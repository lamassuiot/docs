":129566,"_41655":129569,"_41657":129572,"_41659":129575,"_41661":129578,"_41663":129581,"_41665":129584,"_41667":129587,"_41669":129590,"_41671":129593,"_41673":129596,"_41675":129599,"_41677":129602,"_41679":129605,"_41681":129608,"_41683":129611,"_41685":129614,"_41687":129617,"_41690":129620,"_41692":129623,"_41694":129626},{"_3627":72741,"_31174":72741,"_5":15221,"_3078":120343,"_31533":120344,"_21594":120347,"_28366":72741},"Despliega desde AWS Marketplace",[50951,120345,120346],"Despliegue","Otros modelos",[],{"_3627":72742,"_31174":72741,"_21594":120349,"_5":14861,"_28366":72741,"_3078":120350},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3627":72743,"_31174":72741,"_5":31530,"_21594":120352,"_28366":120353,"_3078":120354},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3627":72744,"_31174":72741,"_5":31530,"_21594":120356,"_28366":120357,"_3078":120358},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3627":72745,"_31174":72741,"_5":31530,"_21594":120360,"_28366":120361,"_3078":120362},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3627":72746,"_31174":72741,"_5":31530,"_21594":120364,"_28366":120365,"_3078":120366},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3627":72747,"_31174":72741,"_5":31530,"_21594":120368,"_28366":120369,"_3078":120370},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3627":72748,"_31174":72741,"_5":31530,"_21594":120372,"_28366":120373,"_3078":120374},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3627":72749,"_31174":72741,"_5":31530,"_21594":120376,"_28366":120377,"_3078":120378},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3627":72750,"_31174":72741,"_21594":120380,"_5":14861,"_28366":72741,"_3078":120381},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3627":72751,"_31174":72741,"_21594":120383,"_5":14861,"_28366":120353,"_3078":120384},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3627":72752,"_31174":72741,"_21594":120386,"_5":14861,"_28366":120353,"_3078":120387},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3627":72753,"_31174":72741,"_21594":120389,"_5":14861,"_28366":120353,"_3078":120390},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3627":72754,"_31174":72741,"_21594":120392,"_5":14861,"_28366":120357,"_3078":120393},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3627":72755,"_31174":72741,"_21594":120395,"_5":14861,"_28366":120357,"_3078":120396},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3627":72756,"_31174":72741,"_21594":120398,"_5":14861,"_28366":120357,"_3078":120399},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3627":72757,"_31174":72741,"_21594":120401,"_5":14861,"_28366":120361,"_3078":120402},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3627":72758,"_31174":72741,"_21594":120404,"_5":14861,"_28366":120365,"_3078":120405},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3627":72759,"_31174":72741,"_21594":120407,"_5":14861,"_28366":120369,"_3078":120408},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3627":72760,"_31174":72741,"_21594":120410,"_5":14861,"_28366":120373,"_3078":120411},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3627":72761,"_31174":72741,"_21594":120413,"_5":14861,"_28366":120377,"_3078":120414},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3627":72762,"_31174":72762,"_5":15221,"_3078":120416,"_31533":120417,"_21594":120418,"_28366":72762},"Despliega Lamassu",[50951,120345],[],{"_3627":72763,"_31174":72762,"_21594":120420,"_5":14861,"_28366":72762,"_3078":120421},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3627":72764,"_31174":72762,"_5":31530,"_21594":120423,"_28366":120424,"_3078":120425},[],"/docs/pr-preview/pr-75/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3627":72765,"_31174":72762,"_5":31530,"_21594":120427,"_28366":120428,"_3078":120429},[],"/docs/pr-preview/pr-75/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3627":72766,"_31174":72762,"_5":31530,"_21594":120431,"_28366":120432,"_3078":120433},[],"/docs/pr-preview/pr-75/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3627":72767,"_31174":72762,"_21594":120435,"_5":14861,"_28366":72762,"_3078":120436},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3627":72768,"_31174":72762,"_21594":120438,"_5":14861,"_28366":120424,"_3078":120439},[],"Modelo",{"_3627":72769,"_31174":72762,"_21594":120441,"_5":14861,"_28366":120424,"_3078":120442},[],"Recomendado para",{"_3627":72770,"_31174":72762,"_21594":120444,"_5":14861,"_28366":120424,"_3078":120445},[],"Quién opera la infraestructura",{"_3627":72771,"_31174":72762,"_21594":120447,"_5":14861,"_28366":120424,"_3078":120448},[],"Punto de partida",{"_3627":72772,"_31174":72762,"_21594":120450,"_5":14861,"_28366":120424,"_3078":51058},[],{"_3627":72773,"_31174":72762,"_21594":120452,"_5":14861,"_28366":120424,"_3078":120453},[],"Producción, entornos regulados y despliegues personalizados",{"_3627":72774,"_31174":72762,"_21594":120455,"_5":14861,"_28366":120424,"_3078":120456},[],"Tu equipo",{"_3627":72775,"_31174":72762,"_21594":120458,"_5":14861,"_28366":120424,"_3078":120459},[],"Helm o Fastlane",{"_3627":72776,"_31174":72762,"_21594":120461,"_5":14861,"_28366":120424,"_3078":51070},[],{"_3627":72777,"_31174":72762,"_21594":120463,"_5":14861,"_28366":120424,"_3078":120464},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3627":72778,"_31174":72762,"_21594":120466,"_5":14861,"_28366":120424,"_3078":120456},[],{"_3627":72779,"_31174":72762,"_21594":120468,"_5":14861,"_28366":120424,"_3078":120469},[],"Imagen preconfigurada en EC2",{"_3627":72780,"_31174":72762,"_21594":120471,"_5":14861,"_28366":120424,"_3078":51081},[],{"_3627":72781,"_31174":72762,"_21594":120473,"_5":14861,"_28366":120424,"_3078":120474},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3627":72782,"_31174":72762,"_21594":120476,"_5":14861,"_28366":120424,"_3078":51087},[],{"_3627":72783,"_31174":72762,"_21594":120478,"_5":14861,"_28366":120424,"_3078":120479},[],"Suscripción gestionada",{"_3627":72784,"_31174":72762,"_21594":120481,"_5":14861,"_28366":120424,"_3078":120482},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3627":72785,"_31174":72762,"_21594":120484,"_5":14861,"_28366":120424,"_3078":120485},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3627":72786,"_31174":72762,"_21594":120487,"_5":14861,"_28366":120424,"_3078":120488},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3627":72787,"_31174":72762,"_21594":120490,"_5":14861,"_28366":120428,"_3078":120491},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3627":72788,"_31174":72762,"_21594":120493,"_5":14861,"_28366":120432,"_3078":120494},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3627":72789,"_31174":72789,"_5":15221,"_3078":120496,"_31533":120497,"_21594":120498,"_28366":72789},"Utiliza Lamassu como SaaS",[50951,120345,120346],[],{"_3627":72790,"_31174":72789,"_21594":120500,"_5":14861,"_28366":72789,"_3078":120501},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3627":72791,"_31174":72789,"_5":31530,"_21594":120503,"_28366":120504,"_3078":120505},[],"/docs/pr-preview/pr-75/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3627":72792,"_31174":72789,"_5":31530,"_21594":120507,"_28366":120508,"_3078":120509},[],"/docs/pr-preview/pr-75/es/deployment/saas#planes","Planes",{"_3627":72793,"_31174":72789,"_5":31530,"_21594":120511,"_28366":120512,"_3078":120513},[],"/docs/pr-preview/pr-75/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3627":72794,"_31174":72789,"_21594":120515,"_5":14861,"_28366":72789,"_3078":120516},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3627":72795,"_31174":72789,"_21594":120518,"_5":14861,"_28366":120504,"_3078":120519},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3627":72796,"_31174":72789,"_21594":120521,"_5":14861,"_28366":120504,"_3078":120522},[],"Copias de seguridad automáticas.",{"_3627":72797,"_31174":72789,"_21594":120524,"_5":14861,"_28366":120504,"_3078":120525},[],"Actualizaciones de versión.",{"_3627":72798,"_31174":72789,"_21594":120527,"_5":14861,"_28366":120504,"_3078":120528},[],"Soporte técnico y SLA según el plan contratado.",{"_3627":72799,"_31174":72789,"_21594":120530,"_5":14861,"_28366":120508,"_3078":51142},[],{"_3627":72800,"_31174":72789,"_21594":120532,"_5":14861,"_28366":120508,"_3078":120533},[],"Dispositivos",{"_3627":72801,"_31174":72789,"_21594":120535,"_5":14861,"_28366":120508,"_3078":120536},[],"Soporte",{"_3627":72802,"_31174":72789,"_21594":120538,"_5":14861,"_28366":120508,"_3078":51151},[],{"_3627":72803,"_31174":72789,"_21594":120540,"_5":14861,"_28366":120508,"_3078":51154},[],{"_3627":72804,"_31174":72789,"_21594":120542,"_5":14861,"_28366":120508,"_3078":120543},[],"Hasta 1.000",{"_3627":72805,"_31174":72789,"_21594":120545,"_5":14861,"_28366":120508,"_3078":51160},[],{"_3627":72806,"_31174":72789,"_21594":120547,"_5":14861,"_28366":120508,"_3078":120548},[],"99,5 %",{"_3627":72807,"_31174":72789,"_21594":120550,"_5":14861,"_28366":120508,"_3078":51166},[],{"_3627":72808,"_31174":72789,"_21594":120552,"_5":14861,"_28366":120508,"_3078":120553},[],"Hasta 10.000",{"_3627":72809,"_31174":72789,"_21594":120555,"_5":14861,"_28366":120508,"_3078":120556},[],"Email y chat",{"_3627":72810,"_31174":72789,"_21594":120558,"_5":14861,"_28366":120508,"_3078":120559},[],"99,9 %",{"_3627":72811,"_31174":72789,"_21594":120561,"_5":14861,"_28366":120508,"_3078":51178},[],{"_3627":72812,"_31174":72789,"_21594":120563,"_5":14861,"_28366":120508,"_3078":120564},[],"Ilimitados",{"_3627":72813,"_31174":72789,"_21594":120566,"_5":14861,"_28366":120508,"_3078":120567},[],"Dedicado",{"_3627":72814,"_31174":72789,"_21594":120569,"_5":14861,"_28366":120508,"_3078":120570},[],"99,99 %",{"_3627":72815,"_31174":72789,"_21594":120572,"_5":14861,"_28366":120512,"_3078":120573},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3627":72816,"_31174":72789,"_21594":120575,"_5":14861,"_28366":120512,"_3078":120576},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3627":72817,"_31174":72817,"_5":15221,"_3078":51195,"_31533":120578,"_21594":120580,"_28366":72817},[50951,120345,120579],"Kubernetes autogestionado",[],{"_3627":72818,"_31174":72817,"_21594":120582,"_5":14861,"_28366":72817,"_3078":120583},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3627":72819,"_31174":72817,"_5":31530,"_21594":120585,"_28366":120586,"_3078":120587},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3627":72820,"_31174":72817,"_5":31530,"_21594":120589,"_28366":120590,"_3078":120591},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3627":72821,"_31174":72817,"_5":31530,"_21594":120593,"_28366":120594,"_3078":120595},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3627":72822,"_31174":72817,"_5":31530,"_21594":120597,"_28366":120598,"_3078":120599},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3627":72823,"_31174":72817,"_5":31530,"_21594":120601,"_28366":120602,"_3078":120603},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3627":72824,"_31174":72817,"_5":31530,"_21594":120605,"_28366":120606,"_3078":120607},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3627":72825,"_31174":72817,"_5":31530,"_21594":120609,"_28366":120610,"_3078":120611},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3627":72826,"_31174":72817,"_5":31530,"_21594":120613,"_28366":120614,"_3078":120615},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3627":72827,"_31174":72817,"_5":31530,"_21594":120617,"_28366":120618,"_3078":120619},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3627":72828,"_31174":72817,"_5":31530,"_21594":120621,"_28366":120622,"_3078":120623},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3627":72829,"_31174":72817,"_5":31530,"_21594":120625,"_28366":120626,"_3078":120627},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3627":72830,"_31174":72817,"_21594":120629,"_5":14861,"_28366":120586,"_3078":120630},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3627":72831,"_31174":72817,"_21594":120632,"_5":14861,"_28366":120586,"_3078":120633},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3627":72832,"_31174":72817,"_21594":120635,"_5":14861,"_28366":120590,"_3078":120636},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3627":72833,"_31174":72817,"_21594":120638,"_5":14861,"_28366":120590,"_3078":120639},[],"Fastlane instala o configura",{"_3627":72834,"_31174":72817,"_21594":120641,"_5":14861,"_28366":120590,"_3078":120642},[],"Tú sigues proporcionando",{"_3627":72835,"_31174":72817,"_21594":120644,"_5":14861,"_28366":120590,"_3078":120645},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3627":72836,"_31174":72817,"_21594":120647,"_5":14861,"_28366":120590,"_3078":120648},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3627":72837,"_31174":72817,"_21594":120650,"_5":14861,"_28366":120590,"_3078":120651},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3627":72838,"_31174":72817,"_21594":120653,"_5":14861,"_28366":120590,"_3078":120654},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3627":72839,"_31174":72817,"_21594":120656,"_5":14861,"_28366":120590,"_3078":120657},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3627":72840,"_31174":72817,"_21594":120659,"_5":14861,"_28366":120590,"_3078":120660},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3627":72841,"_31174":72817,"_21594":120662,"_5":14861,"_28366":120590,"_3078":120663},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3627":72842,"_31174":72817,"_21594":120665,"_5":14861,"_28366":120590,"_3078":120666},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3627":72843,"_31174":72817,"_21594":120668,"_5":14861,"_28366":120590,"_3078":120669},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3627":72844,"_31174":72817,"_21594":120671,"_5":14861,"_28366":120594,"_3078":120672},[],"Necesitas:",{"_3627":72845,"_31174":72817,"_21594":120674,"_5":14861,"_28366":120594,"_3078":120675},[],"un clúster Kubernetes existente",{"_3627":72846,"_31174":72817,"_21594":120677,"_5":14861,"_28366":120594,"_3078":120678},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3627":72847,"_31174":72817,"_21594":120680,"_5":14861,"_28366":120594,"_3078":51297},[],{"_3627":72848,"_31174":72817,"_21594":120682,"_5":14861,"_28366":120594,"_3078":24406},[],{"_3627":72849,"_31174":72817,"_21594":120684,"_5":14861,"_28366":120594,"_3078":120685},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3627":72850,"_31174":72817,"_21594":120687,"_5":14861,"_28366":120594,"_3078":120688},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3627":72851,"_31174":72817,"_21594":120690,"_5":14861,"_28366":120594,"_3078":120691},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3627":72852,"_31174":72817,"_21594":120693,"_5":14861,"_28366":120594,"_3078":120694},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3627":72853,"_31174":72817,"_21594":120696,"_5":14861,"_28366":120594,"_3078":120697},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3627":72854,"_31174":72817,"_21594":120699,"_5":14861,"_28366":120598,"_3078":120700},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3627":72855,"_31174":72817,"_21594":120702,"_5":14861,"_28366":120598,"_3078":120703},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3627":72856,"_31174":72817,"_21594":120705,"_5":14861,"_28366":120602,"_3078":120706},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3627":72857,"_31174":72817,"_21594":120708,"_5":14861,"_28366":120602,"_3078":120709},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3627":72858,"_31174":72817,"_21594":120711,"_5":14861,"_28366":120602,"_3078":120712},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3627":72859,"_31174":72817,"_21594":120714,"_5":14861,"_28366":120602,"_3078":120715},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3627":72860,"_31174":72817,"_21594":120717,"_5":14861,"_28366":120606,"_3078":120718},[],"Opción",{"_3627":72861,"_31174":72817,"_21594":120720,"_5":14861,"_28366":120606,"_3078":120721},[],"Valor predeterminado",{"_3627":72862,"_31174":72817,"_21594":120723,"_5":14861,"_28366":120606,"_3078":120724},[],"Propósito",{"_3627":72863,"_31174":72817,"_21594":120726,"_5":14861,"_28366":120606,"_3078":51344},[],{"_3627":72864,"_31174":72817,"_21594":120728,"_5":14861,"_28366":120606,"_3078":51347},[],{"_3627":72865,"_31174":72817,"_21594":120730,"_5":14861,"_28366":120606,"_3078":120731},[],"Muestra la ayuda",{"_3627":72866,"_31174":72817,"_21594":120733,"_5":14861,"_28366":120606,"_3078":51353},[],{"_3627":72867,"_31174":72817,"_21594":120735,"_5":14861,"_28366":120606,"_3078":120736},[],"contexto actual",{"_3627":72868,"_31174":72817,"_21594":120738,"_5":14861,"_28366":120606,"_3078":120739},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3627":72869,"_31174":72817,"_21594":120741,"_5":14861,"_28366":120606,"_3078":51362},[],{"_3627":72870,"_31174":72817,"_21594":120743,"_5":14861,"_28366":120606,"_3078":6794},[],{"_3627":72871,"_31174":72817,"_21594":120745,"_5":14861,"_28366":120606,"_3078":120746},[],"Omite prompts y genera credenciales para las dependencias",{"_3627":72872,"_31174":72817,"_21594":120748,"_5":14861,"_28366":120606,"_3078":51370},[],{"_3627":72873,"_31174":72817,"_21594":120750,"_5":14861,"_28366":120606,"_3078":51373},[],{"_3627":72874,"_31174":72817,"_21594":120752,"_5":14861,"_28366":120606,"_3078":120753},[],"Namespace de la instalación",{"_3627":72875,"_31174":72817,"_21594":120755,"_5":14861,"_28366":120606,"_3078":51379},[],{"_3627":72876,"_31174":72817,"_21594":120757,"_5":14861,"_28366":120606,"_3078":51382},[],{"_3627":72877,"_31174":72817,"_21594":120759,"_5":14861,"_28366":120606,"_3078":120760},[],"Dominio usado por la UI, OIDC y el certificado",{"_3627":72878,"_31174":72817,"_21594":120762,"_5":14861,"_28366":120606,"_3078":51388},[],{"_3627":72879,"_31174":72817,"_21594":120764,"_5":14861,"_28366":120606,"_3078":15573},[],{"_3627":72880,"_31174":72817,"_21594":120766,"_5":14861,"_28366":120606,"_3078":120767},[],"Versión del chart de Lamassu",{"_3627":72881,"_31174":72817,"_21594":120769,"_5":14861,"_28366":120606,"_3078":51396},[],{"_3627":72882,"_31174":72817,"_21594":120771,"_5":14861,"_28366":120606,"_3078":51399},[],{"_3627":72883,"_31174":72817,"_21594":120773,"_5":14861,"_28366":120606,"_3078":120774},[],"Puerto del listener HTTPS",{"_3627":72884,"_31174":72817,"_21594":120776,"_5":14861,"_28366":120606,"_3078":51405},[],{"_3627":72885,"_31174":72817,"_21594":120778,"_5":14861,"_28366":120606,"_3078":51408},[],{"_3627":72886,"_31174":72817,"_21594":120780,"_5":14861,"_28366":120606,"_3078":120781},[],"Puerto del listener HTTP",{"_3627":72887,"_31174":72817,"_21594":120783,"_5":14861,"_28366":120606,"_3078":51414},[],{"_3627":72888,"_31174":72817,"_21594":120785,"_5":14861,"_28366":120606,"_3078":51347},[],{"_3627":72889,"_31174":72817,"_21594":120787,"_5":14861,"_28366":120606,"_3078":120788},[],"Certificado PEM para TLS downstream",{"_3627":72890,"_31174":72817,"_21594":120790,"_5":14861,"_28366":120606,"_3078":51422},[],{"_3627":72891,"_31174":72817,"_21594":120792,"_5":14861,"_28366":120606,"_3078":51347},[],{"_3627":72892,"_31174":72817,"_21594":120794,"_5":14861,"_28366":120606,"_3078":120795},[],"Clave privada PEM para TLS downstream",{"_3627":72893,"_31174":72817,"_21594":120797,"_5":14861,"_28366":120606,"_3078":51430},[],{"_3627":72894,"_31174":72817,"_21594":120799,"_5":14861,"_28366":120606,"_3078":120800},[],"chart del repositorio",{"_3627":72895,"_31174":72817,"_21594":120802,"_5":14861,"_28366":120606,"_3078":120803},[],"Usa un chart local de Lamassu sin empaquetar",{"_3627":72896,"_31174":72817,"_21594":120805,"_5":14861,"_28366":120606,"_3078":51439},[],{"_3627":72897,"_31174":72817,"_21594":120807,"_5":14861,"_28366":120606,"_3078":120808},[],"detección automática",{"_3627":72898,"_31174":72817,"_21594":120810,"_5":14861,"_28366":120606,"_3078":120811},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3627":72899,"_31174":72817,"_21594":120813,"_5":14861,"_28366":120606,"_3078":51447},[],{"_3627":72900,"_31174":72817,"_21594":120815,"_5":14861,"_28366":120606,"_3078":6794},[],{"_3627":72901,"_31174":72817,"_21594":120817,"_5":14861,"_28366":120606,"_3078":120818},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3627":72902,"_31174":72817,"_21594":120820,"_5":14861,"_28366":120606,"_3078":51455},[],{"_3627":72903,"_31174":72817,"_21594":120822,"_5":14861,"_28366":120606,"_3078":6794},[],{"_3627":72904,"_31174":72817,"_21594":120824,"_5":14861,"_28366":120606,"_3078":120825},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3627":72905,"_31174":72817,"_21594":120827,"_5":14861,"_28366":120606,"_3078":51463},[],{"_3627":72906,"_31174":72817,"_21594":120829,"_5":14861,"_28366":120606,"_3078":6794},[],{"_3627":72907,"_31174":72817,"_21594":120831,"_5":14861,"_28366":120606,"_3078":120832},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3627":72908,"_31174":72817,"_21594":120834,"_5":14861,"_28366":120606,"_3078":51471},[],{"_3627":72909,"_31174":72817,"_21594":120836,"_5":14861,"_28366":120606,"_3078":6794},[],{"_3627":72910,"_31174":72817,"_21594":120838,"_5":14861,"_28366":120606,"_3078":120839},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3627":72911,"_31174":72817,"_21594":120841,"_5":14861,"_28366":120606,"_3078":51479},[],{"_3627":72912,"_31174":72817,"_21594":120843,"_5":14861,"_28366":120606,"_3078":51482},[],{"_3627":72913,"_31174":72817,"_21594":120845,"_5":14861,"_28366":120606,"_3078":120846},[],"Usa otro chart local de SoftHSM",{"_3627":72914,"_31174":72817,"_21594":120848,"_5":14861,"_28366":120606,"_3078":120849},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3627":72915,"_31174":72817,"_21594":120851,"_5":14861,"_28366":120610,"_3078":120852},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3627":72916,"_31174":72817,"_21594":120854,"_5":14861,"_28366":120610,"_3078":120855},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3627":72917,"_31174":72817,"_21594":120857,"_5":14861,"_28366":120610,"_3078":120858},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3627":72918,"_31174":72817,"_21594":120860,"_5":14861,"_28366":120610,"_3078":120861},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3627":72919,"_31174":72817,"_21594":120863,"_5":14861,"_28366":120610,"_3078":120864},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3627":72920,"_31174":72817,"_21594":120866,"_5":14861,"_28366":120610,"_3078":120867},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3627":72921,"_31174":72817,"_21594":120869,"_5":14861,"_28366":120614,"_3078":51509},[],{"_3627":72922,"_31174":72817,"_21594":120871,"_5":14861,"_28366":120614,"_3078":120872},[],"valida las herramientas locales y el clúster seleccionado",{"_3627":72923,"_31174":72817,"_21594":120874,"_5":14861,"_28366":120614,"_3078":120875},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3627":72924,"_31174":72817,"_21594":120877,"_5":14861,"_28366":120614,"_3078":120878},[],"crea el namespace",{"_3627":72925,"_31174":72817,"_21594":120880,"_5":14861,"_28366":120614,"_3078":120881},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3627":72926,"_31174":72817,"_21594":120883,"_5":14861,"_28366":120614,"_3078":120884},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3627":72927,"_31174":72817,"_21594":120886,"_5":14861,"_28366":120614,"_3078":120887},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3627":72928,"_31174":72817,"_21594":120889,"_5":14861,"_28366":120614,"_3078":120890},[],"instala RabbitMQ",{"_3627":72929,"_31174":72817,"_21594":120892,"_5":14861,"_28366":120614,"_3078":120893},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3627":72930,"_31174":72817,"_21594":120895,"_5":14861,"_28366":120614,"_3078":120896},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3627":72931,"_31174":72817,"_21594":120898,"_5":14861,"_28366":120614,"_3078":120899},[],"carga datos de ejemplo opcionalmente",{"_3627":72932,"_31174":72817,"_21594":120901,"_5":14861,"_28366":120614,"_3078":120902},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3627":72933,"_31174":72817,"_21594":120904,"_5":14861,"_28366":120618,"_3078":120905},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3627":72934,"_31174":72817,"_21594":120907,"_5":14861,"_28366":120618,"_3078":120908},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3627":72935,"_31174":72817,"_21594":120910,"_5":14861,"_28366":120622,"_3078":120911},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3627":72936,"_31174":72817,"_21594":120913,"_5":14861,"_28366":120622,"_3078":120914},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3627":72937,"_31174":72817,"_21594":120916,"_5":14861,"_28366":120622,"_3078":120917},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3627":72938,"_31174":72817,"_21594":120919,"_5":14861,"_28366":120622,"_3078":120920},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3627":72939,"_31174":72817,"_21594":120922,"_5":14861,"_28366":120626,"_3078":120923},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3627":72940,"_31174":72940,"_5":15221,"_3078":120925,"_31533":120926,"_21594":120927,"_28366":72940},"Instala con Helm",[50951,120345,120579],[],{"_3627":72941,"_31174":72940,"_21594":120929,"_5":14861,"_28366":72940,"_3078":120930},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3627":72942,"_31174":72940,"_5":31530,"_21594":120932,"_28366":120933,"_3078":120934},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3627":72943,"_31174":72940,"_5":31530,"_21594":120936,"_28366":120937,"_3078":120595},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3627":72944,"_31174":72940,"_5":31530,"_21594":120939,"_28366":120940,"_3078":120941},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3627":72945,"_31174":72940,"_5":31530,"_21594":120943,"_28366":120944,"_3078":120945},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3627":72946,"_31174":72940,"_5":31530,"_21594":120947,"_28366":120948,"_3078":120949},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3627":72947,"_31174":72940,"_5":31530,"_21594":120951,"_28366":120952,"_3078":120953},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3627":72948,"_31174":72940,"_5":31530,"_21594":120955,"_28366":120956,"_3078":120957},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3627":72949,"_31174":72940,"_5":31530,"_21594":120959,"_28366":120960,"_3078":120961},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3627":72950,"_31174":72940,"_5":31530,"_21594":120963,"_28366":120964,"_3078":120965},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3627":72951,"_31174":72940,"_5":31530,"_21594":120967,"_28366":120968,"_3078":120969},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3627":72952,"_31174":72940,"_5":31530,"_21594":120971,"_28366":120972,"_3078":120973},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3627":72953,"_31174":72940,"_5":31530,"_21594":120975,"_28366":120976,"_3078":120977},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3627":72954,"_31174":72940,"_21594":120979,"_5":14861,"_28366":120933,"_3078":120980},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3627":72955,"_31174":72940,"_21594":120982,"_5":14861,"_28366":120937,"_3078":120983},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3627":72956,"_31174":72940,"_21594":120985,"_5":14861,"_28366":120937,"_3078":120986},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3627":72957,"_31174":72940,"_21594":120988,"_5":14861,"_28366":120937,"_3078":120989},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3627":72958,"_31174":72940,"_21594":120991,"_5":14861,"_28366":120937,"_3078":120992},[],"un broker RabbitMQ accesible y sus credenciales",{"_3627":72959,"_31174":72940,"_21594":120994,"_5":14861,"_28366":120937,"_3078":120995},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3627":72960,"_31174":72940,"_21594":120997,"_5":14861,"_28366":120937,"_3078":120998},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3627":72961,"_31174":72940,"_21594":121000,"_5":14861,"_28366":120937,"_3078":121001},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3627":72962,"_31174":72940,"_21594":121003,"_5":14861,"_28366":120937,"_3078":121004},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3627":72963,"_31174":72940,"_21594":121006,"_5":14861,"_28366":120937,"_3078":121007},[],"una StorageClass y un diseño de tráfico externo",{"_3627":72964,"_31174":72940,"_21594":121009,"_5":14861,"_28366":120937,"_3078":121010},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3627":72965,"_31174":72940,"_21594":121012,"_5":14861,"_28366":120937,"_3078":121013},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3627":72966,"_31174":72940,"_21594":121015,"_5":14861,"_28366":120937,"_3078":121016},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3627":72967,"_31174":72940,"_21594":121018,"_5":14861,"_28366":120940,"_3078":121019},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3627":72968,"_31174":72940,"_21594":121021,"_5":14861,"_28366":120940,"_3078":121022},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3627":72969,"_31174":72940,"_21594":121024,"_5":14861,"_28366":120940,"_3078":121025},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3627":72970,"_31174":72940,"_21594":121027,"_5":14861,"_28366":120944,"_3078":121028},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3627":72971,"_31174":72940,"_21594":121030,"_5":14861,"_28366":120944,"_3078":121031},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3627":72972,"_31174":72940,"_21594":121033,"_5":14861,"_28366":120944,"_3078":121034},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3627":72973,"_31174":72940,"_21594":121036,"_5":14861,"_28366":120944,"_3078":121037},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3627":72974,"_31174":72940,"_21594":121039,"_5":14861,"_28366":120948,"_3078":121040},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3627":72975,"_31174":72940,"_21594":121042,"_5":14861,"_28366":120948,"_3078":121043},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3627":72976,"_31174":72940,"_21594":121045,"_5":14861,"_28366":120948,"_3078":121046},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3627":72977,"_31174":72940,"_21594":121048,"_5":14861,"_28366":120948,"_3078":121049},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3627":72978,"_31174":72940,"_21594":121051,"_5":14861,"_28366":120948,"_3078":121052},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3627":72979,"_31174":72940,"_21594":121054,"_5":14861,"_28366":120948,"_3078":121055},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3627":72980,"_31174":72940,"_21594":121057,"_5":14861,"_28366":120948,"_3078":121058},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3627":72981,"_31174":72940,"_21594":121060,"_5":14861,"_28366":120948,"_3078":121061},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3627":72982,"_31174":72940,"_21594":121063,"_5":14861,"_28366":120952,"_3078":121064},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3627":72983,"_31174":72940,"_21594":121066,"_5":14861,"_28366":120956,"_3078":121067},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3627":72984,"_31174":72940,"_21594":121069,"_5":14861,"_28366":120956,"_3078":121070},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3627":72985,"_31174":72940,"_21594":121072,"_5":14861,"_28366":120956,"_3078":121073},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3627":72986,"_31174":72940,"_21594":121075,"_5":14861,"_28366":120956,"_3078":121076},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3627":72987,"_31174":72940,"_21594":121078,"_5":14861,"_28366":120956,"_3078":121079},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3627":72988,"_31174":72940,"_21594":121081,"_5":14861,"_28366":120956,"_3078":121082},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3627":72989,"_31174":72940,"_21594":121084,"_5":14861,"_28366":120956,"_3078":121085},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3627":72990,"_31174":72940,"_21594":121087,"_5":14861,"_28366":120960,"_3078":121088},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3627":72991,"_31174":72940,"_21594":121090,"_5":14861,"_28366":120960,"_3078":121091},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3627":72992,"_31174":72940,"_21594":121093,"_5":14861,"_28366":120960,"_3078":121094},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3627":72993,"_31174":72940,"_21594":121096,"_5":14861,"_28366":120960,"_3078":121097},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3627":72994,"_31174":72940,"_21594":121099,"_5":14861,"_28366":120964,"_3078":121100},[],"Para instalar un checkout local:",{"_3627":72995,"_31174":72940,"_21594":121102,"_5":14861,"_28366":120968,"_3078":121103},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3627":72996,"_31174":72940,"_21594":121105,"_5":14861,"_28366":120968,"_3078":121106},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3627":72997,"_31174":72940,"_21594":121108,"_5":14861,"_28366":120972,"_3078":121109},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3627":72998,"_31174":72940,"_21594":121111,"_5":14861,"_28366":120972,"_3078":121112},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3627":72999,"_31174":72940,"_21594":121114,"_5":14861,"_28366":120972,"_3078":121115},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3627":73000,"_31174":72940,"_21594":121117,"_5":14861,"_28366":120972,"_3078":121118},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3627":73001,"_31174":72940,"_21594":121120,"_5":14861,"_28366":120972,"_3078":121121},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3627":73002,"_31174":72940,"_21594":121123,"_5":14861,"_28366":120976,"_3078":121124},[],"Antes de pasar a producción, revisa:",{"_3627":73003,"_31174":72940,"_21594":121126,"_5":14861,"_28366":120976,"_3078":121127},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3627":73004,"_31174":72940,"_21594":121129,"_5":14861,"_28366":120976,"_3078":121130},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3627":73005,"_31174":72940,"_21594":121132,"_5":14861,"_28366":120976,"_3078":121133},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3627":73006,"_31174":72940,"_21594":121135,"_5":14861,"_28366":120976,"_3078":121136},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3627":73007,"_31174":72940,"_21594":121138,"_5":14861,"_28366":120976,"_3078":121139},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3627":73008,"_31174":72940,"_21594":121141,"_5":14861,"_28366":120976,"_3078":121142},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3627":73009,"_31174":72940,"_21594":121144,"_5":14861,"_28366":120976,"_3078":121145},[],"SMTP, observabilidad y entrega de alertas",{"_3627":73010,"_31174":72940,"_21594":121147,"_5":14861,"_28366":120976,"_3078":121148},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3627":73011,"_31174":72940,"_21594":121150,"_5":14861,"_28366":120976,"_3078":121151},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3627":73012,"_31174":73012,"_5":15221,"_3078":121153,"_31533":121154,"_21594":121155,"_28366":73012},"Expón el Gateway",[50951,120345,120579],[],{"_3627":73013,"_31174":73012,"_21594":121157,"_5":14861,"_28366":73012,"_3078":121158},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3627":73014,"_31174":73012,"_5":31530,"_21594":121160,"_28366":121161,"_3078":121162},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3627":73015,"_31174":73012,"_5":31530,"_21594":121164,"_28366":121165,"_3078":121166},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3627":73016,"_31174":73012,"_5":31530,"_21594":121168,"_28366":121169,"_3078":121170},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3627":73017,"_31174":73012,"_5":31530,"_21594":121172,"_28366":121173,"_3078":51814},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#k3s",{"_3627":73018,"_31174":73012,"_5":31530,"_21594":121175,"_28366":121176,"_3078":121177},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3627":73019,"_31174":73012,"_5":31530,"_21594":121179,"_28366":121180,"_3078":121181},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3627":73020,"_31174":73012,"_5":31530,"_21594":121183,"_28366":121184,"_3078":121185},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3627":73021,"_31174":73012,"_5":31530,"_21594":121187,"_28366":121188,"_3078":121189},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3627":73022,"_31174":73012,"_5":31530,"_21594":121191,"_28366":121192,"_3078":121193},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3627":73023,"_31174":73012,"_5":31530,"_21594":121195,"_28366":121196,"_3078":121197},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3627":73024,"_31174":73012,"_5":31530,"_21594":121199,"_28366":121200,"_3078":121201},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3627":73025,"_31174":73012,"_21594":121203,"_5":14861,"_28366":121161,"_3078":121204},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3627":73026,"_31174":73012,"_21594":121206,"_5":14861,"_28366":121161,"_3078":121207},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3627":73027,"_31174":73012,"_21594":121209,"_5":14861,"_28366":121165,"_3078":121210},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3627":73028,"_31174":73012,"_21594":121212,"_5":14861,"_28366":121165,"_3078":121213},[],"Defínelo únicamente cuando:",{"_3627":73029,"_31174":73012,"_21594":121215,"_5":14861,"_28366":121165,"_3078":121216},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3627":73030,"_31174":73012,"_21594":121218,"_5":14861,"_28366":121165,"_3078":121219},[],"esa dirección está asignada a este Gateway",{"_3627":73031,"_31174":73012,"_21594":121221,"_5":14861,"_28366":121165,"_3078":121222},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3627":73032,"_31174":73012,"_21594":121224,"_5":14861,"_28366":121165,"_3078":121225},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3627":73033,"_31174":73012,"_21594":121227,"_5":14861,"_28366":121165,"_3078":121228},[],"No confundas estos valores:",{"_3627":73034,"_31174":73012,"_21594":121230,"_5":14861,"_28366":121165,"_3078":121231},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3627":73035,"_31174":73012,"_21594":121233,"_5":14861,"_28366":121165,"_3078":121234},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3627":73036,"_31174":73012,"_21594":121236,"_5":14861,"_28366":121165,"_3078":121237},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3627":73037,"_31174":73012,"_21594":121239,"_5":14861,"_28366":121169,"_3078":121240},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3627":73038,"_31174":73012,"_21594":121242,"_5":14861,"_28366":121169,"_3078":121243},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3627":73039,"_31174":73012,"_21594":121245,"_5":14861,"_28366":121173,"_3078":121246},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3627":73040,"_31174":73012,"_21594":121248,"_5":14861,"_28366":121173,"_3078":121249},[],"Para el diseño recomendado:",{"_3627":73041,"_31174":73012,"_21594":121251,"_5":14861,"_28366":121173,"_3078":121252},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3627":73042,"_31174":73012,"_21594":121254,"_5":14861,"_28366":121173,"_3078":121255},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3627":73043,"_31174":73012,"_21594":121257,"_5":14861,"_28366":121173,"_3078":121258},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3627":73044,"_31174":73012,"_21594":121260,"_5":14861,"_28366":121173,"_3078":121261},[],"Apunta DNS a la dirección accesible de la VM.",{"_3627":73045,"_31174":73012,"_21594":121263,"_5":14861,"_28366":121173,"_3078":121264},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3627":73046,"_31174":73012,"_21594":121266,"_5":14861,"_28366":121176,"_3078":121267},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3627":73047,"_31174":73012,"_21594":121269,"_5":14861,"_28366":121180,"_3078":121270},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3627":73048,"_31174":73012,"_21594":121272,"_5":14861,"_28366":121180,"_3078":121273},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3627":73049,"_31174":73012,"_21594":121275,"_5":14861,"_28366":121184,"_3078":121276},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3627":73050,"_31174":73012,"_21594":121278,"_5":14861,"_28366":121184,"_3078":121279},[],"Requisito",{"_3627":73051,"_31174":73012,"_21594":121281,"_5":14861,"_28366":121184,"_3078":121282},[],"Diseño recomendado",{"_3627":73052,"_31174":73012,"_21594":121284,"_5":14861,"_28366":121184,"_3078":121285},[],"Consecuencia",{"_3627":73053,"_31174":73012,"_21594":121287,"_5":14861,"_28366":121184,"_3078":121288},[],"Varias URL o servicios de Lamassu",{"_3627":73054,"_31174":73012,"_21594":121290,"_5":14861,"_28366":121184,"_3078":121291},[],"Un Gateway con varias rutas",{"_3627":73055,"_31174":73012,"_21594":121293,"_5":14861,"_28366":121184,"_3078":121294},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3627":73056,"_31174":73012,"_21594":121296,"_5":14861,"_28366":121184,"_3078":121297},[],"Gateways independientes e IP externas distintas",{"_3627":73057,"_31174":73012,"_21594":121299,"_5":14861,"_28366":121184,"_3078":121300},[],"Una VIP por Gateway",{"_3627":73058,"_31174":73012,"_21594":121302,"_5":14861,"_28366":121184,"_3078":121303},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3627":73059,"_31174":73012,"_21594":121305,"_5":14861,"_28366":121184,"_3078":121306},[],"Gateways independientes, un nodo y una IP",{"_3627":73060,"_31174":73012,"_21594":121308,"_5":14861,"_28366":121184,"_3078":121309},[],"Puertos externos diferentes",{"_3627":73061,"_31174":73012,"_21594":121311,"_5":14861,"_28366":121184,"_3078":121312},[],"Los clientes deben indicar puertos no estándar",{"_3627":73062,"_31174":73012,"_21594":121314,"_5":14861,"_28366":121184,"_3078":121315},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3627":73063,"_31174":73012,"_21594":121317,"_5":14861,"_28366":121184,"_3078":121318},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3627":73064,"_31174":73012,"_21594":121320,"_5":14861,"_28366":121184,"_3078":121321},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3627":73065,"_31174":73012,"_21594":121323,"_5":14861,"_28366":121184,"_3078":121324},[],"Recursos Gateway separados pero proxy compartido",{"_3627":73066,"_31174":73012,"_21594":121326,"_5":14861,"_28366":121184,"_3078":121327},[],"Modo merged Gateway de Envoy",{"_3627":73067,"_31174":73012,"_21594":121329,"_5":14861,"_28366":121184,"_3078":121330},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3627":73068,"_31174":73012,"_21594":121332,"_5":14861,"_28366":121184,"_3078":121333},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3627":73069,"_31174":73012,"_21594":121335,"_5":14861,"_28366":121184,"_3078":121336},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3627":73070,"_31174":73012,"_21594":121338,"_5":14861,"_28366":121184,"_3078":121339},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3627":73071,"_31174":73012,"_21594":121341,"_5":14861,"_28366":121184,"_3078":121342},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3627":73072,"_31174":73012,"_21594":121344,"_5":14861,"_28366":121188,"_3078":121345},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3627":73073,"_31174":73012,"_21594":121347,"_5":14861,"_28366":121192,"_3078":121348},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3627":73074,"_31174":73012,"_21594":121350,"_5":14861,"_28366":121192,"_3078":121351},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3627":73075,"_31174":73012,"_21594":121353,"_5":14861,"_28366":121192,"_3078":121354},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3627":73076,"_31174":73012,"_21594":121356,"_5":14861,"_28366":121192,"_3078":121357},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3627":73077,"_31174":73012,"_21594":121359,"_5":14861,"_28366":121192,"_3078":121360},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3627":73078,"_31174":73012,"_21594":121362,"_5":14861,"_28366":121196,"_3078":121363},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3627":73079,"_31174":73012,"_21594":121365,"_5":14861,"_28366":121196,"_3078":121366},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3627":73080,"_31174":73012,"_21594":121368,"_5":14861,"_28366":121200,"_3078":121369},[],"Comprueba, en orden:",{"_3627":73081,"_31174":73012,"_21594":121371,"_5":14861,"_28366":121200,"_3078":121372},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3627":73082,"_31174":73012,"_21594":121374,"_5":14861,"_28366":121200,"_3078":121375},[],"Su estado contiene la dirección esperada.",{"_3627":73083,"_31174":73012,"_21594":121377,"_5":14861,"_28366":121200,"_3078":121378},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3627":73084,"_31174":73012,"_21594":121380,"_5":14861,"_28366":121200,"_3078":121381},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3627":73085,"_31174":73012,"_21594":121383,"_5":14861,"_28366":121200,"_3078":121384},[],"DNS resuelve al endpoint accesible externamente.",{"_3627":73086,"_31174":73012,"_21594":121386,"_5":14861,"_28366":121200,"_3078":121387},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3627":73087,"_31174":73012,"_21594":121389,"_5":14861,"_28366":121200,"_3078":121390},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3627":73088,"_31174":73088,"_5":15221,"_3078":51058,"_31533":121392,"_21594":121393,"_28366":73088},[50951,120345,120579],[],{"_3627":73089,"_31174":73088,"_21594":121395,"_5":14861,"_28366":73088,"_3078":121396},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3627":73090,"_31174":73088,"_5":31530,"_21594":121398,"_28366":121399,"_3078":121400},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3627":73091,"_31174":73088,"_5":31530,"_21594":121402,"_28366":121403,"_3078":121404},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3627":73092,"_31174":73088,"_5":31530,"_21594":121406,"_28366":121407,"_3078":121408},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3627":73093,"_31174":73088,"_5":31530,"_21594":121410,"_28366":121411,"_3078":121412},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3627":73094,"_31174":73088,"_5":31530,"_21594":121414,"_28366":121415,"_3078":121416},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3627":73095,"_31174":73088,"_5":31530,"_21594":121418,"_28366":121419,"_3078":121420},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3627":73096,"_31174":73088,"_21594":121422,"_5":14861,"_28366":121399,"_3078":121423},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3627":73097,"_31174":73088,"_21594":121425,"_5":14861,"_28366":121403,"_3078":121426},[],"Flujo",{"_3627":73098,"_31174":73088,"_21594":121428,"_5":14861,"_28366":121403,"_3078":121429},[],"Úsalo para",{"_3627":73099,"_31174":73088,"_21594":121431,"_5":14861,"_28366":121403,"_3078":121432},[],"Qué instala",{"_3627":73100,"_31174":73088,"_21594":121434,"_5":14861,"_28366":121403,"_3078":52076},[],{"_3627":73101,"_31174":73088,"_21594":121436,"_5":14861,"_28366":121403,"_3078":121437},[],"Producción y entornos controlados",{"_3627":73102,"_31174":73088,"_21594":121439,"_5":14861,"_28366":121403,"_3078":121440},[],"Servicios de Lamassu y recursos de Gateway API",{"_3627":73103,"_31174":73088,"_21594":121442,"_5":14861,"_28366":121403,"_3078":51195},[],{"_3627":73104,"_31174":73088,"_21594":121444,"_5":14861,"_28366":121403,"_3078":121445},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3627":73105,"_31174":73088,"_21594":121447,"_5":14861,"_28366":121403,"_3078":121448},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3627":73106,"_31174":73088,"_21594":121450,"_5":14861,"_28366":121407,"_3078":121451},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3627":73107,"_31174":73088,"_21594":121453,"_5":14861,"_28366":121407,"_3078":121454},[],"Área",{"_3627":73108,"_31174":73088,"_21594":121456,"_5":14861,"_28366":121407,"_3078":121457},[],"El chart de Lamassu proporciona",{"_3627":73109,"_31174":73088,"_21594":121459,"_5":14861,"_28366":121407,"_3078":121460},[],"Tú proporcionas",{"_3627":73110,"_31174":73088,"_21594":121462,"_5":14861,"_28366":121407,"_3078":121463},[],"Aplicaciones Lamassu",{"_3627":73111,"_31174":73088,"_21594":121465,"_5":14861,"_28366":121407,"_3078":121466},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3627":73112,"_31174":73088,"_21594":121468,"_5":14861,"_28366":121407,"_3078":121469},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3627":73113,"_31174":73088,"_21594":121471,"_5":14861,"_28366":121407,"_3078":121472},[],"Datos PostgreSQL",{"_3627":73114,"_31174":73088,"_21594":121474,"_5":14861,"_28366":121407,"_3078":121475},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3627":73115,"_31174":73088,"_21594":121477,"_5":14861,"_28366":121407,"_3078":121478},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3627":73116,"_31174":73088,"_21594":121480,"_5":14861,"_28366":121407,"_3078":121481},[],"Mensajería",{"_3627":73117,"_31174":73088,"_21594":121483,"_5":14861,"_28366":121407,"_3078":121484},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3627":73118,"_31174":73088,"_21594":121486,"_5":14861,"_28366":121407,"_3078":121487},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3627":73119,"_31174":73088,"_21594":121489,"_5":14861,"_28366":121407,"_3078":121490},[],"Identidad",{"_3627":73120,"_31174":73088,"_21594":121492,"_5":14861,"_28366":121407,"_3078":121493},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3627":73121,"_31174":73088,"_21594":121495,"_5":14861,"_28366":121407,"_3078":121496},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3627":73122,"_31174":73088,"_21594":121498,"_5":14861,"_28366":121407,"_3078":121499},[],"Enrutamiento externo",{"_3627":73123,"_31174":73088,"_21594":121501,"_5":14861,"_28366":121407,"_3078":121502},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3627":73124,"_31174":73088,"_21594":121504,"_5":14861,"_28366":121407,"_3078":121505},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3627":73125,"_31174":73088,"_21594":121507,"_5":14861,"_28366":121407,"_3078":52150},[],{"_3627":73126,"_31174":73088,"_21594":121509,"_5":14861,"_28366":121407,"_3078":121510},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3627":73127,"_31174":73088,"_21594":121512,"_5":14861,"_28366":121407,"_3078":121513},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3627":73128,"_31174":73088,"_21594":121515,"_5":14861,"_28366":121407,"_3078":121516},[],"Datos persistentes de la aplicación",{"_3627":73129,"_31174":73088,"_21594":121518,"_5":14861,"_28366":121407,"_3078":121519},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3627":73130,"_31174":73088,"_21594":121521,"_5":14861,"_28366":121407,"_3078":121522},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3627":73131,"_31174":73088,"_21594":121524,"_5":14861,"_28366":121407,"_3078":121525},[],"Integraciones opcionales",{"_3627":73132,"_31174":73088,"_21594":121527,"_5":14861,"_28366":121407,"_3078":121528},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3627":73133,"_31174":73088,"_21594":121530,"_5":14861,"_28366":121407,"_3078":121531},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3627":73134,"_31174":73088,"_21594":121533,"_5":14861,"_28366":121407,"_3078":121534},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3627":73135,"_31174":73088,"_21594":121536,"_5":14861,"_28366":121407,"_3078":121537},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3627":73136,"_31174":73088,"_21594":121539,"_5":14861,"_28366":121411,"_3078":121540},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3627":73137,"_31174":73088,"_21594":121542,"_5":14861,"_28366":121411,"_3078":121543},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3627":73138,"_31174":73088,"_21594":121545,"_5":14861,"_28366":121415,"_3078":121546},[],"Kubernetes 1.24 o posterior",{"_3627":73139,"_31174":73088,"_21594":121548,"_5":14861,"_28366":121415,"_3078":121549},[],"Helm 3.2 o posterior",{"_3627":73140,"_31174":73088,"_21594":121551,"_5":14861,"_28366":121415,"_3078":121552},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3627":73141,"_31174":73088,"_21594":121554,"_5":14861,"_28366":121415,"_3078":121555},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3627":73142,"_31174":73088,"_21594":121557,"_5":14861,"_28366":121415,"_3078":121558},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3627":73143,"_31174":73088,"_21594":121560,"_5":14861,"_28366":121415,"_3078":121561},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3627":73144,"_31174":73088,"_21594":121563,"_5":14861,"_28366":121415,"_3078":121564},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3627":73145,"_31174":73088,"_21594":121566,"_5":14861,"_28366":121419,"_3078":121567},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3627":73146,"_31174":73088,"_21594":121569,"_5":14861,"_28366":121419,"_3078":121570},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3627":73147,"_31174":73088,"_21594":121572,"_5":14861,"_28366":121419,"_3078":121573},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3627":73148,"_31174":73088,"_21594":121575,"_5":14861,"_28366":121419,"_3078":121576},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3627":73149,"_31174":73149,"_5":15221,"_3078":121578,"_31533":121579,"_21594":121581,"_28366":73149},"Resolución de problemas de despliegue",[50951,120345,121580],"Operación",[],{"_3627":73150,"_31174":73149,"_21594":121583,"_5":14861,"_28366":73149,"_3078":121584},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3627":73151,"_31174":73149,"_5":31530,"_21594":121586,"_28366":121587,"_3078":121588},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3627":73152,"_31174":73149,"_5":31530,"_21594":121590,"_28366":121591,"_3078":121592},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3627":73153,"_31174":73149,"_5":31530,"_21594":121594,"_28366":121595,"_3078":121596},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3627":73154,"_31174":73149,"_5":31530,"_21594":121598,"_28366":121599,"_3078":121600},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3627":73155,"_31174":73149,"_5":31530,"_21594":121602,"_28366":121603,"_3078":121604},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3627":73156,"_31174":73149,"_5":31530,"_21594":121606,"_28366":121607,"_3078":121608},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3627":73157,"_31174":73149,"_5":31530,"_21594":121610,"_28366":121611,"_3078":121612},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3627":73158,"_31174":73149,"_5":31530,"_21594":121614,"_28366":121615,"_3078":121616},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3627":73159,"_31174":73149,"_5":31530,"_21594":121618,"_28366":121619,"_3078":121620},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3627":73160,"_31174":73149,"_5":31530,"_21594":121622,"_28366":121623,"_3078":121624},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3627":73161,"_31174":73149,"_5":31530,"_21594":121626,"_28366":121627,"_3078":121628},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3627":73162,"_31174":73149,"_5":31530,"_21594":121630,"_28366":121631,"_3078":121632},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3627":73163,"_31174":73149,"_5":31530,"_21594":121634,"_28366":121635,"_3078":121636},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3627":73164,"_31174":73149,"_21594":121638,"_5":14861,"_28366":73149,"_3078":121639},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3627":73165,"_31174":73149,"_21594":121641,"_5":14861,"_28366":121591,"_3078":121642},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3627":73166,"_31174":73149,"_21594":121644,"_5":14861,"_28366":121595,"_3078":121645},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3627":73167,"_31174":73149,"_21594":121647,"_5":14861,"_28366":121599,"_3078":121648},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3627":73168,"_31174":73149,"_21594":121650,"_5":14861,"_28366":121603,"_3078":121651},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3627":73169,"_31174":73149,"_21594":121653,"_5":14861,"_28366":121607,"_3078":121654},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3627":73170,"_31174":73149,"_21594":121656,"_5":14861,"_28366":121611,"_3078":121657},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3627":73171,"_31174":73149,"_21594":121659,"_5":14861,"_28366":121611,"_3078":121660},[],"Ejecuta también la prueba de conectividad del chart:",{"_3627":73172,"_31174":73149,"_21594":121662,"_5":14861,"_28366":121611,"_3078":121663},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3627":73173,"_31174":73149,"_21594":121665,"_5":14861,"_28366":121611,"_3078":121666},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3627":73174,"_31174":73149,"_21594":121668,"_5":14861,"_28366":121615,"_3078":121669},[],"Si recibes un 401:",{"_3627":73175,"_31174":73149,"_21594":121671,"_5":14861,"_28366":121615,"_3078":121672},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3627":73176,"_31174":73149,"_21594":121674,"_5":14861,"_28366":121615,"_3078":121675},[],"verifica emisor, audiencia y expiración del token;",{"_3627":73177,"_31174":73149,"_21594":121677,"_5":14861,"_28366":121615,"_3078":121678},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3627":73178,"_31174":73149,"_21594":121680,"_5":14861,"_28366":121615,"_3078":121681},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3627":73179,"_31174":73149,"_21594":121683,"_5":14861,"_28366":121615,"_3078":121684},[],"Si el login termina pero las APIs devuelven 403:",{"_3627":73180,"_31174":73149,"_21594":121686,"_5":14861,"_28366":121615,"_3078":121687},[],"inspecciona los claims reales del token;",{"_3627":73181,"_31174":73149,"_21594":121689,"_5":14861,"_28366":121615,"_3078":121690},[],"confirma que coinciden con un principal activo;",{"_3627":73182,"_31174":73149,"_21594":121692,"_5":14861,"_28366":121615,"_3078":121693},[],"revisa las políticas concedidas al principal;",{"_3627":73183,"_31174":73149,"_21594":121695,"_5":14861,"_28366":121615,"_3078":121696},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3627":73184,"_31174":73149,"_21594":121698,"_5":14861,"_28366":121615,"_3078":121699},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3627":73185,"_31174":73149,"_21594":121701,"_5":14861,"_28366":121619,"_3078":121702},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3627":73186,"_31174":73149,"_21594":121704,"_5":14861,"_28366":121619,"_3078":121705},[],"Localiza el pod y Service de authz.",{"_3627":73187,"_31174":73149,"_21594":121707,"_5":14861,"_28366":121619,"_3078":121708},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3627":73188,"_31174":73149,"_21594":121710,"_5":14861,"_28366":121619,"_3078":121711},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3627":73189,"_31174":73149,"_21594":121713,"_5":14861,"_28366":121619,"_3078":121714},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3627":73190,"_31174":73149,"_21594":121716,"_5":14861,"_28366":121619,"_3078":121717},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3627":73191,"_31174":73149,"_21594":121719,"_5":14861,"_28366":121623,"_3078":121720},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3627":73192,"_31174":73149,"_21594":121722,"_5":14861,"_28366":121627,"_3078":121723},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3627":73193,"_31174":73149,"_21594":121725,"_5":14861,"_28366":121627,"_3078":121726},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3627":73194,"_31174":73149,"_21594":121728,"_5":14861,"_28366":121627,"_3078":121729},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3627":73195,"_31174":73149,"_21594":121731,"_5":14861,"_28366":121627,"_3078":121732},[],"volumen persistente sin enlazar;",{"_3627":73196,"_31174":73149,"_21594":121734,"_5":14861,"_28366":121627,"_3078":121735},[],"imagen inaccesible o política de pull incorrecta;",{"_3627":73197,"_31174":73149,"_21594":121737,"_5":14861,"_28366":121627,"_3078":121738},[],"configuración inválida del motor criptográfico;",{"_3627":73198,"_31174":73149,"_21594":121740,"_5":14861,"_28366":121627,"_3078":121741},[],"límites de CPU o memoria demasiado bajos;",{"_3627":73199,"_31174":73149,"_21594":121743,"_5":14861,"_28366":121627,"_3078":121744},[],"migración previa incompleta.",{"_3627":73200,"_31174":73149,"_21594":121746,"_5":14861,"_28366":121627,"_3078":121747},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3627":73201,"_31174":73149,"_21594":121749,"_5":14861,"_28366":121627,"_3078":121750},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3627":73202,"_31174":73149,"_21594":121752,"_5":14861,"_28366":121627,"_3078":121753},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3627":73203,"_31174":73149,"_21594":121755,"_5":14861,"_28366":121631,"_3078":121756},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3627":73204,"_31174":73149,"_21594":121758,"_5":14861,"_28366":121631,"_3078":121759},[],"verifica que esté habilitado en el servicio emisor;",{"_3627":73205,"_31174":73149,"_21594":121761,"_5":14861,"_28366":121631,"_3078":121762},[],"comprueba conectividad y credenciales AMQP;",{"_3627":73206,"_31174":73149,"_21594":121764,"_5":14861,"_28366":121631,"_3078":121765},[],"revisa exchange, routing key, colas y consumidores;",{"_3627":73207,"_31174":73149,"_21594":121767,"_5":14861,"_28366":121631,"_3078":121768},[],"inspecciona dead-letter queues;",{"_3627":73208,"_31174":73149,"_21594":121770,"_5":14861,"_28366":121631,"_3078":121771},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3627":73209,"_31174":73149,"_21594":121773,"_5":14861,"_28366":121631,"_3078":121774},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3627":73210,"_31174":73149,"_21594":121776,"_5":14861,"_28366":121631,"_3078":121777},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3627":73211,"_31174":73149,"_21594":121779,"_5":14861,"_28366":121631,"_3078":121780},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3627":73212,"_31174":73149,"_21594":121782,"_5":14861,"_28366":121631,"_3078":121783},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3627":73213,"_31174":73149,"_21594":121785,"_5":14861,"_28366":121631,"_3078":121786},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3627":73214,"_31174":73149,"_21594":121788,"_5":14861,"_28366":121631,"_3078":121789},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3627":73215,"_31174":73149,"_21594":121791,"_5":14861,"_28366":121631,"_3078":121792},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3627":73216,"_31174":73149,"_21594":121794,"_5":14861,"_28366":121635,"_3078":121795},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3627":73217,"_31174":73149,"_21594":121797,"_5":14861,"_28366":121635,"_3078":121798},[],"Antes de cerrar una incidencia, guarda:",{"_3627":73218,"_31174":73149,"_21594":121800,"_5":14861,"_28366":121635,"_3078":121801},[],"causa confirmada;",{"_3627":73219,"_31174":73149,"_21594":121803,"_5":14861,"_28366":121635,"_3078":121804},[],"alcance temporal y recursos afectados;",{"_3627":73220,"_31174":73149,"_21594":121806,"_5":14861,"_28366":121635,"_3078":121807},[],"comandos o consultas utilizados;",{"_3627":73221,"_31174":73149,"_21594":121809,"_5":14861,"_28366":121635,"_3078":121810},[],"cambio aplicado y forma de revertirlo;",{"_3627":73222,"_31174":73149,"_21594":121812,"_5":14861,"_28366":121635,"_3078":121813},[],"validación desde un consumidor;",{"_3627":73223,"_31174":73149,"_21594":121815,"_5":14861,"_28366":121635,"_3078":121816},[],"acción preventiva y propietario.",{"_3627":73224,"_31174":73224,"_5":15221,"_3078":121818,"_31533":121819,"_21594":121823,"_28366":73224},"Modelo de datos",[50951,121820,121821,121822],"Plataforma","Administración","Control de acceso",[],{"_3627":73225,"_31174":73224,"_21594":121825,"_5":14861,"_28366":73224,"_3078":121826},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3627":73226,"_31174":73224,"_5":31530,"_21594":121828,"_28366":121829,"_3078":121830},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3627":73227,"_31174":73224,"_5":31530,"_21594":121832,"_28366":121833,"_3078":121834},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3627":73228,"_31174":73224,"_21594":121836,"_5":14861,"_28366":73224,"_3078":121837},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3627":73229,"_31174":73224,"_21594":121839,"_5":14861,"_28366":121829,"_3078":121840},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3627":73230,"_31174":73224,"_21594":121842,"_5":14861,"_28366":121829,"_3078":121843},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3627":73231,"_31174":73224,"_21594":121845,"_5":14861,"_28366":121829,"_3078":121846},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3627":73232,"_31174":73224,"_21594":121848,"_5":14861,"_28366":121833,"_3078":121849},[],"Entidad (`schema_name.entity_type`)",{"_3627":73233,"_31174":73224,"_21594":121851,"_5":14861,"_28366":121833,"_3078":121852},[],"Tabla (`table_name`)",{"_3627":73234,"_31174":73224,"_21594":121854,"_5":14861,"_28366":121833,"_3078":121855},[],"Clave (`primary_key`)",{"_3627":73235,"_31174":73224,"_21594":121857,"_5":14861,"_28366":121833,"_3078":52501},[],{"_3627":73236,"_31174":73224,"_21594":121859,"_5":14861,"_28366":121833,"_3078":52504},[],{"_3627":73237,"_31174":73224,"_21594":121861,"_5":14861,"_28366":121833,"_3078":52507},[],{"_3627":73238,"_31174":73224,"_21594":121863,"_5":14861,"_28366":121833,"_3078":52510},[],{"_3627":73239,"_31174":73224,"_21594":121865,"_5":14861,"_28366":121833,"_3078":52513},[],{"_3627":73240,"_31174":73224,"_21594":121867,"_5":14861,"_28366":121833,"_3078":52516},[],{"_3627":73241,"_31174":73224,"_21594":121869,"_5":14861,"_28366":121833,"_3078":52519},[],{"_3627":73242,"_31174":73224,"_21594":121871,"_5":14861,"_28366":121833,"_3078":52522},[],{"_3627":73243,"_31174":73224,"_21594":121873,"_5":14861,"_28366":121833,"_3078":52516},[],{"_3627":73244,"_31174":73224,"_21594":121875,"_5":14861,"_28366":121833,"_3078":52527},[],{"_3627":73245,"_31174":73224,"_21594":121877,"_5":14861,"_28366":121833,"_3078":52530},[],{"_3627":73246,"_31174":73224,"_21594":121879,"_5":14861,"_28366":121833,"_3078":52533},[],{"_3627":73247,"_31174":73224,"_21594":121881,"_5":14861,"_28366":121833,"_3078":52536},[],{"_3627":73248,"_31174":73224,"_21594":121883,"_5":14861,"_28366":121833,"_3078":52539},[],{"_3627":73249,"_31174":73224,"_21594":121885,"_5":14861,"_28366":121833,"_3078":52516},[],{"_3627":73250,"_31174":73224,"_21594":121887,"_5":14861,"_28366":121833,"_3078":52544},[],{"_3627":73251,"_31174":73224,"_21594":121889,"_5":14861,"_28366":121833,"_3078":52547},[],{"_3627":73252,"_31174":73224,"_21594":121891,"_5":14861,"_28366":121833,"_3078":52516},[],{"_3627":73253,"_31174":73224,"_21594":121893,"_5":14861,"_28366":121833,"_3078":52552},[],{"_3627":73254,"_31174":73224,"_21594":121895,"_5":14861,"_28366":121833,"_3078":52555},[],{"_3627":73255,"_31174":73224,"_21594":121897,"_5":14861,"_28366":121833,"_3078":52516},[],{"_3627":73256,"_31174":73224,"_21594":121899,"_5":14861,"_28366":121833,"_3078":52560},[],{"_3627":73257,"_31174":73224,"_21594":121901,"_5":14861,"_28366":121833,"_3078":52563},[],{"_3627":73258,"_31174":73224,"_21594":121903,"_5":14861,"_28366":121833,"_3078":52516},[],{"_3627":73259,"_31174":73224,"_21594":121905,"_5":14861,"_28366":121833,"_3078":52568},[],{"_3627":73260,"_31174":73224,"_21594":121907,"_5":14861,"_28366":121833,"_3078":52571},[],{"_3627":73261,"_31174":73224,"_21594":121909,"_5":14861,"_28366":121833,"_3078":52574},[],{"_3627":73262,"_31174":73224,"_21594":121911,"_5":14861,"_28366":121833,"_3078":52577},[],{"_3627":73263,"_31174":73224,"_21594":121913,"_5":14861,"_28366":121833,"_3078":52580},[],{"_3627":73264,"_31174":73224,"_21594":121915,"_5":14861,"_28366":121833,"_3078":52583},[],{"_3627":73265,"_31174":73224,"_21594":121917,"_5":14861,"_28366":121833,"_3078":121918},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3627":73266,"_31174":73224,"_21594":121920,"_5":14861,"_28366":121833,"_3078":121921},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3627":73267,"_31174":73224,"_21594":121923,"_5":14861,"_28366":121833,"_3078":121924},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3627":73268,"_31174":73268,"_5":15221,"_3078":121926,"_31533":121927,"_21594":121928,"_28366":73268},"Visión general del control de acceso",[50951,121820,121821,121822],[],{"_3627":73269,"_31174":73268,"_21594":121930,"_5":14861,"_28366":73268,"_3078":121931},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3627":73270,"_31174":73268,"_5":31530,"_21594":121933,"_28366":121934,"_3078":121935},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3627":73271,"_31174":73268,"_5":31530,"_21594":121937,"_28366":121938,"_3078":121939},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3627":73272,"_31174":73268,"_5":31530,"_21594":121941,"_28366":121942,"_3078":121943},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3627":73273,"_31174":73268,"_5":31530,"_21594":121945,"_28366":121946,"_3078":121947},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3627":73274,"_31174":73268,"_5":31530,"_21594":121949,"_28366":121950,"_3078":121951},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3627":73275,"_31174":73268,"_5":31530,"_21594":121953,"_28366":121954,"_3078":121955},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3627":73276,"_31174":73268,"_5":31530,"_21594":121957,"_28366":121958,"_3078":121959},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3627":73277,"_31174":73268,"_5":31530,"_21594":121961,"_28366":121962,"_3078":121963},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3627":73278,"_31174":73268,"_5":31530,"_21594":121965,"_28366":121966,"_3078":121967},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3627":73279,"_31174":73268,"_5":31530,"_21594":121969,"_28366":121970,"_3078":121971},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3627":73280,"_31174":73268,"_5":31530,"_21594":121973,"_28366":121974,"_3078":121975},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3627":73281,"_31174":73268,"_5":31530,"_21594":121977,"_28366":121978,"_3078":121979},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3627":73282,"_31174":73268,"_5":31530,"_21594":121981,"_28366":121982,"_3078":121983},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3627":73283,"_31174":73268,"_5":31530,"_21594":121985,"_28366":121986,"_3078":121987},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3627":73284,"_31174":73268,"_5":31530,"_21594":121989,"_28366":121990,"_3078":121991},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3627":73285,"_31174":73268,"_5":31530,"_21594":121993,"_28366":121994,"_3078":120961},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3627":73286,"_31174":73268,"_5":31530,"_21594":121996,"_28366":121997,"_3078":121998},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3627":73287,"_31174":73268,"_5":31530,"_21594":122000,"_28366":122001,"_3078":122002},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3627":73288,"_31174":73268,"_5":31530,"_21594":122004,"_28366":122005,"_3078":122006},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3627":73289,"_31174":73268,"_5":31530,"_21594":122008,"_28366":122009,"_3078":122010},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3627":73290,"_31174":73268,"_5":31530,"_21594":122012,"_28366":122013,"_3078":122014},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3627":73291,"_31174":73268,"_5":31530,"_21594":122016,"_28366":122017,"_3078":122018},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3627":73292,"_31174":73268,"_5":31530,"_21594":122020,"_28366":122021,"_3078":122022},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3627":73293,"_31174":73268,"_5":31530,"_21594":122024,"_28366":122025,"_3078":122026},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3627":73294,"_31174":73268,"_5":31530,"_21594":122028,"_28366":122029,"_3078":122030},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3627":73295,"_31174":73268,"_5":31530,"_21594":122032,"_28366":122033,"_3078":122034},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3627":73296,"_31174":73268,"_5":31530,"_21594":122036,"_28366":122037,"_3078":122038},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3627":73297,"_31174":73268,"_5":31530,"_21594":122040,"_28366":122041,"_3078":122042},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3627":73298,"_31174":73268,"_5":31530,"_21594":122044,"_28366":122045,"_3078":122046},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3627":73299,"_31174":73268,"_5":31530,"_21594":122048,"_28366":122049,"_3078":122050},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3627":73300,"_31174":73268,"_5":31530,"_21594":122052,"_28366":122053,"_3078":122054},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3627":73301,"_31174":73268,"_21594":122056,"_5":14861,"_28366":73268,"_3078":122057},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3627":73302,"_31174":73268,"_21594":122059,"_5":14861,"_28366":73268,"_3078":122060},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3627":73303,"_31174":73268,"_21594":122062,"_5":14861,"_28366":73268,"_3078":122063},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3627":73304,"_31174":73268,"_21594":122065,"_5":14861,"_28366":121934,"_3078":122066},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3627":73305,"_31174":73268,"_21594":122068,"_5":14861,"_28366":121934,"_3078":122069},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3627":73306,"_31174":73268,"_21594":122071,"_5":14861,"_28366":121934,"_3078":122072},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3627":73307,"_31174":73268,"_21594":122074,"_5":14861,"_28366":121934,"_3078":122075},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3627":73308,"_31174":73268,"_21594":122077,"_5":14861,"_28366":121934,"_3078":122078},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3627":73309,"_31174":73268,"_21594":122080,"_5":14861,"_28366":121934,"_3078":122081},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3627":73310,"_31174":73268,"_21594":122083,"_5":14861,"_28366":121938,"_3078":122084},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3627":73311,"_31174":73268,"_21594":122086,"_5":14861,"_28366":121938,"_3078":122087},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3627":73312,"_31174":73268,"_21594":122089,"_5":14861,"_28366":121942,"_3078":122090},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3627":73313,"_31174":73268,"_21594":122092,"_5":14861,"_28366":121942,"_3078":122093},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3627":73314,"_31174":73268,"_21594":122095,"_5":14861,"_28366":121942,"_3078":122096},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3627":73315,"_31174":73268,"_21594":122098,"_5":14861,"_28366":121942,"_3078":122099},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3627":73316,"_31174":73268,"_21594":122101,"_5":14861,"_28366":121942,"_3078":122102},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3627":73317,"_31174":73268,"_21594":122104,"_5":14861,"_28366":121942,"_3078":122105},[],"Carga por separado las políticas concedidas a cada principal.",{"_3627":73318,"_31174":73268,"_21594":122107,"_5":14861,"_28366":121942,"_3078":122108},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3627":73319,"_31174":73268,"_21594":122110,"_5":14861,"_28366":121942,"_3078":122111},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3627":73320,"_31174":73268,"_21594":122113,"_5":14861,"_28366":121942,"_3078":122114},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3627":73321,"_31174":73268,"_21594":122116,"_5":14861,"_28366":121942,"_3078":122117},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3627":73322,"_31174":73268,"_21594":122119,"_5":14861,"_28366":121942,"_3078":122120},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3627":73323,"_31174":73268,"_21594":122122,"_5":14861,"_28366":121942,"_3078":122123},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3627":73324,"_31174":73268,"_21594":122125,"_5":14861,"_28366":121946,"_3078":122126},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3627":73325,"_31174":73268,"_21594":122128,"_5":14861,"_28366":121946,"_3078":122129},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3627":73326,"_31174":73268,"_21594":122131,"_5":14861,"_28366":121946,"_3078":122132},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3627":73327,"_31174":73268,"_21594":122134,"_5":14861,"_28366":121946,"_3078":122135},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3627":73328,"_31174":73268,"_21594":122137,"_5":14861,"_28366":121946,"_3078":122138},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3627":73329,"_31174":73268,"_21594":122140,"_5":14861,"_28366":121946,"_3078":122141},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3627":73330,"_31174":73268,"_21594":122143,"_5":14861,"_28366":121946,"_3078":122144},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3627":73331,"_31174":73268,"_21594":122146,"_5":14861,"_28366":121946,"_3078":122147},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3627":73332,"_31174":73268,"_21594":122149,"_5":14861,"_28366":121946,"_3078":122150},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3627":73333,"_31174":73268,"_21594":122152,"_5":14861,"_28366":121946,"_3078":122153},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3627":73334,"_31174":73268,"_21594":122155,"_5":14861,"_28366":121950,"_3078":122156},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3627":73335,"_31174":73268,"_21594":122158,"_5":14861,"_28366":121950,"_3078":122159},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3627":73336,"_31174":73268,"_21594":122161,"_5":14861,"_28366":121950,"_3078":122162},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3627":73337,"_31174":73268,"_21594":122164,"_5":14861,"_28366":121950,"_3078":122165},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3627":73338,"_31174":73268,"_21594":122167,"_5":14861,"_28366":121950,"_3078":122168},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3627":73339,"_31174":73268,"_21594":122170,"_5":14861,"_28366":121950,"_3078":122171},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3627":73340,"_31174":73268,"_21594":122173,"_5":14861,"_28366":121950,"_3078":122174},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3627":73341,"_31174":73268,"_21594":122176,"_5":14861,"_28366":121950,"_3078":122177},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3627":73342,"_31174":73268,"_21594":122179,"_5":14861,"_28366":121950,"_3078":122180},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3627":73343,"_31174":73268,"_21594":122182,"_5":14861,"_28366":121950,"_3078":122183},[],"Las acciones se dividen en dos grupos:",{"_3627":73344,"_31174":73268,"_21594":122185,"_5":14861,"_28366":121950,"_3078":122186},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3627":73345,"_31174":73268,"_21594":122188,"_5":14861,"_28366":121950,"_3078":122189},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3627":73346,"_31174":73268,"_21594":122191,"_5":14861,"_28366":121950,"_3078":122192},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3627":73347,"_31174":73268,"_21594":122194,"_5":14861,"_28366":121954,"_3078":122195},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3627":73348,"_31174":73268,"_21594":122197,"_5":14861,"_28366":121954,"_3078":122198},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3627":73349,"_31174":73268,"_21594":122200,"_5":14861,"_28366":121954,"_3078":122201},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3627":73350,"_31174":73268,"_21594":122203,"_5":14861,"_28366":121958,"_3078":122204},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3627":73351,"_31174":73268,"_21594":122206,"_5":14861,"_28366":121958,"_3078":122207},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3627":73352,"_31174":73268,"_21594":122209,"_5":14861,"_28366":121958,"_3078":122210},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3627":73353,"_31174":73268,"_21594":122212,"_5":14861,"_28366":121958,"_3078":122213},[],"Los operadores implementados son:",{"_3627":73354,"_31174":73268,"_21594":122215,"_5":14861,"_28366":121958,"_3078":122216},[],"`equals`, para igualdad exacta;",{"_3627":73355,"_31174":73268,"_21594":122218,"_5":14861,"_28366":121958,"_3078":122219},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3627":73356,"_31174":73268,"_21594":122221,"_5":14861,"_28366":121958,"_3078":122222},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3627":73357,"_31174":73268,"_21594":122224,"_5":14861,"_28366":121958,"_3078":122225},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3627":73358,"_31174":73268,"_21594":122227,"_5":14861,"_28366":121962,"_3078":122228},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3627":73359,"_31174":73268,"_21594":122230,"_5":14861,"_28366":121962,"_3078":122231},[],"Los modos disponibles son:",{"_3627":73360,"_31174":73268,"_21594":122233,"_5":14861,"_28366":121962,"_3078":122234},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3627":73361,"_31174":73268,"_21594":122236,"_5":14861,"_28366":121962,"_3078":122237},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3627":73362,"_31174":73268,"_21594":122239,"_5":14861,"_28366":121962,"_3078":122240},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3627":73363,"_31174":73268,"_21594":122242,"_5":14861,"_28366":121962,"_3078":122243},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3627":73364,"_31174":73268,"_21594":122245,"_5":14861,"_28366":121962,"_3078":122246},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3627":73365,"_31174":73268,"_21594":122248,"_5":14861,"_28366":121962,"_3078":122249},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3627":73366,"_31174":73268,"_21594":122251,"_5":14861,"_28366":121966,"_3078":122252},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3627":73367,"_31174":73268,"_21594":122254,"_5":14861,"_28366":121966,"_3078":122255},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3627":73368,"_31174":73268,"_21594":122257,"_5":14861,"_28366":121966,"_3078":122258},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3627":73369,"_31174":73268,"_21594":122260,"_5":14861,"_28366":121966,"_3078":122261},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3627":73370,"_31174":73268,"_21594":122263,"_5":14861,"_28366":121974,"_3078":122264},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3627":73371,"_31174":73268,"_21594":122266,"_5":14861,"_28366":121974,"_3078":122267},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3627":73372,"_31174":73268,"_21594":122269,"_5":14861,"_28366":121978,"_3078":122270},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3627":73373,"_31174":73268,"_21594":122272,"_5":14861,"_28366":121978,"_3078":122273},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3627":73374,"_31174":73268,"_21594":122275,"_5":14861,"_28366":121978,"_3078":122276},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3627":73375,"_31174":73268,"_21594":122278,"_5":14861,"_28366":121978,"_3078":122279},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3627":73376,"_31174":73268,"_21594":122281,"_5":14861,"_28366":121978,"_3078":122282},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3627":73377,"_31174":73268,"_21594":122284,"_5":14861,"_28366":121982,"_3078":122285},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3627":73378,"_31174":73268,"_21594":122287,"_5":14861,"_28366":121982,"_3078":122288},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3627":73379,"_31174":73268,"_21594":122290,"_5":14861,"_28366":121982,"_3078":122291},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3627":73380,"_31174":73268,"_21594":122293,"_5":14861,"_28366":121986,"_3078":122294},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3627":73381,"_31174":73268,"_21594":122296,"_5":14861,"_28366":121986,"_3078":122297},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3627":73382,"_31174":73268,"_21594":122299,"_5":14861,"_28366":121986,"_3078":122300},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3627":73383,"_31174":73268,"_21594":122302,"_5":14861,"_28366":121986,"_3078":122303},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3627":73384,"_31174":73268,"_21594":122305,"_5":14861,"_28366":121986,"_3078":122306},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3627":73385,"_31174":73268,"_21594":122308,"_5":14861,"_28366":121986,"_3078":122309},[],"Ten en cuenta que:",{"_3627":73386,"_31174":73268,"_21594":122311,"_5":14861,"_28366":121986,"_3078":122312},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3627":73387,"_31174":73268,"_21594":122314,"_5":14861,"_28366":121986,"_3078":122315},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3627":73388,"_31174":73268,"_21594":122317,"_5":14861,"_28366":121986,"_3078":122318},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3627":73389,"_31174":73268,"_21594":122320,"_5":14861,"_28366":121990,"_3078":122321},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3627":73390,"_31174":73268,"_21594":122323,"_5":14861,"_28366":121990,"_3078":122324},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3627":73391,"_31174":73268,"_21594":122326,"_5":14861,"_28366":121990,"_3078":122327},[],"acceso completo y de solo lectura a KMS;",{"_3627":73392,"_31174":73268,"_21594":122329,"_5":14861,"_28366":121990,"_3078":122330},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3627":73393,"_31174":73268,"_21594":122332,"_5":14861,"_28366":121990,"_3078":122333},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3627":73394,"_31174":73268,"_21594":122335,"_5":14861,"_28366":121990,"_3078":122336},[],"acceso a la interfaz;",{"_3627":73395,"_31174":73268,"_21594":122338,"_5":14861,"_28366":121990,"_3078":122339},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3627":73396,"_31174":73268,"_21594":122341,"_5":14861,"_28366":121990,"_3078":122342},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3627":73397,"_31174":73268,"_21594":122344,"_5":14861,"_28366":121990,"_3078":122345},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3627":73398,"_31174":73268,"_21594":122347,"_5":14861,"_28366":121990,"_3078":122348},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3627":73399,"_31174":73268,"_21594":122350,"_5":14861,"_28366":121990,"_3078":122351},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3627":73400,"_31174":73268,"_21594":122353,"_5":14861,"_28366":121994,"_3078":122354},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3627":73401,"_31174":73268,"_21594":122356,"_5":14861,"_28366":121994,"_3078":122357},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3627":73402,"_31174":73268,"_21594":122359,"_5":14861,"_28366":121994,"_3078":122360},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3627":73403,"_31174":73268,"_21594":122362,"_5":14861,"_28366":121997,"_3078":122363},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3627":73404,"_31174":73268,"_21594":122365,"_5":14861,"_28366":122001,"_3078":122366},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3627":73405,"_31174":73268,"_21594":122368,"_5":14861,"_28366":122001,"_3078":122369},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3627":73406,"_31174":73268,"_21594":122371,"_5":14861,"_28366":122005,"_3078":122372},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3627":73407,"_31174":73268,"_21594":122374,"_5":14861,"_28366":122009,"_3078":122375},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3627":73408,"_31174":73268,"_21594":122377,"_5":14861,"_28366":122013,"_3078":122378},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3627":73409,"_31174":73268,"_21594":122380,"_5":14861,"_28366":122017,"_3078":122381},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3627":73410,"_31174":73268,"_21594":122383,"_5":14861,"_28366":122017,"_3078":122384},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3627":73411,"_31174":73268,"_21594":122386,"_5":14861,"_28366":122021,"_3078":122387},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3627":73412,"_31174":73268,"_21594":122389,"_5":14861,"_28366":122021,"_3078":122390},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3627":73413,"_31174":73268,"_21594":122392,"_5":14861,"_28366":122021,"_3078":122393},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3627":73414,"_31174":73268,"_21594":122395,"_5":14861,"_28366":122021,"_3078":122396},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3627":73415,"_31174":73268,"_21594":122398,"_5":14861,"_28366":122021,"_3078":122399},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3627":73416,"_31174":73268,"_21594":122401,"_5":14861,"_28366":122021,"_3078":122402},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3627":73417,"_31174":73268,"_21594":122404,"_5":14861,"_28366":122021,"_3078":122405},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3627":73418,"_31174":73268,"_21594":122407,"_5":14861,"_28366":122021,"_3078":122408},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3627":73419,"_31174":73268,"_21594":122410,"_5":14861,"_28366":122025,"_3078":122411},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3627":73420,"_31174":73268,"_21594":122413,"_5":14861,"_28366":122025,"_3078":122414},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3627":73421,"_31174":73268,"_21594":122416,"_5":14861,"_28366":122025,"_3078":122417},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3627":73422,"_31174":73268,"_21594":122419,"_5":14861,"_28366":122029,"_3078":122420},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3627":73423,"_31174":73268,"_21594":122422,"_5":14861,"_28366":122029,"_3078":122423},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3627":73424,"_31174":73268,"_21594":122425,"_5":14861,"_28366":122029,"_3078":122426},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3627":73425,"_31174":73268,"_21594":122428,"_5":14861,"_28366":122029,"_3078":122429},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3627":73426,"_31174":73268,"_21594":122431,"_5":14861,"_28366":122029,"_3078":122432},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3627":73427,"_31174":73268,"_21594":122434,"_5":14861,"_28366":122029,"_3078":122435},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3627":73428,"_31174":73268,"_21594":122437,"_5":14861,"_28366":122029,"_3078":122438},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3627":73429,"_31174":73268,"_21594":122440,"_5":14861,"_28366":122029,"_3078":122441},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3627":73430,"_31174":73268,"_21594":122443,"_5":14861,"_28366":122037,"_3078":122444},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3627":73431,"_31174":73268,"_21594":122446,"_5":14861,"_28366":122041,"_3078":122447},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3627":73432,"_31174":73268,"_21594":122449,"_5":14861,"_28366":122041,"_3078":122450},[],"que exista un principal activo del tipo correcto;",{"_3627":73433,"_31174":73268,"_21594":122452,"_5":14861,"_28366":122041,"_3078":122453},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3627":73434,"_31174":73268,"_21594":122455,"_5":14861,"_28366":122041,"_3078":122456},[],"que todas las condiciones del principal se cumplan;",{"_3627":73435,"_31174":73268,"_21594":122458,"_5":14861,"_28366":122041,"_3078":122459},[],"que el principal tenga concedida la política esperada;",{"_3627":73436,"_31174":73268,"_21594":122461,"_5":14861,"_28366":122041,"_3078":122462},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3627":73437,"_31174":73268,"_21594":122464,"_5":14861,"_28366":122041,"_3078":122465},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3627":73438,"_31174":73268,"_21594":122467,"_5":14861,"_28366":122041,"_3078":122468},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3627":73439,"_31174":73268,"_21594":122470,"_5":14861,"_28366":122041,"_3078":122471},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3627":73440,"_31174":73268,"_21594":122473,"_5":14861,"_28366":122045,"_3078":122474},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3627":73441,"_31174":73268,"_21594":122476,"_5":14861,"_28366":122049,"_3078":122477},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3627":73442,"_31174":73268,"_21594":122479,"_5":14861,"_28366":122053,"_3078":122480},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3627":73443,"_31174":73268,"_21594":122482,"_5":14861,"_28366":122053,"_3078":122483},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3627":73444,"_31174":73444,"_5":15221,"_3078":122485,"_31533":122486,"_21594":122487,"_28366":73444},"Alertas y suscripciones",[50951,121820,121821],[],{"_3627":73445,"_31174":73444,"_21594":122489,"_5":14861,"_28366":73444,"_3078":122490},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3627":73446,"_31174":73444,"_5":31530,"_21594":122492,"_28366":122493,"_3078":122494},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3627":73447,"_31174":73444,"_5":31530,"_21594":122496,"_28366":122497,"_3078":122498},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3627":73448,"_31174":73444,"_5":31530,"_21594":122500,"_28366":122501,"_3078":122502},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3627":73449,"_31174":73444,"_5":31530,"_21594":122504,"_28366":122505,"_3078":122506},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3627":73450,"_31174":73444,"_5":31530,"_21594":122508,"_28366":122509,"_3078":122510},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3627":73451,"_31174":73444,"_5":31530,"_21594":122512,"_28366":122513,"_3078":122514},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3627":73452,"_31174":73444,"_5":31530,"_21594":122516,"_28366":122517,"_3078":122518},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3627":73453,"_31174":73444,"_5":31530,"_21594":122520,"_28366":122521,"_3078":122522},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3627":73454,"_31174":73444,"_5":31530,"_21594":122524,"_28366":122525,"_3078":122526},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3627":73455,"_31174":73444,"_5":31530,"_21594":122528,"_28366":122529,"_3078":122530},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3627":73456,"_31174":73444,"_5":31530,"_21594":122532,"_28366":122533,"_3078":122534},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3627":73457,"_31174":73444,"_21594":122536,"_5":14861,"_28366":73444,"_3078":122537},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3627":73458,"_31174":73444,"_21594":122539,"_5":14861,"_28366":122493,"_3078":122540},[],"Un servicio publica un evento de dominio.",{"_3627":73459,"_31174":73444,"_21594":122542,"_5":14861,"_28366":122493,"_3078":122543},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3627":73460,"_31174":73444,"_21594":122545,"_5":14861,"_28366":122493,"_3078":122546},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3627":73461,"_31174":73444,"_21594":122548,"_5":14861,"_28366":122493,"_3078":122549},[],"Lamassu entrega el evento al canal configurado.",{"_3627":73462,"_31174":73444,"_21594":122551,"_5":14861,"_28366":122493,"_3078":122552},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3627":73463,"_31174":73444,"_21594":122554,"_5":14861,"_28366":122497,"_3078":122555},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3627":73464,"_31174":73444,"_21594":122557,"_5":14861,"_28366":122497,"_3078":122558},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3627":73465,"_31174":73444,"_21594":122560,"_5":14861,"_28366":122497,"_3078":122561},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3627":73466,"_31174":73444,"_21594":122563,"_5":14861,"_28366":122497,"_3078":122564},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3627":73467,"_31174":73444,"_21594":122566,"_5":14861,"_28366":122497,"_3078":122567},[],"`apikey_options` necesita `header` y `key`.",{"_3627":73468,"_31174":73444,"_21594":122569,"_5":14861,"_28366":122497,"_3078":122570},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3627":73469,"_31174":73444,"_21594":122572,"_5":14861,"_28366":122497,"_3078":122573},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3627":73470,"_31174":73444,"_21594":122575,"_5":14861,"_28366":122497,"_3078":122576},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3627":73471,"_31174":73444,"_21594":122578,"_5":14861,"_28366":122505,"_3078":122579},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3627":73472,"_31174":73444,"_21594":122581,"_5":14861,"_28366":122509,"_3078":122582},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3627":73473,"_31174":73444,"_21594":122584,"_5":14861,"_28366":122513,"_3078":122585},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3627":73474,"_31174":73444,"_21594":122587,"_5":14861,"_28366":122513,"_3078":122588},[],"**None** notifica todas las instancias del evento.",{"_3627":73475,"_31174":73444,"_21594":122590,"_5":14861,"_28366":122513,"_3078":122591},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3627":73476,"_31174":73444,"_21594":122593,"_5":14861,"_28366":122513,"_3078":122594},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3627":73477,"_31174":73444,"_21594":122596,"_5":14861,"_28366":122513,"_3078":122597},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3627":73478,"_31174":73444,"_21594":122599,"_5":14861,"_28366":122513,"_3078":122600},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3627":73479,"_31174":73444,"_21594":122602,"_5":14861,"_28366":122513,"_3078":122603},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3627":73480,"_31174":73444,"_21594":122605,"_5":14861,"_28366":122517,"_3078":122606},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3627":73481,"_31174":73444,"_21594":122608,"_5":14861,"_28366":122521,"_3078":122609},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3627":73482,"_31174":73444,"_21594":122611,"_5":14861,"_28366":122521,"_3078":122612},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3627":73483,"_31174":73444,"_21594":122614,"_5":14861,"_28366":122521,"_3078":122615},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3627":73484,"_31174":73444,"_21594":122617,"_5":14861,"_28366":122521,"_3078":122618},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3627":73485,"_31174":73444,"_21594":122620,"_5":14861,"_28366":122521,"_3078":122621},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3627":73486,"_31174":73444,"_21594":122623,"_5":14861,"_28366":122521,"_3078":122624},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3627":73487,"_31174":73444,"_21594":122626,"_5":14861,"_28366":122521,"_3078":122627},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3627":73488,"_31174":73444,"_21594":122629,"_5":14861,"_28366":122521,"_3078":122630},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3627":73489,"_31174":73444,"_21594":122632,"_5":14861,"_28366":122525,"_3078":122633},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3627":73490,"_31174":73444,"_21594":122635,"_5":14861,"_28366":122525,"_3078":122636},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3627":73491,"_31174":73444,"_21594":122638,"_5":14861,"_28366":122525,"_3078":122639},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3627":73492,"_31174":73444,"_21594":122641,"_5":14861,"_28366":122525,"_3078":122642},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3627":73493,"_31174":73444,"_21594":122644,"_5":14861,"_28366":122525,"_3078":122645},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3627":73494,"_31174":73444,"_21594":122647,"_5":14861,"_28366":122525,"_3078":122648},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3627":73495,"_31174":73444,"_21594":122650,"_5":14861,"_28366":122525,"_3078":122651},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3627":73496,"_31174":73444,"_21594":122653,"_5":14861,"_28366":122525,"_3078":122654},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3627":73497,"_31174":73444,"_21594":122656,"_5":14861,"_28366":122529,"_3078":122657},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3627":73498,"_31174":73444,"_21594":122659,"_5":14861,"_28366":122529,"_3078":122660},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3627":73499,"_31174":73444,"_21594":122662,"_5":14861,"_28366":122533,"_3078":122663},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3627":73500,"_31174":73444,"_21594":122665,"_5":14861,"_28366":122533,"_3078":122666},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3627":73501,"_31174":73444,"_21594":122668,"_5":14861,"_28366":122533,"_3078":122669},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3627":73502,"_31174":73444,"_21594":122671,"_5":14861,"_28366":122533,"_3078":122672},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3627":73503,"_31174":73444,"_21594":122674,"_5":14861,"_28366":122533,"_3078":122675},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3627":73504,"_31174":73444,"_21594":122677,"_5":14861,"_28366":122533,"_3078":122678},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3627":73505,"_31174":73444,"_21594":122680,"_5":14861,"_28366":122533,"_3078":122681},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3627":73506,"_31174":73444,"_21594":122683,"_5":14861,"_28366":122533,"_3078":122684},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3627":73507,"_31174":73444,"_21594":122686,"_5":14861,"_28366":122533,"_3078":122687},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3627":73508,"_31174":73444,"_21594":122689,"_5":14861,"_28366":122533,"_3078":122690},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3627":73509,"_31174":73509,"_5":15221,"_3078":122692,"_31533":122693,"_21594":122694,"_28366":73509},"Registros de auditoría",[50951,121820,121821],[],{"_3627":73510,"_31174":73509,"_21594":122696,"_5":14861,"_28366":73509,"_3078":122697},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3627":73511,"_31174":73509,"_5":31530,"_21594":122699,"_28366":122700,"_3078":122701},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3627":73512,"_31174":73509,"_5":31530,"_21594":122703,"_28366":122704,"_3078":122705},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3627":73513,"_31174":73509,"_5":31530,"_21594":122707,"_28366":122708,"_3078":122709},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3627":73514,"_31174":73509,"_5":31530,"_21594":122711,"_28366":122712,"_3078":122713},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3627":73515,"_31174":73509,"_5":31530,"_21594":122715,"_28366":122716,"_3078":122717},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3627":73516,"_31174":73509,"_5":31530,"_21594":122719,"_28366":122720,"_3078":122721},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3627":73517,"_31174":73509,"_5":31530,"_21594":122723,"_28366":122724,"_3078":122725},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3627":73518,"_31174":73509,"_5":31530,"_21594":122727,"_28366":122728,"_3078":122729},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3627":73519,"_31174":73509,"_5":31530,"_21594":122731,"_28366":122732,"_3078":122733},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3627":73520,"_31174":73509,"_5":31530,"_21594":122735,"_28366":122736,"_3078":122737},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3627":73521,"_31174":73509,"_5":31530,"_21594":122739,"_28366":122740,"_3078":122741},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3627":73522,"_31174":73509,"_21594":122743,"_5":14861,"_28366":73509,"_3078":122744},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3627":73523,"_31174":73509,"_21594":122746,"_5":14861,"_28366":122700,"_3078":122747},[],"El cuerpo de auditoría incluye:",{"_3627":73524,"_31174":73509,"_21594":122749,"_5":14861,"_28366":122700,"_3078":122750},[],"input: datos recibidos por la operación;",{"_3627":73525,"_31174":73509,"_21594":122752,"_5":14861,"_28366":122700,"_3078":122753},[],"has\\_error: indica si el servicio devolvió un error;",{"_3627":73526,"_31174":73509,"_21594":122755,"_5":14861,"_28366":122700,"_3078":122756},[],"output: resultado producido o mensaje de error;",{"_3627":73527,"_31174":73509,"_21594":122758,"_5":14861,"_28366":122700,"_3078":122759},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3627":73528,"_31174":73509,"_21594":122761,"_5":14861,"_28366":122700,"_3078":122762},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3627":73529,"_31174":73509,"_21594":122764,"_5":14861,"_28366":122700,"_3078":122765},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3627":73530,"_31174":73509,"_21594":122767,"_5":14861,"_28366":122704,"_3078":122768},[],"El backend aplica auditoría a mutaciones de:",{"_3627":73531,"_31174":73509,"_21594":122770,"_5":14861,"_28366":122704,"_3078":122771},[],"autoridades, certificados y perfiles de emisión;",{"_3627":73532,"_31174":73509,"_21594":122773,"_5":14861,"_28366":122704,"_3078":122774},[],"claves y motores KMS;",{"_3627":73533,"_31174":73509,"_21594":122776,"_5":14861,"_28366":122704,"_3078":122777},[],"dispositivos e identidades;",{"_3627":73534,"_31174":73509,"_21594":122779,"_5":14861,"_28366":122704,"_3078":122780},[],"DMS y operaciones de enrolamiento;",{"_3627":73535,"_31174":73509,"_21594":122782,"_5":14861,"_28366":122704,"_3078":122783},[],"funciones de validación y CRL;",{"_3627":73536,"_31174":73509,"_21594":122785,"_5":14861,"_28366":122704,"_3078":122786},[],"principales, políticas y concesiones de autorización.",{"_3627":73537,"_31174":73509,"_21594":122788,"_5":14861,"_28366":122704,"_3078":122789},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3627":73538,"_31174":73509,"_21594":122791,"_5":14861,"_28366":122708,"_3078":122792},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3627":73539,"_31174":73509,"_21594":122794,"_5":14861,"_28366":122708,"_3078":122795},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3627":73540,"_31174":73509,"_21594":122797,"_5":14861,"_28366":122708,"_3078":122798},[],"Diseña el consumidor para:",{"_3627":73541,"_31174":73509,"_21594":122800,"_5":14861,"_28366":122708,"_3078":122801},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3627":73542,"_31174":73509,"_21594":122803,"_5":14861,"_28366":122708,"_3078":122804},[],"conservar el CloudEvent completo sin modificar;",{"_3627":73543,"_31174":73509,"_21594":122806,"_5":14861,"_28366":122708,"_3078":122807},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3627":73544,"_31174":73509,"_21594":122809,"_5":14861,"_28366":122708,"_3078":122810},[],"cifrar en tránsito y en reposo;",{"_3627":73545,"_31174":73509,"_21594":122812,"_5":14861,"_28366":122708,"_3078":122813},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3627":73546,"_31174":73509,"_21594":122815,"_5":14861,"_28366":122708,"_3078":122816},[],"aplicar una política explícita de retención y legal hold;",{"_3627":73547,"_31174":73509,"_21594":122818,"_5":14861,"_28366":122708,"_3078":122819},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3627":73548,"_31174":73509,"_21594":122821,"_5":14861,"_28366":122712,"_3078":122822},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3627":73549,"_31174":73509,"_21594":122824,"_5":14861,"_28366":122712,"_3078":122825},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3627":73550,"_31174":73509,"_21594":122827,"_5":14861,"_28366":122720,"_3078":122828},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3627":73551,"_31174":73509,"_21594":122830,"_5":14861,"_28366":122724,"_3078":122831},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3627":73552,"_31174":73509,"_21594":122833,"_5":14861,"_28366":122728,"_3078":122834},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3627":73553,"_31174":73509,"_21594":122836,"_5":14861,"_28366":122732,"_3078":122837},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3627":73554,"_31174":73509,"_21594":122839,"_5":14861,"_28366":122736,"_3078":122840},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3627":73555,"_31174":73509,"_21594":122842,"_5":14861,"_28366":122740,"_3078":122843},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3627":73556,"_31174":73509,"_21594":122845,"_5":14861,"_28366":122740,"_3078":122846},[],"aparece un evento de auditoría correcto;",{"_3627":73557,"_31174":73509,"_21594":122848,"_5":14861,"_28366":122740,"_3078":122849},[],"el principal coincide con la identidad utilizada;",{"_3627":73558,"_31174":73509,"_21594":122851,"_5":14861,"_28366":122740,"_3078":122852},[],"el consumidor lo persiste una sola vez;",{"_3627":73559,"_31174":73509,"_21594":122854,"_5":14861,"_28366":122740,"_3078":122855},[],"puede recuperarse por recurso, actor y periodo;",{"_3627":73560,"_31174":73509,"_21594":122857,"_5":14861,"_28366":122740,"_3078":122858},[],"una interrupción del consumidor produce una alerta.",{"_3627":73561,"_31174":73509,"_21594":122860,"_5":14861,"_28366":122740,"_3078":122861},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3627":73562,"_31174":73562,"_5":15221,"_3078":122863,"_31533":122864,"_21594":122865,"_28366":73562},"Arquitectura de la plataforma",[50951,121820],[],{"_3627":73563,"_31174":73562,"_21594":122867,"_5":14861,"_28366":73562,"_3078":122868},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3627":73564,"_31174":73562,"_5":31530,"_21594":122870,"_28366":122871,"_3078":122872},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3627":73565,"_31174":73562,"_5":31530,"_21594":122874,"_28366":122875,"_3078":122876},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3627":73566,"_31174":73562,"_5":31530,"_21594":122878,"_28366":122879,"_3078":122880},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3627":73567,"_31174":73562,"_5":31530,"_21594":122882,"_28366":122883,"_3078":122884},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3627":73568,"_31174":73562,"_5":31530,"_21594":122886,"_28366":122887,"_3078":122888},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3627":73569,"_31174":73562,"_21594":122890,"_5":14861,"_28366":73562,"_3078":122891},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3627":73570,"_31174":73562,"_21594":122893,"_5":14861,"_28366":73562,"_3078":122894},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3627":73571,"_31174":73562,"_21594":122896,"_5":14861,"_28366":122871,"_3078":122897},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3627":73572,"_31174":73562,"_21594":122899,"_5":14861,"_28366":122875,"_3078":122900},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3627":73573,"_31174":73562,"_21594":122902,"_5":14861,"_28366":122879,"_3078":122903},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3627":73574,"_31174":73562,"_21594":122905,"_5":14861,"_28366":122883,"_3078":122906},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3627":73575,"_31174":73562,"_21594":122908,"_5":14861,"_28366":122887,"_3078":122909},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3627":73576,"_31174":73576,"_5":15221,"_3078":122911,"_31533":122912,"_21594":122913,"_28366":73576},"Cómo funciona Lamassu",[50951,121820],[],{"_3627":73577,"_31174":73576,"_21594":122915,"_5":14861,"_28366":73576,"_3078":122916},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3627":73578,"_31174":73576,"_5":31530,"_21594":122918,"_28366":122919,"_3078":122920},[],"/docs/pr-preview/pr-75/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3627":73579,"_31174":73576,"_5":31530,"_21594":122922,"_28366":122923,"_3078":122924},[],"/docs/pr-preview/pr-75/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3627":73580,"_31174":73576,"_21594":122926,"_5":14861,"_28366":73576,"_3078":122927},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3627":73581,"_31174":73576,"_21594":122929,"_5":14861,"_28366":122919,"_3078":122930},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3627":73582,"_31174":73576,"_21594":122932,"_5":14861,"_28366":122919,"_3078":122933},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3627":73583,"_31174":73576,"_21594":122935,"_5":14861,"_28366":122919,"_3078":122936},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3627":73584,"_31174":73576,"_21594":122938,"_5":14861,"_28366":122919,"_3078":122939},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3627":73585,"_31174":73576,"_21594":122941,"_5":14861,"_28366":122919,"_3078":122942},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3627":73586,"_31174":73576,"_21594":122944,"_5":14861,"_28366":122923,"_3078":122945},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3627":73587,"_31174":73576,"_21594":122947,"_5":14861,"_28366":122923,"_3078":122948},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3627":73588,"_31174":73576,"_21594":122950,"_5":14861,"_28366":122923,"_3078":122951},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3627":73589,"_31174":73576,"_21594":122953,"_5":14861,"_28366":122923,"_3078":122954},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3627":73590,"_31174":73576,"_21594":122956,"_5":14861,"_28366":122923,"_3078":122957},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3627":73591,"_31174":73576,"_21594":122959,"_5":14861,"_28366":122923,"_3078":122960},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3627":73592,"_31174":73576,"_21594":122962,"_5":14861,"_28366":122923,"_3078":122963},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3627":73593,"_31174":73593,"_5":15221,"_3078":122965,"_31533":122966,"_21594":122967,"_28366":73593},"Dispositivos e identidades",[50951,121820,53635,122965],[],{"_3627":73594,"_31174":73593,"_21594":122969,"_5":14861,"_28366":73593,"_3078":122970},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3627":73595,"_31174":73593,"_5":31530,"_21594":122972,"_28366":122973,"_3078":122974},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3627":73596,"_31174":73593,"_5":31530,"_21594":122976,"_28366":122977,"_3078":122978},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3627":73597,"_31174":73593,"_5":31530,"_21594":122980,"_28366":122981,"_3078":122982},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3627":73598,"_31174":73593,"_5":31530,"_21594":122984,"_28366":122985,"_3078":122986},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3627":73599,"_31174":73593,"_5":31530,"_21594":122988,"_28366":122989,"_3078":122990},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3627":73600,"_31174":73593,"_5":31530,"_21594":122992,"_28366":122993,"_3078":122994},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3627":73601,"_31174":73593,"_5":31530,"_21594":122996,"_28366":122997,"_3078":122998},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3627":73602,"_31174":73593,"_5":31530,"_21594":123000,"_28366":123001,"_3078":123002},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3627":73603,"_31174":73593,"_5":31530,"_21594":123004,"_28366":123005,"_3078":123006},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3627":73604,"_31174":73593,"_5":31530,"_21594":123008,"_28366":123009,"_3078":123010},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3627":73605,"_31174":73593,"_5":31530,"_21594":123012,"_28366":123013,"_3078":123014},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3627":73606,"_31174":73593,"_21594":123016,"_5":14861,"_28366":73593,"_3078":123017},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3627":73607,"_31174":73593,"_21594":123019,"_5":14861,"_28366":73593,"_3078":123020},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3627":73608,"_31174":73593,"_21594":123022,"_5":14861,"_28366":122973,"_3078":123023},[],"Vista operativa",{"_3627":73609,"_31174":73593,"_21594":123025,"_5":14861,"_28366":122973,"_3078":123026},[],"Interpretación",{"_3627":73610,"_31174":73593,"_21594":123028,"_5":14861,"_28366":122973,"_3078":53698},[],{"_3627":73611,"_31174":73593,"_21594":123030,"_5":14861,"_28366":122973,"_3078":123031},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3627":73612,"_31174":73593,"_21594":123033,"_5":14861,"_28366":122973,"_3078":53704},[],{"_3627":73613,"_31174":73593,"_21594":123035,"_5":14861,"_28366":122973,"_3078":123036},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3627":73614,"_31174":73593,"_21594":123038,"_5":14861,"_28366":122973,"_3078":53710},[],{"_3627":73615,"_31174":73593,"_21594":123040,"_5":14861,"_28366":122973,"_3078":123041},[],"La identidad está en la ventana operativa de renovación.",{"_3627":73616,"_31174":73593,"_21594":123043,"_5":14861,"_28366":122973,"_3078":53716},[],{"_3627":73617,"_31174":73593,"_21594":123045,"_5":14861,"_28366":122973,"_3078":123046},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3627":73618,"_31174":73593,"_21594":123048,"_5":14861,"_28366":122973,"_3078":53722},[],{"_3627":73619,"_31174":73593,"_21594":123050,"_5":14861,"_28366":122973,"_3078":123051},[],"La identidad ha vencido.",{"_3627":73620,"_31174":73593,"_21594":123053,"_5":14861,"_28366":122973,"_3078":53728},[],{"_3627":73621,"_31174":73593,"_21594":123055,"_5":14861,"_28366":122973,"_3078":123056},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3627":73622,"_31174":73593,"_21594":123058,"_5":14861,"_28366":122973,"_3078":53734},[],{"_3627":73623,"_31174":73593,"_21594":123060,"_5":14861,"_28366":122973,"_3078":123061},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3627":73624,"_31174":73593,"_21594":123063,"_5":14861,"_28366":122973,"_3078":123064},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3627":73625,"_31174":73593,"_21594":123066,"_5":14861,"_28366":122977,"_3078":123067},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3627":73626,"_31174":73593,"_21594":123069,"_5":14861,"_28366":122977,"_3078":123070},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3627":73627,"_31174":73593,"_21594":123072,"_5":14861,"_28366":122977,"_3078":123073},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3627":73628,"_31174":73593,"_21594":123075,"_5":14861,"_28366":122977,"_3078":123076},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3627":73629,"_31174":73593,"_21594":123078,"_5":14861,"_28366":122981,"_3078":123079},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3627":73630,"_31174":73593,"_21594":123081,"_5":14861,"_28366":122985,"_3078":123082},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3627":73631,"_31174":73593,"_21594":123084,"_5":14861,"_28366":122989,"_3078":123085},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3627":73632,"_31174":73593,"_21594":123087,"_5":14861,"_28366":122993,"_3078":123088},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3627":73633,"_31174":73593,"_21594":123090,"_5":14861,"_28366":122997,"_3078":123091},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3627":73634,"_31174":73593,"_21594":123093,"_5":14861,"_28366":122997,"_3078":123094},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3627":73635,"_31174":73593,"_21594":123096,"_5":14861,"_28366":123001,"_3078":123097},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3627":73636,"_31174":73593,"_21594":123099,"_5":14861,"_28366":123001,"_3078":123100},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3627":73637,"_31174":73593,"_21594":123102,"_5":14861,"_28366":123001,"_3078":123103},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3627":73638,"_31174":73593,"_21594":123105,"_5":14861,"_28366":123001,"_3078":123106},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3627":73639,"_31174":73593,"_21594":123108,"_5":14861,"_28366":123001,"_3078":123109},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3627":73640,"_31174":73593,"_21594":123111,"_5":14861,"_28366":123001,"_3078":123112},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3627":73641,"_31174":73593,"_21594":123114,"_5":14861,"_28366":123005,"_3078":123115},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3627":73642,"_31174":73593,"_21594":123117,"_5":14861,"_28366":123005,"_3078":123118},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3627":73643,"_31174":73593,"_21594":123120,"_5":14861,"_28366":123005,"_3078":123121},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3627":73644,"_31174":73593,"_21594":123123,"_5":14861,"_28366":123009,"_3078":123124},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3627":73645,"_31174":73593,"_21594":123126,"_5":14861,"_28366":123009,"_3078":123127},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3627":73646,"_31174":73593,"_21594":123129,"_5":14861,"_28366":123009,"_3078":123130},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3627":73647,"_31174":73593,"_21594":123132,"_5":14861,"_28366":123009,"_3078":123133},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3627":73648,"_31174":73593,"_21594":123135,"_5":14861,"_28366":123013,"_3078":123136},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3627":73649,"_31174":73593,"_21594":123138,"_5":14861,"_28366":123013,"_3078":123139},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3627":73650,"_31174":73650,"_5":15221,"_3078":123141,"_31533":123142,"_21594":123144,"_28366":73650},"Identidad inicial y autenticación",[50951,121820,53635,122965,123143],"Enrolamiento con PKI",[],{"_3627":73651,"_31174":73650,"_21594":123146,"_5":14861,"_28366":73650,"_3078":123147},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3627":73652,"_31174":73650,"_5":31530,"_21594":123149,"_28366":123150,"_3078":123151},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3627":73653,"_31174":73650,"_5":31530,"_21594":123153,"_28366":123154,"_3078":123155},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3627":73654,"_31174":73650,"_5":31530,"_21594":123157,"_28366":123158,"_3078":123159},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3627":73655,"_31174":73650,"_5":31530,"_21594":123161,"_28366":123162,"_3078":123163},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3627":73656,"_31174":73650,"_5":31530,"_21594":123165,"_28366":123166,"_3078":123167},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3627":73657,"_31174":73650,"_21594":123169,"_5":14861,"_28366":73650,"_3078":123170},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3627":73658,"_31174":73650,"_21594":123172,"_5":14861,"_28366":123150,"_3078":123173},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3627":73659,"_31174":73650,"_21594":123175,"_5":14861,"_28366":123150,"_3078":123176},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3627":73660,"_31174":73650,"_21594":123178,"_5":14861,"_28366":123154,"_3078":123179},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3627":73661,"_31174":73650,"_21594":123181,"_5":14861,"_28366":123154,"_3078":123182},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3627":73662,"_31174":73650,"_21594":123184,"_5":14861,"_28366":123154,"_3078":123185},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3627":73663,"_31174":73650,"_21594":123187,"_5":14861,"_28366":123158,"_3078":123188},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3627":73664,"_31174":73650,"_21594":123190,"_5":14861,"_28366":123158,"_3078":123191},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3627":73665,"_31174":73650,"_21594":123193,"_5":14861,"_28366":123162,"_3078":123194},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3627":73666,"_31174":73650,"_21594":123196,"_5":14861,"_28366":123162,"_3078":123197},[],"Ejemplo de cuerpo:",{"_3627":73667,"_31174":73650,"_21594":123199,"_5":14861,"_28366":123162,"_3078":123200},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3627":73668,"_31174":73650,"_21594":123202,"_5":14861,"_28366":123162,"_3078":123203},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3627":73669,"_31174":73650,"_21594":123205,"_5":14861,"_28366":123162,"_3078":123206},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3627":73670,"_31174":73650,"_21594":123208,"_5":14861,"_28366":123162,"_3078":123209},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3627":73671,"_31174":73650,"_21594":123211,"_5":14861,"_28366":123166,"_3078":123212},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3627":73672,"_31174":73650,"_21594":123214,"_5":14861,"_28366":123166,"_3078":123215},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3627":73673,"_31174":73650,"_21594":123217,"_5":14861,"_28366":123166,"_3078":123218},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3627":73674,"_31174":73650,"_21594":123220,"_5":14861,"_28366":123166,"_3078":123221},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3627":73675,"_31174":73675,"_5":15221,"_3078":123223,"_31533":123224,"_21594":123225,"_28366":73675},"Configura y opera el DMS",[50951,121820,53635,122965,123143],[],{"_3627":73676,"_31174":73675,"_21594":123227,"_5":14861,"_28366":73675,"_3078":123228},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3627":73677,"_31174":73675,"_5":31530,"_21594":123230,"_28366":123231,"_3078":120354},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3627":73678,"_31174":73675,"_5":31530,"_21594":123233,"_28366":123234,"_3078":123235},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3627":73679,"_31174":73675,"_5":31530,"_21594":123237,"_28366":123238,"_3078":123239},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3627":73680,"_31174":73675,"_5":31530,"_21594":123241,"_28366":123242,"_3078":123243},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3627":73681,"_31174":73675,"_5":31530,"_21594":123245,"_28366":123246,"_3078":123247},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3627":73682,"_31174":73675,"_5":31530,"_21594":123249,"_28366":123250,"_3078":123251},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3627":73683,"_31174":73675,"_5":31530,"_21594":123253,"_28366":123254,"_3078":123255},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3627":73684,"_31174":73675,"_5":31530,"_21594":123257,"_28366":123258,"_3078":123259},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3627":73685,"_31174":73675,"_5":31530,"_21594":123261,"_28366":123262,"_3078":53939},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3627":73686,"_31174":73675,"_5":31530,"_21594":123264,"_28366":123265,"_3078":53943},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3627":73687,"_31174":73675,"_5":31530,"_21594":123267,"_28366":123268,"_3078":123269},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3627":73688,"_31174":73675,"_5":31530,"_21594":123271,"_28366":123272,"_3078":123273},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3627":73689,"_31174":73675,"_5":31530,"_21594":123275,"_28366":123276,"_3078":123277},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3627":73690,"_31174":73675,"_5":31530,"_21594":123279,"_28366":123280,"_3078":123281},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3627":73691,"_31174":73675,"_5":31530,"_21594":123283,"_28366":123284,"_3078":53963},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3627":73692,"_31174":73675,"_5":31530,"_21594":123286,"_28366":123287,"_3078":123288},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3627":73693,"_31174":73675,"_5":31530,"_21594":123290,"_28366":123291,"_3078":123292},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3627":73694,"_31174":73675,"_5":31530,"_21594":123294,"_28366":123295,"_3078":123296},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3627":73695,"_31174":73675,"_21594":123298,"_5":14861,"_28366":73675,"_3078":123299},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3627":73696,"_31174":73675,"_21594":123301,"_5":14861,"_28366":123231,"_3078":123302},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3627":73697,"_31174":73675,"_21594":123304,"_5":14861,"_28366":123231,"_3078":123305},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3627":73698,"_31174":73675,"_21594":123307,"_5":14861,"_28366":123238,"_3078":123308},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3627":73699,"_31174":73675,"_21594":123310,"_5":14861,"_28366":123242,"_3078":123311},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3627":73700,"_31174":73675,"_21594":123313,"_5":14861,"_28366":123246,"_3078":123314},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3627":73701,"_31174":73675,"_21594":123316,"_5":14861,"_28366":123250,"_3078":123317},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3627":73702,"_31174":73675,"_21594":123319,"_5":14861,"_28366":123254,"_3078":123320},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3627":73703,"_31174":73675,"_21594":123322,"_5":14861,"_28366":123262,"_3078":123323},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3627":73704,"_31174":73675,"_21594":123325,"_5":14861,"_28366":123262,"_3078":123326},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3627":73705,"_31174":73675,"_21594":123328,"_5":14861,"_28366":123265,"_3078":123329},[],"Campo de `settings.enrollment_settings`",{"_3627":73706,"_31174":73675,"_21594":123331,"_5":14861,"_28366":123265,"_3078":123332},[],"Decisión",{"_3627":73707,"_31174":73675,"_21594":123334,"_5":14861,"_28366":123265,"_3078":54014},[],{"_3627":73708,"_31174":73675,"_21594":123336,"_5":14861,"_28366":123265,"_3078":123337},[],"`EST_RFC7030` para estas operaciones.",{"_3627":73709,"_31174":73675,"_21594":123339,"_5":14861,"_28366":123265,"_3078":54020},[],{"_3627":73710,"_31174":73675,"_21594":123341,"_5":14861,"_28366":123265,"_3078":123342},[],"ID de la CA que firmará.",{"_3627":73711,"_31174":73675,"_21594":123344,"_5":14861,"_28366":123265,"_3078":54026},[],{"_3627":73712,"_31174":73675,"_21594":123346,"_5":14861,"_28366":123265,"_3078":123347},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3627":73713,"_31174":73675,"_21594":123349,"_5":14861,"_28366":123265,"_3078":54032},[],{"_3627":73714,"_31174":73675,"_21594":123351,"_5":14861,"_28366":123265,"_3078":123352},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3627":73715,"_31174":73675,"_21594":123354,"_5":14861,"_28366":123265,"_3078":54038},[],{"_3627":73716,"_31174":73675,"_21594":123356,"_5":14861,"_28366":123265,"_3078":123357},[],"Uno de los cuatro modos de autenticación.",{"_3627":73717,"_31174":73675,"_21594":123359,"_5":14861,"_28366":123265,"_3078":123360},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3627":73718,"_31174":73675,"_21594":123362,"_5":14861,"_28366":123268,"_3078":123363},[],"Los bloques son independientes:",{"_3627":73719,"_31174":73675,"_21594":123365,"_5":14861,"_28366":123268,"_3078":123366},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3627":73720,"_31174":73675,"_21594":123368,"_5":14861,"_28366":123268,"_3078":123369},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3627":73721,"_31174":73675,"_21594":123371,"_5":14861,"_28366":123268,"_3078":54056},[],{"_3627":73722,"_31174":73675,"_21594":123373,"_5":14861,"_28366":123268,"_3078":123374},[],"Control aplicado en la operación configurada",{"_3627":73723,"_31174":73675,"_21594":123376,"_5":14861,"_28366":123268,"_3078":54062},[],{"_3627":73724,"_31174":73675,"_21594":123378,"_5":14861,"_28366":123268,"_3078":123379},[],"Validación del certificado presentado.",{"_3627":73725,"_31174":73675,"_21594":123381,"_5":14861,"_28366":123268,"_3078":54068},[],{"_3627":73726,"_31174":73675,"_21594":123383,"_5":14861,"_28366":123268,"_3078":123384},[],"Autorización del webhook configurado.",{"_3627":73727,"_31174":73675,"_21594":123386,"_5":14861,"_28366":123268,"_3078":54074},[],{"_3627":73728,"_31174":73675,"_21594":123388,"_5":14861,"_28366":123268,"_3078":123389},[],"Validación del certificado y, después, aprobación del webhook.",{"_3627":73729,"_31174":73675,"_21594":123391,"_5":14861,"_28366":123268,"_3078":54080},[],{"_3627":73730,"_31174":73675,"_21594":123393,"_5":14861,"_28366":123268,"_3078":123394},[],"Sin autenticación del solicitante por el DMS.",{"_3627":73731,"_31174":73675,"_21594":123396,"_5":14861,"_28366":123268,"_3078":123397},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3627":73732,"_31174":73675,"_21594":123399,"_5":14861,"_28366":123268,"_3078":123400},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3627":73733,"_31174":73675,"_21594":123402,"_5":14861,"_28366":123268,"_3078":123403},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3627":73734,"_31174":73675,"_21594":123405,"_5":14861,"_28366":123268,"_3078":123406},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3627":73735,"_31174":73675,"_21594":123408,"_5":14861,"_28366":123268,"_3078":123409},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3627":73736,"_31174":73675,"_21594":123411,"_5":14861,"_28366":123272,"_3078":123412},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3627":73737,"_31174":73675,"_21594":123414,"_5":14861,"_28366":123272,"_3078":123415},[],"Campo de `external_webhook_settings`",{"_3627":73738,"_31174":73675,"_21594":123417,"_5":14861,"_28366":123272,"_3078":123332},[],{"_3627":73739,"_31174":73675,"_21594":123419,"_5":14861,"_28366":123272,"_3078":54109},[],{"_3627":73740,"_31174":73675,"_21594":123421,"_5":14861,"_28366":123272,"_3078":123422},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3627":73741,"_31174":73675,"_21594":123424,"_5":14861,"_28366":123272,"_3078":54115},[],{"_3627":73742,"_31174":73675,"_21594":123426,"_5":14861,"_28366":123272,"_3078":123427},[],"`POST` o `PUT`; `POST` por defecto.",{"_3627":73743,"_31174":73675,"_21594":123429,"_5":14861,"_28366":123272,"_3078":54121},[],{"_3627":73744,"_31174":73675,"_21594":123431,"_5":14861,"_28366":123272,"_3078":123432},[],"Etiqueta usada en los logs del servicio.",{"_3627":73745,"_31174":73675,"_21594":123434,"_5":14861,"_28366":123272,"_3078":54127},[],{"_3627":73746,"_31174":73675,"_21594":123436,"_5":14861,"_28366":123272,"_3078":123437},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3627":73747,"_31174":73675,"_21594":123439,"_5":14861,"_28366":123272,"_3078":54133},[],{"_3627":73748,"_31174":73675,"_21594":123441,"_5":14861,"_28366":123272,"_3078":123442},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3627":73749,"_31174":73675,"_21594":123444,"_5":14861,"_28366":123272,"_3078":54139},[],{"_3627":73750,"_31174":73675,"_21594":123446,"_5":14861,"_28366":123272,"_3078":123447},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3627":73751,"_31174":73675,"_21594":123449,"_5":14861,"_28366":123272,"_3078":54145},[],{"_3627":73752,"_31174":73675,"_21594":123451,"_5":14861,"_28366":123272,"_3078":123452},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3627":73753,"_31174":73675,"_21594":123454,"_5":14861,"_28366":123272,"_3078":54151},[],{"_3627":73754,"_31174":73675,"_21594":123456,"_5":14861,"_28366":123272,"_3078":123457},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3627":73755,"_31174":73675,"_21594":123459,"_5":14861,"_28366":123272,"_3078":54157},[],{"_3627":73756,"_31174":73675,"_21594":123461,"_5":14861,"_28366":123272,"_3078":123462},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3627":73757,"_31174":73675,"_21594":123464,"_5":14861,"_28366":123272,"_3078":54163},[],{"_3627":73758,"_31174":73675,"_21594":123466,"_5":14861,"_28366":123272,"_3078":123467},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3627":73759,"_31174":73675,"_21594":123469,"_5":14861,"_28366":123272,"_3078":123470},[],"Reglas de esa configuración:",{"_3627":73760,"_31174":73675,"_21594":123472,"_5":14861,"_28366":123272,"_3078":123473},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3627":73761,"_31174":73675,"_21594":123475,"_5":14861,"_28366":123272,"_3078":123476},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3627":73762,"_31174":73675,"_21594":123478,"_5":14861,"_28366":123272,"_3078":123479},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3627":73763,"_31174":73675,"_21594":123481,"_5":14861,"_28366":123272,"_3078":123482},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3627":73764,"_31174":73675,"_21594":123484,"_5":14861,"_28366":123272,"_3078":123485},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3627":73765,"_31174":73675,"_21594":123487,"_5":14861,"_28366":123272,"_3078":123488},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3627":73766,"_31174":73675,"_21594":123490,"_5":14861,"_28366":123272,"_3078":123491},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3627":73767,"_31174":73675,"_21594":123493,"_5":14861,"_28366":123272,"_3078":123494},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3627":73768,"_31174":73675,"_21594":123496,"_5":14861,"_28366":123272,"_3078":123497},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3627":73769,"_31174":73675,"_21594":123499,"_5":14861,"_28366":123276,"_3078":123500},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3627":73770,"_31174":73675,"_21594":123502,"_5":14861,"_28366":123280,"_3078":123503},[],"Campo de `settings.reenrollment_settings`",{"_3627":73771,"_31174":73675,"_21594":123505,"_5":14861,"_28366":123280,"_3078":123506},[],"Función",{"_3627":73772,"_31174":73675,"_21594":123508,"_5":14861,"_28366":123280,"_3078":54207},[],{"_3627":73773,"_31174":73675,"_21594":123510,"_5":14861,"_28366":123280,"_3078":123511},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3627":73774,"_31174":73675,"_21594":123513,"_5":14861,"_28366":123280,"_3078":54213},[],{"_3627":73775,"_31174":73675,"_21594":123515,"_5":14861,"_28366":123280,"_3078":123516},[],"Umbral operativo preventivo de monitorización.",{"_3627":73776,"_31174":73675,"_21594":123518,"_5":14861,"_28366":123280,"_3078":54219},[],{"_3627":73777,"_31174":73675,"_21594":123520,"_5":14861,"_28366":123280,"_3078":123521},[],"Umbral operativo crítico de monitorización.",{"_3627":73778,"_31174":73675,"_21594":123523,"_5":14861,"_28366":123280,"_3078":54225},[],{"_3627":73779,"_31174":73675,"_21594":123525,"_5":14861,"_28366":123280,"_3078":123526},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3627":73780,"_31174":73675,"_21594":123528,"_5":14861,"_28366":123280,"_3078":54231},[],{"_3627":73781,"_31174":73675,"_21594":123530,"_5":14861,"_28366":123280,"_3078":123531},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3627":73782,"_31174":73675,"_21594":123533,"_5":14861,"_28366":123280,"_3078":54237},[],{"_3627":73783,"_31174":73675,"_21594":123535,"_5":14861,"_28366":123280,"_3078":123536},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3627":73784,"_31174":73675,"_21594":123538,"_5":14861,"_28366":123280,"_3078":123539},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3627":73785,"_31174":73675,"_21594":123541,"_5":14861,"_28366":123284,"_3078":123542},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3627":73786,"_31174":73675,"_21594":123544,"_5":14861,"_28366":123287,"_3078":120718},[],{"_3627":73787,"_31174":73675,"_21594":123546,"_5":14861,"_28366":123287,"_3078":123547},[],"Qué publica",{"_3627":73788,"_31174":73675,"_21594":123549,"_5":14861,"_28366":123287,"_3078":54254},[],{"_3627":73789,"_31174":73675,"_21594":123551,"_5":14861,"_28366":123287,"_3078":123552},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3627":73790,"_31174":73675,"_21594":123554,"_5":14861,"_28366":123287,"_3078":54260},[],{"_3627":73791,"_31174":73675,"_21594":123556,"_5":14861,"_28366":123287,"_3078":123557},[],"Certificado de la CA emisora seleccionada.",{"_3627":73792,"_31174":73675,"_21594":123559,"_5":14861,"_28366":123287,"_3078":54266},[],{"_3627":73793,"_31174":73675,"_21594":123561,"_5":14861,"_28366":123287,"_3078":123562},[],"Certificados de las CAs elegidas explícitamente.",{"_3627":73794,"_31174":73675,"_21594":123564,"_5":14861,"_28366":123287,"_3078":123565},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3627":73795,"_31174":73675,"_21594":123567,"_5":14861,"_28366":123291,"_3078":123568},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3627":73796,"_31174":73675,"_21594":123570,"_5":14861,"_28366":123291,"_3078":123571},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3627":73797,"_31174":73675,"_21594":123573,"_5":14861,"_28366":123291,"_3078":123574},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3627":73798,"_31174":73675,"_21594":123576,"_5":14861,"_28366":123295,"_3078":123577},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3627":73799,"_31174":73799,"_5":15221,"_3078":123579,"_31533":123580,"_21594":123581,"_28366":73799},"Integra el cliente EST",[50951,121820,53635,122965,123143],[],{"_3627":73800,"_31174":73799,"_21594":123583,"_5":14861,"_28366":73799,"_3078":123584},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3627":73801,"_31174":73799,"_5":31530,"_21594":123586,"_28366":123587,"_3078":120354},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3627":73802,"_31174":73799,"_5":31530,"_21594":123589,"_28366":123590,"_3078":123591},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3627":73803,"_31174":73799,"_5":31530,"_21594":123593,"_28366":123594,"_3078":123595},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3627":73804,"_31174":73799,"_5":31530,"_21594":123597,"_28366":123598,"_3078":123599},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3627":73805,"_31174":73799,"_5":31530,"_21594":123601,"_28366":123602,"_3078":123603},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3627":73806,"_31174":73799,"_5":31530,"_21594":123605,"_28366":123606,"_3078":123607},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3627":73807,"_31174":73799,"_21594":123609,"_5":14861,"_28366":73799,"_3078":123610},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3627":73808,"_31174":73799,"_21594":123612,"_5":14861,"_28366":123587,"_3078":123613},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3627":73809,"_31174":73799,"_21594":123615,"_5":14861,"_28366":123587,"_3078":123616},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3627":73810,"_31174":73799,"_21594":123618,"_5":14861,"_28366":123587,"_3078":123619},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3627":73811,"_31174":73799,"_21594":123621,"_5":14861,"_28366":123590,"_3078":123622},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3627":73812,"_31174":73799,"_21594":123624,"_5":14861,"_28366":123590,"_3078":123625},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3627":73813,"_31174":73799,"_21594":123627,"_5":14861,"_28366":123594,"_3078":123628},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3627":73814,"_31174":73799,"_21594":123630,"_5":14861,"_28366":123594,"_3078":123631},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3627":73815,"_31174":73799,"_21594":123633,"_5":14861,"_28366":123598,"_3078":123634},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3627":73816,"_31174":73799,"_21594":123636,"_5":14861,"_28366":123598,"_3078":123637},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3627":73817,"_31174":73799,"_21594":123639,"_5":14861,"_28366":123602,"_3078":123640},[],"Para el caso de una raíz que emite directamente:",{"_3627":73818,"_31174":73799,"_21594":123642,"_5":14861,"_28366":123602,"_3078":123643},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3627":73819,"_31174":73799,"_21594":123645,"_5":14861,"_28366":123602,"_3078":123646},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3627":73820,"_31174":73799,"_21594":123648,"_5":14861,"_28366":123606,"_3078":123649},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3627":73821,"_31174":73821,"_5":15221,"_3078":123651,"_31533":123652,"_21594":123653,"_28366":73821},"Referencia EST",[50951,121820,53635,122965,123143],[],{"_3627":73822,"_31174":73821,"_21594":123655,"_5":14861,"_28366":73821,"_3078":123656},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3627":73823,"_31174":73821,"_5":31530,"_21594":123658,"_28366":123659,"_3078":123660},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3627":73824,"_31174":73821,"_5":31530,"_21594":123662,"_28366":123663,"_3078":23396},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3627":73825,"_31174":73821,"_5":31530,"_21594":123665,"_28366":123666,"_3078":26911},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3627":73826,"_31174":73821,"_5":31530,"_21594":123668,"_28366":123669,"_3078":26918},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3627":73827,"_31174":73821,"_5":31530,"_21594":123671,"_28366":123672,"_3078":26180},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3627":73828,"_31174":73821,"_5":31530,"_21594":123674,"_28366":123675,"_3078":123676},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3627":73829,"_31174":73821,"_5":31530,"_21594":123678,"_28366":123679,"_3078":123680},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3627":73830,"_31174":73821,"_5":31530,"_21594":123682,"_28366":123683,"_3078":123684},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3627":73831,"_31174":73821,"_21594":123686,"_5":14861,"_28366":73821,"_3078":123687},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3627":73832,"_31174":73821,"_21594":123689,"_5":14861,"_28366":123659,"_3078":123690},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3627":73833,"_31174":73821,"_21594":123692,"_5":14861,"_28366":123659,"_3078":121580},[],{"_3627":73834,"_31174":73821,"_21594":123694,"_5":14861,"_28366":123659,"_3078":123695},[],"Método",{"_3627":73835,"_31174":73821,"_21594":123697,"_5":14861,"_28366":123659,"_3078":123698},[],"Autenticación y condición",{"_3627":73836,"_31174":73821,"_21594":123700,"_5":14861,"_28366":123659,"_3078":54409},[],{"_3627":73837,"_31174":73821,"_21594":123702,"_5":14861,"_28366":123659,"_3078":54412},[],{"_3627":73838,"_31174":73821,"_21594":123704,"_5":14861,"_28366":123659,"_3078":123705},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3627":73839,"_31174":73821,"_21594":123707,"_5":14861,"_28366":123659,"_3078":54418},[],{"_3627":73840,"_31174":73821,"_21594":123709,"_5":14861,"_28366":123659,"_3078":54421},[],{"_3627":73841,"_31174":73821,"_21594":123711,"_5":14861,"_28366":123659,"_3078":123712},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3627":73842,"_31174":73821,"_21594":123714,"_5":14861,"_28366":123659,"_3078":54427},[],{"_3627":73843,"_31174":73821,"_21594":123716,"_5":14861,"_28366":123659,"_3078":54421},[],{"_3627":73844,"_31174":73821,"_21594":123718,"_5":14861,"_28366":123659,"_3078":123719},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3627":73845,"_31174":73821,"_21594":123721,"_5":14861,"_28366":123659,"_3078":54435},[],{"_3627":73846,"_31174":73821,"_21594":123723,"_5":14861,"_28366":123659,"_3078":54421},[],{"_3627":73847,"_31174":73821,"_21594":123725,"_5":14861,"_28366":123659,"_3078":123726},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3627":73848,"_31174":73821,"_21594":123728,"_5":14861,"_28366":123659,"_3078":123729},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3627":73849,"_31174":73821,"_21594":123731,"_5":14861,"_28366":123663,"_3078":123732},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3627":73850,"_31174":73821,"_21594":123734,"_5":14861,"_28366":123663,"_3078":123735},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3627":73851,"_31174":73821,"_21594":123737,"_5":14861,"_28366":123666,"_3078":123738},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3627":73852,"_31174":73821,"_21594":123740,"_5":14861,"_28366":123666,"_3078":123741},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3627":73853,"_31174":73821,"_21594":123743,"_5":14861,"_28366":123669,"_3078":123744},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3627":73854,"_31174":73821,"_21594":123746,"_5":14861,"_28366":123669,"_3078":123747},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3627":73855,"_31174":73821,"_21594":123749,"_5":14861,"_28366":123672,"_3078":123750},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3627":73856,"_31174":73821,"_21594":123752,"_5":14861,"_28366":123672,"_3078":123753},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3627":73857,"_31174":73821,"_21594":123755,"_5":14861,"_28366":123675,"_3078":123756},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3627":73858,"_31174":73821,"_21594":123758,"_5":14861,"_28366":123675,"_3078":123759},[],"Parte",{"_3627":73859,"_31174":73821,"_21594":123761,"_5":14861,"_28366":123675,"_3078":123762},[],"Contenido tras decodificar su Base64",{"_3627":73860,"_31174":73821,"_21594":123764,"_5":14861,"_28366":123675,"_3078":54479},[],{"_3627":73861,"_31174":73821,"_21594":123766,"_5":14861,"_28366":123675,"_3078":123767},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3627":73862,"_31174":73821,"_21594":123769,"_5":14861,"_28366":123675,"_3078":54485},[],{"_3627":73863,"_31174":73821,"_21594":123771,"_5":14861,"_28366":123675,"_3078":123772},[],"PKCS#7 DER con el certificado emitido.",{"_3627":73864,"_31174":73821,"_21594":123774,"_5":14861,"_28366":123675,"_3078":123775},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3627":73865,"_31174":73821,"_21594":123777,"_5":14861,"_28366":123679,"_3078":123778},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3627":73866,"_31174":73821,"_21594":123780,"_5":14861,"_28366":123679,"_3078":123781},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3627":73867,"_31174":73821,"_21594":123783,"_5":14861,"_28366":123679,"_3078":123784},[],"Convierte y comprueba el resultado:",{"_3627":73868,"_31174":73821,"_21594":123786,"_5":14861,"_28366":123679,"_3078":123787},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3627":73869,"_31174":73821,"_21594":123789,"_5":14861,"_28366":123683,"_3078":123790},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3627":73870,"_31174":73821,"_21594":123792,"_5":14861,"_28366":123683,"_3078":123793},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3627":73871,"_31174":73871,"_5":15221,"_3078":123143,"_31533":123795,"_21594":123796,"_28366":73871},[50951,121820,53635,122965,123143],[],{"_3627":73872,"_31174":73871,"_21594":123798,"_5":14861,"_28366":73871,"_3078":123799},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3627":73873,"_31174":73871,"_5":31530,"_21594":123801,"_28366":123802,"_3078":123803},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3627":73874,"_31174":73871,"_5":31530,"_21594":123805,"_28366":123806,"_3078":123807},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3627":73875,"_31174":73871,"_5":31530,"_21594":123809,"_28366":123810,"_3078":123811},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3627":73876,"_31174":73871,"_21594":123813,"_5":14861,"_28366":73871,"_3078":123814},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3627":73877,"_31174":73871,"_21594":123816,"_5":14861,"_28366":123802,"_3078":123817},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3627":73878,"_31174":73871,"_21594":123819,"_5":14861,"_28366":123802,"_3078":123820},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3627":73879,"_31174":73871,"_21594":123822,"_5":14861,"_28366":123802,"_3078":123823},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3627":73880,"_31174":73871,"_21594":123825,"_5":14861,"_28366":123802,"_3078":123826},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3627":73881,"_31174":73871,"_21594":123828,"_5":14861,"_28366":123802,"_3078":123829},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3627":73882,"_31174":73871,"_21594":123831,"_5":14861,"_28366":123802,"_3078":123832},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3627":73883,"_31174":73871,"_21594":123834,"_5":14861,"_28366":123806,"_3078":123835},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3627":73884,"_31174":73871,"_21594":123837,"_5":14861,"_28366":123806,"_3078":123838},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3627":73885,"_31174":73871,"_21594":123840,"_5":14861,"_28366":123806,"_3078":123841},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3627":73886,"_31174":73871,"_21594":123843,"_5":14861,"_28366":123806,"_3078":123844},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3627":73887,"_31174":73871,"_21594":123846,"_5":14861,"_28366":123810,"_3078":123847},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3627":73888,"_31174":73871,"_21594":123849,"_5":14861,"_28366":123810,"_3078":123850},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3627":73889,"_31174":73871,"_21594":123852,"_5":14861,"_28366":123810,"_3078":123853},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3627":73890,"_31174":73871,"_21594":123855,"_5":14861,"_28366":123810,"_3078":123856},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3627":73891,"_31174":73871,"_21594":123858,"_5":14861,"_28366":123810,"_3078":123859},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3627":73892,"_31174":73892,"_5":15221,"_3078":123861,"_31533":123862,"_21594":123863,"_28366":73892},"Estrategias de aprovisionamiento",[50951,121820,53635,122965,123143],[],{"_3627":73893,"_31174":73892,"_21594":123865,"_5":14861,"_28366":73892,"_3078":123866},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3627":73894,"_31174":73892,"_5":31530,"_21594":123868,"_28366":123869,"_3078":123870},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3627":73895,"_31174":73892,"_5":31530,"_21594":123872,"_28366":123873,"_3078":123874},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3627":73896,"_31174":73892,"_5":31530,"_21594":123876,"_28366":123877,"_3078":123878},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3627":73897,"_31174":73892,"_5":31530,"_21594":123880,"_28366":123881,"_3078":123882},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3627":73898,"_31174":73892,"_5":31530,"_21594":123884,"_28366":123885,"_3078":123886},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3627":73899,"_31174":73892,"_21594":123888,"_5":14861,"_28366":73892,"_3078":123889},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3627":73900,"_31174":73892,"_21594":123891,"_5":14861,"_28366":123869,"_3078":123892},[],"Recorrido",{"_3627":73901,"_31174":73892,"_21594":123894,"_5":14861,"_28366":123869,"_3078":123895},[],"Cuándo existe el dispositivo",{"_3627":73902,"_31174":73892,"_21594":123897,"_5":14861,"_28366":123869,"_3078":123898},[],"Qué compruebas",{"_3627":73903,"_31174":73892,"_21594":123900,"_5":14861,"_28366":123869,"_3078":123901},[],"Asignación manual",{"_3627":73904,"_31174":73892,"_21594":123903,"_5":14861,"_28366":123869,"_3078":123904},[],"El operador lo crea antes de asociar un certificado.",{"_3627":73905,"_31174":73892,"_21594":123906,"_5":14861,"_28366":123869,"_3078":123907},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3627":73906,"_31174":73892,"_21594":123909,"_5":14861,"_28366":123869,"_3078":123910},[],"EST con `JITP`",{"_3627":73907,"_31174":73892,"_21594":123912,"_5":14861,"_28366":123869,"_3078":123913},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3627":73908,"_31174":73892,"_21594":123915,"_5":14861,"_28366":123869,"_3078":123916},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3627":73909,"_31174":73892,"_21594":123918,"_5":14861,"_28366":123869,"_3078":123919},[],"EST con `PRE_REGISTRATION`",{"_3627":73910,"_31174":73892,"_21594":123921,"_5":14861,"_28366":123869,"_3078":123922},[],"Debe existir antes de `/simpleenroll`.",{"_3627":73911,"_31174":73892,"_21594":123924,"_5":14861,"_28366":123869,"_3078":123925},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3627":73912,"_31174":73892,"_21594":123927,"_5":14861,"_28366":123869,"_3078":123928},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3627":73913,"_31174":73892,"_21594":123930,"_5":14861,"_28366":123869,"_3078":123931},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3627":73914,"_31174":73892,"_21594":123933,"_5":14861,"_28366":123873,"_3078":123934},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3627":73915,"_31174":73892,"_21594":123936,"_5":14861,"_28366":123873,"_3078":123937},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3627":73916,"_31174":73892,"_21594":123939,"_5":14861,"_28366":123873,"_3078":123940},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3627":73917,"_31174":73892,"_21594":123942,"_5":14861,"_28366":123877,"_3078":123943},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3627":73918,"_31174":73892,"_21594":123945,"_5":14861,"_28366":123877,"_3078":123946},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3627":73919,"_31174":73892,"_21594":123948,"_5":14861,"_28366":123877,"_3078":123949},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3627":73920,"_31174":73892,"_21594":123951,"_5":14861,"_28366":123877,"_3078":123952},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3627":73921,"_31174":73892,"_21594":123954,"_5":14861,"_28366":123877,"_3078":123955},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3627":73922,"_31174":73892,"_21594":123957,"_5":14861,"_28366":123877,"_3078":123958},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3627":73923,"_31174":73892,"_21594":123960,"_5":14861,"_28366":123881,"_3078":120718},[],{"_3627":73924,"_31174":73892,"_21594":123962,"_5":14861,"_28366":123881,"_3078":123963},[],"Material que atraviesa EST",{"_3627":73925,"_31174":73892,"_21594":123965,"_5":14861,"_28366":123881,"_3078":123966},[],"Clave generada por el dispositivo",{"_3627":73926,"_31174":73892,"_21594":123968,"_5":14861,"_28366":123881,"_3078":123969},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3627":73927,"_31174":73892,"_21594":123971,"_5":14861,"_28366":123881,"_3078":123972},[],"Clave ya disponible en el dispositivo",{"_3627":73928,"_31174":73892,"_21594":123974,"_5":14861,"_28366":123881,"_3078":123975},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3627":73929,"_31174":73892,"_21594":123977,"_5":14861,"_28366":123881,"_3078":53963},[],{"_3627":73930,"_31174":73892,"_21594":123979,"_5":14861,"_28366":123881,"_3078":123980},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3627":73931,"_31174":73892,"_21594":123982,"_5":14861,"_28366":123881,"_3078":123983},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3627":73932,"_31174":73892,"_21594":123985,"_5":14861,"_28366":123885,"_3078":123986},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3627":73933,"_31174":73933,"_5":15221,"_3078":123988,"_31533":123989,"_21594":123990,"_28366":73933},"Renovación y recuperación",[50951,121820,53635,122965,123143],[],{"_3627":73934,"_31174":73933,"_21594":123992,"_5":14861,"_28366":73933,"_3078":123993},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3627":73935,"_31174":73933,"_5":31530,"_21594":123995,"_28366":123996,"_3078":123997},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3627":73936,"_31174":73933,"_5":31530,"_21594":123999,"_28366":124000,"_3078":124001},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3627":73937,"_31174":73933,"_5":31530,"_21594":124003,"_28366":124004,"_3078":124005},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3627":73938,"_31174":73933,"_5":31530,"_21594":124007,"_28366":124008,"_3078":124009},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3627":73939,"_31174":73933,"_5":31530,"_21594":124011,"_28366":124012,"_3078":124013},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3627":73940,"_31174":73933,"_21594":124015,"_5":14861,"_28366":73933,"_3078":124016},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3627":73941,"_31174":73933,"_21594":124018,"_5":14861,"_28366":123996,"_3078":124019},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3627":73942,"_31174":73933,"_21594":124021,"_5":14861,"_28366":123996,"_3078":124022},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3627":73943,"_31174":73933,"_21594":124024,"_5":14861,"_28366":123996,"_3078":124025},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3627":73944,"_31174":73933,"_21594":124027,"_5":14861,"_28366":123996,"_3078":124028},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3627":73945,"_31174":73933,"_21594":124030,"_5":14861,"_28366":124000,"_3078":124031},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3627":73946,"_31174":73933,"_21594":124033,"_5":14861,"_28366":124000,"_3078":124034},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3627":73947,"_31174":73933,"_21594":124036,"_5":14861,"_28366":124004,"_3078":124037},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3627":73948,"_31174":73933,"_21594":124039,"_5":14861,"_28366":124004,"_3078":124040},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3627":73949,"_31174":73933,"_21594":124042,"_5":14861,"_28366":124004,"_3078":124043},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3627":73950,"_31174":73933,"_21594":124045,"_5":14861,"_28366":124008,"_3078":124046},[],"Situación",{"_3627":73951,"_31174":73933,"_21594":124048,"_5":14861,"_28366":124008,"_3078":124049},[],"Procedimiento",{"_3627":73952,"_31174":73933,"_21594":124051,"_5":14861,"_28366":124008,"_3078":124052},[],"Certificado vigente, fuera de ventana",{"_3627":73953,"_31174":73933,"_21594":124054,"_5":14861,"_28366":124008,"_3078":124055},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3627":73954,"_31174":73933,"_21594":124057,"_5":14861,"_28366":124008,"_3078":124058},[],"Certificado vencido, clave disponible",{"_3627":73955,"_31174":73933,"_21594":124060,"_5":14861,"_28366":124008,"_3078":124061},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3627":73956,"_31174":73933,"_21594":124063,"_5":14861,"_28366":124008,"_3078":124064},[],"Renovación por webhook o `NO_AUTH`",{"_3627":73957,"_31174":73933,"_21594":124066,"_5":14861,"_28366":124008,"_3078":124067},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3627":73958,"_31174":73933,"_21594":124069,"_5":14861,"_28366":124008,"_3078":124070},[],"Clave perdida o inaccesible",{"_3627":73959,"_31174":73933,"_21594":124072,"_5":14861,"_28366":124008,"_3078":124073},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3627":73960,"_31174":73933,"_21594":124075,"_5":14861,"_28366":124008,"_3078":124076},[],"Identidad actual revocada",{"_3627":73961,"_31174":73933,"_21594":124078,"_5":14861,"_28366":124008,"_3078":124079},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3627":73962,"_31174":73933,"_21594":124081,"_5":14861,"_28366":124008,"_3078":124082},[],"Dispositivo sin identidad",{"_3627":73963,"_31174":73933,"_21594":124084,"_5":14861,"_28366":124008,"_3078":124085},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3627":73964,"_31174":73933,"_21594":124087,"_5":14861,"_28366":124008,"_3078":124088},[],"Dispositivo retirado",{"_3627":73965,"_31174":73933,"_21594":124090,"_5":14861,"_28366":124008,"_3078":124091},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3627":73966,"_31174":73933,"_21594":124093,"_5":14861,"_28366":124008,"_3078":124094},[],"Timeout, HTTP 500 o fallo de instalación",{"_3627":73967,"_31174":73933,"_21594":124096,"_5":14861,"_28366":124008,"_3078":124097},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3627":73968,"_31174":73933,"_21594":124099,"_5":14861,"_28366":124012,"_3078":124100},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3627":73969,"_31174":73933,"_21594":124102,"_5":14861,"_28366":124012,"_3078":124103},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3627":73970,"_31174":73970,"_5":15221,"_3078":124105,"_31533":124106,"_21594":124107,"_28366":73970},"Diagnóstico de enrolamiento",[50951,121820,53635,122965,123143],[],{"_3627":73971,"_31174":73970,"_21594":124109,"_5":14861,"_28366":73970,"_3078":124110},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3627":73972,"_31174":73970,"_5":31530,"_21594":124112,"_28366":124113,"_3078":124114},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3627":73973,"_31174":73970,"_5":31530,"_21594":124116,"_28366":124117,"_3078":124118},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3627":73974,"_31174":73970,"_5":31530,"_21594":124120,"_28366":124121,"_3078":123684},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3627":73975,"_31174":73970,"_5":31530,"_21594":124123,"_28366":124124,"_3078":124125},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3627":73976,"_31174":73970,"_21594":124127,"_5":14861,"_28366":73970,"_3078":124128},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3627":73977,"_31174":73970,"_21594":124130,"_5":14861,"_28366":124117,"_3078":124131},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3627":73978,"_31174":73970,"_21594":124133,"_5":14861,"_28366":124117,"_3078":124134},[],"Síntoma o mensaje",{"_3627":73979,"_31174":73970,"_21594":124136,"_5":14861,"_28366":124117,"_3078":124137},[],"Qué revisar",{"_3627":73980,"_31174":73970,"_21594":124139,"_5":14861,"_28366":124117,"_3078":124140},[],"curl rechaza TLS, nombre o emisor",{"_3627":73981,"_31174":73970,"_21594":124142,"_5":14861,"_28366":124117,"_3078":124143},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3627":73982,"_31174":73970,"_21594":124145,"_5":14861,"_28366":124117,"_3078":124146},[],"404 o APS ausente",{"_3627":73983,"_31174":73970,"_21594":124148,"_5":14861,"_28366":124117,"_3078":124149},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3627":73984,"_31174":73970,"_21594":124151,"_5":14861,"_28366":124117,"_3078":124152},[],"400, error de CSR o formato",{"_3627":73985,"_31174":73970,"_21594":124154,"_5":14861,"_28366":124117,"_3078":124155},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3627":73986,"_31174":73970,"_21594":124157,"_5":14861,"_28366":124117,"_3078":124158},[],"Credencial ausente o certificado no válido",{"_3627":73987,"_31174":73970,"_21594":124160,"_5":14861,"_28366":124117,"_3078":124161},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3627":73988,"_31174":73970,"_21594":124163,"_5":14861,"_28366":124117,"_3078":124164},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3627":73989,"_31174":73970,"_21594":124166,"_5":14861,"_28366":124117,"_3078":124167},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3627":73990,"_31174":73970,"_21594":124169,"_5":14861,"_28366":124117,"_3078":124170},[],"Webhook deniega, expira o responde sin autorización",{"_3627":73991,"_31174":73970,"_21594":124172,"_5":14861,"_28366":124117,"_3078":124173},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3627":73992,"_31174":73970,"_21594":124175,"_5":14861,"_28366":124117,"_3078":54891},[],{"_3627":73993,"_31174":73970,"_21594":124177,"_5":14861,"_28366":124117,"_3078":124178},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3627":73994,"_31174":73970,"_21594":124180,"_5":14861,"_28366":124117,"_3078":54897},[],{"_3627":73995,"_31174":73970,"_21594":124182,"_5":14861,"_28366":124117,"_3078":124183},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3627":73996,"_31174":73970,"_21594":124185,"_5":14861,"_28366":124117,"_3078":54903},[],{"_3627":73997,"_31174":73970,"_21594":124187,"_5":14861,"_28366":124117,"_3078":124188},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3627":73998,"_31174":73970,"_21594":124190,"_5":14861,"_28366":124117,"_3078":54909},[],{"_3627":73999,"_31174":73970,"_21594":124192,"_5":14861,"_28366":124117,"_3078":124193},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3627":74000,"_31174":73970,"_21594":124195,"_5":14861,"_28366":124117,"_3078":54915},[],{"_3627":74001,"_31174":73970,"_21594":124197,"_5":14861,"_28366":124117,"_3078":124198},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3627":74002,"_31174":73970,"_21594":124200,"_5":14861,"_28366":124117,"_3078":124201},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3627":74003,"_31174":73970,"_21594":124203,"_5":14861,"_28366":124117,"_3078":124204},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3627":74004,"_31174":73970,"_21594":124206,"_5":14861,"_28366":124117,"_3078":124207},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3627":74005,"_31174":73970,"_21594":124209,"_5":14861,"_28366":124117,"_3078":124210},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3627":74006,"_31174":73970,"_21594":124212,"_5":14861,"_28366":124117,"_3078":54933},[],{"_3627":74007,"_31174":73970,"_21594":124214,"_5":14861,"_28366":124117,"_3078":124215},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3627":74008,"_31174":73970,"_21594":124217,"_5":14861,"_28366":124117,"_3078":54939},[],{"_3627":74009,"_31174":73970,"_21594":124219,"_5":14861,"_28366":124117,"_3078":124220},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3627":74010,"_31174":73970,"_21594":124222,"_5":14861,"_28366":124117,"_3078":124223},[],"DMS propietario distinto",{"_3627":74011,"_31174":73970,"_21594":124225,"_5":14861,"_28366":124117,"_3078":124226},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3627":74012,"_31174":73970,"_21594":124228,"_5":14861,"_28366":124117,"_3078":54951},[],{"_3627":74013,"_31174":73970,"_21594":124230,"_5":14861,"_28366":124117,"_3078":124231},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3627":74014,"_31174":73970,"_21594":124233,"_5":14861,"_28366":124117,"_3078":54957},[],{"_3627":74015,"_31174":73970,"_21594":124235,"_5":14861,"_28366":124117,"_3078":124236},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3627":74016,"_31174":73970,"_21594":124238,"_5":14861,"_28366":124117,"_3078":124239},[],"Certificado actual revocado",{"_3627":74017,"_31174":73970,"_21594":124241,"_5":14861,"_28366":124117,"_3078":124242},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3627":74018,"_31174":73970,"_21594":124244,"_5":14861,"_28366":124117,"_3078":124245},[],"Error de CA, perfil o firma",{"_3627":74019,"_31174":73970,"_21594":124247,"_5":14861,"_28366":124117,"_3078":124248},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3627":74020,"_31174":73970,"_21594":124250,"_5":14861,"_28366":124117,"_3078":124251},[],"HTTP 200 sin conexión del dispositivo",{"_3627":74021,"_31174":73970,"_21594":124253,"_5":14861,"_28366":124117,"_3078":124254},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3627":74022,"_31174":73970,"_21594":124256,"_5":14861,"_28366":124117,"_3078":124257},[],"Timeout o error después de emitir",{"_3627":74023,"_31174":73970,"_21594":124259,"_5":14861,"_28366":124117,"_3078":124260},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3627":74024,"_31174":73970,"_21594":124262,"_5":14861,"_28366":124121,"_3078":124263},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3627":74025,"_31174":73970,"_21594":124265,"_5":14861,"_28366":124121,"_3078":124266},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3627":74026,"_31174":73970,"_21594":124268,"_5":14861,"_28366":124124,"_3078":124269},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3627":74027,"_31174":73970,"_21594":124271,"_5":14861,"_28366":124124,"_3078":124272},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3627":74028,"_31174":73970,"_21594":124274,"_5":14861,"_28366":124124,"_3078":124275},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3627":74029,"_31174":73970,"_21594":124277,"_5":14861,"_28366":124124,"_3078":124278},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3627":74030,"_31174":73970,"_21594":124280,"_5":14861,"_28366":124124,"_3078":124281},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3627":74031,"_31174":73970,"_21594":124283,"_5":14861,"_28366":124124,"_3078":124284},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3627":74032,"_31174":73970,"_21594":124286,"_5":14861,"_28366":124124,"_3078":124287},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3627":74033,"_31174":74033,"_5":15221,"_3078":124289,"_31533":124290,"_21594":124291,"_28366":74033},"Distribución y actualización de confianza",[50951,121820,53635,122965,123143],[],{"_3627":74034,"_31174":74033,"_21594":124293,"_5":14861,"_28366":74033,"_3078":124294},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3627":74035,"_31174":74033,"_5":31530,"_21594":124296,"_28366":124297,"_3078":124298},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3627":74036,"_31174":74033,"_5":31530,"_21594":124300,"_28366":124301,"_3078":124302},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3627":74037,"_31174":74033,"_5":31530,"_21594":124304,"_28366":124305,"_3078":124306},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3627":74038,"_31174":74033,"_5":31530,"_21594":124308,"_28366":124309,"_3078":124310},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3627":74039,"_31174":74033,"_5":31530,"_21594":124312,"_28366":124313,"_3078":124314},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3627":74040,"_31174":74033,"_21594":124316,"_5":14861,"_28366":74033,"_3078":124317},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3627":74041,"_31174":74033,"_21594":124319,"_5":14861,"_28366":124297,"_3078":124320},[],"Relación",{"_3627":74042,"_31174":74033,"_21594":124322,"_5":14861,"_28366":124297,"_3078":124323},[],"Material que prepara el responsable",{"_3627":74043,"_31174":74033,"_21594":124325,"_5":14861,"_28366":124297,"_3078":124326},[],"Dispositivo → servidor EST",{"_3627":74044,"_31174":74033,"_21594":124328,"_5":14861,"_28366":124297,"_3078":124329},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3627":74045,"_31174":74033,"_21594":124331,"_5":14861,"_28366":124297,"_3078":124332},[],"DMS → solicitante",{"_3627":74046,"_31174":74033,"_21594":124334,"_5":14861,"_28366":124297,"_3078":124335},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3627":74047,"_31174":74033,"_21594":124337,"_5":14861,"_28366":124297,"_3078":124338},[],"Consumidor → dispositivo",{"_3627":74048,"_31174":74033,"_21594":124340,"_5":14861,"_28366":124297,"_3078":124341},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3627":74049,"_31174":74033,"_21594":124343,"_5":14861,"_28366":124297,"_3078":124344},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3627":74050,"_31174":74033,"_21594":124346,"_5":14861,"_28366":124301,"_3078":124347},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3627":74051,"_31174":74033,"_21594":124349,"_5":14861,"_28366":124301,"_3078":124350},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3627":74052,"_31174":74033,"_21594":124352,"_5":14861,"_28366":124305,"_3078":124353},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3627":74053,"_31174":74033,"_21594":124355,"_5":14861,"_28366":124305,"_3078":124356},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3627":74054,"_31174":74033,"_21594":124358,"_5":14861,"_28366":124305,"_3078":124359},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3627":74055,"_31174":74033,"_21594":124361,"_5":14861,"_28366":124305,"_3078":124362},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3627":74056,"_31174":74033,"_21594":124364,"_5":14861,"_28366":124305,"_3078":124365},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3627":74057,"_31174":74033,"_21594":124367,"_5":14861,"_28366":124305,"_3078":124368},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3627":74058,"_31174":74033,"_21594":124370,"_5":14861,"_28366":124309,"_3078":124371},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3627":74059,"_31174":74033,"_21594":124373,"_5":14861,"_28366":124309,"_3078":124374},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3627":74060,"_31174":74033,"_21594":124376,"_5":14861,"_28366":124309,"_3078":124377},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3627":74061,"_31174":74033,"_21594":124379,"_5":14861,"_28366":124313,"_3078":124380},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3627":74062,"_31174":74062,"_5":15221,"_3078":55106,"_31533":124382,"_21594":124384,"_28366":74062},[50951,121820,53635,122965,124383],"Integraciones",[],{"_3627":74063,"_31174":74062,"_21594":124386,"_5":14861,"_28366":74062,"_3078":124387},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3627":74064,"_31174":74062,"_5":31530,"_21594":124389,"_28366":124390,"_3078":124391},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3627":74065,"_31174":74062,"_5":31530,"_21594":124393,"_28366":124394,"_3078":124395},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3627":74066,"_31174":74062,"_5":31530,"_21594":124397,"_28366":124398,"_3078":124399},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3627":74067,"_31174":74062,"_5":31530,"_21594":124401,"_28366":124402,"_3078":124403},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3627":74068,"_31174":74062,"_5":31530,"_21594":124405,"_28366":124406,"_3078":124407},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3627":74069,"_31174":74062,"_5":31530,"_21594":124409,"_28366":124410,"_3078":124411},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3627":74070,"_31174":74062,"_5":31530,"_21594":124413,"_28366":124414,"_3078":124415},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3627":74071,"_31174":74062,"_5":31530,"_21594":124417,"_28366":124418,"_3078":124419},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3627":74072,"_31174":74062,"_5":31530,"_21594":124421,"_28366":124422,"_3078":55148},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3627":74073,"_31174":74062,"_5":31530,"_21594":124424,"_28366":124425,"_3078":55152},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3627":74074,"_31174":74062,"_5":31530,"_21594":124427,"_28366":124428,"_3078":124429},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3627":74075,"_31174":74062,"_5":31530,"_21594":124431,"_28366":124432,"_3078":124433},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3627":74076,"_31174":74062,"_5":31530,"_21594":124435,"_28366":124436,"_3078":124437},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3627":74077,"_31174":74062,"_5":31530,"_21594":124439,"_28366":124440,"_3078":124441},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3627":74078,"_31174":74062,"_5":31530,"_21594":124443,"_28366":124444,"_3078":124445},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3627":74079,"_31174":74062,"_5":31530,"_21594":124447,"_28366":124448,"_3078":124449},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3627":74080,"_31174":74062,"_5":31530,"_21594":124451,"_28366":124452,"_3078":124453},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3627":74081,"_31174":74062,"_5":31530,"_21594":124455,"_28366":124456,"_3078":124457},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3627":74082,"_31174":74062,"_5":31530,"_21594":124459,"_28366":124460,"_3078":124461},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3627":74083,"_31174":74062,"_5":31530,"_21594":124463,"_28366":124464,"_3078":124465},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3627":74084,"_31174":74062,"_5":31530,"_21594":124467,"_28366":124468,"_3078":124469},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3627":74085,"_31174":74062,"_5":31530,"_21594":124471,"_28366":124472,"_3078":124473},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3627":74086,"_31174":74062,"_5":31530,"_21594":124475,"_28366":124476,"_3078":124477},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3627":74087,"_31174":74062,"_5":31530,"_21594":124479,"_28366":124480,"_3078":124481},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3627":74088,"_31174":74062,"_5":31530,"_21594":124483,"_28366":124484,"_3078":124485},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3627":74089,"_31174":74062,"_21594":124487,"_5":14861,"_28366":74062,"_3078":124488},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3627":74090,"_31174":74062,"_21594":124490,"_5":14861,"_28366":74062,"_3078":124491},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3627":74091,"_31174":74062,"_21594":124493,"_5":14861,"_28366":74062,"_3078":124494},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3627":74092,"_31174":74062,"_21594":124496,"_5":14861,"_28366":124390,"_3078":124497},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3627":74093,"_31174":74062,"_21594":124499,"_5":14861,"_28366":124390,"_3078":124500},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3627":74094,"_31174":74062,"_21594":124502,"_5":14861,"_28366":124390,"_3078":124503},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3627":74095,"_31174":74062,"_21594":124505,"_5":14861,"_28366":124390,"_3078":124506},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3627":74096,"_31174":74062,"_21594":124508,"_5":14861,"_28366":124394,"_3078":124509},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3627":74097,"_31174":74062,"_21594":124511,"_5":14861,"_28366":124398,"_3078":124512},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3627":74098,"_31174":74062,"_21594":124514,"_5":14861,"_28366":124398,"_3078":124515},[],"Acción IAM",{"_3627":74099,"_31174":74062,"_21594":124517,"_5":14861,"_28366":124398,"_3078":120724},[],{"_3627":74100,"_31174":74062,"_21594":124519,"_5":14861,"_28366":124398,"_3078":55247},[],{"_3627":74101,"_31174":74062,"_21594":124521,"_5":14861,"_28366":124398,"_3078":124522},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3627":74102,"_31174":74062,"_21594":124524,"_5":14861,"_28366":124398,"_3078":55253},[],{"_3627":74103,"_31174":74062,"_21594":124526,"_5":14861,"_28366":124398,"_3078":124527},[],"Registrar la CA en AWS IoT",{"_3627":74104,"_31174":74062,"_21594":124529,"_5":14861,"_28366":124398,"_3078":55259},[],{"_3627":74105,"_31174":74062,"_21594":124531,"_5":14861,"_28366":124398,"_3078":124532},[],"Consultar el estado del registro de la CA",{"_3627":74106,"_31174":74062,"_21594":124534,"_5":14861,"_28366":124398,"_3078":55265},[],{"_3627":74107,"_31174":74062,"_21594":124536,"_5":14861,"_28366":124398,"_3078":124537},[],"Crear o actualizar Things en IoT Core",{"_3627":74108,"_31174":74062,"_21594":124539,"_5":14861,"_28366":124398,"_3078":55271},[],{"_3627":74109,"_31174":74062,"_21594":124541,"_5":14861,"_28366":124398,"_3078":124542},[],"Aprovisionar Things mediante plantilla",{"_3627":74110,"_31174":74062,"_21594":124544,"_5":14861,"_28366":124398,"_3078":55277},[],{"_3627":74111,"_31174":74062,"_21594":124546,"_5":14861,"_28366":124398,"_3078":124547},[],"Registrar certificados de dispositivo",{"_3627":74112,"_31174":74062,"_21594":124549,"_5":14861,"_28366":124398,"_3078":55283},[],{"_3627":74113,"_31174":74062,"_21594":124551,"_5":14861,"_28366":124398,"_3078":124552},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3627":74114,"_31174":74062,"_21594":124554,"_5":14861,"_28366":124398,"_3078":55289},[],{"_3627":74115,"_31174":74062,"_21594":124556,"_5":14861,"_28366":124398,"_3078":124557},[],"Crear y adjuntar políticas IoT",{"_3627":74116,"_31174":74062,"_21594":124559,"_5":14861,"_28366":124398,"_3078":55295},[],{"_3627":74117,"_31174":74062,"_21594":124561,"_5":14861,"_28366":124398,"_3078":124562},[],"Gestionar grupos de Things",{"_3627":74118,"_31174":74062,"_21594":124564,"_5":14861,"_28366":124398,"_3078":55301},[],{"_3627":74119,"_31174":74062,"_21594":124566,"_5":14861,"_28366":124398,"_3078":124567},[],"Crear plantillas JITP",{"_3627":74120,"_31174":74062,"_21594":124569,"_5":14861,"_28366":124398,"_3078":55307},[],{"_3627":74121,"_31174":74062,"_21594":124571,"_5":14861,"_28366":124398,"_3078":124572},[],"Leer y escribir el Device Shadow",{"_3627":74122,"_31174":74062,"_21594":124574,"_5":14861,"_28366":124398,"_3078":124575},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3627":74123,"_31174":74062,"_21594":124577,"_5":14861,"_28366":124402,"_3078":124578},[],"Parámetro",{"_3627":74124,"_31174":74062,"_21594":124580,"_5":14861,"_28366":124402,"_3078":124581},[],"Tipo",{"_3627":74125,"_31174":74062,"_21594":124583,"_5":14861,"_28366":124402,"_3078":124584},[],"Requerido",{"_3627":74126,"_31174":74062,"_21594":124586,"_5":14861,"_28366":124402,"_3078":124587},[],"Descripción",{"_3627":74127,"_31174":74062,"_21594":124589,"_5":14861,"_28366":124402,"_3078":55328},[],{"_3627":74128,"_31174":74062,"_21594":124591,"_5":14861,"_28366":124402,"_3078":25780},[],{"_3627":74129,"_31174":74062,"_21594":124593,"_5":14861,"_28366":124402,"_3078":124594},[],"Sí",{"_3627":74130,"_31174":74062,"_21594":124596,"_5":14861,"_28366":124402,"_3078":124597},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3627":74131,"_31174":74062,"_21594":124599,"_5":14861,"_28366":124402,"_3078":55339},[],{"_3627":74132,"_31174":74062,"_21594":124601,"_5":14861,"_28366":124402,"_3078":25780},[],{"_3627":74133,"_31174":74062,"_21594":124603,"_5":14861,"_28366":124402,"_3078":124594},[],{"_3627":74134,"_31174":74062,"_21594":124605,"_5":14861,"_28366":124402,"_3078":124606},[],"Región AWS donde opera el conector.",{"_3627":74135,"_31174":74062,"_21594":124608,"_5":14861,"_28366":124402,"_3078":55349},[],{"_3627":74136,"_31174":74062,"_21594":124610,"_5":14861,"_28366":124402,"_3078":25780},[],{"_3627":74137,"_31174":74062,"_21594":124612,"_5":14861,"_28366":124402,"_3078":124594},[],{"_3627":74138,"_31174":74062,"_21594":124614,"_5":14861,"_28366":124402,"_3078":124615},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3627":74139,"_31174":74062,"_21594":124617,"_5":14861,"_28366":124402,"_3078":55359},[],{"_3627":74140,"_31174":74062,"_21594":124619,"_5":14861,"_28366":124402,"_3078":25780},[],{"_3627":74141,"_31174":74062,"_21594":124621,"_5":14861,"_28366":124402,"_3078":124622},[],"Solo con `auth_method=static`",{"_3627":74142,"_31174":74062,"_21594":124624,"_5":14861,"_28366":124402,"_3078":124625},[],"Clave de acceso AWS.",{"_3627":74143,"_31174":74062,"_21594":124627,"_5":14861,"_28366":124402,"_3078":55370},[],{"_3627":74144,"_31174":74062,"_21594":124629,"_5":14861,"_28366":124402,"_3078":25780},[],{"_3627":74145,"_31174":74062,"_21594":124631,"_5":14861,"_28366":124402,"_3078":124622},[],{"_3627":74146,"_31174":74062,"_21594":124633,"_5":14861,"_28366":124402,"_3078":124634},[],"Clave secreta AWS.",{"_3627":74147,"_31174":74062,"_21594":124636,"_5":14861,"_28366":124402,"_3078":55380},[],{"_3627":74148,"_31174":74062,"_21594":124638,"_5":14861,"_28366":124402,"_3078":25780},[],{"_3627":74149,"_31174":74062,"_21594":124640,"_5":14861,"_28366":124402,"_3078":55385},[],{"_3627":74150,"_31174":74062,"_21594":124642,"_5":14861,"_28366":124402,"_3078":124643},[],"Token de sesión (con `auth_method=static`).",{"_3627":74151,"_31174":74062,"_21594":124645,"_5":14861,"_28366":124402,"_3078":55391},[],{"_3627":74152,"_31174":74062,"_21594":124647,"_5":14861,"_28366":124402,"_3078":25780},[],{"_3627":74153,"_31174":74062,"_21594":124649,"_5":14861,"_28366":124402,"_3078":124650},[],"Solo con `auth_method=role`",{"_3627":74154,"_31174":74062,"_21594":124652,"_5":14861,"_28366":124402,"_3078":124653},[],"ARN del rol a asumir.",{"_3627":74155,"_31174":74062,"_21594":124655,"_5":14861,"_28366":124402,"_3078":55402},[],{"_3627":74156,"_31174":74062,"_21594":124657,"_5":14861,"_28366":124402,"_3078":25780},[],{"_3627":74157,"_31174":74062,"_21594":124659,"_5":14861,"_28366":124402,"_3078":55385},[],{"_3627":74158,"_31174":74062,"_21594":124661,"_5":14861,"_28366":124402,"_3078":124662},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3627":74159,"_31174":74062,"_21594":124664,"_5":14861,"_28366":124402,"_3078":55412},[],{"_3627":74160,"_31174":74062,"_21594":124666,"_5":14861,"_28366":124402,"_3078":92911},[],{"_3627":74161,"_31174":74062,"_21594":124668,"_5":14861,"_28366":124402,"_3078":124594},[],{"_3627":74162,"_31174":74062,"_21594":124670,"_5":14861,"_28366":124402,"_3078":124671},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3627":74163,"_31174":74062,"_21594":124673,"_5":14861,"_28366":124402,"_3078":55422},[],{"_3627":74164,"_31174":74062,"_21594":124675,"_5":14861,"_28366":124402,"_3078":25780},[],{"_3627":74165,"_31174":74062,"_21594":124677,"_5":14861,"_28366":124402,"_3078":124594},[],{"_3627":74166,"_31174":74062,"_21594":124679,"_5":14861,"_28366":124402,"_3078":124680},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3627":74167,"_31174":74062,"_21594":124682,"_5":14861,"_28366":124402,"_3078":55432},[],{"_3627":74168,"_31174":74062,"_21594":124684,"_5":14861,"_28366":124402,"_3078":25780},[],{"_3627":74169,"_31174":74062,"_21594":124686,"_5":14861,"_28366":124402,"_3078":124594},[],{"_3627":74170,"_31174":74062,"_21594":124688,"_5":14861,"_28366":124402,"_3078":124689},[],"URL HTTP del Device Manager de Lamassu.",{"_3627":74171,"_31174":74062,"_21594":124691,"_5":14861,"_28366":124402,"_3078":55442},[],{"_3627":74172,"_31174":74062,"_21594":124693,"_5":14861,"_28366":124402,"_3078":25780},[],{"_3627":74173,"_31174":74062,"_21594":124695,"_5":14861,"_28366":124402,"_3078":124594},[],{"_3627":74174,"_31174":74062,"_21594":124697,"_5":14861,"_28366":124402,"_3078":124698},[],"URL HTTP del servicio de CA de Lamassu.",{"_3627":74175,"_31174":74062,"_21594":124700,"_5":14861,"_28366":124406,"_3078":124701},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3627":74176,"_31174":74062,"_21594":124703,"_5":14861,"_28366":124406,"_3078":124704},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3627":74177,"_31174":74062,"_21594":124706,"_5":14861,"_28366":124406,"_3078":124707},[],"Tipo de CloudEvent",{"_3627":74178,"_31174":74062,"_21594":124709,"_5":14861,"_28366":124406,"_3078":124710},[],"Recurso en Lamassu",{"_3627":74179,"_31174":74062,"_21594":124712,"_5":14861,"_28366":124406,"_3078":124713},[],"Recurso AWS",{"_3627":74180,"_31174":74062,"_21594":124715,"_5":14861,"_28366":124406,"_3078":124716},[],"Acciones IAM",{"_3627":74181,"_31174":74062,"_21594":124718,"_5":14861,"_28366":124406,"_3078":124719},[],"Llamadas AWS y efecto",{"_3627":74182,"_31174":74062,"_21594":124721,"_5":14861,"_28366":124406,"_3078":124722},[],"Dónde en esta página",{"_3627":74183,"_31174":74062,"_21594":124724,"_5":14861,"_28366":124406,"_3078":55476},[],{"_3627":74184,"_31174":74062,"_21594":124726,"_5":14861,"_28366":124406,"_3078":55479},[],{"_3627":74185,"_31174":74062,"_21594":124728,"_5":14861,"_28366":124406,"_3078":55482},[],{"_3627":74186,"_31174":74062,"_21594":124730,"_5":14861,"_28366":124406,"_3078":55485},[],{"_3627":74187,"_31174":74062,"_21594":124732,"_5":14861,"_28366":124406,"_3078":124733},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3627":74188,"_31174":74062,"_21594":124735,"_5":14861,"_28366":124406,"_3078":124419},[],{"_3627":74189,"_31174":74062,"_21594":124737,"_5":14861,"_28366":124406,"_3078":55493},[],{"_3627":74190,"_31174":74062,"_21594":124739,"_5":14861,"_28366":124406,"_3078":55496},[],{"_3627":74191,"_31174":74062,"_21594":124741,"_5":14861,"_28366":124406,"_3078":55499},[],{"_3627":74192,"_31174":74062,"_21594":124743,"_5":14861,"_28366":124406,"_3078":55502},[],{"_3627":74193,"_31174":74062,"_21594":124745,"_5":14861,"_28366":124406,"_3078":124746},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3627":74194,"_31174":74062,"_21594":124748,"_5":14861,"_28366":124406,"_3078":124445},[],{"_3627":74195,"_31174":74062,"_21594":124750,"_5":14861,"_28366":124406,"_3078":55510},[],{"_3627":74196,"_31174":74062,"_21594":124752,"_5":14861,"_28366":124406,"_3078":124753},[],"Dispositivo",{"_3627":74197,"_31174":74062,"_21594":124755,"_5":14861,"_28366":124406,"_3078":55516},[],{"_3627":74198,"_31174":74062,"_21594":124757,"_5":14861,"_28366":124406,"_3078":55519},[],{"_3627":74199,"_31174":74062,"_21594":124759,"_5":14861,"_28366":124406,"_3078":124760},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3627":74200,"_31174":74062,"_21594":124762,"_5":14861,"_28366":124406,"_3078":124453},[],{"_3627":74201,"_31174":74062,"_21594":124764,"_5":14861,"_28366":124406,"_3078":55527},[],{"_3627":74202,"_31174":74062,"_21594":124766,"_5":14861,"_28366":124406,"_3078":124767},[],"Certificado",{"_3627":74203,"_31174":74062,"_21594":124769,"_5":14861,"_28366":124406,"_3078":55533},[],{"_3627":74204,"_31174":74062,"_21594":124771,"_5":14861,"_28366":124406,"_3078":124772},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3627":74205,"_31174":74062,"_21594":124774,"_5":14861,"_28366":124406,"_3078":124775},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3627":74206,"_31174":74062,"_21594":124777,"_5":14861,"_28366":124406,"_3078":124465},[],{"_3627":74207,"_31174":74062,"_21594":124779,"_5":14861,"_28366":124406,"_3078":55544},[],{"_3627":74208,"_31174":74062,"_21594":124781,"_5":14861,"_28366":124406,"_3078":124782},[],"Certificado / Dispositivo",{"_3627":74209,"_31174":74062,"_21594":124784,"_5":14861,"_28366":124406,"_3078":55550},[],{"_3627":74210,"_31174":74062,"_21594":124786,"_5":14861,"_28366":124406,"_3078":51347},[],{"_3627":74211,"_31174":74062,"_21594":124788,"_5":14861,"_28366":124406,"_3078":124789},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3627":74212,"_31174":74062,"_21594":124791,"_5":14861,"_28366":124406,"_3078":124473},[],{"_3627":74213,"_31174":74062,"_21594":124793,"_5":14861,"_28366":124410,"_3078":124794},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3627":74214,"_31174":74062,"_21594":124796,"_5":14861,"_28366":124414,"_3078":124797},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3627":74215,"_31174":74062,"_21594":124799,"_5":14861,"_28366":124414,"_3078":124800},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3627":74216,"_31174":74062,"_21594":124802,"_5":14861,"_28366":124418,"_3078":124803},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3627":74217,"_31174":74062,"_21594":124805,"_5":14861,"_28366":124418,"_3078":124806},[],"Transición",{"_3627":74218,"_31174":74062,"_21594":124808,"_5":14861,"_28366":124418,"_3078":124809},[],"Llamadas AWS",{"_3627":74219,"_31174":74062,"_21594":124811,"_5":14861,"_28366":124418,"_3078":124812},[],"`NoRegistrada` → `Solicitada`",{"_3627":74220,"_31174":74062,"_21594":124814,"_5":14861,"_28366":124418,"_3078":124815},[],"ninguna (solo escritura de metadatos)",{"_3627":74221,"_31174":74062,"_21594":124817,"_5":14861,"_28366":124418,"_3078":124818},[],"`Solicitada` → `Registrando`",{"_3627":74222,"_31174":74062,"_21594":124820,"_5":14861,"_28366":124418,"_3078":124821},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3627":74223,"_31174":74062,"_21594":124823,"_5":14861,"_28366":124418,"_3078":124824},[],"`Registrando` → `Completada`",{"_3627":74224,"_31174":74062,"_21594":124826,"_5":14861,"_28366":124418,"_3078":124827},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3627":74225,"_31174":74062,"_21594":124829,"_5":14861,"_28366":124418,"_3078":124830},[],"`Registrando` → `Fallida`",{"_3627":74226,"_31174":74062,"_21594":124832,"_5":14861,"_28366":124418,"_3078":124833},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3627":74227,"_31174":74062,"_21594":124835,"_5":14861,"_28366":124418,"_3078":124836},[],"`Fallida` / `Completada` → `Solicitada`",{"_3627":74228,"_31174":74062,"_21594":124838,"_5":14861,"_28366":124418,"_3078":124839},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3627":74229,"_31174":74062,"_21594":124841,"_5":14861,"_28366":124422,"_3078":124842},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3627":74230,"_31174":74062,"_21594":124844,"_5":14861,"_28366":124422,"_3078":124845},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3627":74231,"_31174":74062,"_21594":124847,"_5":14861,"_28366":124422,"_3078":124848},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3627":74232,"_31174":74062,"_21594":124850,"_5":14861,"_28366":124422,"_3078":124851},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3627":74233,"_31174":74062,"_21594":124853,"_5":14861,"_28366":124422,"_3078":124854},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3627":74234,"_31174":74062,"_21594":124856,"_5":14861,"_28366":124422,"_3078":124857},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3627":74235,"_31174":74062,"_21594":124859,"_5":14861,"_28366":124425,"_3078":124860},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3627":74236,"_31174":74062,"_21594":124862,"_5":14861,"_28366":124428,"_3078":124863},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3627":74237,"_31174":74062,"_21594":124865,"_5":14861,"_28366":124428,"_3078":124866},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3627":74238,"_31174":74062,"_21594":124868,"_5":14861,"_28366":124432,"_3078":124869},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3627":74239,"_31174":74062,"_21594":124871,"_5":14861,"_28366":124436,"_3078":124872},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3627":74240,"_31174":74062,"_21594":124874,"_5":14861,"_28366":124436,"_3078":124875},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3627":74241,"_31174":74062,"_21594":124877,"_5":14861,"_28366":124436,"_3078":124878},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3627":74242,"_31174":74062,"_21594":124880,"_5":14861,"_28366":124436,"_3078":124881},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3627":74243,"_31174":74062,"_21594":124883,"_5":14861,"_28366":124436,"_3078":124884},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3627":74244,"_31174":74062,"_21594":124886,"_5":14861,"_28366":124436,"_3078":124887},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3627":74245,"_31174":74062,"_21594":124889,"_5":14861,"_28366":124440,"_3078":124890},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3627":74246,"_31174":74062,"_21594":124892,"_5":14861,"_28366":124440,"_3078":124893},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3627":74247,"_31174":74062,"_21594":124895,"_5":14861,"_28366":124440,"_3078":124896},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3627":74248,"_31174":74062,"_21594":124898,"_5":14861,"_28366":124440,"_3078":124899},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3627":74249,"_31174":74062,"_21594":124901,"_5":14861,"_28366":124440,"_3078":124902},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3627":74250,"_31174":74062,"_21594":124904,"_5":14861,"_28366":124444,"_3078":124905},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3627":74251,"_31174":74062,"_21594":124907,"_5":14861,"_28366":124444,"_3078":124806},[],{"_3627":74252,"_31174":74062,"_21594":124909,"_5":14861,"_28366":124444,"_3078":124809},[],{"_3627":74253,"_31174":74062,"_21594":124911,"_5":14861,"_28366":124444,"_3078":124912},[],"`SinConfigurar` → `None` / `Auto`",{"_3627":74254,"_31174":74062,"_21594":124914,"_5":14861,"_28366":124444,"_3078":124915},[],"ninguna (solo configuración)",{"_3627":74255,"_31174":74062,"_21594":124917,"_5":14861,"_28366":124444,"_3078":55687},[],{"_3627":74256,"_31174":74062,"_21594":124919,"_5":14861,"_28366":124444,"_3078":124915},[],{"_3627":74257,"_31174":74062,"_21594":124921,"_5":14861,"_28366":124444,"_3078":124922},[],"Cualquiera → `Jitp`",{"_3627":74258,"_31174":74062,"_21594":124924,"_5":14861,"_28366":124444,"_3078":124925},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3627":74259,"_31174":74062,"_21594":124927,"_5":14861,"_28366":124444,"_3078":55698},[],{"_3627":74260,"_31174":74062,"_21594":124929,"_5":14861,"_28366":124444,"_3078":124930},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3627":74261,"_31174":74062,"_21594":124932,"_5":14861,"_28366":124448,"_3078":124933},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3627":74262,"_31174":74062,"_21594":124935,"_5":14861,"_28366":124448,"_3078":124936},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3627":74263,"_31174":74062,"_21594":124938,"_5":14861,"_28366":124448,"_3078":124939},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3627":74264,"_31174":74062,"_21594":124941,"_5":14861,"_28366":124452,"_3078":124942},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3627":74265,"_31174":74062,"_21594":124944,"_5":14861,"_28366":124452,"_3078":124806},[],{"_3627":74266,"_31174":74062,"_21594":124946,"_5":14861,"_28366":124452,"_3078":124809},[],{"_3627":74267,"_31174":74062,"_21594":124948,"_5":14861,"_28366":124452,"_3078":124949},[],"`Ausente` → `Aprovisionado`",{"_3627":74268,"_31174":74062,"_21594":124951,"_5":14861,"_28366":124452,"_3078":124952},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3627":74269,"_31174":74062,"_21594":124954,"_5":14861,"_28366":124452,"_3078":124955},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3627":74270,"_31174":74062,"_21594":124957,"_5":14861,"_28366":124452,"_3078":124958},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3627":74271,"_31174":74062,"_21594":124960,"_5":14861,"_28366":124452,"_3078":124961},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3627":74272,"_31174":74062,"_21594":124963,"_5":14861,"_28366":124456,"_3078":124964},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3627":74273,"_31174":74062,"_21594":124966,"_5":14861,"_28366":124456,"_3078":124967},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3627":74274,"_31174":74062,"_21594":124969,"_5":14861,"_28366":124456,"_3078":124970},[],"Para que el flujo JITP funcione correctamente:",{"_3627":74275,"_31174":74062,"_21594":124972,"_5":14861,"_28366":124456,"_3078":124973},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3627":74276,"_31174":74062,"_21594":124975,"_5":14861,"_28366":124456,"_3078":124976},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3627":74277,"_31174":74062,"_21594":124978,"_5":14861,"_28366":124456,"_3078":124979},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3627":74278,"_31174":74062,"_21594":124981,"_5":14861,"_28366":124456,"_3078":124982},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3627":74279,"_31174":74062,"_21594":124984,"_5":14861,"_28366":124460,"_3078":124985},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3627":74280,"_31174":74062,"_21594":124987,"_5":14861,"_28366":124460,"_3078":124988},[],"Estado en Lamassu",{"_3627":74281,"_31174":74062,"_21594":124990,"_5":14861,"_28366":124460,"_3078":124991},[],"Razón de revocación",{"_3627":74282,"_31174":74062,"_21594":124993,"_5":14861,"_28366":124460,"_3078":124994},[],"Estado en AWS IoT Core",{"_3627":74283,"_31174":74062,"_21594":124996,"_5":14861,"_28366":124460,"_3078":55768},[],{"_3627":74284,"_31174":74062,"_21594":124998,"_5":14861,"_28366":124460,"_3078":124999},[],"Ninguna",{"_3627":74285,"_31174":74062,"_21594":125001,"_5":14861,"_28366":124460,"_3078":55774},[],{"_3627":74286,"_31174":74062,"_21594":125003,"_5":14861,"_28366":124460,"_3078":55777},[],{"_3627":74287,"_31174":74062,"_21594":125005,"_5":14861,"_28366":124460,"_3078":55780},[],{"_3627":74288,"_31174":74062,"_21594":125007,"_5":14861,"_28366":124460,"_3078":55783},[],{"_3627":74289,"_31174":74062,"_21594":125009,"_5":14861,"_28366":124460,"_3078":55777},[],{"_3627":74290,"_31174":74062,"_21594":125011,"_5":14861,"_28366":124460,"_3078":125012},[],"Cualquier otra razón",{"_3627":74291,"_31174":74062,"_21594":125014,"_5":14861,"_28366":124460,"_3078":55791},[],{"_3627":74292,"_31174":74062,"_21594":125016,"_5":14861,"_28366":124460,"_3078":125017},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3627":74293,"_31174":74062,"_21594":125019,"_5":14861,"_28366":124464,"_3078":125020},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3627":74294,"_31174":74062,"_21594":125022,"_5":14861,"_28366":124464,"_3078":124806},[],{"_3627":74295,"_31174":74062,"_21594":125024,"_5":14861,"_28366":124464,"_3078":124809},[],{"_3627":74296,"_31174":74062,"_21594":125026,"_5":14861,"_28366":124464,"_3078":125027},[],"`NoSincronizado` → `Active`",{"_3627":74297,"_31174":74062,"_21594":125029,"_5":14861,"_28366":124464,"_3078":55283},[],{"_3627":74298,"_31174":74062,"_21594":125031,"_5":14861,"_28366":124464,"_3078":55809},[],{"_3627":74299,"_31174":74062,"_21594":125033,"_5":14861,"_28366":124464,"_3078":125034},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3627":74300,"_31174":74062,"_21594":125036,"_5":14861,"_28366":124464,"_3078":55815},[],{"_3627":74301,"_31174":74062,"_21594":125038,"_5":14861,"_28366":124464,"_3078":125034},[],{"_3627":74302,"_31174":74062,"_21594":125040,"_5":14861,"_28366":124464,"_3078":55820},[],{"_3627":74303,"_31174":74062,"_21594":125042,"_5":14861,"_28366":124464,"_3078":55283},[],{"_3627":74304,"_31174":74062,"_21594":125044,"_5":14861,"_28366":124464,"_3078":55825},[],{"_3627":74305,"_31174":74062,"_21594":125046,"_5":14861,"_28366":124464,"_3078":125047},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3627":74306,"_31174":74062,"_21594":125049,"_5":14861,"_28366":124468,"_3078":125050},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3627":74307,"_31174":74062,"_21594":125052,"_5":14861,"_28366":124468,"_3078":125053},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3627":74308,"_31174":74062,"_21594":125055,"_5":14861,"_28366":124468,"_3078":125056},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3627":74309,"_31174":74062,"_21594":125058,"_5":14861,"_28366":124472,"_3078":125059},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3627":74310,"_31174":74062,"_21594":125061,"_5":14861,"_28366":124472,"_3078":125062},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3627":74311,"_31174":74062,"_21594":125064,"_5":14861,"_28366":124476,"_3078":125065},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3627":74312,"_31174":74062,"_21594":125067,"_5":14861,"_28366":124476,"_3078":125068},[],"Existen dos tipos de acciones:",{"_3627":74313,"_31174":74062,"_21594":125070,"_5":14861,"_28366":124476,"_3078":125071},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3627":74314,"_31174":74062,"_21594":125073,"_5":14861,"_28366":124476,"_3078":125074},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3627":74315,"_31174":74062,"_21594":125076,"_5":14861,"_28366":124476,"_3078":125077},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3627":74316,"_31174":74062,"_21594":125079,"_5":14861,"_28366":124480,"_3078":125080},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3627":74317,"_31174":74062,"_21594":125082,"_5":14861,"_28366":124480,"_3078":125083},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3627":74318,"_31174":74062,"_21594":125085,"_5":14861,"_28366":124480,"_3078":125086},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3627":74319,"_31174":74062,"_21594":125088,"_5":14861,"_28366":124484,"_3078":125089},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3627":74320,"_31174":74062,"_21594":125091,"_5":14861,"_28366":124484,"_3078":125092},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3627":74321,"_31174":74062,"_21594":125094,"_5":14861,"_28366":124484,"_3078":125095},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3627":74322,"_31174":74062,"_21594":125097,"_5":14861,"_28366":124484,"_3078":125098},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3627":74323,"_31174":74062,"_21594":125100,"_5":14861,"_28366":124484,"_3078":125101},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3627":74324,"_31174":74062,"_21594":125103,"_5":14861,"_28366":124484,"_3078":125104},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3627":74325,"_31174":74062,"_21594":125106,"_5":14861,"_28366":124484,"_3078":125107},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3627":74326,"_31174":74062,"_21594":125109,"_5":14861,"_28366":124484,"_3078":125110},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3627":74327,"_31174":74062,"_21594":125112,"_5":14861,"_28366":124484,"_3078":125113},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3627":74328,"_31174":74062,"_21594":125115,"_5":14861,"_28366":124484,"_3078":125116},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3627":74329,"_31174":74062,"_21594":125118,"_5":14861,"_28366":124484,"_3078":125119},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3627":74330,"_31174":74062,"_21594":125121,"_5":14861,"_28366":124484,"_3078":125122},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3627":74331,"_31174":74062,"_21594":125124,"_5":14861,"_28366":124484,"_3078":125125},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3627":74332,"_31174":74062,"_21594":125127,"_5":14861,"_28366":124484,"_3078":125128},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3627":74333,"_31174":74062,"_21594":125130,"_5":14861,"_28366":124484,"_3078":125131},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3627":74334,"_31174":74062,"_21594":125133,"_5":14861,"_28366":124484,"_3078":125134},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3627":74335,"_31174":74062,"_21594":125136,"_5":14861,"_28366":124484,"_3078":125137},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3627":74336,"_31174":74062,"_21594":125139,"_5":14861,"_28366":124484,"_3078":125140},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3627":74337,"_31174":74062,"_21594":125142,"_5":14861,"_28366":124484,"_3078":125143},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3627":74338,"_31174":74062,"_21594":125145,"_5":14861,"_28366":124484,"_3078":125146},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3627":74339,"_31174":74062,"_21594":125148,"_5":14861,"_28366":124484,"_3078":125149},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3627":74340,"_31174":74062,"_21594":125151,"_5":14861,"_28366":124484,"_3078":125152},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3627":74341,"_31174":74062,"_21594":125154,"_5":14861,"_28366":124484,"_3078":125155},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3627":74342,"_31174":74062,"_21594":125157,"_5":14861,"_28366":124484,"_3078":125158},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3627":74343,"_31174":74343,"_5":15221,"_3078":53635,"_31533":125160,"_21594":125161,"_28366":74343},[50951,121820,53635],[],{"_3627":74344,"_31174":74343,"_21594":125163,"_5":14861,"_28366":74343,"_3078":125164},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3627":74345,"_31174":74343,"_5":31530,"_21594":125166,"_28366":125167,"_3078":125168},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3627":74346,"_31174":74343,"_5":31530,"_21594":125170,"_28366":125171,"_3078":122965},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3627":74347,"_31174":74343,"_5":31530,"_21594":125173,"_28366":125174,"_3078":123143},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3627":74348,"_31174":74343,"_5":31530,"_21594":125176,"_28366":125177,"_3078":124383},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#integraciones",{"_3627":74349,"_31174":74343,"_5":31530,"_21594":125179,"_28366":125180,"_3078":125181},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3627":74350,"_31174":74343,"_21594":125183,"_5":14861,"_28366":74343,"_3078":125184},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3627":74351,"_31174":74343,"_21594":125186,"_5":14861,"_28366":125167,"_3078":125187},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3627":74352,"_31174":74343,"_21594":125189,"_5":14861,"_28366":125167,"_3078":125190},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3627":74353,"_31174":74343,"_21594":125192,"_5":14861,"_28366":125171,"_3078":125193},[],"Recurso",{"_3627":74354,"_31174":74343,"_21594":125195,"_5":14861,"_28366":125171,"_3078":125196},[],"Qué representa",{"_3627":74355,"_31174":74343,"_21594":125198,"_5":14861,"_28366":125171,"_3078":125199},[],"**Dispositivo**",{"_3627":74356,"_31174":74343,"_21594":125201,"_5":14861,"_28366":125171,"_3078":125202},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3627":74357,"_31174":74343,"_21594":125204,"_5":14861,"_28366":125171,"_3078":125205},[],"**Identidad**",{"_3627":74358,"_31174":74343,"_21594":125207,"_5":14861,"_28366":125171,"_3078":125208},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3627":74359,"_31174":74343,"_21594":125210,"_5":14861,"_28366":125171,"_3078":55992},[],{"_3627":74360,"_31174":74343,"_21594":125212,"_5":14861,"_28366":125171,"_3078":125213},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3627":74361,"_31174":74343,"_21594":125215,"_5":14861,"_28366":125171,"_3078":125216},[],"**Flota**",{"_3627":74362,"_31174":74343,"_21594":125218,"_5":14861,"_28366":125171,"_3078":125219},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3627":74363,"_31174":74343,"_21594":125221,"_5":14861,"_28366":125171,"_3078":125222},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3627":74364,"_31174":74343,"_21594":125224,"_5":14861,"_28366":125171,"_3078":125225},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3627":74365,"_31174":74343,"_21594":125227,"_5":14861,"_28366":125174,"_3078":125228},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3627":74366,"_31174":74343,"_21594":125230,"_5":14861,"_28366":125174,"_3078":125231},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3627":74367,"_31174":74343,"_21594":125233,"_5":14861,"_28366":125174,"_3078":125234},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3627":74368,"_31174":74343,"_21594":125236,"_5":14861,"_28366":125174,"_3078":125237},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3627":74369,"_31174":74343,"_21594":125239,"_5":14861,"_28366":125174,"_3078":125240},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3627":74370,"_31174":74343,"_21594":125242,"_5":14861,"_28366":125174,"_3078":125243},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3627":74371,"_31174":74343,"_21594":125245,"_5":14861,"_28366":125174,"_3078":125246},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3627":74372,"_31174":74343,"_21594":125248,"_5":14861,"_28366":125174,"_3078":125249},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3627":74373,"_31174":74343,"_21594":125251,"_5":14861,"_28366":125177,"_3078":125252},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3627":74374,"_31174":74343,"_21594":125254,"_5":14861,"_28366":125177,"_3078":125255},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3627":74375,"_31174":74343,"_21594":125257,"_5":14861,"_28366":125180,"_3078":125258},[],"Participante",{"_3627":74376,"_31174":74343,"_21594":125260,"_5":14861,"_28366":125180,"_3078":125261},[],"Responsabilidad",{"_3627":74377,"_31174":74343,"_21594":125263,"_5":14861,"_28366":125180,"_3078":125264},[],"Administrador PKI",{"_3627":74378,"_31174":74343,"_21594":125266,"_5":14861,"_28366":125180,"_3078":125267},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3627":74379,"_31174":74343,"_21594":125269,"_5":14861,"_28366":125180,"_3078":125270},[],"Administrador del aprovisionamiento",{"_3627":74380,"_31174":74343,"_21594":125272,"_5":14861,"_28366":125180,"_3078":125273},[],"DMS, admisión, autenticación por operación e inventario.",{"_3627":74381,"_31174":74343,"_21594":125275,"_5":14861,"_28366":125180,"_3078":125276},[],"Integrador del dispositivo",{"_3627":74382,"_31174":74343,"_21594":125278,"_5":14861,"_28366":125180,"_3078":125279},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3627":74383,"_31174":74343,"_21594":125281,"_5":14861,"_28366":125180,"_3078":125282},[],"Integrador del consumidor",{"_3627":74384,"_31174":74343,"_21594":125284,"_5":14861,"_28366":125180,"_3078":125285},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3627":74385,"_31174":74343,"_21594":125287,"_5":14861,"_28366":125180,"_3078":125288},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3627":74386,"_31174":74386,"_5":15221,"_3078":125290,"_31533":125291,"_21594":125293,"_28366":74386},"Enrola y conecta tu primer dispositivo",[50951,121820,53635,125292],"Primeros pasos",[],{"_3627":74387,"_31174":74386,"_21594":125295,"_5":14861,"_28366":74386,"_3078":125296},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3627":74388,"_31174":74386,"_5":31530,"_21594":125298,"_28366":125299,"_3078":120354},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3627":74389,"_31174":74386,"_5":31530,"_21594":125301,"_28366":125302,"_3078":125303},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3627":74390,"_31174":74386,"_5":31530,"_21594":125305,"_28366":125306,"_3078":125307},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3627":74391,"_31174":74386,"_5":31530,"_21594":125309,"_28366":125310,"_3078":125311},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3627":74392,"_31174":74386,"_5":31530,"_21594":125313,"_28366":125314,"_3078":125315},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3627":74393,"_31174":74386,"_5":31530,"_21594":125317,"_28366":125318,"_3078":125319},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3627":74394,"_31174":74386,"_5":31530,"_21594":125321,"_28366":125322,"_3078":125323},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3627":74395,"_31174":74386,"_5":31530,"_21594":125325,"_28366":125326,"_3078":125327},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3627":74396,"_31174":74386,"_21594":125329,"_5":14861,"_28366":74386,"_3078":125330},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3627":74397,"_31174":74386,"_21594":125332,"_5":14861,"_28366":125299,"_3078":125333},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3627":74398,"_31174":74386,"_21594":125335,"_5":14861,"_28366":125299,"_3078":125336},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3627":74399,"_31174":74386,"_21594":125338,"_5":14861,"_28366":125299,"_3078":125339},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3627":74400,"_31174":74386,"_21594":125341,"_5":14861,"_28366":125299,"_3078":125342},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3627":74401,"_31174":74386,"_21594":125344,"_5":14861,"_28366":125299,"_3078":125345},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3627":74402,"_31174":74386,"_21594":125347,"_5":14861,"_28366":125302,"_3078":125348},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3627":74403,"_31174":74386,"_21594":125350,"_5":14861,"_28366":125302,"_3078":125351},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3627":74404,"_31174":74386,"_21594":125353,"_5":14861,"_28366":125306,"_3078":125354},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3627":74405,"_31174":74386,"_21594":125356,"_5":14861,"_28366":125306,"_3078":125357},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3627":74406,"_31174":74386,"_21594":125359,"_5":14861,"_28366":125306,"_3078":125360},[],"Ajuste",{"_3627":74407,"_31174":74386,"_21594":125362,"_5":14861,"_28366":125306,"_3078":125363},[],"Valor de evaluación",{"_3627":74408,"_31174":74386,"_21594":125365,"_5":14861,"_28366":125306,"_3078":56148},[],{"_3627":74409,"_31174":74386,"_21594":125367,"_5":14861,"_28366":125306,"_3078":125368},[],"Raíz emisora de `device-root.pem`.",{"_3627":74410,"_31174":74386,"_21594":125370,"_5":14861,"_28366":125306,"_3078":123277},[],{"_3627":74411,"_31174":74386,"_21594":125372,"_5":14861,"_28366":125306,"_3078":125373},[],"Perfil final de 1 hora que acabas de preparar.",{"_3627":74412,"_31174":74386,"_21594":125375,"_5":14861,"_28366":125306,"_3078":56159},[],{"_3627":74413,"_31174":74386,"_21594":125377,"_5":14861,"_28366":125306,"_3078":56162},[],{"_3627":74414,"_31174":74386,"_21594":125379,"_5":14861,"_28366":125306,"_3078":56165},[],{"_3627":74415,"_31174":74386,"_21594":125381,"_5":14861,"_28366":125306,"_3078":125382},[],"Habilitado.",{"_3627":74416,"_31174":74386,"_21594":125384,"_5":14861,"_28366":125306,"_3078":56171},[],{"_3627":74417,"_31174":74386,"_21594":125386,"_5":14861,"_28366":125306,"_3078":125387},[],"Deshabilitado; el ID debe ser nuevo.",{"_3627":74418,"_31174":74386,"_21594":125389,"_5":14861,"_28366":125306,"_3078":125390},[],"Autenticación inicial",{"_3627":74419,"_31174":74386,"_21594":125392,"_5":14861,"_28366":125306,"_3078":125393},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3627":74420,"_31174":74386,"_21594":125395,"_5":14861,"_28366":125306,"_3078":125396},[],"Autenticación de renovación",{"_3627":74421,"_31174":74386,"_21594":125398,"_5":14861,"_28366":125306,"_3078":125399},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3627":74422,"_31174":74386,"_21594":125401,"_5":14861,"_28366":125306,"_3078":56189},[],{"_3627":74423,"_31174":74386,"_21594":125403,"_5":14861,"_28366":125306,"_3078":125404},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3627":74424,"_31174":74386,"_21594":125406,"_5":14861,"_28366":125306,"_3078":56195},[],{"_3627":74425,"_31174":74386,"_21594":125408,"_5":14861,"_28366":125306,"_3078":125409},[],"1 hora.",{"_3627":74426,"_31174":74386,"_21594":125411,"_5":14861,"_28366":125306,"_3078":56201},[],{"_3627":74427,"_31174":74386,"_21594":125413,"_5":14861,"_28366":125306,"_3078":125414},[],"30 minutos / 10 minutos.",{"_3627":74428,"_31174":74386,"_21594":125416,"_5":14861,"_28366":125306,"_3078":56207},[],{"_3627":74429,"_31174":74386,"_21594":125418,"_5":14861,"_28366":125306,"_3078":125419},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3627":74430,"_31174":74386,"_21594":125421,"_5":14861,"_28366":125306,"_3078":53963},[],{"_3627":74431,"_31174":74386,"_21594":125423,"_5":14861,"_28366":125306,"_3078":125424},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3627":74432,"_31174":74386,"_21594":125426,"_5":14861,"_28366":125306,"_3078":56218},[],{"_3627":74433,"_31174":74386,"_21594":125428,"_5":14861,"_28366":125306,"_3078":125429},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3627":74434,"_31174":74386,"_21594":125431,"_5":14861,"_28366":125306,"_3078":125432},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3627":74435,"_31174":74386,"_21594":125434,"_5":14861,"_28366":125310,"_3078":125435},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3627":74436,"_31174":74386,"_21594":125437,"_5":14861,"_28366":125310,"_3078":125438},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3627":74437,"_31174":74386,"_21594":125440,"_5":14861,"_28366":125314,"_3078":125441},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3627":74438,"_31174":74386,"_21594":125443,"_5":14861,"_28366":125314,"_3078":125444},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3627":74439,"_31174":74386,"_21594":125446,"_5":14861,"_28366":125314,"_3078":125447},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3627":74440,"_31174":74386,"_21594":125449,"_5":14861,"_28366":125318,"_3078":125450},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3627":74441,"_31174":74386,"_21594":125452,"_5":14861,"_28366":125318,"_3078":125453},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3627":74442,"_31174":74386,"_21594":125455,"_5":14861,"_28366":125322,"_3078":125456},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3627":74443,"_31174":74386,"_21594":125458,"_5":14861,"_28366":125322,"_3078":125459},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3627":74444,"_31174":74386,"_21594":125461,"_5":14861,"_28366":125322,"_3078":125462},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3627":74445,"_31174":74386,"_21594":125464,"_5":14861,"_28366":125322,"_3078":125465},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3627":74446,"_31174":74386,"_21594":125467,"_5":14861,"_28366":125322,"_3078":125468},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3627":74447,"_31174":74386,"_21594":125470,"_5":14861,"_28366":125326,"_3078":125471},[],"Comprobación",{"_3627":74448,"_31174":74386,"_21594":125473,"_5":14861,"_28366":125326,"_3078":125474},[],"Resultado esperado",{"_3627":74449,"_31174":74386,"_21594":125476,"_5":14861,"_28366":125326,"_3078":125477},[],"Registro",{"_3627":74450,"_31174":74386,"_21594":125479,"_5":14861,"_28366":125326,"_3078":125480},[],"ID creado automáticamente y DMS correcto.",{"_3627":74451,"_31174":74386,"_21594":125482,"_5":14861,"_28366":125326,"_3078":124767},[],{"_3627":74452,"_31174":74386,"_21594":125484,"_5":14861,"_28366":125326,"_3078":125485},[],"CN, perfil, serie y clave verificados.",{"_3627":74453,"_31174":74386,"_21594":125487,"_5":14861,"_28366":125326,"_3078":125488},[],"Inventario",{"_3627":74454,"_31174":74386,"_21594":125490,"_5":14861,"_28366":125326,"_3078":125491},[],"Serie recibida visible como identidad actual y en el historial.",{"_3627":74455,"_31174":74386,"_21594":125493,"_5":14861,"_28366":125326,"_3078":125494},[],"Consumidor",{"_3627":74456,"_31174":74386,"_21594":125496,"_5":14861,"_28366":125326,"_3078":125497},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3627":74457,"_31174":74386,"_21594":125499,"_5":14861,"_28366":125326,"_3078":125500},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3627":74458,"_31174":74386,"_21594":125502,"_5":14861,"_28366":125326,"_3078":125503},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3627":74459,"_31174":74459,"_5":15221,"_3078":122982,"_31533":125505,"_21594":125506,"_28366":74459},[50951,121820,53635,125292],[],{"_3627":74460,"_31174":74459,"_21594":125508,"_5":14861,"_28366":74459,"_3078":125509},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3627":74461,"_31174":74459,"_5":31530,"_21594":125511,"_28366":125512,"_3078":120354},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3627":74462,"_31174":74459,"_5":31530,"_21594":125514,"_28366":125515,"_3078":125516},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3627":74463,"_31174":74459,"_5":31530,"_21594":125518,"_28366":125519,"_3078":125520},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3627":74464,"_31174":74459,"_5":31530,"_21594":125522,"_28366":125523,"_3078":125524},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3627":74465,"_31174":74459,"_5":31530,"_21594":125526,"_28366":125527,"_3078":125528},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3627":74466,"_31174":74459,"_5":31530,"_21594":125530,"_28366":125531,"_3078":125532},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3627":74467,"_31174":74459,"_5":31530,"_21594":125534,"_28366":125535,"_3078":125474},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3627":74468,"_31174":74459,"_5":31530,"_21594":125537,"_28366":125538,"_3078":125539},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3627":74469,"_31174":74459,"_5":31530,"_21594":125541,"_28366":125542,"_3078":125543},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3627":74470,"_31174":74459,"_21594":125545,"_5":14861,"_28366":74459,"_3078":125546},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3627":74471,"_31174":74459,"_21594":125548,"_5":14861,"_28366":74459,"_3078":125549},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3627":74472,"_31174":74459,"_21594":125551,"_5":14861,"_28366":125512,"_3078":125552},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3627":74473,"_31174":74459,"_21594":125554,"_5":14861,"_28366":125512,"_3078":125555},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3627":74474,"_31174":74459,"_21594":125557,"_5":14861,"_28366":125512,"_3078":125558},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3627":74475,"_31174":74459,"_21594":125560,"_5":14861,"_28366":125512,"_3078":125561},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3627":74476,"_31174":74459,"_21594":125563,"_5":14861,"_28366":125515,"_3078":125564},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3627":74477,"_31174":74459,"_21594":125566,"_5":14861,"_28366":125515,"_3078":125567},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3627":74478,"_31174":74459,"_21594":125569,"_5":14861,"_28366":125515,"_3078":125570},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3627":74479,"_31174":74459,"_21594":125572,"_5":14861,"_28366":125515,"_3078":125573},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3627":74480,"_31174":74459,"_21594":125575,"_5":14861,"_28366":125515,"_3078":125576},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3627":74481,"_31174":74459,"_21594":125578,"_5":14861,"_28366":125515,"_3078":125579},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3627":74482,"_31174":74459,"_21594":125581,"_5":14861,"_28366":125515,"_3078":125582},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3627":74483,"_31174":74459,"_21594":125584,"_5":14861,"_28366":125515,"_3078":125585},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3627":74484,"_31174":74459,"_21594":125587,"_5":14861,"_28366":125519,"_3078":125588},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3627":74485,"_31174":74459,"_21594":125590,"_5":14861,"_28366":125519,"_3078":56383},[],{"_3627":74486,"_31174":74459,"_21594":125592,"_5":14861,"_28366":125519,"_3078":125593},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3627":74487,"_31174":74459,"_21594":125595,"_5":14861,"_28366":125519,"_3078":125596},[],"**Icon** y **Tags**: clasificación opcional.",{"_3627":74488,"_31174":74459,"_21594":125598,"_5":14861,"_28366":125519,"_3078":125599},[],"Confirma el registro.",{"_3627":74489,"_31174":74459,"_21594":125601,"_5":14861,"_28366":125523,"_3078":125602},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3627":74490,"_31174":74459,"_21594":125604,"_5":14861,"_28366":125523,"_3078":125605},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3627":74491,"_31174":74459,"_21594":125607,"_5":14861,"_28366":125527,"_3078":125608},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3627":74492,"_31174":74459,"_21594":125610,"_5":14861,"_28366":125527,"_3078":125611},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3627":74493,"_31174":74459,"_21594":125613,"_5":14861,"_28366":125531,"_3078":125614},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3627":74494,"_31174":74459,"_21594":125616,"_5":14861,"_28366":125531,"_3078":125617},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3627":74495,"_31174":74459,"_21594":125619,"_5":14861,"_28366":125535,"_3078":125471},[],{"_3627":74496,"_31174":74459,"_21594":125621,"_5":14861,"_28366":125535,"_3078":125622},[],"Resultado",{"_3627":74497,"_31174":74459,"_21594":125624,"_5":14861,"_28366":125535,"_3078":124753},[],{"_3627":74498,"_31174":74459,"_21594":125626,"_5":14861,"_28366":125535,"_3078":125627},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3627":74499,"_31174":74459,"_21594":125629,"_5":14861,"_28366":125535,"_3078":125630},[],"Identidad actual",{"_3627":74500,"_31174":74459,"_21594":125632,"_5":14861,"_28366":125535,"_3078":125633},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3627":74501,"_31174":74459,"_21594":125635,"_5":14861,"_28366":125535,"_3078":125636},[],"Historial",{"_3627":74502,"_31174":74459,"_21594":125638,"_5":14861,"_28366":125535,"_3078":125639},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3627":74503,"_31174":74459,"_21594":125641,"_5":14861,"_28366":125535,"_3078":125642},[],"Clave y certificado",{"_3627":74504,"_31174":74459,"_21594":125644,"_5":14861,"_28366":125535,"_3078":125645},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3627":74505,"_31174":74459,"_21594":125647,"_5":14861,"_28366":125538,"_3078":125648},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3627":74506,"_31174":74459,"_21594":125650,"_5":14861,"_28366":125538,"_3078":125651},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3627":74507,"_31174":74459,"_21594":125653,"_5":14861,"_28366":125538,"_3078":125654},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3627":74508,"_31174":74459,"_21594":125656,"_5":14861,"_28366":125538,"_3078":125657},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3627":74509,"_31174":74459,"_21594":125659,"_5":14861,"_28366":125542,"_3078":125660},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3627":74510,"_31174":74459,"_21594":125662,"_5":14861,"_28366":125542,"_3078":125663},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3627":74511,"_31174":74459,"_21594":125665,"_5":14861,"_28366":125542,"_3078":125666},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3627":74512,"_31174":74512,"_5":15221,"_3078":125668,"_31533":125669,"_21594":125670,"_28366":74512},"Plataforma Lamassu IoT",[50951,121820],[],{"_3627":74513,"_31174":74512,"_21594":125672,"_5":14861,"_28366":74512,"_3078":125673},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3627":74514,"_31174":74512,"_5":31530,"_21594":125675,"_28366":125676,"_3078":125168},[],"/docs/pr-preview/pr-75/es/platform/overview#empieza-aquí",{"_3627":74515,"_31174":74512,"_5":31530,"_21594":125678,"_28366":125679,"_3078":125680},[],"/docs/pr-preview/pr-75/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3627":74516,"_31174":74512,"_5":31530,"_21594":125682,"_28366":125683,"_3078":125684},[],"/docs/pr-preview/pr-75/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3627":74517,"_31174":74512,"_5":31530,"_21594":125686,"_28366":125687,"_3078":125688},[],"/docs/pr-preview/pr-75/es/platform/overview#capacidades-principales","Capacidades principales",{"_3627":74518,"_31174":74512,"_5":31530,"_21594":125690,"_28366":125691,"_3078":125692},[],"/docs/pr-preview/pr-75/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3627":74519,"_31174":74512,"_5":31530,"_21594":125694,"_28366":125695,"_3078":125696},[],"/docs/pr-preview/pr-75/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3627":74520,"_31174":74512,"_5":31530,"_21594":125698,"_28366":125699,"_3078":125700},[],"/docs/pr-preview/pr-75/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3627":74521,"_31174":74512,"_5":31530,"_21594":125702,"_28366":125703,"_3078":125704},[],"/docs/pr-preview/pr-75/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3627":74522,"_31174":74512,"_5":31530,"_21594":125706,"_28366":125707,"_3078":125708},[],"/docs/pr-preview/pr-75/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3627":74523,"_31174":74512,"_5":31530,"_21594":125710,"_28366":125711,"_3078":125712},[],"/docs/pr-preview/pr-75/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3627":74524,"_31174":74512,"_5":31530,"_21594":125714,"_28366":125715,"_3078":125716},[],"/docs/pr-preview/pr-75/es/platform/overview#referencia-operativa","Referencia operativa",{"_3627":74525,"_31174":74512,"_21594":125718,"_5":14861,"_28366":74512,"_3078":125719},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3627":74526,"_31174":74512,"_21594":125721,"_5":14861,"_28366":125676,"_3078":125722},[],"Elige el resultado que necesitas obtener:",{"_3627":74527,"_31174":74512,"_21594":125724,"_5":14861,"_28366":125676,"_3078":125725},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3627":74528,"_31174":74512,"_21594":125727,"_5":14861,"_28366":125676,"_3078":125728},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3627":74529,"_31174":74512,"_21594":125730,"_5":14861,"_28366":125676,"_3078":125731},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3627":74530,"_31174":74512,"_21594":125733,"_5":14861,"_28366":125679,"_3078":125734},[],"Bloque",{"_3627":74531,"_31174":74512,"_21594":125736,"_5":14861,"_28366":125679,"_3078":125737},[],"Qué gestionas",{"_3627":74532,"_31174":74512,"_21594":125739,"_5":14861,"_28366":125679,"_3078":125740},[],"Punto de entrada",{"_3627":74533,"_31174":74512,"_21594":125742,"_5":14861,"_28366":125679,"_3078":56536},[],{"_3627":74534,"_31174":74512,"_21594":125744,"_5":14861,"_28366":125679,"_3078":125745},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3627":74535,"_31174":74512,"_21594":125747,"_5":14861,"_28366":125679,"_3078":125748},[],"Visión general de PKI",{"_3627":74536,"_31174":74512,"_21594":125750,"_5":14861,"_28366":125679,"_3078":56545},[],{"_3627":74537,"_31174":74512,"_21594":125752,"_5":14861,"_28366":125679,"_3078":125753},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3627":74538,"_31174":74512,"_21594":125755,"_5":14861,"_28366":125679,"_3078":125756},[],"Visión general de IoT Fleets",{"_3627":74539,"_31174":74512,"_21594":125758,"_5":14861,"_28366":125679,"_3078":125759},[],"**Administración**",{"_3627":74540,"_31174":74512,"_21594":125761,"_5":14861,"_28366":125679,"_3078":125762},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3627":74541,"_31174":74512,"_21594":125764,"_5":14861,"_28366":125679,"_3078":121822},[],{"_3627":74542,"_31174":74512,"_21594":125766,"_5":14861,"_28366":125679,"_3078":125767},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3627":74543,"_31174":74512,"_21594":125769,"_5":14861,"_28366":125683,"_3078":125770},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3627":74544,"_31174":74512,"_21594":125772,"_5":14861,"_28366":125683,"_3078":125773},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3627":74545,"_31174":74512,"_21594":125775,"_5":14861,"_28366":125683,"_3078":125776},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3627":74546,"_31174":74512,"_21594":125778,"_5":14861,"_28366":125683,"_3078":125779},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3627":74547,"_31174":74512,"_21594":125781,"_5":14861,"_28366":125683,"_3078":125782},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3627":74548,"_31174":74512,"_21594":125784,"_5":14861,"_28366":125683,"_3078":125785},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3627":74549,"_31174":74512,"_21594":125787,"_5":14861,"_28366":125691,"_3078":125788},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3627":74550,"_31174":74512,"_21594":125790,"_5":14861,"_28366":125695,"_3078":125791},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3627":74551,"_31174":74512,"_21594":125793,"_5":14861,"_28366":125699,"_3078":125794},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3627":74552,"_31174":74512,"_21594":125796,"_5":14861,"_28366":125703,"_3078":125797},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3627":74553,"_31174":74512,"_21594":125799,"_5":14861,"_28366":125707,"_3078":125800},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3627":74554,"_31174":74512,"_21594":125802,"_5":14861,"_28366":125711,"_3078":125803},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3627":74555,"_31174":74512,"_21594":125805,"_5":14861,"_28366":125715,"_3078":125261},[],{"_3627":74556,"_31174":74512,"_21594":125807,"_5":14861,"_28366":125715,"_3078":125808},[],"Qué prepara o comprueba",{"_3627":74557,"_31174":74512,"_21594":125810,"_5":14861,"_28366":125715,"_3078":125264},[],{"_3627":74558,"_31174":74512,"_21594":125812,"_5":14861,"_28366":125715,"_3078":125813},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3627":74559,"_31174":74512,"_21594":125815,"_5":14861,"_28366":125715,"_3078":125816},[],"Administrador de la flota",{"_3627":74560,"_31174":74512,"_21594":125818,"_5":14861,"_28366":125715,"_3078":125819},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3627":74561,"_31174":74512,"_21594":125821,"_5":14861,"_28366":125715,"_3078":125276},[],{"_3627":74562,"_31174":74512,"_21594":125823,"_5":14861,"_28366":125715,"_3078":125824},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3627":74563,"_31174":74512,"_21594":125826,"_5":14861,"_28366":125715,"_3078":125282},[],{"_3627":74564,"_31174":74512,"_21594":125828,"_5":14861,"_28366":125715,"_3078":125829},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3627":74565,"_31174":74512,"_21594":125831,"_5":14861,"_28366":125715,"_3078":125832},[],"Operador de infraestructura",{"_3627":74566,"_31174":74512,"_21594":125834,"_5":14861,"_28366":125715,"_3078":125835},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3627":74567,"_31174":74512,"_21594":125837,"_5":14861,"_28366":125715,"_3078":125838},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3627":74568,"_31174":74568,"_5":15221,"_3078":125840,"_31533":125841,"_21594":125843,"_28366":74568},"Jerarquía y rotación de CAs",[50951,121820,56637,125842],"Claves, autoridades y certificados",[],{"_3627":74569,"_31174":74568,"_21594":125845,"_5":14861,"_28366":74568,"_3078":125846},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3627":74570,"_31174":74568,"_5":31530,"_21594":125848,"_28366":125849,"_3078":125850},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3627":74571,"_31174":74568,"_5":31530,"_21594":125852,"_28366":125853,"_3078":125854},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3627":74572,"_31174":74568,"_5":31530,"_21594":125856,"_28366":125857,"_3078":125858},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3627":74573,"_31174":74568,"_5":31530,"_21594":125860,"_28366":125861,"_3078":125862},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3627":74574,"_31174":74568,"_5":31530,"_21594":125864,"_28366":125865,"_3078":125866},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3627":74575,"_31174":74568,"_5":31530,"_21594":125868,"_28366":125869,"_3078":125870},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3627":74576,"_31174":74568,"_5":31530,"_21594":125872,"_28366":125873,"_3078":125874},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3627":74577,"_31174":74568,"_5":31530,"_21594":125876,"_28366":125877,"_3078":125878},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3627":74578,"_31174":74568,"_5":31530,"_21594":125880,"_28366":125881,"_3078":125882},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3627":74579,"_31174":74568,"_5":31530,"_21594":125884,"_28366":125885,"_3078":125886},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3627":74580,"_31174":74568,"_5":31530,"_21594":125888,"_28366":125889,"_3078":125890},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3627":74581,"_31174":74568,"_5":31530,"_21594":125892,"_28366":125893,"_3078":125894},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3627":74582,"_31174":74568,"_21594":125896,"_5":14861,"_28366":74568,"_3078":125897},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3627":74583,"_31174":74568,"_21594":125899,"_5":14861,"_28366":74568,"_3078":125900},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3627":74584,"_31174":74568,"_21594":125902,"_5":14861,"_28366":125849,"_3078":125903},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3627":74585,"_31174":74568,"_21594":125905,"_5":14861,"_28366":125849,"_3078":125906},[],"entorno, como producción y preproducción;",{"_3627":74586,"_31174":74568,"_21594":125908,"_5":14861,"_28366":125849,"_3078":125909},[],"propietario o equipo operador;",{"_3627":74587,"_31174":74568,"_21594":125911,"_5":14861,"_28366":125849,"_3078":125912},[],"familia de dispositivos o proceso de fabricación;",{"_3627":74588,"_31174":74568,"_21594":125914,"_5":14861,"_28366":125849,"_3078":125915},[],"región o requisito regulatorio;",{"_3627":74589,"_31174":74568,"_21594":125917,"_5":14861,"_28366":125849,"_3078":125918},[],"motor criptográfico o política de clave;",{"_3627":74590,"_31174":74568,"_21594":125920,"_5":14861,"_28366":125849,"_3078":125921},[],"ventana de mantenimiento y ritmo de renovación.",{"_3627":74591,"_31174":74568,"_21594":125923,"_5":14861,"_28366":125849,"_3078":125924},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3627":74592,"_31174":74568,"_21594":125926,"_5":14861,"_28366":125849,"_3078":125927},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3627":74593,"_31174":74568,"_21594":125929,"_5":14861,"_28366":125853,"_3078":125930},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3627":74594,"_31174":74568,"_21594":125932,"_5":14861,"_28366":125853,"_3078":125933},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3627":74595,"_31174":74568,"_21594":125935,"_5":14861,"_28366":125853,"_3078":125936},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3627":74596,"_31174":74568,"_21594":125938,"_5":14861,"_28366":125853,"_3078":125939},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3627":74597,"_31174":74568,"_21594":125941,"_5":14861,"_28366":125857,"_3078":125942},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3627":74598,"_31174":74568,"_21594":125944,"_5":14861,"_28366":125857,"_3078":125945},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3627":74599,"_31174":74568,"_21594":125947,"_5":14861,"_28366":125857,"_3078":125948},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3627":74600,"_31174":74568,"_21594":125950,"_5":14861,"_28366":125857,"_3078":125951},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3627":74601,"_31174":74568,"_21594":125953,"_5":14861,"_28366":125865,"_3078":125954},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3627":74602,"_31174":74568,"_21594":125956,"_5":14861,"_28366":125869,"_3078":125957},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3627":74603,"_31174":74568,"_21594":125959,"_5":14861,"_28366":125873,"_3078":125960},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3627":74604,"_31174":74568,"_21594":125962,"_5":14861,"_28366":125877,"_3078":125963},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3627":74605,"_31174":74568,"_21594":125965,"_5":14861,"_28366":125881,"_3078":125966},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3627":74606,"_31174":74568,"_21594":125968,"_5":14861,"_28366":125885,"_3078":125969},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3627":74607,"_31174":74568,"_21594":125971,"_5":14861,"_28366":125889,"_3078":125972},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3627":74608,"_31174":74568,"_21594":125974,"_5":14861,"_28366":125889,"_3078":125975},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3627":74609,"_31174":74568,"_21594":125977,"_5":14861,"_28366":125889,"_3078":125978},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3627":74610,"_31174":74568,"_21594":125980,"_5":14861,"_28366":125889,"_3078":125981},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3627":74611,"_31174":74568,"_21594":125983,"_5":14861,"_28366":125893,"_3078":125984},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3627":74612,"_31174":74568,"_21594":125986,"_5":14861,"_28366":125893,"_3078":125987},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3627":74613,"_31174":74568,"_21594":125989,"_5":14861,"_28366":125893,"_3078":125990},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3627":74614,"_31174":74568,"_21594":125992,"_5":14861,"_28366":125893,"_3078":125993},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3627":74615,"_31174":74568,"_21594":125995,"_5":14861,"_28366":125893,"_3078":125996},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3627":74616,"_31174":74568,"_21594":125998,"_5":14861,"_28366":125893,"_3078":125999},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3627":74617,"_31174":74568,"_21594":126001,"_5":14861,"_28366":125893,"_3078":126002},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3627":74618,"_31174":74618,"_5":15221,"_3078":126004,"_31533":126005,"_21594":126006,"_28366":74618},"Autoridades de certificación",[50951,121820,56637,125842],[],{"_3627":74619,"_31174":74618,"_21594":126008,"_5":14861,"_28366":74618,"_3078":126009},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3627":74620,"_31174":74618,"_5":31530,"_21594":126011,"_28366":126012,"_3078":126013},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3627":74621,"_31174":74618,"_5":31530,"_21594":126015,"_28366":126016,"_3078":126017},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3627":74622,"_31174":74618,"_5":31530,"_21594":126019,"_28366":126020,"_3078":120354},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3627":74623,"_31174":74618,"_5":31530,"_21594":126022,"_28366":126023,"_3078":126024},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3627":74624,"_31174":74618,"_5":31530,"_21594":126026,"_28366":126027,"_3078":126028},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3627":74625,"_31174":74618,"_5":31530,"_21594":126030,"_28366":126031,"_3078":126032},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3627":74626,"_31174":74618,"_5":31530,"_21594":126034,"_28366":126035,"_3078":126036},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3627":74627,"_31174":74618,"_5":31530,"_21594":126038,"_28366":126039,"_3078":126040},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3627":74628,"_31174":74618,"_5":31530,"_21594":126042,"_28366":126043,"_3078":126044},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3627":74629,"_31174":74618,"_5":31530,"_21594":126046,"_28366":126047,"_3078":126048},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3627":74630,"_31174":74618,"_5":31530,"_21594":126050,"_28366":126051,"_3078":126052},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3627":74631,"_31174":74618,"_5":31530,"_21594":126054,"_28366":126055,"_3078":126056},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3627":74632,"_31174":74618,"_5":31530,"_21594":126058,"_28366":126059,"_3078":126060},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3627":74633,"_31174":74618,"_5":31530,"_21594":126062,"_28366":126063,"_3078":126064},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3627":74634,"_31174":74618,"_5":31530,"_21594":126066,"_28366":126067,"_3078":126068},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3627":74635,"_31174":74618,"_5":31530,"_21594":126070,"_28366":126071,"_3078":126072},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3627":74636,"_31174":74618,"_5":31530,"_21594":126074,"_28366":126075,"_3078":126076},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3627":74637,"_31174":74618,"_5":31530,"_21594":126078,"_28366":126079,"_3078":126080},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3627":74638,"_31174":74618,"_5":31530,"_21594":126082,"_28366":126083,"_3078":126084},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3627":74639,"_31174":74618,"_5":31530,"_21594":126086,"_28366":126087,"_3078":126088},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3627":74640,"_31174":74618,"_5":31530,"_21594":126090,"_28366":126091,"_3078":126092},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3627":74641,"_31174":74618,"_5":31530,"_21594":126094,"_28366":126095,"_3078":126096},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3627":74642,"_31174":74618,"_5":31530,"_21594":126098,"_28366":126099,"_3078":126100},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3627":74643,"_31174":74618,"_21594":126102,"_5":14861,"_28366":74618,"_3078":126103},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3627":74644,"_31174":74618,"_21594":126105,"_5":14861,"_28366":74618,"_3078":126106},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3627":74645,"_31174":74618,"_21594":126108,"_5":14861,"_28366":74618,"_3078":126109},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3627":74646,"_31174":74618,"_21594":126111,"_5":14861,"_28366":126012,"_3078":126112},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3627":74647,"_31174":74618,"_21594":126114,"_5":14861,"_28366":126012,"_3078":126115},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3627":74648,"_31174":74618,"_21594":126117,"_5":14861,"_28366":126012,"_3078":126118},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3627":74649,"_31174":74618,"_21594":126120,"_5":14861,"_28366":126012,"_3078":126121},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3627":74650,"_31174":74618,"_21594":126123,"_5":14861,"_28366":126012,"_3078":126124},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3627":74651,"_31174":74618,"_21594":126126,"_5":14861,"_28366":126020,"_3078":126127},[],"Decide si la CA será raíz o intermedia.",{"_3627":74652,"_31174":74618,"_21594":126129,"_5":14861,"_28366":126020,"_3078":126130},[],"Elige el motor que custodiará la clave.",{"_3627":74653,"_31174":74618,"_21594":126132,"_5":14861,"_28366":126020,"_3078":126133},[],"Define una validez superior a la de los certificados que emitirá.",{"_3627":74654,"_31174":74618,"_21594":126135,"_5":14861,"_28366":126020,"_3078":126136},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3627":74655,"_31174":74618,"_21594":126138,"_5":14861,"_28366":126023,"_3078":126139},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3627":74656,"_31174":74618,"_21594":126141,"_5":14861,"_28366":126027,"_3078":126142},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3627":74657,"_31174":74618,"_21594":126144,"_5":14861,"_28366":126027,"_3078":126145},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3627":74658,"_31174":74618,"_21594":126147,"_5":14861,"_28366":126031,"_3078":126148},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3627":74659,"_31174":74618,"_21594":126150,"_5":14861,"_28366":126035,"_3078":126151},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3627":74660,"_31174":74618,"_21594":126153,"_5":14861,"_28366":126035,"_3078":126154},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3627":74661,"_31174":74618,"_21594":126156,"_5":14861,"_28366":126035,"_3078":126157},[],"`ST`: estado o provincia.",{"_3627":74662,"_31174":74618,"_21594":126159,"_5":14861,"_28366":126035,"_3078":126160},[],"`L`: localidad.",{"_3627":74663,"_31174":74618,"_21594":126162,"_5":14861,"_28366":126035,"_3078":126163},[],"`O`: organización.",{"_3627":74664,"_31174":74618,"_21594":126165,"_5":14861,"_28366":126035,"_3078":126166},[],"`OU`: unidad organizativa.",{"_3627":74665,"_31174":74618,"_21594":126168,"_5":14861,"_28366":126035,"_3078":126169},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3627":74666,"_31174":74618,"_21594":126171,"_5":14861,"_28366":126039,"_3078":126172},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3627":74667,"_31174":74618,"_21594":126174,"_5":14861,"_28366":126039,"_3078":126175},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3627":74668,"_31174":74618,"_21594":126177,"_5":14861,"_28366":126043,"_3078":126178},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3627":74669,"_31174":74618,"_21594":126180,"_5":14861,"_28366":126043,"_3078":126181},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3627":74670,"_31174":74618,"_21594":126183,"_5":14861,"_28366":126047,"_3078":126184},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3627":74671,"_31174":74618,"_21594":126186,"_5":14861,"_28366":126047,"_3078":126187},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3627":74672,"_31174":74618,"_21594":126189,"_5":14861,"_28366":126051,"_3078":126190},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3627":74673,"_31174":74618,"_21594":126192,"_5":14861,"_28366":126051,"_3078":126193},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3627":74674,"_31174":74618,"_21594":126195,"_5":14861,"_28366":126051,"_3078":126196},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3627":74675,"_31174":74618,"_21594":126198,"_5":14861,"_28366":126051,"_3078":126199},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3627":74676,"_31174":74618,"_21594":126201,"_5":14861,"_28366":126055,"_3078":126202},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3627":74677,"_31174":74618,"_21594":126204,"_5":14861,"_28366":126059,"_3078":126205},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3627":74678,"_31174":74618,"_21594":126207,"_5":14861,"_28366":126059,"_3078":126208},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3627":74679,"_31174":74618,"_21594":126210,"_5":14861,"_28366":126063,"_3078":126211},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3627":74680,"_31174":74618,"_21594":126213,"_5":14861,"_28366":126067,"_3078":126214},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3627":74681,"_31174":74618,"_21594":126216,"_5":14861,"_28366":126067,"_3078":126217},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3627":74682,"_31174":74618,"_21594":126219,"_5":14861,"_28366":126067,"_3078":126220},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3627":74683,"_31174":74618,"_21594":126222,"_5":14861,"_28366":126071,"_3078":126223},[],"Abre una CA desde el inventario para consultar:",{"_3627":74684,"_31174":74618,"_21594":126225,"_5":14861,"_28366":126071,"_3078":126226},[],"Estado y periodo de validez.",{"_3627":74685,"_31174":74618,"_21594":126228,"_5":14861,"_28366":126071,"_3078":126229},[],"Certificado y cadena en formato PEM.",{"_3627":74686,"_31174":74618,"_21594":126231,"_5":14861,"_28366":126071,"_3078":126232},[],"Número de certificados activos, expirados y revocados.",{"_3627":74687,"_31174":74618,"_21594":126234,"_5":14861,"_28366":126071,"_3078":126235},[],"Certificados emitidos en **Issued Certificates**.",{"_3627":74688,"_31174":74618,"_21594":126237,"_5":14861,"_28366":126071,"_3078":126238},[],"CRL vinculada a la autoridad.",{"_3627":74689,"_31174":74618,"_21594":126240,"_5":14861,"_28366":126071,"_3078":126241},[],"Metadatos y motor criptográfico asociado.",{"_3627":74690,"_31174":74618,"_21594":126243,"_5":14861,"_28366":126071,"_3078":126244},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3627":74691,"_31174":74618,"_21594":126246,"_5":14861,"_28366":126075,"_3078":126247},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3627":74692,"_31174":74618,"_21594":126249,"_5":14861,"_28366":126075,"_3078":126250},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3627":74693,"_31174":74618,"_21594":126252,"_5":14861,"_28366":126075,"_3078":126253},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3627":74694,"_31174":74618,"_21594":126255,"_5":14861,"_28366":126075,"_3078":126256},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3627":74695,"_31174":74618,"_21594":126258,"_5":14861,"_28366":126075,"_3078":126259},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3627":74696,"_31174":74618,"_21594":126261,"_5":14861,"_28366":126075,"_3078":126262},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3627":74697,"_31174":74618,"_21594":126264,"_5":14861,"_28366":126079,"_3078":126265},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3627":74698,"_31174":74618,"_21594":126267,"_5":14861,"_28366":126083,"_3078":126268},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3627":74699,"_31174":74618,"_21594":126270,"_5":14861,"_28366":126087,"_3078":126271},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3627":74700,"_31174":74618,"_21594":126273,"_5":14861,"_28366":126091,"_3078":126274},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3627":74701,"_31174":74618,"_21594":126276,"_5":14861,"_28366":126095,"_3078":126277},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3627":74702,"_31174":74618,"_21594":126279,"_5":14861,"_28366":126099,"_3078":126280},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3627":74703,"_31174":74618,"_21594":126282,"_5":14861,"_28366":126099,"_3078":126283},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3627":74704,"_31174":74618,"_21594":126285,"_5":14861,"_28366":126099,"_3078":126286},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3627":74705,"_31174":74618,"_21594":126288,"_5":14861,"_28366":126099,"_3078":126289},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3627":74706,"_31174":74618,"_21594":126291,"_5":14861,"_28366":126099,"_3078":126292},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3627":74707,"_31174":74707,"_5":15221,"_3078":126294,"_31533":126295,"_21594":126296,"_28366":74707},"Perfiles de certificado",[50951,121820,56637,125842],[],{"_3627":74708,"_31174":74707,"_21594":126298,"_5":14861,"_28366":74707,"_3078":126299},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3627":74709,"_31174":74707,"_5":31530,"_21594":126301,"_28366":126302,"_3078":126303},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3627":74710,"_31174":74707,"_5":31530,"_21594":126305,"_28366":126306,"_3078":126307},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#validez","Validez",{"_3627":74711,"_31174":74707,"_5":31530,"_21594":126309,"_28366":126310,"_3078":126311},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3627":74712,"_31174":74707,"_5":31530,"_21594":126313,"_28366":126314,"_3078":126315},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3627":74713,"_31174":74707,"_5":31530,"_21594":126317,"_28366":126318,"_3078":126319},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3627":74714,"_31174":74707,"_5":31530,"_21594":126321,"_28366":126322,"_3078":126323},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3627":74715,"_31174":74707,"_5":31530,"_21594":126325,"_28366":126326,"_3078":126327},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3627":74716,"_31174":74707,"_5":31530,"_21594":126329,"_28366":126330,"_3078":126331},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3627":74717,"_31174":74707,"_5":31530,"_21594":126333,"_28366":126334,"_3078":126335},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3627":74718,"_31174":74707,"_5":31530,"_21594":126337,"_28366":126338,"_3078":126339},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3627":74719,"_31174":74707,"_5":31530,"_21594":126341,"_28366":126342,"_3078":126343},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3627":74720,"_31174":74707,"_5":31530,"_21594":126345,"_28366":126346,"_3078":126347},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3627":74721,"_31174":74707,"_5":31530,"_21594":126349,"_28366":126350,"_3078":126351},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3627":74722,"_31174":74707,"_5":31530,"_21594":126353,"_28366":126354,"_3078":126355},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3627":74723,"_31174":74707,"_5":31530,"_21594":126357,"_28366":126358,"_3078":126359},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3627":74724,"_31174":74707,"_5":31530,"_21594":126361,"_28366":126362,"_3078":126363},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3627":74725,"_31174":74707,"_21594":126365,"_5":14861,"_28366":74707,"_3078":126366},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3627":74726,"_31174":74707,"_21594":126368,"_5":14861,"_28366":74707,"_3078":126369},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3627":74727,"_31174":74707,"_21594":126371,"_5":14861,"_28366":126306,"_3078":126372},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3627":74728,"_31174":74707,"_21594":126374,"_5":14861,"_28366":126306,"_3078":126375},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3627":74729,"_31174":74707,"_21594":126377,"_5":14861,"_28366":126310,"_3078":126378},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3627":74730,"_31174":74707,"_21594":126380,"_5":14861,"_28366":126314,"_3078":126381},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3627":74731,"_31174":74707,"_21594":126383,"_5":14861,"_28366":126314,"_3078":126384},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3627":74732,"_31174":74707,"_21594":126386,"_5":14861,"_28366":126314,"_3078":126387},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3627":74733,"_31174":74707,"_21594":126389,"_5":14861,"_28366":126318,"_3078":126390},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3627":74734,"_31174":74707,"_21594":126392,"_5":14861,"_28366":126322,"_3078":126393},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3627":74735,"_31174":74707,"_21594":126395,"_5":14861,"_28366":126322,"_3078":126396},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3627":74736,"_31174":74707,"_21594":126398,"_5":14861,"_28366":126326,"_3078":126399},[],"La aplicación criptográfica puede:",{"_3627":74737,"_31174":74707,"_21594":126401,"_5":14861,"_28366":126326,"_3078":126402},[],"permitir o bloquear claves RSA;",{"_3627":74738,"_31174":74707,"_21594":126404,"_5":14861,"_28366":126326,"_3078":126405},[],"limitar los tamaños RSA admitidos;",{"_3627":74739,"_31174":74707,"_21594":126407,"_5":14861,"_28366":126326,"_3078":126408},[],"permitir o bloquear claves ECDSA;",{"_3627":74740,"_31174":74707,"_21594":126410,"_5":14861,"_28366":126326,"_3078":126411},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3627":74741,"_31174":74707,"_21594":126413,"_5":14861,"_28366":126326,"_3078":126414},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3627":74742,"_31174":74707,"_21594":126416,"_5":14861,"_28366":126330,"_3078":126417},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3627":74743,"_31174":74707,"_21594":126419,"_5":14861,"_28366":126330,"_3078":121580},[],{"_3627":74744,"_31174":74707,"_21594":126421,"_5":14861,"_28366":126330,"_3078":126422},[],"Primera opción",{"_3627":74745,"_31174":74707,"_21594":126424,"_5":14861,"_28366":126330,"_3078":126425},[],"Segunda opción",{"_3627":74746,"_31174":74707,"_21594":126427,"_5":14861,"_28366":126330,"_3078":126428},[],"Si no hay ninguna",{"_3627":74747,"_31174":74707,"_21594":126430,"_5":14861,"_28366":126330,"_3078":126431},[],"Firma directa con una CA",{"_3627":74748,"_31174":74707,"_21594":126433,"_5":14861,"_28366":126330,"_3078":126434},[],"`issuance_profile` incluido en la solicitud",{"_3627":74749,"_31174":74707,"_21594":126436,"_5":14861,"_28366":126330,"_3078":126437},[],"`issuance_profile_id` de la solicitud",{"_3627":74750,"_31174":74707,"_21594":126439,"_5":14861,"_28366":126330,"_3078":126440},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3627":74751,"_31174":74707,"_21594":126442,"_5":14861,"_28366":126330,"_3078":126443},[],"Emisión mediante DMS",{"_3627":74752,"_31174":74707,"_21594":126445,"_5":14861,"_28366":126330,"_3078":57242},[],{"_3627":74753,"_31174":74707,"_21594":126447,"_5":14861,"_28366":126330,"_3078":126448},[],"`settings.issuance_profile` incluido en el DMS",{"_3627":74754,"_31174":74707,"_21594":126450,"_5":14861,"_28366":126330,"_3078":126451},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3627":74755,"_31174":74707,"_21594":126453,"_5":14861,"_28366":126330,"_3078":126454},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3627":74756,"_31174":74707,"_21594":126456,"_5":14861,"_28366":126330,"_3078":126457},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3627":74757,"_31174":74707,"_21594":126459,"_5":14861,"_28366":126338,"_3078":126460},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3627":74758,"_31174":74707,"_21594":126462,"_5":14861,"_28366":126342,"_3078":126463},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3627":74759,"_31174":74707,"_21594":126465,"_5":14861,"_28366":126346,"_3078":126466},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3627":74760,"_31174":74707,"_21594":126468,"_5":14861,"_28366":126350,"_3078":126469},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3627":74761,"_31174":74707,"_21594":126471,"_5":14861,"_28366":126354,"_3078":126472},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3627":74762,"_31174":74707,"_21594":126474,"_5":14861,"_28366":126354,"_3078":126475},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3627":74763,"_31174":74707,"_21594":126477,"_5":14861,"_28366":126358,"_3078":126478},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3627":74764,"_31174":74707,"_21594":126480,"_5":14861,"_28366":126358,"_3078":126481},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3627":74765,"_31174":74707,"_21594":126483,"_5":14861,"_28366":126358,"_3078":126484},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3627":74766,"_31174":74707,"_21594":126486,"_5":14861,"_28366":126358,"_3078":126487},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3627":74767,"_31174":74707,"_21594":126489,"_5":14861,"_28366":126362,"_3078":126490},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3627":74768,"_31174":74707,"_21594":126492,"_5":14861,"_28366":126362,"_3078":126493},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3627":74769,"_31174":74769,"_5":15221,"_3078":126495,"_31533":126496,"_21594":126498,"_28366":74769},"Validación de certificados",[50951,121820,56637,126497],"Validación",[],{"_3627":74770,"_31174":74769,"_21594":126500,"_5":14861,"_28366":74769,"_3078":126501},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3627":74771,"_31174":74769,"_5":31530,"_21594":126503,"_28366":126504,"_3078":126505},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3627":74772,"_31174":74769,"_5":31530,"_21594":126507,"_28366":126508,"_3078":126509},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3627":74773,"_31174":74769,"_5":31530,"_21594":126511,"_28366":126512,"_3078":126513},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3627":74774,"_31174":74769,"_21594":126515,"_5":14861,"_28366":74769,"_3078":126516},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3627":74775,"_31174":74769,"_21594":126518,"_5":14861,"_28366":126504,"_3078":126519},[],"Verifica estos criterios juntos:",{"_3627":74776,"_31174":74769,"_21594":126521,"_5":14861,"_28366":126504,"_3078":125471},[],{"_3627":74777,"_31174":74769,"_21594":126523,"_5":14861,"_28366":126504,"_3078":126524},[],"Resultado necesario",{"_3627":74778,"_31174":74769,"_21594":126526,"_5":14861,"_28366":126504,"_3078":126527},[],"Cadena y firma",{"_3627":74779,"_31174":74769,"_21594":126529,"_5":14861,"_28366":126504,"_3078":126530},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3627":74780,"_31174":74769,"_21594":126532,"_5":14861,"_28366":126504,"_3078":126533},[],"Fechas",{"_3627":74781,"_31174":74769,"_21594":126535,"_5":14861,"_28366":126504,"_3078":126536},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3627":74782,"_31174":74769,"_21594":126538,"_5":14861,"_28366":126504,"_3078":121490},[],{"_3627":74783,"_31174":74769,"_21594":126540,"_5":14861,"_28366":126504,"_3078":126541},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3627":74784,"_31174":74769,"_21594":126543,"_5":14861,"_28366":126504,"_3078":126544},[],"Uso",{"_3627":74785,"_31174":74769,"_21594":126546,"_5":14861,"_28366":126504,"_3078":126547},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3627":74786,"_31174":74769,"_21594":126549,"_5":14861,"_28366":126504,"_3078":126550},[],"Revocación",{"_3627":74787,"_31174":74769,"_21594":126552,"_5":14861,"_28366":126504,"_3078":126553},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3627":74788,"_31174":74769,"_21594":126555,"_5":14861,"_28366":126504,"_3078":126556},[],"Autorización",{"_3627":74789,"_31174":74769,"_21594":126558,"_5":14861,"_28366":126504,"_3078":126559},[],"La aplicación permite la acción a esa identidad.",{"_3627":74790,"_31174":74769,"_21594":126561,"_5":14861,"_28366":126504,"_3078":126562},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3627":74791,"_31174":74769,"_21594":126564,"_5":14861,"_28366":126508,"_3078":126565},[],"Mecanismo",{"_3627":74792,"_31174":74769,"_21594":126567,"_5":14861,"_28366":126508,"_3078":126568},[],"Cuándo utilizarlo",{"_3627":74793,"_31174":74769,"_21594":126570,"_5":14861,"_28366":126508,"_3078":126571},[],"Qué debes mantener",{"_3627":74794,"_31174":74769,"_21594":126573,"_5":14861,"_28366":126508,"_3078":57370},[],{"_3627":74795,"_31174":74769,"_21594":126575,"_5":14861,"_28366":126508,"_3078":126576},[],"Consulta del estado de un certificado concreto.",{"_3627":74796,"_31174":74769,"_21594":126578,"_5":14861,"_28366":126508,"_3078":126579},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3627":74797,"_31174":74769,"_21594":126581,"_5":14861,"_28366":126508,"_3078":57379},[],{"_3627":74798,"_31174":74769,"_21594":126583,"_5":14861,"_28366":126508,"_3078":126584},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3627":74799,"_31174":74769,"_21594":126586,"_5":14861,"_28366":126508,"_3078":126587},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3627":74800,"_31174":74769,"_21594":126589,"_5":14861,"_28366":126508,"_3078":126590},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3627":74801,"_31174":74769,"_21594":126592,"_5":14861,"_28366":126508,"_3078":126593},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3627":74802,"_31174":74769,"_21594":126595,"_5":14861,"_28366":126512,"_3078":126596},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3627":74803,"_31174":74769,"_21594":126598,"_5":14861,"_28366":126512,"_3078":126599},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3627":74804,"_31174":74769,"_21594":126601,"_5":14861,"_28366":126512,"_3078":126602},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3627":74805,"_31174":74769,"_21594":126604,"_5":14861,"_28366":126512,"_3078":126605},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3627":74806,"_31174":74769,"_21594":126607,"_5":14861,"_28366":126512,"_3078":126608},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3627":74807,"_31174":74769,"_21594":126610,"_5":14861,"_28366":126512,"_3078":126611},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3627":74808,"_31174":74769,"_21594":126613,"_5":14861,"_28366":126512,"_3078":126614},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3627":74809,"_31174":74769,"_21594":126616,"_5":14861,"_28366":126512,"_3078":126617},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3627":74810,"_31174":74769,"_21594":126619,"_5":14861,"_28366":126512,"_3078":126620},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3627":74811,"_31174":74811,"_5":15221,"_3078":126622,"_31533":126623,"_21594":126624,"_28366":74811},"Certificados",[50951,121820,56637,125842],[],{"_3627":74812,"_31174":74811,"_21594":126626,"_5":14861,"_28366":74811,"_3078":126627},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3627":74813,"_31174":74811,"_5":31530,"_21594":126629,"_28366":126630,"_3078":126631},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3627":74814,"_31174":74811,"_5":31530,"_21594":126633,"_28366":126634,"_3078":126635},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3627":74815,"_31174":74811,"_5":31530,"_21594":126637,"_28366":126638,"_3078":126639},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3627":74816,"_31174":74811,"_5":31530,"_21594":126641,"_28366":126642,"_3078":126643},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3627":74817,"_31174":74811,"_5":31530,"_21594":126645,"_28366":126646,"_3078":126647},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3627":74818,"_31174":74811,"_5":31530,"_21594":126649,"_28366":126650,"_3078":126651},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3627":74819,"_31174":74811,"_5":31530,"_21594":126653,"_28366":126654,"_3078":126655},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3627":74820,"_31174":74811,"_5":31530,"_21594":126657,"_28366":126658,"_3078":126659},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3627":74821,"_31174":74811,"_5":31530,"_21594":126661,"_28366":126662,"_3078":126663},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#continúa","Continúa",{"_3627":74822,"_31174":74811,"_21594":126665,"_5":14861,"_28366":74811,"_3078":126666},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3627":74823,"_31174":74811,"_21594":126668,"_5":14861,"_28366":126630,"_3078":126669},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3627":74824,"_31174":74811,"_21594":126671,"_5":14861,"_28366":126630,"_3078":126672},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3627":74825,"_31174":74811,"_21594":126674,"_5":14861,"_28366":126630,"_3078":126675},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3627":74826,"_31174":74811,"_21594":126677,"_5":14861,"_28366":126630,"_3078":126678},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3627":74827,"_31174":74811,"_21594":126680,"_5":14861,"_28366":126630,"_3078":126681},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3627":74828,"_31174":74811,"_21594":126683,"_5":14861,"_28366":126630,"_3078":126684},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3627":74829,"_31174":74811,"_21594":126686,"_5":14861,"_28366":126630,"_3078":126687},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3627":74830,"_31174":74811,"_21594":126689,"_5":14861,"_28366":126634,"_3078":126690},[],"Descarga el PEM e inspecciónalo:",{"_3627":74831,"_31174":74811,"_21594":126692,"_5":14861,"_28366":126634,"_3078":126693},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3627":74832,"_31174":74811,"_21594":126695,"_5":14861,"_28366":126638,"_3078":126696},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3627":74833,"_31174":74811,"_21594":126698,"_5":14861,"_28366":126638,"_3078":126699},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3627":74834,"_31174":74811,"_21594":126701,"_5":14861,"_28366":126638,"_3078":126702},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3627":74835,"_31174":74811,"_21594":126704,"_5":14861,"_28366":126638,"_3078":126705},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3627":74836,"_31174":74811,"_21594":126707,"_5":14861,"_28366":126638,"_3078":126708},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3627":74837,"_31174":74811,"_21594":126710,"_5":14861,"_28366":126638,"_3078":126711},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3627":74838,"_31174":74811,"_21594":126713,"_5":14861,"_28366":126638,"_3078":126714},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3627":74839,"_31174":74811,"_21594":126716,"_5":14861,"_28366":126642,"_3078":126717},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3627":74840,"_31174":74811,"_21594":126719,"_5":14861,"_28366":126646,"_3078":126720},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3627":74841,"_31174":74811,"_21594":126722,"_5":14861,"_28366":126650,"_3078":126723},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3627":74842,"_31174":74811,"_21594":126725,"_5":14861,"_28366":126654,"_3078":126726},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3627":74843,"_31174":74811,"_21594":126728,"_5":14861,"_28366":126654,"_3078":126729},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3627":74844,"_31174":74811,"_21594":126731,"_5":14861,"_28366":126654,"_3078":126732},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3627":74845,"_31174":74811,"_21594":126734,"_5":14861,"_28366":126658,"_3078":126735},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3627":74846,"_31174":74811,"_21594":126737,"_5":14861,"_28366":126658,"_3078":126738},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3627":74847,"_31174":74811,"_21594":126740,"_5":14861,"_28366":126658,"_3078":126741},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3627":74848,"_31174":74811,"_21594":126743,"_5":14861,"_28366":126662,"_3078":126744},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3627":74849,"_31174":74811,"_21594":126746,"_5":14861,"_28366":126662,"_3078":126747},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3627":74850,"_31174":74850,"_5":15221,"_3078":126749,"_31533":126750,"_21594":126752,"_28366":74850},"Ciclo de vida de un certificado",[50951,121820,56637,126751],"Conceptos",[],{"_3627":74851,"_31174":74850,"_21594":126754,"_5":14861,"_28366":74850,"_3078":126755},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3627":74852,"_31174":74850,"_5":31530,"_21594":126757,"_28366":126758,"_3078":126759},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3627":74853,"_31174":74850,"_5":31530,"_21594":126761,"_28366":126762,"_3078":126763},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3627":74854,"_31174":74850,"_5":31530,"_21594":126765,"_28366":126766,"_3078":126767},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3627":74855,"_31174":74850,"_5":31530,"_21594":126769,"_28366":126770,"_3078":126771},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3627":74856,"_31174":74850,"_5":31530,"_21594":126773,"_28366":126774,"_3078":126775},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3627":74857,"_31174":74850,"_5":31530,"_21594":126777,"_28366":126778,"_3078":126779},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3627":74858,"_31174":74850,"_5":31530,"_21594":126781,"_28366":126782,"_3078":124465},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3627":74859,"_31174":74850,"_5":31530,"_21594":126784,"_28366":126785,"_3078":126786},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3627":74860,"_31174":74850,"_5":31530,"_21594":126788,"_28366":126789,"_3078":126790},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3627":74861,"_31174":74850,"_5":31530,"_21594":126792,"_28366":126793,"_3078":126794},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3627":74862,"_31174":74850,"_21594":126796,"_5":14861,"_28366":74850,"_3078":126797},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3627":74863,"_31174":74850,"_21594":126799,"_5":14861,"_28366":126762,"_3078":126800},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3627":74864,"_31174":74850,"_21594":126802,"_5":14861,"_28366":126766,"_3078":126803},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3627":74865,"_31174":74850,"_21594":126805,"_5":14861,"_28366":126770,"_3078":126806},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3627":74866,"_31174":74850,"_21594":126808,"_5":14861,"_28366":126774,"_3078":126809},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3627":74867,"_31174":74850,"_21594":126811,"_5":14861,"_28366":126778,"_3078":126812},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3627":74868,"_31174":74850,"_21594":126814,"_5":14861,"_28366":126782,"_3078":126815},[],"Lamassu persiste cuatro estados X.509:",{"_3627":74869,"_31174":74850,"_21594":126817,"_5":14861,"_28366":126782,"_3078":126818},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3627":74870,"_31174":74850,"_21594":126820,"_5":14861,"_28366":126782,"_3078":126821},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3627":74871,"_31174":74850,"_21594":126823,"_5":14861,"_28366":126782,"_3078":126824},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3627":74872,"_31174":74850,"_21594":126826,"_5":14861,"_28366":126782,"_3078":126827},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3627":74873,"_31174":74850,"_21594":126829,"_5":14861,"_28366":126782,"_3078":126830},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3627":74874,"_31174":74850,"_21594":126832,"_5":14861,"_28366":126785,"_3078":126833},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3627":74875,"_31174":74850,"_21594":126835,"_5":14861,"_28366":126785,"_3078":126836},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3627":74876,"_31174":74850,"_21594":126838,"_5":14861,"_28366":126785,"_3078":126839},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3627":74877,"_31174":74850,"_21594":126841,"_5":14861,"_28366":126789,"_3078":126842},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3627":74878,"_31174":74850,"_21594":126844,"_5":14861,"_28366":126789,"_3078":126845},[],"Antes de confirmar:",{"_3627":74879,"_31174":74850,"_21594":126847,"_5":14861,"_28366":126789,"_3078":126848},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3627":74880,"_31174":74850,"_21594":126850,"_5":14861,"_28366":126789,"_3078":126851},[],"Distribuye la nueva cadena de confianza.",{"_3627":74881,"_31174":74850,"_21594":126853,"_5":14861,"_28366":126789,"_3078":126854},[],"Reemite las identidades necesarias.",{"_3627":74882,"_31174":74850,"_21594":126856,"_5":14861,"_28366":126789,"_3078":126857},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3627":74883,"_31174":74850,"_21594":126859,"_5":14861,"_28366":126789,"_3078":126860},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3627":74884,"_31174":74850,"_21594":126862,"_5":14861,"_28366":126789,"_3078":126863},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3627":74885,"_31174":74850,"_21594":126865,"_5":14861,"_28366":126793,"_3078":126866},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3627":74886,"_31174":74850,"_21594":126868,"_5":14861,"_28366":126793,"_3078":126869},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3627":74887,"_31174":74850,"_21594":126871,"_5":14861,"_28366":126793,"_3078":126872},[],"Cambios de estado y razones de revocación.",{"_3627":74888,"_31174":74850,"_21594":126874,"_5":14861,"_28366":126793,"_3078":126875},[],"Publicación y vigencia de OCSP y CRLs.",{"_3627":74889,"_31174":74850,"_21594":126877,"_5":14861,"_28366":126793,"_3078":126878},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3627":74890,"_31174":74850,"_21594":126880,"_5":14861,"_28366":126793,"_3078":126881},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3627":74891,"_31174":74891,"_5":15221,"_3078":126883,"_31533":126884,"_21594":126885,"_28366":74891},"Modelo de confianza",[50951,121820,56637,126751],[],{"_3627":74892,"_31174":74891,"_21594":126887,"_5":14861,"_28366":74891,"_3078":126888},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3627":74893,"_31174":74891,"_5":31530,"_21594":126890,"_28366":126891,"_3078":126892},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3627":74894,"_31174":74891,"_5":31530,"_21594":126894,"_28366":126895,"_3078":126896},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3627":74895,"_31174":74891,"_5":31530,"_21594":126898,"_28366":126899,"_3078":126900},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3627":74896,"_31174":74891,"_5":31530,"_21594":126902,"_28366":126903,"_3078":126904},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3627":74897,"_31174":74891,"_5":31530,"_21594":126906,"_28366":126907,"_3078":126908},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3627":74898,"_31174":74891,"_5":31530,"_21594":126910,"_28366":126911,"_3078":126912},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3627":74899,"_31174":74891,"_5":31530,"_21594":126914,"_28366":126915,"_3078":126916},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3627":74900,"_31174":74891,"_5":31530,"_21594":126918,"_28366":126919,"_3078":126920},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3627":74901,"_31174":74891,"_5":31530,"_21594":126922,"_28366":126923,"_3078":126924},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3627":74902,"_31174":74891,"_5":31530,"_21594":126926,"_28366":126927,"_3078":126928},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3627":74903,"_31174":74891,"_21594":126930,"_5":14861,"_28366":74891,"_3078":126931},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3627":74904,"_31174":74891,"_21594":126933,"_5":14861,"_28366":126895,"_3078":126934},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3627":74905,"_31174":74891,"_21594":126936,"_5":14861,"_28366":126899,"_3078":126937},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3627":74906,"_31174":74891,"_21594":126939,"_5":14861,"_28366":126903,"_3078":126940},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3627":74907,"_31174":74891,"_21594":126942,"_5":14861,"_28366":126907,"_3078":126943},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3627":74908,"_31174":74891,"_21594":126945,"_5":14861,"_28366":126911,"_3078":126946},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3627":74909,"_31174":74891,"_21594":126948,"_5":14861,"_28366":126911,"_3078":126949},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3627":74910,"_31174":74891,"_21594":126951,"_5":14861,"_28366":126911,"_3078":126952},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3627":74911,"_31174":74891,"_21594":126954,"_5":14861,"_28366":126911,"_3078":126955},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3627":74912,"_31174":74891,"_21594":126957,"_5":14861,"_28366":126911,"_3078":126958},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3627":74913,"_31174":74891,"_21594":126960,"_5":14861,"_28366":126911,"_3078":126961},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3627":74914,"_31174":74891,"_21594":126963,"_5":14861,"_28366":126915,"_3078":126964},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3627":74915,"_31174":74891,"_21594":126966,"_5":14861,"_28366":126915,"_3078":126967},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3627":74916,"_31174":74891,"_21594":126969,"_5":14861,"_28366":126915,"_3078":126970},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3627":74917,"_31174":74891,"_21594":126972,"_5":14861,"_28366":126915,"_3078":126973},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3627":74918,"_31174":74891,"_21594":126975,"_5":14861,"_28366":126915,"_3078":126976},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3627":74919,"_31174":74891,"_21594":126978,"_5":14861,"_28366":126919,"_3078":126979},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3627":74920,"_31174":74891,"_21594":126981,"_5":14861,"_28366":126919,"_3078":126982},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3627":74921,"_31174":74891,"_21594":126984,"_5":14861,"_28366":126919,"_3078":126985},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3627":74922,"_31174":74891,"_21594":126987,"_5":14861,"_28366":126919,"_3078":126988},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3627":74923,"_31174":74891,"_21594":126990,"_5":14861,"_28366":126919,"_3078":126991},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3627":74924,"_31174":74891,"_21594":126993,"_5":14861,"_28366":126919,"_3078":126994},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3627":74925,"_31174":74891,"_21594":126996,"_5":14861,"_28366":126919,"_3078":126997},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3627":74926,"_31174":74891,"_21594":126999,"_5":14861,"_28366":126923,"_3078":127000},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3627":74927,"_31174":74891,"_21594":127002,"_5":14861,"_28366":126927,"_3078":127003},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3627":74928,"_31174":74891,"_21594":127005,"_5":14861,"_28366":126927,"_3078":127006},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3627":74929,"_31174":74891,"_21594":127008,"_5":14861,"_28366":126927,"_3078":127009},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3627":74930,"_31174":74891,"_21594":127011,"_5":14861,"_28366":126927,"_3078":127012},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3627":74931,"_31174":74891,"_21594":127014,"_5":14861,"_28366":126927,"_3078":127015},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3627":74932,"_31174":74891,"_21594":127017,"_5":14861,"_28366":126927,"_3078":127018},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3627":74933,"_31174":74891,"_21594":127020,"_5":14861,"_28366":126927,"_3078":127021},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3627":74934,"_31174":74934,"_5":15221,"_3078":127023,"_31533":127024,"_21594":127025,"_28366":74934},"Listas de revocación (CRL)",[50951,121820,56637,126497],[],{"_3627":74935,"_31174":74934,"_21594":127027,"_5":14861,"_28366":74934,"_3078":127028},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3627":74936,"_31174":74934,"_5":31530,"_21594":127030,"_28366":127031,"_3078":127032},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3627":74937,"_31174":74934,"_5":31530,"_21594":127034,"_28366":127035,"_3078":127036},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3627":74938,"_31174":74934,"_5":31530,"_21594":127038,"_28366":127039,"_3078":127040},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3627":74939,"_31174":74934,"_5":31530,"_21594":127042,"_28366":127043,"_3078":127044},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3627":74940,"_31174":74934,"_5":31530,"_21594":127046,"_28366":127047,"_3078":127048},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3627":74941,"_31174":74934,"_5":31530,"_21594":127050,"_28366":127051,"_3078":127052},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3627":74942,"_31174":74934,"_5":31530,"_21594":127054,"_28366":127055,"_3078":127056},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3627":74943,"_31174":74934,"_5":31530,"_21594":127058,"_28366":127059,"_3078":127060},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#referencias","Referencias",{"_3627":74944,"_31174":74934,"_21594":127062,"_5":14861,"_28366":74934,"_3078":127063},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3627":74945,"_31174":74934,"_21594":127065,"_5":14861,"_28366":127031,"_3078":127066},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3627":74946,"_31174":74934,"_21594":127068,"_5":14861,"_28366":127031,"_3078":127069},[],"Campo",{"_3627":74947,"_31174":74934,"_21594":127071,"_5":14861,"_28366":127031,"_3078":123506},[],{"_3627":74948,"_31174":74934,"_21594":127073,"_5":14861,"_28366":127031,"_3078":52583},[],{"_3627":74949,"_31174":74934,"_21594":127075,"_5":14861,"_28366":127031,"_3078":127076},[],"ID de la CA a la que pertenecen los ajustes.",{"_3627":74950,"_31174":74934,"_21594":127078,"_5":14861,"_28366":127031,"_3078":57878},[],{"_3627":74951,"_31174":74934,"_21594":127080,"_5":14861,"_28366":127031,"_3078":127081},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3627":74952,"_31174":74934,"_21594":127083,"_5":14861,"_28366":127031,"_3078":57884},[],{"_3627":74953,"_31174":74934,"_21594":127085,"_5":14861,"_28366":127031,"_3078":127086},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3627":74954,"_31174":74934,"_21594":127088,"_5":14861,"_28366":127031,"_3078":57890},[],{"_3627":74955,"_31174":74934,"_21594":127090,"_5":14861,"_28366":127031,"_3078":127091},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3627":74956,"_31174":74934,"_21594":127093,"_5":14861,"_28366":127031,"_3078":127094},[],"Campo de `crl_options`",{"_3627":74957,"_31174":74934,"_21594":127096,"_5":14861,"_28366":127031,"_3078":123506},[],{"_3627":74958,"_31174":74934,"_21594":127098,"_5":14861,"_28366":127031,"_3078":127099},[],"Valor inicial",{"_3627":74959,"_31174":74934,"_21594":127101,"_5":14861,"_28366":127031,"_3078":57904},[],{"_3627":74960,"_31174":74934,"_21594":127103,"_5":14861,"_28366":127031,"_3078":127104},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3627":74961,"_31174":74934,"_21594":127106,"_5":14861,"_28366":127031,"_3078":127107},[],"7 días.",{"_3627":74962,"_31174":74934,"_21594":127109,"_5":14861,"_28366":127031,"_3078":57913},[],{"_3627":74963,"_31174":74934,"_21594":127111,"_5":14861,"_28366":127031,"_3078":127112},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3627":74964,"_31174":74934,"_21594":127114,"_5":14861,"_28366":127031,"_3078":127115},[],"6 días y 23 horas.",{"_3627":74965,"_31174":74934,"_21594":127117,"_5":14861,"_28366":127031,"_3078":57922},[],{"_3627":74966,"_31174":74934,"_21594":127119,"_5":14861,"_28366":127031,"_3078":127120},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3627":74967,"_31174":74934,"_21594":127122,"_5":14861,"_28366":127031,"_3078":57928},[],{"_3627":74968,"_31174":74934,"_21594":127124,"_5":14861,"_28366":127031,"_3078":57931},[],{"_3627":74969,"_31174":74934,"_21594":127126,"_5":14861,"_28366":127031,"_3078":127127},[],"Número de serie del certificado existente que firma la CRL.",{"_3627":74970,"_31174":74934,"_21594":127129,"_5":14861,"_28366":127031,"_3078":127130},[],"Número de serie del certificado actual de la CA.",{"_3627":74971,"_31174":74934,"_21594":127132,"_5":14861,"_28366":127031,"_3078":127133},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3627":74972,"_31174":74934,"_21594":127135,"_5":14861,"_28366":127031,"_3078":127136},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3627":74973,"_31174":74934,"_21594":127138,"_5":14861,"_28366":127031,"_3078":127139},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3627":74974,"_31174":74934,"_21594":127141,"_5":14861,"_28366":127031,"_3078":127142},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3627":74975,"_31174":74934,"_21594":127144,"_5":14861,"_28366":127031,"_3078":127145},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3627":74976,"_31174":74934,"_21594":127147,"_5":14861,"_28366":127031,"_3078":127148},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3627":74977,"_31174":74934,"_21594":127150,"_5":14861,"_28366":127031,"_3078":127151},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3627":74978,"_31174":74934,"_21594":127153,"_5":14861,"_28366":127031,"_3078":127154},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3627":74979,"_31174":74934,"_21594":127156,"_5":14861,"_28366":127031,"_3078":127157},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3627":74980,"_31174":74934,"_21594":127159,"_5":14861,"_28366":127031,"_3078":127160},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3627":74981,"_31174":74934,"_21594":127162,"_5":14861,"_28366":127031,"_3078":127163},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3627":74982,"_31174":74934,"_21594":127165,"_5":14861,"_28366":127035,"_3078":127166},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3627":74983,"_31174":74934,"_21594":127168,"_5":14861,"_28366":127035,"_3078":127169},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3627":74984,"_31174":74934,"_21594":127171,"_5":14861,"_28366":127035,"_3078":127172},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3627":74985,"_31174":74934,"_21594":127174,"_5":14861,"_28366":127035,"_3078":127175},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3627":74986,"_31174":74934,"_21594":127177,"_5":14861,"_28366":127039,"_3078":127178},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3627":74987,"_31174":74934,"_21594":127180,"_5":14861,"_28366":127039,"_3078":127181},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3627":74988,"_31174":74934,"_21594":127183,"_5":14861,"_28366":127039,"_3078":127184},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3627":74989,"_31174":74934,"_21594":127186,"_5":14861,"_28366":127039,"_3078":127187},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3627":74990,"_31174":74934,"_21594":127189,"_5":14861,"_28366":127039,"_3078":127190},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3627":74991,"_31174":74934,"_21594":127192,"_5":14861,"_28366":127039,"_3078":127193},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3627":74992,"_31174":74934,"_21594":127195,"_5":14861,"_28366":127039,"_3078":127196},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3627":74993,"_31174":74934,"_21594":127198,"_5":14861,"_28366":127039,"_3078":127199},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3627":74994,"_31174":74934,"_21594":127201,"_5":14861,"_28366":127039,"_3078":127202},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3627":74995,"_31174":74934,"_21594":127204,"_5":14861,"_28366":127043,"_3078":127205},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3627":74996,"_31174":74934,"_21594":127207,"_5":14861,"_28366":127043,"_3078":127208},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3627":74997,"_31174":74934,"_21594":127210,"_5":14861,"_28366":127047,"_3078":127211},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3627":74998,"_31174":74934,"_21594":127213,"_5":14861,"_28366":127047,"_3078":127214},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3627":74999,"_31174":74934,"_21594":127216,"_5":14861,"_28366":127047,"_3078":127217},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3627":75000,"_31174":74934,"_21594":127219,"_5":14861,"_28366":127047,"_3078":127220},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3627":75001,"_31174":74934,"_21594":127222,"_5":14861,"_28366":127047,"_3078":127223},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3627":75002,"_31174":74934,"_21594":127225,"_5":14861,"_28366":127051,"_3078":127226},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3627":75003,"_31174":74934,"_21594":127228,"_5":14861,"_28366":127051,"_3078":123695},[],{"_3627":75004,"_31174":74934,"_21594":127230,"_5":14861,"_28366":127051,"_3078":127231},[],"Path relativo",{"_3627":75005,"_31174":74934,"_21594":127233,"_5":14861,"_28366":127051,"_3078":121580},[],{"_3627":75006,"_31174":74934,"_21594":127235,"_5":14861,"_28366":127051,"_3078":58043},[],{"_3627":75007,"_31174":74934,"_21594":127237,"_5":14861,"_28366":127051,"_3078":58046},[],{"_3627":75008,"_31174":74934,"_21594":127239,"_5":14861,"_28366":127051,"_3078":127240},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3627":75009,"_31174":74934,"_21594":127242,"_5":14861,"_28366":127051,"_3078":58043},[],{"_3627":75010,"_31174":74934,"_21594":127244,"_5":14861,"_28366":127051,"_3078":58054},[],{"_3627":75011,"_31174":74934,"_21594":127246,"_5":14861,"_28366":127051,"_3078":127247},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3627":75012,"_31174":74934,"_21594":127249,"_5":14861,"_28366":127051,"_3078":58060},[],{"_3627":75013,"_31174":74934,"_21594":127251,"_5":14861,"_28366":127051,"_3078":58054},[],{"_3627":75014,"_31174":74934,"_21594":127253,"_5":14861,"_28366":127051,"_3078":127254},[],"Sustituir la configuración de CRL de una CA.",{"_3627":75015,"_31174":74934,"_21594":127256,"_5":14861,"_28366":127051,"_3078":58068},[],{"_3627":75016,"_31174":74934,"_21594":127258,"_5":14861,"_28366":127051,"_3078":58054},[],{"_3627":75017,"_31174":74934,"_21594":127260,"_5":14861,"_28366":127051,"_3078":127261},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3627":75018,"_31174":74934,"_21594":127263,"_5":14861,"_28366":127051,"_3078":127264},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3627":75019,"_31174":74934,"_21594":127266,"_5":14861,"_28366":127051,"_3078":127267},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3627":75020,"_31174":74934,"_21594":127269,"_5":14861,"_28366":127051,"_3078":127270},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3627":75021,"_31174":74934,"_21594":127272,"_5":14861,"_28366":127055,"_3078":127273},[],"Síntoma",{"_3627":75022,"_31174":74934,"_21594":127275,"_5":14861,"_28366":127055,"_3078":127276},[],"Causa",{"_3627":75023,"_31174":74934,"_21594":127278,"_5":14861,"_28366":127055,"_3078":127279},[],"Acción",{"_3627":75024,"_31174":74934,"_21594":127281,"_5":14861,"_28366":127055,"_3078":127282},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3627":75025,"_31174":74934,"_21594":127284,"_5":14861,"_28366":127055,"_3078":127285},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3627":75026,"_31174":74934,"_21594":127287,"_5":14861,"_28366":127055,"_3078":127288},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3627":75027,"_31174":74934,"_21594":127290,"_5":14861,"_28366":127055,"_3078":127291},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3627":75028,"_31174":74934,"_21594":127293,"_5":14861,"_28366":127055,"_3078":127294},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3627":75029,"_31174":74934,"_21594":127296,"_5":14861,"_28366":127055,"_3078":127297},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3627":75030,"_31174":74934,"_21594":127299,"_5":14861,"_28366":127055,"_3078":127300},[],"`PUT` devuelve 400.",{"_3627":75031,"_31174":74934,"_21594":127302,"_5":14861,"_28366":127055,"_3078":127303},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3627":75032,"_31174":74934,"_21594":127305,"_5":14861,"_28366":127055,"_3078":127306},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3627":75033,"_31174":74934,"_21594":127308,"_5":14861,"_28366":127055,"_3078":127309},[],"`PUT` devuelve 404.",{"_3627":75034,"_31174":74934,"_21594":127311,"_5":14861,"_28366":127055,"_3078":127312},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3627":75035,"_31174":74934,"_21594":127314,"_5":14861,"_28366":127055,"_3078":127315},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3627":75036,"_31174":74934,"_21594":127317,"_5":14861,"_28366":127055,"_3078":127318},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3627":75037,"_31174":74934,"_21594":127320,"_5":14861,"_28366":127055,"_3078":127321},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3627":75038,"_31174":74934,"_21594":127323,"_5":14861,"_28366":127055,"_3078":127324},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3627":75039,"_31174":74934,"_21594":127326,"_5":14861,"_28366":127055,"_3078":127327},[],"La CRL no cambia tras revocar un certificado.",{"_3627":75040,"_31174":74934,"_21594":127329,"_5":14861,"_28366":127055,"_3078":127330},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3627":75041,"_31174":74934,"_21594":127332,"_5":14861,"_28366":127055,"_3078":127333},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3627":75042,"_31174":74934,"_21594":127335,"_5":14861,"_28366":127055,"_3078":127336},[],"Un verificador rechaza la CRL por el emisor.",{"_3627":75043,"_31174":74934,"_21594":127338,"_5":14861,"_28366":127055,"_3078":127339},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3627":75044,"_31174":74934,"_21594":127341,"_5":14861,"_28366":127055,"_3078":127342},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3627":75045,"_31174":74934,"_21594":127344,"_5":14861,"_28366":127059,"_3078":127345},[],"RFC 5280: perfil X.509 y CRL.",{"_3627":75046,"_31174":74934,"_21594":127347,"_5":14861,"_28366":127059,"_3078":58160},[],{"_3627":75047,"_31174":74934,"_21594":127349,"_5":14861,"_28366":127059,"_3078":58163},[],{"_3627":75048,"_31174":74934,"_21594":127351,"_5":14861,"_28366":127059,"_3078":127352},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3627":75049,"_31174":74934,"_21594":127354,"_5":14861,"_28366":127059,"_3078":127355},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3627":75050,"_31174":75050,"_5":15221,"_3078":127357,"_31533":127358,"_21594":127359,"_28366":75050},"Claves y motores criptográficos",[50951,121820,56637,125842],[],{"_3627":75051,"_31174":75050,"_21594":127361,"_5":14861,"_28366":75050,"_3078":127362},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3627":75052,"_31174":75050,"_5":31530,"_21594":127364,"_28366":127365,"_3078":127366},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3627":75053,"_31174":75050,"_5":31530,"_21594":127368,"_28366":127369,"_3078":127370},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3627":75054,"_31174":75050,"_5":31530,"_21594":127372,"_28366":127373,"_3078":58188},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#file-system",{"_3627":75055,"_31174":75050,"_5":31530,"_21594":127375,"_28366":127376,"_3078":58192},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#hashicorp-vault",{"_3627":75056,"_31174":75050,"_5":31530,"_21594":127378,"_28366":127379,"_3078":58196},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#aws-secrets-manager",{"_3627":75057,"_31174":75050,"_5":31530,"_21594":127381,"_28366":127382,"_3078":58200},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#aws-kms",{"_3627":75058,"_31174":75050,"_5":31530,"_21594":127384,"_28366":127385,"_3078":58204},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#pkcs11",{"_3627":75059,"_31174":75050,"_5":31530,"_21594":127387,"_28366":127388,"_3078":58208},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#azure-key-vault",{"_3627":75060,"_31174":75050,"_5":31530,"_21594":127390,"_28366":127391,"_3078":127392},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3627":75061,"_31174":75050,"_5":31530,"_21594":127394,"_28366":127395,"_3078":127396},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3627":75062,"_31174":75050,"_5":31530,"_21594":127398,"_28366":127399,"_3078":127400},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3627":75063,"_31174":75050,"_5":31530,"_21594":127402,"_28366":127403,"_3078":127404},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3627":75064,"_31174":75050,"_5":31530,"_21594":127406,"_28366":127407,"_3078":127408},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3627":75065,"_31174":75050,"_5":31530,"_21594":127410,"_28366":127411,"_3078":127412},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3627":75066,"_31174":75050,"_5":31530,"_21594":127414,"_28366":127415,"_3078":127416},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3627":75067,"_31174":75050,"_5":31530,"_21594":127418,"_28366":127419,"_3078":58240},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#sign",{"_3627":75068,"_31174":75050,"_5":31530,"_21594":127421,"_28366":127422,"_3078":58244},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#verify",{"_3627":75069,"_31174":75050,"_5":31530,"_21594":127424,"_28366":127425,"_3078":127426},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3627":75070,"_31174":75050,"_5":31530,"_21594":127428,"_28366":127429,"_3078":127430},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3627":75071,"_31174":75050,"_5":31530,"_21594":127432,"_28366":127433,"_3078":127434},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3627":75072,"_31174":75050,"_21594":127436,"_5":14861,"_28366":75050,"_3078":127437},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3627":75073,"_31174":75050,"_21594":127439,"_5":14861,"_28366":75050,"_3078":127440},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3627":75074,"_31174":75050,"_21594":127442,"_5":14861,"_28366":127365,"_3078":127443},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3627":75075,"_31174":75050,"_21594":127445,"_5":14861,"_28366":127365,"_3078":127446},[],"En la práctica, permite:",{"_3627":75076,"_31174":75050,"_21594":127448,"_5":14861,"_28366":127365,"_3078":127449},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3627":75077,"_31174":75050,"_21594":127451,"_5":14861,"_28366":127365,"_3078":127452},[],"Importar claves creadas externamente.",{"_3627":75078,"_31174":75050,"_21594":127454,"_5":14861,"_28366":127365,"_3078":127455},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3627":75079,"_31174":75050,"_21594":127457,"_5":14861,"_28366":127365,"_3078":127458},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3627":75080,"_31174":75050,"_21594":127460,"_5":14861,"_28366":127369,"_3078":127461},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3627":75081,"_31174":75050,"_21594":127463,"_5":14861,"_28366":127369,"_3078":127464},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3627":75082,"_31174":75050,"_21594":127466,"_5":14861,"_28366":127369,"_3078":127467},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3627":75083,"_31174":75050,"_21594":127469,"_5":14861,"_28366":127373,"_3078":127470},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3627":75084,"_31174":75050,"_21594":127472,"_5":14861,"_28366":127376,"_3078":127473},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3627":75085,"_31174":75050,"_21594":127475,"_5":14861,"_28366":127376,"_3078":127476},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3627":75086,"_31174":75050,"_21594":127478,"_5":14861,"_28366":127379,"_3078":127479},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3627":75087,"_31174":75050,"_21594":127481,"_5":14861,"_28366":127382,"_3078":127482},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3627":75088,"_31174":75050,"_21594":127484,"_5":14861,"_28366":127385,"_3078":127485},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3627":75089,"_31174":75050,"_21594":127487,"_5":14861,"_28366":127388,"_3078":127488},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3627":75090,"_31174":75050,"_21594":127490,"_5":14861,"_28366":127388,"_3078":127491},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3627":75091,"_31174":75050,"_21594":127493,"_5":14861,"_28366":127388,"_3078":127494},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3627":75092,"_31174":75050,"_21594":127496,"_5":14861,"_28366":127388,"_3078":127497},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3627":75093,"_31174":75050,"_21594":127499,"_5":14861,"_28366":127391,"_3078":127500},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3627":75094,"_31174":75050,"_21594":127502,"_5":14861,"_28366":127391,"_3078":127503},[],"La tabla incluye los siguientes campos:",{"_3627":75095,"_31174":75050,"_21594":127505,"_5":14861,"_28366":127391,"_3078":127506},[],"**Name**: nombre descriptivo de la clave.",{"_3627":75096,"_31174":75050,"_21594":127508,"_5":14861,"_28366":127391,"_3078":127509},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3627":75097,"_31174":75050,"_21594":127511,"_5":14861,"_28366":127391,"_3078":127512},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3627":75098,"_31174":75050,"_21594":127514,"_5":14861,"_28366":127391,"_3078":127515},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3627":75099,"_31174":75050,"_21594":127517,"_5":14861,"_28366":127391,"_3078":127518},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3627":75100,"_31174":75050,"_21594":127520,"_5":14861,"_28366":127391,"_3078":127521},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3627":75101,"_31174":75050,"_21594":127523,"_5":14861,"_28366":127391,"_3078":127524},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3627":75102,"_31174":75050,"_21594":127526,"_5":14861,"_28366":127391,"_3078":127527},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3627":75103,"_31174":75050,"_21594":127529,"_5":14861,"_28366":127391,"_3078":127530},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3627":75104,"_31174":75050,"_21594":127532,"_5":14861,"_28366":127391,"_3078":127533},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3627":75105,"_31174":75050,"_21594":127535,"_5":14861,"_28366":127391,"_3078":127536},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3627":75106,"_31174":75050,"_21594":127538,"_5":14861,"_28366":127391,"_3078":127539},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3627":75107,"_31174":75050,"_21594":127541,"_5":14861,"_28366":127391,"_3078":127542},[],"**Delete Key** para eliminar la clave del sistema.",{"_3627":75108,"_31174":75050,"_21594":127544,"_5":14861,"_28366":127395,"_3078":127545},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3627":75109,"_31174":75050,"_21594":127547,"_5":14861,"_28366":127399,"_3078":127548},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3627":75110,"_31174":75050,"_21594":127550,"_5":14861,"_28366":127399,"_3078":127551},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3627":75111,"_31174":75050,"_21594":127553,"_5":14861,"_28366":127399,"_3078":127554},[],"**Key Name**: nombre único y descriptivo.",{"_3627":75112,"_31174":75050,"_21594":127556,"_5":14861,"_28366":127399,"_3078":127557},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3627":75113,"_31174":75050,"_21594":127559,"_5":14861,"_28366":127399,"_3078":127560},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3627":75114,"_31174":75050,"_21594":127562,"_5":14861,"_28366":127399,"_3078":127563},[],"**Tags**: metadatos para clasificar la clave.",{"_3627":75115,"_31174":75050,"_21594":127565,"_5":14861,"_28366":127399,"_3078":127566},[],"**Metadata**: información adicional para usos avanzados.",{"_3627":75116,"_31174":75050,"_21594":127568,"_5":14861,"_28366":127403,"_3078":127569},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3627":75117,"_31174":75050,"_21594":127571,"_5":14861,"_28366":127403,"_3078":127572},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3627":75118,"_31174":75050,"_21594":127574,"_5":14861,"_28366":127403,"_3078":127575},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3627":75119,"_31174":75050,"_21594":127577,"_5":14861,"_28366":127403,"_3078":127578},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3627":75120,"_31174":75050,"_21594":127580,"_5":14861,"_28366":127403,"_3078":127581},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3627":75121,"_31174":75050,"_21594":127583,"_5":14861,"_28366":127403,"_3078":127584},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3627":75122,"_31174":75050,"_21594":127586,"_5":14861,"_28366":127403,"_3078":127587},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3627":75123,"_31174":75050,"_21594":127589,"_5":14861,"_28366":127403,"_3078":127590},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3627":75124,"_31174":75050,"_21594":127592,"_5":14861,"_28366":127403,"_3078":127593},[],"**Metadata**: información adicional opcional.",{"_3627":75125,"_31174":75050,"_21594":127595,"_5":14861,"_28366":127403,"_3078":127596},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3627":75126,"_31174":75050,"_21594":127598,"_5":14861,"_28366":127403,"_3078":127599},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3627":75127,"_31174":75050,"_21594":127601,"_5":14861,"_28366":127407,"_3078":127602},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3627":75128,"_31174":75050,"_21594":127604,"_5":14861,"_28366":127411,"_3078":127605},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3627":75129,"_31174":75050,"_21594":127607,"_5":14861,"_28366":127411,"_3078":127608},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3627":75130,"_31174":75050,"_21594":127610,"_5":14861,"_28366":127411,"_3078":127611},[],"**Key Name**: nombre descriptivo.",{"_3627":75131,"_31174":75050,"_21594":127613,"_5":14861,"_28366":127411,"_3078":127614},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3627":75132,"_31174":75050,"_21594":127616,"_5":14861,"_28366":127411,"_3078":127617},[],"**Tags**: etiquetas asociadas.",{"_3627":75133,"_31174":75050,"_21594":127619,"_5":14861,"_28366":127411,"_3078":127620},[],"**Aliases**: nombres alternativos.",{"_3627":75134,"_31174":75050,"_21594":127622,"_5":14861,"_28366":127411,"_3078":127623},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3627":75135,"_31174":75050,"_21594":127625,"_5":14861,"_28366":127411,"_3078":127626},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3627":75136,"_31174":75050,"_21594":127628,"_5":14861,"_28366":127411,"_3078":127629},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3627":75137,"_31174":75050,"_21594":127631,"_5":14861,"_28366":127411,"_3078":127632},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3627":75138,"_31174":75050,"_21594":127634,"_5":14861,"_28366":127415,"_3078":127635},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3627":75139,"_31174":75050,"_21594":127637,"_5":14861,"_28366":127415,"_3078":127638},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3627":75140,"_31174":75050,"_21594":127640,"_5":14861,"_28366":127415,"_3078":127641},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3627":75141,"_31174":75050,"_21594":127643,"_5":14861,"_28366":127419,"_3078":127644},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3627":75142,"_31174":75050,"_21594":127646,"_5":14861,"_28366":127419,"_3078":127647},[],"Campos principales:",{"_3627":75143,"_31174":75050,"_21594":127649,"_5":14861,"_28366":127419,"_3078":127650},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3627":75144,"_31174":75050,"_21594":127652,"_5":14861,"_28366":127419,"_3078":127653},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3627":75145,"_31174":75050,"_21594":127655,"_5":14861,"_28366":127419,"_3078":127656},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3627":75146,"_31174":75050,"_21594":127658,"_5":14861,"_28366":127419,"_3078":127659},[],"**Message**: contenido que se va a firmar.",{"_3627":75147,"_31174":75050,"_21594":127661,"_5":14861,"_28366":127419,"_3078":127662},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3627":75148,"_31174":75050,"_21594":127664,"_5":14861,"_28366":127422,"_3078":127665},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3627":75149,"_31174":75050,"_21594":127667,"_5":14861,"_28366":127422,"_3078":127647},[],{"_3627":75150,"_31174":75050,"_21594":127669,"_5":14861,"_28366":127422,"_3078":127670},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3627":75151,"_31174":75050,"_21594":127672,"_5":14861,"_28366":127422,"_3078":127673},[],"**Message Type**: `Raw` o `Digest`.",{"_3627":75152,"_31174":75050,"_21594":127675,"_5":14861,"_28366":127422,"_3078":127676},[],"**Payload Encoding**: codificación del mensaje.",{"_3627":75153,"_31174":75050,"_21594":127678,"_5":14861,"_28366":127422,"_3078":127679},[],"**Message**: mensaje original o hash.",{"_3627":75154,"_31174":75050,"_21594":127681,"_5":14861,"_28366":127422,"_3078":127682},[],"**Signature**: firma que se desea comprobar.",{"_3627":75155,"_31174":75050,"_21594":127684,"_5":14861,"_28366":127422,"_3078":127685},[],"**Result**: indicador del resultado de la validación.",{"_3627":75156,"_31174":75050,"_21594":127687,"_5":14861,"_28366":127425,"_3078":127688},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3627":75157,"_31174":75050,"_21594":127690,"_5":14861,"_28366":127425,"_3078":127691},[],"Este flujo es útil para:",{"_3627":75158,"_31174":75050,"_21594":127693,"_5":14861,"_28366":127425,"_3078":127694},[],"Solicitar certificados a una CA externa.",{"_3627":75159,"_31174":75050,"_21594":127696,"_5":14861,"_28366":127425,"_3078":127697},[],"Renovar una identidad manteniendo la misma clave.",{"_3627":75160,"_31174":75050,"_21594":127699,"_5":14861,"_28366":127425,"_3078":127700},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3627":75161,"_31174":75050,"_21594":127702,"_5":14861,"_28366":127425,"_3078":127703},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3627":75162,"_31174":75050,"_21594":127705,"_5":14861,"_28366":127425,"_3078":127706},[],"**Organization (O)**: organización o empresa.",{"_3627":75163,"_31174":75050,"_21594":127708,"_5":14861,"_28366":127425,"_3078":127709},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3627":75164,"_31174":75050,"_21594":127711,"_5":14861,"_28366":127425,"_3078":127712},[],"**Country (C)**: código de país de dos letras.",{"_3627":75165,"_31174":75050,"_21594":127714,"_5":14861,"_28366":127425,"_3078":127715},[],"**State / Province (ST)**: estado o provincia.",{"_3627":75166,"_31174":75050,"_21594":127717,"_5":14861,"_28366":127425,"_3078":127718},[],"**Locality (L)**: ciudad o localidad.",{"_3627":75167,"_31174":75050,"_21594":127720,"_5":14861,"_28366":127425,"_3078":127721},[],"**Email Address**: correo de contacto.",{"_3627":75168,"_31174":75050,"_21594":127723,"_5":14861,"_28366":127425,"_3078":127724},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3627":75169,"_31174":75050,"_21594":127726,"_5":14861,"_28366":127425,"_3078":127727},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3627":75170,"_31174":75050,"_21594":127729,"_5":14861,"_28366":127429,"_3078":127730},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3627":75171,"_31174":75050,"_21594":127732,"_5":14861,"_28366":127429,"_3078":127733},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3627":75172,"_31174":75050,"_21594":127735,"_5":14861,"_28366":127433,"_3078":127736},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3627":75173,"_31174":75050,"_21594":127738,"_5":14861,"_28366":127433,"_3078":127739},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3627":75174,"_31174":75174,"_5":15221,"_3078":127741,"_31533":127742,"_21594":127743,"_28366":75174},"Validación online con OCSP",[50951,121820,56637,126497],[],{"_3627":75175,"_31174":75174,"_21594":127745,"_5":14861,"_28366":75174,"_3078":127746},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3627":75176,"_31174":75174,"_5":31530,"_21594":127748,"_28366":127749,"_3078":127750},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3627":75177,"_31174":75174,"_5":31530,"_21594":127752,"_28366":127753,"_3078":127754},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3627":75178,"_31174":75174,"_5":31530,"_21594":127756,"_28366":127757,"_3078":127758},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3627":75179,"_31174":75174,"_5":31530,"_21594":127760,"_28366":127761,"_3078":127762},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3627":75180,"_31174":75174,"_5":31530,"_21594":127764,"_28366":127765,"_3078":127766},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3627":75181,"_31174":75174,"_5":31530,"_21594":127768,"_28366":127769,"_3078":127060},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#referencias",{"_3627":75182,"_31174":75174,"_21594":127771,"_5":14861,"_28366":75174,"_3078":127772},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3627":75183,"_31174":75174,"_21594":127774,"_5":14861,"_28366":127749,"_3078":127775},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3627":75184,"_31174":75174,"_21594":127777,"_5":14861,"_28366":127749,"_3078":127778},[],"Estado del registro",{"_3627":75185,"_31174":75174,"_21594":127780,"_5":14861,"_28366":127749,"_3078":127781},[],"Respuesta firmada",{"_3627":75186,"_31174":75174,"_21594":127783,"_5":14861,"_28366":127749,"_3078":55774},[],{"_3627":75187,"_31174":75174,"_21594":127785,"_5":14861,"_28366":127749,"_3078":58608},[],{"_3627":75188,"_31174":75174,"_21594":127787,"_5":14861,"_28366":127749,"_3078":55791},[],{"_3627":75189,"_31174":75174,"_21594":127789,"_5":14861,"_28366":127749,"_3078":127790},[],"`Revoked`, con razón y fecha de revocación.",{"_3627":75190,"_31174":75174,"_21594":127792,"_5":14861,"_28366":127749,"_3078":127793},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3627":75191,"_31174":75174,"_21594":127795,"_5":14861,"_28366":127749,"_3078":127796},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3627":75192,"_31174":75174,"_21594":127798,"_5":14861,"_28366":127749,"_3078":127799},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3627":75193,"_31174":75174,"_21594":127801,"_5":14861,"_28366":127749,"_3078":127802},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3627":75194,"_31174":75174,"_21594":127804,"_5":14861,"_28366":127749,"_3078":127805},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3627":75195,"_31174":75174,"_21594":127807,"_5":14861,"_28366":127753,"_3078":127808},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3627":75196,"_31174":75174,"_21594":127810,"_5":14861,"_28366":127753,"_3078":127811},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3627":75197,"_31174":75174,"_21594":127813,"_5":14861,"_28366":127757,"_3078":127814},[],"El servicio acepta:",{"_3627":75198,"_31174":75174,"_21594":127816,"_5":14861,"_28366":127757,"_3078":123695},[],{"_3627":75199,"_31174":75174,"_21594":127818,"_5":14861,"_28366":127757,"_3078":127819},[],"Ruta del servicio VA",{"_3627":75200,"_31174":75174,"_21594":127821,"_5":14861,"_28366":127757,"_3078":127822},[],"Formato",{"_3627":75201,"_31174":75174,"_21594":127824,"_5":14861,"_28366":127757,"_3078":58648},[],{"_3627":75202,"_31174":75174,"_21594":127826,"_5":14861,"_28366":127757,"_3078":58651},[],{"_3627":75203,"_31174":75174,"_21594":127828,"_5":14861,"_28366":127757,"_3078":127829},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3627":75204,"_31174":75174,"_21594":127831,"_5":14861,"_28366":127757,"_3078":58043},[],{"_3627":75205,"_31174":75174,"_21594":127833,"_5":14861,"_28366":127757,"_3078":58659},[],{"_3627":75206,"_31174":75174,"_21594":127835,"_5":14861,"_28366":127757,"_3078":127836},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3627":75207,"_31174":75174,"_21594":127838,"_5":14861,"_28366":127757,"_3078":127839},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3627":75208,"_31174":75174,"_21594":127841,"_5":14861,"_28366":127761,"_3078":127842},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3627":75209,"_31174":75174,"_21594":127844,"_5":14861,"_28366":127761,"_3078":127845},[],"Genera la solicitud:",{"_3627":75210,"_31174":75174,"_21594":127847,"_5":14861,"_28366":127761,"_3078":127848},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3627":75211,"_31174":75174,"_21594":127850,"_5":14861,"_28366":127761,"_3078":127851},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3627":75212,"_31174":75174,"_21594":127853,"_5":14861,"_28366":127761,"_3078":127854},[],"Verifica el DER recibido:",{"_3627":75213,"_31174":75174,"_21594":127856,"_5":14861,"_28366":127761,"_3078":127857},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3627":75214,"_31174":75174,"_21594":127859,"_5":14861,"_28366":127765,"_3078":127860},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3627":75215,"_31174":75174,"_21594":127862,"_5":14861,"_28366":127765,"_3078":127863},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3627":75216,"_31174":75174,"_21594":127865,"_5":14861,"_28366":127769,"_3078":58692},[],{"_3627":75217,"_31174":75174,"_21594":127867,"_5":14861,"_28366":127769,"_3078":58695},[],{"_3627":75218,"_31174":75174,"_21594":127869,"_5":14861,"_28366":127769,"_3078":127870},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3627":75219,"_31174":75174,"_21594":127872,"_5":14861,"_28366":127769,"_3078":127355},[],{"_3627":75220,"_31174":75220,"_5":15221,"_3078":56637,"_31533":127874,"_21594":127875,"_28366":75220},[50951,121820,56637],[],{"_3627":75221,"_31174":75220,"_21594":127877,"_5":14861,"_28366":75220,"_3078":127878},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3627":75222,"_31174":75220,"_5":31530,"_21594":127880,"_28366":127881,"_3078":125168},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#empieza-aquí",{"_3627":75223,"_31174":75220,"_5":31530,"_21594":127883,"_28366":127884,"_3078":127885},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3627":75224,"_31174":75220,"_5":31530,"_21594":127887,"_28366":127888,"_3078":125688},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#capacidades-principales",{"_3627":75225,"_31174":75220,"_5":31530,"_21594":127890,"_28366":127891,"_3078":125692},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3627":75226,"_31174":75220,"_5":31530,"_21594":127893,"_28366":127894,"_3078":125696},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3627":75227,"_31174":75220,"_5":31530,"_21594":127896,"_28366":127897,"_3078":125700},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#emite-y-controla-certificados",{"_3627":75228,"_31174":75220,"_5":31530,"_21594":127899,"_28366":127900,"_3078":125708},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#publica-el-estado-de-validación",{"_3627":75229,"_31174":75220,"_5":31530,"_21594":127902,"_28366":127903,"_3078":127904},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3627":75230,"_31174":75220,"_5":31530,"_21594":127906,"_28366":127907,"_3078":126663},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#continúa",{"_3627":75231,"_31174":75220,"_21594":127909,"_5":14861,"_28366":75220,"_3078":127910},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3627":75232,"_31174":75220,"_21594":127912,"_5":14861,"_28366":127881,"_3078":127913},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3627":75233,"_31174":75220,"_21594":127915,"_5":14861,"_28366":127881,"_3078":127916},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3627":75234,"_31174":75220,"_21594":127918,"_5":14861,"_28366":127884,"_3078":127919},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3627":75235,"_31174":75220,"_21594":127921,"_5":14861,"_28366":127884,"_3078":127922},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3627":75236,"_31174":75220,"_21594":127924,"_5":14861,"_28366":127884,"_3078":127925},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3627":75237,"_31174":75220,"_21594":127927,"_5":14861,"_28366":127884,"_3078":127928},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3627":75238,"_31174":75220,"_21594":127930,"_5":14861,"_28366":127884,"_3078":127931},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3627":75239,"_31174":75220,"_21594":127933,"_5":14861,"_28366":127891,"_3078":127934},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3627":75240,"_31174":75220,"_21594":127936,"_5":14861,"_28366":127894,"_3078":127937},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3627":75241,"_31174":75220,"_21594":127939,"_5":14861,"_28366":127897,"_3078":127940},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3627":75242,"_31174":75220,"_21594":127942,"_5":14861,"_28366":127900,"_3078":127943},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3627":75243,"_31174":75220,"_21594":127945,"_5":14861,"_28366":127903,"_3078":127946},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3627":75244,"_31174":75220,"_21594":127948,"_5":14861,"_28366":127903,"_3078":127949},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3627":75245,"_31174":75220,"_21594":127951,"_5":14861,"_28366":127903,"_3078":127952},[],"su clave pública corresponda a la clave privada del cliente;",{"_3627":75246,"_31174":75220,"_21594":127954,"_5":14861,"_28366":127903,"_3078":127955},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3627":75247,"_31174":75220,"_21594":127957,"_5":14861,"_28366":127903,"_3078":127958},[],"sus fechas y usos permitan la operación;",{"_3627":75248,"_31174":75220,"_21594":127960,"_5":14861,"_28366":127903,"_3078":127961},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3627":75249,"_31174":75220,"_21594":127963,"_5":14861,"_28366":127903,"_3078":127964},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3627":75250,"_31174":75220,"_21594":127966,"_5":14861,"_28366":127907,"_3078":127967},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3627":75251,"_31174":75220,"_21594":127969,"_5":14861,"_28366":127907,"_3078":127970},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3627":75252,"_31174":75220,"_21594":127972,"_5":14861,"_28366":127907,"_3078":127973},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3627":75253,"_31174":75253,"_5":15221,"_3078":127975,"_31533":127976,"_21594":127977,"_28366":75253},"Crea tu primera CA",[50951,121820,56637,125292],[],{"_3627":75254,"_31174":75253,"_21594":127979,"_5":14861,"_28366":75253,"_3078":127980},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3627":75255,"_31174":75253,"_5":31530,"_21594":127982,"_28366":127983,"_3078":120354},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3627":75256,"_31174":75253,"_5":31530,"_21594":127985,"_28366":127986,"_3078":127987},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3627":75257,"_31174":75253,"_5":31530,"_21594":127989,"_28366":127990,"_3078":127991},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3627":75258,"_31174":75253,"_5":31530,"_21594":127993,"_28366":127994,"_3078":127995},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3627":75259,"_31174":75253,"_5":31530,"_21594":127997,"_28366":127998,"_3078":127999},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3627":75260,"_31174":75253,"_5":31530,"_21594":128001,"_28366":128002,"_3078":128003},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3627":75261,"_31174":75253,"_5":31530,"_21594":128005,"_28366":128006,"_3078":128007},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3627":75262,"_31174":75253,"_5":31530,"_21594":128009,"_28366":128010,"_3078":125539},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3627":75263,"_31174":75253,"_5":31530,"_21594":128012,"_28366":128013,"_3078":120378},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3627":75264,"_31174":75253,"_21594":128015,"_5":14861,"_28366":75253,"_3078":128016},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3627":75265,"_31174":75253,"_21594":128018,"_5":14861,"_28366":127983,"_3078":128019},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3627":75266,"_31174":75253,"_21594":128021,"_5":14861,"_28366":127983,"_3078":128022},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3627":75267,"_31174":75253,"_21594":128024,"_5":14861,"_28366":127983,"_3078":128025},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3627":75268,"_31174":75253,"_21594":128027,"_5":14861,"_28366":127983,"_3078":128028},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3627":75269,"_31174":75253,"_21594":128030,"_5":14861,"_28366":127986,"_3078":128031},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3627":75270,"_31174":75253,"_21594":128033,"_5":14861,"_28366":127986,"_3078":128034},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3627":75271,"_31174":75253,"_21594":128036,"_5":14861,"_28366":127990,"_3078":128037},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3627":75272,"_31174":75253,"_21594":128039,"_5":14861,"_28366":127990,"_3078":128040},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3627":75273,"_31174":75253,"_21594":128042,"_5":14861,"_28366":127994,"_3078":128043},[],"Selecciona **Root CA** y completa:",{"_3627":75274,"_31174":75253,"_21594":128045,"_5":14861,"_28366":127994,"_3078":58874},[],{"_3627":75275,"_31174":75253,"_21594":128047,"_5":14861,"_28366":127994,"_3078":128048},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3627":75276,"_31174":75253,"_21594":128050,"_5":14861,"_28366":127994,"_3078":128051},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3627":75277,"_31174":75253,"_21594":128053,"_5":14861,"_28366":127994,"_3078":128054},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3627":75278,"_31174":75253,"_21594":128056,"_5":14861,"_28366":127994,"_3078":128057},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3627":75279,"_31174":75253,"_21594":128059,"_5":14861,"_28366":127998,"_3078":128060},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3627":75280,"_31174":75253,"_21594":128062,"_5":14861,"_28366":128002,"_3078":128063},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3627":75281,"_31174":75253,"_21594":128065,"_5":14861,"_28366":128002,"_3078":128066},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3627":75282,"_31174":75253,"_21594":128068,"_5":14861,"_28366":128006,"_3078":128069},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3627":75283,"_31174":75253,"_21594":128071,"_5":14861,"_28366":128006,"_3078":128072},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3627":75284,"_31174":75253,"_21594":128074,"_5":14861,"_28366":128006,"_3078":128075},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3627":75285,"_31174":75253,"_21594":128077,"_5":14861,"_28366":128010,"_3078":128078},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3627":75286,"_31174":75253,"_21594":128080,"_5":14861,"_28366":128010,"_3078":128081},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3627":75287,"_31174":75253,"_21594":128083,"_5":14861,"_28366":128010,"_3078":128084},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3627":75288,"_31174":75253,"_21594":128086,"_5":14861,"_28366":128010,"_3078":128087},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3627":75289,"_31174":75253,"_21594":128089,"_5":14861,"_28366":128013,"_3078":128090},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3627":75290,"_31174":75290,"_5":15221,"_3078":128092,"_31533":128093,"_21594":128094,"_28366":75290},"Emite y verifica un certificado",[50951,121820,56637,125292],[],{"_3627":75291,"_31174":75290,"_21594":128096,"_5":14861,"_28366":75290,"_3078":128097},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3627":75292,"_31174":75290,"_5":31530,"_21594":128099,"_28366":128100,"_3078":120354},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3627":75293,"_31174":75290,"_5":31530,"_21594":128102,"_28366":128103,"_3078":128104},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3627":75294,"_31174":75290,"_5":31530,"_21594":128106,"_28366":128107,"_3078":128108},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3627":75295,"_31174":75290,"_5":31530,"_21594":128110,"_28366":128111,"_3078":128112},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3627":75296,"_31174":75290,"_5":31530,"_21594":128114,"_28366":128115,"_3078":128116},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3627":75297,"_31174":75290,"_5":31530,"_21594":128118,"_28366":128119,"_3078":128120},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3627":75298,"_31174":75290,"_5":31530,"_21594":128122,"_28366":128123,"_3078":128124},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3627":75299,"_31174":75290,"_5":31530,"_21594":128126,"_28366":128127,"_3078":128128},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3627":75300,"_31174":75290,"_5":31530,"_21594":128130,"_28366":128131,"_3078":128132},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3627":75301,"_31174":75290,"_5":31530,"_21594":128134,"_28366":128135,"_3078":128136},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3627":75302,"_31174":75290,"_5":31530,"_21594":128138,"_28366":128139,"_3078":125539},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3627":75303,"_31174":75290,"_5":31530,"_21594":128141,"_28366":128142,"_3078":120378},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3627":75304,"_31174":75290,"_21594":128144,"_5":14861,"_28366":75290,"_3078":128145},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3627":75305,"_31174":75290,"_21594":128147,"_5":14861,"_28366":128100,"_3078":128148},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3627":75306,"_31174":75290,"_21594":128150,"_5":14861,"_28366":128100,"_3078":128151},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3627":75307,"_31174":75290,"_21594":128153,"_5":14861,"_28366":128100,"_3078":128154},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3627":75308,"_31174":75290,"_21594":128156,"_5":14861,"_28366":128100,"_3078":128157},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3627":75309,"_31174":75290,"_21594":128159,"_5":14861,"_28366":128100,"_3078":128160},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3627":75310,"_31174":75290,"_21594":128162,"_5":14861,"_28366":128103,"_3078":128163},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3627":75311,"_31174":75290,"_21594":128165,"_5":14861,"_28366":128107,"_3078":128166},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3627":75312,"_31174":75290,"_21594":128168,"_5":14861,"_28366":128107,"_3078":128169},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3627":75313,"_31174":75290,"_21594":128171,"_5":14861,"_28366":128111,"_3078":128172},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3627":75314,"_31174":75290,"_21594":128174,"_5":14861,"_28366":128111,"_3078":128175},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3627":75315,"_31174":75290,"_21594":128177,"_5":14861,"_28366":128115,"_3078":128178},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3627":75316,"_31174":75290,"_21594":128180,"_5":14861,"_28366":128115,"_3078":128181},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3627":75317,"_31174":75290,"_21594":128183,"_5":14861,"_28366":128119,"_3078":128184},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3627":75318,"_31174":75290,"_21594":128186,"_5":14861,"_28366":128123,"_3078":128187},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3627":75319,"_31174":75290,"_21594":128189,"_5":14861,"_28366":128127,"_3078":128190},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3627":75320,"_31174":75290,"_21594":128192,"_5":14861,"_28366":128131,"_3078":128193},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3627":75321,"_31174":75290,"_21594":128195,"_5":14861,"_28366":128131,"_3078":128196},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3627":75322,"_31174":75290,"_21594":128198,"_5":14861,"_28366":128131,"_3078":128199},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3627":75323,"_31174":75290,"_21594":128201,"_5":14861,"_28366":128135,"_3078":128202},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3627":75324,"_31174":75290,"_21594":128204,"_5":14861,"_28366":128135,"_3078":128205},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3627":75325,"_31174":75290,"_21594":128207,"_5":14861,"_28366":128135,"_3078":128208},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3627":75326,"_31174":75290,"_21594":128210,"_5":14861,"_28366":128139,"_3078":125622},[],{"_3627":75327,"_31174":75290,"_21594":128212,"_5":14861,"_28366":128139,"_3078":124137},[],{"_3627":75328,"_31174":75290,"_21594":128214,"_5":14861,"_28366":128139,"_3078":128215},[],"La CA rechaza la emisión",{"_3627":75329,"_31174":75290,"_21594":128217,"_5":14861,"_28366":128139,"_3078":128218},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3627":75330,"_31174":75290,"_21594":128220,"_5":14861,"_28366":128139,"_3078":128221},[],"Sujeto o usos diferentes",{"_3627":75331,"_31174":75290,"_21594":128223,"_5":14861,"_28366":128139,"_3078":128224},[],"Perfil aplicado y valores solicitados.",{"_3627":75332,"_31174":75290,"_21594":128226,"_5":14861,"_28366":128139,"_3078":128227},[],"No se encuentra el emisor",{"_3627":75333,"_31174":75290,"_21594":128229,"_5":14861,"_28366":128139,"_3078":128230},[],"CA descargada y cadena intermedia necesaria.",{"_3627":75334,"_31174":75290,"_21594":128232,"_5":14861,"_28366":128139,"_3078":128233},[],"Falla la vigencia",{"_3627":75335,"_31174":75290,"_21594":128235,"_5":14861,"_28366":128139,"_3078":128236},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3627":75336,"_31174":75290,"_21594":128238,"_5":14861,"_28366":128139,"_3078":128239},[],"Los resúmenes de clave difieren",{"_3627":75337,"_31174":75290,"_21594":128241,"_5":14861,"_28366":128139,"_3078":128242},[],"Archivos de certificado y clave de la misma emisión.",{"_3627":75338,"_31174":75290,"_21594":128244,"_5":14861,"_28366":128139,"_3078":128245},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3627":75339,"_31174":75290,"_21594":128247,"_5":14861,"_28366":128142,"_3078":128248},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3627":75340,"_31174":75290,"_21594":128250,"_5":14861,"_28366":128142,"_3078":128251},[],"Gestionar certificados para inspección, estado y revocación.",{"_3627":75341,"_31174":75290,"_21594":128253,"_5":14861,"_28366":128142,"_3078":128254},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3627":75342,"_31174":75290,"_21594":128256,"_5":14861,"_28366":128142,"_3078":128257},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3627":75343,"_31174":75290,"_21594":128259,"_5":14861,"_28366":128142,"_3078":128260},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3627":75344,"_31174":75344,"_5":15221,"_3078":128262,"_31533":128263,"_21594":128264,"_28366":75344},"Primeros pasos de PKI",[50951,121820,56637,125292],[],{"_3627":75345,"_31174":75344,"_21594":128266,"_5":14861,"_28366":75344,"_3078":128267},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3627":75346,"_31174":75344,"_5":31530,"_21594":128269,"_28366":128270,"_3078":120354},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3627":75347,"_31174":75344,"_5":31530,"_21594":128272,"_28366":128273,"_3078":128274},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3627":75348,"_31174":75344,"_5":31530,"_21594":128276,"_28366":128277,"_3078":125474},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3627":75349,"_31174":75344,"_5":31530,"_21594":128279,"_28366":128280,"_3078":128281},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3627":75350,"_31174":75344,"_21594":128283,"_5":14861,"_28366":75344,"_3078":128284},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3627":75351,"_31174":75344,"_21594":128286,"_5":14861,"_28366":128270,"_3078":128287},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3627":75352,"_31174":75344,"_21594":128289,"_5":14861,"_28366":128270,"_3078":128290},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3627":75353,"_31174":75344,"_21594":128292,"_5":14861,"_28366":128270,"_3078":128293},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3627":75354,"_31174":75344,"_21594":128295,"_5":14861,"_28366":128270,"_3078":128296},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3627":75355,"_31174":75344,"_21594":128298,"_5":14861,"_28366":128270,"_3078":128299},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3627":75356,"_31174":75344,"_21594":128301,"_5":14861,"_28366":128273,"_3078":128302},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3627":75357,"_31174":75344,"_21594":128304,"_5":14861,"_28366":128273,"_3078":128305},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3627":75358,"_31174":75344,"_21594":128307,"_5":14861,"_28366":128273,"_3078":128308},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3627":75359,"_31174":75344,"_21594":128310,"_5":14861,"_28366":128273,"_3078":128311},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3627":75360,"_31174":75344,"_21594":128313,"_5":14861,"_28366":128277,"_3078":128314},[],"Archivo o recurso",{"_3627":75361,"_31174":75344,"_21594":128316,"_5":14861,"_28366":128277,"_3078":125471},[],{"_3627":75362,"_31174":75344,"_21594":128318,"_5":14861,"_28366":128277,"_3078":128319},[],"CA raíz activa y `ca.pem`",{"_3627":75363,"_31174":75344,"_21594":128321,"_5":14861,"_28366":128277,"_3078":128322},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3627":75364,"_31174":75344,"_21594":128324,"_5":14861,"_28366":128277,"_3078":128325},[],"Certificado final y `device.crt`",{"_3627":75365,"_31174":75344,"_21594":128327,"_5":14861,"_28366":128277,"_3078":128328},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3627":75366,"_31174":75344,"_21594":128330,"_5":14861,"_28366":128277,"_3078":128331},[],"Clave privada `device.key`",{"_3627":75367,"_31174":75344,"_21594":128333,"_5":14861,"_28366":128277,"_3078":128334},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3627":75368,"_31174":75344,"_21594":128336,"_5":14861,"_28366":128277,"_3078":128337},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3627":75369,"_31174":75344,"_21594":128339,"_5":14861,"_28366":128280,"_3078":128340},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3627":75370,"_31174":75344,"_21594":128342,"_5":14861,"_28366":128280,"_3078":128343},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3627":75371,"_31174":75344,"_21594":128345,"_5":14861,"_28366":128280,"_3078":128346},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3627":75372,"_31174":75372,"_5":15221,"_3078":128348,"_31533":128349,"_21594":128351,"_28366":75372},"Resolución de problemas PKI",[50951,121820,56637,128350],"Resolución de problemas",[],{"_3627":75373,"_31174":75372,"_21594":128353,"_5":14861,"_28366":75372,"_3078":128354},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3627":75374,"_31174":75372,"_5":31530,"_21594":128356,"_28366":128357,"_3078":128358},[],"/docs/pr-preview/pr-75/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3627":75375,"_31174":75372,"_5":31530,"_21594":128360,"_28366":128361,"_3078":128362},[],"/docs/pr-preview/pr-75/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3627":75376,"_31174":75372,"_5":31530,"_21594":128364,"_28366":128365,"_3078":128366},[],"/docs/pr-preview/pr-75/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3627":75377,"_31174":75372,"_21594":128368,"_5":14861,"_28366":75372,"_3078":128369},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3627":75378,"_31174":75372,"_21594":128371,"_5":14861,"_28366":75372,"_3078":128372},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3627":75379,"_31174":75372,"_21594":128374,"_5":14861,"_28366":128357,"_3078":125471},[],{"_3627":75380,"_31174":75372,"_21594":128376,"_5":14861,"_28366":128357,"_3078":124137},[],{"_3627":75381,"_31174":75372,"_21594":128378,"_5":14861,"_28366":128357,"_3078":120378},[],{"_3627":75382,"_31174":75372,"_21594":128380,"_5":14861,"_28366":128357,"_3078":55479},[],{"_3627":75383,"_31174":75372,"_21594":128382,"_5":14861,"_28366":128357,"_3078":128383},[],"Existe, está activa y sus fechas son utilizables.",{"_3627":75384,"_31174":75372,"_21594":128385,"_5":14861,"_28366":128357,"_3078":128386},[],"Autoridades.",{"_3627":75385,"_31174":75372,"_21594":128388,"_5":14861,"_28366":128357,"_3078":128389},[],"Clave",{"_3627":75386,"_31174":75372,"_21594":128391,"_5":14861,"_28366":128357,"_3078":128392},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3627":75387,"_31174":75372,"_21594":128394,"_5":14861,"_28366":128357,"_3078":128395},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3627":75388,"_31174":75372,"_21594":128397,"_5":14861,"_28366":128357,"_3078":59228},[],{"_3627":75389,"_31174":75372,"_21594":128399,"_5":14861,"_28366":128357,"_3078":128400},[],"PEM correcto y firma verificable.",{"_3627":75390,"_31174":75372,"_21594":128402,"_5":14861,"_28366":128357,"_3078":59234},[],{"_3627":75391,"_31174":75372,"_21594":128404,"_5":14861,"_28366":128357,"_3078":128405},[],"Perfil",{"_3627":75392,"_31174":75372,"_21594":128407,"_5":14861,"_28366":128357,"_3078":128408},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3627":75393,"_31174":75372,"_21594":128410,"_5":14861,"_28366":128357,"_3078":128411},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3627":75394,"_31174":75372,"_21594":128413,"_5":14861,"_28366":128357,"_3078":125622},[],{"_3627":75395,"_31174":75372,"_21594":128415,"_5":14861,"_28366":128357,"_3078":128416},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3627":75396,"_31174":75372,"_21594":128418,"_5":14861,"_28366":128357,"_3078":128419},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3627":75397,"_31174":75372,"_21594":128421,"_5":14861,"_28366":128357,"_3078":128422},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3627":75398,"_31174":75372,"_21594":128424,"_5":14861,"_28366":128357,"_3078":128425},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3627":75399,"_31174":75372,"_21594":128427,"_5":14861,"_28366":128357,"_3078":128428},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3627":75400,"_31174":75372,"_21594":128430,"_5":14861,"_28366":128361,"_3078":128431},[],"Revisa cada frontera por separado:",{"_3627":75401,"_31174":75372,"_21594":128433,"_5":14861,"_28366":128361,"_3078":128434},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3627":75402,"_31174":75372,"_21594":128436,"_5":14861,"_28366":128361,"_3078":128437},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3627":75403,"_31174":75372,"_21594":128439,"_5":14861,"_28366":128361,"_3078":128440},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3627":75404,"_31174":75372,"_21594":128442,"_5":14861,"_28366":128361,"_3078":128443},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3627":75405,"_31174":75372,"_21594":128445,"_5":14861,"_28366":128361,"_3078":128446},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3627":75406,"_31174":75372,"_21594":128448,"_5":14861,"_28366":128361,"_3078":128449},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3627":75407,"_31174":75372,"_21594":128451,"_5":14861,"_28366":128365,"_3078":128452},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3627":75408,"_31174":75372,"_21594":128454,"_5":14861,"_28366":128365,"_3078":128455},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3627":75409,"_31174":75409,"_5":15221,"_3078":128457,"_31533":128458,"_21594":128459,"_28366":75409},"Seguridad",[50951],[],{"_3627":75410,"_31174":75409,"_21594":128461,"_5":14861,"_28366":75409,"_3078":128462},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3627":75411,"_31174":75409,"_5":31530,"_21594":128464,"_28366":128465,"_3078":128466},[],"/docs/pr-preview/pr-75/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3627":75412,"_31174":75409,"_5":31530,"_21594":128468,"_28366":128469,"_3078":128470},[],"/docs/pr-preview/pr-75/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3627":75413,"_31174":75409,"_5":31530,"_21594":128472,"_28366":128473,"_3078":128474},[],"/docs/pr-preview/pr-75/es/security#versiones-soportadas","Versiones soportadas",{"_3627":75414,"_31174":75409,"_5":31530,"_21594":128476,"_28366":128477,"_3078":128478},[],"/docs/pr-preview/pr-75/es/security#divulgación-responsable","Divulgación responsable",{"_3627":75415,"_31174":75409,"_21594":128480,"_5":14861,"_28366":75409,"_3078":128481},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3627":75416,"_31174":75409,"_21594":128483,"_5":14861,"_28366":128465,"_3078":128484},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3627":75417,"_31174":75409,"_21594":128486,"_5":14861,"_28366":128465,"_3078":128487},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3627":75418,"_31174":75409,"_21594":128489,"_5":14861,"_28366":128465,"_3078":15500},[],{"_3627":75419,"_31174":75409,"_21594":128491,"_5":14861,"_28366":128465,"_3078":15429},[],{"_3627":75420,"_31174":75409,"_21594":128493,"_5":14861,"_28366":128465,"_3078":15487},[],{"_3627":75421,"_31174":75409,"_21594":128495,"_5":14861,"_28366":128465,"_3078":128496},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3627":75422,"_31174":75409,"_21594":128498,"_5":14861,"_28366":128465,"_3078":128499},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3627":75423,"_31174":75409,"_21594":128501,"_5":14861,"_28366":128469,"_3078":128502},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3627":75424,"_31174":75409,"_21594":128504,"_5":14861,"_28366":128469,"_3078":128505},[],"No incluyas en el reporte:",{"_3627":75425,"_31174":75409,"_21594":128507,"_5":14861,"_28366":128469,"_3078":128508},[],"Credenciales, tokens o claves privadas",{"_3627":75426,"_31174":75409,"_21594":128510,"_5":14861,"_28366":128469,"_3078":128511},[],"Datos de clientes o información identificable de clientes",{"_3627":75427,"_31174":75409,"_21594":128513,"_5":14861,"_28366":128469,"_3078":128514},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3627":75428,"_31174":75409,"_21594":128516,"_5":14861,"_28366":128473,"_3078":128517},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3627":75429,"_31174":75409,"_21594":128519,"_5":14861,"_28366":128473,"_3078":128520},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3627":75430,"_31174":75409,"_21594":128522,"_5":14861,"_28366":128477,"_3078":128523},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3627":75431,"_31174":75409,"_21594":128525,"_5":14861,"_28366":128477,"_3078":128526},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3627":75432,"_31174":75409,"_21594":128528,"_5":14861,"_28366":128477,"_3078":128529},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3627":75433,"_31174":75409,"_21594":128531,"_5":14861,"_28366":128477,"_3078":128532},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3627":75434,"_31174":75409,"_21594":128534,"_5":14861,"_28366":128477,"_3078":128535},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3627":75435,"_31174":75435,"_5":15221,"_3078":128537,"_31533":128538,"_21594":128540,"_28366":75435},"3.8.0 a 4.0.0",[50951,128539],"Actualizaciones",[],{"_3627":75436,"_31174":75435,"_21594":128542,"_5":14861,"_28366":75435,"_3078":128543},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3627":75437,"_31174":75435,"_5":31530,"_21594":128545,"_28366":128546,"_3078":128547},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3627":75438,"_31174":75435,"_5":31530,"_21594":128549,"_28366":128550,"_3078":128551},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3627":75439,"_31174":75435,"_5":31530,"_21594":128553,"_28366":128554,"_3078":128555},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3627":75440,"_31174":75435,"_5":31530,"_21594":128557,"_28366":128558,"_3078":128559},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3627":75441,"_31174":75435,"_5":31530,"_21594":128561,"_28366":128562,"_3078":128563},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3627":75442,"_31174":75435,"_5":31530,"_21594":128565,"_28366":128566,"_3078":128567},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3627":75443,"_31174":75435,"_5":31530,"_21594":128569,"_28366":128570,"_3078":59403},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3627":75444,"_31174":75435,"_5":31530,"_21594":128572,"_28366":128573,"_3078":128574},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3627":75445,"_31174":75435,"_5":31530,"_21594":128576,"_28366":128577,"_3078":128578},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3627":75446,"_31174":75435,"_5":31530,"_21594":128580,"_28366":128581,"_3078":128582},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3627":75447,"_31174":75435,"_5":31530,"_21594":128584,"_28366":128585,"_3078":120949},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3627":75448,"_31174":75435,"_5":31530,"_21594":128587,"_28366":128588,"_3078":128589},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3627":75449,"_31174":75435,"_5":31530,"_21594":128591,"_28366":128592,"_3078":128593},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3627":75450,"_31174":75435,"_5":31530,"_21594":128595,"_28366":128596,"_3078":128597},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3627":75451,"_31174":75435,"_5":31530,"_21594":128599,"_28366":128600,"_3078":128601},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3627":75452,"_31174":75435,"_5":31530,"_21594":128603,"_28366":128604,"_3078":128605},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3627":75453,"_31174":75435,"_5":31530,"_21594":128607,"_28366":128608,"_3078":128609},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3627":75454,"_31174":75435,"_5":31530,"_21594":128611,"_28366":128612,"_3078":128613},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3627":75455,"_31174":75435,"_5":31530,"_21594":128615,"_28366":128616,"_3078":128617},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3627":75456,"_31174":75435,"_5":31530,"_21594":128619,"_28366":128620,"_3078":128621},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3627":75457,"_31174":75435,"_5":31530,"_21594":128623,"_28366":128624,"_3078":128625},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3627":75458,"_31174":75435,"_5":31530,"_21594":128627,"_28366":128628,"_3078":128629},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3627":75459,"_31174":75435,"_5":31530,"_21594":128631,"_28366":128632,"_3078":128633},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3627":75460,"_31174":75435,"_5":31530,"_21594":128635,"_28366":128636,"_3078":128637},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3627":75461,"_31174":75435,"_5":31530,"_21594":128639,"_28366":128640,"_3078":128641},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3627":75462,"_31174":75435,"_5":31530,"_21594":128643,"_28366":128644,"_3078":128645},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3627":75463,"_31174":75435,"_5":31530,"_21594":128647,"_28366":128648,"_3078":128649},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3627":75464,"_31174":75435,"_5":31530,"_21594":128651,"_28366":128652,"_3078":128653},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3627":75465,"_31174":75435,"_5":31530,"_21594":128655,"_28366":128656,"_3078":128657},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3627":75466,"_31174":75435,"_5":31530,"_21594":128659,"_28366":128660,"_3078":128661},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3627":75467,"_31174":75435,"_5":31530,"_21594":128663,"_28366":128664,"_3078":128665},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3627":75468,"_31174":75435,"_5":31530,"_21594":128667,"_28366":128668,"_3078":128669},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3627":75469,"_31174":75435,"_5":31530,"_21594":128671,"_28366":128672,"_3078":128673},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3627":75470,"_31174":75435,"_5":31530,"_21594":128675,"_28366":128676,"_3078":128677},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3627":75471,"_31174":75435,"_5":31530,"_21594":128679,"_28366":128680,"_3078":128681},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3627":75472,"_31174":75435,"_5":31530,"_21594":128683,"_28366":128684,"_3078":128685},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3627":75473,"_31174":75435,"_5":31530,"_21594":128687,"_28366":128688,"_3078":128689},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3627":75474,"_31174":75435,"_5":31530,"_21594":128691,"_28366":128692,"_3078":128693},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3627":75475,"_31174":75435,"_5":31530,"_21594":128695,"_28366":128696,"_3078":128697},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3627":75476,"_31174":75435,"_5":31530,"_21594":128699,"_28366":128700,"_3078":128701},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3627":75477,"_31174":75435,"_5":31530,"_21594":128703,"_28366":128704,"_3078":128705},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3627":75478,"_31174":75435,"_5":31530,"_21594":128707,"_28366":128708,"_3078":128709},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3627":75479,"_31174":75435,"_5":31530,"_21594":128711,"_28366":128712,"_3078":128713},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3627":75480,"_31174":75435,"_5":31530,"_21594":128715,"_28366":128716,"_3078":128717},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3627":75481,"_31174":75435,"_5":31530,"_21594":128719,"_28366":128720,"_3078":124485},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3627":75482,"_31174":75435,"_5":31530,"_21594":128722,"_28366":128723,"_3078":128724},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3627":75483,"_31174":75435,"_5":31530,"_21594":128726,"_28366":128727,"_3078":128728},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3627":75484,"_31174":75435,"_21594":128730,"_5":14861,"_28366":75435,"_3078":128731},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3627":75485,"_31174":75435,"_21594":128733,"_5":14861,"_28366":75435,"_3078":128734},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3627":75486,"_31174":75435,"_21594":128736,"_5":14861,"_28366":75435,"_3078":128737},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3627":75487,"_31174":75435,"_21594":128739,"_5":14861,"_28366":75435,"_3078":128740},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3627":75488,"_31174":75435,"_21594":128742,"_5":14861,"_28366":75435,"_3078":128743},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3627":75489,"_31174":75435,"_21594":128745,"_5":14861,"_28366":75435,"_3078":128746},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3627":75490,"_31174":75435,"_21594":128748,"_5":14861,"_28366":75435,"_3078":128749},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3627":75491,"_31174":75435,"_21594":128751,"_5":14861,"_28366":128550,"_3078":128752},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3627":75492,"_31174":75435,"_21594":128754,"_5":14861,"_28366":128550,"_3078":128755},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3627":75493,"_31174":75435,"_21594":128757,"_5":14861,"_28366":128554,"_3078":128758},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3627":75494,"_31174":75435,"_21594":128760,"_5":14861,"_28366":128554,"_3078":128761},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3627":75495,"_31174":75435,"_21594":128763,"_5":14861,"_28366":128558,"_3078":128764},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3627":75496,"_31174":75435,"_21594":128766,"_5":14861,"_28366":128562,"_3078":128767},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3627":75497,"_31174":75435,"_21594":128769,"_5":14861,"_28366":128562,"_3078":128770},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3627":75498,"_31174":75435,"_21594":128772,"_5":14861,"_28366":128562,"_3078":128773},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3627":75499,"_31174":75435,"_21594":128775,"_5":14861,"_28366":128562,"_3078":128776},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3627":75500,"_31174":75435,"_21594":128778,"_5":14861,"_28366":128562,"_3078":128779},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3627":75501,"_31174":75435,"_21594":128781,"_5":14861,"_28366":128566,"_3078":128782},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3627":75502,"_31174":75435,"_21594":128784,"_5":14861,"_28366":128566,"_3078":128785},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3627":75503,"_31174":75435,"_21594":128787,"_5":14861,"_28366":128566,"_3078":128788},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3627":75504,"_31174":75435,"_21594":128790,"_5":14861,"_28366":128566,"_3078":128791},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3627":75505,"_31174":75435,"_21594":128793,"_5":14861,"_28366":128566,"_3078":128794},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3627":75506,"_31174":75435,"_21594":128796,"_5":14861,"_28366":128566,"_3078":128797},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3627":75507,"_31174":75435,"_21594":128799,"_5":14861,"_28366":128570,"_3078":128800},[],"Cambio",{"_3627":75508,"_31174":75435,"_21594":128802,"_5":14861,"_28366":128570,"_3078":128803},[],"A quién afecta",{"_3627":75509,"_31174":75435,"_21594":128805,"_5":14861,"_28366":128570,"_3078":128806},[],"Gravedad",{"_3627":75510,"_31174":75435,"_21594":128808,"_5":14861,"_28366":128570,"_3078":127279},[],{"_3627":75511,"_31174":75435,"_21594":128810,"_5":14861,"_28366":128570,"_3078":128578},[],{"_3627":75512,"_31174":75435,"_21594":128812,"_5":14861,"_28366":128570,"_3078":128813},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3627":75513,"_31174":75435,"_21594":128815,"_5":14861,"_28366":128570,"_3078":128816},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3627":75514,"_31174":75435,"_21594":128818,"_5":14861,"_28366":128570,"_3078":128819},[],"Copiar los datos a los volúmenes nuevos",{"_3627":75515,"_31174":75435,"_21594":128821,"_5":14861,"_28366":128570,"_3078":128582},[],{"_3627":75516,"_31174":75435,"_21594":128823,"_5":14861,"_28366":128570,"_3078":128824},[],"Todas las releases de Helm",{"_3627":75517,"_31174":75435,"_21594":128826,"_5":14861,"_28366":128570,"_3078":128827},[],"Alta: `helm upgrade` falla",{"_3627":75518,"_31174":75435,"_21594":128829,"_5":14861,"_28366":128570,"_3078":128830},[],"Eliminar o renombrar las claves heredadas",{"_3627":75519,"_31174":75435,"_21594":128832,"_5":14861,"_28366":128570,"_3078":120949},[],{"_3627":75520,"_31174":75435,"_21594":128834,"_5":14861,"_28366":128570,"_3078":128824},[],{"_3627":75521,"_31174":75435,"_21594":128836,"_5":14861,"_28366":128570,"_3078":128837},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3627":75522,"_31174":75435,"_21594":128839,"_5":14861,"_28366":128570,"_3078":128840},[],"Crear primero los Secrets; consulta el paso 2",{"_3627":75523,"_31174":75435,"_21594":128842,"_5":14861,"_28366":128570,"_3078":128589},[],{"_3627":75524,"_31174":75435,"_21594":128844,"_5":14861,"_28366":128570,"_3078":128845},[],"Todos los despliegues",{"_3627":75525,"_31174":75435,"_21594":128847,"_5":14861,"_28366":128570,"_3078":128848},[],"Alta: sin principal de bootstrap no hay administrador",{"_3627":75526,"_31174":75435,"_21594":128850,"_5":14861,"_28366":128570,"_3078":128851},[],"Configurar `services.authz`",{"_3627":75527,"_31174":75435,"_21594":128853,"_5":14861,"_28366":128570,"_3078":128593},[],{"_3627":75528,"_31174":75435,"_21594":128855,"_5":14861,"_28366":128570,"_3078":128824},[],{"_3627":75529,"_31174":75435,"_21594":128857,"_5":14861,"_28366":128570,"_3078":128858},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3627":75530,"_31174":75435,"_21594":128860,"_5":14861,"_28366":128570,"_3078":128861},[],"Mover JWKS y roles a `services.authz`",{"_3627":75531,"_31174":75435,"_21594":128863,"_5":14861,"_28366":128570,"_3078":128613},[],{"_3627":75532,"_31174":75435,"_21594":128865,"_5":14861,"_28366":128570,"_3078":128866},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3627":75533,"_31174":75435,"_21594":128868,"_5":14861,"_28366":128570,"_3078":128869},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3627":75534,"_31174":75435,"_21594":128871,"_5":14861,"_28366":128570,"_3078":128872},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3627":75535,"_31174":75435,"_21594":128874,"_5":14861,"_28366":128570,"_3078":128617},[],{"_3627":75536,"_31174":75435,"_21594":128876,"_5":14861,"_28366":128570,"_3078":128877},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3627":75537,"_31174":75435,"_21594":128879,"_5":14861,"_28366":128570,"_3078":128880},[],"Alta: el backend ya no arranca con ellos",{"_3627":75538,"_31174":75435,"_21594":128882,"_5":14861,"_28366":128570,"_3078":128883},[],"Pasar a PostgreSQL antes de actualizar",{"_3627":75539,"_31174":75435,"_21594":128885,"_5":14861,"_28366":128570,"_3078":128665},[],{"_3627":75540,"_31174":75435,"_21594":128887,"_5":14861,"_28366":128570,"_3078":128888},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3627":75541,"_31174":75435,"_21594":128890,"_5":14861,"_28366":128570,"_3078":128891},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3627":75542,"_31174":75435,"_21594":128893,"_5":14861,"_28366":128570,"_3078":128894},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3627":75543,"_31174":75435,"_21594":128896,"_5":14861,"_28366":128570,"_3078":128897},[],"Webhooks con referencias a archivos",{"_3627":75544,"_31174":75435,"_21594":128899,"_5":14861,"_28366":128570,"_3078":128900},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3627":75545,"_31174":75435,"_21594":128902,"_5":14861,"_28366":128570,"_3078":128903},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3627":75546,"_31174":75435,"_21594":128905,"_5":14861,"_28366":128570,"_3078":128906},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3627":75547,"_31174":75435,"_21594":128908,"_5":14861,"_28366":128570,"_3078":128597},[],{"_3627":75548,"_31174":75435,"_21594":128910,"_5":14861,"_28366":128570,"_3078":128911},[],"Releases con identidades por servicio o material de claves montado",{"_3627":75549,"_31174":75435,"_21594":128913,"_5":14861,"_28366":128570,"_3078":128914},[],"Media: los servicios no pueden leer sus archivos",{"_3627":75550,"_31174":75435,"_21594":128916,"_5":14861,"_28366":128570,"_3078":128917},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3627":75551,"_31174":75435,"_21594":128919,"_5":14861,"_28366":128570,"_3078":128601},[],{"_3627":75552,"_31174":75435,"_21594":128921,"_5":14861,"_28366":128570,"_3078":128922},[],"Releases que definen `amqp.tls`",{"_3627":75553,"_31174":75435,"_21594":128924,"_5":14861,"_28366":128570,"_3078":128925},[],"Media: los clientes se conectan al puerto equivocado",{"_3627":75554,"_31174":75435,"_21594":128927,"_5":14861,"_28366":128570,"_3078":128928},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3627":75555,"_31174":75435,"_21594":128930,"_5":14861,"_28366":128570,"_3078":128621},[],{"_3627":75556,"_31174":75435,"_21594":128932,"_5":14861,"_28366":128570,"_3078":128933},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3627":75557,"_31174":75435,"_21594":128935,"_5":14861,"_28366":128570,"_3078":128936},[],"Media: las claves de CA quedan sin gestionar",{"_3627":75558,"_31174":75435,"_21594":128938,"_5":14861,"_28366":128570,"_3078":128939},[],"Ejecutar la migración de CA a KMS",{"_3627":75559,"_31174":75435,"_21594":128941,"_5":14861,"_28366":128570,"_3078":128942},[],"Verificación del certificado del receptor",{"_3627":75560,"_31174":75435,"_21594":128944,"_5":14861,"_28366":128570,"_3078":128945},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3627":75561,"_31174":75435,"_21594":128947,"_5":14861,"_28366":128570,"_3078":128948},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3627":75562,"_31174":75435,"_21594":128950,"_5":14861,"_28366":128570,"_3078":128951},[],"Poner `insecure_skip_verify` a `false`",{"_3627":75563,"_31174":75435,"_21594":128953,"_5":14861,"_28366":128570,"_3078":128637},[],{"_3627":75564,"_31174":75435,"_21594":128955,"_5":14861,"_28366":128570,"_3078":128956},[],"Scripts y consolas que editan DMS por API",{"_3627":75565,"_31174":75435,"_21594":128958,"_5":14861,"_28366":128570,"_3078":128959},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3627":75566,"_31174":75435,"_21594":128961,"_5":14861,"_28366":128570,"_3078":128962},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3627":75567,"_31174":75435,"_21594":128964,"_5":14861,"_28366":128570,"_3078":128641},[],{"_3627":75568,"_31174":75435,"_21594":128966,"_5":14861,"_28366":128570,"_3078":128967},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3627":75569,"_31174":75435,"_21594":128969,"_5":14861,"_28366":128570,"_3078":128970},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3627":75570,"_31174":75435,"_21594":128972,"_5":14861,"_28366":128570,"_3078":128973},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3627":75571,"_31174":75435,"_21594":128975,"_5":14861,"_28366":128570,"_3078":128661},[],{"_3627":75572,"_31174":75435,"_21594":128977,"_5":14861,"_28366":128570,"_3078":128978},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3627":75573,"_31174":75435,"_21594":128980,"_5":14861,"_28366":128570,"_3078":128981},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3627":75574,"_31174":75435,"_21594":128983,"_5":14861,"_28366":128570,"_3078":128984},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3627":75575,"_31174":75435,"_21594":128986,"_5":14861,"_28366":128570,"_3078":128669},[],{"_3627":75576,"_31174":75435,"_21594":128988,"_5":14861,"_28366":128570,"_3078":128989},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3627":75577,"_31174":75435,"_21594":128991,"_5":14861,"_28366":128570,"_3078":128992},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3627":75578,"_31174":75435,"_21594":128994,"_5":14861,"_28366":128570,"_3078":128995},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3627":75579,"_31174":75435,"_21594":128997,"_5":14861,"_28366":128570,"_3078":128673},[],{"_3627":75580,"_31174":75435,"_21594":128999,"_5":14861,"_28366":128570,"_3078":129000},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3627":75581,"_31174":75435,"_21594":129002,"_5":14861,"_28366":128570,"_3078":129003},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3627":75582,"_31174":75435,"_21594":129005,"_5":14861,"_28366":128570,"_3078":129006},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3627":75583,"_31174":75435,"_21594":129008,"_5":14861,"_28366":128570,"_3078":128657},[],{"_3627":75584,"_31174":75435,"_21594":129010,"_5":14861,"_28366":128570,"_3078":129011},[],"Consumidores que leen el campo `events` del dispositivo",{"_3627":75585,"_31174":75435,"_21594":129013,"_5":14861,"_28366":128570,"_3078":129014},[],"Media: el campo desaparece",{"_3627":75586,"_31174":75435,"_21594":129016,"_5":14861,"_28366":128570,"_3078":129017},[],"Usar los nuevos endpoints de eventos",{"_3627":75587,"_31174":75435,"_21594":129019,"_5":14861,"_28366":128570,"_3078":128685},[],{"_3627":75588,"_31174":75435,"_21594":129021,"_5":14861,"_28366":128570,"_3078":129022},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3627":75589,"_31174":75435,"_21594":129024,"_5":14861,"_28366":128570,"_3078":129025},[],"Media: la migración de la VA aborta",{"_3627":75590,"_31174":75435,"_21594":129027,"_5":14861,"_28366":128570,"_3078":129028},[],"Corregir los roles afectados antes de actualizar",{"_3627":75591,"_31174":75435,"_21594":129030,"_5":14861,"_28366":128570,"_3078":128605},[],{"_3627":75592,"_31174":75435,"_21594":129032,"_5":14861,"_28366":128570,"_3078":129033},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3627":75593,"_31174":75435,"_21594":129035,"_5":14861,"_28366":128570,"_3078":129036},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3627":75594,"_31174":75435,"_21594":129038,"_5":14861,"_28366":128570,"_3078":129039},[],"Actualizar el archivo de values",{"_3627":75595,"_31174":75435,"_21594":129041,"_5":14861,"_28366":128570,"_3078":128649},[],{"_3627":75596,"_31174":75435,"_21594":129043,"_5":14861,"_28366":128570,"_3078":129044},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3627":75597,"_31174":75435,"_21594":129046,"_5":14861,"_28366":128570,"_3078":129047},[],"Baja: prevalece el ID de la URL",{"_3627":75598,"_31174":75435,"_21594":129049,"_5":14861,"_28366":128570,"_3078":129050},[],"Enviar el ID en la URL",{"_3627":75599,"_31174":75435,"_21594":129052,"_5":14861,"_28366":128570,"_3078":128677},[],{"_3627":75600,"_31174":75435,"_21594":129054,"_5":14861,"_28366":128570,"_3078":129055},[],"Clientes que envían un `id` al crear o importar CAs",{"_3627":75601,"_31174":75435,"_21594":129057,"_5":14861,"_28366":128570,"_3078":129058},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3627":75602,"_31174":75435,"_21594":129060,"_5":14861,"_28366":128570,"_3078":129061},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3627":75603,"_31174":75435,"_21594":129063,"_5":14861,"_28366":128570,"_3078":128681},[],{"_3627":75604,"_31174":75435,"_21594":129065,"_5":14861,"_28366":128570,"_3078":129066},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3627":75605,"_31174":75435,"_21594":129068,"_5":14861,"_28366":128570,"_3078":129069},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3627":75606,"_31174":75435,"_21594":129071,"_5":14861,"_28366":128570,"_3078":129072},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3627":75607,"_31174":75435,"_21594":129074,"_5":14861,"_28366":128570,"_3078":128653},[],{"_3627":75608,"_31174":75435,"_21594":129076,"_5":14861,"_28366":128570,"_3078":129077},[],"Consumidores que comparan el `type` del certificado",{"_3627":75609,"_31174":75435,"_21594":129079,"_5":14861,"_28366":128570,"_3078":129080},[],"Baja: dos valores cambian de nombre",{"_3627":75610,"_31174":75435,"_21594":129082,"_5":14861,"_28366":128570,"_3078":129083},[],"Adaptar los consumidores",{"_3627":75611,"_31174":75435,"_21594":129085,"_5":14861,"_28366":128570,"_3078":128645},[],{"_3627":75612,"_31174":75435,"_21594":129087,"_5":14861,"_28366":128570,"_3078":129088},[],"Cualquier DMS",{"_3627":75613,"_31174":75435,"_21594":129090,"_5":14861,"_28366":128570,"_3078":129091},[],"Baja: solo informativo",{"_3627":75614,"_31174":75435,"_21594":129093,"_5":14861,"_28366":128570,"_3078":129094},[],"Revisar ambos bloques antes de editar",{"_3627":75615,"_31174":75435,"_21594":129096,"_5":14861,"_28366":128577,"_3078":129097},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3627":75616,"_31174":75435,"_21594":129099,"_5":14861,"_28366":128577,"_3078":129100},[],"El paso 4 de la guía de migración copia los datos.",{"_3627":75617,"_31174":75435,"_21594":129102,"_5":14861,"_28366":128581,"_3078":129103},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3627":75618,"_31174":75435,"_21594":129105,"_5":14861,"_28366":128585,"_3078":129106},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3627":75619,"_31174":75435,"_21594":129108,"_5":14861,"_28366":128585,"_3078":129109},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3627":75620,"_31174":75435,"_21594":129111,"_5":14861,"_28366":128588,"_3078":129112},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3627":75621,"_31174":75435,"_21594":129114,"_5":14861,"_28366":128592,"_3078":129115},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3627":75622,"_31174":75435,"_21594":129117,"_5":14861,"_28366":128596,"_3078":129118},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3627":75623,"_31174":75435,"_21594":129120,"_5":14861,"_28366":128596,"_3078":129121},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3627":75624,"_31174":75435,"_21594":129123,"_5":14861,"_28366":128596,"_3078":129124},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3627":75625,"_31174":75435,"_21594":129126,"_5":14861,"_28366":128600,"_3078":129127},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3627":75626,"_31174":75435,"_21594":129129,"_5":14861,"_28366":128604,"_3078":129130},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3627":75627,"_31174":75435,"_21594":129132,"_5":14861,"_28366":128604,"_3078":129133},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3627":75628,"_31174":75435,"_21594":129135,"_5":14861,"_28366":128604,"_3078":129136},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3627":75629,"_31174":75435,"_21594":129138,"_5":14861,"_28366":128604,"_3078":129139},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3627":75630,"_31174":75435,"_21594":129141,"_5":14861,"_28366":128604,"_3078":129142},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3627":75631,"_31174":75435,"_21594":129144,"_5":14861,"_28366":128604,"_3078":129145},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3627":75632,"_31174":75435,"_21594":129147,"_5":14861,"_28366":128612,"_3078":129148},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3627":75633,"_31174":75435,"_21594":129150,"_5":14861,"_28366":128612,"_3078":129151},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3627":75634,"_31174":75435,"_21594":129153,"_5":14861,"_28366":128612,"_3078":129154},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3627":75635,"_31174":75435,"_21594":129156,"_5":14861,"_28366":128612,"_3078":129157},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3627":75636,"_31174":75435,"_21594":129159,"_5":14861,"_28366":128612,"_3078":129160},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3627":75637,"_31174":75435,"_21594":129162,"_5":14861,"_28366":128616,"_3078":129163},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3627":75638,"_31174":75435,"_21594":129165,"_5":14861,"_28366":128620,"_3078":129166},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3627":75639,"_31174":75435,"_21594":129168,"_5":14861,"_28366":128620,"_3078":129169},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3627":75640,"_31174":75435,"_21594":129171,"_5":14861,"_28366":128620,"_3078":129172},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3627":75641,"_31174":75435,"_21594":129174,"_5":14861,"_28366":128620,"_3078":129175},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3627":75642,"_31174":75435,"_21594":129177,"_5":14861,"_28366":128620,"_3078":129178},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3627":75643,"_31174":75435,"_21594":129180,"_5":14861,"_28366":128620,"_3078":129181},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3627":75644,"_31174":75435,"_21594":129183,"_5":14861,"_28366":128620,"_3078":129184},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3627":75645,"_31174":75435,"_21594":129186,"_5":14861,"_28366":128620,"_3078":129187},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3627":75646,"_31174":75435,"_21594":129189,"_5":14861,"_28366":128624,"_3078":129190},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3627":75647,"_31174":75435,"_21594":129192,"_5":14861,"_28366":128632,"_3078":129193},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3627":75648,"_31174":75435,"_21594":129195,"_5":14861,"_28366":128632,"_3078":129196},[],"Campo en 3.8.0",{"_3627":75649,"_31174":75435,"_21594":129198,"_5":14861,"_28366":128632,"_3078":129199},[],"Campo en 4.0.0",{"_3627":75650,"_31174":75435,"_21594":129201,"_5":14861,"_28366":128632,"_3078":60034},[],{"_3627":75651,"_31174":75435,"_21594":129203,"_5":14861,"_28366":128632,"_3078":129204},[],"`insecure_skip_verify` (con el valor negado)",{"_3627":75652,"_31174":75435,"_21594":129206,"_5":14861,"_28366":128632,"_3078":60040},[],{"_3627":75653,"_31174":75435,"_21594":129208,"_5":14861,"_28366":128632,"_3078":60043},[],{"_3627":75654,"_31174":75435,"_21594":129210,"_5":14861,"_28366":128632,"_3078":60046},[],{"_3627":75655,"_31174":75435,"_21594":129212,"_5":14861,"_28366":128632,"_3078":60049},[],{"_3627":75656,"_31174":75435,"_21594":129214,"_5":14861,"_28366":128632,"_3078":60052},[],{"_3627":75657,"_31174":75435,"_21594":129216,"_5":14861,"_28366":128632,"_3078":60055},[],{"_3627":75658,"_31174":75435,"_21594":129218,"_5":14861,"_28366":128632,"_3078":129219},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3627":75659,"_31174":75435,"_21594":129221,"_5":14861,"_28366":128632,"_3078":129222},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3627":75660,"_31174":75435,"_21594":129224,"_5":14861,"_28366":128632,"_3078":129225},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3627":75661,"_31174":75435,"_21594":129227,"_5":14861,"_28366":128636,"_3078":129228},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3627":75662,"_31174":75435,"_21594":129230,"_5":14861,"_28366":128636,"_3078":129231},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3627":75663,"_31174":75435,"_21594":129233,"_5":14861,"_28366":128636,"_3078":129234},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3627":75664,"_31174":75435,"_21594":129236,"_5":14861,"_28366":128640,"_3078":129237},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3627":75665,"_31174":75435,"_21594":129239,"_5":14861,"_28366":128640,"_3078":129240},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3627":75666,"_31174":75435,"_21594":129242,"_5":14861,"_28366":128644,"_3078":129243},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3627":75667,"_31174":75435,"_21594":129245,"_5":14861,"_28366":128648,"_3078":129246},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3627":75668,"_31174":75435,"_21594":129248,"_5":14861,"_28366":128652,"_3078":129249},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3627":75669,"_31174":75435,"_21594":129251,"_5":14861,"_28366":128656,"_3078":129252},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3627":75670,"_31174":75435,"_21594":129254,"_5":14861,"_28366":128656,"_3078":129255},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3627":75671,"_31174":75435,"_21594":129257,"_5":14861,"_28366":128656,"_3078":129258},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3627":75672,"_31174":75435,"_21594":129260,"_5":14861,"_28366":128656,"_3078":129261},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3627":75673,"_31174":75435,"_21594":129263,"_5":14861,"_28366":128660,"_3078":129264},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3627":75674,"_31174":75435,"_21594":129266,"_5":14861,"_28366":128664,"_3078":129267},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3627":75675,"_31174":75435,"_21594":129269,"_5":14861,"_28366":128664,"_3078":129270},[],"Ruta",{"_3627":75676,"_31174":75435,"_21594":129272,"_5":14861,"_28366":128664,"_3078":121580},[],{"_3627":75677,"_31174":75435,"_21594":129274,"_5":14861,"_28366":128664,"_3078":60114},[],{"_3627":75678,"_31174":75435,"_21594":129276,"_5":14861,"_28366":128664,"_3078":129277},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3627":75679,"_31174":75435,"_21594":129279,"_5":14861,"_28366":128664,"_3078":60120},[],{"_3627":75680,"_31174":75435,"_21594":129281,"_5":14861,"_28366":128664,"_3078":129282},[],"Lee los ajustes de una CA.",{"_3627":75681,"_31174":75435,"_21594":129284,"_5":14861,"_28366":128664,"_3078":60126},[],{"_3627":75682,"_31174":75435,"_21594":129286,"_5":14861,"_28366":128664,"_3078":129287},[],"Sustituye los `crl_options`.",{"_3627":75683,"_31174":75435,"_21594":129289,"_5":14861,"_28366":128664,"_3078":60132},[],{"_3627":75684,"_31174":75435,"_21594":129291,"_5":14861,"_28366":128664,"_3078":129292},[],"Elimina los ajustes archivados de una CA.",{"_3627":75685,"_31174":75435,"_21594":129294,"_5":14861,"_28366":128664,"_3078":129295},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3627":75686,"_31174":75435,"_21594":129297,"_5":14861,"_28366":128664,"_3078":129298},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3627":75687,"_31174":75435,"_21594":129300,"_5":14861,"_28366":128664,"_3078":129301},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3627":75688,"_31174":75435,"_21594":129303,"_5":14861,"_28366":128664,"_3078":129304},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3627":75689,"_31174":75435,"_21594":129306,"_5":14861,"_28366":128664,"_3078":129307},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3627":75690,"_31174":75435,"_21594":129309,"_5":14861,"_28366":128664,"_3078":129310},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3627":75691,"_31174":75435,"_21594":129312,"_5":14861,"_28366":128664,"_3078":129313},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3627":75692,"_31174":75435,"_21594":129315,"_5":14861,"_28366":128664,"_3078":129316},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3627":75693,"_31174":75435,"_21594":129318,"_5":14861,"_28366":128664,"_3078":129319},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3627":75694,"_31174":75435,"_21594":129321,"_5":14861,"_28366":128664,"_3078":129322},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3627":75695,"_31174":75435,"_21594":129324,"_5":14861,"_28366":128664,"_3078":129325},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3627":75696,"_31174":75435,"_21594":129327,"_5":14861,"_28366":128668,"_3078":129328},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3627":75697,"_31174":75435,"_21594":129330,"_5":14861,"_28366":128672,"_3078":129331},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3627":75698,"_31174":75435,"_21594":129333,"_5":14861,"_28366":128676,"_3078":129334},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3627":75699,"_31174":75435,"_21594":129336,"_5":14861,"_28366":128680,"_3078":129337},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3627":75700,"_31174":75435,"_21594":129339,"_5":14861,"_28366":128680,"_3078":129340},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3627":75701,"_31174":75435,"_21594":129342,"_5":14861,"_28366":128684,"_3078":129343},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3627":75702,"_31174":75435,"_21594":129345,"_5":14861,"_28366":128688,"_3078":129346},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3627":75703,"_31174":75435,"_21594":129348,"_5":14861,"_28366":128692,"_3078":129349},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3627":75704,"_31174":75435,"_21594":129351,"_5":14861,"_28366":128692,"_3078":129352},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3627":75705,"_31174":75435,"_21594":129354,"_5":14861,"_28366":128692,"_3078":129355},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3627":75706,"_31174":75435,"_21594":129357,"_5":14861,"_28366":128692,"_3078":129358},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3627":75707,"_31174":75435,"_21594":129360,"_5":14861,"_28366":128692,"_3078":129361},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3627":75708,"_31174":75435,"_21594":129363,"_5":14861,"_28366":128692,"_3078":129364},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3627":75709,"_31174":75435,"_21594":129366,"_5":14861,"_28366":128696,"_3078":129367},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3627":75710,"_31174":75435,"_21594":129369,"_5":14861,"_28366":128696,"_3078":129370},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3627":75711,"_31174":75435,"_21594":129372,"_5":14861,"_28366":128696,"_3078":129373},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3627":75712,"_31174":75435,"_21594":129375,"_5":14861,"_28366":128696,"_3078":129376},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3627":75713,"_31174":75435,"_21594":129378,"_5":14861,"_28366":128696,"_3078":129379},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3627":75714,"_31174":75435,"_21594":129381,"_5":14861,"_28366":128700,"_3078":129382},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3627":75715,"_31174":75435,"_21594":129384,"_5":14861,"_28366":128700,"_3078":129385},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3627":75716,"_31174":75435,"_21594":129387,"_5":14861,"_28366":128700,"_3078":129388},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3627":75717,"_31174":75435,"_21594":129390,"_5":14861,"_28366":128700,"_3078":60234},[],{"_3627":75718,"_31174":75435,"_21594":129392,"_5":14861,"_28366":128700,"_3078":129393},[],"Claves de datos obligatorias",{"_3627":75719,"_31174":75435,"_21594":129395,"_5":14861,"_28366":128700,"_3078":129396},[],"Cuándo",{"_3627":75720,"_31174":75435,"_21594":129398,"_5":14861,"_28366":128700,"_3078":129399},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3627":75721,"_31174":75435,"_21594":129401,"_5":14861,"_28366":128700,"_3078":60246},[],{"_3627":75722,"_31174":75435,"_21594":129403,"_5":14861,"_28366":128700,"_3078":129404},[],"Siempre",{"_3627":75723,"_31174":75435,"_21594":129406,"_5":14861,"_28366":128700,"_3078":129407},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3627":75724,"_31174":75435,"_21594":129409,"_5":14861,"_28366":128700,"_3078":60246},[],{"_3627":75725,"_31174":75435,"_21594":129411,"_5":14861,"_28366":128700,"_3078":129404},[],{"_3627":75726,"_31174":75435,"_21594":129413,"_5":14861,"_28366":128700,"_3078":60259},[],{"_3627":75727,"_31174":75435,"_21594":129415,"_5":14861,"_28366":128700,"_3078":60246},[],{"_3627":75728,"_31174":75435,"_21594":129417,"_5":14861,"_28366":128700,"_3078":129418},[],"Solo cuando hay autenticación SMTP",{"_3627":75729,"_31174":75435,"_21594":129420,"_5":14861,"_28366":128700,"_3078":129421},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3627":75730,"_31174":75435,"_21594":129423,"_5":14861,"_28366":128700,"_3078":129424},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3627":75731,"_31174":75435,"_21594":129426,"_5":14861,"_28366":128700,"_3078":129427},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3627":75732,"_31174":75435,"_21594":129429,"_5":14861,"_28366":128700,"_3078":129430},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3627":75733,"_31174":75435,"_21594":129432,"_5":14861,"_28366":128700,"_3078":129433},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3627":75734,"_31174":75435,"_21594":129435,"_5":14861,"_28366":128700,"_3078":129436},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3627":75735,"_31174":75435,"_21594":129438,"_5":14861,"_28366":128700,"_3078":129439},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3627":75736,"_31174":75435,"_21594":129441,"_5":14861,"_28366":128700,"_3078":129442},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3627":75737,"_31174":75435,"_21594":129444,"_5":14861,"_28366":128700,"_3078":129445},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3627":75738,"_31174":75435,"_21594":129447,"_5":14861,"_28366":128700,"_3078":129448},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3627":75739,"_31174":75435,"_21594":129450,"_5":14861,"_28366":128700,"_3078":129451},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3627":75740,"_31174":75435,"_21594":129453,"_5":14861,"_28366":128700,"_3078":129454},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3627":75741,"_31174":75435,"_21594":129456,"_5":14861,"_28366":128700,"_3078":129457},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3627":75742,"_31174":75435,"_21594":129459,"_5":14861,"_28366":128700,"_3078":129460},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3627":75743,"_31174":75435,"_21594":129462,"_5":14861,"_28366":128700,"_3078":129463},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3627":75744,"_31174":75435,"_21594":129465,"_5":14861,"_28366":128704,"_3078":129466},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3627":75745,"_31174":75435,"_21594":129468,"_5":14861,"_28366":128704,"_3078":129469},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3627":75746,"_31174":75435,"_21594":129471,"_5":14861,"_28366":128708,"_3078":129472},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3627":75747,"_31174":75435,"_21594":129474,"_5":14861,"_28366":128708,"_3078":129475},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3627":75748,"_31174":75435,"_21594":129477,"_5":14861,"_28366":128708,"_3078":129478},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3627":75749,"_31174":75435,"_21594":129480,"_5":14861,"_28366":128708,"_3078":129481},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3627":75750,"_31174":75435,"_21594":129483,"_5":14861,"_28366":128708,"_3078":129484},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3627":75751,"_31174":75435,"_21594":129486,"_5":14861,"_28366":128708,"_3078":129487},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3627":75752,"_31174":75435,"_21594":129489,"_5":14861,"_28366":128708,"_3078":129490},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3627":75753,"_31174":75435,"_21594":129492,"_5":14861,"_28366":128708,"_3078":129493},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3627":75754,"_31174":75435,"_21594":129495,"_5":14861,"_28366":128708,"_3078":129496},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3627":75755,"_31174":75435,"_21594":129498,"_5":14861,"_28366":128708,"_3078":129499},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3627":75756,"_31174":75435,"_21594":129501,"_5":14861,"_28366":128708,"_3078":129502},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3627":75757,"_31174":75435,"_21594":129504,"_5":14861,"_28366":128712,"_3078":129505},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3627":75758,"_31174":75435,"_21594":129507,"_5":14861,"_28366":128712,"_3078":129508},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3627":75759,"_31174":75435,"_21594":129510,"_5":14861,"_28366":128716,"_3078":129511},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3627":75760,"_31174":75435,"_21594":129513,"_5":14861,"_28366":128716,"_3078":129514},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3627":75761,"_31174":75435,"_21594":129516,"_5":14861,"_28366":128716,"_3078":129517},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3627":75762,"_31174":75435,"_21594":129519,"_5":14861,"_28366":128716,"_3078":129520},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3627":75763,"_31174":75435,"_21594":129522,"_5":14861,"_28366":128716,"_3078":129523},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3627":75764,"_31174":75435,"_21594":129525,"_5":14861,"_28366":128716,"_3078":129526},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3627":75765,"_31174":75435,"_21594":129528,"_5":14861,"_28366":128716,"_3078":129529},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3627":75766,"_31174":75435,"_21594":129531,"_5":14861,"_28366":128716,"_3078":129532},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3627":75767,"_31174":75435,"_21594":129534,"_5":14861,"_28366":128720,"_3078":129535},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3627":75768,"_31174":75435,"_21594":129537,"_5":14861,"_28366":128720,"_3078":129538},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3627":75769,"_31174":75435,"_21594":129540,"_5":14861,"_28366":128720,"_3078":129541},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3627":75770,"_31174":75435,"_21594":129543,"_5":14861,"_28366":128720,"_3078":129544},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3627":75771,"_31174":75435,"_21594":129546,"_5":14861,"_28366":128720,"_3078":129547},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3627":75772,"_31174":75435,"_21594":129549,"_5":14861,"_28366":128720,"_3078":129550},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3627":75773,"_31174":75435,"_21594":129552,"_5":14861,"_28366":128720,"_3078":129553},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3627":75774,"_31174":75435,"_21594":129555,"_5":14861,"_28366":128720,"_3078":129556},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3627":75775,"_31174":75435,"_21594":129558,"_5":14861,"_28366":128720,"_3078":129559},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3627":75776,"_31174":75435,"_21594":129561,"_5":14861,"_28366":128720,"_3078":129562},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3627":75777,"_31174":75435,"_21594":129564,"_5":14861,"_28366":128720,"_3078":129565},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3627":75778,"_31174":75435,"_21594":129567,"_5":14861,"_28366":128723,"_3078":129568},[],"Tras la actualización, comprueba en este orden:",{"_3627":75779,"_31174":75435,"_21594":129570,"_5":14861,"_28366":128723,"_3078":129571},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3627":75780,"_31174":75435,"_21594":129573,"_5":14861,"_28366":128723,"_3078":129574},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3627":75781,"_31174":75435,"_21594":129576,"_5":14861,"_28366":128723,"_3078":129577},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3627":75782,"_31174":75435,"_21594":129579,"_5":14861,"_28366":128723,"_3078":129580},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3627":75783,"_31174":75435,"_21594":129582,"_5":14861,"_28366":128723,"_3078":129583},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3627":75784,"_31174":75435,"_21594":129585,"_5":14861,"_28366":128723,"_3078":129586},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3627":75785,"_31174":75435,"_21594":129588,"_5":14861,"_28366":128723,"_3078":129589},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3627":75786,"_31174":75435,"_21594":129591,"_5":14861,"_28366":128723,"_3078":129592},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3627":75787,"_31174":75435,"_21594":129594,"_5":14861,"_28366":128723,"_3078":129595},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3627":75788,"_31174":75435,"_21594":129597,"_5":14861,"_28366":128723,"_3078":129598},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3627":75789,"_31174":75435,"_21594":129600,"_5":14861,"_28366":128723,"_3078":129601},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3627":75790,"_31174":75435,"_21594":129603,"_5":14861,"_28366":128723,"_3078":129604},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3627":75791,"_31174":75435,"_21594":129606,"_5":14861,"_28366":128723,"_3078":129607},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3627":75792,"_31174":75435,"_21594":129609,"_5":14861,"_28366":128723,"_3078":129610},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3627":75793,"_31174":75435,"_21594":129612,"_5":14861,"_28366":128723,"_3078":129613},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3627":75794,"_31174":75435,"_21594":129615,"_5":14861,"_28366":128727,"_3078":129616},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3627":75795,"_31174":75435,"_21594":129618,"_5":14861,"_28366":128727,"_3078":129619},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3627":75796,"_31174":75435,"_21594":129621,"_5":14861,"_28366":128727,"_3078":129622},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3627":75797,"_31174":75435,"_21594":129624,"_5":14861,"_28366":128727,"_3078":129625},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3627":75798,"_31174":75435,"_21594":129627,"_5":14861,"_28366":128727,"_3078":129628},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60477":129630,"_60479":129631,"_60481":129632,"_60483":129633,"_18731":3113,"_72734":3113},"spanish",[3078,31174,5,28366],{"_3078":25780,"_31174":25780,"_5":25780,"_28366":25780},{"_3078":129634,"_31174":132695,"_5":135756,"_28366":138817},{"_4829":129635,"_60487":129636,"_5":25780},{"_14942":3391,"_15321":6347,"_15340":4668,"_30174":4178,"_15327":4216,"_20506":6729,"_14963":3579,"_14970":6613,"_30116":12735,"_30524":6224,"_30551":7795,"_30150":4572,"_35580":5178,"_30253":20992,"_30595":10213,"_35587":5453,"_35590":4217,"_35593":14910,"_35596":5646,"_30997":12410,"_35601":19796,"_35603":3968,"_31032":13827,"_15336":31190,"_35607":7811,"_35610":17786,"_35612":7797,"_30579":3506,"_31017":14908,"_31045":4733,"_35617":8219,"_35619":3265,"_35621":3820,"_30264":7986,"_35624":8748,"_35626":6191,"_35628":5356,"_35630":7987,"_35632":25589,"_30187":7494,"_35635":3816,"_35637":3891,"_30181":17379,"_30616":14651,"_35641":18607,"_35643":6460,"_35646":4574,"_30227":4413,"_35650":8494,"_30107":4158,"_35653":11747,"_30155":14227,"_35656":3171,"_35658":7928,"