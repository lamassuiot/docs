299,"_41567":60302,"_41569":60305,"_41571":60308,"_41573":60311,"_41575":60314,"_41577":60316,"_41579":60318,"_41581":60321,"_41583":60323,"_41585":60326,"_41587":60329,"_41589":60332,"_41591":60335,"_41593":60338,"_41595":60341,"_41597":60344,"_41599":60347,"_41601":60350,"_41603":60353,"_41605":60356,"_41607":60359,"_41609":60362,"_41611":60365,"_41613":60368,"_41615":60371,"_41617":60374,"_41619":60377,"_41621":60380,"_41623":60383,"_41626":60386,"_41628":60389,"_41630":60392,"_41632":60395,"_41634":60398,"_41636":60401,"_41638":60404,"_41640":60407,"_41642":60410,"_41644":60413,"_41646":60416,"_41648":60419,"_41650":60422,"_41652":60425,"_41655":60428,"_41657":60431,"_41659":60434,"_41661":60437,"_41663":60440,"_41665":60443,"_41667":60446,"_41669":60449,"_41671":60452,"_41673":60455,"_41675":60458,"_41677":60461,"_41679":60464,"_41681":60467,"_41683":60470,"_41685":60473,"_41687":60476,"_41689":60479,"_41691":60482,"_41693":60485,"_41695":60488,"_41697":60491,"_41699":60494,"_41701":60497,"_41703":60500,"_41705":60503,"_41707":60506,"_41709":60509,"_41711":60512,"_41713":60515,"_41715":60518,"_41717":60521,"_41720":60524,"_41722":60527,"_41724":60530,"_41726":60533},{"_3632":15,"_31184":15,"_5":15230,"_3083":50994,"_31543":50995,"_21603":50999,"_28376":15},"Deploy from AWS Marketplace",[50996,50997,50998],"Docs","Deployment","Other models",[],{"_3632":16,"_31184":15,"_21603":51001,"_5":14870,"_28376":15,"_3083":51002},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3632":17,"_31184":15,"_5":31540,"_21603":51004,"_28376":51005,"_3083":51006},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3632":18,"_31184":15,"_5":31540,"_21603":51008,"_28376":51009,"_3083":51010},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3632":19,"_31184":15,"_5":31540,"_21603":51012,"_28376":51013,"_3083":51014},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3632":20,"_31184":15,"_5":31540,"_21603":51016,"_28376":51017,"_3083":51018},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3632":21,"_31184":15,"_5":31540,"_21603":51020,"_28376":51021,"_3083":51022},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3632":22,"_31184":15,"_5":31540,"_21603":51024,"_28376":51025,"_3083":51026},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3632":23,"_31184":15,"_5":31540,"_21603":51028,"_28376":51029,"_3083":51030},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#next-step","Next step",{"_3632":24,"_31184":15,"_21603":51032,"_5":14870,"_28376":15,"_3083":51033},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3632":25,"_31184":15,"_21603":51035,"_5":14870,"_28376":51005,"_3083":51036},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3632":26,"_31184":15,"_21603":51038,"_5":14870,"_28376":51005,"_3083":51039},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3632":27,"_31184":15,"_21603":51041,"_5":14870,"_28376":51005,"_3083":51042},[],"A security group allowing the necessary endpoints.",{"_3632":28,"_31184":15,"_21603":51044,"_5":14870,"_28376":51009,"_3083":51045},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3632":29,"_31184":15,"_21603":51047,"_5":14870,"_28376":51009,"_3083":51048},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3632":30,"_31184":15,"_21603":51050,"_5":14870,"_28376":51009,"_3083":51051},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3632":31,"_31184":15,"_21603":51053,"_5":14870,"_28376":51013,"_3083":51054},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3632":32,"_31184":15,"_21603":51056,"_5":14870,"_28376":51017,"_3083":51057},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3632":33,"_31184":15,"_21603":51059,"_5":14870,"_28376":51021,"_3083":51060},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3632":34,"_31184":15,"_21603":51062,"_5":14870,"_28376":51025,"_3083":51063},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3632":35,"_31184":15,"_21603":51065,"_5":14870,"_28376":51029,"_3083":51066},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3632":36,"_31184":36,"_5":15230,"_3083":51068,"_31543":51069,"_21603":51070,"_28376":36},"Deploy Lamassu",[50996,50997],[],{"_3632":37,"_31184":36,"_21603":51072,"_5":14870,"_28376":36,"_3083":51073},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3632":38,"_31184":36,"_5":31540,"_21603":51075,"_28376":51076,"_3083":51077},[],"/docs/pr-preview/pr-75/deployment/overview#choose-a-model","Choose a model",{"_3632":39,"_31184":36,"_5":31540,"_21603":51079,"_28376":51080,"_3083":51081},[],"/docs/pr-preview/pr-75/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3632":40,"_31184":36,"_5":31540,"_21603":51083,"_28376":51084,"_3083":51085},[],"/docs/pr-preview/pr-75/deployment/overview#after-deployment","After deployment",{"_3632":41,"_31184":36,"_21603":51087,"_5":14870,"_28376":36,"_3083":51088},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3632":42,"_31184":36,"_21603":51090,"_5":14870,"_28376":51076,"_3083":51091},[],"Model",{"_3632":43,"_31184":36,"_21603":51093,"_5":14870,"_28376":51076,"_3083":51094},[],"Recommended for",{"_3632":44,"_31184":36,"_21603":51096,"_5":14870,"_28376":51076,"_3083":51097},[],"Who operates the infrastructure",{"_3632":45,"_31184":36,"_21603":51099,"_5":14870,"_28376":51076,"_3083":51100},[],"Starting point",{"_3632":46,"_31184":36,"_21603":51102,"_5":14870,"_28376":51076,"_3083":51103},[],"Kubernetes self-managed",{"_3632":47,"_31184":36,"_21603":51105,"_5":14870,"_28376":51076,"_3083":51106},[],"Production, regulated environments and custom deployments",{"_3632":48,"_31184":36,"_21603":51108,"_5":14870,"_28376":51076,"_3083":51109},[],"Your team",{"_3632":49,"_31184":36,"_21603":51111,"_5":14870,"_28376":51076,"_3083":51112},[],"Helm or Fastlane",{"_3632":50,"_31184":36,"_21603":51114,"_5":14870,"_28376":51076,"_3083":51115},[],"AWS Marketplace",{"_3632":51,"_31184":36,"_21603":51117,"_5":14870,"_28376":51076,"_3083":51118},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3632":52,"_31184":36,"_21603":51120,"_5":14870,"_28376":51076,"_3083":51109},[],{"_3632":53,"_31184":36,"_21603":51122,"_5":14870,"_28376":51076,"_3083":51123},[],"Preconfigured image on EC2",{"_3632":54,"_31184":36,"_21603":51125,"_5":14870,"_28376":51076,"_3083":51126},[],"SaaS",{"_3632":55,"_31184":36,"_21603":51128,"_5":14870,"_28376":51076,"_3083":51129},[],"Teams that want to use the platform without operating it",{"_3632":56,"_31184":36,"_21603":51131,"_5":14870,"_28376":51076,"_3083":51132},[],"Lamassu",{"_3632":57,"_31184":36,"_21603":51134,"_5":14870,"_28376":51076,"_3083":51135},[],"Managed subscription",{"_3632":58,"_31184":36,"_21603":51137,"_5":14870,"_28376":51076,"_3083":51138},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3632":59,"_31184":36,"_21603":51140,"_5":14870,"_28376":51076,"_3083":51141},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3632":60,"_31184":36,"_21603":51143,"_5":14870,"_28376":51076,"_3083":51144},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3632":61,"_31184":36,"_21603":51146,"_5":14870,"_28376":51080,"_3083":51147},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3632":62,"_31184":36,"_21603":51149,"_5":14870,"_28376":51084,"_3083":51150},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3632":63,"_31184":63,"_5":15230,"_3083":51152,"_31543":51153,"_21603":51154,"_28376":63},"Use Lamassu as SaaS",[50996,50997,50998],[],{"_3632":64,"_31184":63,"_21603":51156,"_5":14870,"_28376":63,"_3083":51157},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3632":65,"_31184":63,"_5":31540,"_21603":51159,"_28376":51160,"_3083":51161},[],"/docs/pr-preview/pr-75/deployment/saas#what-the-service-manages","What the service manages",{"_3632":66,"_31184":63,"_5":31540,"_21603":51163,"_28376":51164,"_3083":51165},[],"/docs/pr-preview/pr-75/deployment/saas#plans","Plans",{"_3632":67,"_31184":63,"_5":31540,"_21603":51167,"_28376":51168,"_3083":51169},[],"/docs/pr-preview/pr-75/deployment/saas#request-access","Request access",{"_3632":68,"_31184":63,"_21603":51171,"_5":14870,"_28376":63,"_3083":51172},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3632":69,"_31184":63,"_21603":51174,"_5":14870,"_28376":51160,"_3083":51175},[],"Platform availability and maintenance.",{"_3632":70,"_31184":63,"_21603":51177,"_5":14870,"_28376":51160,"_3083":51178},[],"Automatic backups.",{"_3632":71,"_31184":63,"_21603":51180,"_5":14870,"_28376":51160,"_3083":51181},[],"Version upgrades.",{"_3632":72,"_31184":63,"_21603":51183,"_5":14870,"_28376":51160,"_3083":51184},[],"Technical support and SLA according to your plan.",{"_3632":73,"_31184":63,"_21603":51186,"_5":14870,"_28376":51164,"_3083":51187},[],"Plan",{"_3632":74,"_31184":63,"_21603":51189,"_5":14870,"_28376":51164,"_3083":51190},[],"Devices",{"_3632":75,"_31184":63,"_21603":51192,"_5":14870,"_28376":51164,"_3083":51193},[],"Support",{"_3632":76,"_31184":63,"_21603":51195,"_5":14870,"_28376":51164,"_3083":51196},[],"SLA",{"_3632":77,"_31184":63,"_21603":51198,"_5":14870,"_28376":51164,"_3083":51199},[],"Starter",{"_3632":78,"_31184":63,"_21603":51201,"_5":14870,"_28376":51164,"_3083":51202},[],"Up to 1,000",{"_3632":79,"_31184":63,"_21603":51204,"_5":14870,"_28376":51164,"_3083":51205},[],"Email",{"_3632":80,"_31184":63,"_21603":51207,"_5":14870,"_28376":51164,"_3083":51208},[],"99.5 %",{"_3632":81,"_31184":63,"_21603":51210,"_5":14870,"_28376":51164,"_3083":51211},[],"Professional",{"_3632":82,"_31184":63,"_21603":51213,"_5":14870,"_28376":51164,"_3083":51214},[],"Up to 10,000",{"_3632":83,"_31184":63,"_21603":51216,"_5":14870,"_28376":51164,"_3083":51217},[],"Email and chat",{"_3632":84,"_31184":63,"_21603":51219,"_5":14870,"_28376":51164,"_3083":51220},[],"99.9 %",{"_3632":85,"_31184":63,"_21603":51222,"_5":14870,"_28376":51164,"_3083":51223},[],"Enterprise",{"_3632":86,"_31184":63,"_21603":51225,"_5":14870,"_28376":51164,"_3083":51226},[],"Unlimited",{"_3632":87,"_31184":63,"_21603":51228,"_5":14870,"_28376":51164,"_3083":51229},[],"Dedicated",{"_3632":88,"_31184":63,"_21603":51231,"_5":14870,"_28376":51164,"_3083":51232},[],"99.99 %",{"_3632":89,"_31184":63,"_21603":51234,"_5":14870,"_28376":51168,"_3083":51235},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3632":90,"_31184":63,"_21603":51237,"_5":14870,"_28376":51168,"_3083":51238},[],"When you receive your instance's credentials, continue with Get started.",{"_3632":91,"_31184":91,"_5":15230,"_3083":51240,"_31543":51241,"_21603":51242,"_28376":91},"Fastlane",[50996,50997,51103],[],{"_3632":92,"_31184":91,"_21603":51244,"_5":14870,"_28376":91,"_3083":51245},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3632":93,"_31184":91,"_5":31540,"_21603":51247,"_28376":51248,"_3083":51249},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3632":94,"_31184":91,"_5":31540,"_21603":51251,"_28376":51252,"_3083":51253},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3632":95,"_31184":91,"_5":31540,"_21603":51255,"_28376":51256,"_3083":51006},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#before-you-begin",{"_3632":96,"_31184":91,"_5":31540,"_21603":51258,"_28376":51259,"_3083":51260},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3632":97,"_31184":91,"_5":31540,"_21603":51262,"_28376":51263,"_3083":51264},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3632":98,"_31184":91,"_5":31540,"_21603":51266,"_28376":51267,"_3083":51268},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3632":99,"_31184":91,"_5":31540,"_21603":51270,"_28376":51271,"_3083":51272},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3632":100,"_31184":91,"_5":31540,"_21603":51274,"_28376":51275,"_3083":51276},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3632":101,"_31184":91,"_5":31540,"_21603":51278,"_28376":51279,"_3083":51280},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3632":102,"_31184":91,"_5":31540,"_21603":51282,"_28376":51283,"_3083":51284},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3632":103,"_31184":91,"_5":31540,"_21603":51286,"_28376":51287,"_3083":51288},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3632":104,"_31184":91,"_21603":51290,"_5":14870,"_28376":51248,"_3083":51291},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3632":105,"_31184":91,"_21603":51293,"_5":14870,"_28376":51248,"_3083":51294},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3632":106,"_31184":91,"_21603":51296,"_5":14870,"_28376":51252,"_3083":51297},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3632":107,"_31184":91,"_21603":51299,"_5":14870,"_28376":51252,"_3083":51300},[],"Fastlane installs or configures",{"_3632":108,"_31184":91,"_21603":51302,"_5":14870,"_28376":51252,"_3083":51303},[],"You still provide",{"_3632":109,"_31184":91,"_21603":51305,"_5":14870,"_28376":51252,"_3083":51306},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3632":110,"_31184":91,"_21603":51308,"_5":14870,"_28376":51252,"_3083":51309},[],"The Kubernetes cluster, nodes and persistent storage",{"_3632":111,"_31184":91,"_21603":51311,"_5":14870,"_28376":51252,"_3083":51312},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3632":112,"_31184":91,"_21603":51314,"_5":14870,"_28376":51252,"_3083":51315},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3632":113,"_31184":91,"_21603":51317,"_5":14870,"_28376":51252,"_3083":51318},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3632":114,"_31184":91,"_21603":51320,"_5":14870,"_28376":51252,"_3083":51321},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3632":115,"_31184":91,"_21603":51323,"_5":14870,"_28376":51252,"_3083":51324},[],"Optional observability and lab HSM components",{"_3632":116,"_31184":91,"_21603":51326,"_5":14870,"_28376":51252,"_3083":51327},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3632":117,"_31184":91,"_21603":51329,"_5":14870,"_28376":51252,"_3083":51330},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3632":118,"_31184":91,"_21603":51332,"_5":14870,"_28376":51256,"_3083":51333},[],"You need:",{"_3632":119,"_31184":91,"_21603":51335,"_5":14870,"_28376":51256,"_3083":51336},[],"an existing Kubernetes cluster",{"_3632":120,"_31184":91,"_21603":51338,"_5":14870,"_28376":51256,"_3083":51339},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3632":121,"_31184":91,"_21603":51341,"_5":14870,"_28376":51256,"_3083":51342},[],"`yq`",{"_3632":122,"_31184":91,"_21603":51344,"_5":14870,"_28376":51256,"_3083":24416},[],{"_3632":123,"_31184":91,"_21603":51346,"_5":14870,"_28376":51256,"_3083":51347},[],"`jq` only when using `--sample-data` or `--development`",{"_3632":124,"_31184":91,"_21603":51349,"_5":14870,"_28376":51256,"_3083":51350},[],"`ssh-keygen` only when using `--with-hsm`",{"_3632":125,"_31184":91,"_21603":51352,"_5":14870,"_28376":51256,"_3083":51353},[],"free external ports 80 and 443 on a single-node K3s host",{"_3632":126,"_31184":91,"_21603":51355,"_5":14870,"_28376":51256,"_3083":51356},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3632":127,"_31184":91,"_21603":51358,"_5":14870,"_28376":51256,"_3083":51359},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3632":128,"_31184":91,"_21603":51361,"_5":14870,"_28376":51259,"_3083":51362},[],"Run the script from a clone of the Helm repository:",{"_3632":129,"_31184":91,"_21603":51364,"_5":14870,"_28376":51259,"_3083":51365},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3632":130,"_31184":91,"_21603":51367,"_5":14870,"_28376":51263,"_3083":51368},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3632":131,"_31184":91,"_21603":51370,"_5":14870,"_28376":51263,"_3083":51371},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3632":132,"_31184":91,"_21603":51373,"_5":14870,"_28376":51263,"_3083":51374},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3632":133,"_31184":91,"_21603":51376,"_5":14870,"_28376":51263,"_3083":51377},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3632":134,"_31184":91,"_21603":51379,"_5":14870,"_28376":51267,"_3083":51380},[],"Option",{"_3632":135,"_31184":91,"_21603":51382,"_5":14870,"_28376":51267,"_3083":51383},[],"Default",{"_3632":136,"_31184":91,"_21603":51385,"_5":14870,"_28376":51267,"_3083":51386},[],"Purpose",{"_3632":137,"_31184":91,"_21603":51388,"_5":14870,"_28376":51267,"_3083":51389},[],"`-h`, `--help`",{"_3632":138,"_31184":91,"_21603":51391,"_5":14870,"_28376":51267,"_3083":51392},[],"—",{"_3632":139,"_31184":91,"_21603":51394,"_5":14870,"_28376":51267,"_3083":51395},[],"Show help",{"_3632":140,"_31184":91,"_21603":51397,"_5":14870,"_28376":51267,"_3083":51398},[],"`-c`, `--context`",{"_3632":141,"_31184":91,"_21603":51400,"_5":14870,"_28376":51267,"_3083":51401},[],"current context",{"_3632":142,"_31184":91,"_21603":51403,"_5":14870,"_28376":51267,"_3083":51404},[],"Select the kubeconfig context for kubectl and Helm",{"_3632":143,"_31184":91,"_21603":51406,"_5":14870,"_28376":51267,"_3083":51407},[],"`-n`, `--non-interactive`",{"_3632":144,"_31184":91,"_21603":51409,"_5":14870,"_28376":51267,"_3083":6802},[],{"_3632":145,"_31184":91,"_21603":51411,"_5":14870,"_28376":51267,"_3083":51412},[],"Skip prompts and generate dependency credentials",{"_3632":146,"_31184":91,"_21603":51414,"_5":14870,"_28376":51267,"_3083":51415},[],"`-ns`, `--namespace`",{"_3632":147,"_31184":91,"_21603":51417,"_5":14870,"_28376":51267,"_3083":51418},[],"`lamassu-dev`",{"_3632":148,"_31184":91,"_21603":51420,"_5":14870,"_28376":51267,"_3083":51421},[],"Namespace for the installation",{"_3632":149,"_31184":91,"_21603":51423,"_5":14870,"_28376":51267,"_3083":51424},[],"`-d`, `--domain`",{"_3632":150,"_31184":91,"_21603":51426,"_5":14870,"_28376":51267,"_3083":51427},[],"`dev.lamassu.io`",{"_3632":151,"_31184":91,"_21603":51429,"_5":14870,"_28376":51267,"_3083":51430},[],"Domain used by the UI, OIDC and certificate",{"_3632":152,"_31184":91,"_21603":51432,"_5":14870,"_28376":51267,"_3083":51433},[],"`-v`, `--version`",{"_3632":153,"_31184":91,"_21603":51435,"_5":14870,"_28376":51267,"_3083":15582},[],{"_3632":154,"_31184":91,"_21603":51437,"_5":14870,"_28376":51267,"_3083":51438},[],"Lamassu chart version",{"_3632":155,"_31184":91,"_21603":51440,"_5":14870,"_28376":51267,"_3083":51441},[],"`--https-port`",{"_3632":156,"_31184":91,"_21603":51443,"_5":14870,"_28376":51267,"_3083":51444},[],"`443`",{"_3632":157,"_31184":91,"_21603":51446,"_5":14870,"_28376":51267,"_3083":51447},[],"Gateway HTTPS listener port",{"_3632":158,"_31184":91,"_21603":51449,"_5":14870,"_28376":51267,"_3083":51450},[],"`--http-port`",{"_3632":159,"_31184":91,"_21603":51452,"_5":14870,"_28376":51267,"_3083":51453},[],"`80`",{"_3632":160,"_31184":91,"_21603":51455,"_5":14870,"_28376":51267,"_3083":51456},[],"Gateway HTTP listener port",{"_3632":161,"_31184":91,"_21603":51458,"_5":14870,"_28376":51267,"_3083":51459},[],"`--tls-crt`",{"_3632":162,"_31184":91,"_21603":51461,"_5":14870,"_28376":51267,"_3083":51392},[],{"_3632":163,"_31184":91,"_21603":51463,"_5":14870,"_28376":51267,"_3083":51464},[],"PEM certificate for downstream TLS",{"_3632":164,"_31184":91,"_21603":51466,"_5":14870,"_28376":51267,"_3083":51467},[],"`--tls-key`",{"_3632":165,"_31184":91,"_21603":51469,"_5":14870,"_28376":51267,"_3083":51392},[],{"_3632":166,"_31184":91,"_21603":51471,"_5":14870,"_28376":51267,"_3083":51472},[],"PEM private key for downstream TLS",{"_3632":167,"_31184":91,"_21603":51474,"_5":14870,"_28376":51267,"_3083":51475},[],"`-l`, `--local-chart-path`",{"_3632":168,"_31184":91,"_21603":51477,"_5":14870,"_28376":51267,"_3083":51478},[],"repository chart",{"_3632":169,"_31184":91,"_21603":51480,"_5":14870,"_28376":51267,"_3083":51481},[],"Use an unpacked local Lamassu chart",{"_3632":170,"_31184":91,"_21603":51483,"_5":14870,"_28376":51267,"_3083":51484},[],"`-ip`, `--gateway-ip`",{"_3632":171,"_31184":91,"_21603":51486,"_5":14870,"_28376":51267,"_3083":9088},[],{"_3632":172,"_31184":91,"_21603":51488,"_5":14870,"_28376":51267,"_3083":51489},[],"Override the address written to `gateway.addresses`",{"_3632":173,"_31184":91,"_21603":51491,"_5":14870,"_28376":51267,"_3083":51492},[],"`--otel`",{"_3632":174,"_31184":91,"_21603":51494,"_5":14870,"_28376":51267,"_3083":6802},[],{"_3632":175,"_31184":91,"_21603":51496,"_5":14870,"_28376":51267,"_3083":51497},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3632":176,"_31184":91,"_21603":51499,"_5":14870,"_28376":51267,"_3083":51500},[],"`--development`",{"_3632":177,"_31184":91,"_21603":51502,"_5":14870,"_28376":51267,"_3083":6802},[],{"_3632":178,"_31184":91,"_21603":51504,"_5":14870,"_28376":51267,"_3083":51505},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3632":179,"_31184":91,"_21603":51507,"_5":14870,"_28376":51267,"_3083":51508},[],"`--sample-data`",{"_3632":180,"_31184":91,"_21603":51510,"_5":14870,"_28376":51267,"_3083":6802},[],{"_3632":181,"_31184":91,"_21603":51512,"_5":14870,"_28376":51267,"_3083":51513},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3632":182,"_31184":91,"_21603":51515,"_5":14870,"_28376":51267,"_3083":51516},[],"`--with-hsm`",{"_3632":183,"_31184":91,"_21603":51518,"_5":14870,"_28376":51267,"_3083":6802},[],{"_3632":184,"_31184":91,"_21603":51520,"_5":14870,"_28376":51267,"_3083":51521},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3632":185,"_31184":91,"_21603":51523,"_5":14870,"_28376":51267,"_3083":51524},[],"`--softhsm-chart-path`",{"_3632":186,"_31184":91,"_21603":51526,"_5":14870,"_28376":51267,"_3083":51527},[],"`./charts/softhsm`",{"_3632":187,"_31184":91,"_21603":51529,"_5":14870,"_28376":51267,"_3083":51530},[],"Use a different local SoftHSM chart",{"_3632":188,"_31184":91,"_21603":51532,"_5":14870,"_28376":51267,"_3083":51533},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3632":189,"_31184":91,"_21603":51535,"_5":14870,"_28376":51271,"_3083":51536},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3632":190,"_31184":91,"_21603":51538,"_5":14870,"_28376":51271,"_3083":51539},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3632":191,"_31184":91,"_21603":51541,"_5":14870,"_28376":51271,"_3083":51542},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3632":192,"_31184":91,"_21603":51544,"_5":14870,"_28376":51271,"_3083":51545},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3632":193,"_31184":91,"_21603":51547,"_5":14870,"_28376":51271,"_3083":51548},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3632":194,"_31184":91,"_21603":51550,"_5":14870,"_28376":51271,"_3083":51551},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3632":195,"_31184":91,"_21603":51553,"_5":14870,"_28376":51275,"_3083":51554},[],"Fastlane:",{"_3632":196,"_31184":91,"_21603":51556,"_5":14870,"_28376":51275,"_3083":51557},[],"validates local tools and the selected cluster",{"_3632":197,"_31184":91,"_21603":51559,"_5":14870,"_28376":51275,"_3083":51560},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3632":198,"_31184":91,"_21603":51562,"_5":14870,"_28376":51275,"_3083":51563},[],"creates the namespace",{"_3632":199,"_31184":91,"_21603":51565,"_5":14870,"_28376":51275,"_3083":51566},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3632":200,"_31184":91,"_21603":51568,"_5":14870,"_28376":51275,"_3083":51569},[],"installs PostgreSQL and creates the required databases",{"_3632":201,"_31184":91,"_21603":51571,"_5":14870,"_28376":51275,"_3083":51572},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3632":202,"_31184":91,"_21603":51574,"_5":14870,"_28376":51275,"_3083":51575},[],"installs RabbitMQ",{"_3632":203,"_31184":91,"_21603":51577,"_5":14870,"_28376":51275,"_3083":51578},[],"optionally installs observability and lab HSM components",{"_3632":204,"_31184":91,"_21603":51580,"_5":14870,"_28376":51275,"_3083":51581},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3632":205,"_31184":91,"_21603":51583,"_5":14870,"_28376":51275,"_3083":51584},[],"optionally loads sample data",{"_3632":206,"_31184":91,"_21603":51586,"_5":14870,"_28376":51275,"_3083":51587},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3632":207,"_31184":91,"_21603":51589,"_5":14870,"_28376":51279,"_3083":51590},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3632":208,"_31184":91,"_21603":51592,"_5":14870,"_28376":51279,"_3083":51593},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3632":209,"_31184":91,"_21603":51595,"_5":14870,"_28376":51283,"_3083":51596},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3632":210,"_31184":91,"_21603":51598,"_5":14870,"_28376":51283,"_3083":51599},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3632":211,"_31184":91,"_21603":51601,"_5":14870,"_28376":51283,"_3083":51602},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3632":212,"_31184":91,"_21603":51604,"_5":14870,"_28376":51283,"_3083":51605},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3632":213,"_31184":91,"_21603":51607,"_5":14870,"_28376":51287,"_3083":51608},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3632":214,"_31184":214,"_5":15230,"_3083":51610,"_31543":51611,"_21603":51612,"_28376":214},"Install with Helm",[50996,50997,51103],[],{"_3632":215,"_31184":214,"_21603":51614,"_5":14870,"_28376":214,"_3083":51615},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3632":216,"_31184":214,"_5":31540,"_21603":51617,"_28376":51618,"_3083":51619},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3632":217,"_31184":214,"_5":31540,"_21603":51621,"_28376":51622,"_3083":51006},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#before-you-begin",{"_3632":218,"_31184":214,"_5":31540,"_21603":51624,"_28376":51625,"_3083":51626},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3632":219,"_31184":214,"_5":31540,"_21603":51628,"_28376":51629,"_3083":51630},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3632":220,"_31184":214,"_5":31540,"_21603":51632,"_28376":51633,"_3083":51634},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3632":221,"_31184":214,"_5":31540,"_21603":51636,"_28376":51637,"_3083":51638},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3632":222,"_31184":214,"_5":31540,"_21603":51640,"_28376":51641,"_3083":51642},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3632":223,"_31184":214,"_5":31540,"_21603":51644,"_28376":51645,"_3083":51646},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3632":224,"_31184":214,"_5":31540,"_21603":51648,"_28376":51649,"_3083":51650},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3632":225,"_31184":214,"_5":31540,"_21603":51652,"_28376":51653,"_3083":51654},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3632":226,"_31184":214,"_5":31540,"_21603":51656,"_28376":51657,"_3083":51658},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3632":227,"_31184":214,"_5":31540,"_21603":51660,"_28376":51661,"_3083":51662},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3632":228,"_31184":214,"_21603":51664,"_5":14870,"_28376":51618,"_3083":51665},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3632":229,"_31184":214,"_21603":51667,"_5":14870,"_28376":51622,"_3083":51668},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3632":230,"_31184":214,"_21603":51670,"_5":14870,"_28376":51622,"_3083":51671},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3632":231,"_31184":214,"_21603":51673,"_5":14870,"_28376":51622,"_3083":51674},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3632":232,"_31184":214,"_21603":51676,"_5":14870,"_28376":51622,"_3083":51677},[],"a reachable RabbitMQ broker and credentials",{"_3632":233,"_31184":214,"_21603":51679,"_5":14870,"_28376":51622,"_3083":51680},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3632":234,"_31184":214,"_21603":51682,"_5":14870,"_28376":51622,"_3083":51683},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3632":235,"_31184":214,"_21603":51685,"_5":14870,"_28376":51622,"_3083":51686},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3632":236,"_31184":214,"_21603":51688,"_5":14870,"_28376":51622,"_3083":51689},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3632":237,"_31184":214,"_21603":51691,"_5":14870,"_28376":51622,"_3083":51692},[],"a StorageClass and an external traffic design",{"_3632":238,"_31184":214,"_21603":51694,"_5":14870,"_28376":51622,"_3083":51695},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3632":239,"_31184":214,"_21603":51697,"_5":14870,"_28376":51622,"_3083":51698},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3632":240,"_31184":214,"_21603":51700,"_5":14870,"_28376":51622,"_3083":51701},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3632":241,"_31184":214,"_21603":51703,"_5":14870,"_28376":51625,"_3083":51704},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3632":242,"_31184":214,"_21603":51706,"_5":14870,"_28376":51625,"_3083":51707},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3632":243,"_31184":214,"_21603":51709,"_5":14870,"_28376":51625,"_3083":51710},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3632":244,"_31184":214,"_21603":51712,"_5":14870,"_28376":51629,"_3083":51713},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3632":245,"_31184":214,"_21603":51715,"_5":14870,"_28376":51629,"_3083":51716},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3632":246,"_31184":214,"_21603":51718,"_5":14870,"_28376":51629,"_3083":51719},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3632":247,"_31184":214,"_21603":51721,"_5":14870,"_28376":51629,"_3083":51722},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3632":248,"_31184":214,"_21603":51724,"_5":14870,"_28376":51633,"_3083":51725},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3632":249,"_31184":214,"_21603":51727,"_5":14870,"_28376":51633,"_3083":51728},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3632":250,"_31184":214,"_21603":51730,"_5":14870,"_28376":51633,"_3083":51731},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3632":251,"_31184":214,"_21603":51733,"_5":14870,"_28376":51633,"_3083":51734},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3632":252,"_31184":214,"_21603":51736,"_5":14870,"_28376":51633,"_3083":51737},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3632":253,"_31184":214,"_21603":51739,"_5":14870,"_28376":51633,"_3083":51740},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3632":254,"_31184":214,"_21603":51742,"_5":14870,"_28376":51633,"_3083":51743},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3632":255,"_31184":214,"_21603":51745,"_5":14870,"_28376":51633,"_3083":51746},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3632":256,"_31184":214,"_21603":51748,"_5":14870,"_28376":51637,"_3083":51749},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3632":257,"_31184":214,"_21603":51751,"_5":14870,"_28376":51641,"_3083":51752},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3632":258,"_31184":214,"_21603":51754,"_5":14870,"_28376":51641,"_3083":51755},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3632":259,"_31184":214,"_21603":51757,"_5":14870,"_28376":51641,"_3083":51758},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3632":260,"_31184":214,"_21603":51760,"_5":14870,"_28376":51641,"_3083":51761},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3632":261,"_31184":214,"_21603":51763,"_5":14870,"_28376":51641,"_3083":51764},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3632":262,"_31184":214,"_21603":51766,"_5":14870,"_28376":51641,"_3083":51767},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3632":263,"_31184":214,"_21603":51769,"_5":14870,"_28376":51641,"_3083":51770},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3632":264,"_31184":214,"_21603":51772,"_5":14870,"_28376":51645,"_3083":51773},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3632":265,"_31184":214,"_21603":51775,"_5":14870,"_28376":51645,"_3083":51776},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3632":266,"_31184":214,"_21603":51778,"_5":14870,"_28376":51645,"_3083":51779},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3632":267,"_31184":214,"_21603":51781,"_5":14870,"_28376":51645,"_3083":51782},[],"See Access control for the principal and policy model.",{"_3632":268,"_31184":214,"_21603":51784,"_5":14870,"_28376":51649,"_3083":51785},[],"To install a local checkout instead:",{"_3632":269,"_31184":214,"_21603":51787,"_5":14870,"_28376":51653,"_3083":51788},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3632":270,"_31184":214,"_21603":51790,"_5":14870,"_28376":51653,"_3083":51791},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3632":271,"_31184":214,"_21603":51793,"_5":14870,"_28376":51657,"_3083":51794},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3632":272,"_31184":214,"_21603":51796,"_5":14870,"_28376":51657,"_3083":51797},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3632":273,"_31184":214,"_21603":51799,"_5":14870,"_28376":51657,"_3083":51800},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3632":274,"_31184":214,"_21603":51802,"_5":14870,"_28376":51657,"_3083":51803},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3632":275,"_31184":214,"_21603":51805,"_5":14870,"_28376":51657,"_3083":51806},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3632":276,"_31184":214,"_21603":51808,"_5":14870,"_28376":51661,"_3083":51809},[],"Before going live, review:",{"_3632":277,"_31184":214,"_21603":51811,"_5":14870,"_28376":51661,"_3083":51812},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3632":278,"_31184":214,"_21603":51814,"_5":14870,"_28376":51661,"_3083":51815},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3632":279,"_31184":214,"_21603":51817,"_5":14870,"_28376":51661,"_3083":51818},[],"shared VA storage before increasing VA replicas",{"_3632":280,"_31184":214,"_21603":51820,"_5":14870,"_28376":51661,"_3083":51821},[],"managed OIDC roles and removal of evaluation credentials",{"_3632":281,"_31184":214,"_21603":51823,"_5":14870,"_28376":51661,"_3083":51824},[],"a trusted TLS issuer or externally managed certificate",{"_3632":282,"_31184":214,"_21603":51826,"_5":14870,"_28376":51661,"_3083":51827},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3632":283,"_31184":214,"_21603":51829,"_5":14870,"_28376":51661,"_3083":51830},[],"SMTP, observability and alert delivery",{"_3632":284,"_31184":214,"_21603":51832,"_5":14870,"_28376":51661,"_3083":51833},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3632":285,"_31184":214,"_21603":51835,"_5":14870,"_28376":51661,"_3083":51836},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3632":286,"_31184":286,"_5":15230,"_3083":51838,"_31543":51839,"_21603":51840,"_28376":286},"Expose the Gateway",[50996,50997,51103],[],{"_3632":287,"_31184":286,"_21603":51842,"_5":14870,"_28376":286,"_3083":51843},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3632":288,"_31184":286,"_5":31540,"_21603":51845,"_28376":51846,"_3083":51847},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3632":289,"_31184":286,"_5":31540,"_21603":51849,"_28376":51850,"_3083":51851},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3632":290,"_31184":286,"_5":31540,"_21603":51853,"_28376":51854,"_3083":51855},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3632":291,"_31184":286,"_5":31540,"_21603":51857,"_28376":51858,"_3083":51859},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#k3s","K3s",{"_3632":292,"_31184":286,"_5":31540,"_21603":51861,"_28376":51862,"_3083":51863},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3632":293,"_31184":286,"_5":31540,"_21603":51865,"_28376":51866,"_3083":51867},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3632":294,"_31184":286,"_5":31540,"_21603":51869,"_28376":51870,"_3083":51871},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3632":295,"_31184":286,"_5":31540,"_21603":51873,"_28376":51874,"_3083":51875},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3632":296,"_31184":286,"_5":31540,"_21603":51877,"_28376":51878,"_3083":51879},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3632":297,"_31184":286,"_5":31540,"_21603":51881,"_28376":51882,"_3083":51883},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3632":298,"_31184":286,"_5":31540,"_21603":51885,"_28376":51886,"_3083":51887},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3632":299,"_31184":286,"_21603":51889,"_5":14870,"_28376":51846,"_3083":51890},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3632":300,"_31184":286,"_21603":51892,"_5":14870,"_28376":51846,"_3083":51893},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3632":301,"_31184":286,"_21603":51895,"_5":14870,"_28376":51850,"_3083":51896},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3632":302,"_31184":286,"_21603":51898,"_5":14870,"_28376":51850,"_3083":51899},[],"Set it only when:",{"_3632":303,"_31184":286,"_21603":51901,"_5":14870,"_28376":51850,"_3083":51902},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3632":304,"_31184":286,"_21603":51904,"_5":14870,"_28376":51850,"_3083":51905},[],"that address is allocated to this Gateway",{"_3632":305,"_31184":286,"_21603":51907,"_5":14870,"_28376":51850,"_3083":51908},[],"the surrounding network already routes traffic for it to the cluster",{"_3632":306,"_31184":286,"_21603":51910,"_5":14870,"_28376":51850,"_3083":51911},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3632":307,"_31184":286,"_21603":51913,"_5":14870,"_28376":51850,"_3083":51914},[],"Keep these two settings separate:",{"_3632":308,"_31184":286,"_21603":51916,"_5":14870,"_28376":51850,"_3083":51917},[],"`gateway.addresses` requests an address for the Gateway.",{"_3632":309,"_31184":286,"_21603":51919,"_5":14870,"_28376":51850,"_3083":51920},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3632":310,"_31184":286,"_21603":51922,"_5":14870,"_28376":51850,"_3083":51923},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3632":311,"_31184":286,"_21603":51925,"_5":14870,"_28376":51854,"_3083":51926},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3632":312,"_31184":286,"_21603":51928,"_5":14870,"_28376":51854,"_3083":51929},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3632":313,"_31184":286,"_21603":51931,"_5":14870,"_28376":51858,"_3083":51932},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3632":314,"_31184":286,"_21603":51934,"_5":14870,"_28376":51858,"_3083":51935},[],"For the recommended design:",{"_3632":315,"_31184":286,"_21603":51937,"_5":14870,"_28376":51858,"_3083":51938},[],"Use only one externally exposed Lamassu Gateway.",{"_3632":316,"_31184":286,"_21603":51940,"_5":14870,"_28376":51858,"_3083":51941},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3632":317,"_31184":286,"_21603":51943,"_5":14870,"_28376":51858,"_3083":51944},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3632":318,"_31184":286,"_21603":51946,"_5":14870,"_28376":51858,"_3083":51947},[],"Point DNS at the VM's reachable address.",{"_3632":319,"_31184":286,"_21603":51949,"_5":14870,"_28376":51858,"_3083":51950},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3632":320,"_31184":286,"_21603":51952,"_5":14870,"_28376":51862,"_3083":51953},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3632":321,"_31184":286,"_21603":51955,"_5":14870,"_28376":51866,"_3083":51956},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3632":322,"_31184":286,"_21603":51958,"_5":14870,"_28376":51866,"_3083":51959},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3632":323,"_31184":286,"_21603":51961,"_5":14870,"_28376":51870,"_3083":51962},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3632":324,"_31184":286,"_21603":51964,"_5":14870,"_28376":51870,"_3083":51965},[],"Requirement",{"_3632":325,"_31184":286,"_21603":51967,"_5":14870,"_28376":51870,"_3083":51968},[],"Recommended design",{"_3632":326,"_31184":286,"_21603":51970,"_5":14870,"_28376":51870,"_3083":51971},[],"Consequence",{"_3632":327,"_31184":286,"_21603":51973,"_5":14870,"_28376":51870,"_3083":51974},[],"Several Lamassu URLs or services",{"_3632":328,"_31184":286,"_21603":51976,"_5":14870,"_28376":51870,"_3083":51977},[],"One Gateway with multiple routes",{"_3632":329,"_31184":286,"_21603":51979,"_5":14870,"_28376":51870,"_3083":51980},[],"One IP and one proxy fleet; this is the chart default",{"_3632":330,"_31184":286,"_21603":51982,"_5":14870,"_28376":51870,"_3083":51983},[],"Independent Gateways and separate external IPs",{"_3632":331,"_31184":286,"_21603":51985,"_5":14870,"_28376":51870,"_3083":51986},[],"One VIP per Gateway",{"_3632":332,"_31184":286,"_21603":51988,"_5":14870,"_28376":51870,"_3083":51989},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3632":333,"_31184":286,"_21603":51991,"_5":14870,"_28376":51870,"_3083":51992},[],"Independent Gateways on one node and one IP",{"_3632":334,"_31184":286,"_21603":51994,"_5":14870,"_28376":51870,"_3083":51995},[],"Use different external ports",{"_3632":335,"_31184":286,"_21603":51997,"_5":14870,"_28376":51870,"_3083":51998},[],"Clients must include non-standard ports",{"_3632":336,"_31184":286,"_21603":52000,"_5":14870,"_28376":51870,"_3083":52001},[],"Separate TLS/mTLS termination behind one IP",{"_3632":337,"_31184":286,"_21603":52003,"_5":14870,"_28376":51870,"_3083":52004},[],"Front-door SNI routing to internal Gateways",{"_3632":338,"_31184":286,"_21603":52006,"_5":14870,"_28376":51870,"_3083":52007},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3632":339,"_31184":286,"_21603":52009,"_5":14870,"_28376":51870,"_3083":52010},[],"Separate Gateway resources but shared proxy infrastructure",{"_3632":340,"_31184":286,"_21603":52012,"_5":14870,"_28376":51870,"_3083":52013},[],"Envoy merged-Gateway mode",{"_3632":341,"_31184":286,"_21603":52015,"_5":14870,"_28376":51870,"_3083":52016},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3632":342,"_31184":286,"_21603":52018,"_5":14870,"_28376":51870,"_3083":52019},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3632":343,"_31184":286,"_21603":52021,"_5":14870,"_28376":51870,"_3083":52022},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3632":344,"_31184":286,"_21603":52024,"_5":14870,"_28376":51870,"_3083":52025},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3632":345,"_31184":286,"_21603":52027,"_5":14870,"_28376":51870,"_3083":52028},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3632":346,"_31184":286,"_21603":52030,"_5":14870,"_28376":51874,"_3083":52031},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3632":347,"_31184":286,"_21603":52033,"_5":14870,"_28376":51878,"_3083":52034},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3632":348,"_31184":286,"_21603":52036,"_5":14870,"_28376":51878,"_3083":52037},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3632":349,"_31184":286,"_21603":52039,"_5":14870,"_28376":51878,"_3083":52040},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3632":350,"_31184":286,"_21603":52042,"_5":14870,"_28376":51878,"_3083":52043},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3632":351,"_31184":286,"_21603":52045,"_5":14870,"_28376":51878,"_3083":52046},[],"If none of those are possible, use different external ports or change the external network design.",{"_3632":352,"_31184":286,"_21603":52048,"_5":14870,"_28376":51882,"_3083":52049},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3632":353,"_31184":286,"_21603":52051,"_5":14870,"_28376":51882,"_3083":52052},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3632":354,"_31184":286,"_21603":52054,"_5":14870,"_28376":51886,"_3083":52055},[],"Check, in order:",{"_3632":355,"_31184":286,"_21603":52057,"_5":14870,"_28376":51886,"_3083":52058},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3632":356,"_31184":286,"_21603":52060,"_5":14870,"_28376":51886,"_3083":52061},[],"Its status contains the expected address.",{"_3632":357,"_31184":286,"_21603":52063,"_5":14870,"_28376":51886,"_3083":52064},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3632":358,"_31184":286,"_21603":52066,"_5":14870,"_28376":51886,"_3083":52067},[],"Port 443 reaches that address from the client network.",{"_3632":359,"_31184":286,"_21603":52069,"_5":14870,"_28376":51886,"_3083":52070},[],"DNS resolves to the externally reachable endpoint.",{"_3632":360,"_31184":286,"_21603":52072,"_5":14870,"_28376":51886,"_3083":52073},[],"The certificate contains the DNS name or IP used by the client.",{"_3632":361,"_31184":286,"_21603":52075,"_5":14870,"_28376":51886,"_3083":52076},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3632":362,"_31184":362,"_5":15230,"_3083":51103,"_31543":52078,"_21603":52079,"_28376":362},[50996,50997,51103],[],{"_3632":363,"_31184":362,"_21603":52081,"_5":14870,"_28376":362,"_3083":52082},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3632":364,"_31184":362,"_5":31540,"_21603":52084,"_28376":52085,"_3083":52086},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3632":365,"_31184":362,"_5":31540,"_21603":52088,"_28376":52089,"_3083":52090},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3632":366,"_31184":362,"_5":31540,"_21603":52092,"_28376":52093,"_3083":52094},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3632":367,"_31184":362,"_5":31540,"_21603":52096,"_28376":52097,"_3083":52098},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3632":368,"_31184":362,"_5":31540,"_21603":52100,"_28376":52101,"_3083":52102},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3632":369,"_31184":362,"_5":31540,"_21603":52104,"_28376":52105,"_3083":52106},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3632":370,"_31184":362,"_21603":52108,"_5":14870,"_28376":52085,"_3083":52109},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3632":371,"_31184":362,"_21603":52111,"_5":14870,"_28376":52089,"_3083":52112},[],"Workflow",{"_3632":372,"_31184":362,"_21603":52114,"_5":14870,"_28376":52089,"_3083":52115},[],"Use it for",{"_3632":373,"_31184":362,"_21603":52117,"_5":14870,"_28376":52089,"_3083":52118},[],"What it installs",{"_3632":374,"_31184":362,"_21603":52120,"_5":14870,"_28376":52089,"_3083":52121},[],"Helm",{"_3632":375,"_31184":362,"_21603":52123,"_5":14870,"_28376":52089,"_3083":52124},[],"Production and controlled environments",{"_3632":376,"_31184":362,"_21603":52126,"_5":14870,"_28376":52089,"_3083":52127},[],"Lamassu services and Gateway API resources",{"_3632":377,"_31184":362,"_21603":52129,"_5":14870,"_28376":52089,"_3083":51240},[],{"_3632":378,"_31184":362,"_21603":52131,"_5":14870,"_28376":52089,"_3083":52132},[],"Evaluation, demos, CI and small lab clusters",{"_3632":379,"_31184":362,"_21603":52134,"_5":14870,"_28376":52089,"_3083":52135},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3632":380,"_31184":362,"_21603":52137,"_5":14870,"_28376":52093,"_3083":52138},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3632":381,"_31184":362,"_21603":52140,"_5":14870,"_28376":52093,"_3083":52141},[],"Area",{"_3632":382,"_31184":362,"_21603":52143,"_5":14870,"_28376":52093,"_3083":52144},[],"The Lamassu chart provides",{"_3632":383,"_31184":362,"_21603":52146,"_5":14870,"_28376":52093,"_3083":52147},[],"You provide",{"_3632":384,"_31184":362,"_21603":52149,"_5":14870,"_28376":52093,"_3083":52150},[],"Lamassu applications",{"_3632":385,"_31184":362,"_21603":52152,"_5":14870,"_28376":52093,"_3083":52153},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3632":386,"_31184":362,"_21603":52155,"_5":14870,"_28376":52093,"_3083":52156},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3632":387,"_31184":362,"_21603":52158,"_5":14870,"_28376":52093,"_3083":52159},[],"PostgreSQL data",{"_3632":388,"_31184":362,"_21603":52161,"_5":14870,"_28376":52093,"_3083":52162},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3632":389,"_31184":362,"_21603":52164,"_5":14870,"_28376":52093,"_3083":52165},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3632":390,"_31184":362,"_21603":52167,"_5":14870,"_28376":52093,"_3083":52168},[],"Messaging",{"_3632":391,"_31184":362,"_21603":52170,"_5":14870,"_28376":52093,"_3083":52171},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3632":392,"_31184":362,"_21603":52173,"_5":14870,"_28376":52093,"_3083":52174},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3632":393,"_31184":362,"_21603":52176,"_5":14870,"_28376":52093,"_3083":52177},[],"Identity",{"_3632":394,"_31184":362,"_21603":52179,"_5":14870,"_28376":52093,"_3083":52180},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3632":395,"_31184":362,"_21603":52182,"_5":14870,"_28376":52093,"_3083":52183},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3632":396,"_31184":362,"_21603":52185,"_5":14870,"_28376":52093,"_3083":52186},[],"External routing",{"_3632":397,"_31184":362,"_21603":52188,"_5":14870,"_28376":52093,"_3083":52189},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3632":398,"_31184":362,"_21603":52191,"_5":14870,"_28376":52093,"_3083":52192},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3632":399,"_31184":362,"_21603":52194,"_5":14870,"_28376":52093,"_3083":52195},[],"TLS",{"_3632":400,"_31184":362,"_21603":52197,"_5":14870,"_28376":52093,"_3083":52198},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3632":401,"_31184":362,"_21603":52200,"_5":14870,"_28376":52093,"_3083":52201},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3632":402,"_31184":362,"_21603":52203,"_5":14870,"_28376":52093,"_3083":52204},[],"Persistent application data",{"_3632":403,"_31184":362,"_21603":52206,"_5":14870,"_28376":52093,"_3083":52207},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3632":404,"_31184":362,"_21603":52209,"_5":14870,"_28376":52093,"_3083":52210},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3632":405,"_31184":362,"_21603":52212,"_5":14870,"_28376":52093,"_3083":52213},[],"Optional integrations",{"_3632":406,"_31184":362,"_21603":52215,"_5":14870,"_28376":52093,"_3083":52216},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3632":407,"_31184":362,"_21603":52218,"_5":14870,"_28376":52093,"_3083":52219},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3632":408,"_31184":362,"_21603":52221,"_5":14870,"_28376":52093,"_3083":52222},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3632":409,"_31184":362,"_21603":52224,"_5":14870,"_28376":52093,"_3083":52225},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3632":410,"_31184":362,"_21603":52227,"_5":14870,"_28376":52097,"_3083":52228},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3632":411,"_31184":362,"_21603":52230,"_5":14870,"_28376":52097,"_3083":52231},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3632":412,"_31184":362,"_21603":52233,"_5":14870,"_28376":52101,"_3083":52234},[],"Kubernetes 1.24 or newer",{"_3632":413,"_31184":362,"_21603":52236,"_5":14870,"_28376":52101,"_3083":52237},[],"Helm 3.2 or newer",{"_3632":414,"_31184":362,"_21603":52239,"_5":14870,"_28376":52101,"_3083":52240},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3632":415,"_31184":362,"_21603":52242,"_5":14870,"_28376":52101,"_3083":52243},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3632":416,"_31184":362,"_21603":52245,"_5":14870,"_28376":52101,"_3083":52246},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3632":417,"_31184":362,"_21603":52248,"_5":14870,"_28376":52101,"_3083":52249},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3632":418,"_31184":362,"_21603":52251,"_5":14870,"_28376":52101,"_3083":52252},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3632":419,"_31184":362,"_21603":52254,"_5":14870,"_28376":52105,"_3083":52255},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3632":420,"_31184":362,"_21603":52257,"_5":14870,"_28376":52105,"_3083":52258},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3632":421,"_31184":362,"_21603":52260,"_5":14870,"_28376":52105,"_3083":52261},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3632":422,"_31184":362,"_21603":52263,"_5":14870,"_28376":52105,"_3083":52264},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3632":423,"_31184":423,"_5":15230,"_3083":52266,"_31543":52267,"_21603":52269,"_28376":423},"Deployment troubleshooting",[50996,50997,52268],"Operations",[],{"_3632":424,"_31184":423,"_21603":52271,"_5":14870,"_28376":423,"_3083":52272},[],"Diagnose access, service health and infrastructure dependencies.",{"_3632":425,"_31184":423,"_5":31540,"_21603":52274,"_28376":52275,"_3083":52276},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3632":426,"_31184":423,"_5":31540,"_21603":52278,"_28376":52279,"_3083":52280},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3632":427,"_31184":423,"_5":31540,"_21603":52282,"_28376":52283,"_3083":52284},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3632":428,"_31184":423,"_5":31540,"_21603":52286,"_28376":52287,"_3083":52288},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3632":429,"_31184":423,"_5":31540,"_21603":52290,"_28376":52291,"_3083":52292},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3632":430,"_31184":423,"_5":31540,"_21603":52294,"_28376":52295,"_3083":52296},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3632":431,"_31184":423,"_5":31540,"_21603":52298,"_28376":52299,"_3083":52300},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3632":432,"_31184":423,"_5":31540,"_21603":52302,"_28376":52303,"_3083":52304},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3632":433,"_31184":423,"_5":31540,"_21603":52306,"_28376":52307,"_3083":52308},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3632":434,"_31184":423,"_5":31540,"_21603":52310,"_28376":52311,"_3083":52312},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3632":435,"_31184":423,"_5":31540,"_21603":52314,"_28376":52315,"_3083":52316},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3632":436,"_31184":423,"_5":31540,"_21603":52318,"_28376":52319,"_3083":52320},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3632":437,"_31184":423,"_5":31540,"_21603":52322,"_28376":52323,"_3083":52324},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#observability","Observability",{"_3632":438,"_31184":423,"_21603":52326,"_5":14870,"_28376":423,"_3083":52327},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3632":439,"_31184":423,"_21603":52329,"_5":14870,"_28376":52279,"_3083":52330},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3632":440,"_31184":423,"_21603":52332,"_5":14870,"_28376":52283,"_3083":52333},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3632":441,"_31184":423,"_21603":52335,"_5":14870,"_28376":52287,"_3083":52336},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3632":442,"_31184":423,"_21603":52338,"_5":14870,"_28376":52291,"_3083":52339},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3632":443,"_31184":423,"_21603":52341,"_5":14870,"_28376":52295,"_3083":52342},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3632":444,"_31184":423,"_21603":52344,"_5":14870,"_28376":52299,"_3083":52345},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3632":445,"_31184":423,"_21603":52347,"_5":14870,"_28376":52299,"_3083":52348},[],"Also run the chart's connectivity test:",{"_3632":446,"_31184":423,"_21603":52350,"_5":14870,"_28376":52299,"_3083":52351},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3632":447,"_31184":423,"_21603":52353,"_5":14870,"_28376":52299,"_3083":52354},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3632":448,"_31184":423,"_21603":52356,"_5":14870,"_28376":52303,"_3083":52357},[],"If you receive a 401:",{"_3632":449,"_31184":423,"_21603":52359,"_5":14870,"_28376":52303,"_3083":52360},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3632":450,"_31184":423,"_21603":52362,"_5":14870,"_28376":52303,"_3083":52363},[],"verify issuer, audience and expiration of the token;",{"_3632":451,"_31184":423,"_21603":52365,"_5":14870,"_28376":52303,"_3083":52366},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3632":452,"_31184":423,"_21603":52368,"_5":14870,"_28376":52303,"_3083":52369},[],"check that the provider's public and internal routes point to the same realm.",{"_3632":453,"_31184":423,"_21603":52371,"_5":14870,"_28376":52303,"_3083":52372},[],"If login succeeds but the APIs return 403:",{"_3632":454,"_31184":423,"_21603":52374,"_5":14870,"_28376":52303,"_3083":52375},[],"inspect the token's real claims;",{"_3632":455,"_31184":423,"_21603":52377,"_5":14870,"_28376":52303,"_3083":52378},[],"confirm they match an active principal;",{"_3632":456,"_31184":423,"_21603":52380,"_5":14870,"_28376":52303,"_3083":52381},[],"review the policies granted to that principal;",{"_3632":457,"_31184":423,"_21603":52383,"_5":14870,"_28376":52303,"_3083":52384},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3632":458,"_31184":423,"_21603":52386,"_5":14870,"_28376":52303,"_3083":52387},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3632":459,"_31184":423,"_21603":52389,"_5":14870,"_28376":52307,"_3083":52390},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3632":460,"_31184":423,"_21603":52392,"_5":14870,"_28376":52307,"_3083":52393},[],"Locate the authz pod and Service.",{"_3632":461,"_31184":423,"_21603":52395,"_5":14870,"_28376":52307,"_3083":52396},[],"Check /health, logs and its database connection.",{"_3632":462,"_31184":423,"_21603":52398,"_5":14870,"_28376":52307,"_3083":52399},[],"Verify the DNS and port configured in externalAuthorization.",{"_3632":463,"_31184":423,"_21603":52401,"_5":14870,"_28376":52307,"_3083":52402},[],"Check the check route is /v1/ext\\_authz/check.",{"_3632":464,"_31184":423,"_21603":52404,"_5":14870,"_28376":52307,"_3083":52405},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3632":465,"_31184":423,"_21603":52407,"_5":14870,"_28376":52311,"_3083":52408},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3632":466,"_31184":423,"_21603":52410,"_5":14870,"_28376":52315,"_3083":52411},[],"Review kubectl describe pod first. Common causes are:",{"_3632":467,"_31184":423,"_21603":52413,"_5":14870,"_28376":52315,"_3083":52414},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3632":468,"_31184":423,"_21603":52416,"_5":14870,"_28376":52315,"_3083":52417},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3632":469,"_31184":423,"_21603":52419,"_5":14870,"_28376":52315,"_3083":52420},[],"unbound persistent volume;",{"_3632":470,"_31184":423,"_21603":52422,"_5":14870,"_28376":52315,"_3083":52423},[],"inaccessible image or incorrect pull policy;",{"_3632":471,"_31184":423,"_21603":52425,"_5":14870,"_28376":52315,"_3083":52426},[],"invalid cryptographic engine configuration;",{"_3632":472,"_31184":423,"_21603":52428,"_5":14870,"_28376":52315,"_3083":52429},[],"CPU or memory limits set too low;",{"_3632":473,"_31184":423,"_21603":52431,"_5":14870,"_28376":52315,"_3083":52432},[],"an incomplete prior migration.",{"_3632":474,"_31184":423,"_21603":52434,"_5":14870,"_28376":52315,"_3083":52435},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3632":475,"_31184":423,"_21603":52437,"_5":14870,"_28376":52315,"_3083":52438},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3632":476,"_31184":423,"_21603":52440,"_5":14870,"_28376":52315,"_3083":52441},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3632":477,"_31184":423,"_21603":52443,"_5":14870,"_28376":52319,"_3083":52444},[],"Domain and audit events depend on the bus publisher:",{"_3632":478,"_31184":423,"_21603":52446,"_5":14870,"_28376":52319,"_3083":52447},[],"verify it is enabled in the emitting service;",{"_3632":479,"_31184":423,"_21603":52449,"_5":14870,"_28376":52319,"_3083":52450},[],"check AMQP connectivity and credentials;",{"_3632":480,"_31184":423,"_21603":52452,"_5":14870,"_28376":52319,"_3083":52453},[],"review exchange, routing key, queues and consumers;",{"_3632":481,"_31184":423,"_21603":52455,"_5":14870,"_28376":52319,"_3083":52456},[],"inspect dead-letter queues;",{"_3632":482,"_31184":423,"_21603":52458,"_5":14870,"_28376":52319,"_3083":52459},[],"alert on orphan durable queues and backlog growth.",{"_3632":483,"_31184":423,"_21603":52461,"_5":14870,"_28376":52319,"_3083":52462},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3632":484,"_31184":423,"_21603":52464,"_5":14870,"_28376":52319,"_3083":52465},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3632":485,"_31184":423,"_21603":52467,"_5":14870,"_28376":52319,"_3083":52468},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3632":486,"_31184":423,"_21603":52470,"_5":14870,"_28376":52319,"_3083":52471},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3632":487,"_31184":423,"_21603":52473,"_5":14870,"_28376":52319,"_3083":52474},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3632":488,"_31184":423,"_21603":52476,"_5":14870,"_28376":52319,"_3083":52477},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3632":489,"_31184":423,"_21603":52479,"_5":14870,"_28376":52319,"_3083":52480},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3632":490,"_31184":423,"_21603":52482,"_5":14870,"_28376":52323,"_3083":52483},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3632":491,"_31184":423,"_21603":52485,"_5":14870,"_28376":52323,"_3083":52486},[],"Before closing an incident, record:",{"_3632":492,"_31184":423,"_21603":52488,"_5":14870,"_28376":52323,"_3083":52489},[],"the confirmed cause;",{"_3632":493,"_31184":423,"_21603":52491,"_5":14870,"_28376":52323,"_3083":52492},[],"the time scope and affected resources;",{"_3632":494,"_31184":423,"_21603":52494,"_5":14870,"_28376":52323,"_3083":52495},[],"the commands or queries used;",{"_3632":495,"_31184":423,"_21603":52497,"_5":14870,"_28376":52323,"_3083":52498},[],"the applied change and how to revert it;",{"_3632":496,"_31184":423,"_21603":52500,"_5":14870,"_28376":52323,"_3083":52501},[],"validation from a consumer;",{"_3632":497,"_31184":423,"_21603":52503,"_5":14870,"_28376":52323,"_3083":52504},[],"the preventive action and its owner.",{"_3632":498,"_31184":498,"_5":15230,"_3083":52506,"_31543":52507,"_21603":52511,"_28376":498},"Data model",[50996,52508,52509,52510],"Platform","Administration","Access control",[],{"_3632":499,"_31184":498,"_21603":52513,"_5":14870,"_28376":498,"_3083":52514},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3632":500,"_31184":498,"_5":31540,"_21603":52516,"_28376":52517,"_3083":52518},[],"/docs/pr-preview/pr-75/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3632":501,"_31184":498,"_5":31540,"_21603":52520,"_28376":52521,"_3083":52522},[],"/docs/pr-preview/pr-75/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3632":502,"_31184":498,"_21603":52524,"_5":14870,"_28376":498,"_3083":52525},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3632":503,"_31184":498,"_21603":52527,"_5":14870,"_28376":52517,"_3083":52528},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3632":504,"_31184":498,"_21603":52530,"_5":14870,"_28376":52517,"_3083":52531},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3632":505,"_31184":498,"_21603":52533,"_5":14870,"_28376":52517,"_3083":52534},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3632":506,"_31184":498,"_21603":52536,"_5":14870,"_28376":52521,"_3083":52537},[],"Entity (`schema_name.entity_type`)",{"_3632":507,"_31184":498,"_21603":52539,"_5":14870,"_28376":52521,"_3083":52540},[],"Table (`table_name`)",{"_3632":508,"_31184":498,"_21603":52542,"_5":14870,"_28376":52521,"_3083":52543},[],"Key (`primary_key`)",{"_3632":509,"_31184":498,"_21603":52545,"_5":14870,"_28376":52521,"_3083":52546},[],"`alerts.event`",{"_3632":510,"_31184":498,"_21603":52548,"_5":14870,"_28376":52521,"_3083":52549},[],"`events`",{"_3632":511,"_31184":498,"_21603":52551,"_5":14870,"_28376":52521,"_3083":52552},[],"`event_type`",{"_3632":512,"_31184":498,"_21603":52554,"_5":14870,"_28376":52521,"_3083":52555},[],"`alerts.subscription`",{"_3632":513,"_31184":498,"_21603":52557,"_5":14870,"_28376":52521,"_3083":52558},[],"`subscriptions`",{"_3632":514,"_31184":498,"_21603":52560,"_5":14870,"_28376":52521,"_3083":52561},[],"`id`",{"_3632":515,"_31184":498,"_21603":52563,"_5":14870,"_28376":52521,"_3083":52564},[],"`ca.ca_certificate`",{"_3632":516,"_31184":498,"_21603":52566,"_5":14870,"_28376":52521,"_3083":52567},[],"`ca_certificates`",{"_3632":517,"_31184":498,"_21603":52569,"_5":14870,"_28376":52521,"_3083":52561},[],{"_3632":518,"_31184":498,"_21603":52571,"_5":14870,"_28376":52521,"_3083":52572},[],"`ca.certificate`",{"_3632":519,"_31184":498,"_21603":52574,"_5":14870,"_28376":52521,"_3083":52575},[],"`certificates`",{"_3632":520,"_31184":498,"_21603":52577,"_5":14870,"_28376":52521,"_3083":52578},[],"`serial_number`",{"_3632":521,"_31184":498,"_21603":52580,"_5":14870,"_28376":52521,"_3083":52581},[],"`ca.issuance_profile`",{"_3632":522,"_31184":498,"_21603":52583,"_5":14870,"_28376":52521,"_3083":52584},[],"`issuance_profiles`",{"_3632":523,"_31184":498,"_21603":52586,"_5":14870,"_28376":52521,"_3083":52561},[],{"_3632":524,"_31184":498,"_21603":52588,"_5":14870,"_28376":52521,"_3083":52589},[],"`devicemanager.device_group`",{"_3632":525,"_31184":498,"_21603":52591,"_5":14870,"_28376":52521,"_3083":52592},[],"`device_groups`",{"_3632":526,"_31184":498,"_21603":52594,"_5":14870,"_28376":52521,"_3083":52561},[],{"_3632":527,"_31184":498,"_21603":52596,"_5":14870,"_28376":52521,"_3083":52597},[],"`devicemanager.device`",{"_3632":528,"_31184":498,"_21603":52599,"_5":14870,"_28376":52521,"_3083":52600},[],"`devices`",{"_3632":529,"_31184":498,"_21603":52602,"_5":14870,"_28376":52521,"_3083":52561},[],{"_3632":530,"_31184":498,"_21603":52604,"_5":14870,"_28376":52521,"_3083":52605},[],"`dmsmanager.dms`",{"_3632":531,"_31184":498,"_21603":52607,"_5":14870,"_28376":52521,"_3083":52608},[],"`dms`",{"_3632":532,"_31184":498,"_21603":52610,"_5":14870,"_28376":52521,"_3083":52561},[],{"_3632":533,"_31184":498,"_21603":52612,"_5":14870,"_28376":52521,"_3083":52613},[],"`kms.kms_key`",{"_3632":534,"_31184":498,"_21603":52615,"_5":14870,"_28376":52521,"_3083":52616},[],"`kms_keys`",{"_3632":535,"_31184":498,"_21603":52618,"_5":14870,"_28376":52521,"_3083":52619},[],"`key_id`, `engine_id`",{"_3632":536,"_31184":498,"_21603":52621,"_5":14870,"_28376":52521,"_3083":52622},[],"`va.crl_settings`",{"_3632":537,"_31184":498,"_21603":52624,"_5":14870,"_28376":52521,"_3083":52625},[],"`crl_settings`",{"_3632":538,"_31184":498,"_21603":52627,"_5":14870,"_28376":52521,"_3083":52628},[],"`ca_id`",{"_3632":539,"_31184":498,"_21603":52630,"_5":14870,"_28376":52521,"_3083":52631},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3632":540,"_31184":498,"_21603":52633,"_5":14870,"_28376":52521,"_3083":52634},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3632":541,"_31184":498,"_21603":52636,"_5":14870,"_28376":52521,"_3083":52637},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3632":542,"_31184":542,"_5":15230,"_3083":52639,"_31543":52640,"_21603":52641,"_28376":542},"Access control overview",[50996,52508,52509,52510],[],{"_3632":543,"_31184":542,"_21603":52643,"_5":14870,"_28376":542,"_3083":52644},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3632":544,"_31184":542,"_5":31540,"_21603":52646,"_28376":52647,"_3083":52648},[],"/docs/pr-preview/pr-75/platform/administration/access-control#essential-concepts","Essential concepts",{"_3632":545,"_31184":542,"_5":31540,"_21603":52650,"_28376":52651,"_3083":52652},[],"/docs/pr-preview/pr-75/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3632":546,"_31184":542,"_5":31540,"_21603":52654,"_28376":52655,"_3083":52656},[],"/docs/pr-preview/pr-75/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3632":547,"_31184":542,"_5":31540,"_21603":52658,"_28376":52659,"_3083":52660},[],"/docs/pr-preview/pr-75/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3632":548,"_31184":542,"_5":31540,"_21603":52662,"_28376":52663,"_3083":52664},[],"/docs/pr-preview/pr-75/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3632":549,"_31184":542,"_5":31540,"_21603":52666,"_28376":52667,"_3083":52668},[],"/docs/pr-preview/pr-75/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3632":550,"_31184":542,"_5":31540,"_21603":52670,"_28376":52671,"_3083":52672},[],"/docs/pr-preview/pr-75/platform/administration/access-control#oidc-principals","OIDC principals",{"_3632":551,"_31184":542,"_5":31540,"_21603":52674,"_28376":52675,"_3083":52676},[],"/docs/pr-preview/pr-75/platform/administration/access-control#x509-principals","X.509 principals",{"_3632":552,"_31184":542,"_5":31540,"_21603":52678,"_28376":52679,"_3083":52680},[],"/docs/pr-preview/pr-75/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3632":553,"_31184":542,"_5":31540,"_21603":52682,"_28376":52683,"_3083":52684},[],"/docs/pr-preview/pr-75/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3632":554,"_31184":542,"_5":31540,"_21603":52686,"_28376":52687,"_3083":52688},[],"/docs/pr-preview/pr-75/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3632":555,"_31184":542,"_5":31540,"_21603":52690,"_28376":52691,"_3083":52692},[],"/docs/pr-preview/pr-75/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3632":556,"_31184":542,"_5":31540,"_21603":52694,"_28376":52695,"_3083":52696},[],"/docs/pr-preview/pr-75/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3632":557,"_31184":542,"_5":31540,"_21603":52698,"_28376":52699,"_3083":52700},[],"/docs/pr-preview/pr-75/platform/administration/access-control#http-rules","HTTP rules",{"_3632":558,"_31184":542,"_5":31540,"_21603":52702,"_28376":52703,"_3083":52704},[],"/docs/pr-preview/pr-75/platform/administration/access-control#included-policies","Included policies",{"_3632":559,"_31184":542,"_5":31540,"_21603":52706,"_28376":52707,"_3083":51646},[],"/docs/pr-preview/pr-75/platform/administration/access-control#provision-the-first-administrator",{"_3632":560,"_31184":542,"_5":31540,"_21603":52709,"_28376":52710,"_3083":52711},[],"/docs/pr-preview/pr-75/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3632":561,"_31184":542,"_5":31540,"_21603":52713,"_28376":52714,"_3083":52715},[],"/docs/pr-preview/pr-75/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3632":562,"_31184":542,"_5":31540,"_21603":52717,"_28376":52718,"_3083":52719},[],"/docs/pr-preview/pr-75/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3632":563,"_31184":542,"_5":31540,"_21603":52721,"_28376":52722,"_3083":52723},[],"/docs/pr-preview/pr-75/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3632":564,"_31184":542,"_5":31540,"_21603":52725,"_28376":52726,"_3083":52727},[],"/docs/pr-preview/pr-75/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3632":565,"_31184":542,"_5":31540,"_21603":52729,"_28376":52730,"_3083":52731},[],"/docs/pr-preview/pr-75/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3632":566,"_31184":542,"_5":31540,"_21603":52733,"_28376":52734,"_3083":52735},[],"/docs/pr-preview/pr-75/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3632":567,"_31184":542,"_5":31540,"_21603":52737,"_28376":52738,"_3083":52739},[],"/docs/pr-preview/pr-75/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3632":568,"_31184":542,"_5":31540,"_21603":52741,"_28376":52742,"_3083":52743},[],"/docs/pr-preview/pr-75/platform/administration/access-control#operational-checklist","Operational checklist",{"_3632":569,"_31184":542,"_5":31540,"_21603":52745,"_28376":52746,"_3083":52747},[],"/docs/pr-preview/pr-75/platform/administration/access-control#diagnostics","Diagnostics",{"_3632":570,"_31184":542,"_5":31540,"_21603":52749,"_28376":52750,"_3083":52751},[],"/docs/pr-preview/pr-75/platform/administration/access-control#the-response-is-401","The response is 401",{"_3632":571,"_31184":542,"_5":31540,"_21603":52753,"_28376":52754,"_3083":52755},[],"/docs/pr-preview/pr-75/platform/administration/access-control#the-response-is-403","The response is 403",{"_3632":572,"_31184":542,"_5":31540,"_21603":52757,"_28376":52758,"_3083":52759},[],"/docs/pr-preview/pr-75/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3632":573,"_31184":542,"_5":31540,"_21603":52761,"_28376":52762,"_3083":52763},[],"/docs/pr-preview/pr-75/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3632":574,"_31184":542,"_5":31540,"_21603":52765,"_28376":52766,"_3083":52767},[],"/docs/pr-preview/pr-75/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3632":575,"_31184":542,"_21603":52769,"_5":14870,"_28376":542,"_3083":52770},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3632":576,"_31184":542,"_21603":52772,"_5":14870,"_28376":542,"_3083":52773},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3632":577,"_31184":542,"_21603":52775,"_5":14870,"_28376":542,"_3083":52776},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3632":578,"_31184":542,"_21603":52778,"_5":14870,"_28376":52647,"_3083":52779},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3632":579,"_31184":542,"_21603":52781,"_5":14870,"_28376":52647,"_3083":52782},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3632":580,"_31184":542,"_21603":52784,"_5":14870,"_28376":52647,"_3083":52785},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3632":581,"_31184":542,"_21603":52787,"_5":14870,"_28376":52647,"_3083":52788},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3632":582,"_31184":542,"_21603":52790,"_5":14870,"_28376":52647,"_3083":52791},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3632":583,"_31184":542,"_21603":52793,"_5":14870,"_28376":52647,"_3083":52794},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3632":584,"_31184":542,"_21603":52796,"_5":14870,"_28376":52651,"_3083":52797},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3632":585,"_31184":542,"_21603":52799,"_5":14870,"_28376":52651,"_3083":52800},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3632":586,"_31184":542,"_21603":52802,"_5":14870,"_28376":52655,"_3083":52803},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3632":587,"_31184":542,"_21603":52805,"_5":14870,"_28376":52655,"_3083":52806},[],"The decision is made **before forwarding the request to the service**:",{"_3632":588,"_31184":542,"_21603":52808,"_5":14870,"_28376":52655,"_3083":52809},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3632":589,"_31184":542,"_21603":52811,"_5":14870,"_28376":52655,"_3083":52812},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3632":590,"_31184":542,"_21603":52814,"_5":14870,"_28376":52655,"_3083":52815},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3632":591,"_31184":542,"_21603":52817,"_5":14870,"_28376":52655,"_3083":52818},[],"It separately loads the policies granted to each principal.",{"_3632":592,"_31184":542,"_21603":52820,"_5":14870,"_28376":52655,"_3083":52821},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3632":593,"_31184":542,"_21603":52823,"_5":14870,"_28376":52655,"_3083":52824},[],"`authz` looks for an HTTP rule granting that action.",{"_3632":594,"_31184":542,"_21603":52826,"_5":14870,"_28376":52655,"_3083":52827},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3632":595,"_31184":542,"_21603":52829,"_5":14870,"_28376":52655,"_3083":52830},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3632":596,"_31184":542,"_21603":52832,"_5":14870,"_28376":52655,"_3083":52833},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3632":597,"_31184":542,"_21603":52835,"_5":14870,"_28376":52655,"_3083":52836},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3632":598,"_31184":542,"_21603":52838,"_5":14870,"_28376":52659,"_3083":52839},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3632":599,"_31184":542,"_21603":52841,"_5":14870,"_28376":52659,"_3083":52842},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3632":600,"_31184":542,"_21603":52844,"_5":14870,"_28376":52659,"_3083":52845},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3632":601,"_31184":542,"_21603":52847,"_5":14870,"_28376":52659,"_3083":52848},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3632":602,"_31184":542,"_21603":52850,"_5":14870,"_28376":52659,"_3083":52851},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3632":603,"_31184":542,"_21603":52853,"_5":14870,"_28376":52659,"_3083":52854},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3632":604,"_31184":542,"_21603":52856,"_5":14870,"_28376":52659,"_3083":52857},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3632":605,"_31184":542,"_21603":52859,"_5":14870,"_28376":52659,"_3083":52860},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3632":606,"_31184":542,"_21603":52862,"_5":14870,"_28376":52659,"_3083":52863},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3632":607,"_31184":542,"_21603":52865,"_5":14870,"_28376":52659,"_3083":52866},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3632":608,"_31184":542,"_21603":52868,"_5":14870,"_28376":52663,"_3083":52869},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3632":609,"_31184":542,"_21603":52871,"_5":14870,"_28376":52663,"_3083":52872},[],"The decision is made with the domain operation context:",{"_3632":610,"_31184":542,"_21603":52874,"_5":14870,"_28376":52663,"_3083":52875},[],"The middleware extracts the credential and resolves the matching principals.",{"_3632":611,"_31184":542,"_21603":52877,"_5":14870,"_28376":52663,"_3083":52878},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3632":612,"_31184":542,"_21603":52880,"_5":14870,"_28376":52663,"_3083":52881},[],"`authz` gathers the entity rules of the granted policies.",{"_3632":613,"_31184":542,"_21603":52883,"_5":14870,"_28376":52663,"_3083":52884},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3632":614,"_31184":542,"_21603":52886,"_5":14870,"_28376":52663,"_3083":52887},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3632":615,"_31184":542,"_21603":52889,"_5":14870,"_28376":52663,"_3083":52890},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3632":616,"_31184":542,"_21603":52892,"_5":14870,"_28376":52663,"_3083":52893},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3632":617,"_31184":542,"_21603":52895,"_5":14870,"_28376":52663,"_3083":52896},[],"Actions fall into two groups:",{"_3632":618,"_31184":542,"_21603":52898,"_5":14870,"_28376":52663,"_3083":52899},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3632":619,"_31184":542,"_21603":52901,"_5":14870,"_28376":52663,"_3083":52902},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3632":620,"_31184":542,"_21603":52904,"_5":14870,"_28376":52663,"_3083":52905},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3632":621,"_31184":542,"_21603":52907,"_5":14870,"_28376":52667,"_3083":52908},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3632":622,"_31184":542,"_21603":52910,"_5":14870,"_28376":52667,"_3083":52911},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3632":623,"_31184":542,"_21603":52913,"_5":14870,"_28376":52667,"_3083":52914},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3632":624,"_31184":542,"_21603":52916,"_5":14870,"_28376":52671,"_3083":52917},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3632":625,"_31184":542,"_21603":52919,"_5":14870,"_28376":52671,"_3083":52920},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3632":626,"_31184":542,"_21603":52922,"_5":14870,"_28376":52671,"_3083":52923},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3632":627,"_31184":542,"_21603":52925,"_5":14870,"_28376":52671,"_3083":52926},[],"The implemented operators are:",{"_3632":628,"_31184":542,"_21603":52928,"_5":14870,"_28376":52671,"_3083":52929},[],"`equals`, for exact equality;",{"_3632":629,"_31184":542,"_21603":52931,"_5":14870,"_28376":52671,"_3083":52932},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3632":630,"_31184":542,"_21603":52934,"_5":14870,"_28376":52671,"_3083":52935},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3632":631,"_31184":542,"_21603":52937,"_5":14870,"_28376":52671,"_3083":52938},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3632":632,"_31184":542,"_21603":52940,"_5":14870,"_28376":52675,"_3083":52941},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3632":633,"_31184":542,"_21603":52943,"_5":14870,"_28376":52675,"_3083":52944},[],"The available modes are:",{"_3632":634,"_31184":542,"_21603":52946,"_5":14870,"_28376":52675,"_3083":52947},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3632":635,"_31184":542,"_21603":52949,"_5":14870,"_28376":52675,"_3083":52950},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3632":636,"_31184":542,"_21603":52952,"_5":14870,"_28376":52675,"_3083":52953},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3632":637,"_31184":542,"_21603":52955,"_5":14870,"_28376":52675,"_3083":52956},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3632":638,"_31184":542,"_21603":52958,"_5":14870,"_28376":52675,"_3083":52959},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3632":639,"_31184":542,"_21603":52961,"_5":14870,"_28376":52675,"_3083":52962},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3632":640,"_31184":542,"_21603":52964,"_5":14870,"_28376":52679,"_3083":52965},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3632":641,"_31184":542,"_21603":52967,"_5":14870,"_28376":52679,"_3083":52968},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3632":642,"_31184":542,"_21603":52970,"_5":14870,"_28376":52679,"_3083":52971},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3632":643,"_31184":542,"_21603":52973,"_5":14870,"_28376":52679,"_3083":52974},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3632":644,"_31184":542,"_21603":52976,"_5":14870,"_28376":52687,"_3083":52977},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3632":645,"_31184":542,"_21603":52979,"_5":14870,"_28376":52687,"_3083":52980},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3632":646,"_31184":542,"_21603":52982,"_5":14870,"_28376":52691,"_3083":52983},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3632":647,"_31184":542,"_21603":52985,"_5":14870,"_28376":52691,"_3083":52986},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3632":648,"_31184":542,"_21603":52988,"_5":14870,"_28376":52691,"_3083":52989},[],"The data model shows how the resources used in entity rules are connected.",{"_3632":649,"_31184":542,"_21603":52991,"_5":14870,"_28376":52691,"_3083":52992},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3632":650,"_31184":542,"_21603":52994,"_5":14870,"_28376":52691,"_3083":52995},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3632":651,"_31184":542,"_21603":52997,"_5":14870,"_28376":52695,"_3083":52998},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3632":652,"_31184":542,"_21603":53000,"_5":14870,"_28376":52695,"_3083":53001},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3632":653,"_31184":542,"_21603":53003,"_5":14870,"_28376":52695,"_3083":53004},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3632":654,"_31184":542,"_21603":53006,"_5":14870,"_28376":52699,"_3083":53007},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3632":655,"_31184":542,"_21603":53009,"_5":14870,"_28376":52699,"_3083":53010},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3632":656,"_31184":542,"_21603":53012,"_5":14870,"_28376":52699,"_3083":53013},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3632":657,"_31184":542,"_21603":53015,"_5":14870,"_28376":52699,"_3083":53016},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3632":658,"_31184":542,"_21603":53018,"_5":14870,"_28376":52699,"_3083":53019},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3632":659,"_31184":542,"_21603":53021,"_5":14870,"_28376":52699,"_3083":53022},[],"Note that:",{"_3632":660,"_31184":542,"_21603":53024,"_5":14870,"_28376":52699,"_3083":53025},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3632":661,"_31184":542,"_21603":53027,"_5":14870,"_28376":52699,"_3083":53028},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3632":662,"_31184":542,"_21603":53030,"_5":14870,"_28376":52699,"_3083":53031},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3632":663,"_31184":542,"_21603":53033,"_5":14870,"_28376":52703,"_3083":53034},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3632":664,"_31184":542,"_21603":53036,"_5":14870,"_28376":52703,"_3083":53037},[],"full and read-only access to certificates and authorities;",{"_3632":665,"_31184":542,"_21603":53039,"_5":14870,"_28376":52703,"_3083":53040},[],"full and read-only access to the KMS;",{"_3632":666,"_31184":542,"_21603":53042,"_5":14870,"_28376":52703,"_3083":53043},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3632":667,"_31184":542,"_21603":53045,"_5":14870,"_28376":52703,"_3083":53046},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3632":668,"_31184":542,"_21603":53048,"_5":14870,"_28376":52703,"_3083":53049},[],"console access;",{"_3632":669,"_31184":542,"_21603":53051,"_5":14870,"_28376":52703,"_3083":53052},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3632":670,"_31184":542,"_21603":53054,"_5":14870,"_28376":52703,"_3083":53055},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3632":671,"_31184":542,"_21603":53057,"_5":14870,"_28376":52703,"_3083":53058},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3632":672,"_31184":542,"_21603":53060,"_5":14870,"_28376":52703,"_3083":53061},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3632":673,"_31184":542,"_21603":53063,"_5":14870,"_28376":52703,"_3083":53064},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3632":674,"_31184":542,"_21603":53066,"_5":14870,"_28376":52707,"_3083":53067},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3632":675,"_31184":542,"_21603":53069,"_5":14870,"_28376":52707,"_3083":53070},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3632":676,"_31184":542,"_21603":53072,"_5":14870,"_28376":52707,"_3083":53073},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3632":677,"_31184":542,"_21603":53075,"_5":14870,"_28376":52710,"_3083":53076},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3632":678,"_31184":542,"_21603":53078,"_5":14870,"_28376":52714,"_3083":53079},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3632":679,"_31184":542,"_21603":53081,"_5":14870,"_28376":52714,"_3083":53082},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3632":680,"_31184":542,"_21603":53084,"_5":14870,"_28376":52718,"_3083":53085},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3632":681,"_31184":542,"_21603":53087,"_5":14870,"_28376":52722,"_3083":53088},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3632":682,"_31184":542,"_21603":53090,"_5":14870,"_28376":52726,"_3083":53091},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3632":683,"_31184":542,"_21603":53093,"_5":14870,"_28376":52730,"_3083":53094},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3632":684,"_31184":542,"_21603":53096,"_5":14870,"_28376":52730,"_3083":53097},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3632":685,"_31184":542,"_21603":53099,"_5":14870,"_28376":52734,"_3083":53100},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3632":686,"_31184":542,"_21603":53102,"_5":14870,"_28376":52734,"_3083":53103},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3632":687,"_31184":542,"_21603":53105,"_5":14870,"_28376":52734,"_3083":53106},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3632":688,"_31184":542,"_21603":53108,"_5":14870,"_28376":52734,"_3083":53109},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3632":689,"_31184":542,"_21603":53111,"_5":14870,"_28376":52734,"_3083":53112},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3632":690,"_31184":542,"_21603":53114,"_5":14870,"_28376":52734,"_3083":53115},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3632":691,"_31184":542,"_21603":53117,"_5":14870,"_28376":52734,"_3083":53118},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3632":692,"_31184":542,"_21603":53120,"_5":14870,"_28376":52734,"_3083":53121},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3632":693,"_31184":542,"_21603":53123,"_5":14870,"_28376":52738,"_3083":53124},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3632":694,"_31184":542,"_21603":53126,"_5":14870,"_28376":52738,"_3083":53127},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3632":695,"_31184":542,"_21603":53129,"_5":14870,"_28376":52738,"_3083":53130},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3632":696,"_31184":542,"_21603":53132,"_5":14870,"_28376":52742,"_3083":53133},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3632":697,"_31184":542,"_21603":53135,"_5":14870,"_28376":52742,"_3083":53136},[],"Use groups or stable roles for people and independent identities for automations.",{"_3632":698,"_31184":542,"_21603":53138,"_5":14870,"_28376":52742,"_3083":53139},[],"Keep at least two recovery administrators and test their access periodically.",{"_3632":699,"_31184":542,"_21603":53141,"_5":14870,"_28376":52742,"_3083":53142},[],"Review active principals, their matches and their grants after IdP changes.",{"_3632":700,"_31184":542,"_21603":53144,"_5":14870,"_28376":52742,"_3083":53145},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3632":701,"_31184":542,"_21603":53147,"_5":14870,"_28376":52742,"_3083":53148},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3632":702,"_31184":542,"_21603":53150,"_5":14870,"_28376":52742,"_3083":53151},[],"Always test one allowed and one denied operation for each role.",{"_3632":703,"_31184":542,"_21603":53153,"_5":14870,"_28376":52742,"_3083":53154},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3632":704,"_31184":542,"_21603":53156,"_5":14870,"_28376":52750,"_3083":53157},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3632":705,"_31184":542,"_21603":53159,"_5":14870,"_28376":52754,"_3083":53160},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3632":706,"_31184":542,"_21603":53162,"_5":14870,"_28376":52754,"_3083":53163},[],"that an active principal of the correct type exists;",{"_3632":707,"_31184":542,"_21603":53165,"_5":14870,"_28376":52754,"_3083":53166},[],"that the claim paths and values match the real token exactly;",{"_3632":708,"_31184":542,"_21603":53168,"_5":14870,"_28376":52754,"_3083":53169},[],"that all of the principal's conditions hold;",{"_3632":709,"_31184":542,"_21603":53171,"_5":14870,"_28376":52754,"_3083":53172},[],"that the principal has the expected policy granted;",{"_3632":710,"_31184":542,"_21603":53174,"_5":14870,"_28376":52754,"_3083":53175},[],"that the policy includes the action and the requested resource type or route;",{"_3632":711,"_31184":542,"_21603":53177,"_5":14870,"_28376":52754,"_3083":53178},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3632":712,"_31184":542,"_21603":53180,"_5":14870,"_28376":52754,"_3083":53181},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3632":713,"_31184":542,"_21603":53183,"_5":14870,"_28376":52754,"_3083":53184},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3632":714,"_31184":542,"_21603":53186,"_5":14870,"_28376":52758,"_3083":53187},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3632":715,"_31184":542,"_21603":53189,"_5":14870,"_28376":52762,"_3083":53190},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3632":716,"_31184":542,"_21603":53192,"_5":14870,"_28376":52766,"_3083":53193},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3632":717,"_31184":542,"_21603":53195,"_5":14870,"_28376":52766,"_3083":53196},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3632":718,"_31184":718,"_5":15230,"_3083":53198,"_31543":53199,"_21603":53200,"_28376":718},"Alerts and subscriptions",[50996,52508,52509],[],{"_3632":719,"_31184":718,"_21603":53202,"_5":14870,"_28376":718,"_3083":53203},[],"Send PKI events to people and external systems.",{"_3632":720,"_31184":718,"_5":31540,"_21603":53205,"_28376":53206,"_3083":53207},[],"/docs/pr-preview/pr-75/platform/administration/alerts#how-it-works","How it works",{"_3632":721,"_31184":718,"_5":31540,"_21603":53209,"_28376":53210,"_3083":53211},[],"/docs/pr-preview/pr-75/platform/administration/alerts#available-channels","Available channels",{"_3632":722,"_31184":718,"_5":31540,"_21603":53213,"_28376":53214,"_3083":53215},[],"/docs/pr-preview/pr-75/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3632":723,"_31184":718,"_5":31540,"_21603":53217,"_28376":53218,"_3083":53219},[],"/docs/pr-preview/pr-75/platform/administration/alerts#choose-the-event","Choose the event",{"_3632":724,"_31184":718,"_5":31540,"_21603":53221,"_28376":53222,"_3083":53223},[],"/docs/pr-preview/pr-75/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3632":725,"_31184":718,"_5":31540,"_21603":53225,"_28376":53226,"_3083":53227},[],"/docs/pr-preview/pr-75/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3632":726,"_31184":718,"_5":31540,"_21603":53229,"_28376":53230,"_3083":53231},[],"/docs/pr-preview/pr-75/platform/administration/alerts#review-and-activate","Review and activate",{"_3632":727,"_31184":718,"_5":31540,"_21603":53233,"_28376":53234,"_3083":53235},[],"/docs/pr-preview/pr-75/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3632":728,"_31184":718,"_5":31540,"_21603":53237,"_28376":53238,"_3083":53239},[],"/docs/pr-preview/pr-75/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3632":729,"_31184":718,"_5":31540,"_21603":53241,"_28376":53242,"_3083":53243},[],"/docs/pr-preview/pr-75/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3632":730,"_31184":718,"_5":31540,"_21603":53245,"_28376":53246,"_3083":53247},[],"/docs/pr-preview/pr-75/platform/administration/alerts#event-families","Event families",{"_3632":731,"_31184":718,"_21603":53249,"_5":14870,"_28376":718,"_3083":53250},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3632":732,"_31184":718,"_21603":53252,"_5":14870,"_28376":53206,"_3083":53253},[],"A service publishes a domain event.",{"_3632":733,"_31184":718,"_21603":53255,"_5":14870,"_28376":53206,"_3083":53256},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3632":734,"_31184":718,"_21603":53258,"_5":14870,"_28376":53206,"_3083":53259},[],"Each subscription's filter decides whether it should be notified.",{"_3632":735,"_31184":718,"_21603":53261,"_5":14870,"_28376":53206,"_3083":53262},[],"Lamassu delivers the event to the configured channel.",{"_3632":736,"_31184":718,"_21603":53264,"_5":14870,"_28376":53206,"_3083":53265},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3632":737,"_31184":718,"_21603":53267,"_5":14870,"_28376":53210,"_3083":53268},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3632":738,"_31184":718,"_21603":53270,"_5":14870,"_28376":53210,"_3083":53271},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3632":739,"_31184":718,"_21603":53273,"_5":14870,"_28376":53210,"_3083":53274},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3632":740,"_31184":718,"_21603":53276,"_5":14870,"_28376":53210,"_3083":53277},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3632":741,"_31184":718,"_21603":53279,"_5":14870,"_28376":53210,"_3083":53280},[],"`apikey_options` requires `header` and `key`.",{"_3632":742,"_31184":718,"_21603":53282,"_5":14870,"_28376":53210,"_3083":53283},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3632":743,"_31184":718,"_21603":53285,"_5":14870,"_28376":53210,"_3083":53286},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3632":744,"_31184":718,"_21603":53288,"_5":14870,"_28376":53210,"_3083":53289},[],"The alerts API reference documents the full `http_client` schema.",{"_3632":745,"_31184":718,"_21603":53291,"_5":14870,"_28376":53218,"_3083":53292},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3632":746,"_31184":718,"_21603":53294,"_5":14870,"_28376":53222,"_3083":53295},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3632":747,"_31184":718,"_21603":53297,"_5":14870,"_28376":53226,"_3083":53298},[],"Add a filter if you don't want to receive every instance of the event.",{"_3632":748,"_31184":718,"_21603":53300,"_5":14870,"_28376":53226,"_3083":53301},[],"**None** notifies all instances of the event.",{"_3632":749,"_31184":718,"_21603":53303,"_5":14870,"_28376":53226,"_3083":53304},[],"**JSON Path** evaluates one or more specific fields.",{"_3632":750,"_31184":718,"_21603":53306,"_5":14870,"_28376":53226,"_3083":53307},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3632":751,"_31184":718,"_21603":53309,"_5":14870,"_28376":53226,"_3083":53310},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3632":752,"_31184":718,"_21603":53312,"_5":14870,"_28376":53226,"_3083":53313},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3632":753,"_31184":718,"_21603":53315,"_5":14870,"_28376":53226,"_3083":53316},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3632":754,"_31184":718,"_21603":53318,"_5":14870,"_28376":53230,"_3083":53319},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3632":755,"_31184":718,"_21603":53321,"_5":14870,"_28376":53234,"_3083":53322},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3632":756,"_31184":718,"_21603":53324,"_5":14870,"_28376":53234,"_3083":53325},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3632":757,"_31184":718,"_21603":53327,"_5":14870,"_28376":53234,"_3083":53328},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3632":758,"_31184":718,"_21603":53330,"_5":14870,"_28376":53234,"_3083":53331},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3632":759,"_31184":718,"_21603":53333,"_5":14870,"_28376":53234,"_3083":53334},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3632":760,"_31184":718,"_21603":53336,"_5":14870,"_28376":53234,"_3083":53337},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3632":761,"_31184":718,"_21603":53339,"_5":14870,"_28376":53234,"_3083":53340},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3632":762,"_31184":718,"_21603":53342,"_5":14870,"_28376":53234,"_3083":53343},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3632":763,"_31184":718,"_21603":53345,"_5":14870,"_28376":53238,"_3083":53346},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3632":764,"_31184":718,"_21603":53348,"_5":14870,"_28376":53238,"_3083":53349},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3632":765,"_31184":718,"_21603":53351,"_5":14870,"_28376":53238,"_3083":53352},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3632":766,"_31184":718,"_21603":53354,"_5":14870,"_28376":53238,"_3083":53355},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3632":767,"_31184":718,"_21603":53357,"_5":14870,"_28376":53238,"_3083":53358},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3632":768,"_31184":718,"_21603":53360,"_5":14870,"_28376":53238,"_3083":53361},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3632":769,"_31184":718,"_21603":53363,"_5":14870,"_28376":53238,"_3083":53364},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3632":770,"_31184":718,"_21603":53366,"_5":14870,"_28376":53238,"_3083":53367},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3632":771,"_31184":718,"_21603":53369,"_5":14870,"_28376":53242,"_3083":53370},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3632":772,"_31184":718,"_21603":53372,"_5":14870,"_28376":53242,"_3083":53373},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3632":773,"_31184":718,"_21603":53375,"_5":14870,"_28376":53246,"_3083":53376},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3632":774,"_31184":718,"_21603":53378,"_5":14870,"_28376":53246,"_3083":53379},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3632":775,"_31184":718,"_21603":53381,"_5":14870,"_28376":53246,"_3083":53382},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3632":776,"_31184":718,"_21603":53384,"_5":14870,"_28376":53246,"_3083":53385},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3632":777,"_31184":718,"_21603":53387,"_5":14870,"_28376":53246,"_3083":53388},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3632":778,"_31184":718,"_21603":53390,"_5":14870,"_28376":53246,"_3083":53391},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3632":779,"_31184":718,"_21603":53393,"_5":14870,"_28376":53246,"_3083":53394},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3632":780,"_31184":718,"_21603":53396,"_5":14870,"_28376":53246,"_3083":53397},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3632":781,"_31184":718,"_21603":53399,"_5":14870,"_28376":53246,"_3083":53400},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3632":782,"_31184":718,"_21603":53402,"_5":14870,"_28376":53246,"_3083":53403},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3632":783,"_31184":783,"_5":15230,"_3083":53405,"_31543":53406,"_21603":53407,"_28376":783},"Audit logs",[50996,52508,52509],[],{"_3632":784,"_31184":783,"_21603":53409,"_5":14870,"_28376":783,"_3083":53410},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3632":785,"_31184":783,"_5":31540,"_21603":53412,"_28376":53413,"_3083":53414},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3632":786,"_31184":783,"_5":31540,"_21603":53416,"_28376":53417,"_3083":53418},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#coverage","Coverage",{"_3632":787,"_31184":783,"_5":31540,"_21603":53420,"_28376":53421,"_3083":53422},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3632":788,"_31184":783,"_5":31540,"_21603":53424,"_28376":53425,"_3083":53426},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3632":789,"_31184":783,"_5":31540,"_21603":53428,"_28376":53429,"_3083":53430},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3632":790,"_31184":783,"_5":31540,"_21603":53432,"_28376":53433,"_3083":53434},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3632":791,"_31184":783,"_5":31540,"_21603":53436,"_28376":53437,"_3083":53438},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3632":792,"_31184":783,"_5":31540,"_21603":53440,"_28376":53441,"_3083":53442},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3632":793,"_31184":783,"_5":31540,"_21603":53444,"_28376":53445,"_3083":53446},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3632":794,"_31184":783,"_5":31540,"_21603":53448,"_28376":53449,"_3083":53450},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3632":795,"_31184":783,"_5":31540,"_21603":53452,"_28376":53453,"_3083":53454},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3632":796,"_31184":783,"_21603":53456,"_5":14870,"_28376":783,"_3083":53457},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3632":797,"_31184":783,"_21603":53459,"_5":14870,"_28376":53413,"_3083":53460},[],"The audit body includes:",{"_3632":798,"_31184":783,"_21603":53462,"_5":14870,"_28376":53413,"_3083":53463},[],"input: data received by the operation;",{"_3632":799,"_31184":783,"_21603":53465,"_5":14870,"_28376":53413,"_3083":53466},[],"has\\_error: whether the service returned an error;",{"_3632":800,"_31184":783,"_21603":53468,"_5":14870,"_28376":53413,"_3083":53469},[],"output: produced result or error message;",{"_3632":801,"_31184":783,"_21603":53471,"_5":14870,"_28376":53413,"_3083":53472},[],"principals: identifiers of the principals that matched the request.",{"_3632":802,"_31184":783,"_21603":53474,"_5":14870,"_28376":53413,"_3083":53475},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3632":803,"_31184":783,"_21603":53477,"_5":14870,"_28376":53413,"_3083":53478},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3632":804,"_31184":783,"_21603":53480,"_5":14870,"_28376":53417,"_3083":53481},[],"The backend applies auditing to mutations of:",{"_3632":805,"_31184":783,"_21603":53483,"_5":14870,"_28376":53417,"_3083":53484},[],"authorities, certificates and issuance profiles;",{"_3632":806,"_31184":783,"_21603":53486,"_5":14870,"_28376":53417,"_3083":53487},[],"keys and KMS engines;",{"_3632":807,"_31184":783,"_21603":53489,"_5":14870,"_28376":53417,"_3083":53490},[],"devices and identities;",{"_3632":808,"_31184":783,"_21603":53492,"_5":14870,"_28376":53417,"_3083":53493},[],"DMSs and enrollment operations;",{"_3632":809,"_31184":783,"_21603":53495,"_5":14870,"_28376":53417,"_3083":53496},[],"validation functions and CRL;",{"_3632":810,"_31184":783,"_21603":53498,"_5":14870,"_28376":53417,"_3083":53499},[],"principals, policies and authorization grants.",{"_3632":811,"_31184":783,"_21603":53501,"_5":14870,"_28376":53417,"_3083":53502},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3632":812,"_31184":783,"_21603":53504,"_5":14870,"_28376":53421,"_3083":53505},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3632":813,"_31184":783,"_21603":53507,"_5":14870,"_28376":53421,"_3083":53508},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3632":814,"_31184":783,"_21603":53510,"_5":14870,"_28376":53421,"_3083":53511},[],"Design the consumer to:",{"_3632":815,"_31184":783,"_21603":53513,"_5":14870,"_28376":53421,"_3083":53514},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3632":816,"_31184":783,"_21603":53516,"_5":14870,"_28376":53421,"_3083":53517},[],"keep the complete CloudEvent unmodified;",{"_3632":817,"_31184":783,"_21603":53519,"_5":14870,"_28376":53421,"_3083":53520},[],"record the ingestion time and detect duplicates by ID;",{"_3632":818,"_31184":783,"_21603":53522,"_5":14870,"_28376":53421,"_3083":53523},[],"encrypt in transit and at rest;",{"_3632":819,"_31184":783,"_21603":53525,"_5":14870,"_28376":53421,"_3083":53526},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3632":820,"_31184":783,"_21603":53528,"_5":14870,"_28376":53421,"_3083":53529},[],"apply an explicit retention and legal hold policy;",{"_3632":821,"_31184":783,"_21603":53531,"_5":14870,"_28376":53421,"_3083":53532},[],"alert if it stops consuming or the pending queue grows.",{"_3632":822,"_31184":783,"_21603":53534,"_5":14870,"_28376":53425,"_3083":53535},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3632":823,"_31184":783,"_21603":53537,"_5":14870,"_28376":53425,"_3083":53538},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3632":824,"_31184":783,"_21603":53540,"_5":14870,"_28376":53433,"_3083":53541},[],"Start from the reported time and normalize every source to UTC.",{"_3632":825,"_31184":783,"_21603":53543,"_5":14870,"_28376":53437,"_3083":53544},[],"Filter by event type, service source and resource identifier.",{"_3632":826,"_31184":783,"_21603":53546,"_5":14870,"_28376":53441,"_3083":53547},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3632":827,"_31184":783,"_21603":53549,"_5":14870,"_28376":53445,"_3083":53550},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3632":828,"_31184":783,"_21603":53552,"_5":14870,"_28376":53449,"_3083":53553},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3632":829,"_31184":783,"_21603":53555,"_5":14870,"_28376":53453,"_3083":53556},[],"Generate a controlled mutation in a test environment and check that:",{"_3632":830,"_31184":783,"_21603":53558,"_5":14870,"_28376":53453,"_3083":53559},[],"a successful audit event appears;",{"_3632":831,"_31184":783,"_21603":53561,"_5":14870,"_28376":53453,"_3083":53562},[],"the principal matches the identity used;",{"_3632":832,"_31184":783,"_21603":53564,"_5":14870,"_28376":53453,"_3083":53565},[],"the consumer persists it exactly once;",{"_3632":833,"_31184":783,"_21603":53567,"_5":14870,"_28376":53453,"_3083":53568},[],"it can be retrieved by resource, actor and period;",{"_3632":834,"_31184":783,"_21603":53570,"_5":14870,"_28376":53453,"_3083":53571},[],"a consumer outage raises an alert.",{"_3632":835,"_31184":783,"_21603":53573,"_5":14870,"_28376":53453,"_3083":53574},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3632":836,"_31184":836,"_5":15230,"_3083":53576,"_31543":53577,"_21603":53578,"_28376":836},"Platform architecture",[50996,52508],[],{"_3632":837,"_31184":836,"_21603":53580,"_5":14870,"_28376":836,"_3083":53581},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3632":838,"_31184":836,"_5":31540,"_21603":53583,"_28376":53584,"_3083":53585},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#control-plane","Control plane",{"_3632":839,"_31184":836,"_5":31540,"_21603":53587,"_28376":53588,"_3083":53589},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3632":840,"_31184":836,"_5":31540,"_21603":53591,"_28376":53592,"_3083":53593},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3632":841,"_31184":836,"_5":31540,"_21603":53595,"_28376":53596,"_3083":53597},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#status-and-validation","Status and validation",{"_3632":842,"_31184":836,"_5":31540,"_21603":53599,"_28376":53600,"_3083":53601},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3632":843,"_31184":836,"_21603":53603,"_5":14870,"_28376":836,"_3083":53604},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3632":844,"_31184":836,"_21603":53606,"_5":14870,"_28376":836,"_3083":53607},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3632":845,"_31184":836,"_21603":53609,"_5":14870,"_28376":53584,"_3083":53610},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3632":846,"_31184":836,"_21603":53612,"_5":14870,"_28376":53588,"_3083":53613},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3632":847,"_31184":836,"_21603":53615,"_5":14870,"_28376":53592,"_3083":53616},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3632":848,"_31184":836,"_21603":53618,"_5":14870,"_28376":53596,"_3083":53619},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3632":849,"_31184":836,"_21603":53621,"_5":14870,"_28376":53600,"_3083":53622},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3632":850,"_31184":850,"_5":15230,"_3083":53624,"_31543":53625,"_21603":53626,"_28376":850},"How Lamassu works",[50996,52508],[],{"_3632":851,"_31184":850,"_21603":53628,"_5":14870,"_28376":850,"_3083":53629},[],"The mental model of trust, keys, certificates and devices.",{"_3632":852,"_31184":850,"_5":31540,"_21603":53631,"_28376":53632,"_3083":53633},[],"/docs/pr-preview/pr-75/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3632":853,"_31184":850,"_5":31540,"_21603":53635,"_28376":53636,"_3083":53637},[],"/docs/pr-preview/pr-75/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3632":854,"_31184":850,"_21603":53639,"_5":14870,"_28376":850,"_3083":53640},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3632":855,"_31184":850,"_21603":53642,"_5":14870,"_28376":53632,"_3083":53643},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3632":856,"_31184":850,"_21603":53645,"_5":14870,"_28376":53632,"_3083":53646},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3632":857,"_31184":850,"_21603":53648,"_5":14870,"_28376":53632,"_3083":53649},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3632":858,"_31184":850,"_21603":53651,"_5":14870,"_28376":53632,"_3083":53652},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3632":859,"_31184":850,"_21603":53654,"_5":14870,"_28376":53632,"_3083":53655},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3632":860,"_31184":850,"_21603":53657,"_5":14870,"_28376":53636,"_3083":53658},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3632":861,"_31184":850,"_21603":53660,"_5":14870,"_28376":53636,"_3083":53661},[],"A DMS relates that CA to an enrollment policy.",{"_3632":862,"_31184":850,"_21603":53663,"_5":14870,"_28376":53636,"_3083":53664},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3632":863,"_31184":850,"_21603":53666,"_5":14870,"_28376":53636,"_3083":53667},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3632":864,"_31184":850,"_21603":53669,"_5":14870,"_28376":53636,"_3083":53670},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3632":865,"_31184":850,"_21603":53672,"_5":14870,"_28376":53636,"_3083":53673},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3632":866,"_31184":850,"_21603":53675,"_5":14870,"_28376":53636,"_3083":53676},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3632":867,"_31184":867,"_5":15230,"_3083":53678,"_31543":53679,"_21603":53681,"_28376":867},"Devices and identities",[50996,52508,53680,53678],"IoT Fleets",[],{"_3632":868,"_31184":867,"_21603":53683,"_5":14870,"_28376":867,"_3083":53684},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3632":869,"_31184":867,"_5":31540,"_21603":53686,"_28376":53687,"_3083":53688},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","Device states",{"_3632":870,"_31184":867,"_5":31540,"_21603":53690,"_28376":53691,"_3083":53692},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3632":871,"_31184":867,"_5":31540,"_21603":53694,"_28376":53695,"_3083":53696},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3632":872,"_31184":867,"_5":31540,"_21603":53698,"_28376":53699,"_3083":53700},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3632":873,"_31184":867,"_5":31540,"_21603":53702,"_28376":53703,"_3083":53704},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3632":874,"_31184":867,"_5":31540,"_21603":53706,"_28376":53707,"_3083":53708},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3632":875,"_31184":867,"_5":31540,"_21603":53710,"_28376":53711,"_3083":53712},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3632":876,"_31184":867,"_5":31540,"_21603":53714,"_28376":53715,"_3083":53716},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3632":877,"_31184":867,"_5":31540,"_21603":53718,"_28376":53719,"_3083":53720},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3632":878,"_31184":867,"_5":31540,"_21603":53722,"_28376":53723,"_3083":53724},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3632":879,"_31184":867,"_5":31540,"_21603":53726,"_28376":53727,"_3083":53728},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3632":880,"_31184":867,"_21603":53730,"_5":14870,"_28376":867,"_3083":53731},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3632":881,"_31184":867,"_21603":53733,"_5":14870,"_28376":867,"_3083":53734},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3632":882,"_31184":867,"_21603":53736,"_5":14870,"_28376":53687,"_3083":53737},[],"Operational view",{"_3632":883,"_31184":867,"_21603":53739,"_5":14870,"_28376":53687,"_3083":53740},[],"Meaning",{"_3632":884,"_31184":867,"_21603":53742,"_5":14870,"_28376":53687,"_3083":53743},[],"**No Identity**",{"_3632":885,"_31184":867,"_21603":53745,"_5":14870,"_28376":53687,"_3083":53746},[],"A record exists without an associated identity.",{"_3632":886,"_31184":867,"_21603":53748,"_5":14870,"_28376":53687,"_3083":53749},[],"**Active**",{"_3632":887,"_31184":867,"_21603":53751,"_5":14870,"_28376":53687,"_3083":53752},[],"The slot is active; also check certificate dates, status and usages.",{"_3632":888,"_31184":867,"_21603":53754,"_5":14870,"_28376":53687,"_3083":53755},[],"**Renewal Pending**",{"_3632":889,"_31184":867,"_21603":53757,"_5":14870,"_28376":53687,"_3083":53758},[],"The identity is in the operational renewal window.",{"_3632":890,"_31184":867,"_21603":53760,"_5":14870,"_28376":53687,"_3083":53761},[],"**Expiring Soon**",{"_3632":891,"_31184":867,"_21603":53763,"_5":14870,"_28376":53687,"_3083":53764},[],"Expiration is approaching according to configured thresholds.",{"_3632":892,"_31184":867,"_21603":53766,"_5":14870,"_28376":53687,"_3083":53767},[],"**Expired**",{"_3632":893,"_31184":867,"_21603":53769,"_5":14870,"_28376":53687,"_3083":53770},[],"The identity has expired.",{"_3632":894,"_31184":867,"_21603":53772,"_5":14870,"_28376":53687,"_3083":53773},[],"**Revoked**",{"_3632":895,"_31184":867,"_21603":53775,"_5":14870,"_28376":53687,"_3083":53776},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3632":896,"_31184":867,"_21603":53778,"_5":14870,"_28376":53687,"_3083":53779},[],"**Decommissioned**",{"_3632":897,"_31184":867,"_21603":53781,"_5":14870,"_28376":53687,"_3083":53782},[],"The record is retired and ordinary updates do not restore operation.",{"_3632":898,"_31184":867,"_21603":53784,"_5":14870,"_28376":53687,"_3083":53785},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3632":899,"_31184":867,"_21603":53787,"_5":14870,"_28376":53691,"_3083":53788},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3632":900,"_31184":867,"_21603":53790,"_5":14870,"_28376":53691,"_3083":53791},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3632":901,"_31184":867,"_21603":53793,"_5":14870,"_28376":53691,"_3083":53794},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3632":902,"_31184":867,"_21603":53796,"_5":14870,"_28376":53691,"_3083":53797},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3632":903,"_31184":867,"_21603":53799,"_5":14870,"_28376":53695,"_3083":53800},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3632":904,"_31184":867,"_21603":53802,"_5":14870,"_28376":53699,"_3083":53803},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3632":905,"_31184":867,"_21603":53805,"_5":14870,"_28376":53703,"_3083":53806},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3632":906,"_31184":867,"_21603":53808,"_5":14870,"_28376":53707,"_3083":53809},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3632":907,"_31184":867,"_21603":53811,"_5":14870,"_28376":53711,"_3083":53812},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3632":908,"_31184":867,"_21603":53814,"_5":14870,"_28376":53711,"_3083":53815},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3632":909,"_31184":867,"_21603":53817,"_5":14870,"_28376":53715,"_3083":53818},[],"From **No Identity**, use **Assign Identity**:",{"_3632":910,"_31184":867,"_21603":53820,"_5":14870,"_28376":53715,"_3083":53821},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3632":911,"_31184":867,"_21603":53823,"_5":14870,"_28376":53715,"_3083":53824},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3632":912,"_31184":867,"_21603":53826,"_5":14870,"_28376":53715,"_3083":53827},[],"Confirm and read the serial, active version and history again.",{"_3632":913,"_31184":867,"_21603":53829,"_5":14870,"_28376":53715,"_3083":53830},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3632":914,"_31184":867,"_21603":53832,"_5":14870,"_28376":53715,"_3083":53833},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3632":915,"_31184":867,"_21603":53835,"_5":14870,"_28376":53719,"_3083":53836},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3632":916,"_31184":867,"_21603":53838,"_5":14870,"_28376":53719,"_3083":53839},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3632":917,"_31184":867,"_21603":53841,"_5":14870,"_28376":53719,"_3083":53842},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3632":918,"_31184":867,"_21603":53844,"_5":14870,"_28376":53723,"_3083":53845},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3632":919,"_31184":867,"_21603":53847,"_5":14870,"_28376":53723,"_3083":53848},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3632":920,"_31184":867,"_21603":53850,"_5":14870,"_28376":53723,"_3083":53851},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3632":921,"_31184":867,"_21603":53853,"_5":14870,"_28376":53723,"_3083":53854},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3632":922,"_31184":867,"_21603":53856,"_5":14870,"_28376":53727,"_3083":53857},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3632":923,"_31184":867,"_21603":53859,"_5":14870,"_28376":53727,"_3083":53860},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3632":924,"_31184":924,"_5":15230,"_3083":53862,"_31543":53863,"_21603":53865,"_28376":924},"Bootstrap identity and authentication",[50996,52508,53680,53678,53864],"Enrollment with PKI",[],{"_3632":925,"_31184":924,"_21603":53867,"_5":14870,"_28376":924,"_3083":53868},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3632":926,"_31184":924,"_5":31540,"_21603":53870,"_28376":53871,"_3083":53872},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3632":927,"_31184":924,"_5":31540,"_21603":53874,"_28376":53875,"_3083":53876},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3632":928,"_31184":924,"_5":31540,"_21603":53878,"_28376":53879,"_3083":53880},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3632":929,"_31184":924,"_5":31540,"_21603":53882,"_28376":53883,"_3083":53884},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3632":930,"_31184":924,"_5":31540,"_21603":53886,"_28376":53887,"_3083":53888},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3632":931,"_31184":924,"_21603":53890,"_5":14870,"_28376":924,"_3083":53891},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3632":932,"_31184":924,"_21603":53893,"_5":14870,"_28376":53871,"_3083":53894},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3632":933,"_31184":924,"_21603":53896,"_5":14870,"_28376":53871,"_3083":53897},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3632":934,"_31184":924,"_21603":53899,"_5":14870,"_28376":53875,"_3083":53900},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3632":935,"_31184":924,"_21603":53902,"_5":14870,"_28376":53875,"_3083":53903},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3632":936,"_31184":924,"_21603":53905,"_5":14870,"_28376":53875,"_3083":53906},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3632":937,"_31184":924,"_21603":53908,"_5":14870,"_28376":53879,"_3083":53909},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3632":938,"_31184":924,"_21603":53911,"_5":14870,"_28376":53879,"_3083":53912},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3632":939,"_31184":924,"_21603":53914,"_5":14870,"_28376":53883,"_3083":53915},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3632":940,"_31184":924,"_21603":53917,"_5":14870,"_28376":53883,"_3083":53918},[],"Example body:",{"_3632":941,"_31184":924,"_21603":53920,"_5":14870,"_28376":53883,"_3083":53921},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3632":942,"_31184":924,"_21603":53923,"_5":14870,"_28376":53883,"_3083":53924},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3632":943,"_31184":924,"_21603":53926,"_5":14870,"_28376":53883,"_3083":53927},[],"Continuation requires a successful HTTP response and JSON:",{"_3632":944,"_31184":924,"_21603":53929,"_5":14870,"_28376":53883,"_3083":53930},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3632":945,"_31184":924,"_21603":53932,"_5":14870,"_28376":53887,"_3083":53933},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3632":946,"_31184":924,"_21603":53935,"_5":14870,"_28376":53887,"_3083":53936},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh — `thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old — and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3632":947,"_31184":924,"_21603":53938,"_5":14870,"_28376":53887,"_3083":53939},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3632":948,"_31184":924,"_21603":53941,"_5":14870,"_28376":53887,"_3083":53942},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3632":949,"_31184":949,"_5":15230,"_3083":53944,"_31543":53945,"_21603":53946,"_28376":949},"Configure and operate the DMS",[50996,52508,53680,53678,53864],[],{"_3632":950,"_31184":949,"_21603":53948,"_5":14870,"_28376":949,"_3083":53949},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3632":951,"_31184":949,"_5":31540,"_21603":53951,"_28376":53952,"_3083":51006},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3632":952,"_31184":949,"_5":31540,"_21603":53954,"_28376":53955,"_3083":53956},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3632":953,"_31184":949,"_5":31540,"_21603":53958,"_28376":53959,"_3083":53960},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3632":954,"_31184":949,"_5":31540,"_21603":53962,"_28376":53963,"_3083":53964},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3632":955,"_31184":949,"_5":31540,"_21603":53966,"_28376":53967,"_3083":53968},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3632":956,"_31184":949,"_5":31540,"_21603":53970,"_28376":53971,"_3083":53972},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3632":957,"_31184":949,"_5":31540,"_21603":53974,"_28376":53975,"_3083":53976},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3632":958,"_31184":949,"_5":31540,"_21603":53978,"_28376":53979,"_3083":53980},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3632":959,"_31184":949,"_5":31540,"_21603":53982,"_28376":53983,"_3083":53984},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3632":960,"_31184":949,"_5":31540,"_21603":53986,"_28376":53987,"_3083":53988},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3632":961,"_31184":949,"_5":31540,"_21603":53990,"_28376":53991,"_3083":53992},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3632":962,"_31184":949,"_5":31540,"_21603":53994,"_28376":53995,"_3083":53996},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3632":963,"_31184":949,"_5":31540,"_21603":53998,"_28376":53999,"_3083":54000},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3632":964,"_31184":949,"_5":31540,"_21603":54002,"_28376":54003,"_3083":54004},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3632":965,"_31184":949,"_5":31540,"_21603":54006,"_28376":54007,"_3083":54008},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3632":966,"_31184":949,"_5":31540,"_21603":54010,"_28376":54011,"_3083":54012},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3632":967,"_31184":949,"_5":31540,"_21603":54014,"_28376":54015,"_3083":54016},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3632":968,"_31184":949,"_5":31540,"_21603":54018,"_28376":54019,"_3083":54020},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3632":969,"_31184":949,"_21603":54022,"_5":14870,"_28376":949,"_3083":54023},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3632":970,"_31184":949,"_21603":54025,"_5":14870,"_28376":53952,"_3083":54026},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3632":971,"_31184":949,"_21603":54028,"_5":14870,"_28376":53952,"_3083":54029},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3632":972,"_31184":949,"_21603":54031,"_5":14870,"_28376":53959,"_3083":54032},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3632":973,"_31184":949,"_21603":54034,"_5":14870,"_28376":53963,"_3083":54035},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3632":974,"_31184":949,"_21603":54037,"_5":14870,"_28376":53967,"_3083":54038},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3632":975,"_31184":949,"_21603":54040,"_5":14870,"_28376":53971,"_3083":54041},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3632":976,"_31184":949,"_21603":54043,"_5":14870,"_28376":53975,"_3083":54044},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3632":977,"_31184":949,"_21603":54046,"_5":14870,"_28376":53983,"_3083":54047},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3632":978,"_31184":949,"_21603":54049,"_5":14870,"_28376":53983,"_3083":54050},[],"PRE\\_REGISTRATION requires an existing ID. An existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3632":979,"_31184":949,"_21603":54052,"_5":14870,"_28376":53987,"_3083":54053},[],"`settings.enrollment_settings` field",{"_3632":980,"_31184":949,"_21603":54055,"_5":14870,"_28376":53987,"_3083":54056},[],"Decision",{"_3632":981,"_31184":949,"_21603":54058,"_5":14870,"_28376":53987,"_3083":54059},[],"`protocol`",{"_3632":982,"_31184":949,"_21603":54061,"_5":14870,"_28376":53987,"_3083":54062},[],"`EST_RFC7030` for these operations.",{"_3632":983,"_31184":949,"_21603":54064,"_5":14870,"_28376":53987,"_3083":54065},[],"`enrollment_ca`",{"_3632":984,"_31184":949,"_21603":54067,"_5":14870,"_28376":53987,"_3083":54068},[],"ID of the signing CA.",{"_3632":985,"_31184":949,"_21603":54070,"_5":14870,"_28376":53987,"_3083":54071},[],"`verify_csr_signature`",{"_3632":986,"_31184":949,"_21603":54073,"_5":14870,"_28376":53987,"_3083":54074},[],"Keep `true` to verify CSR key possession.",{"_3632":987,"_31184":949,"_21603":54076,"_5":14870,"_28376":53987,"_3083":54077},[],"`enable_replaceable_enrollment`",{"_3632":988,"_31184":949,"_21603":54079,"_5":14870,"_28376":53987,"_3083":54080},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3632":989,"_31184":949,"_21603":54082,"_5":14870,"_28376":53987,"_3083":54083},[],"`est_rfc7030_settings.auth_mode`",{"_3632":990,"_31184":949,"_21603":54085,"_5":14870,"_28376":53987,"_3083":54086},[],"One of the four authentication modes.",{"_3632":991,"_31184":949,"_21603":54088,"_5":14870,"_28376":53987,"_3083":54089},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3632":992,"_31184":949,"_21603":54091,"_5":14870,"_28376":53991,"_3083":54092},[],"The blocks are independent:",{"_3632":993,"_31184":949,"_21603":54094,"_5":14870,"_28376":53991,"_3083":54095},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3632":994,"_31184":949,"_21603":54097,"_5":14870,"_28376":53991,"_3083":54098},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3632":995,"_31184":949,"_21603":54100,"_5":14870,"_28376":53991,"_3083":54101},[],"`auth_mode`",{"_3632":996,"_31184":949,"_21603":54103,"_5":14870,"_28376":53991,"_3083":54104},[],"Control applied in the configured operation",{"_3632":997,"_31184":949,"_21603":54106,"_5":14870,"_28376":53991,"_3083":54107},[],"`CLIENT_CERTIFICATE`",{"_3632":998,"_31184":949,"_21603":54109,"_5":14870,"_28376":53991,"_3083":54110},[],"Presented certificate validation.",{"_3632":999,"_31184":949,"_21603":54112,"_5":14870,"_28376":53991,"_3083":54113},[],"`EXTERNAL_WEBHOOK`",{"_3632":1000,"_31184":949,"_21603":54115,"_5":14870,"_28376":53991,"_3083":54116},[],"Configured webhook authorization.",{"_3632":1001,"_31184":949,"_21603":54118,"_5":14870,"_28376":53991,"_3083":54119},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3632":1002,"_31184":949,"_21603":54121,"_5":14870,"_28376":53991,"_3083":54122},[],"Certificate validation followed by webhook approval.",{"_3632":1003,"_31184":949,"_21603":54124,"_5":14870,"_28376":53991,"_3083":54125},[],"`NO_AUTH`",{"_3632":1004,"_31184":949,"_21603":54127,"_5":14870,"_28376":53991,"_3083":54128},[],"No DMS requester authentication.",{"_3632":1005,"_31184":949,"_21603":54130,"_5":14870,"_28376":53991,"_3083":54131},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3632":1006,"_31184":949,"_21603":54133,"_5":14870,"_28376":53991,"_3083":54134},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `chain_level_validation` and `allow_unverifiable_revocation`. The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3632":1007,"_31184":949,"_21603":54136,"_5":14870,"_28376":53991,"_3083":54137},[],"Revocation is checked for every presented certificate. In initial enrollment the client certificate **and** every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. A validation CA that is revoked in Lamassu rejects the operation: the first validation CA that validates the certificate is used, and a revoked one is not replaced by the remaining validation CAs. Certificates issued and managed by Lamassu are checked against their stored status. External certificates are checked through their OCSP and CRL endpoints, and the operation fails closed when revocation cannot be verified: only `allow_unverifiable_revocation` — `false` by default in both blocks — relaxes the case of an external certificate that lists no endpoint at all. Endpoints that exist but are unreachable, return stale or invalid evidence, or report an inconclusive status are always rejected, whatever the option says. The details and the evidence the endpoints must present are in Revocation and checks.",{"_3632":1008,"_31184":949,"_21603":54139,"_5":14870,"_28376":53991,"_3083":54140},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`. Re-enrollment checks revocation of the client certificate only; that check is governed by the re-enrollment block's own `allow_unverifiable_revocation`.",{"_3632":1009,"_31184":949,"_21603":54142,"_5":14870,"_28376":53991,"_3083":54143},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3632":1010,"_31184":949,"_21603":54145,"_5":14870,"_28376":53995,"_3083":54146},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3632":1011,"_31184":949,"_21603":54148,"_5":14870,"_28376":53995,"_3083":54149},[],"`external_webhook_settings` field",{"_3632":1012,"_31184":949,"_21603":54151,"_5":14870,"_28376":53995,"_3083":54056},[],{"_3632":1013,"_31184":949,"_21603":54153,"_5":14870,"_28376":53995,"_3083":54154},[],"`url`",{"_3632":1014,"_31184":949,"_21603":54156,"_5":14870,"_28376":53995,"_3083":54157},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3632":1015,"_31184":949,"_21603":54159,"_5":14870,"_28376":53995,"_3083":54160},[],"`method`",{"_3632":1016,"_31184":949,"_21603":54162,"_5":14870,"_28376":53995,"_3083":54163},[],"`POST` or `PUT`; `POST` by default.",{"_3632":1017,"_31184":949,"_21603":54165,"_5":14870,"_28376":53995,"_3083":54166},[],"`name`",{"_3632":1018,"_31184":949,"_21603":54168,"_5":14870,"_28376":53995,"_3083":54169},[],"Label used in service logs.",{"_3632":1019,"_31184":949,"_21603":54171,"_5":14870,"_28376":53995,"_3083":54172},[],"`config.auth_mode`",{"_3632":1020,"_31184":949,"_21603":54174,"_5":14870,"_28376":53995,"_3083":54175},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3632":1021,"_31184":949,"_21603":54177,"_5":14870,"_28376":53995,"_3083":54178},[],"`config.log_level`",{"_3632":1022,"_31184":949,"_21603":54180,"_5":14870,"_28376":53995,"_3083":54181},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3632":1023,"_31184":949,"_21603":54183,"_5":14870,"_28376":53995,"_3083":54184},[],"`config.apikey_options`",{"_3632":1024,"_31184":949,"_21603":54186,"_5":14870,"_28376":53995,"_3083":54187},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3632":1025,"_31184":949,"_21603":54189,"_5":14870,"_28376":53995,"_3083":54190},[],"`config.jwt_options`",{"_3632":1026,"_31184":949,"_21603":54192,"_5":14870,"_28376":53995,"_3083":54193},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3632":1027,"_31184":949,"_21603":54195,"_5":14870,"_28376":53995,"_3083":54196},[],"`config.mtls_options`",{"_3632":1028,"_31184":949,"_21603":54198,"_5":14870,"_28376":53995,"_3083":54199},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3632":1029,"_31184":949,"_21603":54201,"_5":14870,"_28376":53995,"_3083":54202},[],"`config.insecure_skip_verify`",{"_3632":1030,"_31184":949,"_21603":54204,"_5":14870,"_28376":53995,"_3083":54205},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3632":1031,"_31184":949,"_21603":54207,"_5":14870,"_28376":53995,"_3083":54208},[],"`config.call_timeout`",{"_3632":1032,"_31184":949,"_21603":54210,"_5":14870,"_28376":53995,"_3083":54211},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3632":1033,"_31184":949,"_21603":54213,"_5":14870,"_28376":53995,"_3083":54214},[],"Rules for that configuration:",{"_3632":1034,"_31184":949,"_21603":54216,"_5":14870,"_28376":53995,"_3083":54217},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3632":1035,"_31184":949,"_21603":54219,"_5":14870,"_28376":53995,"_3083":54220},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3632":1036,"_31184":949,"_21603":54222,"_5":14870,"_28376":53995,"_3083":54223},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3632":1037,"_31184":949,"_21603":54225,"_5":14870,"_28376":53995,"_3083":54226},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3632":1038,"_31184":949,"_21603":54228,"_5":14870,"_28376":53995,"_3083":54229},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3632":1039,"_31184":949,"_21603":54231,"_5":14870,"_28376":53995,"_3083":54232},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3632":1040,"_31184":949,"_21603":54234,"_5":14870,"_28376":53995,"_3083":54235},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3632":1041,"_31184":949,"_21603":54237,"_5":14870,"_28376":53995,"_3083":54238},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3632":1042,"_31184":949,"_21603":54240,"_5":14870,"_28376":53995,"_3083":54241},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3632":1043,"_31184":949,"_21603":54243,"_5":14870,"_28376":53999,"_3083":54244},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3632":1044,"_31184":949,"_21603":54246,"_5":14870,"_28376":54003,"_3083":54247},[],"`settings.reenrollment_settings` field",{"_3632":1045,"_31184":949,"_21603":54249,"_5":14870,"_28376":54003,"_3083":51386},[],{"_3632":1046,"_31184":949,"_21603":54251,"_5":14870,"_28376":54003,"_3083":54252},[],"`reenrollment_delta`",{"_3632":1047,"_31184":949,"_21603":54254,"_5":14870,"_28376":54003,"_3083":54255},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3632":1048,"_31184":949,"_21603":54257,"_5":14870,"_28376":54003,"_3083":54258},[],"`preventive_delta`",{"_3632":1049,"_31184":949,"_21603":54260,"_5":14870,"_28376":54003,"_3083":54261},[],"Preventive operational monitoring threshold.",{"_3632":1050,"_31184":949,"_21603":54263,"_5":14870,"_28376":54003,"_3083":54264},[],"`critical_delta`",{"_3632":1051,"_31184":949,"_21603":54266,"_5":14870,"_28376":54003,"_3083":54267},[],"Critical operational monitoring threshold.",{"_3632":1052,"_31184":949,"_21603":54269,"_5":14870,"_28376":54003,"_3083":54270},[],"`enable_expired_renewal`",{"_3632":1053,"_31184":949,"_21603":54272,"_5":14870,"_28376":54003,"_3083":54273},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3632":1054,"_31184":949,"_21603":54275,"_5":14870,"_28376":54003,"_3083":54276},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3632":1055,"_31184":949,"_21603":54278,"_5":14870,"_28376":54003,"_3083":54279},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3632":1056,"_31184":949,"_21603":54281,"_5":14870,"_28376":54003,"_3083":54282},[],"`revoke_on_reenrollment`",{"_3632":1057,"_31184":949,"_21603":54284,"_5":14870,"_28376":54003,"_3083":54285},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3632":1058,"_31184":949,"_21603":54287,"_5":14870,"_28376":54003,"_3083":54288},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3632":1059,"_31184":949,"_21603":54290,"_5":14870,"_28376":54007,"_3083":54291},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3632":1060,"_31184":949,"_21603":54293,"_5":14870,"_28376":54011,"_3083":51380},[],{"_3632":1061,"_31184":949,"_21603":54295,"_5":14870,"_28376":54011,"_3083":54296},[],"Published material",{"_3632":1062,"_31184":949,"_21603":54298,"_5":14870,"_28376":54011,"_3083":54299},[],"**Include Lamassu System CA**",{"_3632":1063,"_31184":949,"_21603":54301,"_5":14870,"_28376":54011,"_3083":54302},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3632":1064,"_31184":949,"_21603":54304,"_5":14870,"_28376":54011,"_3083":54305},[],"**Include Enrollment CA**",{"_3632":1065,"_31184":949,"_21603":54307,"_5":14870,"_28376":54011,"_3083":54308},[],"Selected issuing CA certificate.",{"_3632":1066,"_31184":949,"_21603":54310,"_5":14870,"_28376":54011,"_3083":54311},[],"**Managed CAs**",{"_3632":1067,"_31184":949,"_21603":54313,"_5":14870,"_28376":54011,"_3083":54314},[],"Explicitly selected CA certificates.",{"_3632":1068,"_31184":949,"_21603":54316,"_5":14870,"_28376":54011,"_3083":54317},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3632":1069,"_31184":949,"_21603":54319,"_5":14870,"_28376":54015,"_3083":54320},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3632":1070,"_31184":949,"_21603":54322,"_5":14870,"_28376":54015,"_3083":54323},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3632":1071,"_31184":949,"_21603":54325,"_5":14870,"_28376":54015,"_3083":54326},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3632":1072,"_31184":949,"_21603":54328,"_5":14870,"_28376":54019,"_3083":54329},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3632":1073,"_31184":1073,"_5":15230,"_3083":54331,"_31543":54332,"_21603":54333,"_28376":1073},"Integrate the EST client",[50996,52508,53680,53678,53864],[],{"_3632":1074,"_31184":1073,"_21603":54335,"_5":14870,"_28376":1073,"_3083":54336},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3632":1075,"_31184":1073,"_5":31540,"_21603":54338,"_28376":54339,"_3083":51006},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3632":1076,"_31184":1073,"_5":31540,"_21603":54341,"_28376":54342,"_3083":54343},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3632":1077,"_31184":1073,"_5":31540,"_21603":54345,"_28376":54346,"_3083":54347},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3632":1078,"_31184":1073,"_5":31540,"_21603":54349,"_28376":54350,"_3083":54351},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3632":1079,"_31184":1073,"_5":31540,"_21603":54353,"_28376":54354,"_3083":54355},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3632":1080,"_31184":1073,"_5":31540,"_21603":54357,"_28376":54358,"_3083":54359},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3632":1081,"_31184":1073,"_21603":54361,"_5":14870,"_28376":1073,"_3083":54362},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3632":1082,"_31184":1073,"_21603":54364,"_5":14870,"_28376":54339,"_3083":54365},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3632":1083,"_31184":1073,"_21603":54367,"_5":14870,"_28376":54339,"_3083":54368},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3632":1084,"_31184":1073,"_21603":54370,"_5":14870,"_28376":54339,"_3083":54371},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3632":1085,"_31184":1073,"_21603":54373,"_5":14870,"_28376":54342,"_3083":54374},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3632":1086,"_31184":1073,"_21603":54376,"_5":14870,"_28376":54342,"_3083":54377},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3632":1087,"_31184":1073,"_21603":54379,"_5":14870,"_28376":54346,"_3083":54380},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3632":1088,"_31184":1073,"_21603":54382,"_5":14870,"_28376":54346,"_3083":54383},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3632":1089,"_31184":1073,"_21603":54385,"_5":14870,"_28376":54350,"_3083":54386},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3632":1090,"_31184":1073,"_21603":54388,"_5":14870,"_28376":54350,"_3083":54389},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3632":1091,"_31184":1073,"_21603":54391,"_5":14870,"_28376":54354,"_3083":54392},[],"For a root that issues directly:",{"_3632":1092,"_31184":1073,"_21603":54394,"_5":14870,"_28376":54354,"_3083":54395},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3632":1093,"_31184":1073,"_21603":54397,"_5":14870,"_28376":54354,"_3083":54398},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3632":1094,"_31184":1073,"_21603":54400,"_5":14870,"_28376":54358,"_3083":54401},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3632":1095,"_31184":1095,"_5":15230,"_3083":54403,"_31543":54404,"_21603":54405,"_28376":1095},"EST reference",[50996,52508,53680,53678,53864],[],{"_3632":1096,"_31184":1095,"_21603":54407,"_5":14870,"_28376":1095,"_3083":54408},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3632":1097,"_31184":1095,"_5":31540,"_21603":54410,"_28376":54411,"_3083":54412},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3632":1098,"_31184":1095,"_5":31540,"_21603":54414,"_28376":54415,"_3083":23406},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3632":1099,"_31184":1095,"_5":31540,"_21603":54417,"_28376":54418,"_3083":26921},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3632":1100,"_31184":1095,"_5":31540,"_21603":54420,"_28376":54421,"_3083":26928},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3632":1101,"_31184":1095,"_5":31540,"_21603":54423,"_28376":54424,"_3083":26190},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3632":1102,"_31184":1095,"_5":31540,"_21603":54426,"_28376":54427,"_3083":54428},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3632":1103,"_31184":1095,"_5":31540,"_21603":54430,"_28376":54431,"_3083":54432},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3632":1104,"_31184":1095,"_5":31540,"_21603":54434,"_28376":54435,"_3083":54436},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3632":1105,"_31184":1095,"_21603":54438,"_5":14870,"_28376":1095,"_3083":54439},[],"Reference for the Lamassu EST service, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3632":1106,"_31184":1095,"_21603":54441,"_5":14870,"_28376":54411,"_3083":54442},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3632":1107,"_31184":1095,"_21603":54444,"_5":14870,"_28376":54411,"_3083":54445},[],"Operation",{"_3632":1108,"_31184":1095,"_21603":54447,"_5":14870,"_28376":54411,"_3083":54448},[],"Method",{"_3632":1109,"_31184":1095,"_21603":54450,"_5":14870,"_28376":54411,"_3083":54451},[],"Authentication and condition",{"_3632":1110,"_31184":1095,"_21603":54453,"_5":14870,"_28376":54411,"_3083":54454},[],"`/cacerts`",{"_3632":1111,"_31184":1095,"_21603":54456,"_5":14870,"_28376":54411,"_3083":54457},[],"GET",{"_3632":1112,"_31184":1095,"_21603":54459,"_5":14870,"_28376":54411,"_3083":54460},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3632":1113,"_31184":1095,"_21603":54462,"_5":14870,"_28376":54411,"_3083":54463},[],"`/simpleenroll`",{"_3632":1114,"_31184":1095,"_21603":54465,"_5":14870,"_28376":54411,"_3083":54466},[],"POST",{"_3632":1115,"_31184":1095,"_21603":54468,"_5":14870,"_28376":54411,"_3083":54469},[],"Initial authentication and DMS registration/replacement policy.",{"_3632":1116,"_31184":1095,"_21603":54471,"_5":14870,"_28376":54411,"_3083":54472},[],"`/simplereenroll`",{"_3632":1117,"_31184":1095,"_21603":54474,"_5":14870,"_28376":54411,"_3083":54466},[],{"_3632":1118,"_31184":1095,"_21603":54476,"_5":14870,"_28376":54411,"_3083":54477},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3632":1119,"_31184":1095,"_21603":54479,"_5":14870,"_28376":54411,"_3083":54480},[],"`/serverkeygen`",{"_3632":1120,"_31184":1095,"_21603":54482,"_5":14870,"_28376":54411,"_3083":54466},[],{"_3632":1121,"_31184":1095,"_21603":54484,"_5":14870,"_28376":54411,"_3083":54485},[],"Initial authentication and admission; server generation enabled.",{"_3632":1122,"_31184":1095,"_21603":54487,"_5":14870,"_28376":54411,"_3083":54488},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3632":1123,"_31184":1095,"_21603":54490,"_5":14870,"_28376":54415,"_3083":54491},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3632":1124,"_31184":1095,"_21603":54493,"_5":14870,"_28376":54415,"_3083":54494},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3632":1125,"_31184":1095,"_21603":54496,"_5":14870,"_28376":54418,"_3083":54497},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3632":1126,"_31184":1095,"_21603":54499,"_5":14870,"_28376":54418,"_3083":54500},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3632":1127,"_31184":1095,"_21603":54502,"_5":14870,"_28376":54421,"_3083":54503},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3632":1128,"_31184":1095,"_21603":54505,"_5":14870,"_28376":54421,"_3083":54506},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. With default settings, a client certificate whose revocation cannot be verified is also rejected; the DMS guide describes `allow_unverifiable_revocation`. See Renewal for installation and recovery.",{"_3632":1129,"_31184":1095,"_21603":54508,"_5":14870,"_28376":54424,"_3083":54509},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3632":1130,"_31184":1095,"_21603":54511,"_5":14870,"_28376":54424,"_3083":54512},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3632":1131,"_31184":1095,"_21603":54514,"_5":14870,"_28376":54427,"_3083":54515},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3632":1132,"_31184":1095,"_21603":54517,"_5":14870,"_28376":54427,"_3083":54518},[],"Part",{"_3632":1133,"_31184":1095,"_21603":54520,"_5":14870,"_28376":54427,"_3083":54521},[],"Content after decoding its Base64",{"_3632":1134,"_31184":1095,"_21603":54523,"_5":14870,"_28376":54427,"_3083":54524},[],"`application/pkcs8`",{"_3632":1135,"_31184":1095,"_21603":54526,"_5":14870,"_28376":54427,"_3083":54527},[],"Unencrypted DER PKCS#8 private key.",{"_3632":1136,"_31184":1095,"_21603":54529,"_5":14870,"_28376":54427,"_3083":54530},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3632":1137,"_31184":1095,"_21603":54532,"_5":14870,"_28376":54427,"_3083":54533},[],"DER PKCS#7 containing the issued certificate.",{"_3632":1138,"_31184":1095,"_21603":54535,"_5":14870,"_28376":54427,"_3083":54536},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3632":1139,"_31184":1095,"_21603":54538,"_5":14870,"_28376":54431,"_3083":54539},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3632":1140,"_31184":1095,"_21603":54541,"_5":14870,"_28376":54431,"_3083":54542},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3632":1141,"_31184":1095,"_21603":54544,"_5":14870,"_28376":54431,"_3083":54545},[],"Convert and check the result:",{"_3632":1142,"_31184":1095,"_21603":54547,"_5":14870,"_28376":54431,"_3083":54548},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3632":1143,"_31184":1095,"_21603":54550,"_5":14870,"_28376":54435,"_3083":54551},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3632":1144,"_31184":1095,"_21603":54553,"_5":14870,"_28376":54435,"_3083":54554},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3632":1145,"_31184":1145,"_5":15230,"_3083":53864,"_31543":54556,"_21603":54557,"_28376":1145},[50996,52508,53680,53678,53864],[],{"_3632":1146,"_31184":1145,"_21603":54559,"_5":14870,"_28376":1145,"_3083":54560},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3632":1147,"_31184":1145,"_5":31540,"_21603":54562,"_28376":54563,"_3083":54564},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3632":1148,"_31184":1145,"_5":31540,"_21603":54566,"_28376":54567,"_3083":54568},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3632":1149,"_31184":1145,"_5":31540,"_21603":54570,"_28376":54571,"_3083":54572},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3632":1150,"_31184":1145,"_21603":54574,"_5":14870,"_28376":1145,"_3083":54575},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3632":1151,"_31184":1145,"_21603":54577,"_5":14870,"_28376":54563,"_3083":54578},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3632":1152,"_31184":1145,"_21603":54580,"_5":14870,"_28376":54563,"_3083":54581},[],"The integrator installs initial EST server trust and an admission credential.",{"_3632":1153,"_31184":1145,"_21603":54583,"_5":14870,"_28376":54563,"_3083":54584},[],"The client requests an identity for its `Device ID` through EST.",{"_3632":1154,"_31184":1145,"_21603":54586,"_5":14870,"_28376":54563,"_3083":54587},[],"Certificate, device binding and key/certificate installation are checked.",{"_3632":1155,"_31184":1145,"_21603":54589,"_5":14870,"_28376":54563,"_3083":54590},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3632":1156,"_31184":1145,"_21603":54592,"_5":14870,"_28376":54563,"_3083":54593},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3632":1157,"_31184":1145,"_21603":54595,"_5":14870,"_28376":54567,"_3083":54596},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3632":1158,"_31184":1145,"_21603":54598,"_5":14870,"_28376":54567,"_3083":54599},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":1159,"_31184":1145,"_21603":54601,"_5":14870,"_28376":54567,"_3083":54602},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3632":1160,"_31184":1145,"_21603":54604,"_5":14870,"_28376":54567,"_3083":54605},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3632":1161,"_31184":1145,"_21603":54607,"_5":14870,"_28376":54571,"_3083":54608},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3632":1162,"_31184":1145,"_21603":54610,"_5":14870,"_28376":54571,"_3083":54611},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3632":1163,"_31184":1145,"_21603":54613,"_5":14870,"_28376":54571,"_3083":54614},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3632":1164,"_31184":1145,"_21603":54616,"_5":14870,"_28376":54571,"_3083":54617},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3632":1165,"_31184":1145,"_21603":54619,"_5":14870,"_28376":54571,"_3083":54620},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3632":1166,"_31184":1166,"_5":15230,"_3083":54622,"_31543":54623,"_21603":54624,"_28376":1166},"Provisioning strategies",[50996,52508,53680,53678,53864],[],{"_3632":1167,"_31184":1166,"_21603":54626,"_5":14870,"_28376":1166,"_3083":54627},[],"Choose device registration, identity authorization and key generation.",{"_3632":1168,"_31184":1166,"_5":31540,"_21603":54629,"_28376":54630,"_3083":54631},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3632":1169,"_31184":1166,"_5":31540,"_21603":54633,"_28376":54634,"_3083":54635},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3632":1170,"_31184":1166,"_5":31540,"_21603":54637,"_28376":54638,"_3083":54639},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3632":1171,"_31184":1166,"_5":31540,"_21603":54641,"_28376":54642,"_3083":54643},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3632":1172,"_31184":1166,"_5":31540,"_21603":54645,"_28376":54646,"_3083":54647},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3632":1173,"_31184":1166,"_21603":54649,"_5":14870,"_28376":1166,"_3083":54650},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3632":1174,"_31184":1166,"_21603":54652,"_5":14870,"_28376":54630,"_3083":54653},[],"Path",{"_3632":1175,"_31184":1166,"_21603":54655,"_5":14870,"_28376":54630,"_3083":54656},[],"When the device exists",{"_3632":1176,"_31184":1166,"_21603":54658,"_5":14870,"_28376":54630,"_3083":54659},[],"What to check",{"_3632":1177,"_31184":1166,"_21603":54661,"_5":14870,"_28376":54630,"_3083":54662},[],"Manual assignment",{"_3632":1178,"_31184":1166,"_21603":54664,"_5":14870,"_28376":54630,"_3083":54665},[],"An operator creates it before associating a certificate.",{"_3632":1179,"_31184":1166,"_21603":54667,"_5":14870,"_28376":54630,"_3083":54668},[],"ID, owning DMS, certificate CN and bound serial.",{"_3632":1180,"_31184":1166,"_21603":54670,"_5":14870,"_28376":54630,"_3083":54671},[],"EST with `JITP`",{"_3632":1181,"_31184":1166,"_21603":54673,"_5":14870,"_28376":54630,"_3083":54674},[],"Created for an unknown CN during `/simpleenroll`.",{"_3632":1182,"_31184":1166,"_21603":54676,"_5":14870,"_28376":54630,"_3083":54677},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3632":1183,"_31184":1166,"_21603":54679,"_5":14870,"_28376":54630,"_3083":54680},[],"EST with `PRE_REGISTRATION`",{"_3632":1184,"_31184":1166,"_21603":54682,"_5":14870,"_28376":54630,"_3083":54683},[],"Must exist before `/simpleenroll`.",{"_3632":1185,"_31184":1166,"_21603":54685,"_5":14870,"_28376":54630,"_3083":54686},[],"Approved record, same DMS and replacement conditions for your version.",{"_3632":1186,"_31184":1166,"_21603":54688,"_5":14870,"_28376":54630,"_3083":54689},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3632":1187,"_31184":1166,"_21603":54691,"_5":14870,"_28376":54630,"_3083":54692},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3632":1188,"_31184":1166,"_21603":54694,"_5":14870,"_28376":54634,"_3083":54695},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3632":1189,"_31184":1166,"_21603":54697,"_5":14870,"_28376":54634,"_3083":54698},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3632":1190,"_31184":1166,"_21603":54700,"_5":14870,"_28376":54634,"_3083":54701},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3632":1191,"_31184":1166,"_21603":54703,"_5":14870,"_28376":54638,"_3083":54704},[],"Decide initial enrollment and re-enrollment separately:",{"_3632":1192,"_31184":1166,"_21603":54706,"_5":14870,"_28376":54638,"_3083":54707},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3632":1193,"_31184":1166,"_21603":54709,"_5":14870,"_28376":54638,"_3083":54710},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3632":1194,"_31184":1166,"_21603":54712,"_5":14870,"_28376":54638,"_3083":54713},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3632":1195,"_31184":1166,"_21603":54715,"_5":14870,"_28376":54638,"_3083":54716},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3632":1196,"_31184":1166,"_21603":54718,"_5":14870,"_28376":54638,"_3083":54719},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3632":1197,"_31184":1166,"_21603":54721,"_5":14870,"_28376":54642,"_3083":51380},[],{"_3632":1198,"_31184":1166,"_21603":54723,"_5":14870,"_28376":54642,"_3083":54724},[],"Material crossing EST",{"_3632":1199,"_31184":1166,"_21603":54726,"_5":14870,"_28376":54642,"_3083":54727},[],"Device-generated key",{"_3632":1200,"_31184":1166,"_21603":54729,"_5":14870,"_28376":54642,"_3083":54730},[],"Public CSR and certificate; the key stays on the client.",{"_3632":1201,"_31184":1166,"_21603":54732,"_5":14870,"_28376":54642,"_3083":54733},[],"Existing device key",{"_3632":1202,"_31184":1166,"_21603":54735,"_5":14870,"_28376":54642,"_3083":54736},[],"CSR signed with that key and a new certificate.",{"_3632":1203,"_31184":1166,"_21603":54738,"_5":14870,"_28376":54642,"_3083":54008},[],{"_3632":1204,"_31184":1166,"_21603":54740,"_5":14870,"_28376":54642,"_3083":54741},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3632":1205,"_31184":1166,"_21603":54743,"_5":14870,"_28376":54642,"_3083":54744},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3632":1206,"_31184":1166,"_21603":54746,"_5":14870,"_28376":54646,"_3083":54747},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3632":1207,"_31184":1207,"_5":15230,"_3083":54749,"_31543":54750,"_21603":54751,"_28376":1207},"Renewal and recovery",[50996,52508,53680,53678,53864],[],{"_3632":1208,"_31184":1207,"_21603":54753,"_5":14870,"_28376":1207,"_3083":54754},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3632":1209,"_31184":1207,"_5":31540,"_21603":54756,"_28376":54757,"_3083":54758},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3632":1210,"_31184":1207,"_5":31540,"_21603":54760,"_28376":54761,"_3083":54762},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3632":1211,"_31184":1207,"_5":31540,"_21603":54764,"_28376":54765,"_3083":54766},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3632":1212,"_31184":1207,"_5":31540,"_21603":54768,"_28376":54769,"_3083":54770},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3632":1213,"_31184":1207,"_5":31540,"_21603":54772,"_28376":54773,"_3083":54774},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3632":1214,"_31184":1207,"_21603":54776,"_5":14870,"_28376":1207,"_3083":54777},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3632":1215,"_31184":1207,"_21603":54779,"_5":14870,"_28376":54757,"_3083":54780},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3632":1216,"_31184":1207,"_21603":54782,"_5":14870,"_28376":54757,"_3083":54783},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3632":1217,"_31184":1207,"_21603":54785,"_5":14870,"_28376":54757,"_3083":54786},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3632":1218,"_31184":1207,"_21603":54788,"_5":14870,"_28376":54757,"_3083":54789},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3632":1219,"_31184":1207,"_21603":54791,"_5":14870,"_28376":54761,"_3083":54792},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3632":1220,"_31184":1207,"_21603":54794,"_5":14870,"_28376":54761,"_3083":54795},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3632":1221,"_31184":1207,"_21603":54797,"_5":14870,"_28376":54765,"_3083":54798},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3632":1222,"_31184":1207,"_21603":54800,"_5":14870,"_28376":54765,"_3083":54801},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3632":1223,"_31184":1207,"_21603":54803,"_5":14870,"_28376":54765,"_3083":54804},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3632":1224,"_31184":1207,"_21603":54806,"_5":14870,"_28376":54769,"_3083":54807},[],"Situation",{"_3632":1225,"_31184":1207,"_21603":54809,"_5":14870,"_28376":54769,"_3083":54810},[],"Procedure",{"_3632":1226,"_31184":1207,"_21603":54812,"_5":14870,"_28376":54769,"_3083":54813},[],"Valid certificate, outside the window",{"_3632":1227,"_31184":1207,"_21603":54815,"_5":14870,"_28376":54769,"_3083":54816},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3632":1228,"_31184":1207,"_21603":54818,"_5":14870,"_28376":54769,"_3083":54819},[],"Expired certificate, key available",{"_3632":1229,"_31184":1207,"_21603":54821,"_5":14870,"_28376":54769,"_3083":54822},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3632":1230,"_31184":1207,"_21603":54824,"_5":14870,"_28376":54769,"_3083":54825},[],"Renewal through webhook or `NO_AUTH`",{"_3632":1231,"_31184":1207,"_21603":54827,"_5":14870,"_28376":54769,"_3083":54828},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3632":1232,"_31184":1207,"_21603":54830,"_5":14870,"_28376":54769,"_3083":54831},[],"Lost or inaccessible key",{"_3632":1233,"_31184":1207,"_21603":54833,"_5":14870,"_28376":54769,"_3083":54834},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3632":1234,"_31184":1207,"_21603":54836,"_5":14870,"_28376":54769,"_3083":54837},[],"Current identity revoked",{"_3632":1235,"_31184":1207,"_21603":54839,"_5":14870,"_28376":54769,"_3083":54840},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3632":1236,"_31184":1207,"_21603":54842,"_5":14870,"_28376":54769,"_3083":54843},[],"Device without an identity",{"_3632":1237,"_31184":1207,"_21603":54845,"_5":14870,"_28376":54769,"_3083":54846},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3632":1238,"_31184":1207,"_21603":54848,"_5":14870,"_28376":54769,"_3083":54849},[],"Retired device",{"_3632":1239,"_31184":1207,"_21603":54851,"_5":14870,"_28376":54769,"_3083":54852},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3632":1240,"_31184":1207,"_21603":54854,"_5":14870,"_28376":54769,"_3083":54855},[],"Timeout, HTTP 500 or installation failure",{"_3632":1241,"_31184":1207,"_21603":54857,"_5":14870,"_28376":54769,"_3083":54858},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3632":1242,"_31184":1207,"_21603":54860,"_5":14870,"_28376":54773,"_3083":54861},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3632":1243,"_31184":1207,"_21603":54863,"_5":14870,"_28376":54773,"_3083":54864},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3632":1244,"_31184":1244,"_5":15230,"_3083":54866,"_31543":54867,"_21603":54868,"_28376":1244},"Enrollment troubleshooting",[50996,52508,53680,53678,53864],[],{"_3632":1245,"_31184":1244,"_21603":54870,"_5":14870,"_28376":1244,"_3083":54871},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3632":1246,"_31184":1244,"_5":31540,"_21603":54873,"_28376":54874,"_3083":54875},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3632":1247,"_31184":1244,"_5":31540,"_21603":54877,"_28376":54878,"_3083":54879},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3632":1248,"_31184":1244,"_5":31540,"_21603":54881,"_28376":54882,"_3083":54436},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3632":1249,"_31184":1244,"_5":31540,"_21603":54884,"_28376":54885,"_3083":54886},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3632":1250,"_31184":1244,"_21603":54888,"_5":14870,"_28376":1244,"_3083":54889},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3632":1251,"_31184":1244,"_21603":54891,"_5":14870,"_28376":54878,"_3083":54892},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3632":1252,"_31184":1244,"_21603":54894,"_5":14870,"_28376":54878,"_3083":54895},[],"Symptom or message",{"_3632":1253,"_31184":1244,"_21603":54897,"_5":14870,"_28376":54878,"_3083":54659},[],{"_3632":1254,"_31184":1244,"_21603":54899,"_5":14870,"_28376":54878,"_3083":54900},[],"curl rejects TLS, name or issuer",{"_3632":1255,"_31184":1244,"_21603":54902,"_5":14870,"_28376":54878,"_3083":54903},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3632":1256,"_31184":1244,"_21603":54905,"_5":14870,"_28376":54878,"_3083":54906},[],"404 or missing APS",{"_3632":1257,"_31184":1244,"_21603":54908,"_5":14870,"_28376":54878,"_3083":54909},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3632":1258,"_31184":1244,"_21603":54911,"_5":14870,"_28376":54878,"_3083":54912},[],"400, CSR or format error",{"_3632":1259,"_31184":1244,"_21603":54914,"_5":14870,"_28376":54878,"_3083":54915},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3632":1260,"_31184":1244,"_21603":54917,"_5":14870,"_28376":54878,"_3083":54918},[],"Missing credential or invalid certificate",{"_3632":1261,"_31184":1244,"_21603":54920,"_5":14870,"_28376":54878,"_3083":54921},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3632":1262,"_31184":1244,"_21603":54923,"_5":14870,"_28376":54878,"_3083":54924},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3632":1263,"_31184":1244,"_21603":54926,"_5":14870,"_28376":54878,"_3083":54927},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3632":1264,"_31184":1244,"_21603":54929,"_5":14870,"_28376":54878,"_3083":54930},[],"Webhook denies, times out or responds without authorization",{"_3632":1265,"_31184":1244,"_21603":54932,"_5":14870,"_28376":54878,"_3083":54933},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3632":1266,"_31184":1244,"_21603":54935,"_5":14870,"_28376":54878,"_3083":54936},[],"`unexpected status code: <n>: redirects are not followed`",{"_3632":1267,"_31184":1244,"_21603":54938,"_5":14870,"_28376":54878,"_3083":54939},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3632":1268,"_31184":1244,"_21603":54941,"_5":14870,"_28376":54878,"_3083":54942},[],"`webhook response exceeds 1048576 bytes`",{"_3632":1269,"_31184":1244,"_21603":54944,"_5":14870,"_28376":54878,"_3083":54945},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3632":1270,"_31184":1244,"_21603":54947,"_5":14870,"_28376":54878,"_3083":54948},[],"`webhook config must not reference files`",{"_3632":1271,"_31184":1244,"_21603":54950,"_5":14870,"_28376":54878,"_3083":54951},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3632":1272,"_31184":1244,"_21603":54953,"_5":14870,"_28376":54878,"_3083":54954},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3632":1273,"_31184":1244,"_21603":54956,"_5":14870,"_28376":54878,"_3083":54957},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3632":1274,"_31184":1244,"_21603":54959,"_5":14870,"_28376":54878,"_3083":54960},[],"`webhook mTLS certificate and key are invalid: …`",{"_3632":1275,"_31184":1244,"_21603":54962,"_5":14870,"_28376":54878,"_3083":54963},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3632":1276,"_31184":1244,"_21603":54965,"_5":14870,"_28376":54878,"_3083":54966},[],"400 `struct validation error` creating or updating a DMS",{"_3632":1277,"_31184":1244,"_21603":54968,"_5":14870,"_28376":54878,"_3083":54969},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3632":1278,"_31184":1244,"_21603":54971,"_5":14870,"_28376":54878,"_3083":54972},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3632":1279,"_31184":1244,"_21603":54974,"_5":14870,"_28376":54878,"_3083":54975},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3632":1280,"_31184":1244,"_21603":54977,"_5":14870,"_28376":54878,"_3083":54978},[],"`device not preregistered`",{"_3632":1281,"_31184":1244,"_21603":54980,"_5":14870,"_28376":54878,"_3083":54981},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3632":1282,"_31184":1244,"_21603":54983,"_5":14870,"_28376":54878,"_3083":54984},[],"`forbiddenNewEnrollment`",{"_3632":1283,"_31184":1244,"_21603":54986,"_5":14870,"_28376":54878,"_3083":54987},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3632":1284,"_31184":1244,"_21603":54989,"_5":14870,"_28376":54878,"_3083":54990},[],"Different owning DMS",{"_3632":1285,"_31184":1244,"_21603":54992,"_5":14870,"_28376":54878,"_3083":54993},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3632":1286,"_31184":1244,"_21603":54995,"_5":14870,"_28376":54878,"_3083":54996},[],"`invalid RawSubject bytes`",{"_3632":1287,"_31184":1244,"_21603":54998,"_5":14870,"_28376":54878,"_3083":54999},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3632":1288,"_31184":1244,"_21603":55001,"_5":14870,"_28376":54878,"_3083":55002},[],"`invalid reenroll window`",{"_3632":1289,"_31184":1244,"_21603":55004,"_5":14870,"_28376":54878,"_3083":55005},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3632":1290,"_31184":1244,"_21603":55007,"_5":14870,"_28376":54878,"_3083":55008},[],"Current certificate revoked",{"_3632":1291,"_31184":1244,"_21603":55010,"_5":14870,"_28376":54878,"_3083":55011},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3632":1292,"_31184":1244,"_21603":55013,"_5":14870,"_28376":54878,"_3083":55014},[],"CA, profile or signing error",{"_3632":1293,"_31184":1244,"_21603":55016,"_5":14870,"_28376":54878,"_3083":55017},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3632":1294,"_31184":1244,"_21603":55019,"_5":14870,"_28376":54878,"_3083":55020},[],"HTTP 200 without a device connection",{"_3632":1295,"_31184":1244,"_21603":55022,"_5":14870,"_28376":54878,"_3083":55023},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3632":1296,"_31184":1244,"_21603":55025,"_5":14870,"_28376":54878,"_3083":55026},[],"Timeout or error after issuance",{"_3632":1297,"_31184":1244,"_21603":55028,"_5":14870,"_28376":54878,"_3083":55029},[],"New certificates, current slot and previous identity's state before retrying.",{"_3632":1298,"_31184":1244,"_21603":55031,"_5":14870,"_28376":54882,"_3083":55032},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3632":1299,"_31184":1244,"_21603":55034,"_5":14870,"_28376":54882,"_3083":55035},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3632":1300,"_31184":1244,"_21603":55037,"_5":14870,"_28376":54885,"_3083":55038},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3632":1301,"_31184":1244,"_21603":55040,"_5":14870,"_28376":54885,"_3083":55041},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3632":1302,"_31184":1244,"_21603":55043,"_5":14870,"_28376":54885,"_3083":55044},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3632":1303,"_31184":1244,"_21603":55046,"_5":14870,"_28376":54885,"_3083":55047},[],"Make one request, save headers/body and query the device and certificates.",{"_3632":1304,"_31184":1244,"_21603":55049,"_5":14870,"_28376":54885,"_3083":55050},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3632":1305,"_31184":1244,"_21603":55052,"_5":14870,"_28376":54885,"_3083":55053},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified — including an OCSP Unknown status — is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3632":1306,"_31184":1244,"_21603":55055,"_5":14870,"_28376":54885,"_3083":55056},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3632":1307,"_31184":1307,"_5":15230,"_3083":55058,"_31543":55059,"_21603":55060,"_28376":1307},"Trust distribution and updates",[50996,52508,53680,53678,53864],[],{"_3632":1308,"_31184":1307,"_21603":55062,"_5":14870,"_28376":1307,"_3083":55063},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3632":1309,"_31184":1307,"_5":31540,"_21603":55065,"_28376":55066,"_3083":55067},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3632":1310,"_31184":1307,"_5":31540,"_21603":55069,"_28376":55070,"_3083":55071},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3632":1311,"_31184":1307,"_5":31540,"_21603":55073,"_28376":55074,"_3083":55075},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3632":1312,"_31184":1307,"_5":31540,"_21603":55077,"_28376":55078,"_3083":55079},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3632":1313,"_31184":1307,"_5":31540,"_21603":55081,"_28376":55082,"_3083":55083},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3632":1314,"_31184":1307,"_21603":55085,"_5":14870,"_28376":1307,"_3083":55086},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3632":1315,"_31184":1307,"_21603":55088,"_5":14870,"_28376":55066,"_3083":55089},[],"Relationship",{"_3632":1316,"_31184":1307,"_21603":55091,"_5":14870,"_28376":55066,"_3083":55092},[],"Material prepared by its owner",{"_3632":1317,"_31184":1307,"_21603":55094,"_5":14870,"_28376":55066,"_3083":55095},[],"Device → EST server",{"_3632":1318,"_31184":1307,"_21603":55097,"_5":14870,"_28376":55066,"_3083":55098},[],"Previously verified server root, chain or pin and TLS name.",{"_3632":1319,"_31184":1307,"_21603":55100,"_5":14870,"_28376":55066,"_3083":55101},[],"DMS → requester",{"_3632":1320,"_31184":1307,"_21603":55103,"_5":14870,"_28376":55066,"_3083":55104},[],"CAs and rules authorizing initial or renewal credentials.",{"_3632":1321,"_31184":1307,"_21603":55106,"_5":14870,"_28376":55066,"_3083":55107},[],"Consumer → device",{"_3632":1322,"_31184":1307,"_21603":55109,"_5":14870,"_28376":55066,"_3083":55110},[],"Operational identity roots, intermediates, validation and permissions.",{"_3632":1323,"_31184":1307,"_21603":55112,"_5":14870,"_28376":55066,"_3083":55113},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3632":1324,"_31184":1307,"_21603":55115,"_5":14870,"_28376":55070,"_3083":55116},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3632":1325,"_31184":1307,"_21603":55118,"_5":14870,"_28376":55070,"_3083":55119},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3632":1326,"_31184":1307,"_21603":55121,"_5":14870,"_28376":55074,"_3083":55122},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3632":1327,"_31184":1307,"_21603":55124,"_5":14870,"_28376":55074,"_3083":55125},[],"Select policy-approved roots as anchors.",{"_3632":1328,"_31184":1307,"_21603":55127,"_5":14870,"_28376":55074,"_3083":55128},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3632":1329,"_31184":1307,"_21603":55130,"_5":14870,"_28376":55074,"_3083":55131},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3632":1330,"_31184":1307,"_21603":55133,"_5":14870,"_28376":55074,"_3083":55134},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3632":1331,"_31184":1307,"_21603":55136,"_5":14870,"_28376":55074,"_3083":55137},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3632":1332,"_31184":1307,"_21603":55139,"_5":14870,"_28376":55078,"_3083":55140},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3632":1333,"_31184":1307,"_21603":55142,"_5":14870,"_28376":55078,"_3083":55143},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3632":1334,"_31184":1307,"_21603":55145,"_5":14870,"_28376":55078,"_3083":55146},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3632":1335,"_31184":1307,"_21603":55148,"_5":14870,"_28376":55082,"_3083":55149},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3632":1336,"_31184":1336,"_5":15230,"_3083":55151,"_31543":55152,"_21603":55154,"_28376":1336},"AWS IoT Core",[50996,52508,53680,53678,55153],"Integrations",[],{"_3632":1337,"_31184":1336,"_21603":55156,"_5":14870,"_28376":1336,"_3083":55157},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3632":1338,"_31184":1336,"_5":31540,"_21603":55159,"_28376":55160,"_3083":55161},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3632":1339,"_31184":1336,"_5":31540,"_21603":55163,"_28376":55164,"_3083":55165},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3632":1340,"_31184":1336,"_5":31540,"_21603":55167,"_28376":55168,"_3083":55169},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3632":1341,"_31184":1336,"_5":31540,"_21603":55171,"_28376":55172,"_3083":55173},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3632":1342,"_31184":1336,"_5":31540,"_21603":55175,"_28376":55176,"_3083":55177},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3632":1343,"_31184":1336,"_5":31540,"_21603":55179,"_28376":55180,"_3083":55181},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3632":1344,"_31184":1336,"_5":31540,"_21603":55183,"_28376":55184,"_3083":55185},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3632":1345,"_31184":1336,"_5":31540,"_21603":55187,"_28376":55188,"_3083":55189},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3632":1346,"_31184":1336,"_5":31540,"_21603":55191,"_28376":55192,"_3083":55193},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3632":1347,"_31184":1336,"_5":31540,"_21603":55195,"_28376":55196,"_3083":55197},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3632":1348,"_31184":1336,"_5":31540,"_21603":55199,"_28376":55200,"_3083":55201},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3632":1349,"_31184":1336,"_5":31540,"_21603":55203,"_28376":55204,"_3083":55205},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3632":1350,"_31184":1336,"_5":31540,"_21603":55207,"_28376":55208,"_3083":55209},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3632":1351,"_31184":1336,"_5":31540,"_21603":55211,"_28376":55212,"_3083":55213},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3632":1352,"_31184":1336,"_5":31540,"_21603":55215,"_28376":55216,"_3083":55217},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3632":1353,"_31184":1336,"_5":31540,"_21603":55219,"_28376":55220,"_3083":55221},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3632":1354,"_31184":1336,"_5":31540,"_21603":55223,"_28376":55224,"_3083":55225},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3632":1355,"_31184":1336,"_5":31540,"_21603":55227,"_28376":55228,"_3083":55229},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3632":1356,"_31184":1336,"_5":31540,"_21603":55231,"_28376":55232,"_3083":55233},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3632":1357,"_31184":1336,"_5":31540,"_21603":55235,"_28376":55236,"_3083":55237},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3632":1358,"_31184":1336,"_5":31540,"_21603":55239,"_28376":55240,"_3083":55241},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3632":1359,"_31184":1336,"_5":31540,"_21603":55243,"_28376":55244,"_3083":55245},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3632":1360,"_31184":1336,"_5":31540,"_21603":55247,"_28376":55248,"_3083":55249},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3632":1361,"_31184":1336,"_5":31540,"_21603":55251,"_28376":55252,"_3083":55253},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3632":1362,"_31184":1336,"_5":31540,"_21603":55255,"_28376":55256,"_3083":55257},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3632":1363,"_31184":1336,"_21603":55259,"_5":14870,"_28376":1336,"_3083":55260},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3632":1364,"_31184":1336,"_21603":55262,"_5":14870,"_28376":1336,"_3083":55263},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3632":1365,"_31184":1336,"_21603":55265,"_5":14870,"_28376":1336,"_3083":55266},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3632":1366,"_31184":1336,"_21603":55268,"_5":14870,"_28376":55160,"_3083":55269},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3632":1367,"_31184":1336,"_21603":55271,"_5":14870,"_28376":55160,"_3083":55272},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3632":1368,"_31184":1336,"_21603":55274,"_5":14870,"_28376":55160,"_3083":55275},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3632":1369,"_31184":1336,"_21603":55277,"_5":14870,"_28376":55160,"_3083":55278},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3632":1370,"_31184":1336,"_21603":55280,"_5":14870,"_28376":55164,"_3083":55281},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3632":1371,"_31184":1336,"_21603":55283,"_5":14870,"_28376":55168,"_3083":55284},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3632":1372,"_31184":1336,"_21603":55286,"_5":14870,"_28376":55168,"_3083":55287},[],"IAM action",{"_3632":1373,"_31184":1336,"_21603":55289,"_5":14870,"_28376":55168,"_3083":51386},[],{"_3632":1374,"_31184":1336,"_21603":55291,"_5":14870,"_28376":55168,"_3083":55292},[],"`iot:GetRegistrationCode`",{"_3632":1375,"_31184":1336,"_21603":55294,"_5":14870,"_28376":55168,"_3083":55295},[],"Obtain the verification code for CA registration in the Primary Account",{"_3632":1376,"_31184":1336,"_21603":55297,"_5":14870,"_28376":55168,"_3083":55298},[],"`iot:RegisterCACertificate`",{"_3632":1377,"_31184":1336,"_21603":55300,"_5":14870,"_28376":55168,"_3083":55301},[],"Register the CA in AWS IoT",{"_3632":1378,"_31184":1336,"_21603":55303,"_5":14870,"_28376":55168,"_3083":55304},[],"`iot:DescribeCACertificate`",{"_3632":1379,"_31184":1336,"_21603":55306,"_5":14870,"_28376":55168,"_3083":55307},[],"Check the CA registration status",{"_3632":1380,"_31184":1336,"_21603":55309,"_5":14870,"_28376":55168,"_3083":55310},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3632":1381,"_31184":1336,"_21603":55312,"_5":14870,"_28376":55168,"_3083":55313},[],"Create or update Things in IoT Core",{"_3632":1382,"_31184":1336,"_21603":55315,"_5":14870,"_28376":55168,"_3083":55316},[],"`iot:RegisterThing`",{"_3632":1383,"_31184":1336,"_21603":55318,"_5":14870,"_28376":55168,"_3083":55319},[],"Provision Things through a template",{"_3632":1384,"_31184":1336,"_21603":55321,"_5":14870,"_28376":55168,"_3083":55322},[],"`iot:RegisterCertificate`",{"_3632":1385,"_31184":1336,"_21603":55324,"_5":14870,"_28376":55168,"_3083":55325},[],"Register device certificates",{"_3632":1386,"_31184":1336,"_21603":55327,"_5":14870,"_28376":55168,"_3083":55328},[],"`iot:UpdateCertificate`",{"_3632":1387,"_31184":1336,"_21603":55330,"_5":14870,"_28376":55168,"_3083":55331},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3632":1388,"_31184":1336,"_21603":55333,"_5":14870,"_28376":55168,"_3083":55334},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3632":1389,"_31184":1336,"_21603":55336,"_5":14870,"_28376":55168,"_3083":55337},[],"Create and attach IoT policies",{"_3632":1390,"_31184":1336,"_21603":55339,"_5":14870,"_28376":55168,"_3083":55340},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3632":1391,"_31184":1336,"_21603":55342,"_5":14870,"_28376":55168,"_3083":55343},[],"Manage Thing groups",{"_3632":1392,"_31184":1336,"_21603":55345,"_5":14870,"_28376":55168,"_3083":55346},[],"`iot:CreateProvisioningTemplate`",{"_3632":1393,"_31184":1336,"_21603":55348,"_5":14870,"_28376":55168,"_3083":55349},[],"Create JITP templates",{"_3632":1394,"_31184":1336,"_21603":55351,"_5":14870,"_28376":55168,"_3083":55352},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3632":1395,"_31184":1336,"_21603":55354,"_5":14870,"_28376":55168,"_3083":55355},[],"Read and write the Device Shadow",{"_3632":1396,"_31184":1336,"_21603":55357,"_5":14870,"_28376":55168,"_3083":55358},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3632":1397,"_31184":1336,"_21603":55360,"_5":14870,"_28376":55172,"_3083":55361},[],"Parameter",{"_3632":1398,"_31184":1336,"_21603":55363,"_5":14870,"_28376":55172,"_3083":55364},[],"Type",{"_3632":1399,"_31184":1336,"_21603":55366,"_5":14870,"_28376":55172,"_3083":55367},[],"Required",{"_3632":1400,"_31184":1336,"_21603":55369,"_5":14870,"_28376":55172,"_3083":55370},[],"Description",{"_3632":1401,"_31184":1336,"_21603":55372,"_5":14870,"_28376":55172,"_3083":55373},[],"`connector_id`",{"_3632":1402,"_31184":1336,"_21603":55375,"_5":14870,"_28376":55172,"_3083":25790},[],{"_3632":1403,"_31184":1336,"_21603":55377,"_5":14870,"_28376":55172,"_3083":55378},[],"Yes",{"_3632":1404,"_31184":1336,"_21603":55380,"_5":14870,"_28376":55172,"_3083":55381},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3632":1405,"_31184":1336,"_21603":55383,"_5":14870,"_28376":55172,"_3083":55384},[],"`aws_config.region`",{"_3632":1406,"_31184":1336,"_21603":55386,"_5":14870,"_28376":55172,"_3083":25790},[],{"_3632":1407,"_31184":1336,"_21603":55388,"_5":14870,"_28376":55172,"_3083":55378},[],{"_3632":1408,"_31184":1336,"_21603":55390,"_5":14870,"_28376":55172,"_3083":55391},[],"AWS region where the connector operates.",{"_3632":1409,"_31184":1336,"_21603":55393,"_5":14870,"_28376":55172,"_3083":55394},[],"`aws_config.auth_method`",{"_3632":1410,"_31184":1336,"_21603":55396,"_5":14870,"_28376":55172,"_3083":25790},[],{"_3632":1411,"_31184":1336,"_21603":55398,"_5":14870,"_28376":55172,"_3083":55378},[],{"_3632":1412,"_31184":1336,"_21603":55400,"_5":14870,"_28376":55172,"_3083":55401},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3632":1413,"_31184":1336,"_21603":55403,"_5":14870,"_28376":55172,"_3083":55404},[],"`aws_config.access_key_id`",{"_3632":1414,"_31184":1336,"_21603":55406,"_5":14870,"_28376":55172,"_3083":25790},[],{"_3632":1415,"_31184":1336,"_21603":55408,"_5":14870,"_28376":55172,"_3083":55409},[],"Only with `auth_method=static`",{"_3632":1416,"_31184":1336,"_21603":55411,"_5":14870,"_28376":55172,"_3083":55412},[],"AWS access key.",{"_3632":1417,"_31184":1336,"_21603":55414,"_5":14870,"_28376":55172,"_3083":55415},[],"`aws_config.secret_access_key`",{"_3632":1418,"_31184":1336,"_21603":55417,"_5":14870,"_28376":55172,"_3083":25790},[],{"_3632":1419,"_31184":1336,"_21603":55419,"_5":14870,"_28376":55172,"_3083":55409},[],{"_3632":1420,"_31184":1336,"_21603":55421,"_5":14870,"_28376":55172,"_3083":55422},[],"AWS secret key.",{"_3632":1421,"_31184":1336,"_21603":55424,"_5":14870,"_28376":55172,"_3083":55425},[],"`aws_config.session_token`",{"_3632":1422,"_31184":1336,"_21603":55427,"_5":14870,"_28376":55172,"_3083":25790},[],{"_3632":1423,"_31184":1336,"_21603":55429,"_5":14870,"_28376":55172,"_3083":55430},[],"No",{"_3632":1424,"_31184":1336,"_21603":55432,"_5":14870,"_28376":55172,"_3083":55433},[],"Session token (with `auth_method=static`).",{"_3632":1425,"_31184":1336,"_21603":55435,"_5":14870,"_28376":55172,"_3083":55436},[],"`aws_config.role_arn`",{"_3632":1426,"_31184":1336,"_21603":55438,"_5":14870,"_28376":55172,"_3083":25790},[],{"_3632":1427,"_31184":1336,"_21603":55440,"_5":14870,"_28376":55172,"_3083":55441},[],"Only with `auth_method=role`",{"_3632":1428,"_31184":1336,"_21603":55443,"_5":14870,"_28376":55172,"_3083":55444},[],"ARN of the role to assume.",{"_3632":1429,"_31184":1336,"_21603":55446,"_5":14870,"_28376":55172,"_3083":55447},[],"`aws_config.endpoint_url`",{"_3632":1430,"_31184":1336,"_21603":55449,"_5":14870,"_28376":55172,"_3083":25790},[],{"_3632":1431,"_31184":1336,"_21603":55451,"_5":14870,"_28376":55172,"_3083":55430},[],{"_3632":1432,"_31184":1336,"_21603":55453,"_5":14870,"_28376":55172,"_3083":55454},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3632":1433,"_31184":1336,"_21603":55456,"_5":14870,"_28376":55172,"_3083":55457},[],"`subscriber_event_bus`",{"_3632":1434,"_31184":1336,"_21603":55459,"_5":14870,"_28376":55172,"_3083":18216},[],{"_3632":1435,"_31184":1336,"_21603":55461,"_5":14870,"_28376":55172,"_3083":55378},[],{"_3632":1436,"_31184":1336,"_21603":55463,"_5":14870,"_28376":55172,"_3083":55464},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3632":1437,"_31184":1336,"_21603":55466,"_5":14870,"_28376":55172,"_3083":55467},[],"`dms_manager_client`",{"_3632":1438,"_31184":1336,"_21603":55469,"_5":14870,"_28376":55172,"_3083":25790},[],{"_3632":1439,"_31184":1336,"_21603":55471,"_5":14870,"_28376":55172,"_3083":55378},[],{"_3632":1440,"_31184":1336,"_21603":55473,"_5":14870,"_28376":55172,"_3083":55474},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3632":1441,"_31184":1336,"_21603":55476,"_5":14870,"_28376":55172,"_3083":55477},[],"`device_manager_client`",{"_3632":1442,"_31184":1336,"_21603":55479,"_5":14870,"_28376":55172,"_3083":25790},[],{"_3632":1443,"_31184":1336,"_21603":55481,"_5":14870,"_28376":55172,"_3083":55378},[],{"_3632":1444,"_31184":1336,"_21603":55483,"_5":14870,"_28376":55172,"_3083":55484},[],"HTTP URL of Lamassu's Device Manager.",{"_3632":1445,"_31184":1336,"_21603":55486,"_5":14870,"_28376":55172,"_3083":55487},[],"`ca_client`",{"_3632":1446,"_31184":1336,"_21603":55489,"_5":14870,"_28376":55172,"_3083":25790},[],{"_3632":1447,"_31184":1336,"_21603":55491,"_5":14870,"_28376":55172,"_3083":55378},[],{"_3632":1448,"_31184":1336,"_21603":55493,"_5":14870,"_28376":55172,"_3083":55494},[],"HTTP URL of Lamassu's CA service.",{"_3632":1449,"_31184":1336,"_21603":55496,"_5":14870,"_28376":55176,"_3083":55497},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3632":1450,"_31184":1336,"_21603":55499,"_5":14870,"_28376":55176,"_3083":55500},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3632":1451,"_31184":1336,"_21603":55502,"_5":14870,"_28376":55176,"_3083":55503},[],"CloudEvent type",{"_3632":1452,"_31184":1336,"_21603":55505,"_5":14870,"_28376":55176,"_3083":55506},[],"Lamassu resource",{"_3632":1453,"_31184":1336,"_21603":55508,"_5":14870,"_28376":55176,"_3083":55509},[],"AWS Resource",{"_3632":1454,"_31184":1336,"_21603":55511,"_5":14870,"_28376":55176,"_3083":55512},[],"IAM actions",{"_3632":1455,"_31184":1336,"_21603":55514,"_5":14870,"_28376":55176,"_3083":55515},[],"AWS calls and effect",{"_3632":1456,"_31184":1336,"_21603":55517,"_5":14870,"_28376":55176,"_3083":55518},[],"Where in this page",{"_3632":1457,"_31184":1336,"_21603":55520,"_5":14870,"_28376":55176,"_3083":55521},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3632":1458,"_31184":1336,"_21603":55523,"_5":14870,"_28376":55176,"_3083":55524},[],"CA",{"_3632":1459,"_31184":1336,"_21603":55526,"_5":14870,"_28376":55176,"_3083":55527},[],"`IoTCore/CACertificate`",{"_3632":1460,"_31184":1336,"_21603":55529,"_5":14870,"_28376":55176,"_3083":55530},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3632":1461,"_31184":1336,"_21603":55532,"_5":14870,"_28376":55176,"_3083":55533},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3632":1462,"_31184":1336,"_21603":55535,"_5":14870,"_28376":55176,"_3083":55189},[],{"_3632":1463,"_31184":1336,"_21603":55537,"_5":14870,"_28376":55176,"_3083":55538},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3632":1464,"_31184":1336,"_21603":55540,"_5":14870,"_28376":55176,"_3083":55541},[],"DMS",{"_3632":1465,"_31184":1336,"_21603":55543,"_5":14870,"_28376":55176,"_3083":55544},[],"`IoTCore/ProvisioningTemplate`",{"_3632":1466,"_31184":1336,"_21603":55546,"_5":14870,"_28376":55176,"_3083":55547},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3632":1467,"_31184":1336,"_21603":55549,"_5":14870,"_28376":55176,"_3083":55550},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3632":1468,"_31184":1336,"_21603":55552,"_5":14870,"_28376":55176,"_3083":55217},[],{"_3632":1469,"_31184":1336,"_21603":55554,"_5":14870,"_28376":55176,"_3083":55555},[],"`EventBindDeviceIdentityKey`",{"_3632":1470,"_31184":1336,"_21603":55557,"_5":14870,"_28376":55176,"_3083":55558},[],"Device",{"_3632":1471,"_31184":1336,"_21603":55560,"_5":14870,"_28376":55176,"_3083":55561},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3632":1472,"_31184":1336,"_21603":55563,"_5":14870,"_28376":55176,"_3083":55564},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3632":1473,"_31184":1336,"_21603":55566,"_5":14870,"_28376":55176,"_3083":55567},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3632":1474,"_31184":1336,"_21603":55569,"_5":14870,"_28376":55176,"_3083":55225},[],{"_3632":1475,"_31184":1336,"_21603":55571,"_5":14870,"_28376":55176,"_3083":55572},[],"`EventUpdateCertificateStatusKey`",{"_3632":1476,"_31184":1336,"_21603":55574,"_5":14870,"_28376":55176,"_3083":55575},[],"Certificate",{"_3632":1477,"_31184":1336,"_21603":55577,"_5":14870,"_28376":55176,"_3083":55578},[],"`IoTCore/Certificate`",{"_3632":1478,"_31184":1336,"_21603":55580,"_5":14870,"_28376":55176,"_3083":55581},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3632":1479,"_31184":1336,"_21603":55583,"_5":14870,"_28376":55176,"_3083":55584},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3632":1480,"_31184":1336,"_21603":55586,"_5":14870,"_28376":55176,"_3083":55237},[],{"_3632":1481,"_31184":1336,"_21603":55588,"_5":14870,"_28376":55176,"_3083":55589},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3632":1482,"_31184":1336,"_21603":55591,"_5":14870,"_28376":55176,"_3083":55592},[],"Certificate / Device",{"_3632":1483,"_31184":1336,"_21603":55594,"_5":14870,"_28376":55176,"_3083":55595},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3632":1484,"_31184":1336,"_21603":55597,"_5":14870,"_28376":55176,"_3083":51392},[],{"_3632":1485,"_31184":1336,"_21603":55599,"_5":14870,"_28376":55176,"_3083":55600},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3632":1486,"_31184":1336,"_21603":55602,"_5":14870,"_28376":55176,"_3083":55245},[],{"_3632":1487,"_31184":1336,"_21603":55604,"_5":14870,"_28376":55180,"_3083":55605},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3632":1488,"_31184":1336,"_21603":55607,"_5":14870,"_28376":55184,"_3083":55608},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3632":1489,"_31184":1336,"_21603":55610,"_5":14870,"_28376":55184,"_3083":55611},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3632":1490,"_31184":1336,"_21603":55613,"_5":14870,"_28376":55188,"_3083":55614},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3632":1491,"_31184":1336,"_21603":55616,"_5":14870,"_28376":55188,"_3083":55617},[],"Transition",{"_3632":1492,"_31184":1336,"_21603":55619,"_5":14870,"_28376":55188,"_3083":55620},[],"AWS calls",{"_3632":1493,"_31184":1336,"_21603":55622,"_5":14870,"_28376":55188,"_3083":55623},[],"`NotRegistered` → `Requested`",{"_3632":1494,"_31184":1336,"_21603":55625,"_5":14870,"_28376":55188,"_3083":55626},[],"none (metadata write only)",{"_3632":1495,"_31184":1336,"_21603":55628,"_5":14870,"_28376":55188,"_3083":55629},[],"`Requested` → `Registering`",{"_3632":1496,"_31184":1336,"_21603":55631,"_5":14870,"_28376":55188,"_3083":55632},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3632":1497,"_31184":1336,"_21603":55634,"_5":14870,"_28376":55188,"_3083":55635},[],"`Registering` → `Succeeded`",{"_3632":1498,"_31184":1336,"_21603":55637,"_5":14870,"_28376":55188,"_3083":55638},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3632":1499,"_31184":1336,"_21603":55640,"_5":14870,"_28376":55188,"_3083":55641},[],"`Registering` → `Failed`",{"_3632":1500,"_31184":1336,"_21603":55643,"_5":14870,"_28376":55188,"_3083":55644},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3632":1501,"_31184":1336,"_21603":55646,"_5":14870,"_28376":55188,"_3083":55647},[],"`Failed` / `Succeeded` → `Requested`",{"_3632":1502,"_31184":1336,"_21603":55649,"_5":14870,"_28376":55188,"_3083":55650},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3632":1503,"_31184":1336,"_21603":55652,"_5":14870,"_28376":55192,"_3083":55653},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3632":1504,"_31184":1336,"_21603":55655,"_5":14870,"_28376":55192,"_3083":55656},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3632":1505,"_31184":1336,"_21603":55658,"_5":14870,"_28376":55192,"_3083":55659},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3632":1506,"_31184":1336,"_21603":55661,"_5":14870,"_28376":55192,"_3083":55662},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3632":1507,"_31184":1336,"_21603":55664,"_5":14870,"_28376":55192,"_3083":55665},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3632":1508,"_31184":1336,"_21603":55667,"_5":14870,"_28376":55192,"_3083":55668},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3632":1509,"_31184":1336,"_21603":55670,"_5":14870,"_28376":55196,"_3083":55671},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3632":1510,"_31184":1336,"_21603":55673,"_5":14870,"_28376":55200,"_3083":55674},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3632":1511,"_31184":1336,"_21603":55676,"_5":14870,"_28376":55200,"_3083":55677},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3632":1512,"_31184":1336,"_21603":55679,"_5":14870,"_28376":55204,"_3083":55680},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3632":1513,"_31184":1336,"_21603":55682,"_5":14870,"_28376":55208,"_3083":55683},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3632":1514,"_31184":1336,"_21603":55685,"_5":14870,"_28376":55208,"_3083":55686},[],"Creates or updates the IoT policies configured in the DMS.",{"_3632":1515,"_31184":1336,"_21603":55688,"_5":14870,"_28376":55208,"_3083":55689},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3632":1516,"_31184":1336,"_21603":55691,"_5":14870,"_28376":55208,"_3083":55692},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3632":1517,"_31184":1336,"_21603":55694,"_5":14870,"_28376":55208,"_3083":55695},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3632":1518,"_31184":1336,"_21603":55697,"_5":14870,"_28376":55208,"_3083":55698},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3632":1519,"_31184":1336,"_21603":55700,"_5":14870,"_28376":55208,"_3083":55701},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3632":1520,"_31184":1336,"_21603":55703,"_5":14870,"_28376":55212,"_3083":55704},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3632":1521,"_31184":1336,"_21603":55706,"_5":14870,"_28376":55212,"_3083":55707},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3632":1522,"_31184":1336,"_21603":55709,"_5":14870,"_28376":55212,"_3083":55710},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3632":1523,"_31184":1336,"_21603":55712,"_5":14870,"_28376":55212,"_3083":55713},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3632":1524,"_31184":1336,"_21603":55715,"_5":14870,"_28376":55212,"_3083":55716},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3632":1525,"_31184":1336,"_21603":55718,"_5":14870,"_28376":55216,"_3083":55719},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3632":1526,"_31184":1336,"_21603":55721,"_5":14870,"_28376":55216,"_3083":55617},[],{"_3632":1527,"_31184":1336,"_21603":55723,"_5":14870,"_28376":55216,"_3083":55620},[],{"_3632":1528,"_31184":1336,"_21603":55725,"_5":14870,"_28376":55216,"_3083":55726},[],"`Unconfigured` → `None` / `Auto`",{"_3632":1529,"_31184":1336,"_21603":55728,"_5":14870,"_28376":55216,"_3083":55729},[],"none (configuration only)",{"_3632":1530,"_31184":1336,"_21603":55731,"_5":14870,"_28376":55216,"_3083":55732},[],"`None` ↔ `Auto`",{"_3632":1531,"_31184":1336,"_21603":55734,"_5":14870,"_28376":55216,"_3083":55729},[],{"_3632":1532,"_31184":1336,"_21603":55736,"_5":14870,"_28376":55216,"_3083":55737},[],"Any → `Jitp`",{"_3632":1533,"_31184":1336,"_21603":55739,"_5":14870,"_28376":55216,"_3083":55740},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3632":1534,"_31184":1336,"_21603":55742,"_5":14870,"_28376":55216,"_3083":55743},[],"`Jitp` → `None` / `Auto`",{"_3632":1535,"_31184":1336,"_21603":55745,"_5":14870,"_28376":55216,"_3083":55746},[],"none (the template stays in the AWS account)",{"_3632":1536,"_31184":1336,"_21603":55748,"_5":14870,"_28376":55220,"_3083":55749},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3632":1537,"_31184":1336,"_21603":55751,"_5":14870,"_28376":55220,"_3083":55752},[],"The full flow from the device's perspective is:",{"_3632":1538,"_31184":1336,"_21603":55754,"_5":14870,"_28376":55220,"_3083":55755},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3632":1539,"_31184":1336,"_21603":55757,"_5":14870,"_28376":55224,"_3083":55758},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3632":1540,"_31184":1336,"_21603":55760,"_5":14870,"_28376":55224,"_3083":55617},[],{"_3632":1541,"_31184":1336,"_21603":55762,"_5":14870,"_28376":55224,"_3083":55620},[],{"_3632":1542,"_31184":1336,"_21603":55764,"_5":14870,"_28376":55224,"_3083":55765},[],"`Absent` → `Provisioned`",{"_3632":1543,"_31184":1336,"_21603":55767,"_5":14870,"_28376":55224,"_3083":55768},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3632":1544,"_31184":1336,"_21603":55770,"_5":14870,"_28376":55224,"_3083":55771},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3632":1545,"_31184":1336,"_21603":55773,"_5":14870,"_28376":55224,"_3083":55774},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3632":1546,"_31184":1336,"_21603":55776,"_5":14870,"_28376":55224,"_3083":55777},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3632":1547,"_31184":1336,"_21603":55779,"_5":14870,"_28376":55228,"_3083":55780},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3632":1548,"_31184":1336,"_21603":55782,"_5":14870,"_28376":55228,"_3083":55783},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3632":1549,"_31184":1336,"_21603":55785,"_5":14870,"_28376":55228,"_3083":55786},[],"For the JITP flow to work correctly:",{"_3632":1550,"_31184":1336,"_21603":55788,"_5":14870,"_28376":55228,"_3083":55789},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3632":1551,"_31184":1336,"_21603":55791,"_5":14870,"_28376":55228,"_3083":55792},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3632":1552,"_31184":1336,"_21603":55794,"_5":14870,"_28376":55228,"_3083":55795},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3632":1553,"_31184":1336,"_21603":55797,"_5":14870,"_28376":55228,"_3083":55798},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3632":1554,"_31184":1336,"_21603":55800,"_5":14870,"_28376":55232,"_3083":55801},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3632":1555,"_31184":1336,"_21603":55803,"_5":14870,"_28376":55232,"_3083":55804},[],"Status in Lamassu",{"_3632":1556,"_31184":1336,"_21603":55806,"_5":14870,"_28376":55232,"_3083":55807},[],"Revocation reason",{"_3632":1557,"_31184":1336,"_21603":55809,"_5":14870,"_28376":55232,"_3083":55810},[],"Status in AWS IoT Core",{"_3632":1558,"_31184":1336,"_21603":55812,"_5":14870,"_28376":55232,"_3083":55813},[],"`Active`",{"_3632":1559,"_31184":1336,"_21603":55815,"_5":14870,"_28376":55232,"_3083":55816},[],"None",{"_3632":1560,"_31184":1336,"_21603":55818,"_5":14870,"_28376":55232,"_3083":55819},[],"`ACTIVE`",{"_3632":1561,"_31184":1336,"_21603":55821,"_5":14870,"_28376":55232,"_3083":55822},[],"`Revoked`",{"_3632":1562,"_31184":1336,"_21603":55824,"_5":14870,"_28376":55232,"_3083":55825},[],"`certificateHold`",{"_3632":1563,"_31184":1336,"_21603":55827,"_5":14870,"_28376":55232,"_3083":55828},[],"`INACTIVE`",{"_3632":1564,"_31184":1336,"_21603":55830,"_5":14870,"_28376":55232,"_3083":55822},[],{"_3632":1565,"_31184":1336,"_21603":55832,"_5":14870,"_28376":55232,"_3083":55833},[],"Any other reason",{"_3632":1566,"_31184":1336,"_21603":55835,"_5":14870,"_28376":55232,"_3083":55836},[],"`REVOKED`",{"_3632":1567,"_31184":1336,"_21603":55838,"_5":14870,"_28376":55232,"_3083":55839},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3632":1568,"_31184":1336,"_21603":55841,"_5":14870,"_28376":55236,"_3083":55842},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3632":1569,"_31184":1336,"_21603":55844,"_5":14870,"_28376":55236,"_3083":55617},[],{"_3632":1570,"_31184":1336,"_21603":55846,"_5":14870,"_28376":55236,"_3083":55620},[],{"_3632":1571,"_31184":1336,"_21603":55848,"_5":14870,"_28376":55236,"_3083":55849},[],"`NotSynced` → `Active`",{"_3632":1572,"_31184":1336,"_21603":55851,"_5":14870,"_28376":55236,"_3083":55328},[],{"_3632":1573,"_31184":1336,"_21603":55853,"_5":14870,"_28376":55236,"_3083":55854},[],"`Active` → `Inactive`",{"_3632":1574,"_31184":1336,"_21603":55856,"_5":14870,"_28376":55236,"_3083":55857},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3632":1575,"_31184":1336,"_21603":55859,"_5":14870,"_28376":55236,"_3083":55860},[],"`Active` → `Revoked`",{"_3632":1576,"_31184":1336,"_21603":55862,"_5":14870,"_28376":55236,"_3083":55857},[],{"_3632":1577,"_31184":1336,"_21603":55864,"_5":14870,"_28376":55236,"_3083":55865},[],"`Inactive` / `Revoked` → `Active`",{"_3632":1578,"_31184":1336,"_21603":55867,"_5":14870,"_28376":55236,"_3083":55328},[],{"_3632":1579,"_31184":1336,"_21603":55869,"_5":14870,"_28376":55236,"_3083":55870},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3632":1580,"_31184":1336,"_21603":55872,"_5":14870,"_28376":55236,"_3083":55873},[],"none (these states are not synced to AWS)",{"_3632":1581,"_31184":1336,"_21603":55875,"_5":14870,"_28376":55240,"_3083":55876},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3632":1582,"_31184":1336,"_21603":55878,"_5":14870,"_28376":55240,"_3083":55879},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3632":1583,"_31184":1336,"_21603":55881,"_5":14870,"_28376":55240,"_3083":55882},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3632":1584,"_31184":1336,"_21603":55884,"_5":14870,"_28376":55244,"_3083":55885},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3632":1585,"_31184":1336,"_21603":55887,"_5":14870,"_28376":55244,"_3083":55888},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3632":1586,"_31184":1336,"_21603":55890,"_5":14870,"_28376":55248,"_3083":55891},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3632":1587,"_31184":1336,"_21603":55893,"_5":14870,"_28376":55248,"_3083":55894},[],"There are two action types:",{"_3632":1588,"_31184":1336,"_21603":55896,"_5":14870,"_28376":55248,"_3083":55897},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3632":1589,"_31184":1336,"_21603":55899,"_5":14870,"_28376":55248,"_3083":55900},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3632":1590,"_31184":1336,"_21603":55902,"_5":14870,"_28376":55248,"_3083":55903},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3632":1591,"_31184":1336,"_21603":55905,"_5":14870,"_28376":55252,"_3083":55906},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3632":1592,"_31184":1336,"_21603":55908,"_5":14870,"_28376":55252,"_3083":55909},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3632":1593,"_31184":1336,"_21603":55911,"_5":14870,"_28376":55252,"_3083":55912},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3632":1594,"_31184":1336,"_21603":55914,"_5":14870,"_28376":55256,"_3083":55915},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3632":1595,"_31184":1336,"_21603":55917,"_5":14870,"_28376":55256,"_3083":55918},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3632":1596,"_31184":1336,"_21603":55920,"_5":14870,"_28376":55256,"_3083":55921},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3632":1597,"_31184":1336,"_21603":55923,"_5":14870,"_28376":55256,"_3083":55924},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3632":1598,"_31184":1336,"_21603":55926,"_5":14870,"_28376":55256,"_3083":55927},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3632":1599,"_31184":1336,"_21603":55929,"_5":14870,"_28376":55256,"_3083":55930},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3632":1600,"_31184":1336,"_21603":55932,"_5":14870,"_28376":55256,"_3083":55933},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3632":1601,"_31184":1336,"_21603":55935,"_5":14870,"_28376":55256,"_3083":55936},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3632":1602,"_31184":1336,"_21603":55938,"_5":14870,"_28376":55256,"_3083":55939},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3632":1603,"_31184":1336,"_21603":55941,"_5":14870,"_28376":55256,"_3083":55942},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3632":1604,"_31184":1336,"_21603":55944,"_5":14870,"_28376":55256,"_3083":55945},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3632":1605,"_31184":1336,"_21603":55947,"_5":14870,"_28376":55256,"_3083":55948},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3632":1606,"_31184":1336,"_21603":55950,"_5":14870,"_28376":55256,"_3083":55951},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3632":1607,"_31184":1336,"_21603":55953,"_5":14870,"_28376":55256,"_3083":55954},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3632":1608,"_31184":1336,"_21603":55956,"_5":14870,"_28376":55256,"_3083":55957},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3632":1609,"_31184":1336,"_21603":55959,"_5":14870,"_28376":55256,"_3083":55960},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3632":1610,"_31184":1336,"_21603":55962,"_5":14870,"_28376":55256,"_3083":55963},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3632":1611,"_31184":1336,"_21603":55965,"_5":14870,"_28376":55256,"_3083":55966},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3632":1612,"_31184":1336,"_21603":55968,"_5":14870,"_28376":55256,"_3083":55969},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3632":1613,"_31184":1336,"_21603":55971,"_5":14870,"_28376":55256,"_3083":55972},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3632":1614,"_31184":1336,"_21603":55974,"_5":14870,"_28376":55256,"_3083":55975},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3632":1615,"_31184":1336,"_21603":55977,"_5":14870,"_28376":55256,"_3083":55978},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":1616,"_31184":1336,"_21603":55980,"_5":14870,"_28376":55256,"_3083":55981},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3632":1617,"_31184":1336,"_21603":55983,"_5":14870,"_28376":55256,"_3083":55984},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3632":1618,"_31184":1618,"_5":15230,"_3083":53680,"_31543":55986,"_21603":55987,"_28376":1618},[50996,52508,53680],[],{"_3632":1619,"_31184":1618,"_21603":55989,"_5":14870,"_28376":1618,"_3083":55990},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3632":1620,"_31184":1618,"_5":31540,"_21603":55992,"_28376":55993,"_3083":55994},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#start-here","Start here",{"_3632":1621,"_31184":1618,"_5":31540,"_21603":55996,"_28376":55997,"_3083":53678},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#devices-and-identities",{"_3632":1622,"_31184":1618,"_5":31540,"_21603":55999,"_28376":56000,"_3083":53864},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#enrollment-with-pki",{"_3632":1623,"_31184":1618,"_5":31540,"_21603":56002,"_28376":56003,"_3083":55153},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#integrations",{"_3632":1624,"_31184":1618,"_5":31540,"_21603":56005,"_28376":56006,"_3083":56007},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3632":1625,"_31184":1618,"_21603":56009,"_5":14870,"_28376":1618,"_3083":56010},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3632":1626,"_31184":1618,"_21603":56012,"_5":14870,"_28376":55993,"_3083":56013},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3632":1627,"_31184":1618,"_21603":56015,"_5":14870,"_28376":55993,"_3083":56016},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3632":1628,"_31184":1618,"_21603":56018,"_5":14870,"_28376":55997,"_3083":56019},[],"Resource",{"_3632":1629,"_31184":1618,"_21603":56021,"_5":14870,"_28376":55997,"_3083":56022},[],"What it represents",{"_3632":1630,"_31184":1618,"_21603":56024,"_5":14870,"_28376":55997,"_3083":56025},[],"**Device**",{"_3632":1631,"_31184":1618,"_21603":56027,"_5":14870,"_28376":55997,"_3083":56028},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3632":1632,"_31184":1618,"_21603":56030,"_5":14870,"_28376":55997,"_3083":56031},[],"**Identity**",{"_3632":1633,"_31184":1618,"_21603":56033,"_5":14870,"_28376":55997,"_3083":56034},[],"The device's association with its certificates: an active version and a history.",{"_3632":1634,"_31184":1618,"_21603":56036,"_5":14870,"_28376":55997,"_3083":56037},[],"**DMS**",{"_3632":1635,"_31184":1618,"_21603":56039,"_5":14870,"_28376":55997,"_3083":56040},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3632":1636,"_31184":1618,"_21603":56042,"_5":14870,"_28376":55997,"_3083":56043},[],"**Fleet**",{"_3632":1637,"_31184":1618,"_21603":56045,"_5":14870,"_28376":55997,"_3083":56046},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3632":1638,"_31184":1618,"_21603":56048,"_5":14870,"_28376":55997,"_3083":56049},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3632":1639,"_31184":1618,"_21603":56051,"_5":14870,"_28376":55997,"_3083":56052},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3632":1640,"_31184":1618,"_21603":56054,"_5":14870,"_28376":56000,"_3083":56055},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3632":1641,"_31184":1618,"_21603":56057,"_5":14870,"_28376":56000,"_3083":56058},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3632":1642,"_31184":1618,"_21603":56060,"_5":14870,"_28376":56000,"_3083":56061},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3632":1643,"_31184":1618,"_21603":56063,"_5":14870,"_28376":56000,"_3083":56064},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3632":1644,"_31184":1618,"_21603":56066,"_5":14870,"_28376":56000,"_3083":56067},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3632":1645,"_31184":1618,"_21603":56069,"_5":14870,"_28376":56000,"_3083":56070},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3632":1646,"_31184":1618,"_21603":56072,"_5":14870,"_28376":56000,"_3083":56073},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3632":1647,"_31184":1618,"_21603":56075,"_5":14870,"_28376":56000,"_3083":56076},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3632":1648,"_31184":1618,"_21603":56078,"_5":14870,"_28376":56003,"_3083":56079},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3632":1649,"_31184":1618,"_21603":56081,"_5":14870,"_28376":56003,"_3083":56082},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3632":1650,"_31184":1618,"_21603":56084,"_5":14870,"_28376":56006,"_3083":56085},[],"Participant",{"_3632":1651,"_31184":1618,"_21603":56087,"_5":14870,"_28376":56006,"_3083":56088},[],"Responsibility",{"_3632":1652,"_31184":1618,"_21603":56090,"_5":14870,"_28376":56006,"_3083":56091},[],"PKI administrator",{"_3632":1653,"_31184":1618,"_21603":56093,"_5":14870,"_28376":56006,"_3083":56094},[],"CA, issuance profile, chain and revocation publication.",{"_3632":1654,"_31184":1618,"_21603":56096,"_5":14870,"_28376":56006,"_3083":56097},[],"Provisioning administrator",{"_3632":1655,"_31184":1618,"_21603":56099,"_5":14870,"_28376":56006,"_3083":56100},[],"DMS, admission, authentication per operation and inventory.",{"_3632":1656,"_31184":1618,"_21603":56102,"_5":14870,"_28376":56006,"_3083":56103},[],"Device integrator",{"_3632":1657,"_31184":1618,"_21603":56105,"_5":14870,"_28376":56006,"_3083":56106},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3632":1658,"_31184":1618,"_21603":56108,"_5":14870,"_28376":56006,"_3083":56109},[],"Consumer integrator",{"_3632":1659,"_31184":1618,"_21603":56111,"_5":14870,"_28376":56006,"_3083":56112},[],"Trusted issuers, validation and device permissions in the destination.",{"_3632":1660,"_31184":1618,"_21603":56114,"_5":14870,"_28376":56006,"_3083":56115},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3632":1661,"_31184":1661,"_5":15230,"_3083":56117,"_31543":56118,"_21603":56120,"_28376":1661},"Enroll and connect your first device",[50996,52508,53680,56119],"Getting started",[],{"_3632":1662,"_31184":1661,"_21603":56122,"_5":14870,"_28376":1661,"_3083":56123},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3632":1663,"_31184":1661,"_5":31540,"_21603":56125,"_28376":56126,"_3083":51006},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3632":1664,"_31184":1661,"_5":31540,"_21603":56128,"_28376":56129,"_3083":56130},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3632":1665,"_31184":1661,"_5":31540,"_21603":56132,"_28376":56133,"_3083":56134},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3632":1666,"_31184":1661,"_5":31540,"_21603":56136,"_28376":56137,"_3083":56138},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3632":1667,"_31184":1661,"_5":31540,"_21603":56140,"_28376":56141,"_3083":56142},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3632":1668,"_31184":1661,"_5":31540,"_21603":56144,"_28376":56145,"_3083":56146},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3632":1669,"_31184":1661,"_5":31540,"_21603":56148,"_28376":56149,"_3083":56150},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3632":1670,"_31184":1661,"_5":31540,"_21603":56152,"_28376":56153,"_3083":56154},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3632":1671,"_31184":1661,"_21603":56156,"_5":14870,"_28376":1661,"_3083":56157},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3632":1672,"_31184":1661,"_21603":56159,"_5":14870,"_28376":56126,"_3083":56160},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3632":1673,"_31184":1661,"_21603":56162,"_5":14870,"_28376":56126,"_3083":56163},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3632":1674,"_31184":1661,"_21603":56165,"_5":14870,"_28376":56126,"_3083":56166},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3632":1675,"_31184":1661,"_21603":56168,"_5":14870,"_28376":56126,"_3083":56169},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3632":1676,"_31184":1661,"_21603":56171,"_5":14870,"_28376":56126,"_3083":56172},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3632":1677,"_31184":1661,"_21603":56174,"_5":14870,"_28376":56129,"_3083":56175},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3632":1678,"_31184":1661,"_21603":56177,"_5":14870,"_28376":56129,"_3083":56178},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3632":1679,"_31184":1661,"_21603":56180,"_5":14870,"_28376":56133,"_3083":56181},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3632":1680,"_31184":1661,"_21603":56183,"_5":14870,"_28376":56133,"_3083":56184},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3632":1681,"_31184":1661,"_21603":56186,"_5":14870,"_28376":56133,"_3083":56187},[],"Setting",{"_3632":1682,"_31184":1661,"_21603":56189,"_5":14870,"_28376":56133,"_3083":56190},[],"Evaluation value",{"_3632":1683,"_31184":1661,"_21603":56192,"_5":14870,"_28376":56133,"_3083":56193},[],"Enrollment CA",{"_3632":1684,"_31184":1661,"_21603":56195,"_5":14870,"_28376":56133,"_3083":56196},[],"Issuing root from `device-root.pem`.",{"_3632":1685,"_31184":1661,"_21603":56198,"_5":14870,"_28376":56133,"_3083":54000},[],{"_3632":1686,"_31184":1661,"_21603":56200,"_5":14870,"_28376":56133,"_3083":56201},[],"The 1-hour leaf profile you just prepared.",{"_3632":1687,"_31184":1661,"_21603":56203,"_5":14870,"_28376":56133,"_3083":56204},[],"Protocol / Registration Mode",{"_3632":1688,"_31184":1661,"_21603":56206,"_5":14870,"_28376":56133,"_3083":56207},[],"`EST_RFC7030` / `JITP`.",{"_3632":1689,"_31184":1661,"_21603":56209,"_5":14870,"_28376":56133,"_3083":56210},[],"Verify CSR Signature",{"_3632":1690,"_31184":1661,"_21603":56212,"_5":14870,"_28376":56133,"_3083":56213},[],"Enabled.",{"_3632":1691,"_31184":1661,"_21603":56215,"_5":14870,"_28376":56133,"_3083":56216},[],"Enable Replaceable Enrollment",{"_3632":1692,"_31184":1661,"_21603":56218,"_5":14870,"_28376":56133,"_3083":56219},[],"Disabled; the ID must be new.",{"_3632":1693,"_31184":1661,"_21603":56221,"_5":14870,"_28376":56133,"_3083":56222},[],"Initial authentication",{"_3632":1694,"_31184":1661,"_21603":56224,"_5":14870,"_28376":56133,"_3083":56225},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3632":1695,"_31184":1661,"_21603":56227,"_5":14870,"_28376":56133,"_3083":56228},[],"Renewal authentication",{"_3632":1696,"_31184":1661,"_21603":56230,"_5":14870,"_28376":56133,"_3083":56231},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3632":1697,"_31184":1661,"_21603":56233,"_5":14870,"_28376":56133,"_3083":56234},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3632":1698,"_31184":1661,"_21603":56236,"_5":14870,"_28376":56133,"_3083":56237},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3632":1699,"_31184":1661,"_21603":56239,"_5":14870,"_28376":56133,"_3083":56240},[],"Re-enrollment Delta",{"_3632":1700,"_31184":1661,"_21603":56242,"_5":14870,"_28376":56133,"_3083":56243},[],"1 hour.",{"_3632":1701,"_31184":1661,"_21603":56245,"_5":14870,"_28376":56133,"_3083":56246},[],"Preventive / Critical Delta",{"_3632":1702,"_31184":1661,"_21603":56248,"_5":14870,"_28376":56133,"_3083":56249},[],"30 minutes / 10 minutes.",{"_3632":1703,"_31184":1661,"_21603":56251,"_5":14870,"_28376":56133,"_3083":56252},[],"Revoke on Re-enrollment",{"_3632":1704,"_31184":1661,"_21603":56254,"_5":14870,"_28376":56133,"_3083":56255},[],"Disabled to test the successor before retiring the previous identity.",{"_3632":1705,"_31184":1661,"_21603":56257,"_5":14870,"_28376":56133,"_3083":54008},[],{"_3632":1706,"_31184":1661,"_21603":56259,"_5":14870,"_28376":56133,"_3083":56260},[],"Disabled; the operational key is generated in the client.",{"_3632":1707,"_31184":1661,"_21603":56262,"_5":14870,"_28376":56133,"_3083":56263},[],"CA Distribution",{"_3632":1708,"_31184":1661,"_21603":56265,"_5":14870,"_28376":56133,"_3083":56266},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3632":1709,"_31184":1661,"_21603":56268,"_5":14870,"_28376":56133,"_3083":56269},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3632":1710,"_31184":1661,"_21603":56271,"_5":14870,"_28376":56137,"_3083":56272},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3632":1711,"_31184":1661,"_21603":56274,"_5":14870,"_28376":56137,"_3083":56275},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3632":1712,"_31184":1661,"_21603":56277,"_5":14870,"_28376":56141,"_3083":56278},[],"Generate a new key and CSR with the selected identifier:",{"_3632":1713,"_31184":1661,"_21603":56280,"_5":14870,"_28376":56141,"_3083":56281},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3632":1714,"_31184":1661,"_21603":56283,"_5":14870,"_28376":56141,"_3083":56284},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3632":1715,"_31184":1661,"_21603":56286,"_5":14870,"_28376":56145,"_3083":56287},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3632":1716,"_31184":1661,"_21603":56289,"_5":14870,"_28376":56145,"_3083":56290},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3632":1717,"_31184":1661,"_21603":56292,"_5":14870,"_28376":56149,"_3083":56293},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3632":1718,"_31184":1661,"_21603":56295,"_5":14870,"_28376":56149,"_3083":56296},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3632":1719,"_31184":1661,"_21603":56298,"_5":14870,"_28376":56149,"_3083":56299},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3632":1720,"_31184":1661,"_21603":56301,"_5":14870,"_28376":56149,"_3083":56302},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3632":1721,"_31184":1661,"_21603":56304,"_5":14870,"_28376":56149,"_3083":56305},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3632":1722,"_31184":1661,"_21603":56307,"_5":14870,"_28376":56153,"_3083":56308},[],"Check",{"_3632":1723,"_31184":1661,"_21603":56310,"_5":14870,"_28376":56153,"_3083":56311},[],"Expected result",{"_3632":1724,"_31184":1661,"_21603":56313,"_5":14870,"_28376":56153,"_3083":56314},[],"Registration",{"_3632":1725,"_31184":1661,"_21603":56316,"_5":14870,"_28376":56153,"_3083":56317},[],"ID created automatically and correct DMS.",{"_3632":1726,"_31184":1661,"_21603":56319,"_5":14870,"_28376":56153,"_3083":55575},[],{"_3632":1727,"_31184":1661,"_21603":56321,"_5":14870,"_28376":56153,"_3083":56322},[],"CN, profile, serial and key verified.",{"_3632":1728,"_31184":1661,"_21603":56324,"_5":14870,"_28376":56153,"_3083":56325},[],"Inventory",{"_3632":1729,"_31184":1661,"_21603":56327,"_5":14870,"_28376":56153,"_3083":56328},[],"Received serial visible as the current identity and in history.",{"_3632":1730,"_31184":1661,"_21603":56330,"_5":14870,"_28376":56153,"_3083":56331},[],"Consumer",{"_3632":1731,"_31184":1661,"_21603":56333,"_5":14870,"_28376":56153,"_3083":56334},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3632":1732,"_31184":1661,"_21603":56336,"_5":14870,"_28376":56153,"_3083":56337},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3632":1733,"_31184":1661,"_21603":56339,"_5":14870,"_28376":56153,"_3083":56340},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3632":1734,"_31184":1734,"_5":15230,"_3083":53696,"_31543":56342,"_21603":56343,"_28376":1734},[50996,52508,53680,56119],[],{"_3632":1735,"_31184":1734,"_21603":56345,"_5":14870,"_28376":1734,"_3083":56346},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3632":1736,"_31184":1734,"_5":31540,"_21603":56348,"_28376":56349,"_3083":51006},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3632":1737,"_31184":1734,"_5":31540,"_21603":56351,"_28376":56352,"_3083":56353},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3632":1738,"_31184":1734,"_5":31540,"_21603":56355,"_28376":56356,"_3083":56357},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3632":1739,"_31184":1734,"_5":31540,"_21603":56359,"_28376":56360,"_3083":56361},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3632":1740,"_31184":1734,"_5":31540,"_21603":56363,"_28376":56364,"_3083":56365},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3632":1741,"_31184":1734,"_5":31540,"_21603":56367,"_28376":56368,"_3083":56369},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3632":1742,"_31184":1734,"_5":31540,"_21603":56371,"_28376":56372,"_3083":56311},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3632":1743,"_31184":1734,"_5":31540,"_21603":56374,"_28376":56375,"_3083":56376},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3632":1744,"_31184":1734,"_5":31540,"_21603":56378,"_28376":56379,"_3083":56380},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3632":1745,"_31184":1734,"_21603":56382,"_5":14870,"_28376":1734,"_3083":56383},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3632":1746,"_31184":1734,"_21603":56385,"_5":14870,"_28376":1734,"_3083":56386},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3632":1747,"_31184":1734,"_21603":56388,"_5":14870,"_28376":56349,"_3083":56389},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3632":1748,"_31184":1734,"_21603":56391,"_5":14870,"_28376":56349,"_3083":56392},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3632":1749,"_31184":1734,"_21603":56394,"_5":14870,"_28376":56349,"_3083":56395},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3632":1750,"_31184":1734,"_21603":56397,"_5":14870,"_28376":56349,"_3083":56398},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3632":1751,"_31184":1734,"_21603":56400,"_5":14870,"_28376":56352,"_3083":56401},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3632":1752,"_31184":1734,"_21603":56403,"_5":14870,"_28376":56352,"_3083":56404},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3632":1753,"_31184":1734,"_21603":56406,"_5":14870,"_28376":56352,"_3083":56407},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3632":1754,"_31184":1734,"_21603":56409,"_5":14870,"_28376":56352,"_3083":56410},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3632":1755,"_31184":1734,"_21603":56412,"_5":14870,"_28376":56352,"_3083":56413},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3632":1756,"_31184":1734,"_21603":56415,"_5":14870,"_28376":56352,"_3083":56416},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3632":1757,"_31184":1734,"_21603":56418,"_5":14870,"_28376":56352,"_3083":56419},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3632":1758,"_31184":1734,"_21603":56421,"_5":14870,"_28376":56352,"_3083":56422},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3632":1759,"_31184":1734,"_21603":56424,"_5":14870,"_28376":56356,"_3083":56425},[],"Open **Managed Devices** and the registration action. Complete:",{"_3632":1760,"_31184":1734,"_21603":56427,"_5":14870,"_28376":56356,"_3083":56428},[],"**Device ID**: `device-001`.",{"_3632":1761,"_31184":1734,"_21603":56430,"_5":14870,"_28376":56356,"_3083":56431},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3632":1762,"_31184":1734,"_21603":56433,"_5":14870,"_28376":56356,"_3083":56434},[],"**Icon** and **Tags**: optional classification.",{"_3632":1763,"_31184":1734,"_21603":56436,"_5":14870,"_28376":56356,"_3083":56437},[],"Confirm registration.",{"_3632":1764,"_31184":1734,"_21603":56439,"_5":14870,"_28376":56360,"_3083":56440},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3632":1765,"_31184":1734,"_21603":56442,"_5":14870,"_28376":56360,"_3083":56443},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3632":1766,"_31184":1734,"_21603":56445,"_5":14870,"_28376":56364,"_3083":56446},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3632":1767,"_31184":1734,"_21603":56448,"_5":14870,"_28376":56364,"_3083":56449},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3632":1768,"_31184":1734,"_21603":56451,"_5":14870,"_28376":56368,"_3083":56452},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3632":1769,"_31184":1734,"_21603":56454,"_5":14870,"_28376":56368,"_3083":56455},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3632":1770,"_31184":1734,"_21603":56457,"_5":14870,"_28376":56372,"_3083":56308},[],{"_3632":1771,"_31184":1734,"_21603":56459,"_5":14870,"_28376":56372,"_3083":56460},[],"Result",{"_3632":1772,"_31184":1734,"_21603":56462,"_5":14870,"_28376":56372,"_3083":55558},[],{"_3632":1773,"_31184":1734,"_21603":56464,"_5":14870,"_28376":56372,"_3083":56465},[],"`device-001` appears in inventory with the expected DMS.",{"_3632":1774,"_31184":1734,"_21603":56467,"_5":14870,"_28376":56372,"_3083":56468},[],"Current identity",{"_3632":1775,"_31184":1734,"_21603":56470,"_5":14870,"_28376":56372,"_3083":56471},[],"The associated certificate matches the one you verified in PKI.",{"_3632":1776,"_31184":1734,"_21603":56473,"_5":14870,"_28376":56372,"_3083":56474},[],"History",{"_3632":1777,"_31184":1734,"_21603":56476,"_5":14870,"_28376":56372,"_3083":56477},[],"The associated issuance appears with its serial number and dates.",{"_3632":1778,"_31184":1734,"_21603":56479,"_5":14870,"_28376":56372,"_3083":56480},[],"Key and certificate",{"_3632":1779,"_31184":1734,"_21603":56482,"_5":14870,"_28376":56372,"_3083":56483},[],"You have the verified pair ready to install on the device.",{"_3632":1780,"_31184":1734,"_21603":56485,"_5":14870,"_28376":56375,"_3083":56486},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3632":1781,"_31184":1734,"_21603":56488,"_5":14870,"_28376":56375,"_3083":56489},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3632":1782,"_31184":1734,"_21603":56491,"_5":14870,"_28376":56375,"_3083":56492},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3632":1783,"_31184":1734,"_21603":56494,"_5":14870,"_28376":56375,"_3083":56495},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3632":1784,"_31184":1734,"_21603":56497,"_5":14870,"_28376":56379,"_3083":56498},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3632":1785,"_31184":1734,"_21603":56500,"_5":14870,"_28376":56379,"_3083":56501},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3632":1786,"_31184":1734,"_21603":56503,"_5":14870,"_28376":56379,"_3083":56504},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3632":1787,"_31184":1787,"_5":15230,"_3083":56506,"_31543":56507,"_21603":56508,"_28376":1787},"Lamassu IoT Platform",[50996,52508],[],{"_3632":1788,"_31184":1787,"_21603":56510,"_5":14870,"_28376":1787,"_3083":56511},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3632":1789,"_31184":1787,"_5":31540,"_21603":56513,"_28376":56514,"_3083":55994},[],"/docs/pr-preview/pr-75/platform/overview#start-here",{"_3632":1790,"_31184":1787,"_5":31540,"_21603":56516,"_28376":56517,"_3083":56518},[],"/docs/pr-preview/pr-75/platform/overview#choose-your-path","Choose your path",{"_3632":1791,"_31184":1787,"_5":31540,"_21603":56520,"_28376":56521,"_3083":56522},[],"/docs/pr-preview/pr-75/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3632":1792,"_31184":1787,"_5":31540,"_21603":56524,"_28376":56525,"_3083":56526},[],"/docs/pr-preview/pr-75/platform/overview#core-capabilities","Core capabilities",{"_3632":1793,"_31184":1787,"_5":31540,"_21603":56528,"_28376":56529,"_3083":56530},[],"/docs/pr-preview/pr-75/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3632":1794,"_31184":1787,"_5":31540,"_21603":56532,"_28376":56533,"_3083":56534},[],"/docs/pr-preview/pr-75/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3632":1795,"_31184":1787,"_5":31540,"_21603":56536,"_28376":56537,"_3083":56538},[],"/docs/pr-preview/pr-75/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3632":1796,"_31184":1787,"_5":31540,"_21603":56540,"_28376":56541,"_3083":56542},[],"/docs/pr-preview/pr-75/platform/overview#automate-device-identities","Automate device identities",{"_3632":1797,"_31184":1787,"_5":31540,"_21603":56544,"_28376":56545,"_3083":56546},[],"/docs/pr-preview/pr-75/platform/overview#publish-validation-status","Publish validation status",{"_3632":1798,"_31184":1787,"_5":31540,"_21603":56548,"_28376":56549,"_3083":56550},[],"/docs/pr-preview/pr-75/platform/overview#react-to-events","React to events",{"_3632":1799,"_31184":1787,"_5":31540,"_21603":56552,"_28376":56553,"_3083":56554},[],"/docs/pr-preview/pr-75/platform/overview#operational-reference","Operational reference",{"_3632":1800,"_31184":1787,"_21603":56556,"_5":14870,"_28376":1787,"_3083":56557},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3632":1801,"_31184":1787,"_21603":56559,"_5":14870,"_28376":56514,"_3083":56560},[],"Choose the result you need:",{"_3632":1802,"_31184":1787,"_21603":56562,"_5":14870,"_28376":56514,"_3083":56563},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3632":1803,"_31184":1787,"_21603":56565,"_5":14870,"_28376":56514,"_3083":56566},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3632":1804,"_31184":1787,"_21603":56568,"_5":14870,"_28376":56514,"_3083":56569},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3632":1805,"_31184":1787,"_21603":56571,"_5":14870,"_28376":56517,"_3083":56572},[],"Section",{"_3632":1806,"_31184":1787,"_21603":56574,"_5":14870,"_28376":56517,"_3083":56575},[],"What you manage",{"_3632":1807,"_31184":1787,"_21603":56577,"_5":14870,"_28376":56517,"_3083":56578},[],"Entry point",{"_3632":1808,"_31184":1787,"_21603":56580,"_5":14870,"_28376":56517,"_3083":56581},[],"**PKI**",{"_3632":1809,"_31184":1787,"_21603":56583,"_5":14870,"_28376":56517,"_3083":56584},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3632":1810,"_31184":1787,"_21603":56586,"_5":14870,"_28376":56517,"_3083":56587},[],"PKI overview",{"_3632":1811,"_31184":1787,"_21603":56589,"_5":14870,"_28376":56517,"_3083":56590},[],"**IoT Fleets**",{"_3632":1812,"_31184":1787,"_21603":56592,"_5":14870,"_28376":56517,"_3083":56593},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3632":1813,"_31184":1787,"_21603":56595,"_5":14870,"_28376":56517,"_3083":56596},[],"IoT Fleets overview",{"_3632":1814,"_31184":1787,"_21603":56598,"_5":14870,"_28376":56517,"_3083":56599},[],"**Administration**",{"_3632":1815,"_31184":1787,"_21603":56601,"_5":14870,"_28376":56517,"_3083":56602},[],"Operator permissions, audit and event subscriptions.",{"_3632":1816,"_31184":1787,"_21603":56604,"_5":14870,"_28376":56517,"_3083":52510},[],{"_3632":1817,"_31184":1787,"_21603":56606,"_5":14870,"_28376":56517,"_3083":56607},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3632":1818,"_31184":1787,"_21603":56609,"_5":14870,"_28376":56521,"_3083":56610},[],"An identity's journey connects four responsibilities:",{"_3632":1819,"_31184":1787,"_21603":56612,"_5":14870,"_28376":56521,"_3083":56613},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3632":1820,"_31184":1787,"_21603":56615,"_5":14870,"_28376":56521,"_3083":56616},[],"The provisioning administrator configures the DMS and initial trust.",{"_3632":1821,"_31184":1787,"_21603":56618,"_5":14870,"_28376":56521,"_3083":56619},[],"The device client requests a certificate and installs it with the matching key.",{"_3632":1822,"_31184":1787,"_21603":56621,"_5":14870,"_28376":56521,"_3083":56622},[],"The consumer validates the identity and applies its access permissions.",{"_3632":1823,"_31184":1787,"_21603":56624,"_5":14870,"_28376":56521,"_3083":56625},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3632":1824,"_31184":1787,"_21603":56627,"_5":14870,"_28376":56529,"_3083":56628},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3632":1825,"_31184":1787,"_21603":56630,"_5":14870,"_28376":56533,"_3083":56631},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3632":1826,"_31184":1787,"_21603":56633,"_5":14870,"_28376":56537,"_3083":56634},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3632":1827,"_31184":1787,"_21603":56636,"_5":14870,"_28376":56541,"_3083":56637},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3632":1828,"_31184":1787,"_21603":56639,"_5":14870,"_28376":56545,"_3083":56640},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3632":1829,"_31184":1787,"_21603":56642,"_5":14870,"_28376":56549,"_3083":56643},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3632":1830,"_31184":1787,"_21603":56645,"_5":14870,"_28376":56553,"_3083":56088},[],{"_3632":1831,"_31184":1787,"_21603":56647,"_5":14870,"_28376":56553,"_3083":56648},[],"What it prepares or checks",{"_3632":1832,"_31184":1787,"_21603":56650,"_5":14870,"_28376":56553,"_3083":56091},[],{"_3632":1833,"_31184":1787,"_21603":56652,"_5":14870,"_28376":56553,"_3083":56653},[],"Key custody, CA hierarchy, profiles and validation.",{"_3632":1834,"_31184":1787,"_21603":56655,"_5":14870,"_28376":56553,"_3083":56656},[],"Fleet administrator",{"_3632":1835,"_31184":1787,"_21603":56658,"_5":14870,"_28376":56553,"_3083":56659},[],"DMS, device admission, renewal policy and inventory.",{"_3632":1836,"_31184":1787,"_21603":56661,"_5":14870,"_28376":56553,"_3083":56103},[],{"_3632":1837,"_31184":1787,"_21603":56663,"_5":14870,"_28376":56553,"_3083":56664},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3632":1838,"_31184":1787,"_21603":56666,"_5":14870,"_28376":56553,"_3083":56109},[],{"_3632":1839,"_31184":1787,"_21603":56668,"_5":14870,"_28376":56553,"_3083":56669},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3632":1840,"_31184":1787,"_21603":56671,"_5":14870,"_28376":56553,"_3083":56672},[],"Infrastructure operator",{"_3632":1841,"_31184":1787,"_21603":56674,"_5":14870,"_28376":56553,"_3083":56675},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3632":1842,"_31184":1787,"_21603":56677,"_5":14870,"_28376":56553,"_3083":56678},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3632":1843,"_31184":1843,"_5":15230,"_3083":56680,"_31543":56681,"_21603":56684,"_28376":1843},"CA hierarchy and rotation",[50996,52508,56682,56683],"PKI","Keys, authorities and certificates",[],{"_3632":1844,"_31184":1843,"_21603":56686,"_5":14870,"_28376":1843,"_3083":56687},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3632":1845,"_31184":1843,"_5":31540,"_21603":56689,"_28376":56690,"_3083":56691},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3632":1846,"_31184":1843,"_5":31540,"_21603":56693,"_28376":56694,"_3083":56695},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3632":1847,"_31184":1843,"_5":31540,"_21603":56697,"_28376":56698,"_3083":56699},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3632":1848,"_31184":1843,"_5":31540,"_21603":56701,"_28376":56702,"_3083":56703},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3632":1849,"_31184":1843,"_5":31540,"_21603":56705,"_28376":56706,"_3083":56707},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3632":1850,"_31184":1843,"_5":31540,"_21603":56709,"_28376":56710,"_3083":56711},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3632":1851,"_31184":1843,"_5":31540,"_21603":56713,"_28376":56714,"_3083":56715},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3632":1852,"_31184":1843,"_5":31540,"_21603":56717,"_28376":56718,"_3083":56719},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3632":1853,"_31184":1843,"_5":31540,"_21603":56721,"_28376":56722,"_3083":56723},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3632":1854,"_31184":1843,"_5":31540,"_21603":56725,"_28376":56726,"_3083":56727},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3632":1855,"_31184":1843,"_5":31540,"_21603":56729,"_28376":56730,"_3083":56731},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3632":1856,"_31184":1843,"_5":31540,"_21603":56733,"_28376":56734,"_3083":56735},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3632":1857,"_31184":1843,"_21603":56737,"_5":14870,"_28376":1843,"_3083":56738},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3632":1858,"_31184":1843,"_21603":56740,"_5":14870,"_28376":1843,"_3083":56741},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3632":1859,"_31184":1843,"_21603":56743,"_5":14870,"_28376":56690,"_3083":56744},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3632":1860,"_31184":1843,"_21603":56746,"_5":14870,"_28376":56690,"_3083":56747},[],"environment, such as production and preproduction;",{"_3632":1861,"_31184":1843,"_21603":56749,"_5":14870,"_28376":56690,"_3083":56750},[],"owner or operating team;",{"_3632":1862,"_31184":1843,"_21603":56752,"_5":14870,"_28376":56690,"_3083":56753},[],"device family or manufacturing process;",{"_3632":1863,"_31184":1843,"_21603":56755,"_5":14870,"_28376":56690,"_3083":56756},[],"region or regulatory requirement;",{"_3632":1864,"_31184":1843,"_21603":56758,"_5":14870,"_28376":56690,"_3083":56759},[],"cryptographic engine or key policy;",{"_3632":1865,"_31184":1843,"_21603":56761,"_5":14870,"_28376":56690,"_3083":56762},[],"maintenance window and renewal cadence.",{"_3632":1866,"_31184":1843,"_21603":56764,"_5":14870,"_28376":56690,"_3083":56765},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3632":1867,"_31184":1843,"_21603":56767,"_5":14870,"_28376":56690,"_3083":56768},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3632":1868,"_31184":1843,"_21603":56770,"_5":14870,"_28376":56694,"_3083":56771},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3632":1869,"_31184":1843,"_21603":56773,"_5":14870,"_28376":56694,"_3083":56774},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3632":1870,"_31184":1843,"_21603":56776,"_5":14870,"_28376":56694,"_3083":56777},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3632":1871,"_31184":1843,"_21603":56779,"_5":14870,"_28376":56694,"_3083":56780},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3632":1872,"_31184":1843,"_21603":56782,"_5":14870,"_28376":56698,"_3083":56783},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3632":1873,"_31184":1843,"_21603":56785,"_5":14870,"_28376":56698,"_3083":56786},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3632":1874,"_31184":1843,"_21603":56788,"_5":14870,"_28376":56698,"_3083":56789},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3632":1875,"_31184":1843,"_21603":56791,"_5":14870,"_28376":56698,"_3083":56792},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3632":1876,"_31184":1843,"_21603":56794,"_5":14870,"_28376":56706,"_3083":56795},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3632":1877,"_31184":1843,"_21603":56797,"_5":14870,"_28376":56710,"_3083":56798},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3632":1878,"_31184":1843,"_21603":56800,"_5":14870,"_28376":56714,"_3083":56801},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3632":1879,"_31184":1843,"_21603":56803,"_5":14870,"_28376":56718,"_3083":56804},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3632":1880,"_31184":1843,"_21603":56806,"_5":14870,"_28376":56722,"_3083":56807},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3632":1881,"_31184":1843,"_21603":56809,"_5":14870,"_28376":56726,"_3083":56810},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3632":1882,"_31184":1843,"_21603":56812,"_5":14870,"_28376":56730,"_3083":56813},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3632":1883,"_31184":1843,"_21603":56815,"_5":14870,"_28376":56730,"_3083":56816},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3632":1884,"_31184":1843,"_21603":56818,"_5":14870,"_28376":56730,"_3083":56819},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3632":1885,"_31184":1843,"_21603":56821,"_5":14870,"_28376":56730,"_3083":56822},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3632":1886,"_31184":1843,"_21603":56824,"_5":14870,"_28376":56734,"_3083":56825},[],"The new chain ends in an anchor installed by the consumer.",{"_3632":1887,"_31184":1843,"_21603":56827,"_5":14870,"_28376":56734,"_3083":56828},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3632":1888,"_31184":1843,"_21603":56830,"_5":14870,"_28376":56734,"_3083":56831},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3632":1889,"_31184":1843,"_21603":56833,"_5":14870,"_28376":56734,"_3083":56834},[],"Re-enrollment accepts the old identity during the planned period.",{"_3632":1890,"_31184":1843,"_21603":56836,"_5":14870,"_28376":56734,"_3083":56837},[],"OCSP and CRL respond for the authorities that remain active.",{"_3632":1891,"_31184":1843,"_21603":56839,"_5":14870,"_28376":56734,"_3083":56840},[],"No DMS is left accidentally issuing from the old CA.",{"_3632":1892,"_31184":1843,"_21603":56842,"_5":14870,"_28376":56734,"_3083":56843},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3632":1893,"_31184":1893,"_5":15230,"_3083":56845,"_31543":56846,"_21603":56847,"_28376":1893},"Certification authorities",[50996,52508,56682,56683],[],{"_3632":1894,"_31184":1893,"_21603":56849,"_5":14870,"_28376":1893,"_3083":56850},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3632":1895,"_31184":1893,"_5":31540,"_21603":56852,"_28376":56853,"_3083":56854},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3632":1896,"_31184":1893,"_5":31540,"_21603":56856,"_28376":56857,"_3083":56858},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3632":1897,"_31184":1893,"_5":31540,"_21603":56860,"_28376":56861,"_3083":51006},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#before-you-begin",{"_3632":1898,"_31184":1893,"_5":31540,"_21603":56863,"_28376":56864,"_3083":56865},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3632":1899,"_31184":1893,"_5":31540,"_21603":56867,"_28376":56868,"_3083":56869},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3632":1900,"_31184":1893,"_5":31540,"_21603":56871,"_28376":56872,"_3083":56873},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3632":1901,"_31184":1893,"_5":31540,"_21603":56875,"_28376":56876,"_3083":56877},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3632":1902,"_31184":1893,"_5":31540,"_21603":56879,"_28376":56880,"_3083":56881},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3632":1903,"_31184":1893,"_5":31540,"_21603":56883,"_28376":56884,"_3083":56885},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3632":1904,"_31184":1893,"_5":31540,"_21603":56887,"_28376":56888,"_3083":56889},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3632":1905,"_31184":1893,"_5":31540,"_21603":56891,"_28376":56892,"_3083":56893},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3632":1906,"_31184":1893,"_5":31540,"_21603":56895,"_28376":56896,"_3083":56897},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3632":1907,"_31184":1893,"_5":31540,"_21603":56899,"_28376":56900,"_3083":56901},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3632":1908,"_31184":1893,"_5":31540,"_21603":56903,"_28376":56904,"_3083":56905},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3632":1909,"_31184":1893,"_5":31540,"_21603":56907,"_28376":56908,"_3083":56909},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3632":1910,"_31184":1893,"_5":31540,"_21603":56911,"_28376":56912,"_3083":56913},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#ca-states","CA states",{"_3632":1911,"_31184":1893,"_5":31540,"_21603":56915,"_28376":56916,"_3083":56917},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3632":1912,"_31184":1893,"_5":31540,"_21603":56919,"_28376":56920,"_3083":56921},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3632":1913,"_31184":1893,"_5":31540,"_21603":56923,"_28376":56924,"_3083":56925},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3632":1914,"_31184":1893,"_5":31540,"_21603":56927,"_28376":56928,"_3083":56929},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3632":1915,"_31184":1893,"_5":31540,"_21603":56931,"_28376":56932,"_3083":56933},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3632":1916,"_31184":1893,"_5":31540,"_21603":56935,"_28376":56936,"_3083":56937},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3632":1917,"_31184":1893,"_5":31540,"_21603":56939,"_28376":56940,"_3083":56941},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3632":1918,"_31184":1893,"_5":31540,"_21603":56943,"_28376":56944,"_3083":56945},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3632":1919,"_31184":1893,"_21603":56947,"_5":14870,"_28376":1893,"_3083":56948},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3632":1920,"_31184":1893,"_21603":56950,"_5":14870,"_28376":1893,"_3083":56951},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3632":1921,"_31184":1893,"_21603":56953,"_5":14870,"_28376":1893,"_3083":56954},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3632":1922,"_31184":1893,"_21603":56956,"_5":14870,"_28376":56853,"_3083":56957},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3632":1923,"_31184":1893,"_21603":56959,"_5":14870,"_28376":56853,"_3083":56960},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3632":1924,"_31184":1893,"_21603":56962,"_5":14870,"_28376":56853,"_3083":56963},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3632":1925,"_31184":1893,"_21603":56965,"_5":14870,"_28376":56853,"_3083":56966},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3632":1926,"_31184":1893,"_21603":56968,"_5":14870,"_28376":56853,"_3083":56969},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3632":1927,"_31184":1893,"_21603":56971,"_5":14870,"_28376":56861,"_3083":56972},[],"Decide whether the CA will be a root or an intermediate.",{"_3632":1928,"_31184":1893,"_21603":56974,"_5":14870,"_28376":56861,"_3083":56975},[],"Choose the engine that will keep the key.",{"_3632":1929,"_31184":1893,"_21603":56977,"_5":14870,"_28376":56861,"_3083":56978},[],"Define a validity longer than that of the certificates it will issue.",{"_3632":1930,"_31184":1893,"_21603":56980,"_5":14870,"_28376":56861,"_3083":56981},[],"For an intermediate CA, make sure the parent CA is active.",{"_3632":1931,"_31184":1893,"_21603":56983,"_5":14870,"_28376":56864,"_3083":56984},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3632":1932,"_31184":1893,"_21603":56986,"_5":14870,"_28376":56868,"_3083":56987},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3632":1933,"_31184":1893,"_21603":56989,"_5":14870,"_28376":56868,"_3083":56990},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3632":1934,"_31184":1893,"_21603":56992,"_5":14870,"_28376":56872,"_3083":56993},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3632":1935,"_31184":1893,"_21603":56995,"_5":14870,"_28376":56876,"_3083":56996},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3632":1936,"_31184":1893,"_21603":56998,"_5":14870,"_28376":56876,"_3083":56999},[],"`C`: two-letter ISO 3166-1 country code.",{"_3632":1937,"_31184":1893,"_21603":57001,"_5":14870,"_28376":56876,"_3083":57002},[],"`ST`: state or province.",{"_3632":1938,"_31184":1893,"_21603":57004,"_5":14870,"_28376":56876,"_3083":57005},[],"`L`: locality.",{"_3632":1939,"_31184":1893,"_21603":57007,"_5":14870,"_28376":56876,"_3083":57008},[],"`O`: organization.",{"_3632":1940,"_31184":1893,"_21603":57010,"_5":14870,"_28376":56876,"_3083":57011},[],"`OU`: organizational unit.",{"_3632":1941,"_31184":1893,"_21603":57013,"_5":14870,"_28376":56876,"_3083":57014},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3632":1942,"_31184":1893,"_21603":57016,"_5":14870,"_28376":56880,"_3083":57017},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3632":1943,"_31184":1893,"_21603":57019,"_5":14870,"_28376":56880,"_3083":57020},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3632":1944,"_31184":1893,"_21603":57022,"_5":14870,"_28376":56884,"_3083":57023},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3632":1945,"_31184":1893,"_21603":57025,"_5":14870,"_28376":56884,"_3083":57026},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3632":1946,"_31184":1893,"_21603":57028,"_5":14870,"_28376":56888,"_3083":57029},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3632":1947,"_31184":1893,"_21603":57031,"_5":14870,"_28376":56888,"_3083":57032},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3632":1948,"_31184":1893,"_21603":57034,"_5":14870,"_28376":56892,"_3083":57035},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3632":1949,"_31184":1893,"_21603":57037,"_5":14870,"_28376":56892,"_3083":57038},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3632":1950,"_31184":1893,"_21603":57040,"_5":14870,"_28376":56892,"_3083":57041},[],"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and, when Lamassu has no stored record of that certificate yet, the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. If the import reuses the record of a deleted CA (see above and Delete a CA), the previous status is kept instead, even if the certificate has expired in the meantime. An `EXPIRED` CA rejects status changes; see certificate lifecycle.",{"_3632":1951,"_31184":1893,"_21603":57043,"_5":14870,"_28376":56892,"_3083":57044},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3632":1952,"_31184":1893,"_21603":57046,"_5":14870,"_28376":56896,"_3083":57047},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3632":1953,"_31184":1893,"_21603":57049,"_5":14870,"_28376":56900,"_3083":57050},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3632":1954,"_31184":1893,"_21603":57052,"_5":14870,"_28376":56900,"_3083":57053},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3632":1955,"_31184":1893,"_21603":57055,"_5":14870,"_28376":56904,"_3083":57056},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3632":1956,"_31184":1893,"_21603":57058,"_5":14870,"_28376":56908,"_3083":57059},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3632":1957,"_31184":1893,"_21603":57061,"_5":14870,"_28376":56908,"_3083":57062},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3632":1958,"_31184":1893,"_21603":57064,"_5":14870,"_28376":56908,"_3083":57065},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3632":1959,"_31184":1893,"_21603":57067,"_5":14870,"_28376":56912,"_3083":57068},[],"A CA only signs in `ACTIVE`. From there it can move to `EXPIRED` or to `REVOKED`, and it leaves those states only by deletion, with one exception: a revocation with `CertificateHold` can be undone.",{"_3632":1960,"_31184":1893,"_21603":57070,"_5":14870,"_28376":56912,"_3083":57071},[],"**Expiry.** The expiry monitor marks as `EXPIRED` the `ACTIVE` CAs whose validity period has ended. Until it runs, the CA already does not sign, because Lamassu checks the dates (Issue certificates).",{"_3632":1961,"_31184":1893,"_21603":57073,"_5":14870,"_28376":56912,"_3083":57074},[],"**Revocation.** Revoking with the `CertificateHold` reason is reversible. A revocation with any other reason, like `EXPIRED`, rejects every later status change. Revoking, also with `CertificateHold`, additionally acts on the subordinate CAs and the certificates it issued: Revoke a CA.",{"_3632":1962,"_31184":1893,"_21603":57076,"_5":14870,"_28376":56912,"_3083":57077},[],"**Deletion.** Only a CA revoked with another reason, or an expired one, can be deleted; an imported CA without a key can be deleted from any state. Conditions and effects in Delete a CA.",{"_3632":1963,"_31184":1893,"_21603":57079,"_5":14870,"_28376":56916,"_3083":57080},[],"Open a CA from the inventory to review:",{"_3632":1964,"_31184":1893,"_21603":57082,"_5":14870,"_28376":56916,"_3083":57083},[],"Status and validity period.",{"_3632":1965,"_31184":1893,"_21603":57085,"_5":14870,"_28376":56916,"_3083":57086},[],"Certificate and chain in PEM format.",{"_3632":1966,"_31184":1893,"_21603":57088,"_5":14870,"_28376":56916,"_3083":57089},[],"Number of active, expired and revoked certificates.",{"_3632":1967,"_31184":1893,"_21603":57091,"_5":14870,"_28376":56916,"_3083":57092},[],"Certificates issued in **Issued Certificates**.",{"_3632":1968,"_31184":1893,"_21603":57094,"_5":14870,"_28376":56916,"_3083":57095},[],"The CRL linked to the authority.",{"_3632":1969,"_31184":1893,"_21603":57097,"_5":14870,"_28376":56916,"_3083":57098},[],"Metadata and the associated cryptographic engine.",{"_3632":1970,"_31184":1893,"_21603":57100,"_5":14870,"_28376":56916,"_3083":57101},[],"You can filter the inventory by name, status and CA type.",{"_3632":1971,"_31184":1893,"_21603":57103,"_5":14870,"_28376":56920,"_3083":57104},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3632":1972,"_31184":1893,"_21603":57106,"_5":14870,"_28376":56920,"_3083":57107},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3632":1973,"_31184":1893,"_21603":57109,"_5":14870,"_28376":56920,"_3083":57110},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3632":1974,"_31184":1893,"_21603":57112,"_5":14870,"_28376":56920,"_3083":57113},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3632":1975,"_31184":1893,"_21603":57115,"_5":14870,"_28376":56920,"_3083":57116},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3632":1976,"_31184":1893,"_21603":57118,"_5":14870,"_28376":56920,"_3083":57119},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3632":1977,"_31184":1893,"_21603":57121,"_5":14870,"_28376":56924,"_3083":57122},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3632":1978,"_31184":1893,"_21603":57124,"_5":14870,"_28376":56928,"_3083":57125},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3632":1979,"_31184":1893,"_21603":57127,"_5":14870,"_28376":56932,"_3083":57128},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3632":1980,"_31184":1893,"_21603":57130,"_5":14870,"_28376":56936,"_3083":57131},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3632":1981,"_31184":1893,"_21603":57133,"_5":14870,"_28376":56940,"_3083":57134},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3632":1982,"_31184":1893,"_21603":57136,"_5":14870,"_28376":56944,"_3083":57137},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3632":1983,"_31184":1893,"_21603":57139,"_5":14870,"_28376":56944,"_3083":57140},[],"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it.",{"_3632":1984,"_31184":1893,"_21603":57142,"_5":14870,"_28376":56944,"_3083":57143},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3632":1985,"_31184":1893,"_21603":57145,"_5":14870,"_28376":56944,"_3083":57146},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3632":1986,"_31184":1893,"_21603":57148,"_5":14870,"_28376":56944,"_3083":57149},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3632":1987,"_31184":1987,"_5":15230,"_3083":57151,"_31543":57152,"_21603":57153,"_28376":1987},"Certificate profiles",[50996,52508,56682,56683],[],{"_3632":1988,"_31184":1987,"_21603":57155,"_5":14870,"_28376":1987,"_3083":57156},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3632":1989,"_31184":1987,"_5":31540,"_21603":57158,"_28376":57159,"_3083":57160},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3632":1990,"_31184":1987,"_5":31540,"_21603":57162,"_28376":57163,"_3083":57164},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#validity","Validity",{"_3632":1991,"_31184":1987,"_5":31540,"_21603":57166,"_28376":57167,"_3083":57168},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3632":1992,"_31184":1987,"_5":31540,"_21603":57170,"_28376":57171,"_3083":57172},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3632":1993,"_31184":1987,"_5":31540,"_21603":57174,"_28376":57175,"_3083":57176},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#subject","Subject",{"_3632":1994,"_31184":1987,"_5":31540,"_21603":57178,"_28376":57179,"_3083":57180},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3632":1995,"_31184":1987,"_5":31540,"_21603":57182,"_28376":57183,"_3083":57184},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3632":1996,"_31184":1987,"_5":31540,"_21603":57186,"_28376":57187,"_3083":57188},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3632":1997,"_31184":1987,"_5":31540,"_21603":57190,"_28376":57191,"_3083":57192},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3632":1998,"_31184":1987,"_5":31540,"_21603":57194,"_28376":57195,"_3083":57196},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3632":1999,"_31184":1987,"_5":31540,"_21603":57198,"_28376":57199,"_3083":57200},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3632":2000,"_31184":1987,"_5":31540,"_21603":57202,"_28376":57203,"_3083":57204},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3632":2001,"_31184":1987,"_5":31540,"_21603":57206,"_28376":57207,"_3083":57208},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3632":2002,"_31184":1987,"_5":31540,"_21603":57210,"_28376":57211,"_3083":57212},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3632":2003,"_31184":1987,"_5":31540,"_21603":57214,"_28376":57215,"_3083":57216},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#design-examples","Design examples",{"_3632":2004,"_31184":1987,"_5":31540,"_21603":57218,"_28376":57219,"_3083":57220},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3632":2005,"_31184":1987,"_21603":57222,"_5":14870,"_28376":1987,"_3083":57223},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3632":2006,"_31184":1987,"_21603":57225,"_5":14870,"_28376":1987,"_3083":57226},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3632":2007,"_31184":1987,"_21603":57228,"_5":14870,"_28376":57163,"_3083":57229},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3632":2008,"_31184":1987,"_21603":57231,"_5":14870,"_28376":57163,"_3083":57232},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3632":2009,"_31184":1987,"_21603":57234,"_5":14870,"_28376":57167,"_3083":57235},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3632":2010,"_31184":1987,"_21603":57237,"_5":14870,"_28376":57171,"_3083":57238},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3632":2011,"_31184":1987,"_21603":57240,"_5":14870,"_28376":57171,"_3083":57241},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3632":2012,"_31184":1987,"_21603":57243,"_5":14870,"_28376":57171,"_3083":57244},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3632":2013,"_31184":1987,"_21603":57246,"_5":14870,"_28376":57175,"_3083":57247},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3632":2014,"_31184":1987,"_21603":57249,"_5":14870,"_28376":57179,"_3083":57250},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3632":2015,"_31184":1987,"_21603":57252,"_5":14870,"_28376":57179,"_3083":57253},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3632":2016,"_31184":1987,"_21603":57255,"_5":14870,"_28376":57183,"_3083":57256},[],"The cryptographic enforcement can:",{"_3632":2017,"_31184":1987,"_21603":57258,"_5":14870,"_28376":57183,"_3083":57259},[],"allow or block RSA keys;",{"_3632":2018,"_31184":1987,"_21603":57261,"_5":14870,"_28376":57183,"_3083":57262},[],"limit the supported RSA sizes;",{"_3632":2019,"_31184":1987,"_21603":57264,"_5":14870,"_28376":57183,"_3083":57265},[],"allow or block ECDSA keys;",{"_3632":2020,"_31184":1987,"_21603":57267,"_5":14870,"_28376":57183,"_3083":57268},[],"limit the supported ECDSA sizes or curves.",{"_3632":2021,"_31184":1987,"_21603":57270,"_5":14870,"_28376":57183,"_3083":57271},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3632":2022,"_31184":1987,"_21603":57273,"_5":14870,"_28376":57187,"_3083":57274},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3632":2023,"_31184":1987,"_21603":57276,"_5":14870,"_28376":57187,"_3083":54445},[],{"_3632":2024,"_31184":1987,"_21603":57278,"_5":14870,"_28376":57187,"_3083":57279},[],"First choice",{"_3632":2025,"_31184":1987,"_21603":57281,"_5":14870,"_28376":57187,"_3083":57282},[],"Second choice",{"_3632":2026,"_31184":1987,"_21603":57284,"_5":14870,"_28376":57187,"_3083":57285},[],"If neither is supplied",{"_3632":2027,"_31184":1987,"_21603":57287,"_5":14870,"_28376":57187,"_3083":57288},[],"Direct signing with a CA",{"_3632":2028,"_31184":1987,"_21603":57290,"_5":14870,"_28376":57187,"_3083":57291},[],"`issuance_profile` embedded in the request",{"_3632":2029,"_31184":1987,"_21603":57293,"_5":14870,"_28376":57187,"_3083":57294},[],"Request `issuance_profile_id`",{"_3632":2030,"_31184":1987,"_21603":57296,"_5":14870,"_28376":57187,"_3083":57297},[],"CA default profile (`profile_id`).",{"_3632":2031,"_31184":1987,"_21603":57299,"_5":14870,"_28376":57187,"_3083":57300},[],"Issuance through a DMS",{"_3632":2032,"_31184":1987,"_21603":57302,"_5":14870,"_28376":57187,"_3083":57303},[],"`settings.issuance_profile_id`",{"_3632":2033,"_31184":1987,"_21603":57305,"_5":14870,"_28376":57187,"_3083":57306},[],"`settings.issuance_profile` embedded in the DMS",{"_3632":2034,"_31184":1987,"_21603":57308,"_5":14870,"_28376":57187,"_3083":57309},[],"Enrollment CA default profile.",{"_3632":2035,"_31184":1987,"_21603":57311,"_5":14870,"_28376":57187,"_3083":57312},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3632":2036,"_31184":1987,"_21603":57314,"_5":14870,"_28376":57187,"_3083":57315},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3632":2037,"_31184":1987,"_21603":57317,"_5":14870,"_28376":57195,"_3083":57318},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3632":2038,"_31184":1987,"_21603":57320,"_5":14870,"_28376":57199,"_3083":57321},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3632":2039,"_31184":1987,"_21603":57323,"_5":14870,"_28376":57203,"_3083":57324},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3632":2040,"_31184":1987,"_21603":57326,"_5":14870,"_28376":57207,"_3083":57327},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3632":2041,"_31184":1987,"_21603":57329,"_5":14870,"_28376":57211,"_3083":57330},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3632":2042,"_31184":1987,"_21603":57332,"_5":14870,"_28376":57211,"_3083":57333},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3632":2043,"_31184":1987,"_21603":57335,"_5":14870,"_28376":57215,"_3083":57336},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3632":2044,"_31184":1987,"_21603":57338,"_5":14870,"_28376":57215,"_3083":57339},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3632":2045,"_31184":1987,"_21603":57341,"_5":14870,"_28376":57215,"_3083":57342},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3632":2046,"_31184":1987,"_21603":57344,"_5":14870,"_28376":57215,"_3083":57345},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3632":2047,"_31184":1987,"_21603":57347,"_5":14870,"_28376":57219,"_3083":57348},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3632":2048,"_31184":1987,"_21603":57350,"_5":14870,"_28376":57219,"_3083":57351},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3632":2049,"_31184":2049,"_5":15230,"_3083":57353,"_31543":57354,"_21603":57356,"_28376":2049},"Certificate validation",[50996,52508,56682,57355],"Validation",[],{"_3632":2050,"_31184":2049,"_21603":57358,"_5":14870,"_28376":2049,"_3083":57359},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3632":2051,"_31184":2049,"_5":31540,"_21603":57361,"_28376":57362,"_3083":57363},[],"/docs/pr-preview/pr-75/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3632":2052,"_31184":2049,"_5":31540,"_21603":57365,"_28376":57366,"_3083":57367},[],"/docs/pr-preview/pr-75/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3632":2053,"_31184":2049,"_5":31540,"_21603":57369,"_28376":57370,"_3083":57371},[],"/docs/pr-preview/pr-75/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3632":2054,"_31184":2049,"_21603":57373,"_5":14870,"_28376":2049,"_3083":57374},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3632":2055,"_31184":2049,"_21603":57376,"_5":14870,"_28376":57362,"_3083":57377},[],"Verify these criteria together:",{"_3632":2056,"_31184":2049,"_21603":57379,"_5":14870,"_28376":57362,"_3083":56308},[],{"_3632":2057,"_31184":2049,"_21603":57381,"_5":14870,"_28376":57362,"_3083":57382},[],"Required result",{"_3632":2058,"_31184":2049,"_21603":57384,"_5":14870,"_28376":57362,"_3083":57385},[],"Chain and signature",{"_3632":2059,"_31184":2049,"_21603":57387,"_5":14870,"_28376":57362,"_3083":57388},[],"Valid chain to a root deliberately installed in the consumer.",{"_3632":2060,"_31184":2049,"_21603":57390,"_5":14870,"_28376":57362,"_3083":57391},[],"Dates",{"_3632":2061,"_31184":2049,"_21603":57393,"_5":14870,"_28376":57362,"_3083":57394},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3632":2062,"_31184":2049,"_21603":57396,"_5":14870,"_28376":57362,"_3083":52177},[],{"_3632":2063,"_31184":2049,"_21603":57398,"_5":14870,"_28376":57362,"_3083":57399},[],"Name, SAN or identifier matches the expected peer.",{"_3632":2064,"_31184":2049,"_21603":57401,"_5":14870,"_28376":57362,"_3083":51386},[],{"_3632":2065,"_31184":2049,"_21603":57403,"_5":14870,"_28376":57362,"_3083":57404},[],"KU, EKU and constraints permit the specific operation.",{"_3632":2066,"_31184":2049,"_21603":57406,"_5":14870,"_28376":57362,"_3083":57407},[],"Revocation",{"_3632":2067,"_31184":2049,"_21603":57409,"_5":14870,"_28376":57362,"_3083":57410},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3632":2068,"_31184":2049,"_21603":57412,"_5":14870,"_28376":57362,"_3083":57413},[],"Authorization",{"_3632":2069,"_31184":2049,"_21603":57415,"_5":14870,"_28376":57362,"_3083":57416},[],"The application permits that identity to perform the action.",{"_3632":2070,"_31184":2049,"_21603":57418,"_5":14870,"_28376":57362,"_3083":57419},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3632":2071,"_31184":2049,"_21603":57421,"_5":14870,"_28376":57366,"_3083":57422},[],"Mechanism",{"_3632":2072,"_31184":2049,"_21603":57424,"_5":14870,"_28376":57366,"_3083":57425},[],"When to use it",{"_3632":2073,"_31184":2049,"_21603":57427,"_5":14870,"_28376":57366,"_3083":57428},[],"What you must maintain",{"_3632":2074,"_31184":2049,"_21603":57430,"_5":14870,"_28376":57366,"_3083":57431},[],"OCSP",{"_3632":2075,"_31184":2049,"_21603":57433,"_5":14870,"_28376":57366,"_3083":57434},[],"Status query for a specific certificate.",{"_3632":2076,"_31184":2049,"_21603":57436,"_5":14870,"_28376":57366,"_3083":57437},[],"Responder access, signature verification and cache/freshness policy.",{"_3632":2077,"_31184":2049,"_21603":57439,"_5":14870,"_28376":57366,"_3083":57440},[],"CRL",{"_3632":2078,"_31184":2049,"_21603":57442,"_5":14870,"_28376":57366,"_3083":57443},[],"Local checks for many certificates or offline operation.",{"_3632":2079,"_31184":2049,"_21603":57445,"_5":14870,"_28376":57366,"_3083":57446},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3632":2080,"_31184":2049,"_21603":57448,"_5":14870,"_28376":57366,"_3083":57449},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3632":2081,"_31184":2049,"_21603":57451,"_5":14870,"_28376":57366,"_3083":57452},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3632":2082,"_31184":2049,"_21603":57454,"_5":14870,"_28376":57370,"_3083":57455},[],"Accept a current, authorized certificate with a known chain.",{"_3632":2083,"_31184":2049,"_21603":57457,"_5":14870,"_28376":57370,"_3083":57458},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3632":2084,"_31184":2049,"_21603":57460,"_5":14870,"_28376":57370,"_3083":57461},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3632":2085,"_31184":2049,"_21603":57463,"_5":14870,"_28376":57370,"_3083":57464},[],"Check that a new connection with that identity is rejected.",{"_3632":2086,"_31184":2049,"_21603":57466,"_5":14870,"_28376":57370,"_3083":57467},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3632":2087,"_31184":2049,"_21603":57469,"_5":14870,"_28376":57370,"_3083":57470},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3632":2088,"_31184":2049,"_21603":57472,"_5":14870,"_28376":57370,"_3083":57473},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3632":2089,"_31184":2049,"_21603":57475,"_5":14870,"_28376":57370,"_3083":57476},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":2090,"_31184":2049,"_21603":57478,"_5":14870,"_28376":57370,"_3083":57479},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3632":2091,"_31184":2091,"_5":15230,"_3083":57481,"_31543":57482,"_21603":57483,"_28376":2091},"Certificates",[50996,52508,56682,56683],[],{"_3632":2092,"_31184":2091,"_21603":57485,"_5":14870,"_28376":2091,"_3083":57486},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3632":2093,"_31184":2091,"_5":31540,"_21603":57488,"_28376":57489,"_3083":57490},[],"/docs/pr-preview/pr-75/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3632":2094,"_31184":2091,"_5":31540,"_21603":57492,"_28376":57493,"_3083":57494},[],"/docs/pr-preview/pr-75/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3632":2095,"_31184":2091,"_5":31540,"_21603":57496,"_28376":57497,"_3083":57498},[],"/docs/pr-preview/pr-75/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3632":2096,"_31184":2091,"_5":31540,"_21603":57500,"_28376":57501,"_3083":57502},[],"/docs/pr-preview/pr-75/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3632":2097,"_31184":2091,"_5":31540,"_21603":57504,"_28376":57505,"_3083":57506},[],"/docs/pr-preview/pr-75/platform/pki/certificates#open-the-action","Open the action",{"_3632":2098,"_31184":2091,"_5":31540,"_21603":57508,"_28376":57509,"_3083":57510},[],"/docs/pr-preview/pr-75/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3632":2099,"_31184":2091,"_5":31540,"_21603":57512,"_28376":57513,"_3083":57514},[],"/docs/pr-preview/pr-75/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3632":2100,"_31184":2091,"_5":31540,"_21603":57516,"_28376":57517,"_3083":57518},[],"/docs/pr-preview/pr-75/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3632":2101,"_31184":2091,"_5":31540,"_21603":57520,"_28376":57521,"_3083":57522},[],"/docs/pr-preview/pr-75/platform/pki/certificates#continue","Continue",{"_3632":2102,"_31184":2091,"_21603":57524,"_5":14870,"_28376":2091,"_3083":57525},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3632":2103,"_31184":2091,"_21603":57527,"_5":14870,"_28376":57489,"_3083":57528},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3632":2104,"_31184":2091,"_21603":57530,"_5":14870,"_28376":57489,"_3083":57531},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3632":2105,"_31184":2091,"_21603":57533,"_5":14870,"_28376":57489,"_3083":57534},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3632":2106,"_31184":2091,"_21603":57536,"_5":14870,"_28376":57489,"_3083":57537},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3632":2107,"_31184":2091,"_21603":57539,"_5":14870,"_28376":57489,"_3083":57540},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3632":2108,"_31184":2091,"_21603":57542,"_5":14870,"_28376":57489,"_3083":57543},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3632":2109,"_31184":2091,"_21603":57545,"_5":14870,"_28376":57489,"_3083":57546},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3632":2110,"_31184":2091,"_21603":57548,"_5":14870,"_28376":57493,"_3083":57549},[],"Download the PEM and inspect it:",{"_3632":2111,"_31184":2091,"_21603":57551,"_5":14870,"_28376":57493,"_3083":57552},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3632":2112,"_31184":2091,"_21603":57554,"_5":14870,"_28376":57497,"_3083":57555},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3632":2113,"_31184":2091,"_21603":57557,"_5":14870,"_28376":57497,"_3083":57558},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3632":2114,"_31184":2091,"_21603":57560,"_5":14870,"_28376":57497,"_3083":57561},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3632":2115,"_31184":2091,"_21603":57563,"_5":14870,"_28376":57497,"_3083":57564},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3632":2116,"_31184":2091,"_21603":57566,"_5":14870,"_28376":57497,"_3083":57567},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3632":2117,"_31184":2091,"_21603":57569,"_5":14870,"_28376":57497,"_3083":57570},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3632":2118,"_31184":2091,"_21603":57572,"_5":14870,"_28376":57497,"_3083":57573},[],"For browser key generation, follow Issue your first certificate.",{"_3632":2119,"_31184":2091,"_21603":57575,"_5":14870,"_28376":57501,"_3083":57576},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3632":2120,"_31184":2091,"_21603":57578,"_5":14870,"_28376":57505,"_3083":57579},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3632":2121,"_31184":2091,"_21603":57581,"_5":14870,"_28376":57509,"_3083":57582},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3632":2122,"_31184":2091,"_21603":57584,"_5":14870,"_28376":57513,"_3083":57585},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3632":2123,"_31184":2091,"_21603":57587,"_5":14870,"_28376":57513,"_3083":57588},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3632":2124,"_31184":2091,"_21603":57590,"_5":14870,"_28376":57513,"_3083":57591},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3632":2125,"_31184":2091,"_21603":57593,"_5":14870,"_28376":57517,"_3083":57594},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3632":2126,"_31184":2091,"_21603":57596,"_5":14870,"_28376":57517,"_3083":57597},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3632":2127,"_31184":2091,"_21603":57599,"_5":14870,"_28376":57517,"_3083":57600},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3632":2128,"_31184":2091,"_21603":57602,"_5":14870,"_28376":57521,"_3083":57603},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":2129,"_31184":2091,"_21603":57605,"_5":14870,"_28376":57521,"_3083":57606},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3632":2130,"_31184":2130,"_5":15230,"_3083":57608,"_31543":57609,"_21603":57611,"_28376":2130},"Certificate lifecycle",[50996,52508,56682,57610],"Concepts",[],{"_3632":2131,"_31184":2130,"_21603":57613,"_5":14870,"_28376":2130,"_3083":57614},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3632":2132,"_31184":2130,"_5":31540,"_21603":57616,"_28376":57617,"_3083":57618},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3632":2133,"_31184":2130,"_5":31540,"_21603":57620,"_28376":57621,"_3083":57622},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3632":2134,"_31184":2130,"_5":31540,"_21603":57624,"_28376":57625,"_3083":57626},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3632":2135,"_31184":2130,"_5":31540,"_21603":57628,"_28376":57629,"_3083":57630},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3632":2136,"_31184":2130,"_5":31540,"_21603":57632,"_28376":57633,"_3083":57634},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3632":2137,"_31184":2130,"_5":31540,"_21603":57636,"_28376":57637,"_3083":57638},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3632":2138,"_31184":2130,"_5":31540,"_21603":57640,"_28376":57641,"_3083":57642},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3632":2139,"_31184":2130,"_5":31540,"_21603":57644,"_28376":57645,"_3083":57646},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3632":2140,"_31184":2130,"_5":31540,"_21603":57648,"_28376":57649,"_3083":57650},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3632":2141,"_31184":2130,"_5":31540,"_21603":57652,"_28376":57653,"_3083":57654},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3632":2142,"_31184":2130,"_21603":57656,"_5":14870,"_28376":2130,"_3083":57657},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3632":2143,"_31184":2130,"_21603":57659,"_5":14870,"_28376":57621,"_3083":57660},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3632":2144,"_31184":2130,"_21603":57662,"_5":14870,"_28376":57625,"_3083":57663},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3632":2145,"_31184":2130,"_21603":57665,"_5":14870,"_28376":57629,"_3083":57666},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3632":2146,"_31184":2130,"_21603":57668,"_5":14870,"_28376":57633,"_3083":57669},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3632":2147,"_31184":2130,"_21603":57671,"_5":14870,"_28376":57637,"_3083":57672},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3632":2148,"_31184":2130,"_21603":57674,"_5":14870,"_28376":57641,"_3083":57675},[],"Lamassu persists four X.509 states:",{"_3632":2149,"_31184":2130,"_21603":57677,"_5":14870,"_28376":57641,"_3083":57678},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3632":2150,"_31184":2130,"_21603":57680,"_5":14870,"_28376":57641,"_3083":57681},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3632":2151,"_31184":2130,"_21603":57683,"_5":14870,"_28376":57641,"_3083":57684},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3632":2152,"_31184":2130,"_21603":57686,"_5":14870,"_28376":57641,"_3083":57687},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3632":2153,"_31184":2130,"_21603":57689,"_5":14870,"_28376":57641,"_3083":57690},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3632":2154,"_31184":2130,"_21603":57692,"_5":14870,"_28376":57645,"_3083":57693},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3632":2155,"_31184":2130,"_21603":57695,"_5":14870,"_28376":57645,"_3083":57696},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3632":2156,"_31184":2130,"_21603":57698,"_5":14870,"_28376":57645,"_3083":57699},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3632":2157,"_31184":2130,"_21603":57701,"_5":14870,"_28376":57649,"_3083":57702},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3632":2158,"_31184":2130,"_21603":57704,"_5":14870,"_28376":57649,"_3083":57705},[],"Before confirming:",{"_3632":2159,"_31184":2130,"_21603":57707,"_5":14870,"_28376":57649,"_3083":57708},[],"Identify DMSs, devices and services that trust that chain.",{"_3632":2160,"_31184":2130,"_21603":57710,"_5":14870,"_28376":57649,"_3083":57711},[],"Distribute the new chain of trust.",{"_3632":2161,"_31184":2130,"_21603":57713,"_5":14870,"_28376":57649,"_3083":57714},[],"Reissue the necessary identities.",{"_3632":2162,"_31184":2130,"_21603":57716,"_5":14870,"_28376":57649,"_3083":57717},[],"Check OCSP and CRL from a real consumer.",{"_3632":2163,"_31184":2130,"_21603":57719,"_5":14870,"_28376":57649,"_3083":57720},[],"Revoke the old CA once no legitimate traffic remains.",{"_3632":2164,"_31184":2130,"_21603":57722,"_5":14870,"_28376":57649,"_3083":57723},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3632":2165,"_31184":2130,"_21603":57725,"_5":14870,"_28376":57653,"_3083":57726},[],"Certificates entering the preventive or critical renewal window.",{"_3632":2166,"_31184":2130,"_21603":57728,"_5":14870,"_28376":57653,"_3083":57729},[],"Repeated enrollment or re-enrollment failures.",{"_3632":2167,"_31184":2130,"_21603":57731,"_5":14870,"_28376":57653,"_3083":57732},[],"Status changes and revocation reasons.",{"_3632":2168,"_31184":2130,"_21603":57734,"_5":14870,"_28376":57653,"_3083":57735},[],"OCSP and CRL publication and validity.",{"_3632":2169,"_31184":2130,"_21603":57737,"_5":14870,"_28376":57653,"_3083":57738},[],"Dependencies still presenting a replaced certificate.",{"_3632":2170,"_31184":2130,"_21603":57740,"_5":14870,"_28376":57653,"_3083":57741},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3632":2171,"_31184":2171,"_5":15230,"_3083":57743,"_31543":57744,"_21603":57745,"_28376":2171},"Trust model",[50996,52508,56682,57610],[],{"_3632":2172,"_31184":2171,"_21603":57747,"_5":14870,"_28376":2171,"_3083":57748},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3632":2173,"_31184":2171,"_5":31540,"_21603":57750,"_28376":57751,"_3083":57752},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3632":2174,"_31184":2171,"_5":31540,"_21603":57754,"_28376":57755,"_3083":57756},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3632":2175,"_31184":2171,"_5":31540,"_21603":57758,"_28376":57759,"_3083":57760},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3632":2176,"_31184":2171,"_5":31540,"_21603":57762,"_28376":57763,"_3083":57764},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3632":2177,"_31184":2171,"_5":31540,"_21603":57766,"_28376":57767,"_3083":57768},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3632":2178,"_31184":2171,"_5":31540,"_21603":57770,"_28376":57771,"_3083":57772},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3632":2179,"_31184":2171,"_5":31540,"_21603":57774,"_28376":57775,"_3083":57776},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3632":2180,"_31184":2171,"_5":31540,"_21603":57778,"_28376":57779,"_3083":57780},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3632":2181,"_31184":2171,"_5":31540,"_21603":57782,"_28376":57783,"_3083":57784},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3632":2182,"_31184":2171,"_5":31540,"_21603":57786,"_28376":57787,"_3083":57788},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3632":2183,"_31184":2171,"_21603":57790,"_5":14870,"_28376":2171,"_3083":57791},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3632":2184,"_31184":2171,"_21603":57793,"_5":14870,"_28376":57755,"_3083":57794},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3632":2185,"_31184":2171,"_21603":57796,"_5":14870,"_28376":57759,"_3083":57797},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3632":2186,"_31184":2171,"_21603":57799,"_5":14870,"_28376":57763,"_3083":57800},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3632":2187,"_31184":2171,"_21603":57802,"_5":14870,"_28376":57767,"_3083":57803},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3632":2188,"_31184":2171,"_21603":57805,"_5":14870,"_28376":57771,"_3083":57806},[],"The device proves it can enroll according to the DMS policy.",{"_3632":2189,"_31184":2171,"_21603":57808,"_5":14870,"_28376":57771,"_3083":57809},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3632":2190,"_31184":2171,"_21603":57811,"_5":14870,"_28376":57771,"_3083":57812},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3632":2191,"_31184":2171,"_21603":57814,"_5":14870,"_28376":57771,"_3083":57815},[],"The device installs the certificate and the chain it needs.",{"_3632":2192,"_31184":2171,"_21603":57817,"_5":14870,"_28376":57771,"_3083":57818},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3632":2193,"_31184":2171,"_21603":57820,"_5":14870,"_28376":57771,"_3083":57821},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3632":2194,"_31184":2171,"_21603":57823,"_5":14870,"_28376":57775,"_3083":57824},[],"A DMS relates three sets that are worth designing separately:",{"_3632":2195,"_31184":2171,"_21603":57826,"_5":14870,"_28376":57775,"_3083":57827},[],"**Enrollment CA:** signs the new identities.",{"_3632":2196,"_31184":2171,"_21603":57829,"_5":14870,"_28376":57775,"_3083":57830},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3632":2197,"_31184":2171,"_21603":57832,"_5":14870,"_28376":57775,"_3083":57833},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3632":2198,"_31184":2171,"_21603":57835,"_5":14870,"_28376":57775,"_3083":57836},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3632":2199,"_31184":2171,"_21603":57838,"_5":14870,"_28376":57779,"_3083":57839},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3632":2200,"_31184":2171,"_21603":57841,"_5":14870,"_28376":57779,"_3083":57842},[],"that the current date is between `Not Before` and `Not After`;",{"_3632":2201,"_31184":2171,"_21603":57844,"_5":14870,"_28376":57779,"_3083":57845},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3632":2202,"_31184":2171,"_21603":57847,"_5":14870,"_28376":57779,"_3083":57848},[],"that names, SANs and subject match the expected identity;",{"_3632":2203,"_31184":2171,"_21603":57850,"_5":14870,"_28376":57779,"_3083":57851},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3632":2204,"_31184":2171,"_21603":57853,"_5":14870,"_28376":57779,"_3083":57854},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3632":2205,"_31184":2171,"_21603":57856,"_5":14870,"_28376":57779,"_3083":57857},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3632":2206,"_31184":2171,"_21603":57859,"_5":14870,"_28376":57783,"_3083":57860},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3632":2207,"_31184":2171,"_21603":57862,"_5":14870,"_28376":57787,"_3083":57863},[],"Keep the root out of daily operations, or with very restricted access.",{"_3632":2208,"_31184":2171,"_21603":57865,"_5":14870,"_28376":57787,"_3083":57866},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3632":2209,"_31184":2171,"_21603":57868,"_5":14870,"_28376":57787,"_3083":57869},[],"Assign explicit profiles to every use case.",{"_3632":2210,"_31184":2171,"_21603":57871,"_5":14870,"_28376":57787,"_3083":57872},[],"Distribute the new trust before starting a rotation.",{"_3632":2211,"_31184":2171,"_21603":57874,"_5":14870,"_28376":57787,"_3083":57875},[],"Keep enough overlap to renew a disconnected fleet.",{"_3632":2212,"_31184":2171,"_21603":57877,"_5":14870,"_28376":57787,"_3083":57878},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3632":2213,"_31184":2171,"_21603":57880,"_5":14870,"_28376":57787,"_3083":57881},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3632":2214,"_31184":2214,"_5":15230,"_3083":57883,"_31543":57884,"_21603":57885,"_28376":2214},"Revocation lists (CRL)",[50996,52508,56682,57355],[],{"_3632":2215,"_31184":2214,"_21603":57887,"_5":14870,"_28376":2214,"_3083":57888},[],"Generate and distribute signed lists to validate certificates offline.",{"_3632":2216,"_31184":2214,"_5":31540,"_21603":57890,"_28376":57891,"_3083":57892},[],"/docs/pr-preview/pr-75/platform/pki/crl#crl-settings","CRL settings",{"_3632":2217,"_31184":2214,"_5":31540,"_21603":57894,"_28376":57895,"_3083":57896},[],"/docs/pr-preview/pr-75/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3632":2218,"_31184":2214,"_5":31540,"_21603":57898,"_28376":57899,"_3083":57900},[],"/docs/pr-preview/pr-75/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3632":2219,"_31184":2214,"_5":31540,"_21603":57902,"_28376":57903,"_3083":57904},[],"/docs/pr-preview/pr-75/platform/pki/crl#crl-contents","CRL contents",{"_3632":2220,"_31184":2214,"_5":31540,"_21603":57906,"_28376":57907,"_3083":57908},[],"/docs/pr-preview/pr-75/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3632":2221,"_31184":2214,"_5":31540,"_21603":57910,"_28376":57911,"_3083":57912},[],"/docs/pr-preview/pr-75/platform/pki/crl#crl-settings-api","CRL settings API",{"_3632":2222,"_31184":2214,"_5":31540,"_21603":57914,"_28376":57915,"_3083":57916},[],"/docs/pr-preview/pr-75/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3632":2223,"_31184":2214,"_5":31540,"_21603":57918,"_28376":57919,"_3083":57920},[],"/docs/pr-preview/pr-75/platform/pki/crl#references","References",{"_3632":2224,"_31184":2214,"_21603":57922,"_5":14870,"_28376":2214,"_3083":57923},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3632":2225,"_31184":2214,"_21603":57925,"_5":14870,"_28376":57891,"_3083":57926},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3632":2226,"_31184":2214,"_21603":57928,"_5":14870,"_28376":57891,"_3083":57929},[],"Field",{"_3632":2227,"_31184":2214,"_21603":57931,"_5":14870,"_28376":57891,"_3083":51386},[],{"_3632":2228,"_31184":2214,"_21603":57933,"_5":14870,"_28376":57891,"_3083":52628},[],{"_3632":2229,"_31184":2214,"_21603":57935,"_5":14870,"_28376":57891,"_3083":57936},[],"ID of the CA the settings belong to.",{"_3632":2230,"_31184":2214,"_21603":57938,"_5":14870,"_28376":57891,"_3083":57939},[],"`status`",{"_3632":2231,"_31184":2214,"_21603":57941,"_5":14870,"_28376":57891,"_3083":57942},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3632":2232,"_31184":2214,"_21603":57944,"_5":14870,"_28376":57891,"_3083":57945},[],"`legacy_ski`",{"_3632":2233,"_31184":2214,"_21603":57947,"_5":14870,"_28376":57891,"_3083":57948},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3632":2234,"_31184":2214,"_21603":57950,"_5":14870,"_28376":57891,"_3083":57951},[],"`latest_crl`",{"_3632":2235,"_31184":2214,"_21603":57953,"_5":14870,"_28376":57891,"_3083":57954},[],"Version, validity start and end of the last published list. Read-only.",{"_3632":2236,"_31184":2214,"_21603":57956,"_5":14870,"_28376":57891,"_3083":57957},[],"`crl_options` field",{"_3632":2237,"_31184":2214,"_21603":57959,"_5":14870,"_28376":57891,"_3083":51386},[],{"_3632":2238,"_31184":2214,"_21603":57961,"_5":14870,"_28376":57891,"_3083":57962},[],"Initial value",{"_3632":2239,"_31184":2214,"_21603":57964,"_5":14870,"_28376":57891,"_3083":57965},[],"`validity`",{"_3632":2240,"_31184":2214,"_21603":57967,"_5":14870,"_28376":57891,"_3083":57968},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3632":2241,"_31184":2214,"_21603":57970,"_5":14870,"_28376":57891,"_3083":57971},[],"7 days.",{"_3632":2242,"_31184":2214,"_21603":57973,"_5":14870,"_28376":57891,"_3083":57974},[],"`refresh_interval`",{"_3632":2243,"_31184":2214,"_21603":57976,"_5":14870,"_28376":57891,"_3083":57977},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3632":2244,"_31184":2214,"_21603":57979,"_5":14870,"_28376":57891,"_3083":57980},[],"6 days and 23 hours.",{"_3632":2245,"_31184":2214,"_21603":57982,"_5":14870,"_28376":57891,"_3083":57983},[],"`regenerate_on_revoke`",{"_3632":2246,"_31184":2214,"_21603":57985,"_5":14870,"_28376":57891,"_3083":57986},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3632":2247,"_31184":2214,"_21603":57988,"_5":14870,"_28376":57891,"_3083":57989},[],"`true`.",{"_3632":2248,"_31184":2214,"_21603":57991,"_5":14870,"_28376":57891,"_3083":57992},[],"`signer_serial_number`",{"_3632":2249,"_31184":2214,"_21603":57994,"_5":14870,"_28376":57891,"_3083":57995},[],"Serial number of the existing certificate that signs the CRL.",{"_3632":2250,"_31184":2214,"_21603":57997,"_5":14870,"_28376":57891,"_3083":57998},[],"Serial number of the CA’s current certificate.",{"_3632":2251,"_31184":2214,"_21603":58000,"_5":14870,"_28376":57891,"_3083":58001},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3632":2252,"_31184":2214,"_21603":58003,"_5":14870,"_28376":57891,"_3083":58004},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3632":2253,"_31184":2214,"_21603":58006,"_5":14870,"_28376":57891,"_3083":58007},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3632":2254,"_31184":2214,"_21603":58009,"_5":14870,"_28376":57891,"_3083":58010},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3632":2255,"_31184":2214,"_21603":58012,"_5":14870,"_28376":57891,"_3083":58013},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3632":2256,"_31184":2214,"_21603":58015,"_5":14870,"_28376":57891,"_3083":58016},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3632":2257,"_31184":2214,"_21603":58018,"_5":14870,"_28376":57891,"_3083":58019},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3632":2258,"_31184":2214,"_21603":58021,"_5":14870,"_28376":57891,"_3083":58022},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3632":2259,"_31184":2214,"_21603":58024,"_5":14870,"_28376":57891,"_3083":58025},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3632":2260,"_31184":2214,"_21603":58027,"_5":14870,"_28376":57891,"_3083":58028},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3632":2261,"_31184":2214,"_21603":58030,"_5":14870,"_28376":57891,"_3083":58031},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3632":2262,"_31184":2214,"_21603":58033,"_5":14870,"_28376":57895,"_3083":58034},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3632":2263,"_31184":2214,"_21603":58036,"_5":14870,"_28376":57895,"_3083":58037},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3632":2264,"_31184":2214,"_21603":58039,"_5":14870,"_28376":57895,"_3083":58040},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3632":2265,"_31184":2214,"_21603":58042,"_5":14870,"_28376":57895,"_3083":58043},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3632":2266,"_31184":2214,"_21603":58045,"_5":14870,"_28376":57899,"_3083":58046},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3632":2267,"_31184":2214,"_21603":58048,"_5":14870,"_28376":57899,"_3083":58049},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3632":2268,"_31184":2214,"_21603":58051,"_5":14870,"_28376":57899,"_3083":58052},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3632":2269,"_31184":2214,"_21603":58054,"_5":14870,"_28376":57899,"_3083":58055},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3632":2270,"_31184":2214,"_21603":58057,"_5":14870,"_28376":57899,"_3083":58058},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3632":2271,"_31184":2214,"_21603":58060,"_5":14870,"_28376":57899,"_3083":58061},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3632":2272,"_31184":2214,"_21603":58063,"_5":14870,"_28376":57899,"_3083":58064},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3632":2273,"_31184":2214,"_21603":58066,"_5":14870,"_28376":57899,"_3083":58067},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3632":2274,"_31184":2214,"_21603":58069,"_5":14870,"_28376":57899,"_3083":58070},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3632":2275,"_31184":2214,"_21603":58072,"_5":14870,"_28376":57903,"_3083":58073},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3632":2276,"_31184":2214,"_21603":58075,"_5":14870,"_28376":57903,"_3083":58076},[],"When the VA has configured domains, the list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with those distribution URLs; a VA with no configured domains publishes the list without an IDP, and a CRL without an IDP covers every certificate of its CA. When the extension is present, check that your client interprets it and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3632":2277,"_31184":2214,"_21603":58078,"_5":14870,"_28376":57907,"_3083":58079},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3632":2278,"_31184":2214,"_21603":58081,"_5":14870,"_28376":57907,"_3083":58082},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3632":2279,"_31184":2214,"_21603":58084,"_5":14870,"_28376":57907,"_3083":58085},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3632":2280,"_31184":2214,"_21603":58087,"_5":14870,"_28376":57907,"_3083":58088},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3632":2281,"_31184":2214,"_21603":58090,"_5":14870,"_28376":57907,"_3083":58091},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3632":2282,"_31184":2214,"_21603":58093,"_5":14870,"_28376":57911,"_3083":58094},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3632":2283,"_31184":2214,"_21603":58096,"_5":14870,"_28376":57911,"_3083":54448},[],{"_3632":2284,"_31184":2214,"_21603":58098,"_5":14870,"_28376":57911,"_3083":58099},[],"Relative path",{"_3632":2285,"_31184":2214,"_21603":58101,"_5":14870,"_28376":57911,"_3083":54445},[],{"_3632":2286,"_31184":2214,"_21603":58103,"_5":14870,"_28376":57911,"_3083":58104},[],"`GET`",{"_3632":2287,"_31184":2214,"_21603":58106,"_5":14870,"_28376":57911,"_3083":58107},[],"`/v1/crl-settings`",{"_3632":2288,"_31184":2214,"_21603":58109,"_5":14870,"_28376":57911,"_3083":58110},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3632":2289,"_31184":2214,"_21603":58112,"_5":14870,"_28376":57911,"_3083":58104},[],{"_3632":2290,"_31184":2214,"_21603":58114,"_5":14870,"_28376":57911,"_3083":58115},[],"`/v1/crl-settings/{ca-id}`",{"_3632":2291,"_31184":2214,"_21603":58117,"_5":14870,"_28376":57911,"_3083":58118},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3632":2292,"_31184":2214,"_21603":58120,"_5":14870,"_28376":57911,"_3083":58121},[],"`PUT`",{"_3632":2293,"_31184":2214,"_21603":58123,"_5":14870,"_28376":57911,"_3083":58115},[],{"_3632":2294,"_31184":2214,"_21603":58125,"_5":14870,"_28376":57911,"_3083":58126},[],"Replace the CRL configuration of a CA.",{"_3632":2295,"_31184":2214,"_21603":58128,"_5":14870,"_28376":57911,"_3083":58129},[],"`DELETE`",{"_3632":2296,"_31184":2214,"_21603":58131,"_5":14870,"_28376":57911,"_3083":58115},[],{"_3632":2297,"_31184":2214,"_21603":58133,"_5":14870,"_28376":57911,"_3083":58134},[],"Remove the archived CRL settings of a CA.",{"_3632":2298,"_31184":2214,"_21603":58136,"_5":14870,"_28376":57911,"_3083":58137},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3632":2299,"_31184":2214,"_21603":58139,"_5":14870,"_28376":57911,"_3083":58140},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3632":2300,"_31184":2214,"_21603":58142,"_5":14870,"_28376":57911,"_3083":58143},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3632":2301,"_31184":2214,"_21603":58145,"_5":14870,"_28376":57915,"_3083":58146},[],"Symptom",{"_3632":2302,"_31184":2214,"_21603":58148,"_5":14870,"_28376":57915,"_3083":58149},[],"Cause",{"_3632":2303,"_31184":2214,"_21603":58151,"_5":14870,"_28376":57915,"_3083":58152},[],"Action",{"_3632":2304,"_31184":2214,"_21603":58154,"_5":14870,"_28376":57915,"_3083":58155},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3632":2305,"_31184":2214,"_21603":58157,"_5":14870,"_28376":57915,"_3083":58158},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3632":2306,"_31184":2214,"_21603":58160,"_5":14870,"_28376":57915,"_3083":58161},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3632":2307,"_31184":2214,"_21603":58163,"_5":14870,"_28376":57915,"_3083":58164},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3632":2308,"_31184":2214,"_21603":58166,"_5":14870,"_28376":57915,"_3083":58167},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3632":2309,"_31184":2214,"_21603":58169,"_5":14870,"_28376":57915,"_3083":58170},[],"Delete the CA first; deleting it archives its settings.",{"_3632":2310,"_31184":2214,"_21603":58172,"_5":14870,"_28376":57915,"_3083":58173},[],"`PUT` returns 400.",{"_3632":2311,"_31184":2214,"_21603":58175,"_5":14870,"_28376":57915,"_3083":58176},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3632":2312,"_31184":2214,"_21603":58178,"_5":14870,"_28376":57915,"_3083":58179},[],"Set the serial number of a valid certificate of that CA.",{"_3632":2313,"_31184":2214,"_21603":58181,"_5":14870,"_28376":57915,"_3083":58182},[],"`PUT` returns 404.",{"_3632":2314,"_31184":2214,"_21603":58184,"_5":14870,"_28376":57915,"_3083":58185},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3632":2315,"_31184":2214,"_21603":58187,"_5":14870,"_28376":57915,"_3083":58188},[],"Check the CA ID and the signer serial number.",{"_3632":2316,"_31184":2214,"_21603":58190,"_5":14870,"_28376":57915,"_3083":58191},[],"`PUT` returns 400 from a 3.x client.",{"_3632":2317,"_31184":2214,"_21603":58193,"_5":14870,"_28376":57915,"_3083":58194},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3632":2318,"_31184":2214,"_21603":58196,"_5":14870,"_28376":57915,"_3083":58197},[],"Update the client to send the new field.",{"_3632":2319,"_31184":2214,"_21603":58199,"_5":14870,"_28376":57915,"_3083":58200},[],"The CRL does not change after revoking a certificate.",{"_3632":2320,"_31184":2214,"_21603":58202,"_5":14870,"_28376":57915,"_3083":58203},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3632":2321,"_31184":2214,"_21603":58205,"_5":14870,"_28376":57915,"_3083":58206},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3632":2322,"_31184":2214,"_21603":58208,"_5":14870,"_28376":57915,"_3083":58209},[],"A verifier rejects the CRL because of the issuer.",{"_3632":2323,"_31184":2214,"_21603":58211,"_5":14870,"_28376":57915,"_3083":58212},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3632":2324,"_31184":2214,"_21603":58214,"_5":14870,"_28376":57915,"_3083":58215},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3632":2325,"_31184":2214,"_21603":58217,"_5":14870,"_28376":57919,"_3083":58218},[],"RFC 5280: X.509 and CRL profile.",{"_3632":2326,"_31184":2214,"_21603":58220,"_5":14870,"_28376":57919,"_3083":58221},[],"OpenSSL: openssl-crl.",{"_3632":2327,"_31184":2214,"_21603":58223,"_5":14870,"_28376":57919,"_3083":58224},[],"OpenSSL: openssl-verify.",{"_3632":2328,"_31184":2214,"_21603":58226,"_5":14870,"_28376":57919,"_3083":58227},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3632":2329,"_31184":2214,"_21603":58229,"_5":14870,"_28376":57919,"_3083":58230},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3632":2330,"_31184":2330,"_5":15230,"_3083":58232,"_31543":58233,"_21603":58234,"_28376":2330},"Keys and cryptographic engines",[50996,52508,56682,56683],[],{"_3632":2331,"_31184":2330,"_21603":58236,"_5":14870,"_28376":2330,"_3083":58237},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3632":2332,"_31184":2330,"_5":31540,"_21603":58239,"_28376":58240,"_3083":58241},[],"/docs/pr-preview/pr-75/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3632":2333,"_31184":2330,"_5":31540,"_21603":58243,"_28376":58244,"_3083":58245},[],"/docs/pr-preview/pr-75/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3632":2334,"_31184":2330,"_5":31540,"_21603":58247,"_28376":58248,"_3083":58249},[],"/docs/pr-preview/pr-75/platform/pki/key-management#file-system","File System",{"_3632":2335,"_31184":2330,"_5":31540,"_21603":58251,"_28376":58252,"_3083":58253},[],"/docs/pr-preview/pr-75/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3632":2336,"_31184":2330,"_5":31540,"_21603":58255,"_28376":58256,"_3083":58257},[],"/docs/pr-preview/pr-75/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3632":2337,"_31184":2330,"_5":31540,"_21603":58259,"_28376":58260,"_3083":58261},[],"/docs/pr-preview/pr-75/platform/pki/key-management#aws-kms","AWS KMS",{"_3632":2338,"_31184":2330,"_5":31540,"_21603":58263,"_28376":58264,"_3083":58265},[],"/docs/pr-preview/pr-75/platform/pki/key-management#pkcs11","PKCS#11",{"_3632":2339,"_31184":2330,"_5":31540,"_21603":58267,"_28376":58268,"_3083":58269},[],"/docs/pr-preview/pr-75/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3632":2340,"_31184":2330,"_5":31540,"_21603":58271,"_28376":58272,"_3083":58273},[],"/docs/pr-preview/pr-75/platform/pki/key-management#key-inventory","Key inventory",{"_3632":2341,"_31184":2330,"_5":31540,"_21603":58275,"_28376":58276,"_3083":58277},[],"/docs/pr-preview/pr-75/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3632":2342,"_31184":2330,"_5":31540,"_21603":58279,"_28376":58280,"_3083":58281},[],"/docs/pr-preview/pr-75/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3632":2343,"_31184":2330,"_5":31540,"_21603":58283,"_28376":58284,"_3083":58285},[],"/docs/pr-preview/pr-75/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3632":2344,"_31184":2330,"_5":31540,"_21603":58287,"_28376":58288,"_3083":58289},[],"/docs/pr-preview/pr-75/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3632":2345,"_31184":2330,"_5":31540,"_21603":58291,"_28376":58292,"_3083":58293},[],"/docs/pr-preview/pr-75/platform/pki/key-management#view-details","View details",{"_3632":2346,"_31184":2330,"_5":31540,"_21603":58295,"_28376":58296,"_3083":58297},[],"/docs/pr-preview/pr-75/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3632":2347,"_31184":2330,"_5":31540,"_21603":58299,"_28376":58300,"_3083":58301},[],"/docs/pr-preview/pr-75/platform/pki/key-management#sign","Sign",{"_3632":2348,"_31184":2330,"_5":31540,"_21603":58303,"_28376":58304,"_3083":58305},[],"/docs/pr-preview/pr-75/platform/pki/key-management#verify","Verify",{"_3632":2349,"_31184":2330,"_5":31540,"_21603":58307,"_28376":58308,"_3083":58309},[],"/docs/pr-preview/pr-75/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3632":2350,"_31184":2330,"_5":31540,"_21603":58311,"_28376":58312,"_3083":58313},[],"/docs/pr-preview/pr-75/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3632":2351,"_31184":2330,"_5":31540,"_21603":58315,"_28376":58316,"_3083":58317},[],"/docs/pr-preview/pr-75/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3632":2352,"_31184":2330,"_21603":58319,"_5":14870,"_28376":2330,"_3083":58320},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3632":2353,"_31184":2330,"_21603":58322,"_5":14870,"_28376":2330,"_3083":58323},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3632":2354,"_31184":2330,"_21603":58325,"_5":14870,"_28376":58240,"_3083":58326},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3632":2355,"_31184":2330,"_21603":58328,"_5":14870,"_28376":58240,"_3083":58329},[],"In practice, it lets you:",{"_3632":2356,"_31184":2330,"_21603":58331,"_5":14870,"_28376":58240,"_3083":58332},[],"Generate new key pairs from Lamassu IoT.",{"_3632":2357,"_31184":2330,"_21603":58334,"_5":14870,"_28376":58240,"_3083":58335},[],"Import keys created externally.",{"_3632":2358,"_31184":2330,"_21603":58337,"_5":14870,"_28376":58240,"_3083":58338},[],"Delegate custody and cryptographic operations to external engines.",{"_3632":2359,"_31184":2330,"_21603":58340,"_5":14870,"_28376":58240,"_3083":58341},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3632":2360,"_31184":2330,"_21603":58343,"_5":14870,"_28376":58244,"_3083":58344},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3632":2361,"_31184":2330,"_21603":58346,"_5":14870,"_28376":58244,"_3083":58347},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3632":2362,"_31184":2330,"_21603":58349,"_5":14870,"_28376":58244,"_3083":58350},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3632":2363,"_31184":2330,"_21603":58352,"_5":14870,"_28376":58248,"_3083":58353},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3632":2364,"_31184":2330,"_21603":58355,"_5":14870,"_28376":58252,"_3083":58356},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3632":2365,"_31184":2330,"_21603":58358,"_5":14870,"_28376":58252,"_3083":58359},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3632":2366,"_31184":2330,"_21603":58361,"_5":14870,"_28376":58256,"_3083":58362},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3632":2367,"_31184":2330,"_21603":58364,"_5":14870,"_28376":58260,"_3083":58365},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3632":2368,"_31184":2330,"_21603":58367,"_5":14870,"_28376":58264,"_3083":58368},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3632":2369,"_31184":2330,"_21603":58370,"_5":14870,"_28376":58268,"_3083":58371},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3632":2370,"_31184":2330,"_21603":58373,"_5":14870,"_28376":58268,"_3083":58374},[],"Lamassu shows the enabled engines in the console.",{"_3632":2371,"_31184":2330,"_21603":58376,"_5":14870,"_28376":58268,"_3083":58377},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3632":2372,"_31184":2330,"_21603":58379,"_5":14870,"_28376":58268,"_3083":58380},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3632":2373,"_31184":2330,"_21603":58382,"_5":14870,"_28376":58272,"_3083":58383},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3632":2374,"_31184":2330,"_21603":58385,"_5":14870,"_28376":58272,"_3083":58386},[],"The table includes the following fields:",{"_3632":2375,"_31184":2330,"_21603":58388,"_5":14870,"_28376":58272,"_3083":58389},[],"**Name**: descriptive name of the key.",{"_3632":2376,"_31184":2330,"_21603":58391,"_5":14870,"_28376":58272,"_3083":58392},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3632":2377,"_31184":2330,"_21603":58394,"_5":14870,"_28376":58272,"_3083":58395},[],"**Strength**: visual indicator of cryptographic strength.",{"_3632":2378,"_31184":2330,"_21603":58397,"_5":14870,"_28376":58272,"_3083":58398},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3632":2379,"_31184":2330,"_21603":58400,"_5":14870,"_28376":58272,"_3083":58401},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3632":2380,"_31184":2330,"_21603":58403,"_5":14870,"_28376":58272,"_3083":58404},[],"**Aliases**: alternative names associated with the key.",{"_3632":2381,"_31184":2330,"_21603":58406,"_5":14870,"_28376":58272,"_3083":58407},[],"**Tags**: labels for classification and search.",{"_3632":2382,"_31184":2330,"_21603":58409,"_5":14870,"_28376":58272,"_3083":58410},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3632":2383,"_31184":2330,"_21603":58412,"_5":14870,"_28376":58272,"_3083":58413},[],"From this view you also reach the most common actions:",{"_3632":2384,"_31184":2330,"_21603":58415,"_5":14870,"_28376":58272,"_3083":58416},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3632":2385,"_31184":2330,"_21603":58418,"_5":14870,"_28376":58272,"_3083":58419},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3632":2386,"_31184":2330,"_21603":58421,"_5":14870,"_28376":58272,"_3083":58422},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3632":2387,"_31184":2330,"_21603":58424,"_5":14870,"_28376":58272,"_3083":58425},[],"**Delete Key** to remove the key from the system.",{"_3632":2388,"_31184":2330,"_21603":58427,"_5":14870,"_28376":58276,"_3083":58428},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3632":2389,"_31184":2330,"_21603":58430,"_5":14870,"_28376":58280,"_3083":58431},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3632":2390,"_31184":2330,"_21603":58433,"_5":14870,"_28376":58280,"_3083":58434},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3632":2391,"_31184":2330,"_21603":58436,"_5":14870,"_28376":58280,"_3083":58437},[],"**Key Name**: unique and descriptive name.",{"_3632":2392,"_31184":2330,"_21603":58439,"_5":14870,"_28376":58280,"_3083":58440},[],"**Crypto Engine**: engine that will keep the key.",{"_3632":2393,"_31184":2330,"_21603":58442,"_5":14870,"_28376":58280,"_3083":58443},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3632":2394,"_31184":2330,"_21603":58445,"_5":14870,"_28376":58280,"_3083":58446},[],"**Tags**: metadata to classify the key.",{"_3632":2395,"_31184":2330,"_21603":58448,"_5":14870,"_28376":58280,"_3083":58449},[],"**Metadata**: additional information for advanced uses.",{"_3632":2396,"_31184":2330,"_21603":58451,"_5":14870,"_28376":58284,"_3083":58452},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3632":2397,"_31184":2330,"_21603":58454,"_5":14870,"_28376":58284,"_3083":58455},[],"When you have an exportable private key and the destination engine supports import.",{"_3632":2398,"_31184":2330,"_21603":58457,"_5":14870,"_28376":58284,"_3083":58458},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3632":2399,"_31184":2330,"_21603":58460,"_5":14870,"_28376":58284,"_3083":58461},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3632":2400,"_31184":2330,"_21603":58463,"_5":14870,"_28376":58284,"_3083":58464},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3632":2401,"_31184":2330,"_21603":58466,"_5":14870,"_28376":58284,"_3083":58467},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3632":2402,"_31184":2330,"_21603":58469,"_5":14870,"_28376":58284,"_3083":58470},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3632":2403,"_31184":2330,"_21603":58472,"_5":14870,"_28376":58284,"_3083":58473},[],"**Tags**: labels for organization and search.",{"_3632":2404,"_31184":2330,"_21603":58475,"_5":14870,"_28376":58284,"_3083":58476},[],"**Metadata**: additional optional information.",{"_3632":2405,"_31184":2330,"_21603":58478,"_5":14870,"_28376":58284,"_3083":58479},[],"**Private Key (PEM)**: private key in PEM format.",{"_3632":2406,"_31184":2330,"_21603":58481,"_5":14870,"_28376":58284,"_3083":58482},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3632":2407,"_31184":2330,"_21603":58484,"_5":14870,"_28376":58288,"_3083":58485},[],"Each registered key has a detail view and several operational actions.",{"_3632":2408,"_31184":2330,"_21603":58487,"_5":14870,"_28376":58292,"_3083":58488},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3632":2409,"_31184":2330,"_21603":58490,"_5":14870,"_28376":58292,"_3083":58491},[],"The **Overview** tab shows, among others, these fields:",{"_3632":2410,"_31184":2330,"_21603":58493,"_5":14870,"_28376":58292,"_3083":58494},[],"**Key Name**: descriptive name.",{"_3632":2411,"_31184":2330,"_21603":58496,"_5":14870,"_28376":58292,"_3083":58497},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3632":2412,"_31184":2330,"_21603":58499,"_5":14870,"_28376":58292,"_3083":58500},[],"**Tags**: associated labels.",{"_3632":2413,"_31184":2330,"_21603":58502,"_5":14870,"_28376":58292,"_3083":58503},[],"**Aliases**: alternative names.",{"_3632":2414,"_31184":2330,"_21603":58505,"_5":14870,"_28376":58292,"_3083":58506},[],"**Crypto Engine**: engine where the key resides.",{"_3632":2415,"_31184":2330,"_21603":58508,"_5":14870,"_28376":58292,"_3083":58509},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3632":2416,"_31184":2330,"_21603":58511,"_5":14870,"_28376":58292,"_3083":58512},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3632":2417,"_31184":2330,"_21603":58514,"_5":14870,"_28376":58292,"_3083":58515},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3632":2418,"_31184":2330,"_21603":58517,"_5":14870,"_28376":58296,"_3083":58518},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3632":2419,"_31184":2330,"_21603":58520,"_5":14870,"_28376":58296,"_3083":58521},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3632":2420,"_31184":2330,"_21603":58523,"_5":14870,"_28376":58296,"_3083":58524},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3632":2421,"_31184":2330,"_21603":58526,"_5":14870,"_28376":58300,"_3083":58527},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3632":2422,"_31184":2330,"_21603":58529,"_5":14870,"_28376":58300,"_3083":58530},[],"Main fields:",{"_3632":2423,"_31184":2330,"_21603":58532,"_5":14870,"_28376":58300,"_3083":58533},[],"**Algorithm**: signing algorithm available for the key type.",{"_3632":2424,"_31184":2330,"_21603":58535,"_5":14870,"_28376":58300,"_3083":58536},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3632":2425,"_31184":2330,"_21603":58538,"_5":14870,"_28376":58300,"_3083":58539},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3632":2426,"_31184":2330,"_21603":58541,"_5":14870,"_28376":58300,"_3083":58542},[],"**Message**: content to sign.",{"_3632":2427,"_31184":2330,"_21603":58544,"_5":14870,"_28376":58300,"_3083":58545},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3632":2428,"_31184":2330,"_21603":58547,"_5":14870,"_28376":58304,"_3083":58548},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3632":2429,"_31184":2330,"_21603":58550,"_5":14870,"_28376":58304,"_3083":58530},[],{"_3632":2430,"_31184":2330,"_21603":58552,"_5":14870,"_28376":58304,"_3083":58553},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3632":2431,"_31184":2330,"_21603":58555,"_5":14870,"_28376":58304,"_3083":58556},[],"**Message Type**: `Raw` or `Digest`.",{"_3632":2432,"_31184":2330,"_21603":58558,"_5":14870,"_28376":58304,"_3083":58559},[],"**Payload Encoding**: encoding of the message.",{"_3632":2433,"_31184":2330,"_21603":58561,"_5":14870,"_28376":58304,"_3083":58562},[],"**Message**: original message or hash.",{"_3632":2434,"_31184":2330,"_21603":58564,"_5":14870,"_28376":58304,"_3083":58565},[],"**Signature**: signature to check.",{"_3632":2435,"_31184":2330,"_21603":58567,"_5":14870,"_28376":58304,"_3083":58568},[],"**Result**: indicator of the validation result.",{"_3632":2436,"_31184":2330,"_21603":58570,"_5":14870,"_28376":58308,"_3083":58571},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3632":2437,"_31184":2330,"_21603":58573,"_5":14870,"_28376":58308,"_3083":58574},[],"This flow is useful for:",{"_3632":2438,"_31184":2330,"_21603":58576,"_5":14870,"_28376":58308,"_3083":58577},[],"Requesting certificates from an external CA.",{"_3632":2439,"_31184":2330,"_21603":58579,"_5":14870,"_28376":58308,"_3083":58580},[],"Renewing an identity while keeping the same key.",{"_3632":2440,"_31184":2330,"_21603":58582,"_5":14870,"_28376":58308,"_3083":58583},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3632":2441,"_31184":2330,"_21603":58585,"_5":14870,"_28376":58308,"_3083":58586},[],"**Common Name (CN)**: main name of the identity.",{"_3632":2442,"_31184":2330,"_21603":58588,"_5":14870,"_28376":58308,"_3083":58589},[],"**Organization (O)**: organization or company.",{"_3632":2443,"_31184":2330,"_21603":58591,"_5":14870,"_28376":58308,"_3083":58592},[],"**Organizational Unit (OU)**: department or unit.",{"_3632":2444,"_31184":2330,"_21603":58594,"_5":14870,"_28376":58308,"_3083":58595},[],"**Country (C)**: two-letter country code.",{"_3632":2445,"_31184":2330,"_21603":58597,"_5":14870,"_28376":58308,"_3083":58598},[],"**State / Province (ST)**: state or province.",{"_3632":2446,"_31184":2330,"_21603":58600,"_5":14870,"_28376":58308,"_3083":58601},[],"**Locality (L)**: city or locality.",{"_3632":2447,"_31184":2330,"_21603":58603,"_5":14870,"_28376":58308,"_3083":58604},[],"**Email Address**: contact email.",{"_3632":2448,"_31184":2330,"_21603":58606,"_5":14870,"_28376":58308,"_3083":58607},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3632":2449,"_31184":2330,"_21603":58609,"_5":14870,"_28376":58308,"_3083":58610},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3632":2450,"_31184":2330,"_21603":58612,"_5":14870,"_28376":58312,"_3083":58613},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3632":2451,"_31184":2330,"_21603":58615,"_5":14870,"_28376":58312,"_3083":58616},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3632":2452,"_31184":2330,"_21603":58618,"_5":14870,"_28376":58316,"_3083":58619},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3632":2453,"_31184":2330,"_21603":58621,"_5":14870,"_28376":58316,"_3083":58622},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3632":2454,"_31184":2454,"_5":15230,"_3083":58624,"_31543":58625,"_21603":58626,"_28376":2454},"Online validation with OCSP",[50996,52508,56682,57355],[],{"_3632":2455,"_31184":2454,"_21603":58628,"_5":14870,"_28376":2454,"_3083":58629},[],"Query signed status and verify the responder’s response.",{"_3632":2456,"_31184":2454,"_5":31540,"_21603":58631,"_28376":58632,"_3083":58633},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3632":2457,"_31184":2454,"_5":31540,"_21603":58635,"_28376":58636,"_3083":58637},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3632":2458,"_31184":2454,"_5":31540,"_21603":58639,"_28376":58640,"_3083":58641},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3632":2459,"_31184":2454,"_5":31540,"_21603":58643,"_28376":58644,"_3083":58645},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3632":2460,"_31184":2454,"_5":31540,"_21603":58647,"_28376":58648,"_3083":58649},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3632":2461,"_31184":2454,"_5":31540,"_21603":58651,"_28376":58652,"_3083":57920},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#references",{"_3632":2462,"_31184":2454,"_21603":58654,"_5":14870,"_28376":2454,"_3083":58655},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3632":2463,"_31184":2454,"_21603":58657,"_5":14870,"_28376":58632,"_3083":58658},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3632":2464,"_31184":2454,"_21603":58660,"_5":14870,"_28376":58632,"_3083":58661},[],"Record status",{"_3632":2465,"_31184":2454,"_21603":58663,"_5":14870,"_28376":58632,"_3083":58664},[],"Signed response",{"_3632":2466,"_31184":2454,"_21603":58666,"_5":14870,"_28376":58632,"_3083":55819},[],{"_3632":2467,"_31184":2454,"_21603":58668,"_5":14870,"_28376":58632,"_3083":58669},[],"`Good`.",{"_3632":2468,"_31184":2454,"_21603":58671,"_5":14870,"_28376":58632,"_3083":55836},[],{"_3632":2469,"_31184":2454,"_21603":58673,"_5":14870,"_28376":58632,"_3083":58674},[],"`Revoked`, with revocation reason and timestamp.",{"_3632":2470,"_31184":2454,"_21603":58676,"_5":14870,"_28376":58632,"_3083":58677},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3632":2471,"_31184":2454,"_21603":58679,"_5":14870,"_28376":58632,"_3083":58680},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3632":2472,"_31184":2454,"_21603":58682,"_5":14870,"_28376":58632,"_3083":58683},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3632":2473,"_31184":2454,"_21603":58685,"_5":14870,"_28376":58632,"_3083":58686},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3632":2474,"_31184":2454,"_21603":58688,"_5":14870,"_28376":58632,"_3083":58689},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3632":2475,"_31184":2454,"_21603":58691,"_5":14870,"_28376":58636,"_3083":58692},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3632":2476,"_31184":2454,"_21603":58694,"_5":14870,"_28376":58636,"_3083":58695},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3632":2477,"_31184":2454,"_21603":58697,"_5":14870,"_28376":58640,"_3083":58698},[],"The service accepts:",{"_3632":2478,"_31184":2454,"_21603":58700,"_5":14870,"_28376":58640,"_3083":54448},[],{"_3632":2479,"_31184":2454,"_21603":58702,"_5":14870,"_28376":58640,"_3083":58703},[],"VA service path",{"_3632":2480,"_31184":2454,"_21603":58705,"_5":14870,"_28376":58640,"_3083":58706},[],"Format",{"_3632":2481,"_31184":2454,"_21603":58708,"_5":14870,"_28376":58640,"_3083":58709},[],"`POST`",{"_3632":2482,"_31184":2454,"_21603":58711,"_5":14870,"_28376":58640,"_3083":58712},[],"`/ocsp`",{"_3632":2483,"_31184":2454,"_21603":58714,"_5":14870,"_28376":58640,"_3083":58715},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3632":2484,"_31184":2454,"_21603":58717,"_5":14870,"_28376":58640,"_3083":58104},[],{"_3632":2485,"_31184":2454,"_21603":58719,"_5":14870,"_28376":58640,"_3083":58720},[],"`/ocsp/{ocsp_request}`",{"_3632":2486,"_31184":2454,"_21603":58722,"_5":14870,"_28376":58640,"_3083":58723},[],"DER request encoded using padded URL Base64.",{"_3632":2487,"_31184":2454,"_21603":58725,"_5":14870,"_28376":58640,"_3083":58726},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3632":2488,"_31184":2454,"_21603":58728,"_5":14870,"_28376":58644,"_3083":58729},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3632":2489,"_31184":2454,"_21603":58731,"_5":14870,"_28376":58644,"_3083":58732},[],"Generate the request:",{"_3632":2490,"_31184":2454,"_21603":58734,"_5":14870,"_28376":58644,"_3083":58735},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3632":2491,"_31184":2454,"_21603":58737,"_5":14870,"_28376":58644,"_3083":58738},[],"Replace the example URL with the inspected endpoint:",{"_3632":2492,"_31184":2454,"_21603":58740,"_5":14870,"_28376":58644,"_3083":58741},[],"Verify the returned DER:",{"_3632":2493,"_31184":2454,"_21603":58743,"_5":14870,"_28376":58644,"_3083":58744},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3632":2494,"_31184":2454,"_21603":58746,"_5":14870,"_28376":58648,"_3083":58747},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3632":2495,"_31184":2454,"_21603":58749,"_5":14870,"_28376":58648,"_3083":58750},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3632":2496,"_31184":2454,"_21603":58752,"_5":14870,"_28376":58652,"_3083":58753},[],"RFC 6960: OCSP.",{"_3632":2497,"_31184":2454,"_21603":58755,"_5":14870,"_28376":58652,"_3083":58756},[],"OpenSSL: openssl-ocsp.",{"_3632":2498,"_31184":2454,"_21603":58758,"_5":14870,"_28376":58652,"_3083":58759},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3632":2499,"_31184":2454,"_21603":58761,"_5":14870,"_28376":58652,"_3083":58230},[],{"_3632":2500,"_31184":2500,"_5":15230,"_3083":56682,"_31543":58763,"_21603":58764,"_28376":2500},[50996,52508,56682],[],{"_3632":2501,"_31184":2500,"_21603":58766,"_5":14870,"_28376":2500,"_3083":58767},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3632":2502,"_31184":2500,"_5":31540,"_21603":58769,"_28376":58770,"_3083":55994},[],"/docs/pr-preview/pr-75/platform/pki/overview#start-here",{"_3632":2503,"_31184":2500,"_5":31540,"_21603":58772,"_28376":58773,"_3083":58774},[],"/docs/pr-preview/pr-75/platform/pki/overview#what-you-need","What you need",{"_3632":2504,"_31184":2500,"_5":31540,"_21603":58776,"_28376":58777,"_3083":56526},[],"/docs/pr-preview/pr-75/platform/pki/overview#core-capabilities",{"_3632":2505,"_31184":2500,"_5":31540,"_21603":58779,"_28376":58780,"_3083":56530},[],"/docs/pr-preview/pr-75/platform/pki/overview#build-your-trust-hierarchy",{"_3632":2506,"_31184":2500,"_5":31540,"_21603":58782,"_28376":58783,"_3083":56534},[],"/docs/pr-preview/pr-75/platform/pki/overview#protect-cryptographic-keys",{"_3632":2507,"_31184":2500,"_5":31540,"_21603":58785,"_28376":58786,"_3083":56538},[],"/docs/pr-preview/pr-75/platform/pki/overview#issue-and-control-certificates",{"_3632":2508,"_31184":2500,"_5":31540,"_21603":58788,"_28376":58789,"_3083":56546},[],"/docs/pr-preview/pr-75/platform/pki/overview#publish-validation-status",{"_3632":2509,"_31184":2500,"_5":31540,"_21603":58791,"_28376":58792,"_3083":58793},[],"/docs/pr-preview/pr-75/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3632":2510,"_31184":2500,"_5":31540,"_21603":58795,"_28376":58796,"_3083":57522},[],"/docs/pr-preview/pr-75/platform/pki/overview#continue",{"_3632":2511,"_31184":2500,"_21603":58798,"_5":14870,"_28376":2500,"_3083":58799},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3632":2512,"_31184":2500,"_21603":58801,"_5":14870,"_28376":58770,"_3083":58802},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3632":2513,"_31184":2500,"_21603":58804,"_5":14870,"_28376":58770,"_3083":58805},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3632":2514,"_31184":2500,"_21603":58807,"_5":14870,"_28376":58773,"_3083":58808},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3632":2515,"_31184":2500,"_21603":58810,"_5":14870,"_28376":58773,"_3083":58811},[],"An available cryptographic engine to keep the authority's key.",{"_3632":2516,"_31184":2500,"_21603":58813,"_5":14870,"_28376":58773,"_3083":58814},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3632":2517,"_31184":2500,"_21603":58816,"_5":14870,"_28376":58773,"_3083":58817},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3632":2518,"_31184":2500,"_21603":58819,"_5":14870,"_28376":58773,"_3083":58820},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3632":2519,"_31184":2500,"_21603":58822,"_5":14870,"_28376":58780,"_3083":58823},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3632":2520,"_31184":2500,"_21603":58825,"_5":14870,"_28376":58783,"_3083":58826},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3632":2521,"_31184":2500,"_21603":58828,"_5":14870,"_28376":58786,"_3083":58829},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3632":2522,"_31184":2500,"_21603":58831,"_5":14870,"_28376":58789,"_3083":58832},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3632":2523,"_31184":2500,"_21603":58834,"_5":14870,"_28376":58792,"_3083":58835},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3632":2524,"_31184":2500,"_21603":58837,"_5":14870,"_28376":58792,"_3083":58838},[],"its subject and extensions identify the expected client;",{"_3632":2525,"_31184":2500,"_21603":58840,"_5":14870,"_28376":58792,"_3083":58841},[],"its public key matches the client's private key;",{"_3632":2526,"_31184":2500,"_21603":58843,"_5":14870,"_28376":58792,"_3083":58844},[],"its chain reaches a root trusted by the consumer;",{"_3632":2527,"_31184":2500,"_21603":58846,"_5":14870,"_28376":58792,"_3083":58847},[],"its dates and usages allow the operation;",{"_3632":2528,"_31184":2500,"_21603":58849,"_5":14870,"_28376":58792,"_3083":58850},[],"the consumer applies revocation checks and authorization.",{"_3632":2529,"_31184":2500,"_21603":58852,"_5":14870,"_28376":58792,"_3083":58853},[],"The issuance path includes the first independent checks.",{"_3632":2530,"_31184":2500,"_21603":58855,"_5":14870,"_28376":58796,"_3083":58856},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3632":2531,"_31184":2500,"_21603":58858,"_5":14870,"_28376":58796,"_3083":58859},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3632":2532,"_31184":2500,"_21603":58861,"_5":14870,"_28376":58796,"_3083":58862},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3632":2533,"_31184":2533,"_5":15230,"_3083":58864,"_31543":58865,"_21603":58866,"_28376":2533},"Create your first CA",[50996,52508,56682,56119],[],{"_3632":2534,"_31184":2533,"_21603":58868,"_5":14870,"_28376":2533,"_3083":58869},[],"Create an evaluation root and check its certificate before issuing.",{"_3632":2535,"_31184":2533,"_5":31540,"_21603":58871,"_28376":58872,"_3083":51006},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3632":2536,"_31184":2533,"_5":31540,"_21603":58874,"_28376":58875,"_3083":58876},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3632":2537,"_31184":2533,"_5":31540,"_21603":58878,"_28376":58879,"_3083":58880},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3632":2538,"_31184":2533,"_5":31540,"_21603":58882,"_28376":58883,"_3083":58884},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3632":2539,"_31184":2533,"_5":31540,"_21603":58886,"_28376":58887,"_3083":58888},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3632":2540,"_31184":2533,"_5":31540,"_21603":58890,"_28376":58891,"_3083":58892},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3632":2541,"_31184":2533,"_5":31540,"_21603":58894,"_28376":58895,"_3083":58896},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3632":2542,"_31184":2533,"_5":31540,"_21603":58898,"_28376":58899,"_3083":56376},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3632":2543,"_31184":2533,"_5":31540,"_21603":58901,"_28376":58902,"_3083":51030},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3632":2544,"_31184":2533,"_21603":58904,"_5":14870,"_28376":2533,"_3083":58905},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3632":2545,"_31184":2533,"_21603":58907,"_5":14870,"_28376":58872,"_3083":58908},[],"Console access and permission to create keys and authorities.",{"_3632":2546,"_31184":2533,"_21603":58910,"_5":14870,"_28376":58872,"_3083":58911},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3632":2547,"_31184":2533,"_21603":58913,"_5":14870,"_28376":58872,"_3083":58914},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3632":2548,"_31184":2533,"_21603":58916,"_5":14870,"_28376":58872,"_3083":58917},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3632":2549,"_31184":2533,"_21603":58919,"_5":14870,"_28376":58875,"_3083":58920},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3632":2550,"_31184":2533,"_21603":58922,"_5":14870,"_28376":58875,"_3083":58923},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3632":2551,"_31184":2533,"_21603":58925,"_5":14870,"_28376":58879,"_3083":58926},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3632":2552,"_31184":2533,"_21603":58928,"_5":14870,"_28376":58879,"_3083":58929},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3632":2553,"_31184":2533,"_21603":58931,"_5":14870,"_28376":58883,"_3083":58932},[],"Select **Root CA** and complete:",{"_3632":2554,"_31184":2533,"_21603":58934,"_5":14870,"_28376":58883,"_3083":58935},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3632":2555,"_31184":2533,"_21603":58937,"_5":14870,"_28376":58883,"_3083":58938},[],"**Subject**: organization and country details for your evaluation.",{"_3632":2556,"_31184":2533,"_21603":58940,"_5":14870,"_28376":58883,"_3083":58941},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3632":2557,"_31184":2533,"_21603":58943,"_5":14870,"_28376":58883,"_3083":58944},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3632":2558,"_31184":2533,"_21603":58946,"_5":14870,"_28376":58883,"_3083":58947},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3632":2559,"_31184":2533,"_21603":58949,"_5":14870,"_28376":58887,"_3083":58950},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3632":2560,"_31184":2533,"_21603":58952,"_5":14870,"_28376":58891,"_3083":58953},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3632":2561,"_31184":2533,"_21603":58955,"_5":14870,"_28376":58891,"_3083":58956},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3632":2562,"_31184":2533,"_21603":58958,"_5":14870,"_28376":58895,"_3083":58959},[],"Run from the directory where you saved `ca.pem`:",{"_3632":2563,"_31184":2533,"_21603":58961,"_5":14870,"_28376":58895,"_3083":58962},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3632":2564,"_31184":2533,"_21603":58964,"_5":14870,"_28376":58895,"_3083":58965},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3632":2565,"_31184":2533,"_21603":58967,"_5":14870,"_28376":58899,"_3083":58968},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3632":2566,"_31184":2533,"_21603":58970,"_5":14870,"_28376":58899,"_3083":58971},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3632":2567,"_31184":2533,"_21603":58973,"_5":14870,"_28376":58899,"_3083":58974},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3632":2568,"_31184":2533,"_21603":58976,"_5":14870,"_28376":58899,"_3083":58977},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3632":2569,"_31184":2533,"_21603":58979,"_5":14870,"_28376":58902,"_3083":58980},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3632":2570,"_31184":2570,"_5":15230,"_3083":58982,"_31543":58983,"_21603":58984,"_28376":2570},"Issue and verify a certificate",[50996,52508,56682,56119],[],{"_3632":2571,"_31184":2570,"_21603":58986,"_5":14870,"_28376":2570,"_3083":58987},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3632":2572,"_31184":2570,"_5":31540,"_21603":58989,"_28376":58990,"_3083":51006},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3632":2573,"_31184":2570,"_5":31540,"_21603":58992,"_28376":58993,"_3083":58994},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3632":2574,"_31184":2570,"_5":31540,"_21603":58996,"_28376":58997,"_3083":58998},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3632":2575,"_31184":2570,"_5":31540,"_21603":59000,"_28376":59001,"_3083":59002},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3632":2576,"_31184":2570,"_5":31540,"_21603":59004,"_28376":59005,"_3083":59006},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3632":2577,"_31184":2570,"_5":31540,"_21603":59008,"_28376":59009,"_3083":59010},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3632":2578,"_31184":2570,"_5":31540,"_21603":59012,"_28376":59013,"_3083":59014},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3632":2579,"_31184":2570,"_5":31540,"_21603":59016,"_28376":59017,"_3083":59018},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3632":2580,"_31184":2570,"_5":31540,"_21603":59020,"_28376":59021,"_3083":59022},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3632":2581,"_31184":2570,"_5":31540,"_21603":59024,"_28376":59025,"_3083":59026},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3632":2582,"_31184":2570,"_5":31540,"_21603":59028,"_28376":59029,"_3083":56376},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3632":2583,"_31184":2570,"_5":31540,"_21603":59031,"_28376":59032,"_3083":51030},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#next-step",{"_3632":2584,"_31184":2570,"_21603":59034,"_5":14870,"_28376":2570,"_3083":59035},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3632":2585,"_31184":2570,"_21603":59037,"_5":14870,"_28376":58990,"_3083":59038},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3632":2586,"_31184":2570,"_21603":59040,"_5":14870,"_28376":58990,"_3083":59041},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3632":2587,"_31184":2570,"_21603":59043,"_5":14870,"_28376":58990,"_3083":59044},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3632":2588,"_31184":2570,"_21603":59046,"_5":14870,"_28376":58990,"_3083":59047},[],"A client identifier: here we use `device-001`.",{"_3632":2589,"_31184":2570,"_21603":59049,"_5":14870,"_28376":58990,"_3083":59050},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3632":2590,"_31184":2570,"_21603":59052,"_5":14870,"_28376":58993,"_3083":59053},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3632":2591,"_31184":2570,"_21603":59055,"_5":14870,"_28376":58997,"_3083":59056},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3632":2592,"_31184":2570,"_21603":59058,"_5":14870,"_28376":58997,"_3083":59059},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3632":2593,"_31184":2570,"_21603":59061,"_5":14870,"_28376":59001,"_3083":59062},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3632":2594,"_31184":2570,"_21603":59064,"_5":14870,"_28376":59001,"_3083":59065},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3632":2595,"_31184":2570,"_21603":59067,"_5":14870,"_28376":59005,"_3083":59068},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3632":2596,"_31184":2570,"_21603":59070,"_5":14870,"_28376":59005,"_3083":59071},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3632":2597,"_31184":2570,"_21603":59073,"_5":14870,"_28376":59009,"_3083":59074},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3632":2598,"_31184":2570,"_21603":59076,"_5":14870,"_28376":59013,"_3083":59077},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3632":2599,"_31184":2570,"_21603":59079,"_5":14870,"_28376":59017,"_3083":59080},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3632":2600,"_31184":2570,"_21603":59082,"_5":14870,"_28376":59021,"_3083":59083},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3632":2601,"_31184":2570,"_21603":59085,"_5":14870,"_28376":59021,"_3083":59086},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3632":2602,"_31184":2570,"_21603":59088,"_5":14870,"_28376":59021,"_3083":59089},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3632":2603,"_31184":2570,"_21603":59091,"_5":14870,"_28376":59025,"_3083":59092},[],"In Bash, compare the two public-key digests:",{"_3632":2604,"_31184":2570,"_21603":59094,"_5":14870,"_28376":59025,"_3083":59095},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3632":2605,"_31184":2570,"_21603":59097,"_5":14870,"_28376":59025,"_3083":59098},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3632":2606,"_31184":2570,"_21603":59100,"_5":14870,"_28376":59029,"_3083":56460},[],{"_3632":2607,"_31184":2570,"_21603":59102,"_5":14870,"_28376":59029,"_3083":59103},[],"What to review",{"_3632":2608,"_31184":2570,"_21603":59105,"_5":14870,"_28376":59029,"_3083":59106},[],"The CA rejects issuance",{"_3632":2609,"_31184":2570,"_21603":59108,"_5":14870,"_28376":59029,"_3083":59109},[],"Permissions, CA state and key, algorithm and profile.",{"_3632":2610,"_31184":2570,"_21603":59111,"_5":14870,"_28376":59029,"_3083":59112},[],"Different subject or usages",{"_3632":2611,"_31184":2570,"_21603":59114,"_5":14870,"_28376":59029,"_3083":59115},[],"Applied profile and requested values.",{"_3632":2612,"_31184":2570,"_21603":59117,"_5":14870,"_28376":59029,"_3083":59118},[],"Issuer cannot be found",{"_3632":2613,"_31184":2570,"_21603":59120,"_5":14870,"_28376":59029,"_3083":59121},[],"Downloaded CA and required intermediate chain.",{"_3632":2614,"_31184":2570,"_21603":59123,"_5":14870,"_28376":59029,"_3083":59124},[],"Validity fails",{"_3632":2615,"_31184":2570,"_21603":59126,"_5":14870,"_28376":59029,"_3083":59127},[],"Certificate and CA dates, and the computer's clock.",{"_3632":2616,"_31184":2570,"_21603":59129,"_5":14870,"_28376":59029,"_3083":59130},[],"Public-key digests differ",{"_3632":2617,"_31184":2570,"_21603":59132,"_5":14870,"_28376":59029,"_3083":59133},[],"Certificate and key files from the same issuance.",{"_3632":2618,"_31184":2570,"_21603":59135,"_5":14870,"_28376":59029,"_3083":59136},[],"See PKI diagnostics to narrow an issuance failure.",{"_3632":2619,"_31184":2570,"_21603":59138,"_5":14870,"_28376":59032,"_3083":59139},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3632":2620,"_31184":2570,"_21603":59141,"_5":14870,"_28376":59032,"_3083":59142},[],"Manage certificates for inspection, status and revocation.",{"_3632":2621,"_31184":2570,"_21603":59144,"_5":14870,"_28376":59032,"_3083":59145},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3632":2622,"_31184":2570,"_21603":59147,"_5":14870,"_28376":59032,"_3083":59148},[],"Prepare EST for the device to request its next identities.",{"_3632":2623,"_31184":2570,"_21603":59150,"_5":14870,"_28376":59032,"_3083":59151},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3632":2624,"_31184":2624,"_5":15230,"_3083":59153,"_31543":59154,"_21603":59155,"_28376":2624},"PKI getting started",[50996,52508,56682,56119],[],{"_3632":2625,"_31184":2624,"_21603":59157,"_5":14870,"_28376":2624,"_3083":59158},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3632":2626,"_31184":2624,"_5":31540,"_21603":59160,"_28376":59161,"_3083":51006},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#before-you-begin",{"_3632":2627,"_31184":2624,"_5":31540,"_21603":59163,"_28376":59164,"_3083":59165},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3632":2628,"_31184":2624,"_5":31540,"_21603":59167,"_28376":59168,"_3083":56311},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#expected-result",{"_3632":2629,"_31184":2624,"_5":31540,"_21603":59170,"_28376":59171,"_3083":59172},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3632":2630,"_31184":2624,"_21603":59174,"_5":14870,"_28376":2624,"_3083":59175},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3632":2631,"_31184":2624,"_21603":59177,"_5":14870,"_28376":59161,"_3083":59178},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3632":2632,"_31184":2624,"_21603":59180,"_5":14870,"_28376":59161,"_3083":59181},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3632":2633,"_31184":2624,"_21603":59183,"_5":14870,"_28376":59161,"_3083":59184},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3632":2634,"_31184":2624,"_21603":59186,"_5":14870,"_28376":59161,"_3083":59187},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3632":2635,"_31184":2624,"_21603":59189,"_5":14870,"_28376":59161,"_3083":59190},[],"A working directory with restricted access for the downloaded key.",{"_3632":2636,"_31184":2624,"_21603":59192,"_5":14870,"_28376":59164,"_3083":59193},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3632":2637,"_31184":2624,"_21603":59195,"_5":14870,"_28376":59164,"_3083":59196},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3632":2638,"_31184":2624,"_21603":59198,"_5":14870,"_28376":59164,"_3083":59199},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3632":2639,"_31184":2624,"_21603":59201,"_5":14870,"_28376":59164,"_3083":59202},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3632":2640,"_31184":2624,"_21603":59204,"_5":14870,"_28376":59168,"_3083":59205},[],"File or resource",{"_3632":2641,"_31184":2624,"_21603":59207,"_5":14870,"_28376":59168,"_3083":56308},[],{"_3632":2642,"_31184":2624,"_21603":59209,"_5":14870,"_28376":59168,"_3083":59210},[],"Active root CA and `ca.pem`",{"_3632":2643,"_31184":2624,"_21603":59212,"_5":14870,"_28376":59168,"_3083":59213},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3632":2644,"_31184":2624,"_21603":59215,"_5":14870,"_28376":59168,"_3083":59216},[],"End-entity certificate and `device.crt`",{"_3632":2645,"_31184":2624,"_21603":59218,"_5":14870,"_28376":59168,"_3083":59219},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3632":2646,"_31184":2624,"_21603":59221,"_5":14870,"_28376":59168,"_3083":59222},[],"Private key `device.key`",{"_3632":2647,"_31184":2624,"_21603":59224,"_5":14870,"_28376":59168,"_3083":59225},[],"Its public key matches the one included in `device.crt`.",{"_3632":2648,"_31184":2624,"_21603":59227,"_5":14870,"_28376":59168,"_3083":59228},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3632":2649,"_31184":2624,"_21603":59230,"_5":14870,"_28376":59171,"_3083":59231},[],"To operate certificates, continue with Certificates and Validation.",{"_3632":2650,"_31184":2624,"_21603":59233,"_5":14870,"_28376":59171,"_3083":59234},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3632":2651,"_31184":2624,"_21603":59236,"_5":14870,"_28376":59171,"_3083":59237},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3632":2652,"_31184":2652,"_5":15230,"_3083":59239,"_31543":59240,"_21603":59241,"_28376":2652},"PKI troubleshooting",[50996,52508,56682,55257],[],{"_3632":2653,"_31184":2652,"_21603":59243,"_5":14870,"_28376":2652,"_3083":59244},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3632":2654,"_31184":2652,"_5":31540,"_21603":59246,"_28376":59247,"_3083":59248},[],"/docs/pr-preview/pr-75/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3632":2655,"_31184":2652,"_5":31540,"_21603":59250,"_28376":59251,"_3083":59252},[],"/docs/pr-preview/pr-75/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3632":2656,"_31184":2652,"_5":31540,"_21603":59254,"_28376":59255,"_3083":59256},[],"/docs/pr-preview/pr-75/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3632":2657,"_31184":2652,"_21603":59258,"_5":14870,"_28376":2652,"_3083":59259},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3632":2658,"_31184":2652,"_21603":59261,"_5":14870,"_28376":2652,"_3083":59262},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3632":2659,"_31184":2652,"_21603":59264,"_5":14870,"_28376":59247,"_3083":56308},[],{"_3632":2660,"_31184":2652,"_21603":59266,"_5":14870,"_28376":59247,"_3083":59267},[],"What to inspect",{"_3632":2661,"_31184":2652,"_21603":59269,"_5":14870,"_28376":59247,"_3083":51030},[],{"_3632":2662,"_31184":2652,"_21603":59271,"_5":14870,"_28376":59247,"_3083":55524},[],{"_3632":2663,"_31184":2652,"_21603":59273,"_5":14870,"_28376":59247,"_3083":59274},[],"Exists, is active and has usable dates.",{"_3632":2664,"_31184":2652,"_21603":59276,"_5":14870,"_28376":59247,"_3083":59277},[],"Authorities.",{"_3632":2665,"_31184":2652,"_21603":59279,"_5":14870,"_28376":59247,"_3083":59280},[],"Key",{"_3632":2666,"_31184":2652,"_21603":59282,"_5":14870,"_28376":59247,"_3083":59283},[],"The record has a usable private key and the engine can sign.",{"_3632":2667,"_31184":2652,"_21603":59285,"_5":14870,"_28376":59247,"_3083":59286},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3632":2668,"_31184":2652,"_21603":59288,"_5":14870,"_28376":59247,"_3083":59289},[],"CSR",{"_3632":2669,"_31184":2652,"_21603":59291,"_5":14870,"_28376":59247,"_3083":59292},[],"Correct PEM and verifiable signature.",{"_3632":2670,"_31184":2652,"_21603":59294,"_5":14870,"_28376":59247,"_3083":59295},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3632":2671,"_31184":2652,"_21603":59297,"_5":14870,"_28376":59247,"_3083":59298},[],"Profile",{"_3632":2672,"_31184":2652,"_21603":59300,"_5":14870,"_28376":59247,"_3083":59301},[],"Selected source, existing ID, allowed algorithm and size.",{"_3632":2673,"_31184":2652,"_21603":59303,"_5":14870,"_28376":59247,"_3083":59304},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3632":2674,"_31184":2652,"_21603":59306,"_5":14870,"_28376":59247,"_3083":56460},[],{"_3632":2675,"_31184":2652,"_21603":59308,"_5":14870,"_28376":59247,"_3083":59309},[],"Appropriate subject, SAN, usages and dates.",{"_3632":2676,"_31184":2652,"_21603":59311,"_5":14870,"_28376":59247,"_3083":59312},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3632":2677,"_31184":2652,"_21603":59314,"_5":14870,"_28376":59247,"_3083":59315},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3632":2678,"_31184":2652,"_21603":59317,"_5":14870,"_28376":59247,"_3083":59318},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3632":2679,"_31184":2652,"_21603":59320,"_5":14870,"_28376":59247,"_3083":59321},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3632":2680,"_31184":2652,"_21603":59323,"_5":14870,"_28376":59251,"_3083":59324},[],"Check each boundary independently:",{"_3632":2681,"_31184":2652,"_21603":59326,"_5":14870,"_28376":59251,"_3083":59327},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3632":2682,"_31184":2652,"_21603":59329,"_5":14870,"_28376":59251,"_3083":59330},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3632":2683,"_31184":2652,"_21603":59332,"_5":14870,"_28376":59251,"_3083":59333},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3632":2684,"_31184":2652,"_21603":59335,"_5":14870,"_28376":59251,"_3083":59336},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3632":2685,"_31184":2652,"_21603":59338,"_5":14870,"_28376":59251,"_3083":59339},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3632":2686,"_31184":2652,"_21603":59341,"_5":14870,"_28376":59251,"_3083":59342},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3632":2687,"_31184":2652,"_21603":59344,"_5":14870,"_28376":59255,"_3083":59345},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3632":2688,"_31184":2652,"_21603":59347,"_5":14870,"_28376":59255,"_3083":59348},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3632":2689,"_31184":2689,"_5":15230,"_3083":59350,"_31543":59351,"_21603":59352,"_28376":2689},"Security",[50996],[],{"_3632":2690,"_31184":2689,"_21603":59354,"_5":14870,"_28376":2689,"_3083":59355},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3632":2691,"_31184":2689,"_5":31540,"_21603":59357,"_28376":59358,"_3083":59359},[],"/docs/pr-preview/pr-75/security#report-a-vulnerability","Report a vulnerability",{"_3632":2692,"_31184":2689,"_5":31540,"_21603":59361,"_28376":59362,"_3083":59363},[],"/docs/pr-preview/pr-75/security#what-to-include-in-a-report","What to include in a report",{"_3632":2693,"_31184":2689,"_5":31540,"_21603":59365,"_28376":59366,"_3083":59367},[],"/docs/pr-preview/pr-75/security#supported-versions","Supported versions",{"_3632":2694,"_31184":2689,"_5":31540,"_21603":59369,"_28376":59370,"_3083":59371},[],"/docs/pr-preview/pr-75/security#responsible-disclosure","Responsible disclosure",{"_3632":2695,"_31184":2689,"_21603":59373,"_5":14870,"_28376":2689,"_3083":59374},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3632":2696,"_31184":2689,"_21603":59376,"_5":14870,"_28376":59358,"_3083":59377},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3632":2697,"_31184":2689,"_21603":59379,"_5":14870,"_28376":59358,"_3083":59380},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3632":2698,"_31184":2689,"_21603":59382,"_5":14870,"_28376":59358,"_3083":15509},[],{"_3632":2699,"_31184":2689,"_21603":59384,"_5":14870,"_28376":59358,"_3083":15438},[],{"_3632":2700,"_31184":2689,"_21603":59386,"_5":14870,"_28376":59358,"_3083":15496},[],{"_3632":2701,"_31184":2689,"_21603":59388,"_5":14870,"_28376":59358,"_3083":59389},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3632":2702,"_31184":2689,"_21603":59391,"_5":14870,"_28376":59358,"_3083":59392},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3632":2703,"_31184":2689,"_21603":59394,"_5":14870,"_28376":59362,"_3083":59395},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3632":2704,"_31184":2689,"_21603":59397,"_5":14870,"_28376":59362,"_3083":59398},[],"Do not include in the report:",{"_3632":2705,"_31184":2689,"_21603":59400,"_5":14870,"_28376":59362,"_3083":59401},[],"Credentials, tokens, or private keys",{"_3632":2706,"_31184":2689,"_21603":59403,"_5":14870,"_28376":59362,"_3083":59404},[],"Customer data or customer-identifiable information",{"_3632":2707,"_31184":2689,"_21603":59406,"_5":14870,"_28376":59362,"_3083":59407},[],"Confidential architecture or internal infrastructure details",{"_3632":2708,"_31184":2689,"_21603":59409,"_5":14870,"_28376":59366,"_3083":59410},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3632":2709,"_31184":2689,"_21603":59412,"_5":14870,"_28376":59366,"_3083":59413},[],"For upgrade guidance, see Upgrades.",{"_3632":2710,"_31184":2689,"_21603":59415,"_5":14870,"_28376":59370,"_3083":59416},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3632":2711,"_31184":2689,"_21603":59418,"_5":14870,"_28376":59370,"_3083":59419},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3632":2712,"_31184":2689,"_21603":59421,"_5":14870,"_28376":59370,"_3083":59422},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3632":2713,"_31184":2689,"_21603":59424,"_5":14870,"_28376":59370,"_3083":59425},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3632":2714,"_31184":2689,"_21603":59427,"_5":14870,"_28376":59370,"_3083":59428},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3632":2715,"_31184":2715,"_5":15230,"_3083":59430,"_31543":59431,"_21603":59433,"_28376":2715},"3.8.0 to 4.0.0",[50996,59432],"Upgrades",[],{"_3632":2716,"_31184":2715,"_21603":59435,"_5":14870,"_28376":2715,"_3083":59436},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3632":2717,"_31184":2715,"_5":31540,"_21603":59438,"_28376":59439,"_3083":59440},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3632":2718,"_31184":2715,"_5":31540,"_21603":59442,"_28376":59443,"_3083":59444},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3632":2719,"_31184":2715,"_5":31540,"_21603":59446,"_28376":59447,"_3083":59448},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3632":2720,"_31184":2715,"_5":31540,"_21603":59450,"_28376":59451,"_3083":59452},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3632":2721,"_31184":2715,"_5":31540,"_21603":59454,"_28376":59455,"_3083":59456},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3632":2722,"_31184":2715,"_5":31540,"_21603":59458,"_28376":59459,"_3083":59460},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3632":2723,"_31184":2715,"_5":31540,"_21603":59462,"_28376":59463,"_3083":59464},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3632":2724,"_31184":2715,"_5":31540,"_21603":59466,"_28376":59467,"_3083":59468},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3632":2725,"_31184":2715,"_5":31540,"_21603":59470,"_28376":59471,"_3083":59472},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3632":2726,"_31184":2715,"_5":31540,"_21603":59474,"_28376":59475,"_3083":59476},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3632":2727,"_31184":2715,"_5":31540,"_21603":59478,"_28376":59479,"_3083":51634},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3632":2728,"_31184":2715,"_5":31540,"_21603":59481,"_28376":59482,"_3083":59483},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3632":2729,"_31184":2715,"_5":31540,"_21603":59485,"_28376":59486,"_3083":59487},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3632":2730,"_31184":2715,"_5":31540,"_21603":59489,"_28376":59490,"_3083":59491},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3632":2731,"_31184":2715,"_5":31540,"_21603":59493,"_28376":59494,"_3083":59495},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3632":2732,"_31184":2715,"_5":31540,"_21603":59497,"_28376":59498,"_3083":59499},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3632":2733,"_31184":2715,"_5":31540,"_21603":59501,"_28376":59502,"_3083":59503},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3632":2734,"_31184":2715,"_5":31540,"_21603":59505,"_28376":59506,"_3083":59507},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3632":2735,"_31184":2715,"_5":31540,"_21603":59509,"_28376":59510,"_3083":59511},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3632":2736,"_31184":2715,"_5":31540,"_21603":59513,"_28376":59514,"_3083":59515},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3632":2737,"_31184":2715,"_5":31540,"_21603":59517,"_28376":59518,"_3083":59519},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3632":2738,"_31184":2715,"_5":31540,"_21603":59521,"_28376":59522,"_3083":59523},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3632":2739,"_31184":2715,"_5":31540,"_21603":59525,"_28376":59526,"_3083":59527},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3632":2740,"_31184":2715,"_5":31540,"_21603":59529,"_28376":59530,"_3083":59531},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3632":2741,"_31184":2715,"_5":31540,"_21603":59533,"_28376":59534,"_3083":59535},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3632":2742,"_31184":2715,"_5":31540,"_21603":59537,"_28376":59538,"_3083":59539},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3632":2743,"_31184":2715,"_5":31540,"_21603":59541,"_28376":59542,"_3083":59543},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3632":2744,"_31184":2715,"_5":31540,"_21603":59545,"_28376":59546,"_3083":59547},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3632":2745,"_31184":2715,"_5":31540,"_21603":59549,"_28376":59550,"_3083":59551},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3632":2746,"_31184":2715,"_5":31540,"_21603":59553,"_28376":59554,"_3083":59555},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3632":2747,"_31184":2715,"_5":31540,"_21603":59557,"_28376":59558,"_3083":59559},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3632":2748,"_31184":2715,"_5":31540,"_21603":59561,"_28376":59562,"_3083":59563},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3632":2749,"_31184":2715,"_5":31540,"_21603":59565,"_28376":59566,"_3083":59567},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3632":2750,"_31184":2715,"_5":31540,"_21603":59569,"_28376":59570,"_3083":59571},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3632":2751,"_31184":2715,"_5":31540,"_21603":59573,"_28376":59574,"_3083":59567},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3632":2752,"_31184":2715,"_5":31540,"_21603":59576,"_28376":59577,"_3083":59578},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3632":2753,"_31184":2715,"_5":31540,"_21603":59580,"_28376":59581,"_3083":59582},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3632":2754,"_31184":2715,"_5":31540,"_21603":59584,"_28376":59585,"_3083":59586},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3632":2755,"_31184":2715,"_5":31540,"_21603":59588,"_28376":59589,"_3083":59590},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3632":2756,"_31184":2715,"_5":31540,"_21603":59592,"_28376":59593,"_3083":59594},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3632":2757,"_31184":2715,"_5":31540,"_21603":59596,"_28376":59597,"_3083":59598},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3632":2758,"_31184":2715,"_5":31540,"_21603":59600,"_28376":59601,"_3083":59602},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3632":2759,"_31184":2715,"_5":31540,"_21603":59604,"_28376":59605,"_3083":59606},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3632":2760,"_31184":2715,"_5":31540,"_21603":59608,"_28376":59609,"_3083":59610},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3632":2761,"_31184":2715,"_5":31540,"_21603":59612,"_28376":59613,"_3083":55257},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3632":2762,"_31184":2715,"_5":31540,"_21603":59615,"_28376":59616,"_3083":59617},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3632":2763,"_31184":2715,"_5":31540,"_21603":59619,"_28376":59620,"_3083":59621},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3632":2764,"_31184":2715,"_21603":59623,"_5":14870,"_28376":2715,"_3083":59624},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3632":2765,"_31184":2715,"_21603":59626,"_5":14870,"_28376":2715,"_3083":59627},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3632":2766,"_31184":2715,"_21603":59629,"_5":14870,"_28376":2715,"_3083":59630},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3632":2767,"_31184":2715,"_21603":59632,"_5":14870,"_28376":2715,"_3083":59633},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3632":2768,"_31184":2715,"_21603":59635,"_5":14870,"_28376":2715,"_3083":59636},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3632":2769,"_31184":2715,"_21603":59638,"_5":14870,"_28376":2715,"_3083":59639},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3632":2770,"_31184":2715,"_21603":59641,"_5":14870,"_28376":2715,"_3083":59642},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3632":2771,"_31184":2715,"_21603":59644,"_5":14870,"_28376":59443,"_3083":59645},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3632":2772,"_31184":2715,"_21603":59647,"_5":14870,"_28376":59443,"_3083":59648},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3632":2773,"_31184":2715,"_21603":59650,"_5":14870,"_28376":59447,"_3083":59651},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3632":2774,"_31184":2715,"_21603":59653,"_5":14870,"_28376":59447,"_3083":59654},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3632":2775,"_31184":2715,"_21603":59656,"_5":14870,"_28376":59451,"_3083":59657},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3632":2776,"_31184":2715,"_21603":59659,"_5":14870,"_28376":59455,"_3083":59660},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3632":2777,"_31184":2715,"_21603":59662,"_5":14870,"_28376":59455,"_3083":59663},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3632":2778,"_31184":2715,"_21603":59665,"_5":14870,"_28376":59455,"_3083":59666},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3632":2779,"_31184":2715,"_21603":59668,"_5":14870,"_28376":59455,"_3083":59669},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3632":2780,"_31184":2715,"_21603":59671,"_5":14870,"_28376":59455,"_3083":59672},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3632":2781,"_31184":2715,"_21603":59674,"_5":14870,"_28376":59459,"_3083":59675},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3632":2782,"_31184":2715,"_21603":59677,"_5":14870,"_28376":59459,"_3083":59678},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3632":2783,"_31184":2715,"_21603":59680,"_5":14870,"_28376":59459,"_3083":59681},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3632":2784,"_31184":2715,"_21603":59683,"_5":14870,"_28376":59459,"_3083":59684},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3632":2785,"_31184":2715,"_21603":59686,"_5":14870,"_28376":59459,"_3083":59687},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3632":2786,"_31184":2715,"_21603":59689,"_5":14870,"_28376":59459,"_3083":59690},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3632":2787,"_31184":2715,"_21603":59692,"_5":14870,"_28376":59463,"_3083":59693},[],"Change",{"_3632":2788,"_31184":2715,"_21603":59695,"_5":14870,"_28376":59463,"_3083":59696},[],"Who is affected",{"_3632":2789,"_31184":2715,"_21603":59698,"_5":14870,"_28376":59463,"_3083":59699},[],"Severity",{"_3632":2790,"_31184":2715,"_21603":59701,"_5":14870,"_28376":59463,"_3083":58152},[],{"_3632":2791,"_31184":2715,"_21603":59703,"_5":14870,"_28376":59463,"_3083":59472},[],{"_3632":2792,"_31184":2715,"_21603":59705,"_5":14870,"_28376":59463,"_3083":59706},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3632":2793,"_31184":2715,"_21603":59708,"_5":14870,"_28376":59463,"_3083":59709},[],"High: KMS and VA start on empty volumes",{"_3632":2794,"_31184":2715,"_21603":59711,"_5":14870,"_28376":59463,"_3083":59712},[],"Copy the data into the new volumes",{"_3632":2795,"_31184":2715,"_21603":59714,"_5":14870,"_28376":59463,"_3083":59476},[],{"_3632":2796,"_31184":2715,"_21603":59716,"_5":14870,"_28376":59463,"_3083":59717},[],"Every Helm release",{"_3632":2797,"_31184":2715,"_21603":59719,"_5":14870,"_28376":59463,"_3083":59720},[],"High: `helm upgrade` fails",{"_3632":2798,"_31184":2715,"_21603":59722,"_5":14870,"_28376":59463,"_3083":59723},[],"Remove or rename legacy keys",{"_3632":2799,"_31184":2715,"_21603":59725,"_5":14870,"_28376":59463,"_3083":51634},[],{"_3632":2800,"_31184":2715,"_21603":59727,"_5":14870,"_28376":59463,"_3083":59717},[],{"_3632":2801,"_31184":2715,"_21603":59729,"_5":14870,"_28376":59463,"_3083":59730},[],"High: `helm upgrade` fails on inline credentials",{"_3632":2802,"_31184":2715,"_21603":59732,"_5":14870,"_28376":59463,"_3083":59733},[],"Create the Secrets first; see Step 2",{"_3632":2803,"_31184":2715,"_21603":59735,"_5":14870,"_28376":59463,"_3083":59483},[],{"_3632":2804,"_31184":2715,"_21603":59737,"_5":14870,"_28376":59463,"_3083":59738},[],"Every deployment",{"_3632":2805,"_31184":2715,"_21603":59740,"_5":14870,"_28376":59463,"_3083":59741},[],"High: without a bootstrap principal there is no administrator",{"_3632":2806,"_31184":2715,"_21603":59743,"_5":14870,"_28376":59463,"_3083":59744},[],"Configure `services.authz`",{"_3632":2807,"_31184":2715,"_21603":59746,"_5":14870,"_28376":59463,"_3083":59487},[],{"_3632":2808,"_31184":2715,"_21603":59748,"_5":14870,"_28376":59463,"_3083":59717},[],{"_3632":2809,"_31184":2715,"_21603":59750,"_5":14870,"_28376":59463,"_3083":59751},[],"High: `helm upgrade` fails on the old keys",{"_3632":2810,"_31184":2715,"_21603":59753,"_5":14870,"_28376":59463,"_3083":59754},[],"Move JWKS and roles into `services.authz`",{"_3632":2811,"_31184":2715,"_21603":59756,"_5":14870,"_28376":59463,"_3083":59507},[],{"_3632":2812,"_31184":2715,"_21603":59758,"_5":14870,"_28376":59463,"_3083":59759},[],"3.8.0 deployments with per-service databases",{"_3632":2813,"_31184":2715,"_21603":59761,"_5":14870,"_28376":59463,"_3083":59762},[],"High: services find no data, or a migration aborts",{"_3632":2814,"_31184":2715,"_21603":59764,"_5":14870,"_28376":59463,"_3083":59765},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3632":2815,"_31184":2715,"_21603":59767,"_5":14870,"_28376":59463,"_3083":59511},[],{"_3632":2816,"_31184":2715,"_21603":59769,"_5":14870,"_28376":59463,"_3083":59770},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3632":2817,"_31184":2715,"_21603":59772,"_5":14870,"_28376":59463,"_3083":59773},[],"High: the backend no longer starts with them",{"_3632":2818,"_31184":2715,"_21603":59775,"_5":14870,"_28376":59463,"_3083":59776},[],"Move to PostgreSQL before upgrading",{"_3632":2819,"_31184":2715,"_21603":59778,"_5":14870,"_28376":59463,"_3083":59559},[],{"_3632":2820,"_31184":2715,"_21603":59780,"_5":14870,"_28376":59463,"_3083":59781},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3632":2821,"_31184":2715,"_21603":59783,"_5":14870,"_28376":59463,"_3083":59784},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3632":2822,"_31184":2715,"_21603":59786,"_5":14870,"_28376":59463,"_3083":59787},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3632":2823,"_31184":2715,"_21603":59789,"_5":14870,"_28376":59463,"_3083":59790},[],"Webhooks with file references",{"_3632":2824,"_31184":2715,"_21603":59792,"_5":14870,"_28376":59463,"_3083":59793},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3632":2825,"_31184":2715,"_21603":59795,"_5":14870,"_28376":59463,"_3083":59796},[],"High: enrollments calling the webhook fail",{"_3632":2826,"_31184":2715,"_21603":59798,"_5":14870,"_28376":59463,"_3083":59799},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3632":2827,"_31184":2715,"_21603":59801,"_5":14870,"_28376":59463,"_3083":59491},[],{"_3632":2828,"_31184":2715,"_21603":59803,"_5":14870,"_28376":59463,"_3083":59804},[],"Releases with per-service identity overrides or mounted key material",{"_3632":2829,"_31184":2715,"_21603":59806,"_5":14870,"_28376":59463,"_3083":59807},[],"Medium: services cannot read their files",{"_3632":2830,"_31184":2715,"_21603":59809,"_5":14870,"_28376":59463,"_3083":59810},[],"Remove the overrides and fix volume ownership",{"_3632":2831,"_31184":2715,"_21603":59812,"_5":14870,"_28376":59463,"_3083":59495},[],{"_3632":2832,"_31184":2715,"_21603":59814,"_5":14870,"_28376":59463,"_3083":59815},[],"Releases that set `amqp.tls`",{"_3632":2833,"_31184":2715,"_21603":59817,"_5":14870,"_28376":59463,"_3083":59818},[],"Medium: clients connect to the wrong port",{"_3632":2834,"_31184":2715,"_21603":59820,"_5":14870,"_28376":59463,"_3083":59821},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3632":2835,"_31184":2715,"_21603":59823,"_5":14870,"_28376":59463,"_3083":59515},[],{"_3632":2836,"_31184":2715,"_21603":59825,"_5":14870,"_28376":59463,"_3083":59826},[],"Installations whose CA keys predate the KMS",{"_3632":2837,"_31184":2715,"_21603":59828,"_5":14870,"_28376":59463,"_3083":59829},[],"Medium: CA keys stay unmanaged",{"_3632":2838,"_31184":2715,"_21603":59831,"_5":14870,"_28376":59463,"_3083":59832},[],"Run the CA-to-KMS migration",{"_3632":2839,"_31184":2715,"_21603":59834,"_5":14870,"_28376":59463,"_3083":59835},[],"Receiver certificate verification",{"_3632":2840,"_31184":2715,"_21603":59837,"_5":14870,"_28376":59463,"_3083":59838},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3632":2841,"_31184":2715,"_21603":59840,"_5":14870,"_28376":59463,"_3083":59841},[],"Medium: credentials go to an unverified receiver",{"_3632":2842,"_31184":2715,"_21603":59843,"_5":14870,"_28376":59463,"_3083":59844},[],"Set `insecure_skip_verify` to `false`",{"_3632":2843,"_31184":2715,"_21603":59846,"_5":14870,"_28376":59463,"_3083":59531},[],{"_3632":2844,"_31184":2715,"_21603":59848,"_5":14870,"_28376":59463,"_3083":59849},[],"Scripts and consoles that edit DMSs through the API",{"_3632":2845,"_31184":2715,"_21603":59851,"_5":14870,"_28376":59463,"_3083":59852},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3632":2846,"_31184":2715,"_21603":59854,"_5":14870,"_28376":59463,"_3083":59855},[],"Read the DMS before editing and use the new field",{"_3632":2847,"_31184":2715,"_21603":59857,"_5":14870,"_28376":59463,"_3083":59535},[],{"_3632":2848,"_31184":2715,"_21603":59859,"_5":14870,"_28376":59463,"_3083":59860},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3632":2849,"_31184":2715,"_21603":59862,"_5":14870,"_28376":59463,"_3083":59863},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3632":2850,"_31184":2715,"_21603":59865,"_5":14870,"_28376":59463,"_3083":59866},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3632":2851,"_31184":2715,"_21603":59868,"_5":14870,"_28376":59463,"_3083":59555},[],{"_3632":2852,"_31184":2715,"_21603":59870,"_5":14870,"_28376":59463,"_3083":59871},[],"Clients that create or update CRL settings through the API",{"_3632":2853,"_31184":2715,"_21603":59873,"_5":14870,"_28376":59463,"_3083":59874},[],"Medium: requests with the old field return an error",{"_3632":2854,"_31184":2715,"_21603":59876,"_5":14870,"_28376":59463,"_3083":59877},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3632":2855,"_31184":2715,"_21603":59879,"_5":14870,"_28376":59463,"_3083":59563},[],{"_3632":2856,"_31184":2715,"_21603":59881,"_5":14870,"_28376":59463,"_3083":59882},[],"Alert subscriptions and consumers of the VA events",{"_3632":2857,"_31184":2715,"_21603":59884,"_5":14870,"_28376":59463,"_3083":59885},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3632":2858,"_31184":2715,"_21603":59887,"_5":14870,"_28376":59463,"_3083":59888},[],"Review conditions filtering on the old event payload or subject",{"_3632":2859,"_31184":2715,"_21603":59890,"_5":14870,"_28376":59463,"_3083":59567},[],{"_3632":2860,"_31184":2715,"_21603":59892,"_5":14870,"_28376":59463,"_3083":59893},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3632":2861,"_31184":2715,"_21603":59895,"_5":14870,"_28376":59463,"_3083":59896},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3632":2862,"_31184":2715,"_21603":59898,"_5":14870,"_28376":59463,"_3083":59899},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3632":2863,"_31184":2715,"_21603":59901,"_5":14870,"_28376":59463,"_3083":59551},[],{"_3632":2864,"_31184":2715,"_21603":59903,"_5":14870,"_28376":59463,"_3083":59904},[],"Consumers that read the device `events` field",{"_3632":2865,"_31184":2715,"_21603":59906,"_5":14870,"_28376":59463,"_3083":59907},[],"Medium: the field disappears",{"_3632":2866,"_31184":2715,"_21603":59909,"_5":14870,"_28376":59463,"_3083":59910},[],"Use the new event endpoints",{"_3632":2867,"_31184":2715,"_21603":59912,"_5":14870,"_28376":59463,"_3083":59578},[],{"_3632":2868,"_31184":2715,"_21603":59914,"_5":14870,"_28376":59463,"_3083":59915},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3632":2869,"_31184":2715,"_21603":59917,"_5":14870,"_28376":59463,"_3083":59918},[],"Medium: the VA migration aborts",{"_3632":2870,"_31184":2715,"_21603":59920,"_5":14870,"_28376":59463,"_3083":59921},[],"Fix the affected roles before upgrading",{"_3632":2871,"_31184":2715,"_21603":59923,"_5":14870,"_28376":59463,"_3083":59499},[],{"_3632":2872,"_31184":2715,"_21603":59925,"_5":14870,"_28376":59463,"_3083":59926},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3632":2873,"_31184":2715,"_21603":59928,"_5":14870,"_28376":59463,"_3083":59929},[],"Low to medium: validation errors or changed defaults",{"_3632":2874,"_31184":2715,"_21603":59931,"_5":14870,"_28376":59463,"_3083":59932},[],"Update the values file",{"_3632":2875,"_31184":2715,"_21603":59934,"_5":14870,"_28376":59463,"_3083":59543},[],{"_3632":2876,"_31184":2715,"_21603":59936,"_5":14870,"_28376":59463,"_3083":59937},[],"Clients that send the DMS ID in the update body",{"_3632":2877,"_31184":2715,"_21603":59939,"_5":14870,"_28376":59463,"_3083":59940},[],"Low: the ID in the URL wins",{"_3632":2878,"_31184":2715,"_21603":59942,"_5":14870,"_28376":59463,"_3083":59943},[],"Send the ID in the URL",{"_3632":2879,"_31184":2715,"_21603":59945,"_5":14870,"_28376":59463,"_3083":59571},[],{"_3632":2880,"_31184":2715,"_21603":59947,"_5":14870,"_28376":59463,"_3083":59948},[],"Clients that send an `id` when creating or importing CAs",{"_3632":2881,"_31184":2715,"_21603":59950,"_5":14870,"_28376":59463,"_3083":59951},[],"Low: the ID in the body is ignored, and the field is removed",{"_3632":2882,"_31184":2715,"_21603":59953,"_5":14870,"_28376":59463,"_3083":59954},[],"Let the backend assign the ID and use the returned one",{"_3632":2883,"_31184":2715,"_21603":59956,"_5":14870,"_28376":59463,"_3083":59567},[],{"_3632":2884,"_31184":2715,"_21603":59958,"_5":14870,"_28376":59463,"_3083":59959},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3632":2885,"_31184":2715,"_21603":59961,"_5":14870,"_28376":59463,"_3083":59962},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3632":2886,"_31184":2715,"_21603":59964,"_5":14870,"_28376":59463,"_3083":59965},[],"Use the KMS `sign` and `verify` operations",{"_3632":2887,"_31184":2715,"_21603":59967,"_5":14870,"_28376":59463,"_3083":59547},[],{"_3632":2888,"_31184":2715,"_21603":59969,"_5":14870,"_28376":59463,"_3083":59970},[],"Consumers that match on certificate `type`",{"_3632":2889,"_31184":2715,"_21603":59972,"_5":14870,"_28376":59463,"_3083":59973},[],"Low: two values are renamed",{"_3632":2890,"_31184":2715,"_21603":59975,"_5":14870,"_28376":59463,"_3083":59976},[],"Adapt consumers",{"_3632":2891,"_31184":2715,"_21603":59978,"_5":14870,"_28376":59463,"_3083":59539},[],{"_3632":2892,"_31184":2715,"_21603":59980,"_5":14870,"_28376":59463,"_3083":59981},[],"Any DMS",{"_3632":2893,"_31184":2715,"_21603":59983,"_5":14870,"_28376":59463,"_3083":59984},[],"Low: informational",{"_3632":2894,"_31184":2715,"_21603":59986,"_5":14870,"_28376":59463,"_3083":59987},[],"Read both blocks before editing",{"_3632":2895,"_31184":2715,"_21603":59989,"_5":14870,"_28376":59471,"_3083":59990},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3632":2896,"_31184":2715,"_21603":59992,"_5":14870,"_28376":59471,"_3083":59993},[],"Step 4 of the migration guide copies the data.",{"_3632":2897,"_31184":2715,"_21603":59995,"_5":14870,"_28376":59475,"_3083":59996},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3632":2898,"_31184":2715,"_21603":59998,"_5":14870,"_28376":59479,"_3083":59999},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3632":2899,"_31184":2715,"_21603":60001,"_5":14870,"_28376":59479,"_3083":60002},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3632":2900,"_31184":2715,"_21603":60004,"_5":14870,"_28376":59482,"_3083":60005},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3632":2901,"_31184":2715,"_21603":60007,"_5":14870,"_28376":59486,"_3083":60008},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3632":2902,"_31184":2715,"_21603":60010,"_5":14870,"_28376":59490,"_3083":60011},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3632":2903,"_31184":2715,"_21603":60013,"_5":14870,"_28376":59490,"_3083":60014},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3632":2904,"_31184":2715,"_21603":60016,"_5":14870,"_28376":59490,"_3083":60017},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3632":2905,"_31184":2715,"_21603":60019,"_5":14870,"_28376":59494,"_3083":60020},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3632":2906,"_31184":2715,"_21603":60022,"_5":14870,"_28376":59498,"_3083":60023},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3632":2907,"_31184":2715,"_21603":60025,"_5":14870,"_28376":59498,"_3083":60026},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3632":2908,"_31184":2715,"_21603":60028,"_5":14870,"_28376":59498,"_3083":60029},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3632":2909,"_31184":2715,"_21603":60031,"_5":14870,"_28376":59498,"_3083":60032},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3632":2910,"_31184":2715,"_21603":60034,"_5":14870,"_28376":59498,"_3083":60035},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3632":2911,"_31184":2715,"_21603":60037,"_5":14870,"_28376":59498,"_3083":60038},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3632":2912,"_31184":2715,"_21603":60040,"_5":14870,"_28376":59506,"_3083":60041},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3632":2913,"_31184":2715,"_21603":60043,"_5":14870,"_28376":59506,"_3083":60044},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3632":2914,"_31184":2715,"_21603":60046,"_5":14870,"_28376":59506,"_3083":60047},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3632":2915,"_31184":2715,"_21603":60049,"_5":14870,"_28376":59506,"_3083":60050},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3632":2916,"_31184":2715,"_21603":60052,"_5":14870,"_28376":59506,"_3083":60053},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3632":2917,"_31184":2715,"_21603":60055,"_5":14870,"_28376":59510,"_3083":60056},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3632":2918,"_31184":2715,"_21603":60058,"_5":14870,"_28376":59514,"_3083":60059},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3632":2919,"_31184":2715,"_21603":60061,"_5":14870,"_28376":59514,"_3083":60062},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3632":2920,"_31184":2715,"_21603":60064,"_5":14870,"_28376":59514,"_3083":60065},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3632":2921,"_31184":2715,"_21603":60067,"_5":14870,"_28376":59514,"_3083":60068},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3632":2922,"_31184":2715,"_21603":60070,"_5":14870,"_28376":59514,"_3083":60071},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3632":2923,"_31184":2715,"_21603":60073,"_5":14870,"_28376":59514,"_3083":60074},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3632":2924,"_31184":2715,"_21603":60076,"_5":14870,"_28376":59514,"_3083":60077},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3632":2925,"_31184":2715,"_21603":60079,"_5":14870,"_28376":59514,"_3083":60080},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3632":2926,"_31184":2715,"_21603":60082,"_5":14870,"_28376":59518,"_3083":60083},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3632":2927,"_31184":2715,"_21603":60085,"_5":14870,"_28376":59526,"_3083":60086},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3632":2928,"_31184":2715,"_21603":60088,"_5":14870,"_28376":59526,"_3083":60089},[],"Field in 3.8.0",{"_3632":2929,"_31184":2715,"_21603":60091,"_5":14870,"_28376":59526,"_3083":60092},[],"Field in 4.0.0",{"_3632":2930,"_31184":2715,"_21603":60094,"_5":14870,"_28376":59526,"_3083":60095},[],"`validate_server_cert`",{"_3632":2931,"_31184":2715,"_21603":60097,"_5":14870,"_28376":59526,"_3083":60098},[],"`insecure_skip_verify` (value negated)",{"_3632":2932,"_31184":2715,"_21603":60100,"_5":14870,"_28376":59526,"_3083":60101},[],"`oidc`",{"_3632":2933,"_31184":2715,"_21603":60103,"_5":14870,"_28376":59526,"_3083":60104},[],"`jwt_options`",{"_3632":2934,"_31184":2715,"_21603":60106,"_5":14870,"_28376":59526,"_3083":60107},[],"`apikey`",{"_3632":2935,"_31184":2715,"_21603":60109,"_5":14870,"_28376":59526,"_3083":60110},[],"`apikey_options`",{"_3632":2936,"_31184":2715,"_21603":60112,"_5":14870,"_28376":59526,"_3083":60113},[],"`mtls`",{"_3632":2937,"_31184":2715,"_21603":60115,"_5":14870,"_28376":59526,"_3083":60116},[],"`mtls_options`",{"_3632":2938,"_31184":2715,"_21603":60118,"_5":14870,"_28376":59526,"_3083":60119},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3632":2939,"_31184":2715,"_21603":60121,"_5":14870,"_28376":59526,"_3083":60122},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3632":2940,"_31184":2715,"_21603":60124,"_5":14870,"_28376":59526,"_3083":60125},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3632":2941,"_31184":2715,"_21603":60127,"_5":14870,"_28376":59530,"_3083":60128},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3632":2942,"_31184":2715,"_21603":60130,"_5":14870,"_28376":59530,"_3083":60131},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3632":2943,"_31184":2715,"_21603":60133,"_5":14870,"_28376":59530,"_3083":60134},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3632":2944,"_31184":2715,"_21603":60136,"_5":14870,"_28376":59534,"_3083":60137},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3632":2945,"_31184":2715,"_21603":60139,"_5":14870,"_28376":59534,"_3083":60140},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3632":2946,"_31184":2715,"_21603":60142,"_5":14870,"_28376":59538,"_3083":60143},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3632":2947,"_31184":2715,"_21603":60145,"_5":14870,"_28376":59542,"_3083":60146},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3632":2948,"_31184":2715,"_21603":60148,"_5":14870,"_28376":59546,"_3083":60149},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3632":2949,"_31184":2715,"_21603":60151,"_5":14870,"_28376":59550,"_3083":60152},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3632":2950,"_31184":2715,"_21603":60154,"_5":14870,"_28376":59550,"_3083":60155},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3632":2951,"_31184":2715,"_21603":60157,"_5":14870,"_28376":59550,"_3083":60158},[],"`POST /v1/devices/:id/events` creates an event.",{"_3632":2952,"_31184":2715,"_21603":60160,"_5":14870,"_28376":59550,"_3083":60161},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3632":2953,"_31184":2715,"_21603":60163,"_5":14870,"_28376":59554,"_3083":60164},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3632":2954,"_31184":2715,"_21603":60166,"_5":14870,"_28376":59558,"_3083":60167},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3632":2955,"_31184":2715,"_21603":60169,"_5":14870,"_28376":59558,"_3083":60170},[],"Route",{"_3632":2956,"_31184":2715,"_21603":60172,"_5":14870,"_28376":59558,"_3083":54445},[],{"_3632":2957,"_31184":2715,"_21603":60174,"_5":14870,"_28376":59558,"_3083":60175},[],"`GET /v1/crl-settings`",{"_3632":2958,"_31184":2715,"_21603":60177,"_5":14870,"_28376":59558,"_3083":60178},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3632":2959,"_31184":2715,"_21603":60180,"_5":14870,"_28376":59558,"_3083":60181},[],"`GET /v1/crl-settings/{ca-id}`",{"_3632":2960,"_31184":2715,"_21603":60183,"_5":14870,"_28376":59558,"_3083":60184},[],"Reads the settings of a CA.",{"_3632":2961,"_31184":2715,"_21603":60186,"_5":14870,"_28376":59558,"_3083":60187},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3632":2962,"_31184":2715,"_21603":60189,"_5":14870,"_28376":59558,"_3083":60190},[],"Replaces `crl_options`.",{"_3632":2963,"_31184":2715,"_21603":60192,"_5":14870,"_28376":59558,"_3083":60193},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3632":2964,"_31184":2715,"_21603":60195,"_5":14870,"_28376":59558,"_3083":60196},[],"Removes the archived settings of a CA.",{"_3632":2965,"_31184":2715,"_21603":60198,"_5":14870,"_28376":59558,"_3083":60199},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3632":2966,"_31184":2715,"_21603":60201,"_5":14870,"_28376":59558,"_3083":60202},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3632":2967,"_31184":2715,"_21603":60204,"_5":14870,"_28376":59558,"_3083":60205},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3632":2968,"_31184":2715,"_21603":60207,"_5":14870,"_28376":59558,"_3083":60208},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3632":2969,"_31184":2715,"_21603":60210,"_5":14870,"_28376":59558,"_3083":60211},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3632":2970,"_31184":2715,"_21603":60213,"_5":14870,"_28376":59558,"_3083":60214},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3632":2971,"_31184":2715,"_21603":60216,"_5":14870,"_28376":59558,"_3083":60217},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3632":2972,"_31184":2715,"_21603":60219,"_5":14870,"_28376":59558,"_3083":60220},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3632":2973,"_31184":2715,"_21603":60222,"_5":14870,"_28376":59558,"_3083":60223},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3632":2974,"_31184":2715,"_21603":60225,"_5":14870,"_28376":59558,"_3083":60226},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3632":2975,"_31184":2715,"_21603":60228,"_5":14870,"_28376":59558,"_3083":60229},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3632":2976,"_31184":2715,"_21603":60231,"_5":14870,"_28376":59562,"_3083":60232},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3632":2977,"_31184":2715,"_21603":60234,"_5":14870,"_28376":59566,"_3083":60235},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3632":2978,"_31184":2715,"_21603":60237,"_5":14870,"_28376":59570,"_3083":60238},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3632":2979,"_31184":2715,"_21603":60240,"_5":14870,"_28376":59574,"_3083":60241},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3632":2980,"_31184":2715,"_21603":60243,"_5":14870,"_28376":59574,"_3083":60244},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3632":2981,"_31184":2715,"_21603":60246,"_5":14870,"_28376":59577,"_3083":60247},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3632":2982,"_31184":2715,"_21603":60249,"_5":14870,"_28376":59581,"_3083":60250},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3632":2983,"_31184":2715,"_21603":60252,"_5":14870,"_28376":59585,"_3083":60253},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3632":2984,"_31184":2715,"_21603":60255,"_5":14870,"_28376":59585,"_3083":60256},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3632":2985,"_31184":2715,"_21603":60258,"_5":14870,"_28376":59585,"_3083":60259},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3632":2986,"_31184":2715,"_21603":60261,"_5":14870,"_28376":59585,"_3083":60262},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3632":2987,"_31184":2715,"_21603":60264,"_5":14870,"_28376":59585,"_3083":60265},[],"Record the names of your local-storage PVCs:",{"_3632":2988,"_31184":2715,"_21603":60267,"_5":14870,"_28376":59585,"_3083":60268},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3632":2989,"_31184":2715,"_21603":60270,"_5":14870,"_28376":59589,"_3083":60271},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3632":2990,"_31184":2715,"_21603":60273,"_5":14870,"_28376":59589,"_3083":60274},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3632":2991,"_31184":2715,"_21603":60276,"_5":14870,"_28376":59589,"_3083":60277},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3632":2992,"_31184":2715,"_21603":60279,"_5":14870,"_28376":59589,"_3083":60280},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3632":2993,"_31184":2715,"_21603":60282,"_5":14870,"_28376":59589,"_3083":60283},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3632":2994,"_31184":2715,"_21603":60285,"_5":14870,"_28376":59593,"_3083":60286},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3632":2995,"_31184":2715,"_21603":60288,"_5":14870,"_28376":59593,"_3083":60289},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3632":2996,"_31184":2715,"_21603":60291,"_5":14870,"_28376":59593,"_3083":60292},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3632":2997,"_31184":2715,"_21603":60294,"_5":14870,"_28376":59593,"_3083":60295},[],"Secret (`existingSecret`)",{"_3632":2998,"_31184":2715,"_21603":60297,"_5":14870,"_28376":59593,"_3083":60298},[],"Required data keys",{"_3632":2999,"_31184":2715,"_21603":60300,"_5":14870,"_28376":59593,"_3083":60301},[],"When",{"_3632":3000,"_31184":2715,"_21603":60303,"_5":14870,"_28376":59593,"_3083":60304},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3632":3001,"_31184":2715,"_21603":60306,"_5":14870,"_28376":59593,"_3083":60307},[],"`username`, `password`",{"_3632":3002,"_31184":2715,"_21603":60309,"_5":14870,"_28376":59593,"_3083":60310},[],"Always",{"_3632":3003,"_31184":2715,"_21603":60312,"_5":14870,"_28376":59593,"_3083":60313},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3632":3004,"_31184":2715,"_21603":60315,"_5":14870,"_28376":59593,"_3083":60307},[],{"_3632":3005,"_31184":2715,"_21603":60317,"_5":14870,"_28376":59593,"_3083":60310},[],{"_3632":3006,"_31184":2715,"_21603":60319,"_5":14870,"_28376":59593,"_3083":60320},[],"`services.alerts.smtp_server.existingSecret`",{"_3632":3007,"_31184":2715,"_21603":60322,"_5":14870,"_28376":59593,"_3083":60307},[],{"_3632":3008,"_31184":2715,"_21603":60324,"_5":14870,"_28376":59593,"_3083":60325},[],"Only when SMTP authentication is enabled",{"_3632":3009,"_31184":2715,"_21603":60327,"_5":14870,"_28376":59593,"_3083":60328},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3632":3010,"_31184":2715,"_21603":60330,"_5":14870,"_28376":59593,"_3083":60331},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3632":3011,"_31184":2715,"_21603":60333,"_5":14870,"_28376":59593,"_3083":60334},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3632":3012,"_31184":2715,"_21603":60336,"_5":14870,"_28376":59593,"_3083":60337},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3632":3013,"_31184":2715,"_21603":60339,"_5":14870,"_28376":59593,"_3083":60340},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3632":3014,"_31184":2715,"_21603":60342,"_5":14870,"_28376":59593,"_3083":60343},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3632":3015,"_31184":2715,"_21603":60345,"_5":14870,"_28376":59593,"_3083":60346},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3632":3016,"_31184":2715,"_21603":60348,"_5":14870,"_28376":59593,"_3083":60349},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3632":3017,"_31184":2715,"_21603":60351,"_5":14870,"_28376":59593,"_3083":60352},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3632":3018,"_31184":2715,"_21603":60354,"_5":14870,"_28376":59593,"_3083":60355},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3632":3019,"_31184":2715,"_21603":60357,"_5":14870,"_28376":59593,"_3083":60358},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3632":3020,"_31184":2715,"_21603":60360,"_5":14870,"_28376":59593,"_3083":60361},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3632":3021,"_31184":2715,"_21603":60363,"_5":14870,"_28376":59593,"_3083":60364},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3632":3022,"_31184":2715,"_21603":60366,"_5":14870,"_28376":59593,"_3083":60367},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3632":3023,"_31184":2715,"_21603":60369,"_5":14870,"_28376":59593,"_3083":60370},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3632":3024,"_31184":2715,"_21603":60372,"_5":14870,"_28376":59597,"_3083":60373},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3632":3025,"_31184":2715,"_21603":60375,"_5":14870,"_28376":59597,"_3083":60376},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3632":3026,"_31184":2715,"_21603":60378,"_5":14870,"_28376":59601,"_3083":60379},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3632":3027,"_31184":2715,"_21603":60381,"_5":14870,"_28376":59601,"_3083":60382},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3632":3028,"_31184":2715,"_21603":60384,"_5":14870,"_28376":59601,"_3083":60385},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3632":3029,"_31184":2715,"_21603":60387,"_5":14870,"_28376":59601,"_3083":60388},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3632":3030,"_31184":2715,"_21603":60390,"_5":14870,"_28376":59601,"_3083":60391},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3632":3031,"_31184":2715,"_21603":60393,"_5":14870,"_28376":59601,"_3083":60394},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3632":3032,"_31184":2715,"_21603":60396,"_5":14870,"_28376":59601,"_3083":60397},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3632":3033,"_31184":2715,"_21603":60399,"_5":14870,"_28376":59601,"_3083":60400},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3632":3034,"_31184":2715,"_21603":60402,"_5":14870,"_28376":59601,"_3083":60403},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3632":3035,"_31184":2715,"_21603":60405,"_5":14870,"_28376":59601,"_3083":60406},[],"**Remove the helper and restore the recorded replica counts:**",{"_3632":3036,"_31184":2715,"_21603":60408,"_5":14870,"_28376":59601,"_3083":60409},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3632":3037,"_31184":2715,"_21603":60411,"_5":14870,"_28376":59605,"_3083":60412},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3632":3038,"_31184":2715,"_21603":60414,"_5":14870,"_28376":59605,"_3083":60415},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3632":3039,"_31184":2715,"_21603":60417,"_5":14870,"_28376":59609,"_3083":60418},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3632":3040,"_31184":2715,"_21603":60420,"_5":14870,"_28376":59609,"_3083":60421},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3632":3041,"_31184":2715,"_21603":60423,"_5":14870,"_28376":59609,"_3083":60424},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3632":3042,"_31184":2715,"_21603":60426,"_5":14870,"_28376":59609,"_3083":60427},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3632":3043,"_31184":2715,"_21603":60429,"_5":14870,"_28376":59609,"_3083":60430},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3632":3044,"_31184":2715,"_21603":60432,"_5":14870,"_28376":59609,"_3083":60433},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3632":3045,"_31184":2715,"_21603":60435,"_5":14870,"_28376":59609,"_3083":60436},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3632":3046,"_31184":2715,"_21603":60438,"_5":14870,"_28376":59609,"_3083":60439},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3632":3047,"_31184":2715,"_21603":60441,"_5":14870,"_28376":59613,"_3083":60442},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3632":3048,"_31184":2715,"_21603":60444,"_5":14870,"_28376":59613,"_3083":60445},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3632":3049,"_31184":2715,"_21603":60447,"_5":14870,"_28376":59613,"_3083":60448},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3632":3050,"_31184":2715,"_21603":60450,"_5":14870,"_28376":59613,"_3083":60451},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3632":3051,"_31184":2715,"_21603":60453,"_5":14870,"_28376":59613,"_3083":60454},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3632":3052,"_31184":2715,"_21603":60456,"_5":14870,"_28376":59613,"_3083":60457},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3632":3053,"_31184":2715,"_21603":60459,"_5":14870,"_28376":59613,"_3083":60460},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3632":3054,"_31184":2715,"_21603":60462,"_5":14870,"_28376":59613,"_3083":60463},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3632":3055,"_31184":2715,"_21603":60465,"_5":14870,"_28376":59613,"_3083":60466},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3632":3056,"_31184":2715,"_21603":60468,"_5":14870,"_28376":59613,"_3083":60469},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3632":3057,"_31184":2715,"_21603":60471,"_5":14870,"_28376":59613,"_3083":60472},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3632":3058,"_31184":2715,"_21603":60474,"_5":14870,"_28376":59616,"_3083":60475},[],"After the upgrade, check in this order:",{"_3632":3059,"_31184":2715,"_21603":60477,"_5":14870,"_28376":59616,"_3083":60478},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3632":3060,"_31184":2715,"_21603":60480,"_5":14870,"_28376":59616,"_3083":60481},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3632":3061,"_31184":2715,"_21603":60483,"_5":14870,"_28376":59616,"_3083":60484},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3632":3062,"_31184":2715,"_21603":60486,"_5":14870,"_28376":59616,"_3083":60487},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3632":3063,"_31184":2715,"_21603":60489,"_5":14870,"_28376":59616,"_3083":60490},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3632":3064,"_31184":2715,"_21603":60492,"_5":14870,"_28376":59616,"_3083":60493},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3632":3065,"_31184":2715,"_21603":60495,"_5":14870,"_28376":59616,"_3083":60496},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3632":3066,"_31184":2715,"_21603":60498,"_5":14870,"_28376":59616,"_3083":60499},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3632":3067,"_31184":2715,"_21603":60501,"_5":14870,"_28376":59616,"_3083":60502},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3632":3068,"_31184":2715,"_21603":60504,"_5":14870,"_28376":59616,"_3083":60505},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3632":3069,"_31184":2715,"_21603":60507,"_5":14870,"_28376":59616,"_3083":60508},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3632":3070,"_31184":2715,"_21603":60510,"_5":14870,"_28376":59616,"_3083":60511},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3632":3071,"_31184":2715,"_21603":60513,"_5":14870,"_28376":59616,"_3083":60514},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3632":3072,"_31184":2715,"_21603":60516,"_5":14870,"_28376":59616,"_3083":60517},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3632":3073,"_31184":2715,"_21603":60519,"_5":14870,"_28376":59616,"_3083":60520},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3632":3074,"_31184":2715,"_21603":60522,"_5":14870,"_28376":59620,"_3083":60523},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3632":3075,"_31184":2715,"_21603":60525,"_5":14870,"_28376":59620,"_3083":60526},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3632":3076,"_31184":2715,"_21603":60528,"_5":14870,"_28376":59620,"_3083":60529},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3632":3077,"_31184":2715,"_21603":60531,"_5":14870,"_28376":59620,"_3083":60532},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3632":3078,"_31184":2715,"_21603":60534,"_5":14870,"_28376":59620,"_3083":60535},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60538":60539,"_60540":60541,"_60542":60543,"_60544":60545,"_18740":3118,"_72815":3118},"language","english","sortableProperties",[3083,31184,5,28376],"sortablePropertiesWithTypes",{"_3083":25790,"_31184":25790,"_5":25790,"_28376":25790},"sorts",{"_3083":60546,"_31184":63614,"_5":66681,"_28376":69748},{"_4836":60547,"_60548":60549,"_5":25790},{"_14951":3395,"_15330":16335,"_15349":3251,"_30184":4039,"_15336":4244,"_20515":12885,"_14972":7026,"_14979":7921,"_30126":4173,"_30534":6256,"_30561":3501,"_30160":7496,"_35600":3339,"_30263":7823,"_30605":5631,"_35607":15401,"_35610":5354,"_35613":4615,"_35616":13569,"_31007":5152,"_35621":3382,"_35623":7244,"_31042":4766,"_15345":18765,"_35627":4809,"_35630":4550,"_35632":6446,"_30589":20076,"_31027":3255,"_31055":5192,"_35637":15388,"_35639":15000,"_35641":6989,"_30274":3184,"_35644":5355,"_35646":8510,"_35648":20816,"_35650":3813,"_35652":6236,"_30197":7288,"_35655":4040,"_35657":20614,"_30191":7256,"_30626":6793,"_35661":3923,"_35663":3924,"_35666":11029,"_30237":4571,"_35670":5165,"_30117":3565,"_35673":4580,"_30165":20109,"_35676":5298,"_35678":7919,"_35681":20868,"_15339":7867,"_35684":3592,"_35686":12260,"_35689":6065,"_35691":3567,"_35693":14523,"_35695":7295,"_35697":13855,"_20518":5385,"_35700":20815,"_35702":3336,"_30138":7945,"_30583":5386,"_35706":3408,"_35708":4783,"_35710":15209,"_31071":6545,"_35713":5337,"_35715":4150,"_31249":7882,"_31164":4582,"_30642":7393,"_35720":6052,"_35722":26196,"_30175":5474,"_35725":3208,"_35727":4086,"_35729":21239,"_31087":6207,"_30257":3399,"_29637":6082,"_35734":10661,"_35736":4418,"_35738":6750,"_30300":9015,"_35742":19143,"_30577":7345,"_35746":7395,"_35748":4494,"_35750":18370,"_35752":7312,"_35754":7588,"_35756":3357,"_30289":3634,"_30539":29485,"_35760":4247,"_35762":4947,"_35764":20781,"_35767":3541,"_35769":7864,"_35771":4005,"_35773":23817,"_35775":11713,"_35777":16288,"_35779":19053,"_35782":3425,"_35784":7394,"_35786":25795,"_35788":7960,"_35790":4084,"_35793":3792,"_35795":4588,"_35798":5158,"_35801":25150,"_35803":3500,"_35805":19776,"_35807":10834,"_35809":5137,"_35811":50986,"_35813":3825,"_35815":4137,"_35817":3801,"_30588":15411,"_35820":4892,"_35822":3803,"_35824":8689,"_35826":6039,"_35828":3268,"_35830":7798,"_35832":5136,"_35834":7841,"_35836":13740,"_35838":7833,"_35840":3496,"_35842":3492,"_35844":4135,"_35846":11619,"_35848":10524,"_35850":7430,"_35852":6169,"_35854":10857,"_35856":4864,"_35858":3120,"_35860":5778,"_35862":6538,"_35864":7186,"_35866":10832,"_35868":5224,"_35870":14796,"_35872":8334,"_35874":4138,"_35876":9925,"_35878":7267,"_35880":4136,"_35882":22377,"_35884":4640,"_35886":6038,"_35888":25792,"_35890":5750,"_35892":5184,"_35894":20779,"_35896":4795,"_30582":7197,"_35899":8688,"_35901":5777,"_35903":4891,"_35905":7834,"_35907":6489,"_35909":25794,"_35912":4863,"_35914":7301,"_35916":6636,"_35918":7677,"_35920":4192,"_35922":5135,"_35924":7346,"_35926":8442,"_35928":26197,"_35930":9244,"_35932":5755,"_35934":5754,"_35936":5753,"_35938":5659,"_35940":5537,"_35942":7353,"_35944":4940,"_30576":23045,"_35947":3279,"_35949":6444,"_35952":14741,"_35955":3174,"_35957":11373,"_35959":7981,"_35962":6850,"_31022":30087,"_35965":7270,"_35967":8880,"_35969":3252,"_31012":4352,"_35972":6180,"_35974":6553,"_35976":10094,"_35978":7223,"_35980":7564,"_35982":7214,"_35984":14175,"_35986":6747,"_35988":5045,"_35990":5905,"_35992":6674,"_35994":3287,"_35996":4985,"_35998":3337,"_36000":25599,"_36002":4155,"_36004":5348,"_36006":4443,"_36008":7218,"_31037":5268,"_36011":6813,"_36013":20825,"_36015":12909,"_36017":7240,"_36019":5751,"_36022":3312,"_36024":3404,"_36027":3441,"_36029":14914,"_36032":24611,"_36035":7988,"_36037":5312,"_36039":7707,"_36042":5345,"_36045":3368,"_36047":5353,"_36050":6064,"_36052":23409,"_36054":15405,"_36056":4206,"_36059":7349,"_36061":6867,"_36064":3346,"_36067":4251,"_36069":10833,"_36072":3536,"_36074":3175,"_36076":6394,"_36078":7961,"_36080":5433,"_36082":16447,"_31032":5270,"_36085":3180,"_36088":7328,"_36090":16956,"_36092":5544,"_36095":11999,"_36097":7874,"_36099":4909,"_36101":4903,"_36103":4095,"_36105":3278,"_36107":4994,"_36109":7281,"_36111":6761,"_36113":6703,"_36115":6079,"_36117":7905,"_36119":9272,"_36121":8283,"_36123":11715,"_36125":5643,"_36127":3480,"_36129":4987,"_36131":16317,