952,50953],"Docs","Deployment","Other models",[],{"_3627":16,"_31174":15,"_21594":50956,"_5":14861,"_28366":15,"_3078":50957},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3627":17,"_31174":15,"_5":31530,"_21594":50959,"_28366":50960,"_3078":50961},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3627":18,"_31174":15,"_5":31530,"_21594":50963,"_28366":50964,"_3078":50965},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3627":19,"_31174":15,"_5":31530,"_21594":50967,"_28366":50968,"_3078":50969},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3627":20,"_31174":15,"_5":31530,"_21594":50971,"_28366":50972,"_3078":50973},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3627":21,"_31174":15,"_5":31530,"_21594":50975,"_28366":50976,"_3078":50977},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3627":22,"_31174":15,"_5":31530,"_21594":50979,"_28366":50980,"_3078":50981},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3627":23,"_31174":15,"_5":31530,"_21594":50983,"_28366":50984,"_3078":50985},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#next-step","Next step",{"_3627":24,"_31174":15,"_21594":50987,"_5":14861,"_28366":15,"_3078":50988},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3627":25,"_31174":15,"_21594":50990,"_5":14861,"_28366":50960,"_3078":50991},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3627":26,"_31174":15,"_21594":50993,"_5":14861,"_28366":50960,"_3078":50994},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3627":27,"_31174":15,"_21594":50996,"_5":14861,"_28366":50960,"_3078":50997},[],"A security group allowing the necessary endpoints.",{"_3627":28,"_31174":15,"_21594":50999,"_5":14861,"_28366":50964,"_3078":51000},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3627":29,"_31174":15,"_21594":51002,"_5":14861,"_28366":50964,"_3078":51003},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3627":30,"_31174":15,"_21594":51005,"_5":14861,"_28366":50964,"_3078":51006},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3627":31,"_31174":15,"_21594":51008,"_5":14861,"_28366":50968,"_3078":51009},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3627":32,"_31174":15,"_21594":51011,"_5":14861,"_28366":50972,"_3078":51012},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3627":33,"_31174":15,"_21594":51014,"_5":14861,"_28366":50976,"_3078":51015},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3627":34,"_31174":15,"_21594":51017,"_5":14861,"_28366":50980,"_3078":51018},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3627":35,"_31174":15,"_21594":51020,"_5":14861,"_28366":50984,"_3078":51021},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3627":36,"_31174":36,"_5":15221,"_3078":51023,"_31533":51024,"_21594":51025,"_28366":36},"Deploy Lamassu",[50951,50952],[],{"_3627":37,"_31174":36,"_21594":51027,"_5":14861,"_28366":36,"_3078":51028},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3627":38,"_31174":36,"_5":31530,"_21594":51030,"_28366":51031,"_3078":51032},[],"/docs/pr-preview/pr-75/deployment/overview#choose-a-model","Choose a model",{"_3627":39,"_31174":36,"_5":31530,"_21594":51034,"_28366":51035,"_3078":51036},[],"/docs/pr-preview/pr-75/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3627":40,"_31174":36,"_5":31530,"_21594":51038,"_28366":51039,"_3078":51040},[],"/docs/pr-preview/pr-75/deployment/overview#after-deployment","After deployment",{"_3627":41,"_31174":36,"_21594":51042,"_5":14861,"_28366":36,"_3078":51043},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3627":42,"_31174":36,"_21594":51045,"_5":14861,"_28366":51031,"_3078":51046},[],"Model",{"_3627":43,"_31174":36,"_21594":51048,"_5":14861,"_28366":51031,"_3078":51049},[],"Recommended for",{"_3627":44,"_31174":36,"_21594":51051,"_5":14861,"_28366":51031,"_3078":51052},[],"Who operates the infrastructure",{"_3627":45,"_31174":36,"_21594":51054,"_5":14861,"_28366":51031,"_3078":51055},[],"Starting point",{"_3627":46,"_31174":36,"_21594":51057,"_5":14861,"_28366":51031,"_3078":51058},[],"Kubernetes self-managed",{"_3627":47,"_31174":36,"_21594":51060,"_5":14861,"_28366":51031,"_3078":51061},[],"Production, regulated environments and custom deployments",{"_3627":48,"_31174":36,"_21594":51063,"_5":14861,"_28366":51031,"_3078":51064},[],"Your team",{"_3627":49,"_31174":36,"_21594":51066,"_5":14861,"_28366":51031,"_3078":51067},[],"Helm or Fastlane",{"_3627":50,"_31174":36,"_21594":51069,"_5":14861,"_28366":51031,"_3078":51070},[],"AWS Marketplace",{"_3627":51,"_31174":36,"_21594":51072,"_5":14861,"_28366":51031,"_3078":51073},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3627":52,"_31174":36,"_21594":51075,"_5":14861,"_28366":51031,"_3078":51064},[],{"_3627":53,"_31174":36,"_21594":51077,"_5":14861,"_28366":51031,"_3078":51078},[],"Preconfigured image on EC2",{"_3627":54,"_31174":36,"_21594":51080,"_5":14861,"_28366":51031,"_3078":51081},[],"SaaS",{"_3627":55,"_31174":36,"_21594":51083,"_5":14861,"_28366":51031,"_3078":51084},[],"Teams that want to use the platform without operating it",{"_3627":56,"_31174":36,"_21594":51086,"_5":14861,"_28366":51031,"_3078":51087},[],"Lamassu",{"_3627":57,"_31174":36,"_21594":51089,"_5":14861,"_28366":51031,"_3078":51090},[],"Managed subscription",{"_3627":58,"_31174":36,"_21594":51092,"_5":14861,"_28366":51031,"_3078":51093},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3627":59,"_31174":36,"_21594":51095,"_5":14861,"_28366":51031,"_3078":51096},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3627":60,"_31174":36,"_21594":51098,"_5":14861,"_28366":51031,"_3078":51099},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3627":61,"_31174":36,"_21594":51101,"_5":14861,"_28366":51035,"_3078":51102},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3627":62,"_31174":36,"_21594":51104,"_5":14861,"_28366":51039,"_3078":51105},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3627":63,"_31174":63,"_5":15221,"_3078":51107,"_31533":51108,"_21594":51109,"_28366":63},"Use Lamassu as SaaS",[50951,50952,50953],[],{"_3627":64,"_31174":63,"_21594":51111,"_5":14861,"_28366":63,"_3078":51112},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3627":65,"_31174":63,"_5":31530,"_21594":51114,"_28366":51115,"_3078":51116},[],"/docs/pr-preview/pr-75/deployment/saas#what-the-service-manages","What the service manages",{"_3627":66,"_31174":63,"_5":31530,"_21594":51118,"_28366":51119,"_3078":51120},[],"/docs/pr-preview/pr-75/deployment/saas#plans","Plans",{"_3627":67,"_31174":63,"_5":31530,"_21594":51122,"_28366":51123,"_3078":51124},[],"/docs/pr-preview/pr-75/deployment/saas#request-access","Request access",{"_3627":68,"_31174":63,"_21594":51126,"_5":14861,"_28366":63,"_3078":51127},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3627":69,"_31174":63,"_21594":51129,"_5":14861,"_28366":51115,"_3078":51130},[],"Platform availability and maintenance.",{"_3627":70,"_31174":63,"_21594":51132,"_5":14861,"_28366":51115,"_3078":51133},[],"Automatic backups.",{"_3627":71,"_31174":63,"_21594":51135,"_5":14861,"_28366":51115,"_3078":51136},[],"Version upgrades.",{"_3627":72,"_31174":63,"_21594":51138,"_5":14861,"_28366":51115,"_3078":51139},[],"Technical support and SLA according to your plan.",{"_3627":73,"_31174":63,"_21594":51141,"_5":14861,"_28366":51119,"_3078":51142},[],"Plan",{"_3627":74,"_31174":63,"_21594":51144,"_5":14861,"_28366":51119,"_3078":51145},[],"Devices",{"_3627":75,"_31174":63,"_21594":51147,"_5":14861,"_28366":51119,"_3078":51148},[],"Support",{"_3627":76,"_31174":63,"_21594":51150,"_5":14861,"_28366":51119,"_3078":51151},[],"SLA",{"_3627":77,"_31174":63,"_21594":51153,"_5":14861,"_28366":51119,"_3078":51154},[],"Starter",{"_3627":78,"_31174":63,"_21594":51156,"_5":14861,"_28366":51119,"_3078":51157},[],"Up to 1,000",{"_3627":79,"_31174":63,"_21594":51159,"_5":14861,"_28366":51119,"_3078":51160},[],"Email",{"_3627":80,"_31174":63,"_21594":51162,"_5":14861,"_28366":51119,"_3078":51163},[],"99.5 %",{"_3627":81,"_31174":63,"_21594":51165,"_5":14861,"_28366":51119,"_3078":51166},[],"Professional",{"_3627":82,"_31174":63,"_21594":51168,"_5":14861,"_28366":51119,"_3078":51169},[],"Up to 10,000",{"_3627":83,"_31174":63,"_21594":51171,"_5":14861,"_28366":51119,"_3078":51172},[],"Email and chat",{"_3627":84,"_31174":63,"_21594":51174,"_5":14861,"_28366":51119,"_3078":51175},[],"99.9 %",{"_3627":85,"_31174":63,"_21594":51177,"_5":14861,"_28366":51119,"_3078":51178},[],"Enterprise",{"_3627":86,"_31174":63,"_21594":51180,"_5":14861,"_28366":51119,"_3078":51181},[],"Unlimited",{"_3627":87,"_31174":63,"_21594":51183,"_5":14861,"_28366":51119,"_3078":51184},[],"Dedicated",{"_3627":88,"_31174":63,"_21594":51186,"_5":14861,"_28366":51119,"_3078":51187},[],"99.99 %",{"_3627":89,"_31174":63,"_21594":51189,"_5":14861,"_28366":51123,"_3078":51190},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3627":90,"_31174":63,"_21594":51192,"_5":14861,"_28366":51123,"_3078":51193},[],"When you receive your instance's credentials, continue with Get started.",{"_3627":91,"_31174":91,"_5":15221,"_3078":51195,"_31533":51196,"_21594":51197,"_28366":91},"Fastlane",[50951,50952,51058],[],{"_3627":92,"_31174":91,"_21594":51199,"_5":14861,"_28366":91,"_3078":51200},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3627":93,"_31174":91,"_5":31530,"_21594":51202,"_28366":51203,"_3078":51204},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3627":94,"_31174":91,"_5":31530,"_21594":51206,"_28366":51207,"_3078":51208},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3627":95,"_31174":91,"_5":31530,"_21594":51210,"_28366":51211,"_3078":50961},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#before-you-begin",{"_3627":96,"_31174":91,"_5":31530,"_21594":51213,"_28366":51214,"_3078":51215},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3627":97,"_31174":91,"_5":31530,"_21594":51217,"_28366":51218,"_3078":51219},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3627":98,"_31174":91,"_5":31530,"_21594":51221,"_28366":51222,"_3078":51223},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3627":99,"_31174":91,"_5":31530,"_21594":51225,"_28366":51226,"_3078":51227},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3627":100,"_31174":91,"_5":31530,"_21594":51229,"_28366":51230,"_3078":51231},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3627":101,"_31174":91,"_5":31530,"_21594":51233,"_28366":51234,"_3078":51235},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3627":102,"_31174":91,"_5":31530,"_21594":51237,"_28366":51238,"_3078":51239},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3627":103,"_31174":91,"_5":31530,"_21594":51241,"_28366":51242,"_3078":51243},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3627":104,"_31174":91,"_21594":51245,"_5":14861,"_28366":51203,"_3078":51246},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3627":105,"_31174":91,"_21594":51248,"_5":14861,"_28366":51203,"_3078":51249},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3627":106,"_31174":91,"_21594":51251,"_5":14861,"_28366":51207,"_3078":51252},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3627":107,"_31174":91,"_21594":51254,"_5":14861,"_28366":51207,"_3078":51255},[],"Fastlane installs or configures",{"_3627":108,"_31174":91,"_21594":51257,"_5":14861,"_28366":51207,"_3078":51258},[],"You still provide",{"_3627":109,"_31174":91,"_21594":51260,"_5":14861,"_28366":51207,"_3078":51261},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3627":110,"_31174":91,"_21594":51263,"_5":14861,"_28366":51207,"_3078":51264},[],"The Kubernetes cluster, nodes and persistent storage",{"_3627":111,"_31174":91,"_21594":51266,"_5":14861,"_28366":51207,"_3078":51267},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3627":112,"_31174":91,"_21594":51269,"_5":14861,"_28366":51207,"_3078":51270},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3627":113,"_31174":91,"_21594":51272,"_5":14861,"_28366":51207,"_3078":51273},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3627":114,"_31174":91,"_21594":51275,"_5":14861,"_28366":51207,"_3078":51276},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3627":115,"_31174":91,"_21594":51278,"_5":14861,"_28366":51207,"_3078":51279},[],"Optional observability and lab HSM components",{"_3627":116,"_31174":91,"_21594":51281,"_5":14861,"_28366":51207,"_3078":51282},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3627":117,"_31174":91,"_21594":51284,"_5":14861,"_28366":51207,"_3078":51285},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3627":118,"_31174":91,"_21594":51287,"_5":14861,"_28366":51211,"_3078":51288},[],"You need:",{"_3627":119,"_31174":91,"_21594":51290,"_5":14861,"_28366":51211,"_3078":51291},[],"an existing Kubernetes cluster",{"_3627":120,"_31174":91,"_21594":51293,"_5":14861,"_28366":51211,"_3078":51294},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3627":121,"_31174":91,"_21594":51296,"_5":14861,"_28366":51211,"_3078":51297},[],"`yq`",{"_3627":122,"_31174":91,"_21594":51299,"_5":14861,"_28366":51211,"_3078":24406},[],{"_3627":123,"_31174":91,"_21594":51301,"_5":14861,"_28366":51211,"_3078":51302},[],"`jq` only when using `--sample-data` or `--development`",{"_3627":124,"_31174":91,"_21594":51304,"_5":14861,"_28366":51211,"_3078":51305},[],"`ssh-keygen` only when using `--with-hsm`",{"_3627":125,"_31174":91,"_21594":51307,"_5":14861,"_28366":51211,"_3078":51308},[],"free external ports 80 and 443 on a single-node K3s host",{"_3627":126,"_31174":91,"_21594":51310,"_5":14861,"_28366":51211,"_3078":51311},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3627":127,"_31174":91,"_21594":51313,"_5":14861,"_28366":51211,"_3078":51314},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3627":128,"_31174":91,"_21594":51316,"_5":14861,"_28366":51214,"_3078":51317},[],"Run the script from a clone of the Helm repository:",{"_3627":129,"_31174":91,"_21594":51319,"_5":14861,"_28366":51214,"_3078":51320},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3627":130,"_31174":91,"_21594":51322,"_5":14861,"_28366":51218,"_3078":51323},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3627":131,"_31174":91,"_21594":51325,"_5":14861,"_28366":51218,"_3078":51326},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3627":132,"_31174":91,"_21594":51328,"_5":14861,"_28366":51218,"_3078":51329},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3627":133,"_31174":91,"_21594":51331,"_5":14861,"_28366":51218,"_3078":51332},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3627":134,"_31174":91,"_21594":51334,"_5":14861,"_28366":51222,"_3078":51335},[],"Option",{"_3627":135,"_31174":91,"_21594":51337,"_5":14861,"_28366":51222,"_3078":51338},[],"Default",{"_3627":136,"_31174":91,"_21594":51340,"_5":14861,"_28366":51222,"_3078":51341},[],"Purpose",{"_3627":137,"_31174":91,"_21594":51343,"_5":14861,"_28366":51222,"_3078":51344},[],"`-h`, `--help`",{"_3627":138,"_31174":91,"_21594":51346,"_5":14861,"_28366":51222,"_3078":51347},[],"—",{"_3627":139,"_31174":91,"_21594":51349,"_5":14861,"_28366":51222,"_3078":51350},[],"Show help",{"_3627":140,"_31174":91,"_21594":51352,"_5":14861,"_28366":51222,"_3078":51353},[],"`-c`, `--context`",{"_3627":141,"_31174":91,"_21594":51355,"_5":14861,"_28366":51222,"_3078":51356},[],"current context",{"_3627":142,"_31174":91,"_21594":51358,"_5":14861,"_28366":51222,"_3078":51359},[],"Select the kubeconfig context for kubectl and Helm",{"_3627":143,"_31174":91,"_21594":51361,"_5":14861,"_28366":51222,"_3078":51362},[],"`-n`, `--non-interactive`",{"_3627":144,"_31174":91,"_21594":51364,"_5":14861,"_28366":51222,"_3078":6794},[],{"_3627":145,"_31174":91,"_21594":51366,"_5":14861,"_28366":51222,"_3078":51367},[],"Skip prompts and generate dependency credentials",{"_3627":146,"_31174":91,"_21594":51369,"_5":14861,"_28366":51222,"_3078":51370},[],"`-ns`, `--namespace`",{"_3627":147,"_31174":91,"_21594":51372,"_5":14861,"_28366":51222,"_3078":51373},[],"`lamassu-dev`",{"_3627":148,"_31174":91,"_21594":51375,"_5":14861,"_28366":51222,"_3078":51376},[],"Namespace for the installation",{"_3627":149,"_31174":91,"_21594":51378,"_5":14861,"_28366":51222,"_3078":51379},[],"`-d`, `--domain`",{"_3627":150,"_31174":91,"_21594":51381,"_5":14861,"_28366":51222,"_3078":51382},[],"`dev.lamassu.io`",{"_3627":151,"_31174":91,"_21594":51384,"_5":14861,"_28366":51222,"_3078":51385},[],"Domain used by the UI, OIDC and certificate",{"_3627":152,"_31174":91,"_21594":51387,"_5":14861,"_28366":51222,"_3078":51388},[],"`-v`, `--version`",{"_3627":153,"_31174":91,"_21594":51390,"_5":14861,"_28366":51222,"_3078":15573},[],{"_3627":154,"_31174":91,"_21594":51392,"_5":14861,"_28366":51222,"_3078":51393},[],"Lamassu chart version",{"_3627":155,"_31174":91,"_21594":51395,"_5":14861,"_28366":51222,"_3078":51396},[],"`--https-port`",{"_3627":156,"_31174":91,"_21594":51398,"_5":14861,"_28366":51222,"_3078":51399},[],"`443`",{"_3627":157,"_31174":91,"_21594":51401,"_5":14861,"_28366":51222,"_3078":51402},[],"Gateway HTTPS listener port",{"_3627":158,"_31174":91,"_21594":51404,"_5":14861,"_28366":51222,"_3078":51405},[],"`--http-port`",{"_3627":159,"_31174":91,"_21594":51407,"_5":14861,"_28366":51222,"_3078":51408},[],"`80`",{"_3627":160,"_31174":91,"_21594":51410,"_5":14861,"_28366":51222,"_3078":51411},[],"Gateway HTTP listener port",{"_3627":161,"_31174":91,"_21594":51413,"_5":14861,"_28366":51222,"_3078":51414},[],"`--tls-crt`",{"_3627":162,"_31174":91,"_21594":51416,"_5":14861,"_28366":51222,"_3078":51347},[],{"_3627":163,"_31174":91,"_21594":51418,"_5":14861,"_28366":51222,"_3078":51419},[],"PEM certificate for downstream TLS",{"_3627":164,"_31174":91,"_21594":51421,"_5":14861,"_28366":51222,"_3078":51422},[],"`--tls-key`",{"_3627":165,"_31174":91,"_21594":51424,"_5":14861,"_28366":51222,"_3078":51347},[],{"_3627":166,"_31174":91,"_21594":51426,"_5":14861,"_28366":51222,"_3078":51427},[],"PEM private key for downstream TLS",{"_3627":167,"_31174":91,"_21594":51429,"_5":14861,"_28366":51222,"_3078":51430},[],"`-l`, `--local-chart-path`",{"_3627":168,"_31174":91,"_21594":51432,"_5":14861,"_28366":51222,"_3078":51433},[],"repository chart",{"_3627":169,"_31174":91,"_21594":51435,"_5":14861,"_28366":51222,"_3078":51436},[],"Use an unpacked local Lamassu chart",{"_3627":170,"_31174":91,"_21594":51438,"_5":14861,"_28366":51222,"_3078":51439},[],"`-ip`, `--gateway-ip`",{"_3627":171,"_31174":91,"_21594":51441,"_5":14861,"_28366":51222,"_3078":9079},[],{"_3627":172,"_31174":91,"_21594":51443,"_5":14861,"_28366":51222,"_3078":51444},[],"Override the address written to `gateway.addresses`",{"_3627":173,"_31174":91,"_21594":51446,"_5":14861,"_28366":51222,"_3078":51447},[],"`--otel`",{"_3627":174,"_31174":91,"_21594":51449,"_5":14861,"_28366":51222,"_3078":6794},[],{"_3627":175,"_31174":91,"_21594":51451,"_5":14861,"_28366":51222,"_3078":51452},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3627":176,"_31174":91,"_21594":51454,"_5":14861,"_28366":51222,"_3078":51455},[],"`--development`",{"_3627":177,"_31174":91,"_21594":51457,"_5":14861,"_28366":51222,"_3078":6794},[],{"_3627":178,"_31174":91,"_21594":51459,"_5":14861,"_28366":51222,"_3078":51460},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3627":179,"_31174":91,"_21594":51462,"_5":14861,"_28366":51222,"_3078":51463},[],"`--sample-data`",{"_3627":180,"_31174":91,"_21594":51465,"_5":14861,"_28366":51222,"_3078":6794},[],{"_3627":181,"_31174":91,"_21594":51467,"_5":14861,"_28366":51222,"_3078":51468},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3627":182,"_31174":91,"_21594":51470,"_5":14861,"_28366":51222,"_3078":51471},[],"`--with-hsm`",{"_3627":183,"_31174":91,"_21594":51473,"_5":14861,"_28366":51222,"_3078":6794},[],{"_3627":184,"_31174":91,"_21594":51475,"_5":14861,"_28366":51222,"_3078":51476},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3627":185,"_31174":91,"_21594":51478,"_5":14861,"_28366":51222,"_3078":51479},[],"`--softhsm-chart-path`",{"_3627":186,"_31174":91,"_21594":51481,"_5":14861,"_28366":51222,"_3078":51482},[],"`./charts/softhsm`",{"_3627":187,"_31174":91,"_21594":51484,"_5":14861,"_28366":51222,"_3078":51485},[],"Use a different local SoftHSM chart",{"_3627":188,"_31174":91,"_21594":51487,"_5":14861,"_28366":51222,"_3078":51488},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3627":189,"_31174":91,"_21594":51490,"_5":14861,"_28366":51226,"_3078":51491},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3627":190,"_31174":91,"_21594":51493,"_5":14861,"_28366":51226,"_3078":51494},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3627":191,"_31174":91,"_21594":51496,"_5":14861,"_28366":51226,"_3078":51497},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3627":192,"_31174":91,"_21594":51499,"_5":14861,"_28366":51226,"_3078":51500},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3627":193,"_31174":91,"_21594":51502,"_5":14861,"_28366":51226,"_3078":51503},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3627":194,"_31174":91,"_21594":51505,"_5":14861,"_28366":51226,"_3078":51506},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3627":195,"_31174":91,"_21594":51508,"_5":14861,"_28366":51230,"_3078":51509},[],"Fastlane:",{"_3627":196,"_31174":91,"_21594":51511,"_5":14861,"_28366":51230,"_3078":51512},[],"validates local tools and the selected cluster",{"_3627":197,"_31174":91,"_21594":51514,"_5":14861,"_28366":51230,"_3078":51515},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3627":198,"_31174":91,"_21594":51517,"_5":14861,"_28366":51230,"_3078":51518},[],"creates the namespace",{"_3627":199,"_31174":91,"_21594":51520,"_5":14861,"_28366":51230,"_3078":51521},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3627":200,"_31174":91,"_21594":51523,"_5":14861,"_28366":51230,"_3078":51524},[],"installs PostgreSQL and creates the required databases",{"_3627":201,"_31174":91,"_21594":51526,"_5":14861,"_28366":51230,"_3078":51527},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3627":202,"_31174":91,"_21594":51529,"_5":14861,"_28366":51230,"_3078":51530},[],"installs RabbitMQ",{"_3627":203,"_31174":91,"_21594":51532,"_5":14861,"_28366":51230,"_3078":51533},[],"optionally installs observability and lab HSM components",{"_3627":204,"_31174":91,"_21594":51535,"_5":14861,"_28366":51230,"_3078":51536},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3627":205,"_31174":91,"_21594":51538,"_5":14861,"_28366":51230,"_3078":51539},[],"optionally loads sample data",{"_3627":206,"_31174":91,"_21594":51541,"_5":14861,"_28366":51230,"_3078":51542},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3627":207,"_31174":91,"_21594":51544,"_5":14861,"_28366":51234,"_3078":51545},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3627":208,"_31174":91,"_21594":51547,"_5":14861,"_28366":51234,"_3078":51548},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3627":209,"_31174":91,"_21594":51550,"_5":14861,"_28366":51238,"_3078":51551},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3627":210,"_31174":91,"_21594":51553,"_5":14861,"_28366":51238,"_3078":51554},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3627":211,"_31174":91,"_21594":51556,"_5":14861,"_28366":51238,"_3078":51557},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3627":212,"_31174":91,"_21594":51559,"_5":14861,"_28366":51238,"_3078":51560},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3627":213,"_31174":91,"_21594":51562,"_5":14861,"_28366":51242,"_3078":51563},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3627":214,"_31174":214,"_5":15221,"_3078":51565,"_31533":51566,"_21594":51567,"_28366":214},"Install with Helm",[50951,50952,51058],[],{"_3627":215,"_31174":214,"_21594":51569,"_5":14861,"_28366":214,"_3078":51570},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3627":216,"_31174":214,"_5":31530,"_21594":51572,"_28366":51573,"_3078":51574},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3627":217,"_31174":214,"_5":31530,"_21594":51576,"_28366":51577,"_3078":50961},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#before-you-begin",{"_3627":218,"_31174":214,"_5":31530,"_21594":51579,"_28366":51580,"_3078":51581},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3627":219,"_31174":214,"_5":31530,"_21594":51583,"_28366":51584,"_3078":51585},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3627":220,"_31174":214,"_5":31530,"_21594":51587,"_28366":51588,"_3078":51589},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3627":221,"_31174":214,"_5":31530,"_21594":51591,"_28366":51592,"_3078":51593},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3627":222,"_31174":214,"_5":31530,"_21594":51595,"_28366":51596,"_3078":51597},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3627":223,"_31174":214,"_5":31530,"_21594":51599,"_28366":51600,"_3078":51601},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3627":224,"_31174":214,"_5":31530,"_21594":51603,"_28366":51604,"_3078":51605},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3627":225,"_31174":214,"_5":31530,"_21594":51607,"_28366":51608,"_3078":51609},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3627":226,"_31174":214,"_5":31530,"_21594":51611,"_28366":51612,"_3078":51613},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3627":227,"_31174":214,"_5":31530,"_21594":51615,"_28366":51616,"_3078":51617},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3627":228,"_31174":214,"_21594":51619,"_5":14861,"_28366":51573,"_3078":51620},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3627":229,"_31174":214,"_21594":51622,"_5":14861,"_28366":51577,"_3078":51623},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3627":230,"_31174":214,"_21594":51625,"_5":14861,"_28366":51577,"_3078":51626},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3627":231,"_31174":214,"_21594":51628,"_5":14861,"_28366":51577,"_3078":51629},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3627":232,"_31174":214,"_21594":51631,"_5":14861,"_28366":51577,"_3078":51632},[],"a reachable RabbitMQ broker and credentials",{"_3627":233,"_31174":214,"_21594":51634,"_5":14861,"_28366":51577,"_3078":51635},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3627":234,"_31174":214,"_21594":51637,"_5":14861,"_28366":51577,"_3078":51638},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3627":235,"_31174":214,"_21594":51640,"_5":14861,"_28366":51577,"_3078":51641},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3627":236,"_31174":214,"_21594":51643,"_5":14861,"_28366":51577,"_3078":51644},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3627":237,"_31174":214,"_21594":51646,"_5":14861,"_28366":51577,"_3078":51647},[],"a StorageClass and an external traffic design",{"_3627":238,"_31174":214,"_21594":51649,"_5":14861,"_28366":51577,"_3078":51650},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3627":239,"_31174":214,"_21594":51652,"_5":14861,"_28366":51577,"_3078":51653},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3627":240,"_31174":214,"_21594":51655,"_5":14861,"_28366":51577,"_3078":51656},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3627":241,"_31174":214,"_21594":51658,"_5":14861,"_28366":51580,"_3078":51659},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3627":242,"_31174":214,"_21594":51661,"_5":14861,"_28366":51580,"_3078":51662},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3627":243,"_31174":214,"_21594":51664,"_5":14861,"_28366":51580,"_3078":51665},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3627":244,"_31174":214,"_21594":51667,"_5":14861,"_28366":51584,"_3078":51668},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3627":245,"_31174":214,"_21594":51670,"_5":14861,"_28366":51584,"_3078":51671},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3627":246,"_31174":214,"_21594":51673,"_5":14861,"_28366":51584,"_3078":51674},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3627":247,"_31174":214,"_21594":51676,"_5":14861,"_28366":51584,"_3078":51677},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3627":248,"_31174":214,"_21594":51679,"_5":14861,"_28366":51588,"_3078":51680},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3627":249,"_31174":214,"_21594":51682,"_5":14861,"_28366":51588,"_3078":51683},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3627":250,"_31174":214,"_21594":51685,"_5":14861,"_28366":51588,"_3078":51686},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3627":251,"_31174":214,"_21594":51688,"_5":14861,"_28366":51588,"_3078":51689},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3627":252,"_31174":214,"_21594":51691,"_5":14861,"_28366":51588,"_3078":51692},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3627":253,"_31174":214,"_21594":51694,"_5":14861,"_28366":51588,"_3078":51695},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3627":254,"_31174":214,"_21594":51697,"_5":14861,"_28366":51588,"_3078":51698},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3627":255,"_31174":214,"_21594":51700,"_5":14861,"_28366":51588,"_3078":51701},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3627":256,"_31174":214,"_21594":51703,"_5":14861,"_28366":51592,"_3078":51704},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3627":257,"_31174":214,"_21594":51706,"_5":14861,"_28366":51596,"_3078":51707},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3627":258,"_31174":214,"_21594":51709,"_5":14861,"_28366":51596,"_3078":51710},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3627":259,"_31174":214,"_21594":51712,"_5":14861,"_28366":51596,"_3078":51713},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3627":260,"_31174":214,"_21594":51715,"_5":14861,"_28366":51596,"_3078":51716},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3627":261,"_31174":214,"_21594":51718,"_5":14861,"_28366":51596,"_3078":51719},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3627":262,"_31174":214,"_21594":51721,"_5":14861,"_28366":51596,"_3078":51722},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3627":263,"_31174":214,"_21594":51724,"_5":14861,"_28366":51596,"_3078":51725},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3627":264,"_31174":214,"_21594":51727,"_5":14861,"_28366":51600,"_3078":51728},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3627":265,"_31174":214,"_21594":51730,"_5":14861,"_28366":51600,"_3078":51731},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3627":266,"_31174":214,"_21594":51733,"_5":14861,"_28366":51600,"_3078":51734},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3627":267,"_31174":214,"_21594":51736,"_5":14861,"_28366":51600,"_3078":51737},[],"See Access control for the principal and policy model.",{"_3627":268,"_31174":214,"_21594":51739,"_5":14861,"_28366":51604,"_3078":51740},[],"To install a local checkout instead:",{"_3627":269,"_31174":214,"_21594":51742,"_5":14861,"_28366":51608,"_3078":51743},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3627":270,"_31174":214,"_21594":51745,"_5":14861,"_28366":51608,"_3078":51746},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3627":271,"_31174":214,"_21594":51748,"_5":14861,"_28366":51612,"_3078":51749},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3627":272,"_31174":214,"_21594":51751,"_5":14861,"_28366":51612,"_3078":51752},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3627":273,"_31174":214,"_21594":51754,"_5":14861,"_28366":51612,"_3078":51755},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3627":274,"_31174":214,"_21594":51757,"_5":14861,"_28366":51612,"_3078":51758},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3627":275,"_31174":214,"_21594":51760,"_5":14861,"_28366":51612,"_3078":51761},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3627":276,"_31174":214,"_21594":51763,"_5":14861,"_28366":51616,"_3078":51764},[],"Before going live, review:",{"_3627":277,"_31174":214,"_21594":51766,"_5":14861,"_28366":51616,"_3078":51767},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3627":278,"_31174":214,"_21594":51769,"_5":14861,"_28366":51616,"_3078":51770},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3627":279,"_31174":214,"_21594":51772,"_5":14861,"_28366":51616,"_3078":51773},[],"shared VA storage before increasing VA replicas",{"_3627":280,"_31174":214,"_21594":51775,"_5":14861,"_28366":51616,"_3078":51776},[],"managed OIDC roles and removal of evaluation credentials",{"_3627":281,"_31174":214,"_21594":51778,"_5":14861,"_28366":51616,"_3078":51779},[],"a trusted TLS issuer or externally managed certificate",{"_3627":282,"_31174":214,"_21594":51781,"_5":14861,"_28366":51616,"_3078":51782},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3627":283,"_31174":214,"_21594":51784,"_5":14861,"_28366":51616,"_3078":51785},[],"SMTP, observability and alert delivery",{"_3627":284,"_31174":214,"_21594":51787,"_5":14861,"_28366":51616,"_3078":51788},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3627":285,"_31174":214,"_21594":51790,"_5":14861,"_28366":51616,"_3078":51791},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3627":286,"_31174":286,"_5":15221,"_3078":51793,"_31533":51794,"_21594":51795,"_28366":286},"Expose the Gateway",[50951,50952,51058],[],{"_3627":287,"_31174":286,"_21594":51797,"_5":14861,"_28366":286,"_3078":51798},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3627":288,"_31174":286,"_5":31530,"_21594":51800,"_28366":51801,"_3078":51802},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3627":289,"_31174":286,"_5":31530,"_21594":51804,"_28366":51805,"_3078":51806},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3627":290,"_31174":286,"_5":31530,"_21594":51808,"_28366":51809,"_3078":51810},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3627":291,"_31174":286,"_5":31530,"_21594":51812,"_28366":51813,"_3078":51814},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#k3s","K3s",{"_3627":292,"_31174":286,"_5":31530,"_21594":51816,"_28366":51817,"_3078":51818},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3627":293,"_31174":286,"_5":31530,"_21594":51820,"_28366":51821,"_3078":51822},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3627":294,"_31174":286,"_5":31530,"_21594":51824,"_28366":51825,"_3078":51826},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3627":295,"_31174":286,"_5":31530,"_21594":51828,"_28366":51829,"_3078":51830},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3627":296,"_31174":286,"_5":31530,"_21594":51832,"_28366":51833,"_3078":51834},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3627":297,"_31174":286,"_5":31530,"_21594":51836,"_28366":51837,"_3078":51838},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3627":298,"_31174":286,"_5":31530,"_21594":51840,"_28366":51841,"_3078":51842},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3627":299,"_31174":286,"_21594":51844,"_5":14861,"_28366":51801,"_3078":51845},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3627":300,"_31174":286,"_21594":51847,"_5":14861,"_28366":51801,"_3078":51848},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3627":301,"_31174":286,"_21594":51850,"_5":14861,"_28366":51805,"_3078":51851},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3627":302,"_31174":286,"_21594":51853,"_5":14861,"_28366":51805,"_3078":51854},[],"Set it only when:",{"_3627":303,"_31174":286,"_21594":51856,"_5":14861,"_28366":51805,"_3078":51857},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3627":304,"_31174":286,"_21594":51859,"_5":14861,"_28366":51805,"_3078":51860},[],"that address is allocated to this Gateway",{"_3627":305,"_31174":286,"_21594":51862,"_5":14861,"_28366":51805,"_3078":51863},[],"the surrounding network already routes traffic for it to the cluster",{"_3627":306,"_31174":286,"_21594":51865,"_5":14861,"_28366":51805,"_3078":51866},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3627":307,"_31174":286,"_21594":51868,"_5":14861,"_28366":51805,"_3078":51869},[],"Keep these two settings separate:",{"_3627":308,"_31174":286,"_21594":51871,"_5":14861,"_28366":51805,"_3078":51872},[],"`gateway.addresses` requests an address for the Gateway.",{"_3627":309,"_31174":286,"_21594":51874,"_5":14861,"_28366":51805,"_3078":51875},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3627":310,"_31174":286,"_21594":51877,"_5":14861,"_28366":51805,"_3078":51878},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3627":311,"_31174":286,"_21594":51880,"_5":14861,"_28366":51809,"_3078":51881},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3627":312,"_31174":286,"_21594":51883,"_5":14861,"_28366":51809,"_3078":51884},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3627":313,"_31174":286,"_21594":51886,"_5":14861,"_28366":51813,"_3078":51887},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3627":314,"_31174":286,"_21594":51889,"_5":14861,"_28366":51813,"_3078":51890},[],"For the recommended design:",{"_3627":315,"_31174":286,"_21594":51892,"_5":14861,"_28366":51813,"_3078":51893},[],"Use only one externally exposed Lamassu Gateway.",{"_3627":316,"_31174":286,"_21594":51895,"_5":14861,"_28366":51813,"_3078":51896},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3627":317,"_31174":286,"_21594":51898,"_5":14861,"_28366":51813,"_3078":51899},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3627":318,"_31174":286,"_21594":51901,"_5":14861,"_28366":51813,"_3078":51902},[],"Point DNS at the VM's reachable address.",{"_3627":319,"_31174":286,"_21594":51904,"_5":14861,"_28366":51813,"_3078":51905},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3627":320,"_31174":286,"_21594":51907,"_5":14861,"_28366":51817,"_3078":51908},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3627":321,"_31174":286,"_21594":51910,"_5":14861,"_28366":51821,"_3078":51911},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3627":322,"_31174":286,"_21594":51913,"_5":14861,"_28366":51821,"_3078":51914},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3627":323,"_31174":286,"_21594":51916,"_5":14861,"_28366":51825,"_3078":51917},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3627":324,"_31174":286,"_21594":51919,"_5":14861,"_28366":51825,"_3078":51920},[],"Requirement",{"_3627":325,"_31174":286,"_21594":51922,"_5":14861,"_28366":51825,"_3078":51923},[],"Recommended design",{"_3627":326,"_31174":286,"_21594":51925,"_5":14861,"_28366":51825,"_3078":51926},[],"Consequence",{"_3627":327,"_31174":286,"_21594":51928,"_5":14861,"_28366":51825,"_3078":51929},[],"Several Lamassu URLs or services",{"_3627":328,"_31174":286,"_21594":51931,"_5":14861,"_28366":51825,"_3078":51932},[],"One Gateway with multiple routes",{"_3627":329,"_31174":286,"_21594":51934,"_5":14861,"_28366":51825,"_3078":51935},[],"One IP and one proxy fleet; this is the chart default",{"_3627":330,"_31174":286,"_21594":51937,"_5":14861,"_28366":51825,"_3078":51938},[],"Independent Gateways and separate external IPs",{"_3627":331,"_31174":286,"_21594":51940,"_5":14861,"_28366":51825,"_3078":51941},[],"One VIP per Gateway",{"_3627":332,"_31174":286,"_21594":51943,"_5":14861,"_28366":51825,"_3078":51944},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3627":333,"_31174":286,"_21594":51946,"_5":14861,"_28366":51825,"_3078":51947},[],"Independent Gateways on one node and one IP",{"_3627":334,"_31174":286,"_21594":51949,"_5":14861,"_28366":51825,"_3078":51950},[],"Use different external ports",{"_3627":335,"_31174":286,"_21594":51952,"_5":14861,"_28366":51825,"_3078":51953},[],"Clients must include non-standard ports",{"_3627":336,"_31174":286,"_21594":51955,"_5":14861,"_28366":51825,"_3078":51956},[],"Separate TLS/mTLS termination behind one IP",{"_3627":337,"_31174":286,"_21594":51958,"_5":14861,"_28366":51825,"_3078":51959},[],"Front-door SNI routing to internal Gateways",{"_3627":338,"_31174":286,"_21594":51961,"_5":14861,"_28366":51825,"_3078":51962},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3627":339,"_31174":286,"_21594":51964,"_5":14861,"_28366":51825,"_3078":51965},[],"Separate Gateway resources but shared proxy infrastructure",{"_3627":340,"_31174":286,"_21594":51967,"_5":14861,"_28366":51825,"_3078":51968},[],"Envoy merged-Gateway mode",{"_3627":341,"_31174":286,"_21594":51970,"_5":14861,"_28366":51825,"_3078":51971},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3627":342,"_31174":286,"_21594":51973,"_5":14861,"_28366":51825,"_3078":51974},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3627":343,"_31174":286,"_21594":51976,"_5":14861,"_28366":51825,"_3078":51977},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3627":344,"_31174":286,"_21594":51979,"_5":14861,"_28366":51825,"_3078":51980},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3627":345,"_31174":286,"_21594":51982,"_5":14861,"_28366":51825,"_3078":51983},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3627":346,"_31174":286,"_21594":51985,"_5":14861,"_28366":51829,"_3078":51986},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3627":347,"_31174":286,"_21594":51988,"_5":14861,"_28366":51833,"_3078":51989},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3627":348,"_31174":286,"_21594":51991,"_5":14861,"_28366":51833,"_3078":51992},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3627":349,"_31174":286,"_21594":51994,"_5":14861,"_28366":51833,"_3078":51995},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3627":350,"_31174":286,"_21594":51997,"_5":14861,"_28366":51833,"_3078":51998},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3627":351,"_31174":286,"_21594":52000,"_5":14861,"_28366":51833,"_3078":52001},[],"If none of those are possible, use different external ports or change the external network design.",{"_3627":352,"_31174":286,"_21594":52003,"_5":14861,"_28366":51837,"_3078":52004},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3627":353,"_31174":286,"_21594":52006,"_5":14861,"_28366":51837,"_3078":52007},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3627":354,"_31174":286,"_21594":52009,"_5":14861,"_28366":51841,"_3078":52010},[],"Check, in order:",{"_3627":355,"_31174":286,"_21594":52012,"_5":14861,"_28366":51841,"_3078":52013},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3627":356,"_31174":286,"_21594":52015,"_5":14861,"_28366":51841,"_3078":52016},[],"Its status contains the expected address.",{"_3627":357,"_31174":286,"_21594":52018,"_5":14861,"_28366":51841,"_3078":52019},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3627":358,"_31174":286,"_21594":52021,"_5":14861,"_28366":51841,"_3078":52022},[],"Port 443 reaches that address from the client network.",{"_3627":359,"_31174":286,"_21594":52024,"_5":14861,"_28366":51841,"_3078":52025},[],"DNS resolves to the externally reachable endpoint.",{"_3627":360,"_31174":286,"_21594":52027,"_5":14861,"_28366":51841,"_3078":52028},[],"The certificate contains the DNS name or IP used by the client.",{"_3627":361,"_31174":286,"_21594":52030,"_5":14861,"_28366":51841,"_3078":52031},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3627":362,"_31174":362,"_5":15221,"_3078":51058,"_31533":52033,"_21594":52034,"_28366":362},[50951,50952,51058],[],{"_3627":363,"_31174":362,"_21594":52036,"_5":14861,"_28366":362,"_3078":52037},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3627":364,"_31174":362,"_5":31530,"_21594":52039,"_28366":52040,"_3078":52041},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3627":365,"_31174":362,"_5":31530,"_21594":52043,"_28366":52044,"_3078":52045},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3627":366,"_31174":362,"_5":31530,"_21594":52047,"_28366":52048,"_3078":52049},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3627":367,"_31174":362,"_5":31530,"_21594":52051,"_28366":52052,"_3078":52053},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3627":368,"_31174":362,"_5":31530,"_21594":52055,"_28366":52056,"_3078":52057},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3627":369,"_31174":362,"_5":31530,"_21594":52059,"_28366":52060,"_3078":52061},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3627":370,"_31174":362,"_21594":52063,"_5":14861,"_28366":52040,"_3078":52064},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3627":371,"_31174":362,"_21594":52066,"_5":14861,"_28366":52044,"_3078":52067},[],"Workflow",{"_3627":372,"_31174":362,"_21594":52069,"_5":14861,"_28366":52044,"_3078":52070},[],"Use it for",{"_3627":373,"_31174":362,"_21594":52072,"_5":14861,"_28366":52044,"_3078":52073},[],"What it installs",{"_3627":374,"_31174":362,"_21594":52075,"_5":14861,"_28366":52044,"_3078":52076},[],"Helm",{"_3627":375,"_31174":362,"_21594":52078,"_5":14861,"_28366":52044,"_3078":52079},[],"Production and controlled environments",{"_3627":376,"_31174":362,"_21594":52081,"_5":14861,"_28366":52044,"_3078":52082},[],"Lamassu services and Gateway API resources",{"_3627":377,"_31174":362,"_21594":52084,"_5":14861,"_28366":52044,"_3078":51195},[],{"_3627":378,"_31174":362,"_21594":52086,"_5":14861,"_28366":52044,"_3078":52087},[],"Evaluation, demos, CI and small lab clusters",{"_3627":379,"_31174":362,"_21594":52089,"_5":14861,"_28366":52044,"_3078":52090},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3627":380,"_31174":362,"_21594":52092,"_5":14861,"_28366":52048,"_3078":52093},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3627":381,"_31174":362,"_21594":52095,"_5":14861,"_28366":52048,"_3078":52096},[],"Area",{"_3627":382,"_31174":362,"_21594":52098,"_5":14861,"_28366":52048,"_3078":52099},[],"The Lamassu chart provides",{"_3627":383,"_31174":362,"_21594":52101,"_5":14861,"_28366":52048,"_3078":52102},[],"You provide",{"_3627":384,"_31174":362,"_21594":52104,"_5":14861,"_28366":52048,"_3078":52105},[],"Lamassu applications",{"_3627":385,"_31174":362,"_21594":52107,"_5":14861,"_28366":52048,"_3078":52108},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3627":386,"_31174":362,"_21594":52110,"_5":14861,"_28366":52048,"_3078":52111},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3627":387,"_31174":362,"_21594":52113,"_5":14861,"_28366":52048,"_3078":52114},[],"PostgreSQL data",{"_3627":388,"_31174":362,"_21594":52116,"_5":14861,"_28366":52048,"_3078":52117},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3627":389,"_31174":362,"_21594":52119,"_5":14861,"_28366":52048,"_3078":52120},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3627":390,"_31174":362,"_21594":52122,"_5":14861,"_28366":52048,"_3078":52123},[],"Messaging",{"_3627":391,"_31174":362,"_21594":52125,"_5":14861,"_28366":52048,"_3078":52126},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3627":392,"_31174":362,"_21594":52128,"_5":14861,"_28366":52048,"_3078":52129},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3627":393,"_31174":362,"_21594":52131,"_5":14861,"_28366":52048,"_3078":52132},[],"Identity",{"_3627":394,"_31174":362,"_21594":52134,"_5":14861,"_28366":52048,"_3078":52135},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3627":395,"_31174":362,"_21594":52137,"_5":14861,"_28366":52048,"_3078":52138},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3627":396,"_31174":362,"_21594":52140,"_5":14861,"_28366":52048,"_3078":52141},[],"External routing",{"_3627":397,"_31174":362,"_21594":52143,"_5":14861,"_28366":52048,"_3078":52144},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3627":398,"_31174":362,"_21594":52146,"_5":14861,"_28366":52048,"_3078":52147},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3627":399,"_31174":362,"_21594":52149,"_5":14861,"_28366":52048,"_3078":52150},[],"TLS",{"_3627":400,"_31174":362,"_21594":52152,"_5":14861,"_28366":52048,"_3078":52153},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3627":401,"_31174":362,"_21594":52155,"_5":14861,"_28366":52048,"_3078":52156},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3627":402,"_31174":362,"_21594":52158,"_5":14861,"_28366":52048,"_3078":52159},[],"Persistent application data",{"_3627":403,"_31174":362,"_21594":52161,"_5":14861,"_28366":52048,"_3078":52162},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3627":404,"_31174":362,"_21594":52164,"_5":14861,"_28366":52048,"_3078":52165},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3627":405,"_31174":362,"_21594":52167,"_5":14861,"_28366":52048,"_3078":52168},[],"Optional integrations",{"_3627":406,"_31174":362,"_21594":52170,"_5":14861,"_28366":52048,"_3078":52171},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3627":407,"_31174":362,"_21594":52173,"_5":14861,"_28366":52048,"_3078":52174},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3627":408,"_31174":362,"_21594":52176,"_5":14861,"_28366":52048,"_3078":52177},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3627":409,"_31174":362,"_21594":52179,"_5":14861,"_28366":52048,"_3078":52180},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3627":410,"_31174":362,"_21594":52182,"_5":14861,"_28366":52052,"_3078":52183},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3627":411,"_31174":362,"_21594":52185,"_5":14861,"_28366":52052,"_3078":52186},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3627":412,"_31174":362,"_21594":52188,"_5":14861,"_28366":52056,"_3078":52189},[],"Kubernetes 1.24 or newer",{"_3627":413,"_31174":362,"_21594":52191,"_5":14861,"_28366":52056,"_3078":52192},[],"Helm 3.2 or newer",{"_3627":414,"_31174":362,"_21594":52194,"_5":14861,"_28366":52056,"_3078":52195},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3627":415,"_31174":362,"_21594":52197,"_5":14861,"_28366":52056,"_3078":52198},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3627":416,"_31174":362,"_21594":52200,"_5":14861,"_28366":52056,"_3078":52201},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3627":417,"_31174":362,"_21594":52203,"_5":14861,"_28366":52056,"_3078":52204},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3627":418,"_31174":362,"_21594":52206,"_5":14861,"_28366":52056,"_3078":52207},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3627":419,"_31174":362,"_21594":52209,"_5":14861,"_28366":52060,"_3078":52210},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3627":420,"_31174":362,"_21594":52212,"_5":14861,"_28366":52060,"_3078":52213},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3627":421,"_31174":362,"_21594":52215,"_5":14861,"_28366":52060,"_3078":52216},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3627":422,"_31174":362,"_21594":52218,"_5":14861,"_28366":52060,"_3078":52219},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3627":423,"_31174":423,"_5":15221,"_3078":52221,"_31533":52222,"_21594":52224,"_28366":423},"Deployment troubleshooting",[50951,50952,52223],"Operations",[],{"_3627":424,"_31174":423,"_21594":52226,"_5":14861,"_28366":423,"_3078":52227},[],"Diagnose access, service health and infrastructure dependencies.",{"_3627":425,"_31174":423,"_5":31530,"_21594":52229,"_28366":52230,"_3078":52231},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3627":426,"_31174":423,"_5":31530,"_21594":52233,"_28366":52234,"_3078":52235},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3627":427,"_31174":423,"_5":31530,"_21594":52237,"_28366":52238,"_3078":52239},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3627":428,"_31174":423,"_5":31530,"_21594":52241,"_28366":52242,"_3078":52243},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3627":429,"_31174":423,"_5":31530,"_21594":52245,"_28366":52246,"_3078":52247},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3627":430,"_31174":423,"_5":31530,"_21594":52249,"_28366":52250,"_3078":52251},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3627":431,"_31174":423,"_5":31530,"_21594":52253,"_28366":52254,"_3078":52255},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3627":432,"_31174":423,"_5":31530,"_21594":52257,"_28366":52258,"_3078":52259},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3627":433,"_31174":423,"_5":31530,"_21594":52261,"_28366":52262,"_3078":52263},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3627":434,"_31174":423,"_5":31530,"_21594":52265,"_28366":52266,"_3078":52267},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3627":435,"_31174":423,"_5":31530,"_21594":52269,"_28366":52270,"_3078":52271},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3627":436,"_31174":423,"_5":31530,"_21594":52273,"_28366":52274,"_3078":52275},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3627":437,"_31174":423,"_5":31530,"_21594":52277,"_28366":52278,"_3078":52279},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#observability","Observability",{"_3627":438,"_31174":423,"_21594":52281,"_5":14861,"_28366":423,"_3078":52282},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3627":439,"_31174":423,"_21594":52284,"_5":14861,"_28366":52234,"_3078":52285},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3627":440,"_31174":423,"_21594":52287,"_5":14861,"_28366":52238,"_3078":52288},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3627":441,"_31174":423,"_21594":52290,"_5":14861,"_28366":52242,"_3078":52291},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3627":442,"_31174":423,"_21594":52293,"_5":14861,"_28366":52246,"_3078":52294},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3627":443,"_31174":423,"_21594":52296,"_5":14861,"_28366":52250,"_3078":52297},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3627":444,"_31174":423,"_21594":52299,"_5":14861,"_28366":52254,"_3078":52300},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3627":445,"_31174":423,"_21594":52302,"_5":14861,"_28366":52254,"_3078":52303},[],"Also run the chart's connectivity test:",{"_3627":446,"_31174":423,"_21594":52305,"_5":14861,"_28366":52254,"_3078":52306},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3627":447,"_31174":423,"_21594":52308,"_5":14861,"_28366":52254,"_3078":52309},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3627":448,"_31174":423,"_21594":52311,"_5":14861,"_28366":52258,"_3078":52312},[],"If you receive a 401:",{"_3627":449,"_31174":423,"_21594":52314,"_5":14861,"_28366":52258,"_3078":52315},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3627":450,"_31174":423,"_21594":52317,"_5":14861,"_28366":52258,"_3078":52318},[],"verify issuer, audience and expiration of the token;",{"_3627":451,"_31174":423,"_21594":52320,"_5":14861,"_28366":52258,"_3078":52321},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3627":452,"_31174":423,"_21594":52323,"_5":14861,"_28366":52258,"_3078":52324},[],"check that the provider's public and internal routes point to the same realm.",{"_3627":453,"_31174":423,"_21594":52326,"_5":14861,"_28366":52258,"_3078":52327},[],"If login succeeds but the APIs return 403:",{"_3627":454,"_31174":423,"_21594":52329,"_5":14861,"_28366":52258,"_3078":52330},[],"inspect the token's real claims;",{"_3627":455,"_31174":423,"_21594":52332,"_5":14861,"_28366":52258,"_3078":52333},[],"confirm they match an active principal;",{"_3627":456,"_31174":423,"_21594":52335,"_5":14861,"_28366":52258,"_3078":52336},[],"review the policies granted to that principal;",{"_3627":457,"_31174":423,"_21594":52338,"_5":14861,"_28366":52258,"_3078":52339},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3627":458,"_31174":423,"_21594":52341,"_5":14861,"_28366":52258,"_3078":52342},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3627":459,"_31174":423,"_21594":52344,"_5":14861,"_28366":52262,"_3078":52345},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3627":460,"_31174":423,"_21594":52347,"_5":14861,"_28366":52262,"_3078":52348},[],"Locate the authz pod and Service.",{"_3627":461,"_31174":423,"_21594":52350,"_5":14861,"_28366":52262,"_3078":52351},[],"Check /health, logs and its database connection.",{"_3627":462,"_31174":423,"_21594":52353,"_5":14861,"_28366":52262,"_3078":52354},[],"Verify the DNS and port configured in externalAuthorization.",{"_3627":463,"_31174":423,"_21594":52356,"_5":14861,"_28366":52262,"_3078":52357},[],"Check the check route is /v1/ext\\_authz/check.",{"_3627":464,"_31174":423,"_21594":52359,"_5":14861,"_28366":52262,"_3078":52360},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3627":465,"_31174":423,"_21594":52362,"_5":14861,"_28366":52266,"_3078":52363},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3627":466,"_31174":423,"_21594":52365,"_5":14861,"_28366":52270,"_3078":52366},[],"Review kubectl describe pod first. Common causes are:",{"_3627":467,"_31174":423,"_21594":52368,"_5":14861,"_28366":52270,"_3078":52369},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3627":468,"_31174":423,"_21594":52371,"_5":14861,"_28366":52270,"_3078":52372},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3627":469,"_31174":423,"_21594":52374,"_5":14861,"_28366":52270,"_3078":52375},[],"unbound persistent volume;",{"_3627":470,"_31174":423,"_21594":52377,"_5":14861,"_28366":52270,"_3078":52378},[],"inaccessible image or incorrect pull policy;",{"_3627":471,"_31174":423,"_21594":52380,"_5":14861,"_28366":52270,"_3078":52381},[],"invalid cryptographic engine configuration;",{"_3627":472,"_31174":423,"_21594":52383,"_5":14861,"_28366":52270,"_3078":52384},[],"CPU or memory limits set too low;",{"_3627":473,"_31174":423,"_21594":52386,"_5":14861,"_28366":52270,"_3078":52387},[],"an incomplete prior migration.",{"_3627":474,"_31174":423,"_21594":52389,"_5":14861,"_28366":52270,"_3078":52390},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3627":475,"_31174":423,"_21594":52392,"_5":14861,"_28366":52270,"_3078":52393},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3627":476,"_31174":423,"_21594":52395,"_5":14861,"_28366":52270,"_3078":52396},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3627":477,"_31174":423,"_21594":52398,"_5":14861,"_28366":52274,"_3078":52399},[],"Domain and audit events depend on the bus publisher:",{"_3627":478,"_31174":423,"_21594":52401,"_5":14861,"_28366":52274,"_3078":52402},[],"verify it is enabled in the emitting service;",{"_3627":479,"_31174":423,"_21594":52404,"_5":14861,"_28366":52274,"_3078":52405},[],"check AMQP connectivity and credentials;",{"_3627":480,"_31174":423,"_21594":52407,"_5":14861,"_28366":52274,"_3078":52408},[],"review exchange, routing key, queues and consumers;",{"_3627":481,"_31174":423,"_21594":52410,"_5":14861,"_28366":52274,"_3078":52411},[],"inspect dead-letter queues;",{"_3627":482,"_31174":423,"_21594":52413,"_5":14861,"_28366":52274,"_3078":52414},[],"alert on orphan durable queues and backlog growth.",{"_3627":483,"_31174":423,"_21594":52416,"_5":14861,"_28366":52274,"_3078":52417},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3627":484,"_31174":423,"_21594":52419,"_5":14861,"_28366":52274,"_3078":52420},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3627":485,"_31174":423,"_21594":52422,"_5":14861,"_28366":52274,"_3078":52423},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3627":486,"_31174":423,"_21594":52425,"_5":14861,"_28366":52274,"_3078":52426},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3627":487,"_31174":423,"_21594":52428,"_5":14861,"_28366":52274,"_3078":52429},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3627":488,"_31174":423,"_21594":52431,"_5":14861,"_28366":52274,"_3078":52432},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3627":489,"_31174":423,"_21594":52434,"_5":14861,"_28366":52274,"_3078":52435},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3627":490,"_31174":423,"_21594":52437,"_5":14861,"_28366":52278,"_3078":52438},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3627":491,"_31174":423,"_21594":52440,"_5":14861,"_28366":52278,"_3078":52441},[],"Before closing an incident, record:",{"_3627":492,"_31174":423,"_21594":52443,"_5":14861,"_28366":52278,"_3078":52444},[],"the confirmed cause;",{"_3627":493,"_31174":423,"_21594":52446,"_5":14861,"_28366":52278,"_3078":52447},[],"the time scope and affected resources;",{"_3627":494,"_31174":423,"_21594":52449,"_5":14861,"_28366":52278,"_3078":52450},[],"the commands or queries used;",{"_3627":495,"_31174":423,"_21594":52452,"_5":14861,"_28366":52278,"_3078":52453},[],"the applied change and how to revert it;",{"_3627":496,"_31174":423,"_21594":52455,"_5":14861,"_28366":52278,"_3078":52456},[],"validation from a consumer;",{"_3627":497,"_31174":423,"_21594":52458,"_5":14861,"_28366":52278,"_3078":52459},[],"the preventive action and its owner.",{"_3627":498,"_31174":498,"_5":15221,"_3078":52461,"_31533":52462,"_21594":52466,"_28366":498},"Data model",[50951,52463,52464,52465],"Platform","Administration","Access control",[],{"_3627":499,"_31174":498,"_21594":52468,"_5":14861,"_28366":498,"_3078":52469},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3627":500,"_31174":498,"_5":31530,"_21594":52471,"_28366":52472,"_3078":52473},[],"/docs/pr-preview/pr-75/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3627":501,"_31174":498,"_5":31530,"_21594":52475,"_28366":52476,"_3078":52477},[],"/docs/pr-preview/pr-75/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3627":502,"_31174":498,"_21594":52479,"_5":14861,"_28366":498,"_3078":52480},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3627":503,"_31174":498,"_21594":52482,"_5":14861,"_28366":52472,"_3078":52483},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3627":504,"_31174":498,"_21594":52485,"_5":14861,"_28366":52472,"_3078":52486},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3627":505,"_31174":498,"_21594":52488,"_5":14861,"_28366":52472,"_3078":52489},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3627":506,"_31174":498,"_21594":52491,"_5":14861,"_28366":52476,"_3078":52492},[],"Entity (`schema_name.entity_type`)",{"_3627":507,"_31174":498,"_21594":52494,"_5":14861,"_28366":52476,"_3078":52495},[],"Table (`table_name`)",{"_3627":508,"_31174":498,"_21594":52497,"_5":14861,"_28366":52476,"_3078":52498},[],"Key (`primary_key`)",{"_3627":509,"_31174":498,"_21594":52500,"_5":14861,"_28366":52476,"_3078":52501},[],"`alerts.event`",{"_3627":510,"_31174":498,"_21594":52503,"_5":14861,"_28366":52476,"_3078":52504},[],"`events`",{"_3627":511,"_31174":498,"_21594":52506,"_5":14861,"_28366":52476,"_3078":52507},[],"`event_type`",{"_3627":512,"_31174":498,"_21594":52509,"_5":14861,"_28366":52476,"_3078":52510},[],"`alerts.subscription`",{"_3627":513,"_31174":498,"_21594":52512,"_5":14861,"_28366":52476,"_3078":52513},[],"`subscriptions`",{"_3627":514,"_31174":498,"_21594":52515,"_5":14861,"_28366":52476,"_3078":52516},[],"`id`",{"_3627":515,"_31174":498,"_21594":52518,"_5":14861,"_28366":52476,"_3078":52519},[],"`ca.ca_certificate`",{"_3627":516,"_31174":498,"_21594":52521,"_5":14861,"_28366":52476,"_3078":52522},[],"`ca_certificates`",{"_3627":517,"_31174":498,"_21594":52524,"_5":14861,"_28366":52476,"_3078":52516},[],{"_3627":518,"_31174":498,"_21594":52526,"_5":14861,"_28366":52476,"_3078":52527},[],"`ca.certificate`",{"_3627":519,"_31174":498,"_21594":52529,"_5":14861,"_28366":52476,"_3078":52530},[],"`certificates`",{"_3627":520,"_31174":498,"_21594":52532,"_5":14861,"_28366":52476,"_3078":52533},[],"`serial_number`",{"_3627":521,"_31174":498,"_21594":52535,"_5":14861,"_28366":52476,"_3078":52536},[],"`ca.issuance_profile`",{"_3627":522,"_31174":498,"_21594":52538,"_5":14861,"_28366":52476,"_3078":52539},[],"`issuance_profiles`",{"_3627":523,"_31174":498,"_21594":52541,"_5":14861,"_28366":52476,"_3078":52516},[],{"_3627":524,"_31174":498,"_21594":52543,"_5":14861,"_28366":52476,"_3078":52544},[],"`devicemanager.device_group`",{"_3627":525,"_31174":498,"_21594":52546,"_5":14861,"_28366":52476,"_3078":52547},[],"`device_groups`",{"_3627":526,"_31174":498,"_21594":52549,"_5":14861,"_28366":52476,"_3078":52516},[],{"_3627":527,"_31174":498,"_21594":52551,"_5":14861,"_28366":52476,"_3078":52552},[],"`devicemanager.device`",{"_3627":528,"_31174":498,"_21594":52554,"_5":14861,"_28366":52476,"_3078":52555},[],"`devices`",{"_3627":529,"_31174":498,"_21594":52557,"_5":14861,"_28366":52476,"_3078":52516},[],{"_3627":530,"_31174":498,"_21594":52559,"_5":14861,"_28366":52476,"_3078":52560},[],"`dmsmanager.dms`",{"_3627":531,"_31174":498,"_21594":52562,"_5":14861,"_28366":52476,"_3078":52563},[],"`dms`",{"_3627":532,"_31174":498,"_21594":52565,"_5":14861,"_28366":52476,"_3078":52516},[],{"_3627":533,"_31174":498,"_21594":52567,"_5":14861,"_28366":52476,"_3078":52568},[],"`kms.kms_key`",{"_3627":534,"_31174":498,"_21594":52570,"_5":14861,"_28366":52476,"_3078":52571},[],"`kms_keys`",{"_3627":535,"_31174":498,"_21594":52573,"_5":14861,"_28366":52476,"_3078":52574},[],"`key_id`, `engine_id`",{"_3627":536,"_31174":498,"_21594":52576,"_5":14861,"_28366":52476,"_3078":52577},[],"`va.crl_settings`",{"_3627":537,"_31174":498,"_21594":52579,"_5":14861,"_28366":52476,"_3078":52580},[],"`crl_settings`",{"_3627":538,"_31174":498,"_21594":52582,"_5":14861,"_28366":52476,"_3078":52583},[],"`ca_id`",{"_3627":539,"_31174":498,"_21594":52585,"_5":14861,"_28366":52476,"_3078":52586},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3627":540,"_31174":498,"_21594":52588,"_5":14861,"_28366":52476,"_3078":52589},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3627":541,"_31174":498,"_21594":52591,"_5":14861,"_28366":52476,"_3078":52592},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3627":542,"_31174":542,"_5":15221,"_3078":52594,"_31533":52595,"_21594":52596,"_28366":542},"Access control overview",[50951,52463,52464,52465],[],{"_3627":543,"_31174":542,"_21594":52598,"_5":14861,"_28366":542,"_3078":52599},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3627":544,"_31174":542,"_5":31530,"_21594":52601,"_28366":52602,"_3078":52603},[],"/docs/pr-preview/pr-75/platform/administration/access-control#essential-concepts","Essential concepts",{"_3627":545,"_31174":542,"_5":31530,"_21594":52605,"_28366":52606,"_3078":52607},[],"/docs/pr-preview/pr-75/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3627":546,"_31174":542,"_5":31530,"_21594":52609,"_28366":52610,"_3078":52611},[],"/docs/pr-preview/pr-75/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3627":547,"_31174":542,"_5":31530,"_21594":52613,"_28366":52614,"_3078":52615},[],"/docs/pr-preview/pr-75/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3627":548,"_31174":542,"_5":31530,"_21594":52617,"_28366":52618,"_3078":52619},[],"/docs/pr-preview/pr-75/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3627":549,"_31174":542,"_5":31530,"_21594":52621,"_28366":52622,"_3078":52623},[],"/docs/pr-preview/pr-75/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3627":550,"_31174":542,"_5":31530,"_21594":52625,"_28366":52626,"_3078":52627},[],"/docs/pr-preview/pr-75/platform/administration/access-control#oidc-principals","OIDC principals",{"_3627":551,"_31174":542,"_5":31530,"_21594":52629,"_28366":52630,"_3078":52631},[],"/docs/pr-preview/pr-75/platform/administration/access-control#x509-principals","X.509 principals",{"_3627":552,"_31174":542,"_5":31530,"_21594":52633,"_28366":52634,"_3078":52635},[],"/docs/pr-preview/pr-75/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3627":553,"_31174":542,"_5":31530,"_21594":52637,"_28366":52638,"_3078":52639},[],"/docs/pr-preview/pr-75/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3627":554,"_31174":542,"_5":31530,"_21594":52641,"_28366":52642,"_3078":52643},[],"/docs/pr-preview/pr-75/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3627":555,"_31174":542,"_5":31530,"_21594":52645,"_28366":52646,"_3078":52647},[],"/docs/pr-preview/pr-75/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3627":556,"_31174":542,"_5":31530,"_21594":52649,"_28366":52650,"_3078":52651},[],"/docs/pr-preview/pr-75/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3627":557,"_31174":542,"_5":31530,"_21594":52653,"_28366":52654,"_3078":52655},[],"/docs/pr-preview/pr-75/platform/administration/access-control#http-rules","HTTP rules",{"_3627":558,"_31174":542,"_5":31530,"_21594":52657,"_28366":52658,"_3078":52659},[],"/docs/pr-preview/pr-75/platform/administration/access-control#included-policies","Included policies",{"_3627":559,"_31174":542,"_5":31530,"_21594":52661,"_28366":52662,"_3078":51601},[],"/docs/pr-preview/pr-75/platform/administration/access-control#provision-the-first-administrator",{"_3627":560,"_31174":542,"_5":31530,"_21594":52664,"_28366":52665,"_3078":52666},[],"/docs/pr-preview/pr-75/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3627":561,"_31174":542,"_5":31530,"_21594":52668,"_28366":52669,"_3078":52670},[],"/docs/pr-preview/pr-75/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3627":562,"_31174":542,"_5":31530,"_21594":52672,"_28366":52673,"_3078":52674},[],"/docs/pr-preview/pr-75/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3627":563,"_31174":542,"_5":31530,"_21594":52676,"_28366":52677,"_3078":52678},[],"/docs/pr-preview/pr-75/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3627":564,"_31174":542,"_5":31530,"_21594":52680,"_28366":52681,"_3078":52682},[],"/docs/pr-preview/pr-75/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3627":565,"_31174":542,"_5":31530,"_21594":52684,"_28366":52685,"_3078":52686},[],"/docs/pr-preview/pr-75/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3627":566,"_31174":542,"_5":31530,"_21594":52688,"_28366":52689,"_3078":52690},[],"/docs/pr-preview/pr-75/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3627":567,"_31174":542,"_5":31530,"_21594":52692,"_28366":52693,"_3078":52694},[],"/docs/pr-preview/pr-75/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3627":568,"_31174":542,"_5":31530,"_21594":52696,"_28366":52697,"_3078":52698},[],"/docs/pr-preview/pr-75/platform/administration/access-control#operational-checklist","Operational checklist",{"_3627":569,"_31174":542,"_5":31530,"_21594":52700,"_28366":52701,"_3078":52702},[],"/docs/pr-preview/pr-75/platform/administration/access-control#diagnostics","Diagnostics",{"_3627":570,"_31174":542,"_5":31530,"_21594":52704,"_28366":52705,"_3078":52706},[],"/docs/pr-preview/pr-75/platform/administration/access-control#the-response-is-401","The response is 401",{"_3627":571,"_31174":542,"_5":31530,"_21594":52708,"_28366":52709,"_3078":52710},[],"/docs/pr-preview/pr-75/platform/administration/access-control#the-response-is-403","The response is 403",{"_3627":572,"_31174":542,"_5":31530,"_21594":52712,"_28366":52713,"_3078":52714},[],"/docs/pr-preview/pr-75/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3627":573,"_31174":542,"_5":31530,"_21594":52716,"_28366":52717,"_3078":52718},[],"/docs/pr-preview/pr-75/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3627":574,"_31174":542,"_5":31530,"_21594":52720,"_28366":52721,"_3078":52722},[],"/docs/pr-preview/pr-75/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3627":575,"_31174":542,"_21594":52724,"_5":14861,"_28366":542,"_3078":52725},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3627":576,"_31174":542,"_21594":52727,"_5":14861,"_28366":542,"_3078":52728},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3627":577,"_31174":542,"_21594":52730,"_5":14861,"_28366":542,"_3078":52731},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3627":578,"_31174":542,"_21594":52733,"_5":14861,"_28366":52602,"_3078":52734},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3627":579,"_31174":542,"_21594":52736,"_5":14861,"_28366":52602,"_3078":52737},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3627":580,"_31174":542,"_21594":52739,"_5":14861,"_28366":52602,"_3078":52740},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3627":581,"_31174":542,"_21594":52742,"_5":14861,"_28366":52602,"_3078":52743},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3627":582,"_31174":542,"_21594":52745,"_5":14861,"_28366":52602,"_3078":52746},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3627":583,"_31174":542,"_21594":52748,"_5":14861,"_28366":52602,"_3078":52749},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3627":584,"_31174":542,"_21594":52751,"_5":14861,"_28366":52606,"_3078":52752},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3627":585,"_31174":542,"_21594":52754,"_5":14861,"_28366":52606,"_3078":52755},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3627":586,"_31174":542,"_21594":52757,"_5":14861,"_28366":52610,"_3078":52758},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3627":587,"_31174":542,"_21594":52760,"_5":14861,"_28366":52610,"_3078":52761},[],"The decision is made **before forwarding the request to the service**:",{"_3627":588,"_31174":542,"_21594":52763,"_5":14861,"_28366":52610,"_3078":52764},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3627":589,"_31174":542,"_21594":52766,"_5":14861,"_28366":52610,"_3078":52767},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3627":590,"_31174":542,"_21594":52769,"_5":14861,"_28366":52610,"_3078":52770},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3627":591,"_31174":542,"_21594":52772,"_5":14861,"_28366":52610,"_3078":52773},[],"It separately loads the policies granted to each principal.",{"_3627":592,"_31174":542,"_21594":52775,"_5":14861,"_28366":52610,"_3078":52776},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3627":593,"_31174":542,"_21594":52778,"_5":14861,"_28366":52610,"_3078":52779},[],"`authz` looks for an HTTP rule granting that action.",{"_3627":594,"_31174":542,"_21594":52781,"_5":14861,"_28366":52610,"_3078":52782},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3627":595,"_31174":542,"_21594":52784,"_5":14861,"_28366":52610,"_3078":52785},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3627":596,"_31174":542,"_21594":52787,"_5":14861,"_28366":52610,"_3078":52788},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3627":597,"_31174":542,"_21594":52790,"_5":14861,"_28366":52610,"_3078":52791},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3627":598,"_31174":542,"_21594":52793,"_5":14861,"_28366":52614,"_3078":52794},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3627":599,"_31174":542,"_21594":52796,"_5":14861,"_28366":52614,"_3078":52797},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3627":600,"_31174":542,"_21594":52799,"_5":14861,"_28366":52614,"_3078":52800},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3627":601,"_31174":542,"_21594":52802,"_5":14861,"_28366":52614,"_3078":52803},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3627":602,"_31174":542,"_21594":52805,"_5":14861,"_28366":52614,"_3078":52806},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3627":603,"_31174":542,"_21594":52808,"_5":14861,"_28366":52614,"_3078":52809},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3627":604,"_31174":542,"_21594":52811,"_5":14861,"_28366":52614,"_3078":52812},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3627":605,"_31174":542,"_21594":52814,"_5":14861,"_28366":52614,"_3078":52815},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3627":606,"_31174":542,"_21594":52817,"_5":14861,"_28366":52614,"_3078":52818},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3627":607,"_31174":542,"_21594":52820,"_5":14861,"_28366":52614,"_3078":52821},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3627":608,"_31174":542,"_21594":52823,"_5":14861,"_28366":52618,"_3078":52824},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3627":609,"_31174":542,"_21594":52826,"_5":14861,"_28366":52618,"_3078":52827},[],"The decision is made with the domain operation context:",{"_3627":610,"_31174":542,"_21594":52829,"_5":14861,"_28366":52618,"_3078":52830},[],"The middleware extracts the credential and resolves the matching principals.",{"_3627":611,"_31174":542,"_21594":52832,"_5":14861,"_28366":52618,"_3078":52833},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3627":612,"_31174":542,"_21594":52835,"_5":14861,"_28366":52618,"_3078":52836},[],"`authz` gathers the entity rules of the granted policies.",{"_3627":613,"_31174":542,"_21594":52838,"_5":14861,"_28366":52618,"_3078":52839},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3627":614,"_31174":542,"_21594":52841,"_5":14861,"_28366":52618,"_3078":52842},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3627":615,"_31174":542,"_21594":52844,"_5":14861,"_28366":52618,"_3078":52845},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3627":616,"_31174":542,"_21594":52847,"_5":14861,"_28366":52618,"_3078":52848},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3627":617,"_31174":542,"_21594":52850,"_5":14861,"_28366":52618,"_3078":52851},[],"Actions fall into two groups:",{"_3627":618,"_31174":542,"_21594":52853,"_5":14861,"_28366":52618,"_3078":52854},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3627":619,"_31174":542,"_21594":52856,"_5":14861,"_28366":52618,"_3078":52857},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3627":620,"_31174":542,"_21594":52859,"_5":14861,"_28366":52618,"_3078":52860},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3627":621,"_31174":542,"_21594":52862,"_5":14861,"_28366":52622,"_3078":52863},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3627":622,"_31174":542,"_21594":52865,"_5":14861,"_28366":52622,"_3078":52866},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3627":623,"_31174":542,"_21594":52868,"_5":14861,"_28366":52622,"_3078":52869},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3627":624,"_31174":542,"_21594":52871,"_5":14861,"_28366":52626,"_3078":52872},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3627":625,"_31174":542,"_21594":52874,"_5":14861,"_28366":52626,"_3078":52875},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3627":626,"_31174":542,"_21594":52877,"_5":14861,"_28366":52626,"_3078":52878},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3627":627,"_31174":542,"_21594":52880,"_5":14861,"_28366":52626,"_3078":52881},[],"The implemented operators are:",{"_3627":628,"_31174":542,"_21594":52883,"_5":14861,"_28366":52626,"_3078":52884},[],"`equals`, for exact equality;",{"_3627":629,"_31174":542,"_21594":52886,"_5":14861,"_28366":52626,"_3078":52887},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3627":630,"_31174":542,"_21594":52889,"_5":14861,"_28366":52626,"_3078":52890},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3627":631,"_31174":542,"_21594":52892,"_5":14861,"_28366":52626,"_3078":52893},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3627":632,"_31174":542,"_21594":52895,"_5":14861,"_28366":52630,"_3078":52896},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3627":633,"_31174":542,"_21594":52898,"_5":14861,"_28366":52630,"_3078":52899},[],"The available modes are:",{"_3627":634,"_31174":542,"_21594":52901,"_5":14861,"_28366":52630,"_3078":52902},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3627":635,"_31174":542,"_21594":52904,"_5":14861,"_28366":52630,"_3078":52905},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3627":636,"_31174":542,"_21594":52907,"_5":14861,"_28366":52630,"_3078":52908},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3627":637,"_31174":542,"_21594":52910,"_5":14861,"_28366":52630,"_3078":52911},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3627":638,"_31174":542,"_21594":52913,"_5":14861,"_28366":52630,"_3078":52914},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3627":639,"_31174":542,"_21594":52916,"_5":14861,"_28366":52630,"_3078":52917},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3627":640,"_31174":542,"_21594":52919,"_5":14861,"_28366":52634,"_3078":52920},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3627":641,"_31174":542,"_21594":52922,"_5":14861,"_28366":52634,"_3078":52923},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3627":642,"_31174":542,"_21594":52925,"_5":14861,"_28366":52634,"_3078":52926},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3627":643,"_31174":542,"_21594":52928,"_5":14861,"_28366":52634,"_3078":52929},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3627":644,"_31174":542,"_21594":52931,"_5":14861,"_28366":52642,"_3078":52932},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3627":645,"_31174":542,"_21594":52934,"_5":14861,"_28366":52642,"_3078":52935},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3627":646,"_31174":542,"_21594":52937,"_5":14861,"_28366":52646,"_3078":52938},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3627":647,"_31174":542,"_21594":52940,"_5":14861,"_28366":52646,"_3078":52941},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3627":648,"_31174":542,"_21594":52943,"_5":14861,"_28366":52646,"_3078":52944},[],"The data model shows how the resources used in entity rules are connected.",{"_3627":649,"_31174":542,"_21594":52946,"_5":14861,"_28366":52646,"_3078":52947},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3627":650,"_31174":542,"_21594":52949,"_5":14861,"_28366":52646,"_3078":52950},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3627":651,"_31174":542,"_21594":52952,"_5":14861,"_28366":52650,"_3078":52953},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3627":652,"_31174":542,"_21594":52955,"_5":14861,"_28366":52650,"_3078":52956},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3627":653,"_31174":542,"_21594":52958,"_5":14861,"_28366":52650,"_3078":52959},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3627":654,"_31174":542,"_21594":52961,"_5":14861,"_28366":52654,"_3078":52962},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3627":655,"_31174":542,"_21594":52964,"_5":14861,"_28366":52654,"_3078":52965},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3627":656,"_31174":542,"_21594":52967,"_5":14861,"_28366":52654,"_3078":52968},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3627":657,"_31174":542,"_21594":52970,"_5":14861,"_28366":52654,"_3078":52971},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3627":658,"_31174":542,"_21594":52973,"_5":14861,"_28366":52654,"_3078":52974},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3627":659,"_31174":542,"_21594":52976,"_5":14861,"_28366":52654,"_3078":52977},[],"Note that:",{"_3627":660,"_31174":542,"_21594":52979,"_5":14861,"_28366":52654,"_3078":52980},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3627":661,"_31174":542,"_21594":52982,"_5":14861,"_28366":52654,"_3078":52983},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3627":662,"_31174":542,"_21594":52985,"_5":14861,"_28366":52654,"_3078":52986},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3627":663,"_31174":542,"_21594":52988,"_5":14861,"_28366":52658,"_3078":52989},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3627":664,"_31174":542,"_21594":52991,"_5":14861,"_28366":52658,"_3078":52992},[],"full and read-only access to certificates and authorities;",{"_3627":665,"_31174":542,"_21594":52994,"_5":14861,"_28366":52658,"_3078":52995},[],"full and read-only access to the KMS;",{"_3627":666,"_31174":542,"_21594":52997,"_5":14861,"_28366":52658,"_3078":52998},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3627":667,"_31174":542,"_21594":53000,"_5":14861,"_28366":52658,"_3078":53001},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3627":668,"_31174":542,"_21594":53003,"_5":14861,"_28366":52658,"_3078":53004},[],"console access;",{"_3627":669,"_31174":542,"_21594":53006,"_5":14861,"_28366":52658,"_3078":53007},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3627":670,"_31174":542,"_21594":53009,"_5":14861,"_28366":52658,"_3078":53010},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3627":671,"_31174":542,"_21594":53012,"_5":14861,"_28366":52658,"_3078":53013},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3627":672,"_31174":542,"_21594":53015,"_5":14861,"_28366":52658,"_3078":53016},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3627":673,"_31174":542,"_21594":53018,"_5":14861,"_28366":52658,"_3078":53019},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3627":674,"_31174":542,"_21594":53021,"_5":14861,"_28366":52662,"_3078":53022},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3627":675,"_31174":542,"_21594":53024,"_5":14861,"_28366":52662,"_3078":53025},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3627":676,"_31174":542,"_21594":53027,"_5":14861,"_28366":52662,"_3078":53028},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3627":677,"_31174":542,"_21594":53030,"_5":14861,"_28366":52665,"_3078":53031},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3627":678,"_31174":542,"_21594":53033,"_5":14861,"_28366":52669,"_3078":53034},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3627":679,"_31174":542,"_21594":53036,"_5":14861,"_28366":52669,"_3078":53037},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3627":680,"_31174":542,"_21594":53039,"_5":14861,"_28366":52673,"_3078":53040},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3627":681,"_31174":542,"_21594":53042,"_5":14861,"_28366":52677,"_3078":53043},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3627":682,"_31174":542,"_21594":53045,"_5":14861,"_28366":52681,"_3078":53046},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3627":683,"_31174":542,"_21594":53048,"_5":14861,"_28366":52685,"_3078":53049},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3627":684,"_31174":542,"_21594":53051,"_5":14861,"_28366":52685,"_3078":53052},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3627":685,"_31174":542,"_21594":53054,"_5":14861,"_28366":52689,"_3078":53055},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3627":686,"_31174":542,"_21594":53057,"_5":14861,"_28366":52689,"_3078":53058},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3627":687,"_31174":542,"_21594":53060,"_5":14861,"_28366":52689,"_3078":53061},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3627":688,"_31174":542,"_21594":53063,"_5":14861,"_28366":52689,"_3078":53064},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3627":689,"_31174":542,"_21594":53066,"_5":14861,"_28366":52689,"_3078":53067},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3627":690,"_31174":542,"_21594":53069,"_5":14861,"_28366":52689,"_3078":53070},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3627":691,"_31174":542,"_21594":53072,"_5":14861,"_28366":52689,"_3078":53073},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3627":692,"_31174":542,"_21594":53075,"_5":14861,"_28366":52689,"_3078":53076},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3627":693,"_31174":542,"_21594":53078,"_5":14861,"_28366":52693,"_3078":53079},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3627":694,"_31174":542,"_21594":53081,"_5":14861,"_28366":52693,"_3078":53082},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3627":695,"_31174":542,"_21594":53084,"_5":14861,"_28366":52693,"_3078":53085},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3627":696,"_31174":542,"_21594":53087,"_5":14861,"_28366":52697,"_3078":53088},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3627":697,"_31174":542,"_21594":53090,"_5":14861,"_28366":52697,"_3078":53091},[],"Use groups or stable roles for people and independent identities for automations.",{"_3627":698,"_31174":542,"_21594":53093,"_5":14861,"_28366":52697,"_3078":53094},[],"Keep at least two recovery administrators and test their access periodically.",{"_3627":699,"_31174":542,"_21594":53096,"_5":14861,"_28366":52697,"_3078":53097},[],"Review active principals, their matches and their grants after IdP changes.",{"_3627":700,"_31174":542,"_21594":53099,"_5":14861,"_28366":52697,"_3078":53100},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3627":701,"_31174":542,"_21594":53102,"_5":14861,"_28366":52697,"_3078":53103},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3627":702,"_31174":542,"_21594":53105,"_5":14861,"_28366":52697,"_3078":53106},[],"Always test one allowed and one denied operation for each role.",{"_3627":703,"_31174":542,"_21594":53108,"_5":14861,"_28366":52697,"_3078":53109},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3627":704,"_31174":542,"_21594":53111,"_5":14861,"_28366":52705,"_3078":53112},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3627":705,"_31174":542,"_21594":53114,"_5":14861,"_28366":52709,"_3078":53115},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3627":706,"_31174":542,"_21594":53117,"_5":14861,"_28366":52709,"_3078":53118},[],"that an active principal of the correct type exists;",{"_3627":707,"_31174":542,"_21594":53120,"_5":14861,"_28366":52709,"_3078":53121},[],"that the claim paths and values match the real token exactly;",{"_3627":708,"_31174":542,"_21594":53123,"_5":14861,"_28366":52709,"_3078":53124},[],"that all of the principal's conditions hold;",{"_3627":709,"_31174":542,"_21594":53126,"_5":14861,"_28366":52709,"_3078":53127},[],"that the principal has the expected policy granted;",{"_3627":710,"_31174":542,"_21594":53129,"_5":14861,"_28366":52709,"_3078":53130},[],"that the policy includes the action and the requested resource type or route;",{"_3627":711,"_31174":542,"_21594":53132,"_5":14861,"_28366":52709,"_3078":53133},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3627":712,"_31174":542,"_21594":53135,"_5":14861,"_28366":52709,"_3078":53136},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3627":713,"_31174":542,"_21594":53138,"_5":14861,"_28366":52709,"_3078":53139},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3627":714,"_31174":542,"_21594":53141,"_5":14861,"_28366":52713,"_3078":53142},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3627":715,"_31174":542,"_21594":53144,"_5":14861,"_28366":52717,"_3078":53145},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3627":716,"_31174":542,"_21594":53147,"_5":14861,"_28366":52721,"_3078":53148},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3627":717,"_31174":542,"_21594":53150,"_5":14861,"_28366":52721,"_3078":53151},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3627":718,"_31174":718,"_5":15221,"_3078":53153,"_31533":53154,"_21594":53155,"_28366":718},"Alerts and subscriptions",[50951,52463,52464],[],{"_3627":719,"_31174":718,"_21594":53157,"_5":14861,"_28366":718,"_3078":53158},[],"Send PKI events to people and external systems.",{"_3627":720,"_31174":718,"_5":31530,"_21594":53160,"_28366":53161,"_3078":53162},[],"/docs/pr-preview/pr-75/platform/administration/alerts#how-it-works","How it works",{"_3627":721,"_31174":718,"_5":31530,"_21594":53164,"_28366":53165,"_3078":53166},[],"/docs/pr-preview/pr-75/platform/administration/alerts#available-channels","Available channels",{"_3627":722,"_31174":718,"_5":31530,"_21594":53168,"_28366":53169,"_3078":53170},[],"/docs/pr-preview/pr-75/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3627":723,"_31174":718,"_5":31530,"_21594":53172,"_28366":53173,"_3078":53174},[],"/docs/pr-preview/pr-75/platform/administration/alerts#choose-the-event","Choose the event",{"_3627":724,"_31174":718,"_5":31530,"_21594":53176,"_28366":53177,"_3078":53178},[],"/docs/pr-preview/pr-75/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3627":725,"_31174":718,"_5":31530,"_21594":53180,"_28366":53181,"_3078":53182},[],"/docs/pr-preview/pr-75/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3627":726,"_31174":718,"_5":31530,"_21594":53184,"_28366":53185,"_3078":53186},[],"/docs/pr-preview/pr-75/platform/administration/alerts#review-and-activate","Review and activate",{"_3627":727,"_31174":718,"_5":31530,"_21594":53188,"_28366":53189,"_3078":53190},[],"/docs/pr-preview/pr-75/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3627":728,"_31174":718,"_5":31530,"_21594":53192,"_28366":53193,"_3078":53194},[],"/docs/pr-preview/pr-75/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3627":729,"_31174":718,"_5":31530,"_21594":53196,"_28366":53197,"_3078":53198},[],"/docs/pr-preview/pr-75/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3627":730,"_31174":718,"_5":31530,"_21594":53200,"_28366":53201,"_3078":53202},[],"/docs/pr-preview/pr-75/platform/administration/alerts#event-families","Event families",{"_3627":731,"_31174":718,"_21594":53204,"_5":14861,"_28366":718,"_3078":53205},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3627":732,"_31174":718,"_21594":53207,"_5":14861,"_28366":53161,"_3078":53208},[],"A service publishes a domain event.",{"_3627":733,"_31174":718,"_21594":53210,"_5":14861,"_28366":53161,"_3078":53211},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3627":734,"_31174":718,"_21594":53213,"_5":14861,"_28366":53161,"_3078":53214},[],"Each subscription's filter decides whether it should be notified.",{"_3627":735,"_31174":718,"_21594":53216,"_5":14861,"_28366":53161,"_3078":53217},[],"Lamassu delivers the event to the configured channel.",{"_3627":736,"_31174":718,"_21594":53219,"_5":14861,"_28366":53161,"_3078":53220},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3627":737,"_31174":718,"_21594":53222,"_5":14861,"_28366":53165,"_3078":53223},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3627":738,"_31174":718,"_21594":53225,"_5":14861,"_28366":53165,"_3078":53226},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3627":739,"_31174":718,"_21594":53228,"_5":14861,"_28366":53165,"_3078":53229},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3627":740,"_31174":718,"_21594":53231,"_5":14861,"_28366":53165,"_3078":53232},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3627":741,"_31174":718,"_21594":53234,"_5":14861,"_28366":53165,"_3078":53235},[],"`apikey_options` requires `header` and `key`.",{"_3627":742,"_31174":718,"_21594":53237,"_5":14861,"_28366":53165,"_3078":53238},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3627":743,"_31174":718,"_21594":53240,"_5":14861,"_28366":53165,"_3078":53241},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3627":744,"_31174":718,"_21594":53243,"_5":14861,"_28366":53165,"_3078":53244},[],"The alerts API reference documents the full `http_client` schema.",{"_3627":745,"_31174":718,"_21594":53246,"_5":14861,"_28366":53173,"_3078":53247},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3627":746,"_31174":718,"_21594":53249,"_5":14861,"_28366":53177,"_3078":53250},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3627":747,"_31174":718,"_21594":53252,"_5":14861,"_28366":53181,"_3078":53253},[],"Add a filter if you don't want to receive every instance of the event.",{"_3627":748,"_31174":718,"_21594":53255,"_5":14861,"_28366":53181,"_3078":53256},[],"**None** notifies all instances of the event.",{"_3627":749,"_31174":718,"_21594":53258,"_5":14861,"_28366":53181,"_3078":53259},[],"**JSON Path** evaluates one or more specific fields.",{"_3627":750,"_31174":718,"_21594":53261,"_5":14861,"_28366":53181,"_3078":53262},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3627":751,"_31174":718,"_21594":53264,"_5":14861,"_28366":53181,"_3078":53265},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3627":752,"_31174":718,"_21594":53267,"_5":14861,"_28366":53181,"_3078":53268},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3627":753,"_31174":718,"_21594":53270,"_5":14861,"_28366":53181,"_3078":53271},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3627":754,"_31174":718,"_21594":53273,"_5":14861,"_28366":53185,"_3078":53274},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3627":755,"_31174":718,"_21594":53276,"_5":14861,"_28366":53189,"_3078":53277},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3627":756,"_31174":718,"_21594":53279,"_5":14861,"_28366":53189,"_3078":53280},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3627":757,"_31174":718,"_21594":53282,"_5":14861,"_28366":53189,"_3078":53283},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3627":758,"_31174":718,"_21594":53285,"_5":14861,"_28366":53189,"_3078":53286},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3627":759,"_31174":718,"_21594":53288,"_5":14861,"_28366":53189,"_3078":53289},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3627":760,"_31174":718,"_21594":53291,"_5":14861,"_28366":53189,"_3078":53292},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3627":761,"_31174":718,"_21594":53294,"_5":14861,"_28366":53189,"_3078":53295},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3627":762,"_31174":718,"_21594":53297,"_5":14861,"_28366":53189,"_3078":53298},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3627":763,"_31174":718,"_21594":53300,"_5":14861,"_28366":53193,"_3078":53301},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3627":764,"_31174":718,"_21594":53303,"_5":14861,"_28366":53193,"_3078":53304},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3627":765,"_31174":718,"_21594":53306,"_5":14861,"_28366":53193,"_3078":53307},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3627":766,"_31174":718,"_21594":53309,"_5":14861,"_28366":53193,"_3078":53310},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3627":767,"_31174":718,"_21594":53312,"_5":14861,"_28366":53193,"_3078":53313},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3627":768,"_31174":718,"_21594":53315,"_5":14861,"_28366":53193,"_3078":53316},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3627":769,"_31174":718,"_21594":53318,"_5":14861,"_28366":53193,"_3078":53319},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3627":770,"_31174":718,"_21594":53321,"_5":14861,"_28366":53193,"_3078":53322},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3627":771,"_31174":718,"_21594":53324,"_5":14861,"_28366":53197,"_3078":53325},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3627":772,"_31174":718,"_21594":53327,"_5":14861,"_28366":53197,"_3078":53328},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3627":773,"_31174":718,"_21594":53330,"_5":14861,"_28366":53201,"_3078":53331},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3627":774,"_31174":718,"_21594":53333,"_5":14861,"_28366":53201,"_3078":53334},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3627":775,"_31174":718,"_21594":53336,"_5":14861,"_28366":53201,"_3078":53337},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3627":776,"_31174":718,"_21594":53339,"_5":14861,"_28366":53201,"_3078":53340},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3627":777,"_31174":718,"_21594":53342,"_5":14861,"_28366":53201,"_3078":53343},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3627":778,"_31174":718,"_21594":53345,"_5":14861,"_28366":53201,"_3078":53346},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3627":779,"_31174":718,"_21594":53348,"_5":14861,"_28366":53201,"_3078":53349},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3627":780,"_31174":718,"_21594":53351,"_5":14861,"_28366":53201,"_3078":53352},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3627":781,"_31174":718,"_21594":53354,"_5":14861,"_28366":53201,"_3078":53355},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3627":782,"_31174":718,"_21594":53357,"_5":14861,"_28366":53201,"_3078":53358},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3627":783,"_31174":783,"_5":15221,"_3078":53360,"_31533":53361,"_21594":53362,"_28366":783},"Audit logs",[50951,52463,52464],[],{"_3627":784,"_31174":783,"_21594":53364,"_5":14861,"_28366":783,"_3078":53365},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3627":785,"_31174":783,"_5":31530,"_21594":53367,"_28366":53368,"_3078":53369},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3627":786,"_31174":783,"_5":31530,"_21594":53371,"_28366":53372,"_3078":53373},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#coverage","Coverage",{"_3627":787,"_31174":783,"_5":31530,"_21594":53375,"_28366":53376,"_3078":53377},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3627":788,"_31174":783,"_5":31530,"_21594":53379,"_28366":53380,"_3078":53381},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3627":789,"_31174":783,"_5":31530,"_21594":53383,"_28366":53384,"_3078":53385},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3627":790,"_31174":783,"_5":31530,"_21594":53387,"_28366":53388,"_3078":53389},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3627":791,"_31174":783,"_5":31530,"_21594":53391,"_28366":53392,"_3078":53393},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3627":792,"_31174":783,"_5":31530,"_21594":53395,"_28366":53396,"_3078":53397},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3627":793,"_31174":783,"_5":31530,"_21594":53399,"_28366":53400,"_3078":53401},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3627":794,"_31174":783,"_5":31530,"_21594":53403,"_28366":53404,"_3078":53405},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3627":795,"_31174":783,"_5":31530,"_21594":53407,"_28366":53408,"_3078":53409},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3627":796,"_31174":783,"_21594":53411,"_5":14861,"_28366":783,"_3078":53412},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3627":797,"_31174":783,"_21594":53414,"_5":14861,"_28366":53368,"_3078":53415},[],"The audit body includes:",{"_3627":798,"_31174":783,"_21594":53417,"_5":14861,"_28366":53368,"_3078":53418},[],"input: data received by the operation;",{"_3627":799,"_31174":783,"_21594":53420,"_5":14861,"_28366":53368,"_3078":53421},[],"has\\_error: whether the service returned an error;",{"_3627":800,"_31174":783,"_21594":53423,"_5":14861,"_28366":53368,"_3078":53424},[],"output: produced result or error message;",{"_3627":801,"_31174":783,"_21594":53426,"_5":14861,"_28366":53368,"_3078":53427},[],"principals: identifiers of the principals that matched the request.",{"_3627":802,"_31174":783,"_21594":53429,"_5":14861,"_28366":53368,"_3078":53430},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3627":803,"_31174":783,"_21594":53432,"_5":14861,"_28366":53368,"_3078":53433},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3627":804,"_31174":783,"_21594":53435,"_5":14861,"_28366":53372,"_3078":53436},[],"The backend applies auditing to mutations of:",{"_3627":805,"_31174":783,"_21594":53438,"_5":14861,"_28366":53372,"_3078":53439},[],"authorities, certificates and issuance profiles;",{"_3627":806,"_31174":783,"_21594":53441,"_5":14861,"_28366":53372,"_3078":53442},[],"keys and KMS engines;",{"_3627":807,"_31174":783,"_21594":53444,"_5":14861,"_28366":53372,"_3078":53445},[],"devices and identities;",{"_3627":808,"_31174":783,"_21594":53447,"_5":14861,"_28366":53372,"_3078":53448},[],"DMSs and enrollment operations;",{"_3627":809,"_31174":783,"_21594":53450,"_5":14861,"_28366":53372,"_3078":53451},[],"validation functions and CRL;",{"_3627":810,"_31174":783,"_21594":53453,"_5":14861,"_28366":53372,"_3078":53454},[],"principals, policies and authorization grants.",{"_3627":811,"_31174":783,"_21594":53456,"_5":14861,"_28366":53372,"_3078":53457},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3627":812,"_31174":783,"_21594":53459,"_5":14861,"_28366":53376,"_3078":53460},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3627":813,"_31174":783,"_21594":53462,"_5":14861,"_28366":53376,"_3078":53463},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3627":814,"_31174":783,"_21594":53465,"_5":14861,"_28366":53376,"_3078":53466},[],"Design the consumer to:",{"_3627":815,"_31174":783,"_21594":53468,"_5":14861,"_28366":53376,"_3078":53469},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3627":816,"_31174":783,"_21594":53471,"_5":14861,"_28366":53376,"_3078":53472},[],"keep the complete CloudEvent unmodified;",{"_3627":817,"_31174":783,"_21594":53474,"_5":14861,"_28366":53376,"_3078":53475},[],"record the ingestion time and detect duplicates by ID;",{"_3627":818,"_31174":783,"_21594":53477,"_5":14861,"_28366":53376,"_3078":53478},[],"encrypt in transit and at rest;",{"_3627":819,"_31174":783,"_21594":53480,"_5":14861,"_28366":53376,"_3078":53481},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3627":820,"_31174":783,"_21594":53483,"_5":14861,"_28366":53376,"_3078":53484},[],"apply an explicit retention and legal hold policy;",{"_3627":821,"_31174":783,"_21594":53486,"_5":14861,"_28366":53376,"_3078":53487},[],"alert if it stops consuming or the pending queue grows.",{"_3627":822,"_31174":783,"_21594":53489,"_5":14861,"_28366":53380,"_3078":53490},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3627":823,"_31174":783,"_21594":53492,"_5":14861,"_28366":53380,"_3078":53493},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3627":824,"_31174":783,"_21594":53495,"_5":14861,"_28366":53388,"_3078":53496},[],"Start from the reported time and normalize every source to UTC.",{"_3627":825,"_31174":783,"_21594":53498,"_5":14861,"_28366":53392,"_3078":53499},[],"Filter by event type, service source and resource identifier.",{"_3627":826,"_31174":783,"_21594":53501,"_5":14861,"_28366":53396,"_3078":53502},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3627":827,"_31174":783,"_21594":53504,"_5":14861,"_28366":53400,"_3078":53505},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3627":828,"_31174":783,"_21594":53507,"_5":14861,"_28366":53404,"_3078":53508},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3627":829,"_31174":783,"_21594":53510,"_5":14861,"_28366":53408,"_3078":53511},[],"Generate a controlled mutation in a test environment and check that:",{"_3627":830,"_31174":783,"_21594":53513,"_5":14861,"_28366":53408,"_3078":53514},[],"a successful audit event appears;",{"_3627":831,"_31174":783,"_21594":53516,"_5":14861,"_28366":53408,"_3078":53517},[],"the principal matches the identity used;",{"_3627":832,"_31174":783,"_21594":53519,"_5":14861,"_28366":53408,"_3078":53520},[],"the consumer persists it exactly once;",{"_3627":833,"_31174":783,"_21594":53522,"_5":14861,"_28366":53408,"_3078":53523},[],"it can be retrieved by resource, actor and period;",{"_3627":834,"_31174":783,"_21594":53525,"_5":14861,"_28366":53408,"_3078":53526},[],"a consumer outage raises an alert.",{"_3627":835,"_31174":783,"_21594":53528,"_5":14861,"_28366":53408,"_3078":53529},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3627":836,"_31174":836,"_5":15221,"_3078":53531,"_31533":53532,"_21594":53533,"_28366":836},"Platform architecture",[50951,52463],[],{"_3627":837,"_31174":836,"_21594":53535,"_5":14861,"_28366":836,"_3078":53536},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3627":838,"_31174":836,"_5":31530,"_21594":53538,"_28366":53539,"_3078":53540},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#control-plane","Control plane",{"_3627":839,"_31174":836,"_5":31530,"_21594":53542,"_28366":53543,"_3078":53544},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3627":840,"_31174":836,"_5":31530,"_21594":53546,"_28366":53547,"_3078":53548},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3627":841,"_31174":836,"_5":31530,"_21594":53550,"_28366":53551,"_3078":53552},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#status-and-validation","Status and validation",{"_3627":842,"_31174":836,"_5":31530,"_21594":53554,"_28366":53555,"_3078":53556},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3627":843,"_31174":836,"_21594":53558,"_5":14861,"_28366":836,"_3078":53559},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3627":844,"_31174":836,"_21594":53561,"_5":14861,"_28366":836,"_3078":53562},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3627":845,"_31174":836,"_21594":53564,"_5":14861,"_28366":53539,"_3078":53565},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3627":846,"_31174":836,"_21594":53567,"_5":14861,"_28366":53543,"_3078":53568},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3627":847,"_31174":836,"_21594":53570,"_5":14861,"_28366":53547,"_3078":53571},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3627":848,"_31174":836,"_21594":53573,"_5":14861,"_28366":53551,"_3078":53574},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3627":849,"_31174":836,"_21594":53576,"_5":14861,"_28366":53555,"_3078":53577},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3627":850,"_31174":850,"_5":15221,"_3078":53579,"_31533":53580,"_21594":53581,"_28366":850},"How Lamassu works",[50951,52463],[],{"_3627":851,"_31174":850,"_21594":53583,"_5":14861,"_28366":850,"_3078":53584},[],"The mental model of trust, keys, certificates and devices.",{"_3627":852,"_31174":850,"_5":31530,"_21594":53586,"_28366":53587,"_3078":53588},[],"/docs/pr-preview/pr-75/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3627":853,"_31174":850,"_5":31530,"_21594":53590,"_28366":53591,"_3078":53592},[],"/docs/pr-preview/pr-75/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3627":854,"_31174":850,"_21594":53594,"_5":14861,"_28366":850,"_3078":53595},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3627":855,"_31174":850,"_21594":53597,"_5":14861,"_28366":53587,"_3078":53598},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3627":856,"_31174":850,"_21594":53600,"_5":14861,"_28366":53587,"_3078":53601},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3627":857,"_31174":850,"_21594":53603,"_5":14861,"_28366":53587,"_3078":53604},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3627":858,"_31174":850,"_21594":53606,"_5":14861,"_28366":53587,"_3078":53607},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3627":859,"_31174":850,"_21594":53609,"_5":14861,"_28366":53587,"_3078":53610},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3627":860,"_31174":850,"_21594":53612,"_5":14861,"_28366":53591,"_3078":53613},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3627":861,"_31174":850,"_21594":53615,"_5":14861,"_28366":53591,"_3078":53616},[],"A DMS relates that CA to an enrollment policy.",{"_3627":862,"_31174":850,"_21594":53618,"_5":14861,"_28366":53591,"_3078":53619},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3627":863,"_31174":850,"_21594":53621,"_5":14861,"_28366":53591,"_3078":53622},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3627":864,"_31174":850,"_21594":53624,"_5":14861,"_28366":53591,"_3078":53625},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3627":865,"_31174":850,"_21594":53627,"_5":14861,"_28366":53591,"_3078":53628},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3627":866,"_31174":850,"_21594":53630,"_5":14861,"_28366":53591,"_3078":53631},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3627":867,"_31174":867,"_5":15221,"_3078":53633,"_31533":53634,"_21594":53636,"_28366":867},"Devices and identities",[50951,52463,53635,53633],"IoT Fleets",[],{"_3627":868,"_31174":867,"_21594":53638,"_5":14861,"_28366":867,"_3078":53639},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3627":869,"_31174":867,"_5":31530,"_21594":53641,"_28366":53642,"_3078":53643},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","Device states",{"_3627":870,"_31174":867,"_5":31530,"_21594":53645,"_28366":53646,"_3078":53647},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3627":871,"_31174":867,"_5":31530,"_21594":53649,"_28366":53650,"_3078":53651},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3627":872,"_31174":867,"_5":31530,"_21594":53653,"_28366":53654,"_3078":53655},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3627":873,"_31174":867,"_5":31530,"_21594":53657,"_28366":53658,"_3078":53659},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3627":874,"_31174":867,"_5":31530,"_21594":53661,"_28366":53662,"_3078":53663},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3627":875,"_31174":867,"_5":31530,"_21594":53665,"_28366":53666,"_3078":53667},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3627":876,"_31174":867,"_5":31530,"_21594":53669,"_28366":53670,"_3078":53671},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3627":877,"_31174":867,"_5":31530,"_21594":53673,"_28366":53674,"_3078":53675},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3627":878,"_31174":867,"_5":31530,"_21594":53677,"_28366":53678,"_3078":53679},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3627":879,"_31174":867,"_5":31530,"_21594":53681,"_28366":53682,"_3078":53683},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3627":880,"_31174":867,"_21594":53685,"_5":14861,"_28366":867,"_3078":53686},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3627":881,"_31174":867,"_21594":53688,"_5":14861,"_28366":867,"_3078":53689},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3627":882,"_31174":867,"_21594":53691,"_5":14861,"_28366":53642,"_3078":53692},[],"Operational view",{"_3627":883,"_31174":867,"_21594":53694,"_5":14861,"_28366":53642,"_3078":53695},[],"Meaning",{"_3627":884,"_31174":867,"_21594":53697,"_5":14861,"_28366":53642,"_3078":53698},[],"**No Identity**",{"_3627":885,"_31174":867,"_21594":53700,"_5":14861,"_28366":53642,"_3078":53701},[],"A record exists without an associated identity.",{"_3627":886,"_31174":867,"_21594":53703,"_5":14861,"_28366":53642,"_3078":53704},[],"**Active**",{"_3627":887,"_31174":867,"_21594":53706,"_5":14861,"_28366":53642,"_3078":53707},[],"The slot is active; also check certificate dates, status and usages.",{"_3627":888,"_31174":867,"_21594":53709,"_5":14861,"_28366":53642,"_3078":53710},[],"**Renewal Pending**",{"_3627":889,"_31174":867,"_21594":53712,"_5":14861,"_28366":53642,"_3078":53713},[],"The identity is in the operational renewal window.",{"_3627":890,"_31174":867,"_21594":53715,"_5":14861,"_28366":53642,"_3078":53716},[],"**Expiring Soon**",{"_3627":891,"_31174":867,"_21594":53718,"_5":14861,"_28366":53642,"_3078":53719},[],"Expiration is approaching according to configured thresholds.",{"_3627":892,"_31174":867,"_21594":53721,"_5":14861,"_28366":53642,"_3078":53722},[],"**Expired**",{"_3627":893,"_31174":867,"_21594":53724,"_5":14861,"_28366":53642,"_3078":53725},[],"The identity has expired.",{"_3627":894,"_31174":867,"_21594":53727,"_5":14861,"_28366":53642,"_3078":53728},[],"**Revoked**",{"_3627":895,"_31174":867,"_21594":53730,"_5":14861,"_28366":53642,"_3078":53731},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3627":896,"_31174":867,"_21594":53733,"_5":14861,"_28366":53642,"_3078":53734},[],"**Decommissioned**",{"_3627":897,"_31174":867,"_21594":53736,"_5":14861,"_28366":53642,"_3078":53737},[],"The record is retired and ordinary updates do not restore operation.",{"_3627":898,"_31174":867,"_21594":53739,"_5":14861,"_28366":53642,"_3078":53740},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3627":899,"_31174":867,"_21594":53742,"_5":14861,"_28366":53646,"_3078":53743},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3627":900,"_31174":867,"_21594":53745,"_5":14861,"_28366":53646,"_3078":53746},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3627":901,"_31174":867,"_21594":53748,"_5":14861,"_28366":53646,"_3078":53749},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3627":902,"_31174":867,"_21594":53751,"_5":14861,"_28366":53646,"_3078":53752},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3627":903,"_31174":867,"_21594":53754,"_5":14861,"_28366":53650,"_3078":53755},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3627":904,"_31174":867,"_21594":53757,"_5":14861,"_28366":53654,"_3078":53758},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3627":905,"_31174":867,"_21594":53760,"_5":14861,"_28366":53658,"_3078":53761},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3627":906,"_31174":867,"_21594":53763,"_5":14861,"_28366":53662,"_3078":53764},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3627":907,"_31174":867,"_21594":53766,"_5":14861,"_28366":53666,"_3078":53767},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3627":908,"_31174":867,"_21594":53769,"_5":14861,"_28366":53666,"_3078":53770},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3627":909,"_31174":867,"_21594":53772,"_5":14861,"_28366":53670,"_3078":53773},[],"From **No Identity**, use **Assign Identity**:",{"_3627":910,"_31174":867,"_21594":53775,"_5":14861,"_28366":53670,"_3078":53776},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3627":911,"_31174":867,"_21594":53778,"_5":14861,"_28366":53670,"_3078":53779},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3627":912,"_31174":867,"_21594":53781,"_5":14861,"_28366":53670,"_3078":53782},[],"Confirm and read the serial, active version and history again.",{"_3627":913,"_31174":867,"_21594":53784,"_5":14861,"_28366":53670,"_3078":53785},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3627":914,"_31174":867,"_21594":53787,"_5":14861,"_28366":53670,"_3078":53788},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3627":915,"_31174":867,"_21594":53790,"_5":14861,"_28366":53674,"_3078":53791},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3627":916,"_31174":867,"_21594":53793,"_5":14861,"_28366":53674,"_3078":53794},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3627":917,"_31174":867,"_21594":53796,"_5":14861,"_28366":53674,"_3078":53797},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3627":918,"_31174":867,"_21594":53799,"_5":14861,"_28366":53678,"_3078":53800},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3627":919,"_31174":867,"_21594":53802,"_5":14861,"_28366":53678,"_3078":53803},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3627":920,"_31174":867,"_21594":53805,"_5":14861,"_28366":53678,"_3078":53806},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3627":921,"_31174":867,"_21594":53808,"_5":14861,"_28366":53678,"_3078":53809},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3627":922,"_31174":867,"_21594":53811,"_5":14861,"_28366":53682,"_3078":53812},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3627":923,"_31174":867,"_21594":53814,"_5":14861,"_28366":53682,"_3078":53815},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3627":924,"_31174":924,"_5":15221,"_3078":53817,"_31533":53818,"_21594":53820,"_28366":924},"Bootstrap identity and authentication",[50951,52463,53635,53633,53819],"Enrollment with PKI",[],{"_3627":925,"_31174":924,"_21594":53822,"_5":14861,"_28366":924,"_3078":53823},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3627":926,"_31174":924,"_5":31530,"_21594":53825,"_28366":53826,"_3078":53827},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3627":927,"_31174":924,"_5":31530,"_21594":53829,"_28366":53830,"_3078":53831},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3627":928,"_31174":924,"_5":31530,"_21594":53833,"_28366":53834,"_3078":53835},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3627":929,"_31174":924,"_5":31530,"_21594":53837,"_28366":53838,"_3078":53839},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3627":930,"_31174":924,"_5":31530,"_21594":53841,"_28366":53842,"_3078":53843},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3627":931,"_31174":924,"_21594":53845,"_5":14861,"_28366":924,"_3078":53846},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3627":932,"_31174":924,"_21594":53848,"_5":14861,"_28366":53826,"_3078":53849},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3627":933,"_31174":924,"_21594":53851,"_5":14861,"_28366":53826,"_3078":53852},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3627":934,"_31174":924,"_21594":53854,"_5":14861,"_28366":53830,"_3078":53855},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3627":935,"_31174":924,"_21594":53857,"_5":14861,"_28366":53830,"_3078":53858},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3627":936,"_31174":924,"_21594":53860,"_5":14861,"_28366":53830,"_3078":53861},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3627":937,"_31174":924,"_21594":53863,"_5":14861,"_28366":53834,"_3078":53864},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3627":938,"_31174":924,"_21594":53866,"_5":14861,"_28366":53834,"_3078":53867},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3627":939,"_31174":924,"_21594":53869,"_5":14861,"_28366":53838,"_3078":53870},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3627":940,"_31174":924,"_21594":53872,"_5":14861,"_28366":53838,"_3078":53873},[],"Example body:",{"_3627":941,"_31174":924,"_21594":53875,"_5":14861,"_28366":53838,"_3078":53876},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3627":942,"_31174":924,"_21594":53878,"_5":14861,"_28366":53838,"_3078":53879},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3627":943,"_31174":924,"_21594":53881,"_5":14861,"_28366":53838,"_3078":53882},[],"Continuation requires a successful HTTP response and JSON:",{"_3627":944,"_31174":924,"_21594":53884,"_5":14861,"_28366":53838,"_3078":53885},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3627":945,"_31174":924,"_21594":53887,"_5":14861,"_28366":53842,"_3078":53888},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3627":946,"_31174":924,"_21594":53890,"_5":14861,"_28366":53842,"_3078":53891},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh — `thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old — and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3627":947,"_31174":924,"_21594":53893,"_5":14861,"_28366":53842,"_3078":53894},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3627":948,"_31174":924,"_21594":53896,"_5":14861,"_28366":53842,"_3078":53897},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3627":949,"_31174":949,"_5":15221,"_3078":53899,"_31533":53900,"_21594":53901,"_28366":949},"Configure and operate the DMS",[50951,52463,53635,53633,53819],[],{"_3627":950,"_31174":949,"_21594":53903,"_5":14861,"_28366":949,"_3078":53904},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3627":951,"_31174":949,"_5":31530,"_21594":53906,"_28366":53907,"_3078":50961},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3627":952,"_31174":949,"_5":31530,"_21594":53909,"_28366":53910,"_3078":53911},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3627":953,"_31174":949,"_5":31530,"_21594":53913,"_28366":53914,"_3078":53915},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3627":954,"_31174":949,"_5":31530,"_21594":53917,"_28366":53918,"_3078":53919},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3627":955,"_31174":949,"_5":31530,"_21594":53921,"_28366":53922,"_3078":53923},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3627":956,"_31174":949,"_5":31530,"_21594":53925,"_28366":53926,"_3078":53927},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3627":957,"_31174":949,"_5":31530,"_21594":53929,"_28366":53930,"_3078":53931},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3627":958,"_31174":949,"_5":31530,"_21594":53933,"_28366":53934,"_3078":53935},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3627":959,"_31174":949,"_5":31530,"_21594":53937,"_28366":53938,"_3078":53939},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3627":960,"_31174":949,"_5":31530,"_21594":53941,"_28366":53942,"_3078":53943},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3627":961,"_31174":949,"_5":31530,"_21594":53945,"_28366":53946,"_3078":53947},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3627":962,"_31174":949,"_5":31530,"_21594":53949,"_28366":53950,"_3078":53951},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3627":963,"_31174":949,"_5":31530,"_21594":53953,"_28366":53954,"_3078":53955},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3627":964,"_31174":949,"_5":31530,"_21594":53957,"_28366":53958,"_3078":53959},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3627":965,"_31174":949,"_5":31530,"_21594":53961,"_28366":53962,"_3078":53963},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3627":966,"_31174":949,"_5":31530,"_21594":53965,"_28366":53966,"_3078":53967},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3627":967,"_31174":949,"_5":31530,"_21594":53969,"_28366":53970,"_3078":53971},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3627":968,"_31174":949,"_5":31530,"_21594":53973,"_28366":53974,"_3078":53975},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3627":969,"_31174":949,"_21594":53977,"_5":14861,"_28366":949,"_3078":53978},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3627":970,"_31174":949,"_21594":53980,"_5":14861,"_28366":53907,"_3078":53981},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3627":971,"_31174":949,"_21594":53983,"_5":14861,"_28366":53907,"_3078":53984},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3627":972,"_31174":949,"_21594":53986,"_5":14861,"_28366":53914,"_3078":53987},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3627":973,"_31174":949,"_21594":53989,"_5":14861,"_28366":53918,"_3078":53990},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3627":974,"_31174":949,"_21594":53992,"_5":14861,"_28366":53922,"_3078":53993},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3627":975,"_31174":949,"_21594":53995,"_5":14861,"_28366":53926,"_3078":53996},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3627":976,"_31174":949,"_21594":53998,"_5":14861,"_28366":53930,"_3078":53999},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3627":977,"_31174":949,"_21594":54001,"_5":14861,"_28366":53938,"_3078":54002},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3627":978,"_31174":949,"_21594":54004,"_5":14861,"_28366":53938,"_3078":54005},[],"PRE\\_REGISTRATION requires an existing ID. An existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3627":979,"_31174":949,"_21594":54007,"_5":14861,"_28366":53942,"_3078":54008},[],"`settings.enrollment_settings` field",{"_3627":980,"_31174":949,"_21594":54010,"_5":14861,"_28366":53942,"_3078":54011},[],"Decision",{"_3627":981,"_31174":949,"_21594":54013,"_5":14861,"_28366":53942,"_3078":54014},[],"`protocol`",{"_3627":982,"_31174":949,"_21594":54016,"_5":14861,"_28366":53942,"_3078":54017},[],"`EST_RFC7030` for these operations.",{"_3627":983,"_31174":949,"_21594":54019,"_5":14861,"_28366":53942,"_3078":54020},[],"`enrollment_ca`",{"_3627":984,"_31174":949,"_21594":54022,"_5":14861,"_28366":53942,"_3078":54023},[],"ID of the signing CA.",{"_3627":985,"_31174":949,"_21594":54025,"_5":14861,"_28366":53942,"_3078":54026},[],"`verify_csr_signature`",{"_3627":986,"_31174":949,"_21594":54028,"_5":14861,"_28366":53942,"_3078":54029},[],"Keep `true` to verify CSR key possession.",{"_3627":987,"_31174":949,"_21594":54031,"_5":14861,"_28366":53942,"_3078":54032},[],"`enable_replaceable_enrollment`",{"_3627":988,"_31174":949,"_21594":54034,"_5":14861,"_28366":53942,"_3078":54035},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3627":989,"_31174":949,"_21594":54037,"_5":14861,"_28366":53942,"_3078":54038},[],"`est_rfc7030_settings.auth_mode`",{"_3627":990,"_31174":949,"_21594":54040,"_5":14861,"_28366":53942,"_3078":54041},[],"One of the four authentication modes.",{"_3627":991,"_31174":949,"_21594":54043,"_5":14861,"_28366":53942,"_3078":54044},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3627":992,"_31174":949,"_21594":54046,"_5":14861,"_28366":53946,"_3078":54047},[],"The blocks are independent:",{"_3627":993,"_31174":949,"_21594":54049,"_5":14861,"_28366":53946,"_3078":54050},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3627":994,"_31174":949,"_21594":54052,"_5":14861,"_28366":53946,"_3078":54053},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3627":995,"_31174":949,"_21594":54055,"_5":14861,"_28366":53946,"_3078":54056},[],"`auth_mode`",{"_3627":996,"_31174":949,"_21594":54058,"_5":14861,"_28366":53946,"_3078":54059},[],"Control applied in the configured operation",{"_3627":997,"_31174":949,"_21594":54061,"_5":14861,"_28366":53946,"_3078":54062},[],"`CLIENT_CERTIFICATE`",{"_3627":998,"_31174":949,"_21594":54064,"_5":14861,"_28366":53946,"_3078":54065},[],"Presented certificate validation.",{"_3627":999,"_31174":949,"_21594":54067,"_5":14861,"_28366":53946,"_3078":54068},[],"`EXTERNAL_WEBHOOK`",{"_3627":1000,"_31174":949,"_21594":54070,"_5":14861,"_28366":53946,"_3078":54071},[],"Configured webhook authorization.",{"_3627":1001,"_31174":949,"_21594":54073,"_5":14861,"_28366":53946,"_3078":54074},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3627":1002,"_31174":949,"_21594":54076,"_5":14861,"_28366":53946,"_3078":54077},[],"Certificate validation followed by webhook approval.",{"_3627":1003,"_31174":949,"_21594":54079,"_5":14861,"_28366":53946,"_3078":54080},[],"`NO_AUTH`",{"_3627":1004,"_31174":949,"_21594":54082,"_5":14861,"_28366":53946,"_3078":54083},[],"No DMS requester authentication.",{"_3627":1005,"_31174":949,"_21594":54085,"_5":14861,"_28366":53946,"_3078":54086},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3627":1006,"_31174":949,"_21594":54088,"_5":14861,"_28366":53946,"_3078":54089},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `chain_level_validation` and `allow_unverifiable_revocation`. The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3627":1007,"_31174":949,"_21594":54091,"_5":14861,"_28366":53946,"_3078":54092},[],"Revocation is checked for every presented certificate. In initial enrollment the client certificate **and** every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. A validation CA that is revoked in Lamassu rejects the operation: the first validation CA that validates the certificate is used, and a revoked one is not replaced by the remaining validation CAs. Certificates issued and managed by Lamassu are checked against their stored status. External certificates are checked through their OCSP and CRL endpoints, and the operation fails closed when revocation cannot be verified: only `allow_unverifiable_revocation` — `false` by default in both blocks — relaxes the case of an external certificate that lists no endpoint at all. Endpoints that exist but are unreachable, return stale or invalid evidence, or report an inconclusive status are always rejected, whatever the option says. The details and the evidence the endpoints must present are in Revocation and checks.",{"_3627":1008,"_31174":949,"_21594":54094,"_5":14861,"_28366":53946,"_3078":54095},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`. Re-enrollment checks revocation of the client certificate only; that check is governed by the re-enrollment block's own `allow_unverifiable_revocation`.",{"_3627":1009,"_31174":949,"_21594":54097,"_5":14861,"_28366":53946,"_3078":54098},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3627":1010,"_31174":949,"_21594":54100,"_5":14861,"_28366":53950,"_3078":54101},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3627":1011,"_31174":949,"_21594":54103,"_5":14861,"_28366":53950,"_3078":54104},[],"`external_webhook_settings` field",{"_3627":1012,"_31174":949,"_21594":54106,"_5":14861,"_28366":53950,"_3078":54011},[],{"_3627":1013,"_31174":949,"_21594":54108,"_5":14861,"_28366":53950,"_3078":54109},[],"`url`",{"_3627":1014,"_31174":949,"_21594":54111,"_5":14861,"_28366":53950,"_3078":54112},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3627":1015,"_31174":949,"_21594":54114,"_5":14861,"_28366":53950,"_3078":54115},[],"`method`",{"_3627":1016,"_31174":949,"_21594":54117,"_5":14861,"_28366":53950,"_3078":54118},[],"`POST` or `PUT`; `POST` by default.",{"_3627":1017,"_31174":949,"_21594":54120,"_5":14861,"_28366":53950,"_3078":54121},[],"`name`",{"_3627":1018,"_31174":949,"_21594":54123,"_5":14861,"_28366":53950,"_3078":54124},[],"Label used in service logs.",{"_3627":1019,"_31174":949,"_21594":54126,"_5":14861,"_28366":53950,"_3078":54127},[],"`config.auth_mode`",{"_3627":1020,"_31174":949,"_21594":54129,"_5":14861,"_28366":53950,"_3078":54130},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3627":1021,"_31174":949,"_21594":54132,"_5":14861,"_28366":53950,"_3078":54133},[],"`config.log_level`",{"_3627":1022,"_31174":949,"_21594":54135,"_5":14861,"_28366":53950,"_3078":54136},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3627":1023,"_31174":949,"_21594":54138,"_5":14861,"_28366":53950,"_3078":54139},[],"`config.apikey_options`",{"_3627":1024,"_31174":949,"_21594":54141,"_5":14861,"_28366":53950,"_3078":54142},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3627":1025,"_31174":949,"_21594":54144,"_5":14861,"_28366":53950,"_3078":54145},[],"`config.jwt_options`",{"_3627":1026,"_31174":949,"_21594":54147,"_5":14861,"_28366":53950,"_3078":54148},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3627":1027,"_31174":949,"_21594":54150,"_5":14861,"_28366":53950,"_3078":54151},[],"`config.mtls_options`",{"_3627":1028,"_31174":949,"_21594":54153,"_5":14861,"_28366":53950,"_3078":54154},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3627":1029,"_31174":949,"_21594":54156,"_5":14861,"_28366":53950,"_3078":54157},[],"`config.insecure_skip_verify`",{"_3627":1030,"_31174":949,"_21594":54159,"_5":14861,"_28366":53950,"_3078":54160},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3627":1031,"_31174":949,"_21594":54162,"_5":14861,"_28366":53950,"_3078":54163},[],"`config.call_timeout`",{"_3627":1032,"_31174":949,"_21594":54165,"_5":14861,"_28366":53950,"_3078":54166},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3627":1033,"_31174":949,"_21594":54168,"_5":14861,"_28366":53950,"_3078":54169},[],"Rules for that configuration:",{"_3627":1034,"_31174":949,"_21594":54171,"_5":14861,"_28366":53950,"_3078":54172},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3627":1035,"_31174":949,"_21594":54174,"_5":14861,"_28366":53950,"_3078":54175},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3627":1036,"_31174":949,"_21594":54177,"_5":14861,"_28366":53950,"_3078":54178},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3627":1037,"_31174":949,"_21594":54180,"_5":14861,"_28366":53950,"_3078":54181},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3627":1038,"_31174":949,"_21594":54183,"_5":14861,"_28366":53950,"_3078":54184},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3627":1039,"_31174":949,"_21594":54186,"_5":14861,"_28366":53950,"_3078":54187},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3627":1040,"_31174":949,"_21594":54189,"_5":14861,"_28366":53950,"_3078":54190},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3627":1041,"_31174":949,"_21594":54192,"_5":14861,"_28366":53950,"_3078":54193},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3627":1042,"_31174":949,"_21594":54195,"_5":14861,"_28366":53950,"_3078":54196},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3627":1043,"_31174":949,"_21594":54198,"_5":14861,"_28366":53954,"_3078":54199},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3627":1044,"_31174":949,"_21594":54201,"_5":14861,"_28366":53958,"_3078":54202},[],"`settings.reenrollment_settings` field",{"_3627":1045,"_31174":949,"_21594":54204,"_5":14861,"_28366":53958,"_3078":51341},[],{"_3627":1046,"_31174":949,"_21594":54206,"_5":14861,"_28366":53958,"_3078":54207},[],"`reenrollment_delta`",{"_3627":1047,"_31174":949,"_21594":54209,"_5":14861,"_28366":53958,"_3078":54210},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3627":1048,"_31174":949,"_21594":54212,"_5":14861,"_28366":53958,"_3078":54213},[],"`preventive_delta`",{"_3627":1049,"_31174":949,"_21594":54215,"_5":14861,"_28366":53958,"_3078":54216},[],"Preventive operational monitoring threshold.",{"_3627":1050,"_31174":949,"_21594":54218,"_5":14861,"_28366":53958,"_3078":54219},[],"`critical_delta`",{"_3627":1051,"_31174":949,"_21594":54221,"_5":14861,"_28366":53958,"_3078":54222},[],"Critical operational monitoring threshold.",{"_3627":1052,"_31174":949,"_21594":54224,"_5":14861,"_28366":53958,"_3078":54225},[],"`enable_expired_renewal`",{"_3627":1053,"_31174":949,"_21594":54227,"_5":14861,"_28366":53958,"_3078":54228},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3627":1054,"_31174":949,"_21594":54230,"_5":14861,"_28366":53958,"_3078":54231},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3627":1055,"_31174":949,"_21594":54233,"_5":14861,"_28366":53958,"_3078":54234},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3627":1056,"_31174":949,"_21594":54236,"_5":14861,"_28366":53958,"_3078":54237},[],"`revoke_on_reenrollment`",{"_3627":1057,"_31174":949,"_21594":54239,"_5":14861,"_28366":53958,"_3078":54240},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3627":1058,"_31174":949,"_21594":54242,"_5":14861,"_28366":53958,"_3078":54243},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3627":1059,"_31174":949,"_21594":54245,"_5":14861,"_28366":53962,"_3078":54246},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3627":1060,"_31174":949,"_21594":54248,"_5":14861,"_28366":53966,"_3078":51335},[],{"_3627":1061,"_31174":949,"_21594":54250,"_5":14861,"_28366":53966,"_3078":54251},[],"Published material",{"_3627":1062,"_31174":949,"_21594":54253,"_5":14861,"_28366":53966,"_3078":54254},[],"**Include Lamassu System CA**",{"_3627":1063,"_31174":949,"_21594":54256,"_5":14861,"_28366":53966,"_3078":54257},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3627":1064,"_31174":949,"_21594":54259,"_5":14861,"_28366":53966,"_3078":54260},[],"**Include Enrollment CA**",{"_3627":1065,"_31174":949,"_21594":54262,"_5":14861,"_28366":53966,"_3078":54263},[],"Selected issuing CA certificate.",{"_3627":1066,"_31174":949,"_21594":54265,"_5":14861,"_28366":53966,"_3078":54266},[],"**Managed CAs**",{"_3627":1067,"_31174":949,"_21594":54268,"_5":14861,"_28366":53966,"_3078":54269},[],"Explicitly selected CA certificates.",{"_3627":1068,"_31174":949,"_21594":54271,"_5":14861,"_28366":53966,"_3078":54272},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3627":1069,"_31174":949,"_21594":54274,"_5":14861,"_28366":53970,"_3078":54275},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3627":1070,"_31174":949,"_21594":54277,"_5":14861,"_28366":53970,"_3078":54278},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3627":1071,"_31174":949,"_21594":54280,"_5":14861,"_28366":53970,"_3078":54281},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3627":1072,"_31174":949,"_21594":54283,"_5":14861,"_28366":53974,"_3078":54284},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3627":1073,"_31174":1073,"_5":15221,"_3078":54286,"_31533":54287,"_21594":54288,"_28366":1073},"Integrate the EST client",[50951,52463,53635,53633,53819],[],{"_3627":1074,"_31174":1073,"_21594":54290,"_5":14861,"_28366":1073,"_3078":54291},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3627":1075,"_31174":1073,"_5":31530,"_21594":54293,"_28366":54294,"_3078":50961},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3627":1076,"_31174":1073,"_5":31530,"_21594":54296,"_28366":54297,"_3078":54298},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3627":1077,"_31174":1073,"_5":31530,"_21594":54300,"_28366":54301,"_3078":54302},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3627":1078,"_31174":1073,"_5":31530,"_21594":54304,"_28366":54305,"_3078":54306},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3627":1079,"_31174":1073,"_5":31530,"_21594":54308,"_28366":54309,"_3078":54310},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3627":1080,"_31174":1073,"_5":31530,"_21594":54312,"_28366":54313,"_3078":54314},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3627":1081,"_31174":1073,"_21594":54316,"_5":14861,"_28366":1073,"_3078":54317},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3627":1082,"_31174":1073,"_21594":54319,"_5":14861,"_28366":54294,"_3078":54320},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3627":1083,"_31174":1073,"_21594":54322,"_5":14861,"_28366":54294,"_3078":54323},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3627":1084,"_31174":1073,"_21594":54325,"_5":14861,"_28366":54294,"_3078":54326},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3627":1085,"_31174":1073,"_21594":54328,"_5":14861,"_28366":54297,"_3078":54329},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3627":1086,"_31174":1073,"_21594":54331,"_5":14861,"_28366":54297,"_3078":54332},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3627":1087,"_31174":1073,"_21594":54334,"_5":14861,"_28366":54301,"_3078":54335},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3627":1088,"_31174":1073,"_21594":54337,"_5":14861,"_28366":54301,"_3078":54338},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3627":1089,"_31174":1073,"_21594":54340,"_5":14861,"_28366":54305,"_3078":54341},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3627":1090,"_31174":1073,"_21594":54343,"_5":14861,"_28366":54305,"_3078":54344},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3627":1091,"_31174":1073,"_21594":54346,"_5":14861,"_28366":54309,"_3078":54347},[],"For a root that issues directly:",{"_3627":1092,"_31174":1073,"_21594":54349,"_5":14861,"_28366":54309,"_3078":54350},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3627":1093,"_31174":1073,"_21594":54352,"_5":14861,"_28366":54309,"_3078":54353},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3627":1094,"_31174":1073,"_21594":54355,"_5":14861,"_28366":54313,"_3078":54356},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3627":1095,"_31174":1095,"_5":15221,"_3078":54358,"_31533":54359,"_21594":54360,"_28366":1095},"EST reference",[50951,52463,53635,53633,53819],[],{"_3627":1096,"_31174":1095,"_21594":54362,"_5":14861,"_28366":1095,"_3078":54363},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3627":1097,"_31174":1095,"_5":31530,"_21594":54365,"_28366":54366,"_3078":54367},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3627":1098,"_31174":1095,"_5":31530,"_21594":54369,"_28366":54370,"_3078":23396},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3627":1099,"_31174":1095,"_5":31530,"_21594":54372,"_28366":54373,"_3078":26911},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3627":1100,"_31174":1095,"_5":31530,"_21594":54375,"_28366":54376,"_3078":26918},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3627":1101,"_31174":1095,"_5":31530,"_21594":54378,"_28366":54379,"_3078":26180},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3627":1102,"_31174":1095,"_5":31530,"_21594":54381,"_28366":54382,"_3078":54383},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3627":1103,"_31174":1095,"_5":31530,"_21594":54385,"_28366":54386,"_3078":54387},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3627":1104,"_31174":1095,"_5":31530,"_21594":54389,"_28366":54390,"_3078":54391},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3627":1105,"_31174":1095,"_21594":54393,"_5":14861,"_28366":1095,"_3078":54394},[],"Reference for the Lamassu EST service, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3627":1106,"_31174":1095,"_21594":54396,"_5":14861,"_28366":54366,"_3078":54397},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3627":1107,"_31174":1095,"_21594":54399,"_5":14861,"_28366":54366,"_3078":54400},[],"Operation",{"_3627":1108,"_31174":1095,"_21594":54402,"_5":14861,"_28366":54366,"_3078":54403},[],"Method",{"_3627":1109,"_31174":1095,"_21594":54405,"_5":14861,"_28366":54366,"_3078":54406},[],"Authentication and condition",{"_3627":1110,"_31174":1095,"_21594":54408,"_5":14861,"_28366":54366,"_3078":54409},[],"`/cacerts`",{"_3627":1111,"_31174":1095,"_21594":54411,"_5":14861,"_28366":54366,"_3078":54412},[],"GET",{"_3627":1112,"_31174":1095,"_21594":54414,"_5":14861,"_28366":54366,"_3078":54415},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3627":1113,"_31174":1095,"_21594":54417,"_5":14861,"_28366":54366,"_3078":54418},[],"`/simpleenroll`",{"_3627":1114,"_31174":1095,"_21594":54420,"_5":14861,"_28366":54366,"_3078":54421},[],"POST",{"_3627":1115,"_31174":1095,"_21594":54423,"_5":14861,"_28366":54366,"_3078":54424},[],"Initial authentication and DMS registration/replacement policy.",{"_3627":1116,"_31174":1095,"_21594":54426,"_5":14861,"_28366":54366,"_3078":54427},[],"`/simplereenroll`",{"_3627":1117,"_31174":1095,"_21594":54429,"_5":14861,"_28366":54366,"_3078":54421},[],{"_3627":1118,"_31174":1095,"_21594":54431,"_5":14861,"_28366":54366,"_3078":54432},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3627":1119,"_31174":1095,"_21594":54434,"_5":14861,"_28366":54366,"_3078":54435},[],"`/serverkeygen`",{"_3627":1120,"_31174":1095,"_21594":54437,"_5":14861,"_28366":54366,"_3078":54421},[],{"_3627":1121,"_31174":1095,"_21594":54439,"_5":14861,"_28366":54366,"_3078":54440},[],"Initial authentication and admission; server generation enabled.",{"_3627":1122,"_31174":1095,"_21594":54442,"_5":14861,"_28366":54366,"_3078":54443},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3627":1123,"_31174":1095,"_21594":54445,"_5":14861,"_28366":54370,"_3078":54446},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3627":1124,"_31174":1095,"_21594":54448,"_5":14861,"_28366":54370,"_3078":54449},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3627":1125,"_31174":1095,"_21594":54451,"_5":14861,"_28366":54373,"_3078":54452},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3627":1126,"_31174":1095,"_21594":54454,"_5":14861,"_28366":54373,"_3078":54455},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3627":1127,"_31174":1095,"_21594":54457,"_5":14861,"_28366":54376,"_3078":54458},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3627":1128,"_31174":1095,"_21594":54460,"_5":14861,"_28366":54376,"_3078":54461},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. With default settings, a client certificate whose revocation cannot be verified is also rejected; the DMS guide describes `allow_unverifiable_revocation`. See Renewal for installation and recovery.",{"_3627":1129,"_31174":1095,"_21594":54463,"_5":14861,"_28366":54379,"_3078":54464},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3627":1130,"_31174":1095,"_21594":54466,"_5":14861,"_28366":54379,"_3078":54467},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3627":1131,"_31174":1095,"_21594":54469,"_5":14861,"_28366":54382,"_3078":54470},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3627":1132,"_31174":1095,"_21594":54472,"_5":14861,"_28366":54382,"_3078":54473},[],"Part",{"_3627":1133,"_31174":1095,"_21594":54475,"_5":14861,"_28366":54382,"_3078":54476},[],"Content after decoding its Base64",{"_3627":1134,"_31174":1095,"_21594":54478,"_5":14861,"_28366":54382,"_3078":54479},[],"`application/pkcs8`",{"_3627":1135,"_31174":1095,"_21594":54481,"_5":14861,"_28366":54382,"_3078":54482},[],"Unencrypted DER PKCS#8 private key.",{"_3627":1136,"_31174":1095,"_21594":54484,"_5":14861,"_28366":54382,"_3078":54485},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3627":1137,"_31174":1095,"_21594":54487,"_5":14861,"_28366":54382,"_3078":54488},[],"DER PKCS#7 containing the issued certificate.",{"_3627":1138,"_31174":1095,"_21594":54490,"_5":14861,"_28366":54382,"_3078":54491},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3627":1139,"_31174":1095,"_21594":54493,"_5":14861,"_28366":54386,"_3078":54494},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3627":1140,"_31174":1095,"_21594":54496,"_5":14861,"_28366":54386,"_3078":54497},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3627":1141,"_31174":1095,"_21594":54499,"_5":14861,"_28366":54386,"_3078":54500},[],"Convert and check the result:",{"_3627":1142,"_31174":1095,"_21594":54502,"_5":14861,"_28366":54386,"_3078":54503},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3627":1143,"_31174":1095,"_21594":54505,"_5":14861,"_28366":54390,"_3078":54506},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3627":1144,"_31174":1095,"_21594":54508,"_5":14861,"_28366":54390,"_3078":54509},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3627":1145,"_31174":1145,"_5":15221,"_3078":53819,"_31533":54511,"_21594":54512,"_28366":1145},[50951,52463,53635,53633,53819],[],{"_3627":1146,"_31174":1145,"_21594":54514,"_5":14861,"_28366":1145,"_3078":54515},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3627":1147,"_31174":1145,"_5":31530,"_21594":54517,"_28366":54518,"_3078":54519},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3627":1148,"_31174":1145,"_5":31530,"_21594":54521,"_28366":54522,"_3078":54523},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3627":1149,"_31174":1145,"_5":31530,"_21594":54525,"_28366":54526,"_3078":54527},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3627":1150,"_31174":1145,"_21594":54529,"_5":14861,"_28366":1145,"_3078":54530},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3627":1151,"_31174":1145,"_21594":54532,"_5":14861,"_28366":54518,"_3078":54533},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3627":1152,"_31174":1145,"_21594":54535,"_5":14861,"_28366":54518,"_3078":54536},[],"The integrator installs initial EST server trust and an admission credential.",{"_3627":1153,"_31174":1145,"_21594":54538,"_5":14861,"_28366":54518,"_3078":54539},[],"The client requests an identity for its `Device ID` through EST.",{"_3627":1154,"_31174":1145,"_21594":54541,"_5":14861,"_28366":54518,"_3078":54542},[],"Certificate, device binding and key/certificate installation are checked.",{"_3627":1155,"_31174":1145,"_21594":54544,"_5":14861,"_28366":54518,"_3078":54545},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3627":1156,"_31174":1145,"_21594":54547,"_5":14861,"_28366":54518,"_3078":54548},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3627":1157,"_31174":1145,"_21594":54550,"_5":14861,"_28366":54522,"_3078":54551},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3627":1158,"_31174":1145,"_21594":54553,"_5":14861,"_28366":54522,"_3078":54554},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3627":1159,"_31174":1145,"_21594":54556,"_5":14861,"_28366":54522,"_3078":54557},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3627":1160,"_31174":1145,"_21594":54559,"_5":14861,"_28366":54522,"_3078":54560},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3627":1161,"_31174":1145,"_21594":54562,"_5":14861,"_28366":54526,"_3078":54563},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3627":1162,"_31174":1145,"_21594":54565,"_5":14861,"_28366":54526,"_3078":54566},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3627":1163,"_31174":1145,"_21594":54568,"_5":14861,"_28366":54526,"_3078":54569},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3627":1164,"_31174":1145,"_21594":54571,"_5":14861,"_28366":54526,"_3078":54572},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3627":1165,"_31174":1145,"_21594":54574,"_5":14861,"_28366":54526,"_3078":54575},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3627":1166,"_31174":1166,"_5":15221,"_3078":54577,"_31533":54578,"_21594":54579,"_28366":1166},"Provisioning strategies",[50951,52463,53635,53633,53819],[],{"_3627":1167,"_31174":1166,"_21594":54581,"_5":14861,"_28366":1166,"_3078":54582},[],"Choose device registration, identity authorization and key generation.",{"_3627":1168,"_31174":1166,"_5":31530,"_21594":54584,"_28366":54585,"_3078":54586},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3627":1169,"_31174":1166,"_5":31530,"_21594":54588,"_28366":54589,"_3078":54590},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3627":1170,"_31174":1166,"_5":31530,"_21594":54592,"_28366":54593,"_3078":54594},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3627":1171,"_31174":1166,"_5":31530,"_21594":54596,"_28366":54597,"_3078":54598},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3627":1172,"_31174":1166,"_5":31530,"_21594":54600,"_28366":54601,"_3078":54602},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3627":1173,"_31174":1166,"_21594":54604,"_5":14861,"_28366":1166,"_3078":54605},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3627":1174,"_31174":1166,"_21594":54607,"_5":14861,"_28366":54585,"_3078":54608},[],"Path",{"_3627":1175,"_31174":1166,"_21594":54610,"_5":14861,"_28366":54585,"_3078":54611},[],"When the device exists",{"_3627":1176,"_31174":1166,"_21594":54613,"_5":14861,"_28366":54585,"_3078":54614},[],"What to check",{"_3627":1177,"_31174":1166,"_21594":54616,"_5":14861,"_28366":54585,"_3078":54617},[],"Manual assignment",{"_3627":1178,"_31174":1166,"_21594":54619,"_5":14861,"_28366":54585,"_3078":54620},[],"An operator creates it before associating a certificate.",{"_3627":1179,"_31174":1166,"_21594":54622,"_5":14861,"_28366":54585,"_3078":54623},[],"ID, owning DMS, certificate CN and bound serial.",{"_3627":1180,"_31174":1166,"_21594":54625,"_5":14861,"_28366":54585,"_3078":54626},[],"EST with `JITP`",{"_3627":1181,"_31174":1166,"_21594":54628,"_5":14861,"_28366":54585,"_3078":54629},[],"Created for an unknown CN during `/simpleenroll`.",{"_3627":1182,"_31174":1166,"_21594":54631,"_5":14861,"_28366":54585,"_3078":54632},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3627":1183,"_31174":1166,"_21594":54634,"_5":14861,"_28366":54585,"_3078":54635},[],"EST with `PRE_REGISTRATION`",{"_3627":1184,"_31174":1166,"_21594":54637,"_5":14861,"_28366":54585,"_3078":54638},[],"Must exist before `/simpleenroll`.",{"_3627":1185,"_31174":1166,"_21594":54640,"_5":14861,"_28366":54585,"_3078":54641},[],"Approved record, same DMS and replacement conditions for your version.",{"_3627":1186,"_31174":1166,"_21594":54643,"_5":14861,"_28366":54585,"_3078":54644},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3627":1187,"_31174":1166,"_21594":54646,"_5":14861,"_28366":54585,"_3078":54647},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3627":1188,"_31174":1166,"_21594":54649,"_5":14861,"_28366":54589,"_3078":54650},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3627":1189,"_31174":1166,"_21594":54652,"_5":14861,"_28366":54589,"_3078":54653},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3627":1190,"_31174":1166,"_21594":54655,"_5":14861,"_28366":54589,"_3078":54656},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3627":1191,"_31174":1166,"_21594":54658,"_5":14861,"_28366":54593,"_3078":54659},[],"Decide initial enrollment and re-enrollment separately:",{"_3627":1192,"_31174":1166,"_21594":54661,"_5":14861,"_28366":54593,"_3078":54662},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3627":1193,"_31174":1166,"_21594":54664,"_5":14861,"_28366":54593,"_3078":54665},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3627":1194,"_31174":1166,"_21594":54667,"_5":14861,"_28366":54593,"_3078":54668},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3627":1195,"_31174":1166,"_21594":54670,"_5":14861,"_28366":54593,"_3078":54671},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3627":1196,"_31174":1166,"_21594":54673,"_5":14861,"_28366":54593,"_3078":54674},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3627":1197,"_31174":1166,"_21594":54676,"_5":14861,"_28366":54597,"_3078":51335},[],{"_3627":1198,"_31174":1166,"_21594":54678,"_5":14861,"_28366":54597,"_3078":54679},[],"Material crossing EST",{"_3627":1199,"_31174":1166,"_21594":54681,"_5":14861,"_28366":54597,"_3078":54682},[],"Device-generated key",{"_3627":1200,"_31174":1166,"_21594":54684,"_5":14861,"_28366":54597,"_3078":54685},[],"Public CSR and certificate; the key stays on the client.",{"_3627":1201,"_31174":1166,"_21594":54687,"_5":14861,"_28366":54597,"_3078":54688},[],"Existing device key",{"_3627":1202,"_31174":1166,"_21594":54690,"_5":14861,"_28366":54597,"_3078":54691},[],"CSR signed with that key and a new certificate.",{"_3627":1203,"_31174":1166,"_21594":54693,"_5":14861,"_28366":54597,"_3078":53963},[],{"_3627":1204,"_31174":1166,"_21594":54695,"_5":14861,"_28366":54597,"_3078":54696},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3627":1205,"_31174":1166,"_21594":54698,"_5":14861,"_28366":54597,"_3078":54699},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3627":1206,"_31174":1166,"_21594":54701,"_5":14861,"_28366":54601,"_3078":54702},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3627":1207,"_31174":1207,"_5":15221,"_3078":54704,"_31533":54705,"_21594":54706,"_28366":1207},"Renewal and recovery",[50951,52463,53635,53633,53819],[],{"_3627":1208,"_31174":1207,"_21594":54708,"_5":14861,"_28366":1207,"_3078":54709},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3627":1209,"_31174":1207,"_5":31530,"_21594":54711,"_28366":54712,"_3078":54713},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3627":1210,"_31174":1207,"_5":31530,"_21594":54715,"_28366":54716,"_3078":54717},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3627":1211,"_31174":1207,"_5":31530,"_21594":54719,"_28366":54720,"_3078":54721},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3627":1212,"_31174":1207,"_5":31530,"_21594":54723,"_28366":54724,"_3078":54725},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3627":1213,"_31174":1207,"_5":31530,"_21594":54727,"_28366":54728,"_3078":54729},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3627":1214,"_31174":1207,"_21594":54731,"_5":14861,"_28366":1207,"_3078":54732},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3627":1215,"_31174":1207,"_21594":54734,"_5":14861,"_28366":54712,"_3078":54735},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3627":1216,"_31174":1207,"_21594":54737,"_5":14861,"_28366":54712,"_3078":54738},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3627":1217,"_31174":1207,"_21594":54740,"_5":14861,"_28366":54712,"_3078":54741},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3627":1218,"_31174":1207,"_21594":54743,"_5":14861,"_28366":54712,"_3078":54744},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3627":1219,"_31174":1207,"_21594":54746,"_5":14861,"_28366":54716,"_3078":54747},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3627":1220,"_31174":1207,"_21594":54749,"_5":14861,"_28366":54716,"_3078":54750},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3627":1221,"_31174":1207,"_21594":54752,"_5":14861,"_28366":54720,"_3078":54753},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3627":1222,"_31174":1207,"_21594":54755,"_5":14861,"_28366":54720,"_3078":54756},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3627":1223,"_31174":1207,"_21594":54758,"_5":14861,"_28366":54720,"_3078":54759},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3627":1224,"_31174":1207,"_21594":54761,"_5":14861,"_28366":54724,"_3078":54762},[],"Situation",{"_3627":1225,"_31174":1207,"_21594":54764,"_5":14861,"_28366":54724,"_3078":54765},[],"Procedure",{"_3627":1226,"_31174":1207,"_21594":54767,"_5":14861,"_28366":54724,"_3078":54768},[],"Valid certificate, outside the window",{"_3627":1227,"_31174":1207,"_21594":54770,"_5":14861,"_28366":54724,"_3078":54771},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3627":1228,"_31174":1207,"_21594":54773,"_5":14861,"_28366":54724,"_3078":54774},[],"Expired certificate, key available",{"_3627":1229,"_31174":1207,"_21594":54776,"_5":14861,"_28366":54724,"_3078":54777},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3627":1230,"_31174":1207,"_21594":54779,"_5":14861,"_28366":54724,"_3078":54780},[],"Renewal through webhook or `NO_AUTH`",{"_3627":1231,"_31174":1207,"_21594":54782,"_5":14861,"_28366":54724,"_3078":54783},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3627":1232,"_31174":1207,"_21594":54785,"_5":14861,"_28366":54724,"_3078":54786},[],"Lost or inaccessible key",{"_3627":1233,"_31174":1207,"_21594":54788,"_5":14861,"_28366":54724,"_3078":54789},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3627":1234,"_31174":1207,"_21594":54791,"_5":14861,"_28366":54724,"_3078":54792},[],"Current identity revoked",{"_3627":1235,"_31174":1207,"_21594":54794,"_5":14861,"_28366":54724,"_3078":54795},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3627":1236,"_31174":1207,"_21594":54797,"_5":14861,"_28366":54724,"_3078":54798},[],"Device without an identity",{"_3627":1237,"_31174":1207,"_21594":54800,"_5":14861,"_28366":54724,"_3078":54801},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3627":1238,"_31174":1207,"_21594":54803,"_5":14861,"_28366":54724,"_3078":54804},[],"Retired device",{"_3627":1239,"_31174":1207,"_21594":54806,"_5":14861,"_28366":54724,"_3078":54807},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3627":1240,"_31174":1207,"_21594":54809,"_5":14861,"_28366":54724,"_3078":54810},[],"Timeout, HTTP 500 or installation failure",{"_3627":1241,"_31174":1207,"_21594":54812,"_5":14861,"_28366":54724,"_3078":54813},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3627":1242,"_31174":1207,"_21594":54815,"_5":14861,"_28366":54728,"_3078":54816},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3627":1243,"_31174":1207,"_21594":54818,"_5":14861,"_28366":54728,"_3078":54819},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3627":1244,"_31174":1244,"_5":15221,"_3078":54821,"_31533":54822,"_21594":54823,"_28366":1244},"Enrollment troubleshooting",[50951,52463,53635,53633,53819],[],{"_3627":1245,"_31174":1244,"_21594":54825,"_5":14861,"_28366":1244,"_3078":54826},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3627":1246,"_31174":1244,"_5":31530,"_21594":54828,"_28366":54829,"_3078":54830},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3627":1247,"_31174":1244,"_5":31530,"_21594":54832,"_28366":54833,"_3078":54834},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3627":1248,"_31174":1244,"_5":31530,"_21594":54836,"_28366":54837,"_3078":54391},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3627":1249,"_31174":1244,"_5":31530,"_21594":54839,"_28366":54840,"_3078":54841},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3627":1250,"_31174":1244,"_21594":54843,"_5":14861,"_28366":1244,"_3078":54844},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3627":1251,"_31174":1244,"_21594":54846,"_5":14861,"_28366":54833,"_3078":54847},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3627":1252,"_31174":1244,"_21594":54849,"_5":14861,"_28366":54833,"_3078":54850},[],"Symptom or message",{"_3627":1253,"_31174":1244,"_21594":54852,"_5":14861,"_28366":54833,"_3078":54614},[],{"_3627":1254,"_31174":1244,"_21594":54854,"_5":14861,"_28366":54833,"_3078":54855},[],"curl rejects TLS, name or issuer",{"_3627":1255,"_31174":1244,"_21594":54857,"_5":14861,"_28366":54833,"_3078":54858},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3627":1256,"_31174":1244,"_21594":54860,"_5":14861,"_28366":54833,"_3078":54861},[],"404 or missing APS",{"_3627":1257,"_31174":1244,"_21594":54863,"_5":14861,"_28366":54833,"_3078":54864},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3627":1258,"_31174":1244,"_21594":54866,"_5":14861,"_28366":54833,"_3078":54867},[],"400, CSR or format error",{"_3627":1259,"_31174":1244,"_21594":54869,"_5":14861,"_28366":54833,"_3078":54870},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3627":1260,"_31174":1244,"_21594":54872,"_5":14861,"_28366":54833,"_3078":54873},[],"Missing credential or invalid certificate",{"_3627":1261,"_31174":1244,"_21594":54875,"_5":14861,"_28366":54833,"_3078":54876},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3627":1262,"_31174":1244,"_21594":54878,"_5":14861,"_28366":54833,"_3078":54879},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3627":1263,"_31174":1244,"_21594":54881,"_5":14861,"_28366":54833,"_3078":54882},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3627":1264,"_31174":1244,"_21594":54884,"_5":14861,"_28366":54833,"_3078":54885},[],"Webhook denies, times out or responds without authorization",{"_3627":1265,"_31174":1244,"_21594":54887,"_5":14861,"_28366":54833,"_3078":54888},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3627":1266,"_31174":1244,"_21594":54890,"_5":14861,"_28366":54833,"_3078":54891},[],"`unexpected status code: <n>: redirects are not followed`",{"_3627":1267,"_31174":1244,"_21594":54893,"_5":14861,"_28366":54833,"_3078":54894},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3627":1268,"_31174":1244,"_21594":54896,"_5":14861,"_28366":54833,"_3078":54897},[],"`webhook response exceeds 1048576 bytes`",{"_3627":1269,"_31174":1244,"_21594":54899,"_5":14861,"_28366":54833,"_3078":54900},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3627":1270,"_31174":1244,"_21594":54902,"_5":14861,"_28366":54833,"_3078":54903},[],"`webhook config must not reference files`",{"_3627":1271,"_31174":1244,"_21594":54905,"_5":14861,"_28366":54833,"_3078":54906},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3627":1272,"_31174":1244,"_21594":54908,"_5":14861,"_28366":54833,"_3078":54909},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3627":1273,"_31174":1244,"_21594":54911,"_5":14861,"_28366":54833,"_3078":54912},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3627":1274,"_31174":1244,"_21594":54914,"_5":14861,"_28366":54833,"_3078":54915},[],"`webhook mTLS certificate and key are invalid: …`",{"_3627":1275,"_31174":1244,"_21594":54917,"_5":14861,"_28366":54833,"_3078":54918},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3627":1276,"_31174":1244,"_21594":54920,"_5":14861,"_28366":54833,"_3078":54921},[],"400 `struct validation error` creating or updating a DMS",{"_3627":1277,"_31174":1244,"_21594":54923,"_5":14861,"_28366":54833,"_3078":54924},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3627":1278,"_31174":1244,"_21594":54926,"_5":14861,"_28366":54833,"_3078":54927},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3627":1279,"_31174":1244,"_21594":54929,"_5":14861,"_28366":54833,"_3078":54930},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3627":1280,"_31174":1244,"_21594":54932,"_5":14861,"_28366":54833,"_3078":54933},[],"`device not preregistered`",{"_3627":1281,"_31174":1244,"_21594":54935,"_5":14861,"_28366":54833,"_3078":54936},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3627":1282,"_31174":1244,"_21594":54938,"_5":14861,"_28366":54833,"_3078":54939},[],"`forbiddenNewEnrollment`",{"_3627":1283,"_31174":1244,"_21594":54941,"_5":14861,"_28366":54833,"_3078":54942},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3627":1284,"_31174":1244,"_21594":54944,"_5":14861,"_28366":54833,"_3078":54945},[],"Different owning DMS",{"_3627":1285,"_31174":1244,"_21594":54947,"_5":14861,"_28366":54833,"_3078":54948},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3627":1286,"_31174":1244,"_21594":54950,"_5":14861,"_28366":54833,"_3078":54951},[],"`invalid RawSubject bytes`",{"_3627":1287,"_31174":1244,"_21594":54953,"_5":14861,"_28366":54833,"_3078":54954},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3627":1288,"_31174":1244,"_21594":54956,"_5":14861,"_28366":54833,"_3078":54957},[],"`invalid reenroll window`",{"_3627":1289,"_31174":1244,"_21594":54959,"_5":14861,"_28366":54833,"_3078":54960},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3627":1290,"_31174":1244,"_21594":54962,"_5":14861,"_28366":54833,"_3078":54963},[],"Current certificate revoked",{"_3627":1291,"_31174":1244,"_21594":54965,"_5":14861,"_28366":54833,"_3078":54966},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3627":1292,"_31174":1244,"_21594":54968,"_5":14861,"_28366":54833,"_3078":54969},[],"CA, profile or signing error",{"_3627":1293,"_31174":1244,"_21594":54971,"_5":14861,"_28366":54833,"_3078":54972},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3627":1294,"_31174":1244,"_21594":54974,"_5":14861,"_28366":54833,"_3078":54975},[],"HTTP 200 without a device connection",{"_3627":1295,"_31174":1244,"_21594":54977,"_5":14861,"_28366":54833,"_3078":54978},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3627":1296,"_31174":1244,"_21594":54980,"_5":14861,"_28366":54833,"_3078":54981},[],"Timeout or error after issuance",{"_3627":1297,"_31174":1244,"_21594":54983,"_5":14861,"_28366":54833,"_3078":54984},[],"New certificates, current slot and previous identity's state before retrying.",{"_3627":1298,"_31174":1244,"_21594":54986,"_5":14861,"_28366":54837,"_3078":54987},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3627":1299,"_31174":1244,"_21594":54989,"_5":14861,"_28366":54837,"_3078":54990},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3627":1300,"_31174":1244,"_21594":54992,"_5":14861,"_28366":54840,"_3078":54993},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3627":1301,"_31174":1244,"_21594":54995,"_5":14861,"_28366":54840,"_3078":54996},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3627":1302,"_31174":1244,"_21594":54998,"_5":14861,"_28366":54840,"_3078":54999},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3627":1303,"_31174":1244,"_21594":55001,"_5":14861,"_28366":54840,"_3078":55002},[],"Make one request, save headers/body and query the device and certificates.",{"_3627":1304,"_31174":1244,"_21594":55004,"_5":14861,"_28366":54840,"_3078":55005},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3627":1305,"_31174":1244,"_21594":55007,"_5":14861,"_28366":54840,"_3078":55008},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified — including an OCSP Unknown status — is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3627":1306,"_31174":1244,"_21594":55010,"_5":14861,"_28366":54840,"_3078":55011},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3627":1307,"_31174":1307,"_5":15221,"_3078":55013,"_31533":55014,"_21594":55015,"_28366":1307},"Trust distribution and updates",[50951,52463,53635,53633,53819],[],{"_3627":1308,"_31174":1307,"_21594":55017,"_5":14861,"_28366":1307,"_3078":55018},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3627":1309,"_31174":1307,"_5":31530,"_21594":55020,"_28366":55021,"_3078":55022},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3627":1310,"_31174":1307,"_5":31530,"_21594":55024,"_28366":55025,"_3078":55026},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3627":1311,"_31174":1307,"_5":31530,"_21594":55028,"_28366":55029,"_3078":55030},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3627":1312,"_31174":1307,"_5":31530,"_21594":55032,"_28366":55033,"_3078":55034},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3627":1313,"_31174":1307,"_5":31530,"_21594":55036,"_28366":55037,"_3078":55038},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3627":1314,"_31174":1307,"_21594":55040,"_5":14861,"_28366":1307,"_3078":55041},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3627":1315,"_31174":1307,"_21594":55043,"_5":14861,"_28366":55021,"_3078":55044},[],"Relationship",{"_3627":1316,"_31174":1307,"_21594":55046,"_5":14861,"_28366":55021,"_3078":55047},[],"Material prepared by its owner",{"_3627":1317,"_31174":1307,"_21594":55049,"_5":14861,"_28366":55021,"_3078":55050},[],"Device → EST server",{"_3627":1318,"_31174":1307,"_21594":55052,"_5":14861,"_28366":55021,"_3078":55053},[],"Previously verified server root, chain or pin and TLS name.",{"_3627":1319,"_31174":1307,"_21594":55055,"_5":14861,"_28366":55021,"_3078":55056},[],"DMS → requester",{"_3627":1320,"_31174":1307,"_21594":55058,"_5":14861,"_28366":55021,"_3078":55059},[],"CAs and rules authorizing initial or renewal credentials.",{"_3627":1321,"_31174":1307,"_21594":55061,"_5":14861,"_28366":55021,"_3078":55062},[],"Consumer → device",{"_3627":1322,"_31174":1307,"_21594":55064,"_5":14861,"_28366":55021,"_3078":55065},[],"Operational identity roots, intermediates, validation and permissions.",{"_3627":1323,"_31174":1307,"_21594":55067,"_5":14861,"_28366":55021,"_3078":55068},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3627":1324,"_31174":1307,"_21594":55070,"_5":14861,"_28366":55025,"_3078":55071},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3627":1325,"_31174":1307,"_21594":55073,"_5":14861,"_28366":55025,"_3078":55074},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3627":1326,"_31174":1307,"_21594":55076,"_5":14861,"_28366":55029,"_3078":55077},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3627":1327,"_31174":1307,"_21594":55079,"_5":14861,"_28366":55029,"_3078":55080},[],"Select policy-approved roots as anchors.",{"_3627":1328,"_31174":1307,"_21594":55082,"_5":14861,"_28366":55029,"_3078":55083},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3627":1329,"_31174":1307,"_21594":55085,"_5":14861,"_28366":55029,"_3078":55086},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3627":1330,"_31174":1307,"_21594":55088,"_5":14861,"_28366":55029,"_3078":55089},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3627":1331,"_31174":1307,"_21594":55091,"_5":14861,"_28366":55029,"_3078":55092},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3627":1332,"_31174":1307,"_21594":55094,"_5":14861,"_28366":55033,"_3078":55095},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3627":1333,"_31174":1307,"_21594":55097,"_5":14861,"_28366":55033,"_3078":55098},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3627":1334,"_31174":1307,"_21594":55100,"_5":14861,"_28366":55033,"_3078":55101},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3627":1335,"_31174":1307,"_21594":55103,"_5":14861,"_28366":55037,"_3078":55104},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3627":1336,"_31174":1336,"_5":15221,"_3078":55106,"_31533":55107,"_21594":55109,"_28366":1336},"AWS IoT Core",[50951,52463,53635,53633,55108],"Integrations",[],{"_3627":1337,"_31174":1336,"_21594":55111,"_5":14861,"_28366":1336,"_3078":55112},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3627":1338,"_31174":1336,"_5":31530,"_21594":55114,"_28366":55115,"_3078":55116},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3627":1339,"_31174":1336,"_5":31530,"_21594":55118,"_28366":55119,"_3078":55120},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3627":1340,"_31174":1336,"_5":31530,"_21594":55122,"_28366":55123,"_3078":55124},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3627":1341,"_31174":1336,"_5":31530,"_21594":55126,"_28366":55127,"_3078":55128},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3627":1342,"_31174":1336,"_5":31530,"_21594":55130,"_28366":55131,"_3078":55132},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3627":1343,"_31174":1336,"_5":31530,"_21594":55134,"_28366":55135,"_3078":55136},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3627":1344,"_31174":1336,"_5":31530,"_21594":55138,"_28366":55139,"_3078":55140},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3627":1345,"_31174":1336,"_5":31530,"_21594":55142,"_28366":55143,"_3078":55144},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3627":1346,"_31174":1336,"_5":31530,"_21594":55146,"_28366":55147,"_3078":55148},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3627":1347,"_31174":1336,"_5":31530,"_21594":55150,"_28366":55151,"_3078":55152},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3627":1348,"_31174":1336,"_5":31530,"_21594":55154,"_28366":55155,"_3078":55156},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3627":1349,"_31174":1336,"_5":31530,"_21594":55158,"_28366":55159,"_3078":55160},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3627":1350,"_31174":1336,"_5":31530,"_21594":55162,"_28366":55163,"_3078":55164},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3627":1351,"_31174":1336,"_5":31530,"_21594":55166,"_28366":55167,"_3078":55168},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3627":1352,"_31174":1336,"_5":31530,"_21594":55170,"_28366":55171,"_3078":55172},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3627":1353,"_31174":1336,"_5":31530,"_21594":55174,"_28366":55175,"_3078":55176},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3627":1354,"_31174":1336,"_5":31530,"_21594":55178,"_28366":55179,"_3078":55180},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3627":1355,"_31174":1336,"_5":31530,"_21594":55182,"_28366":55183,"_3078":55184},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3627":1356,"_31174":1336,"_5":31530,"_21594":55186,"_28366":55187,"_3078":55188},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3627":1357,"_31174":1336,"_5":31530,"_21594":55190,"_28366":55191,"_3078":55192},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3627":1358,"_31174":1336,"_5":31530,"_21594":55194,"_28366":55195,"_3078":55196},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3627":1359,"_31174":1336,"_5":31530,"_21594":55198,"_28366":55199,"_3078":55200},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3627":1360,"_31174":1336,"_5":31530,"_21594":55202,"_28366":55203,"_3078":55204},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3627":1361,"_31174":1336,"_5":31530,"_21594":55206,"_28366":55207,"_3078":55208},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3627":1362,"_31174":1336,"_5":31530,"_21594":55210,"_28366":55211,"_3078":55212},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3627":1363,"_31174":1336,"_21594":55214,"_5":14861,"_28366":1336,"_3078":55215},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3627":1364,"_31174":1336,"_21594":55217,"_5":14861,"_28366":1336,"_3078":55218},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3627":1365,"_31174":1336,"_21594":55220,"_5":14861,"_28366":1336,"_3078":55221},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3627":1366,"_31174":1336,"_21594":55223,"_5":14861,"_28366":55115,"_3078":55224},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3627":1367,"_31174":1336,"_21594":55226,"_5":14861,"_28366":55115,"_3078":55227},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3627":1368,"_31174":1336,"_21594":55229,"_5":14861,"_28366":55115,"_3078":55230},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3627":1369,"_31174":1336,"_21594":55232,"_5":14861,"_28366":55115,"_3078":55233},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3627":1370,"_31174":1336,"_21594":55235,"_5":14861,"_28366":55119,"_3078":55236},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3627":1371,"_31174":1336,"_21594":55238,"_5":14861,"_28366":55123,"_3078":55239},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3627":1372,"_31174":1336,"_21594":55241,"_5":14861,"_28366":55123,"_3078":55242},[],"IAM action",{"_3627":1373,"_31174":1336,"_21594":55244,"_5":14861,"_28366":55123,"_3078":51341},[],{"_3627":1374,"_31174":1336,"_21594":55246,"_5":14861,"_28366":55123,"_3078":55247},[],"`iot:GetRegistrationCode`",{"_3627":1375,"_31174":1336,"_21594":55249,"_5":14861,"_28366":55123,"_3078":55250},[],"Obtain the verification code for CA registration in the Primary Account",{"_3627":1376,"_31174":1336,"_21594":55252,"_5":14861,"_28366":55123,"_3078":55253},[],"`iot:RegisterCACertificate`",{"_3627":1377,"_31174":1336,"_21594":55255,"_5":14861,"_28366":55123,"_3078":55256},[],"Register the CA in AWS IoT",{"_3627":1378,"_31174":1336,"_21594":55258,"_5":14861,"_28366":55123,"_3078":55259},[],"`iot:DescribeCACertificate`",{"_3627":1379,"_31174":1336,"_21594":55261,"_5":14861,"_28366":55123,"_3078":55262},[],"Check the CA registration status",{"_3627":1380,"_31174":1336,"_21594":55264,"_5":14861,"_28366":55123,"_3078":55265},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3627":1381,"_31174":1336,"_21594":55267,"_5":14861,"_28366":55123,"_3078":55268},[],"Create or update Things in IoT Core",{"_3627":1382,"_31174":1336,"_21594":55270,"_5":14861,"_28366":55123,"_3078":55271},[],"`iot:RegisterThing`",{"_3627":1383,"_31174":1336,"_21594":55273,"_5":14861,"_28366":55123,"_3078":55274},[],"Provision Things through a template",{"_3627":1384,"_31174":1336,"_21594":55276,"_5":14861,"_28366":55123,"_3078":55277},[],"`iot:RegisterCertificate`",{"_3627":1385,"_31174":1336,"_21594":55279,"_5":14861,"_28366":55123,"_3078":55280},[],"Register device certificates",{"_3627":1386,"_31174":1336,"_21594":55282,"_5":14861,"_28366":55123,"_3078":55283},[],"`iot:UpdateCertificate`",{"_3627":1387,"_31174":1336,"_21594":55285,"_5":14861,"_28366":55123,"_3078":55286},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3627":1388,"_31174":1336,"_21594":55288,"_5":14861,"_28366":55123,"_3078":55289},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3627":1389,"_31174":1336,"_21594":55291,"_5":14861,"_28366":55123,"_3078":55292},[],"Create and attach IoT policies",{"_3627":1390,"_31174":1336,"_21594":55294,"_5":14861,"_28366":55123,"_3078":55295},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3627":1391,"_31174":1336,"_21594":55297,"_5":14861,"_28366":55123,"_3078":55298},[],"Manage Thing groups",{"_3627":1392,"_31174":1336,"_21594":55300,"_5":14861,"_28366":55123,"_3078":55301},[],"`iot:CreateProvisioningTemplate`",{"_3627":1393,"_31174":1336,"_21594":55303,"_5":14861,"_28366":55123,"_3078":55304},[],"Create JITP templates",{"_3627":1394,"_31174":1336,"_21594":55306,"_5":14861,"_28366":55123,"_3078":55307},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3627":1395,"_31174":1336,"_21594":55309,"_5":14861,"_28366":55123,"_3078":55310},[],"Read and write the Device Shadow",{"_3627":1396,"_31174":1336,"_21594":55312,"_5":14861,"_28366":55123,"_3078":55313},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3627":1397,"_31174":1336,"_21594":55315,"_5":14861,"_28366":55127,"_3078":55316},[],"Parameter",{"_3627":1398,"_31174":1336,"_21594":55318,"_5":14861,"_28366":55127,"_3078":55319},[],"Type",{"_3627":1399,"_31174":1336,"_21594":55321,"_5":14861,"_28366":55127,"_3078":55322},[],"Required",{"_3627":1400,"_31174":1336,"_21594":55324,"_5":14861,"_28366":55127,"_3078":55325},[],"Description",{"_3627":1401,"_31174":1336,"_21594":55327,"_5":14861,"_28366":55127,"_3078":55328},[],"`connector_id`",{"_3627":1402,"_31174":1336,"_21594":55330,"_5":14861,"_28366":55127,"_3078":25780},[],{"_3627":1403,"_31174":1336,"_21594":55332,"_5":14861,"_28366":55127,"_3078":55333},[],"Yes",{"_3627":1404,"_31174":1336,"_21594":55335,"_5":14861,"_28366":55127,"_3078":55336},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3627":1405,"_31174":1336,"_21594":55338,"_5":14861,"_28366":55127,"_3078":55339},[],"`aws_config.region`",{"_3627":1406,"_31174":1336,"_21594":55341,"_5":14861,"_28366":55127,"_3078":25780},[],{"_3627":1407,"_31174":1336,"_21594":55343,"_5":14861,"_28366":55127,"_3078":55333},[],{"_3627":1408,"_31174":1336,"_21594":55345,"_5":14861,"_28366":55127,"_3078":55346},[],"AWS region where the connector operates.",{"_3627":1409,"_31174":1336,"_21594":55348,"_5":14861,"_28366":55127,"_3078":55349},[],"`aws_config.auth_method`",{"_3627":1410,"_31174":1336,"_21594":55351,"_5":14861,"_28366":55127,"_3078":25780},[],{"_3627":1411,"_31174":1336,"_21594":55353,"_5":14861,"_28366":55127,"_3078":55333},[],{"_3627":1412,"_31174":1336,"_21594":55355,"_5":14861,"_28366":55127,"_3078":55356},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3627":1413,"_31174":1336,"_21594":55358,"_5":14861,"_28366":55127,"_3078":55359},[],"`aws_config.access_key_id`",{"_3627":1414,"_31174":1336,"_21594":55361,"_5":14861,"_28366":55127,"_3078":25780},[],{"_3627":1415,"_31174":1336,"_21594":55363,"_5":14861,"_28366":55127,"_3078":55364},[],"Only with `auth_method=static`",{"_3627":1416,"_31174":1336,"_21594":55366,"_5":14861,"_28366":55127,"_3078":55367},[],"AWS access key.",{"_3627":1417,"_31174":1336,"_21594":55369,"_5":14861,"_28366":55127,"_3078":55370},[],"`aws_config.secret_access_key`",{"_3627":1418,"_31174":1336,"_21594":55372,"_5":14861,"_28366":55127,"_3078":25780},[],{"_3627":1419,"_31174":1336,"_21594":55374,"_5":14861,"_28366":55127,"_3078":55364},[],{"_3627":1420,"_31174":1336,"_21594":55376,"_5":14861,"_28366":55127,"_3078":55377},[],"AWS secret key.",{"_3627":1421,"_31174":1336,"_21594":55379,"_5":14861,"_28366":55127,"_3078":55380},[],"`aws_config.session_token`",{"_3627":1422,"_31174":1336,"_21594":55382,"_5":14861,"_28366":55127,"_3078":25780},[],{"_3627":1423,"_31174":1336,"_21594":55384,"_5":14861,"_28366":55127,"_3078":55385},[],"No",{"_3627":1424,"_31174":1336,"_21594":55387,"_5":14861,"_28366":55127,"_3078":55388},[],"Session token (with `auth_method=static`).",{"_3627":1425,"_31174":1336,"_21594":55390,"_5":14861,"_28366":55127,"_3078":55391},[],"`aws_config.role_arn`",{"_3627":1426,"_31174":1336,"_21594":55393,"_5":14861,"_28366":55127,"_3078":25780},[],{"_3627":1427,"_31174":1336,"_21594":55395,"_5":14861,"_28366":55127,"_3078":55396},[],"Only with `auth_method=role`",{"_3627":1428,"_31174":1336,"_21594":55398,"_5":14861,"_28366":55127,"_3078":55399},[],"ARN of the role to assume.",{"_3627":1429,"_31174":1336,"_21594":55401,"_5":14861,"_28366":55127,"_3078":55402},[],"`aws_config.endpoint_url`",{"_3627":1430,"_31174":1336,"_21594":55404,"_5":14861,"_28366":55127,"_3078":25780},[],{"_3627":1431,"_31174":1336,"_21594":55406,"_5":14861,"_28366":55127,"_3078":55385},[],{"_3627":1432,"_31174":1336,"_21594":55408,"_5":14861,"_28366":55127,"_3078":55409},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3627":1433,"_31174":1336,"_21594":55411,"_5":14861,"_28366":55127,"_3078":55412},[],"`subscriber_event_bus`",{"_3627":1434,"_31174":1336,"_21594":55414,"_5":14861,"_28366":55127,"_3078":18207},[],{"_3627":1435,"_31174":1336,"_21594":55416,"_5":14861,"_28366":55127,"_3078":55333},[],{"_3627":1436,"_31174":1336,"_21594":55418,"_5":14861,"_28366":55127,"_3078":55419},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3627":1437,"_31174":1336,"_21594":55421,"_5":14861,"_28366":55127,"_3078":55422},[],"`dms_manager_client`",{"_3627":1438,"_31174":1336,"_21594":55424,"_5":14861,"_28366":55127,"_3078":25780},[],{"_3627":1439,"_31174":1336,"_21594":55426,"_5":14861,"_28366":55127,"_3078":55333},[],{"_3627":1440,"_31174":1336,"_21594":55428,"_5":14861,"_28366":55127,"_3078":55429},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3627":1441,"_31174":1336,"_21594":55431,"_5":14861,"_28366":55127,"_3078":55432},[],"`device_manager_client`",{"_3627":1442,"_31174":1336,"_21594":55434,"_5":14861,"_28366":55127,"_3078":25780},[],{"_3627":1443,"_31174":1336,"_21594":55436,"_5":14861,"_28366":55127,"_3078":55333},[],{"_3627":1444,"_31174":1336,"_21594":55438,"_5":14861,"_28366":55127,"_3078":55439},[],"HTTP URL of Lamassu's Device Manager.",{"_3627":1445,"_31174":1336,"_21594":55441,"_5":14861,"_28366":55127,"_3078":55442},[],"`ca_client`",{"_3627":1446,"_31174":1336,"_21594":55444,"_5":14861,"_28366":55127,"_3078":25780},[],{"_3627":1447,"_31174":1336,"_21594":55446,"_5":14861,"_28366":55127,"_3078":55333},[],{"_3627":1448,"_31174":1336,"_21594":55448,"_5":14861,"_28366":55127,"_3078":55449},[],"HTTP URL of Lamassu's CA service.",{"_3627":1449,"_31174":1336,"_21594":55451,"_5":14861,"_28366":55131,"_3078":55452},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3627":1450,"_31174":1336,"_21594":55454,"_5":14861,"_28366":55131,"_3078":55455},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3627":1451,"_31174":1336,"_21594":55457,"_5":14861,"_28366":55131,"_3078":55458},[],"CloudEvent type",{"_3627":1452,"_31174":1336,"_21594":55460,"_5":14861,"_28366":55131,"_3078":55461},[],"Lamassu resource",{"_3627":1453,"_31174":1336,"_21594":55463,"_5":14861,"_28366":55131,"_3078":55464},[],"AWS Resource",{"_3627":1454,"_31174":1336,"_21594":55466,"_5":14861,"_28366":55131,"_3078":55467},[],"IAM actions",{"_3627":1455,"_31174":1336,"_21594":55469,"_5":14861,"_28366":55131,"_3078":55470},[],"AWS calls and effect",{"_3627":1456,"_31174":1336,"_21594":55472,"_5":14861,"_28366":55131,"_3078":55473},[],"Where in this page",{"_3627":1457,"_31174":1336,"_21594":55475,"_5":14861,"_28366":55131,"_3078":55476},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3627":1458,"_31174":1336,"_21594":55478,"_5":14861,"_28366":55131,"_3078":55479},[],"CA",{"_3627":1459,"_31174":1336,"_21594":55481,"_5":14861,"_28366":55131,"_3078":55482},[],"`IoTCore/CACertificate`",{"_3627":1460,"_31174":1336,"_21594":55484,"_5":14861,"_28366":55131,"_3078":55485},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3627":1461,"_31174":1336,"_21594":55487,"_5":14861,"_28366":55131,"_3078":55488},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3627":1462,"_31174":1336,"_21594":55490,"_5":14861,"_28366":55131,"_3078":55144},[],{"_3627":1463,"_31174":1336,"_21594":55492,"_5":14861,"_28366":55131,"_3078":55493},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3627":1464,"_31174":1336,"_21594":55495,"_5":14861,"_28366":55131,"_3078":55496},[],"DMS",{"_3627":1465,"_31174":1336,"_21594":55498,"_5":14861,"_28366":55131,"_3078":55499},[],"`IoTCore/ProvisioningTemplate`",{"_3627":1466,"_31174":1336,"_21594":55501,"_5":14861,"_28366":55131,"_3078":55502},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3627":1467,"_31174":1336,"_21594":55504,"_5":14861,"_28366":55131,"_3078":55505},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3627":1468,"_31174":1336,"_21594":55507,"_5":14861,"_28366":55131,"_3078":55172},[],{"_3627":1469,"_31174":1336,"_21594":55509,"_5":14861,"_28366":55131,"_3078":55510},[],"`EventBindDeviceIdentityKey`",{"_3627":1470,"_31174":1336,"_21594":55512,"_5":14861,"_28366":55131,"_3078":55513},[],"Device",{"_3627":1471,"_31174":1336,"_21594":55515,"_5":14861,"_28366":55131,"_3078":55516},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3627":1472,"_31174":1336,"_21594":55518,"_5":14861,"_28366":55131,"_3078":55519},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3627":1473,"_31174":1336,"_21594":55521,"_5":14861,"_28366":55131,"_3078":55522},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3627":1474,"_31174":1336,"_21594":55524,"_5":14861,"_28366":55131,"_3078":55180},[],{"_3627":1475,"_31174":1336,"_21594":55526,"_5":14861,"_28366":55131,"_3078":55527},[],"`EventUpdateCertificateStatusKey`",{"_3627":1476,"_31174":1336,"_21594":55529,"_5":14861,"_28366":55131,"_3078":55530},[],"Certificate",{"_3627":1477,"_31174":1336,"_21594":55532,"_5":14861,"_28366":55131,"_3078":55533},[],"`IoTCore/Certificate`",{"_3627":1478,"_31174":1336,"_21594":55535,"_5":14861,"_28366":55131,"_3078":55536},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3627":1479,"_31174":1336,"_21594":55538,"_5":14861,"_28366":55131,"_3078":55539},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3627":1480,"_31174":1336,"_21594":55541,"_5":14861,"_28366":55131,"_3078":55192},[],{"_3627":1481,"_31174":1336,"_21594":55543,"_5":14861,"_28366":55131,"_3078":55544},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3627":1482,"_31174":1336,"_21594":55546,"_5":14861,"_28366":55131,"_3078":55547},[],"Certificate / Device",{"_3627":1483,"_31174":1336,"_21594":55549,"_5":14861,"_28366":55131,"_3078":55550},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3627":1484,"_31174":1336,"_21594":55552,"_5":14861,"_28366":55131,"_3078":51347},[],{"_3627":1485,"_31174":1336,"_21594":55554,"_5":14861,"_28366":55131,"_3078":55555},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3627":1486,"_31174":1336,"_21594":55557,"_5":14861,"_28366":55131,"_3078":55200},[],{"_3627":1487,"_31174":1336,"_21594":55559,"_5":14861,"_28366":55135,"_3078":55560},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3627":1488,"_31174":1336,"_21594":55562,"_5":14861,"_28366":55139,"_3078":55563},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3627":1489,"_31174":1336,"_21594":55565,"_5":14861,"_28366":55139,"_3078":55566},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3627":1490,"_31174":1336,"_21594":55568,"_5":14861,"_28366":55143,"_3078":55569},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3627":1491,"_31174":1336,"_21594":55571,"_5":14861,"_28366":55143,"_3078":55572},[],"Transition",{"_3627":1492,"_31174":1336,"_21594":55574,"_5":14861,"_28366":55143,"_3078":55575},[],"AWS calls",{"_3627":1493,"_31174":1336,"_21594":55577,"_5":14861,"_28366":55143,"_3078":55578},[],"`NotRegistered` → `Requested`",{"_3627":1494,"_31174":1336,"_21594":55580,"_5":14861,"_28366":55143,"_3078":55581},[],"none (metadata write only)",{"_3627":1495,"_31174":1336,"_21594":55583,"_5":14861,"_28366":55143,"_3078":55584},[],"`Requested` → `Registering`",{"_3627":1496,"_31174":1336,"_21594":55586,"_5":14861,"_28366":55143,"_3078":55587},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3627":1497,"_31174":1336,"_21594":55589,"_5":14861,"_28366":55143,"_3078":55590},[],"`Registering` → `Succeeded`",{"_3627":1498,"_31174":1336,"_21594":55592,"_5":14861,"_28366":55143,"_3078":55593},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3627":1499,"_31174":1336,"_21594":55595,"_5":14861,"_28366":55143,"_3078":55596},[],"`Registering` → `Failed`",{"_3627":1500,"_31174":1336,"_21594":55598,"_5":14861,"_28366":55143,"_3078":55599},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3627":1501,"_31174":1336,"_21594":55601,"_5":14861,"_28366":55143,"_3078":55602},[],"`Failed` / `Succeeded` → `Requested`",{"_3627":1502,"_31174":1336,"_21594":55604,"_5":14861,"_28366":55143,"_3078":55605},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3627":1503,"_31174":1336,"_21594":55607,"_5":14861,"_28366":55147,"_3078":55608},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3627":1504,"_31174":1336,"_21594":55610,"_5":14861,"_28366":55147,"_3078":55611},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3627":1505,"_31174":1336,"_21594":55613,"_5":14861,"_28366":55147,"_3078":55614},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3627":1506,"_31174":1336,"_21594":55616,"_5":14861,"_28366":55147,"_3078":55617},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3627":1507,"_31174":1336,"_21594":55619,"_5":14861,"_28366":55147,"_3078":55620},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3627":1508,"_31174":1336,"_21594":55622,"_5":14861,"_28366":55147,"_3078":55623},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3627":1509,"_31174":1336,"_21594":55625,"_5":14861,"_28366":55151,"_3078":55626},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3627":1510,"_31174":1336,"_21594":55628,"_5":14861,"_28366":55155,"_3078":55629},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3627":1511,"_31174":1336,"_21594":55631,"_5":14861,"_28366":55155,"_3078":55632},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3627":1512,"_31174":1336,"_21594":55634,"_5":14861,"_28366":55159,"_3078":55635},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3627":1513,"_31174":1336,"_21594":55637,"_5":14861,"_28366":55163,"_3078":55638},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3627":1514,"_31174":1336,"_21594":55640,"_5":14861,"_28366":55163,"_3078":55641},[],"Creates or updates the IoT policies configured in the DMS.",{"_3627":1515,"_31174":1336,"_21594":55643,"_5":14861,"_28366":55163,"_3078":55644},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3627":1516,"_31174":1336,"_21594":55646,"_5":14861,"_28366":55163,"_3078":55647},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3627":1517,"_31174":1336,"_21594":55649,"_5":14861,"_28366":55163,"_3078":55650},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3627":1518,"_31174":1336,"_21594":55652,"_5":14861,"_28366":55163,"_3078":55653},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3627":1519,"_31174":1336,"_21594":55655,"_5":14861,"_28366":55163,"_3078":55656},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3627":1520,"_31174":1336,"_21594":55658,"_5":14861,"_28366":55167,"_3078":55659},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3627":1521,"_31174":1336,"_21594":55661,"_5":14861,"_28366":55167,"_3078":55662},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3627":1522,"_31174":1336,"_21594":55664,"_5":14861,"_28366":55167,"_3078":55665},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3627":1523,"_31174":1336,"_21594":55667,"_5":14861,"_28366":55167,"_3078":55668},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3627":1524,"_31174":1336,"_21594":55670,"_5":14861,"_28366":55167,"_3078":55671},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3627":1525,"_31174":1336,"_21594":55673,"_5":14861,"_28366":55171,"_3078":55674},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3627":1526,"_31174":1336,"_21594":55676,"_5":14861,"_28366":55171,"_3078":55572},[],{"_3627":1527,"_31174":1336,"_21594":55678,"_5":14861,"_28366":55171,"_3078":55575},[],{"_3627":1528,"_31174":1336,"_21594":55680,"_5":14861,"_28366":55171,"_3078":55681},[],"`Unconfigured` → `None` / `Auto`",{"_3627":1529,"_31174":1336,"_21594":55683,"_5":14861,"_28366":55171,"_3078":55684},[],"none (configuration only)",{"_3627":1530,"_31174":1336,"_21594":55686,"_5":14861,"_28366":55171,"_3078":55687},[],"`None` ↔ `Auto`",{"_3627":1531,"_31174":1336,"_21594":55689,"_5":14861,"_28366":55171,"_3078":55684},[],{"_3627":1532,"_31174":1336,"_21594":55691,"_5":14861,"_28366":55171,"_3078":55692},[],"Any → `Jitp`",{"_3627":1533,"_31174":1336,"_21594":55694,"_5":14861,"_28366":55171,"_3078":55695},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3627":1534,"_31174":1336,"_21594":55697,"_5":14861,"_28366":55171,"_3078":55698},[],"`Jitp` → `None` / `Auto`",{"_3627":1535,"_31174":1336,"_21594":55700,"_5":14861,"_28366":55171,"_3078":55701},[],"none (the template stays in the AWS account)",{"_3627":1536,"_31174":1336,"_21594":55703,"_5":14861,"_28366":55175,"_3078":55704},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3627":1537,"_31174":1336,"_21594":55706,"_5":14861,"_28366":55175,"_3078":55707},[],"The full flow from the device's perspective is:",{"_3627":1538,"_31174":1336,"_21594":55709,"_5":14861,"_28366":55175,"_3078":55710},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3627":1539,"_31174":1336,"_21594":55712,"_5":14861,"_28366":55179,"_3078":55713},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3627":1540,"_31174":1336,"_21594":55715,"_5":14861,"_28366":55179,"_3078":55572},[],{"_3627":1541,"_31174":1336,"_21594":55717,"_5":14861,"_28366":55179,"_3078":55575},[],{"_3627":1542,"_31174":1336,"_21594":55719,"_5":14861,"_28366":55179,"_3078":55720},[],"`Absent` → `Provisioned`",{"_3627":1543,"_31174":1336,"_21594":55722,"_5":14861,"_28366":55179,"_3078":55723},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3627":1544,"_31174":1336,"_21594":55725,"_5":14861,"_28366":55179,"_3078":55726},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3627":1545,"_31174":1336,"_21594":55728,"_5":14861,"_28366":55179,"_3078":55729},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3627":1546,"_31174":1336,"_21594":55731,"_5":14861,"_28366":55179,"_3078":55732},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3627":1547,"_31174":1336,"_21594":55734,"_5":14861,"_28366":55183,"_3078":55735},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3627":1548,"_31174":1336,"_21594":55737,"_5":14861,"_28366":55183,"_3078":55738},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3627":1549,"_31174":1336,"_21594":55740,"_5":14861,"_28366":55183,"_3078":55741},[],"For the JITP flow to work correctly:",{"_3627":1550,"_31174":1336,"_21594":55743,"_5":14861,"_28366":55183,"_3078":55744},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3627":1551,"_31174":1336,"_21594":55746,"_5":14861,"_28366":55183,"_3078":55747},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3627":1552,"_31174":1336,"_21594":55749,"_5":14861,"_28366":55183,"_3078":55750},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3627":1553,"_31174":1336,"_21594":55752,"_5":14861,"_28366":55183,"_3078":55753},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3627":1554,"_31174":1336,"_21594":55755,"_5":14861,"_28366":55187,"_3078":55756},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3627":1555,"_31174":1336,"_21594":55758,"_5":14861,"_28366":55187,"_3078":55759},[],"Status in Lamassu",{"_3627":1556,"_31174":1336,"_21594":55761,"_5":14861,"_28366":55187,"_3078":55762},[],"Revocation reason",{"_3627":1557,"_31174":1336,"_21594":55764,"_5":14861,"_28366":55187,"_3078":55765},[],"Status in AWS IoT Core",{"_3627":1558,"_31174":1336,"_21594":55767,"_5":14861,"_28366":55187,"_3078":55768},[],"`Active`",{"_3627":1559,"_31174":1336,"_21594":55770,"_5":14861,"_28366":55187,"_3078":55771},[],"None",{"_3627":1560,"_31174":1336,"_21594":55773,"_5":14861,"_28366":55187,"_3078":55774},[],"`ACTIVE`",{"_3627":1561,"_31174":1336,"_21594":55776,"_5":14861,"_28366":55187,"_3078":55777},[],"`Revoked`",{"_3627":1562,"_31174":1336,"_21594":55779,"_5":14861,"_28366":55187,"_3078":55780},[],"`certificateHold`",{"_3627":1563,"_31174":1336,"_21594":55782,"_5":14861,"_28366":55187,"_3078":55783},[],"`INACTIVE`",{"_3627":1564,"_31174":1336,"_21594":55785,"_5":14861,"_28366":55187,"_3078":55777},[],{"_3627":1565,"_31174":1336,"_21594":55787,"_5":14861,"_28366":55187,"_3078":55788},[],"Any other reason",{"_3627":1566,"_31174":1336,"_21594":55790,"_5":14861,"_28366":55187,"_3078":55791},[],"`REVOKED`",{"_3627":1567,"_31174":1336,"_21594":55793,"_5":14861,"_28366":55187,"_3078":55794},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3627":1568,"_31174":1336,"_21594":55796,"_5":14861,"_28366":55191,"_3078":55797},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3627":1569,"_31174":1336,"_21594":55799,"_5":14861,"_28366":55191,"_3078":55572},[],{"_3627":1570,"_31174":1336,"_21594":55801,"_5":14861,"_28366":55191,"_3078":55575},[],{"_3627":1571,"_31174":1336,"_21594":55803,"_5":14861,"_28366":55191,"_3078":55804},[],"`NotSynced` → `Active`",{"_3627":1572,"_31174":1336,"_21594":55806,"_5":14861,"_28366":55191,"_3078":55283},[],{"_3627":1573,"_31174":1336,"_21594":55808,"_5":14861,"_28366":55191,"_3078":55809},[],"`Active` → `Inactive`",{"_3627":1574,"_31174":1336,"_21594":55811,"_5":14861,"_28366":55191,"_3078":55812},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3627":1575,"_31174":1336,"_21594":55814,"_5":14861,"_28366":55191,"_3078":55815},[],"`Active` → `Revoked`",{"_3627":1576,"_31174":1336,"_21594":55817,"_5":14861,"_28366":55191,"_3078":55812},[],{"_3627":1577,"_31174":1336,"_21594":55819,"_5":14861,"_28366":55191,"_3078":55820},[],"`Inactive` / `Revoked` → `Active`",{"_3627":1578,"_31174":1336,"_21594":55822,"_5":14861,"_28366":55191,"_3078":55283},[],{"_3627":1579,"_31174":1336,"_21594":55824,"_5":14861,"_28366":55191,"_3078":55825},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3627":1580,"_31174":1336,"_21594":55827,"_5":14861,"_28366":55191,"_3078":55828},[],"none (these states are not synced to AWS)",{"_3627":1581,"_31174":1336,"_21594":55830,"_5":14861,"_28366":55195,"_3078":55831},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3627":1582,"_31174":1336,"_21594":55833,"_5":14861,"_28366":55195,"_3078":55834},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3627":1583,"_31174":1336,"_21594":55836,"_5":14861,"_28366":55195,"_3078":55837},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3627":1584,"_31174":1336,"_21594":55839,"_5":14861,"_28366":55199,"_3078":55840},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3627":1585,"_31174":1336,"_21594":55842,"_5":14861,"_28366":55199,"_3078":55843},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3627":1586,"_31174":1336,"_21594":55845,"_5":14861,"_28366":55203,"_3078":55846},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3627":1587,"_31174":1336,"_21594":55848,"_5":14861,"_28366":55203,"_3078":55849},[],"There are two action types:",{"_3627":1588,"_31174":1336,"_21594":55851,"_5":14861,"_28366":55203,"_3078":55852},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3627":1589,"_31174":1336,"_21594":55854,"_5":14861,"_28366":55203,"_3078":55855},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3627":1590,"_31174":1336,"_21594":55857,"_5":14861,"_28366":55203,"_3078":55858},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3627":1591,"_31174":1336,"_21594":55860,"_5":14861,"_28366":55207,"_3078":55861},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3627":1592,"_31174":1336,"_21594":55863,"_5":14861,"_28366":55207,"_3078":55864},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3627":1593,"_31174":1336,"_21594":55866,"_5":14861,"_28366":55207,"_3078":55867},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3627":1594,"_31174":1336,"_21594":55869,"_5":14861,"_28366":55211,"_3078":55870},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3627":1595,"_31174":1336,"_21594":55872,"_5":14861,"_28366":55211,"_3078":55873},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3627":1596,"_31174":1336,"_21594":55875,"_5":14861,"_28366":55211,"_3078":55876},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3627":1597,"_31174":1336,"_21594":55878,"_5":14861,"_28366":55211,"_3078":55879},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3627":1598,"_31174":1336,"_21594":55881,"_5":14861,"_28366":55211,"_3078":55882},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3627":1599,"_31174":1336,"_21594":55884,"_5":14861,"_28366":55211,"_3078":55885},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3627":1600,"_31174":1336,"_21594":55887,"_5":14861,"_28366":55211,"_3078":55888},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3627":1601,"_31174":1336,"_21594":55890,"_5":14861,"_28366":55211,"_3078":55891},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3627":1602,"_31174":1336,"_21594":55893,"_5":14861,"_28366":55211,"_3078":55894},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3627":1603,"_31174":1336,"_21594":55896,"_5":14861,"_28366":55211,"_3078":55897},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3627":1604,"_31174":1336,"_21594":55899,"_5":14861,"_28366":55211,"_3078":55900},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3627":1605,"_31174":1336,"_21594":55902,"_5":14861,"_28366":55211,"_3078":55903},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3627":1606,"_31174":1336,"_21594":55905,"_5":14861,"_28366":55211,"_3078":55906},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3627":1607,"_31174":1336,"_21594":55908,"_5":14861,"_28366":55211,"_3078":55909},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3627":1608,"_31174":1336,"_21594":55911,"_5":14861,"_28366":55211,"_3078":55912},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3627":1609,"_31174":1336,"_21594":55914,"_5":14861,"_28366":55211,"_3078":55915},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3627":1610,"_31174":1336,"_21594":55917,"_5":14861,"_28366":55211,"_3078":55918},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3627":1611,"_31174":1336,"_21594":55920,"_5":14861,"_28366":55211,"_3078":55921},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3627":1612,"_31174":1336,"_21594":55923,"_5":14861,"_28366":55211,"_3078":55924},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3627":1613,"_31174":1336,"_21594":55926,"_5":14861,"_28366":55211,"_3078":55927},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3627":1614,"_31174":1336,"_21594":55929,"_5":14861,"_28366":55211,"_3078":55930},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3627":1615,"_31174":1336,"_21594":55932,"_5":14861,"_28366":55211,"_3078":55933},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3627":1616,"_31174":1336,"_21594":55935,"_5":14861,"_28366":55211,"_3078":55936},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3627":1617,"_31174":1336,"_21594":55938,"_5":14861,"_28366":55211,"_3078":55939},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3627":1618,"_31174":1618,"_5":15221,"_3078":53635,"_31533":55941,"_21594":55942,"_28366":1618},[50951,52463,53635],[],{"_3627":1619,"_31174":1618,"_21594":55944,"_5":14861,"_28366":1618,"_3078":55945},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3627":1620,"_31174":1618,"_5":31530,"_21594":55947,"_28366":55948,"_3078":55949},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#start-here","Start here",{"_3627":1621,"_31174":1618,"_5":31530,"_21594":55951,"_28366":55952,"_3078":53633},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#devices-and-identities",{"_3627":1622,"_31174":1618,"_5":31530,"_21594":55954,"_28366":55955,"_3078":53819},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#enrollment-with-pki",{"_3627":1623,"_31174":1618,"_5":31530,"_21594":55957,"_28366":55958,"_3078":55108},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#integrations",{"_3627":1624,"_31174":1618,"_5":31530,"_21594":55960,"_28366":55961,"_3078":55962},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3627":1625,"_31174":1618,"_21594":55964,"_5":14861,"_28366":1618,"_3078":55965},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3627":1626,"_31174":1618,"_21594":55967,"_5":14861,"_28366":55948,"_3078":55968},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3627":1627,"_31174":1618,"_21594":55970,"_5":14861,"_28366":55948,"_3078":55971},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3627":1628,"_31174":1618,"_21594":55973,"_5":14861,"_28366":55952,"_3078":55974},[],"Resource",{"_3627":1629,"_31174":1618,"_21594":55976,"_5":14861,"_28366":55952,"_3078":55977},[],"What it represents",{"_3627":1630,"_31174":1618,"_21594":55979,"_5":14861,"_28366":55952,"_3078":55980},[],"**Device**",{"_3627":1631,"_31174":1618,"_21594":55982,"_5":14861,"_28366":55952,"_3078":55983},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3627":1632,"_31174":1618,"_21594":55985,"_5":14861,"_28366":55952,"_3078":55986},[],"**Identity**",{"_3627":1633,"_31174":1618,"_21594":55988,"_5":14861,"_28366":55952,"_3078":55989},[],"The device's association with its certificates: an active version and a history.",{"_3627":1634,"_31174":1618,"_21594":55991,"_5":14861,"_28366":55952,"_3078":55992},[],"**DMS**",{"_3627":1635,"_31174":1618,"_21594":55994,"_5":14861,"_28366":55952,"_3078":55995},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3627":1636,"_31174":1618,"_21594":55997,"_5":14861,"_28366":55952,"_3078":55998},[],"**Fleet**",{"_3627":1637,"_31174":1618,"_21594":56000,"_5":14861,"_28366":55952,"_3078":56001},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3627":1638,"_31174":1618,"_21594":56003,"_5":14861,"_28366":55952,"_3078":56004},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3627":1639,"_31174":1618,"_21594":56006,"_5":14861,"_28366":55952,"_3078":56007},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3627":1640,"_31174":1618,"_21594":56009,"_5":14861,"_28366":55955,"_3078":56010},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3627":1641,"_31174":1618,"_21594":56012,"_5":14861,"_28366":55955,"_3078":56013},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3627":1642,"_31174":1618,"_21594":56015,"_5":14861,"_28366":55955,"_3078":56016},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3627":1643,"_31174":1618,"_21594":56018,"_5":14861,"_28366":55955,"_3078":56019},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3627":1644,"_31174":1618,"_21594":56021,"_5":14861,"_28366":55955,"_3078":56022},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3627":1645,"_31174":1618,"_21594":56024,"_5":14861,"_28366":55955,"_3078":56025},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3627":1646,"_31174":1618,"_21594":56027,"_5":14861,"_28366":55955,"_3078":56028},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3627":1647,"_31174":1618,"_21594":56030,"_5":14861,"_28366":55955,"_3078":56031},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3627":1648,"_31174":1618,"_21594":56033,"_5":14861,"_28366":55958,"_3078":56034},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3627":1649,"_31174":1618,"_21594":56036,"_5":14861,"_28366":55958,"_3078":56037},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3627":1650,"_31174":1618,"_21594":56039,"_5":14861,"_28366":55961,"_3078":56040},[],"Participant",{"_3627":1651,"_31174":1618,"_21594":56042,"_5":14861,"_28366":55961,"_3078":56043},[],"Responsibility",{"_3627":1652,"_31174":1618,"_21594":56045,"_5":14861,"_28366":55961,"_3078":56046},[],"PKI administrator",{"_3627":1653,"_31174":1618,"_21594":56048,"_5":14861,"_28366":55961,"_3078":56049},[],"CA, issuance profile, chain and revocation publication.",{"_3627":1654,"_31174":1618,"_21594":56051,"_5":14861,"_28366":55961,"_3078":56052},[],"Provisioning administrator",{"_3627":1655,"_31174":1618,"_21594":56054,"_5":14861,"_28366":55961,"_3078":56055},[],"DMS, admission, authentication per operation and inventory.",{"_3627":1656,"_31174":1618,"_21594":56057,"_5":14861,"_28366":55961,"_3078":56058},[],"Device integrator",{"_3627":1657,"_31174":1618,"_21594":56060,"_5":14861,"_28366":55961,"_3078":56061},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3627":1658,"_31174":1618,"_21594":56063,"_5":14861,"_28366":55961,"_3078":56064},[],"Consumer integrator",{"_3627":1659,"_31174":1618,"_21594":56066,"_5":14861,"_28366":55961,"_3078":56067},[],"Trusted issuers, validation and device permissions in the destination.",{"_3627":1660,"_31174":1618,"_21594":56069,"_5":14861,"_28366":55961,"_3078":56070},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3627":1661,"_31174":1661,"_5":15221,"_3078":56072,"_31533":56073,"_21594":56075,"_28366":1661},"Enroll and connect your first device",[50951,52463,53635,56074],"Getting started",[],{"_3627":1662,"_31174":1661,"_21594":56077,"_5":14861,"_28366":1661,"_3078":56078},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3627":1663,"_31174":1661,"_5":31530,"_21594":56080,"_28366":56081,"_3078":50961},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3627":1664,"_31174":1661,"_5":31530,"_21594":56083,"_28366":56084,"_3078":56085},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3627":1665,"_31174":1661,"_5":31530,"_21594":56087,"_28366":56088,"_3078":56089},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3627":1666,"_31174":1661,"_5":31530,"_21594":56091,"_28366":56092,"_3078":56093},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3627":1667,"_31174":1661,"_5":31530,"_21594":56095,"_28366":56096,"_3078":56097},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3627":1668,"_31174":1661,"_5":31530,"_21594":56099,"_28366":56100,"_3078":56101},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3627":1669,"_31174":1661,"_5":31530,"_21594":56103,"_28366":56104,"_3078":56105},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3627":1670,"_31174":1661,"_5":31530,"_21594":56107,"_28366":56108,"_3078":56109},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3627":1671,"_31174":1661,"_21594":56111,"_5":14861,"_28366":1661,"_3078":56112},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3627":1672,"_31174":1661,"_21594":56114,"_5":14861,"_28366":56081,"_3078":56115},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3627":1673,"_31174":1661,"_21594":56117,"_5":14861,"_28366":56081,"_3078":56118},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3627":1674,"_31174":1661,"_21594":56120,"_5":14861,"_28366":56081,"_3078":56121},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3627":1675,"_31174":1661,"_21594":56123,"_5":14861,"_28366":56081,"_3078":56124},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3627":1676,"_31174":1661,"_21594":56126,"_5":14861,"_28366":56081,"_3078":56127},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3627":1677,"_31174":1661,"_21594":56129,"_5":14861,"_28366":56084,"_3078":56130},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3627":1678,"_31174":1661,"_21594":56132,"_5":14861,"_28366":56084,"_3078":56133},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3627":1679,"_31174":1661,"_21594":56135,"_5":14861,"_28366":56088,"_3078":56136},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3627":1680,"_31174":1661,"_21594":56138,"_5":14861,"_28366":56088,"_3078":56139},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3627":1681,"_31174":1661,"_21594":56141,"_5":14861,"_28366":56088,"_3078":56142},[],"Setting",{"_3627":1682,"_31174":1661,"_21594":56144,"_5":14861,"_28366":56088,"_3078":56145},[],"Evaluation value",{"_3627":1683,"_31174":1661,"_21594":56147,"_5":14861,"_28366":56088,"_3078":56148},[],"Enrollment CA",{"_3627":1684,"_31174":1661,"_21594":56150,"_5":14861,"_28366":56088,"_3078":56151},[],"Issuing root from `device-root.pem`.",{"_3627":1685,"_31174":1661,"_21594":56153,"_5":14861,"_28366":56088,"_3078":53955},[],{"_3627":1686,"_31174":1661,"_21594":56155,"_5":14861,"_28366":56088,"_3078":56156},[],"The 1-hour leaf profile you just prepared.",{"_3627":1687,"_31174":1661,"_21594":56158,"_5":14861,"_28366":56088,"_3078":56159},[],"Protocol / Registration Mode",{"_3627":1688,"_31174":1661,"_21594":56161,"_5":14861,"_28366":56088,"_3078":56162},[],"`EST_RFC7030` / `JITP`.",{"_3627":1689,"_31174":1661,"_21594":56164,"_5":14861,"_28366":56088,"_3078":56165},[],"Verify CSR Signature",{"_3627":1690,"_31174":1661,"_21594":56167,"_5":14861,"_28366":56088,"_3078":56168},[],"Enabled.",{"_3627":1691,"_31174":1661,"_21594":56170,"_5":14861,"_28366":56088,"_3078":56171},[],"Enable Replaceable Enrollment",{"_3627":1692,"_31174":1661,"_21594":56173,"_5":14861,"_28366":56088,"_3078":56174},[],"Disabled; the ID must be new.",{"_3627":1693,"_31174":1661,"_21594":56176,"_5":14861,"_28366":56088,"_3078":56177},[],"Initial authentication",{"_3627":1694,"_31174":1661,"_21594":56179,"_5":14861,"_28366":56088,"_3078":56180},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3627":1695,"_31174":1661,"_21594":56182,"_5":14861,"_28366":56088,"_3078":56183},[],"Renewal authentication",{"_3627":1696,"_31174":1661,"_21594":56185,"_5":14861,"_28366":56088,"_3078":56186},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3627":1697,"_31174":1661,"_21594":56188,"_5":14861,"_28366":56088,"_3078":56189},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3627":1698,"_31174":1661,"_21594":56191,"_5":14861,"_28366":56088,"_3078":56192},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3627":1699,"_31174":1661,"_21594":56194,"_5":14861,"_28366":56088,"_3078":56195},[],"Re-enrollment Delta",{"_3627":1700,"_31174":1661,"_21594":56197,"_5":14861,"_28366":56088,"_3078":56198},[],"1 hour.",{"_3627":1701,"_31174":1661,"_21594":56200,"_5":14861,"_28366":56088,"_3078":56201},[],"Preventive / Critical Delta",{"_3627":1702,"_31174":1661,"_21594":56203,"_5":14861,"_28366":56088,"_3078":56204},[],"30 minutes / 10 minutes.",{"_3627":1703,"_31174":1661,"_21594":56206,"_5":14861,"_28366":56088,"_3078":56207},[],"Revoke on Re-enrollment",{"_3627":1704,"_31174":1661,"_21594":56209,"_5":14861,"_28366":56088,"_3078":56210},[],"Disabled to test the successor before retiring the previous identity.",{"_3627":1705,"_31174":1661,"_21594":56212,"_5":14861,"_28366":56088,"_3078":53963},[],{"_3627":1706,"_31174":1661,"_21594":56214,"_5":14861,"_28366":56088,"_3078":56215},[],"Disabled; the operational key is generated in the client.",{"_3627":1707,"_31174":1661,"_21594":56217,"_5":14861,"_28366":56088,"_3078":56218},[],"CA Distribution",{"_3627":1708,"_31174":1661,"_21594":56220,"_5":14861,"_28366":56088,"_3078":56221},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3627":1709,"_31174":1661,"_21594":56223,"_5":14861,"_28366":56088,"_3078":56224},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3627":1710,"_31174":1661,"_21594":56226,"_5":14861,"_28366":56092,"_3078":56227},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3627":1711,"_31174":1661,"_21594":56229,"_5":14861,"_28366":56092,"_3078":56230},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3627":1712,"_31174":1661,"_21594":56232,"_5":14861,"_28366":56096,"_3078":56233},[],"Generate a new key and CSR with the selected identifier:",{"_3627":1713,"_31174":1661,"_21594":56235,"_5":14861,"_28366":56096,"_3078":56236},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3627":1714,"_31174":1661,"_21594":56238,"_5":14861,"_28366":56096,"_3078":56239},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3627":1715,"_31174":1661,"_21594":56241,"_5":14861,"_28366":56100,"_3078":56242},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3627":1716,"_31174":1661,"_21594":56244,"_5":14861,"_28366":56100,"_3078":56245},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3627":1717,"_31174":1661,"_21594":56247,"_5":14861,"_28366":56104,"_3078":56248},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3627":1718,"_31174":1661,"_21594":56250,"_5":14861,"_28366":56104,"_3078":56251},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3627":1719,"_31174":1661,"_21594":56253,"_5":14861,"_28366":56104,"_3078":56254},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3627":1720,"_31174":1661,"_21594":56256,"_5":14861,"_28366":56104,"_3078":56257},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3627":1721,"_31174":1661,"_21594":56259,"_5":14861,"_28366":56104,"_3078":56260},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3627":1722,"_31174":1661,"_21594":56262,"_5":14861,"_28366":56108,"_3078":56263},[],"Check",{"_3627":1723,"_31174":1661,"_21594":56265,"_5":14861,"_28366":56108,"_3078":56266},[],"Expected result",{"_3627":1724,"_31174":1661,"_21594":56268,"_5":14861,"_28366":56108,"_3078":56269},[],"Registration",{"_3627":1725,"_31174":1661,"_21594":56271,"_5":14861,"_28366":56108,"_3078":56272},[],"ID created automatically and correct DMS.",{"_3627":1726,"_31174":1661,"_21594":56274,"_5":14861,"_28366":56108,"_3078":55530},[],{"_3627":1727,"_31174":1661,"_21594":56276,"_5":14861,"_28366":56108,"_3078":56277},[],"CN, profile, serial and key verified.",{"_3627":1728,"_31174":1661,"_21594":56279,"_5":14861,"_28366":56108,"_3078":56280},[],"Inventory",{"_3627":1729,"_31174":1661,"_21594":56282,"_5":14861,"_28366":56108,"_3078":56283},[],"Received serial visible as the current identity and in history.",{"_3627":1730,"_31174":1661,"_21594":56285,"_5":14861,"_28366":56108,"_3078":56286},[],"Consumer",{"_3627":1731,"_31174":1661,"_21594":56288,"_5":14861,"_28366":56108,"_3078":56289},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3627":1732,"_31174":1661,"_21594":56291,"_5":14861,"_28366":56108,"_3078":56292},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3627":1733,"_31174":1661,"_21594":56294,"_5":14861,"_28366":56108,"_3078":56295},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3627":1734,"_31174":1734,"_5":15221,"_3078":53651,"_31533":56297,"_21594":56298,"_28366":1734},[50951,52463,53635,56074],[],{"_3627":1735,"_31174":1734,"_21594":56300,"_5":14861,"_28366":1734,"_3078":56301},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3627":1736,"_31174":1734,"_5":31530,"_21594":56303,"_28366":56304,"_3078":50961},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3627":1737,"_31174":1734,"_5":31530,"_21594":56306,"_28366":56307,"_3078":56308},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3627":1738,"_31174":1734,"_5":31530,"_21594":56310,"_28366":56311,"_3078":56312},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3627":1739,"_31174":1734,"_5":31530,"_21594":56314,"_28366":56315,"_3078":56316},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3627":1740,"_31174":1734,"_5":31530,"_21594":56318,"_28366":56319,"_3078":56320},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3627":1741,"_31174":1734,"_5":31530,"_21594":56322,"_28366":56323,"_3078":56324},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3627":1742,"_31174":1734,"_5":31530,"_21594":56326,"_28366":56327,"_3078":56266},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3627":1743,"_31174":1734,"_5":31530,"_21594":56329,"_28366":56330,"_3078":56331},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3627":1744,"_31174":1734,"_5":31530,"_21594":56333,"_28366":56334,"_3078":56335},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3627":1745,"_31174":1734,"_21594":56337,"_5":14861,"_28366":1734,"_3078":56338},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3627":1746,"_31174":1734,"_21594":56340,"_5":14861,"_28366":1734,"_3078":56341},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3627":1747,"_31174":1734,"_21594":56343,"_5":14861,"_28366":56304,"_3078":56344},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3627":1748,"_31174":1734,"_21594":56346,"_5":14861,"_28366":56304,"_3078":56347},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3627":1749,"_31174":1734,"_21594":56349,"_5":14861,"_28366":56304,"_3078":56350},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3627":1750,"_31174":1734,"_21594":56352,"_5":14861,"_28366":56304,"_3078":56353},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3627":1751,"_31174":1734,"_21594":56355,"_5":14861,"_28366":56307,"_3078":56356},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3627":1752,"_31174":1734,"_21594":56358,"_5":14861,"_28366":56307,"_3078":56359},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3627":1753,"_31174":1734,"_21594":56361,"_5":14861,"_28366":56307,"_3078":56362},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3627":1754,"_31174":1734,"_21594":56364,"_5":14861,"_28366":56307,"_3078":56365},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3627":1755,"_31174":1734,"_21594":56367,"_5":14861,"_28366":56307,"_3078":56368},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3627":1756,"_31174":1734,"_21594":56370,"_5":14861,"_28366":56307,"_3078":56371},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3627":1757,"_31174":1734,"_21594":56373,"_5":14861,"_28366":56307,"_3078":56374},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3627":1758,"_31174":1734,"_21594":56376,"_5":14861,"_28366":56307,"_3078":56377},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3627":1759,"_31174":1734,"_21594":56379,"_5":14861,"_28366":56311,"_3078":56380},[],"Open **Managed Devices** and the registration action. Complete:",{"_3627":1760,"_31174":1734,"_21594":56382,"_5":14861,"_28366":56311,"_3078":56383},[],"**Device ID**: `device-001`.",{"_3627":1761,"_31174":1734,"_21594":56385,"_5":14861,"_28366":56311,"_3078":56386},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3627":1762,"_31174":1734,"_21594":56388,"_5":14861,"_28366":56311,"_3078":56389},[],"**Icon** and **Tags**: optional classification.",{"_3627":1763,"_31174":1734,"_21594":56391,"_5":14861,"_28366":56311,"_3078":56392},[],"Confirm registration.",{"_3627":1764,"_31174":1734,"_21594":56394,"_5":14861,"_28366":56315,"_3078":56395},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3627":1765,"_31174":1734,"_21594":56397,"_5":14861,"_28366":56315,"_3078":56398},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3627":1766,"_31174":1734,"_21594":56400,"_5":14861,"_28366":56319,"_3078":56401},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3627":1767,"_31174":1734,"_21594":56403,"_5":14861,"_28366":56319,"_3078":56404},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3627":1768,"_31174":1734,"_21594":56406,"_5":14861,"_28366":56323,"_3078":56407},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3627":1769,"_31174":1734,"_21594":56409,"_5":14861,"_28366":56323,"_3078":56410},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3627":1770,"_31174":1734,"_21594":56412,"_5":14861,"_28366":56327,"_3078":56263},[],{"_3627":1771,"_31174":1734,"_21594":56414,"_5":14861,"_28366":56327,"_3078":56415},[],"Result",{"_3627":1772,"_31174":1734,"_21594":56417,"_5":14861,"_28366":56327,"_3078":55513},[],{"_3627":1773,"_31174":1734,"_21594":56419,"_5":14861,"_28366":56327,"_3078":56420},[],"`device-001` appears in inventory with the expected DMS.",{"_3627":1774,"_31174":1734,"_21594":56422,"_5":14861,"_28366":56327,"_3078":56423},[],"Current identity",{"_3627":1775,"_31174":1734,"_21594":56425,"_5":14861,"_28366":56327,"_3078":56426},[],"The associated certificate matches the one you verified in PKI.",{"_3627":1776,"_31174":1734,"_21594":56428,"_5":14861,"_28366":56327,"_3078":56429},[],"History",{"_3627":1777,"_31174":1734,"_21594":56431,"_5":14861,"_28366":56327,"_3078":56432},[],"The associated issuance appears with its serial number and dates.",{"_3627":1778,"_31174":1734,"_21594":56434,"_5":14861,"_28366":56327,"_3078":56435},[],"Key and certificate",{"_3627":1779,"_31174":1734,"_21594":56437,"_5":14861,"_28366":56327,"_3078":56438},[],"You have the verified pair ready to install on the device.",{"_3627":1780,"_31174":1734,"_21594":56440,"_5":14861,"_28366":56330,"_3078":56441},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3627":1781,"_31174":1734,"_21594":56443,"_5":14861,"_28366":56330,"_3078":56444},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3627":1782,"_31174":1734,"_21594":56446,"_5":14861,"_28366":56330,"_3078":56447},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3627":1783,"_31174":1734,"_21594":56449,"_5":14861,"_28366":56330,"_3078":56450},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3627":1784,"_31174":1734,"_21594":56452,"_5":14861,"_28366":56334,"_3078":56453},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3627":1785,"_31174":1734,"_21594":56455,"_5":14861,"_28366":56334,"_3078":56456},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3627":1786,"_31174":1734,"_21594":56458,"_5":14861,"_28366":56334,"_3078":56459},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3627":1787,"_31174":1787,"_5":15221,"_3078":56461,"_31533":56462,"_21594":56463,"_28366":1787},"Lamassu IoT Platform",[50951,52463],[],{"_3627":1788,"_31174":1787,"_21594":56465,"_5":14861,"_28366":1787,"_3078":56466},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3627":1789,"_31174":1787,"_5":31530,"_21594":56468,"_28366":56469,"_3078":55949},[],"/docs/pr-preview/pr-75/platform/overview#start-here",{"_3627":1790,"_31174":1787,"_5":31530,"_21594":56471,"_28366":56472,"_3078":56473},[],"/docs/pr-preview/pr-75/platform/overview#choose-your-path","Choose your path",{"_3627":1791,"_31174":1787,"_5":31530,"_21594":56475,"_28366":56476,"_3078":56477},[],"/docs/pr-preview/pr-75/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3627":1792,"_31174":1787,"_5":31530,"_21594":56479,"_28366":56480,"_3078":56481},[],"/docs/pr-preview/pr-75/platform/overview#core-capabilities","Core capabilities",{"_3627":1793,"_31174":1787,"_5":31530,"_21594":56483,"_28366":56484,"_3078":56485},[],"/docs/pr-preview/pr-75/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3627":1794,"_31174":1787,"_5":31530,"_21594":56487,"_28366":56488,"_3078":56489},[],"/docs/pr-preview/pr-75/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3627":1795,"_31174":1787,"_5":31530,"_21594":56491,"_28366":56492,"_3078":56493},[],"/docs/pr-preview/pr-75/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3627":1796,"_31174":1787,"_5":31530,"_21594":56495,"_28366":56496,"_3078":56497},[],"/docs/pr-preview/pr-75/platform/overview#automate-device-identities","Automate device identities",{"_3627":1797,"_31174":1787,"_5":31530,"_21594":56499,"_28366":56500,"_3078":56501},[],"/docs/pr-preview/pr-75/platform/overview#publish-validation-status","Publish validation status",{"_3627":1798,"_31174":1787,"_5":31530,"_21594":56503,"_28366":56504,"_3078":56505},[],"/docs/pr-preview/pr-75/platform/overview#react-to-events","React to events",{"_3627":1799,"_31174":1787,"_5":31530,"_21594":56507,"_28366":56508,"_3078":56509},[],"/docs/pr-preview/pr-75/platform/overview#operational-reference","Operational reference",{"_3627":1800,"_31174":1787,"_21594":56511,"_5":14861,"_28366":1787,"_3078":56512},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3627":1801,"_31174":1787,"_21594":56514,"_5":14861,"_28366":56469,"_3078":56515},[],"Choose the result you need:",{"_3627":1802,"_31174":1787,"_21594":56517,"_5":14861,"_28366":56469,"_3078":56518},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3627":1803,"_31174":1787,"_21594":56520,"_5":14861,"_28366":56469,"_3078":56521},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3627":1804,"_31174":1787,"_21594":56523,"_5":14861,"_28366":56469,"_3078":56524},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3627":1805,"_31174":1787,"_21594":56526,"_5":14861,"_28366":56472,"_3078":56527},[],"Section",{"_3627":1806,"_31174":1787,"_21594":56529,"_5":14861,"_28366":56472,"_3078":56530},[],"What you manage",{"_3627":1807,"_31174":1787,"_21594":56532,"_5":14861,"_28366":56472,"_3078":56533},[],"Entry point",{"_3627":1808,"_31174":1787,"_21594":56535,"_5":14861,"_28366":56472,"_3078":56536},[],"**PKI**",{"_3627":1809,"_31174":1787,"_21594":56538,"_5":14861,"_28366":56472,"_3078":56539},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3627":1810,"_31174":1787,"_21594":56541,"_5":14861,"_28366":56472,"_3078":56542},[],"PKI overview",{"_3627":1811,"_31174":1787,"_21594":56544,"_5":14861,"_28366":56472,"_3078":56545},[],"**IoT Fleets**",{"_3627":1812,"_31174":1787,"_21594":56547,"_5":14861,"_28366":56472,"_3078":56548},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3627":1813,"_31174":1787,"_21594":56550,"_5":14861,"_28366":56472,"_3078":56551},[],"IoT Fleets overview",{"_3627":1814,"_31174":1787,"_21594":56553,"_5":14861,"_28366":56472,"_3078":56554},[],"**Administration**",{"_3627":1815,"_31174":1787,"_21594":56556,"_5":14861,"_28366":56472,"_3078":56557},[],"Operator permissions, audit and event subscriptions.",{"_3627":1816,"_31174":1787,"_21594":56559,"_5":14861,"_28366":56472,"_3078":52465},[],{"_3627":1817,"_31174":1787,"_21594":56561,"_5":14861,"_28366":56472,"_3078":56562},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3627":1818,"_31174":1787,"_21594":56564,"_5":14861,"_28366":56476,"_3078":56565},[],"An identity's journey connects four responsibilities:",{"_3627":1819,"_31174":1787,"_21594":56567,"_5":14861,"_28366":56476,"_3078":56568},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3627":1820,"_31174":1787,"_21594":56570,"_5":14861,"_28366":56476,"_3078":56571},[],"The provisioning administrator configures the DMS and initial trust.",{"_3627":1821,"_31174":1787,"_21594":56573,"_5":14861,"_28366":56476,"_3078":56574},[],"The device client requests a certificate and installs it with the matching key.",{"_3627":1822,"_31174":1787,"_21594":56576,"_5":14861,"_28366":56476,"_3078":56577},[],"The consumer validates the identity and applies its access permissions.",{"_3627":1823,"_31174":1787,"_21594":56579,"_5":14861,"_28366":56476,"_3078":56580},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3627":1824,"_31174":1787,"_21594":56582,"_5":14861,"_28366":56484,"_3078":56583},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3627":1825,"_31174":1787,"_21594":56585,"_5":14861,"_28366":56488,"_3078":56586},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3627":1826,"_31174":1787,"_21594":56588,"_5":14861,"_28366":56492,"_3078":56589},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3627":1827,"_31174":1787,"_21594":56591,"_5":14861,"_28366":56496,"_3078":56592},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3627":1828,"_31174":1787,"_21594":56594,"_5":14861,"_28366":56500,"_3078":56595},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3627":1829,"_31174":1787,"_21594":56597,"_5":14861,"_28366":56504,"_3078":56598},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3627":1830,"_31174":1787,"_21594":56600,"_5":14861,"_28366":56508,"_3078":56043},[],{"_3627":1831,"_31174":1787,"_21594":56602,"_5":14861,"_28366":56508,"_3078":56603},[],"What it prepares or checks",{"_3627":1832,"_31174":1787,"_21594":56605,"_5":14861,"_28366":56508,"_3078":56046},[],{"_3627":1833,"_31174":1787,"_21594":56607,"_5":14861,"_28366":56508,"_3078":56608},[],"Key custody, CA hierarchy, profiles and validation.",{"_3627":1834,"_31174":1787,"_21594":56610,"_5":14861,"_28366":56508,"_3078":56611},[],"Fleet administrator",{"_3627":1835,"_31174":1787,"_21594":56613,"_5":14861,"_28366":56508,"_3078":56614},[],"DMS, device admission, renewal policy and inventory.",{"_3627":1836,"_31174":1787,"_21594":56616,"_5":14861,"_28366":56508,"_3078":56058},[],{"_3627":1837,"_31174":1787,"_21594":56618,"_5":14861,"_28366":56508,"_3078":56619},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3627":1838,"_31174":1787,"_21594":56621,"_5":14861,"_28366":56508,"_3078":56064},[],{"_3627":1839,"_31174":1787,"_21594":56623,"_5":14861,"_28366":56508,"_3078":56624},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3627":1840,"_31174":1787,"_21594":56626,"_5":14861,"_28366":56508,"_3078":56627},[],"Infrastructure operator",{"_3627":1841,"_31174":1787,"_21594":56629,"_5":14861,"_28366":56508,"_3078":56630},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3627":1842,"_31174":1787,"_21594":56632,"_5":14861,"_28366":56508,"_3078":56633},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3627":1843,"_31174":1843,"_5":15221,"_3078":56635,"_31533":56636,"_21594":56639,"_28366":1843},"CA hierarchy and rotation",[50951,52463,56637,56638],"PKI","Keys, authorities and certificates",[],{"_3627":1844,"_31174":1843,"_21594":56641,"_5":14861,"_28366":1843,"_3078":56642},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3627":1845,"_31174":1843,"_5":31530,"_21594":56644,"_28366":56645,"_3078":56646},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3627":1846,"_31174":1843,"_5":31530,"_21594":56648,"_28366":56649,"_3078":56650},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3627":1847,"_31174":1843,"_5":31530,"_21594":56652,"_28366":56653,"_3078":56654},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3627":1848,"_31174":1843,"_5":31530,"_21594":56656,"_28366":56657,"_3078":56658},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3627":1849,"_31174":1843,"_5":31530,"_21594":56660,"_28366":56661,"_3078":56662},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3627":1850,"_31174":1843,"_5":31530,"_21594":56664,"_28366":56665,"_3078":56666},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3627":1851,"_31174":1843,"_5":31530,"_21594":56668,"_28366":56669,"_3078":56670},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3627":1852,"_31174":1843,"_5":31530,"_21594":56672,"_28366":56673,"_3078":56674},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3627":1853,"_31174":1843,"_5":31530,"_21594":56676,"_28366":56677,"_3078":56678},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3627":1854,"_31174":1843,"_5":31530,"_21594":56680,"_28366":56681,"_3078":56682},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3627":1855,"_31174":1843,"_5":31530,"_21594":56684,"_28366":56685,"_3078":56686},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3627":1856,"_31174":1843,"_5":31530,"_21594":56688,"_28366":56689,"_3078":56690},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3627":1857,"_31174":1843,"_21594":56692,"_5":14861,"_28366":1843,"_3078":56693},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3627":1858,"_31174":1843,"_21594":56695,"_5":14861,"_28366":1843,"_3078":56696},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3627":1859,"_31174":1843,"_21594":56698,"_5":14861,"_28366":56645,"_3078":56699},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3627":1860,"_31174":1843,"_21594":56701,"_5":14861,"_28366":56645,"_3078":56702},[],"environment, such as production and preproduction;",{"_3627":1861,"_31174":1843,"_21594":56704,"_5":14861,"_28366":56645,"_3078":56705},[],"owner or operating team;",{"_3627":1862,"_31174":1843,"_21594":56707,"_5":14861,"_28366":56645,"_3078":56708},[],"device family or manufacturing process;",{"_3627":1863,"_31174":1843,"_21594":56710,"_5":14861,"_28366":56645,"_3078":56711},[],"region or regulatory requirement;",{"_3627":1864,"_31174":1843,"_21594":56713,"_5":14861,"_28366":56645,"_3078":56714},[],"cryptographic engine or key policy;",{"_3627":1865,"_31174":1843,"_21594":56716,"_5":14861,"_28366":56645,"_3078":56717},[],"maintenance window and renewal cadence.",{"_3627":1866,"_31174":1843,"_21594":56719,"_5":14861,"_28366":56645,"_3078":56720},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3627":1867,"_31174":1843,"_21594":56722,"_5":14861,"_28366":56645,"_3078":56723},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3627":1868,"_31174":1843,"_21594":56725,"_5":14861,"_28366":56649,"_3078":56726},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3627":1869,"_31174":1843,"_21594":56728,"_5":14861,"_28366":56649,"_3078":56729},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3627":1870,"_31174":1843,"_21594":56731,"_5":14861,"_28366":56649,"_3078":56732},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3627":1871,"_31174":1843,"_21594":56734,"_5":14861,"_28366":56649,"_3078":56735},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3627":1872,"_31174":1843,"_21594":56737,"_5":14861,"_28366":56653,"_3078":56738},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3627":1873,"_31174":1843,"_21594":56740,"_5":14861,"_28366":56653,"_3078":56741},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3627":1874,"_31174":1843,"_21594":56743,"_5":14861,"_28366":56653,"_3078":56744},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3627":1875,"_31174":1843,"_21594":56746,"_5":14861,"_28366":56653,"_3078":56747},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3627":1876,"_31174":1843,"_21594":56749,"_5":14861,"_28366":56661,"_3078":56750},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3627":1877,"_31174":1843,"_21594":56752,"_5":14861,"_28366":56665,"_3078":56753},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3627":1878,"_31174":1843,"_21594":56755,"_5":14861,"_28366":56669,"_3078":56756},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3627":1879,"_31174":1843,"_21594":56758,"_5":14861,"_28366":56673,"_3078":56759},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3627":1880,"_31174":1843,"_21594":56761,"_5":14861,"_28366":56677,"_3078":56762},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3627":1881,"_31174":1843,"_21594":56764,"_5":14861,"_28366":56681,"_3078":56765},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3627":1882,"_31174":1843,"_21594":56767,"_5":14861,"_28366":56685,"_3078":56768},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3627":1883,"_31174":1843,"_21594":56770,"_5":14861,"_28366":56685,"_3078":56771},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3627":1884,"_31174":1843,"_21594":56773,"_5":14861,"_28366":56685,"_3078":56774},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3627":1885,"_31174":1843,"_21594":56776,"_5":14861,"_28366":56685,"_3078":56777},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3627":1886,"_31174":1843,"_21594":56779,"_5":14861,"_28366":56689,"_3078":56780},[],"The new chain ends in an anchor installed by the consumer.",{"_3627":1887,"_31174":1843,"_21594":56782,"_5":14861,"_28366":56689,"_3078":56783},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3627":1888,"_31174":1843,"_21594":56785,"_5":14861,"_28366":56689,"_3078":56786},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3627":1889,"_31174":1843,"_21594":56788,"_5":14861,"_28366":56689,"_3078":56789},[],"Re-enrollment accepts the old identity during the planned period.",{"_3627":1890,"_31174":1843,"_21594":56791,"_5":14861,"_28366":56689,"_3078":56792},[],"OCSP and CRL respond for the authorities that remain active.",{"_3627":1891,"_31174":1843,"_21594":56794,"_5":14861,"_28366":56689,"_3078":56795},[],"No DMS is left accidentally issuing from the old CA.",{"_3627":1892,"_31174":1843,"_21594":56797,"_5":14861,"_28366":56689,"_3078":56798},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3627":1893,"_31174":1893,"_5":15221,"_3078":56800,"_31533":56801,"_21594":56802,"_28366":1893},"Certification authorities",[50951,52463,56637,56638],[],{"_3627":1894,"_31174":1893,"_21594":56804,"_5":14861,"_28366":1893,"_3078":56805},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3627":1895,"_31174":1893,"_5":31530,"_21594":56807,"_28366":56808,"_3078":56809},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3627":1896,"_31174":1893,"_5":31530,"_21594":56811,"_28366":56812,"_3078":56813},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3627":1897,"_31174":1893,"_5":31530,"_21594":56815,"_28366":56816,"_3078":50961},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#before-you-begin",{"_3627":1898,"_31174":1893,"_5":31530,"_21594":56818,"_28366":56819,"_3078":56820},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3627":1899,"_31174":1893,"_5":31530,"_21594":56822,"_28366":56823,"_3078":56824},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3627":1900,"_31174":1893,"_5":31530,"_21594":56826,"_28366":56827,"_3078":56828},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3627":1901,"_31174":1893,"_5":31530,"_21594":56830,"_28366":56831,"_3078":56832},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3627":1902,"_31174":1893,"_5":31530,"_21594":56834,"_28366":56835,"_3078":56836},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3627":1903,"_31174":1893,"_5":31530,"_21594":56838,"_28366":56839,"_3078":56840},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3627":1904,"_31174":1893,"_5":31530,"_21594":56842,"_28366":56843,"_3078":56844},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3627":1905,"_31174":1893,"_5":31530,"_21594":56846,"_28366":56847,"_3078":56848},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3627":1906,"_31174":1893,"_5":31530,"_21594":56850,"_28366":56851,"_3078":56852},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3627":1907,"_31174":1893,"_5":31530,"_21594":56854,"_28366":56855,"_3078":56856},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3627":1908,"_31174":1893,"_5":31530,"_21594":56858,"_28366":56859,"_3078":56860},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3627":1909,"_31174":1893,"_5":31530,"_21594":56862,"_28366":56863,"_3078":56864},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3627":1910,"_31174":1893,"_5":31530,"_21594":56866,"_28366":56867,"_3078":56868},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3627":1911,"_31174":1893,"_5":31530,"_21594":56870,"_28366":56871,"_3078":56872},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3627":1912,"_31174":1893,"_5":31530,"_21594":56874,"_28366":56875,"_3078":56876},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3627":1913,"_31174":1893,"_5":31530,"_21594":56878,"_28366":56879,"_3078":56880},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3627":1914,"_31174":1893,"_5":31530,"_21594":56882,"_28366":56883,"_3078":56884},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3627":1915,"_31174":1893,"_5":31530,"_21594":56886,"_28366":56887,"_3078":56888},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3627":1916,"_31174":1893,"_5":31530,"_21594":56890,"_28366":56891,"_3078":56892},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3627":1917,"_31174":1893,"_5":31530,"_21594":56894,"_28366":56895,"_3078":56896},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3627":1918,"_31174":1893,"_21594":56898,"_5":14861,"_28366":1893,"_3078":56899},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3627":1919,"_31174":1893,"_21594":56901,"_5":14861,"_28366":1893,"_3078":56902},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3627":1920,"_31174":1893,"_21594":56904,"_5":14861,"_28366":1893,"_3078":56905},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3627":1921,"_31174":1893,"_21594":56907,"_5":14861,"_28366":56808,"_3078":56908},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3627":1922,"_31174":1893,"_21594":56910,"_5":14861,"_28366":56808,"_3078":56911},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3627":1923,"_31174":1893,"_21594":56913,"_5":14861,"_28366":56808,"_3078":56914},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3627":1924,"_31174":1893,"_21594":56916,"_5":14861,"_28366":56808,"_3078":56917},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3627":1925,"_31174":1893,"_21594":56919,"_5":14861,"_28366":56808,"_3078":56920},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3627":1926,"_31174":1893,"_21594":56922,"_5":14861,"_28366":56816,"_3078":56923},[],"Decide whether the CA will be a root or an intermediate.",{"_3627":1927,"_31174":1893,"_21594":56925,"_5":14861,"_28366":56816,"_3078":56926},[],"Choose the engine that will keep the key.",{"_3627":1928,"_31174":1893,"_21594":56928,"_5":14861,"_28366":56816,"_3078":56929},[],"Define a validity longer than that of the certificates it will issue.",{"_3627":1929,"_31174":1893,"_21594":56931,"_5":14861,"_28366":56816,"_3078":56932},[],"For an intermediate CA, make sure the parent CA is active.",{"_3627":1930,"_31174":1893,"_21594":56934,"_5":14861,"_28366":56819,"_3078":56935},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3627":1931,"_31174":1893,"_21594":56937,"_5":14861,"_28366":56823,"_3078":56938},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3627":1932,"_31174":1893,"_21594":56940,"_5":14861,"_28366":56823,"_3078":56941},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3627":1933,"_31174":1893,"_21594":56943,"_5":14861,"_28366":56827,"_3078":56944},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3627":1934,"_31174":1893,"_21594":56946,"_5":14861,"_28366":56831,"_3078":56947},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3627":1935,"_31174":1893,"_21594":56949,"_5":14861,"_28366":56831,"_3078":56950},[],"`C`: two-letter ISO 3166-1 country code.",{"_3627":1936,"_31174":1893,"_21594":56952,"_5":14861,"_28366":56831,"_3078":56953},[],"`ST`: state or province.",{"_3627":1937,"_31174":1893,"_21594":56955,"_5":14861,"_28366":56831,"_3078":56956},[],"`L`: locality.",{"_3627":1938,"_31174":1893,"_21594":56958,"_5":14861,"_28366":56831,"_3078":56959},[],"`O`: organization.",{"_3627":1939,"_31174":1893,"_21594":56961,"_5":14861,"_28366":56831,"_3078":56962},[],"`OU`: organizational unit.",{"_3627":1940,"_31174":1893,"_21594":56964,"_5":14861,"_28366":56831,"_3078":56965},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3627":1941,"_31174":1893,"_21594":56967,"_5":14861,"_28366":56835,"_3078":56968},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3627":1942,"_31174":1893,"_21594":56970,"_5":14861,"_28366":56835,"_3078":56971},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3627":1943,"_31174":1893,"_21594":56973,"_5":14861,"_28366":56839,"_3078":56974},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3627":1944,"_31174":1893,"_21594":56976,"_5":14861,"_28366":56839,"_3078":56977},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3627":1945,"_31174":1893,"_21594":56979,"_5":14861,"_28366":56843,"_3078":56980},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3627":1946,"_31174":1893,"_21594":56982,"_5":14861,"_28366":56843,"_3078":56983},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3627":1947,"_31174":1893,"_21594":56985,"_5":14861,"_28366":56847,"_3078":56986},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3627":1948,"_31174":1893,"_21594":56988,"_5":14861,"_28366":56847,"_3078":56989},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3627":1949,"_31174":1893,"_21594":56991,"_5":14861,"_28366":56847,"_3078":56992},[],"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and, when Lamassu has no stored record of that certificate yet, the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. If the import reuses the record of a deleted CA (see above and Delete a CA), the previous status is kept instead, even if the certificate has expired in the meantime. An `EXPIRED` CA rejects status changes; see certificate lifecycle.",{"_3627":1950,"_31174":1893,"_21594":56994,"_5":14861,"_28366":56847,"_3078":56995},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3627":1951,"_31174":1893,"_21594":56997,"_5":14861,"_28366":56851,"_3078":56998},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3627":1952,"_31174":1893,"_21594":57000,"_5":14861,"_28366":56855,"_3078":57001},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3627":1953,"_31174":1893,"_21594":57003,"_5":14861,"_28366":56855,"_3078":57004},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3627":1954,"_31174":1893,"_21594":57006,"_5":14861,"_28366":56859,"_3078":57007},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3627":1955,"_31174":1893,"_21594":57009,"_5":14861,"_28366":56863,"_3078":57010},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3627":1956,"_31174":1893,"_21594":57012,"_5":14861,"_28366":56863,"_3078":57013},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3627":1957,"_31174":1893,"_21594":57015,"_5":14861,"_28366":56863,"_3078":57016},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3627":1958,"_31174":1893,"_21594":57018,"_5":14861,"_28366":56867,"_3078":57019},[],"Open a CA from the inventory to review:",{"_3627":1959,"_31174":1893,"_21594":57021,"_5":14861,"_28366":56867,"_3078":57022},[],"Status and validity period.",{"_3627":1960,"_31174":1893,"_21594":57024,"_5":14861,"_28366":56867,"_3078":57025},[],"Certificate and chain in PEM format.",{"_3627":1961,"_31174":1893,"_21594":57027,"_5":14861,"_28366":56867,"_3078":57028},[],"Number of active, expired and revoked certificates.",{"_3627":1962,"_31174":1893,"_21594":57030,"_5":14861,"_28366":56867,"_3078":57031},[],"Certificates issued in **Issued Certificates**.",{"_3627":1963,"_31174":1893,"_21594":57033,"_5":14861,"_28366":56867,"_3078":57034},[],"The CRL linked to the authority.",{"_3627":1964,"_31174":1893,"_21594":57036,"_5":14861,"_28366":56867,"_3078":57037},[],"Metadata and the associated cryptographic engine.",{"_3627":1965,"_31174":1893,"_21594":57039,"_5":14861,"_28366":56867,"_3078":57040},[],"You can filter the inventory by name, status and CA type.",{"_3627":1966,"_31174":1893,"_21594":57042,"_5":14861,"_28366":56871,"_3078":57043},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3627":1967,"_31174":1893,"_21594":57045,"_5":14861,"_28366":56871,"_3078":57046},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3627":1968,"_31174":1893,"_21594":57048,"_5":14861,"_28366":56871,"_3078":57049},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3627":1969,"_31174":1893,"_21594":57051,"_5":14861,"_28366":56871,"_3078":57052},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3627":1970,"_31174":1893,"_21594":57054,"_5":14861,"_28366":56871,"_3078":57055},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3627":1971,"_31174":1893,"_21594":57057,"_5":14861,"_28366":56871,"_3078":57058},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3627":1972,"_31174":1893,"_21594":57060,"_5":14861,"_28366":56875,"_3078":57061},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3627":1973,"_31174":1893,"_21594":57063,"_5":14861,"_28366":56879,"_3078":57064},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3627":1974,"_31174":1893,"_21594":57066,"_5":14861,"_28366":56883,"_3078":57067},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3627":1975,"_31174":1893,"_21594":57069,"_5":14861,"_28366":56887,"_3078":57070},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3627":1976,"_31174":1893,"_21594":57072,"_5":14861,"_28366":56891,"_3078":57073},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3627":1977,"_31174":1893,"_21594":57075,"_5":14861,"_28366":56895,"_3078":57076},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3627":1978,"_31174":1893,"_21594":57078,"_5":14861,"_28366":56895,"_3078":57079},[],"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it.",{"_3627":1979,"_31174":1893,"_21594":57081,"_5":14861,"_28366":56895,"_3078":57082},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3627":1980,"_31174":1893,"_21594":57084,"_5":14861,"_28366":56895,"_3078":57085},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3627":1981,"_31174":1893,"_21594":57087,"_5":14861,"_28366":56895,"_3078":57088},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3627":1982,"_31174":1982,"_5":15221,"_3078":57090,"_31533":57091,"_21594":57092,"_28366":1982},"Certificate profiles",[50951,52463,56637,56638],[],{"_3627":1983,"_31174":1982,"_21594":57094,"_5":14861,"_28366":1982,"_3078":57095},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3627":1984,"_31174":1982,"_5":31530,"_21594":57097,"_28366":57098,"_3078":57099},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3627":1985,"_31174":1982,"_5":31530,"_21594":57101,"_28366":57102,"_3078":57103},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#validity","Validity",{"_3627":1986,"_31174":1982,"_5":31530,"_21594":57105,"_28366":57106,"_3078":57107},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3627":1987,"_31174":1982,"_5":31530,"_21594":57109,"_28366":57110,"_3078":57111},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3627":1988,"_31174":1982,"_5":31530,"_21594":57113,"_28366":57114,"_3078":57115},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#subject","Subject",{"_3627":1989,"_31174":1982,"_5":31530,"_21594":57117,"_28366":57118,"_3078":57119},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3627":1990,"_31174":1982,"_5":31530,"_21594":57121,"_28366":57122,"_3078":57123},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3627":1991,"_31174":1982,"_5":31530,"_21594":57125,"_28366":57126,"_3078":57127},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3627":1992,"_31174":1982,"_5":31530,"_21594":57129,"_28366":57130,"_3078":57131},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3627":1993,"_31174":1982,"_5":31530,"_21594":57133,"_28366":57134,"_3078":57135},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3627":1994,"_31174":1982,"_5":31530,"_21594":57137,"_28366":57138,"_3078":57139},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3627":1995,"_31174":1982,"_5":31530,"_21594":57141,"_28366":57142,"_3078":57143},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3627":1996,"_31174":1982,"_5":31530,"_21594":57145,"_28366":57146,"_3078":57147},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3627":1997,"_31174":1982,"_5":31530,"_21594":57149,"_28366":57150,"_3078":57151},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3627":1998,"_31174":1982,"_5":31530,"_21594":57153,"_28366":57154,"_3078":57155},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#design-examples","Design examples",{"_3627":1999,"_31174":1982,"_5":31530,"_21594":57157,"_28366":57158,"_3078":57159},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3627":2000,"_31174":1982,"_21594":57161,"_5":14861,"_28366":1982,"_3078":57162},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3627":2001,"_31174":1982,"_21594":57164,"_5":14861,"_28366":1982,"_3078":57165},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3627":2002,"_31174":1982,"_21594":57167,"_5":14861,"_28366":57102,"_3078":57168},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3627":2003,"_31174":1982,"_21594":57170,"_5":14861,"_28366":57102,"_3078":57171},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3627":2004,"_31174":1982,"_21594":57173,"_5":14861,"_28366":57106,"_3078":57174},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3627":2005,"_31174":1982,"_21594":57176,"_5":14861,"_28366":57110,"_3078":57177},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3627":2006,"_31174":1982,"_21594":57179,"_5":14861,"_28366":57110,"_3078":57180},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3627":2007,"_31174":1982,"_21594":57182,"_5":14861,"_28366":57110,"_3078":57183},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3627":2008,"_31174":1982,"_21594":57185,"_5":14861,"_28366":57114,"_3078":57186},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3627":2009,"_31174":1982,"_21594":57188,"_5":14861,"_28366":57118,"_3078":57189},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3627":2010,"_31174":1982,"_21594":57191,"_5":14861,"_28366":57118,"_3078":57192},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3627":2011,"_31174":1982,"_21594":57194,"_5":14861,"_28366":57122,"_3078":57195},[],"The cryptographic enforcement can:",{"_3627":2012,"_31174":1982,"_21594":57197,"_5":14861,"_28366":57122,"_3078":57198},[],"allow or block RSA keys;",{"_3627":2013,"_31174":1982,"_21594":57200,"_5":14861,"_28366":57122,"_3078":57201},[],"limit the supported RSA sizes;",{"_3627":2014,"_31174":1982,"_21594":57203,"_5":14861,"_28366":57122,"_3078":57204},[],"allow or block ECDSA keys;",{"_3627":2015,"_31174":1982,"_21594":57206,"_5":14861,"_28366":57122,"_3078":57207},[],"limit the supported ECDSA sizes or curves.",{"_3627":2016,"_31174":1982,"_21594":57209,"_5":14861,"_28366":57122,"_3078":57210},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3627":2017,"_31174":1982,"_21594":57212,"_5":14861,"_28366":57126,"_3078":57213},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3627":2018,"_31174":1982,"_21594":57215,"_5":14861,"_28366":57126,"_3078":54400},[],{"_3627":2019,"_31174":1982,"_21594":57217,"_5":14861,"_28366":57126,"_3078":57218},[],"First choice",{"_3627":2020,"_31174":1982,"_21594":57220,"_5":14861,"_28366":57126,"_3078":57221},[],"Second choice",{"_3627":2021,"_31174":1982,"_21594":57223,"_5":14861,"_28366":57126,"_3078":57224},[],"If neither is supplied",{"_3627":2022,"_31174":1982,"_21594":57226,"_5":14861,"_28366":57126,"_3078":57227},[],"Direct signing with a CA",{"_3627":2023,"_31174":1982,"_21594":57229,"_5":14861,"_28366":57126,"_3078":57230},[],"`issuance_profile` embedded in the request",{"_3627":2024,"_31174":1982,"_21594":57232,"_5":14861,"_28366":57126,"_3078":57233},[],"Request `issuance_profile_id`",{"_3627":2025,"_31174":1982,"_21594":57235,"_5":14861,"_28366":57126,"_3078":57236},[],"CA default profile (`profile_id`).",{"_3627":2026,"_31174":1982,"_21594":57238,"_5":14861,"_28366":57126,"_3078":57239},[],"Issuance through a DMS",{"_3627":2027,"_31174":1982,"_21594":57241,"_5":14861,"_28366":57126,"_3078":57242},[],"`settings.issuance_profile_id`",{"_3627":2028,"_31174":1982,"_21594":57244,"_5":14861,"_28366":57126,"_3078":57245},[],"`settings.issuance_profile` embedded in the DMS",{"_3627":2029,"_31174":1982,"_21594":57247,"_5":14861,"_28366":57126,"_3078":57248},[],"Enrollment CA default profile.",{"_3627":2030,"_31174":1982,"_21594":57250,"_5":14861,"_28366":57126,"_3078":57251},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3627":2031,"_31174":1982,"_21594":57253,"_5":14861,"_28366":57126,"_3078":57254},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3627":2032,"_31174":1982,"_21594":57256,"_5":14861,"_28366":57134,"_3078":57257},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3627":2033,"_31174":1982,"_21594":57259,"_5":14861,"_28366":57138,"_3078":57260},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3627":2034,"_31174":1982,"_21594":57262,"_5":14861,"_28366":57142,"_3078":57263},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3627":2035,"_31174":1982,"_21594":57265,"_5":14861,"_28366":57146,"_3078":57266},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3627":2036,"_31174":1982,"_21594":57268,"_5":14861,"_28366":57150,"_3078":57269},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3627":2037,"_31174":1982,"_21594":57271,"_5":14861,"_28366":57150,"_3078":57272},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3627":2038,"_31174":1982,"_21594":57274,"_5":14861,"_28366":57154,"_3078":57275},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3627":2039,"_31174":1982,"_21594":57277,"_5":14861,"_28366":57154,"_3078":57278},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3627":2040,"_31174":1982,"_21594":57280,"_5":14861,"_28366":57154,"_3078":57281},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3627":2041,"_31174":1982,"_21594":57283,"_5":14861,"_28366":57154,"_3078":57284},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3627":2042,"_31174":1982,"_21594":57286,"_5":14861,"_28366":57158,"_3078":57287},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3627":2043,"_31174":1982,"_21594":57289,"_5":14861,"_28366":57158,"_3078":57290},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3627":2044,"_31174":2044,"_5":15221,"_3078":57292,"_31533":57293,"_21594":57295,"_28366":2044},"Certificate validation",[50951,52463,56637,57294],"Validation",[],{"_3627":2045,"_31174":2044,"_21594":57297,"_5":14861,"_28366":2044,"_3078":57298},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3627":2046,"_31174":2044,"_5":31530,"_21594":57300,"_28366":57301,"_3078":57302},[],"/docs/pr-preview/pr-75/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3627":2047,"_31174":2044,"_5":31530,"_21594":57304,"_28366":57305,"_3078":57306},[],"/docs/pr-preview/pr-75/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3627":2048,"_31174":2044,"_5":31530,"_21594":57308,"_28366":57309,"_3078":57310},[],"/docs/pr-preview/pr-75/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3627":2049,"_31174":2044,"_21594":57312,"_5":14861,"_28366":2044,"_3078":57313},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3627":2050,"_31174":2044,"_21594":57315,"_5":14861,"_28366":57301,"_3078":57316},[],"Verify these criteria together:",{"_3627":2051,"_31174":2044,"_21594":57318,"_5":14861,"_28366":57301,"_3078":56263},[],{"_3627":2052,"_31174":2044,"_21594":57320,"_5":14861,"_28366":57301,"_3078":57321},[],"Required result",{"_3627":2053,"_31174":2044,"_21594":57323,"_5":14861,"_28366":57301,"_3078":57324},[],"Chain and signature",{"_3627":2054,"_31174":2044,"_21594":57326,"_5":14861,"_28366":57301,"_3078":57327},[],"Valid chain to a root deliberately installed in the consumer.",{"_3627":2055,"_31174":2044,"_21594":57329,"_5":14861,"_28366":57301,"_3078":57330},[],"Dates",{"_3627":2056,"_31174":2044,"_21594":57332,"_5":14861,"_28366":57301,"_3078":57333},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3627":2057,"_31174":2044,"_21594":57335,"_5":14861,"_28366":57301,"_3078":52132},[],{"_3627":2058,"_31174":2044,"_21594":57337,"_5":14861,"_28366":57301,"_3078":57338},[],"Name, SAN or identifier matches the expected peer.",{"_3627":2059,"_31174":2044,"_21594":57340,"_5":14861,"_28366":57301,"_3078":51341},[],{"_3627":2060,"_31174":2044,"_21594":57342,"_5":14861,"_28366":57301,"_3078":57343},[],"KU, EKU and constraints permit the specific operation.",{"_3627":2061,"_31174":2044,"_21594":57345,"_5":14861,"_28366":57301,"_3078":57346},[],"Revocation",{"_3627":2062,"_31174":2044,"_21594":57348,"_5":14861,"_28366":57301,"_3078":57349},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3627":2063,"_31174":2044,"_21594":57351,"_5":14861,"_28366":57301,"_3078":57352},[],"Authorization",{"_3627":2064,"_31174":2044,"_21594":57354,"_5":14861,"_28366":57301,"_3078":57355},[],"The application permits that identity to perform the action.",{"_3627":2065,"_31174":2044,"_21594":57357,"_5":14861,"_28366":57301,"_3078":57358},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3627":2066,"_31174":2044,"_21594":57360,"_5":14861,"_28366":57305,"_3078":57361},[],"Mechanism",{"_3627":2067,"_31174":2044,"_21594":57363,"_5":14861,"_28366":57305,"_3078":57364},[],"When to use it",{"_3627":2068,"_31174":2044,"_21594":57366,"_5":14861,"_28366":57305,"_3078":57367},[],"What you must maintain",{"_3627":2069,"_31174":2044,"_21594":57369,"_5":14861,"_28366":57305,"_3078":57370},[],"OCSP",{"_3627":2070,"_31174":2044,"_21594":57372,"_5":14861,"_28366":57305,"_3078":57373},[],"Status query for a specific certificate.",{"_3627":2071,"_31174":2044,"_21594":57375,"_5":14861,"_28366":57305,"_3078":57376},[],"Responder access, signature verification and cache/freshness policy.",{"_3627":2072,"_31174":2044,"_21594":57378,"_5":14861,"_28366":57305,"_3078":57379},[],"CRL",{"_3627":2073,"_31174":2044,"_21594":57381,"_5":14861,"_28366":57305,"_3078":57382},[],"Local checks for many certificates or offline operation.",{"_3627":2074,"_31174":2044,"_21594":57384,"_5":14861,"_28366":57305,"_3078":57385},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3627":2075,"_31174":2044,"_21594":57387,"_5":14861,"_28366":57305,"_3078":57388},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3627":2076,"_31174":2044,"_21594":57390,"_5":14861,"_28366":57305,"_3078":57391},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3627":2077,"_31174":2044,"_21594":57393,"_5":14861,"_28366":57309,"_3078":57394},[],"Accept a current, authorized certificate with a known chain.",{"_3627":2078,"_31174":2044,"_21594":57396,"_5":14861,"_28366":57309,"_3078":57397},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3627":2079,"_31174":2044,"_21594":57399,"_5":14861,"_28366":57309,"_3078":57400},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3627":2080,"_31174":2044,"_21594":57402,"_5":14861,"_28366":57309,"_3078":57403},[],"Check that a new connection with that identity is rejected.",{"_3627":2081,"_31174":2044,"_21594":57405,"_5":14861,"_28366":57309,"_3078":57406},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3627":2082,"_31174":2044,"_21594":57408,"_5":14861,"_28366":57309,"_3078":57409},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3627":2083,"_31174":2044,"_21594":57411,"_5":14861,"_28366":57309,"_3078":57412},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3627":2084,"_31174":2044,"_21594":57414,"_5":14861,"_28366":57309,"_3078":57415},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3627":2085,"_31174":2044,"_21594":57417,"_5":14861,"_28366":57309,"_3078":57418},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3627":2086,"_31174":2086,"_5":15221,"_3078":57420,"_31533":57421,"_21594":57422,"_28366":2086},"Certificates",[50951,52463,56637,56638],[],{"_3627":2087,"_31174":2086,"_21594":57424,"_5":14861,"_28366":2086,"_3078":57425},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3627":2088,"_31174":2086,"_5":31530,"_21594":57427,"_28366":57428,"_3078":57429},[],"/docs/pr-preview/pr-75/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3627":2089,"_31174":2086,"_5":31530,"_21594":57431,"_28366":57432,"_3078":57433},[],"/docs/pr-preview/pr-75/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3627":2090,"_31174":2086,"_5":31530,"_21594":57435,"_28366":57436,"_3078":57437},[],"/docs/pr-preview/pr-75/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3627":2091,"_31174":2086,"_5":31530,"_21594":57439,"_28366":57440,"_3078":57441},[],"/docs/pr-preview/pr-75/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3627":2092,"_31174":2086,"_5":31530,"_21594":57443,"_28366":57444,"_3078":57445},[],"/docs/pr-preview/pr-75/platform/pki/certificates#open-the-action","Open the action",{"_3627":2093,"_31174":2086,"_5":31530,"_21594":57447,"_28366":57448,"_3078":57449},[],"/docs/pr-preview/pr-75/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3627":2094,"_31174":2086,"_5":31530,"_21594":57451,"_28366":57452,"_3078":57453},[],"/docs/pr-preview/pr-75/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3627":2095,"_31174":2086,"_5":31530,"_21594":57455,"_28366":57456,"_3078":57457},[],"/docs/pr-preview/pr-75/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3627":2096,"_31174":2086,"_5":31530,"_21594":57459,"_28366":57460,"_3078":57461},[],"/docs/pr-preview/pr-75/platform/pki/certificates#continue","Continue",{"_3627":2097,"_31174":2086,"_21594":57463,"_5":14861,"_28366":2086,"_3078":57464},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3627":2098,"_31174":2086,"_21594":57466,"_5":14861,"_28366":57428,"_3078":57467},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3627":2099,"_31174":2086,"_21594":57469,"_5":14861,"_28366":57428,"_3078":57470},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3627":2100,"_31174":2086,"_21594":57472,"_5":14861,"_28366":57428,"_3078":57473},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3627":2101,"_31174":2086,"_21594":57475,"_5":14861,"_28366":57428,"_3078":57476},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3627":2102,"_31174":2086,"_21594":57478,"_5":14861,"_28366":57428,"_3078":57479},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3627":2103,"_31174":2086,"_21594":57481,"_5":14861,"_28366":57428,"_3078":57482},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3627":2104,"_31174":2086,"_21594":57484,"_5":14861,"_28366":57428,"_3078":57485},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3627":2105,"_31174":2086,"_21594":57487,"_5":14861,"_28366":57432,"_3078":57488},[],"Download the PEM and inspect it:",{"_3627":2106,"_31174":2086,"_21594":57490,"_5":14861,"_28366":57432,"_3078":57491},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3627":2107,"_31174":2086,"_21594":57493,"_5":14861,"_28366":57436,"_3078":57494},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3627":2108,"_31174":2086,"_21594":57496,"_5":14861,"_28366":57436,"_3078":57497},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3627":2109,"_31174":2086,"_21594":57499,"_5":14861,"_28366":57436,"_3078":57500},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3627":2110,"_31174":2086,"_21594":57502,"_5":14861,"_28366":57436,"_3078":57503},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3627":2111,"_31174":2086,"_21594":57505,"_5":14861,"_28366":57436,"_3078":57506},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3627":2112,"_31174":2086,"_21594":57508,"_5":14861,"_28366":57436,"_3078":57509},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3627":2113,"_31174":2086,"_21594":57511,"_5":14861,"_28366":57436,"_3078":57512},[],"For browser key generation, follow Issue your first certificate.",{"_3627":2114,"_31174":2086,"_21594":57514,"_5":14861,"_28366":57440,"_3078":57515},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3627":2115,"_31174":2086,"_21594":57517,"_5":14861,"_28366":57444,"_3078":57518},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3627":2116,"_31174":2086,"_21594":57520,"_5":14861,"_28366":57448,"_3078":57521},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3627":2117,"_31174":2086,"_21594":57523,"_5":14861,"_28366":57452,"_3078":57524},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3627":2118,"_31174":2086,"_21594":57526,"_5":14861,"_28366":57452,"_3078":57527},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3627":2119,"_31174":2086,"_21594":57529,"_5":14861,"_28366":57452,"_3078":57530},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3627":2120,"_31174":2086,"_21594":57532,"_5":14861,"_28366":57456,"_3078":57533},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3627":2121,"_31174":2086,"_21594":57535,"_5":14861,"_28366":57456,"_3078":57536},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3627":2122,"_31174":2086,"_21594":57538,"_5":14861,"_28366":57456,"_3078":57539},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3627":2123,"_31174":2086,"_21594":57541,"_5":14861,"_28366":57460,"_3078":57542},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3627":2124,"_31174":2086,"_21594":57544,"_5":14861,"_28366":57460,"_3078":57545},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3627":2125,"_31174":2125,"_5":15221,"_3078":57547,"_31533":57548,"_21594":57550,"_28366":2125},"Certificate lifecycle",[50951,52463,56637,57549],"Concepts",[],{"_3627":2126,"_31174":2125,"_21594":57552,"_5":14861,"_28366":2125,"_3078":57553},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3627":2127,"_31174":2125,"_5":31530,"_21594":57555,"_28366":57556,"_3078":57557},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3627":2128,"_31174":2125,"_5":31530,"_21594":57559,"_28366":57560,"_3078":57561},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3627":2129,"_31174":2125,"_5":31530,"_21594":57563,"_28366":57564,"_3078":57565},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3627":2130,"_31174":2125,"_5":31530,"_21594":57567,"_28366":57568,"_3078":57569},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3627":2131,"_31174":2125,"_5":31530,"_21594":57571,"_28366":57572,"_3078":57573},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3627":2132,"_31174":2125,"_5":31530,"_21594":57575,"_28366":57576,"_3078":57577},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3627":2133,"_31174":2125,"_5":31530,"_21594":57579,"_28366":57580,"_3078":57581},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3627":2134,"_31174":2125,"_5":31530,"_21594":57583,"_28366":57584,"_3078":57585},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3627":2135,"_31174":2125,"_5":31530,"_21594":57587,"_28366":57588,"_3078":57589},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3627":2136,"_31174":2125,"_5":31530,"_21594":57591,"_28366":57592,"_3078":57593},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3627":2137,"_31174":2125,"_21594":57595,"_5":14861,"_28366":2125,"_3078":57596},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3627":2138,"_31174":2125,"_21594":57598,"_5":14861,"_28366":57560,"_3078":57599},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3627":2139,"_31174":2125,"_21594":57601,"_5":14861,"_28366":57564,"_3078":57602},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3627":2140,"_31174":2125,"_21594":57604,"_5":14861,"_28366":57568,"_3078":57605},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3627":2141,"_31174":2125,"_21594":57607,"_5":14861,"_28366":57572,"_3078":57608},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3627":2142,"_31174":2125,"_21594":57610,"_5":14861,"_28366":57576,"_3078":57611},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3627":2143,"_31174":2125,"_21594":57613,"_5":14861,"_28366":57580,"_3078":57614},[],"Lamassu persists four X.509 states:",{"_3627":2144,"_31174":2125,"_21594":57616,"_5":14861,"_28366":57580,"_3078":57617},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3627":2145,"_31174":2125,"_21594":57619,"_5":14861,"_28366":57580,"_3078":57620},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3627":2146,"_31174":2125,"_21594":57622,"_5":14861,"_28366":57580,"_3078":57623},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3627":2147,"_31174":2125,"_21594":57625,"_5":14861,"_28366":57580,"_3078":57626},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3627":2148,"_31174":2125,"_21594":57628,"_5":14861,"_28366":57580,"_3078":57629},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3627":2149,"_31174":2125,"_21594":57631,"_5":14861,"_28366":57584,"_3078":57632},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3627":2150,"_31174":2125,"_21594":57634,"_5":14861,"_28366":57584,"_3078":57635},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3627":2151,"_31174":2125,"_21594":57637,"_5":14861,"_28366":57584,"_3078":57638},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3627":2152,"_31174":2125,"_21594":57640,"_5":14861,"_28366":57588,"_3078":57641},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3627":2153,"_31174":2125,"_21594":57643,"_5":14861,"_28366":57588,"_3078":57644},[],"Before confirming:",{"_3627":2154,"_31174":2125,"_21594":57646,"_5":14861,"_28366":57588,"_3078":57647},[],"Identify DMSs, devices and services that trust that chain.",{"_3627":2155,"_31174":2125,"_21594":57649,"_5":14861,"_28366":57588,"_3078":57650},[],"Distribute the new chain of trust.",{"_3627":2156,"_31174":2125,"_21594":57652,"_5":14861,"_28366":57588,"_3078":57653},[],"Reissue the necessary identities.",{"_3627":2157,"_31174":2125,"_21594":57655,"_5":14861,"_28366":57588,"_3078":57656},[],"Check OCSP and CRL from a real consumer.",{"_3627":2158,"_31174":2125,"_21594":57658,"_5":14861,"_28366":57588,"_3078":57659},[],"Revoke the old CA once no legitimate traffic remains.",{"_3627":2159,"_31174":2125,"_21594":57661,"_5":14861,"_28366":57588,"_3078":57662},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3627":2160,"_31174":2125,"_21594":57664,"_5":14861,"_28366":57592,"_3078":57665},[],"Certificates entering the preventive or critical renewal window.",{"_3627":2161,"_31174":2125,"_21594":57667,"_5":14861,"_28366":57592,"_3078":57668},[],"Repeated enrollment or re-enrollment failures.",{"_3627":2162,"_31174":2125,"_21594":57670,"_5":14861,"_28366":57592,"_3078":57671},[],"Status changes and revocation reasons.",{"_3627":2163,"_31174":2125,"_21594":57673,"_5":14861,"_28366":57592,"_3078":57674},[],"OCSP and CRL publication and validity.",{"_3627":2164,"_31174":2125,"_21594":57676,"_5":14861,"_28366":57592,"_3078":57677},[],"Dependencies still presenting a replaced certificate.",{"_3627":2165,"_31174":2125,"_21594":57679,"_5":14861,"_28366":57592,"_3078":57680},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3627":2166,"_31174":2166,"_5":15221,"_3078":57682,"_31533":57683,"_21594":57684,"_28366":2166},"Trust model",[50951,52463,56637,57549],[],{"_3627":2167,"_31174":2166,"_21594":57686,"_5":14861,"_28366":2166,"_3078":57687},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3627":2168,"_31174":2166,"_5":31530,"_21594":57689,"_28366":57690,"_3078":57691},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3627":2169,"_31174":2166,"_5":31530,"_21594":57693,"_28366":57694,"_3078":57695},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3627":2170,"_31174":2166,"_5":31530,"_21594":57697,"_28366":57698,"_3078":57699},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3627":2171,"_31174":2166,"_5":31530,"_21594":57701,"_28366":57702,"_3078":57703},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3627":2172,"_31174":2166,"_5":31530,"_21594":57705,"_28366":57706,"_3078":57707},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3627":2173,"_31174":2166,"_5":31530,"_21594":57709,"_28366":57710,"_3078":57711},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3627":2174,"_31174":2166,"_5":31530,"_21594":57713,"_28366":57714,"_3078":57715},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3627":2175,"_31174":2166,"_5":31530,"_21594":57717,"_28366":57718,"_3078":57719},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3627":2176,"_31174":2166,"_5":31530,"_21594":57721,"_28366":57722,"_3078":57723},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3627":2177,"_31174":2166,"_5":31530,"_21594":57725,"_28366":57726,"_3078":57727},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3627":2178,"_31174":2166,"_21594":57729,"_5":14861,"_28366":2166,"_3078":57730},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3627":2179,"_31174":2166,"_21594":57732,"_5":14861,"_28366":57694,"_3078":57733},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3627":2180,"_31174":2166,"_21594":57735,"_5":14861,"_28366":57698,"_3078":57736},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3627":2181,"_31174":2166,"_21594":57738,"_5":14861,"_28366":57702,"_3078":57739},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3627":2182,"_31174":2166,"_21594":57741,"_5":14861,"_28366":57706,"_3078":57742},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3627":2183,"_31174":2166,"_21594":57744,"_5":14861,"_28366":57710,"_3078":57745},[],"The device proves it can enroll according to the DMS policy.",{"_3627":2184,"_31174":2166,"_21594":57747,"_5":14861,"_28366":57710,"_3078":57748},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3627":2185,"_31174":2166,"_21594":57750,"_5":14861,"_28366":57710,"_3078":57751},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3627":2186,"_31174":2166,"_21594":57753,"_5":14861,"_28366":57710,"_3078":57754},[],"The device installs the certificate and the chain it needs.",{"_3627":2187,"_31174":2166,"_21594":57756,"_5":14861,"_28366":57710,"_3078":57757},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3627":2188,"_31174":2166,"_21594":57759,"_5":14861,"_28366":57710,"_3078":57760},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3627":2189,"_31174":2166,"_21594":57762,"_5":14861,"_28366":57714,"_3078":57763},[],"A DMS relates three sets that are worth designing separately:",{"_3627":2190,"_31174":2166,"_21594":57765,"_5":14861,"_28366":57714,"_3078":57766},[],"**Enrollment CA:** signs the new identities.",{"_3627":2191,"_31174":2166,"_21594":57768,"_5":14861,"_28366":57714,"_3078":57769},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3627":2192,"_31174":2166,"_21594":57771,"_5":14861,"_28366":57714,"_3078":57772},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3627":2193,"_31174":2166,"_21594":57774,"_5":14861,"_28366":57714,"_3078":57775},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3627":2194,"_31174":2166,"_21594":57777,"_5":14861,"_28366":57718,"_3078":57778},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3627":2195,"_31174":2166,"_21594":57780,"_5":14861,"_28366":57718,"_3078":57781},[],"that the current date is between `Not Before` and `Not After`;",{"_3627":2196,"_31174":2166,"_21594":57783,"_5":14861,"_28366":57718,"_3078":57784},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3627":2197,"_31174":2166,"_21594":57786,"_5":14861,"_28366":57718,"_3078":57787},[],"that names, SANs and subject match the expected identity;",{"_3627":2198,"_31174":2166,"_21594":57789,"_5":14861,"_28366":57718,"_3078":57790},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3627":2199,"_31174":2166,"_21594":57792,"_5":14861,"_28366":57718,"_3078":57793},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3627":2200,"_31174":2166,"_21594":57795,"_5":14861,"_28366":57718,"_3078":57796},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3627":2201,"_31174":2166,"_21594":57798,"_5":14861,"_28366":57722,"_3078":57799},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3627":2202,"_31174":2166,"_21594":57801,"_5":14861,"_28366":57726,"_3078":57802},[],"Keep the root out of daily operations, or with very restricted access.",{"_3627":2203,"_31174":2166,"_21594":57804,"_5":14861,"_28366":57726,"_3078":57805},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3627":2204,"_31174":2166,"_21594":57807,"_5":14861,"_28366":57726,"_3078":57808},[],"Assign explicit profiles to every use case.",{"_3627":2205,"_31174":2166,"_21594":57810,"_5":14861,"_28366":57726,"_3078":57811},[],"Distribute the new trust before starting a rotation.",{"_3627":2206,"_31174":2166,"_21594":57813,"_5":14861,"_28366":57726,"_3078":57814},[],"Keep enough overlap to renew a disconnected fleet.",{"_3627":2207,"_31174":2166,"_21594":57816,"_5":14861,"_28366":57726,"_3078":57817},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3627":2208,"_31174":2166,"_21594":57819,"_5":14861,"_28366":57726,"_3078":57820},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3627":2209,"_31174":2209,"_5":15221,"_3078":57822,"_31533":57823,"_21594":57824,"_28366":2209},"Revocation lists (CRL)",[50951,52463,56637,57294],[],{"_3627":2210,"_31174":2209,"_21594":57826,"_5":14861,"_28366":2209,"_3078":57827},[],"Generate and distribute signed lists to validate certificates offline.",{"_3627":2211,"_31174":2209,"_5":31530,"_21594":57829,"_28366":57830,"_3078":57831},[],"/docs/pr-preview/pr-75/platform/pki/crl#crl-settings","CRL settings",{"_3627":2212,"_31174":2209,"_5":31530,"_21594":57833,"_28366":57834,"_3078":57835},[],"/docs/pr-preview/pr-75/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3627":2213,"_31174":2209,"_5":31530,"_21594":57837,"_28366":57838,"_3078":57839},[],"/docs/pr-preview/pr-75/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3627":2214,"_31174":2209,"_5":31530,"_21594":57841,"_28366":57842,"_3078":57843},[],"/docs/pr-preview/pr-75/platform/pki/crl#crl-contents","CRL contents",{"_3627":2215,"_31174":2209,"_5":31530,"_21594":57845,"_28366":57846,"_3078":57847},[],"/docs/pr-preview/pr-75/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3627":2216,"_31174":2209,"_5":31530,"_21594":57849,"_28366":57850,"_3078":57851},[],"/docs/pr-preview/pr-75/platform/pki/crl#crl-settings-api","CRL settings API",{"_3627":2217,"_31174":2209,"_5":31530,"_21594":57853,"_28366":57854,"_3078":57855},[],"/docs/pr-preview/pr-75/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3627":2218,"_31174":2209,"_5":31530,"_21594":57857,"_28366":57858,"_3078":57859},[],"/docs/pr-preview/pr-75/platform/pki/crl#references","References",{"_3627":2219,"_31174":2209,"_21594":57861,"_5":14861,"_28366":2209,"_3078":57862},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3627":2220,"_31174":2209,"_21594":57864,"_5":14861,"_28366":57830,"_3078":57865},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3627":2221,"_31174":2209,"_21594":57867,"_5":14861,"_28366":57830,"_3078":57868},[],"Field",{"_3627":2222,"_31174":2209,"_21594":57870,"_5":14861,"_28366":57830,"_3078":51341},[],{"_3627":2223,"_31174":2209,"_21594":57872,"_5":14861,"_28366":57830,"_3078":52583},[],{"_3627":2224,"_31174":2209,"_21594":57874,"_5":14861,"_28366":57830,"_3078":57875},[],"ID of the CA the settings belong to.",{"_3627":2225,"_31174":2209,"_21594":57877,"_5":14861,"_28366":57830,"_3078":57878},[],"`status`",{"_3627":2226,"_31174":2209,"_21594":57880,"_5":14861,"_28366":57830,"_3078":57881},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3627":2227,"_31174":2209,"_21594":57883,"_5":14861,"_28366":57830,"_3078":57884},[],"`legacy_ski`",{"_3627":2228,"_31174":2209,"_21594":57886,"_5":14861,"_28366":57830,"_3078":57887},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3627":2229,"_31174":2209,"_21594":57889,"_5":14861,"_28366":57830,"_3078":57890},[],"`latest_crl`",{"_3627":2230,"_31174":2209,"_21594":57892,"_5":14861,"_28366":57830,"_3078":57893},[],"Version, validity start and end of the last published list. Read-only.",{"_3627":2231,"_31174":2209,"_21594":57895,"_5":14861,"_28366":57830,"_3078":57896},[],"`crl_options` field",{"_3627":2232,"_31174":2209,"_21594":57898,"_5":14861,"_28366":57830,"_3078":51341},[],{"_3627":2233,"_31174":2209,"_21594":57900,"_5":14861,"_28366":57830,"_3078":57901},[],"Initial value",{"_3627":2234,"_31174":2209,"_21594":57903,"_5":14861,"_28366":57830,"_3078":57904},[],"`validity`",{"_3627":2235,"_31174":2209,"_21594":57906,"_5":14861,"_28366":57830,"_3078":57907},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3627":2236,"_31174":2209,"_21594":57909,"_5":14861,"_28366":57830,"_3078":57910},[],"7 days.",{"_3627":2237,"_31174":2209,"_21594":57912,"_5":14861,"_28366":57830,"_3078":57913},[],"`refresh_interval`",{"_3627":2238,"_31174":2209,"_21594":57915,"_5":14861,"_28366":57830,"_3078":57916},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3627":2239,"_31174":2209,"_21594":57918,"_5":14861,"_28366":57830,"_3078":57919},[],"6 days and 23 hours.",{"_3627":2240,"_31174":2209,"_21594":57921,"_5":14861,"_28366":57830,"_3078":57922},[],"`regenerate_on_revoke`",{"_3627":2241,"_31174":2209,"_21594":57924,"_5":14861,"_28366":57830,"_3078":57925},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3627":2242,"_31174":2209,"_21594":57927,"_5":14861,"_28366":57830,"_3078":57928},[],"`true`.",{"_3627":2243,"_31174":2209,"_21594":57930,"_5":14861,"_28366":57830,"_3078":57931},[],"`signer_serial_number`",{"_3627":2244,"_31174":2209,"_21594":57933,"_5":14861,"_28366":57830,"_3078":57934},[],"Serial number of the existing certificate that signs the CRL.",{"_3627":2245,"_31174":2209,"_21594":57936,"_5":14861,"_28366":57830,"_3078":57937},[],"Serial number of the CA’s current certificate.",{"_3627":2246,"_31174":2209,"_21594":57939,"_5":14861,"_28366":57830,"_3078":57940},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3627":2247,"_31174":2209,"_21594":57942,"_5":14861,"_28366":57830,"_3078":57943},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3627":2248,"_31174":2209,"_21594":57945,"_5":14861,"_28366":57830,"_3078":57946},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3627":2249,"_31174":2209,"_21594":57948,"_5":14861,"_28366":57830,"_3078":57949},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3627":2250,"_31174":2209,"_21594":57951,"_5":14861,"_28366":57830,"_3078":57952},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3627":2251,"_31174":2209,"_21594":57954,"_5":14861,"_28366":57830,"_3078":57955},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3627":2252,"_31174":2209,"_21594":57957,"_5":14861,"_28366":57830,"_3078":57958},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3627":2253,"_31174":2209,"_21594":57960,"_5":14861,"_28366":57830,"_3078":57961},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3627":2254,"_31174":2209,"_21594":57963,"_5":14861,"_28366":57830,"_3078":57964},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3627":2255,"_31174":2209,"_21594":57966,"_5":14861,"_28366":57830,"_3078":57967},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3627":2256,"_31174":2209,"_21594":57969,"_5":14861,"_28366":57830,"_3078":57970},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3627":2257,"_31174":2209,"_21594":57972,"_5":14861,"_28366":57834,"_3078":57973},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3627":2258,"_31174":2209,"_21594":57975,"_5":14861,"_28366":57834,"_3078":57976},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3627":2259,"_31174":2209,"_21594":57978,"_5":14861,"_28366":57834,"_3078":57979},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3627":2260,"_31174":2209,"_21594":57981,"_5":14861,"_28366":57834,"_3078":57982},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3627":2261,"_31174":2209,"_21594":57984,"_5":14861,"_28366":57838,"_3078":57985},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3627":2262,"_31174":2209,"_21594":57987,"_5":14861,"_28366":57838,"_3078":57988},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3627":2263,"_31174":2209,"_21594":57990,"_5":14861,"_28366":57838,"_3078":57991},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3627":2264,"_31174":2209,"_21594":57993,"_5":14861,"_28366":57838,"_3078":57994},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3627":2265,"_31174":2209,"_21594":57996,"_5":14861,"_28366":57838,"_3078":57997},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3627":2266,"_31174":2209,"_21594":57999,"_5":14861,"_28366":57838,"_3078":58000},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3627":2267,"_31174":2209,"_21594":58002,"_5":14861,"_28366":57838,"_3078":58003},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3627":2268,"_31174":2209,"_21594":58005,"_5":14861,"_28366":57838,"_3078":58006},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3627":2269,"_31174":2209,"_21594":58008,"_5":14861,"_28366":57838,"_3078":58009},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3627":2270,"_31174":2209,"_21594":58011,"_5":14861,"_28366":57842,"_3078":58012},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3627":2271,"_31174":2209,"_21594":58014,"_5":14861,"_28366":57842,"_3078":58015},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3627":2272,"_31174":2209,"_21594":58017,"_5":14861,"_28366":57846,"_3078":58018},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3627":2273,"_31174":2209,"_21594":58020,"_5":14861,"_28366":57846,"_3078":58021},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3627":2274,"_31174":2209,"_21594":58023,"_5":14861,"_28366":57846,"_3078":58024},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3627":2275,"_31174":2209,"_21594":58026,"_5":14861,"_28366":57846,"_3078":58027},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3627":2276,"_31174":2209,"_21594":58029,"_5":14861,"_28366":57846,"_3078":58030},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3627":2277,"_31174":2209,"_21594":58032,"_5":14861,"_28366":57850,"_3078":58033},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3627":2278,"_31174":2209,"_21594":58035,"_5":14861,"_28366":57850,"_3078":54403},[],{"_3627":2279,"_31174":2209,"_21594":58037,"_5":14861,"_28366":57850,"_3078":58038},[],"Relative path",{"_3627":2280,"_31174":2209,"_21594":58040,"_5":14861,"_28366":57850,"_3078":54400},[],{"_3627":2281,"_31174":2209,"_21594":58042,"_5":14861,"_28366":57850,"_3078":58043},[],"`GET`",{"_3627":2282,"_31174":2209,"_21594":58045,"_5":14861,"_28366":57850,"_3078":58046},[],"`/v1/crl-settings`",{"_3627":2283,"_31174":2209,"_21594":58048,"_5":14861,"_28366":57850,"_3078":58049},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3627":2284,"_31174":2209,"_21594":58051,"_5":14861,"_28366":57850,"_3078":58043},[],{"_3627":2285,"_31174":2209,"_21594":58053,"_5":14861,"_28366":57850,"_3078":58054},[],"`/v1/crl-settings/{ca-id}`",{"_3627":2286,"_31174":2209,"_21594":58056,"_5":14861,"_28366":57850,"_3078":58057},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3627":2287,"_31174":2209,"_21594":58059,"_5":14861,"_28366":57850,"_3078":58060},[],"`PUT`",{"_3627":2288,"_31174":2209,"_21594":58062,"_5":14861,"_28366":57850,"_3078":58054},[],{"_3627":2289,"_31174":2209,"_21594":58064,"_5":14861,"_28366":57850,"_3078":58065},[],"Replace the CRL configuration of a CA.",{"_3627":2290,"_31174":2209,"_21594":58067,"_5":14861,"_28366":57850,"_3078":58068},[],"`DELETE`",{"_3627":2291,"_31174":2209,"_21594":58070,"_5":14861,"_28366":57850,"_3078":58054},[],{"_3627":2292,"_31174":2209,"_21594":58072,"_5":14861,"_28366":57850,"_3078":58073},[],"Remove the archived CRL settings of a CA.",{"_3627":2293,"_31174":2209,"_21594":58075,"_5":14861,"_28366":57850,"_3078":58076},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3627":2294,"_31174":2209,"_21594":58078,"_5":14861,"_28366":57850,"_3078":58079},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3627":2295,"_31174":2209,"_21594":58081,"_5":14861,"_28366":57850,"_3078":58082},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3627":2296,"_31174":2209,"_21594":58084,"_5":14861,"_28366":57854,"_3078":58085},[],"Symptom",{"_3627":2297,"_31174":2209,"_21594":58087,"_5":14861,"_28366":57854,"_3078":58088},[],"Cause",{"_3627":2298,"_31174":2209,"_21594":58090,"_5":14861,"_28366":57854,"_3078":58091},[],"Action",{"_3627":2299,"_31174":2209,"_21594":58093,"_5":14861,"_28366":57854,"_3078":58094},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3627":2300,"_31174":2209,"_21594":58096,"_5":14861,"_28366":57854,"_3078":58097},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3627":2301,"_31174":2209,"_21594":58099,"_5":14861,"_28366":57854,"_3078":58100},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3627":2302,"_31174":2209,"_21594":58102,"_5":14861,"_28366":57854,"_3078":58103},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3627":2303,"_31174":2209,"_21594":58105,"_5":14861,"_28366":57854,"_3078":58106},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3627":2304,"_31174":2209,"_21594":58108,"_5":14861,"_28366":57854,"_3078":58109},[],"Delete the CA first; deleting it archives its settings.",{"_3627":2305,"_31174":2209,"_21594":58111,"_5":14861,"_28366":57854,"_3078":58112},[],"`PUT` returns 400.",{"_3627":2306,"_31174":2209,"_21594":58114,"_5":14861,"_28366":57854,"_3078":58115},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3627":2307,"_31174":2209,"_21594":58117,"_5":14861,"_28366":57854,"_3078":58118},[],"Set the serial number of a valid certificate of that CA.",{"_3627":2308,"_31174":2209,"_21594":58120,"_5":14861,"_28366":57854,"_3078":58121},[],"`PUT` returns 404.",{"_3627":2309,"_31174":2209,"_21594":58123,"_5":14861,"_28366":57854,"_3078":58124},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3627":2310,"_31174":2209,"_21594":58126,"_5":14861,"_28366":57854,"_3078":58127},[],"Check the CA ID and the signer serial number.",{"_3627":2311,"_31174":2209,"_21594":58129,"_5":14861,"_28366":57854,"_3078":58130},[],"`PUT` returns 400 from a 3.x client.",{"_3627":2312,"_31174":2209,"_21594":58132,"_5":14861,"_28366":57854,"_3078":58133},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3627":2313,"_31174":2209,"_21594":58135,"_5":14861,"_28366":57854,"_3078":58136},[],"Update the client to send the new field.",{"_3627":2314,"_31174":2209,"_21594":58138,"_5":14861,"_28366":57854,"_3078":58139},[],"The CRL does not change after revoking a certificate.",{"_3627":2315,"_31174":2209,"_21594":58141,"_5":14861,"_28366":57854,"_3078":58142},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3627":2316,"_31174":2209,"_21594":58144,"_5":14861,"_28366":57854,"_3078":58145},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3627":2317,"_31174":2209,"_21594":58147,"_5":14861,"_28366":57854,"_3078":58148},[],"A verifier rejects the CRL because of the issuer.",{"_3627":2318,"_31174":2209,"_21594":58150,"_5":14861,"_28366":57854,"_3078":58151},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3627":2319,"_31174":2209,"_21594":58153,"_5":14861,"_28366":57854,"_3078":58154},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3627":2320,"_31174":2209,"_21594":58156,"_5":14861,"_28366":57858,"_3078":58157},[],"RFC 5280: X.509 and CRL profile.",{"_3627":2321,"_31174":2209,"_21594":58159,"_5":14861,"_28366":57858,"_3078":58160},[],"OpenSSL: openssl-crl.",{"_3627":2322,"_31174":2209,"_21594":58162,"_5":14861,"_28366":57858,"_3078":58163},[],"OpenSSL: openssl-verify.",{"_3627":2323,"_31174":2209,"_21594":58165,"_5":14861,"_28366":57858,"_3078":58166},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3627":2324,"_31174":2209,"_21594":58168,"_5":14861,"_28366":57858,"_3078":58169},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3627":2325,"_31174":2325,"_5":15221,"_3078":58171,"_31533":58172,"_21594":58173,"_28366":2325},"Keys and cryptographic engines",[50951,52463,56637,56638],[],{"_3627":2326,"_31174":2325,"_21594":58175,"_5":14861,"_28366":2325,"_3078":58176},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3627":2327,"_31174":2325,"_5":31530,"_21594":58178,"_28366":58179,"_3078":58180},[],"/docs/pr-preview/pr-75/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3627":2328,"_31174":2325,"_5":31530,"_21594":58182,"_28366":58183,"_3078":58184},[],"/docs/pr-preview/pr-75/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3627":2329,"_31174":2325,"_5":31530,"_21594":58186,"_28366":58187,"_3078":58188},[],"/docs/pr-preview/pr-75/platform/pki/key-management#file-system","File System",{"_3627":2330,"_31174":2325,"_5":31530,"_21594":58190,"_28366":58191,"_3078":58192},[],"/docs/pr-preview/pr-75/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3627":2331,"_31174":2325,"_5":31530,"_21594":58194,"_28366":58195,"_3078":58196},[],"/docs/pr-preview/pr-75/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3627":2332,"_31174":2325,"_5":31530,"_21594":58198,"_28366":58199,"_3078":58200},[],"/docs/pr-preview/pr-75/platform/pki/key-management#aws-kms","AWS KMS",{"_3627":2333,"_31174":2325,"_5":31530,"_21594":58202,"_28366":58203,"_3078":58204},[],"/docs/pr-preview/pr-75/platform/pki/key-management#pkcs11","PKCS#11",{"_3627":2334,"_31174":2325,"_5":31530,"_21594":58206,"_28366":58207,"_3078":58208},[],"/docs/pr-preview/pr-75/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3627":2335,"_31174":2325,"_5":31530,"_21594":58210,"_28366":58211,"_3078":58212},[],"/docs/pr-preview/pr-75/platform/pki/key-management#key-inventory","Key inventory",{"_3627":2336,"_31174":2325,"_5":31530,"_21594":58214,"_28366":58215,"_3078":58216},[],"/docs/pr-preview/pr-75/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3627":2337,"_31174":2325,"_5":31530,"_21594":58218,"_28366":58219,"_3078":58220},[],"/docs/pr-preview/pr-75/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3627":2338,"_31174":2325,"_5":31530,"_21594":58222,"_28366":58223,"_3078":58224},[],"/docs/pr-preview/pr-75/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3627":2339,"_31174":2325,"_5":31530,"_21594":58226,"_28366":58227,"_3078":58228},[],"/docs/pr-preview/pr-75/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3627":2340,"_31174":2325,"_5":31530,"_21594":58230,"_28366":58231,"_3078":58232},[],"/docs/pr-preview/pr-75/platform/pki/key-management#view-details","View details",{"_3627":2341,"_31174":2325,"_5":31530,"_21594":58234,"_28366":58235,"_3078":58236},[],"/docs/pr-preview/pr-75/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3627":2342,"_31174":2325,"_5":31530,"_21594":58238,"_28366":58239,"_3078":58240},[],"/docs/pr-preview/pr-75/platform/pki/key-management#sign","Sign",{"_3627":2343,"_31174":2325,"_5":31530,"_21594":58242,"_28366":58243,"_3078":58244},[],"/docs/pr-preview/pr-75/platform/pki/key-management#verify","Verify",{"_3627":2344,"_31174":2325,"_5":31530,"_21594":58246,"_28366":58247,"_3078":58248},[],"/docs/pr-preview/pr-75/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3627":2345,"_31174":2325,"_5":31530,"_21594":58250,"_28366":58251,"_3078":58252},[],"/docs/pr-preview/pr-75/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3627":2346,"_31174":2325,"_5":31530,"_21594":58254,"_28366":58255,"_3078":58256},[],"/docs/pr-preview/pr-75/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3627":2347,"_31174":2325,"_21594":58258,"_5":14861,"_28366":2325,"_3078":58259},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3627":2348,"_31174":2325,"_21594":58261,"_5":14861,"_28366":2325,"_3078":58262},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3627":2349,"_31174":2325,"_21594":58264,"_5":14861,"_28366":58179,"_3078":58265},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3627":2350,"_31174":2325,"_21594":58267,"_5":14861,"_28366":58179,"_3078":58268},[],"In practice, it lets you:",{"_3627":2351,"_31174":2325,"_21594":58270,"_5":14861,"_28366":58179,"_3078":58271},[],"Generate new key pairs from Lamassu IoT.",{"_3627":2352,"_31174":2325,"_21594":58273,"_5":14861,"_28366":58179,"_3078":58274},[],"Import keys created externally.",{"_3627":2353,"_31174":2325,"_21594":58276,"_5":14861,"_28366":58179,"_3078":58277},[],"Delegate custody and cryptographic operations to external engines.",{"_3627":2354,"_31174":2325,"_21594":58279,"_5":14861,"_28366":58179,"_3078":58280},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3627":2355,"_31174":2325,"_21594":58282,"_5":14861,"_28366":58183,"_3078":58283},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3627":2356,"_31174":2325,"_21594":58285,"_5":14861,"_28366":58183,"_3078":58286},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3627":2357,"_31174":2325,"_21594":58288,"_5":14861,"_28366":58183,"_3078":58289},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3627":2358,"_31174":2325,"_21594":58291,"_5":14861,"_28366":58187,"_3078":58292},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3627":2359,"_31174":2325,"_21594":58294,"_5":14861,"_28366":58191,"_3078":58295},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3627":2360,"_31174":2325,"_21594":58297,"_5":14861,"_28366":58191,"_3078":58298},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3627":2361,"_31174":2325,"_21594":58300,"_5":14861,"_28366":58195,"_3078":58301},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3627":2362,"_31174":2325,"_21594":58303,"_5":14861,"_28366":58199,"_3078":58304},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3627":2363,"_31174":2325,"_21594":58306,"_5":14861,"_28366":58203,"_3078":58307},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3627":2364,"_31174":2325,"_21594":58309,"_5":14861,"_28366":58207,"_3078":58310},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3627":2365,"_31174":2325,"_21594":58312,"_5":14861,"_28366":58207,"_3078":58313},[],"Lamassu shows the enabled engines in the console.",{"_3627":2366,"_31174":2325,"_21594":58315,"_5":14861,"_28366":58207,"_3078":58316},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3627":2367,"_31174":2325,"_21594":58318,"_5":14861,"_28366":58207,"_3078":58319},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3627":2368,"_31174":2325,"_21594":58321,"_5":14861,"_28366":58211,"_3078":58322},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3627":2369,"_31174":2325,"_21594":58324,"_5":14861,"_28366":58211,"_3078":58325},[],"The table includes the following fields:",{"_3627":2370,"_31174":2325,"_21594":58327,"_5":14861,"_28366":58211,"_3078":58328},[],"**Name**: descriptive name of the key.",{"_3627":2371,"_31174":2325,"_21594":58330,"_5":14861,"_28366":58211,"_3078":58331},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3627":2372,"_31174":2325,"_21594":58333,"_5":14861,"_28366":58211,"_3078":58334},[],"**Strength**: visual indicator of cryptographic strength.",{"_3627":2373,"_31174":2325,"_21594":58336,"_5":14861,"_28366":58211,"_3078":58337},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3627":2374,"_31174":2325,"_21594":58339,"_5":14861,"_28366":58211,"_3078":58340},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3627":2375,"_31174":2325,"_21594":58342,"_5":14861,"_28366":58211,"_3078":58343},[],"**Aliases**: alternative names associated with the key.",{"_3627":2376,"_31174":2325,"_21594":58345,"_5":14861,"_28366":58211,"_3078":58346},[],"**Tags**: labels for classification and search.",{"_3627":2377,"_31174":2325,"_21594":58348,"_5":14861,"_28366":58211,"_3078":58349},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3627":2378,"_31174":2325,"_21594":58351,"_5":14861,"_28366":58211,"_3078":58352},[],"From this view you also reach the most common actions:",{"_3627":2379,"_31174":2325,"_21594":58354,"_5":14861,"_28366":58211,"_3078":58355},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3627":2380,"_31174":2325,"_21594":58357,"_5":14861,"_28366":58211,"_3078":58358},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3627":2381,"_31174":2325,"_21594":58360,"_5":14861,"_28366":58211,"_3078":58361},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3627":2382,"_31174":2325,"_21594":58363,"_5":14861,"_28366":58211,"_3078":58364},[],"**Delete Key** to remove the key from the system.",{"_3627":2383,"_31174":2325,"_21594":58366,"_5":14861,"_28366":58215,"_3078":58367},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3627":2384,"_31174":2325,"_21594":58369,"_5":14861,"_28366":58219,"_3078":58370},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3627":2385,"_31174":2325,"_21594":58372,"_5":14861,"_28366":58219,"_3078":58373},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3627":2386,"_31174":2325,"_21594":58375,"_5":14861,"_28366":58219,"_3078":58376},[],"**Key Name**: unique and descriptive name.",{"_3627":2387,"_31174":2325,"_21594":58378,"_5":14861,"_28366":58219,"_3078":58379},[],"**Crypto Engine**: engine that will keep the key.",{"_3627":2388,"_31174":2325,"_21594":58381,"_5":14861,"_28366":58219,"_3078":58382},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3627":2389,"_31174":2325,"_21594":58384,"_5":14861,"_28366":58219,"_3078":58385},[],"**Tags**: metadata to classify the key.",{"_3627":2390,"_31174":2325,"_21594":58387,"_5":14861,"_28366":58219,"_3078":58388},[],"**Metadata**: additional information for advanced uses.",{"_3627":2391,"_31174":2325,"_21594":58390,"_5":14861,"_28366":58223,"_3078":58391},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3627":2392,"_31174":2325,"_21594":58393,"_5":14861,"_28366":58223,"_3078":58394},[],"When you have an exportable private key and the destination engine supports import.",{"_3627":2393,"_31174":2325,"_21594":58396,"_5":14861,"_28366":58223,"_3078":58397},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3627":2394,"_31174":2325,"_21594":58399,"_5":14861,"_28366":58223,"_3078":58400},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3627":2395,"_31174":2325,"_21594":58402,"_5":14861,"_28366":58223,"_3078":58403},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3627":2396,"_31174":2325,"_21594":58405,"_5":14861,"_28366":58223,"_3078":58406},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3627":2397,"_31174":2325,"_21594":58408,"_5":14861,"_28366":58223,"_3078":58409},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3627":2398,"_31174":2325,"_21594":58411,"_5":14861,"_28366":58223,"_3078":58412},[],"**Tags**: labels for organization and search.",{"_3627":2399,"_31174":2325,"_21594":58414,"_5":14861,"_28366":58223,"_3078":58415},[],"**Metadata**: additional optional information.",{"_3627":2400,"_31174":2325,"_21594":58417,"_5":14861,"_28366":58223,"_3078":58418},[],"**Private Key (PEM)**: private key in PEM format.",{"_3627":2401,"_31174":2325,"_21594":58420,"_5":14861,"_28366":58223,"_3078":58421},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3627":2402,"_31174":2325,"_21594":58423,"_5":14861,"_28366":58227,"_3078":58424},[],"Each registered key has a detail view and several operational actions.",{"_3627":2403,"_31174":2325,"_21594":58426,"_5":14861,"_28366":58231,"_3078":58427},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3627":2404,"_31174":2325,"_21594":58429,"_5":14861,"_28366":58231,"_3078":58430},[],"The **Overview** tab shows, among others, these fields:",{"_3627":2405,"_31174":2325,"_21594":58432,"_5":14861,"_28366":58231,"_3078":58433},[],"**Key Name**: descriptive name.",{"_3627":2406,"_31174":2325,"_21594":58435,"_5":14861,"_28366":58231,"_3078":58436},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3627":2407,"_31174":2325,"_21594":58438,"_5":14861,"_28366":58231,"_3078":58439},[],"**Tags**: associated labels.",{"_3627":2408,"_31174":2325,"_21594":58441,"_5":14861,"_28366":58231,"_3078":58442},[],"**Aliases**: alternative names.",{"_3627":2409,"_31174":2325,"_21594":58444,"_5":14861,"_28366":58231,"_3078":58445},[],"**Crypto Engine**: engine where the key resides.",{"_3627":2410,"_31174":2325,"_21594":58447,"_5":14861,"_28366":58231,"_3078":58448},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3627":2411,"_31174":2325,"_21594":58450,"_5":14861,"_28366":58231,"_3078":58451},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3627":2412,"_31174":2325,"_21594":58453,"_5":14861,"_28366":58231,"_3078":58454},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3627":2413,"_31174":2325,"_21594":58456,"_5":14861,"_28366":58235,"_3078":58457},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3627":2414,"_31174":2325,"_21594":58459,"_5":14861,"_28366":58235,"_3078":58460},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3627":2415,"_31174":2325,"_21594":58462,"_5":14861,"_28366":58235,"_3078":58463},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3627":2416,"_31174":2325,"_21594":58465,"_5":14861,"_28366":58239,"_3078":58466},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3627":2417,"_31174":2325,"_21594":58468,"_5":14861,"_28366":58239,"_3078":58469},[],"Main fields:",{"_3627":2418,"_31174":2325,"_21594":58471,"_5":14861,"_28366":58239,"_3078":58472},[],"**Algorithm**: signing algorithm available for the key type.",{"_3627":2419,"_31174":2325,"_21594":58474,"_5":14861,"_28366":58239,"_3078":58475},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3627":2420,"_31174":2325,"_21594":58477,"_5":14861,"_28366":58239,"_3078":58478},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3627":2421,"_31174":2325,"_21594":58480,"_5":14861,"_28366":58239,"_3078":58481},[],"**Message**: content to sign.",{"_3627":2422,"_31174":2325,"_21594":58483,"_5":14861,"_28366":58239,"_3078":58484},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3627":2423,"_31174":2325,"_21594":58486,"_5":14861,"_28366":58243,"_3078":58487},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3627":2424,"_31174":2325,"_21594":58489,"_5":14861,"_28366":58243,"_3078":58469},[],{"_3627":2425,"_31174":2325,"_21594":58491,"_5":14861,"_28366":58243,"_3078":58492},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3627":2426,"_31174":2325,"_21594":58494,"_5":14861,"_28366":58243,"_3078":58495},[],"**Message Type**: `Raw` or `Digest`.",{"_3627":2427,"_31174":2325,"_21594":58497,"_5":14861,"_28366":58243,"_3078":58498},[],"**Payload Encoding**: encoding of the message.",{"_3627":2428,"_31174":2325,"_21594":58500,"_5":14861,"_28366":58243,"_3078":58501},[],"**Message**: original message or hash.",{"_3627":2429,"_31174":2325,"_21594":58503,"_5":14861,"_28366":58243,"_3078":58504},[],"**Signature**: signature to check.",{"_3627":2430,"_31174":2325,"_21594":58506,"_5":14861,"_28366":58243,"_3078":58507},[],"**Result**: indicator of the validation result.",{"_3627":2431,"_31174":2325,"_21594":58509,"_5":14861,"_28366":58247,"_3078":58510},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3627":2432,"_31174":2325,"_21594":58512,"_5":14861,"_28366":58247,"_3078":58513},[],"This flow is useful for:",{"_3627":2433,"_31174":2325,"_21594":58515,"_5":14861,"_28366":58247,"_3078":58516},[],"Requesting certificates from an external CA.",{"_3627":2434,"_31174":2325,"_21594":58518,"_5":14861,"_28366":58247,"_3078":58519},[],"Renewing an identity while keeping the same key.",{"_3627":2435,"_31174":2325,"_21594":58521,"_5":14861,"_28366":58247,"_3078":58522},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3627":2436,"_31174":2325,"_21594":58524,"_5":14861,"_28366":58247,"_3078":58525},[],"**Common Name (CN)**: main name of the identity.",{"_3627":2437,"_31174":2325,"_21594":58527,"_5":14861,"_28366":58247,"_3078":58528},[],"**Organization (O)**: organization or company.",{"_3627":2438,"_31174":2325,"_21594":58530,"_5":14861,"_28366":58247,"_3078":58531},[],"**Organizational Unit (OU)**: department or unit.",{"_3627":2439,"_31174":2325,"_21594":58533,"_5":14861,"_28366":58247,"_3078":58534},[],"**Country (C)**: two-letter country code.",{"_3627":2440,"_31174":2325,"_21594":58536,"_5":14861,"_28366":58247,"_3078":58537},[],"**State / Province (ST)**: state or province.",{"_3627":2441,"_31174":2325,"_21594":58539,"_5":14861,"_28366":58247,"_3078":58540},[],"**Locality (L)**: city or locality.",{"_3627":2442,"_31174":2325,"_21594":58542,"_5":14861,"_28366":58247,"_3078":58543},[],"**Email Address**: contact email.",{"_3627":2443,"_31174":2325,"_21594":58545,"_5":14861,"_28366":58247,"_3078":58546},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3627":2444,"_31174":2325,"_21594":58548,"_5":14861,"_28366":58247,"_3078":58549},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3627":2445,"_31174":2325,"_21594":58551,"_5":14861,"_28366":58251,"_3078":58552},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3627":2446,"_31174":2325,"_21594":58554,"_5":14861,"_28366":58251,"_3078":58555},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3627":2447,"_31174":2325,"_21594":58557,"_5":14861,"_28366":58255,"_3078":58558},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3627":2448,"_31174":2325,"_21594":58560,"_5":14861,"_28366":58255,"_3078":58561},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3627":2449,"_31174":2449,"_5":15221,"_3078":58563,"_31533":58564,"_21594":58565,"_28366":2449},"Online validation with OCSP",[50951,52463,56637,57294],[],{"_3627":2450,"_31174":2449,"_21594":58567,"_5":14861,"_28366":2449,"_3078":58568},[],"Query signed status and verify the responder’s response.",{"_3627":2451,"_31174":2449,"_5":31530,"_21594":58570,"_28366":58571,"_3078":58572},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3627":2452,"_31174":2449,"_5":31530,"_21594":58574,"_28366":58575,"_3078":58576},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3627":2453,"_31174":2449,"_5":31530,"_21594":58578,"_28366":58579,"_3078":58580},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3627":2454,"_31174":2449,"_5":31530,"_21594":58582,"_28366":58583,"_3078":58584},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3627":2455,"_31174":2449,"_5":31530,"_21594":58586,"_28366":58587,"_3078":58588},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3627":2456,"_31174":2449,"_5":31530,"_21594":58590,"_28366":58591,"_3078":57859},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#references",{"_3627":2457,"_31174":2449,"_21594":58593,"_5":14861,"_28366":2449,"_3078":58594},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3627":2458,"_31174":2449,"_21594":58596,"_5":14861,"_28366":58571,"_3078":58597},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3627":2459,"_31174":2449,"_21594":58599,"_5":14861,"_28366":58571,"_3078":58600},[],"Record status",{"_3627":2460,"_31174":2449,"_21594":58602,"_5":14861,"_28366":58571,"_3078":58603},[],"Signed response",{"_3627":2461,"_31174":2449,"_21594":58605,"_5":14861,"_28366":58571,"_3078":55774},[],{"_3627":2462,"_31174":2449,"_21594":58607,"_5":14861,"_28366":58571,"_3078":58608},[],"`Good`.",{"_3627":2463,"_31174":2449,"_21594":58610,"_5":14861,"_28366":58571,"_3078":55791},[],{"_3627":2464,"_31174":2449,"_21594":58612,"_5":14861,"_28366":58571,"_3078":58613},[],"`Revoked`, with revocation reason and timestamp.",{"_3627":2465,"_31174":2449,"_21594":58615,"_5":14861,"_28366":58571,"_3078":58616},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3627":2466,"_31174":2449,"_21594":58618,"_5":14861,"_28366":58571,"_3078":58619},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3627":2467,"_31174":2449,"_21594":58621,"_5":14861,"_28366":58571,"_3078":58622},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3627":2468,"_31174":2449,"_21594":58624,"_5":14861,"_28366":58571,"_3078":58625},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3627":2469,"_31174":2449,"_21594":58627,"_5":14861,"_28366":58571,"_3078":58628},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3627":2470,"_31174":2449,"_21594":58630,"_5":14861,"_28366":58575,"_3078":58631},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3627":2471,"_31174":2449,"_21594":58633,"_5":14861,"_28366":58575,"_3078":58634},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3627":2472,"_31174":2449,"_21594":58636,"_5":14861,"_28366":58579,"_3078":58637},[],"The service accepts:",{"_3627":2473,"_31174":2449,"_21594":58639,"_5":14861,"_28366":58579,"_3078":54403},[],{"_3627":2474,"_31174":2449,"_21594":58641,"_5":14861,"_28366":58579,"_3078":58642},[],"VA service path",{"_3627":2475,"_31174":2449,"_21594":58644,"_5":14861,"_28366":58579,"_3078":58645},[],"Format",{"_3627":2476,"_31174":2449,"_21594":58647,"_5":14861,"_28366":58579,"_3078":58648},[],"`POST`",{"_3627":2477,"_31174":2449,"_21594":58650,"_5":14861,"_28366":58579,"_3078":58651},[],"`/ocsp`",{"_3627":2478,"_31174":2449,"_21594":58653,"_5":14861,"_28366":58579,"_3078":58654},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3627":2479,"_31174":2449,"_21594":58656,"_5":14861,"_28366":58579,"_3078":58043},[],{"_3627":2480,"_31174":2449,"_21594":58658,"_5":14861,"_28366":58579,"_3078":58659},[],"`/ocsp/{ocsp_request}`",{"_3627":2481,"_31174":2449,"_21594":58661,"_5":14861,"_28366":58579,"_3078":58662},[],"DER request encoded using padded URL Base64.",{"_3627":2482,"_31174":2449,"_21594":58664,"_5":14861,"_28366":58579,"_3078":58665},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3627":2483,"_31174":2449,"_21594":58667,"_5":14861,"_28366":58583,"_3078":58668},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3627":2484,"_31174":2449,"_21594":58670,"_5":14861,"_28366":58583,"_3078":58671},[],"Generate the request:",{"_3627":2485,"_31174":2449,"_21594":58673,"_5":14861,"_28366":58583,"_3078":58674},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3627":2486,"_31174":2449,"_21594":58676,"_5":14861,"_28366":58583,"_3078":58677},[],"Replace the example URL with the inspected endpoint:",{"_3627":2487,"_31174":2449,"_21594":58679,"_5":14861,"_28366":58583,"_3078":58680},[],"Verify the returned DER:",{"_3627":2488,"_31174":2449,"_21594":58682,"_5":14861,"_28366":58583,"_3078":58683},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3627":2489,"_31174":2449,"_21594":58685,"_5":14861,"_28366":58587,"_3078":58686},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3627":2490,"_31174":2449,"_21594":58688,"_5":14861,"_28366":58587,"_3078":58689},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3627":2491,"_31174":2449,"_21594":58691,"_5":14861,"_28366":58591,"_3078":58692},[],"RFC 6960: OCSP.",{"_3627":2492,"_31174":2449,"_21594":58694,"_5":14861,"_28366":58591,"_3078":58695},[],"OpenSSL: openssl-ocsp.",{"_3627":2493,"_31174":2449,"_21594":58697,"_5":14861,"_28366":58591,"_3078":58698},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3627":2494,"_31174":2449,"_21594":58700,"_5":14861,"_28366":58591,"_3078":58169},[],{"_3627":2495,"_31174":2495,"_5":15221,"_3078":56637,"_31533":58702,"_21594":58703,"_28366":2495},[50951,52463,56637],[],{"_3627":2496,"_31174":2495,"_21594":58705,"_5":14861,"_28366":2495,"_3078":58706},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3627":2497,"_31174":2495,"_5":31530,"_21594":58708,"_28366":58709,"_3078":55949},[],"/docs/pr-preview/pr-75/platform/pki/overview#start-here",{"_3627":2498,"_31174":2495,"_5":31530,"_21594":58711,"_28366":58712,"_3078":58713},[],"/docs/pr-preview/pr-75/platform/pki/overview#what-you-need","What you need",{"_3627":2499,"_31174":2495,"_5":31530,"_21594":58715,"_28366":58716,"_3078":56481},[],"/docs/pr-preview/pr-75/platform/pki/overview#core-capabilities",{"_3627":2500,"_31174":2495,"_5":31530,"_21594":58718,"_28366":58719,"_3078":56485},[],"/docs/pr-preview/pr-75/platform/pki/overview#build-your-trust-hierarchy",{"_3627":2501,"_31174":2495,"_5":31530,"_21594":58721,"_28366":58722,"_3078":56489},[],"/docs/pr-preview/pr-75/platform/pki/overview#protect-cryptographic-keys",{"_3627":2502,"_31174":2495,"_5":31530,"_21594":58724,"_28366":58725,"_3078":56493},[],"/docs/pr-preview/pr-75/platform/pki/overview#issue-and-control-certificates",{"_3627":2503,"_31174":2495,"_5":31530,"_21594":58727,"_28366":58728,"_3078":56501},[],"/docs/pr-preview/pr-75/platform/pki/overview#publish-validation-status",{"_3627":2504,"_31174":2495,"_5":31530,"_21594":58730,"_28366":58731,"_3078":58732},[],"/docs/pr-preview/pr-75/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3627":2505,"_31174":2495,"_5":31530,"_21594":58734,"_28366":58735,"_3078":57461},[],"/docs/pr-preview/pr-75/platform/pki/overview#continue",{"_3627":2506,"_31174":2495,"_21594":58737,"_5":14861,"_28366":2495,"_3078":58738},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3627":2507,"_31174":2495,"_21594":58740,"_5":14861,"_28366":58709,"_3078":58741},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3627":2508,"_31174":2495,"_21594":58743,"_5":14861,"_28366":58709,"_3078":58744},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3627":2509,"_31174":2495,"_21594":58746,"_5":14861,"_28366":58712,"_3078":58747},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3627":2510,"_31174":2495,"_21594":58749,"_5":14861,"_28366":58712,"_3078":58750},[],"An available cryptographic engine to keep the authority's key.",{"_3627":2511,"_31174":2495,"_21594":58752,"_5":14861,"_28366":58712,"_3078":58753},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3627":2512,"_31174":2495,"_21594":58755,"_5":14861,"_28366":58712,"_3078":58756},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3627":2513,"_31174":2495,"_21594":58758,"_5":14861,"_28366":58712,"_3078":58759},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3627":2514,"_31174":2495,"_21594":58761,"_5":14861,"_28366":58719,"_3078":58762},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3627":2515,"_31174":2495,"_21594":58764,"_5":14861,"_28366":58722,"_3078":58765},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3627":2516,"_31174":2495,"_21594":58767,"_5":14861,"_28366":58725,"_3078":58768},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3627":2517,"_31174":2495,"_21594":58770,"_5":14861,"_28366":58728,"_3078":58771},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3627":2518,"_31174":2495,"_21594":58773,"_5":14861,"_28366":58731,"_3078":58774},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3627":2519,"_31174":2495,"_21594":58776,"_5":14861,"_28366":58731,"_3078":58777},[],"its subject and extensions identify the expected client;",{"_3627":2520,"_31174":2495,"_21594":58779,"_5":14861,"_28366":58731,"_3078":58780},[],"its public key matches the client's private key;",{"_3627":2521,"_31174":2495,"_21594":58782,"_5":14861,"_28366":58731,"_3078":58783},[],"its chain reaches a root trusted by the consumer;",{"_3627":2522,"_31174":2495,"_21594":58785,"_5":14861,"_28366":58731,"_3078":58786},[],"its dates and usages allow the operation;",{"_3627":2523,"_31174":2495,"_21594":58788,"_5":14861,"_28366":58731,"_3078":58789},[],"the consumer applies revocation checks and authorization.",{"_3627":2524,"_31174":2495,"_21594":58791,"_5":14861,"_28366":58731,"_3078":58792},[],"The issuance path includes the first independent checks.",{"_3627":2525,"_31174":2495,"_21594":58794,"_5":14861,"_28366":58735,"_3078":58795},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3627":2526,"_31174":2495,"_21594":58797,"_5":14861,"_28366":58735,"_3078":58798},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3627":2527,"_31174":2495,"_21594":58800,"_5":14861,"_28366":58735,"_3078":58801},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3627":2528,"_31174":2528,"_5":15221,"_3078":58803,"_31533":58804,"_21594":58805,"_28366":2528},"Create your first CA",[50951,52463,56637,56074],[],{"_3627":2529,"_31174":2528,"_21594":58807,"_5":14861,"_28366":2528,"_3078":58808},[],"Create an evaluation root and check its certificate before issuing.",{"_3627":2530,"_31174":2528,"_5":31530,"_21594":58810,"_28366":58811,"_3078":50961},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3627":2531,"_31174":2528,"_5":31530,"_21594":58813,"_28366":58814,"_3078":58815},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3627":2532,"_31174":2528,"_5":31530,"_21594":58817,"_28366":58818,"_3078":58819},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3627":2533,"_31174":2528,"_5":31530,"_21594":58821,"_28366":58822,"_3078":58823},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3627":2534,"_31174":2528,"_5":31530,"_21594":58825,"_28366":58826,"_3078":58827},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3627":2535,"_31174":2528,"_5":31530,"_21594":58829,"_28366":58830,"_3078":58831},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3627":2536,"_31174":2528,"_5":31530,"_21594":58833,"_28366":58834,"_3078":58835},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3627":2537,"_31174":2528,"_5":31530,"_21594":58837,"_28366":58838,"_3078":56331},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3627":2538,"_31174":2528,"_5":31530,"_21594":58840,"_28366":58841,"_3078":50985},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3627":2539,"_31174":2528,"_21594":58843,"_5":14861,"_28366":2528,"_3078":58844},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3627":2540,"_31174":2528,"_21594":58846,"_5":14861,"_28366":58811,"_3078":58847},[],"Console access and permission to create keys and authorities.",{"_3627":2541,"_31174":2528,"_21594":58849,"_5":14861,"_28366":58811,"_3078":58850},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3627":2542,"_31174":2528,"_21594":58852,"_5":14861,"_28366":58811,"_3078":58853},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3627":2543,"_31174":2528,"_21594":58855,"_5":14861,"_28366":58811,"_3078":58856},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3627":2544,"_31174":2528,"_21594":58858,"_5":14861,"_28366":58814,"_3078":58859},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3627":2545,"_31174":2528,"_21594":58861,"_5":14861,"_28366":58814,"_3078":58862},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3627":2546,"_31174":2528,"_21594":58864,"_5":14861,"_28366":58818,"_3078":58865},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3627":2547,"_31174":2528,"_21594":58867,"_5":14861,"_28366":58818,"_3078":58868},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3627":2548,"_31174":2528,"_21594":58870,"_5":14861,"_28366":58822,"_3078":58871},[],"Select **Root CA** and complete:",{"_3627":2549,"_31174":2528,"_21594":58873,"_5":14861,"_28366":58822,"_3078":58874},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3627":2550,"_31174":2528,"_21594":58876,"_5":14861,"_28366":58822,"_3078":58877},[],"**Subject**: organization and country details for your evaluation.",{"_3627":2551,"_31174":2528,"_21594":58879,"_5":14861,"_28366":58822,"_3078":58880},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3627":2552,"_31174":2528,"_21594":58882,"_5":14861,"_28366":58822,"_3078":58883},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3627":2553,"_31174":2528,"_21594":58885,"_5":14861,"_28366":58822,"_3078":58886},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3627":2554,"_31174":2528,"_21594":58888,"_5":14861,"_28366":58826,"_3078":58889},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3627":2555,"_31174":2528,"_21594":58891,"_5":14861,"_28366":58830,"_3078":58892},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3627":2556,"_31174":2528,"_21594":58894,"_5":14861,"_28366":58830,"_3078":58895},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3627":2557,"_31174":2528,"_21594":58897,"_5":14861,"_28366":58834,"_3078":58898},[],"Run from the directory where you saved `ca.pem`:",{"_3627":2558,"_31174":2528,"_21594":58900,"_5":14861,"_28366":58834,"_3078":58901},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3627":2559,"_31174":2528,"_21594":58903,"_5":14861,"_28366":58834,"_3078":58904},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3627":2560,"_31174":2528,"_21594":58906,"_5":14861,"_28366":58838,"_3078":58907},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3627":2561,"_31174":2528,"_21594":58909,"_5":14861,"_28366":58838,"_3078":58910},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3627":2562,"_31174":2528,"_21594":58912,"_5":14861,"_28366":58838,"_3078":58913},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3627":2563,"_31174":2528,"_21594":58915,"_5":14861,"_28366":58838,"_3078":58916},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3627":2564,"_31174":2528,"_21594":58918,"_5":14861,"_28366":58841,"_3078":58919},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3627":2565,"_31174":2565,"_5":15221,"_3078":58921,"_31533":58922,"_21594":58923,"_28366":2565},"Issue and verify a certificate",[50951,52463,56637,56074],[],{"_3627":2566,"_31174":2565,"_21594":58925,"_5":14861,"_28366":2565,"_3078":58926},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3627":2567,"_31174":2565,"_5":31530,"_21594":58928,"_28366":58929,"_3078":50961},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3627":2568,"_31174":2565,"_5":31530,"_21594":58931,"_28366":58932,"_3078":58933},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3627":2569,"_31174":2565,"_5":31530,"_21594":58935,"_28366":58936,"_3078":58937},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3627":2570,"_31174":2565,"_5":31530,"_21594":58939,"_28366":58940,"_3078":58941},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3627":2571,"_31174":2565,"_5":31530,"_21594":58943,"_28366":58944,"_3078":58945},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3627":2572,"_31174":2565,"_5":31530,"_21594":58947,"_28366":58948,"_3078":58949},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3627":2573,"_31174":2565,"_5":31530,"_21594":58951,"_28366":58952,"_3078":58953},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3627":2574,"_31174":2565,"_5":31530,"_21594":58955,"_28366":58956,"_3078":58957},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3627":2575,"_31174":2565,"_5":31530,"_21594":58959,"_28366":58960,"_3078":58961},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3627":2576,"_31174":2565,"_5":31530,"_21594":58963,"_28366":58964,"_3078":58965},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3627":2577,"_31174":2565,"_5":31530,"_21594":58967,"_28366":58968,"_3078":56331},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3627":2578,"_31174":2565,"_5":31530,"_21594":58970,"_28366":58971,"_3078":50985},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#next-step",{"_3627":2579,"_31174":2565,"_21594":58973,"_5":14861,"_28366":2565,"_3078":58974},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3627":2580,"_31174":2565,"_21594":58976,"_5":14861,"_28366":58929,"_3078":58977},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3627":2581,"_31174":2565,"_21594":58979,"_5":14861,"_28366":58929,"_3078":58980},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3627":2582,"_31174":2565,"_21594":58982,"_5":14861,"_28366":58929,"_3078":58983},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3627":2583,"_31174":2565,"_21594":58985,"_5":14861,"_28366":58929,"_3078":58986},[],"A client identifier: here we use `device-001`.",{"_3627":2584,"_31174":2565,"_21594":58988,"_5":14861,"_28366":58929,"_3078":58989},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3627":2585,"_31174":2565,"_21594":58991,"_5":14861,"_28366":58932,"_3078":58992},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3627":2586,"_31174":2565,"_21594":58994,"_5":14861,"_28366":58936,"_3078":58995},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3627":2587,"_31174":2565,"_21594":58997,"_5":14861,"_28366":58936,"_3078":58998},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3627":2588,"_31174":2565,"_21594":59000,"_5":14861,"_28366":58940,"_3078":59001},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3627":2589,"_31174":2565,"_21594":59003,"_5":14861,"_28366":58940,"_3078":59004},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3627":2590,"_31174":2565,"_21594":59006,"_5":14861,"_28366":58944,"_3078":59007},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3627":2591,"_31174":2565,"_21594":59009,"_5":14861,"_28366":58944,"_3078":59010},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3627":2592,"_31174":2565,"_21594":59012,"_5":14861,"_28366":58948,"_3078":59013},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3627":2593,"_31174":2565,"_21594":59015,"_5":14861,"_28366":58952,"_3078":59016},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3627":2594,"_31174":2565,"_21594":59018,"_5":14861,"_28366":58956,"_3078":59019},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3627":2595,"_31174":2565,"_21594":59021,"_5":14861,"_28366":58960,"_3078":59022},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3627":2596,"_31174":2565,"_21594":59024,"_5":14861,"_28366":58960,"_3078":59025},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3627":2597,"_31174":2565,"_21594":59027,"_5":14861,"_28366":58960,"_3078":59028},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3627":2598,"_31174":2565,"_21594":59030,"_5":14861,"_28366":58964,"_3078":59031},[],"In Bash, compare the two public-key digests:",{"_3627":2599,"_31174":2565,"_21594":59033,"_5":14861,"_28366":58964,"_3078":59034},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3627":2600,"_31174":2565,"_21594":59036,"_5":14861,"_28366":58964,"_3078":59037},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3627":2601,"_31174":2565,"_21594":59039,"_5":14861,"_28366":58968,"_3078":56415},[],{"_3627":2602,"_31174":2565,"_21594":59041,"_5":14861,"_28366":58968,"_3078":59042},[],"What to review",{"_3627":2603,"_31174":2565,"_21594":59044,"_5":14861,"_28366":58968,"_3078":59045},[],"The CA rejects issuance",{"_3627":2604,"_31174":2565,"_21594":59047,"_5":14861,"_28366":58968,"_3078":59048},[],"Permissions, CA state and key, algorithm and profile.",{"_3627":2605,"_31174":2565,"_21594":59050,"_5":14861,"_28366":58968,"_3078":59051},[],"Different subject or usages",{"_3627":2606,"_31174":2565,"_21594":59053,"_5":14861,"_28366":58968,"_3078":59054},[],"Applied profile and requested values.",{"_3627":2607,"_31174":2565,"_21594":59056,"_5":14861,"_28366":58968,"_3078":59057},[],"Issuer cannot be found",{"_3627":2608,"_31174":2565,"_21594":59059,"_5":14861,"_28366":58968,"_3078":59060},[],"Downloaded CA and required intermediate chain.",{"_3627":2609,"_31174":2565,"_21594":59062,"_5":14861,"_28366":58968,"_3078":59063},[],"Validity fails",{"_3627":2610,"_31174":2565,"_21594":59065,"_5":14861,"_28366":58968,"_3078":59066},[],"Certificate and CA dates, and the computer's clock.",{"_3627":2611,"_31174":2565,"_21594":59068,"_5":14861,"_28366":58968,"_3078":59069},[],"Public-key digests differ",{"_3627":2612,"_31174":2565,"_21594":59071,"_5":14861,"_28366":58968,"_3078":59072},[],"Certificate and key files from the same issuance.",{"_3627":2613,"_31174":2565,"_21594":59074,"_5":14861,"_28366":58968,"_3078":59075},[],"See PKI diagnostics to narrow an issuance failure.",{"_3627":2614,"_31174":2565,"_21594":59077,"_5":14861,"_28366":58971,"_3078":59078},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3627":2615,"_31174":2565,"_21594":59080,"_5":14861,"_28366":58971,"_3078":59081},[],"Manage certificates for inspection, status and revocation.",{"_3627":2616,"_31174":2565,"_21594":59083,"_5":14861,"_28366":58971,"_3078":59084},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3627":2617,"_31174":2565,"_21594":59086,"_5":14861,"_28366":58971,"_3078":59087},[],"Prepare EST for the device to request its next identities.",{"_3627":2618,"_31174":2565,"_21594":59089,"_5":14861,"_28366":58971,"_3078":59090},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3627":2619,"_31174":2619,"_5":15221,"_3078":59092,"_31533":59093,"_21594":59094,"_28366":2619},"PKI getting started",[50951,52463,56637,56074],[],{"_3627":2620,"_31174":2619,"_21594":59096,"_5":14861,"_28366":2619,"_3078":59097},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3627":2621,"_31174":2619,"_5":31530,"_21594":59099,"_28366":59100,"_3078":50961},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#before-you-begin",{"_3627":2622,"_31174":2619,"_5":31530,"_21594":59102,"_28366":59103,"_3078":59104},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3627":2623,"_31174":2619,"_5":31530,"_21594":59106,"_28366":59107,"_3078":56266},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#expected-result",{"_3627":2624,"_31174":2619,"_5":31530,"_21594":59109,"_28366":59110,"_3078":59111},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3627":2625,"_31174":2619,"_21594":59113,"_5":14861,"_28366":2619,"_3078":59114},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3627":2626,"_31174":2619,"_21594":59116,"_5":14861,"_28366":59100,"_3078":59117},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3627":2627,"_31174":2619,"_21594":59119,"_5":14861,"_28366":59100,"_3078":59120},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3627":2628,"_31174":2619,"_21594":59122,"_5":14861,"_28366":59100,"_3078":59123},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3627":2629,"_31174":2619,"_21594":59125,"_5":14861,"_28366":59100,"_3078":59126},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3627":2630,"_31174":2619,"_21594":59128,"_5":14861,"_28366":59100,"_3078":59129},[],"A working directory with restricted access for the downloaded key.",{"_3627":2631,"_31174":2619,"_21594":59131,"_5":14861,"_28366":59103,"_3078":59132},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3627":2632,"_31174":2619,"_21594":59134,"_5":14861,"_28366":59103,"_3078":59135},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3627":2633,"_31174":2619,"_21594":59137,"_5":14861,"_28366":59103,"_3078":59138},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3627":2634,"_31174":2619,"_21594":59140,"_5":14861,"_28366":59103,"_3078":59141},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3627":2635,"_31174":2619,"_21594":59143,"_5":14861,"_28366":59107,"_3078":59144},[],"File or resource",{"_3627":2636,"_31174":2619,"_21594":59146,"_5":14861,"_28366":59107,"_3078":56263},[],{"_3627":2637,"_31174":2619,"_21594":59148,"_5":14861,"_28366":59107,"_3078":59149},[],"Active root CA and `ca.pem`",{"_3627":2638,"_31174":2619,"_21594":59151,"_5":14861,"_28366":59107,"_3078":59152},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3627":2639,"_31174":2619,"_21594":59154,"_5":14861,"_28366":59107,"_3078":59155},[],"End-entity certificate and `device.crt`",{"_3627":2640,"_31174":2619,"_21594":59157,"_5":14861,"_28366":59107,"_3078":59158},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3627":2641,"_31174":2619,"_21594":59160,"_5":14861,"_28366":59107,"_3078":59161},[],"Private key `device.key`",{"_3627":2642,"_31174":2619,"_21594":59163,"_5":14861,"_28366":59107,"_3078":59164},[],"Its public key matches the one included in `device.crt`.",{"_3627":2643,"_31174":2619,"_21594":59166,"_5":14861,"_28366":59107,"_3078":59167},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3627":2644,"_31174":2619,"_21594":59169,"_5":14861,"_28366":59110,"_3078":59170},[],"To operate certificates, continue with Certificates and Validation.",{"_3627":2645,"_31174":2619,"_21594":59172,"_5":14861,"_28366":59110,"_3078":59173},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3627":2646,"_31174":2619,"_21594":59175,"_5":14861,"_28366":59110,"_3078":59176},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3627":2647,"_31174":2647,"_5":15221,"_3078":59178,"_31533":59179,"_21594":59180,"_28366":2647},"PKI troubleshooting",[50951,52463,56637,55212],[],{"_3627":2648,"_31174":2647,"_21594":59182,"_5":14861,"_28366":2647,"_3078":59183},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3627":2649,"_31174":2647,"_5":31530,"_21594":59185,"_28366":59186,"_3078":59187},[],"/docs/pr-preview/pr-75/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3627":2650,"_31174":2647,"_5":31530,"_21594":59189,"_28366":59190,"_3078":59191},[],"/docs/pr-preview/pr-75/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3627":2651,"_31174":2647,"_5":31530,"_21594":59193,"_28366":59194,"_3078":59195},[],"/docs/pr-preview/pr-75/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3627":2652,"_31174":2647,"_21594":59197,"_5":14861,"_28366":2647,"_3078":59198},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3627":2653,"_31174":2647,"_21594":59200,"_5":14861,"_28366":2647,"_3078":59201},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3627":2654,"_31174":2647,"_21594":59203,"_5":14861,"_28366":59186,"_3078":56263},[],{"_3627":2655,"_31174":2647,"_21594":59205,"_5":14861,"_28366":59186,"_3078":59206},[],"What to inspect",{"_3627":2656,"_31174":2647,"_21594":59208,"_5":14861,"_28366":59186,"_3078":50985},[],{"_3627":2657,"_31174":2647,"_21594":59210,"_5":14861,"_28366":59186,"_3078":55479},[],{"_3627":2658,"_31174":2647,"_21594":59212,"_5":14861,"_28366":59186,"_3078":59213},[],"Exists, is active and has usable dates.",{"_3627":2659,"_31174":2647,"_21594":59215,"_5":14861,"_28366":59186,"_3078":59216},[],"Authorities.",{"_3627":2660,"_31174":2647,"_21594":59218,"_5":14861,"_28366":59186,"_3078":59219},[],"Key",{"_3627":2661,"_31174":2647,"_21594":59221,"_5":14861,"_28366":59186,"_3078":59222},[],"The record has a usable private key and the engine can sign.",{"_3627":2662,"_31174":2647,"_21594":59224,"_5":14861,"_28366":59186,"_3078":59225},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3627":2663,"_31174":2647,"_21594":59227,"_5":14861,"_28366":59186,"_3078":59228},[],"CSR",{"_3627":2664,"_31174":2647,"_21594":59230,"_5":14861,"_28366":59186,"_3078":59231},[],"Correct PEM and verifiable signature.",{"_3627":2665,"_31174":2647,"_21594":59233,"_5":14861,"_28366":59186,"_3078":59234},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3627":2666,"_31174":2647,"_21594":59236,"_5":14861,"_28366":59186,"_3078":59237},[],"Profile",{"_3627":2667,"_31174":2647,"_21594":59239,"_5":14861,"_28366":59186,"_3078":59240},[],"Selected source, existing ID, allowed algorithm and size.",{"_3627":2668,"_31174":2647,"_21594":59242,"_5":14861,"_28366":59186,"_3078":59243},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3627":2669,"_31174":2647,"_21594":59245,"_5":14861,"_28366":59186,"_3078":56415},[],{"_3627":2670,"_31174":2647,"_21594":59247,"_5":14861,"_28366":59186,"_3078":59248},[],"Appropriate subject, SAN, usages and dates.",{"_3627":2671,"_31174":2647,"_21594":59250,"_5":14861,"_28366":59186,"_3078":59251},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3627":2672,"_31174":2647,"_21594":59253,"_5":14861,"_28366":59186,"_3078":59254},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3627":2673,"_31174":2647,"_21594":59256,"_5":14861,"_28366":59186,"_3078":59257},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3627":2674,"_31174":2647,"_21594":59259,"_5":14861,"_28366":59186,"_3078":59260},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3627":2675,"_31174":2647,"_21594":59262,"_5":14861,"_28366":59190,"_3078":59263},[],"Check each boundary independently:",{"_3627":2676,"_31174":2647,"_21594":59265,"_5":14861,"_28366":59190,"_3078":59266},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3627":2677,"_31174":2647,"_21594":59268,"_5":14861,"_28366":59190,"_3078":59269},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3627":2678,"_31174":2647,"_21594":59271,"_5":14861,"_28366":59190,"_3078":59272},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3627":2679,"_31174":2647,"_21594":59274,"_5":14861,"_28366":59190,"_3078":59275},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3627":2680,"_31174":2647,"_21594":59277,"_5":14861,"_28366":59190,"_3078":59278},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3627":2681,"_31174":2647,"_21594":59280,"_5":14861,"_28366":59190,"_3078":59281},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3627":2682,"_31174":2647,"_21594":59283,"_5":14861,"_28366":59194,"_3078":59284},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3627":2683,"_31174":2647,"_21594":59286,"_5":14861,"_28366":59194,"_3078":59287},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3627":2684,"_31174":2684,"_5":15221,"_3078":59289,"_31533":59290,"_21594":59291,"_28366":2684},"Security",[50951],[],{"_3627":2685,"_31174":2684,"_21594":59293,"_5":14861,"_28366":2684,"_3078":59294},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3627":2686,"_31174":2684,"_5":31530,"_21594":59296,"_28366":59297,"_3078":59298},[],"/docs/pr-preview/pr-75/security#report-a-vulnerability","Report a vulnerability",{"_3627":2687,"_31174":2684,"_5":31530,"_21594":59300,"_28366":59301,"_3078":59302},[],"/docs/pr-preview/pr-75/security#what-to-include-in-a-report","What to include in a report",{"_3627":2688,"_31174":2684,"_5":31530,"_21594":59304,"_28366":59305,"_3078":59306},[],"/docs/pr-preview/pr-75/security#supported-versions","Supported versions",{"_3627":2689,"_31174":2684,"_5":31530,"_21594":59308,"_28366":59309,"_3078":59310},[],"/docs/pr-preview/pr-75/security#responsible-disclosure","Responsible disclosure",{"_3627":2690,"_31174":2684,"_21594":59312,"_5":14861,"_28366":2684,"_3078":59313},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3627":2691,"_31174":2684,"_21594":59315,"_5":14861,"_28366":59297,"_3078":59316},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3627":2692,"_31174":2684,"_21594":59318,"_5":14861,"_28366":59297,"_3078":59319},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3627":2693,"_31174":2684,"_21594":59321,"_5":14861,"_28366":59297,"_3078":15500},[],{"_3627":2694,"_31174":2684,"_21594":59323,"_5":14861,"_28366":59297,"_3078":15429},[],{"_3627":2695,"_31174":2684,"_21594":59325,"_5":14861,"_28366":59297,"_3078":15487},[],{"_3627":2696,"_31174":2684,"_21594":59327,"_5":14861,"_28366":59297,"_3078":59328},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3627":2697,"_31174":2684,"_21594":59330,"_5":14861,"_28366":59297,"_3078":59331},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3627":2698,"_31174":2684,"_21594":59333,"_5":14861,"_28366":59301,"_3078":59334},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3627":2699,"_31174":2684,"_21594":59336,"_5":14861,"_28366":59301,"_3078":59337},[],"Do not include in the report:",{"_3627":2700,"_31174":2684,"_21594":59339,"_5":14861,"_28366":59301,"_3078":59340},[],"Credentials, tokens, or private keys",{"_3627":2701,"_31174":2684,"_21594":59342,"_5":14861,"_28366":59301,"_3078":59343},[],"Customer data or customer-identifiable information",{"_3627":2702,"_31174":2684,"_21594":59345,"_5":14861,"_28366":59301,"_3078":59346},[],"Confidential architecture or internal infrastructure details",{"_3627":2703,"_31174":2684,"_21594":59348,"_5":14861,"_28366":59305,"_3078":59349},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3627":2704,"_31174":2684,"_21594":59351,"_5":14861,"_28366":59305,"_3078":59352},[],"For upgrade guidance, see Upgrades.",{"_3627":2705,"_31174":2684,"_21594":59354,"_5":14861,"_28366":59309,"_3078":59355},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3627":2706,"_31174":2684,"_21594":59357,"_5":14861,"_28366":59309,"_3078":59358},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3627":2707,"_31174":2684,"_21594":59360,"_5":14861,"_28366":59309,"_3078":59361},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3627":2708,"_31174":2684,"_21594":59363,"_5":14861,"_28366":59309,"_3078":59364},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3627":2709,"_31174":2684,"_21594":59366,"_5":14861,"_28366":59309,"_3078":59367},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3627":2710,"_31174":2710,"_5":15221,"_3078":59369,"_31533":59370,"_21594":59372,"_28366":2710},"3.8.0 to 4.0.0",[50951,59371],"Upgrades",[],{"_3627":2711,"_31174":2710,"_21594":59374,"_5":14861,"_28366":2710,"_3078":59375},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3627":2712,"_31174":2710,"_5":31530,"_21594":59377,"_28366":59378,"_3078":59379},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3627":2713,"_31174":2710,"_5":31530,"_21594":59381,"_28366":59382,"_3078":59383},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3627":2714,"_31174":2710,"_5":31530,"_21594":59385,"_28366":59386,"_3078":59387},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3627":2715,"_31174":2710,"_5":31530,"_21594":59389,"_28366":59390,"_3078":59391},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3627":2716,"_31174":2710,"_5":31530,"_21594":59393,"_28366":59394,"_3078":59395},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3627":2717,"_31174":2710,"_5":31530,"_21594":59397,"_28366":59398,"_3078":59399},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3627":2718,"_31174":2710,"_5":31530,"_21594":59401,"_28366":59402,"_3078":59403},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3627":2719,"_31174":2710,"_5":31530,"_21594":59405,"_28366":59406,"_3078":59407},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3627":2720,"_31174":2710,"_5":31530,"_21594":59409,"_28366":59410,"_3078":59411},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3627":2721,"_31174":2710,"_5":31530,"_21594":59413,"_28366":59414,"_3078":59415},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3627":2722,"_31174":2710,"_5":31530,"_21594":59417,"_28366":59418,"_3078":51589},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3627":2723,"_31174":2710,"_5":31530,"_21594":59420,"_28366":59421,"_3078":59422},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3627":2724,"_31174":2710,"_5":31530,"_21594":59424,"_28366":59425,"_3078":59426},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3627":2725,"_31174":2710,"_5":31530,"_21594":59428,"_28366":59429,"_3078":59430},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3627":2726,"_31174":2710,"_5":31530,"_21594":59432,"_28366":59433,"_3078":59434},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3627":2727,"_31174":2710,"_5":31530,"_21594":59436,"_28366":59437,"_3078":59438},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3627":2728,"_31174":2710,"_5":31530,"_21594":59440,"_28366":59441,"_3078":59442},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3627":2729,"_31174":2710,"_5":31530,"_21594":59444,"_28366":59445,"_3078":59446},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3627":2730,"_31174":2710,"_5":31530,"_21594":59448,"_28366":59449,"_3078":59450},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3627":2731,"_31174":2710,"_5":31530,"_21594":59452,"_28366":59453,"_3078":59454},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3627":2732,"_31174":2710,"_5":31530,"_21594":59456,"_28366":59457,"_3078":59458},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3627":2733,"_31174":2710,"_5":31530,"_21594":59460,"_28366":59461,"_3078":59462},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3627":2734,"_31174":2710,"_5":31530,"_21594":59464,"_28366":59465,"_3078":59466},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3627":2735,"_31174":2710,"_5":31530,"_21594":59468,"_28366":59469,"_3078":59470},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3627":2736,"_31174":2710,"_5":31530,"_21594":59472,"_28366":59473,"_3078":59474},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3627":2737,"_31174":2710,"_5":31530,"_21594":59476,"_28366":59477,"_3078":59478},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3627":2738,"_31174":2710,"_5":31530,"_21594":59480,"_28366":59481,"_3078":59482},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3627":2739,"_31174":2710,"_5":31530,"_21594":59484,"_28366":59485,"_3078":59486},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3627":2740,"_31174":2710,"_5":31530,"_21594":59488,"_28366":59489,"_3078":59490},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3627":2741,"_31174":2710,"_5":31530,"_21594":59492,"_28366":59493,"_3078":59494},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3627":2742,"_31174":2710,"_5":31530,"_21594":59496,"_28366":59497,"_3078":59498},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3627":2743,"_31174":2710,"_5":31530,"_21594":59500,"_28366":59501,"_3078":59502},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3627":2744,"_31174":2710,"_5":31530,"_21594":59504,"_28366":59505,"_3078":59506},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3627":2745,"_31174":2710,"_5":31530,"_21594":59508,"_28366":59509,"_3078":59510},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3627":2746,"_31174":2710,"_5":31530,"_21594":59512,"_28366":59513,"_3078":59506},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3627":2747,"_31174":2710,"_5":31530,"_21594":59515,"_28366":59516,"_3078":59517},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3627":2748,"_31174":2710,"_5":31530,"_21594":59519,"_28366":59520,"_3078":59521},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3627":2749,"_31174":2710,"_5":31530,"_21594":59523,"_28366":59524,"_3078":59525},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3627":2750,"_31174":2710,"_5":31530,"_21594":59527,"_28366":59528,"_3078":59529},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3627":2751,"_31174":2710,"_5":31530,"_21594":59531,"_28366":59532,"_3078":59533},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3627":2752,"_31174":2710,"_5":31530,"_21594":59535,"_28366":59536,"_3078":59537},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3627":2753,"_31174":2710,"_5":31530,"_21594":59539,"_28366":59540,"_3078":59541},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3627":2754,"_31174":2710,"_5":31530,"_21594":59543,"_28366":59544,"_3078":59545},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3627":2755,"_31174":2710,"_5":31530,"_21594":59547,"_28366":59548,"_3078":59549},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3627":2756,"_31174":2710,"_5":31530,"_21594":59551,"_28366":59552,"_3078":55212},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3627":2757,"_31174":2710,"_5":31530,"_21594":59554,"_28366":59555,"_3078":59556},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3627":2758,"_31174":2710,"_5":31530,"_21594":59558,"_28366":59559,"_3078":59560},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3627":2759,"_31174":2710,"_21594":59562,"_5":14861,"_28366":2710,"_3078":59563},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3627":2760,"_31174":2710,"_21594":59565,"_5":14861,"_28366":2710,"_3078":59566},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3627":2761,"_31174":2710,"_21594":59568,"_5":14861,"_28366":2710,"_3078":59569},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3627":2762,"_31174":2710,"_21594":59571,"_5":14861,"_28366":2710,"_3078":59572},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3627":2763,"_31174":2710,"_21594":59574,"_5":14861,"_28366":2710,"_3078":59575},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3627":2764,"_31174":2710,"_21594":59577,"_5":14861,"_28366":2710,"_3078":59578},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3627":2765,"_31174":2710,"_21594":59580,"_5":14861,"_28366":2710,"_3078":59581},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3627":2766,"_31174":2710,"_21594":59583,"_5":14861,"_28366":59382,"_3078":59584},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3627":2767,"_31174":2710,"_21594":59586,"_5":14861,"_28366":59382,"_3078":59587},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3627":2768,"_31174":2710,"_21594":59589,"_5":14861,"_28366":59386,"_3078":59590},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3627":2769,"_31174":2710,"_21594":59592,"_5":14861,"_28366":59386,"_3078":59593},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3627":2770,"_31174":2710,"_21594":59595,"_5":14861,"_28366":59390,"_3078":59596},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3627":2771,"_31174":2710,"_21594":59598,"_5":14861,"_28366":59394,"_3078":59599},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3627":2772,"_31174":2710,"_21594":59601,"_5":14861,"_28366":59394,"_3078":59602},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3627":2773,"_31174":2710,"_21594":59604,"_5":14861,"_28366":59394,"_3078":59605},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3627":2774,"_31174":2710,"_21594":59607,"_5":14861,"_28366":59394,"_3078":59608},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3627":2775,"_31174":2710,"_21594":59610,"_5":14861,"_28366":59394,"_3078":59611},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3627":2776,"_31174":2710,"_21594":59613,"_5":14861,"_28366":59398,"_3078":59614},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3627":2777,"_31174":2710,"_21594":59616,"_5":14861,"_28366":59398,"_3078":59617},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3627":2778,"_31174":2710,"_21594":59619,"_5":14861,"_28366":59398,"_3078":59620},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3627":2779,"_31174":2710,"_21594":59622,"_5":14861,"_28366":59398,"_3078":59623},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3627":2780,"_31174":2710,"_21594":59625,"_5":14861,"_28366":59398,"_3078":59626},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3627":2781,"_31174":2710,"_21594":59628,"_5":14861,"_28366":59398,"_3078":59629},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3627":2782,"_31174":2710,"_21594":59631,"_5":14861,"_28366":59402,"_3078":59632},[],"Change",{"_3627":2783,"_31174":2710,"_21594":59634,"_5":14861,"_28366":59402,"_3078":59635},[],"Who is affected",{"_3627":2784,"_31174":2710,"_21594":59637,"_5":14861,"_28366":59402,"_3078":59638},[],"Severity",{"_3627":2785,"_31174":2710,"_21594":59640,"_5":14861,"_28366":59402,"_3078":58091},[],{"_3627":2786,"_31174":2710,"_21594":59642,"_5":14861,"_28366":59402,"_3078":59411},[],{"_3627":2787,"_31174":2710,"_21594":59644,"_5":14861,"_28366":59402,"_3078":59645},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3627":2788,"_31174":2710,"_21594":59647,"_5":14861,"_28366":59402,"_3078":59648},[],"High: KMS and VA start on empty volumes",{"_3627":2789,"_31174":2710,"_21594":59650,"_5":14861,"_28366":59402,"_3078":59651},[],"Copy the data into the new volumes",{"_3627":2790,"_31174":2710,"_21594":59653,"_5":14861,"_28366":59402,"_3078":59415},[],{"_3627":2791,"_31174":2710,"_21594":59655,"_5":14861,"_28366":59402,"_3078":59656},[],"Every Helm release",{"_3627":2792,"_31174":2710,"_21594":59658,"_5":14861,"_28366":59402,"_3078":59659},[],"High: `helm upgrade` fails",{"_3627":2793,"_31174":2710,"_21594":59661,"_5":14861,"_28366":59402,"_3078":59662},[],"Remove or rename legacy keys",{"_3627":2794,"_31174":2710,"_21594":59664,"_5":14861,"_28366":59402,"_3078":51589},[],{"_3627":2795,"_31174":2710,"_21594":59666,"_5":14861,"_28366":59402,"_3078":59656},[],{"_3627":2796,"_31174":2710,"_21594":59668,"_5":14861,"_28366":59402,"_3078":59669},[],"High: `helm upgrade` fails on inline credentials",{"_3627":2797,"_31174":2710,"_21594":59671,"_5":14861,"_28366":59402,"_3078":59672},[],"Create the Secrets first; see Step 2",{"_3627":2798,"_31174":2710,"_21594":59674,"_5":14861,"_28366":59402,"_3078":59422},[],{"_3627":2799,"_31174":2710,"_21594":59676,"_5":14861,"_28366":59402,"_3078":59677},[],"Every deployment",{"_3627":2800,"_31174":2710,"_21594":59679,"_5":14861,"_28366":59402,"_3078":59680},[],"High: without a bootstrap principal there is no administrator",{"_3627":2801,"_31174":2710,"_21594":59682,"_5":14861,"_28366":59402,"_3078":59683},[],"Configure `services.authz`",{"_3627":2802,"_31174":2710,"_21594":59685,"_5":14861,"_28366":59402,"_3078":59426},[],{"_3627":2803,"_31174":2710,"_21594":59687,"_5":14861,"_28366":59402,"_3078":59656},[],{"_3627":2804,"_31174":2710,"_21594":59689,"_5":14861,"_28366":59402,"_3078":59690},[],"High: `helm upgrade` fails on the old keys",{"_3627":2805,"_31174":2710,"_21594":59692,"_5":14861,"_28366":59402,"_3078":59693},[],"Move JWKS and roles into `services.authz`",{"_3627":2806,"_31174":2710,"_21594":59695,"_5":14861,"_28366":59402,"_3078":59446},[],{"_3627":2807,"_31174":2710,"_21594":59697,"_5":14861,"_28366":59402,"_3078":59698},[],"3.8.0 deployments with per-service databases",{"_3627":2808,"_31174":2710,"_21594":59700,"_5":14861,"_28366":59402,"_3078":59701},[],"High: services find no data, or a migration aborts",{"_3627":2809,"_31174":2710,"_21594":59703,"_5":14861,"_28366":59402,"_3078":59704},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3627":2810,"_31174":2710,"_21594":59706,"_5":14861,"_28366":59402,"_3078":59450},[],{"_3627":2811,"_31174":2710,"_21594":59708,"_5":14861,"_28366":59402,"_3078":59709},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3627":2812,"_31174":2710,"_21594":59711,"_5":14861,"_28366":59402,"_3078":59712},[],"High: the backend no longer starts with them",{"_3627":2813,"_31174":2710,"_21594":59714,"_5":14861,"_28366":59402,"_3078":59715},[],"Move to PostgreSQL before upgrading",{"_3627":2814,"_31174":2710,"_21594":59717,"_5":14861,"_28366":59402,"_3078":59498},[],{"_3627":2815,"_31174":2710,"_21594":59719,"_5":14861,"_28366":59402,"_3078":59720},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3627":2816,"_31174":2710,"_21594":59722,"_5":14861,"_28366":59402,"_3078":59723},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3627":2817,"_31174":2710,"_21594":59725,"_5":14861,"_28366":59402,"_3078":59726},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3627":2818,"_31174":2710,"_21594":59728,"_5":14861,"_28366":59402,"_3078":59729},[],"Webhooks with file references",{"_3627":2819,"_31174":2710,"_21594":59731,"_5":14861,"_28366":59402,"_3078":59732},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3627":2820,"_31174":2710,"_21594":59734,"_5":14861,"_28366":59402,"_3078":59735},[],"High: enrollments calling the webhook fail",{"_3627":2821,"_31174":2710,"_21594":59737,"_5":14861,"_28366":59402,"_3078":59738},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3627":2822,"_31174":2710,"_21594":59740,"_5":14861,"_28366":59402,"_3078":59430},[],{"_3627":2823,"_31174":2710,"_21594":59742,"_5":14861,"_28366":59402,"_3078":59743},[],"Releases with per-service identity overrides or mounted key material",{"_3627":2824,"_31174":2710,"_21594":59745,"_5":14861,"_28366":59402,"_3078":59746},[],"Medium: services cannot read their files",{"_3627":2825,"_31174":2710,"_21594":59748,"_5":14861,"_28366":59402,"_3078":59749},[],"Remove the overrides and fix volume ownership",{"_3627":2826,"_31174":2710,"_21594":59751,"_5":14861,"_28366":59402,"_3078":59434},[],{"_3627":2827,"_31174":2710,"_21594":59753,"_5":14861,"_28366":59402,"_3078":59754},[],"Releases that set `amqp.tls`",{"_3627":2828,"_31174":2710,"_21594":59756,"_5":14861,"_28366":59402,"_3078":59757},[],"Medium: clients connect to the wrong port",{"_3627":2829,"_31174":2710,"_21594":59759,"_5":14861,"_28366":59402,"_3078":59760},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3627":2830,"_31174":2710,"_21594":59762,"_5":14861,"_28366":59402,"_3078":59454},[],{"_3627":2831,"_31174":2710,"_21594":59764,"_5":14861,"_28366":59402,"_3078":59765},[],"Installations whose CA keys predate the KMS",{"_3627":2832,"_31174":2710,"_21594":59767,"_5":14861,"_28366":59402,"_3078":59768},[],"Medium: CA keys stay unmanaged",{"_3627":2833,"_31174":2710,"_21594":59770,"_5":14861,"_28366":59402,"_3078":59771},[],"Run the CA-to-KMS migration",{"_3627":2834,"_31174":2710,"_21594":59773,"_5":14861,"_28366":59402,"_3078":59774},[],"Receiver certificate verification",{"_3627":2835,"_31174":2710,"_21594":59776,"_5":14861,"_28366":59402,"_3078":59777},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3627":2836,"_31174":2710,"_21594":59779,"_5":14861,"_28366":59402,"_3078":59780},[],"Medium: credentials go to an unverified receiver",{"_3627":2837,"_31174":2710,"_21594":59782,"_5":14861,"_28366":59402,"_3078":59783},[],"Set `insecure_skip_verify` to `false`",{"_3627":2838,"_31174":2710,"_21594":59785,"_5":14861,"_28366":59402,"_3078":59470},[],{"_3627":2839,"_31174":2710,"_21594":59787,"_5":14861,"_28366":59402,"_3078":59788},[],"Scripts and consoles that edit DMSs through the API",{"_3627":2840,"_31174":2710,"_21594":59790,"_5":14861,"_28366":59402,"_3078":59791},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3627":2841,"_31174":2710,"_21594":59793,"_5":14861,"_28366":59402,"_3078":59794},[],"Read the DMS before editing and use the new field",{"_3627":2842,"_31174":2710,"_21594":59796,"_5":14861,"_28366":59402,"_3078":59474},[],{"_3627":2843,"_31174":2710,"_21594":59798,"_5":14861,"_28366":59402,"_3078":59799},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3627":2844,"_31174":2710,"_21594":59801,"_5":14861,"_28366":59402,"_3078":59802},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3627":2845,"_31174":2710,"_21594":59804,"_5":14861,"_28366":59402,"_3078":59805},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3627":2846,"_31174":2710,"_21594":59807,"_5":14861,"_28366":59402,"_3078":59494},[],{"_3627":2847,"_31174":2710,"_21594":59809,"_5":14861,"_28366":59402,"_3078":59810},[],"Clients that create or update CRL settings through the API",{"_3627":2848,"_31174":2710,"_21594":59812,"_5":14861,"_28366":59402,"_3078":59813},[],"Medium: requests with the old field return an error",{"_3627":2849,"_31174":2710,"_21594":59815,"_5":14861,"_28366":59402,"_3078":59816},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3627":2850,"_31174":2710,"_21594":59818,"_5":14861,"_28366":59402,"_3078":59502},[],{"_3627":2851,"_31174":2710,"_21594":59820,"_5":14861,"_28366":59402,"_3078":59821},[],"Alert subscriptions and consumers of the VA events",{"_3627":2852,"_31174":2710,"_21594":59823,"_5":14861,"_28366":59402,"_3078":59824},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3627":2853,"_31174":2710,"_21594":59826,"_5":14861,"_28366":59402,"_3078":59827},[],"Review conditions filtering on the old event payload or subject",{"_3627":2854,"_31174":2710,"_21594":59829,"_5":14861,"_28366":59402,"_3078":59506},[],{"_3627":2855,"_31174":2710,"_21594":59831,"_5":14861,"_28366":59402,"_3078":59832},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3627":2856,"_31174":2710,"_21594":59834,"_5":14861,"_28366":59402,"_3078":59835},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3627":2857,"_31174":2710,"_21594":59837,"_5":14861,"_28366":59402,"_3078":59838},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3627":2858,"_31174":2710,"_21594":59840,"_5":14861,"_28366":59402,"_3078":59490},[],{"_3627":2859,"_31174":2710,"_21594":59842,"_5":14861,"_28366":59402,"_3078":59843},[],"Consumers that read the device `events` field",{"_3627":2860,"_31174":2710,"_21594":59845,"_5":14861,"_28366":59402,"_3078":59846},[],"Medium: the field disappears",{"_3627":2861,"_31174":2710,"_21594":59848,"_5":14861,"_28366":59402,"_3078":59849},[],"Use the new event endpoints",{"_3627":2862,"_31174":2710,"_21594":59851,"_5":14861,"_28366":59402,"_3078":59517},[],{"_3627":2863,"_31174":2710,"_21594":59853,"_5":14861,"_28366":59402,"_3078":59854},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3627":2864,"_31174":2710,"_21594":59856,"_5":14861,"_28366":59402,"_3078":59857},[],"Medium: the VA migration aborts",{"_3627":2865,"_31174":2710,"_21594":59859,"_5":14861,"_28366":59402,"_3078":59860},[],"Fix the affected roles before upgrading",{"_3627":2866,"_31174":2710,"_21594":59862,"_5":14861,"_28366":59402,"_3078":59438},[],{"_3627":2867,"_31174":2710,"_21594":59864,"_5":14861,"_28366":59402,"_3078":59865},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3627":2868,"_31174":2710,"_21594":59867,"_5":14861,"_28366":59402,"_3078":59868},[],"Low to medium: validation errors or changed defaults",{"_3627":2869,"_31174":2710,"_21594":59870,"_5":14861,"_28366":59402,"_3078":59871},[],"Update the values file",{"_3627":2870,"_31174":2710,"_21594":59873,"_5":14861,"_28366":59402,"_3078":59482},[],{"_3627":2871,"_31174":2710,"_21594":59875,"_5":14861,"_28366":59402,"_3078":59876},[],"Clients that send the DMS ID in the update body",{"_3627":2872,"_31174":2710,"_21594":59878,"_5":14861,"_28366":59402,"_3078":59879},[],"Low: the ID in the URL wins",{"_3627":2873,"_31174":2710,"_21594":59881,"_5":14861,"_28366":59402,"_3078":59882},[],"Send the ID in the URL",{"_3627":2874,"_31174":2710,"_21594":59884,"_5":14861,"_28366":59402,"_3078":59510},[],{"_3627":2875,"_31174":2710,"_21594":59886,"_5":14861,"_28366":59402,"_3078":59887},[],"Clients that send an `id` when creating or importing CAs",{"_3627":2876,"_31174":2710,"_21594":59889,"_5":14861,"_28366":59402,"_3078":59890},[],"Low: the ID in the body is ignored, and the field is removed",{"_3627":2877,"_31174":2710,"_21594":59892,"_5":14861,"_28366":59402,"_3078":59893},[],"Let the backend assign the ID and use the returned one",{"_3627":2878,"_31174":2710,"_21594":59895,"_5":14861,"_28366":59402,"_3078":59506},[],{"_3627":2879,"_31174":2710,"_21594":59897,"_5":14861,"_28366":59402,"_3078":59898},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3627":2880,"_31174":2710,"_21594":59900,"_5":14861,"_28366":59402,"_3078":59901},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3627":2881,"_31174":2710,"_21594":59903,"_5":14861,"_28366":59402,"_3078":59904},[],"Use the KMS `sign` and `verify` operations",{"_3627":2882,"_31174":2710,"_21594":59906,"_5":14861,"_28366":59402,"_3078":59486},[],{"_3627":2883,"_31174":2710,"_21594":59908,"_5":14861,"_28366":59402,"_3078":59909},[],"Consumers that match on certificate `type`",{"_3627":2884,"_31174":2710,"_21594":59911,"_5":14861,"_28366":59402,"_3078":59912},[],"Low: two values are renamed",{"_3627":2885,"_31174":2710,"_21594":59914,"_5":14861,"_28366":59402,"_3078":59915},[],"Adapt consumers",{"_3627":2886,"_31174":2710,"_21594":59917,"_5":14861,"_28366":59402,"_3078":59478},[],{"_3627":2887,"_31174":2710,"_21594":59919,"_5":14861,"_28366":59402,"_3078":59920},[],"Any DMS",{"_3627":2888,"_31174":2710,"_21594":59922,"_5":14861,"_28366":59402,"_3078":59923},[],"Low: informational",{"_3627":2889,"_31174":2710,"_21594":59925,"_5":14861,"_28366":59402,"_3078":59926},[],"Read both blocks before editing",{"_3627":2890,"_31174":2710,"_21594":59928,"_5":14861,"_28366":59410,"_3078":59929},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3627":2891,"_31174":2710,"_21594":59931,"_5":14861,"_28366":59410,"_3078":59932},[],"Step 4 of the migration guide copies the data.",{"_3627":2892,"_31174":2710,"_21594":59934,"_5":14861,"_28366":59414,"_3078":59935},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3627":2893,"_31174":2710,"_21594":59937,"_5":14861,"_28366":59418,"_3078":59938},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3627":2894,"_31174":2710,"_21594":59940,"_5":14861,"_28366":59418,"_3078":59941},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3627":2895,"_31174":2710,"_21594":59943,"_5":14861,"_28366":59421,"_3078":59944},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3627":2896,"_31174":2710,"_21594":59946,"_5":14861,"_28366":59425,"_3078":59947},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3627":2897,"_31174":2710,"_21594":59949,"_5":14861,"_28366":59429,"_3078":59950},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3627":2898,"_31174":2710,"_21594":59952,"_5":14861,"_28366":59429,"_3078":59953},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3627":2899,"_31174":2710,"_21594":59955,"_5":14861,"_28366":59429,"_3078":59956},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3627":2900,"_31174":2710,"_21594":59958,"_5":14861,"_28366":59433,"_3078":59959},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3627":2901,"_31174":2710,"_21594":59961,"_5":14861,"_28366":59437,"_3078":59962},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3627":2902,"_31174":2710,"_21594":59964,"_5":14861,"_28366":59437,"_3078":59965},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3627":2903,"_31174":2710,"_21594":59967,"_5":14861,"_28366":59437,"_3078":59968},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3627":2904,"_31174":2710,"_21594":59970,"_5":14861,"_28366":59437,"_3078":59971},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3627":2905,"_31174":2710,"_21594":59973,"_5":14861,"_28366":59437,"_3078":59974},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3627":2906,"_31174":2710,"_21594":59976,"_5":14861,"_28366":59437,"_3078":59977},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3627":2907,"_31174":2710,"_21594":59979,"_5":14861,"_28366":59445,"_3078":59980},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3627":2908,"_31174":2710,"_21594":59982,"_5":14861,"_28366":59445,"_3078":59983},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3627":2909,"_31174":2710,"_21594":59985,"_5":14861,"_28366":59445,"_3078":59986},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3627":2910,"_31174":2710,"_21594":59988,"_5":14861,"_28366":59445,"_3078":59989},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3627":2911,"_31174":2710,"_21594":59991,"_5":14861,"_28366":59445,"_3078":59992},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3627":2912,"_31174":2710,"_21594":59994,"_5":14861,"_28366":59449,"_3078":59995},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3627":2913,"_31174":2710,"_21594":59997,"_5":14861,"_28366":59453,"_3078":59998},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3627":2914,"_31174":2710,"_21594":60000,"_5":14861,"_28366":59453,"_3078":60001},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3627":2915,"_31174":2710,"_21594":60003,"_5":14861,"_28366":59453,"_3078":60004},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3627":2916,"_31174":2710,"_21594":60006,"_5":14861,"_28366":59453,"_3078":60007},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3627":2917,"_31174":2710,"_21594":60009,"_5":14861,"_28366":59453,"_3078":60010},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3627":2918,"_31174":2710,"_21594":60012,"_5":14861,"_28366":59453,"_3078":60013},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3627":2919,"_31174":2710,"_21594":60015,"_5":14861,"_28366":59453,"_3078":60016},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3627":2920,"_31174":2710,"_21594":60018,"_5":14861,"_28366":59453,"_3078":60019},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3627":2921,"_31174":2710,"_21594":60021,"_5":14861,"_28366":59457,"_3078":60022},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3627":2922,"_31174":2710,"_21594":60024,"_5":14861,"_28366":59465,"_3078":60025},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3627":2923,"_31174":2710,"_21594":60027,"_5":14861,"_28366":59465,"_3078":60028},[],"Field in 3.8.0",{"_3627":2924,"_31174":2710,"_21594":60030,"_5":14861,"_28366":59465,"_3078":60031},[],"Field in 4.0.0",{"_3627":2925,"_31174":2710,"_21594":60033,"_5":14861,"_28366":59465,"_3078":60034},[],"`validate_server_cert`",{"_3627":2926,"_31174":2710,"_21594":60036,"_5":14861,"_28366":59465,"_3078":60037},[],"`insecure_skip_verify` (value negated)",{"_3627":2927,"_31174":2710,"_21594":60039,"_5":14861,"_28366":59465,"_3078":60040},[],"`oidc`",{"_3627":2928,"_31174":2710,"_21594":60042,"_5":14861,"_28366":59465,"_3078":60043},[],"`jwt_options`",{"_3627":2929,"_31174":2710,"_21594":60045,"_5":14861,"_28366":59465,"_3078":60046},[],"`apikey`",{"_3627":2930,"_31174":2710,"_21594":60048,"_5":14861,"_28366":59465,"_3078":60049},[],"`apikey_options`",{"_3627":2931,"_31174":2710,"_21594":60051,"_5":14861,"_28366":59465,"_3078":60052},[],"`mtls`",{"_3627":2932,"_31174":2710,"_21594":60054,"_5":14861,"_28366":59465,"_3078":60055},[],"`mtls_options`",{"_3627":2933,"_31174":2710,"_21594":60057,"_5":14861,"_28366":59465,"_3078":60058},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3627":2934,"_31174":2710,"_21594":60060,"_5":14861,"_28366":59465,"_3078":60061},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3627":2935,"_31174":2710,"_21594":60063,"_5":14861,"_28366":59465,"_3078":60064},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3627":2936,"_31174":2710,"_21594":60066,"_5":14861,"_28366":59469,"_3078":60067},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3627":2937,"_31174":2710,"_21594":60069,"_5":14861,"_28366":59469,"_3078":60070},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3627":2938,"_31174":2710,"_21594":60072,"_5":14861,"_28366":59469,"_3078":60073},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3627":2939,"_31174":2710,"_21594":60075,"_5":14861,"_28366":59473,"_3078":60076},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3627":2940,"_31174":2710,"_21594":60078,"_5":14861,"_28366":59473,"_3078":60079},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3627":2941,"_31174":2710,"_21594":60081,"_5":14861,"_28366":59477,"_3078":60082},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3627":2942,"_31174":2710,"_21594":60084,"_5":14861,"_28366":59481,"_3078":60085},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3627":2943,"_31174":2710,"_21594":60087,"_5":14861,"_28366":59485,"_3078":60088},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3627":2944,"_31174":2710,"_21594":60090,"_5":14861,"_28366":59489,"_3078":60091},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3627":2945,"_31174":2710,"_21594":60093,"_5":14861,"_28366":59489,"_3078":60094},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3627":2946,"_31174":2710,"_21594":60096,"_5":14861,"_28366":59489,"_3078":60097},[],"`POST /v1/devices/:id/events` creates an event.",{"_3627":2947,"_31174":2710,"_21594":60099,"_5":14861,"_28366":59489,"_3078":60100},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3627":2948,"_31174":2710,"_21594":60102,"_5":14861,"_28366":59493,"_3078":60103},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3627":2949,"_31174":2710,"_21594":60105,"_5":14861,"_28366":59497,"_3078":60106},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3627":2950,"_31174":2710,"_21594":60108,"_5":14861,"_28366":59497,"_3078":60109},[],"Route",{"_3627":2951,"_31174":2710,"_21594":60111,"_5":14861,"_28366":59497,"_3078":54400},[],{"_3627":2952,"_31174":2710,"_21594":60113,"_5":14861,"_28366":59497,"_3078":60114},[],"`GET /v1/crl-settings`",{"_3627":2953,"_31174":2710,"_21594":60116,"_5":14861,"_28366":59497,"_3078":60117},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3627":2954,"_31174":2710,"_21594":60119,"_5":14861,"_28366":59497,"_3078":60120},[],"`GET /v1/crl-settings/{ca-id}`",{"_3627":2955,"_31174":2710,"_21594":60122,"_5":14861,"_28366":59497,"_3078":60123},[],"Reads the settings of a CA.",{"_3627":2956,"_31174":2710,"_21594":60125,"_5":14861,"_28366":59497,"_3078":60126},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3627":2957,"_31174":2710,"_21594":60128,"_5":14861,"_28366":59497,"_3078":60129},[],"Replaces `crl_options`.",{"_3627":2958,"_31174":2710,"_21594":60131,"_5":14861,"_28366":59497,"_3078":60132},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3627":2959,"_31174":2710,"_21594":60134,"_5":14861,"_28366":59497,"_3078":60135},[],"Removes the archived settings of a CA.",{"_3627":2960,"_31174":2710,"_21594":60137,"_5":14861,"_28366":59497,"_3078":60138},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3627":2961,"_31174":2710,"_21594":60140,"_5":14861,"_28366":59497,"_3078":60141},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3627":2962,"_31174":2710,"_21594":60143,"_5":14861,"_28366":59497,"_3078":60144},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3627":2963,"_31174":2710,"_21594":60146,"_5":14861,"_28366":59497,"_3078":60147},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3627":2964,"_31174":2710,"_21594":60149,"_5":14861,"_28366":59497,"_3078":60150},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3627":2965,"_31174":2710,"_21594":60152,"_5":14861,"_28366":59497,"_3078":60153},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3627":2966,"_31174":2710,"_21594":60155,"_5":14861,"_28366":59497,"_3078":60156},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3627":2967,"_31174":2710,"_21594":60158,"_5":14861,"_28366":59497,"_3078":60159},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3627":2968,"_31174":2710,"_21594":60161,"_5":14861,"_28366":59497,"_3078":60162},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3627":2969,"_31174":2710,"_21594":60164,"_5":14861,"_28366":59497,"_3078":60165},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3627":2970,"_31174":2710,"_21594":60167,"_5":14861,"_28366":59497,"_3078":60168},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3627":2971,"_31174":2710,"_21594":60170,"_5":14861,"_28366":59501,"_3078":60171},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3627":2972,"_31174":2710,"_21594":60173,"_5":14861,"_28366":59505,"_3078":60174},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3627":2973,"_31174":2710,"_21594":60176,"_5":14861,"_28366":59509,"_3078":60177},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3627":2974,"_31174":2710,"_21594":60179,"_5":14861,"_28366":59513,"_3078":60180},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3627":2975,"_31174":2710,"_21594":60182,"_5":14861,"_28366":59513,"_3078":60183},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3627":2976,"_31174":2710,"_21594":60185,"_5":14861,"_28366":59516,"_3078":60186},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3627":2977,"_31174":2710,"_21594":60188,"_5":14861,"_28366":59520,"_3078":60189},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3627":2978,"_31174":2710,"_21594":60191,"_5":14861,"_28366":59524,"_3078":60192},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3627":2979,"_31174":2710,"_21594":60194,"_5":14861,"_28366":59524,"_3078":60195},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3627":2980,"_31174":2710,"_21594":60197,"_5":14861,"_28366":59524,"_3078":60198},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3627":2981,"_31174":2710,"_21594":60200,"_5":14861,"_28366":59524,"_3078":60201},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3627":2982,"_31174":2710,"_21594":60203,"_5":14861,"_28366":59524,"_3078":60204},[],"Record the names of your local-storage PVCs:",{"_3627":2983,"_31174":2710,"_21594":60206,"_5":14861,"_28366":59524,"_3078":60207},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3627":2984,"_31174":2710,"_21594":60209,"_5":14861,"_28366":59528,"_3078":60210},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3627":2985,"_31174":2710,"_21594":60212,"_5":14861,"_28366":59528,"_3078":60213},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3627":2986,"_31174":2710,"_21594":60215,"_5":14861,"_28366":59528,"_3078":60216},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3627":2987,"_31174":2710,"_21594":60218,"_5":14861,"_28366":59528,"_3078":60219},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3627":2988,"_31174":2710,"_21594":60221,"_5":14861,"_28366":59528,"_3078":60222},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3627":2989,"_31174":2710,"_21594":60224,"_5":14861,"_28366":59532,"_3078":60225},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3627":2990,"_31174":2710,"_21594":60227,"_5":14861,"_28366":59532,"_3078":60228},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3627":2991,"_31174":2710,"_21594":60230,"_5":14861,"_28366":59532,"_3078":60231},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3627":2992,"_31174":2710,"_21594":60233,"_5":14861,"_28366":59532,"_3078":60234},[],"Secret (`existingSecret`)",{"_3627":2993,"_31174":2710,"_21594":60236,"_5":14861,"_28366":59532,"_3078":60237},[],"Required data keys",{"_3627":2994,"_31174":2710,"_21594":60239,"_5":14861,"_28366":59532,"_3078":60240},[],"When",{"_3627":2995,"_31174":2710,"_21594":60242,"_5":14861,"_28366":59532,"_3078":60243},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3627":2996,"_31174":2710,"_21594":60245,"_5":14861,"_28366":59532,"_3078":60246},[],"`username`, `password`",{"_3627":2997,"_31174":2710,"_21594":60248,"_5":14861,"_28366":59532,"_3078":60249},[],"Always",{"_3627":2998,"_31174":2710,"_21594":60251,"_5":14861,"_28366":59532,"_3078":60252},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3627":2999,"_31174":2710,"_21594":60254,"_5":14861,"_28366":59532,"_3078":60246},[],{"_3627":3000,"_31174":2710,"_21594":60256,"_5":14861,"_28366":59532,"_3078":60249},[],{"_3627":3001,"_31174":2710,"_21594":60258,"_5":14861,"_28366":59532,"_3078":60259},[],"`services.alerts.smtp_server.existingSecret`",{"_3627":3002,"_31174":2710,"_21594":60261,"_5":14861,"_28366":59532,"_3078":60246},[],{"_3627":3003,"_31174":2710,"_21594":60263,"_5":14861,"_28366":59532,"_3078":60264},[],"Only when SMTP authentication is enabled",{"_3627":3004,"_31174":2710,"_21594":60266,"_5":14861,"_28366":59532,"_3078":60267},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3627":3005,"_31174":2710,"_21594":60269,"_5":14861,"_28366":59532,"_3078":60270},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3627":3006,"_31174":2710,"_21594":60272,"_5":14861,"_28366":59532,"_3078":60273},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3627":3007,"_31174":2710,"_21594":60275,"_5":14861,"_28366":59532,"_3078":60276},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3627":3008,"_31174":2710,"_21594":60278,"_5":14861,"_28366":59532,"_3078":60279},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3627":3009,"_31174":2710,"_21594":60281,"_5":14861,"_28366":59532,"_3078":60282},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3627":3010,"_31174":2710,"_21594":60284,"_5":14861,"_28366":59532,"_3078":60285},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3627":3011,"_31174":2710,"_21594":60287,"_5":14861,"_28366":59532,"_3078":60288},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3627":3012,"_31174":2710,"_21594":60290,"_5":14861,"_28366":59532,"_3078":60291},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3627":3013,"_31174":2710,"_21594":60293,"_5":14861,"_28366":59532,"_3078":60294},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3627":3014,"_31174":2710,"_21594":60296,"_5":14861,"_28366":59532,"_3078":60297},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3627":3015,"_31174":2710,"_21594":60299,"_5":14861,"_28366":59532,"_3078":60300},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3627":3016,"_31174":2710,"_21594":60302,"_5":14861,"_28366":59532,"_3078":60303},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3627":3017,"_31174":2710,"_21594":60305,"_5":14861,"_28366":59532,"_3078":60306},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3627":3018,"_31174":2710,"_21594":60308,"_5":14861,"_28366":59532,"_3078":60309},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3627":3019,"_31174":2710,"_21594":60311,"_5":14861,"_28366":59536,"_3078":60312},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3627":3020,"_31174":2710,"_21594":60314,"_5":14861,"_28366":59536,"_3078":60315},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3627":3021,"_31174":2710,"_21594":60317,"_5":14861,"_28366":59540,"_3078":60318},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3627":3022,"_31174":2710,"_21594":60320,"_5":14861,"_28366":59540,"_3078":60321},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3627":3023,"_31174":2710,"_21594":60323,"_5":14861,"_28366":59540,"_3078":60324},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3627":3024,"_31174":2710,"_21594":60326,"_5":14861,"_28366":59540,"_3078":60327},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3627":3025,"_31174":2710,"_21594":60329,"_5":14861,"_28366":59540,"_3078":60330},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3627":3026,"_31174":2710,"_21594":60332,"_5":14861,"_28366":59540,"_3078":60333},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3627":3027,"_31174":2710,"_21594":60335,"_5":14861,"_28366":59540,"_3078":60336},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3627":3028,"_31174":2710,"_21594":60338,"_5":14861,"_28366":59540,"_3078":60339},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3627":3029,"_31174":2710,"_21594":60341,"_5":14861,"_28366":59540,"_3078":60342},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3627":3030,"_31174":2710,"_21594":60344,"_5":14861,"_28366":59540,"_3078":60345},[],"**Remove the helper and restore the recorded replica counts:**",{"_3627":3031,"_31174":2710,"_21594":60347,"_5":14861,"_28366":59540,"_3078":60348},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3627":3032,"_31174":2710,"_21594":60350,"_5":14861,"_28366":59544,"_3078":60351},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3627":3033,"_31174":2710,"_21594":60353,"_5":14861,"_28366":59544,"_3078":60354},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3627":3034,"_31174":2710,"_21594":60356,"_5":14861,"_28366":59548,"_3078":60357},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3627":3035,"_31174":2710,"_21594":60359,"_5":14861,"_28366":59548,"_3078":60360},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3627":3036,"_31174":2710,"_21594":60362,"_5":14861,"_28366":59548,"_3078":60363},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3627":3037,"_31174":2710,"_21594":60365,"_5":14861,"_28366":59548,"_3078":60366},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3627":3038,"_31174":2710,"_21594":60368,"_5":14861,"_28366":59548,"_3078":60369},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3627":3039,"_31174":2710,"_21594":60371,"_5":14861,"_28366":59548,"_3078":60372},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3627":3040,"_31174":2710,"_21594":60374,"_5":14861,"_28366":59548,"_3078":60375},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3627":3041,"_31174":2710,"_21594":60377,"_5":14861,"_28366":59548,"_3078":60378},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3627":3042,"_31174":2710,"_21594":60380,"_5":14861,"_28366":59552,"_3078":60381},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3627":3043,"_31174":2710,"_21594":60383,"_5":14861,"_28366":59552,"_3078":60384},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3627":3044,"_31174":2710,"_21594":60386,"_5":14861,"_28366":59552,"_3078":60387},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3627":3045,"_31174":2710,"_21594":60389,"_5":14861,"_28366":59552,"_3078":60390},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3627":3046,"_31174":2710,"_21594":60392,"_5":14861,"_28366":59552,"_3078":60393},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3627":3047,"_31174":2710,"_21594":60395,"_5":14861,"_28366":59552,"_3078":60396},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3627":3048,"_31174":2710,"_21594":60398,"_5":14861,"_28366":59552,"_3078":60399},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3627":3049,"_31174":2710,"_21594":60401,"_5":14861,"_28366":59552,"_3078":60402},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3627":3050,"_31174":2710,"_21594":60404,"_5":14861,"_28366":59552,"_3078":60405},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3627":3051,"_31174":2710,"_21594":60407,"_5":14861,"_28366":59552,"_3078":60408},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3627":3052,"_31174":2710,"_21594":60410,"_5":14861,"_28366":59552,"_3078":60411},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3627":3053,"_31174":2710,"_21594":60413,"_5":14861,"_28366":59555,"_3078":60414},[],"After the upgrade, check in this order:",{"_3627":3054,"_31174":2710,"_21594":60416,"_5":14861,"_28366":59555,"_3078":60417},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3627":3055,"_31174":2710,"_21594":60419,"_5":14861,"_28366":59555,"_3078":60420},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3627":3056,"_31174":2710,"_21594":60422,"_5":14861,"_28366":59555,"_3078":60423},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3627":3057,"_31174":2710,"_21594":60425,"_5":14861,"_28366":59555,"_3078":60426},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3627":3058,"_31174":2710,"_21594":60428,"_5":14861,"_28366":59555,"_3078":60429},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3627":3059,"_31174":2710,"_21594":60431,"_5":14861,"_28366":59555,"_3078":60432},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3627":3060,"_31174":2710,"_21594":60434,"_5":14861,"_28366":59555,"_3078":60435},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3627":3061,"_31174":2710,"_21594":60437,"_5":14861,"_28366":59555,"_3078":60438},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3627":3062,"_31174":2710,"_21594":60440,"_5":14861,"_28366":59555,"_3078":60441},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3627":3063,"_31174":2710,"_21594":60443,"_5":14861,"_28366":59555,"_3078":60444},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3627":3064,"_31174":2710,"_21594":60446,"_5":14861,"_28366":59555,"_3078":60447},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3627":3065,"_31174":2710,"_21594":60449,"_5":14861,"_28366":59555,"_3078":60450},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3627":3066,"_31174":2710,"_21594":60452,"_5":14861,"_28366":59555,"_3078":60453},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3627":3067,"_31174":2710,"_21594":60455,"_5":14861,"_28366":59555,"_3078":60456},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3627":3068,"_31174":2710,"_21594":60458,"_5":14861,"_28366":59555,"_3078":60459},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3627":3069,"_31174":2710,"_21594":60461,"_5":14861,"_28366":59559,"_3078":60462},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3627":3070,"_31174":2710,"_21594":60464,"_5":14861,"_28366":59559,"_3078":60465},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3627":3071,"_31174":2710,"_21594":60467,"_5":14861,"_28366":59559,"_3078":60468},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3627":3072,"_31174":2710,"_21594":60470,"_5":14861,"_28366":59559,"_3078":60471},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3627":3073,"_31174":2710,"_21594":60473,"_5":14861,"_28366":59559,"_3078":60474},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60477":60478,"_60479":60480,"_60481":60482,"_60483":60484,"_18731":3113,"_72734":3113},"language","english","sortableProperties",[3078,31174,5,28366],"sortablePropertiesWithTypes",{"_3078":25780,"_31174":25780,"_5":25780,"_28366":25780},"sorts",{"_3078":60485,"_31174":63548,"_5":66610,"_28366":69672},{"_4829":60486,"_60487":60488,"_5":25780},{"_14942":4233,"_15321":16326,"_15340":14840,"_30174":13351,"_15327":4239,"_20506":4486,"_14963":7913,"_14970":3154,"_30116":7923,"_30524":6248,"_30551":3496,"_30150":7060,"_35580":4388,"_30253":7814,"_30595":5125,"_35587":30766,"_35590":4917,"_35593":4608,"_35596":4159,"_30997":5143,"_35601":5322,"_35603":17854,"_31032":8910,"_15336":6196,"_35607":3474,"_35610":6976,"_35612":6438,"_30579":5388,"_31017":3250,"_31045":5183,"_35617":15379,"_35619":3484,"_35621":6981,"_30264":3179,"_35624":3423,"_35626":4057,"_35628":3409,"_35630":3808,"_35632":6228,"_30187":7279,"_35635":4035,"_35637":3594,"_30181":10787,"_30616":7484,"_35641":4380,"_35643":7771,"_35646":4587,"_30227":4563,"_35650":5178,"_30107":17339,"_35653":4966,"_30155":20100,"_35656":5289,"_35658":14907,"_35661":20859,"_15330":9916,"_35664":3175,"_35666":12251,"_35669":6057,"_35671":3396,"_35673":14514,"