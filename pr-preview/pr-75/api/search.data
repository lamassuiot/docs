3,"_41270":128566,"_41272":128569,"_41274":128572,"_41276":128575,"_41278":128578,"_41280":128581,"_41282":128584,"_41284":128587,"_41286":128590,"_41288":128593,"_41290":128596,"_41292":128599,"_41294":128602,"_41296":128605,"_41298":128608,"_41300":128611,"_41302":128614,"_41304":128617,"_41306":128620,"_41308":128623,"_41310":128625,"_41312":128628,"_41314":128631,"_41316":128634,"_41318":128636,"_41320":128639,"_41322":128642,"_41324":128644,"_41326":128646,"_41328":128648,"_41330":128650,"_41332":128653,"_41334":128656,"_41336":128659,"_41338":128662,"_41340":128665,"_41342":128668,"_41344":128671,"_41346":128674,"_41348":128677,"_41350":128680,"_41352":128683,"_41354":128686,"_41356":128689,"_41358":128692,"_41360":128695,"_41362":128698,"_41364":128701,"_41366":128704,"_41368":128707,"_41370":128710,"_41372":128713,"_41375":128716,"_41377":128719,"_41379":128722,"_41381":128725,"_41383":128728,"_41385":128731,"_41387":128734,"_41389":128737,"_41391":128740,"_41393":128743,"_41395":128746,"_41397":128749,"_41399":128752,"_41401":128755,"_41404":128758,"_41406":128761,"_41408":128764,"_41410":128767,"_41412":128770,"_41414":128773,"_41416":128776,"_41418":128779,"_41420":128782,"_41422":128785,"_41424":128788,"_41426":128791,"_41428":128794,"_41430":128797,"_41432":128800,"_41434":128803,"_41436":128806,"_41438":128809,"_41440":128812,"_41442":128815,"_41444":128818,"_41446":128821,"_41448":128824,"_41450":128827,"_41452":128830,"_41454":128833,"_41456":128836,"_41458":128839,"_41460":128842,"_41462":128845,"_41464":128848,"_41466":128851,"_41469":128854,"_41471":128857,"_41473":128860},{"_3604":72332,"_31000":72332,"_5":15112,"_3059":119633,"_31359":119634,"_21469":119637,"_28187":72332},"Despliega desde AWS Marketplace",[50673,119635,119636],"Despliegue","Otros modelos",[],{"_3604":72333,"_31000":72332,"_21469":119639,"_5":14752,"_28187":72332,"_3059":119640},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3604":72334,"_31000":72332,"_5":31356,"_21469":119642,"_28187":119643,"_3059":119644},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3604":72335,"_31000":72332,"_5":31356,"_21469":119646,"_28187":119647,"_3059":119648},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3604":72336,"_31000":72332,"_5":31356,"_21469":119650,"_28187":119651,"_3059":119652},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3604":72337,"_31000":72332,"_5":31356,"_21469":119654,"_28187":119655,"_3059":119656},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3604":72338,"_31000":72332,"_5":31356,"_21469":119658,"_28187":119659,"_3059":119660},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3604":72339,"_31000":72332,"_5":31356,"_21469":119662,"_28187":119663,"_3059":119664},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3604":72340,"_31000":72332,"_5":31356,"_21469":119666,"_28187":119667,"_3059":119668},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3604":72341,"_31000":72332,"_21469":119670,"_5":14752,"_28187":72332,"_3059":119671},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3604":72342,"_31000":72332,"_21469":119673,"_5":14752,"_28187":119643,"_3059":119674},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3604":72343,"_31000":72332,"_21469":119676,"_5":14752,"_28187":119643,"_3059":119677},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3604":72344,"_31000":72332,"_21469":119679,"_5":14752,"_28187":119643,"_3059":119680},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3604":72345,"_31000":72332,"_21469":119682,"_5":14752,"_28187":119647,"_3059":119683},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3604":72346,"_31000":72332,"_21469":119685,"_5":14752,"_28187":119647,"_3059":119686},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3604":72347,"_31000":72332,"_21469":119688,"_5":14752,"_28187":119647,"_3059":119689},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3604":72348,"_31000":72332,"_21469":119691,"_5":14752,"_28187":119651,"_3059":119692},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3604":72349,"_31000":72332,"_21469":119694,"_5":14752,"_28187":119655,"_3059":119695},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3604":72350,"_31000":72332,"_21469":119697,"_5":14752,"_28187":119659,"_3059":119698},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3604":72351,"_31000":72332,"_21469":119700,"_5":14752,"_28187":119663,"_3059":119701},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3604":72352,"_31000":72332,"_21469":119703,"_5":14752,"_28187":119667,"_3059":119704},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3604":72353,"_31000":72353,"_5":15112,"_3059":119706,"_31359":119707,"_21469":119708,"_28187":72353},"Despliega Lamassu",[50673,119635],[],{"_3604":72354,"_31000":72353,"_21469":119710,"_5":14752,"_28187":72353,"_3059":119711},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3604":72355,"_31000":72353,"_5":31356,"_21469":119713,"_28187":119714,"_3059":119715},[],"/docs/pr-preview/pr-75/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3604":72356,"_31000":72353,"_5":31356,"_21469":119717,"_28187":119718,"_3059":119719},[],"/docs/pr-preview/pr-75/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3604":72357,"_31000":72353,"_5":31356,"_21469":119721,"_28187":119722,"_3059":119723},[],"/docs/pr-preview/pr-75/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3604":72358,"_31000":72353,"_21469":119725,"_5":14752,"_28187":72353,"_3059":119726},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3604":72359,"_31000":72353,"_21469":119728,"_5":14752,"_28187":119714,"_3059":119729},[],"Modelo",{"_3604":72360,"_31000":72353,"_21469":119731,"_5":14752,"_28187":119714,"_3059":119732},[],"Recomendado para",{"_3604":72361,"_31000":72353,"_21469":119734,"_5":14752,"_28187":119714,"_3059":119735},[],"Quién opera la infraestructura",{"_3604":72362,"_31000":72353,"_21469":119737,"_5":14752,"_28187":119714,"_3059":119738},[],"Punto de partida",{"_3604":72363,"_31000":72353,"_21469":119740,"_5":14752,"_28187":119714,"_3059":50780},[],{"_3604":72364,"_31000":72353,"_21469":119742,"_5":14752,"_28187":119714,"_3059":119743},[],"Producción, entornos regulados y despliegues personalizados",{"_3604":72365,"_31000":72353,"_21469":119745,"_5":14752,"_28187":119714,"_3059":119746},[],"Tu equipo",{"_3604":72366,"_31000":72353,"_21469":119748,"_5":14752,"_28187":119714,"_3059":119749},[],"Helm o Fastlane",{"_3604":72367,"_31000":72353,"_21469":119751,"_5":14752,"_28187":119714,"_3059":50792},[],{"_3604":72368,"_31000":72353,"_21469":119753,"_5":14752,"_28187":119714,"_3059":119754},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3604":72369,"_31000":72353,"_21469":119756,"_5":14752,"_28187":119714,"_3059":119746},[],{"_3604":72370,"_31000":72353,"_21469":119758,"_5":14752,"_28187":119714,"_3059":119759},[],"Imagen preconfigurada en EC2",{"_3604":72371,"_31000":72353,"_21469":119761,"_5":14752,"_28187":119714,"_3059":50803},[],{"_3604":72372,"_31000":72353,"_21469":119763,"_5":14752,"_28187":119714,"_3059":119764},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3604":72373,"_31000":72353,"_21469":119766,"_5":14752,"_28187":119714,"_3059":50809},[],{"_3604":72374,"_31000":72353,"_21469":119768,"_5":14752,"_28187":119714,"_3059":119769},[],"Suscripción gestionada",{"_3604":72375,"_31000":72353,"_21469":119771,"_5":14752,"_28187":119714,"_3059":119772},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3604":72376,"_31000":72353,"_21469":119774,"_5":14752,"_28187":119714,"_3059":119775},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3604":72377,"_31000":72353,"_21469":119777,"_5":14752,"_28187":119714,"_3059":119778},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3604":72378,"_31000":72353,"_21469":119780,"_5":14752,"_28187":119718,"_3059":119781},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3604":72379,"_31000":72353,"_21469":119783,"_5":14752,"_28187":119722,"_3059":119784},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3604":72380,"_31000":72380,"_5":15112,"_3059":119786,"_31359":119787,"_21469":119788,"_28187":72380},"Utiliza Lamassu como SaaS",[50673,119635,119636],[],{"_3604":72381,"_31000":72380,"_21469":119790,"_5":14752,"_28187":72380,"_3059":119791},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3604":72382,"_31000":72380,"_5":31356,"_21469":119793,"_28187":119794,"_3059":119795},[],"/docs/pr-preview/pr-75/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3604":72383,"_31000":72380,"_5":31356,"_21469":119797,"_28187":119798,"_3059":119799},[],"/docs/pr-preview/pr-75/es/deployment/saas#planes","Planes",{"_3604":72384,"_31000":72380,"_5":31356,"_21469":119801,"_28187":119802,"_3059":119803},[],"/docs/pr-preview/pr-75/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3604":72385,"_31000":72380,"_21469":119805,"_5":14752,"_28187":72380,"_3059":119806},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3604":72386,"_31000":72380,"_21469":119808,"_5":14752,"_28187":119794,"_3059":119809},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3604":72387,"_31000":72380,"_21469":119811,"_5":14752,"_28187":119794,"_3059":119812},[],"Copias de seguridad automáticas.",{"_3604":72388,"_31000":72380,"_21469":119814,"_5":14752,"_28187":119794,"_3059":119815},[],"Actualizaciones de versión.",{"_3604":72389,"_31000":72380,"_21469":119817,"_5":14752,"_28187":119794,"_3059":119818},[],"Soporte técnico y SLA según el plan contratado.",{"_3604":72390,"_31000":72380,"_21469":119820,"_5":14752,"_28187":119798,"_3059":50864},[],{"_3604":72391,"_31000":72380,"_21469":119822,"_5":14752,"_28187":119798,"_3059":119823},[],"Dispositivos",{"_3604":72392,"_31000":72380,"_21469":119825,"_5":14752,"_28187":119798,"_3059":119826},[],"Soporte",{"_3604":72393,"_31000":72380,"_21469":119828,"_5":14752,"_28187":119798,"_3059":50873},[],{"_3604":72394,"_31000":72380,"_21469":119830,"_5":14752,"_28187":119798,"_3059":50876},[],{"_3604":72395,"_31000":72380,"_21469":119832,"_5":14752,"_28187":119798,"_3059":119833},[],"Hasta 1.000",{"_3604":72396,"_31000":72380,"_21469":119835,"_5":14752,"_28187":119798,"_3059":50882},[],{"_3604":72397,"_31000":72380,"_21469":119837,"_5":14752,"_28187":119798,"_3059":119838},[],"99,5 %",{"_3604":72398,"_31000":72380,"_21469":119840,"_5":14752,"_28187":119798,"_3059":50888},[],{"_3604":72399,"_31000":72380,"_21469":119842,"_5":14752,"_28187":119798,"_3059":119843},[],"Hasta 10.000",{"_3604":72400,"_31000":72380,"_21469":119845,"_5":14752,"_28187":119798,"_3059":119846},[],"Email y chat",{"_3604":72401,"_31000":72380,"_21469":119848,"_5":14752,"_28187":119798,"_3059":119849},[],"99,9 %",{"_3604":72402,"_31000":72380,"_21469":119851,"_5":14752,"_28187":119798,"_3059":50900},[],{"_3604":72403,"_31000":72380,"_21469":119853,"_5":14752,"_28187":119798,"_3059":119854},[],"Ilimitados",{"_3604":72404,"_31000":72380,"_21469":119856,"_5":14752,"_28187":119798,"_3059":119857},[],"Dedicado",{"_3604":72405,"_31000":72380,"_21469":119859,"_5":14752,"_28187":119798,"_3059":119860},[],"99,99 %",{"_3604":72406,"_31000":72380,"_21469":119862,"_5":14752,"_28187":119802,"_3059":119863},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3604":72407,"_31000":72380,"_21469":119865,"_5":14752,"_28187":119802,"_3059":119866},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3604":72408,"_31000":72408,"_5":15112,"_3059":50917,"_31359":119868,"_21469":119870,"_28187":72408},[50673,119635,119869],"Kubernetes autogestionado",[],{"_3604":72409,"_31000":72408,"_21469":119872,"_5":14752,"_28187":72408,"_3059":119873},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3604":72410,"_31000":72408,"_5":31356,"_21469":119875,"_28187":119876,"_3059":119877},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3604":72411,"_31000":72408,"_5":31356,"_21469":119879,"_28187":119880,"_3059":119881},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3604":72412,"_31000":72408,"_5":31356,"_21469":119883,"_28187":119884,"_3059":119885},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3604":72413,"_31000":72408,"_5":31356,"_21469":119887,"_28187":119888,"_3059":119889},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3604":72414,"_31000":72408,"_5":31356,"_21469":119891,"_28187":119892,"_3059":119893},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3604":72415,"_31000":72408,"_5":31356,"_21469":119895,"_28187":119896,"_3059":119897},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3604":72416,"_31000":72408,"_5":31356,"_21469":119899,"_28187":119900,"_3059":119901},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3604":72417,"_31000":72408,"_5":31356,"_21469":119903,"_28187":119904,"_3059":119905},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3604":72418,"_31000":72408,"_5":31356,"_21469":119907,"_28187":119908,"_3059":119909},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3604":72419,"_31000":72408,"_5":31356,"_21469":119911,"_28187":119912,"_3059":119913},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3604":72420,"_31000":72408,"_5":31356,"_21469":119915,"_28187":119916,"_3059":119917},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3604":72421,"_31000":72408,"_21469":119919,"_5":14752,"_28187":119876,"_3059":119920},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3604":72422,"_31000":72408,"_21469":119922,"_5":14752,"_28187":119876,"_3059":119923},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3604":72423,"_31000":72408,"_21469":119925,"_5":14752,"_28187":119880,"_3059":119926},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3604":72424,"_31000":72408,"_21469":119928,"_5":14752,"_28187":119880,"_3059":119929},[],"Fastlane instala o configura",{"_3604":72425,"_31000":72408,"_21469":119931,"_5":14752,"_28187":119880,"_3059":119932},[],"Tú sigues proporcionando",{"_3604":72426,"_31000":72408,"_21469":119934,"_5":14752,"_28187":119880,"_3059":119935},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3604":72427,"_31000":72408,"_21469":119937,"_5":14752,"_28187":119880,"_3059":119938},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3604":72428,"_31000":72408,"_21469":119940,"_5":14752,"_28187":119880,"_3059":119941},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3604":72429,"_31000":72408,"_21469":119943,"_5":14752,"_28187":119880,"_3059":119944},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3604":72430,"_31000":72408,"_21469":119946,"_5":14752,"_28187":119880,"_3059":119947},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3604":72431,"_31000":72408,"_21469":119949,"_5":14752,"_28187":119880,"_3059":119950},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3604":72432,"_31000":72408,"_21469":119952,"_5":14752,"_28187":119880,"_3059":119953},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3604":72433,"_31000":72408,"_21469":119955,"_5":14752,"_28187":119880,"_3059":119956},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3604":72434,"_31000":72408,"_21469":119958,"_5":14752,"_28187":119880,"_3059":119959},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3604":72435,"_31000":72408,"_21469":119961,"_5":14752,"_28187":119884,"_3059":119962},[],"Necesitas:",{"_3604":72436,"_31000":72408,"_21469":119964,"_5":14752,"_28187":119884,"_3059":119965},[],"un clúster Kubernetes existente",{"_3604":72437,"_31000":72408,"_21469":119967,"_5":14752,"_28187":119884,"_3059":119968},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3604":72438,"_31000":72408,"_21469":119970,"_5":14752,"_28187":119884,"_3059":51019},[],{"_3604":72439,"_31000":72408,"_21469":119972,"_5":14752,"_28187":119884,"_3059":24270},[],{"_3604":72440,"_31000":72408,"_21469":119974,"_5":14752,"_28187":119884,"_3059":119975},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3604":72441,"_31000":72408,"_21469":119977,"_5":14752,"_28187":119884,"_3059":119978},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3604":72442,"_31000":72408,"_21469":119980,"_5":14752,"_28187":119884,"_3059":119981},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3604":72443,"_31000":72408,"_21469":119983,"_5":14752,"_28187":119884,"_3059":119984},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3604":72444,"_31000":72408,"_21469":119986,"_5":14752,"_28187":119884,"_3059":119987},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3604":72445,"_31000":72408,"_21469":119989,"_5":14752,"_28187":119888,"_3059":119990},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3604":72446,"_31000":72408,"_21469":119992,"_5":14752,"_28187":119888,"_3059":119993},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3604":72447,"_31000":72408,"_21469":119995,"_5":14752,"_28187":119892,"_3059":119996},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3604":72448,"_31000":72408,"_21469":119998,"_5":14752,"_28187":119892,"_3059":119999},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3604":72449,"_31000":72408,"_21469":120001,"_5":14752,"_28187":119892,"_3059":120002},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3604":72450,"_31000":72408,"_21469":120004,"_5":14752,"_28187":119892,"_3059":120005},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3604":72451,"_31000":72408,"_21469":120007,"_5":14752,"_28187":119896,"_3059":120008},[],"Opción",{"_3604":72452,"_31000":72408,"_21469":120010,"_5":14752,"_28187":119896,"_3059":120011},[],"Valor predeterminado",{"_3604":72453,"_31000":72408,"_21469":120013,"_5":14752,"_28187":119896,"_3059":120014},[],"Propósito",{"_3604":72454,"_31000":72408,"_21469":120016,"_5":14752,"_28187":119896,"_3059":51066},[],{"_3604":72455,"_31000":72408,"_21469":120018,"_5":14752,"_28187":119896,"_3059":51069},[],{"_3604":72456,"_31000":72408,"_21469":120020,"_5":14752,"_28187":119896,"_3059":120021},[],"Muestra la ayuda",{"_3604":72457,"_31000":72408,"_21469":120023,"_5":14752,"_28187":119896,"_3059":51075},[],{"_3604":72458,"_31000":72408,"_21469":120025,"_5":14752,"_28187":119896,"_3059":120026},[],"contexto actual",{"_3604":72459,"_31000":72408,"_21469":120028,"_5":14752,"_28187":119896,"_3059":120029},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3604":72460,"_31000":72408,"_21469":120031,"_5":14752,"_28187":119896,"_3059":51084},[],{"_3604":72461,"_31000":72408,"_21469":120033,"_5":14752,"_28187":119896,"_3059":6761},[],{"_3604":72462,"_31000":72408,"_21469":120035,"_5":14752,"_28187":119896,"_3059":120036},[],"Omite prompts y genera credenciales para las dependencias",{"_3604":72463,"_31000":72408,"_21469":120038,"_5":14752,"_28187":119896,"_3059":51092},[],{"_3604":72464,"_31000":72408,"_21469":120040,"_5":14752,"_28187":119896,"_3059":51095},[],{"_3604":72465,"_31000":72408,"_21469":120042,"_5":14752,"_28187":119896,"_3059":120043},[],"Namespace de la instalación",{"_3604":72466,"_31000":72408,"_21469":120045,"_5":14752,"_28187":119896,"_3059":51101},[],{"_3604":72467,"_31000":72408,"_21469":120047,"_5":14752,"_28187":119896,"_3059":51104},[],{"_3604":72468,"_31000":72408,"_21469":120049,"_5":14752,"_28187":119896,"_3059":120050},[],"Dominio usado por la UI, OIDC y el certificado",{"_3604":72469,"_31000":72408,"_21469":120052,"_5":14752,"_28187":119896,"_3059":51110},[],{"_3604":72470,"_31000":72408,"_21469":120054,"_5":14752,"_28187":119896,"_3059":15463},[],{"_3604":72471,"_31000":72408,"_21469":120056,"_5":14752,"_28187":119896,"_3059":120057},[],"Versión del chart de Lamassu",{"_3604":72472,"_31000":72408,"_21469":120059,"_5":14752,"_28187":119896,"_3059":51118},[],{"_3604":72473,"_31000":72408,"_21469":120061,"_5":14752,"_28187":119896,"_3059":51121},[],{"_3604":72474,"_31000":72408,"_21469":120063,"_5":14752,"_28187":119896,"_3059":120064},[],"Puerto del listener HTTPS",{"_3604":72475,"_31000":72408,"_21469":120066,"_5":14752,"_28187":119896,"_3059":51127},[],{"_3604":72476,"_31000":72408,"_21469":120068,"_5":14752,"_28187":119896,"_3059":51130},[],{"_3604":72477,"_31000":72408,"_21469":120070,"_5":14752,"_28187":119896,"_3059":120071},[],"Puerto del listener HTTP",{"_3604":72478,"_31000":72408,"_21469":120073,"_5":14752,"_28187":119896,"_3059":51136},[],{"_3604":72479,"_31000":72408,"_21469":120075,"_5":14752,"_28187":119896,"_3059":51069},[],{"_3604":72480,"_31000":72408,"_21469":120077,"_5":14752,"_28187":119896,"_3059":120078},[],"Certificado PEM para TLS downstream",{"_3604":72481,"_31000":72408,"_21469":120080,"_5":14752,"_28187":119896,"_3059":51144},[],{"_3604":72482,"_31000":72408,"_21469":120082,"_5":14752,"_28187":119896,"_3059":51069},[],{"_3604":72483,"_31000":72408,"_21469":120084,"_5":14752,"_28187":119896,"_3059":120085},[],"Clave privada PEM para TLS downstream",{"_3604":72484,"_31000":72408,"_21469":120087,"_5":14752,"_28187":119896,"_3059":51152},[],{"_3604":72485,"_31000":72408,"_21469":120089,"_5":14752,"_28187":119896,"_3059":120090},[],"chart del repositorio",{"_3604":72486,"_31000":72408,"_21469":120092,"_5":14752,"_28187":119896,"_3059":120093},[],"Usa un chart local de Lamassu sin empaquetar",{"_3604":72487,"_31000":72408,"_21469":120095,"_5":14752,"_28187":119896,"_3059":51161},[],{"_3604":72488,"_31000":72408,"_21469":120097,"_5":14752,"_28187":119896,"_3059":120098},[],"detección automática",{"_3604":72489,"_31000":72408,"_21469":120100,"_5":14752,"_28187":119896,"_3059":120101},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3604":72490,"_31000":72408,"_21469":120103,"_5":14752,"_28187":119896,"_3059":51169},[],{"_3604":72491,"_31000":72408,"_21469":120105,"_5":14752,"_28187":119896,"_3059":6761},[],{"_3604":72492,"_31000":72408,"_21469":120107,"_5":14752,"_28187":119896,"_3059":120108},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3604":72493,"_31000":72408,"_21469":120110,"_5":14752,"_28187":119896,"_3059":51177},[],{"_3604":72494,"_31000":72408,"_21469":120112,"_5":14752,"_28187":119896,"_3059":6761},[],{"_3604":72495,"_31000":72408,"_21469":120114,"_5":14752,"_28187":119896,"_3059":120115},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3604":72496,"_31000":72408,"_21469":120117,"_5":14752,"_28187":119896,"_3059":51185},[],{"_3604":72497,"_31000":72408,"_21469":120119,"_5":14752,"_28187":119896,"_3059":6761},[],{"_3604":72498,"_31000":72408,"_21469":120121,"_5":14752,"_28187":119896,"_3059":120122},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3604":72499,"_31000":72408,"_21469":120124,"_5":14752,"_28187":119896,"_3059":51193},[],{"_3604":72500,"_31000":72408,"_21469":120126,"_5":14752,"_28187":119896,"_3059":6761},[],{"_3604":72501,"_31000":72408,"_21469":120128,"_5":14752,"_28187":119896,"_3059":120129},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3604":72502,"_31000":72408,"_21469":120131,"_5":14752,"_28187":119896,"_3059":51201},[],{"_3604":72503,"_31000":72408,"_21469":120133,"_5":14752,"_28187":119896,"_3059":51204},[],{"_3604":72504,"_31000":72408,"_21469":120135,"_5":14752,"_28187":119896,"_3059":120136},[],"Usa otro chart local de SoftHSM",{"_3604":72505,"_31000":72408,"_21469":120138,"_5":14752,"_28187":119896,"_3059":120139},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3604":72506,"_31000":72408,"_21469":120141,"_5":14752,"_28187":119900,"_3059":120142},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3604":72507,"_31000":72408,"_21469":120144,"_5":14752,"_28187":119900,"_3059":120145},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3604":72508,"_31000":72408,"_21469":120147,"_5":14752,"_28187":119900,"_3059":120148},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3604":72509,"_31000":72408,"_21469":120150,"_5":14752,"_28187":119900,"_3059":120151},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3604":72510,"_31000":72408,"_21469":120153,"_5":14752,"_28187":119900,"_3059":120154},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3604":72511,"_31000":72408,"_21469":120156,"_5":14752,"_28187":119900,"_3059":120157},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3604":72512,"_31000":72408,"_21469":120159,"_5":14752,"_28187":119904,"_3059":51231},[],{"_3604":72513,"_31000":72408,"_21469":120161,"_5":14752,"_28187":119904,"_3059":120162},[],"valida las herramientas locales y el clúster seleccionado",{"_3604":72514,"_31000":72408,"_21469":120164,"_5":14752,"_28187":119904,"_3059":120165},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3604":72515,"_31000":72408,"_21469":120167,"_5":14752,"_28187":119904,"_3059":120168},[],"crea el namespace",{"_3604":72516,"_31000":72408,"_21469":120170,"_5":14752,"_28187":119904,"_3059":120171},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3604":72517,"_31000":72408,"_21469":120173,"_5":14752,"_28187":119904,"_3059":120174},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3604":72518,"_31000":72408,"_21469":120176,"_5":14752,"_28187":119904,"_3059":120177},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3604":72519,"_31000":72408,"_21469":120179,"_5":14752,"_28187":119904,"_3059":120180},[],"instala RabbitMQ",{"_3604":72520,"_31000":72408,"_21469":120182,"_5":14752,"_28187":119904,"_3059":120183},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3604":72521,"_31000":72408,"_21469":120185,"_5":14752,"_28187":119904,"_3059":120186},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3604":72522,"_31000":72408,"_21469":120188,"_5":14752,"_28187":119904,"_3059":120189},[],"carga datos de ejemplo opcionalmente",{"_3604":72523,"_31000":72408,"_21469":120191,"_5":14752,"_28187":119904,"_3059":120192},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3604":72524,"_31000":72408,"_21469":120194,"_5":14752,"_28187":119908,"_3059":120195},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3604":72525,"_31000":72408,"_21469":120197,"_5":14752,"_28187":119908,"_3059":120198},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3604":72526,"_31000":72408,"_21469":120200,"_5":14752,"_28187":119912,"_3059":120201},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3604":72527,"_31000":72408,"_21469":120203,"_5":14752,"_28187":119912,"_3059":120204},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3604":72528,"_31000":72408,"_21469":120206,"_5":14752,"_28187":119912,"_3059":120207},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3604":72529,"_31000":72408,"_21469":120209,"_5":14752,"_28187":119912,"_3059":120210},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3604":72530,"_31000":72408,"_21469":120212,"_5":14752,"_28187":119916,"_3059":120213},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3604":72531,"_31000":72531,"_5":15112,"_3059":120215,"_31359":120216,"_21469":120217,"_28187":72531},"Instala con Helm",[50673,119635,119869],[],{"_3604":72532,"_31000":72531,"_21469":120219,"_5":14752,"_28187":72531,"_3059":120220},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3604":72533,"_31000":72531,"_5":31356,"_21469":120222,"_28187":120223,"_3059":120224},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3604":72534,"_31000":72531,"_5":31356,"_21469":120226,"_28187":120227,"_3059":119885},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3604":72535,"_31000":72531,"_5":31356,"_21469":120229,"_28187":120230,"_3059":120231},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3604":72536,"_31000":72531,"_5":31356,"_21469":120233,"_28187":120234,"_3059":120235},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3604":72537,"_31000":72531,"_5":31356,"_21469":120237,"_28187":120238,"_3059":120239},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3604":72538,"_31000":72531,"_5":31356,"_21469":120241,"_28187":120242,"_3059":120243},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3604":72539,"_31000":72531,"_5":31356,"_21469":120245,"_28187":120246,"_3059":120247},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3604":72540,"_31000":72531,"_5":31356,"_21469":120249,"_28187":120250,"_3059":120251},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3604":72541,"_31000":72531,"_5":31356,"_21469":120253,"_28187":120254,"_3059":120255},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3604":72542,"_31000":72531,"_5":31356,"_21469":120257,"_28187":120258,"_3059":120259},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3604":72543,"_31000":72531,"_5":31356,"_21469":120261,"_28187":120262,"_3059":120263},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3604":72544,"_31000":72531,"_5":31356,"_21469":120265,"_28187":120266,"_3059":120267},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3604":72545,"_31000":72531,"_21469":120269,"_5":14752,"_28187":120223,"_3059":120270},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3604":72546,"_31000":72531,"_21469":120272,"_5":14752,"_28187":120227,"_3059":120273},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3604":72547,"_31000":72531,"_21469":120275,"_5":14752,"_28187":120227,"_3059":120276},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3604":72548,"_31000":72531,"_21469":120278,"_5":14752,"_28187":120227,"_3059":120279},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3604":72549,"_31000":72531,"_21469":120281,"_5":14752,"_28187":120227,"_3059":120282},[],"un broker RabbitMQ accesible y sus credenciales",{"_3604":72550,"_31000":72531,"_21469":120284,"_5":14752,"_28187":120227,"_3059":120285},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3604":72551,"_31000":72531,"_21469":120287,"_5":14752,"_28187":120227,"_3059":120288},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3604":72552,"_31000":72531,"_21469":120290,"_5":14752,"_28187":120227,"_3059":120291},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3604":72553,"_31000":72531,"_21469":120293,"_5":14752,"_28187":120227,"_3059":120294},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3604":72554,"_31000":72531,"_21469":120296,"_5":14752,"_28187":120227,"_3059":120297},[],"una StorageClass y un diseño de tráfico externo",{"_3604":72555,"_31000":72531,"_21469":120299,"_5":14752,"_28187":120227,"_3059":120300},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3604":72556,"_31000":72531,"_21469":120302,"_5":14752,"_28187":120227,"_3059":120303},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3604":72557,"_31000":72531,"_21469":120305,"_5":14752,"_28187":120227,"_3059":120306},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3604":72558,"_31000":72531,"_21469":120308,"_5":14752,"_28187":120230,"_3059":120309},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3604":72559,"_31000":72531,"_21469":120311,"_5":14752,"_28187":120230,"_3059":120312},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3604":72560,"_31000":72531,"_21469":120314,"_5":14752,"_28187":120230,"_3059":120315},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3604":72561,"_31000":72531,"_21469":120317,"_5":14752,"_28187":120234,"_3059":120318},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3604":72562,"_31000":72531,"_21469":120320,"_5":14752,"_28187":120234,"_3059":120321},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3604":72563,"_31000":72531,"_21469":120323,"_5":14752,"_28187":120234,"_3059":120324},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3604":72564,"_31000":72531,"_21469":120326,"_5":14752,"_28187":120234,"_3059":120327},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3604":72565,"_31000":72531,"_21469":120329,"_5":14752,"_28187":120238,"_3059":120330},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3604":72566,"_31000":72531,"_21469":120332,"_5":14752,"_28187":120238,"_3059":120333},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3604":72567,"_31000":72531,"_21469":120335,"_5":14752,"_28187":120238,"_3059":120336},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3604":72568,"_31000":72531,"_21469":120338,"_5":14752,"_28187":120238,"_3059":120339},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3604":72569,"_31000":72531,"_21469":120341,"_5":14752,"_28187":120238,"_3059":120342},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3604":72570,"_31000":72531,"_21469":120344,"_5":14752,"_28187":120238,"_3059":120345},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3604":72571,"_31000":72531,"_21469":120347,"_5":14752,"_28187":120238,"_3059":120348},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3604":72572,"_31000":72531,"_21469":120350,"_5":14752,"_28187":120238,"_3059":120351},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3604":72573,"_31000":72531,"_21469":120353,"_5":14752,"_28187":120242,"_3059":120354},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3604":72574,"_31000":72531,"_21469":120356,"_5":14752,"_28187":120246,"_3059":120357},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3604":72575,"_31000":72531,"_21469":120359,"_5":14752,"_28187":120246,"_3059":120360},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3604":72576,"_31000":72531,"_21469":120362,"_5":14752,"_28187":120246,"_3059":120363},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3604":72577,"_31000":72531,"_21469":120365,"_5":14752,"_28187":120246,"_3059":120366},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3604":72578,"_31000":72531,"_21469":120368,"_5":14752,"_28187":120246,"_3059":120369},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3604":72579,"_31000":72531,"_21469":120371,"_5":14752,"_28187":120246,"_3059":120372},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3604":72580,"_31000":72531,"_21469":120374,"_5":14752,"_28187":120246,"_3059":120375},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3604":72581,"_31000":72531,"_21469":120377,"_5":14752,"_28187":120250,"_3059":120378},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3604":72582,"_31000":72531,"_21469":120380,"_5":14752,"_28187":120250,"_3059":120381},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3604":72583,"_31000":72531,"_21469":120383,"_5":14752,"_28187":120250,"_3059":120384},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3604":72584,"_31000":72531,"_21469":120386,"_5":14752,"_28187":120250,"_3059":120387},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3604":72585,"_31000":72531,"_21469":120389,"_5":14752,"_28187":120254,"_3059":120390},[],"Para instalar un checkout local:",{"_3604":72586,"_31000":72531,"_21469":120392,"_5":14752,"_28187":120258,"_3059":120393},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3604":72587,"_31000":72531,"_21469":120395,"_5":14752,"_28187":120258,"_3059":120396},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3604":72588,"_31000":72531,"_21469":120398,"_5":14752,"_28187":120262,"_3059":120399},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3604":72589,"_31000":72531,"_21469":120401,"_5":14752,"_28187":120262,"_3059":120402},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3604":72590,"_31000":72531,"_21469":120404,"_5":14752,"_28187":120262,"_3059":120405},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3604":72591,"_31000":72531,"_21469":120407,"_5":14752,"_28187":120262,"_3059":120408},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3604":72592,"_31000":72531,"_21469":120410,"_5":14752,"_28187":120262,"_3059":120411},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3604":72593,"_31000":72531,"_21469":120413,"_5":14752,"_28187":120266,"_3059":120414},[],"Antes de pasar a producción, revisa:",{"_3604":72594,"_31000":72531,"_21469":120416,"_5":14752,"_28187":120266,"_3059":120417},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3604":72595,"_31000":72531,"_21469":120419,"_5":14752,"_28187":120266,"_3059":120420},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3604":72596,"_31000":72531,"_21469":120422,"_5":14752,"_28187":120266,"_3059":120423},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3604":72597,"_31000":72531,"_21469":120425,"_5":14752,"_28187":120266,"_3059":120426},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3604":72598,"_31000":72531,"_21469":120428,"_5":14752,"_28187":120266,"_3059":120429},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3604":72599,"_31000":72531,"_21469":120431,"_5":14752,"_28187":120266,"_3059":120432},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3604":72600,"_31000":72531,"_21469":120434,"_5":14752,"_28187":120266,"_3059":120435},[],"SMTP, observabilidad y entrega de alertas",{"_3604":72601,"_31000":72531,"_21469":120437,"_5":14752,"_28187":120266,"_3059":120438},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3604":72602,"_31000":72531,"_21469":120440,"_5":14752,"_28187":120266,"_3059":120441},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3604":72603,"_31000":72603,"_5":15112,"_3059":120443,"_31359":120444,"_21469":120445,"_28187":72603},"Expón el Gateway",[50673,119635,119869],[],{"_3604":72604,"_31000":72603,"_21469":120447,"_5":14752,"_28187":72603,"_3059":120448},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3604":72605,"_31000":72603,"_5":31356,"_21469":120450,"_28187":120451,"_3059":120452},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3604":72606,"_31000":72603,"_5":31356,"_21469":120454,"_28187":120455,"_3059":120456},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3604":72607,"_31000":72603,"_5":31356,"_21469":120458,"_28187":120459,"_3059":120460},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3604":72608,"_31000":72603,"_5":31356,"_21469":120462,"_28187":120463,"_3059":51536},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#k3s",{"_3604":72609,"_31000":72603,"_5":31356,"_21469":120465,"_28187":120466,"_3059":120467},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3604":72610,"_31000":72603,"_5":31356,"_21469":120469,"_28187":120470,"_3059":120471},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3604":72611,"_31000":72603,"_5":31356,"_21469":120473,"_28187":120474,"_3059":120475},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3604":72612,"_31000":72603,"_5":31356,"_21469":120477,"_28187":120478,"_3059":120479},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3604":72613,"_31000":72603,"_5":31356,"_21469":120481,"_28187":120482,"_3059":120483},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3604":72614,"_31000":72603,"_5":31356,"_21469":120485,"_28187":120486,"_3059":120487},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3604":72615,"_31000":72603,"_5":31356,"_21469":120489,"_28187":120490,"_3059":120491},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3604":72616,"_31000":72603,"_21469":120493,"_5":14752,"_28187":120451,"_3059":120494},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3604":72617,"_31000":72603,"_21469":120496,"_5":14752,"_28187":120451,"_3059":120497},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3604":72618,"_31000":72603,"_21469":120499,"_5":14752,"_28187":120455,"_3059":120500},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3604":72619,"_31000":72603,"_21469":120502,"_5":14752,"_28187":120455,"_3059":120503},[],"Defínelo únicamente cuando:",{"_3604":72620,"_31000":72603,"_21469":120505,"_5":14752,"_28187":120455,"_3059":120506},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3604":72621,"_31000":72603,"_21469":120508,"_5":14752,"_28187":120455,"_3059":120509},[],"esa dirección está asignada a este Gateway",{"_3604":72622,"_31000":72603,"_21469":120511,"_5":14752,"_28187":120455,"_3059":120512},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3604":72623,"_31000":72603,"_21469":120514,"_5":14752,"_28187":120455,"_3059":120515},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3604":72624,"_31000":72603,"_21469":120517,"_5":14752,"_28187":120455,"_3059":120518},[],"No confundas estos valores:",{"_3604":72625,"_31000":72603,"_21469":120520,"_5":14752,"_28187":120455,"_3059":120521},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3604":72626,"_31000":72603,"_21469":120523,"_5":14752,"_28187":120455,"_3059":120524},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3604":72627,"_31000":72603,"_21469":120526,"_5":14752,"_28187":120455,"_3059":120527},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3604":72628,"_31000":72603,"_21469":120529,"_5":14752,"_28187":120459,"_3059":120530},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3604":72629,"_31000":72603,"_21469":120532,"_5":14752,"_28187":120459,"_3059":120533},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3604":72630,"_31000":72603,"_21469":120535,"_5":14752,"_28187":120463,"_3059":120536},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3604":72631,"_31000":72603,"_21469":120538,"_5":14752,"_28187":120463,"_3059":120539},[],"Para el diseño recomendado:",{"_3604":72632,"_31000":72603,"_21469":120541,"_5":14752,"_28187":120463,"_3059":120542},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3604":72633,"_31000":72603,"_21469":120544,"_5":14752,"_28187":120463,"_3059":120545},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3604":72634,"_31000":72603,"_21469":120547,"_5":14752,"_28187":120463,"_3059":120548},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3604":72635,"_31000":72603,"_21469":120550,"_5":14752,"_28187":120463,"_3059":120551},[],"Apunta DNS a la dirección accesible de la VM.",{"_3604":72636,"_31000":72603,"_21469":120553,"_5":14752,"_28187":120463,"_3059":120554},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3604":72637,"_31000":72603,"_21469":120556,"_5":14752,"_28187":120466,"_3059":120557},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3604":72638,"_31000":72603,"_21469":120559,"_5":14752,"_28187":120470,"_3059":120560},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3604":72639,"_31000":72603,"_21469":120562,"_5":14752,"_28187":120470,"_3059":120563},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3604":72640,"_31000":72603,"_21469":120565,"_5":14752,"_28187":120474,"_3059":120566},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3604":72641,"_31000":72603,"_21469":120568,"_5":14752,"_28187":120474,"_3059":120569},[],"Requisito",{"_3604":72642,"_31000":72603,"_21469":120571,"_5":14752,"_28187":120474,"_3059":120572},[],"Diseño recomendado",{"_3604":72643,"_31000":72603,"_21469":120574,"_5":14752,"_28187":120474,"_3059":120575},[],"Consecuencia",{"_3604":72644,"_31000":72603,"_21469":120577,"_5":14752,"_28187":120474,"_3059":120578},[],"Varias URL o servicios de Lamassu",{"_3604":72645,"_31000":72603,"_21469":120580,"_5":14752,"_28187":120474,"_3059":120581},[],"Un Gateway con varias rutas",{"_3604":72646,"_31000":72603,"_21469":120583,"_5":14752,"_28187":120474,"_3059":120584},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3604":72647,"_31000":72603,"_21469":120586,"_5":14752,"_28187":120474,"_3059":120587},[],"Gateways independientes e IP externas distintas",{"_3604":72648,"_31000":72603,"_21469":120589,"_5":14752,"_28187":120474,"_3059":120590},[],"Una VIP por Gateway",{"_3604":72649,"_31000":72603,"_21469":120592,"_5":14752,"_28187":120474,"_3059":120593},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3604":72650,"_31000":72603,"_21469":120595,"_5":14752,"_28187":120474,"_3059":120596},[],"Gateways independientes, un nodo y una IP",{"_3604":72651,"_31000":72603,"_21469":120598,"_5":14752,"_28187":120474,"_3059":120599},[],"Puertos externos diferentes",{"_3604":72652,"_31000":72603,"_21469":120601,"_5":14752,"_28187":120474,"_3059":120602},[],"Los clientes deben indicar puertos no estándar",{"_3604":72653,"_31000":72603,"_21469":120604,"_5":14752,"_28187":120474,"_3059":120605},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3604":72654,"_31000":72603,"_21469":120607,"_5":14752,"_28187":120474,"_3059":120608},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3604":72655,"_31000":72603,"_21469":120610,"_5":14752,"_28187":120474,"_3059":120611},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3604":72656,"_31000":72603,"_21469":120613,"_5":14752,"_28187":120474,"_3059":120614},[],"Recursos Gateway separados pero proxy compartido",{"_3604":72657,"_31000":72603,"_21469":120616,"_5":14752,"_28187":120474,"_3059":120617},[],"Modo merged Gateway de Envoy",{"_3604":72658,"_31000":72603,"_21469":120619,"_5":14752,"_28187":120474,"_3059":120620},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3604":72659,"_31000":72603,"_21469":120622,"_5":14752,"_28187":120474,"_3059":120623},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3604":72660,"_31000":72603,"_21469":120625,"_5":14752,"_28187":120474,"_3059":120626},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3604":72661,"_31000":72603,"_21469":120628,"_5":14752,"_28187":120474,"_3059":120629},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3604":72662,"_31000":72603,"_21469":120631,"_5":14752,"_28187":120474,"_3059":120632},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3604":72663,"_31000":72603,"_21469":120634,"_5":14752,"_28187":120478,"_3059":120635},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3604":72664,"_31000":72603,"_21469":120637,"_5":14752,"_28187":120482,"_3059":120638},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3604":72665,"_31000":72603,"_21469":120640,"_5":14752,"_28187":120482,"_3059":120641},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3604":72666,"_31000":72603,"_21469":120643,"_5":14752,"_28187":120482,"_3059":120644},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3604":72667,"_31000":72603,"_21469":120646,"_5":14752,"_28187":120482,"_3059":120647},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3604":72668,"_31000":72603,"_21469":120649,"_5":14752,"_28187":120482,"_3059":120650},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3604":72669,"_31000":72603,"_21469":120652,"_5":14752,"_28187":120486,"_3059":120653},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3604":72670,"_31000":72603,"_21469":120655,"_5":14752,"_28187":120486,"_3059":120656},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3604":72671,"_31000":72603,"_21469":120658,"_5":14752,"_28187":120490,"_3059":120659},[],"Comprueba, en orden:",{"_3604":72672,"_31000":72603,"_21469":120661,"_5":14752,"_28187":120490,"_3059":120662},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3604":72673,"_31000":72603,"_21469":120664,"_5":14752,"_28187":120490,"_3059":120665},[],"Su estado contiene la dirección esperada.",{"_3604":72674,"_31000":72603,"_21469":120667,"_5":14752,"_28187":120490,"_3059":120668},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3604":72675,"_31000":72603,"_21469":120670,"_5":14752,"_28187":120490,"_3059":120671},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3604":72676,"_31000":72603,"_21469":120673,"_5":14752,"_28187":120490,"_3059":120674},[],"DNS resuelve al endpoint accesible externamente.",{"_3604":72677,"_31000":72603,"_21469":120676,"_5":14752,"_28187":120490,"_3059":120677},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3604":72678,"_31000":72603,"_21469":120679,"_5":14752,"_28187":120490,"_3059":120680},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3604":72679,"_31000":72679,"_5":15112,"_3059":50780,"_31359":120682,"_21469":120683,"_28187":72679},[50673,119635,119869],[],{"_3604":72680,"_31000":72679,"_21469":120685,"_5":14752,"_28187":72679,"_3059":120686},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3604":72681,"_31000":72679,"_5":31356,"_21469":120688,"_28187":120689,"_3059":120690},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3604":72682,"_31000":72679,"_5":31356,"_21469":120692,"_28187":120693,"_3059":120694},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3604":72683,"_31000":72679,"_5":31356,"_21469":120696,"_28187":120697,"_3059":120698},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3604":72684,"_31000":72679,"_5":31356,"_21469":120700,"_28187":120701,"_3059":120702},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3604":72685,"_31000":72679,"_5":31356,"_21469":120704,"_28187":120705,"_3059":120706},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3604":72686,"_31000":72679,"_5":31356,"_21469":120708,"_28187":120709,"_3059":120710},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3604":72687,"_31000":72679,"_21469":120712,"_5":14752,"_28187":120689,"_3059":120713},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3604":72688,"_31000":72679,"_21469":120715,"_5":14752,"_28187":120693,"_3059":120716},[],"Flujo",{"_3604":72689,"_31000":72679,"_21469":120718,"_5":14752,"_28187":120693,"_3059":120719},[],"Úsalo para",{"_3604":72690,"_31000":72679,"_21469":120721,"_5":14752,"_28187":120693,"_3059":120722},[],"Qué instala",{"_3604":72691,"_31000":72679,"_21469":120724,"_5":14752,"_28187":120693,"_3059":51798},[],{"_3604":72692,"_31000":72679,"_21469":120726,"_5":14752,"_28187":120693,"_3059":120727},[],"Producción y entornos controlados",{"_3604":72693,"_31000":72679,"_21469":120729,"_5":14752,"_28187":120693,"_3059":120730},[],"Servicios de Lamassu y recursos de Gateway API",{"_3604":72694,"_31000":72679,"_21469":120732,"_5":14752,"_28187":120693,"_3059":50917},[],{"_3604":72695,"_31000":72679,"_21469":120734,"_5":14752,"_28187":120693,"_3059":120735},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3604":72696,"_31000":72679,"_21469":120737,"_5":14752,"_28187":120693,"_3059":120738},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3604":72697,"_31000":72679,"_21469":120740,"_5":14752,"_28187":120697,"_3059":120741},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3604":72698,"_31000":72679,"_21469":120743,"_5":14752,"_28187":120697,"_3059":120744},[],"Área",{"_3604":72699,"_31000":72679,"_21469":120746,"_5":14752,"_28187":120697,"_3059":120747},[],"El chart de Lamassu proporciona",{"_3604":72700,"_31000":72679,"_21469":120749,"_5":14752,"_28187":120697,"_3059":120750},[],"Tú proporcionas",{"_3604":72701,"_31000":72679,"_21469":120752,"_5":14752,"_28187":120697,"_3059":120753},[],"Aplicaciones Lamassu",{"_3604":72702,"_31000":72679,"_21469":120755,"_5":14752,"_28187":120697,"_3059":120756},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3604":72703,"_31000":72679,"_21469":120758,"_5":14752,"_28187":120697,"_3059":120759},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3604":72704,"_31000":72679,"_21469":120761,"_5":14752,"_28187":120697,"_3059":120762},[],"Datos PostgreSQL",{"_3604":72705,"_31000":72679,"_21469":120764,"_5":14752,"_28187":120697,"_3059":120765},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3604":72706,"_31000":72679,"_21469":120767,"_5":14752,"_28187":120697,"_3059":120768},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3604":72707,"_31000":72679,"_21469":120770,"_5":14752,"_28187":120697,"_3059":120771},[],"Mensajería",{"_3604":72708,"_31000":72679,"_21469":120773,"_5":14752,"_28187":120697,"_3059":120774},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3604":72709,"_31000":72679,"_21469":120776,"_5":14752,"_28187":120697,"_3059":120777},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3604":72710,"_31000":72679,"_21469":120779,"_5":14752,"_28187":120697,"_3059":120780},[],"Identidad",{"_3604":72711,"_31000":72679,"_21469":120782,"_5":14752,"_28187":120697,"_3059":120783},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3604":72712,"_31000":72679,"_21469":120785,"_5":14752,"_28187":120697,"_3059":120786},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3604":72713,"_31000":72679,"_21469":120788,"_5":14752,"_28187":120697,"_3059":120789},[],"Enrutamiento externo",{"_3604":72714,"_31000":72679,"_21469":120791,"_5":14752,"_28187":120697,"_3059":120792},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3604":72715,"_31000":72679,"_21469":120794,"_5":14752,"_28187":120697,"_3059":120795},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3604":72716,"_31000":72679,"_21469":120797,"_5":14752,"_28187":120697,"_3059":51872},[],{"_3604":72717,"_31000":72679,"_21469":120799,"_5":14752,"_28187":120697,"_3059":120800},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3604":72718,"_31000":72679,"_21469":120802,"_5":14752,"_28187":120697,"_3059":120803},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3604":72719,"_31000":72679,"_21469":120805,"_5":14752,"_28187":120697,"_3059":120806},[],"Datos persistentes de la aplicación",{"_3604":72720,"_31000":72679,"_21469":120808,"_5":14752,"_28187":120697,"_3059":120809},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3604":72721,"_31000":72679,"_21469":120811,"_5":14752,"_28187":120697,"_3059":120812},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3604":72722,"_31000":72679,"_21469":120814,"_5":14752,"_28187":120697,"_3059":120815},[],"Integraciones opcionales",{"_3604":72723,"_31000":72679,"_21469":120817,"_5":14752,"_28187":120697,"_3059":120818},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3604":72724,"_31000":72679,"_21469":120820,"_5":14752,"_28187":120697,"_3059":120821},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3604":72725,"_31000":72679,"_21469":120823,"_5":14752,"_28187":120697,"_3059":120824},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3604":72726,"_31000":72679,"_21469":120826,"_5":14752,"_28187":120697,"_3059":120827},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3604":72727,"_31000":72679,"_21469":120829,"_5":14752,"_28187":120701,"_3059":120830},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3604":72728,"_31000":72679,"_21469":120832,"_5":14752,"_28187":120701,"_3059":120833},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3604":72729,"_31000":72679,"_21469":120835,"_5":14752,"_28187":120705,"_3059":120836},[],"Kubernetes 1.24 o posterior",{"_3604":72730,"_31000":72679,"_21469":120838,"_5":14752,"_28187":120705,"_3059":120839},[],"Helm 3.2 o posterior",{"_3604":72731,"_31000":72679,"_21469":120841,"_5":14752,"_28187":120705,"_3059":120842},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3604":72732,"_31000":72679,"_21469":120844,"_5":14752,"_28187":120705,"_3059":120845},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3604":72733,"_31000":72679,"_21469":120847,"_5":14752,"_28187":120705,"_3059":120848},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3604":72734,"_31000":72679,"_21469":120850,"_5":14752,"_28187":120705,"_3059":120851},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3604":72735,"_31000":72679,"_21469":120853,"_5":14752,"_28187":120705,"_3059":120854},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3604":72736,"_31000":72679,"_21469":120856,"_5":14752,"_28187":120709,"_3059":120857},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3604":72737,"_31000":72679,"_21469":120859,"_5":14752,"_28187":120709,"_3059":120860},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3604":72738,"_31000":72679,"_21469":120862,"_5":14752,"_28187":120709,"_3059":120863},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3604":72739,"_31000":72679,"_21469":120865,"_5":14752,"_28187":120709,"_3059":120866},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3604":72740,"_31000":72740,"_5":15112,"_3059":120868,"_31359":120869,"_21469":120871,"_28187":72740},"Resolución de problemas de despliegue",[50673,119635,120870],"Operación",[],{"_3604":72741,"_31000":72740,"_21469":120873,"_5":14752,"_28187":72740,"_3059":120874},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3604":72742,"_31000":72740,"_5":31356,"_21469":120876,"_28187":120877,"_3059":120878},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3604":72743,"_31000":72740,"_5":31356,"_21469":120880,"_28187":120881,"_3059":120882},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3604":72744,"_31000":72740,"_5":31356,"_21469":120884,"_28187":120885,"_3059":120886},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3604":72745,"_31000":72740,"_5":31356,"_21469":120888,"_28187":120889,"_3059":120890},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3604":72746,"_31000":72740,"_5":31356,"_21469":120892,"_28187":120893,"_3059":120894},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3604":72747,"_31000":72740,"_5":31356,"_21469":120896,"_28187":120897,"_3059":120898},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3604":72748,"_31000":72740,"_5":31356,"_21469":120900,"_28187":120901,"_3059":120902},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3604":72749,"_31000":72740,"_5":31356,"_21469":120904,"_28187":120905,"_3059":120906},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3604":72750,"_31000":72740,"_5":31356,"_21469":120908,"_28187":120909,"_3059":120910},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3604":72751,"_31000":72740,"_5":31356,"_21469":120912,"_28187":120913,"_3059":120914},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3604":72752,"_31000":72740,"_5":31356,"_21469":120916,"_28187":120917,"_3059":120918},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3604":72753,"_31000":72740,"_5":31356,"_21469":120920,"_28187":120921,"_3059":120922},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3604":72754,"_31000":72740,"_5":31356,"_21469":120924,"_28187":120925,"_3059":120926},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3604":72755,"_31000":72740,"_21469":120928,"_5":14752,"_28187":72740,"_3059":120929},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3604":72756,"_31000":72740,"_21469":120931,"_5":14752,"_28187":120881,"_3059":120932},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3604":72757,"_31000":72740,"_21469":120934,"_5":14752,"_28187":120885,"_3059":120935},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3604":72758,"_31000":72740,"_21469":120937,"_5":14752,"_28187":120889,"_3059":120938},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3604":72759,"_31000":72740,"_21469":120940,"_5":14752,"_28187":120893,"_3059":120941},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3604":72760,"_31000":72740,"_21469":120943,"_5":14752,"_28187":120897,"_3059":120944},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3604":72761,"_31000":72740,"_21469":120946,"_5":14752,"_28187":120901,"_3059":120947},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3604":72762,"_31000":72740,"_21469":120949,"_5":14752,"_28187":120901,"_3059":120950},[],"Ejecuta también la prueba de conectividad del chart:",{"_3604":72763,"_31000":72740,"_21469":120952,"_5":14752,"_28187":120901,"_3059":120953},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3604":72764,"_31000":72740,"_21469":120955,"_5":14752,"_28187":120901,"_3059":120956},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3604":72765,"_31000":72740,"_21469":120958,"_5":14752,"_28187":120905,"_3059":120959},[],"Si recibes un 401:",{"_3604":72766,"_31000":72740,"_21469":120961,"_5":14752,"_28187":120905,"_3059":120962},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3604":72767,"_31000":72740,"_21469":120964,"_5":14752,"_28187":120905,"_3059":120965},[],"verifica emisor, audiencia y expiración del token;",{"_3604":72768,"_31000":72740,"_21469":120967,"_5":14752,"_28187":120905,"_3059":120968},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3604":72769,"_31000":72740,"_21469":120970,"_5":14752,"_28187":120905,"_3059":120971},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3604":72770,"_31000":72740,"_21469":120973,"_5":14752,"_28187":120905,"_3059":120974},[],"Si el login termina pero las APIs devuelven 403:",{"_3604":72771,"_31000":72740,"_21469":120976,"_5":14752,"_28187":120905,"_3059":120977},[],"inspecciona los claims reales del token;",{"_3604":72772,"_31000":72740,"_21469":120979,"_5":14752,"_28187":120905,"_3059":120980},[],"confirma que coinciden con un principal activo;",{"_3604":72773,"_31000":72740,"_21469":120982,"_5":14752,"_28187":120905,"_3059":120983},[],"revisa las políticas concedidas al principal;",{"_3604":72774,"_31000":72740,"_21469":120985,"_5":14752,"_28187":120905,"_3059":120986},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3604":72775,"_31000":72740,"_21469":120988,"_5":14752,"_28187":120905,"_3059":120989},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3604":72776,"_31000":72740,"_21469":120991,"_5":14752,"_28187":120909,"_3059":120992},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3604":72777,"_31000":72740,"_21469":120994,"_5":14752,"_28187":120909,"_3059":120995},[],"Localiza el pod y Service de authz.",{"_3604":72778,"_31000":72740,"_21469":120997,"_5":14752,"_28187":120909,"_3059":120998},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3604":72779,"_31000":72740,"_21469":121000,"_5":14752,"_28187":120909,"_3059":121001},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3604":72780,"_31000":72740,"_21469":121003,"_5":14752,"_28187":120909,"_3059":121004},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3604":72781,"_31000":72740,"_21469":121006,"_5":14752,"_28187":120909,"_3059":121007},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3604":72782,"_31000":72740,"_21469":121009,"_5":14752,"_28187":120913,"_3059":121010},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3604":72783,"_31000":72740,"_21469":121012,"_5":14752,"_28187":120917,"_3059":121013},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3604":72784,"_31000":72740,"_21469":121015,"_5":14752,"_28187":120917,"_3059":121016},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3604":72785,"_31000":72740,"_21469":121018,"_5":14752,"_28187":120917,"_3059":121019},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3604":72786,"_31000":72740,"_21469":121021,"_5":14752,"_28187":120917,"_3059":121022},[],"volumen persistente sin enlazar;",{"_3604":72787,"_31000":72740,"_21469":121024,"_5":14752,"_28187":120917,"_3059":121025},[],"imagen inaccesible o política de pull incorrecta;",{"_3604":72788,"_31000":72740,"_21469":121027,"_5":14752,"_28187":120917,"_3059":121028},[],"configuración inválida del motor criptográfico;",{"_3604":72789,"_31000":72740,"_21469":121030,"_5":14752,"_28187":120917,"_3059":121031},[],"límites de CPU o memoria demasiado bajos;",{"_3604":72790,"_31000":72740,"_21469":121033,"_5":14752,"_28187":120917,"_3059":121034},[],"migración previa incompleta.",{"_3604":72791,"_31000":72740,"_21469":121036,"_5":14752,"_28187":120917,"_3059":121037},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3604":72792,"_31000":72740,"_21469":121039,"_5":14752,"_28187":120917,"_3059":121040},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3604":72793,"_31000":72740,"_21469":121042,"_5":14752,"_28187":120917,"_3059":121043},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3604":72794,"_31000":72740,"_21469":121045,"_5":14752,"_28187":120921,"_3059":121046},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3604":72795,"_31000":72740,"_21469":121048,"_5":14752,"_28187":120921,"_3059":121049},[],"verifica que esté habilitado en el servicio emisor;",{"_3604":72796,"_31000":72740,"_21469":121051,"_5":14752,"_28187":120921,"_3059":121052},[],"comprueba conectividad y credenciales AMQP;",{"_3604":72797,"_31000":72740,"_21469":121054,"_5":14752,"_28187":120921,"_3059":121055},[],"revisa exchange, routing key, colas y consumidores;",{"_3604":72798,"_31000":72740,"_21469":121057,"_5":14752,"_28187":120921,"_3059":121058},[],"inspecciona dead-letter queues;",{"_3604":72799,"_31000":72740,"_21469":121060,"_5":14752,"_28187":120921,"_3059":121061},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3604":72800,"_31000":72740,"_21469":121063,"_5":14752,"_28187":120921,"_3059":121064},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3604":72801,"_31000":72740,"_21469":121066,"_5":14752,"_28187":120921,"_3059":121067},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3604":72802,"_31000":72740,"_21469":121069,"_5":14752,"_28187":120921,"_3059":121070},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3604":72803,"_31000":72740,"_21469":121072,"_5":14752,"_28187":120921,"_3059":121073},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3604":72804,"_31000":72740,"_21469":121075,"_5":14752,"_28187":120921,"_3059":121076},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3604":72805,"_31000":72740,"_21469":121078,"_5":14752,"_28187":120921,"_3059":121079},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3604":72806,"_31000":72740,"_21469":121081,"_5":14752,"_28187":120921,"_3059":121082},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3604":72807,"_31000":72740,"_21469":121084,"_5":14752,"_28187":120925,"_3059":121085},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3604":72808,"_31000":72740,"_21469":121087,"_5":14752,"_28187":120925,"_3059":121088},[],"Antes de cerrar una incidencia, guarda:",{"_3604":72809,"_31000":72740,"_21469":121090,"_5":14752,"_28187":120925,"_3059":121091},[],"causa confirmada;",{"_3604":72810,"_31000":72740,"_21469":121093,"_5":14752,"_28187":120925,"_3059":121094},[],"alcance temporal y recursos afectados;",{"_3604":72811,"_31000":72740,"_21469":121096,"_5":14752,"_28187":120925,"_3059":121097},[],"comandos o consultas utilizados;",{"_3604":72812,"_31000":72740,"_21469":121099,"_5":14752,"_28187":120925,"_3059":121100},[],"cambio aplicado y forma de revertirlo;",{"_3604":72813,"_31000":72740,"_21469":121102,"_5":14752,"_28187":120925,"_3059":121103},[],"validación desde un consumidor;",{"_3604":72814,"_31000":72740,"_21469":121105,"_5":14752,"_28187":120925,"_3059":121106},[],"acción preventiva y propietario.",{"_3604":72815,"_31000":72815,"_5":15112,"_3059":121108,"_31359":121109,"_21469":121113,"_28187":72815},"Modelo de datos",[50673,121110,121111,121112],"Plataforma","Administración","Control de acceso",[],{"_3604":72816,"_31000":72815,"_21469":121115,"_5":14752,"_28187":72815,"_3059":121116},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3604":72817,"_31000":72815,"_5":31356,"_21469":121118,"_28187":121119,"_3059":121120},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3604":72818,"_31000":72815,"_5":31356,"_21469":121122,"_28187":121123,"_3059":121124},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3604":72819,"_31000":72815,"_21469":121126,"_5":14752,"_28187":72815,"_3059":121127},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3604":72820,"_31000":72815,"_21469":121129,"_5":14752,"_28187":121119,"_3059":121130},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3604":72821,"_31000":72815,"_21469":121132,"_5":14752,"_28187":121119,"_3059":121133},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3604":72822,"_31000":72815,"_21469":121135,"_5":14752,"_28187":121119,"_3059":121136},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3604":72823,"_31000":72815,"_21469":121138,"_5":14752,"_28187":121123,"_3059":121139},[],"Entidad (`schema_name.entity_type`)",{"_3604":72824,"_31000":72815,"_21469":121141,"_5":14752,"_28187":121123,"_3059":121142},[],"Tabla (`table_name`)",{"_3604":72825,"_31000":72815,"_21469":121144,"_5":14752,"_28187":121123,"_3059":121145},[],"Clave (`primary_key`)",{"_3604":72826,"_31000":72815,"_21469":121147,"_5":14752,"_28187":121123,"_3059":52223},[],{"_3604":72827,"_31000":72815,"_21469":121149,"_5":14752,"_28187":121123,"_3059":52226},[],{"_3604":72828,"_31000":72815,"_21469":121151,"_5":14752,"_28187":121123,"_3059":52229},[],{"_3604":72829,"_31000":72815,"_21469":121153,"_5":14752,"_28187":121123,"_3059":52232},[],{"_3604":72830,"_31000":72815,"_21469":121155,"_5":14752,"_28187":121123,"_3059":52235},[],{"_3604":72831,"_31000":72815,"_21469":121157,"_5":14752,"_28187":121123,"_3059":52238},[],{"_3604":72832,"_31000":72815,"_21469":121159,"_5":14752,"_28187":121123,"_3059":52241},[],{"_3604":72833,"_31000":72815,"_21469":121161,"_5":14752,"_28187":121123,"_3059":52244},[],{"_3604":72834,"_31000":72815,"_21469":121163,"_5":14752,"_28187":121123,"_3059":52238},[],{"_3604":72835,"_31000":72815,"_21469":121165,"_5":14752,"_28187":121123,"_3059":52249},[],{"_3604":72836,"_31000":72815,"_21469":121167,"_5":14752,"_28187":121123,"_3059":52252},[],{"_3604":72837,"_31000":72815,"_21469":121169,"_5":14752,"_28187":121123,"_3059":52255},[],{"_3604":72838,"_31000":72815,"_21469":121171,"_5":14752,"_28187":121123,"_3059":52258},[],{"_3604":72839,"_31000":72815,"_21469":121173,"_5":14752,"_28187":121123,"_3059":52261},[],{"_3604":72840,"_31000":72815,"_21469":121175,"_5":14752,"_28187":121123,"_3059":52238},[],{"_3604":72841,"_31000":72815,"_21469":121177,"_5":14752,"_28187":121123,"_3059":52266},[],{"_3604":72842,"_31000":72815,"_21469":121179,"_5":14752,"_28187":121123,"_3059":52269},[],{"_3604":72843,"_31000":72815,"_21469":121181,"_5":14752,"_28187":121123,"_3059":52238},[],{"_3604":72844,"_31000":72815,"_21469":121183,"_5":14752,"_28187":121123,"_3059":52274},[],{"_3604":72845,"_31000":72815,"_21469":121185,"_5":14752,"_28187":121123,"_3059":52277},[],{"_3604":72846,"_31000":72815,"_21469":121187,"_5":14752,"_28187":121123,"_3059":52238},[],{"_3604":72847,"_31000":72815,"_21469":121189,"_5":14752,"_28187":121123,"_3059":52282},[],{"_3604":72848,"_31000":72815,"_21469":121191,"_5":14752,"_28187":121123,"_3059":52285},[],{"_3604":72849,"_31000":72815,"_21469":121193,"_5":14752,"_28187":121123,"_3059":52238},[],{"_3604":72850,"_31000":72815,"_21469":121195,"_5":14752,"_28187":121123,"_3059":52290},[],{"_3604":72851,"_31000":72815,"_21469":121197,"_5":14752,"_28187":121123,"_3059":52293},[],{"_3604":72852,"_31000":72815,"_21469":121199,"_5":14752,"_28187":121123,"_3059":52296},[],{"_3604":72853,"_31000":72815,"_21469":121201,"_5":14752,"_28187":121123,"_3059":52299},[],{"_3604":72854,"_31000":72815,"_21469":121203,"_5":14752,"_28187":121123,"_3059":52302},[],{"_3604":72855,"_31000":72815,"_21469":121205,"_5":14752,"_28187":121123,"_3059":52305},[],{"_3604":72856,"_31000":72815,"_21469":121207,"_5":14752,"_28187":121123,"_3059":121208},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3604":72857,"_31000":72815,"_21469":121210,"_5":14752,"_28187":121123,"_3059":121211},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3604":72858,"_31000":72815,"_21469":121213,"_5":14752,"_28187":121123,"_3059":121214},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3604":72859,"_31000":72859,"_5":15112,"_3059":121216,"_31359":121217,"_21469":121218,"_28187":72859},"Visión general del control de acceso",[50673,121110,121111,121112],[],{"_3604":72860,"_31000":72859,"_21469":121220,"_5":14752,"_28187":72859,"_3059":121221},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3604":72861,"_31000":72859,"_5":31356,"_21469":121223,"_28187":121224,"_3059":121225},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3604":72862,"_31000":72859,"_5":31356,"_21469":121227,"_28187":121228,"_3059":121229},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3604":72863,"_31000":72859,"_5":31356,"_21469":121231,"_28187":121232,"_3059":121233},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3604":72864,"_31000":72859,"_5":31356,"_21469":121235,"_28187":121236,"_3059":121237},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3604":72865,"_31000":72859,"_5":31356,"_21469":121239,"_28187":121240,"_3059":121241},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3604":72866,"_31000":72859,"_5":31356,"_21469":121243,"_28187":121244,"_3059":121245},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3604":72867,"_31000":72859,"_5":31356,"_21469":121247,"_28187":121248,"_3059":121249},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3604":72868,"_31000":72859,"_5":31356,"_21469":121251,"_28187":121252,"_3059":121253},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3604":72869,"_31000":72859,"_5":31356,"_21469":121255,"_28187":121256,"_3059":121257},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3604":72870,"_31000":72859,"_5":31356,"_21469":121259,"_28187":121260,"_3059":121261},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3604":72871,"_31000":72859,"_5":31356,"_21469":121263,"_28187":121264,"_3059":121265},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3604":72872,"_31000":72859,"_5":31356,"_21469":121267,"_28187":121268,"_3059":121269},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3604":72873,"_31000":72859,"_5":31356,"_21469":121271,"_28187":121272,"_3059":121273},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3604":72874,"_31000":72859,"_5":31356,"_21469":121275,"_28187":121276,"_3059":121277},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3604":72875,"_31000":72859,"_5":31356,"_21469":121279,"_28187":121280,"_3059":121281},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3604":72876,"_31000":72859,"_5":31356,"_21469":121283,"_28187":121284,"_3059":120251},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3604":72877,"_31000":72859,"_5":31356,"_21469":121286,"_28187":121287,"_3059":121288},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3604":72878,"_31000":72859,"_5":31356,"_21469":121290,"_28187":121291,"_3059":121292},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3604":72879,"_31000":72859,"_5":31356,"_21469":121294,"_28187":121295,"_3059":121296},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3604":72880,"_31000":72859,"_5":31356,"_21469":121298,"_28187":121299,"_3059":121300},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3604":72881,"_31000":72859,"_5":31356,"_21469":121302,"_28187":121303,"_3059":121304},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3604":72882,"_31000":72859,"_5":31356,"_21469":121306,"_28187":121307,"_3059":121308},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3604":72883,"_31000":72859,"_5":31356,"_21469":121310,"_28187":121311,"_3059":121312},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3604":72884,"_31000":72859,"_5":31356,"_21469":121314,"_28187":121315,"_3059":121316},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3604":72885,"_31000":72859,"_5":31356,"_21469":121318,"_28187":121319,"_3059":121320},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3604":72886,"_31000":72859,"_5":31356,"_21469":121322,"_28187":121323,"_3059":121324},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3604":72887,"_31000":72859,"_5":31356,"_21469":121326,"_28187":121327,"_3059":121328},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3604":72888,"_31000":72859,"_5":31356,"_21469":121330,"_28187":121331,"_3059":121332},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3604":72889,"_31000":72859,"_5":31356,"_21469":121334,"_28187":121335,"_3059":121336},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3604":72890,"_31000":72859,"_5":31356,"_21469":121338,"_28187":121339,"_3059":121340},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3604":72891,"_31000":72859,"_5":31356,"_21469":121342,"_28187":121343,"_3059":121344},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3604":72892,"_31000":72859,"_21469":121346,"_5":14752,"_28187":72859,"_3059":121347},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3604":72893,"_31000":72859,"_21469":121349,"_5":14752,"_28187":72859,"_3059":121350},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3604":72894,"_31000":72859,"_21469":121352,"_5":14752,"_28187":72859,"_3059":121353},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3604":72895,"_31000":72859,"_21469":121355,"_5":14752,"_28187":121224,"_3059":121356},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3604":72896,"_31000":72859,"_21469":121358,"_5":14752,"_28187":121224,"_3059":121359},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3604":72897,"_31000":72859,"_21469":121361,"_5":14752,"_28187":121224,"_3059":121362},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3604":72898,"_31000":72859,"_21469":121364,"_5":14752,"_28187":121224,"_3059":121365},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3604":72899,"_31000":72859,"_21469":121367,"_5":14752,"_28187":121224,"_3059":121368},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3604":72900,"_31000":72859,"_21469":121370,"_5":14752,"_28187":121224,"_3059":121371},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3604":72901,"_31000":72859,"_21469":121373,"_5":14752,"_28187":121228,"_3059":121374},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3604":72902,"_31000":72859,"_21469":121376,"_5":14752,"_28187":121228,"_3059":121377},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3604":72903,"_31000":72859,"_21469":121379,"_5":14752,"_28187":121232,"_3059":121380},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3604":72904,"_31000":72859,"_21469":121382,"_5":14752,"_28187":121232,"_3059":121383},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3604":72905,"_31000":72859,"_21469":121385,"_5":14752,"_28187":121232,"_3059":121386},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3604":72906,"_31000":72859,"_21469":121388,"_5":14752,"_28187":121232,"_3059":121389},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3604":72907,"_31000":72859,"_21469":121391,"_5":14752,"_28187":121232,"_3059":121392},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3604":72908,"_31000":72859,"_21469":121394,"_5":14752,"_28187":121232,"_3059":121395},[],"Carga por separado las políticas concedidas a cada principal.",{"_3604":72909,"_31000":72859,"_21469":121397,"_5":14752,"_28187":121232,"_3059":121398},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3604":72910,"_31000":72859,"_21469":121400,"_5":14752,"_28187":121232,"_3059":121401},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3604":72911,"_31000":72859,"_21469":121403,"_5":14752,"_28187":121232,"_3059":121404},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3604":72912,"_31000":72859,"_21469":121406,"_5":14752,"_28187":121232,"_3059":121407},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3604":72913,"_31000":72859,"_21469":121409,"_5":14752,"_28187":121232,"_3059":121410},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3604":72914,"_31000":72859,"_21469":121412,"_5":14752,"_28187":121232,"_3059":121413},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3604":72915,"_31000":72859,"_21469":121415,"_5":14752,"_28187":121236,"_3059":121416},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3604":72916,"_31000":72859,"_21469":121418,"_5":14752,"_28187":121236,"_3059":121419},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3604":72917,"_31000":72859,"_21469":121421,"_5":14752,"_28187":121236,"_3059":121422},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3604":72918,"_31000":72859,"_21469":121424,"_5":14752,"_28187":121236,"_3059":121425},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3604":72919,"_31000":72859,"_21469":121427,"_5":14752,"_28187":121236,"_3059":121428},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3604":72920,"_31000":72859,"_21469":121430,"_5":14752,"_28187":121236,"_3059":121431},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3604":72921,"_31000":72859,"_21469":121433,"_5":14752,"_28187":121236,"_3059":121434},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3604":72922,"_31000":72859,"_21469":121436,"_5":14752,"_28187":121236,"_3059":121437},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3604":72923,"_31000":72859,"_21469":121439,"_5":14752,"_28187":121236,"_3059":121440},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3604":72924,"_31000":72859,"_21469":121442,"_5":14752,"_28187":121236,"_3059":121443},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3604":72925,"_31000":72859,"_21469":121445,"_5":14752,"_28187":121240,"_3059":121446},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3604":72926,"_31000":72859,"_21469":121448,"_5":14752,"_28187":121240,"_3059":121449},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3604":72927,"_31000":72859,"_21469":121451,"_5":14752,"_28187":121240,"_3059":121452},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3604":72928,"_31000":72859,"_21469":121454,"_5":14752,"_28187":121240,"_3059":121455},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3604":72929,"_31000":72859,"_21469":121457,"_5":14752,"_28187":121240,"_3059":121458},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3604":72930,"_31000":72859,"_21469":121460,"_5":14752,"_28187":121240,"_3059":121461},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3604":72931,"_31000":72859,"_21469":121463,"_5":14752,"_28187":121240,"_3059":121464},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3604":72932,"_31000":72859,"_21469":121466,"_5":14752,"_28187":121240,"_3059":121467},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3604":72933,"_31000":72859,"_21469":121469,"_5":14752,"_28187":121240,"_3059":121470},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3604":72934,"_31000":72859,"_21469":121472,"_5":14752,"_28187":121240,"_3059":121473},[],"Las acciones se dividen en dos grupos:",{"_3604":72935,"_31000":72859,"_21469":121475,"_5":14752,"_28187":121240,"_3059":121476},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3604":72936,"_31000":72859,"_21469":121478,"_5":14752,"_28187":121240,"_3059":121479},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3604":72937,"_31000":72859,"_21469":121481,"_5":14752,"_28187":121240,"_3059":121482},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3604":72938,"_31000":72859,"_21469":121484,"_5":14752,"_28187":121244,"_3059":121485},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3604":72939,"_31000":72859,"_21469":121487,"_5":14752,"_28187":121244,"_3059":121488},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3604":72940,"_31000":72859,"_21469":121490,"_5":14752,"_28187":121244,"_3059":121491},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3604":72941,"_31000":72859,"_21469":121493,"_5":14752,"_28187":121248,"_3059":121494},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3604":72942,"_31000":72859,"_21469":121496,"_5":14752,"_28187":121248,"_3059":121497},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3604":72943,"_31000":72859,"_21469":121499,"_5":14752,"_28187":121248,"_3059":121500},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3604":72944,"_31000":72859,"_21469":121502,"_5":14752,"_28187":121248,"_3059":121503},[],"Los operadores implementados son:",{"_3604":72945,"_31000":72859,"_21469":121505,"_5":14752,"_28187":121248,"_3059":121506},[],"`equals`, para igualdad exacta;",{"_3604":72946,"_31000":72859,"_21469":121508,"_5":14752,"_28187":121248,"_3059":121509},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3604":72947,"_31000":72859,"_21469":121511,"_5":14752,"_28187":121248,"_3059":121512},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3604":72948,"_31000":72859,"_21469":121514,"_5":14752,"_28187":121248,"_3059":121515},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3604":72949,"_31000":72859,"_21469":121517,"_5":14752,"_28187":121252,"_3059":121518},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3604":72950,"_31000":72859,"_21469":121520,"_5":14752,"_28187":121252,"_3059":121521},[],"Los modos disponibles son:",{"_3604":72951,"_31000":72859,"_21469":121523,"_5":14752,"_28187":121252,"_3059":121524},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3604":72952,"_31000":72859,"_21469":121526,"_5":14752,"_28187":121252,"_3059":121527},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3604":72953,"_31000":72859,"_21469":121529,"_5":14752,"_28187":121252,"_3059":121530},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3604":72954,"_31000":72859,"_21469":121532,"_5":14752,"_28187":121252,"_3059":121533},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3604":72955,"_31000":72859,"_21469":121535,"_5":14752,"_28187":121252,"_3059":121536},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3604":72956,"_31000":72859,"_21469":121538,"_5":14752,"_28187":121252,"_3059":121539},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3604":72957,"_31000":72859,"_21469":121541,"_5":14752,"_28187":121256,"_3059":121542},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3604":72958,"_31000":72859,"_21469":121544,"_5":14752,"_28187":121256,"_3059":121545},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3604":72959,"_31000":72859,"_21469":121547,"_5":14752,"_28187":121256,"_3059":121548},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3604":72960,"_31000":72859,"_21469":121550,"_5":14752,"_28187":121256,"_3059":121551},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3604":72961,"_31000":72859,"_21469":121553,"_5":14752,"_28187":121264,"_3059":121554},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3604":72962,"_31000":72859,"_21469":121556,"_5":14752,"_28187":121264,"_3059":121557},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3604":72963,"_31000":72859,"_21469":121559,"_5":14752,"_28187":121268,"_3059":121560},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3604":72964,"_31000":72859,"_21469":121562,"_5":14752,"_28187":121268,"_3059":121563},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3604":72965,"_31000":72859,"_21469":121565,"_5":14752,"_28187":121268,"_3059":121566},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3604":72966,"_31000":72859,"_21469":121568,"_5":14752,"_28187":121268,"_3059":121569},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3604":72967,"_31000":72859,"_21469":121571,"_5":14752,"_28187":121268,"_3059":121572},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3604":72968,"_31000":72859,"_21469":121574,"_5":14752,"_28187":121272,"_3059":121575},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3604":72969,"_31000":72859,"_21469":121577,"_5":14752,"_28187":121272,"_3059":121578},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3604":72970,"_31000":72859,"_21469":121580,"_5":14752,"_28187":121272,"_3059":121581},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3604":72971,"_31000":72859,"_21469":121583,"_5":14752,"_28187":121276,"_3059":121584},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3604":72972,"_31000":72859,"_21469":121586,"_5":14752,"_28187":121276,"_3059":121587},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3604":72973,"_31000":72859,"_21469":121589,"_5":14752,"_28187":121276,"_3059":121590},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3604":72974,"_31000":72859,"_21469":121592,"_5":14752,"_28187":121276,"_3059":121593},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3604":72975,"_31000":72859,"_21469":121595,"_5":14752,"_28187":121276,"_3059":121596},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3604":72976,"_31000":72859,"_21469":121598,"_5":14752,"_28187":121276,"_3059":121599},[],"Ten en cuenta que:",{"_3604":72977,"_31000":72859,"_21469":121601,"_5":14752,"_28187":121276,"_3059":121602},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3604":72978,"_31000":72859,"_21469":121604,"_5":14752,"_28187":121276,"_3059":121605},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3604":72979,"_31000":72859,"_21469":121607,"_5":14752,"_28187":121276,"_3059":121608},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3604":72980,"_31000":72859,"_21469":121610,"_5":14752,"_28187":121280,"_3059":121611},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3604":72981,"_31000":72859,"_21469":121613,"_5":14752,"_28187":121280,"_3059":121614},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3604":72982,"_31000":72859,"_21469":121616,"_5":14752,"_28187":121280,"_3059":121617},[],"acceso completo y de solo lectura a KMS;",{"_3604":72983,"_31000":72859,"_21469":121619,"_5":14752,"_28187":121280,"_3059":121620},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3604":72984,"_31000":72859,"_21469":121622,"_5":14752,"_28187":121280,"_3059":121623},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3604":72985,"_31000":72859,"_21469":121625,"_5":14752,"_28187":121280,"_3059":121626},[],"acceso a la interfaz;",{"_3604":72986,"_31000":72859,"_21469":121628,"_5":14752,"_28187":121280,"_3059":121629},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3604":72987,"_31000":72859,"_21469":121631,"_5":14752,"_28187":121280,"_3059":121632},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3604":72988,"_31000":72859,"_21469":121634,"_5":14752,"_28187":121280,"_3059":121635},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3604":72989,"_31000":72859,"_21469":121637,"_5":14752,"_28187":121280,"_3059":121638},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3604":72990,"_31000":72859,"_21469":121640,"_5":14752,"_28187":121280,"_3059":121641},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3604":72991,"_31000":72859,"_21469":121643,"_5":14752,"_28187":121284,"_3059":121644},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3604":72992,"_31000":72859,"_21469":121646,"_5":14752,"_28187":121284,"_3059":121647},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3604":72993,"_31000":72859,"_21469":121649,"_5":14752,"_28187":121284,"_3059":121650},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3604":72994,"_31000":72859,"_21469":121652,"_5":14752,"_28187":121287,"_3059":121653},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3604":72995,"_31000":72859,"_21469":121655,"_5":14752,"_28187":121291,"_3059":121656},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3604":72996,"_31000":72859,"_21469":121658,"_5":14752,"_28187":121291,"_3059":121659},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3604":72997,"_31000":72859,"_21469":121661,"_5":14752,"_28187":121295,"_3059":121662},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3604":72998,"_31000":72859,"_21469":121664,"_5":14752,"_28187":121299,"_3059":121665},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3604":72999,"_31000":72859,"_21469":121667,"_5":14752,"_28187":121303,"_3059":121668},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3604":73000,"_31000":72859,"_21469":121670,"_5":14752,"_28187":121307,"_3059":121671},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3604":73001,"_31000":72859,"_21469":121673,"_5":14752,"_28187":121307,"_3059":121674},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3604":73002,"_31000":72859,"_21469":121676,"_5":14752,"_28187":121311,"_3059":121677},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3604":73003,"_31000":72859,"_21469":121679,"_5":14752,"_28187":121311,"_3059":121680},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3604":73004,"_31000":72859,"_21469":121682,"_5":14752,"_28187":121311,"_3059":121683},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3604":73005,"_31000":72859,"_21469":121685,"_5":14752,"_28187":121311,"_3059":121686},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3604":73006,"_31000":72859,"_21469":121688,"_5":14752,"_28187":121311,"_3059":121689},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3604":73007,"_31000":72859,"_21469":121691,"_5":14752,"_28187":121311,"_3059":121692},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3604":73008,"_31000":72859,"_21469":121694,"_5":14752,"_28187":121311,"_3059":121695},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3604":73009,"_31000":72859,"_21469":121697,"_5":14752,"_28187":121311,"_3059":121698},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3604":73010,"_31000":72859,"_21469":121700,"_5":14752,"_28187":121315,"_3059":121701},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3604":73011,"_31000":72859,"_21469":121703,"_5":14752,"_28187":121315,"_3059":121704},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3604":73012,"_31000":72859,"_21469":121706,"_5":14752,"_28187":121315,"_3059":121707},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3604":73013,"_31000":72859,"_21469":121709,"_5":14752,"_28187":121319,"_3059":121710},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3604":73014,"_31000":72859,"_21469":121712,"_5":14752,"_28187":121319,"_3059":121713},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3604":73015,"_31000":72859,"_21469":121715,"_5":14752,"_28187":121319,"_3059":121716},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3604":73016,"_31000":72859,"_21469":121718,"_5":14752,"_28187":121319,"_3059":121719},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3604":73017,"_31000":72859,"_21469":121721,"_5":14752,"_28187":121319,"_3059":121722},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3604":73018,"_31000":72859,"_21469":121724,"_5":14752,"_28187":121319,"_3059":121725},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3604":73019,"_31000":72859,"_21469":121727,"_5":14752,"_28187":121319,"_3059":121728},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3604":73020,"_31000":72859,"_21469":121730,"_5":14752,"_28187":121319,"_3059":121731},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3604":73021,"_31000":72859,"_21469":121733,"_5":14752,"_28187":121327,"_3059":121734},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3604":73022,"_31000":72859,"_21469":121736,"_5":14752,"_28187":121331,"_3059":121737},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3604":73023,"_31000":72859,"_21469":121739,"_5":14752,"_28187":121331,"_3059":121740},[],"que exista un principal activo del tipo correcto;",{"_3604":73024,"_31000":72859,"_21469":121742,"_5":14752,"_28187":121331,"_3059":121743},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3604":73025,"_31000":72859,"_21469":121745,"_5":14752,"_28187":121331,"_3059":121746},[],"que todas las condiciones del principal se cumplan;",{"_3604":73026,"_31000":72859,"_21469":121748,"_5":14752,"_28187":121331,"_3059":121749},[],"que el principal tenga concedida la política esperada;",{"_3604":73027,"_31000":72859,"_21469":121751,"_5":14752,"_28187":121331,"_3059":121752},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3604":73028,"_31000":72859,"_21469":121754,"_5":14752,"_28187":121331,"_3059":121755},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3604":73029,"_31000":72859,"_21469":121757,"_5":14752,"_28187":121331,"_3059":121758},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3604":73030,"_31000":72859,"_21469":121760,"_5":14752,"_28187":121331,"_3059":121761},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3604":73031,"_31000":72859,"_21469":121763,"_5":14752,"_28187":121335,"_3059":121764},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3604":73032,"_31000":72859,"_21469":121766,"_5":14752,"_28187":121339,"_3059":121767},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3604":73033,"_31000":72859,"_21469":121769,"_5":14752,"_28187":121343,"_3059":121770},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3604":73034,"_31000":72859,"_21469":121772,"_5":14752,"_28187":121343,"_3059":121773},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3604":73035,"_31000":73035,"_5":15112,"_3059":121775,"_31359":121776,"_21469":121777,"_28187":73035},"Alertas y suscripciones",[50673,121110,121111],[],{"_3604":73036,"_31000":73035,"_21469":121779,"_5":14752,"_28187":73035,"_3059":121780},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3604":73037,"_31000":73035,"_5":31356,"_21469":121782,"_28187":121783,"_3059":121784},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3604":73038,"_31000":73035,"_5":31356,"_21469":121786,"_28187":121787,"_3059":121788},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3604":73039,"_31000":73035,"_5":31356,"_21469":121790,"_28187":121791,"_3059":121792},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3604":73040,"_31000":73035,"_5":31356,"_21469":121794,"_28187":121795,"_3059":121796},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3604":73041,"_31000":73035,"_5":31356,"_21469":121798,"_28187":121799,"_3059":121800},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3604":73042,"_31000":73035,"_5":31356,"_21469":121802,"_28187":121803,"_3059":121804},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3604":73043,"_31000":73035,"_5":31356,"_21469":121806,"_28187":121807,"_3059":121808},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3604":73044,"_31000":73035,"_5":31356,"_21469":121810,"_28187":121811,"_3059":121812},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3604":73045,"_31000":73035,"_5":31356,"_21469":121814,"_28187":121815,"_3059":121816},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3604":73046,"_31000":73035,"_5":31356,"_21469":121818,"_28187":121819,"_3059":121820},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3604":73047,"_31000":73035,"_5":31356,"_21469":121822,"_28187":121823,"_3059":121824},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3604":73048,"_31000":73035,"_21469":121826,"_5":14752,"_28187":73035,"_3059":121827},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3604":73049,"_31000":73035,"_21469":121829,"_5":14752,"_28187":121783,"_3059":121830},[],"Un servicio publica un evento de dominio.",{"_3604":73050,"_31000":73035,"_21469":121832,"_5":14752,"_28187":121783,"_3059":121833},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3604":73051,"_31000":73035,"_21469":121835,"_5":14752,"_28187":121783,"_3059":121836},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3604":73052,"_31000":73035,"_21469":121838,"_5":14752,"_28187":121783,"_3059":121839},[],"Lamassu entrega el evento al canal configurado.",{"_3604":73053,"_31000":73035,"_21469":121841,"_5":14752,"_28187":121783,"_3059":121842},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3604":73054,"_31000":73035,"_21469":121844,"_5":14752,"_28187":121787,"_3059":121845},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3604":73055,"_31000":73035,"_21469":121847,"_5":14752,"_28187":121787,"_3059":121848},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3604":73056,"_31000":73035,"_21469":121850,"_5":14752,"_28187":121787,"_3059":121851},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3604":73057,"_31000":73035,"_21469":121853,"_5":14752,"_28187":121787,"_3059":121854},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3604":73058,"_31000":73035,"_21469":121856,"_5":14752,"_28187":121787,"_3059":121857},[],"`apikey_options` necesita `header` y `key`.",{"_3604":73059,"_31000":73035,"_21469":121859,"_5":14752,"_28187":121787,"_3059":121860},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3604":73060,"_31000":73035,"_21469":121862,"_5":14752,"_28187":121787,"_3059":121863},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3604":73061,"_31000":73035,"_21469":121865,"_5":14752,"_28187":121787,"_3059":121866},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3604":73062,"_31000":73035,"_21469":121868,"_5":14752,"_28187":121795,"_3059":121869},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3604":73063,"_31000":73035,"_21469":121871,"_5":14752,"_28187":121799,"_3059":121872},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3604":73064,"_31000":73035,"_21469":121874,"_5":14752,"_28187":121803,"_3059":121875},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3604":73065,"_31000":73035,"_21469":121877,"_5":14752,"_28187":121803,"_3059":121878},[],"**None** notifica todas las instancias del evento.",{"_3604":73066,"_31000":73035,"_21469":121880,"_5":14752,"_28187":121803,"_3059":121881},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3604":73067,"_31000":73035,"_21469":121883,"_5":14752,"_28187":121803,"_3059":121884},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3604":73068,"_31000":73035,"_21469":121886,"_5":14752,"_28187":121803,"_3059":121887},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3604":73069,"_31000":73035,"_21469":121889,"_5":14752,"_28187":121803,"_3059":121890},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3604":73070,"_31000":73035,"_21469":121892,"_5":14752,"_28187":121803,"_3059":121893},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3604":73071,"_31000":73035,"_21469":121895,"_5":14752,"_28187":121807,"_3059":121896},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3604":73072,"_31000":73035,"_21469":121898,"_5":14752,"_28187":121811,"_3059":121899},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3604":73073,"_31000":73035,"_21469":121901,"_5":14752,"_28187":121811,"_3059":121902},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3604":73074,"_31000":73035,"_21469":121904,"_5":14752,"_28187":121811,"_3059":121905},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3604":73075,"_31000":73035,"_21469":121907,"_5":14752,"_28187":121811,"_3059":121908},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3604":73076,"_31000":73035,"_21469":121910,"_5":14752,"_28187":121811,"_3059":121911},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3604":73077,"_31000":73035,"_21469":121913,"_5":14752,"_28187":121811,"_3059":121914},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3604":73078,"_31000":73035,"_21469":121916,"_5":14752,"_28187":121811,"_3059":121917},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3604":73079,"_31000":73035,"_21469":121919,"_5":14752,"_28187":121811,"_3059":121920},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3604":73080,"_31000":73035,"_21469":121922,"_5":14752,"_28187":121815,"_3059":121923},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3604":73081,"_31000":73035,"_21469":121925,"_5":14752,"_28187":121815,"_3059":121926},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3604":73082,"_31000":73035,"_21469":121928,"_5":14752,"_28187":121815,"_3059":121929},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3604":73083,"_31000":73035,"_21469":121931,"_5":14752,"_28187":121815,"_3059":121932},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3604":73084,"_31000":73035,"_21469":121934,"_5":14752,"_28187":121815,"_3059":121935},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3604":73085,"_31000":73035,"_21469":121937,"_5":14752,"_28187":121815,"_3059":121938},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3604":73086,"_31000":73035,"_21469":121940,"_5":14752,"_28187":121815,"_3059":121941},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3604":73087,"_31000":73035,"_21469":121943,"_5":14752,"_28187":121815,"_3059":121944},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3604":73088,"_31000":73035,"_21469":121946,"_5":14752,"_28187":121819,"_3059":121947},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3604":73089,"_31000":73035,"_21469":121949,"_5":14752,"_28187":121819,"_3059":121950},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3604":73090,"_31000":73035,"_21469":121952,"_5":14752,"_28187":121823,"_3059":121953},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3604":73091,"_31000":73035,"_21469":121955,"_5":14752,"_28187":121823,"_3059":121956},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3604":73092,"_31000":73035,"_21469":121958,"_5":14752,"_28187":121823,"_3059":121959},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3604":73093,"_31000":73035,"_21469":121961,"_5":14752,"_28187":121823,"_3059":121962},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3604":73094,"_31000":73035,"_21469":121964,"_5":14752,"_28187":121823,"_3059":121965},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3604":73095,"_31000":73035,"_21469":121967,"_5":14752,"_28187":121823,"_3059":121968},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3604":73096,"_31000":73035,"_21469":121970,"_5":14752,"_28187":121823,"_3059":121971},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3604":73097,"_31000":73035,"_21469":121973,"_5":14752,"_28187":121823,"_3059":121974},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3604":73098,"_31000":73035,"_21469":121976,"_5":14752,"_28187":121823,"_3059":121977},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3604":73099,"_31000":73035,"_21469":121979,"_5":14752,"_28187":121823,"_3059":121980},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3604":73100,"_31000":73100,"_5":15112,"_3059":121982,"_31359":121983,"_21469":121984,"_28187":73100},"Registros de auditoría",[50673,121110,121111],[],{"_3604":73101,"_31000":73100,"_21469":121986,"_5":14752,"_28187":73100,"_3059":121987},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3604":73102,"_31000":73100,"_5":31356,"_21469":121989,"_28187":121990,"_3059":121991},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3604":73103,"_31000":73100,"_5":31356,"_21469":121993,"_28187":121994,"_3059":121995},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3604":73104,"_31000":73100,"_5":31356,"_21469":121997,"_28187":121998,"_3059":121999},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3604":73105,"_31000":73100,"_5":31356,"_21469":122001,"_28187":122002,"_3059":122003},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3604":73106,"_31000":73100,"_5":31356,"_21469":122005,"_28187":122006,"_3059":122007},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3604":73107,"_31000":73100,"_5":31356,"_21469":122009,"_28187":122010,"_3059":122011},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3604":73108,"_31000":73100,"_5":31356,"_21469":122013,"_28187":122014,"_3059":122015},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3604":73109,"_31000":73100,"_5":31356,"_21469":122017,"_28187":122018,"_3059":122019},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3604":73110,"_31000":73100,"_5":31356,"_21469":122021,"_28187":122022,"_3059":122023},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3604":73111,"_31000":73100,"_5":31356,"_21469":122025,"_28187":122026,"_3059":122027},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3604":73112,"_31000":73100,"_5":31356,"_21469":122029,"_28187":122030,"_3059":122031},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3604":73113,"_31000":73100,"_21469":122033,"_5":14752,"_28187":73100,"_3059":122034},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3604":73114,"_31000":73100,"_21469":122036,"_5":14752,"_28187":121990,"_3059":122037},[],"El cuerpo de auditoría incluye:",{"_3604":73115,"_31000":73100,"_21469":122039,"_5":14752,"_28187":121990,"_3059":122040},[],"input: datos recibidos por la operación;",{"_3604":73116,"_31000":73100,"_21469":122042,"_5":14752,"_28187":121990,"_3059":122043},[],"has\\_error: indica si el servicio devolvió un error;",{"_3604":73117,"_31000":73100,"_21469":122045,"_5":14752,"_28187":121990,"_3059":122046},[],"output: resultado producido o mensaje de error;",{"_3604":73118,"_31000":73100,"_21469":122048,"_5":14752,"_28187":121990,"_3059":122049},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3604":73119,"_31000":73100,"_21469":122051,"_5":14752,"_28187":121990,"_3059":122052},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3604":73120,"_31000":73100,"_21469":122054,"_5":14752,"_28187":121990,"_3059":122055},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3604":73121,"_31000":73100,"_21469":122057,"_5":14752,"_28187":121994,"_3059":122058},[],"El backend aplica auditoría a mutaciones de:",{"_3604":73122,"_31000":73100,"_21469":122060,"_5":14752,"_28187":121994,"_3059":122061},[],"autoridades, certificados y perfiles de emisión;",{"_3604":73123,"_31000":73100,"_21469":122063,"_5":14752,"_28187":121994,"_3059":122064},[],"claves y motores KMS;",{"_3604":73124,"_31000":73100,"_21469":122066,"_5":14752,"_28187":121994,"_3059":122067},[],"dispositivos e identidades;",{"_3604":73125,"_31000":73100,"_21469":122069,"_5":14752,"_28187":121994,"_3059":122070},[],"DMS y operaciones de enrolamiento;",{"_3604":73126,"_31000":73100,"_21469":122072,"_5":14752,"_28187":121994,"_3059":122073},[],"funciones de validación y CRL;",{"_3604":73127,"_31000":73100,"_21469":122075,"_5":14752,"_28187":121994,"_3059":122076},[],"principales, políticas y concesiones de autorización.",{"_3604":73128,"_31000":73100,"_21469":122078,"_5":14752,"_28187":121994,"_3059":122079},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3604":73129,"_31000":73100,"_21469":122081,"_5":14752,"_28187":121998,"_3059":122082},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3604":73130,"_31000":73100,"_21469":122084,"_5":14752,"_28187":121998,"_3059":122085},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3604":73131,"_31000":73100,"_21469":122087,"_5":14752,"_28187":121998,"_3059":122088},[],"Diseña el consumidor para:",{"_3604":73132,"_31000":73100,"_21469":122090,"_5":14752,"_28187":121998,"_3059":122091},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3604":73133,"_31000":73100,"_21469":122093,"_5":14752,"_28187":121998,"_3059":122094},[],"conservar el CloudEvent completo sin modificar;",{"_3604":73134,"_31000":73100,"_21469":122096,"_5":14752,"_28187":121998,"_3059":122097},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3604":73135,"_31000":73100,"_21469":122099,"_5":14752,"_28187":121998,"_3059":122100},[],"cifrar en tránsito y en reposo;",{"_3604":73136,"_31000":73100,"_21469":122102,"_5":14752,"_28187":121998,"_3059":122103},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3604":73137,"_31000":73100,"_21469":122105,"_5":14752,"_28187":121998,"_3059":122106},[],"aplicar una política explícita de retención y legal hold;",{"_3604":73138,"_31000":73100,"_21469":122108,"_5":14752,"_28187":121998,"_3059":122109},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3604":73139,"_31000":73100,"_21469":122111,"_5":14752,"_28187":122002,"_3059":122112},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3604":73140,"_31000":73100,"_21469":122114,"_5":14752,"_28187":122002,"_3059":122115},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3604":73141,"_31000":73100,"_21469":122117,"_5":14752,"_28187":122010,"_3059":122118},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3604":73142,"_31000":73100,"_21469":122120,"_5":14752,"_28187":122014,"_3059":122121},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3604":73143,"_31000":73100,"_21469":122123,"_5":14752,"_28187":122018,"_3059":122124},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3604":73144,"_31000":73100,"_21469":122126,"_5":14752,"_28187":122022,"_3059":122127},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3604":73145,"_31000":73100,"_21469":122129,"_5":14752,"_28187":122026,"_3059":122130},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3604":73146,"_31000":73100,"_21469":122132,"_5":14752,"_28187":122030,"_3059":122133},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3604":73147,"_31000":73100,"_21469":122135,"_5":14752,"_28187":122030,"_3059":122136},[],"aparece un evento de auditoría correcto;",{"_3604":73148,"_31000":73100,"_21469":122138,"_5":14752,"_28187":122030,"_3059":122139},[],"el principal coincide con la identidad utilizada;",{"_3604":73149,"_31000":73100,"_21469":122141,"_5":14752,"_28187":122030,"_3059":122142},[],"el consumidor lo persiste una sola vez;",{"_3604":73150,"_31000":73100,"_21469":122144,"_5":14752,"_28187":122030,"_3059":122145},[],"puede recuperarse por recurso, actor y periodo;",{"_3604":73151,"_31000":73100,"_21469":122147,"_5":14752,"_28187":122030,"_3059":122148},[],"una interrupción del consumidor produce una alerta.",{"_3604":73152,"_31000":73100,"_21469":122150,"_5":14752,"_28187":122030,"_3059":122151},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3604":73153,"_31000":73153,"_5":15112,"_3059":122153,"_31359":122154,"_21469":122155,"_28187":73153},"Arquitectura de la plataforma",[50673,121110],[],{"_3604":73154,"_31000":73153,"_21469":122157,"_5":14752,"_28187":73153,"_3059":122158},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3604":73155,"_31000":73153,"_5":31356,"_21469":122160,"_28187":122161,"_3059":122162},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3604":73156,"_31000":73153,"_5":31356,"_21469":122164,"_28187":122165,"_3059":122166},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3604":73157,"_31000":73153,"_5":31356,"_21469":122168,"_28187":122169,"_3059":122170},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3604":73158,"_31000":73153,"_5":31356,"_21469":122172,"_28187":122173,"_3059":122174},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3604":73159,"_31000":73153,"_5":31356,"_21469":122176,"_28187":122177,"_3059":122178},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3604":73160,"_31000":73153,"_21469":122180,"_5":14752,"_28187":73153,"_3059":122181},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3604":73161,"_31000":73153,"_21469":122183,"_5":14752,"_28187":73153,"_3059":122184},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3604":73162,"_31000":73153,"_21469":122186,"_5":14752,"_28187":122161,"_3059":122187},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3604":73163,"_31000":73153,"_21469":122189,"_5":14752,"_28187":122165,"_3059":122190},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3604":73164,"_31000":73153,"_21469":122192,"_5":14752,"_28187":122169,"_3059":122193},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3604":73165,"_31000":73153,"_21469":122195,"_5":14752,"_28187":122173,"_3059":122196},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3604":73166,"_31000":73153,"_21469":122198,"_5":14752,"_28187":122177,"_3059":122199},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3604":73167,"_31000":73167,"_5":15112,"_3059":122201,"_31359":122202,"_21469":122203,"_28187":73167},"Cómo funciona Lamassu",[50673,121110],[],{"_3604":73168,"_31000":73167,"_21469":122205,"_5":14752,"_28187":73167,"_3059":122206},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3604":73169,"_31000":73167,"_5":31356,"_21469":122208,"_28187":122209,"_3059":122210},[],"/docs/pr-preview/pr-75/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3604":73170,"_31000":73167,"_5":31356,"_21469":122212,"_28187":122213,"_3059":122214},[],"/docs/pr-preview/pr-75/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3604":73171,"_31000":73167,"_21469":122216,"_5":14752,"_28187":73167,"_3059":122217},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3604":73172,"_31000":73167,"_21469":122219,"_5":14752,"_28187":122209,"_3059":122220},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3604":73173,"_31000":73167,"_21469":122222,"_5":14752,"_28187":122209,"_3059":122223},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3604":73174,"_31000":73167,"_21469":122225,"_5":14752,"_28187":122209,"_3059":122226},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3604":73175,"_31000":73167,"_21469":122228,"_5":14752,"_28187":122209,"_3059":122229},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3604":73176,"_31000":73167,"_21469":122231,"_5":14752,"_28187":122209,"_3059":122232},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3604":73177,"_31000":73167,"_21469":122234,"_5":14752,"_28187":122213,"_3059":122235},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3604":73178,"_31000":73167,"_21469":122237,"_5":14752,"_28187":122213,"_3059":122238},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3604":73179,"_31000":73167,"_21469":122240,"_5":14752,"_28187":122213,"_3059":122241},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3604":73180,"_31000":73167,"_21469":122243,"_5":14752,"_28187":122213,"_3059":122244},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3604":73181,"_31000":73167,"_21469":122246,"_5":14752,"_28187":122213,"_3059":122247},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3604":73182,"_31000":73167,"_21469":122249,"_5":14752,"_28187":122213,"_3059":122250},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3604":73183,"_31000":73167,"_21469":122252,"_5":14752,"_28187":122213,"_3059":122253},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3604":73184,"_31000":73184,"_5":15112,"_3059":122255,"_31359":122256,"_21469":122257,"_28187":73184},"Dispositivos e identidades",[50673,121110,53357,122255],[],{"_3604":73185,"_31000":73184,"_21469":122259,"_5":14752,"_28187":73184,"_3059":122260},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3604":73186,"_31000":73184,"_5":31356,"_21469":122262,"_28187":122263,"_3059":122264},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3604":73187,"_31000":73184,"_5":31356,"_21469":122266,"_28187":122267,"_3059":122268},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3604":73188,"_31000":73184,"_5":31356,"_21469":122270,"_28187":122271,"_3059":122272},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3604":73189,"_31000":73184,"_5":31356,"_21469":122274,"_28187":122275,"_3059":122276},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3604":73190,"_31000":73184,"_5":31356,"_21469":122278,"_28187":122279,"_3059":122280},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3604":73191,"_31000":73184,"_5":31356,"_21469":122282,"_28187":122283,"_3059":122284},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3604":73192,"_31000":73184,"_5":31356,"_21469":122286,"_28187":122287,"_3059":122288},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3604":73193,"_31000":73184,"_5":31356,"_21469":122290,"_28187":122291,"_3059":122292},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3604":73194,"_31000":73184,"_5":31356,"_21469":122294,"_28187":122295,"_3059":122296},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3604":73195,"_31000":73184,"_5":31356,"_21469":122298,"_28187":122299,"_3059":122300},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3604":73196,"_31000":73184,"_5":31356,"_21469":122302,"_28187":122303,"_3059":122304},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3604":73197,"_31000":73184,"_21469":122306,"_5":14752,"_28187":73184,"_3059":122307},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3604":73198,"_31000":73184,"_21469":122309,"_5":14752,"_28187":73184,"_3059":122310},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3604":73199,"_31000":73184,"_21469":122312,"_5":14752,"_28187":122263,"_3059":122313},[],"Vista operativa",{"_3604":73200,"_31000":73184,"_21469":122315,"_5":14752,"_28187":122263,"_3059":122316},[],"Interpretación",{"_3604":73201,"_31000":73184,"_21469":122318,"_5":14752,"_28187":122263,"_3059":53420},[],{"_3604":73202,"_31000":73184,"_21469":122320,"_5":14752,"_28187":122263,"_3059":122321},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3604":73203,"_31000":73184,"_21469":122323,"_5":14752,"_28187":122263,"_3059":53426},[],{"_3604":73204,"_31000":73184,"_21469":122325,"_5":14752,"_28187":122263,"_3059":122326},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3604":73205,"_31000":73184,"_21469":122328,"_5":14752,"_28187":122263,"_3059":53432},[],{"_3604":73206,"_31000":73184,"_21469":122330,"_5":14752,"_28187":122263,"_3059":122331},[],"La identidad está en la ventana operativa de renovación.",{"_3604":73207,"_31000":73184,"_21469":122333,"_5":14752,"_28187":122263,"_3059":53438},[],{"_3604":73208,"_31000":73184,"_21469":122335,"_5":14752,"_28187":122263,"_3059":122336},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3604":73209,"_31000":73184,"_21469":122338,"_5":14752,"_28187":122263,"_3059":53444},[],{"_3604":73210,"_31000":73184,"_21469":122340,"_5":14752,"_28187":122263,"_3059":122341},[],"La identidad ha vencido.",{"_3604":73211,"_31000":73184,"_21469":122343,"_5":14752,"_28187":122263,"_3059":53450},[],{"_3604":73212,"_31000":73184,"_21469":122345,"_5":14752,"_28187":122263,"_3059":122346},[],"La identidad está marcada como revocada.",{"_3604":73213,"_31000":73184,"_21469":122348,"_5":14752,"_28187":122263,"_3059":53456},[],{"_3604":73214,"_31000":73184,"_21469":122350,"_5":14752,"_28187":122263,"_3059":122351},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3604":73215,"_31000":73184,"_21469":122353,"_5":14752,"_28187":122263,"_3059":122354},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3604":73216,"_31000":73184,"_21469":122356,"_5":14752,"_28187":122267,"_3059":122357},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3604":73217,"_31000":73184,"_21469":122359,"_5":14752,"_28187":122267,"_3059":122360},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3604":73218,"_31000":73184,"_21469":122362,"_5":14752,"_28187":122267,"_3059":122363},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3604":73219,"_31000":73184,"_21469":122365,"_5":14752,"_28187":122267,"_3059":122366},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3604":73220,"_31000":73184,"_21469":122368,"_5":14752,"_28187":122271,"_3059":122369},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3604":73221,"_31000":73184,"_21469":122371,"_5":14752,"_28187":122275,"_3059":122372},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3604":73222,"_31000":73184,"_21469":122374,"_5":14752,"_28187":122279,"_3059":122375},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3604":73223,"_31000":73184,"_21469":122377,"_5":14752,"_28187":122283,"_3059":122378},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3604":73224,"_31000":73184,"_21469":122380,"_5":14752,"_28187":122287,"_3059":122381},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3604":73225,"_31000":73184,"_21469":122383,"_5":14752,"_28187":122287,"_3059":122384},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3604":73226,"_31000":73184,"_21469":122386,"_5":14752,"_28187":122291,"_3059":122387},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3604":73227,"_31000":73184,"_21469":122389,"_5":14752,"_28187":122291,"_3059":122390},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3604":73228,"_31000":73184,"_21469":122392,"_5":14752,"_28187":122291,"_3059":122393},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3604":73229,"_31000":73184,"_21469":122395,"_5":14752,"_28187":122291,"_3059":122396},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3604":73230,"_31000":73184,"_21469":122398,"_5":14752,"_28187":122291,"_3059":122399},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3604":73231,"_31000":73184,"_21469":122401,"_5":14752,"_28187":122291,"_3059":122402},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3604":73232,"_31000":73184,"_21469":122404,"_5":14752,"_28187":122295,"_3059":122405},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3604":73233,"_31000":73184,"_21469":122407,"_5":14752,"_28187":122295,"_3059":122408},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3604":73234,"_31000":73184,"_21469":122410,"_5":14752,"_28187":122299,"_3059":122411},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3604":73235,"_31000":73184,"_21469":122413,"_5":14752,"_28187":122299,"_3059":122414},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3604":73236,"_31000":73184,"_21469":122416,"_5":14752,"_28187":122299,"_3059":122417},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3604":73237,"_31000":73184,"_21469":122419,"_5":14752,"_28187":122299,"_3059":122420},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3604":73238,"_31000":73184,"_21469":122422,"_5":14752,"_28187":122303,"_3059":122423},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3604":73239,"_31000":73184,"_21469":122425,"_5":14752,"_28187":122303,"_3059":122426},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3604":73240,"_31000":73240,"_5":15112,"_3059":122428,"_31359":122429,"_21469":122431,"_28187":73240},"Identidad inicial y autenticación",[50673,121110,53357,122255,122430],"Enrolamiento con PKI",[],{"_3604":73241,"_31000":73240,"_21469":122433,"_5":14752,"_28187":73240,"_3059":122434},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3604":73242,"_31000":73240,"_5":31356,"_21469":122436,"_28187":122437,"_3059":122438},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3604":73243,"_31000":73240,"_5":31356,"_21469":122440,"_28187":122441,"_3059":122442},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3604":73244,"_31000":73240,"_5":31356,"_21469":122444,"_28187":122445,"_3059":122446},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3604":73245,"_31000":73240,"_5":31356,"_21469":122448,"_28187":122449,"_3059":122450},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3604":73246,"_31000":73240,"_5":31356,"_21469":122452,"_28187":122453,"_3059":122454},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3604":73247,"_31000":73240,"_21469":122456,"_5":14752,"_28187":73240,"_3059":122457},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3604":73248,"_31000":73240,"_21469":122459,"_5":14752,"_28187":122437,"_3059":122460},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3604":73249,"_31000":73240,"_21469":122462,"_5":14752,"_28187":122437,"_3059":122463},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3604":73250,"_31000":73240,"_21469":122465,"_5":14752,"_28187":122441,"_3059":122466},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3604":73251,"_31000":73240,"_21469":122468,"_5":14752,"_28187":122441,"_3059":122469},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3604":73252,"_31000":73240,"_21469":122471,"_5":14752,"_28187":122441,"_3059":122472},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3604":73253,"_31000":73240,"_21469":122474,"_5":14752,"_28187":122445,"_3059":122475},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3604":73254,"_31000":73240,"_21469":122477,"_5":14752,"_28187":122445,"_3059":122478},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3604":73255,"_31000":73240,"_21469":122480,"_5":14752,"_28187":122449,"_3059":122481},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3604":73256,"_31000":73240,"_21469":122483,"_5":14752,"_28187":122449,"_3059":122484},[],"Ejemplo de cuerpo:",{"_3604":73257,"_31000":73240,"_21469":122486,"_5":14752,"_28187":122449,"_3059":122487},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3604":73258,"_31000":73240,"_21469":122489,"_5":14752,"_28187":122449,"_3059":122490},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3604":73259,"_31000":73240,"_21469":122492,"_5":14752,"_28187":122449,"_3059":122493},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3604":73260,"_31000":73240,"_21469":122495,"_5":14752,"_28187":122449,"_3059":122496},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3604":73261,"_31000":73240,"_21469":122498,"_5":14752,"_28187":122453,"_3059":122499},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3604":73262,"_31000":73240,"_21469":122501,"_5":14752,"_28187":122453,"_3059":122502},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3604":73263,"_31000":73263,"_5":15112,"_3059":122504,"_31359":122505,"_21469":122506,"_28187":73263},"Configura y opera el DMS",[50673,121110,53357,122255,122430],[],{"_3604":73264,"_31000":73263,"_21469":122508,"_5":14752,"_28187":73263,"_3059":122509},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3604":73265,"_31000":73263,"_5":31356,"_21469":122511,"_28187":122512,"_3059":119644},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3604":73266,"_31000":73263,"_5":31356,"_21469":122514,"_28187":122515,"_3059":122516},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3604":73267,"_31000":73263,"_5":31356,"_21469":122518,"_28187":122519,"_3059":122520},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3604":73268,"_31000":73263,"_5":31356,"_21469":122522,"_28187":122523,"_3059":122524},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3604":73269,"_31000":73263,"_5":31356,"_21469":122526,"_28187":122527,"_3059":122528},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3604":73270,"_31000":73263,"_5":31356,"_21469":122530,"_28187":122531,"_3059":122532},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3604":73271,"_31000":73263,"_5":31356,"_21469":122534,"_28187":122535,"_3059":122536},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3604":73272,"_31000":73263,"_5":31356,"_21469":122538,"_28187":122539,"_3059":122540},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3604":73273,"_31000":73263,"_5":31356,"_21469":122542,"_28187":122543,"_3059":53652},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3604":73274,"_31000":73263,"_5":31356,"_21469":122545,"_28187":122546,"_3059":53656},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3604":73275,"_31000":73263,"_5":31356,"_21469":122548,"_28187":122549,"_3059":122550},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3604":73276,"_31000":73263,"_5":31356,"_21469":122552,"_28187":122553,"_3059":122554},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3604":73277,"_31000":73263,"_5":31356,"_21469":122556,"_28187":122557,"_3059":122558},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3604":73278,"_31000":73263,"_5":31356,"_21469":122560,"_28187":122561,"_3059":122562},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3604":73279,"_31000":73263,"_5":31356,"_21469":122564,"_28187":122565,"_3059":53676},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3604":73280,"_31000":73263,"_5":31356,"_21469":122567,"_28187":122568,"_3059":122569},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3604":73281,"_31000":73263,"_5":31356,"_21469":122571,"_28187":122572,"_3059":122573},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3604":73282,"_31000":73263,"_5":31356,"_21469":122575,"_28187":122576,"_3059":122577},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3604":73283,"_31000":73263,"_21469":122579,"_5":14752,"_28187":73263,"_3059":122580},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3604":73284,"_31000":73263,"_21469":122582,"_5":14752,"_28187":122512,"_3059":122583},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3604":73285,"_31000":73263,"_21469":122585,"_5":14752,"_28187":122512,"_3059":122586},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3604":73286,"_31000":73263,"_21469":122588,"_5":14752,"_28187":122519,"_3059":122589},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3604":73287,"_31000":73263,"_21469":122591,"_5":14752,"_28187":122523,"_3059":122592},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3604":73288,"_31000":73263,"_21469":122594,"_5":14752,"_28187":122527,"_3059":122595},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3604":73289,"_31000":73263,"_21469":122597,"_5":14752,"_28187":122531,"_3059":122598},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3604":73290,"_31000":73263,"_21469":122600,"_5":14752,"_28187":122535,"_3059":122601},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3604":73291,"_31000":73263,"_21469":122603,"_5":14752,"_28187":122543,"_3059":122604},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3604":73292,"_31000":73263,"_21469":122606,"_5":14752,"_28187":122543,"_3059":122607},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3604":73293,"_31000":73263,"_21469":122609,"_5":14752,"_28187":122546,"_3059":122610},[],"Campo de `settings.enrollment_settings`",{"_3604":73294,"_31000":73263,"_21469":122612,"_5":14752,"_28187":122546,"_3059":122613},[],"Decisión",{"_3604":73295,"_31000":73263,"_21469":122615,"_5":14752,"_28187":122546,"_3059":53727},[],{"_3604":73296,"_31000":73263,"_21469":122617,"_5":14752,"_28187":122546,"_3059":122618},[],"`EST_RFC7030` para estas operaciones.",{"_3604":73297,"_31000":73263,"_21469":122620,"_5":14752,"_28187":122546,"_3059":53733},[],{"_3604":73298,"_31000":73263,"_21469":122622,"_5":14752,"_28187":122546,"_3059":122623},[],"ID de la CA que firmará.",{"_3604":73299,"_31000":73263,"_21469":122625,"_5":14752,"_28187":122546,"_3059":53739},[],{"_3604":73300,"_31000":73263,"_21469":122627,"_5":14752,"_28187":122546,"_3059":122628},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3604":73301,"_31000":73263,"_21469":122630,"_5":14752,"_28187":122546,"_3059":53745},[],{"_3604":73302,"_31000":73263,"_21469":122632,"_5":14752,"_28187":122546,"_3059":122633},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3604":73303,"_31000":73263,"_21469":122635,"_5":14752,"_28187":122546,"_3059":53751},[],{"_3604":73304,"_31000":73263,"_21469":122637,"_5":14752,"_28187":122546,"_3059":122638},[],"Uno de los cuatro modos de autenticación.",{"_3604":73305,"_31000":73263,"_21469":122640,"_5":14752,"_28187":122546,"_3059":122641},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3604":73306,"_31000":73263,"_21469":122643,"_5":14752,"_28187":122549,"_3059":122644},[],"Los bloques son independientes:",{"_3604":73307,"_31000":73263,"_21469":122646,"_5":14752,"_28187":122549,"_3059":122647},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3604":73308,"_31000":73263,"_21469":122649,"_5":14752,"_28187":122549,"_3059":122650},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3604":73309,"_31000":73263,"_21469":122652,"_5":14752,"_28187":122549,"_3059":53769},[],{"_3604":73310,"_31000":73263,"_21469":122654,"_5":14752,"_28187":122549,"_3059":122655},[],"Control aplicado en la operación configurada",{"_3604":73311,"_31000":73263,"_21469":122657,"_5":14752,"_28187":122549,"_3059":53775},[],{"_3604":73312,"_31000":73263,"_21469":122659,"_5":14752,"_28187":122549,"_3059":122660},[],"Validación del certificado presentado.",{"_3604":73313,"_31000":73263,"_21469":122662,"_5":14752,"_28187":122549,"_3059":53781},[],{"_3604":73314,"_31000":73263,"_21469":122664,"_5":14752,"_28187":122549,"_3059":122665},[],"Autorización del webhook configurado.",{"_3604":73315,"_31000":73263,"_21469":122667,"_5":14752,"_28187":122549,"_3059":53787},[],{"_3604":73316,"_31000":73263,"_21469":122669,"_5":14752,"_28187":122549,"_3059":122670},[],"Validación del certificado y, después, aprobación del webhook.",{"_3604":73317,"_31000":73263,"_21469":122672,"_5":14752,"_28187":122549,"_3059":53793},[],{"_3604":73318,"_31000":73263,"_21469":122674,"_5":14752,"_28187":122549,"_3059":122675},[],"Sin autenticación del solicitante por el DMS.",{"_3604":73319,"_31000":73263,"_21469":122677,"_5":14752,"_28187":122549,"_3059":122678},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3604":73320,"_31000":73263,"_21469":122680,"_5":14752,"_28187":122549,"_3059":122681},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3604":73321,"_31000":73263,"_21469":122683,"_5":14752,"_28187":122549,"_3059":122684},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3604":73322,"_31000":73263,"_21469":122686,"_5":14752,"_28187":122549,"_3059":122687},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3604":73323,"_31000":73263,"_21469":122689,"_5":14752,"_28187":122553,"_3059":122690},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3604":73324,"_31000":73263,"_21469":122692,"_5":14752,"_28187":122553,"_3059":122693},[],"Campo de `external_webhook_settings`",{"_3604":73325,"_31000":73263,"_21469":122695,"_5":14752,"_28187":122553,"_3059":122613},[],{"_3604":73326,"_31000":73263,"_21469":122697,"_5":14752,"_28187":122553,"_3059":53819},[],{"_3604":73327,"_31000":73263,"_21469":122699,"_5":14752,"_28187":122553,"_3059":122700},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3604":73328,"_31000":73263,"_21469":122702,"_5":14752,"_28187":122553,"_3059":53825},[],{"_3604":73329,"_31000":73263,"_21469":122704,"_5":14752,"_28187":122553,"_3059":122705},[],"`POST` o `PUT`; `POST` por defecto.",{"_3604":73330,"_31000":73263,"_21469":122707,"_5":14752,"_28187":122553,"_3059":53831},[],{"_3604":73331,"_31000":73263,"_21469":122709,"_5":14752,"_28187":122553,"_3059":122710},[],"Etiqueta usada en los logs del servicio.",{"_3604":73332,"_31000":73263,"_21469":122712,"_5":14752,"_28187":122553,"_3059":53837},[],{"_3604":73333,"_31000":73263,"_21469":122714,"_5":14752,"_28187":122553,"_3059":122715},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3604":73334,"_31000":73263,"_21469":122717,"_5":14752,"_28187":122553,"_3059":53843},[],{"_3604":73335,"_31000":73263,"_21469":122719,"_5":14752,"_28187":122553,"_3059":122720},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3604":73336,"_31000":73263,"_21469":122722,"_5":14752,"_28187":122553,"_3059":53849},[],{"_3604":73337,"_31000":73263,"_21469":122724,"_5":14752,"_28187":122553,"_3059":122725},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3604":73338,"_31000":73263,"_21469":122727,"_5":14752,"_28187":122553,"_3059":53855},[],{"_3604":73339,"_31000":73263,"_21469":122729,"_5":14752,"_28187":122553,"_3059":122730},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3604":73340,"_31000":73263,"_21469":122732,"_5":14752,"_28187":122553,"_3059":53861},[],{"_3604":73341,"_31000":73263,"_21469":122734,"_5":14752,"_28187":122553,"_3059":122735},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3604":73342,"_31000":73263,"_21469":122737,"_5":14752,"_28187":122553,"_3059":53867},[],{"_3604":73343,"_31000":73263,"_21469":122739,"_5":14752,"_28187":122553,"_3059":122740},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3604":73344,"_31000":73263,"_21469":122742,"_5":14752,"_28187":122553,"_3059":53873},[],{"_3604":73345,"_31000":73263,"_21469":122744,"_5":14752,"_28187":122553,"_3059":122745},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3604":73346,"_31000":73263,"_21469":122747,"_5":14752,"_28187":122553,"_3059":122748},[],"Reglas de esa configuración:",{"_3604":73347,"_31000":73263,"_21469":122750,"_5":14752,"_28187":122553,"_3059":122751},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3604":73348,"_31000":73263,"_21469":122753,"_5":14752,"_28187":122553,"_3059":122754},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3604":73349,"_31000":73263,"_21469":122756,"_5":14752,"_28187":122553,"_3059":122757},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3604":73350,"_31000":73263,"_21469":122759,"_5":14752,"_28187":122553,"_3059":122760},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3604":73351,"_31000":73263,"_21469":122762,"_5":14752,"_28187":122553,"_3059":122763},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3604":73352,"_31000":73263,"_21469":122765,"_5":14752,"_28187":122553,"_3059":122766},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3604":73353,"_31000":73263,"_21469":122768,"_5":14752,"_28187":122553,"_3059":122769},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3604":73354,"_31000":73263,"_21469":122771,"_5":14752,"_28187":122553,"_3059":122772},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3604":73355,"_31000":73263,"_21469":122774,"_5":14752,"_28187":122553,"_3059":122775},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3604":73356,"_31000":73263,"_21469":122777,"_5":14752,"_28187":122557,"_3059":122778},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3604":73357,"_31000":73263,"_21469":122780,"_5":14752,"_28187":122561,"_3059":122781},[],"Campo de `settings.reenrollment_settings`",{"_3604":73358,"_31000":73263,"_21469":122783,"_5":14752,"_28187":122561,"_3059":122784},[],"Función",{"_3604":73359,"_31000":73263,"_21469":122786,"_5":14752,"_28187":122561,"_3059":53917},[],{"_3604":73360,"_31000":73263,"_21469":122788,"_5":14752,"_28187":122561,"_3059":122789},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3604":73361,"_31000":73263,"_21469":122791,"_5":14752,"_28187":122561,"_3059":53923},[],{"_3604":73362,"_31000":73263,"_21469":122793,"_5":14752,"_28187":122561,"_3059":122794},[],"Umbral operativo preventivo de monitorización.",{"_3604":73363,"_31000":73263,"_21469":122796,"_5":14752,"_28187":122561,"_3059":53929},[],{"_3604":73364,"_31000":73263,"_21469":122798,"_5":14752,"_28187":122561,"_3059":122799},[],"Umbral operativo crítico de monitorización.",{"_3604":73365,"_31000":73263,"_21469":122801,"_5":14752,"_28187":122561,"_3059":53935},[],{"_3604":73366,"_31000":73263,"_21469":122803,"_5":14752,"_28187":122561,"_3059":122804},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3604":73367,"_31000":73263,"_21469":122806,"_5":14752,"_28187":122561,"_3059":53941},[],{"_3604":73368,"_31000":73263,"_21469":122808,"_5":14752,"_28187":122561,"_3059":122809},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3604":73369,"_31000":73263,"_21469":122811,"_5":14752,"_28187":122561,"_3059":53947},[],{"_3604":73370,"_31000":73263,"_21469":122813,"_5":14752,"_28187":122561,"_3059":122814},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3604":73371,"_31000":73263,"_21469":122816,"_5":14752,"_28187":122561,"_3059":122817},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3604":73372,"_31000":73263,"_21469":122819,"_5":14752,"_28187":122565,"_3059":122820},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3604":73373,"_31000":73263,"_21469":122822,"_5":14752,"_28187":122568,"_3059":120008},[],{"_3604":73374,"_31000":73263,"_21469":122824,"_5":14752,"_28187":122568,"_3059":122825},[],"Qué publica",{"_3604":73375,"_31000":73263,"_21469":122827,"_5":14752,"_28187":122568,"_3059":53964},[],{"_3604":73376,"_31000":73263,"_21469":122829,"_5":14752,"_28187":122568,"_3059":122830},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3604":73377,"_31000":73263,"_21469":122832,"_5":14752,"_28187":122568,"_3059":53970},[],{"_3604":73378,"_31000":73263,"_21469":122834,"_5":14752,"_28187":122568,"_3059":122835},[],"Certificado de la CA emisora seleccionada.",{"_3604":73379,"_31000":73263,"_21469":122837,"_5":14752,"_28187":122568,"_3059":53976},[],{"_3604":73380,"_31000":73263,"_21469":122839,"_5":14752,"_28187":122568,"_3059":122840},[],"Certificados de las CAs elegidas explícitamente.",{"_3604":73381,"_31000":73263,"_21469":122842,"_5":14752,"_28187":122568,"_3059":122843},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3604":73382,"_31000":73263,"_21469":122845,"_5":14752,"_28187":122572,"_3059":122846},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3604":73383,"_31000":73263,"_21469":122848,"_5":14752,"_28187":122572,"_3059":122849},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3604":73384,"_31000":73263,"_21469":122851,"_5":14752,"_28187":122572,"_3059":122852},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3604":73385,"_31000":73263,"_21469":122854,"_5":14752,"_28187":122576,"_3059":122855},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3604":73386,"_31000":73386,"_5":15112,"_3059":122857,"_31359":122858,"_21469":122859,"_28187":73386},"Integra el cliente EST",[50673,121110,53357,122255,122430],[],{"_3604":73387,"_31000":73386,"_21469":122861,"_5":14752,"_28187":73386,"_3059":122862},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3604":73388,"_31000":73386,"_5":31356,"_21469":122864,"_28187":122865,"_3059":119644},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3604":73389,"_31000":73386,"_5":31356,"_21469":122867,"_28187":122868,"_3059":122869},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3604":73390,"_31000":73386,"_5":31356,"_21469":122871,"_28187":122872,"_3059":122873},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3604":73391,"_31000":73386,"_5":31356,"_21469":122875,"_28187":122876,"_3059":122877},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3604":73392,"_31000":73386,"_5":31356,"_21469":122879,"_28187":122880,"_3059":122881},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3604":73393,"_31000":73386,"_5":31356,"_21469":122883,"_28187":122884,"_3059":122885},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3604":73394,"_31000":73386,"_21469":122887,"_5":14752,"_28187":73386,"_3059":122888},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3604":73395,"_31000":73386,"_21469":122890,"_5":14752,"_28187":122865,"_3059":122891},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3604":73396,"_31000":73386,"_21469":122893,"_5":14752,"_28187":122865,"_3059":122894},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3604":73397,"_31000":73386,"_21469":122896,"_5":14752,"_28187":122865,"_3059":122897},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3604":73398,"_31000":73386,"_21469":122899,"_5":14752,"_28187":122868,"_3059":122900},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3604":73399,"_31000":73386,"_21469":122902,"_5":14752,"_28187":122868,"_3059":122903},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3604":73400,"_31000":73386,"_21469":122905,"_5":14752,"_28187":122872,"_3059":122906},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3604":73401,"_31000":73386,"_21469":122908,"_5":14752,"_28187":122872,"_3059":122909},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3604":73402,"_31000":73386,"_21469":122911,"_5":14752,"_28187":122876,"_3059":122912},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3604":73403,"_31000":73386,"_21469":122914,"_5":14752,"_28187":122876,"_3059":122915},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3604":73404,"_31000":73386,"_21469":122917,"_5":14752,"_28187":122880,"_3059":122918},[],"Para el caso de una raíz que emite directamente:",{"_3604":73405,"_31000":73386,"_21469":122920,"_5":14752,"_28187":122880,"_3059":122921},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3604":73406,"_31000":73386,"_21469":122923,"_5":14752,"_28187":122880,"_3059":122924},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3604":73407,"_31000":73386,"_21469":122926,"_5":14752,"_28187":122884,"_3059":122927},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3604":73408,"_31000":73408,"_5":15112,"_3059":122929,"_31359":122930,"_21469":122931,"_28187":73408},"Referencia EST",[50673,121110,53357,122255,122430],[],{"_3604":73409,"_31000":73408,"_21469":122933,"_5":14752,"_28187":73408,"_3059":122934},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3604":73410,"_31000":73408,"_5":31356,"_21469":122936,"_28187":122937,"_3059":122938},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3604":73411,"_31000":73408,"_5":31356,"_21469":122940,"_28187":122941,"_3059":23266},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3604":73412,"_31000":73408,"_5":31356,"_21469":122943,"_28187":122944,"_3059":26732},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3604":73413,"_31000":73408,"_5":31356,"_21469":122946,"_28187":122947,"_3059":26739},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3604":73414,"_31000":73408,"_5":31356,"_21469":122949,"_28187":122950,"_3059":26017},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3604":73415,"_31000":73408,"_5":31356,"_21469":122952,"_28187":122953,"_3059":122954},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3604":73416,"_31000":73408,"_5":31356,"_21469":122956,"_28187":122957,"_3059":122958},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3604":73417,"_31000":73408,"_5":31356,"_21469":122960,"_28187":122961,"_3059":122962},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3604":73418,"_31000":73408,"_21469":122964,"_5":14752,"_28187":73408,"_3059":122965},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3604":73419,"_31000":73408,"_21469":122967,"_5":14752,"_28187":122937,"_3059":122968},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3604":73420,"_31000":73408,"_21469":122970,"_5":14752,"_28187":122937,"_3059":120870},[],{"_3604":73421,"_31000":73408,"_21469":122972,"_5":14752,"_28187":122937,"_3059":122973},[],"Método",{"_3604":73422,"_31000":73408,"_21469":122975,"_5":14752,"_28187":122937,"_3059":122976},[],"Autenticación y condición",{"_3604":73423,"_31000":73408,"_21469":122978,"_5":14752,"_28187":122937,"_3059":54119},[],{"_3604":73424,"_31000":73408,"_21469":122980,"_5":14752,"_28187":122937,"_3059":54122},[],{"_3604":73425,"_31000":73408,"_21469":122982,"_5":14752,"_28187":122937,"_3059":122983},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3604":73426,"_31000":73408,"_21469":122985,"_5":14752,"_28187":122937,"_3059":54128},[],{"_3604":73427,"_31000":73408,"_21469":122987,"_5":14752,"_28187":122937,"_3059":54131},[],{"_3604":73428,"_31000":73408,"_21469":122989,"_5":14752,"_28187":122937,"_3059":122990},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3604":73429,"_31000":73408,"_21469":122992,"_5":14752,"_28187":122937,"_3059":54137},[],{"_3604":73430,"_31000":73408,"_21469":122994,"_5":14752,"_28187":122937,"_3059":54131},[],{"_3604":73431,"_31000":73408,"_21469":122996,"_5":14752,"_28187":122937,"_3059":122997},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3604":73432,"_31000":73408,"_21469":122999,"_5":14752,"_28187":122937,"_3059":54145},[],{"_3604":73433,"_31000":73408,"_21469":123001,"_5":14752,"_28187":122937,"_3059":54131},[],{"_3604":73434,"_31000":73408,"_21469":123003,"_5":14752,"_28187":122937,"_3059":123004},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3604":73435,"_31000":73408,"_21469":123006,"_5":14752,"_28187":122937,"_3059":123007},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3604":73436,"_31000":73408,"_21469":123009,"_5":14752,"_28187":122941,"_3059":123010},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3604":73437,"_31000":73408,"_21469":123012,"_5":14752,"_28187":122941,"_3059":123013},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3604":73438,"_31000":73408,"_21469":123015,"_5":14752,"_28187":122944,"_3059":123016},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3604":73439,"_31000":73408,"_21469":123018,"_5":14752,"_28187":122944,"_3059":123019},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3604":73440,"_31000":73408,"_21469":123021,"_5":14752,"_28187":122947,"_3059":123022},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3604":73441,"_31000":73408,"_21469":123024,"_5":14752,"_28187":122947,"_3059":123025},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3604":73442,"_31000":73408,"_21469":123027,"_5":14752,"_28187":122950,"_3059":123028},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3604":73443,"_31000":73408,"_21469":123030,"_5":14752,"_28187":122950,"_3059":123031},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3604":73444,"_31000":73408,"_21469":123033,"_5":14752,"_28187":122953,"_3059":123034},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3604":73445,"_31000":73408,"_21469":123036,"_5":14752,"_28187":122953,"_3059":123037},[],"Parte",{"_3604":73446,"_31000":73408,"_21469":123039,"_5":14752,"_28187":122953,"_3059":123040},[],"Contenido tras decodificar su Base64",{"_3604":73447,"_31000":73408,"_21469":123042,"_5":14752,"_28187":122953,"_3059":54189},[],{"_3604":73448,"_31000":73408,"_21469":123044,"_5":14752,"_28187":122953,"_3059":123045},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3604":73449,"_31000":73408,"_21469":123047,"_5":14752,"_28187":122953,"_3059":54195},[],{"_3604":73450,"_31000":73408,"_21469":123049,"_5":14752,"_28187":122953,"_3059":123050},[],"PKCS#7 DER con el certificado emitido.",{"_3604":73451,"_31000":73408,"_21469":123052,"_5":14752,"_28187":122953,"_3059":123053},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3604":73452,"_31000":73408,"_21469":123055,"_5":14752,"_28187":122957,"_3059":123056},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3604":73453,"_31000":73408,"_21469":123058,"_5":14752,"_28187":122957,"_3059":123059},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3604":73454,"_31000":73408,"_21469":123061,"_5":14752,"_28187":122957,"_3059":123062},[],"Convierte y comprueba el resultado:",{"_3604":73455,"_31000":73408,"_21469":123064,"_5":14752,"_28187":122957,"_3059":123065},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3604":73456,"_31000":73408,"_21469":123067,"_5":14752,"_28187":122961,"_3059":123068},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3604":73457,"_31000":73408,"_21469":123070,"_5":14752,"_28187":122961,"_3059":123071},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3604":73458,"_31000":73458,"_5":15112,"_3059":122430,"_31359":123073,"_21469":123074,"_28187":73458},[50673,121110,53357,122255,122430],[],{"_3604":73459,"_31000":73458,"_21469":123076,"_5":14752,"_28187":73458,"_3059":123077},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3604":73460,"_31000":73458,"_5":31356,"_21469":123079,"_28187":123080,"_3059":123081},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3604":73461,"_31000":73458,"_5":31356,"_21469":123083,"_28187":123084,"_3059":123085},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3604":73462,"_31000":73458,"_5":31356,"_21469":123087,"_28187":123088,"_3059":123089},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3604":73463,"_31000":73458,"_5":31356,"_21469":123091,"_28187":123092,"_3059":123093},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3604":73464,"_31000":73458,"_21469":123095,"_5":14752,"_28187":73458,"_3059":123096},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3604":73465,"_31000":73458,"_21469":123098,"_5":14752,"_28187":123080,"_3059":123099},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3604":73466,"_31000":73458,"_21469":123101,"_5":14752,"_28187":123080,"_3059":123102},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3604":73467,"_31000":73458,"_21469":123104,"_5":14752,"_28187":123080,"_3059":123105},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3604":73468,"_31000":73458,"_21469":123107,"_5":14752,"_28187":123080,"_3059":123108},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3604":73469,"_31000":73458,"_21469":123110,"_5":14752,"_28187":123080,"_3059":123111},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3604":73470,"_31000":73458,"_21469":123113,"_5":14752,"_28187":123080,"_3059":123114},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3604":73471,"_31000":73458,"_21469":123116,"_5":14752,"_28187":123084,"_3059":123117},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3604":73472,"_31000":73458,"_21469":123119,"_5":14752,"_28187":123084,"_3059":123120},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3604":73473,"_31000":73458,"_21469":123122,"_5":14752,"_28187":123084,"_3059":123123},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3604":73474,"_31000":73458,"_21469":123125,"_5":14752,"_28187":123084,"_3059":123126},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3604":73475,"_31000":73458,"_21469":123128,"_5":14752,"_28187":123088,"_3059":123129},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3604":73476,"_31000":73458,"_21469":123131,"_5":14752,"_28187":123088,"_3059":123132},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3604":73477,"_31000":73458,"_21469":123134,"_5":14752,"_28187":123088,"_3059":123135},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3604":73478,"_31000":73458,"_21469":123137,"_5":14752,"_28187":123088,"_3059":123138},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3604":73479,"_31000":73458,"_21469":123140,"_5":14752,"_28187":123092,"_3059":123141},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3604":73480,"_31000":73458,"_21469":123143,"_5":14752,"_28187":123092,"_3059":123144},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3604":73481,"_31000":73481,"_5":15112,"_3059":123146,"_31359":123147,"_21469":123148,"_28187":73481},"Estrategias de aprovisionamiento",[50673,121110,53357,122255,122430],[],{"_3604":73482,"_31000":73481,"_21469":123150,"_5":14752,"_28187":73481,"_3059":123151},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3604":73483,"_31000":73481,"_5":31356,"_21469":123153,"_28187":123154,"_3059":123155},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3604":73484,"_31000":73481,"_5":31356,"_21469":123157,"_28187":123158,"_3059":123159},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3604":73485,"_31000":73481,"_5":31356,"_21469":123161,"_28187":123162,"_3059":123163},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3604":73486,"_31000":73481,"_5":31356,"_21469":123165,"_28187":123166,"_3059":123167},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3604":73487,"_31000":73481,"_5":31356,"_21469":123169,"_28187":123170,"_3059":123171},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3604":73488,"_31000":73481,"_21469":123173,"_5":14752,"_28187":73481,"_3059":123174},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3604":73489,"_31000":73481,"_21469":123176,"_5":14752,"_28187":123154,"_3059":123177},[],"Recorrido",{"_3604":73490,"_31000":73481,"_21469":123179,"_5":14752,"_28187":123154,"_3059":123180},[],"Cuándo existe el dispositivo",{"_3604":73491,"_31000":73481,"_21469":123182,"_5":14752,"_28187":123154,"_3059":123183},[],"Qué compruebas",{"_3604":73492,"_31000":73481,"_21469":123185,"_5":14752,"_28187":123154,"_3059":123186},[],"Asignación manual",{"_3604":73493,"_31000":73481,"_21469":123188,"_5":14752,"_28187":123154,"_3059":123189},[],"El operador lo crea antes de asociar un certificado.",{"_3604":73494,"_31000":73481,"_21469":123191,"_5":14752,"_28187":123154,"_3059":123192},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3604":73495,"_31000":73481,"_21469":123194,"_5":14752,"_28187":123154,"_3059":123195},[],"EST con `JITP`",{"_3604":73496,"_31000":73481,"_21469":123197,"_5":14752,"_28187":123154,"_3059":123198},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3604":73497,"_31000":73481,"_21469":123200,"_5":14752,"_28187":123154,"_3059":123201},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3604":73498,"_31000":73481,"_21469":123203,"_5":14752,"_28187":123154,"_3059":123204},[],"EST con `PRE_REGISTRATION`",{"_3604":73499,"_31000":73481,"_21469":123206,"_5":14752,"_28187":123154,"_3059":123207},[],"Debe existir antes de `/simpleenroll`.",{"_3604":73500,"_31000":73481,"_21469":123209,"_5":14752,"_28187":123154,"_3059":123210},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3604":73501,"_31000":73481,"_21469":123212,"_5":14752,"_28187":123154,"_3059":123213},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3604":73502,"_31000":73481,"_21469":123215,"_5":14752,"_28187":123154,"_3059":123216},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3604":73503,"_31000":73481,"_21469":123218,"_5":14752,"_28187":123158,"_3059":123219},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3604":73504,"_31000":73481,"_21469":123221,"_5":14752,"_28187":123158,"_3059":123222},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3604":73505,"_31000":73481,"_21469":123224,"_5":14752,"_28187":123158,"_3059":123225},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3604":73506,"_31000":73481,"_21469":123227,"_5":14752,"_28187":123162,"_3059":123228},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3604":73507,"_31000":73481,"_21469":123230,"_5":14752,"_28187":123162,"_3059":123231},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3604":73508,"_31000":73481,"_21469":123233,"_5":14752,"_28187":123162,"_3059":123234},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3604":73509,"_31000":73481,"_21469":123236,"_5":14752,"_28187":123162,"_3059":123237},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3604":73510,"_31000":73481,"_21469":123239,"_5":14752,"_28187":123162,"_3059":123240},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3604":73511,"_31000":73481,"_21469":123242,"_5":14752,"_28187":123162,"_3059":123243},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3604":73512,"_31000":73481,"_21469":123245,"_5":14752,"_28187":123166,"_3059":120008},[],{"_3604":73513,"_31000":73481,"_21469":123247,"_5":14752,"_28187":123166,"_3059":123248},[],"Material que atraviesa EST",{"_3604":73514,"_31000":73481,"_21469":123250,"_5":14752,"_28187":123166,"_3059":123251},[],"Clave generada por el dispositivo",{"_3604":73515,"_31000":73481,"_21469":123253,"_5":14752,"_28187":123166,"_3059":123254},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3604":73516,"_31000":73481,"_21469":123256,"_5":14752,"_28187":123166,"_3059":123257},[],"Clave ya disponible en el dispositivo",{"_3604":73517,"_31000":73481,"_21469":123259,"_5":14752,"_28187":123166,"_3059":123260},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3604":73518,"_31000":73481,"_21469":123262,"_5":14752,"_28187":123166,"_3059":53676},[],{"_3604":73519,"_31000":73481,"_21469":123264,"_5":14752,"_28187":123166,"_3059":123265},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3604":73520,"_31000":73481,"_21469":123267,"_5":14752,"_28187":123166,"_3059":123268},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3604":73521,"_31000":73481,"_21469":123270,"_5":14752,"_28187":123170,"_3059":123271},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3604":73522,"_31000":73522,"_5":15112,"_3059":123273,"_31359":123274,"_21469":123275,"_28187":73522},"Renovación y recuperación",[50673,121110,53357,122255,122430],[],{"_3604":73523,"_31000":73522,"_21469":123277,"_5":14752,"_28187":73522,"_3059":123278},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3604":73524,"_31000":73522,"_5":31356,"_21469":123280,"_28187":123281,"_3059":123282},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3604":73525,"_31000":73522,"_5":31356,"_21469":123284,"_28187":123285,"_3059":123286},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3604":73526,"_31000":73522,"_5":31356,"_21469":123288,"_28187":123289,"_3059":123290},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3604":73527,"_31000":73522,"_5":31356,"_21469":123292,"_28187":123293,"_3059":123294},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3604":73528,"_31000":73522,"_5":31356,"_21469":123296,"_28187":123297,"_3059":123298},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3604":73529,"_31000":73522,"_21469":123300,"_5":14752,"_28187":73522,"_3059":123301},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3604":73530,"_31000":73522,"_21469":123303,"_5":14752,"_28187":123281,"_3059":123304},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3604":73531,"_31000":73522,"_21469":123306,"_5":14752,"_28187":123281,"_3059":123307},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3604":73532,"_31000":73522,"_21469":123309,"_5":14752,"_28187":123281,"_3059":123310},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3604":73533,"_31000":73522,"_21469":123312,"_5":14752,"_28187":123281,"_3059":123313},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3604":73534,"_31000":73522,"_21469":123315,"_5":14752,"_28187":123285,"_3059":123316},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3604":73535,"_31000":73522,"_21469":123318,"_5":14752,"_28187":123285,"_3059":123319},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3604":73536,"_31000":73522,"_21469":123321,"_5":14752,"_28187":123289,"_3059":123322},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3604":73537,"_31000":73522,"_21469":123324,"_5":14752,"_28187":123289,"_3059":123325},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3604":73538,"_31000":73522,"_21469":123327,"_5":14752,"_28187":123289,"_3059":123328},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3604":73539,"_31000":73522,"_21469":123330,"_5":14752,"_28187":123293,"_3059":123331},[],"Situación",{"_3604":73540,"_31000":73522,"_21469":123333,"_5":14752,"_28187":123293,"_3059":123334},[],"Procedimiento",{"_3604":73541,"_31000":73522,"_21469":123336,"_5":14752,"_28187":123293,"_3059":123337},[],"Certificado vigente, fuera de ventana",{"_3604":73542,"_31000":73522,"_21469":123339,"_5":14752,"_28187":123293,"_3059":123340},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3604":73543,"_31000":73522,"_21469":123342,"_5":14752,"_28187":123293,"_3059":123343},[],"Certificado vencido, clave disponible",{"_3604":73544,"_31000":73522,"_21469":123345,"_5":14752,"_28187":123293,"_3059":123346},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3604":73545,"_31000":73522,"_21469":123348,"_5":14752,"_28187":123293,"_3059":123349},[],"Renovación por webhook o `NO_AUTH`",{"_3604":73546,"_31000":73522,"_21469":123351,"_5":14752,"_28187":123293,"_3059":123352},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3604":73547,"_31000":73522,"_21469":123354,"_5":14752,"_28187":123293,"_3059":123355},[],"Clave perdida o inaccesible",{"_3604":73548,"_31000":73522,"_21469":123357,"_5":14752,"_28187":123293,"_3059":123358},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3604":73549,"_31000":73522,"_21469":123360,"_5":14752,"_28187":123293,"_3059":123361},[],"Identidad actual revocada",{"_3604":73550,"_31000":73522,"_21469":123363,"_5":14752,"_28187":123293,"_3059":123364},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3604":73551,"_31000":73522,"_21469":123366,"_5":14752,"_28187":123293,"_3059":123367},[],"Dispositivo sin identidad",{"_3604":73552,"_31000":73522,"_21469":123369,"_5":14752,"_28187":123293,"_3059":123370},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3604":73553,"_31000":73522,"_21469":123372,"_5":14752,"_28187":123293,"_3059":123373},[],"Dispositivo retirado",{"_3604":73554,"_31000":73522,"_21469":123375,"_5":14752,"_28187":123293,"_3059":123376},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3604":73555,"_31000":73522,"_21469":123378,"_5":14752,"_28187":123293,"_3059":123379},[],"Timeout, HTTP 500 o fallo de instalación",{"_3604":73556,"_31000":73522,"_21469":123381,"_5":14752,"_28187":123293,"_3059":123382},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3604":73557,"_31000":73522,"_21469":123384,"_5":14752,"_28187":123297,"_3059":123385},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3604":73558,"_31000":73522,"_21469":123387,"_5":14752,"_28187":123297,"_3059":123388},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3604":73559,"_31000":73559,"_5":15112,"_3059":123390,"_31359":123391,"_21469":123392,"_28187":73559},"Diagnóstico de enrolamiento",[50673,121110,53357,122255,122430],[],{"_3604":73560,"_31000":73559,"_21469":123394,"_5":14752,"_28187":73559,"_3059":123395},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3604":73561,"_31000":73559,"_5":31356,"_21469":123397,"_28187":123398,"_3059":123399},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3604":73562,"_31000":73559,"_5":31356,"_21469":123401,"_28187":123402,"_3059":123403},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3604":73563,"_31000":73559,"_5":31356,"_21469":123405,"_28187":123406,"_3059":122962},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3604":73564,"_31000":73559,"_5":31356,"_21469":123408,"_28187":123409,"_3059":123410},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3604":73565,"_31000":73559,"_21469":123412,"_5":14752,"_28187":73559,"_3059":123413},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3604":73566,"_31000":73559,"_21469":123415,"_5":14752,"_28187":123402,"_3059":123416},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3604":73567,"_31000":73559,"_21469":123418,"_5":14752,"_28187":123402,"_3059":123419},[],"Síntoma o mensaje",{"_3604":73568,"_31000":73559,"_21469":123421,"_5":14752,"_28187":123402,"_3059":123422},[],"Qué revisar",{"_3604":73569,"_31000":73559,"_21469":123424,"_5":14752,"_28187":123402,"_3059":123425},[],"curl rechaza TLS, nombre o emisor",{"_3604":73570,"_31000":73559,"_21469":123427,"_5":14752,"_28187":123402,"_3059":123428},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3604":73571,"_31000":73559,"_21469":123430,"_5":14752,"_28187":123402,"_3059":123431},[],"404 o APS ausente",{"_3604":73572,"_31000":73559,"_21469":123433,"_5":14752,"_28187":123402,"_3059":123434},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3604":73573,"_31000":73559,"_21469":123436,"_5":14752,"_28187":123402,"_3059":123437},[],"400, error de CSR o formato",{"_3604":73574,"_31000":73559,"_21469":123439,"_5":14752,"_28187":123402,"_3059":123440},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3604":73575,"_31000":73559,"_21469":123442,"_5":14752,"_28187":123402,"_3059":123443},[],"Credencial ausente o certificado no válido",{"_3604":73576,"_31000":73559,"_21469":123445,"_5":14752,"_28187":123402,"_3059":123446},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3604":73577,"_31000":73559,"_21469":123448,"_5":14752,"_28187":123402,"_3059":123449},[],"Webhook deniega, expira o responde sin autorización",{"_3604":73578,"_31000":73559,"_21469":123451,"_5":14752,"_28187":123402,"_3059":123452},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3604":73579,"_31000":73559,"_21469":123454,"_5":14752,"_28187":123402,"_3059":54602},[],{"_3604":73580,"_31000":73559,"_21469":123456,"_5":14752,"_28187":123402,"_3059":123457},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3604":73581,"_31000":73559,"_21469":123459,"_5":14752,"_28187":123402,"_3059":54608},[],{"_3604":73582,"_31000":73559,"_21469":123461,"_5":14752,"_28187":123402,"_3059":123462},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3604":73583,"_31000":73559,"_21469":123464,"_5":14752,"_28187":123402,"_3059":54614},[],{"_3604":73584,"_31000":73559,"_21469":123466,"_5":14752,"_28187":123402,"_3059":123467},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3604":73585,"_31000":73559,"_21469":123469,"_5":14752,"_28187":123402,"_3059":54620},[],{"_3604":73586,"_31000":73559,"_21469":123471,"_5":14752,"_28187":123402,"_3059":123472},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3604":73587,"_31000":73559,"_21469":123474,"_5":14752,"_28187":123402,"_3059":54626},[],{"_3604":73588,"_31000":73559,"_21469":123476,"_5":14752,"_28187":123402,"_3059":123477},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3604":73589,"_31000":73559,"_21469":123479,"_5":14752,"_28187":123402,"_3059":123480},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3604":73590,"_31000":73559,"_21469":123482,"_5":14752,"_28187":123402,"_3059":123483},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3604":73591,"_31000":73559,"_21469":123485,"_5":14752,"_28187":123402,"_3059":123486},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3604":73592,"_31000":73559,"_21469":123488,"_5":14752,"_28187":123402,"_3059":123489},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3604":73593,"_31000":73559,"_21469":123491,"_5":14752,"_28187":123402,"_3059":54644},[],{"_3604":73594,"_31000":73559,"_21469":123493,"_5":14752,"_28187":123402,"_3059":123494},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3604":73595,"_31000":73559,"_21469":123496,"_5":14752,"_28187":123402,"_3059":54650},[],{"_3604":73596,"_31000":73559,"_21469":123498,"_5":14752,"_28187":123402,"_3059":123499},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3604":73597,"_31000":73559,"_21469":123501,"_5":14752,"_28187":123402,"_3059":123502},[],"DMS propietario distinto",{"_3604":73598,"_31000":73559,"_21469":123504,"_5":14752,"_28187":123402,"_3059":123505},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3604":73599,"_31000":73559,"_21469":123507,"_5":14752,"_28187":123402,"_3059":54662},[],{"_3604":73600,"_31000":73559,"_21469":123509,"_5":14752,"_28187":123402,"_3059":123510},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3604":73601,"_31000":73559,"_21469":123512,"_5":14752,"_28187":123402,"_3059":54668},[],{"_3604":73602,"_31000":73559,"_21469":123514,"_5":14752,"_28187":123402,"_3059":123515},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3604":73603,"_31000":73559,"_21469":123517,"_5":14752,"_28187":123402,"_3059":123518},[],"Certificado actual revocado",{"_3604":73604,"_31000":73559,"_21469":123520,"_5":14752,"_28187":123402,"_3059":123521},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3604":73605,"_31000":73559,"_21469":123523,"_5":14752,"_28187":123402,"_3059":123524},[],"Error de CA, perfil o firma",{"_3604":73606,"_31000":73559,"_21469":123526,"_5":14752,"_28187":123402,"_3059":123527},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3604":73607,"_31000":73559,"_21469":123529,"_5":14752,"_28187":123402,"_3059":123530},[],"HTTP 200 sin conexión del dispositivo",{"_3604":73608,"_31000":73559,"_21469":123532,"_5":14752,"_28187":123402,"_3059":123533},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3604":73609,"_31000":73559,"_21469":123535,"_5":14752,"_28187":123402,"_3059":123536},[],"Timeout o error después de emitir",{"_3604":73610,"_31000":73559,"_21469":123538,"_5":14752,"_28187":123402,"_3059":123539},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3604":73611,"_31000":73559,"_21469":123541,"_5":14752,"_28187":123406,"_3059":123542},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3604":73612,"_31000":73559,"_21469":123544,"_5":14752,"_28187":123406,"_3059":123545},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3604":73613,"_31000":73559,"_21469":123547,"_5":14752,"_28187":123409,"_3059":123548},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3604":73614,"_31000":73559,"_21469":123550,"_5":14752,"_28187":123409,"_3059":123551},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3604":73615,"_31000":73559,"_21469":123553,"_5":14752,"_28187":123409,"_3059":123554},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3604":73616,"_31000":73559,"_21469":123556,"_5":14752,"_28187":123409,"_3059":123557},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3604":73617,"_31000":73559,"_21469":123559,"_5":14752,"_28187":123409,"_3059":123560},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3604":73618,"_31000":73559,"_21469":123562,"_5":14752,"_28187":123409,"_3059":123563},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3604":73619,"_31000":73559,"_21469":123565,"_5":14752,"_28187":123409,"_3059":123566},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3604":73620,"_31000":73620,"_5":15112,"_3059":123568,"_31359":123569,"_21469":123570,"_28187":73620},"Distribución y actualización de confianza",[50673,121110,53357,122255,122430],[],{"_3604":73621,"_31000":73620,"_21469":123572,"_5":14752,"_28187":73620,"_3059":123573},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3604":73622,"_31000":73620,"_5":31356,"_21469":123575,"_28187":123576,"_3059":123577},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3604":73623,"_31000":73620,"_5":31356,"_21469":123579,"_28187":123580,"_3059":123581},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3604":73624,"_31000":73620,"_5":31356,"_21469":123583,"_28187":123584,"_3059":123585},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3604":73625,"_31000":73620,"_5":31356,"_21469":123587,"_28187":123588,"_3059":123589},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3604":73626,"_31000":73620,"_5":31356,"_21469":123591,"_28187":123592,"_3059":123593},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3604":73627,"_31000":73620,"_21469":123595,"_5":14752,"_28187":73620,"_3059":123596},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3604":73628,"_31000":73620,"_21469":123598,"_5":14752,"_28187":123576,"_3059":123599},[],"Relación",{"_3604":73629,"_31000":73620,"_21469":123601,"_5":14752,"_28187":123576,"_3059":123602},[],"Material que prepara el responsable",{"_3604":73630,"_31000":73620,"_21469":123604,"_5":14752,"_28187":123576,"_3059":123605},[],"Dispositivo → servidor EST",{"_3604":73631,"_31000":73620,"_21469":123607,"_5":14752,"_28187":123576,"_3059":123608},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3604":73632,"_31000":73620,"_21469":123610,"_5":14752,"_28187":123576,"_3059":123611},[],"DMS → solicitante",{"_3604":73633,"_31000":73620,"_21469":123613,"_5":14752,"_28187":123576,"_3059":123614},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3604":73634,"_31000":73620,"_21469":123616,"_5":14752,"_28187":123576,"_3059":123617},[],"Consumidor → dispositivo",{"_3604":73635,"_31000":73620,"_21469":123619,"_5":14752,"_28187":123576,"_3059":123620},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3604":73636,"_31000":73620,"_21469":123622,"_5":14752,"_28187":123576,"_3059":123623},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3604":73637,"_31000":73620,"_21469":123625,"_5":14752,"_28187":123580,"_3059":123626},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3604":73638,"_31000":73620,"_21469":123628,"_5":14752,"_28187":123580,"_3059":123629},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3604":73639,"_31000":73620,"_21469":123631,"_5":14752,"_28187":123584,"_3059":123632},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3604":73640,"_31000":73620,"_21469":123634,"_5":14752,"_28187":123584,"_3059":123635},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3604":73641,"_31000":73620,"_21469":123637,"_5":14752,"_28187":123584,"_3059":123638},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3604":73642,"_31000":73620,"_21469":123640,"_5":14752,"_28187":123584,"_3059":123641},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3604":73643,"_31000":73620,"_21469":123643,"_5":14752,"_28187":123584,"_3059":123644},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3604":73644,"_31000":73620,"_21469":123646,"_5":14752,"_28187":123584,"_3059":123647},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3604":73645,"_31000":73620,"_21469":123649,"_5":14752,"_28187":123588,"_3059":123650},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3604":73646,"_31000":73620,"_21469":123652,"_5":14752,"_28187":123588,"_3059":123653},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3604":73647,"_31000":73620,"_21469":123655,"_5":14752,"_28187":123588,"_3059":123656},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3604":73648,"_31000":73620,"_21469":123658,"_5":14752,"_28187":123592,"_3059":123659},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3604":73649,"_31000":73649,"_5":15112,"_3059":54817,"_31359":123661,"_21469":123663,"_28187":73649},[50673,121110,53357,122255,123662],"Integraciones",[],{"_3604":73650,"_31000":73649,"_21469":123665,"_5":14752,"_28187":73649,"_3059":123666},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3604":73651,"_31000":73649,"_5":31356,"_21469":123668,"_28187":123669,"_3059":123670},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3604":73652,"_31000":73649,"_5":31356,"_21469":123672,"_28187":123673,"_3059":123674},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3604":73653,"_31000":73649,"_5":31356,"_21469":123676,"_28187":123677,"_3059":123678},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3604":73654,"_31000":73649,"_5":31356,"_21469":123680,"_28187":123681,"_3059":123682},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3604":73655,"_31000":73649,"_5":31356,"_21469":123684,"_28187":123685,"_3059":123686},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3604":73656,"_31000":73649,"_5":31356,"_21469":123688,"_28187":123689,"_3059":123690},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3604":73657,"_31000":73649,"_5":31356,"_21469":123692,"_28187":123693,"_3059":123694},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3604":73658,"_31000":73649,"_5":31356,"_21469":123696,"_28187":123697,"_3059":123698},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3604":73659,"_31000":73649,"_5":31356,"_21469":123700,"_28187":123701,"_3059":54859},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3604":73660,"_31000":73649,"_5":31356,"_21469":123703,"_28187":123704,"_3059":54863},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3604":73661,"_31000":73649,"_5":31356,"_21469":123706,"_28187":123707,"_3059":123708},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3604":73662,"_31000":73649,"_5":31356,"_21469":123710,"_28187":123711,"_3059":123712},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3604":73663,"_31000":73649,"_5":31356,"_21469":123714,"_28187":123715,"_3059":123716},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3604":73664,"_31000":73649,"_5":31356,"_21469":123718,"_28187":123719,"_3059":123720},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3604":73665,"_31000":73649,"_5":31356,"_21469":123722,"_28187":123723,"_3059":123724},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3604":73666,"_31000":73649,"_5":31356,"_21469":123726,"_28187":123727,"_3059":123728},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3604":73667,"_31000":73649,"_5":31356,"_21469":123730,"_28187":123731,"_3059":123732},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3604":73668,"_31000":73649,"_5":31356,"_21469":123734,"_28187":123735,"_3059":123736},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3604":73669,"_31000":73649,"_5":31356,"_21469":123738,"_28187":123739,"_3059":123740},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3604":73670,"_31000":73649,"_5":31356,"_21469":123742,"_28187":123743,"_3059":123744},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3604":73671,"_31000":73649,"_5":31356,"_21469":123746,"_28187":123747,"_3059":123748},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3604":73672,"_31000":73649,"_5":31356,"_21469":123750,"_28187":123751,"_3059":123752},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3604":73673,"_31000":73649,"_5":31356,"_21469":123754,"_28187":123755,"_3059":123756},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3604":73674,"_31000":73649,"_5":31356,"_21469":123758,"_28187":123759,"_3059":123760},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3604":73675,"_31000":73649,"_5":31356,"_21469":123762,"_28187":123763,"_3059":123764},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3604":73676,"_31000":73649,"_21469":123766,"_5":14752,"_28187":73649,"_3059":123767},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3604":73677,"_31000":73649,"_21469":123769,"_5":14752,"_28187":73649,"_3059":123770},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3604":73678,"_31000":73649,"_21469":123772,"_5":14752,"_28187":73649,"_3059":123773},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3604":73679,"_31000":73649,"_21469":123775,"_5":14752,"_28187":123669,"_3059":123776},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3604":73680,"_31000":73649,"_21469":123778,"_5":14752,"_28187":123669,"_3059":123779},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3604":73681,"_31000":73649,"_21469":123781,"_5":14752,"_28187":123669,"_3059":123782},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3604":73682,"_31000":73649,"_21469":123784,"_5":14752,"_28187":123669,"_3059":123785},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3604":73683,"_31000":73649,"_21469":123787,"_5":14752,"_28187":123673,"_3059":123788},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3604":73684,"_31000":73649,"_21469":123790,"_5":14752,"_28187":123677,"_3059":123791},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3604":73685,"_31000":73649,"_21469":123793,"_5":14752,"_28187":123677,"_3059":123794},[],"Acción IAM",{"_3604":73686,"_31000":73649,"_21469":123796,"_5":14752,"_28187":123677,"_3059":120014},[],{"_3604":73687,"_31000":73649,"_21469":123798,"_5":14752,"_28187":123677,"_3059":54958},[],{"_3604":73688,"_31000":73649,"_21469":123800,"_5":14752,"_28187":123677,"_3059":123801},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3604":73689,"_31000":73649,"_21469":123803,"_5":14752,"_28187":123677,"_3059":54964},[],{"_3604":73690,"_31000":73649,"_21469":123805,"_5":14752,"_28187":123677,"_3059":123806},[],"Registrar la CA en AWS IoT",{"_3604":73691,"_31000":73649,"_21469":123808,"_5":14752,"_28187":123677,"_3059":54970},[],{"_3604":73692,"_31000":73649,"_21469":123810,"_5":14752,"_28187":123677,"_3059":123811},[],"Consultar el estado del registro de la CA",{"_3604":73693,"_31000":73649,"_21469":123813,"_5":14752,"_28187":123677,"_3059":54976},[],{"_3604":73694,"_31000":73649,"_21469":123815,"_5":14752,"_28187":123677,"_3059":123816},[],"Crear o actualizar Things en IoT Core",{"_3604":73695,"_31000":73649,"_21469":123818,"_5":14752,"_28187":123677,"_3059":54982},[],{"_3604":73696,"_31000":73649,"_21469":123820,"_5":14752,"_28187":123677,"_3059":123821},[],"Aprovisionar Things mediante plantilla",{"_3604":73697,"_31000":73649,"_21469":123823,"_5":14752,"_28187":123677,"_3059":54988},[],{"_3604":73698,"_31000":73649,"_21469":123825,"_5":14752,"_28187":123677,"_3059":123826},[],"Registrar certificados de dispositivo",{"_3604":73699,"_31000":73649,"_21469":123828,"_5":14752,"_28187":123677,"_3059":54994},[],{"_3604":73700,"_31000":73649,"_21469":123830,"_5":14752,"_28187":123677,"_3059":123831},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3604":73701,"_31000":73649,"_21469":123833,"_5":14752,"_28187":123677,"_3059":55000},[],{"_3604":73702,"_31000":73649,"_21469":123835,"_5":14752,"_28187":123677,"_3059":123836},[],"Crear y adjuntar políticas IoT",{"_3604":73703,"_31000":73649,"_21469":123838,"_5":14752,"_28187":123677,"_3059":55006},[],{"_3604":73704,"_31000":73649,"_21469":123840,"_5":14752,"_28187":123677,"_3059":123841},[],"Gestionar grupos de Things",{"_3604":73705,"_31000":73649,"_21469":123843,"_5":14752,"_28187":123677,"_3059":55012},[],{"_3604":73706,"_31000":73649,"_21469":123845,"_5":14752,"_28187":123677,"_3059":123846},[],"Crear plantillas JITP",{"_3604":73707,"_31000":73649,"_21469":123848,"_5":14752,"_28187":123677,"_3059":55018},[],{"_3604":73708,"_31000":73649,"_21469":123850,"_5":14752,"_28187":123677,"_3059":123851},[],"Leer y escribir el Device Shadow",{"_3604":73709,"_31000":73649,"_21469":123853,"_5":14752,"_28187":123677,"_3059":123854},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3604":73710,"_31000":73649,"_21469":123856,"_5":14752,"_28187":123681,"_3059":123857},[],"Parámetro",{"_3604":73711,"_31000":73649,"_21469":123859,"_5":14752,"_28187":123681,"_3059":123860},[],"Tipo",{"_3604":73712,"_31000":73649,"_21469":123862,"_5":14752,"_28187":123681,"_3059":123863},[],"Requerido",{"_3604":73713,"_31000":73649,"_21469":123865,"_5":14752,"_28187":123681,"_3059":123866},[],"Descripción",{"_3604":73714,"_31000":73649,"_21469":123868,"_5":14752,"_28187":123681,"_3059":55039},[],{"_3604":73715,"_31000":73649,"_21469":123870,"_5":14752,"_28187":123681,"_3059":25627},[],{"_3604":73716,"_31000":73649,"_21469":123872,"_5":14752,"_28187":123681,"_3059":123873},[],"Sí",{"_3604":73717,"_31000":73649,"_21469":123875,"_5":14752,"_28187":123681,"_3059":123876},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3604":73718,"_31000":73649,"_21469":123878,"_5":14752,"_28187":123681,"_3059":55050},[],{"_3604":73719,"_31000":73649,"_21469":123880,"_5":14752,"_28187":123681,"_3059":25627},[],{"_3604":73720,"_31000":73649,"_21469":123882,"_5":14752,"_28187":123681,"_3059":123873},[],{"_3604":73721,"_31000":73649,"_21469":123884,"_5":14752,"_28187":123681,"_3059":123885},[],"Región AWS donde opera el conector.",{"_3604":73722,"_31000":73649,"_21469":123887,"_5":14752,"_28187":123681,"_3059":55060},[],{"_3604":73723,"_31000":73649,"_21469":123889,"_5":14752,"_28187":123681,"_3059":25627},[],{"_3604":73724,"_31000":73649,"_21469":123891,"_5":14752,"_28187":123681,"_3059":123873},[],{"_3604":73725,"_31000":73649,"_21469":123893,"_5":14752,"_28187":123681,"_3059":123894},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3604":73726,"_31000":73649,"_21469":123896,"_5":14752,"_28187":123681,"_3059":55070},[],{"_3604":73727,"_31000":73649,"_21469":123898,"_5":14752,"_28187":123681,"_3059":25627},[],{"_3604":73728,"_31000":73649,"_21469":123900,"_5":14752,"_28187":123681,"_3059":123901},[],"Solo con `auth_method=static`",{"_3604":73729,"_31000":73649,"_21469":123903,"_5":14752,"_28187":123681,"_3059":123904},[],"Clave de acceso AWS.",{"_3604":73730,"_31000":73649,"_21469":123906,"_5":14752,"_28187":123681,"_3059":55081},[],{"_3604":73731,"_31000":73649,"_21469":123908,"_5":14752,"_28187":123681,"_3059":25627},[],{"_3604":73732,"_31000":73649,"_21469":123910,"_5":14752,"_28187":123681,"_3059":123901},[],{"_3604":73733,"_31000":73649,"_21469":123912,"_5":14752,"_28187":123681,"_3059":123913},[],"Clave secreta AWS.",{"_3604":73734,"_31000":73649,"_21469":123915,"_5":14752,"_28187":123681,"_3059":55091},[],{"_3604":73735,"_31000":73649,"_21469":123917,"_5":14752,"_28187":123681,"_3059":25627},[],{"_3604":73736,"_31000":73649,"_21469":123919,"_5":14752,"_28187":123681,"_3059":55096},[],{"_3604":73737,"_31000":73649,"_21469":123921,"_5":14752,"_28187":123681,"_3059":123922},[],"Token de sesión (con `auth_method=static`).",{"_3604":73738,"_31000":73649,"_21469":123924,"_5":14752,"_28187":123681,"_3059":55102},[],{"_3604":73739,"_31000":73649,"_21469":123926,"_5":14752,"_28187":123681,"_3059":25627},[],{"_3604":73740,"_31000":73649,"_21469":123928,"_5":14752,"_28187":123681,"_3059":123929},[],"Solo con `auth_method=role`",{"_3604":73741,"_31000":73649,"_21469":123931,"_5":14752,"_28187":123681,"_3059":123932},[],"ARN del rol a asumir.",{"_3604":73742,"_31000":73649,"_21469":123934,"_5":14752,"_28187":123681,"_3059":55113},[],{"_3604":73743,"_31000":73649,"_21469":123936,"_5":14752,"_28187":123681,"_3059":25627},[],{"_3604":73744,"_31000":73649,"_21469":123938,"_5":14752,"_28187":123681,"_3059":55096},[],{"_3604":73745,"_31000":73649,"_21469":123940,"_5":14752,"_28187":123681,"_3059":123941},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3604":73746,"_31000":73649,"_21469":123943,"_5":14752,"_28187":123681,"_3059":55123},[],{"_3604":73747,"_31000":73649,"_21469":123945,"_5":14752,"_28187":123681,"_3059":92408},[],{"_3604":73748,"_31000":73649,"_21469":123947,"_5":14752,"_28187":123681,"_3059":123873},[],{"_3604":73749,"_31000":73649,"_21469":123949,"_5":14752,"_28187":123681,"_3059":123950},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3604":73750,"_31000":73649,"_21469":123952,"_5":14752,"_28187":123681,"_3059":55133},[],{"_3604":73751,"_31000":73649,"_21469":123954,"_5":14752,"_28187":123681,"_3059":25627},[],{"_3604":73752,"_31000":73649,"_21469":123956,"_5":14752,"_28187":123681,"_3059":123873},[],{"_3604":73753,"_31000":73649,"_21469":123958,"_5":14752,"_28187":123681,"_3059":123959},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3604":73754,"_31000":73649,"_21469":123961,"_5":14752,"_28187":123681,"_3059":55143},[],{"_3604":73755,"_31000":73649,"_21469":123963,"_5":14752,"_28187":123681,"_3059":25627},[],{"_3604":73756,"_31000":73649,"_21469":123965,"_5":14752,"_28187":123681,"_3059":123873},[],{"_3604":73757,"_31000":73649,"_21469":123967,"_5":14752,"_28187":123681,"_3059":123968},[],"URL HTTP del Device Manager de Lamassu.",{"_3604":73758,"_31000":73649,"_21469":123970,"_5":14752,"_28187":123681,"_3059":55153},[],{"_3604":73759,"_31000":73649,"_21469":123972,"_5":14752,"_28187":123681,"_3059":25627},[],{"_3604":73760,"_31000":73649,"_21469":123974,"_5":14752,"_28187":123681,"_3059":123873},[],{"_3604":73761,"_31000":73649,"_21469":123976,"_5":14752,"_28187":123681,"_3059":123977},[],"URL HTTP del servicio de CA de Lamassu.",{"_3604":73762,"_31000":73649,"_21469":123979,"_5":14752,"_28187":123685,"_3059":123980},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3604":73763,"_31000":73649,"_21469":123982,"_5":14752,"_28187":123685,"_3059":123983},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3604":73764,"_31000":73649,"_21469":123985,"_5":14752,"_28187":123685,"_3059":123986},[],"Tipo de CloudEvent",{"_3604":73765,"_31000":73649,"_21469":123988,"_5":14752,"_28187":123685,"_3059":123989},[],"Recurso en Lamassu",{"_3604":73766,"_31000":73649,"_21469":123991,"_5":14752,"_28187":123685,"_3059":123992},[],"Recurso AWS",{"_3604":73767,"_31000":73649,"_21469":123994,"_5":14752,"_28187":123685,"_3059":123995},[],"Acciones IAM",{"_3604":73768,"_31000":73649,"_21469":123997,"_5":14752,"_28187":123685,"_3059":123998},[],"Llamadas AWS y efecto",{"_3604":73769,"_31000":73649,"_21469":124000,"_5":14752,"_28187":123685,"_3059":124001},[],"Dónde en esta página",{"_3604":73770,"_31000":73649,"_21469":124003,"_5":14752,"_28187":123685,"_3059":55187},[],{"_3604":73771,"_31000":73649,"_21469":124005,"_5":14752,"_28187":123685,"_3059":55190},[],{"_3604":73772,"_31000":73649,"_21469":124007,"_5":14752,"_28187":123685,"_3059":55193},[],{"_3604":73773,"_31000":73649,"_21469":124009,"_5":14752,"_28187":123685,"_3059":55196},[],{"_3604":73774,"_31000":73649,"_21469":124011,"_5":14752,"_28187":123685,"_3059":124012},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3604":73775,"_31000":73649,"_21469":124014,"_5":14752,"_28187":123685,"_3059":123698},[],{"_3604":73776,"_31000":73649,"_21469":124016,"_5":14752,"_28187":123685,"_3059":55204},[],{"_3604":73777,"_31000":73649,"_21469":124018,"_5":14752,"_28187":123685,"_3059":55207},[],{"_3604":73778,"_31000":73649,"_21469":124020,"_5":14752,"_28187":123685,"_3059":55210},[],{"_3604":73779,"_31000":73649,"_21469":124022,"_5":14752,"_28187":123685,"_3059":55213},[],{"_3604":73780,"_31000":73649,"_21469":124024,"_5":14752,"_28187":123685,"_3059":124025},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3604":73781,"_31000":73649,"_21469":124027,"_5":14752,"_28187":123685,"_3059":123724},[],{"_3604":73782,"_31000":73649,"_21469":124029,"_5":14752,"_28187":123685,"_3059":55221},[],{"_3604":73783,"_31000":73649,"_21469":124031,"_5":14752,"_28187":123685,"_3059":124032},[],"Dispositivo",{"_3604":73784,"_31000":73649,"_21469":124034,"_5":14752,"_28187":123685,"_3059":55227},[],{"_3604":73785,"_31000":73649,"_21469":124036,"_5":14752,"_28187":123685,"_3059":55230},[],{"_3604":73786,"_31000":73649,"_21469":124038,"_5":14752,"_28187":123685,"_3059":124039},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3604":73787,"_31000":73649,"_21469":124041,"_5":14752,"_28187":123685,"_3059":123732},[],{"_3604":73788,"_31000":73649,"_21469":124043,"_5":14752,"_28187":123685,"_3059":55238},[],{"_3604":73789,"_31000":73649,"_21469":124045,"_5":14752,"_28187":123685,"_3059":124046},[],"Certificado",{"_3604":73790,"_31000":73649,"_21469":124048,"_5":14752,"_28187":123685,"_3059":55244},[],{"_3604":73791,"_31000":73649,"_21469":124050,"_5":14752,"_28187":123685,"_3059":124051},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3604":73792,"_31000":73649,"_21469":124053,"_5":14752,"_28187":123685,"_3059":124054},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3604":73793,"_31000":73649,"_21469":124056,"_5":14752,"_28187":123685,"_3059":123744},[],{"_3604":73794,"_31000":73649,"_21469":124058,"_5":14752,"_28187":123685,"_3059":55255},[],{"_3604":73795,"_31000":73649,"_21469":124060,"_5":14752,"_28187":123685,"_3059":124061},[],"Certificado / Dispositivo",{"_3604":73796,"_31000":73649,"_21469":124063,"_5":14752,"_28187":123685,"_3059":55261},[],{"_3604":73797,"_31000":73649,"_21469":124065,"_5":14752,"_28187":123685,"_3059":51069},[],{"_3604":73798,"_31000":73649,"_21469":124067,"_5":14752,"_28187":123685,"_3059":124068},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3604":73799,"_31000":73649,"_21469":124070,"_5":14752,"_28187":123685,"_3059":123752},[],{"_3604":73800,"_31000":73649,"_21469":124072,"_5":14752,"_28187":123689,"_3059":124073},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3604":73801,"_31000":73649,"_21469":124075,"_5":14752,"_28187":123693,"_3059":124076},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3604":73802,"_31000":73649,"_21469":124078,"_5":14752,"_28187":123693,"_3059":124079},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3604":73803,"_31000":73649,"_21469":124081,"_5":14752,"_28187":123697,"_3059":124082},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3604":73804,"_31000":73649,"_21469":124084,"_5":14752,"_28187":123697,"_3059":124085},[],"Transición",{"_3604":73805,"_31000":73649,"_21469":124087,"_5":14752,"_28187":123697,"_3059":124088},[],"Llamadas AWS",{"_3604":73806,"_31000":73649,"_21469":124090,"_5":14752,"_28187":123697,"_3059":124091},[],"`NoRegistrada` → `Solicitada`",{"_3604":73807,"_31000":73649,"_21469":124093,"_5":14752,"_28187":123697,"_3059":124094},[],"ninguna (solo escritura de metadatos)",{"_3604":73808,"_31000":73649,"_21469":124096,"_5":14752,"_28187":123697,"_3059":124097},[],"`Solicitada` → `Registrando`",{"_3604":73809,"_31000":73649,"_21469":124099,"_5":14752,"_28187":123697,"_3059":124100},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3604":73810,"_31000":73649,"_21469":124102,"_5":14752,"_28187":123697,"_3059":124103},[],"`Registrando` → `Completada`",{"_3604":73811,"_31000":73649,"_21469":124105,"_5":14752,"_28187":123697,"_3059":124106},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3604":73812,"_31000":73649,"_21469":124108,"_5":14752,"_28187":123697,"_3059":124109},[],"`Registrando` → `Fallida`",{"_3604":73813,"_31000":73649,"_21469":124111,"_5":14752,"_28187":123697,"_3059":124112},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3604":73814,"_31000":73649,"_21469":124114,"_5":14752,"_28187":123697,"_3059":124115},[],"`Fallida` / `Completada` → `Solicitada`",{"_3604":73815,"_31000":73649,"_21469":124117,"_5":14752,"_28187":123697,"_3059":124118},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3604":73816,"_31000":73649,"_21469":124120,"_5":14752,"_28187":123701,"_3059":124121},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3604":73817,"_31000":73649,"_21469":124123,"_5":14752,"_28187":123701,"_3059":124124},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3604":73818,"_31000":73649,"_21469":124126,"_5":14752,"_28187":123701,"_3059":124127},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3604":73819,"_31000":73649,"_21469":124129,"_5":14752,"_28187":123701,"_3059":124130},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3604":73820,"_31000":73649,"_21469":124132,"_5":14752,"_28187":123701,"_3059":124133},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3604":73821,"_31000":73649,"_21469":124135,"_5":14752,"_28187":123701,"_3059":124136},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3604":73822,"_31000":73649,"_21469":124138,"_5":14752,"_28187":123704,"_3059":124139},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3604":73823,"_31000":73649,"_21469":124141,"_5":14752,"_28187":123707,"_3059":124142},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3604":73824,"_31000":73649,"_21469":124144,"_5":14752,"_28187":123707,"_3059":124145},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3604":73825,"_31000":73649,"_21469":124147,"_5":14752,"_28187":123711,"_3059":124148},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3604":73826,"_31000":73649,"_21469":124150,"_5":14752,"_28187":123715,"_3059":124151},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3604":73827,"_31000":73649,"_21469":124153,"_5":14752,"_28187":123715,"_3059":124154},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3604":73828,"_31000":73649,"_21469":124156,"_5":14752,"_28187":123715,"_3059":124157},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3604":73829,"_31000":73649,"_21469":124159,"_5":14752,"_28187":123715,"_3059":124160},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3604":73830,"_31000":73649,"_21469":124162,"_5":14752,"_28187":123715,"_3059":124163},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3604":73831,"_31000":73649,"_21469":124165,"_5":14752,"_28187":123715,"_3059":124166},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3604":73832,"_31000":73649,"_21469":124168,"_5":14752,"_28187":123719,"_3059":124169},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3604":73833,"_31000":73649,"_21469":124171,"_5":14752,"_28187":123719,"_3059":124172},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3604":73834,"_31000":73649,"_21469":124174,"_5":14752,"_28187":123719,"_3059":124175},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3604":73835,"_31000":73649,"_21469":124177,"_5":14752,"_28187":123719,"_3059":124178},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3604":73836,"_31000":73649,"_21469":124180,"_5":14752,"_28187":123719,"_3059":124181},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3604":73837,"_31000":73649,"_21469":124183,"_5":14752,"_28187":123723,"_3059":124184},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3604":73838,"_31000":73649,"_21469":124186,"_5":14752,"_28187":123723,"_3059":124085},[],{"_3604":73839,"_31000":73649,"_21469":124188,"_5":14752,"_28187":123723,"_3059":124088},[],{"_3604":73840,"_31000":73649,"_21469":124190,"_5":14752,"_28187":123723,"_3059":124191},[],"`SinConfigurar` → `None` / `Auto`",{"_3604":73841,"_31000":73649,"_21469":124193,"_5":14752,"_28187":123723,"_3059":124194},[],"ninguna (solo configuración)",{"_3604":73842,"_31000":73649,"_21469":124196,"_5":14752,"_28187":123723,"_3059":55398},[],{"_3604":73843,"_31000":73649,"_21469":124198,"_5":14752,"_28187":123723,"_3059":124194},[],{"_3604":73844,"_31000":73649,"_21469":124200,"_5":14752,"_28187":123723,"_3059":124201},[],"Cualquiera → `Jitp`",{"_3604":73845,"_31000":73649,"_21469":124203,"_5":14752,"_28187":123723,"_3059":124204},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3604":73846,"_31000":73649,"_21469":124206,"_5":14752,"_28187":123723,"_3059":55409},[],{"_3604":73847,"_31000":73649,"_21469":124208,"_5":14752,"_28187":123723,"_3059":124209},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3604":73848,"_31000":73649,"_21469":124211,"_5":14752,"_28187":123727,"_3059":124212},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3604":73849,"_31000":73649,"_21469":124214,"_5":14752,"_28187":123727,"_3059":124215},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3604":73850,"_31000":73649,"_21469":124217,"_5":14752,"_28187":123727,"_3059":124218},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3604":73851,"_31000":73649,"_21469":124220,"_5":14752,"_28187":123731,"_3059":124221},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3604":73852,"_31000":73649,"_21469":124223,"_5":14752,"_28187":123731,"_3059":124085},[],{"_3604":73853,"_31000":73649,"_21469":124225,"_5":14752,"_28187":123731,"_3059":124088},[],{"_3604":73854,"_31000":73649,"_21469":124227,"_5":14752,"_28187":123731,"_3059":124228},[],"`Ausente` → `Aprovisionado`",{"_3604":73855,"_31000":73649,"_21469":124230,"_5":14752,"_28187":123731,"_3059":124231},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3604":73856,"_31000":73649,"_21469":124233,"_5":14752,"_28187":123731,"_3059":124234},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3604":73857,"_31000":73649,"_21469":124236,"_5":14752,"_28187":123731,"_3059":124237},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3604":73858,"_31000":73649,"_21469":124239,"_5":14752,"_28187":123731,"_3059":124240},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3604":73859,"_31000":73649,"_21469":124242,"_5":14752,"_28187":123735,"_3059":124243},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3604":73860,"_31000":73649,"_21469":124245,"_5":14752,"_28187":123735,"_3059":124246},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3604":73861,"_31000":73649,"_21469":124248,"_5":14752,"_28187":123735,"_3059":124249},[],"Para que el flujo JITP funcione correctamente:",{"_3604":73862,"_31000":73649,"_21469":124251,"_5":14752,"_28187":123735,"_3059":124252},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3604":73863,"_31000":73649,"_21469":124254,"_5":14752,"_28187":123735,"_3059":124255},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3604":73864,"_31000":73649,"_21469":124257,"_5":14752,"_28187":123735,"_3059":124258},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3604":73865,"_31000":73649,"_21469":124260,"_5":14752,"_28187":123735,"_3059":124261},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3604":73866,"_31000":73649,"_21469":124263,"_5":14752,"_28187":123739,"_3059":124264},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3604":73867,"_31000":73649,"_21469":124266,"_5":14752,"_28187":123739,"_3059":124267},[],"Estado en Lamassu",{"_3604":73868,"_31000":73649,"_21469":124269,"_5":14752,"_28187":123739,"_3059":124270},[],"Razón de revocación",{"_3604":73869,"_31000":73649,"_21469":124272,"_5":14752,"_28187":123739,"_3059":124273},[],"Estado en AWS IoT Core",{"_3604":73870,"_31000":73649,"_21469":124275,"_5":14752,"_28187":123739,"_3059":55479},[],{"_3604":73871,"_31000":73649,"_21469":124277,"_5":14752,"_28187":123739,"_3059":124278},[],"Ninguna",{"_3604":73872,"_31000":73649,"_21469":124280,"_5":14752,"_28187":123739,"_3059":55485},[],{"_3604":73873,"_31000":73649,"_21469":124282,"_5":14752,"_28187":123739,"_3059":55488},[],{"_3604":73874,"_31000":73649,"_21469":124284,"_5":14752,"_28187":123739,"_3059":55491},[],{"_3604":73875,"_31000":73649,"_21469":124286,"_5":14752,"_28187":123739,"_3059":55494},[],{"_3604":73876,"_31000":73649,"_21469":124288,"_5":14752,"_28187":123739,"_3059":55488},[],{"_3604":73877,"_31000":73649,"_21469":124290,"_5":14752,"_28187":123739,"_3059":124291},[],"Cualquier otra razón",{"_3604":73878,"_31000":73649,"_21469":124293,"_5":14752,"_28187":123739,"_3059":55502},[],{"_3604":73879,"_31000":73649,"_21469":124295,"_5":14752,"_28187":123739,"_3059":124296},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3604":73880,"_31000":73649,"_21469":124298,"_5":14752,"_28187":123743,"_3059":124299},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3604":73881,"_31000":73649,"_21469":124301,"_5":14752,"_28187":123743,"_3059":124085},[],{"_3604":73882,"_31000":73649,"_21469":124303,"_5":14752,"_28187":123743,"_3059":124088},[],{"_3604":73883,"_31000":73649,"_21469":124305,"_5":14752,"_28187":123743,"_3059":124306},[],"`NoSincronizado` → `Active`",{"_3604":73884,"_31000":73649,"_21469":124308,"_5":14752,"_28187":123743,"_3059":54994},[],{"_3604":73885,"_31000":73649,"_21469":124310,"_5":14752,"_28187":123743,"_3059":55520},[],{"_3604":73886,"_31000":73649,"_21469":124312,"_5":14752,"_28187":123743,"_3059":124313},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3604":73887,"_31000":73649,"_21469":124315,"_5":14752,"_28187":123743,"_3059":55526},[],{"_3604":73888,"_31000":73649,"_21469":124317,"_5":14752,"_28187":123743,"_3059":124313},[],{"_3604":73889,"_31000":73649,"_21469":124319,"_5":14752,"_28187":123743,"_3059":55531},[],{"_3604":73890,"_31000":73649,"_21469":124321,"_5":14752,"_28187":123743,"_3059":54994},[],{"_3604":73891,"_31000":73649,"_21469":124323,"_5":14752,"_28187":123743,"_3059":55536},[],{"_3604":73892,"_31000":73649,"_21469":124325,"_5":14752,"_28187":123743,"_3059":124326},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3604":73893,"_31000":73649,"_21469":124328,"_5":14752,"_28187":123747,"_3059":124329},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3604":73894,"_31000":73649,"_21469":124331,"_5":14752,"_28187":123747,"_3059":124332},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3604":73895,"_31000":73649,"_21469":124334,"_5":14752,"_28187":123747,"_3059":124335},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3604":73896,"_31000":73649,"_21469":124337,"_5":14752,"_28187":123751,"_3059":124338},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3604":73897,"_31000":73649,"_21469":124340,"_5":14752,"_28187":123751,"_3059":124341},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3604":73898,"_31000":73649,"_21469":124343,"_5":14752,"_28187":123755,"_3059":124344},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3604":73899,"_31000":73649,"_21469":124346,"_5":14752,"_28187":123755,"_3059":124347},[],"Existen dos tipos de acciones:",{"_3604":73900,"_31000":73649,"_21469":124349,"_5":14752,"_28187":123755,"_3059":124350},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3604":73901,"_31000":73649,"_21469":124352,"_5":14752,"_28187":123755,"_3059":124353},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3604":73902,"_31000":73649,"_21469":124355,"_5":14752,"_28187":123755,"_3059":124356},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3604":73903,"_31000":73649,"_21469":124358,"_5":14752,"_28187":123759,"_3059":124359},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3604":73904,"_31000":73649,"_21469":124361,"_5":14752,"_28187":123759,"_3059":124362},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3604":73905,"_31000":73649,"_21469":124364,"_5":14752,"_28187":123759,"_3059":124365},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3604":73906,"_31000":73649,"_21469":124367,"_5":14752,"_28187":123763,"_3059":124368},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3604":73907,"_31000":73649,"_21469":124370,"_5":14752,"_28187":123763,"_3059":124371},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3604":73908,"_31000":73649,"_21469":124373,"_5":14752,"_28187":123763,"_3059":124374},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3604":73909,"_31000":73649,"_21469":124376,"_5":14752,"_28187":123763,"_3059":124377},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3604":73910,"_31000":73649,"_21469":124379,"_5":14752,"_28187":123763,"_3059":124380},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3604":73911,"_31000":73649,"_21469":124382,"_5":14752,"_28187":123763,"_3059":124383},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3604":73912,"_31000":73649,"_21469":124385,"_5":14752,"_28187":123763,"_3059":124386},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3604":73913,"_31000":73649,"_21469":124388,"_5":14752,"_28187":123763,"_3059":124389},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3604":73914,"_31000":73649,"_21469":124391,"_5":14752,"_28187":123763,"_3059":124392},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3604":73915,"_31000":73649,"_21469":124394,"_5":14752,"_28187":123763,"_3059":124395},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3604":73916,"_31000":73649,"_21469":124397,"_5":14752,"_28187":123763,"_3059":124398},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3604":73917,"_31000":73649,"_21469":124400,"_5":14752,"_28187":123763,"_3059":124401},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3604":73918,"_31000":73649,"_21469":124403,"_5":14752,"_28187":123763,"_3059":124404},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3604":73919,"_31000":73649,"_21469":124406,"_5":14752,"_28187":123763,"_3059":124407},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3604":73920,"_31000":73649,"_21469":124409,"_5":14752,"_28187":123763,"_3059":124410},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3604":73921,"_31000":73649,"_21469":124412,"_5":14752,"_28187":123763,"_3059":124413},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3604":73922,"_31000":73649,"_21469":124415,"_5":14752,"_28187":123763,"_3059":124416},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3604":73923,"_31000":73649,"_21469":124418,"_5":14752,"_28187":123763,"_3059":124419},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3604":73924,"_31000":73649,"_21469":124421,"_5":14752,"_28187":123763,"_3059":124422},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3604":73925,"_31000":73649,"_21469":124424,"_5":14752,"_28187":123763,"_3059":124425},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3604":73926,"_31000":73649,"_21469":124427,"_5":14752,"_28187":123763,"_3059":124428},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3604":73927,"_31000":73649,"_21469":124430,"_5":14752,"_28187":123763,"_3059":124431},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3604":73928,"_31000":73649,"_21469":124433,"_5":14752,"_28187":123763,"_3059":124434},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3604":73929,"_31000":73649,"_21469":124436,"_5":14752,"_28187":123763,"_3059":124437},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3604":73930,"_31000":73930,"_5":15112,"_3059":53357,"_31359":124439,"_21469":124440,"_28187":73930},[50673,121110,53357],[],{"_3604":73931,"_31000":73930,"_21469":124442,"_5":14752,"_28187":73930,"_3059":124443},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3604":73932,"_31000":73930,"_5":31356,"_21469":124445,"_28187":124446,"_3059":124447},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3604":73933,"_31000":73930,"_5":31356,"_21469":124449,"_28187":124450,"_3059":122255},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3604":73934,"_31000":73930,"_5":31356,"_21469":124452,"_28187":124453,"_3059":122430},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3604":73935,"_31000":73930,"_5":31356,"_21469":124455,"_28187":124456,"_3059":123662},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#integraciones",{"_3604":73936,"_31000":73930,"_5":31356,"_21469":124458,"_28187":124459,"_3059":124460},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3604":73937,"_31000":73930,"_21469":124462,"_5":14752,"_28187":73930,"_3059":124463},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3604":73938,"_31000":73930,"_21469":124465,"_5":14752,"_28187":124446,"_3059":124466},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3604":73939,"_31000":73930,"_21469":124468,"_5":14752,"_28187":124446,"_3059":124469},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3604":73940,"_31000":73930,"_21469":124471,"_5":14752,"_28187":124450,"_3059":124472},[],"Recurso",{"_3604":73941,"_31000":73930,"_21469":124474,"_5":14752,"_28187":124450,"_3059":124475},[],"Qué representa",{"_3604":73942,"_31000":73930,"_21469":124477,"_5":14752,"_28187":124450,"_3059":124478},[],"**Dispositivo**",{"_3604":73943,"_31000":73930,"_21469":124480,"_5":14752,"_28187":124450,"_3059":124481},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3604":73944,"_31000":73930,"_21469":124483,"_5":14752,"_28187":124450,"_3059":124484},[],"**Identidad**",{"_3604":73945,"_31000":73930,"_21469":124486,"_5":14752,"_28187":124450,"_3059":124487},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3604":73946,"_31000":73930,"_21469":124489,"_5":14752,"_28187":124450,"_3059":55703},[],{"_3604":73947,"_31000":73930,"_21469":124491,"_5":14752,"_28187":124450,"_3059":124492},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3604":73948,"_31000":73930,"_21469":124494,"_5":14752,"_28187":124450,"_3059":124495},[],"**Flota**",{"_3604":73949,"_31000":73930,"_21469":124497,"_5":14752,"_28187":124450,"_3059":124498},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3604":73950,"_31000":73930,"_21469":124500,"_5":14752,"_28187":124450,"_3059":124501},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3604":73951,"_31000":73930,"_21469":124503,"_5":14752,"_28187":124450,"_3059":124504},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3604":73952,"_31000":73930,"_21469":124506,"_5":14752,"_28187":124453,"_3059":124507},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3604":73953,"_31000":73930,"_21469":124509,"_5":14752,"_28187":124453,"_3059":124510},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3604":73954,"_31000":73930,"_21469":124512,"_5":14752,"_28187":124453,"_3059":124513},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3604":73955,"_31000":73930,"_21469":124515,"_5":14752,"_28187":124453,"_3059":124516},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3604":73956,"_31000":73930,"_21469":124518,"_5":14752,"_28187":124453,"_3059":124519},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3604":73957,"_31000":73930,"_21469":124521,"_5":14752,"_28187":124453,"_3059":124522},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3604":73958,"_31000":73930,"_21469":124524,"_5":14752,"_28187":124453,"_3059":124525},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3604":73959,"_31000":73930,"_21469":124527,"_5":14752,"_28187":124453,"_3059":124528},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3604":73960,"_31000":73930,"_21469":124530,"_5":14752,"_28187":124456,"_3059":124531},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3604":73961,"_31000":73930,"_21469":124533,"_5":14752,"_28187":124456,"_3059":124534},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3604":73962,"_31000":73930,"_21469":124536,"_5":14752,"_28187":124459,"_3059":124537},[],"Participante",{"_3604":73963,"_31000":73930,"_21469":124539,"_5":14752,"_28187":124459,"_3059":124540},[],"Responsabilidad",{"_3604":73964,"_31000":73930,"_21469":124542,"_5":14752,"_28187":124459,"_3059":124543},[],"Administrador PKI",{"_3604":73965,"_31000":73930,"_21469":124545,"_5":14752,"_28187":124459,"_3059":124546},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3604":73966,"_31000":73930,"_21469":124548,"_5":14752,"_28187":124459,"_3059":124549},[],"Administrador del aprovisionamiento",{"_3604":73967,"_31000":73930,"_21469":124551,"_5":14752,"_28187":124459,"_3059":124552},[],"DMS, admisión, autenticación por operación e inventario.",{"_3604":73968,"_31000":73930,"_21469":124554,"_5":14752,"_28187":124459,"_3059":124555},[],"Integrador del dispositivo",{"_3604":73969,"_31000":73930,"_21469":124557,"_5":14752,"_28187":124459,"_3059":124558},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3604":73970,"_31000":73930,"_21469":124560,"_5":14752,"_28187":124459,"_3059":124561},[],"Integrador del consumidor",{"_3604":73971,"_31000":73930,"_21469":124563,"_5":14752,"_28187":124459,"_3059":124564},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3604":73972,"_31000":73930,"_21469":124566,"_5":14752,"_28187":124459,"_3059":124567},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3604":73973,"_31000":73973,"_5":15112,"_3059":124569,"_31359":124570,"_21469":124572,"_28187":73973},"Enrola y conecta tu primer dispositivo",[50673,121110,53357,124571],"Primeros pasos",[],{"_3604":73974,"_31000":73973,"_21469":124574,"_5":14752,"_28187":73973,"_3059":124575},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3604":73975,"_31000":73973,"_5":31356,"_21469":124577,"_28187":124578,"_3059":119644},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3604":73976,"_31000":73973,"_5":31356,"_21469":124580,"_28187":124581,"_3059":124582},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3604":73977,"_31000":73973,"_5":31356,"_21469":124584,"_28187":124585,"_3059":124586},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3604":73978,"_31000":73973,"_5":31356,"_21469":124588,"_28187":124589,"_3059":124590},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3604":73979,"_31000":73973,"_5":31356,"_21469":124592,"_28187":124593,"_3059":124594},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3604":73980,"_31000":73973,"_5":31356,"_21469":124596,"_28187":124597,"_3059":124598},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3604":73981,"_31000":73973,"_5":31356,"_21469":124600,"_28187":124601,"_3059":124602},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3604":73982,"_31000":73973,"_5":31356,"_21469":124604,"_28187":124605,"_3059":124606},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3604":73983,"_31000":73973,"_21469":124608,"_5":14752,"_28187":73973,"_3059":124609},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3604":73984,"_31000":73973,"_21469":124611,"_5":14752,"_28187":124578,"_3059":124612},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3604":73985,"_31000":73973,"_21469":124614,"_5":14752,"_28187":124578,"_3059":124615},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3604":73986,"_31000":73973,"_21469":124617,"_5":14752,"_28187":124578,"_3059":124618},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3604":73987,"_31000":73973,"_21469":124620,"_5":14752,"_28187":124578,"_3059":124621},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3604":73988,"_31000":73973,"_21469":124623,"_5":14752,"_28187":124578,"_3059":124624},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3604":73989,"_31000":73973,"_21469":124626,"_5":14752,"_28187":124581,"_3059":124627},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3604":73990,"_31000":73973,"_21469":124629,"_5":14752,"_28187":124581,"_3059":124630},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3604":73991,"_31000":73973,"_21469":124632,"_5":14752,"_28187":124585,"_3059":124633},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3604":73992,"_31000":73973,"_21469":124635,"_5":14752,"_28187":124585,"_3059":124636},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3604":73993,"_31000":73973,"_21469":124638,"_5":14752,"_28187":124585,"_3059":124639},[],"Ajuste",{"_3604":73994,"_31000":73973,"_21469":124641,"_5":14752,"_28187":124585,"_3059":124642},[],"Valor de evaluación",{"_3604":73995,"_31000":73973,"_21469":124644,"_5":14752,"_28187":124585,"_3059":55859},[],{"_3604":73996,"_31000":73973,"_21469":124646,"_5":14752,"_28187":124585,"_3059":124647},[],"Raíz emisora de `device-root.pem`.",{"_3604":73997,"_31000":73973,"_21469":124649,"_5":14752,"_28187":124585,"_3059":122558},[],{"_3604":73998,"_31000":73973,"_21469":124651,"_5":14752,"_28187":124585,"_3059":124652},[],"Perfil final de 1 hora que acabas de preparar.",{"_3604":73999,"_31000":73973,"_21469":124654,"_5":14752,"_28187":124585,"_3059":55870},[],{"_3604":74000,"_31000":73973,"_21469":124656,"_5":14752,"_28187":124585,"_3059":55873},[],{"_3604":74001,"_31000":73973,"_21469":124658,"_5":14752,"_28187":124585,"_3059":55876},[],{"_3604":74002,"_31000":73973,"_21469":124660,"_5":14752,"_28187":124585,"_3059":124661},[],"Habilitado.",{"_3604":74003,"_31000":73973,"_21469":124663,"_5":14752,"_28187":124585,"_3059":55882},[],{"_3604":74004,"_31000":73973,"_21469":124665,"_5":14752,"_28187":124585,"_3059":124666},[],"Deshabilitado; el ID debe ser nuevo.",{"_3604":74005,"_31000":73973,"_21469":124668,"_5":14752,"_28187":124585,"_3059":124669},[],"Autenticación inicial",{"_3604":74006,"_31000":73973,"_21469":124671,"_5":14752,"_28187":124585,"_3059":124672},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3604":74007,"_31000":73973,"_21469":124674,"_5":14752,"_28187":124585,"_3059":124675},[],"Autenticación de renovación",{"_3604":74008,"_31000":73973,"_21469":124677,"_5":14752,"_28187":124585,"_3059":124678},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3604":74009,"_31000":73973,"_21469":124680,"_5":14752,"_28187":124585,"_3059":55900},[],{"_3604":74010,"_31000":73973,"_21469":124682,"_5":14752,"_28187":124585,"_3059":124683},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3604":74011,"_31000":73973,"_21469":124685,"_5":14752,"_28187":124585,"_3059":55906},[],{"_3604":74012,"_31000":73973,"_21469":124687,"_5":14752,"_28187":124585,"_3059":124688},[],"1 hora.",{"_3604":74013,"_31000":73973,"_21469":124690,"_5":14752,"_28187":124585,"_3059":55912},[],{"_3604":74014,"_31000":73973,"_21469":124692,"_5":14752,"_28187":124585,"_3059":124693},[],"30 minutos / 10 minutos.",{"_3604":74015,"_31000":73973,"_21469":124695,"_5":14752,"_28187":124585,"_3059":55918},[],{"_3604":74016,"_31000":73973,"_21469":124697,"_5":14752,"_28187":124585,"_3059":124698},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3604":74017,"_31000":73973,"_21469":124700,"_5":14752,"_28187":124585,"_3059":53676},[],{"_3604":74018,"_31000":73973,"_21469":124702,"_5":14752,"_28187":124585,"_3059":124703},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3604":74019,"_31000":73973,"_21469":124705,"_5":14752,"_28187":124585,"_3059":55929},[],{"_3604":74020,"_31000":73973,"_21469":124707,"_5":14752,"_28187":124585,"_3059":124708},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3604":74021,"_31000":73973,"_21469":124710,"_5":14752,"_28187":124585,"_3059":124711},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3604":74022,"_31000":73973,"_21469":124713,"_5":14752,"_28187":124589,"_3059":124714},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3604":74023,"_31000":73973,"_21469":124716,"_5":14752,"_28187":124589,"_3059":124717},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3604":74024,"_31000":73973,"_21469":124719,"_5":14752,"_28187":124593,"_3059":124720},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3604":74025,"_31000":73973,"_21469":124722,"_5":14752,"_28187":124593,"_3059":124723},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3604":74026,"_31000":73973,"_21469":124725,"_5":14752,"_28187":124593,"_3059":124726},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3604":74027,"_31000":73973,"_21469":124728,"_5":14752,"_28187":124597,"_3059":124729},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3604":74028,"_31000":73973,"_21469":124731,"_5":14752,"_28187":124597,"_3059":124732},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3604":74029,"_31000":73973,"_21469":124734,"_5":14752,"_28187":124601,"_3059":124735},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3604":74030,"_31000":73973,"_21469":124737,"_5":14752,"_28187":124601,"_3059":124738},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3604":74031,"_31000":73973,"_21469":124740,"_5":14752,"_28187":124601,"_3059":124741},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3604":74032,"_31000":73973,"_21469":124743,"_5":14752,"_28187":124601,"_3059":124744},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3604":74033,"_31000":73973,"_21469":124746,"_5":14752,"_28187":124601,"_3059":124747},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3604":74034,"_31000":73973,"_21469":124749,"_5":14752,"_28187":124605,"_3059":124750},[],"Comprobación",{"_3604":74035,"_31000":73973,"_21469":124752,"_5":14752,"_28187":124605,"_3059":124753},[],"Resultado esperado",{"_3604":74036,"_31000":73973,"_21469":124755,"_5":14752,"_28187":124605,"_3059":124756},[],"Registro",{"_3604":74037,"_31000":73973,"_21469":124758,"_5":14752,"_28187":124605,"_3059":124759},[],"ID creado automáticamente y DMS correcto.",{"_3604":74038,"_31000":73973,"_21469":124761,"_5":14752,"_28187":124605,"_3059":124046},[],{"_3604":74039,"_31000":73973,"_21469":124763,"_5":14752,"_28187":124605,"_3059":124764},[],"CN, perfil, serie y clave verificados.",{"_3604":74040,"_31000":73973,"_21469":124766,"_5":14752,"_28187":124605,"_3059":124767},[],"Inventario",{"_3604":74041,"_31000":73973,"_21469":124769,"_5":14752,"_28187":124605,"_3059":124770},[],"Serie recibida visible como identidad actual y en el historial.",{"_3604":74042,"_31000":73973,"_21469":124772,"_5":14752,"_28187":124605,"_3059":124773},[],"Consumidor",{"_3604":74043,"_31000":73973,"_21469":124775,"_5":14752,"_28187":124605,"_3059":124776},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3604":74044,"_31000":73973,"_21469":124778,"_5":14752,"_28187":124605,"_3059":124779},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3604":74045,"_31000":73973,"_21469":124781,"_5":14752,"_28187":124605,"_3059":124782},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3604":74046,"_31000":74046,"_5":15112,"_3059":122272,"_31359":124784,"_21469":124785,"_28187":74046},[50673,121110,53357,124571],[],{"_3604":74047,"_31000":74046,"_21469":124787,"_5":14752,"_28187":74046,"_3059":124788},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3604":74048,"_31000":74046,"_5":31356,"_21469":124790,"_28187":124791,"_3059":119644},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3604":74049,"_31000":74046,"_5":31356,"_21469":124793,"_28187":124794,"_3059":124795},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3604":74050,"_31000":74046,"_5":31356,"_21469":124797,"_28187":124798,"_3059":124799},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3604":74051,"_31000":74046,"_5":31356,"_21469":124801,"_28187":124802,"_3059":124803},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3604":74052,"_31000":74046,"_5":31356,"_21469":124805,"_28187":124806,"_3059":124807},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3604":74053,"_31000":74046,"_5":31356,"_21469":124809,"_28187":124810,"_3059":124811},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3604":74054,"_31000":74046,"_5":31356,"_21469":124813,"_28187":124814,"_3059":124753},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3604":74055,"_31000":74046,"_5":31356,"_21469":124816,"_28187":124817,"_3059":124818},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3604":74056,"_31000":74046,"_5":31356,"_21469":124820,"_28187":124821,"_3059":124822},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3604":74057,"_31000":74046,"_21469":124824,"_5":14752,"_28187":74046,"_3059":124825},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3604":74058,"_31000":74046,"_21469":124827,"_5":14752,"_28187":74046,"_3059":124828},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3604":74059,"_31000":74046,"_21469":124830,"_5":14752,"_28187":124791,"_3059":124831},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3604":74060,"_31000":74046,"_21469":124833,"_5":14752,"_28187":124791,"_3059":124834},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3604":74061,"_31000":74046,"_21469":124836,"_5":14752,"_28187":124791,"_3059":124837},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3604":74062,"_31000":74046,"_21469":124839,"_5":14752,"_28187":124791,"_3059":124840},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3604":74063,"_31000":74046,"_21469":124842,"_5":14752,"_28187":124794,"_3059":124843},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3604":74064,"_31000":74046,"_21469":124845,"_5":14752,"_28187":124794,"_3059":124846},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3604":74065,"_31000":74046,"_21469":124848,"_5":14752,"_28187":124794,"_3059":124849},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3604":74066,"_31000":74046,"_21469":124851,"_5":14752,"_28187":124794,"_3059":124852},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3604":74067,"_31000":74046,"_21469":124854,"_5":14752,"_28187":124794,"_3059":124855},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3604":74068,"_31000":74046,"_21469":124857,"_5":14752,"_28187":124794,"_3059":124858},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3604":74069,"_31000":74046,"_21469":124860,"_5":14752,"_28187":124794,"_3059":124861},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3604":74070,"_31000":74046,"_21469":124863,"_5":14752,"_28187":124794,"_3059":124864},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3604":74071,"_31000":74046,"_21469":124866,"_5":14752,"_28187":124798,"_3059":124867},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3604":74072,"_31000":74046,"_21469":124869,"_5":14752,"_28187":124798,"_3059":56094},[],{"_3604":74073,"_31000":74046,"_21469":124871,"_5":14752,"_28187":124798,"_3059":124872},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3604":74074,"_31000":74046,"_21469":124874,"_5":14752,"_28187":124798,"_3059":124875},[],"**Icon** y **Tags**: clasificación opcional.",{"_3604":74075,"_31000":74046,"_21469":124877,"_5":14752,"_28187":124798,"_3059":124878},[],"Confirma el registro.",{"_3604":74076,"_31000":74046,"_21469":124880,"_5":14752,"_28187":124802,"_3059":124881},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3604":74077,"_31000":74046,"_21469":124883,"_5":14752,"_28187":124802,"_3059":124884},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3604":74078,"_31000":74046,"_21469":124886,"_5":14752,"_28187":124806,"_3059":124887},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3604":74079,"_31000":74046,"_21469":124889,"_5":14752,"_28187":124806,"_3059":124890},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3604":74080,"_31000":74046,"_21469":124892,"_5":14752,"_28187":124810,"_3059":124893},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3604":74081,"_31000":74046,"_21469":124895,"_5":14752,"_28187":124810,"_3059":124896},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3604":74082,"_31000":74046,"_21469":124898,"_5":14752,"_28187":124814,"_3059":124750},[],{"_3604":74083,"_31000":74046,"_21469":124900,"_5":14752,"_28187":124814,"_3059":124901},[],"Resultado",{"_3604":74084,"_31000":74046,"_21469":124903,"_5":14752,"_28187":124814,"_3059":124032},[],{"_3604":74085,"_31000":74046,"_21469":124905,"_5":14752,"_28187":124814,"_3059":124906},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3604":74086,"_31000":74046,"_21469":124908,"_5":14752,"_28187":124814,"_3059":124909},[],"Identidad actual",{"_3604":74087,"_31000":74046,"_21469":124911,"_5":14752,"_28187":124814,"_3059":124912},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3604":74088,"_31000":74046,"_21469":124914,"_5":14752,"_28187":124814,"_3059":124915},[],"Historial",{"_3604":74089,"_31000":74046,"_21469":124917,"_5":14752,"_28187":124814,"_3059":124918},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3604":74090,"_31000":74046,"_21469":124920,"_5":14752,"_28187":124814,"_3059":124921},[],"Clave y certificado",{"_3604":74091,"_31000":74046,"_21469":124923,"_5":14752,"_28187":124814,"_3059":124924},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3604":74092,"_31000":74046,"_21469":124926,"_5":14752,"_28187":124817,"_3059":124927},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3604":74093,"_31000":74046,"_21469":124929,"_5":14752,"_28187":124817,"_3059":124930},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3604":74094,"_31000":74046,"_21469":124932,"_5":14752,"_28187":124817,"_3059":124933},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3604":74095,"_31000":74046,"_21469":124935,"_5":14752,"_28187":124817,"_3059":124936},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3604":74096,"_31000":74046,"_21469":124938,"_5":14752,"_28187":124821,"_3059":124939},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3604":74097,"_31000":74046,"_21469":124941,"_5":14752,"_28187":124821,"_3059":124942},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3604":74098,"_31000":74046,"_21469":124944,"_5":14752,"_28187":124821,"_3059":124945},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3604":74099,"_31000":74099,"_5":15112,"_3059":124947,"_31359":124948,"_21469":124949,"_28187":74099},"Plataforma Lamassu IoT",[50673,121110],[],{"_3604":74100,"_31000":74099,"_21469":124951,"_5":14752,"_28187":74099,"_3059":124952},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3604":74101,"_31000":74099,"_5":31356,"_21469":124954,"_28187":124955,"_3059":124447},[],"/docs/pr-preview/pr-75/es/platform/overview#empieza-aquí",{"_3604":74102,"_31000":74099,"_5":31356,"_21469":124957,"_28187":124958,"_3059":124959},[],"/docs/pr-preview/pr-75/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3604":74103,"_31000":74099,"_5":31356,"_21469":124961,"_28187":124962,"_3059":124963},[],"/docs/pr-preview/pr-75/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3604":74104,"_31000":74099,"_5":31356,"_21469":124965,"_28187":124966,"_3059":124967},[],"/docs/pr-preview/pr-75/es/platform/overview#capacidades-principales","Capacidades principales",{"_3604":74105,"_31000":74099,"_5":31356,"_21469":124969,"_28187":124970,"_3059":124971},[],"/docs/pr-preview/pr-75/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3604":74106,"_31000":74099,"_5":31356,"_21469":124973,"_28187":124974,"_3059":124975},[],"/docs/pr-preview/pr-75/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3604":74107,"_31000":74099,"_5":31356,"_21469":124977,"_28187":124978,"_3059":124979},[],"/docs/pr-preview/pr-75/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3604":74108,"_31000":74099,"_5":31356,"_21469":124981,"_28187":124982,"_3059":124983},[],"/docs/pr-preview/pr-75/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3604":74109,"_31000":74099,"_5":31356,"_21469":124985,"_28187":124986,"_3059":124987},[],"/docs/pr-preview/pr-75/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3604":74110,"_31000":74099,"_5":31356,"_21469":124989,"_28187":124990,"_3059":124991},[],"/docs/pr-preview/pr-75/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3604":74111,"_31000":74099,"_5":31356,"_21469":124993,"_28187":124994,"_3059":124995},[],"/docs/pr-preview/pr-75/es/platform/overview#referencia-operativa","Referencia operativa",{"_3604":74112,"_31000":74099,"_21469":124997,"_5":14752,"_28187":74099,"_3059":124998},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3604":74113,"_31000":74099,"_21469":125000,"_5":14752,"_28187":124955,"_3059":125001},[],"Elige el resultado que necesitas obtener:",{"_3604":74114,"_31000":74099,"_21469":125003,"_5":14752,"_28187":124955,"_3059":125004},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3604":74115,"_31000":74099,"_21469":125006,"_5":14752,"_28187":124955,"_3059":125007},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3604":74116,"_31000":74099,"_21469":125009,"_5":14752,"_28187":124955,"_3059":125010},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3604":74117,"_31000":74099,"_21469":125012,"_5":14752,"_28187":124958,"_3059":125013},[],"Bloque",{"_3604":74118,"_31000":74099,"_21469":125015,"_5":14752,"_28187":124958,"_3059":125016},[],"Qué gestionas",{"_3604":74119,"_31000":74099,"_21469":125018,"_5":14752,"_28187":124958,"_3059":125019},[],"Punto de entrada",{"_3604":74120,"_31000":74099,"_21469":125021,"_5":14752,"_28187":124958,"_3059":56247},[],{"_3604":74121,"_31000":74099,"_21469":125023,"_5":14752,"_28187":124958,"_3059":125024},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3604":74122,"_31000":74099,"_21469":125026,"_5":14752,"_28187":124958,"_3059":125027},[],"Visión general de PKI",{"_3604":74123,"_31000":74099,"_21469":125029,"_5":14752,"_28187":124958,"_3059":56256},[],{"_3604":74124,"_31000":74099,"_21469":125031,"_5":14752,"_28187":124958,"_3059":125032},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3604":74125,"_31000":74099,"_21469":125034,"_5":14752,"_28187":124958,"_3059":125035},[],"Visión general de IoT Fleets",{"_3604":74126,"_31000":74099,"_21469":125037,"_5":14752,"_28187":124958,"_3059":125038},[],"**Administración**",{"_3604":74127,"_31000":74099,"_21469":125040,"_5":14752,"_28187":124958,"_3059":125041},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3604":74128,"_31000":74099,"_21469":125043,"_5":14752,"_28187":124958,"_3059":121112},[],{"_3604":74129,"_31000":74099,"_21469":125045,"_5":14752,"_28187":124958,"_3059":125046},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3604":74130,"_31000":74099,"_21469":125048,"_5":14752,"_28187":124962,"_3059":125049},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3604":74131,"_31000":74099,"_21469":125051,"_5":14752,"_28187":124962,"_3059":125052},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3604":74132,"_31000":74099,"_21469":125054,"_5":14752,"_28187":124962,"_3059":125055},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3604":74133,"_31000":74099,"_21469":125057,"_5":14752,"_28187":124962,"_3059":125058},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3604":74134,"_31000":74099,"_21469":125060,"_5":14752,"_28187":124962,"_3059":125061},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3604":74135,"_31000":74099,"_21469":125063,"_5":14752,"_28187":124962,"_3059":125064},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3604":74136,"_31000":74099,"_21469":125066,"_5":14752,"_28187":124970,"_3059":125067},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3604":74137,"_31000":74099,"_21469":125069,"_5":14752,"_28187":124974,"_3059":125070},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3604":74138,"_31000":74099,"_21469":125072,"_5":14752,"_28187":124978,"_3059":125073},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3604":74139,"_31000":74099,"_21469":125075,"_5":14752,"_28187":124982,"_3059":125076},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3604":74140,"_31000":74099,"_21469":125078,"_5":14752,"_28187":124986,"_3059":125079},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3604":74141,"_31000":74099,"_21469":125081,"_5":14752,"_28187":124990,"_3059":125082},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3604":74142,"_31000":74099,"_21469":125084,"_5":14752,"_28187":124994,"_3059":124540},[],{"_3604":74143,"_31000":74099,"_21469":125086,"_5":14752,"_28187":124994,"_3059":125087},[],"Qué prepara o comprueba",{"_3604":74144,"_31000":74099,"_21469":125089,"_5":14752,"_28187":124994,"_3059":124543},[],{"_3604":74145,"_31000":74099,"_21469":125091,"_5":14752,"_28187":124994,"_3059":125092},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3604":74146,"_31000":74099,"_21469":125094,"_5":14752,"_28187":124994,"_3059":125095},[],"Administrador de la flota",{"_3604":74147,"_31000":74099,"_21469":125097,"_5":14752,"_28187":124994,"_3059":125098},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3604":74148,"_31000":74099,"_21469":125100,"_5":14752,"_28187":124994,"_3059":124555},[],{"_3604":74149,"_31000":74099,"_21469":125102,"_5":14752,"_28187":124994,"_3059":125103},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3604":74150,"_31000":74099,"_21469":125105,"_5":14752,"_28187":124994,"_3059":124561},[],{"_3604":74151,"_31000":74099,"_21469":125107,"_5":14752,"_28187":124994,"_3059":125108},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3604":74152,"_31000":74099,"_21469":125110,"_5":14752,"_28187":124994,"_3059":125111},[],"Operador de infraestructura",{"_3604":74153,"_31000":74099,"_21469":125113,"_5":14752,"_28187":124994,"_3059":125114},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3604":74154,"_31000":74099,"_21469":125116,"_5":14752,"_28187":124994,"_3059":125117},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3604":74155,"_31000":74155,"_5":15112,"_3059":125119,"_31359":125120,"_21469":125122,"_28187":74155},"Jerarquía y rotación de CAs",[50673,121110,56348,125121],"Claves, autoridades y certificados",[],{"_3604":74156,"_31000":74155,"_21469":125124,"_5":14752,"_28187":74155,"_3059":125125},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3604":74157,"_31000":74155,"_5":31356,"_21469":125127,"_28187":125128,"_3059":125129},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3604":74158,"_31000":74155,"_5":31356,"_21469":125131,"_28187":125132,"_3059":125133},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3604":74159,"_31000":74155,"_5":31356,"_21469":125135,"_28187":125136,"_3059":125137},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3604":74160,"_31000":74155,"_5":31356,"_21469":125139,"_28187":125140,"_3059":125141},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3604":74161,"_31000":74155,"_5":31356,"_21469":125143,"_28187":125144,"_3059":125145},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3604":74162,"_31000":74155,"_5":31356,"_21469":125147,"_28187":125148,"_3059":125149},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3604":74163,"_31000":74155,"_5":31356,"_21469":125151,"_28187":125152,"_3059":125153},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3604":74164,"_31000":74155,"_5":31356,"_21469":125155,"_28187":125156,"_3059":125157},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3604":74165,"_31000":74155,"_5":31356,"_21469":125159,"_28187":125160,"_3059":125161},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3604":74166,"_31000":74155,"_5":31356,"_21469":125163,"_28187":125164,"_3059":125165},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3604":74167,"_31000":74155,"_5":31356,"_21469":125167,"_28187":125168,"_3059":125169},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3604":74168,"_31000":74155,"_5":31356,"_21469":125171,"_28187":125172,"_3059":125173},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3604":74169,"_31000":74155,"_21469":125175,"_5":14752,"_28187":74155,"_3059":125176},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3604":74170,"_31000":74155,"_21469":125178,"_5":14752,"_28187":74155,"_3059":125179},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3604":74171,"_31000":74155,"_21469":125181,"_5":14752,"_28187":125128,"_3059":125182},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3604":74172,"_31000":74155,"_21469":125184,"_5":14752,"_28187":125128,"_3059":125185},[],"entorno, como producción y preproducción;",{"_3604":74173,"_31000":74155,"_21469":125187,"_5":14752,"_28187":125128,"_3059":125188},[],"propietario o equipo operador;",{"_3604":74174,"_31000":74155,"_21469":125190,"_5":14752,"_28187":125128,"_3059":125191},[],"familia de dispositivos o proceso de fabricación;",{"_3604":74175,"_31000":74155,"_21469":125193,"_5":14752,"_28187":125128,"_3059":125194},[],"región o requisito regulatorio;",{"_3604":74176,"_31000":74155,"_21469":125196,"_5":14752,"_28187":125128,"_3059":125197},[],"motor criptográfico o política de clave;",{"_3604":74177,"_31000":74155,"_21469":125199,"_5":14752,"_28187":125128,"_3059":125200},[],"ventana de mantenimiento y ritmo de renovación.",{"_3604":74178,"_31000":74155,"_21469":125202,"_5":14752,"_28187":125128,"_3059":125203},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3604":74179,"_31000":74155,"_21469":125205,"_5":14752,"_28187":125128,"_3059":125206},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3604":74180,"_31000":74155,"_21469":125208,"_5":14752,"_28187":125132,"_3059":125209},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3604":74181,"_31000":74155,"_21469":125211,"_5":14752,"_28187":125132,"_3059":125212},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir; consulta la guía de CRL.",{"_3604":74182,"_31000":74155,"_21469":125214,"_5":14752,"_28187":125132,"_3059":125215},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3604":74183,"_31000":74155,"_21469":125217,"_5":14752,"_28187":125132,"_3059":125218},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3604":74184,"_31000":74155,"_21469":125220,"_5":14752,"_28187":125136,"_3059":125221},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3604":74185,"_31000":74155,"_21469":125223,"_5":14752,"_28187":125136,"_3059":125224},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3604":74186,"_31000":74155,"_21469":125226,"_5":14752,"_28187":125136,"_3059":125227},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3604":74187,"_31000":74155,"_21469":125229,"_5":14752,"_28187":125136,"_3059":125230},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3604":74188,"_31000":74155,"_21469":125232,"_5":14752,"_28187":125144,"_3059":125233},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3604":74189,"_31000":74155,"_21469":125235,"_5":14752,"_28187":125148,"_3059":125236},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3604":74190,"_31000":74155,"_21469":125238,"_5":14752,"_28187":125152,"_3059":125239},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3604":74191,"_31000":74155,"_21469":125241,"_5":14752,"_28187":125156,"_3059":125242},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3604":74192,"_31000":74155,"_21469":125244,"_5":14752,"_28187":125160,"_3059":125245},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3604":74193,"_31000":74155,"_21469":125247,"_5":14752,"_28187":125164,"_3059":125248},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3604":74194,"_31000":74155,"_21469":125250,"_5":14752,"_28187":125168,"_3059":125251},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3604":74195,"_31000":74155,"_21469":125253,"_5":14752,"_28187":125168,"_3059":125254},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3604":74196,"_31000":74155,"_21469":125256,"_5":14752,"_28187":125168,"_3059":125257},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3604":74197,"_31000":74155,"_21469":125259,"_5":14752,"_28187":125168,"_3059":125260},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3604":74198,"_31000":74155,"_21469":125262,"_5":14752,"_28187":125172,"_3059":125263},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3604":74199,"_31000":74155,"_21469":125265,"_5":14752,"_28187":125172,"_3059":125266},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3604":74200,"_31000":74155,"_21469":125268,"_5":14752,"_28187":125172,"_3059":125269},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3604":74201,"_31000":74155,"_21469":125271,"_5":14752,"_28187":125172,"_3059":125272},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3604":74202,"_31000":74155,"_21469":125274,"_5":14752,"_28187":125172,"_3059":125275},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3604":74203,"_31000":74155,"_21469":125277,"_5":14752,"_28187":125172,"_3059":125278},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3604":74204,"_31000":74155,"_21469":125280,"_5":14752,"_28187":125172,"_3059":125281},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3604":74205,"_31000":74205,"_5":15112,"_3059":125283,"_31359":125284,"_21469":125285,"_28187":74205},"Autoridades de certificación",[50673,121110,56348,125121],[],{"_3604":74206,"_31000":74205,"_21469":125287,"_5":14752,"_28187":74205,"_3059":125288},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3604":74207,"_31000":74205,"_5":31356,"_21469":125290,"_28187":125291,"_3059":125292},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3604":74208,"_31000":74205,"_5":31356,"_21469":125294,"_28187":125295,"_3059":125296},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3604":74209,"_31000":74205,"_5":31356,"_21469":125298,"_28187":125299,"_3059":119644},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3604":74210,"_31000":74205,"_5":31356,"_21469":125301,"_28187":125302,"_3059":125303},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3604":74211,"_31000":74205,"_5":31356,"_21469":125305,"_28187":125306,"_3059":125307},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3604":74212,"_31000":74205,"_5":31356,"_21469":125309,"_28187":125310,"_3059":125311},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3604":74213,"_31000":74205,"_5":31356,"_21469":125313,"_28187":125314,"_3059":125315},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3604":74214,"_31000":74205,"_5":31356,"_21469":125317,"_28187":125318,"_3059":125319},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3604":74215,"_31000":74205,"_5":31356,"_21469":125321,"_28187":125322,"_3059":125323},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3604":74216,"_31000":74205,"_5":31356,"_21469":125325,"_28187":125326,"_3059":125327},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3604":74217,"_31000":74205,"_5":31356,"_21469":125329,"_28187":125330,"_3059":125331},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3604":74218,"_31000":74205,"_5":31356,"_21469":125333,"_28187":125334,"_3059":125335},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3604":74219,"_31000":74205,"_5":31356,"_21469":125337,"_28187":125338,"_3059":125339},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3604":74220,"_31000":74205,"_5":31356,"_21469":125341,"_28187":125342,"_3059":125343},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3604":74221,"_31000":74205,"_5":31356,"_21469":125345,"_28187":125346,"_3059":125347},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3604":74222,"_31000":74205,"_5":31356,"_21469":125349,"_28187":125350,"_3059":125351},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3604":74223,"_31000":74205,"_5":31356,"_21469":125353,"_28187":125354,"_3059":125355},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3604":74224,"_31000":74205,"_5":31356,"_21469":125357,"_28187":125358,"_3059":125359},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3604":74225,"_31000":74205,"_5":31356,"_21469":125361,"_28187":125362,"_3059":125363},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3604":74226,"_31000":74205,"_5":31356,"_21469":125365,"_28187":125366,"_3059":125367},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3604":74227,"_31000":74205,"_5":31356,"_21469":125369,"_28187":125370,"_3059":125371},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3604":74228,"_31000":74205,"_5":31356,"_21469":125373,"_28187":125374,"_3059":125375},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3604":74229,"_31000":74205,"_5":31356,"_21469":125377,"_28187":125378,"_3059":125379},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3604":74230,"_31000":74205,"_21469":125381,"_5":14752,"_28187":74205,"_3059":125382},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3604":74231,"_31000":74205,"_21469":125384,"_5":14752,"_28187":74205,"_3059":125385},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3604":74232,"_31000":74205,"_21469":125387,"_5":14752,"_28187":74205,"_3059":125388},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3604":74233,"_31000":74205,"_21469":125390,"_5":14752,"_28187":125291,"_3059":125391},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3604":74234,"_31000":74205,"_21469":125393,"_5":14752,"_28187":125291,"_3059":125394},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3604":74235,"_31000":74205,"_21469":125396,"_5":14752,"_28187":125291,"_3059":125397},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3604":74236,"_31000":74205,"_21469":125399,"_5":14752,"_28187":125291,"_3059":125400},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3604":74237,"_31000":74205,"_21469":125402,"_5":14752,"_28187":125291,"_3059":125403},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3604":74238,"_31000":74205,"_21469":125405,"_5":14752,"_28187":125299,"_3059":125406},[],"Decide si la CA será raíz o intermedia.",{"_3604":74239,"_31000":74205,"_21469":125408,"_5":14752,"_28187":125299,"_3059":125409},[],"Elige el motor que custodiará la clave.",{"_3604":74240,"_31000":74205,"_21469":125411,"_5":14752,"_28187":125299,"_3059":125412},[],"Define una validez superior a la de los certificados que emitirá.",{"_3604":74241,"_31000":74205,"_21469":125414,"_5":14752,"_28187":125299,"_3059":125415},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3604":74242,"_31000":74205,"_21469":125417,"_5":14752,"_28187":125302,"_3059":125418},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3604":74243,"_31000":74205,"_21469":125420,"_5":14752,"_28187":125306,"_3059":125421},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3604":74244,"_31000":74205,"_21469":125423,"_5":14752,"_28187":125306,"_3059":125424},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3604":74245,"_31000":74205,"_21469":125426,"_5":14752,"_28187":125310,"_3059":125427},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3604":74246,"_31000":74205,"_21469":125429,"_5":14752,"_28187":125314,"_3059":125430},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3604":74247,"_31000":74205,"_21469":125432,"_5":14752,"_28187":125314,"_3059":125433},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3604":74248,"_31000":74205,"_21469":125435,"_5":14752,"_28187":125314,"_3059":125436},[],"`ST`: estado o provincia.",{"_3604":74249,"_31000":74205,"_21469":125438,"_5":14752,"_28187":125314,"_3059":125439},[],"`L`: localidad.",{"_3604":74250,"_31000":74205,"_21469":125441,"_5":14752,"_28187":125314,"_3059":125442},[],"`O`: organización.",{"_3604":74251,"_31000":74205,"_21469":125444,"_5":14752,"_28187":125314,"_3059":125445},[],"`OU`: unidad organizativa.",{"_3604":74252,"_31000":74205,"_21469":125447,"_5":14752,"_28187":125314,"_3059":125448},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3604":74253,"_31000":74205,"_21469":125450,"_5":14752,"_28187":125318,"_3059":125451},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3604":74254,"_31000":74205,"_21469":125453,"_5":14752,"_28187":125318,"_3059":125454},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3604":74255,"_31000":74205,"_21469":125456,"_5":14752,"_28187":125322,"_3059":125457},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3604":74256,"_31000":74205,"_21469":125459,"_5":14752,"_28187":125322,"_3059":125460},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3604":74257,"_31000":74205,"_21469":125462,"_5":14752,"_28187":125326,"_3059":125463},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3604":74258,"_31000":74205,"_21469":125465,"_5":14752,"_28187":125326,"_3059":125466},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3604":74259,"_31000":74205,"_21469":125468,"_5":14752,"_28187":125330,"_3059":125469},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3604":74260,"_31000":74205,"_21469":125471,"_5":14752,"_28187":125330,"_3059":125472},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3604":74261,"_31000":74205,"_21469":125474,"_5":14752,"_28187":125330,"_3059":125475},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3604":74262,"_31000":74205,"_21469":125477,"_5":14752,"_28187":125334,"_3059":125478},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3604":74263,"_31000":74205,"_21469":125480,"_5":14752,"_28187":125338,"_3059":125481},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3604":74264,"_31000":74205,"_21469":125483,"_5":14752,"_28187":125338,"_3059":125484},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3604":74265,"_31000":74205,"_21469":125486,"_5":14752,"_28187":125342,"_3059":125487},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3604":74266,"_31000":74205,"_21469":125489,"_5":14752,"_28187":125346,"_3059":125490},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3604":74267,"_31000":74205,"_21469":125492,"_5":14752,"_28187":125346,"_3059":125493},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3604":74268,"_31000":74205,"_21469":125495,"_5":14752,"_28187":125350,"_3059":125496},[],"Abre una CA desde el inventario para consultar:",{"_3604":74269,"_31000":74205,"_21469":125498,"_5":14752,"_28187":125350,"_3059":125499},[],"Estado y periodo de validez.",{"_3604":74270,"_31000":74205,"_21469":125501,"_5":14752,"_28187":125350,"_3059":125502},[],"Certificado y cadena en formato PEM.",{"_3604":74271,"_31000":74205,"_21469":125504,"_5":14752,"_28187":125350,"_3059":125505},[],"Número de certificados activos, expirados y revocados.",{"_3604":74272,"_31000":74205,"_21469":125507,"_5":14752,"_28187":125350,"_3059":125508},[],"Certificados emitidos en **Issued Certificates**.",{"_3604":74273,"_31000":74205,"_21469":125510,"_5":14752,"_28187":125350,"_3059":125511},[],"CRL vinculada a la autoridad.",{"_3604":74274,"_31000":74205,"_21469":125513,"_5":14752,"_28187":125350,"_3059":125514},[],"Metadatos y motor criptográfico asociado.",{"_3604":74275,"_31000":74205,"_21469":125516,"_5":14752,"_28187":125350,"_3059":125517},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3604":74276,"_31000":74205,"_21469":125519,"_5":14752,"_28187":125354,"_3059":125520},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3604":74277,"_31000":74205,"_21469":125522,"_5":14752,"_28187":125354,"_3059":125523},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3604":74278,"_31000":74205,"_21469":125525,"_5":14752,"_28187":125354,"_3059":125526},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3604":74279,"_31000":74205,"_21469":125528,"_5":14752,"_28187":125354,"_3059":125529},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3604":74280,"_31000":74205,"_21469":125531,"_5":14752,"_28187":125354,"_3059":125532},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3604":74281,"_31000":74205,"_21469":125534,"_5":14752,"_28187":125354,"_3059":125535},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3604":74282,"_31000":74205,"_21469":125537,"_5":14752,"_28187":125358,"_3059":125538},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3604":74283,"_31000":74205,"_21469":125540,"_5":14752,"_28187":125362,"_3059":125541},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3604":74284,"_31000":74205,"_21469":125543,"_5":14752,"_28187":125366,"_3059":125544},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3604":74285,"_31000":74205,"_21469":125546,"_5":14752,"_28187":125370,"_3059":125547},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3604":74286,"_31000":74205,"_21469":125549,"_5":14752,"_28187":125374,"_3059":125550},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3604":74287,"_31000":74205,"_21469":125552,"_5":14752,"_28187":125378,"_3059":125553},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3604":74288,"_31000":74205,"_21469":125555,"_5":14752,"_28187":125378,"_3059":125556},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3604":74289,"_31000":74205,"_21469":125558,"_5":14752,"_28187":125378,"_3059":125559},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3604":74290,"_31000":74205,"_21469":125561,"_5":14752,"_28187":125378,"_3059":125562},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3604":74291,"_31000":74205,"_21469":125564,"_5":14752,"_28187":125378,"_3059":125565},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3604":74292,"_31000":74292,"_5":15112,"_3059":125567,"_31359":125568,"_21469":125569,"_28187":74292},"Perfiles de certificado",[50673,121110,56348,125121],[],{"_3604":74293,"_31000":74292,"_21469":125571,"_5":14752,"_28187":74292,"_3059":125572},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3604":74294,"_31000":74292,"_5":31356,"_21469":125574,"_28187":125575,"_3059":125576},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3604":74295,"_31000":74292,"_5":31356,"_21469":125578,"_28187":125579,"_3059":125580},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#validez","Validez",{"_3604":74296,"_31000":74292,"_5":31356,"_21469":125582,"_28187":125583,"_3059":125584},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3604":74297,"_31000":74292,"_5":31356,"_21469":125586,"_28187":125587,"_3059":125588},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3604":74298,"_31000":74292,"_5":31356,"_21469":125590,"_28187":125591,"_3059":125592},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3604":74299,"_31000":74292,"_5":31356,"_21469":125594,"_28187":125595,"_3059":125596},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3604":74300,"_31000":74292,"_5":31356,"_21469":125598,"_28187":125599,"_3059":125600},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3604":74301,"_31000":74292,"_5":31356,"_21469":125602,"_28187":125603,"_3059":125604},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3604":74302,"_31000":74292,"_5":31356,"_21469":125606,"_28187":125607,"_3059":125608},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3604":74303,"_31000":74292,"_5":31356,"_21469":125610,"_28187":125611,"_3059":125612},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3604":74304,"_31000":74292,"_5":31356,"_21469":125614,"_28187":125615,"_3059":125616},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3604":74305,"_31000":74292,"_5":31356,"_21469":125618,"_28187":125619,"_3059":125620},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3604":74306,"_31000":74292,"_5":31356,"_21469":125622,"_28187":125623,"_3059":125624},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3604":74307,"_31000":74292,"_5":31356,"_21469":125626,"_28187":125627,"_3059":125628},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3604":74308,"_31000":74292,"_5":31356,"_21469":125630,"_28187":125631,"_3059":125632},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3604":74309,"_31000":74292,"_5":31356,"_21469":125634,"_28187":125635,"_3059":125636},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3604":74310,"_31000":74292,"_21469":125638,"_5":14752,"_28187":74292,"_3059":125639},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3604":74311,"_31000":74292,"_21469":125641,"_5":14752,"_28187":74292,"_3059":125642},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3604":74312,"_31000":74292,"_21469":125644,"_5":14752,"_28187":125579,"_3059":125645},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3604":74313,"_31000":74292,"_21469":125647,"_5":14752,"_28187":125579,"_3059":125648},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3604":74314,"_31000":74292,"_21469":125650,"_5":14752,"_28187":125583,"_3059":125651},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3604":74315,"_31000":74292,"_21469":125653,"_5":14752,"_28187":125587,"_3059":125654},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3604":74316,"_31000":74292,"_21469":125656,"_5":14752,"_28187":125587,"_3059":125657},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3604":74317,"_31000":74292,"_21469":125659,"_5":14752,"_28187":125587,"_3059":125660},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3604":74318,"_31000":74292,"_21469":125662,"_5":14752,"_28187":125591,"_3059":125663},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3604":74319,"_31000":74292,"_21469":125665,"_5":14752,"_28187":125595,"_3059":125666},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3604":74320,"_31000":74292,"_21469":125668,"_5":14752,"_28187":125595,"_3059":125669},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3604":74321,"_31000":74292,"_21469":125671,"_5":14752,"_28187":125599,"_3059":125672},[],"La aplicación criptográfica puede:",{"_3604":74322,"_31000":74292,"_21469":125674,"_5":14752,"_28187":125599,"_3059":125675},[],"permitir o bloquear claves RSA;",{"_3604":74323,"_31000":74292,"_21469":125677,"_5":14752,"_28187":125599,"_3059":125678},[],"limitar los tamaños RSA admitidos;",{"_3604":74324,"_31000":74292,"_21469":125680,"_5":14752,"_28187":125599,"_3059":125681},[],"permitir o bloquear claves ECDSA;",{"_3604":74325,"_31000":74292,"_21469":125683,"_5":14752,"_28187":125599,"_3059":125684},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3604":74326,"_31000":74292,"_21469":125686,"_5":14752,"_28187":125599,"_3059":125687},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3604":74327,"_31000":74292,"_21469":125689,"_5":14752,"_28187":125603,"_3059":125690},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3604":74328,"_31000":74292,"_21469":125692,"_5":14752,"_28187":125603,"_3059":120870},[],{"_3604":74329,"_31000":74292,"_21469":125694,"_5":14752,"_28187":125603,"_3059":125695},[],"Primera opción",{"_3604":74330,"_31000":74292,"_21469":125697,"_5":14752,"_28187":125603,"_3059":125698},[],"Segunda opción",{"_3604":74331,"_31000":74292,"_21469":125700,"_5":14752,"_28187":125603,"_3059":125701},[],"Si no hay ninguna",{"_3604":74332,"_31000":74292,"_21469":125703,"_5":14752,"_28187":125603,"_3059":125704},[],"Firma directa con una CA",{"_3604":74333,"_31000":74292,"_21469":125706,"_5":14752,"_28187":125603,"_3059":125707},[],"`issuance_profile` incluido en la solicitud",{"_3604":74334,"_31000":74292,"_21469":125709,"_5":14752,"_28187":125603,"_3059":125710},[],"`issuance_profile_id` de la solicitud",{"_3604":74335,"_31000":74292,"_21469":125712,"_5":14752,"_28187":125603,"_3059":125713},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3604":74336,"_31000":74292,"_21469":125715,"_5":14752,"_28187":125603,"_3059":125716},[],"Emisión mediante DMS",{"_3604":74337,"_31000":74292,"_21469":125718,"_5":14752,"_28187":125603,"_3059":56947},[],{"_3604":74338,"_31000":74292,"_21469":125720,"_5":14752,"_28187":125603,"_3059":125721},[],"`settings.issuance_profile` incluido en el DMS",{"_3604":74339,"_31000":74292,"_21469":125723,"_5":14752,"_28187":125603,"_3059":125724},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3604":74340,"_31000":74292,"_21469":125726,"_5":14752,"_28187":125603,"_3059":125727},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3604":74341,"_31000":74292,"_21469":125729,"_5":14752,"_28187":125603,"_3059":125730},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3604":74342,"_31000":74292,"_21469":125732,"_5":14752,"_28187":125611,"_3059":125733},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3604":74343,"_31000":74292,"_21469":125735,"_5":14752,"_28187":125615,"_3059":125736},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3604":74344,"_31000":74292,"_21469":125738,"_5":14752,"_28187":125619,"_3059":125739},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3604":74345,"_31000":74292,"_21469":125741,"_5":14752,"_28187":125623,"_3059":125742},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3604":74346,"_31000":74292,"_21469":125744,"_5":14752,"_28187":125627,"_3059":125745},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3604":74347,"_31000":74292,"_21469":125747,"_5":14752,"_28187":125627,"_3059":125748},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3604":74348,"_31000":74292,"_21469":125750,"_5":14752,"_28187":125631,"_3059":125751},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3604":74349,"_31000":74292,"_21469":125753,"_5":14752,"_28187":125631,"_3059":125754},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3604":74350,"_31000":74292,"_21469":125756,"_5":14752,"_28187":125631,"_3059":125757},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3604":74351,"_31000":74292,"_21469":125759,"_5":14752,"_28187":125631,"_3059":125760},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3604":74352,"_31000":74292,"_21469":125762,"_5":14752,"_28187":125635,"_3059":125763},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3604":74353,"_31000":74292,"_21469":125765,"_5":14752,"_28187":125635,"_3059":125766},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3604":74354,"_31000":74354,"_5":15112,"_3059":125768,"_31359":125769,"_21469":125771,"_28187":74354},"Validación de certificados",[50673,121110,56348,125770],"Validación",[],{"_3604":74355,"_31000":74354,"_21469":125773,"_5":14752,"_28187":74354,"_3059":125774},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3604":74356,"_31000":74354,"_5":31356,"_21469":125776,"_28187":125777,"_3059":125778},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3604":74357,"_31000":74354,"_5":31356,"_21469":125780,"_28187":125781,"_3059":125782},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3604":74358,"_31000":74354,"_5":31356,"_21469":125784,"_28187":125785,"_3059":125786},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3604":74359,"_31000":74354,"_21469":125788,"_5":14752,"_28187":74354,"_3059":125789},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3604":74360,"_31000":74354,"_21469":125791,"_5":14752,"_28187":125777,"_3059":125792},[],"Verifica estos criterios juntos:",{"_3604":74361,"_31000":74354,"_21469":125794,"_5":14752,"_28187":125777,"_3059":124750},[],{"_3604":74362,"_31000":74354,"_21469":125796,"_5":14752,"_28187":125777,"_3059":125797},[],"Resultado necesario",{"_3604":74363,"_31000":74354,"_21469":125799,"_5":14752,"_28187":125777,"_3059":125800},[],"Cadena y firma",{"_3604":74364,"_31000":74354,"_21469":125802,"_5":14752,"_28187":125777,"_3059":125803},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3604":74365,"_31000":74354,"_21469":125805,"_5":14752,"_28187":125777,"_3059":125806},[],"Fechas",{"_3604":74366,"_31000":74354,"_21469":125808,"_5":14752,"_28187":125777,"_3059":125809},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3604":74367,"_31000":74354,"_21469":125811,"_5":14752,"_28187":125777,"_3059":120780},[],{"_3604":74368,"_31000":74354,"_21469":125813,"_5":14752,"_28187":125777,"_3059":125814},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3604":74369,"_31000":74354,"_21469":125816,"_5":14752,"_28187":125777,"_3059":125817},[],"Uso",{"_3604":74370,"_31000":74354,"_21469":125819,"_5":14752,"_28187":125777,"_3059":125820},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3604":74371,"_31000":74354,"_21469":125822,"_5":14752,"_28187":125777,"_3059":125823},[],"Revocación",{"_3604":74372,"_31000":74354,"_21469":125825,"_5":14752,"_28187":125777,"_3059":125826},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3604":74373,"_31000":74354,"_21469":125828,"_5":14752,"_28187":125777,"_3059":125829},[],"Autorización",{"_3604":74374,"_31000":74354,"_21469":125831,"_5":14752,"_28187":125777,"_3059":125832},[],"La aplicación permite la acción a esa identidad.",{"_3604":74375,"_31000":74354,"_21469":125834,"_5":14752,"_28187":125777,"_3059":125835},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3604":74376,"_31000":74354,"_21469":125837,"_5":14752,"_28187":125781,"_3059":125838},[],"Mecanismo",{"_3604":74377,"_31000":74354,"_21469":125840,"_5":14752,"_28187":125781,"_3059":125841},[],"Cuándo utilizarlo",{"_3604":74378,"_31000":74354,"_21469":125843,"_5":14752,"_28187":125781,"_3059":125844},[],"Qué debes mantener",{"_3604":74379,"_31000":74354,"_21469":125846,"_5":14752,"_28187":125781,"_3059":57075},[],{"_3604":74380,"_31000":74354,"_21469":125848,"_5":14752,"_28187":125781,"_3059":125849},[],"Consulta del estado de un certificado concreto.",{"_3604":74381,"_31000":74354,"_21469":125851,"_5":14752,"_28187":125781,"_3059":125852},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3604":74382,"_31000":74354,"_21469":125854,"_5":14752,"_28187":125781,"_3059":57084},[],{"_3604":74383,"_31000":74354,"_21469":125856,"_5":14752,"_28187":125781,"_3059":125857},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3604":74384,"_31000":74354,"_21469":125859,"_5":14752,"_28187":125781,"_3059":125860},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3604":74385,"_31000":74354,"_21469":125862,"_5":14752,"_28187":125781,"_3059":125863},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3604":74386,"_31000":74354,"_21469":125865,"_5":14752,"_28187":125781,"_3059":125866},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3604":74387,"_31000":74354,"_21469":125868,"_5":14752,"_28187":125785,"_3059":125869},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3604":74388,"_31000":74354,"_21469":125871,"_5":14752,"_28187":125785,"_3059":125872},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3604":74389,"_31000":74354,"_21469":125874,"_5":14752,"_28187":125785,"_3059":125875},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3604":74390,"_31000":74354,"_21469":125877,"_5":14752,"_28187":125785,"_3059":125878},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3604":74391,"_31000":74354,"_21469":125880,"_5":14752,"_28187":125785,"_3059":125881},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3604":74392,"_31000":74354,"_21469":125883,"_5":14752,"_28187":125785,"_3059":125884},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3604":74393,"_31000":74354,"_21469":125886,"_5":14752,"_28187":125785,"_3059":125887},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3604":74394,"_31000":74354,"_21469":125889,"_5":14752,"_28187":125785,"_3059":125890},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3604":74395,"_31000":74354,"_21469":125892,"_5":14752,"_28187":125785,"_3059":125893},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3604":74396,"_31000":74396,"_5":15112,"_3059":125895,"_31359":125896,"_21469":125897,"_28187":74396},"Certificados",[50673,121110,56348,125121],[],{"_3604":74397,"_31000":74396,"_21469":125899,"_5":14752,"_28187":74396,"_3059":125900},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3604":74398,"_31000":74396,"_5":31356,"_21469":125902,"_28187":125903,"_3059":125904},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3604":74399,"_31000":74396,"_5":31356,"_21469":125906,"_28187":125907,"_3059":125908},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3604":74400,"_31000":74396,"_5":31356,"_21469":125910,"_28187":125911,"_3059":125912},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3604":74401,"_31000":74396,"_5":31356,"_21469":125914,"_28187":125915,"_3059":125916},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3604":74402,"_31000":74396,"_5":31356,"_21469":125918,"_28187":125919,"_3059":125920},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3604":74403,"_31000":74396,"_5":31356,"_21469":125922,"_28187":125923,"_3059":125924},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3604":74404,"_31000":74396,"_5":31356,"_21469":125926,"_28187":125927,"_3059":125928},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3604":74405,"_31000":74396,"_5":31356,"_21469":125930,"_28187":125931,"_3059":125932},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3604":74406,"_31000":74396,"_5":31356,"_21469":125934,"_28187":125935,"_3059":125936},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#continúa","Continúa",{"_3604":74407,"_31000":74396,"_21469":125938,"_5":14752,"_28187":74396,"_3059":125939},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3604":74408,"_31000":74396,"_21469":125941,"_5":14752,"_28187":125903,"_3059":125942},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3604":74409,"_31000":74396,"_21469":125944,"_5":14752,"_28187":125903,"_3059":125945},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3604":74410,"_31000":74396,"_21469":125947,"_5":14752,"_28187":125903,"_3059":125948},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3604":74411,"_31000":74396,"_21469":125950,"_5":14752,"_28187":125903,"_3059":125951},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3604":74412,"_31000":74396,"_21469":125953,"_5":14752,"_28187":125903,"_3059":125954},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3604":74413,"_31000":74396,"_21469":125956,"_5":14752,"_28187":125903,"_3059":125957},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3604":74414,"_31000":74396,"_21469":125959,"_5":14752,"_28187":125903,"_3059":125960},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3604":74415,"_31000":74396,"_21469":125962,"_5":14752,"_28187":125907,"_3059":125963},[],"Descarga el PEM e inspecciónalo:",{"_3604":74416,"_31000":74396,"_21469":125965,"_5":14752,"_28187":125907,"_3059":125966},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3604":74417,"_31000":74396,"_21469":125968,"_5":14752,"_28187":125911,"_3059":125969},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3604":74418,"_31000":74396,"_21469":125971,"_5":14752,"_28187":125911,"_3059":125972},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3604":74419,"_31000":74396,"_21469":125974,"_5":14752,"_28187":125911,"_3059":125975},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3604":74420,"_31000":74396,"_21469":125977,"_5":14752,"_28187":125911,"_3059":125978},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3604":74421,"_31000":74396,"_21469":125980,"_5":14752,"_28187":125911,"_3059":125981},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3604":74422,"_31000":74396,"_21469":125983,"_5":14752,"_28187":125911,"_3059":125984},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3604":74423,"_31000":74396,"_21469":125986,"_5":14752,"_28187":125911,"_3059":125987},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3604":74424,"_31000":74396,"_21469":125989,"_5":14752,"_28187":125915,"_3059":125990},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3604":74425,"_31000":74396,"_21469":125992,"_5":14752,"_28187":125919,"_3059":125993},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3604":74426,"_31000":74396,"_21469":125995,"_5":14752,"_28187":125923,"_3059":125996},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3604":74427,"_31000":74396,"_21469":125998,"_5":14752,"_28187":125927,"_3059":125999},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3604":74428,"_31000":74396,"_21469":126001,"_5":14752,"_28187":125927,"_3059":126002},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3604":74429,"_31000":74396,"_21469":126004,"_5":14752,"_28187":125927,"_3059":126005},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3604":74430,"_31000":74396,"_21469":126007,"_5":14752,"_28187":125931,"_3059":126008},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3604":74431,"_31000":74396,"_21469":126010,"_5":14752,"_28187":125931,"_3059":126011},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3604":74432,"_31000":74396,"_21469":126013,"_5":14752,"_28187":125931,"_3059":126014},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3604":74433,"_31000":74396,"_21469":126016,"_5":14752,"_28187":125935,"_3059":126017},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3604":74434,"_31000":74396,"_21469":126019,"_5":14752,"_28187":125935,"_3059":126020},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3604":74435,"_31000":74435,"_5":15112,"_3059":126022,"_31359":126023,"_21469":126025,"_28187":74435},"Ciclo de vida de un certificado",[50673,121110,56348,126024],"Conceptos",[],{"_3604":74436,"_31000":74435,"_21469":126027,"_5":14752,"_28187":74435,"_3059":126028},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3604":74437,"_31000":74435,"_5":31356,"_21469":126030,"_28187":126031,"_3059":126032},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3604":74438,"_31000":74435,"_5":31356,"_21469":126034,"_28187":126035,"_3059":126036},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3604":74439,"_31000":74435,"_5":31356,"_21469":126038,"_28187":126039,"_3059":126040},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3604":74440,"_31000":74435,"_5":31356,"_21469":126042,"_28187":126043,"_3059":126044},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3604":74441,"_31000":74435,"_5":31356,"_21469":126046,"_28187":126047,"_3059":126048},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3604":74442,"_31000":74435,"_5":31356,"_21469":126050,"_28187":126051,"_3059":126052},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3604":74443,"_31000":74435,"_5":31356,"_21469":126054,"_28187":126055,"_3059":123744},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3604":74444,"_31000":74435,"_5":31356,"_21469":126057,"_28187":126058,"_3059":126059},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3604":74445,"_31000":74435,"_5":31356,"_21469":126061,"_28187":126062,"_3059":126063},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3604":74446,"_31000":74435,"_5":31356,"_21469":126065,"_28187":126066,"_3059":126067},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3604":74447,"_31000":74435,"_21469":126069,"_5":14752,"_28187":74435,"_3059":126070},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3604":74448,"_31000":74435,"_21469":126072,"_5":14752,"_28187":126035,"_3059":126073},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3604":74449,"_31000":74435,"_21469":126075,"_5":14752,"_28187":126039,"_3059":126076},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3604":74450,"_31000":74435,"_21469":126078,"_5":14752,"_28187":126043,"_3059":126079},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3604":74451,"_31000":74435,"_21469":126081,"_5":14752,"_28187":126047,"_3059":126082},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3604":74452,"_31000":74435,"_21469":126084,"_5":14752,"_28187":126051,"_3059":126085},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3604":74453,"_31000":74435,"_21469":126087,"_5":14752,"_28187":126055,"_3059":126088},[],"Lamassu persiste cuatro estados X.509:",{"_3604":74454,"_31000":74435,"_21469":126090,"_5":14752,"_28187":126055,"_3059":126091},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3604":74455,"_31000":74435,"_21469":126093,"_5":14752,"_28187":126055,"_3059":126094},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3604":74456,"_31000":74435,"_21469":126096,"_5":14752,"_28187":126055,"_3059":126097},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3604":74457,"_31000":74435,"_21469":126099,"_5":14752,"_28187":126055,"_3059":126100},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3604":74458,"_31000":74435,"_21469":126102,"_5":14752,"_28187":126055,"_3059":126103},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3604":74459,"_31000":74435,"_21469":126105,"_5":14752,"_28187":126058,"_3059":126106},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3604":74460,"_31000":74435,"_21469":126108,"_5":14752,"_28187":126058,"_3059":126109},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3604":74461,"_31000":74435,"_21469":126111,"_5":14752,"_28187":126058,"_3059":126112},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3604":74462,"_31000":74435,"_21469":126114,"_5":14752,"_28187":126062,"_3059":126115},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3604":74463,"_31000":74435,"_21469":126117,"_5":14752,"_28187":126062,"_3059":126118},[],"Antes de confirmar:",{"_3604":74464,"_31000":74435,"_21469":126120,"_5":14752,"_28187":126062,"_3059":126121},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3604":74465,"_31000":74435,"_21469":126123,"_5":14752,"_28187":126062,"_3059":126124},[],"Distribuye la nueva cadena de confianza.",{"_3604":74466,"_31000":74435,"_21469":126126,"_5":14752,"_28187":126062,"_3059":126127},[],"Reemite las identidades necesarias.",{"_3604":74467,"_31000":74435,"_21469":126129,"_5":14752,"_28187":126062,"_3059":126130},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3604":74468,"_31000":74435,"_21469":126132,"_5":14752,"_28187":126062,"_3059":126133},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3604":74469,"_31000":74435,"_21469":126135,"_5":14752,"_28187":126062,"_3059":126136},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3604":74470,"_31000":74435,"_21469":126138,"_5":14752,"_28187":126066,"_3059":126139},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3604":74471,"_31000":74435,"_21469":126141,"_5":14752,"_28187":126066,"_3059":126142},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3604":74472,"_31000":74435,"_21469":126144,"_5":14752,"_28187":126066,"_3059":126145},[],"Cambios de estado y razones de revocación.",{"_3604":74473,"_31000":74435,"_21469":126147,"_5":14752,"_28187":126066,"_3059":126148},[],"Publicación y vigencia de OCSP y CRLs.",{"_3604":74474,"_31000":74435,"_21469":126150,"_5":14752,"_28187":126066,"_3059":126151},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3604":74475,"_31000":74435,"_21469":126153,"_5":14752,"_28187":126066,"_3059":126154},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3604":74476,"_31000":74476,"_5":15112,"_3059":126156,"_31359":126157,"_21469":126158,"_28187":74476},"Modelo de confianza",[50673,121110,56348,126024],[],{"_3604":74477,"_31000":74476,"_21469":126160,"_5":14752,"_28187":74476,"_3059":126161},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3604":74478,"_31000":74476,"_5":31356,"_21469":126163,"_28187":126164,"_3059":126165},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3604":74479,"_31000":74476,"_5":31356,"_21469":126167,"_28187":126168,"_3059":126169},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3604":74480,"_31000":74476,"_5":31356,"_21469":126171,"_28187":126172,"_3059":126173},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3604":74481,"_31000":74476,"_5":31356,"_21469":126175,"_28187":126176,"_3059":126177},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3604":74482,"_31000":74476,"_5":31356,"_21469":126179,"_28187":126180,"_3059":126181},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3604":74483,"_31000":74476,"_5":31356,"_21469":126183,"_28187":126184,"_3059":126185},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3604":74484,"_31000":74476,"_5":31356,"_21469":126187,"_28187":126188,"_3059":126189},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3604":74485,"_31000":74476,"_5":31356,"_21469":126191,"_28187":126192,"_3059":126193},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3604":74486,"_31000":74476,"_5":31356,"_21469":126195,"_28187":126196,"_3059":126197},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3604":74487,"_31000":74476,"_5":31356,"_21469":126199,"_28187":126200,"_3059":126201},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3604":74488,"_31000":74476,"_21469":126203,"_5":14752,"_28187":74476,"_3059":126204},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3604":74489,"_31000":74476,"_21469":126206,"_5":14752,"_28187":126168,"_3059":126207},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3604":74490,"_31000":74476,"_21469":126209,"_5":14752,"_28187":126172,"_3059":126210},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3604":74491,"_31000":74476,"_21469":126212,"_5":14752,"_28187":126176,"_3059":126213},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3604":74492,"_31000":74476,"_21469":126215,"_5":14752,"_28187":126180,"_3059":126216},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3604":74493,"_31000":74476,"_21469":126218,"_5":14752,"_28187":126184,"_3059":126219},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3604":74494,"_31000":74476,"_21469":126221,"_5":14752,"_28187":126184,"_3059":126222},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3604":74495,"_31000":74476,"_21469":126224,"_5":14752,"_28187":126184,"_3059":126225},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3604":74496,"_31000":74476,"_21469":126227,"_5":14752,"_28187":126184,"_3059":126228},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3604":74497,"_31000":74476,"_21469":126230,"_5":14752,"_28187":126184,"_3059":126231},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3604":74498,"_31000":74476,"_21469":126233,"_5":14752,"_28187":126184,"_3059":126234},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3604":74499,"_31000":74476,"_21469":126236,"_5":14752,"_28187":126188,"_3059":126237},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3604":74500,"_31000":74476,"_21469":126239,"_5":14752,"_28187":126188,"_3059":126240},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3604":74501,"_31000":74476,"_21469":126242,"_5":14752,"_28187":126188,"_3059":126243},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3604":74502,"_31000":74476,"_21469":126245,"_5":14752,"_28187":126188,"_3059":126246},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3604":74503,"_31000":74476,"_21469":126248,"_5":14752,"_28187":126188,"_3059":126249},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3604":74504,"_31000":74476,"_21469":126251,"_5":14752,"_28187":126192,"_3059":126252},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3604":74505,"_31000":74476,"_21469":126254,"_5":14752,"_28187":126192,"_3059":126255},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3604":74506,"_31000":74476,"_21469":126257,"_5":14752,"_28187":126192,"_3059":126258},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3604":74507,"_31000":74476,"_21469":126260,"_5":14752,"_28187":126192,"_3059":126261},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3604":74508,"_31000":74476,"_21469":126263,"_5":14752,"_28187":126192,"_3059":126264},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3604":74509,"_31000":74476,"_21469":126266,"_5":14752,"_28187":126192,"_3059":126267},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3604":74510,"_31000":74476,"_21469":126269,"_5":14752,"_28187":126192,"_3059":126270},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3604":74511,"_31000":74476,"_21469":126272,"_5":14752,"_28187":126196,"_3059":126273},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3604":74512,"_31000":74476,"_21469":126275,"_5":14752,"_28187":126200,"_3059":126276},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3604":74513,"_31000":74476,"_21469":126278,"_5":14752,"_28187":126200,"_3059":126279},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3604":74514,"_31000":74476,"_21469":126281,"_5":14752,"_28187":126200,"_3059":126282},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3604":74515,"_31000":74476,"_21469":126284,"_5":14752,"_28187":126200,"_3059":126285},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3604":74516,"_31000":74476,"_21469":126287,"_5":14752,"_28187":126200,"_3059":126288},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3604":74517,"_31000":74476,"_21469":126290,"_5":14752,"_28187":126200,"_3059":126291},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3604":74518,"_31000":74476,"_21469":126293,"_5":14752,"_28187":126200,"_3059":126294},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3604":74519,"_31000":74519,"_5":15112,"_3059":126296,"_31359":126297,"_21469":126298,"_28187":74519},"Listas de revocación (CRL)",[50673,121110,56348,125770],[],{"_3604":74520,"_31000":74519,"_21469":126300,"_5":14752,"_28187":74519,"_3059":126301},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3604":74521,"_31000":74519,"_5":31356,"_21469":126303,"_28187":126304,"_3059":126305},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3604":74522,"_31000":74519,"_5":31356,"_21469":126307,"_28187":126308,"_3059":126309},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3604":74523,"_31000":74519,"_5":31356,"_21469":126311,"_28187":126312,"_3059":126313},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3604":74524,"_31000":74519,"_5":31356,"_21469":126315,"_28187":126316,"_3059":126317},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3604":74525,"_31000":74519,"_5":31356,"_21469":126319,"_28187":126320,"_3059":126321},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3604":74526,"_31000":74519,"_5":31356,"_21469":126323,"_28187":126324,"_3059":126325},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3604":74527,"_31000":74519,"_5":31356,"_21469":126327,"_28187":126328,"_3059":126329},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3604":74528,"_31000":74519,"_5":31356,"_21469":126331,"_28187":126332,"_3059":126333},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#referencias","Referencias",{"_3604":74529,"_31000":74519,"_21469":126335,"_5":14752,"_28187":74519,"_3059":126336},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3604":74530,"_31000":74519,"_21469":126338,"_5":14752,"_28187":126304,"_3059":126339},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3604":74531,"_31000":74519,"_21469":126341,"_5":14752,"_28187":126304,"_3059":126342},[],"Campo",{"_3604":74532,"_31000":74519,"_21469":126344,"_5":14752,"_28187":126304,"_3059":122784},[],{"_3604":74533,"_31000":74519,"_21469":126346,"_5":14752,"_28187":126304,"_3059":52305},[],{"_3604":74534,"_31000":74519,"_21469":126348,"_5":14752,"_28187":126304,"_3059":126349},[],"ID de la CA a la que pertenecen los ajustes.",{"_3604":74535,"_31000":74519,"_21469":126351,"_5":14752,"_28187":126304,"_3059":57583},[],{"_3604":74536,"_31000":74519,"_21469":126353,"_5":14752,"_28187":126304,"_3059":126354},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3604":74537,"_31000":74519,"_21469":126356,"_5":14752,"_28187":126304,"_3059":57589},[],{"_3604":74538,"_31000":74519,"_21469":126358,"_5":14752,"_28187":126304,"_3059":126359},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3604":74539,"_31000":74519,"_21469":126361,"_5":14752,"_28187":126304,"_3059":57595},[],{"_3604":74540,"_31000":74519,"_21469":126363,"_5":14752,"_28187":126304,"_3059":126364},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3604":74541,"_31000":74519,"_21469":126366,"_5":14752,"_28187":126304,"_3059":126367},[],"Campo de `crl_options`",{"_3604":74542,"_31000":74519,"_21469":126369,"_5":14752,"_28187":126304,"_3059":122784},[],{"_3604":74543,"_31000":74519,"_21469":126371,"_5":14752,"_28187":126304,"_3059":126372},[],"Valor inicial",{"_3604":74544,"_31000":74519,"_21469":126374,"_5":14752,"_28187":126304,"_3059":57609},[],{"_3604":74545,"_31000":74519,"_21469":126376,"_5":14752,"_28187":126304,"_3059":126377},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3604":74546,"_31000":74519,"_21469":126379,"_5":14752,"_28187":126304,"_3059":126380},[],"7 días.",{"_3604":74547,"_31000":74519,"_21469":126382,"_5":14752,"_28187":126304,"_3059":57618},[],{"_3604":74548,"_31000":74519,"_21469":126384,"_5":14752,"_28187":126304,"_3059":126385},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3604":74549,"_31000":74519,"_21469":126387,"_5":14752,"_28187":126304,"_3059":126388},[],"6 días y 23 horas.",{"_3604":74550,"_31000":74519,"_21469":126390,"_5":14752,"_28187":126304,"_3059":57627},[],{"_3604":74551,"_31000":74519,"_21469":126392,"_5":14752,"_28187":126304,"_3059":126393},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3604":74552,"_31000":74519,"_21469":126395,"_5":14752,"_28187":126304,"_3059":57633},[],{"_3604":74553,"_31000":74519,"_21469":126397,"_5":14752,"_28187":126304,"_3059":57636},[],{"_3604":74554,"_31000":74519,"_21469":126399,"_5":14752,"_28187":126304,"_3059":126400},[],"Número de serie del certificado existente que firma la CRL.",{"_3604":74555,"_31000":74519,"_21469":126402,"_5":14752,"_28187":126304,"_3059":126403},[],"Número de serie del certificado actual de la CA.",{"_3604":74556,"_31000":74519,"_21469":126405,"_5":14752,"_28187":126304,"_3059":126406},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3604":74557,"_31000":74519,"_21469":126408,"_5":14752,"_28187":126304,"_3059":126409},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3604":74558,"_31000":74519,"_21469":126411,"_5":14752,"_28187":126304,"_3059":126412},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3604":74559,"_31000":74519,"_21469":126414,"_5":14752,"_28187":126304,"_3059":126415},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3604":74560,"_31000":74519,"_21469":126417,"_5":14752,"_28187":126304,"_3059":126418},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3604":74561,"_31000":74519,"_21469":126420,"_5":14752,"_28187":126304,"_3059":126421},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3604":74562,"_31000":74519,"_21469":126423,"_5":14752,"_28187":126304,"_3059":126424},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3604":74563,"_31000":74519,"_21469":126426,"_5":14752,"_28187":126304,"_3059":126427},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3604":74564,"_31000":74519,"_21469":126429,"_5":14752,"_28187":126304,"_3059":126430},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3604":74565,"_31000":74519,"_21469":126432,"_5":14752,"_28187":126304,"_3059":126433},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3604":74566,"_31000":74519,"_21469":126435,"_5":14752,"_28187":126304,"_3059":126436},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3604":74567,"_31000":74519,"_21469":126438,"_5":14752,"_28187":126308,"_3059":126439},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3604":74568,"_31000":74519,"_21469":126441,"_5":14752,"_28187":126308,"_3059":126442},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3604":74569,"_31000":74519,"_21469":126444,"_5":14752,"_28187":126308,"_3059":126445},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3604":74570,"_31000":74519,"_21469":126447,"_5":14752,"_28187":126308,"_3059":126448},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3604":74571,"_31000":74519,"_21469":126450,"_5":14752,"_28187":126312,"_3059":126451},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3604":74572,"_31000":74519,"_21469":126453,"_5":14752,"_28187":126312,"_3059":126454},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3604":74573,"_31000":74519,"_21469":126456,"_5":14752,"_28187":126312,"_3059":126457},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3604":74574,"_31000":74519,"_21469":126459,"_5":14752,"_28187":126312,"_3059":126460},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3604":74575,"_31000":74519,"_21469":126462,"_5":14752,"_28187":126312,"_3059":126463},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3604":74576,"_31000":74519,"_21469":126465,"_5":14752,"_28187":126312,"_3059":126466},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3604":74577,"_31000":74519,"_21469":126468,"_5":14752,"_28187":126312,"_3059":126469},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3604":74578,"_31000":74519,"_21469":126471,"_5":14752,"_28187":126312,"_3059":126472},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3604":74579,"_31000":74519,"_21469":126474,"_5":14752,"_28187":126312,"_3059":126475},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3604":74580,"_31000":74519,"_21469":126477,"_5":14752,"_28187":126316,"_3059":126478},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3604":74581,"_31000":74519,"_21469":126480,"_5":14752,"_28187":126316,"_3059":126481},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3604":74582,"_31000":74519,"_21469":126483,"_5":14752,"_28187":126320,"_3059":126484},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3604":74583,"_31000":74519,"_21469":126486,"_5":14752,"_28187":126320,"_3059":126487},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3604":74584,"_31000":74519,"_21469":126489,"_5":14752,"_28187":126320,"_3059":126490},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3604":74585,"_31000":74519,"_21469":126492,"_5":14752,"_28187":126320,"_3059":126493},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3604":74586,"_31000":74519,"_21469":126495,"_5":14752,"_28187":126320,"_3059":126496},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3604":74587,"_31000":74519,"_21469":126498,"_5":14752,"_28187":126324,"_3059":126499},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3604":74588,"_31000":74519,"_21469":126501,"_5":14752,"_28187":126324,"_3059":122973},[],{"_3604":74589,"_31000":74519,"_21469":126503,"_5":14752,"_28187":126324,"_3059":126504},[],"Path relativo",{"_3604":74590,"_31000":74519,"_21469":126506,"_5":14752,"_28187":126324,"_3059":120870},[],{"_3604":74591,"_31000":74519,"_21469":126508,"_5":14752,"_28187":126324,"_3059":57748},[],{"_3604":74592,"_31000":74519,"_21469":126510,"_5":14752,"_28187":126324,"_3059":57751},[],{"_3604":74593,"_31000":74519,"_21469":126512,"_5":14752,"_28187":126324,"_3059":126513},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3604":74594,"_31000":74519,"_21469":126515,"_5":14752,"_28187":126324,"_3059":57748},[],{"_3604":74595,"_31000":74519,"_21469":126517,"_5":14752,"_28187":126324,"_3059":57759},[],{"_3604":74596,"_31000":74519,"_21469":126519,"_5":14752,"_28187":126324,"_3059":126520},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3604":74597,"_31000":74519,"_21469":126522,"_5":14752,"_28187":126324,"_3059":57765},[],{"_3604":74598,"_31000":74519,"_21469":126524,"_5":14752,"_28187":126324,"_3059":57759},[],{"_3604":74599,"_31000":74519,"_21469":126526,"_5":14752,"_28187":126324,"_3059":126527},[],"Sustituir la configuración de CRL de una CA.",{"_3604":74600,"_31000":74519,"_21469":126529,"_5":14752,"_28187":126324,"_3059":57773},[],{"_3604":74601,"_31000":74519,"_21469":126531,"_5":14752,"_28187":126324,"_3059":57759},[],{"_3604":74602,"_31000":74519,"_21469":126533,"_5":14752,"_28187":126324,"_3059":126534},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3604":74603,"_31000":74519,"_21469":126536,"_5":14752,"_28187":126324,"_3059":126537},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3604":74604,"_31000":74519,"_21469":126539,"_5":14752,"_28187":126324,"_3059":126540},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3604":74605,"_31000":74519,"_21469":126542,"_5":14752,"_28187":126324,"_3059":126543},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3604":74606,"_31000":74519,"_21469":126545,"_5":14752,"_28187":126328,"_3059":126546},[],"Síntoma",{"_3604":74607,"_31000":74519,"_21469":126548,"_5":14752,"_28187":126328,"_3059":126549},[],"Causa",{"_3604":74608,"_31000":74519,"_21469":126551,"_5":14752,"_28187":126328,"_3059":126552},[],"Acción",{"_3604":74609,"_31000":74519,"_21469":126554,"_5":14752,"_28187":126328,"_3059":126555},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3604":74610,"_31000":74519,"_21469":126557,"_5":14752,"_28187":126328,"_3059":126558},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3604":74611,"_31000":74519,"_21469":126560,"_5":14752,"_28187":126328,"_3059":126561},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3604":74612,"_31000":74519,"_21469":126563,"_5":14752,"_28187":126328,"_3059":126564},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3604":74613,"_31000":74519,"_21469":126566,"_5":14752,"_28187":126328,"_3059":126567},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3604":74614,"_31000":74519,"_21469":126569,"_5":14752,"_28187":126328,"_3059":126570},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3604":74615,"_31000":74519,"_21469":126572,"_5":14752,"_28187":126328,"_3059":126573},[],"`PUT` devuelve 400.",{"_3604":74616,"_31000":74519,"_21469":126575,"_5":14752,"_28187":126328,"_3059":126576},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3604":74617,"_31000":74519,"_21469":126578,"_5":14752,"_28187":126328,"_3059":126579},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3604":74618,"_31000":74519,"_21469":126581,"_5":14752,"_28187":126328,"_3059":126582},[],"`PUT` devuelve 404.",{"_3604":74619,"_31000":74519,"_21469":126584,"_5":14752,"_28187":126328,"_3059":126585},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL (por ejemplo, una CA importada).",{"_3604":74620,"_31000":74519,"_21469":126587,"_5":14752,"_28187":126328,"_3059":126588},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3604":74621,"_31000":74519,"_21469":126590,"_5":14752,"_28187":126328,"_3059":126591},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3604":74622,"_31000":74519,"_21469":126593,"_5":14752,"_28187":126328,"_3059":126594},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3604":74623,"_31000":74519,"_21469":126596,"_5":14752,"_28187":126328,"_3059":126597},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3604":74624,"_31000":74519,"_21469":126599,"_5":14752,"_28187":126328,"_3059":126600},[],"La CRL no cambia tras revocar un certificado.",{"_3604":74625,"_31000":74519,"_21469":126602,"_5":14752,"_28187":126328,"_3059":126603},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3604":74626,"_31000":74519,"_21469":126605,"_5":14752,"_28187":126328,"_3059":126606},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3604":74627,"_31000":74519,"_21469":126608,"_5":14752,"_28187":126328,"_3059":126609},[],"Un verificador rechaza la CRL por el emisor.",{"_3604":74628,"_31000":74519,"_21469":126611,"_5":14752,"_28187":126328,"_3059":126612},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3604":74629,"_31000":74519,"_21469":126614,"_5":14752,"_28187":126328,"_3059":126615},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3604":74630,"_31000":74519,"_21469":126617,"_5":14752,"_28187":126332,"_3059":126618},[],"RFC 5280: perfil X.509 y CRL.",{"_3604":74631,"_31000":74519,"_21469":126620,"_5":14752,"_28187":126332,"_3059":57865},[],{"_3604":74632,"_31000":74519,"_21469":126622,"_5":14752,"_28187":126332,"_3059":57868},[],{"_3604":74633,"_31000":74519,"_21469":126624,"_5":14752,"_28187":126332,"_3059":126625},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3604":74634,"_31000":74519,"_21469":126627,"_5":14752,"_28187":126332,"_3059":126628},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3604":74635,"_31000":74635,"_5":15112,"_3059":126630,"_31359":126631,"_21469":126632,"_28187":74635},"Claves y motores criptográficos",[50673,121110,56348,125121],[],{"_3604":74636,"_31000":74635,"_21469":126634,"_5":14752,"_28187":74635,"_3059":126635},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3604":74637,"_31000":74635,"_5":31356,"_21469":126637,"_28187":126638,"_3059":126639},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3604":74638,"_31000":74635,"_5":31356,"_21469":126641,"_28187":126642,"_3059":126643},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3604":74639,"_31000":74635,"_5":31356,"_21469":126645,"_28187":126646,"_3059":57893},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#file-system",{"_3604":74640,"_31000":74635,"_5":31356,"_21469":126648,"_28187":126649,"_3059":57897},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#hashicorp-vault",{"_3604":74641,"_31000":74635,"_5":31356,"_21469":126651,"_28187":126652,"_3059":57901},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#aws-secrets-manager",{"_3604":74642,"_31000":74635,"_5":31356,"_21469":126654,"_28187":126655,"_3059":57905},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#aws-kms",{"_3604":74643,"_31000":74635,"_5":31356,"_21469":126657,"_28187":126658,"_3059":57909},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#pkcs11",{"_3604":74644,"_31000":74635,"_5":31356,"_21469":126660,"_28187":126661,"_3059":57913},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#azure-key-vault",{"_3604":74645,"_31000":74635,"_5":31356,"_21469":126663,"_28187":126664,"_3059":126665},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3604":74646,"_31000":74635,"_5":31356,"_21469":126667,"_28187":126668,"_3059":126669},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3604":74647,"_31000":74635,"_5":31356,"_21469":126671,"_28187":126672,"_3059":126673},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3604":74648,"_31000":74635,"_5":31356,"_21469":126675,"_28187":126676,"_3059":126677},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3604":74649,"_31000":74635,"_5":31356,"_21469":126679,"_28187":126680,"_3059":126681},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3604":74650,"_31000":74635,"_5":31356,"_21469":126683,"_28187":126684,"_3059":126685},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3604":74651,"_31000":74635,"_5":31356,"_21469":126687,"_28187":126688,"_3059":126689},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3604":74652,"_31000":74635,"_5":31356,"_21469":126691,"_28187":126692,"_3059":57945},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#sign",{"_3604":74653,"_31000":74635,"_5":31356,"_21469":126694,"_28187":126695,"_3059":57949},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#verify",{"_3604":74654,"_31000":74635,"_5":31356,"_21469":126697,"_28187":126698,"_3059":126699},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3604":74655,"_31000":74635,"_5":31356,"_21469":126701,"_28187":126702,"_3059":126703},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3604":74656,"_31000":74635,"_5":31356,"_21469":126705,"_28187":126706,"_3059":126707},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3604":74657,"_31000":74635,"_21469":126709,"_5":14752,"_28187":74635,"_3059":126710},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3604":74658,"_31000":74635,"_21469":126712,"_5":14752,"_28187":74635,"_3059":126713},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3604":74659,"_31000":74635,"_21469":126715,"_5":14752,"_28187":126638,"_3059":126716},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3604":74660,"_31000":74635,"_21469":126718,"_5":14752,"_28187":126638,"_3059":126719},[],"En la práctica, permite:",{"_3604":74661,"_31000":74635,"_21469":126721,"_5":14752,"_28187":126638,"_3059":126722},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3604":74662,"_31000":74635,"_21469":126724,"_5":14752,"_28187":126638,"_3059":126725},[],"Importar claves creadas externamente.",{"_3604":74663,"_31000":74635,"_21469":126727,"_5":14752,"_28187":126638,"_3059":126728},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3604":74664,"_31000":74635,"_21469":126730,"_5":14752,"_28187":126638,"_3059":126731},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3604":74665,"_31000":74635,"_21469":126733,"_5":14752,"_28187":126642,"_3059":126734},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3604":74666,"_31000":74635,"_21469":126736,"_5":14752,"_28187":126642,"_3059":126737},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3604":74667,"_31000":74635,"_21469":126739,"_5":14752,"_28187":126642,"_3059":126740},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3604":74668,"_31000":74635,"_21469":126742,"_5":14752,"_28187":126646,"_3059":126743},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3604":74669,"_31000":74635,"_21469":126745,"_5":14752,"_28187":126649,"_3059":126746},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3604":74670,"_31000":74635,"_21469":126748,"_5":14752,"_28187":126649,"_3059":126749},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3604":74671,"_31000":74635,"_21469":126751,"_5":14752,"_28187":126652,"_3059":126752},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3604":74672,"_31000":74635,"_21469":126754,"_5":14752,"_28187":126655,"_3059":126755},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3604":74673,"_31000":74635,"_21469":126757,"_5":14752,"_28187":126658,"_3059":126758},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3604":74674,"_31000":74635,"_21469":126760,"_5":14752,"_28187":126661,"_3059":126761},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3604":74675,"_31000":74635,"_21469":126763,"_5":14752,"_28187":126661,"_3059":126764},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3604":74676,"_31000":74635,"_21469":126766,"_5":14752,"_28187":126661,"_3059":126767},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3604":74677,"_31000":74635,"_21469":126769,"_5":14752,"_28187":126661,"_3059":126770},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3604":74678,"_31000":74635,"_21469":126772,"_5":14752,"_28187":126664,"_3059":126773},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3604":74679,"_31000":74635,"_21469":126775,"_5":14752,"_28187":126664,"_3059":126776},[],"La tabla incluye los siguientes campos:",{"_3604":74680,"_31000":74635,"_21469":126778,"_5":14752,"_28187":126664,"_3059":126779},[],"**Name**: nombre descriptivo de la clave.",{"_3604":74681,"_31000":74635,"_21469":126781,"_5":14752,"_28187":126664,"_3059":126782},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3604":74682,"_31000":74635,"_21469":126784,"_5":14752,"_28187":126664,"_3059":126785},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3604":74683,"_31000":74635,"_21469":126787,"_5":14752,"_28187":126664,"_3059":126788},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3604":74684,"_31000":74635,"_21469":126790,"_5":14752,"_28187":126664,"_3059":126791},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3604":74685,"_31000":74635,"_21469":126793,"_5":14752,"_28187":126664,"_3059":126794},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3604":74686,"_31000":74635,"_21469":126796,"_5":14752,"_28187":126664,"_3059":126797},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3604":74687,"_31000":74635,"_21469":126799,"_5":14752,"_28187":126664,"_3059":126800},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3604":74688,"_31000":74635,"_21469":126802,"_5":14752,"_28187":126664,"_3059":126803},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3604":74689,"_31000":74635,"_21469":126805,"_5":14752,"_28187":126664,"_3059":126806},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3604":74690,"_31000":74635,"_21469":126808,"_5":14752,"_28187":126664,"_3059":126809},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3604":74691,"_31000":74635,"_21469":126811,"_5":14752,"_28187":126664,"_3059":126812},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3604":74692,"_31000":74635,"_21469":126814,"_5":14752,"_28187":126664,"_3059":126815},[],"**Delete Key** para eliminar la clave del sistema.",{"_3604":74693,"_31000":74635,"_21469":126817,"_5":14752,"_28187":126668,"_3059":126818},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3604":74694,"_31000":74635,"_21469":126820,"_5":14752,"_28187":126672,"_3059":126821},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3604":74695,"_31000":74635,"_21469":126823,"_5":14752,"_28187":126672,"_3059":126824},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3604":74696,"_31000":74635,"_21469":126826,"_5":14752,"_28187":126672,"_3059":126827},[],"**Key Name**: nombre único y descriptivo.",{"_3604":74697,"_31000":74635,"_21469":126829,"_5":14752,"_28187":126672,"_3059":126830},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3604":74698,"_31000":74635,"_21469":126832,"_5":14752,"_28187":126672,"_3059":126833},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3604":74699,"_31000":74635,"_21469":126835,"_5":14752,"_28187":126672,"_3059":126836},[],"**Tags**: metadatos para clasificar la clave.",{"_3604":74700,"_31000":74635,"_21469":126838,"_5":14752,"_28187":126672,"_3059":126839},[],"**Metadata**: información adicional para usos avanzados.",{"_3604":74701,"_31000":74635,"_21469":126841,"_5":14752,"_28187":126676,"_3059":126842},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3604":74702,"_31000":74635,"_21469":126844,"_5":14752,"_28187":126676,"_3059":126845},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3604":74703,"_31000":74635,"_21469":126847,"_5":14752,"_28187":126676,"_3059":126848},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3604":74704,"_31000":74635,"_21469":126850,"_5":14752,"_28187":126676,"_3059":126851},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3604":74705,"_31000":74635,"_21469":126853,"_5":14752,"_28187":126676,"_3059":126854},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3604":74706,"_31000":74635,"_21469":126856,"_5":14752,"_28187":126676,"_3059":126857},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3604":74707,"_31000":74635,"_21469":126859,"_5":14752,"_28187":126676,"_3059":126860},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3604":74708,"_31000":74635,"_21469":126862,"_5":14752,"_28187":126676,"_3059":126863},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3604":74709,"_31000":74635,"_21469":126865,"_5":14752,"_28187":126676,"_3059":126866},[],"**Metadata**: información adicional opcional.",{"_3604":74710,"_31000":74635,"_21469":126868,"_5":14752,"_28187":126676,"_3059":126869},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3604":74711,"_31000":74635,"_21469":126871,"_5":14752,"_28187":126676,"_3059":126872},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3604":74712,"_31000":74635,"_21469":126874,"_5":14752,"_28187":126680,"_3059":126875},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3604":74713,"_31000":74635,"_21469":126877,"_5":14752,"_28187":126684,"_3059":126878},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3604":74714,"_31000":74635,"_21469":126880,"_5":14752,"_28187":126684,"_3059":126881},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3604":74715,"_31000":74635,"_21469":126883,"_5":14752,"_28187":126684,"_3059":126884},[],"**Key Name**: nombre descriptivo.",{"_3604":74716,"_31000":74635,"_21469":126886,"_5":14752,"_28187":126684,"_3059":126887},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3604":74717,"_31000":74635,"_21469":126889,"_5":14752,"_28187":126684,"_3059":126890},[],"**Tags**: etiquetas asociadas.",{"_3604":74718,"_31000":74635,"_21469":126892,"_5":14752,"_28187":126684,"_3059":126893},[],"**Aliases**: nombres alternativos.",{"_3604":74719,"_31000":74635,"_21469":126895,"_5":14752,"_28187":126684,"_3059":126896},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3604":74720,"_31000":74635,"_21469":126898,"_5":14752,"_28187":126684,"_3059":126899},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3604":74721,"_31000":74635,"_21469":126901,"_5":14752,"_28187":126684,"_3059":126902},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3604":74722,"_31000":74635,"_21469":126904,"_5":14752,"_28187":126684,"_3059":126905},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3604":74723,"_31000":74635,"_21469":126907,"_5":14752,"_28187":126688,"_3059":126908},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3604":74724,"_31000":74635,"_21469":126910,"_5":14752,"_28187":126688,"_3059":126911},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3604":74725,"_31000":74635,"_21469":126913,"_5":14752,"_28187":126688,"_3059":126914},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3604":74726,"_31000":74635,"_21469":126916,"_5":14752,"_28187":126692,"_3059":126917},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3604":74727,"_31000":74635,"_21469":126919,"_5":14752,"_28187":126692,"_3059":126920},[],"Campos principales:",{"_3604":74728,"_31000":74635,"_21469":126922,"_5":14752,"_28187":126692,"_3059":126923},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3604":74729,"_31000":74635,"_21469":126925,"_5":14752,"_28187":126692,"_3059":126926},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3604":74730,"_31000":74635,"_21469":126928,"_5":14752,"_28187":126692,"_3059":126929},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3604":74731,"_31000":74635,"_21469":126931,"_5":14752,"_28187":126692,"_3059":126932},[],"**Message**: contenido que se va a firmar.",{"_3604":74732,"_31000":74635,"_21469":126934,"_5":14752,"_28187":126692,"_3059":126935},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3604":74733,"_31000":74635,"_21469":126937,"_5":14752,"_28187":126695,"_3059":126938},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3604":74734,"_31000":74635,"_21469":126940,"_5":14752,"_28187":126695,"_3059":126920},[],{"_3604":74735,"_31000":74635,"_21469":126942,"_5":14752,"_28187":126695,"_3059":126943},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3604":74736,"_31000":74635,"_21469":126945,"_5":14752,"_28187":126695,"_3059":126946},[],"**Message Type**: `Raw` o `Digest`.",{"_3604":74737,"_31000":74635,"_21469":126948,"_5":14752,"_28187":126695,"_3059":126949},[],"**Payload Encoding**: codificación del mensaje.",{"_3604":74738,"_31000":74635,"_21469":126951,"_5":14752,"_28187":126695,"_3059":126952},[],"**Message**: mensaje original o hash.",{"_3604":74739,"_31000":74635,"_21469":126954,"_5":14752,"_28187":126695,"_3059":126955},[],"**Signature**: firma que se desea comprobar.",{"_3604":74740,"_31000":74635,"_21469":126957,"_5":14752,"_28187":126695,"_3059":126958},[],"**Result**: indicador del resultado de la validación.",{"_3604":74741,"_31000":74635,"_21469":126960,"_5":14752,"_28187":126698,"_3059":126961},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3604":74742,"_31000":74635,"_21469":126963,"_5":14752,"_28187":126698,"_3059":126964},[],"Este flujo es útil para:",{"_3604":74743,"_31000":74635,"_21469":126966,"_5":14752,"_28187":126698,"_3059":126967},[],"Solicitar certificados a una CA externa.",{"_3604":74744,"_31000":74635,"_21469":126969,"_5":14752,"_28187":126698,"_3059":126970},[],"Renovar una identidad manteniendo la misma clave.",{"_3604":74745,"_31000":74635,"_21469":126972,"_5":14752,"_28187":126698,"_3059":126973},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3604":74746,"_31000":74635,"_21469":126975,"_5":14752,"_28187":126698,"_3059":126976},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3604":74747,"_31000":74635,"_21469":126978,"_5":14752,"_28187":126698,"_3059":126979},[],"**Organization (O)**: organización o empresa.",{"_3604":74748,"_31000":74635,"_21469":126981,"_5":14752,"_28187":126698,"_3059":126982},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3604":74749,"_31000":74635,"_21469":126984,"_5":14752,"_28187":126698,"_3059":126985},[],"**Country (C)**: código de país de dos letras.",{"_3604":74750,"_31000":74635,"_21469":126987,"_5":14752,"_28187":126698,"_3059":126988},[],"**State / Province (ST)**: estado o provincia.",{"_3604":74751,"_31000":74635,"_21469":126990,"_5":14752,"_28187":126698,"_3059":126991},[],"**Locality (L)**: ciudad o localidad.",{"_3604":74752,"_31000":74635,"_21469":126993,"_5":14752,"_28187":126698,"_3059":126994},[],"**Email Address**: correo de contacto.",{"_3604":74753,"_31000":74635,"_21469":126996,"_5":14752,"_28187":126698,"_3059":126997},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3604":74754,"_31000":74635,"_21469":126999,"_5":14752,"_28187":126698,"_3059":127000},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3604":74755,"_31000":74635,"_21469":127002,"_5":14752,"_28187":126702,"_3059":127003},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3604":74756,"_31000":74635,"_21469":127005,"_5":14752,"_28187":126702,"_3059":127006},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3604":74757,"_31000":74635,"_21469":127008,"_5":14752,"_28187":126706,"_3059":127009},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3604":74758,"_31000":74635,"_21469":127011,"_5":14752,"_28187":126706,"_3059":127012},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3604":74759,"_31000":74759,"_5":15112,"_3059":127014,"_31359":127015,"_21469":127016,"_28187":74759},"Validación online con OCSP",[50673,121110,56348,125770],[],{"_3604":74760,"_31000":74759,"_21469":127018,"_5":14752,"_28187":74759,"_3059":127019},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3604":74761,"_31000":74759,"_5":31356,"_21469":127021,"_28187":127022,"_3059":127023},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3604":74762,"_31000":74759,"_5":31356,"_21469":127025,"_28187":127026,"_3059":127027},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3604":74763,"_31000":74759,"_5":31356,"_21469":127029,"_28187":127030,"_3059":127031},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3604":74764,"_31000":74759,"_5":31356,"_21469":127033,"_28187":127034,"_3059":127035},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3604":74765,"_31000":74759,"_5":31356,"_21469":127037,"_28187":127038,"_3059":127039},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3604":74766,"_31000":74759,"_5":31356,"_21469":127041,"_28187":127042,"_3059":126333},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#referencias",{"_3604":74767,"_31000":74759,"_21469":127044,"_5":14752,"_28187":74759,"_3059":127045},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3604":74768,"_31000":74759,"_21469":127047,"_5":14752,"_28187":127022,"_3059":127048},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3604":74769,"_31000":74759,"_21469":127050,"_5":14752,"_28187":127022,"_3059":127051},[],"Estado del registro",{"_3604":74770,"_31000":74759,"_21469":127053,"_5":14752,"_28187":127022,"_3059":127054},[],"Respuesta firmada",{"_3604":74771,"_31000":74759,"_21469":127056,"_5":14752,"_28187":127022,"_3059":55485},[],{"_3604":74772,"_31000":74759,"_21469":127058,"_5":14752,"_28187":127022,"_3059":58313},[],{"_3604":74773,"_31000":74759,"_21469":127060,"_5":14752,"_28187":127022,"_3059":55502},[],{"_3604":74774,"_31000":74759,"_21469":127062,"_5":14752,"_28187":127022,"_3059":127063},[],"`Revoked`, con razón y fecha de revocación.",{"_3604":74775,"_31000":74759,"_21469":127065,"_5":14752,"_28187":127022,"_3059":127066},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3604":74776,"_31000":74759,"_21469":127068,"_5":14752,"_28187":127022,"_3059":127069},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3604":74777,"_31000":74759,"_21469":127071,"_5":14752,"_28187":127022,"_3059":127072},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3604":74778,"_31000":74759,"_21469":127074,"_5":14752,"_28187":127022,"_3059":127075},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3604":74779,"_31000":74759,"_21469":127077,"_5":14752,"_28187":127022,"_3059":127078},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3604":74780,"_31000":74759,"_21469":127080,"_5":14752,"_28187":127026,"_3059":127081},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3604":74781,"_31000":74759,"_21469":127083,"_5":14752,"_28187":127026,"_3059":127084},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3604":74782,"_31000":74759,"_21469":127086,"_5":14752,"_28187":127030,"_3059":127087},[],"El servicio acepta:",{"_3604":74783,"_31000":74759,"_21469":127089,"_5":14752,"_28187":127030,"_3059":122973},[],{"_3604":74784,"_31000":74759,"_21469":127091,"_5":14752,"_28187":127030,"_3059":127092},[],"Ruta del servicio VA",{"_3604":74785,"_31000":74759,"_21469":127094,"_5":14752,"_28187":127030,"_3059":127095},[],"Formato",{"_3604":74786,"_31000":74759,"_21469":127097,"_5":14752,"_28187":127030,"_3059":58353},[],{"_3604":74787,"_31000":74759,"_21469":127099,"_5":14752,"_28187":127030,"_3059":58356},[],{"_3604":74788,"_31000":74759,"_21469":127101,"_5":14752,"_28187":127030,"_3059":127102},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3604":74789,"_31000":74759,"_21469":127104,"_5":14752,"_28187":127030,"_3059":57748},[],{"_3604":74790,"_31000":74759,"_21469":127106,"_5":14752,"_28187":127030,"_3059":58364},[],{"_3604":74791,"_31000":74759,"_21469":127108,"_5":14752,"_28187":127030,"_3059":127109},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3604":74792,"_31000":74759,"_21469":127111,"_5":14752,"_28187":127030,"_3059":127112},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3604":74793,"_31000":74759,"_21469":127114,"_5":14752,"_28187":127034,"_3059":127115},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3604":74794,"_31000":74759,"_21469":127117,"_5":14752,"_28187":127034,"_3059":127118},[],"Genera la solicitud:",{"_3604":74795,"_31000":74759,"_21469":127120,"_5":14752,"_28187":127034,"_3059":127121},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3604":74796,"_31000":74759,"_21469":127123,"_5":14752,"_28187":127034,"_3059":127124},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3604":74797,"_31000":74759,"_21469":127126,"_5":14752,"_28187":127034,"_3059":127127},[],"Verifica el DER recibido:",{"_3604":74798,"_31000":74759,"_21469":127129,"_5":14752,"_28187":127034,"_3059":127130},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3604":74799,"_31000":74759,"_21469":127132,"_5":14752,"_28187":127038,"_3059":127133},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3604":74800,"_31000":74759,"_21469":127135,"_5":14752,"_28187":127038,"_3059":127136},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3604":74801,"_31000":74759,"_21469":127138,"_5":14752,"_28187":127042,"_3059":58397},[],{"_3604":74802,"_31000":74759,"_21469":127140,"_5":14752,"_28187":127042,"_3059":58400},[],{"_3604":74803,"_31000":74759,"_21469":127142,"_5":14752,"_28187":127042,"_3059":127143},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3604":74804,"_31000":74759,"_21469":127145,"_5":14752,"_28187":127042,"_3059":126628},[],{"_3604":74805,"_31000":74805,"_5":15112,"_3059":56348,"_31359":127147,"_21469":127148,"_28187":74805},[50673,121110,56348],[],{"_3604":74806,"_31000":74805,"_21469":127150,"_5":14752,"_28187":74805,"_3059":127151},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3604":74807,"_31000":74805,"_5":31356,"_21469":127153,"_28187":127154,"_3059":124447},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#empieza-aquí",{"_3604":74808,"_31000":74805,"_5":31356,"_21469":127156,"_28187":127157,"_3059":127158},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3604":74809,"_31000":74805,"_5":31356,"_21469":127160,"_28187":127161,"_3059":124967},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#capacidades-principales",{"_3604":74810,"_31000":74805,"_5":31356,"_21469":127163,"_28187":127164,"_3059":124971},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3604":74811,"_31000":74805,"_5":31356,"_21469":127166,"_28187":127167,"_3059":124975},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3604":74812,"_31000":74805,"_5":31356,"_21469":127169,"_28187":127170,"_3059":124979},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#emite-y-controla-certificados",{"_3604":74813,"_31000":74805,"_5":31356,"_21469":127172,"_28187":127173,"_3059":124987},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#publica-el-estado-de-validación",{"_3604":74814,"_31000":74805,"_5":31356,"_21469":127175,"_28187":127176,"_3059":127177},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3604":74815,"_31000":74805,"_5":31356,"_21469":127179,"_28187":127180,"_3059":125936},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#continúa",{"_3604":74816,"_31000":74805,"_21469":127182,"_5":14752,"_28187":74805,"_3059":127183},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3604":74817,"_31000":74805,"_21469":127185,"_5":14752,"_28187":127154,"_3059":127186},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3604":74818,"_31000":74805,"_21469":127188,"_5":14752,"_28187":127154,"_3059":127189},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3604":74819,"_31000":74805,"_21469":127191,"_5":14752,"_28187":127157,"_3059":127192},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3604":74820,"_31000":74805,"_21469":127194,"_5":14752,"_28187":127157,"_3059":127195},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3604":74821,"_31000":74805,"_21469":127197,"_5":14752,"_28187":127157,"_3059":127198},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3604":74822,"_31000":74805,"_21469":127200,"_5":14752,"_28187":127157,"_3059":127201},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3604":74823,"_31000":74805,"_21469":127203,"_5":14752,"_28187":127157,"_3059":127204},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3604":74824,"_31000":74805,"_21469":127206,"_5":14752,"_28187":127164,"_3059":127207},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3604":74825,"_31000":74805,"_21469":127209,"_5":14752,"_28187":127167,"_3059":127210},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3604":74826,"_31000":74805,"_21469":127212,"_5":14752,"_28187":127170,"_3059":127213},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3604":74827,"_31000":74805,"_21469":127215,"_5":14752,"_28187":127173,"_3059":127216},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3604":74828,"_31000":74805,"_21469":127218,"_5":14752,"_28187":127176,"_3059":127219},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3604":74829,"_31000":74805,"_21469":127221,"_5":14752,"_28187":127176,"_3059":127222},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3604":74830,"_31000":74805,"_21469":127224,"_5":14752,"_28187":127176,"_3059":127225},[],"su clave pública corresponda a la clave privada del cliente;",{"_3604":74831,"_31000":74805,"_21469":127227,"_5":14752,"_28187":127176,"_3059":127228},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3604":74832,"_31000":74805,"_21469":127230,"_5":14752,"_28187":127176,"_3059":127231},[],"sus fechas y usos permitan la operación;",{"_3604":74833,"_31000":74805,"_21469":127233,"_5":14752,"_28187":127176,"_3059":127234},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3604":74834,"_31000":74805,"_21469":127236,"_5":14752,"_28187":127176,"_3059":127237},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3604":74835,"_31000":74805,"_21469":127239,"_5":14752,"_28187":127180,"_3059":127240},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3604":74836,"_31000":74805,"_21469":127242,"_5":14752,"_28187":127180,"_3059":127243},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3604":74837,"_31000":74805,"_21469":127245,"_5":14752,"_28187":127180,"_3059":127246},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3604":74838,"_31000":74838,"_5":15112,"_3059":127248,"_31359":127249,"_21469":127250,"_28187":74838},"Crea tu primera CA",[50673,121110,56348,124571],[],{"_3604":74839,"_31000":74838,"_21469":127252,"_5":14752,"_28187":74838,"_3059":127253},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3604":74840,"_31000":74838,"_5":31356,"_21469":127255,"_28187":127256,"_3059":119644},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3604":74841,"_31000":74838,"_5":31356,"_21469":127258,"_28187":127259,"_3059":127260},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3604":74842,"_31000":74838,"_5":31356,"_21469":127262,"_28187":127263,"_3059":127264},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3604":74843,"_31000":74838,"_5":31356,"_21469":127266,"_28187":127267,"_3059":127268},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3604":74844,"_31000":74838,"_5":31356,"_21469":127270,"_28187":127271,"_3059":127272},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3604":74845,"_31000":74838,"_5":31356,"_21469":127274,"_28187":127275,"_3059":127276},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3604":74846,"_31000":74838,"_5":31356,"_21469":127278,"_28187":127279,"_3059":127280},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3604":74847,"_31000":74838,"_5":31356,"_21469":127282,"_28187":127283,"_3059":124818},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3604":74848,"_31000":74838,"_5":31356,"_21469":127285,"_28187":127286,"_3059":119668},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3604":74849,"_31000":74838,"_21469":127288,"_5":14752,"_28187":74838,"_3059":127289},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3604":74850,"_31000":74838,"_21469":127291,"_5":14752,"_28187":127256,"_3059":127292},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3604":74851,"_31000":74838,"_21469":127294,"_5":14752,"_28187":127256,"_3059":127295},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3604":74852,"_31000":74838,"_21469":127297,"_5":14752,"_28187":127256,"_3059":127298},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3604":74853,"_31000":74838,"_21469":127300,"_5":14752,"_28187":127256,"_3059":127301},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3604":74854,"_31000":74838,"_21469":127303,"_5":14752,"_28187":127259,"_3059":127304},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3604":74855,"_31000":74838,"_21469":127306,"_5":14752,"_28187":127259,"_3059":127307},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3604":74856,"_31000":74838,"_21469":127309,"_5":14752,"_28187":127263,"_3059":127310},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3604":74857,"_31000":74838,"_21469":127312,"_5":14752,"_28187":127263,"_3059":127313},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3604":74858,"_31000":74838,"_21469":127315,"_5":14752,"_28187":127267,"_3059":127316},[],"Selecciona **Root CA** y completa:",{"_3604":74859,"_31000":74838,"_21469":127318,"_5":14752,"_28187":127267,"_3059":58579},[],{"_3604":74860,"_31000":74838,"_21469":127320,"_5":14752,"_28187":127267,"_3059":127321},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3604":74861,"_31000":74838,"_21469":127323,"_5":14752,"_28187":127267,"_3059":127324},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3604":74862,"_31000":74838,"_21469":127326,"_5":14752,"_28187":127267,"_3059":127327},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3604":74863,"_31000":74838,"_21469":127329,"_5":14752,"_28187":127267,"_3059":127330},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3604":74864,"_31000":74838,"_21469":127332,"_5":14752,"_28187":127271,"_3059":127333},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3604":74865,"_31000":74838,"_21469":127335,"_5":14752,"_28187":127275,"_3059":127336},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3604":74866,"_31000":74838,"_21469":127338,"_5":14752,"_28187":127275,"_3059":127339},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3604":74867,"_31000":74838,"_21469":127341,"_5":14752,"_28187":127279,"_3059":127342},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3604":74868,"_31000":74838,"_21469":127344,"_5":14752,"_28187":127279,"_3059":127345},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3604":74869,"_31000":74838,"_21469":127347,"_5":14752,"_28187":127279,"_3059":127348},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3604":74870,"_31000":74838,"_21469":127350,"_5":14752,"_28187":127283,"_3059":127351},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3604":74871,"_31000":74838,"_21469":127353,"_5":14752,"_28187":127283,"_3059":127354},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3604":74872,"_31000":74838,"_21469":127356,"_5":14752,"_28187":127283,"_3059":127357},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3604":74873,"_31000":74838,"_21469":127359,"_5":14752,"_28187":127283,"_3059":127360},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3604":74874,"_31000":74838,"_21469":127362,"_5":14752,"_28187":127286,"_3059":127363},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3604":74875,"_31000":74875,"_5":15112,"_3059":127365,"_31359":127366,"_21469":127367,"_28187":74875},"Emite y verifica un certificado",[50673,121110,56348,124571],[],{"_3604":74876,"_31000":74875,"_21469":127369,"_5":14752,"_28187":74875,"_3059":127370},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3604":74877,"_31000":74875,"_5":31356,"_21469":127372,"_28187":127373,"_3059":119644},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3604":74878,"_31000":74875,"_5":31356,"_21469":127375,"_28187":127376,"_3059":127377},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3604":74879,"_31000":74875,"_5":31356,"_21469":127379,"_28187":127380,"_3059":127381},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3604":74880,"_31000":74875,"_5":31356,"_21469":127383,"_28187":127384,"_3059":127385},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3604":74881,"_31000":74875,"_5":31356,"_21469":127387,"_28187":127388,"_3059":127389},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3604":74882,"_31000":74875,"_5":31356,"_21469":127391,"_28187":127392,"_3059":127393},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3604":74883,"_31000":74875,"_5":31356,"_21469":127395,"_28187":127396,"_3059":127397},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3604":74884,"_31000":74875,"_5":31356,"_21469":127399,"_28187":127400,"_3059":127401},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3604":74885,"_31000":74875,"_5":31356,"_21469":127403,"_28187":127404,"_3059":127405},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3604":74886,"_31000":74875,"_5":31356,"_21469":127407,"_28187":127408,"_3059":127409},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3604":74887,"_31000":74875,"_5":31356,"_21469":127411,"_28187":127412,"_3059":124818},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3604":74888,"_31000":74875,"_5":31356,"_21469":127414,"_28187":127415,"_3059":119668},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3604":74889,"_31000":74875,"_21469":127417,"_5":14752,"_28187":74875,"_3059":127418},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3604":74890,"_31000":74875,"_21469":127420,"_5":14752,"_28187":127373,"_3059":127421},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3604":74891,"_31000":74875,"_21469":127423,"_5":14752,"_28187":127373,"_3059":127424},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3604":74892,"_31000":74875,"_21469":127426,"_5":14752,"_28187":127373,"_3059":127427},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3604":74893,"_31000":74875,"_21469":127429,"_5":14752,"_28187":127373,"_3059":127430},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3604":74894,"_31000":74875,"_21469":127432,"_5":14752,"_28187":127373,"_3059":127433},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3604":74895,"_31000":74875,"_21469":127435,"_5":14752,"_28187":127376,"_3059":127436},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3604":74896,"_31000":74875,"_21469":127438,"_5":14752,"_28187":127380,"_3059":127439},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3604":74897,"_31000":74875,"_21469":127441,"_5":14752,"_28187":127380,"_3059":127442},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3604":74898,"_31000":74875,"_21469":127444,"_5":14752,"_28187":127384,"_3059":127445},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3604":74899,"_31000":74875,"_21469":127447,"_5":14752,"_28187":127384,"_3059":127448},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3604":74900,"_31000":74875,"_21469":127450,"_5":14752,"_28187":127388,"_3059":127451},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3604":74901,"_31000":74875,"_21469":127453,"_5":14752,"_28187":127388,"_3059":127454},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3604":74902,"_31000":74875,"_21469":127456,"_5":14752,"_28187":127392,"_3059":127457},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3604":74903,"_31000":74875,"_21469":127459,"_5":14752,"_28187":127396,"_3059":127460},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3604":74904,"_31000":74875,"_21469":127462,"_5":14752,"_28187":127400,"_3059":127463},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3604":74905,"_31000":74875,"_21469":127465,"_5":14752,"_28187":127404,"_3059":127466},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3604":74906,"_31000":74875,"_21469":127468,"_5":14752,"_28187":127404,"_3059":127469},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3604":74907,"_31000":74875,"_21469":127471,"_5":14752,"_28187":127404,"_3059":127472},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3604":74908,"_31000":74875,"_21469":127474,"_5":14752,"_28187":127408,"_3059":127475},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3604":74909,"_31000":74875,"_21469":127477,"_5":14752,"_28187":127408,"_3059":127478},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3604":74910,"_31000":74875,"_21469":127480,"_5":14752,"_28187":127408,"_3059":127481},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3604":74911,"_31000":74875,"_21469":127483,"_5":14752,"_28187":127412,"_3059":124901},[],{"_3604":74912,"_31000":74875,"_21469":127485,"_5":14752,"_28187":127412,"_3059":123422},[],{"_3604":74913,"_31000":74875,"_21469":127487,"_5":14752,"_28187":127412,"_3059":127488},[],"La CA rechaza la emisión",{"_3604":74914,"_31000":74875,"_21469":127490,"_5":14752,"_28187":127412,"_3059":127491},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3604":74915,"_31000":74875,"_21469":127493,"_5":14752,"_28187":127412,"_3059":127494},[],"Sujeto o usos diferentes",{"_3604":74916,"_31000":74875,"_21469":127496,"_5":14752,"_28187":127412,"_3059":127497},[],"Perfil aplicado y valores solicitados.",{"_3604":74917,"_31000":74875,"_21469":127499,"_5":14752,"_28187":127412,"_3059":127500},[],"No se encuentra el emisor",{"_3604":74918,"_31000":74875,"_21469":127502,"_5":14752,"_28187":127412,"_3059":127503},[],"CA descargada y cadena intermedia necesaria.",{"_3604":74919,"_31000":74875,"_21469":127505,"_5":14752,"_28187":127412,"_3059":127506},[],"Falla la vigencia",{"_3604":74920,"_31000":74875,"_21469":127508,"_5":14752,"_28187":127412,"_3059":127509},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3604":74921,"_31000":74875,"_21469":127511,"_5":14752,"_28187":127412,"_3059":127512},[],"Los resúmenes de clave difieren",{"_3604":74922,"_31000":74875,"_21469":127514,"_5":14752,"_28187":127412,"_3059":127515},[],"Archivos de certificado y clave de la misma emisión.",{"_3604":74923,"_31000":74875,"_21469":127517,"_5":14752,"_28187":127412,"_3059":127518},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3604":74924,"_31000":74875,"_21469":127520,"_5":14752,"_28187":127415,"_3059":127521},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3604":74925,"_31000":74875,"_21469":127523,"_5":14752,"_28187":127415,"_3059":127524},[],"Gestionar certificados para inspección, estado y revocación.",{"_3604":74926,"_31000":74875,"_21469":127526,"_5":14752,"_28187":127415,"_3059":127527},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3604":74927,"_31000":74875,"_21469":127529,"_5":14752,"_28187":127415,"_3059":127530},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3604":74928,"_31000":74875,"_21469":127532,"_5":14752,"_28187":127415,"_3059":127533},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3604":74929,"_31000":74929,"_5":15112,"_3059":127535,"_31359":127536,"_21469":127537,"_28187":74929},"Primeros pasos de PKI",[50673,121110,56348,124571],[],{"_3604":74930,"_31000":74929,"_21469":127539,"_5":14752,"_28187":74929,"_3059":127540},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3604":74931,"_31000":74929,"_5":31356,"_21469":127542,"_28187":127543,"_3059":119644},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3604":74932,"_31000":74929,"_5":31356,"_21469":127545,"_28187":127546,"_3059":127547},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3604":74933,"_31000":74929,"_5":31356,"_21469":127549,"_28187":127550,"_3059":124753},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3604":74934,"_31000":74929,"_5":31356,"_21469":127552,"_28187":127553,"_3059":127554},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3604":74935,"_31000":74929,"_21469":127556,"_5":14752,"_28187":74929,"_3059":127557},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3604":74936,"_31000":74929,"_21469":127559,"_5":14752,"_28187":127543,"_3059":127560},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3604":74937,"_31000":74929,"_21469":127562,"_5":14752,"_28187":127543,"_3059":127563},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3604":74938,"_31000":74929,"_21469":127565,"_5":14752,"_28187":127543,"_3059":127566},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3604":74939,"_31000":74929,"_21469":127568,"_5":14752,"_28187":127543,"_3059":127569},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3604":74940,"_31000":74929,"_21469":127571,"_5":14752,"_28187":127543,"_3059":127572},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3604":74941,"_31000":74929,"_21469":127574,"_5":14752,"_28187":127546,"_3059":127575},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3604":74942,"_31000":74929,"_21469":127577,"_5":14752,"_28187":127546,"_3059":127578},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3604":74943,"_31000":74929,"_21469":127580,"_5":14752,"_28187":127546,"_3059":127581},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3604":74944,"_31000":74929,"_21469":127583,"_5":14752,"_28187":127546,"_3059":127584},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3604":74945,"_31000":74929,"_21469":127586,"_5":14752,"_28187":127550,"_3059":127587},[],"Archivo o recurso",{"_3604":74946,"_31000":74929,"_21469":127589,"_5":14752,"_28187":127550,"_3059":124750},[],{"_3604":74947,"_31000":74929,"_21469":127591,"_5":14752,"_28187":127550,"_3059":127592},[],"CA raíz activa y `ca.pem`",{"_3604":74948,"_31000":74929,"_21469":127594,"_5":14752,"_28187":127550,"_3059":127595},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3604":74949,"_31000":74929,"_21469":127597,"_5":14752,"_28187":127550,"_3059":127598},[],"Certificado final y `device.crt`",{"_3604":74950,"_31000":74929,"_21469":127600,"_5":14752,"_28187":127550,"_3059":127601},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3604":74951,"_31000":74929,"_21469":127603,"_5":14752,"_28187":127550,"_3059":127604},[],"Clave privada `device.key`",{"_3604":74952,"_31000":74929,"_21469":127606,"_5":14752,"_28187":127550,"_3059":127607},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3604":74953,"_31000":74929,"_21469":127609,"_5":14752,"_28187":127550,"_3059":127610},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3604":74954,"_31000":74929,"_21469":127612,"_5":14752,"_28187":127553,"_3059":127613},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3604":74955,"_31000":74929,"_21469":127615,"_5":14752,"_28187":127553,"_3059":127616},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3604":74956,"_31000":74929,"_21469":127618,"_5":14752,"_28187":127553,"_3059":127619},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3604":74957,"_31000":74957,"_5":15112,"_3059":127621,"_31359":127622,"_21469":127624,"_28187":74957},"Resolución de problemas PKI",[50673,121110,56348,127623],"Resolución de problemas",[],{"_3604":74958,"_31000":74957,"_21469":127626,"_5":14752,"_28187":74957,"_3059":127627},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3604":74959,"_31000":74957,"_5":31356,"_21469":127629,"_28187":127630,"_3059":127631},[],"/docs/pr-preview/pr-75/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3604":74960,"_31000":74957,"_5":31356,"_21469":127633,"_28187":127634,"_3059":127635},[],"/docs/pr-preview/pr-75/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3604":74961,"_31000":74957,"_5":31356,"_21469":127637,"_28187":127638,"_3059":127639},[],"/docs/pr-preview/pr-75/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3604":74962,"_31000":74957,"_21469":127641,"_5":14752,"_28187":74957,"_3059":127642},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3604":74963,"_31000":74957,"_21469":127644,"_5":14752,"_28187":74957,"_3059":127645},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3604":74964,"_31000":74957,"_21469":127647,"_5":14752,"_28187":127630,"_3059":124750},[],{"_3604":74965,"_31000":74957,"_21469":127649,"_5":14752,"_28187":127630,"_3059":123422},[],{"_3604":74966,"_31000":74957,"_21469":127651,"_5":14752,"_28187":127630,"_3059":119668},[],{"_3604":74967,"_31000":74957,"_21469":127653,"_5":14752,"_28187":127630,"_3059":55190},[],{"_3604":74968,"_31000":74957,"_21469":127655,"_5":14752,"_28187":127630,"_3059":127656},[],"Existe, está activa y sus fechas son utilizables.",{"_3604":74969,"_31000":74957,"_21469":127658,"_5":14752,"_28187":127630,"_3059":127659},[],"Autoridades.",{"_3604":74970,"_31000":74957,"_21469":127661,"_5":14752,"_28187":127630,"_3059":127662},[],"Clave",{"_3604":74971,"_31000":74957,"_21469":127664,"_5":14752,"_28187":127630,"_3059":127665},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3604":74972,"_31000":74957,"_21469":127667,"_5":14752,"_28187":127630,"_3059":127668},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3604":74973,"_31000":74957,"_21469":127670,"_5":14752,"_28187":127630,"_3059":58933},[],{"_3604":74974,"_31000":74957,"_21469":127672,"_5":14752,"_28187":127630,"_3059":127673},[],"PEM correcto y firma verificable.",{"_3604":74975,"_31000":74957,"_21469":127675,"_5":14752,"_28187":127630,"_3059":58939},[],{"_3604":74976,"_31000":74957,"_21469":127677,"_5":14752,"_28187":127630,"_3059":127678},[],"Perfil",{"_3604":74977,"_31000":74957,"_21469":127680,"_5":14752,"_28187":127630,"_3059":127681},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3604":74978,"_31000":74957,"_21469":127683,"_5":14752,"_28187":127630,"_3059":127684},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3604":74979,"_31000":74957,"_21469":127686,"_5":14752,"_28187":127630,"_3059":124901},[],{"_3604":74980,"_31000":74957,"_21469":127688,"_5":14752,"_28187":127630,"_3059":127689},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3604":74981,"_31000":74957,"_21469":127691,"_5":14752,"_28187":127630,"_3059":127692},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3604":74982,"_31000":74957,"_21469":127694,"_5":14752,"_28187":127630,"_3059":127695},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3604":74983,"_31000":74957,"_21469":127697,"_5":14752,"_28187":127630,"_3059":127698},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3604":74984,"_31000":74957,"_21469":127700,"_5":14752,"_28187":127630,"_3059":127701},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3604":74985,"_31000":74957,"_21469":127703,"_5":14752,"_28187":127634,"_3059":127704},[],"Revisa cada frontera por separado:",{"_3604":74986,"_31000":74957,"_21469":127706,"_5":14752,"_28187":127634,"_3059":127707},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3604":74987,"_31000":74957,"_21469":127709,"_5":14752,"_28187":127634,"_3059":127710},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3604":74988,"_31000":74957,"_21469":127712,"_5":14752,"_28187":127634,"_3059":127713},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3604":74989,"_31000":74957,"_21469":127715,"_5":14752,"_28187":127634,"_3059":127716},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3604":74990,"_31000":74957,"_21469":127718,"_5":14752,"_28187":127634,"_3059":127719},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3604":74991,"_31000":74957,"_21469":127721,"_5":14752,"_28187":127634,"_3059":127722},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3604":74992,"_31000":74957,"_21469":127724,"_5":14752,"_28187":127638,"_3059":127725},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3604":74993,"_31000":74957,"_21469":127727,"_5":14752,"_28187":127638,"_3059":127728},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3604":74994,"_31000":74994,"_5":15112,"_3059":127730,"_31359":127731,"_21469":127732,"_28187":74994},"Seguridad",[50673],[],{"_3604":74995,"_31000":74994,"_21469":127734,"_5":14752,"_28187":74994,"_3059":127735},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3604":74996,"_31000":74994,"_5":31356,"_21469":127737,"_28187":127738,"_3059":127739},[],"/docs/pr-preview/pr-75/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3604":74997,"_31000":74994,"_5":31356,"_21469":127741,"_28187":127742,"_3059":127743},[],"/docs/pr-preview/pr-75/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3604":74998,"_31000":74994,"_5":31356,"_21469":127745,"_28187":127746,"_3059":127747},[],"/docs/pr-preview/pr-75/es/security#versiones-soportadas","Versiones soportadas",{"_3604":74999,"_31000":74994,"_5":31356,"_21469":127749,"_28187":127750,"_3059":127751},[],"/docs/pr-preview/pr-75/es/security#divulgación-responsable","Divulgación responsable",{"_3604":75000,"_31000":74994,"_21469":127753,"_5":14752,"_28187":74994,"_3059":127754},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3604":75001,"_31000":74994,"_21469":127756,"_5":14752,"_28187":127738,"_3059":127757},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3604":75002,"_31000":74994,"_21469":127759,"_5":14752,"_28187":127738,"_3059":127760},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3604":75003,"_31000":74994,"_21469":127762,"_5":14752,"_28187":127738,"_3059":15390},[],{"_3604":75004,"_31000":74994,"_21469":127764,"_5":14752,"_28187":127738,"_3059":15319},[],{"_3604":75005,"_31000":74994,"_21469":127766,"_5":14752,"_28187":127738,"_3059":15377},[],{"_3604":75006,"_31000":74994,"_21469":127768,"_5":14752,"_28187":127738,"_3059":127769},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3604":75007,"_31000":74994,"_21469":127771,"_5":14752,"_28187":127738,"_3059":127772},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3604":75008,"_31000":74994,"_21469":127774,"_5":14752,"_28187":127742,"_3059":127775},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3604":75009,"_31000":74994,"_21469":127777,"_5":14752,"_28187":127742,"_3059":127778},[],"No incluyas en el reporte:",{"_3604":75010,"_31000":74994,"_21469":127780,"_5":14752,"_28187":127742,"_3059":127781},[],"Credenciales, tokens o claves privadas",{"_3604":75011,"_31000":74994,"_21469":127783,"_5":14752,"_28187":127742,"_3059":127784},[],"Datos de clientes o información identificable de clientes",{"_3604":75012,"_31000":74994,"_21469":127786,"_5":14752,"_28187":127742,"_3059":127787},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3604":75013,"_31000":74994,"_21469":127789,"_5":14752,"_28187":127746,"_3059":127790},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3604":75014,"_31000":74994,"_21469":127792,"_5":14752,"_28187":127746,"_3059":127793},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3604":75015,"_31000":74994,"_21469":127795,"_5":14752,"_28187":127750,"_3059":127796},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3604":75016,"_31000":74994,"_21469":127798,"_5":14752,"_28187":127750,"_3059":127799},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3604":75017,"_31000":74994,"_21469":127801,"_5":14752,"_28187":127750,"_3059":127802},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3604":75018,"_31000":74994,"_21469":127804,"_5":14752,"_28187":127750,"_3059":127805},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3604":75019,"_31000":74994,"_21469":127807,"_5":14752,"_28187":127750,"_3059":127808},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3604":75020,"_31000":75020,"_5":15112,"_3059":127810,"_31359":127811,"_21469":127813,"_28187":75020},"3.8.0 a 4.0.0",[50673,127812],"Actualizaciones",[],{"_3604":75021,"_31000":75020,"_21469":127815,"_5":14752,"_28187":75020,"_3059":127816},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3604":75022,"_31000":75020,"_5":31356,"_21469":127818,"_28187":127819,"_3059":127820},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3604":75023,"_31000":75020,"_5":31356,"_21469":127822,"_28187":127823,"_3059":127824},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3604":75024,"_31000":75020,"_5":31356,"_21469":127826,"_28187":127827,"_3059":127828},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3604":75025,"_31000":75020,"_5":31356,"_21469":127830,"_28187":127831,"_3059":127832},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3604":75026,"_31000":75020,"_5":31356,"_21469":127834,"_28187":127835,"_3059":127836},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3604":75027,"_31000":75020,"_5":31356,"_21469":127838,"_28187":127839,"_3059":127840},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3604":75028,"_31000":75020,"_5":31356,"_21469":127842,"_28187":127843,"_3059":59108},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3604":75029,"_31000":75020,"_5":31356,"_21469":127845,"_28187":127846,"_3059":127847},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3604":75030,"_31000":75020,"_5":31356,"_21469":127849,"_28187":127850,"_3059":127851},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3604":75031,"_31000":75020,"_5":31356,"_21469":127853,"_28187":127854,"_3059":127855},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3604":75032,"_31000":75020,"_5":31356,"_21469":127857,"_28187":127858,"_3059":120239},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3604":75033,"_31000":75020,"_5":31356,"_21469":127860,"_28187":127861,"_3059":127862},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3604":75034,"_31000":75020,"_5":31356,"_21469":127864,"_28187":127865,"_3059":127866},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3604":75035,"_31000":75020,"_5":31356,"_21469":127868,"_28187":127869,"_3059":127870},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3604":75036,"_31000":75020,"_5":31356,"_21469":127872,"_28187":127873,"_3059":127874},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3604":75037,"_31000":75020,"_5":31356,"_21469":127876,"_28187":127877,"_3059":127878},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3604":75038,"_31000":75020,"_5":31356,"_21469":127880,"_28187":127881,"_3059":127882},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3604":75039,"_31000":75020,"_5":31356,"_21469":127884,"_28187":127885,"_3059":127886},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3604":75040,"_31000":75020,"_5":31356,"_21469":127888,"_28187":127889,"_3059":127890},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3604":75041,"_31000":75020,"_5":31356,"_21469":127892,"_28187":127893,"_3059":127894},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3604":75042,"_31000":75020,"_5":31356,"_21469":127896,"_28187":127897,"_3059":127898},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3604":75043,"_31000":75020,"_5":31356,"_21469":127900,"_28187":127901,"_3059":127902},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3604":75044,"_31000":75020,"_5":31356,"_21469":127904,"_28187":127905,"_3059":127906},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3604":75045,"_31000":75020,"_5":31356,"_21469":127908,"_28187":127909,"_3059":127910},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3604":75046,"_31000":75020,"_5":31356,"_21469":127912,"_28187":127913,"_3059":127914},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3604":75047,"_31000":75020,"_5":31356,"_21469":127916,"_28187":127917,"_3059":127918},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3604":75048,"_31000":75020,"_5":31356,"_21469":127920,"_28187":127921,"_3059":127922},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3604":75049,"_31000":75020,"_5":31356,"_21469":127924,"_28187":127925,"_3059":127926},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3604":75050,"_31000":75020,"_5":31356,"_21469":127928,"_28187":127929,"_3059":127930},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3604":75051,"_31000":75020,"_5":31356,"_21469":127932,"_28187":127933,"_3059":127934},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3604":75052,"_31000":75020,"_5":31356,"_21469":127936,"_28187":127937,"_3059":127938},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3604":75053,"_31000":75020,"_5":31356,"_21469":127940,"_28187":127941,"_3059":127942},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3604":75054,"_31000":75020,"_5":31356,"_21469":127944,"_28187":127945,"_3059":127946},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3604":75055,"_31000":75020,"_5":31356,"_21469":127948,"_28187":127949,"_3059":127950},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3604":75056,"_31000":75020,"_5":31356,"_21469":127952,"_28187":127953,"_3059":127954},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3604":75057,"_31000":75020,"_5":31356,"_21469":127956,"_28187":127957,"_3059":127958},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3604":75058,"_31000":75020,"_5":31356,"_21469":127960,"_28187":127961,"_3059":127962},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3604":75059,"_31000":75020,"_5":31356,"_21469":127964,"_28187":127965,"_3059":127966},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3604":75060,"_31000":75020,"_5":31356,"_21469":127968,"_28187":127969,"_3059":127970},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3604":75061,"_31000":75020,"_5":31356,"_21469":127972,"_28187":127973,"_3059":127974},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3604":75062,"_31000":75020,"_5":31356,"_21469":127976,"_28187":127977,"_3059":127978},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3604":75063,"_31000":75020,"_5":31356,"_21469":127980,"_28187":127981,"_3059":127982},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3604":75064,"_31000":75020,"_5":31356,"_21469":127984,"_28187":127985,"_3059":123764},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3604":75065,"_31000":75020,"_5":31356,"_21469":127987,"_28187":127988,"_3059":127989},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3604":75066,"_31000":75020,"_5":31356,"_21469":127991,"_28187":127992,"_3059":127993},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3604":75067,"_31000":75020,"_21469":127995,"_5":14752,"_28187":75020,"_3059":127996},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3604":75068,"_31000":75020,"_21469":127998,"_5":14752,"_28187":75020,"_3059":127999},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3604":75069,"_31000":75020,"_21469":128001,"_5":14752,"_28187":75020,"_3059":128002},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3604":75070,"_31000":75020,"_21469":128004,"_5":14752,"_28187":75020,"_3059":128005},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3604":75071,"_31000":75020,"_21469":128007,"_5":14752,"_28187":75020,"_3059":128008},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3604":75072,"_31000":75020,"_21469":128010,"_5":14752,"_28187":75020,"_3059":128011},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3604":75073,"_31000":75020,"_21469":128013,"_5":14752,"_28187":75020,"_3059":128014},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3604":75074,"_31000":75020,"_21469":128016,"_5":14752,"_28187":127823,"_3059":128017},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3604":75075,"_31000":75020,"_21469":128019,"_5":14752,"_28187":127823,"_3059":128020},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3604":75076,"_31000":75020,"_21469":128022,"_5":14752,"_28187":127827,"_3059":128023},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3604":75077,"_31000":75020,"_21469":128025,"_5":14752,"_28187":127827,"_3059":128026},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3604":75078,"_31000":75020,"_21469":128028,"_5":14752,"_28187":127831,"_3059":128029},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3604":75079,"_31000":75020,"_21469":128031,"_5":14752,"_28187":127835,"_3059":128032},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3604":75080,"_31000":75020,"_21469":128034,"_5":14752,"_28187":127835,"_3059":128035},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3604":75081,"_31000":75020,"_21469":128037,"_5":14752,"_28187":127835,"_3059":128038},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3604":75082,"_31000":75020,"_21469":128040,"_5":14752,"_28187":127835,"_3059":128041},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3604":75083,"_31000":75020,"_21469":128043,"_5":14752,"_28187":127835,"_3059":128044},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3604":75084,"_31000":75020,"_21469":128046,"_5":14752,"_28187":127839,"_3059":128047},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3604":75085,"_31000":75020,"_21469":128049,"_5":14752,"_28187":127839,"_3059":128050},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3604":75086,"_31000":75020,"_21469":128052,"_5":14752,"_28187":127839,"_3059":128053},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3604":75087,"_31000":75020,"_21469":128055,"_5":14752,"_28187":127839,"_3059":128056},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3604":75088,"_31000":75020,"_21469":128058,"_5":14752,"_28187":127839,"_3059":128059},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3604":75089,"_31000":75020,"_21469":128061,"_5":14752,"_28187":127839,"_3059":128062},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3604":75090,"_31000":75020,"_21469":128064,"_5":14752,"_28187":127843,"_3059":128065},[],"Cambio",{"_3604":75091,"_31000":75020,"_21469":128067,"_5":14752,"_28187":127843,"_3059":128068},[],"A quién afecta",{"_3604":75092,"_31000":75020,"_21469":128070,"_5":14752,"_28187":127843,"_3059":128071},[],"Gravedad",{"_3604":75093,"_31000":75020,"_21469":128073,"_5":14752,"_28187":127843,"_3059":126552},[],{"_3604":75094,"_31000":75020,"_21469":128075,"_5":14752,"_28187":127843,"_3059":127851},[],{"_3604":75095,"_31000":75020,"_21469":128077,"_5":14752,"_28187":127843,"_3059":128078},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3604":75096,"_31000":75020,"_21469":128080,"_5":14752,"_28187":127843,"_3059":128081},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3604":75097,"_31000":75020,"_21469":128083,"_5":14752,"_28187":127843,"_3059":128084},[],"Copiar los datos a los volúmenes nuevos",{"_3604":75098,"_31000":75020,"_21469":128086,"_5":14752,"_28187":127843,"_3059":127855},[],{"_3604":75099,"_31000":75020,"_21469":128088,"_5":14752,"_28187":127843,"_3059":128089},[],"Todas las releases de Helm",{"_3604":75100,"_31000":75020,"_21469":128091,"_5":14752,"_28187":127843,"_3059":128092},[],"Alta: `helm upgrade` falla",{"_3604":75101,"_31000":75020,"_21469":128094,"_5":14752,"_28187":127843,"_3059":128095},[],"Eliminar o renombrar las claves heredadas",{"_3604":75102,"_31000":75020,"_21469":128097,"_5":14752,"_28187":127843,"_3059":120239},[],{"_3604":75103,"_31000":75020,"_21469":128099,"_5":14752,"_28187":127843,"_3059":128089},[],{"_3604":75104,"_31000":75020,"_21469":128101,"_5":14752,"_28187":127843,"_3059":128102},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3604":75105,"_31000":75020,"_21469":128104,"_5":14752,"_28187":127843,"_3059":128105},[],"Crear primero los Secrets; consulta el paso 2",{"_3604":75106,"_31000":75020,"_21469":128107,"_5":14752,"_28187":127843,"_3059":127862},[],{"_3604":75107,"_31000":75020,"_21469":128109,"_5":14752,"_28187":127843,"_3059":128110},[],"Todos los despliegues",{"_3604":75108,"_31000":75020,"_21469":128112,"_5":14752,"_28187":127843,"_3059":128113},[],"Alta: sin principal de bootstrap no hay administrador",{"_3604":75109,"_31000":75020,"_21469":128115,"_5":14752,"_28187":127843,"_3059":128116},[],"Configurar `services.authz`",{"_3604":75110,"_31000":75020,"_21469":128118,"_5":14752,"_28187":127843,"_3059":127866},[],{"_3604":75111,"_31000":75020,"_21469":128120,"_5":14752,"_28187":127843,"_3059":128089},[],{"_3604":75112,"_31000":75020,"_21469":128122,"_5":14752,"_28187":127843,"_3059":128123},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3604":75113,"_31000":75020,"_21469":128125,"_5":14752,"_28187":127843,"_3059":128126},[],"Mover JWKS y roles a `services.authz`",{"_3604":75114,"_31000":75020,"_21469":128128,"_5":14752,"_28187":127843,"_3059":127886},[],{"_3604":75115,"_31000":75020,"_21469":128130,"_5":14752,"_28187":127843,"_3059":128131},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3604":75116,"_31000":75020,"_21469":128133,"_5":14752,"_28187":127843,"_3059":128134},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3604":75117,"_31000":75020,"_21469":128136,"_5":14752,"_28187":127843,"_3059":128137},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3604":75118,"_31000":75020,"_21469":128139,"_5":14752,"_28187":127843,"_3059":127890},[],{"_3604":75119,"_31000":75020,"_21469":128141,"_5":14752,"_28187":127843,"_3059":128142},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3604":75120,"_31000":75020,"_21469":128144,"_5":14752,"_28187":127843,"_3059":128145},[],"Alta: el backend ya no arranca con ellos",{"_3604":75121,"_31000":75020,"_21469":128147,"_5":14752,"_28187":127843,"_3059":128148},[],"Pasar a PostgreSQL antes de actualizar",{"_3604":75122,"_31000":75020,"_21469":128150,"_5":14752,"_28187":127843,"_3059":127934},[],{"_3604":75123,"_31000":75020,"_21469":128152,"_5":14752,"_28187":127843,"_3059":128153},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3604":75124,"_31000":75020,"_21469":128155,"_5":14752,"_28187":127843,"_3059":128156},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3604":75125,"_31000":75020,"_21469":128158,"_5":14752,"_28187":127843,"_3059":128159},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3604":75126,"_31000":75020,"_21469":128161,"_5":14752,"_28187":127843,"_3059":128162},[],"Webhooks con referencias a archivos",{"_3604":75127,"_31000":75020,"_21469":128164,"_5":14752,"_28187":127843,"_3059":128165},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3604":75128,"_31000":75020,"_21469":128167,"_5":14752,"_28187":127843,"_3059":128168},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3604":75129,"_31000":75020,"_21469":128170,"_5":14752,"_28187":127843,"_3059":128171},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3604":75130,"_31000":75020,"_21469":128173,"_5":14752,"_28187":127843,"_3059":127870},[],{"_3604":75131,"_31000":75020,"_21469":128175,"_5":14752,"_28187":127843,"_3059":128176},[],"Releases con identidades por servicio o material de claves montado",{"_3604":75132,"_31000":75020,"_21469":128178,"_5":14752,"_28187":127843,"_3059":128179},[],"Media: los servicios no pueden leer sus archivos",{"_3604":75133,"_31000":75020,"_21469":128181,"_5":14752,"_28187":127843,"_3059":128182},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3604":75134,"_31000":75020,"_21469":128184,"_5":14752,"_28187":127843,"_3059":127874},[],{"_3604":75135,"_31000":75020,"_21469":128186,"_5":14752,"_28187":127843,"_3059":128187},[],"Releases que definen `amqp.tls`",{"_3604":75136,"_31000":75020,"_21469":128189,"_5":14752,"_28187":127843,"_3059":128190},[],"Media: los clientes se conectan al puerto equivocado",{"_3604":75137,"_31000":75020,"_21469":128192,"_5":14752,"_28187":127843,"_3059":128193},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3604":75138,"_31000":75020,"_21469":128195,"_5":14752,"_28187":127843,"_3059":127894},[],{"_3604":75139,"_31000":75020,"_21469":128197,"_5":14752,"_28187":127843,"_3059":128198},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3604":75140,"_31000":75020,"_21469":128200,"_5":14752,"_28187":127843,"_3059":128201},[],"Media: las claves de CA quedan sin gestionar",{"_3604":75141,"_31000":75020,"_21469":128203,"_5":14752,"_28187":127843,"_3059":128204},[],"Ejecutar la migración de CA a KMS",{"_3604":75142,"_31000":75020,"_21469":128206,"_5":14752,"_28187":127843,"_3059":128207},[],"Verificación del certificado del receptor",{"_3604":75143,"_31000":75020,"_21469":128209,"_5":14752,"_28187":127843,"_3059":128210},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3604":75144,"_31000":75020,"_21469":128212,"_5":14752,"_28187":127843,"_3059":128213},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3604":75145,"_31000":75020,"_21469":128215,"_5":14752,"_28187":127843,"_3059":128216},[],"Poner `insecure_skip_verify` a `false`",{"_3604":75146,"_31000":75020,"_21469":128218,"_5":14752,"_28187":127843,"_3059":127910},[],{"_3604":75147,"_31000":75020,"_21469":128220,"_5":14752,"_28187":127843,"_3059":128221},[],"Scripts y consolas que editan DMS por API",{"_3604":75148,"_31000":75020,"_21469":128223,"_5":14752,"_28187":127843,"_3059":128224},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3604":75149,"_31000":75020,"_21469":128226,"_5":14752,"_28187":127843,"_3059":128227},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3604":75150,"_31000":75020,"_21469":128229,"_5":14752,"_28187":127843,"_3059":127930},[],{"_3604":75151,"_31000":75020,"_21469":128231,"_5":14752,"_28187":127843,"_3059":128232},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3604":75152,"_31000":75020,"_21469":128234,"_5":14752,"_28187":127843,"_3059":128235},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3604":75153,"_31000":75020,"_21469":128237,"_5":14752,"_28187":127843,"_3059":128238},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3604":75154,"_31000":75020,"_21469":128240,"_5":14752,"_28187":127843,"_3059":127938},[],{"_3604":75155,"_31000":75020,"_21469":128242,"_5":14752,"_28187":127843,"_3059":128243},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3604":75156,"_31000":75020,"_21469":128245,"_5":14752,"_28187":127843,"_3059":128246},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3604":75157,"_31000":75020,"_21469":128248,"_5":14752,"_28187":127843,"_3059":128249},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3604":75158,"_31000":75020,"_21469":128251,"_5":14752,"_28187":127843,"_3059":127926},[],{"_3604":75159,"_31000":75020,"_21469":128253,"_5":14752,"_28187":127843,"_3059":128254},[],"Consumidores que leen el campo `events` del dispositivo",{"_3604":75160,"_31000":75020,"_21469":128256,"_5":14752,"_28187":127843,"_3059":128257},[],"Media: el campo desaparece",{"_3604":75161,"_31000":75020,"_21469":128259,"_5":14752,"_28187":127843,"_3059":128260},[],"Usar los nuevos endpoints de eventos",{"_3604":75162,"_31000":75020,"_21469":128262,"_5":14752,"_28187":127843,"_3059":127950},[],{"_3604":75163,"_31000":75020,"_21469":128264,"_5":14752,"_28187":127843,"_3059":128265},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3604":75164,"_31000":75020,"_21469":128267,"_5":14752,"_28187":127843,"_3059":128268},[],"Media: la migración de la VA aborta",{"_3604":75165,"_31000":75020,"_21469":128270,"_5":14752,"_28187":127843,"_3059":128271},[],"Corregir los roles afectados antes de actualizar",{"_3604":75166,"_31000":75020,"_21469":128273,"_5":14752,"_28187":127843,"_3059":127878},[],{"_3604":75167,"_31000":75020,"_21469":128275,"_5":14752,"_28187":127843,"_3059":128276},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3604":75168,"_31000":75020,"_21469":128278,"_5":14752,"_28187":127843,"_3059":128279},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3604":75169,"_31000":75020,"_21469":128281,"_5":14752,"_28187":127843,"_3059":128282},[],"Actualizar el archivo de values",{"_3604":75170,"_31000":75020,"_21469":128284,"_5":14752,"_28187":127843,"_3059":127918},[],{"_3604":75171,"_31000":75020,"_21469":128286,"_5":14752,"_28187":127843,"_3059":128287},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3604":75172,"_31000":75020,"_21469":128289,"_5":14752,"_28187":127843,"_3059":128290},[],"Baja: prevalece el ID de la URL",{"_3604":75173,"_31000":75020,"_21469":128292,"_5":14752,"_28187":127843,"_3059":128293},[],"Enviar el ID en la URL",{"_3604":75174,"_31000":75020,"_21469":128295,"_5":14752,"_28187":127843,"_3059":127942},[],{"_3604":75175,"_31000":75020,"_21469":128297,"_5":14752,"_28187":127843,"_3059":128298},[],"Clientes que envían un `id` al crear o importar CAs",{"_3604":75176,"_31000":75020,"_21469":128300,"_5":14752,"_28187":127843,"_3059":128301},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3604":75177,"_31000":75020,"_21469":128303,"_5":14752,"_28187":127843,"_3059":128304},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3604":75178,"_31000":75020,"_21469":128306,"_5":14752,"_28187":127843,"_3059":127946},[],{"_3604":75179,"_31000":75020,"_21469":128308,"_5":14752,"_28187":127843,"_3059":128309},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3604":75180,"_31000":75020,"_21469":128311,"_5":14752,"_28187":127843,"_3059":128312},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3604":75181,"_31000":75020,"_21469":128314,"_5":14752,"_28187":127843,"_3059":128315},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3604":75182,"_31000":75020,"_21469":128317,"_5":14752,"_28187":127843,"_3059":127922},[],{"_3604":75183,"_31000":75020,"_21469":128319,"_5":14752,"_28187":127843,"_3059":128320},[],"Consumidores que comparan el `type` del certificado",{"_3604":75184,"_31000":75020,"_21469":128322,"_5":14752,"_28187":127843,"_3059":128323},[],"Baja: dos valores cambian de nombre",{"_3604":75185,"_31000":75020,"_21469":128325,"_5":14752,"_28187":127843,"_3059":128326},[],"Adaptar los consumidores",{"_3604":75186,"_31000":75020,"_21469":128328,"_5":14752,"_28187":127843,"_3059":127914},[],{"_3604":75187,"_31000":75020,"_21469":128330,"_5":14752,"_28187":127843,"_3059":128331},[],"Cualquier DMS",{"_3604":75188,"_31000":75020,"_21469":128333,"_5":14752,"_28187":127843,"_3059":128334},[],"Baja: solo informativo",{"_3604":75189,"_31000":75020,"_21469":128336,"_5":14752,"_28187":127843,"_3059":128337},[],"Revisar ambos bloques antes de editar",{"_3604":75190,"_31000":75020,"_21469":128339,"_5":14752,"_28187":127850,"_3059":128340},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3604":75191,"_31000":75020,"_21469":128342,"_5":14752,"_28187":127850,"_3059":128343},[],"El paso 4 de la guía de migración copia los datos.",{"_3604":75192,"_31000":75020,"_21469":128345,"_5":14752,"_28187":127854,"_3059":128346},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3604":75193,"_31000":75020,"_21469":128348,"_5":14752,"_28187":127858,"_3059":128349},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3604":75194,"_31000":75020,"_21469":128351,"_5":14752,"_28187":127858,"_3059":128352},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3604":75195,"_31000":75020,"_21469":128354,"_5":14752,"_28187":127861,"_3059":128355},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3604":75196,"_31000":75020,"_21469":128357,"_5":14752,"_28187":127865,"_3059":128358},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3604":75197,"_31000":75020,"_21469":128360,"_5":14752,"_28187":127869,"_3059":128361},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3604":75198,"_31000":75020,"_21469":128363,"_5":14752,"_28187":127869,"_3059":128364},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3604":75199,"_31000":75020,"_21469":128366,"_5":14752,"_28187":127869,"_3059":128367},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3604":75200,"_31000":75020,"_21469":128369,"_5":14752,"_28187":127873,"_3059":128370},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3604":75201,"_31000":75020,"_21469":128372,"_5":14752,"_28187":127877,"_3059":128373},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3604":75202,"_31000":75020,"_21469":128375,"_5":14752,"_28187":127877,"_3059":128376},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3604":75203,"_31000":75020,"_21469":128378,"_5":14752,"_28187":127877,"_3059":128379},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3604":75204,"_31000":75020,"_21469":128381,"_5":14752,"_28187":127877,"_3059":128382},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3604":75205,"_31000":75020,"_21469":128384,"_5":14752,"_28187":127877,"_3059":128385},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3604":75206,"_31000":75020,"_21469":128387,"_5":14752,"_28187":127877,"_3059":128388},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3604":75207,"_31000":75020,"_21469":128390,"_5":14752,"_28187":127885,"_3059":128391},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3604":75208,"_31000":75020,"_21469":128393,"_5":14752,"_28187":127885,"_3059":128394},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3604":75209,"_31000":75020,"_21469":128396,"_5":14752,"_28187":127885,"_3059":128397},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3604":75210,"_31000":75020,"_21469":128399,"_5":14752,"_28187":127885,"_3059":128400},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3604":75211,"_31000":75020,"_21469":128402,"_5":14752,"_28187":127885,"_3059":128403},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3604":75212,"_31000":75020,"_21469":128405,"_5":14752,"_28187":127889,"_3059":128406},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3604":75213,"_31000":75020,"_21469":128408,"_5":14752,"_28187":127893,"_3059":128409},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3604":75214,"_31000":75020,"_21469":128411,"_5":14752,"_28187":127893,"_3059":128412},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3604":75215,"_31000":75020,"_21469":128414,"_5":14752,"_28187":127893,"_3059":128415},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3604":75216,"_31000":75020,"_21469":128417,"_5":14752,"_28187":127893,"_3059":128418},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3604":75217,"_31000":75020,"_21469":128420,"_5":14752,"_28187":127893,"_3059":128421},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3604":75218,"_31000":75020,"_21469":128423,"_5":14752,"_28187":127893,"_3059":128424},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3604":75219,"_31000":75020,"_21469":128426,"_5":14752,"_28187":127893,"_3059":128427},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3604":75220,"_31000":75020,"_21469":128429,"_5":14752,"_28187":127893,"_3059":128430},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3604":75221,"_31000":75020,"_21469":128432,"_5":14752,"_28187":127897,"_3059":128433},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3604":75222,"_31000":75020,"_21469":128435,"_5":14752,"_28187":127905,"_3059":128436},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3604":75223,"_31000":75020,"_21469":128438,"_5":14752,"_28187":127905,"_3059":128439},[],"Campo en 3.8.0",{"_3604":75224,"_31000":75020,"_21469":128441,"_5":14752,"_28187":127905,"_3059":128442},[],"Campo en 4.0.0",{"_3604":75225,"_31000":75020,"_21469":128444,"_5":14752,"_28187":127905,"_3059":59710},[],{"_3604":75226,"_31000":75020,"_21469":128446,"_5":14752,"_28187":127905,"_3059":128447},[],"`insecure_skip_verify` (con el valor negado)",{"_3604":75227,"_31000":75020,"_21469":128449,"_5":14752,"_28187":127905,"_3059":59716},[],{"_3604":75228,"_31000":75020,"_21469":128451,"_5":14752,"_28187":127905,"_3059":59719},[],{"_3604":75229,"_31000":75020,"_21469":128453,"_5":14752,"_28187":127905,"_3059":59722},[],{"_3604":75230,"_31000":75020,"_21469":128455,"_5":14752,"_28187":127905,"_3059":59725},[],{"_3604":75231,"_31000":75020,"_21469":128457,"_5":14752,"_28187":127905,"_3059":59728},[],{"_3604":75232,"_31000":75020,"_21469":128459,"_5":14752,"_28187":127905,"_3059":59731},[],{"_3604":75233,"_31000":75020,"_21469":128461,"_5":14752,"_28187":127905,"_3059":128462},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3604":75234,"_31000":75020,"_21469":128464,"_5":14752,"_28187":127905,"_3059":128465},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3604":75235,"_31000":75020,"_21469":128467,"_5":14752,"_28187":127905,"_3059":128468},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3604":75236,"_31000":75020,"_21469":128470,"_5":14752,"_28187":127909,"_3059":128471},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3604":75237,"_31000":75020,"_21469":128473,"_5":14752,"_28187":127909,"_3059":128474},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3604":75238,"_31000":75020,"_21469":128476,"_5":14752,"_28187":127909,"_3059":128477},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3604":75239,"_31000":75020,"_21469":128479,"_5":14752,"_28187":127913,"_3059":128480},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3604":75240,"_31000":75020,"_21469":128482,"_5":14752,"_28187":127917,"_3059":128483},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3604":75241,"_31000":75020,"_21469":128485,"_5":14752,"_28187":127921,"_3059":128486},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3604":75242,"_31000":75020,"_21469":128488,"_5":14752,"_28187":127925,"_3059":128489},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3604":75243,"_31000":75020,"_21469":128491,"_5":14752,"_28187":127925,"_3059":128492},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3604":75244,"_31000":75020,"_21469":128494,"_5":14752,"_28187":127925,"_3059":128495},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3604":75245,"_31000":75020,"_21469":128497,"_5":14752,"_28187":127925,"_3059":128498},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3604":75246,"_31000":75020,"_21469":128500,"_5":14752,"_28187":127929,"_3059":128501},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3604":75247,"_31000":75020,"_21469":128503,"_5":14752,"_28187":127933,"_3059":128504},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3604":75248,"_31000":75020,"_21469":128506,"_5":14752,"_28187":127933,"_3059":128507},[],"Ruta",{"_3604":75249,"_31000":75020,"_21469":128509,"_5":14752,"_28187":127933,"_3059":120870},[],{"_3604":75250,"_31000":75020,"_21469":128511,"_5":14752,"_28187":127933,"_3059":59784},[],{"_3604":75251,"_31000":75020,"_21469":128513,"_5":14752,"_28187":127933,"_3059":128514},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3604":75252,"_31000":75020,"_21469":128516,"_5":14752,"_28187":127933,"_3059":59790},[],{"_3604":75253,"_31000":75020,"_21469":128518,"_5":14752,"_28187":127933,"_3059":128519},[],"Lee los ajustes de una CA.",{"_3604":75254,"_31000":75020,"_21469":128521,"_5":14752,"_28187":127933,"_3059":59796},[],{"_3604":75255,"_31000":75020,"_21469":128523,"_5":14752,"_28187":127933,"_3059":128524},[],"Sustituye los `crl_options`.",{"_3604":75256,"_31000":75020,"_21469":128526,"_5":14752,"_28187":127933,"_3059":59802},[],{"_3604":75257,"_31000":75020,"_21469":128528,"_5":14752,"_28187":127933,"_3059":128529},[],"Elimina los ajustes archivados de una CA.",{"_3604":75258,"_31000":75020,"_21469":128531,"_5":14752,"_28187":127933,"_3059":128532},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3604":75259,"_31000":75020,"_21469":128534,"_5":14752,"_28187":127933,"_3059":128535},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3604":75260,"_31000":75020,"_21469":128537,"_5":14752,"_28187":127933,"_3059":128538},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3604":75261,"_31000":75020,"_21469":128540,"_5":14752,"_28187":127933,"_3059":128541},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3604":75262,"_31000":75020,"_21469":128543,"_5":14752,"_28187":127933,"_3059":128544},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3604":75263,"_31000":75020,"_21469":128546,"_5":14752,"_28187":127933,"_3059":128547},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3604":75264,"_31000":75020,"_21469":128549,"_5":14752,"_28187":127933,"_3059":128550},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3604":75265,"_31000":75020,"_21469":128552,"_5":14752,"_28187":127933,"_3059":128553},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3604":75266,"_31000":75020,"_21469":128555,"_5":14752,"_28187":127933,"_3059":128556},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3604":75267,"_31000":75020,"_21469":128558,"_5":14752,"_28187":127933,"_3059":128559},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3604":75268,"_31000":75020,"_21469":128561,"_5":14752,"_28187":127933,"_3059":128562},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3604":75269,"_31000":75020,"_21469":128564,"_5":14752,"_28187":127937,"_3059":128565},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3604":75270,"_31000":75020,"_21469":128567,"_5":14752,"_28187":127941,"_3059":128568},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3604":75271,"_31000":75020,"_21469":128570,"_5":14752,"_28187":127945,"_3059":128571},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3604":75272,"_31000":75020,"_21469":128573,"_5":14752,"_28187":127945,"_3059":128574},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3604":75273,"_31000":75020,"_21469":128576,"_5":14752,"_28187":127949,"_3059":128577},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3604":75274,"_31000":75020,"_21469":128579,"_5":14752,"_28187":127953,"_3059":128580},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3604":75275,"_31000":75020,"_21469":128582,"_5":14752,"_28187":127957,"_3059":128583},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3604":75276,"_31000":75020,"_21469":128585,"_5":14752,"_28187":127957,"_3059":128586},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3604":75277,"_31000":75020,"_21469":128588,"_5":14752,"_28187":127957,"_3059":128589},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3604":75278,"_31000":75020,"_21469":128591,"_5":14752,"_28187":127957,"_3059":128592},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3604":75279,"_31000":75020,"_21469":128594,"_5":14752,"_28187":127957,"_3059":128595},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3604":75280,"_31000":75020,"_21469":128597,"_5":14752,"_28187":127957,"_3059":128598},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3604":75281,"_31000":75020,"_21469":128600,"_5":14752,"_28187":127961,"_3059":128601},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3604":75282,"_31000":75020,"_21469":128603,"_5":14752,"_28187":127961,"_3059":128604},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3604":75283,"_31000":75020,"_21469":128606,"_5":14752,"_28187":127961,"_3059":128607},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3604":75284,"_31000":75020,"_21469":128609,"_5":14752,"_28187":127961,"_3059":128610},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3604":75285,"_31000":75020,"_21469":128612,"_5":14752,"_28187":127961,"_3059":128613},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3604":75286,"_31000":75020,"_21469":128615,"_5":14752,"_28187":127965,"_3059":128616},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3604":75287,"_31000":75020,"_21469":128618,"_5":14752,"_28187":127965,"_3059":128619},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3604":75288,"_31000":75020,"_21469":128621,"_5":14752,"_28187":127965,"_3059":128622},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3604":75289,"_31000":75020,"_21469":128624,"_5":14752,"_28187":127965,"_3059":59901},[],{"_3604":75290,"_31000":75020,"_21469":128626,"_5":14752,"_28187":127965,"_3059":128627},[],"Claves de datos obligatorias",{"_3604":75291,"_31000":75020,"_21469":128629,"_5":14752,"_28187":127965,"_3059":128630},[],"Cuándo",{"_3604":75292,"_31000":75020,"_21469":128632,"_5":14752,"_28187":127965,"_3059":128633},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3604":75293,"_31000":75020,"_21469":128635,"_5":14752,"_28187":127965,"_3059":59913},[],{"_3604":75294,"_31000":75020,"_21469":128637,"_5":14752,"_28187":127965,"_3059":128638},[],"Siempre",{"_3604":75295,"_31000":75020,"_21469":128640,"_5":14752,"_28187":127965,"_3059":128641},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3604":75296,"_31000":75020,"_21469":128643,"_5":14752,"_28187":127965,"_3059":59913},[],{"_3604":75297,"_31000":75020,"_21469":128645,"_5":14752,"_28187":127965,"_3059":128638},[],{"_3604":75298,"_31000":75020,"_21469":128647,"_5":14752,"_28187":127965,"_3059":59926},[],{"_3604":75299,"_31000":75020,"_21469":128649,"_5":14752,"_28187":127965,"_3059":59913},[],{"_3604":75300,"_31000":75020,"_21469":128651,"_5":14752,"_28187":127965,"_3059":128652},[],"Solo cuando hay autenticación SMTP",{"_3604":75301,"_31000":75020,"_21469":128654,"_5":14752,"_28187":127965,"_3059":128655},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3604":75302,"_31000":75020,"_21469":128657,"_5":14752,"_28187":127965,"_3059":128658},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3604":75303,"_31000":75020,"_21469":128660,"_5":14752,"_28187":127965,"_3059":128661},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3604":75304,"_31000":75020,"_21469":128663,"_5":14752,"_28187":127965,"_3059":128664},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3604":75305,"_31000":75020,"_21469":128666,"_5":14752,"_28187":127965,"_3059":128667},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3604":75306,"_31000":75020,"_21469":128669,"_5":14752,"_28187":127965,"_3059":128670},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3604":75307,"_31000":75020,"_21469":128672,"_5":14752,"_28187":127965,"_3059":128673},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3604":75308,"_31000":75020,"_21469":128675,"_5":14752,"_28187":127965,"_3059":128676},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3604":75309,"_31000":75020,"_21469":128678,"_5":14752,"_28187":127965,"_3059":128679},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3604":75310,"_31000":75020,"_21469":128681,"_5":14752,"_28187":127965,"_3059":128682},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3604":75311,"_31000":75020,"_21469":128684,"_5":14752,"_28187":127965,"_3059":128685},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3604":75312,"_31000":75020,"_21469":128687,"_5":14752,"_28187":127965,"_3059":128688},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3604":75313,"_31000":75020,"_21469":128690,"_5":14752,"_28187":127965,"_3059":128691},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3604":75314,"_31000":75020,"_21469":128693,"_5":14752,"_28187":127965,"_3059":128694},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3604":75315,"_31000":75020,"_21469":128696,"_5":14752,"_28187":127965,"_3059":128697},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3604":75316,"_31000":75020,"_21469":128699,"_5":14752,"_28187":127969,"_3059":128700},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3604":75317,"_31000":75020,"_21469":128702,"_5":14752,"_28187":127969,"_3059":128703},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3604":75318,"_31000":75020,"_21469":128705,"_5":14752,"_28187":127973,"_3059":128706},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3604":75319,"_31000":75020,"_21469":128708,"_5":14752,"_28187":127973,"_3059":128709},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3604":75320,"_31000":75020,"_21469":128711,"_5":14752,"_28187":127973,"_3059":128712},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3604":75321,"_31000":75020,"_21469":128714,"_5":14752,"_28187":127973,"_3059":128715},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3604":75322,"_31000":75020,"_21469":128717,"_5":14752,"_28187":127973,"_3059":128718},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3604":75323,"_31000":75020,"_21469":128720,"_5":14752,"_28187":127973,"_3059":128721},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3604":75324,"_31000":75020,"_21469":128723,"_5":14752,"_28187":127973,"_3059":128724},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3604":75325,"_31000":75020,"_21469":128726,"_5":14752,"_28187":127973,"_3059":128727},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3604":75326,"_31000":75020,"_21469":128729,"_5":14752,"_28187":127973,"_3059":128730},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3604":75327,"_31000":75020,"_21469":128732,"_5":14752,"_28187":127973,"_3059":128733},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3604":75328,"_31000":75020,"_21469":128735,"_5":14752,"_28187":127973,"_3059":128736},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3604":75329,"_31000":75020,"_21469":128738,"_5":14752,"_28187":127977,"_3059":128739},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3604":75330,"_31000":75020,"_21469":128741,"_5":14752,"_28187":127977,"_3059":128742},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3604":75331,"_31000":75020,"_21469":128744,"_5":14752,"_28187":127981,"_3059":128745},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3604":75332,"_31000":75020,"_21469":128747,"_5":14752,"_28187":127981,"_3059":128748},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3604":75333,"_31000":75020,"_21469":128750,"_5":14752,"_28187":127981,"_3059":128751},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3604":75334,"_31000":75020,"_21469":128753,"_5":14752,"_28187":127981,"_3059":128754},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3604":75335,"_31000":75020,"_21469":128756,"_5":14752,"_28187":127981,"_3059":128757},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3604":75336,"_31000":75020,"_21469":128759,"_5":14752,"_28187":127981,"_3059":128760},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3604":75337,"_31000":75020,"_21469":128762,"_5":14752,"_28187":127981,"_3059":128763},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3604":75338,"_31000":75020,"_21469":128765,"_5":14752,"_28187":127981,"_3059":128766},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3604":75339,"_31000":75020,"_21469":128768,"_5":14752,"_28187":127985,"_3059":128769},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3604":75340,"_31000":75020,"_21469":128771,"_5":14752,"_28187":127985,"_3059":128772},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3604":75341,"_31000":75020,"_21469":128774,"_5":14752,"_28187":127985,"_3059":128775},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3604":75342,"_31000":75020,"_21469":128777,"_5":14752,"_28187":127985,"_3059":128778},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3604":75343,"_31000":75020,"_21469":128780,"_5":14752,"_28187":127985,"_3059":128781},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3604":75344,"_31000":75020,"_21469":128783,"_5":14752,"_28187":127985,"_3059":128784},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3604":75345,"_31000":75020,"_21469":128786,"_5":14752,"_28187":127985,"_3059":128787},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3604":75346,"_31000":75020,"_21469":128789,"_5":14752,"_28187":127985,"_3059":128790},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3604":75347,"_31000":75020,"_21469":128792,"_5":14752,"_28187":127985,"_3059":128793},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3604":75348,"_31000":75020,"_21469":128795,"_5":14752,"_28187":127985,"_3059":128796},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3604":75349,"_31000":75020,"_21469":128798,"_5":14752,"_28187":127985,"_3059":128799},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3604":75350,"_31000":75020,"_21469":128801,"_5":14752,"_28187":127988,"_3059":128802},[],"Tras la actualización, comprueba en este orden:",{"_3604":75351,"_31000":75020,"_21469":128804,"_5":14752,"_28187":127988,"_3059":128805},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3604":75352,"_31000":75020,"_21469":128807,"_5":14752,"_28187":127988,"_3059":128808},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3604":75353,"_31000":75020,"_21469":128810,"_5":14752,"_28187":127988,"_3059":128811},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3604":75354,"_31000":75020,"_21469":128813,"_5":14752,"_28187":127988,"_3059":128814},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3604":75355,"_31000":75020,"_21469":128816,"_5":14752,"_28187":127988,"_3059":128817},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3604":75356,"_31000":75020,"_21469":128819,"_5":14752,"_28187":127988,"_3059":128820},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3604":75357,"_31000":75020,"_21469":128822,"_5":14752,"_28187":127988,"_3059":128823},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3604":75358,"_31000":75020,"_21469":128825,"_5":14752,"_28187":127988,"_3059":128826},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3604":75359,"_31000":75020,"_21469":128828,"_5":14752,"_28187":127988,"_3059":128829},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3604":75360,"_31000":75020,"_21469":128831,"_5":14752,"_28187":127988,"_3059":128832},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3604":75361,"_31000":75020,"_21469":128834,"_5":14752,"_28187":127988,"_3059":128835},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3604":75362,"_31000":75020,"_21469":128837,"_5":14752,"_28187":127988,"_3059":128838},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3604":75363,"_31000":75020,"_21469":128840,"_5":14752,"_28187":127988,"_3059":128841},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3604":75364,"_31000":75020,"_21469":128843,"_5":14752,"_28187":127988,"_3059":128844},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3604":75365,"_31000":75020,"_21469":128846,"_5":14752,"_28187":127988,"_3059":128847},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3604":75366,"_31000":75020,"_21469":128849,"_5":14752,"_28187":127992,"_3059":128850},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3604":75367,"_31000":75020,"_21469":128852,"_5":14752,"_28187":127992,"_3059":128853},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3604":75368,"_31000":75020,"_21469":128855,"_5":14752,"_28187":127992,"_3059":128856},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3604":75369,"_31000":75020,"_21469":128858,"_5":14752,"_28187":127992,"_3059":128859},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3604":75370,"_31000":75020,"_21469":128861,"_5":14752,"_28187":127992,"_3059":128862},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60144":128864,"_60146":128865,"_60148":128866,"_60150":128867,"_18594":3094,"_72325":3094},"spanish",[3059,31000,5,28187],{"_3059":25627,"_31000":25627,"_5":25627,"_28187":25627},{"_3059":128868,"_31000":131910,"_5":134952,"_28187":137994},{"_4802":128869,"_60154":128870,"_5":25627},{"_14828":26023,"_15211":6315,"_15230":7167,"_29999":6938,"_15217":4188,"_20376":3352,"_14849":4147,"_14856":7211,"_29941":12801,"_30355":6191,"_30376":14824,"_29975":3837,"_35400":6828,"_30078":20862,"_30420":10168,"_35407":5424,"_35410":4122,"_35413":3673,"_35416":5712,"_30822":7861,"_35421":19666,"_35423":7191,"_30857":18932,"_15226":3399,"_35427":7765,"_35430":7839,"_35432":10410,"_30404":3559,"_30842":3495,"_30870":14878,"_35437":9774,"_35439":17987,"_35441":8202,"_30095":6560,"_35444":5336,"_35446":7172,"_35448":7739,"_35450":3511,"_35452":3463,"_30012":7253,"_35455":3420,"_35457":6194,"_30006":5125,"_30441":10709,"_35461":27779,"_35463":14542,"_35466":4546,"_30052":4386,"_35470":8434,"_29932":4133,"_35473":18387,"_29980":14825,"_35476":21231,"_35478":7210,"_35481":4765,"_15220":5618,"_35484":9345,"_35486":9109,"_35489":7236,"_35491":3376,"_35493":23462,"_35495":5121,"_35497":26093,"_20379":6185,"_35500":10470,"_35502":3814,"_29953":6270,"_30398":6186,"_35506":10804,"_35508":4292,"_35510":5478,"_30887":3552,"_35513":3773,"_35515":7160,"_31065":14674,"_30980":4399,"_30457":10162,"_35520":3123,"_35522":7190,"_29990":21647,"_35525":7166,"_35527":10907,"_35529":3918,"_30903":26672,"_30072":12665,"_29452":8170,"_35534":7554,"_35536":14402,"_35538":4942,"_30121":12210,"_35542":23110,"_30392":24363,"_35546":5714,"_35548":18388,"_35550":7865,"_35552":5221,"_35554":3417,"_35556":7177,"_30110":4559,"_30360":5291,"_35560":3335,"_35562":3232,"_35564":8821,"_35567":4235,"_35569":7941,"_35571":9344,"_35573":3309,"_35575":7817,"_35577":9108,"_35579":4352,"_35582":6029,"_35584":18596,"_35586":5740,"_35588":7735,"_35590":4882,"_35593":5432,"_35595":7614,"_35598":11326,"_35601":4132,"_35603":5705,"_35605":6523,"_35607":6718,"_35609":5101,"_35611":50663,"_35613":1719