453":60076,"_41455":60079,"_41457":60082,"_41459":60085,"_41461":60088,"_41463":60091,"_41465":60094,"_41467":60097,"_41469":60100,"_41471":60103,"_41473":60106,"_41475":60109,"_41477":60112,"_41480":60115,"_41482":60118,"_41484":60121,"_41486":60124,"_41488":60127,"_41490":60130,"_41492":60133,"_41494":60136,"_41496":60139,"_41498":60142,"_41500":60145,"_41502":60148,"_41504":60151,"_41506":60154,"_41509":60157,"_41511":60160,"_41513":60163,"_41515":60166,"_41517":60169,"_41519":60172,"_41521":60175,"_41523":60178,"_41525":60181,"_41527":60184,"_41529":60187,"_41531":60190,"_41533":60193,"_41535":60196,"_41537":60199,"_41539":60202,"_41541":60205,"_41543":60208,"_41545":60211,"_41547":60214,"_41549":60217,"_41551":60220,"_41553":60223,"_41555":60226,"_41557":60229,"_41559":60232,"_41561":60235,"_41563":60238,"_41565":60241,"_41567":60244,"_41569":60247,"_41571":60250,"_41574":60253,"_41576":60256,"_41578":60259,"_41580":60262},{"_3607":15,"_31098":15,"_5":15159,"_3062":50785,"_31457":50786,"_21528":50790,"_28279":15},"Deploy from AWS Marketplace",[50787,50788,50789],"Docs","Deployment","Other models",[],{"_3607":16,"_31098":15,"_21528":50792,"_5":14794,"_28279":15,"_3062":50793},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3607":17,"_31098":15,"_5":31454,"_21528":50795,"_28279":50796,"_3062":50797},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3607":18,"_31098":15,"_5":31454,"_21528":50799,"_28279":50800,"_3062":50801},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3607":19,"_31098":15,"_5":31454,"_21528":50803,"_28279":50804,"_3062":50805},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3607":20,"_31098":15,"_5":31454,"_21528":50807,"_28279":50808,"_3062":50809},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3607":21,"_31098":15,"_5":31454,"_21528":50811,"_28279":50812,"_3062":50813},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3607":22,"_31098":15,"_5":31454,"_21528":50815,"_28279":50816,"_3062":50817},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3607":23,"_31098":15,"_5":31454,"_21528":50819,"_28279":50820,"_3062":50821},[],"/docs/pr-preview/pr-75/deployment/aws-marketplace#next-step","Next step",{"_3607":24,"_31098":15,"_21528":50823,"_5":14794,"_28279":15,"_3062":50824},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3607":25,"_31098":15,"_21528":50826,"_5":14794,"_28279":50796,"_3062":50827},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3607":26,"_31098":15,"_21528":50829,"_5":14794,"_28279":50796,"_3062":50830},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3607":27,"_31098":15,"_21528":50832,"_5":14794,"_28279":50796,"_3062":50833},[],"A security group allowing the necessary endpoints.",{"_3607":28,"_31098":15,"_21528":50835,"_5":14794,"_28279":50800,"_3062":50836},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3607":29,"_31098":15,"_21528":50838,"_5":14794,"_28279":50800,"_3062":50839},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3607":30,"_31098":15,"_21528":50841,"_5":14794,"_28279":50800,"_3062":50842},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3607":31,"_31098":15,"_21528":50844,"_5":14794,"_28279":50804,"_3062":50845},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3607":32,"_31098":15,"_21528":50847,"_5":14794,"_28279":50808,"_3062":50848},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3607":33,"_31098":15,"_21528":50850,"_5":14794,"_28279":50812,"_3062":50851},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3607":34,"_31098":15,"_21528":50853,"_5":14794,"_28279":50816,"_3062":50854},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3607":35,"_31098":15,"_21528":50856,"_5":14794,"_28279":50820,"_3062":50857},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3607":36,"_31098":36,"_5":15159,"_3062":50859,"_31457":50860,"_21528":50861,"_28279":36},"Deploy Lamassu",[50787,50788],[],{"_3607":37,"_31098":36,"_21528":50863,"_5":14794,"_28279":36,"_3062":50864},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3607":38,"_31098":36,"_5":31454,"_21528":50866,"_28279":50867,"_3062":50868},[],"/docs/pr-preview/pr-75/deployment/overview#choose-a-model","Choose a model",{"_3607":39,"_31098":36,"_5":31454,"_21528":50870,"_28279":50871,"_3062":50872},[],"/docs/pr-preview/pr-75/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3607":40,"_31098":36,"_5":31454,"_21528":50874,"_28279":50875,"_3062":50876},[],"/docs/pr-preview/pr-75/deployment/overview#after-deployment","After deployment",{"_3607":41,"_31098":36,"_21528":50878,"_5":14794,"_28279":36,"_3062":50879},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3607":42,"_31098":36,"_21528":50881,"_5":14794,"_28279":50867,"_3062":50882},[],"Model",{"_3607":43,"_31098":36,"_21528":50884,"_5":14794,"_28279":50867,"_3062":50885},[],"Recommended for",{"_3607":44,"_31098":36,"_21528":50887,"_5":14794,"_28279":50867,"_3062":50888},[],"Who operates the infrastructure",{"_3607":45,"_31098":36,"_21528":50890,"_5":14794,"_28279":50867,"_3062":50891},[],"Starting point",{"_3607":46,"_31098":36,"_21528":50893,"_5":14794,"_28279":50867,"_3062":50894},[],"Kubernetes self-managed",{"_3607":47,"_31098":36,"_21528":50896,"_5":14794,"_28279":50867,"_3062":50897},[],"Production, regulated environments and custom deployments",{"_3607":48,"_31098":36,"_21528":50899,"_5":14794,"_28279":50867,"_3062":50900},[],"Your team",{"_3607":49,"_31098":36,"_21528":50902,"_5":14794,"_28279":50867,"_3062":50903},[],"Helm or Fastlane",{"_3607":50,"_31098":36,"_21528":50905,"_5":14794,"_28279":50867,"_3062":50906},[],"AWS Marketplace",{"_3607":51,"_31098":36,"_21528":50908,"_5":14794,"_28279":50867,"_3062":50909},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3607":52,"_31098":36,"_21528":50911,"_5":14794,"_28279":50867,"_3062":50900},[],{"_3607":53,"_31098":36,"_21528":50913,"_5":14794,"_28279":50867,"_3062":50914},[],"Preconfigured image on EC2",{"_3607":54,"_31098":36,"_21528":50916,"_5":14794,"_28279":50867,"_3062":50917},[],"SaaS",{"_3607":55,"_31098":36,"_21528":50919,"_5":14794,"_28279":50867,"_3062":50920},[],"Teams that want to use the platform without operating it",{"_3607":56,"_31098":36,"_21528":50922,"_5":14794,"_28279":50867,"_3062":50923},[],"Lamassu",{"_3607":57,"_31098":36,"_21528":50925,"_5":14794,"_28279":50867,"_3062":50926},[],"Managed subscription",{"_3607":58,"_31098":36,"_21528":50928,"_5":14794,"_28279":50867,"_3062":50929},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3607":59,"_31098":36,"_21528":50931,"_5":14794,"_28279":50867,"_3062":50932},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3607":60,"_31098":36,"_21528":50934,"_5":14794,"_28279":50867,"_3062":50935},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3607":61,"_31098":36,"_21528":50937,"_5":14794,"_28279":50871,"_3062":50938},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3607":62,"_31098":36,"_21528":50940,"_5":14794,"_28279":50875,"_3062":50941},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3607":63,"_31098":63,"_5":15159,"_3062":50943,"_31457":50944,"_21528":50945,"_28279":63},"Use Lamassu as SaaS",[50787,50788,50789],[],{"_3607":64,"_31098":63,"_21528":50947,"_5":14794,"_28279":63,"_3062":50948},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3607":65,"_31098":63,"_5":31454,"_21528":50950,"_28279":50951,"_3062":50952},[],"/docs/pr-preview/pr-75/deployment/saas#what-the-service-manages","What the service manages",{"_3607":66,"_31098":63,"_5":31454,"_21528":50954,"_28279":50955,"_3062":50956},[],"/docs/pr-preview/pr-75/deployment/saas#plans","Plans",{"_3607":67,"_31098":63,"_5":31454,"_21528":50958,"_28279":50959,"_3062":50960},[],"/docs/pr-preview/pr-75/deployment/saas#request-access","Request access",{"_3607":68,"_31098":63,"_21528":50962,"_5":14794,"_28279":63,"_3062":50963},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3607":69,"_31098":63,"_21528":50965,"_5":14794,"_28279":50951,"_3062":50966},[],"Platform availability and maintenance.",{"_3607":70,"_31098":63,"_21528":50968,"_5":14794,"_28279":50951,"_3062":50969},[],"Automatic backups.",{"_3607":71,"_31098":63,"_21528":50971,"_5":14794,"_28279":50951,"_3062":50972},[],"Version upgrades.",{"_3607":72,"_31098":63,"_21528":50974,"_5":14794,"_28279":50951,"_3062":50975},[],"Technical support and SLA according to your plan.",{"_3607":73,"_31098":63,"_21528":50977,"_5":14794,"_28279":50955,"_3062":50978},[],"Plan",{"_3607":74,"_31098":63,"_21528":50980,"_5":14794,"_28279":50955,"_3062":50981},[],"Devices",{"_3607":75,"_31098":63,"_21528":50983,"_5":14794,"_28279":50955,"_3062":50984},[],"Support",{"_3607":76,"_31098":63,"_21528":50986,"_5":14794,"_28279":50955,"_3062":50987},[],"SLA",{"_3607":77,"_31098":63,"_21528":50989,"_5":14794,"_28279":50955,"_3062":50990},[],"Starter",{"_3607":78,"_31098":63,"_21528":50992,"_5":14794,"_28279":50955,"_3062":50993},[],"Up to 1,000",{"_3607":79,"_31098":63,"_21528":50995,"_5":14794,"_28279":50955,"_3062":50996},[],"Email",{"_3607":80,"_31098":63,"_21528":50998,"_5":14794,"_28279":50955,"_3062":50999},[],"99.5 %",{"_3607":81,"_31098":63,"_21528":51001,"_5":14794,"_28279":50955,"_3062":51002},[],"Professional",{"_3607":82,"_31098":63,"_21528":51004,"_5":14794,"_28279":50955,"_3062":51005},[],"Up to 10,000",{"_3607":83,"_31098":63,"_21528":51007,"_5":14794,"_28279":50955,"_3062":51008},[],"Email and chat",{"_3607":84,"_31098":63,"_21528":51010,"_5":14794,"_28279":50955,"_3062":51011},[],"99.9 %",{"_3607":85,"_31098":63,"_21528":51013,"_5":14794,"_28279":50955,"_3062":51014},[],"Enterprise",{"_3607":86,"_31098":63,"_21528":51016,"_5":14794,"_28279":50955,"_3062":51017},[],"Unlimited",{"_3607":87,"_31098":63,"_21528":51019,"_5":14794,"_28279":50955,"_3062":51020},[],"Dedicated",{"_3607":88,"_31098":63,"_21528":51022,"_5":14794,"_28279":50955,"_3062":51023},[],"99.99 %",{"_3607":89,"_31098":63,"_21528":51025,"_5":14794,"_28279":50959,"_3062":51026},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3607":90,"_31098":63,"_21528":51028,"_5":14794,"_28279":50959,"_3062":51029},[],"When you receive your instance's credentials, continue with Get started.",{"_3607":91,"_31098":91,"_5":15159,"_3062":51031,"_31457":51032,"_21528":51033,"_28279":91},"Fastlane",[50787,50788,50894],[],{"_3607":92,"_31098":91,"_21528":51035,"_5":14794,"_28279":91,"_3062":51036},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3607":93,"_31098":91,"_5":31454,"_21528":51038,"_28279":51039,"_3062":51040},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3607":94,"_31098":91,"_5":31454,"_21528":51042,"_28279":51043,"_3062":51044},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3607":95,"_31098":91,"_5":31454,"_21528":51046,"_28279":51047,"_3062":50797},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#before-you-begin",{"_3607":96,"_31098":91,"_5":31454,"_21528":51049,"_28279":51050,"_3062":51051},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3607":97,"_31098":91,"_5":31454,"_21528":51053,"_28279":51054,"_3062":51055},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3607":98,"_31098":91,"_5":31454,"_21528":51057,"_28279":51058,"_3062":51059},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3607":99,"_31098":91,"_5":31454,"_21528":51061,"_28279":51062,"_3062":51063},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3607":100,"_31098":91,"_5":31454,"_21528":51065,"_28279":51066,"_3062":51067},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3607":101,"_31098":91,"_5":31454,"_21528":51069,"_28279":51070,"_3062":51071},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3607":102,"_31098":91,"_5":31454,"_21528":51073,"_28279":51074,"_3062":51075},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3607":103,"_31098":91,"_5":31454,"_21528":51077,"_28279":51078,"_3062":51079},[],"/docs/pr-preview/pr-75/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3607":104,"_31098":91,"_21528":51081,"_5":14794,"_28279":51039,"_3062":51082},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3607":105,"_31098":91,"_21528":51084,"_5":14794,"_28279":51039,"_3062":51085},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3607":106,"_31098":91,"_21528":51087,"_5":14794,"_28279":51043,"_3062":51088},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3607":107,"_31098":91,"_21528":51090,"_5":14794,"_28279":51043,"_3062":51091},[],"Fastlane installs or configures",{"_3607":108,"_31098":91,"_21528":51093,"_5":14794,"_28279":51043,"_3062":51094},[],"You still provide",{"_3607":109,"_31098":91,"_21528":51096,"_5":14794,"_28279":51043,"_3062":51097},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3607":110,"_31098":91,"_21528":51099,"_5":14794,"_28279":51043,"_3062":51100},[],"The Kubernetes cluster, nodes and persistent storage",{"_3607":111,"_31098":91,"_21528":51102,"_5":14794,"_28279":51043,"_3062":51103},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3607":112,"_31098":91,"_21528":51105,"_5":14794,"_28279":51043,"_3062":51106},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3607":113,"_31098":91,"_21528":51108,"_5":14794,"_28279":51043,"_3062":51109},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3607":114,"_31098":91,"_21528":51111,"_5":14794,"_28279":51043,"_3062":51112},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3607":115,"_31098":91,"_21528":51114,"_5":14794,"_28279":51043,"_3062":51115},[],"Optional observability and lab HSM components",{"_3607":116,"_31098":91,"_21528":51117,"_5":14794,"_28279":51043,"_3062":51118},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3607":117,"_31098":91,"_21528":51120,"_5":14794,"_28279":51043,"_3062":51121},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3607":118,"_31098":91,"_21528":51123,"_5":14794,"_28279":51047,"_3062":51124},[],"You need:",{"_3607":119,"_31098":91,"_21528":51126,"_5":14794,"_28279":51047,"_3062":51127},[],"an existing Kubernetes cluster",{"_3607":120,"_31098":91,"_21528":51129,"_5":14794,"_28279":51047,"_3062":51130},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3607":121,"_31098":91,"_21528":51132,"_5":14794,"_28279":51047,"_3062":51133},[],"`yq`",{"_3607":122,"_31098":91,"_21528":51135,"_5":14794,"_28279":51047,"_3062":24334},[],{"_3607":123,"_31098":91,"_21528":51137,"_5":14794,"_28279":51047,"_3062":51138},[],"`jq` only when using `--sample-data` or `--development`",{"_3607":124,"_31098":91,"_21528":51140,"_5":14794,"_28279":51047,"_3062":51141},[],"`ssh-keygen` only when using `--with-hsm`",{"_3607":125,"_31098":91,"_21528":51143,"_5":14794,"_28279":51047,"_3062":51144},[],"free external ports 80 and 443 on a single-node K3s host",{"_3607":126,"_31098":91,"_21528":51146,"_5":14794,"_28279":51047,"_3062":51147},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3607":127,"_31098":91,"_21528":51149,"_5":14794,"_28279":51047,"_3062":51150},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3607":128,"_31098":91,"_21528":51152,"_5":14794,"_28279":51050,"_3062":51153},[],"Run the script from a clone of the Helm repository:",{"_3607":129,"_31098":91,"_21528":51155,"_5":14794,"_28279":51050,"_3062":51156},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3607":130,"_31098":91,"_21528":51158,"_5":14794,"_28279":51054,"_3062":51159},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3607":131,"_31098":91,"_21528":51161,"_5":14794,"_28279":51054,"_3062":51162},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3607":132,"_31098":91,"_21528":51164,"_5":14794,"_28279":51054,"_3062":51165},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3607":133,"_31098":91,"_21528":51167,"_5":14794,"_28279":51054,"_3062":51168},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3607":134,"_31098":91,"_21528":51170,"_5":14794,"_28279":51058,"_3062":51171},[],"Option",{"_3607":135,"_31098":91,"_21528":51173,"_5":14794,"_28279":51058,"_3062":51174},[],"Default",{"_3607":136,"_31098":91,"_21528":51176,"_5":14794,"_28279":51058,"_3062":51177},[],"Purpose",{"_3607":137,"_31098":91,"_21528":51179,"_5":14794,"_28279":51058,"_3062":51180},[],"`-h`, `--help`",{"_3607":138,"_31098":91,"_21528":51182,"_5":14794,"_28279":51058,"_3062":51183},[],"—",{"_3607":139,"_31098":91,"_21528":51185,"_5":14794,"_28279":51058,"_3062":51186},[],"Show help",{"_3607":140,"_31098":91,"_21528":51188,"_5":14794,"_28279":51058,"_3062":51189},[],"`-c`, `--context`",{"_3607":141,"_31098":91,"_21528":51191,"_5":14794,"_28279":51058,"_3062":51192},[],"current context",{"_3607":142,"_31098":91,"_21528":51194,"_5":14794,"_28279":51058,"_3062":51195},[],"Select the kubeconfig context for kubectl and Helm",{"_3607":143,"_31098":91,"_21528":51197,"_5":14794,"_28279":51058,"_3062":51198},[],"`-n`, `--non-interactive`",{"_3607":144,"_31098":91,"_21528":51200,"_5":14794,"_28279":51058,"_3062":6768},[],{"_3607":145,"_31098":91,"_21528":51202,"_5":14794,"_28279":51058,"_3062":51203},[],"Skip prompts and generate dependency credentials",{"_3607":146,"_31098":91,"_21528":51205,"_5":14794,"_28279":51058,"_3062":51206},[],"`-ns`, `--namespace`",{"_3607":147,"_31098":91,"_21528":51208,"_5":14794,"_28279":51058,"_3062":51209},[],"`lamassu-dev`",{"_3607":148,"_31098":91,"_21528":51211,"_5":14794,"_28279":51058,"_3062":51212},[],"Namespace for the installation",{"_3607":149,"_31098":91,"_21528":51214,"_5":14794,"_28279":51058,"_3062":51215},[],"`-d`, `--domain`",{"_3607":150,"_31098":91,"_21528":51217,"_5":14794,"_28279":51058,"_3062":51218},[],"`dev.lamassu.io`",{"_3607":151,"_31098":91,"_21528":51220,"_5":14794,"_28279":51058,"_3062":51221},[],"Domain used by the UI, OIDC and certificate",{"_3607":152,"_31098":91,"_21528":51223,"_5":14794,"_28279":51058,"_3062":51224},[],"`-v`, `--version`",{"_3607":153,"_31098":91,"_21528":51226,"_5":14794,"_28279":51058,"_3062":15506},[],{"_3607":154,"_31098":91,"_21528":51228,"_5":14794,"_28279":51058,"_3062":51229},[],"Lamassu chart version",{"_3607":155,"_31098":91,"_21528":51231,"_5":14794,"_28279":51058,"_3062":51232},[],"`--https-port`",{"_3607":156,"_31098":91,"_21528":51234,"_5":14794,"_28279":51058,"_3062":51235},[],"`443`",{"_3607":157,"_31098":91,"_21528":51237,"_5":14794,"_28279":51058,"_3062":51238},[],"Gateway HTTPS listener port",{"_3607":158,"_31098":91,"_21528":51240,"_5":14794,"_28279":51058,"_3062":51241},[],"`--http-port`",{"_3607":159,"_31098":91,"_21528":51243,"_5":14794,"_28279":51058,"_3062":51244},[],"`80`",{"_3607":160,"_31098":91,"_21528":51246,"_5":14794,"_28279":51058,"_3062":51247},[],"Gateway HTTP listener port",{"_3607":161,"_31098":91,"_21528":51249,"_5":14794,"_28279":51058,"_3062":51250},[],"`--tls-crt`",{"_3607":162,"_31098":91,"_21528":51252,"_5":14794,"_28279":51058,"_3062":51183},[],{"_3607":163,"_31098":91,"_21528":51254,"_5":14794,"_28279":51058,"_3062":51255},[],"PEM certificate for downstream TLS",{"_3607":164,"_31098":91,"_21528":51257,"_5":14794,"_28279":51058,"_3062":51258},[],"`--tls-key`",{"_3607":165,"_31098":91,"_21528":51260,"_5":14794,"_28279":51058,"_3062":51183},[],{"_3607":166,"_31098":91,"_21528":51262,"_5":14794,"_28279":51058,"_3062":51263},[],"PEM private key for downstream TLS",{"_3607":167,"_31098":91,"_21528":51265,"_5":14794,"_28279":51058,"_3062":51266},[],"`-l`, `--local-chart-path`",{"_3607":168,"_31098":91,"_21528":51268,"_5":14794,"_28279":51058,"_3062":51269},[],"repository chart",{"_3607":169,"_31098":91,"_21528":51271,"_5":14794,"_28279":51058,"_3062":51272},[],"Use an unpacked local Lamassu chart",{"_3607":170,"_31098":91,"_21528":51274,"_5":14794,"_28279":51058,"_3062":51275},[],"`-ip`, `--gateway-ip`",{"_3607":171,"_31098":91,"_21528":51277,"_5":14794,"_28279":51058,"_3062":9031},[],{"_3607":172,"_31098":91,"_21528":51279,"_5":14794,"_28279":51058,"_3062":51280},[],"Override the address written to `gateway.addresses`",{"_3607":173,"_31098":91,"_21528":51282,"_5":14794,"_28279":51058,"_3062":51283},[],"`--otel`",{"_3607":174,"_31098":91,"_21528":51285,"_5":14794,"_28279":51058,"_3062":6768},[],{"_3607":175,"_31098":91,"_21528":51287,"_5":14794,"_28279":51058,"_3062":51288},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3607":176,"_31098":91,"_21528":51290,"_5":14794,"_28279":51058,"_3062":51291},[],"`--development`",{"_3607":177,"_31098":91,"_21528":51293,"_5":14794,"_28279":51058,"_3062":6768},[],{"_3607":178,"_31098":91,"_21528":51295,"_5":14794,"_28279":51058,"_3062":51296},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3607":179,"_31098":91,"_21528":51298,"_5":14794,"_28279":51058,"_3062":51299},[],"`--sample-data`",{"_3607":180,"_31098":91,"_21528":51301,"_5":14794,"_28279":51058,"_3062":6768},[],{"_3607":181,"_31098":91,"_21528":51303,"_5":14794,"_28279":51058,"_3062":51304},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3607":182,"_31098":91,"_21528":51306,"_5":14794,"_28279":51058,"_3062":51307},[],"`--with-hsm`",{"_3607":183,"_31098":91,"_21528":51309,"_5":14794,"_28279":51058,"_3062":6768},[],{"_3607":184,"_31098":91,"_21528":51311,"_5":14794,"_28279":51058,"_3062":51312},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3607":185,"_31098":91,"_21528":51314,"_5":14794,"_28279":51058,"_3062":51315},[],"`--softhsm-chart-path`",{"_3607":186,"_31098":91,"_21528":51317,"_5":14794,"_28279":51058,"_3062":51318},[],"`./charts/softhsm`",{"_3607":187,"_31098":91,"_21528":51320,"_5":14794,"_28279":51058,"_3062":51321},[],"Use a different local SoftHSM chart",{"_3607":188,"_31098":91,"_21528":51323,"_5":14794,"_28279":51058,"_3062":51324},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3607":189,"_31098":91,"_21528":51326,"_5":14794,"_28279":51062,"_3062":51327},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3607":190,"_31098":91,"_21528":51329,"_5":14794,"_28279":51062,"_3062":51330},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3607":191,"_31098":91,"_21528":51332,"_5":14794,"_28279":51062,"_3062":51333},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3607":192,"_31098":91,"_21528":51335,"_5":14794,"_28279":51062,"_3062":51336},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3607":193,"_31098":91,"_21528":51338,"_5":14794,"_28279":51062,"_3062":51339},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3607":194,"_31098":91,"_21528":51341,"_5":14794,"_28279":51062,"_3062":51342},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3607":195,"_31098":91,"_21528":51344,"_5":14794,"_28279":51066,"_3062":51345},[],"Fastlane:",{"_3607":196,"_31098":91,"_21528":51347,"_5":14794,"_28279":51066,"_3062":51348},[],"validates local tools and the selected cluster",{"_3607":197,"_31098":91,"_21528":51350,"_5":14794,"_28279":51066,"_3062":51351},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3607":198,"_31098":91,"_21528":51353,"_5":14794,"_28279":51066,"_3062":51354},[],"creates the namespace",{"_3607":199,"_31098":91,"_21528":51356,"_5":14794,"_28279":51066,"_3062":51357},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3607":200,"_31098":91,"_21528":51359,"_5":14794,"_28279":51066,"_3062":51360},[],"installs PostgreSQL and creates the required databases",{"_3607":201,"_31098":91,"_21528":51362,"_5":14794,"_28279":51066,"_3062":51363},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3607":202,"_31098":91,"_21528":51365,"_5":14794,"_28279":51066,"_3062":51366},[],"installs RabbitMQ",{"_3607":203,"_31098":91,"_21528":51368,"_5":14794,"_28279":51066,"_3062":51369},[],"optionally installs observability and lab HSM components",{"_3607":204,"_31098":91,"_21528":51371,"_5":14794,"_28279":51066,"_3062":51372},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3607":205,"_31098":91,"_21528":51374,"_5":14794,"_28279":51066,"_3062":51375},[],"optionally loads sample data",{"_3607":206,"_31098":91,"_21528":51377,"_5":14794,"_28279":51066,"_3062":51378},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3607":207,"_31098":91,"_21528":51380,"_5":14794,"_28279":51070,"_3062":51381},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3607":208,"_31098":91,"_21528":51383,"_5":14794,"_28279":51070,"_3062":51384},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3607":209,"_31098":91,"_21528":51386,"_5":14794,"_28279":51074,"_3062":51387},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3607":210,"_31098":91,"_21528":51389,"_5":14794,"_28279":51074,"_3062":51390},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3607":211,"_31098":91,"_21528":51392,"_5":14794,"_28279":51074,"_3062":51393},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3607":212,"_31098":91,"_21528":51395,"_5":14794,"_28279":51074,"_3062":51396},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3607":213,"_31098":91,"_21528":51398,"_5":14794,"_28279":51078,"_3062":51399},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3607":214,"_31098":214,"_5":15159,"_3062":51401,"_31457":51402,"_21528":51403,"_28279":214},"Install with Helm",[50787,50788,50894],[],{"_3607":215,"_31098":214,"_21528":51405,"_5":14794,"_28279":214,"_3062":51406},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3607":216,"_31098":214,"_5":31454,"_21528":51408,"_28279":51409,"_3062":51410},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3607":217,"_31098":214,"_5":31454,"_21528":51412,"_28279":51413,"_3062":50797},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#before-you-begin",{"_3607":218,"_31098":214,"_5":31454,"_21528":51415,"_28279":51416,"_3062":51417},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3607":219,"_31098":214,"_5":31454,"_21528":51419,"_28279":51420,"_3062":51421},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3607":220,"_31098":214,"_5":31454,"_21528":51423,"_28279":51424,"_3062":51425},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3607":221,"_31098":214,"_5":31454,"_21528":51427,"_28279":51428,"_3062":51429},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3607":222,"_31098":214,"_5":31454,"_21528":51431,"_28279":51432,"_3062":51433},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3607":223,"_31098":214,"_5":31454,"_21528":51435,"_28279":51436,"_3062":51437},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3607":224,"_31098":214,"_5":31454,"_21528":51439,"_28279":51440,"_3062":51441},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3607":225,"_31098":214,"_5":31454,"_21528":51443,"_28279":51444,"_3062":51445},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3607":226,"_31098":214,"_5":31454,"_21528":51447,"_28279":51448,"_3062":51449},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3607":227,"_31098":214,"_5":31454,"_21528":51451,"_28279":51452,"_3062":51453},[],"/docs/pr-preview/pr-75/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3607":228,"_31098":214,"_21528":51455,"_5":14794,"_28279":51409,"_3062":51456},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3607":229,"_31098":214,"_21528":51458,"_5":14794,"_28279":51413,"_3062":51459},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3607":230,"_31098":214,"_21528":51461,"_5":14794,"_28279":51413,"_3062":51462},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3607":231,"_31098":214,"_21528":51464,"_5":14794,"_28279":51413,"_3062":51465},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3607":232,"_31098":214,"_21528":51467,"_5":14794,"_28279":51413,"_3062":51468},[],"a reachable RabbitMQ broker and credentials",{"_3607":233,"_31098":214,"_21528":51470,"_5":14794,"_28279":51413,"_3062":51471},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3607":234,"_31098":214,"_21528":51473,"_5":14794,"_28279":51413,"_3062":51474},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3607":235,"_31098":214,"_21528":51476,"_5":14794,"_28279":51413,"_3062":51477},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3607":236,"_31098":214,"_21528":51479,"_5":14794,"_28279":51413,"_3062":51480},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3607":237,"_31098":214,"_21528":51482,"_5":14794,"_28279":51413,"_3062":51483},[],"a StorageClass and an external traffic design",{"_3607":238,"_31098":214,"_21528":51485,"_5":14794,"_28279":51413,"_3062":51486},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3607":239,"_31098":214,"_21528":51488,"_5":14794,"_28279":51413,"_3062":51489},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3607":240,"_31098":214,"_21528":51491,"_5":14794,"_28279":51413,"_3062":51492},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3607":241,"_31098":214,"_21528":51494,"_5":14794,"_28279":51416,"_3062":51495},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3607":242,"_31098":214,"_21528":51497,"_5":14794,"_28279":51416,"_3062":51498},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3607":243,"_31098":214,"_21528":51500,"_5":14794,"_28279":51416,"_3062":51501},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3607":244,"_31098":214,"_21528":51503,"_5":14794,"_28279":51420,"_3062":51504},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3607":245,"_31098":214,"_21528":51506,"_5":14794,"_28279":51420,"_3062":51507},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3607":246,"_31098":214,"_21528":51509,"_5":14794,"_28279":51420,"_3062":51510},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3607":247,"_31098":214,"_21528":51512,"_5":14794,"_28279":51420,"_3062":51513},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3607":248,"_31098":214,"_21528":51515,"_5":14794,"_28279":51424,"_3062":51516},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3607":249,"_31098":214,"_21528":51518,"_5":14794,"_28279":51424,"_3062":51519},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3607":250,"_31098":214,"_21528":51521,"_5":14794,"_28279":51424,"_3062":51522},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3607":251,"_31098":214,"_21528":51524,"_5":14794,"_28279":51424,"_3062":51525},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3607":252,"_31098":214,"_21528":51527,"_5":14794,"_28279":51424,"_3062":51528},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3607":253,"_31098":214,"_21528":51530,"_5":14794,"_28279":51424,"_3062":51531},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3607":254,"_31098":214,"_21528":51533,"_5":14794,"_28279":51424,"_3062":51534},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3607":255,"_31098":214,"_21528":51536,"_5":14794,"_28279":51424,"_3062":51537},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3607":256,"_31098":214,"_21528":51539,"_5":14794,"_28279":51428,"_3062":51540},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3607":257,"_31098":214,"_21528":51542,"_5":14794,"_28279":51432,"_3062":51543},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3607":258,"_31098":214,"_21528":51545,"_5":14794,"_28279":51432,"_3062":51546},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3607":259,"_31098":214,"_21528":51548,"_5":14794,"_28279":51432,"_3062":51549},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3607":260,"_31098":214,"_21528":51551,"_5":14794,"_28279":51432,"_3062":51552},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3607":261,"_31098":214,"_21528":51554,"_5":14794,"_28279":51432,"_3062":51555},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3607":262,"_31098":214,"_21528":51557,"_5":14794,"_28279":51432,"_3062":51558},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3607":263,"_31098":214,"_21528":51560,"_5":14794,"_28279":51432,"_3062":51561},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3607":264,"_31098":214,"_21528":51563,"_5":14794,"_28279":51436,"_3062":51564},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3607":265,"_31098":214,"_21528":51566,"_5":14794,"_28279":51436,"_3062":51567},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3607":266,"_31098":214,"_21528":51569,"_5":14794,"_28279":51436,"_3062":51570},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3607":267,"_31098":214,"_21528":51572,"_5":14794,"_28279":51436,"_3062":51573},[],"See Access control for the principal and policy model.",{"_3607":268,"_31098":214,"_21528":51575,"_5":14794,"_28279":51440,"_3062":51576},[],"To install a local checkout instead:",{"_3607":269,"_31098":214,"_21528":51578,"_5":14794,"_28279":51444,"_3062":51579},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3607":270,"_31098":214,"_21528":51581,"_5":14794,"_28279":51444,"_3062":51582},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3607":271,"_31098":214,"_21528":51584,"_5":14794,"_28279":51448,"_3062":51585},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3607":272,"_31098":214,"_21528":51587,"_5":14794,"_28279":51448,"_3062":51588},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3607":273,"_31098":214,"_21528":51590,"_5":14794,"_28279":51448,"_3062":51591},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3607":274,"_31098":214,"_21528":51593,"_5":14794,"_28279":51448,"_3062":51594},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3607":275,"_31098":214,"_21528":51596,"_5":14794,"_28279":51448,"_3062":51597},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3607":276,"_31098":214,"_21528":51599,"_5":14794,"_28279":51452,"_3062":51600},[],"Before going live, review:",{"_3607":277,"_31098":214,"_21528":51602,"_5":14794,"_28279":51452,"_3062":51603},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3607":278,"_31098":214,"_21528":51605,"_5":14794,"_28279":51452,"_3062":51606},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3607":279,"_31098":214,"_21528":51608,"_5":14794,"_28279":51452,"_3062":51609},[],"shared VA storage before increasing VA replicas",{"_3607":280,"_31098":214,"_21528":51611,"_5":14794,"_28279":51452,"_3062":51612},[],"managed OIDC roles and removal of evaluation credentials",{"_3607":281,"_31098":214,"_21528":51614,"_5":14794,"_28279":51452,"_3062":51615},[],"a trusted TLS issuer or externally managed certificate",{"_3607":282,"_31098":214,"_21528":51617,"_5":14794,"_28279":51452,"_3062":51618},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3607":283,"_31098":214,"_21528":51620,"_5":14794,"_28279":51452,"_3062":51621},[],"SMTP, observability and alert delivery",{"_3607":284,"_31098":214,"_21528":51623,"_5":14794,"_28279":51452,"_3062":51624},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3607":285,"_31098":214,"_21528":51626,"_5":14794,"_28279":51452,"_3062":51627},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3607":286,"_31098":286,"_5":15159,"_3062":51629,"_31457":51630,"_21528":51631,"_28279":286},"Expose the Gateway",[50787,50788,50894],[],{"_3607":287,"_31098":286,"_21528":51633,"_5":14794,"_28279":286,"_3062":51634},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3607":288,"_31098":286,"_5":31454,"_21528":51636,"_28279":51637,"_3062":51638},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3607":289,"_31098":286,"_5":31454,"_21528":51640,"_28279":51641,"_3062":51642},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3607":290,"_31098":286,"_5":31454,"_21528":51644,"_28279":51645,"_3062":51646},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3607":291,"_31098":286,"_5":31454,"_21528":51648,"_28279":51649,"_3062":51650},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#k3s","K3s",{"_3607":292,"_31098":286,"_5":31454,"_21528":51652,"_28279":51653,"_3062":51654},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3607":293,"_31098":286,"_5":31454,"_21528":51656,"_28279":51657,"_3062":51658},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3607":294,"_31098":286,"_5":31454,"_21528":51660,"_28279":51661,"_3062":51662},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3607":295,"_31098":286,"_5":31454,"_21528":51664,"_28279":51665,"_3062":51666},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3607":296,"_31098":286,"_5":31454,"_21528":51668,"_28279":51669,"_3062":51670},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3607":297,"_31098":286,"_5":31454,"_21528":51672,"_28279":51673,"_3062":51674},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3607":298,"_31098":286,"_5":31454,"_21528":51676,"_28279":51677,"_3062":51678},[],"/docs/pr-preview/pr-75/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3607":299,"_31098":286,"_21528":51680,"_5":14794,"_28279":51637,"_3062":51681},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3607":300,"_31098":286,"_21528":51683,"_5":14794,"_28279":51637,"_3062":51684},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3607":301,"_31098":286,"_21528":51686,"_5":14794,"_28279":51641,"_3062":51687},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3607":302,"_31098":286,"_21528":51689,"_5":14794,"_28279":51641,"_3062":51690},[],"Set it only when:",{"_3607":303,"_31098":286,"_21528":51692,"_5":14794,"_28279":51641,"_3062":51693},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3607":304,"_31098":286,"_21528":51695,"_5":14794,"_28279":51641,"_3062":51696},[],"that address is allocated to this Gateway",{"_3607":305,"_31098":286,"_21528":51698,"_5":14794,"_28279":51641,"_3062":51699},[],"the surrounding network already routes traffic for it to the cluster",{"_3607":306,"_31098":286,"_21528":51701,"_5":14794,"_28279":51641,"_3062":51702},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3607":307,"_31098":286,"_21528":51704,"_5":14794,"_28279":51641,"_3062":51705},[],"Keep these two settings separate:",{"_3607":308,"_31098":286,"_21528":51707,"_5":14794,"_28279":51641,"_3062":51708},[],"`gateway.addresses` requests an address for the Gateway.",{"_3607":309,"_31098":286,"_21528":51710,"_5":14794,"_28279":51641,"_3062":51711},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3607":310,"_31098":286,"_21528":51713,"_5":14794,"_28279":51641,"_3062":51714},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3607":311,"_31098":286,"_21528":51716,"_5":14794,"_28279":51645,"_3062":51717},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3607":312,"_31098":286,"_21528":51719,"_5":14794,"_28279":51645,"_3062":51720},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3607":313,"_31098":286,"_21528":51722,"_5":14794,"_28279":51649,"_3062":51723},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3607":314,"_31098":286,"_21528":51725,"_5":14794,"_28279":51649,"_3062":51726},[],"For the recommended design:",{"_3607":315,"_31098":286,"_21528":51728,"_5":14794,"_28279":51649,"_3062":51729},[],"Use only one externally exposed Lamassu Gateway.",{"_3607":316,"_31098":286,"_21528":51731,"_5":14794,"_28279":51649,"_3062":51732},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3607":317,"_31098":286,"_21528":51734,"_5":14794,"_28279":51649,"_3062":51735},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3607":318,"_31098":286,"_21528":51737,"_5":14794,"_28279":51649,"_3062":51738},[],"Point DNS at the VM's reachable address.",{"_3607":319,"_31098":286,"_21528":51740,"_5":14794,"_28279":51649,"_3062":51741},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3607":320,"_31098":286,"_21528":51743,"_5":14794,"_28279":51653,"_3062":51744},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3607":321,"_31098":286,"_21528":51746,"_5":14794,"_28279":51657,"_3062":51747},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3607":322,"_31098":286,"_21528":51749,"_5":14794,"_28279":51657,"_3062":51750},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3607":323,"_31098":286,"_21528":51752,"_5":14794,"_28279":51661,"_3062":51753},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3607":324,"_31098":286,"_21528":51755,"_5":14794,"_28279":51661,"_3062":51756},[],"Requirement",{"_3607":325,"_31098":286,"_21528":51758,"_5":14794,"_28279":51661,"_3062":51759},[],"Recommended design",{"_3607":326,"_31098":286,"_21528":51761,"_5":14794,"_28279":51661,"_3062":51762},[],"Consequence",{"_3607":327,"_31098":286,"_21528":51764,"_5":14794,"_28279":51661,"_3062":51765},[],"Several Lamassu URLs or services",{"_3607":328,"_31098":286,"_21528":51767,"_5":14794,"_28279":51661,"_3062":51768},[],"One Gateway with multiple routes",{"_3607":329,"_31098":286,"_21528":51770,"_5":14794,"_28279":51661,"_3062":51771},[],"One IP and one proxy fleet; this is the chart default",{"_3607":330,"_31098":286,"_21528":51773,"_5":14794,"_28279":51661,"_3062":51774},[],"Independent Gateways and separate external IPs",{"_3607":331,"_31098":286,"_21528":51776,"_5":14794,"_28279":51661,"_3062":51777},[],"One VIP per Gateway",{"_3607":332,"_31098":286,"_21528":51779,"_5":14794,"_28279":51661,"_3062":51780},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3607":333,"_31098":286,"_21528":51782,"_5":14794,"_28279":51661,"_3062":51783},[],"Independent Gateways on one node and one IP",{"_3607":334,"_31098":286,"_21528":51785,"_5":14794,"_28279":51661,"_3062":51786},[],"Use different external ports",{"_3607":335,"_31098":286,"_21528":51788,"_5":14794,"_28279":51661,"_3062":51789},[],"Clients must include non-standard ports",{"_3607":336,"_31098":286,"_21528":51791,"_5":14794,"_28279":51661,"_3062":51792},[],"Separate TLS/mTLS termination behind one IP",{"_3607":337,"_31098":286,"_21528":51794,"_5":14794,"_28279":51661,"_3062":51795},[],"Front-door SNI routing to internal Gateways",{"_3607":338,"_31098":286,"_21528":51797,"_5":14794,"_28279":51661,"_3062":51798},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3607":339,"_31098":286,"_21528":51800,"_5":14794,"_28279":51661,"_3062":51801},[],"Separate Gateway resources but shared proxy infrastructure",{"_3607":340,"_31098":286,"_21528":51803,"_5":14794,"_28279":51661,"_3062":51804},[],"Envoy merged-Gateway mode",{"_3607":341,"_31098":286,"_21528":51806,"_5":14794,"_28279":51661,"_3062":51807},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3607":342,"_31098":286,"_21528":51809,"_5":14794,"_28279":51661,"_3062":51810},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3607":343,"_31098":286,"_21528":51812,"_5":14794,"_28279":51661,"_3062":51813},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3607":344,"_31098":286,"_21528":51815,"_5":14794,"_28279":51661,"_3062":51816},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3607":345,"_31098":286,"_21528":51818,"_5":14794,"_28279":51661,"_3062":51819},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3607":346,"_31098":286,"_21528":51821,"_5":14794,"_28279":51665,"_3062":51822},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3607":347,"_31098":286,"_21528":51824,"_5":14794,"_28279":51669,"_3062":51825},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3607":348,"_31098":286,"_21528":51827,"_5":14794,"_28279":51669,"_3062":51828},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3607":349,"_31098":286,"_21528":51830,"_5":14794,"_28279":51669,"_3062":51831},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3607":350,"_31098":286,"_21528":51833,"_5":14794,"_28279":51669,"_3062":51834},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3607":351,"_31098":286,"_21528":51836,"_5":14794,"_28279":51669,"_3062":51837},[],"If none of those are possible, use different external ports or change the external network design.",{"_3607":352,"_31098":286,"_21528":51839,"_5":14794,"_28279":51673,"_3062":51840},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3607":353,"_31098":286,"_21528":51842,"_5":14794,"_28279":51673,"_3062":51843},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3607":354,"_31098":286,"_21528":51845,"_5":14794,"_28279":51677,"_3062":51846},[],"Check, in order:",{"_3607":355,"_31098":286,"_21528":51848,"_5":14794,"_28279":51677,"_3062":51849},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3607":356,"_31098":286,"_21528":51851,"_5":14794,"_28279":51677,"_3062":51852},[],"Its status contains the expected address.",{"_3607":357,"_31098":286,"_21528":51854,"_5":14794,"_28279":51677,"_3062":51855},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3607":358,"_31098":286,"_21528":51857,"_5":14794,"_28279":51677,"_3062":51858},[],"Port 443 reaches that address from the client network.",{"_3607":359,"_31098":286,"_21528":51860,"_5":14794,"_28279":51677,"_3062":51861},[],"DNS resolves to the externally reachable endpoint.",{"_3607":360,"_31098":286,"_21528":51863,"_5":14794,"_28279":51677,"_3062":51864},[],"The certificate contains the DNS name or IP used by the client.",{"_3607":361,"_31098":286,"_21528":51866,"_5":14794,"_28279":51677,"_3062":51867},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3607":362,"_31098":362,"_5":15159,"_3062":50894,"_31457":51869,"_21528":51870,"_28279":362},[50787,50788,50894],[],{"_3607":363,"_31098":362,"_21528":51872,"_5":14794,"_28279":362,"_3062":51873},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3607":364,"_31098":362,"_5":31454,"_21528":51875,"_28279":51876,"_3062":51877},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3607":365,"_31098":362,"_5":31454,"_21528":51879,"_28279":51880,"_3062":51881},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3607":366,"_31098":362,"_5":31454,"_21528":51883,"_28279":51884,"_3062":51885},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3607":367,"_31098":362,"_5":31454,"_21528":51887,"_28279":51888,"_3062":51889},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3607":368,"_31098":362,"_5":31454,"_21528":51891,"_28279":51892,"_3062":51893},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3607":369,"_31098":362,"_5":31454,"_21528":51895,"_28279":51896,"_3062":51897},[],"/docs/pr-preview/pr-75/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3607":370,"_31098":362,"_21528":51899,"_5":14794,"_28279":51876,"_3062":51900},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3607":371,"_31098":362,"_21528":51902,"_5":14794,"_28279":51880,"_3062":51903},[],"Workflow",{"_3607":372,"_31098":362,"_21528":51905,"_5":14794,"_28279":51880,"_3062":51906},[],"Use it for",{"_3607":373,"_31098":362,"_21528":51908,"_5":14794,"_28279":51880,"_3062":51909},[],"What it installs",{"_3607":374,"_31098":362,"_21528":51911,"_5":14794,"_28279":51880,"_3062":51912},[],"Helm",{"_3607":375,"_31098":362,"_21528":51914,"_5":14794,"_28279":51880,"_3062":51915},[],"Production and controlled environments",{"_3607":376,"_31098":362,"_21528":51917,"_5":14794,"_28279":51880,"_3062":51918},[],"Lamassu services and Gateway API resources",{"_3607":377,"_31098":362,"_21528":51920,"_5":14794,"_28279":51880,"_3062":51031},[],{"_3607":378,"_31098":362,"_21528":51922,"_5":14794,"_28279":51880,"_3062":51923},[],"Evaluation, demos, CI and small lab clusters",{"_3607":379,"_31098":362,"_21528":51925,"_5":14794,"_28279":51880,"_3062":51926},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3607":380,"_31098":362,"_21528":51928,"_5":14794,"_28279":51884,"_3062":51929},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3607":381,"_31098":362,"_21528":51931,"_5":14794,"_28279":51884,"_3062":51932},[],"Area",{"_3607":382,"_31098":362,"_21528":51934,"_5":14794,"_28279":51884,"_3062":51935},[],"The Lamassu chart provides",{"_3607":383,"_31098":362,"_21528":51937,"_5":14794,"_28279":51884,"_3062":51938},[],"You provide",{"_3607":384,"_31098":362,"_21528":51940,"_5":14794,"_28279":51884,"_3062":51941},[],"Lamassu applications",{"_3607":385,"_31098":362,"_21528":51943,"_5":14794,"_28279":51884,"_3062":51944},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3607":386,"_31098":362,"_21528":51946,"_5":14794,"_28279":51884,"_3062":51947},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3607":387,"_31098":362,"_21528":51949,"_5":14794,"_28279":51884,"_3062":51950},[],"PostgreSQL data",{"_3607":388,"_31098":362,"_21528":51952,"_5":14794,"_28279":51884,"_3062":51953},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3607":389,"_31098":362,"_21528":51955,"_5":14794,"_28279":51884,"_3062":51956},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3607":390,"_31098":362,"_21528":51958,"_5":14794,"_28279":51884,"_3062":51959},[],"Messaging",{"_3607":391,"_31098":362,"_21528":51961,"_5":14794,"_28279":51884,"_3062":51962},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3607":392,"_31098":362,"_21528":51964,"_5":14794,"_28279":51884,"_3062":51965},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3607":393,"_31098":362,"_21528":51967,"_5":14794,"_28279":51884,"_3062":51968},[],"Identity",{"_3607":394,"_31098":362,"_21528":51970,"_5":14794,"_28279":51884,"_3062":51971},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3607":395,"_31098":362,"_21528":51973,"_5":14794,"_28279":51884,"_3062":51974},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3607":396,"_31098":362,"_21528":51976,"_5":14794,"_28279":51884,"_3062":51977},[],"External routing",{"_3607":397,"_31098":362,"_21528":51979,"_5":14794,"_28279":51884,"_3062":51980},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3607":398,"_31098":362,"_21528":51982,"_5":14794,"_28279":51884,"_3062":51983},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3607":399,"_31098":362,"_21528":51985,"_5":14794,"_28279":51884,"_3062":51986},[],"TLS",{"_3607":400,"_31098":362,"_21528":51988,"_5":14794,"_28279":51884,"_3062":51989},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3607":401,"_31098":362,"_21528":51991,"_5":14794,"_28279":51884,"_3062":51992},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3607":402,"_31098":362,"_21528":51994,"_5":14794,"_28279":51884,"_3062":51995},[],"Persistent application data",{"_3607":403,"_31098":362,"_21528":51997,"_5":14794,"_28279":51884,"_3062":51998},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3607":404,"_31098":362,"_21528":52000,"_5":14794,"_28279":51884,"_3062":52001},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3607":405,"_31098":362,"_21528":52003,"_5":14794,"_28279":51884,"_3062":52004},[],"Optional integrations",{"_3607":406,"_31098":362,"_21528":52006,"_5":14794,"_28279":51884,"_3062":52007},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3607":407,"_31098":362,"_21528":52009,"_5":14794,"_28279":51884,"_3062":52010},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3607":408,"_31098":362,"_21528":52012,"_5":14794,"_28279":51884,"_3062":52013},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3607":409,"_31098":362,"_21528":52015,"_5":14794,"_28279":51884,"_3062":52016},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3607":410,"_31098":362,"_21528":52018,"_5":14794,"_28279":51888,"_3062":52019},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3607":411,"_31098":362,"_21528":52021,"_5":14794,"_28279":51888,"_3062":52022},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3607":412,"_31098":362,"_21528":52024,"_5":14794,"_28279":51892,"_3062":52025},[],"Kubernetes 1.24 or newer",{"_3607":413,"_31098":362,"_21528":52027,"_5":14794,"_28279":51892,"_3062":52028},[],"Helm 3.2 or newer",{"_3607":414,"_31098":362,"_21528":52030,"_5":14794,"_28279":51892,"_3062":52031},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3607":415,"_31098":362,"_21528":52033,"_5":14794,"_28279":51892,"_3062":52034},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3607":416,"_31098":362,"_21528":52036,"_5":14794,"_28279":51892,"_3062":52037},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3607":417,"_31098":362,"_21528":52039,"_5":14794,"_28279":51892,"_3062":52040},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3607":418,"_31098":362,"_21528":52042,"_5":14794,"_28279":51892,"_3062":52043},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3607":419,"_31098":362,"_21528":52045,"_5":14794,"_28279":51896,"_3062":52046},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3607":420,"_31098":362,"_21528":52048,"_5":14794,"_28279":51896,"_3062":52049},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3607":421,"_31098":362,"_21528":52051,"_5":14794,"_28279":51896,"_3062":52052},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3607":422,"_31098":362,"_21528":52054,"_5":14794,"_28279":51896,"_3062":52055},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3607":423,"_31098":423,"_5":15159,"_3062":52057,"_31457":52058,"_21528":52060,"_28279":423},"Deployment troubleshooting",[50787,50788,52059],"Operations",[],{"_3607":424,"_31098":423,"_21528":52062,"_5":14794,"_28279":423,"_3062":52063},[],"Diagnose access, service health and infrastructure dependencies.",{"_3607":425,"_31098":423,"_5":31454,"_21528":52065,"_28279":52066,"_3062":52067},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3607":426,"_31098":423,"_5":31454,"_21528":52069,"_28279":52070,"_3062":52071},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3607":427,"_31098":423,"_5":31454,"_21528":52073,"_28279":52074,"_3062":52075},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3607":428,"_31098":423,"_5":31454,"_21528":52077,"_28279":52078,"_3062":52079},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3607":429,"_31098":423,"_5":31454,"_21528":52081,"_28279":52082,"_3062":52083},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3607":430,"_31098":423,"_5":31454,"_21528":52085,"_28279":52086,"_3062":52087},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3607":431,"_31098":423,"_5":31454,"_21528":52089,"_28279":52090,"_3062":52091},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3607":432,"_31098":423,"_5":31454,"_21528":52093,"_28279":52094,"_3062":52095},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3607":433,"_31098":423,"_5":31454,"_21528":52097,"_28279":52098,"_3062":52099},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3607":434,"_31098":423,"_5":31454,"_21528":52101,"_28279":52102,"_3062":52103},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3607":435,"_31098":423,"_5":31454,"_21528":52105,"_28279":52106,"_3062":52107},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3607":436,"_31098":423,"_5":31454,"_21528":52109,"_28279":52110,"_3062":52111},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3607":437,"_31098":423,"_5":31454,"_21528":52113,"_28279":52114,"_3062":52115},[],"/docs/pr-preview/pr-75/deployment/troubleshooting#observability","Observability",{"_3607":438,"_31098":423,"_21528":52117,"_5":14794,"_28279":423,"_3062":52118},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3607":439,"_31098":423,"_21528":52120,"_5":14794,"_28279":52070,"_3062":52121},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3607":440,"_31098":423,"_21528":52123,"_5":14794,"_28279":52074,"_3062":52124},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3607":441,"_31098":423,"_21528":52126,"_5":14794,"_28279":52078,"_3062":52127},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3607":442,"_31098":423,"_21528":52129,"_5":14794,"_28279":52082,"_3062":52130},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3607":443,"_31098":423,"_21528":52132,"_5":14794,"_28279":52086,"_3062":52133},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3607":444,"_31098":423,"_21528":52135,"_5":14794,"_28279":52090,"_3062":52136},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3607":445,"_31098":423,"_21528":52138,"_5":14794,"_28279":52090,"_3062":52139},[],"Also run the chart's connectivity test:",{"_3607":446,"_31098":423,"_21528":52141,"_5":14794,"_28279":52090,"_3062":52142},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3607":447,"_31098":423,"_21528":52144,"_5":14794,"_28279":52090,"_3062":52145},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3607":448,"_31098":423,"_21528":52147,"_5":14794,"_28279":52094,"_3062":52148},[],"If you receive a 401:",{"_3607":449,"_31098":423,"_21528":52150,"_5":14794,"_28279":52094,"_3062":52151},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3607":450,"_31098":423,"_21528":52153,"_5":14794,"_28279":52094,"_3062":52154},[],"verify issuer, audience and expiration of the token;",{"_3607":451,"_31098":423,"_21528":52156,"_5":14794,"_28279":52094,"_3062":52157},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3607":452,"_31098":423,"_21528":52159,"_5":14794,"_28279":52094,"_3062":52160},[],"check that the provider's public and internal routes point to the same realm.",{"_3607":453,"_31098":423,"_21528":52162,"_5":14794,"_28279":52094,"_3062":52163},[],"If login succeeds but the APIs return 403:",{"_3607":454,"_31098":423,"_21528":52165,"_5":14794,"_28279":52094,"_3062":52166},[],"inspect the token's real claims;",{"_3607":455,"_31098":423,"_21528":52168,"_5":14794,"_28279":52094,"_3062":52169},[],"confirm they match an active principal;",{"_3607":456,"_31098":423,"_21528":52171,"_5":14794,"_28279":52094,"_3062":52172},[],"review the policies granted to that principal;",{"_3607":457,"_31098":423,"_21528":52174,"_5":14794,"_28279":52094,"_3062":52175},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3607":458,"_31098":423,"_21528":52177,"_5":14794,"_28279":52094,"_3062":52178},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3607":459,"_31098":423,"_21528":52180,"_5":14794,"_28279":52098,"_3062":52181},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3607":460,"_31098":423,"_21528":52183,"_5":14794,"_28279":52098,"_3062":52184},[],"Locate the authz pod and Service.",{"_3607":461,"_31098":423,"_21528":52186,"_5":14794,"_28279":52098,"_3062":52187},[],"Check /health, logs and its database connection.",{"_3607":462,"_31098":423,"_21528":52189,"_5":14794,"_28279":52098,"_3062":52190},[],"Verify the DNS and port configured in externalAuthorization.",{"_3607":463,"_31098":423,"_21528":52192,"_5":14794,"_28279":52098,"_3062":52193},[],"Check the check route is /v1/ext\\_authz/check.",{"_3607":464,"_31098":423,"_21528":52195,"_5":14794,"_28279":52098,"_3062":52196},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3607":465,"_31098":423,"_21528":52198,"_5":14794,"_28279":52102,"_3062":52199},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3607":466,"_31098":423,"_21528":52201,"_5":14794,"_28279":52106,"_3062":52202},[],"Review kubectl describe pod first. Common causes are:",{"_3607":467,"_31098":423,"_21528":52204,"_5":14794,"_28279":52106,"_3062":52205},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3607":468,"_31098":423,"_21528":52207,"_5":14794,"_28279":52106,"_3062":52208},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3607":469,"_31098":423,"_21528":52210,"_5":14794,"_28279":52106,"_3062":52211},[],"unbound persistent volume;",{"_3607":470,"_31098":423,"_21528":52213,"_5":14794,"_28279":52106,"_3062":52214},[],"inaccessible image or incorrect pull policy;",{"_3607":471,"_31098":423,"_21528":52216,"_5":14794,"_28279":52106,"_3062":52217},[],"invalid cryptographic engine configuration;",{"_3607":472,"_31098":423,"_21528":52219,"_5":14794,"_28279":52106,"_3062":52220},[],"CPU or memory limits set too low;",{"_3607":473,"_31098":423,"_21528":52222,"_5":14794,"_28279":52106,"_3062":52223},[],"an incomplete prior migration.",{"_3607":474,"_31098":423,"_21528":52225,"_5":14794,"_28279":52106,"_3062":52226},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3607":475,"_31098":423,"_21528":52228,"_5":14794,"_28279":52106,"_3062":52229},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3607":476,"_31098":423,"_21528":52231,"_5":14794,"_28279":52106,"_3062":52232},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3607":477,"_31098":423,"_21528":52234,"_5":14794,"_28279":52110,"_3062":52235},[],"Domain and audit events depend on the bus publisher:",{"_3607":478,"_31098":423,"_21528":52237,"_5":14794,"_28279":52110,"_3062":52238},[],"verify it is enabled in the emitting service;",{"_3607":479,"_31098":423,"_21528":52240,"_5":14794,"_28279":52110,"_3062":52241},[],"check AMQP connectivity and credentials;",{"_3607":480,"_31098":423,"_21528":52243,"_5":14794,"_28279":52110,"_3062":52244},[],"review exchange, routing key, queues and consumers;",{"_3607":481,"_31098":423,"_21528":52246,"_5":14794,"_28279":52110,"_3062":52247},[],"inspect dead-letter queues;",{"_3607":482,"_31098":423,"_21528":52249,"_5":14794,"_28279":52110,"_3062":52250},[],"alert on orphan durable queues and backlog growth.",{"_3607":483,"_31098":423,"_21528":52252,"_5":14794,"_28279":52110,"_3062":52253},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3607":484,"_31098":423,"_21528":52255,"_5":14794,"_28279":52110,"_3062":52256},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3607":485,"_31098":423,"_21528":52258,"_5":14794,"_28279":52110,"_3062":52259},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3607":486,"_31098":423,"_21528":52261,"_5":14794,"_28279":52110,"_3062":52262},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3607":487,"_31098":423,"_21528":52264,"_5":14794,"_28279":52110,"_3062":52265},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3607":488,"_31098":423,"_21528":52267,"_5":14794,"_28279":52110,"_3062":52268},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3607":489,"_31098":423,"_21528":52270,"_5":14794,"_28279":52110,"_3062":52271},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3607":490,"_31098":423,"_21528":52273,"_5":14794,"_28279":52114,"_3062":52274},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3607":491,"_31098":423,"_21528":52276,"_5":14794,"_28279":52114,"_3062":52277},[],"Before closing an incident, record:",{"_3607":492,"_31098":423,"_21528":52279,"_5":14794,"_28279":52114,"_3062":52280},[],"the confirmed cause;",{"_3607":493,"_31098":423,"_21528":52282,"_5":14794,"_28279":52114,"_3062":52283},[],"the time scope and affected resources;",{"_3607":494,"_31098":423,"_21528":52285,"_5":14794,"_28279":52114,"_3062":52286},[],"the commands or queries used;",{"_3607":495,"_31098":423,"_21528":52288,"_5":14794,"_28279":52114,"_3062":52289},[],"the applied change and how to revert it;",{"_3607":496,"_31098":423,"_21528":52291,"_5":14794,"_28279":52114,"_3062":52292},[],"validation from a consumer;",{"_3607":497,"_31098":423,"_21528":52294,"_5":14794,"_28279":52114,"_3062":52295},[],"the preventive action and its owner.",{"_3607":498,"_31098":498,"_5":15159,"_3062":52297,"_31457":52298,"_21528":52302,"_28279":498},"Data model",[50787,52299,52300,52301],"Platform","Administration","Access control",[],{"_3607":499,"_31098":498,"_21528":52304,"_5":14794,"_28279":498,"_3062":52305},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3607":500,"_31098":498,"_5":31454,"_21528":52307,"_28279":52308,"_3062":52309},[],"/docs/pr-preview/pr-75/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3607":501,"_31098":498,"_5":31454,"_21528":52311,"_28279":52312,"_3062":52313},[],"/docs/pr-preview/pr-75/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3607":502,"_31098":498,"_21528":52315,"_5":14794,"_28279":498,"_3062":52316},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3607":503,"_31098":498,"_21528":52318,"_5":14794,"_28279":52308,"_3062":52319},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3607":504,"_31098":498,"_21528":52321,"_5":14794,"_28279":52308,"_3062":52322},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3607":505,"_31098":498,"_21528":52324,"_5":14794,"_28279":52308,"_3062":52325},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3607":506,"_31098":498,"_21528":52327,"_5":14794,"_28279":52312,"_3062":52328},[],"Entity (`schema_name.entity_type`)",{"_3607":507,"_31098":498,"_21528":52330,"_5":14794,"_28279":52312,"_3062":52331},[],"Table (`table_name`)",{"_3607":508,"_31098":498,"_21528":52333,"_5":14794,"_28279":52312,"_3062":52334},[],"Key (`primary_key`)",{"_3607":509,"_31098":498,"_21528":52336,"_5":14794,"_28279":52312,"_3062":52337},[],"`alerts.event`",{"_3607":510,"_31098":498,"_21528":52339,"_5":14794,"_28279":52312,"_3062":52340},[],"`events`",{"_3607":511,"_31098":498,"_21528":52342,"_5":14794,"_28279":52312,"_3062":52343},[],"`event_type`",{"_3607":512,"_31098":498,"_21528":52345,"_5":14794,"_28279":52312,"_3062":52346},[],"`alerts.subscription`",{"_3607":513,"_31098":498,"_21528":52348,"_5":14794,"_28279":52312,"_3062":52349},[],"`subscriptions`",{"_3607":514,"_31098":498,"_21528":52351,"_5":14794,"_28279":52312,"_3062":52352},[],"`id`",{"_3607":515,"_31098":498,"_21528":52354,"_5":14794,"_28279":52312,"_3062":52355},[],"`ca.ca_certificate`",{"_3607":516,"_31098":498,"_21528":52357,"_5":14794,"_28279":52312,"_3062":52358},[],"`ca_certificates`",{"_3607":517,"_31098":498,"_21528":52360,"_5":14794,"_28279":52312,"_3062":52352},[],{"_3607":518,"_31098":498,"_21528":52362,"_5":14794,"_28279":52312,"_3062":52363},[],"`ca.certificate`",{"_3607":519,"_31098":498,"_21528":52365,"_5":14794,"_28279":52312,"_3062":52366},[],"`certificates`",{"_3607":520,"_31098":498,"_21528":52368,"_5":14794,"_28279":52312,"_3062":52369},[],"`serial_number`",{"_3607":521,"_31098":498,"_21528":52371,"_5":14794,"_28279":52312,"_3062":52372},[],"`ca.issuance_profile`",{"_3607":522,"_31098":498,"_21528":52374,"_5":14794,"_28279":52312,"_3062":52375},[],"`issuance_profiles`",{"_3607":523,"_31098":498,"_21528":52377,"_5":14794,"_28279":52312,"_3062":52352},[],{"_3607":524,"_31098":498,"_21528":52379,"_5":14794,"_28279":52312,"_3062":52380},[],"`devicemanager.device_group`",{"_3607":525,"_31098":498,"_21528":52382,"_5":14794,"_28279":52312,"_3062":52383},[],"`device_groups`",{"_3607":526,"_31098":498,"_21528":52385,"_5":14794,"_28279":52312,"_3062":52352},[],{"_3607":527,"_31098":498,"_21528":52387,"_5":14794,"_28279":52312,"_3062":52388},[],"`devicemanager.device`",{"_3607":528,"_31098":498,"_21528":52390,"_5":14794,"_28279":52312,"_3062":52391},[],"`devices`",{"_3607":529,"_31098":498,"_21528":52393,"_5":14794,"_28279":52312,"_3062":52352},[],{"_3607":530,"_31098":498,"_21528":52395,"_5":14794,"_28279":52312,"_3062":52396},[],"`dmsmanager.dms`",{"_3607":531,"_31098":498,"_21528":52398,"_5":14794,"_28279":52312,"_3062":52399},[],"`dms`",{"_3607":532,"_31098":498,"_21528":52401,"_5":14794,"_28279":52312,"_3062":52352},[],{"_3607":533,"_31098":498,"_21528":52403,"_5":14794,"_28279":52312,"_3062":52404},[],"`kms.kms_key`",{"_3607":534,"_31098":498,"_21528":52406,"_5":14794,"_28279":52312,"_3062":52407},[],"`kms_keys`",{"_3607":535,"_31098":498,"_21528":52409,"_5":14794,"_28279":52312,"_3062":52410},[],"`key_id`, `engine_id`",{"_3607":536,"_31098":498,"_21528":52412,"_5":14794,"_28279":52312,"_3062":52413},[],"`va.crl_settings`",{"_3607":537,"_31098":498,"_21528":52415,"_5":14794,"_28279":52312,"_3062":52416},[],"`crl_settings`",{"_3607":538,"_31098":498,"_21528":52418,"_5":14794,"_28279":52312,"_3062":52419},[],"`ca_id`",{"_3607":539,"_31098":498,"_21528":52421,"_5":14794,"_28279":52312,"_3062":52422},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3607":540,"_31098":498,"_21528":52424,"_5":14794,"_28279":52312,"_3062":52425},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3607":541,"_31098":498,"_21528":52427,"_5":14794,"_28279":52312,"_3062":52428},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3607":542,"_31098":542,"_5":15159,"_3062":52430,"_31457":52431,"_21528":52432,"_28279":542},"Access control overview",[50787,52299,52300,52301],[],{"_3607":543,"_31098":542,"_21528":52434,"_5":14794,"_28279":542,"_3062":52435},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3607":544,"_31098":542,"_5":31454,"_21528":52437,"_28279":52438,"_3062":52439},[],"/docs/pr-preview/pr-75/platform/administration/access-control#essential-concepts","Essential concepts",{"_3607":545,"_31098":542,"_5":31454,"_21528":52441,"_28279":52442,"_3062":52443},[],"/docs/pr-preview/pr-75/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3607":546,"_31098":542,"_5":31454,"_21528":52445,"_28279":52446,"_3062":52447},[],"/docs/pr-preview/pr-75/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3607":547,"_31098":542,"_5":31454,"_21528":52449,"_28279":52450,"_3062":52451},[],"/docs/pr-preview/pr-75/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3607":548,"_31098":542,"_5":31454,"_21528":52453,"_28279":52454,"_3062":52455},[],"/docs/pr-preview/pr-75/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3607":549,"_31098":542,"_5":31454,"_21528":52457,"_28279":52458,"_3062":52459},[],"/docs/pr-preview/pr-75/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3607":550,"_31098":542,"_5":31454,"_21528":52461,"_28279":52462,"_3062":52463},[],"/docs/pr-preview/pr-75/platform/administration/access-control#oidc-principals","OIDC principals",{"_3607":551,"_31098":542,"_5":31454,"_21528":52465,"_28279":52466,"_3062":52467},[],"/docs/pr-preview/pr-75/platform/administration/access-control#x509-principals","X.509 principals",{"_3607":552,"_31098":542,"_5":31454,"_21528":52469,"_28279":52470,"_3062":52471},[],"/docs/pr-preview/pr-75/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3607":553,"_31098":542,"_5":31454,"_21528":52473,"_28279":52474,"_3062":52475},[],"/docs/pr-preview/pr-75/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3607":554,"_31098":542,"_5":31454,"_21528":52477,"_28279":52478,"_3062":52479},[],"/docs/pr-preview/pr-75/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3607":555,"_31098":542,"_5":31454,"_21528":52481,"_28279":52482,"_3062":52483},[],"/docs/pr-preview/pr-75/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3607":556,"_31098":542,"_5":31454,"_21528":52485,"_28279":52486,"_3062":52487},[],"/docs/pr-preview/pr-75/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3607":557,"_31098":542,"_5":31454,"_21528":52489,"_28279":52490,"_3062":52491},[],"/docs/pr-preview/pr-75/platform/administration/access-control#http-rules","HTTP rules",{"_3607":558,"_31098":542,"_5":31454,"_21528":52493,"_28279":52494,"_3062":52495},[],"/docs/pr-preview/pr-75/platform/administration/access-control#included-policies","Included policies",{"_3607":559,"_31098":542,"_5":31454,"_21528":52497,"_28279":52498,"_3062":51437},[],"/docs/pr-preview/pr-75/platform/administration/access-control#provision-the-first-administrator",{"_3607":560,"_31098":542,"_5":31454,"_21528":52500,"_28279":52501,"_3062":52502},[],"/docs/pr-preview/pr-75/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3607":561,"_31098":542,"_5":31454,"_21528":52504,"_28279":52505,"_3062":52506},[],"/docs/pr-preview/pr-75/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3607":562,"_31098":542,"_5":31454,"_21528":52508,"_28279":52509,"_3062":52510},[],"/docs/pr-preview/pr-75/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3607":563,"_31098":542,"_5":31454,"_21528":52512,"_28279":52513,"_3062":52514},[],"/docs/pr-preview/pr-75/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3607":564,"_31098":542,"_5":31454,"_21528":52516,"_28279":52517,"_3062":52518},[],"/docs/pr-preview/pr-75/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3607":565,"_31098":542,"_5":31454,"_21528":52520,"_28279":52521,"_3062":52522},[],"/docs/pr-preview/pr-75/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3607":566,"_31098":542,"_5":31454,"_21528":52524,"_28279":52525,"_3062":52526},[],"/docs/pr-preview/pr-75/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3607":567,"_31098":542,"_5":31454,"_21528":52528,"_28279":52529,"_3062":52530},[],"/docs/pr-preview/pr-75/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3607":568,"_31098":542,"_5":31454,"_21528":52532,"_28279":52533,"_3062":52534},[],"/docs/pr-preview/pr-75/platform/administration/access-control#operational-checklist","Operational checklist",{"_3607":569,"_31098":542,"_5":31454,"_21528":52536,"_28279":52537,"_3062":52538},[],"/docs/pr-preview/pr-75/platform/administration/access-control#diagnostics","Diagnostics",{"_3607":570,"_31098":542,"_5":31454,"_21528":52540,"_28279":52541,"_3062":52542},[],"/docs/pr-preview/pr-75/platform/administration/access-control#the-response-is-401","The response is 401",{"_3607":571,"_31098":542,"_5":31454,"_21528":52544,"_28279":52545,"_3062":52546},[],"/docs/pr-preview/pr-75/platform/administration/access-control#the-response-is-403","The response is 403",{"_3607":572,"_31098":542,"_5":31454,"_21528":52548,"_28279":52549,"_3062":52550},[],"/docs/pr-preview/pr-75/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3607":573,"_31098":542,"_5":31454,"_21528":52552,"_28279":52553,"_3062":52554},[],"/docs/pr-preview/pr-75/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3607":574,"_31098":542,"_5":31454,"_21528":52556,"_28279":52557,"_3062":52558},[],"/docs/pr-preview/pr-75/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3607":575,"_31098":542,"_21528":52560,"_5":14794,"_28279":542,"_3062":52561},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3607":576,"_31098":542,"_21528":52563,"_5":14794,"_28279":542,"_3062":52564},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3607":577,"_31098":542,"_21528":52566,"_5":14794,"_28279":542,"_3062":52567},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3607":578,"_31098":542,"_21528":52569,"_5":14794,"_28279":52438,"_3062":52570},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3607":579,"_31098":542,"_21528":52572,"_5":14794,"_28279":52438,"_3062":52573},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3607":580,"_31098":542,"_21528":52575,"_5":14794,"_28279":52438,"_3062":52576},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3607":581,"_31098":542,"_21528":52578,"_5":14794,"_28279":52438,"_3062":52579},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3607":582,"_31098":542,"_21528":52581,"_5":14794,"_28279":52438,"_3062":52582},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3607":583,"_31098":542,"_21528":52584,"_5":14794,"_28279":52438,"_3062":52585},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3607":584,"_31098":542,"_21528":52587,"_5":14794,"_28279":52442,"_3062":52588},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3607":585,"_31098":542,"_21528":52590,"_5":14794,"_28279":52442,"_3062":52591},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3607":586,"_31098":542,"_21528":52593,"_5":14794,"_28279":52446,"_3062":52594},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3607":587,"_31098":542,"_21528":52596,"_5":14794,"_28279":52446,"_3062":52597},[],"The decision is made **before forwarding the request to the service**:",{"_3607":588,"_31098":542,"_21528":52599,"_5":14794,"_28279":52446,"_3062":52600},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3607":589,"_31098":542,"_21528":52602,"_5":14794,"_28279":52446,"_3062":52603},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3607":590,"_31098":542,"_21528":52605,"_5":14794,"_28279":52446,"_3062":52606},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3607":591,"_31098":542,"_21528":52608,"_5":14794,"_28279":52446,"_3062":52609},[],"It separately loads the policies granted to each principal.",{"_3607":592,"_31098":542,"_21528":52611,"_5":14794,"_28279":52446,"_3062":52612},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3607":593,"_31098":542,"_21528":52614,"_5":14794,"_28279":52446,"_3062":52615},[],"`authz` looks for an HTTP rule granting that action.",{"_3607":594,"_31098":542,"_21528":52617,"_5":14794,"_28279":52446,"_3062":52618},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3607":595,"_31098":542,"_21528":52620,"_5":14794,"_28279":52446,"_3062":52621},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3607":596,"_31098":542,"_21528":52623,"_5":14794,"_28279":52446,"_3062":52624},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3607":597,"_31098":542,"_21528":52626,"_5":14794,"_28279":52446,"_3062":52627},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3607":598,"_31098":542,"_21528":52629,"_5":14794,"_28279":52450,"_3062":52630},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3607":599,"_31098":542,"_21528":52632,"_5":14794,"_28279":52450,"_3062":52633},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3607":600,"_31098":542,"_21528":52635,"_5":14794,"_28279":52450,"_3062":52636},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3607":601,"_31098":542,"_21528":52638,"_5":14794,"_28279":52450,"_3062":52639},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3607":602,"_31098":542,"_21528":52641,"_5":14794,"_28279":52450,"_3062":52642},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3607":603,"_31098":542,"_21528":52644,"_5":14794,"_28279":52450,"_3062":52645},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3607":604,"_31098":542,"_21528":52647,"_5":14794,"_28279":52450,"_3062":52648},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3607":605,"_31098":542,"_21528":52650,"_5":14794,"_28279":52450,"_3062":52651},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3607":606,"_31098":542,"_21528":52653,"_5":14794,"_28279":52450,"_3062":52654},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3607":607,"_31098":542,"_21528":52656,"_5":14794,"_28279":52450,"_3062":52657},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3607":608,"_31098":542,"_21528":52659,"_5":14794,"_28279":52454,"_3062":52660},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3607":609,"_31098":542,"_21528":52662,"_5":14794,"_28279":52454,"_3062":52663},[],"The decision is made with the domain operation context:",{"_3607":610,"_31098":542,"_21528":52665,"_5":14794,"_28279":52454,"_3062":52666},[],"The middleware extracts the credential and resolves the matching principals.",{"_3607":611,"_31098":542,"_21528":52668,"_5":14794,"_28279":52454,"_3062":52669},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3607":612,"_31098":542,"_21528":52671,"_5":14794,"_28279":52454,"_3062":52672},[],"`authz` gathers the entity rules of the granted policies.",{"_3607":613,"_31098":542,"_21528":52674,"_5":14794,"_28279":52454,"_3062":52675},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3607":614,"_31098":542,"_21528":52677,"_5":14794,"_28279":52454,"_3062":52678},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3607":615,"_31098":542,"_21528":52680,"_5":14794,"_28279":52454,"_3062":52681},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3607":616,"_31098":542,"_21528":52683,"_5":14794,"_28279":52454,"_3062":52684},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3607":617,"_31098":542,"_21528":52686,"_5":14794,"_28279":52454,"_3062":52687},[],"Actions fall into two groups:",{"_3607":618,"_31098":542,"_21528":52689,"_5":14794,"_28279":52454,"_3062":52690},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3607":619,"_31098":542,"_21528":52692,"_5":14794,"_28279":52454,"_3062":52693},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3607":620,"_31098":542,"_21528":52695,"_5":14794,"_28279":52454,"_3062":52696},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3607":621,"_31098":542,"_21528":52698,"_5":14794,"_28279":52458,"_3062":52699},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3607":622,"_31098":542,"_21528":52701,"_5":14794,"_28279":52458,"_3062":52702},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3607":623,"_31098":542,"_21528":52704,"_5":14794,"_28279":52458,"_3062":52705},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3607":624,"_31098":542,"_21528":52707,"_5":14794,"_28279":52462,"_3062":52708},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3607":625,"_31098":542,"_21528":52710,"_5":14794,"_28279":52462,"_3062":52711},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3607":626,"_31098":542,"_21528":52713,"_5":14794,"_28279":52462,"_3062":52714},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3607":627,"_31098":542,"_21528":52716,"_5":14794,"_28279":52462,"_3062":52717},[],"The implemented operators are:",{"_3607":628,"_31098":542,"_21528":52719,"_5":14794,"_28279":52462,"_3062":52720},[],"`equals`, for exact equality;",{"_3607":629,"_31098":542,"_21528":52722,"_5":14794,"_28279":52462,"_3062":52723},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3607":630,"_31098":542,"_21528":52725,"_5":14794,"_28279":52462,"_3062":52726},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3607":631,"_31098":542,"_21528":52728,"_5":14794,"_28279":52462,"_3062":52729},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3607":632,"_31098":542,"_21528":52731,"_5":14794,"_28279":52466,"_3062":52732},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3607":633,"_31098":542,"_21528":52734,"_5":14794,"_28279":52466,"_3062":52735},[],"The available modes are:",{"_3607":634,"_31098":542,"_21528":52737,"_5":14794,"_28279":52466,"_3062":52738},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3607":635,"_31098":542,"_21528":52740,"_5":14794,"_28279":52466,"_3062":52741},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3607":636,"_31098":542,"_21528":52743,"_5":14794,"_28279":52466,"_3062":52744},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3607":637,"_31098":542,"_21528":52746,"_5":14794,"_28279":52466,"_3062":52747},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3607":638,"_31098":542,"_21528":52749,"_5":14794,"_28279":52466,"_3062":52750},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3607":639,"_31098":542,"_21528":52752,"_5":14794,"_28279":52466,"_3062":52753},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3607":640,"_31098":542,"_21528":52755,"_5":14794,"_28279":52470,"_3062":52756},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3607":641,"_31098":542,"_21528":52758,"_5":14794,"_28279":52470,"_3062":52759},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3607":642,"_31098":542,"_21528":52761,"_5":14794,"_28279":52470,"_3062":52762},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3607":643,"_31098":542,"_21528":52764,"_5":14794,"_28279":52470,"_3062":52765},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3607":644,"_31098":542,"_21528":52767,"_5":14794,"_28279":52478,"_3062":52768},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3607":645,"_31098":542,"_21528":52770,"_5":14794,"_28279":52478,"_3062":52771},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3607":646,"_31098":542,"_21528":52773,"_5":14794,"_28279":52482,"_3062":52774},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3607":647,"_31098":542,"_21528":52776,"_5":14794,"_28279":52482,"_3062":52777},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3607":648,"_31098":542,"_21528":52779,"_5":14794,"_28279":52482,"_3062":52780},[],"The data model shows how the resources used in entity rules are connected.",{"_3607":649,"_31098":542,"_21528":52782,"_5":14794,"_28279":52482,"_3062":52783},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3607":650,"_31098":542,"_21528":52785,"_5":14794,"_28279":52482,"_3062":52786},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3607":651,"_31098":542,"_21528":52788,"_5":14794,"_28279":52486,"_3062":52789},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3607":652,"_31098":542,"_21528":52791,"_5":14794,"_28279":52486,"_3062":52792},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3607":653,"_31098":542,"_21528":52794,"_5":14794,"_28279":52486,"_3062":52795},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3607":654,"_31098":542,"_21528":52797,"_5":14794,"_28279":52490,"_3062":52798},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3607":655,"_31098":542,"_21528":52800,"_5":14794,"_28279":52490,"_3062":52801},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3607":656,"_31098":542,"_21528":52803,"_5":14794,"_28279":52490,"_3062":52804},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3607":657,"_31098":542,"_21528":52806,"_5":14794,"_28279":52490,"_3062":52807},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3607":658,"_31098":542,"_21528":52809,"_5":14794,"_28279":52490,"_3062":52810},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3607":659,"_31098":542,"_21528":52812,"_5":14794,"_28279":52490,"_3062":52813},[],"Note that:",{"_3607":660,"_31098":542,"_21528":52815,"_5":14794,"_28279":52490,"_3062":52816},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3607":661,"_31098":542,"_21528":52818,"_5":14794,"_28279":52490,"_3062":52819},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3607":662,"_31098":542,"_21528":52821,"_5":14794,"_28279":52490,"_3062":52822},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3607":663,"_31098":542,"_21528":52824,"_5":14794,"_28279":52494,"_3062":52825},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3607":664,"_31098":542,"_21528":52827,"_5":14794,"_28279":52494,"_3062":52828},[],"full and read-only access to certificates and authorities;",{"_3607":665,"_31098":542,"_21528":52830,"_5":14794,"_28279":52494,"_3062":52831},[],"full and read-only access to the KMS;",{"_3607":666,"_31098":542,"_21528":52833,"_5":14794,"_28279":52494,"_3062":52834},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3607":667,"_31098":542,"_21528":52836,"_5":14794,"_28279":52494,"_3062":52837},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3607":668,"_31098":542,"_21528":52839,"_5":14794,"_28279":52494,"_3062":52840},[],"console access;",{"_3607":669,"_31098":542,"_21528":52842,"_5":14794,"_28279":52494,"_3062":52843},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3607":670,"_31098":542,"_21528":52845,"_5":14794,"_28279":52494,"_3062":52846},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3607":671,"_31098":542,"_21528":52848,"_5":14794,"_28279":52494,"_3062":52849},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3607":672,"_31098":542,"_21528":52851,"_5":14794,"_28279":52494,"_3062":52852},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3607":673,"_31098":542,"_21528":52854,"_5":14794,"_28279":52494,"_3062":52855},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3607":674,"_31098":542,"_21528":52857,"_5":14794,"_28279":52498,"_3062":52858},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3607":675,"_31098":542,"_21528":52860,"_5":14794,"_28279":52498,"_3062":52861},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3607":676,"_31098":542,"_21528":52863,"_5":14794,"_28279":52498,"_3062":52864},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3607":677,"_31098":542,"_21528":52866,"_5":14794,"_28279":52501,"_3062":52867},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3607":678,"_31098":542,"_21528":52869,"_5":14794,"_28279":52505,"_3062":52870},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3607":679,"_31098":542,"_21528":52872,"_5":14794,"_28279":52505,"_3062":52873},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3607":680,"_31098":542,"_21528":52875,"_5":14794,"_28279":52509,"_3062":52876},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3607":681,"_31098":542,"_21528":52878,"_5":14794,"_28279":52513,"_3062":52879},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3607":682,"_31098":542,"_21528":52881,"_5":14794,"_28279":52517,"_3062":52882},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3607":683,"_31098":542,"_21528":52884,"_5":14794,"_28279":52521,"_3062":52885},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3607":684,"_31098":542,"_21528":52887,"_5":14794,"_28279":52521,"_3062":52888},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3607":685,"_31098":542,"_21528":52890,"_5":14794,"_28279":52525,"_3062":52891},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3607":686,"_31098":542,"_21528":52893,"_5":14794,"_28279":52525,"_3062":52894},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3607":687,"_31098":542,"_21528":52896,"_5":14794,"_28279":52525,"_3062":52897},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3607":688,"_31098":542,"_21528":52899,"_5":14794,"_28279":52525,"_3062":52900},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3607":689,"_31098":542,"_21528":52902,"_5":14794,"_28279":52525,"_3062":52903},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3607":690,"_31098":542,"_21528":52905,"_5":14794,"_28279":52525,"_3062":52906},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3607":691,"_31098":542,"_21528":52908,"_5":14794,"_28279":52525,"_3062":52909},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3607":692,"_31098":542,"_21528":52911,"_5":14794,"_28279":52525,"_3062":52912},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3607":693,"_31098":542,"_21528":52914,"_5":14794,"_28279":52529,"_3062":52915},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3607":694,"_31098":542,"_21528":52917,"_5":14794,"_28279":52529,"_3062":52918},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3607":695,"_31098":542,"_21528":52920,"_5":14794,"_28279":52529,"_3062":52921},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3607":696,"_31098":542,"_21528":52923,"_5":14794,"_28279":52533,"_3062":52924},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3607":697,"_31098":542,"_21528":52926,"_5":14794,"_28279":52533,"_3062":52927},[],"Use groups or stable roles for people and independent identities for automations.",{"_3607":698,"_31098":542,"_21528":52929,"_5":14794,"_28279":52533,"_3062":52930},[],"Keep at least two recovery administrators and test their access periodically.",{"_3607":699,"_31098":542,"_21528":52932,"_5":14794,"_28279":52533,"_3062":52933},[],"Review active principals, their matches and their grants after IdP changes.",{"_3607":700,"_31098":542,"_21528":52935,"_5":14794,"_28279":52533,"_3062":52936},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3607":701,"_31098":542,"_21528":52938,"_5":14794,"_28279":52533,"_3062":52939},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3607":702,"_31098":542,"_21528":52941,"_5":14794,"_28279":52533,"_3062":52942},[],"Always test one allowed and one denied operation for each role.",{"_3607":703,"_31098":542,"_21528":52944,"_5":14794,"_28279":52533,"_3062":52945},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3607":704,"_31098":542,"_21528":52947,"_5":14794,"_28279":52541,"_3062":52948},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3607":705,"_31098":542,"_21528":52950,"_5":14794,"_28279":52545,"_3062":52951},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3607":706,"_31098":542,"_21528":52953,"_5":14794,"_28279":52545,"_3062":52954},[],"that an active principal of the correct type exists;",{"_3607":707,"_31098":542,"_21528":52956,"_5":14794,"_28279":52545,"_3062":52957},[],"that the claim paths and values match the real token exactly;",{"_3607":708,"_31098":542,"_21528":52959,"_5":14794,"_28279":52545,"_3062":52960},[],"that all of the principal's conditions hold;",{"_3607":709,"_31098":542,"_21528":52962,"_5":14794,"_28279":52545,"_3062":52963},[],"that the principal has the expected policy granted;",{"_3607":710,"_31098":542,"_21528":52965,"_5":14794,"_28279":52545,"_3062":52966},[],"that the policy includes the action and the requested resource type or route;",{"_3607":711,"_31098":542,"_21528":52968,"_5":14794,"_28279":52545,"_3062":52969},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3607":712,"_31098":542,"_21528":52971,"_5":14794,"_28279":52545,"_3062":52972},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3607":713,"_31098":542,"_21528":52974,"_5":14794,"_28279":52545,"_3062":52975},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3607":714,"_31098":542,"_21528":52977,"_5":14794,"_28279":52549,"_3062":52978},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3607":715,"_31098":542,"_21528":52980,"_5":14794,"_28279":52553,"_3062":52981},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3607":716,"_31098":542,"_21528":52983,"_5":14794,"_28279":52557,"_3062":52984},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3607":717,"_31098":542,"_21528":52986,"_5":14794,"_28279":52557,"_3062":52987},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3607":718,"_31098":718,"_5":15159,"_3062":52989,"_31457":52990,"_21528":52991,"_28279":718},"Alerts and subscriptions",[50787,52299,52300],[],{"_3607":719,"_31098":718,"_21528":52993,"_5":14794,"_28279":718,"_3062":52994},[],"Send PKI events to people and external systems.",{"_3607":720,"_31098":718,"_5":31454,"_21528":52996,"_28279":52997,"_3062":52998},[],"/docs/pr-preview/pr-75/platform/administration/alerts#how-it-works","How it works",{"_3607":721,"_31098":718,"_5":31454,"_21528":53000,"_28279":53001,"_3062":53002},[],"/docs/pr-preview/pr-75/platform/administration/alerts#available-channels","Available channels",{"_3607":722,"_31098":718,"_5":31454,"_21528":53004,"_28279":53005,"_3062":53006},[],"/docs/pr-preview/pr-75/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3607":723,"_31098":718,"_5":31454,"_21528":53008,"_28279":53009,"_3062":53010},[],"/docs/pr-preview/pr-75/platform/administration/alerts#choose-the-event","Choose the event",{"_3607":724,"_31098":718,"_5":31454,"_21528":53012,"_28279":53013,"_3062":53014},[],"/docs/pr-preview/pr-75/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3607":725,"_31098":718,"_5":31454,"_21528":53016,"_28279":53017,"_3062":53018},[],"/docs/pr-preview/pr-75/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3607":726,"_31098":718,"_5":31454,"_21528":53020,"_28279":53021,"_3062":53022},[],"/docs/pr-preview/pr-75/platform/administration/alerts#review-and-activate","Review and activate",{"_3607":727,"_31098":718,"_5":31454,"_21528":53024,"_28279":53025,"_3062":53026},[],"/docs/pr-preview/pr-75/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3607":728,"_31098":718,"_5":31454,"_21528":53028,"_28279":53029,"_3062":53030},[],"/docs/pr-preview/pr-75/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3607":729,"_31098":718,"_5":31454,"_21528":53032,"_28279":53033,"_3062":53034},[],"/docs/pr-preview/pr-75/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3607":730,"_31098":718,"_5":31454,"_21528":53036,"_28279":53037,"_3062":53038},[],"/docs/pr-preview/pr-75/platform/administration/alerts#event-families","Event families",{"_3607":731,"_31098":718,"_21528":53040,"_5":14794,"_28279":718,"_3062":53041},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3607":732,"_31098":718,"_21528":53043,"_5":14794,"_28279":52997,"_3062":53044},[],"A service publishes a domain event.",{"_3607":733,"_31098":718,"_21528":53046,"_5":14794,"_28279":52997,"_3062":53047},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3607":734,"_31098":718,"_21528":53049,"_5":14794,"_28279":52997,"_3062":53050},[],"Each subscription's filter decides whether it should be notified.",{"_3607":735,"_31098":718,"_21528":53052,"_5":14794,"_28279":52997,"_3062":53053},[],"Lamassu delivers the event to the configured channel.",{"_3607":736,"_31098":718,"_21528":53055,"_5":14794,"_28279":52997,"_3062":53056},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3607":737,"_31098":718,"_21528":53058,"_5":14794,"_28279":53001,"_3062":53059},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3607":738,"_31098":718,"_21528":53061,"_5":14794,"_28279":53001,"_3062":53062},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3607":739,"_31098":718,"_21528":53064,"_5":14794,"_28279":53001,"_3062":53065},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3607":740,"_31098":718,"_21528":53067,"_5":14794,"_28279":53001,"_3062":53068},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3607":741,"_31098":718,"_21528":53070,"_5":14794,"_28279":53001,"_3062":53071},[],"`apikey_options` requires `header` and `key`.",{"_3607":742,"_31098":718,"_21528":53073,"_5":14794,"_28279":53001,"_3062":53074},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3607":743,"_31098":718,"_21528":53076,"_5":14794,"_28279":53001,"_3062":53077},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3607":744,"_31098":718,"_21528":53079,"_5":14794,"_28279":53001,"_3062":53080},[],"The alerts API reference documents the full `http_client` schema.",{"_3607":745,"_31098":718,"_21528":53082,"_5":14794,"_28279":53009,"_3062":53083},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3607":746,"_31098":718,"_21528":53085,"_5":14794,"_28279":53013,"_3062":53086},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3607":747,"_31098":718,"_21528":53088,"_5":14794,"_28279":53017,"_3062":53089},[],"Add a filter if you don't want to receive every instance of the event.",{"_3607":748,"_31098":718,"_21528":53091,"_5":14794,"_28279":53017,"_3062":53092},[],"**None** notifies all instances of the event.",{"_3607":749,"_31098":718,"_21528":53094,"_5":14794,"_28279":53017,"_3062":53095},[],"**JSON Path** evaluates one or more specific fields.",{"_3607":750,"_31098":718,"_21528":53097,"_5":14794,"_28279":53017,"_3062":53098},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3607":751,"_31098":718,"_21528":53100,"_5":14794,"_28279":53017,"_3062":53101},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3607":752,"_31098":718,"_21528":53103,"_5":14794,"_28279":53017,"_3062":53104},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3607":753,"_31098":718,"_21528":53106,"_5":14794,"_28279":53017,"_3062":53107},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3607":754,"_31098":718,"_21528":53109,"_5":14794,"_28279":53021,"_3062":53110},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3607":755,"_31098":718,"_21528":53112,"_5":14794,"_28279":53025,"_3062":53113},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3607":756,"_31098":718,"_21528":53115,"_5":14794,"_28279":53025,"_3062":53116},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3607":757,"_31098":718,"_21528":53118,"_5":14794,"_28279":53025,"_3062":53119},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3607":758,"_31098":718,"_21528":53121,"_5":14794,"_28279":53025,"_3062":53122},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3607":759,"_31098":718,"_21528":53124,"_5":14794,"_28279":53025,"_3062":53125},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3607":760,"_31098":718,"_21528":53127,"_5":14794,"_28279":53025,"_3062":53128},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3607":761,"_31098":718,"_21528":53130,"_5":14794,"_28279":53025,"_3062":53131},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3607":762,"_31098":718,"_21528":53133,"_5":14794,"_28279":53025,"_3062":53134},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3607":763,"_31098":718,"_21528":53136,"_5":14794,"_28279":53029,"_3062":53137},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3607":764,"_31098":718,"_21528":53139,"_5":14794,"_28279":53029,"_3062":53140},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3607":765,"_31098":718,"_21528":53142,"_5":14794,"_28279":53029,"_3062":53143},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3607":766,"_31098":718,"_21528":53145,"_5":14794,"_28279":53029,"_3062":53146},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3607":767,"_31098":718,"_21528":53148,"_5":14794,"_28279":53029,"_3062":53149},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3607":768,"_31098":718,"_21528":53151,"_5":14794,"_28279":53029,"_3062":53152},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3607":769,"_31098":718,"_21528":53154,"_5":14794,"_28279":53029,"_3062":53155},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3607":770,"_31098":718,"_21528":53157,"_5":14794,"_28279":53029,"_3062":53158},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3607":771,"_31098":718,"_21528":53160,"_5":14794,"_28279":53033,"_3062":53161},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3607":772,"_31098":718,"_21528":53163,"_5":14794,"_28279":53033,"_3062":53164},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3607":773,"_31098":718,"_21528":53166,"_5":14794,"_28279":53037,"_3062":53167},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3607":774,"_31098":718,"_21528":53169,"_5":14794,"_28279":53037,"_3062":53170},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3607":775,"_31098":718,"_21528":53172,"_5":14794,"_28279":53037,"_3062":53173},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3607":776,"_31098":718,"_21528":53175,"_5":14794,"_28279":53037,"_3062":53176},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3607":777,"_31098":718,"_21528":53178,"_5":14794,"_28279":53037,"_3062":53179},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3607":778,"_31098":718,"_21528":53181,"_5":14794,"_28279":53037,"_3062":53182},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3607":779,"_31098":718,"_21528":53184,"_5":14794,"_28279":53037,"_3062":53185},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3607":780,"_31098":718,"_21528":53187,"_5":14794,"_28279":53037,"_3062":53188},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3607":781,"_31098":718,"_21528":53190,"_5":14794,"_28279":53037,"_3062":53191},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3607":782,"_31098":718,"_21528":53193,"_5":14794,"_28279":53037,"_3062":53194},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3607":783,"_31098":783,"_5":15159,"_3062":53196,"_31457":53197,"_21528":53198,"_28279":783},"Audit logs",[50787,52299,52300],[],{"_3607":784,"_31098":783,"_21528":53200,"_5":14794,"_28279":783,"_3062":53201},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3607":785,"_31098":783,"_5":31454,"_21528":53203,"_28279":53204,"_3062":53205},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3607":786,"_31098":783,"_5":31454,"_21528":53207,"_28279":53208,"_3062":53209},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#coverage","Coverage",{"_3607":787,"_31098":783,"_5":31454,"_21528":53211,"_28279":53212,"_3062":53213},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3607":788,"_31098":783,"_5":31454,"_21528":53215,"_28279":53216,"_3062":53217},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3607":789,"_31098":783,"_5":31454,"_21528":53219,"_28279":53220,"_3062":53221},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3607":790,"_31098":783,"_5":31454,"_21528":53223,"_28279":53224,"_3062":53225},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3607":791,"_31098":783,"_5":31454,"_21528":53227,"_28279":53228,"_3062":53229},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3607":792,"_31098":783,"_5":31454,"_21528":53231,"_28279":53232,"_3062":53233},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3607":793,"_31098":783,"_5":31454,"_21528":53235,"_28279":53236,"_3062":53237},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3607":794,"_31098":783,"_5":31454,"_21528":53239,"_28279":53240,"_3062":53241},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3607":795,"_31098":783,"_5":31454,"_21528":53243,"_28279":53244,"_3062":53245},[],"/docs/pr-preview/pr-75/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3607":796,"_31098":783,"_21528":53247,"_5":14794,"_28279":783,"_3062":53248},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3607":797,"_31098":783,"_21528":53250,"_5":14794,"_28279":53204,"_3062":53251},[],"The audit body includes:",{"_3607":798,"_31098":783,"_21528":53253,"_5":14794,"_28279":53204,"_3062":53254},[],"input: data received by the operation;",{"_3607":799,"_31098":783,"_21528":53256,"_5":14794,"_28279":53204,"_3062":53257},[],"has\\_error: whether the service returned an error;",{"_3607":800,"_31098":783,"_21528":53259,"_5":14794,"_28279":53204,"_3062":53260},[],"output: produced result or error message;",{"_3607":801,"_31098":783,"_21528":53262,"_5":14794,"_28279":53204,"_3062":53263},[],"principals: identifiers of the principals that matched the request.",{"_3607":802,"_31098":783,"_21528":53265,"_5":14794,"_28279":53204,"_3062":53266},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3607":803,"_31098":783,"_21528":53268,"_5":14794,"_28279":53204,"_3062":53269},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3607":804,"_31098":783,"_21528":53271,"_5":14794,"_28279":53208,"_3062":53272},[],"The backend applies auditing to mutations of:",{"_3607":805,"_31098":783,"_21528":53274,"_5":14794,"_28279":53208,"_3062":53275},[],"authorities, certificates and issuance profiles;",{"_3607":806,"_31098":783,"_21528":53277,"_5":14794,"_28279":53208,"_3062":53278},[],"keys and KMS engines;",{"_3607":807,"_31098":783,"_21528":53280,"_5":14794,"_28279":53208,"_3062":53281},[],"devices and identities;",{"_3607":808,"_31098":783,"_21528":53283,"_5":14794,"_28279":53208,"_3062":53284},[],"DMSs and enrollment operations;",{"_3607":809,"_31098":783,"_21528":53286,"_5":14794,"_28279":53208,"_3062":53287},[],"validation functions and CRL;",{"_3607":810,"_31098":783,"_21528":53289,"_5":14794,"_28279":53208,"_3062":53290},[],"principals, policies and authorization grants.",{"_3607":811,"_31098":783,"_21528":53292,"_5":14794,"_28279":53208,"_3062":53293},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3607":812,"_31098":783,"_21528":53295,"_5":14794,"_28279":53212,"_3062":53296},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3607":813,"_31098":783,"_21528":53298,"_5":14794,"_28279":53212,"_3062":53299},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3607":814,"_31098":783,"_21528":53301,"_5":14794,"_28279":53212,"_3062":53302},[],"Design the consumer to:",{"_3607":815,"_31098":783,"_21528":53304,"_5":14794,"_28279":53212,"_3062":53305},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3607":816,"_31098":783,"_21528":53307,"_5":14794,"_28279":53212,"_3062":53308},[],"keep the complete CloudEvent unmodified;",{"_3607":817,"_31098":783,"_21528":53310,"_5":14794,"_28279":53212,"_3062":53311},[],"record the ingestion time and detect duplicates by ID;",{"_3607":818,"_31098":783,"_21528":53313,"_5":14794,"_28279":53212,"_3062":53314},[],"encrypt in transit and at rest;",{"_3607":819,"_31098":783,"_21528":53316,"_5":14794,"_28279":53212,"_3062":53317},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3607":820,"_31098":783,"_21528":53319,"_5":14794,"_28279":53212,"_3062":53320},[],"apply an explicit retention and legal hold policy;",{"_3607":821,"_31098":783,"_21528":53322,"_5":14794,"_28279":53212,"_3062":53323},[],"alert if it stops consuming or the pending queue grows.",{"_3607":822,"_31098":783,"_21528":53325,"_5":14794,"_28279":53216,"_3062":53326},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3607":823,"_31098":783,"_21528":53328,"_5":14794,"_28279":53216,"_3062":53329},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3607":824,"_31098":783,"_21528":53331,"_5":14794,"_28279":53224,"_3062":53332},[],"Start from the reported time and normalize every source to UTC.",{"_3607":825,"_31098":783,"_21528":53334,"_5":14794,"_28279":53228,"_3062":53335},[],"Filter by event type, service source and resource identifier.",{"_3607":826,"_31098":783,"_21528":53337,"_5":14794,"_28279":53232,"_3062":53338},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3607":827,"_31098":783,"_21528":53340,"_5":14794,"_28279":53236,"_3062":53341},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3607":828,"_31098":783,"_21528":53343,"_5":14794,"_28279":53240,"_3062":53344},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3607":829,"_31098":783,"_21528":53346,"_5":14794,"_28279":53244,"_3062":53347},[],"Generate a controlled mutation in a test environment and check that:",{"_3607":830,"_31098":783,"_21528":53349,"_5":14794,"_28279":53244,"_3062":53350},[],"a successful audit event appears;",{"_3607":831,"_31098":783,"_21528":53352,"_5":14794,"_28279":53244,"_3062":53353},[],"the principal matches the identity used;",{"_3607":832,"_31098":783,"_21528":53355,"_5":14794,"_28279":53244,"_3062":53356},[],"the consumer persists it exactly once;",{"_3607":833,"_31098":783,"_21528":53358,"_5":14794,"_28279":53244,"_3062":53359},[],"it can be retrieved by resource, actor and period;",{"_3607":834,"_31098":783,"_21528":53361,"_5":14794,"_28279":53244,"_3062":53362},[],"a consumer outage raises an alert.",{"_3607":835,"_31098":783,"_21528":53364,"_5":14794,"_28279":53244,"_3062":53365},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3607":836,"_31098":836,"_5":15159,"_3062":53367,"_31457":53368,"_21528":53369,"_28279":836},"Platform architecture",[50787,52299],[],{"_3607":837,"_31098":836,"_21528":53371,"_5":14794,"_28279":836,"_3062":53372},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3607":838,"_31098":836,"_5":31454,"_21528":53374,"_28279":53375,"_3062":53376},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#control-plane","Control plane",{"_3607":839,"_31098":836,"_5":31454,"_21528":53378,"_28279":53379,"_3062":53380},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3607":840,"_31098":836,"_5":31454,"_21528":53382,"_28279":53383,"_3062":53384},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3607":841,"_31098":836,"_5":31454,"_21528":53386,"_28279":53387,"_3062":53388},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#status-and-validation","Status and validation",{"_3607":842,"_31098":836,"_5":31454,"_21528":53390,"_28279":53391,"_3062":53392},[],"/docs/pr-preview/pr-75/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3607":843,"_31098":836,"_21528":53394,"_5":14794,"_28279":836,"_3062":53395},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3607":844,"_31098":836,"_21528":53397,"_5":14794,"_28279":836,"_3062":53398},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3607":845,"_31098":836,"_21528":53400,"_5":14794,"_28279":53375,"_3062":53401},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3607":846,"_31098":836,"_21528":53403,"_5":14794,"_28279":53379,"_3062":53404},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3607":847,"_31098":836,"_21528":53406,"_5":14794,"_28279":53383,"_3062":53407},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3607":848,"_31098":836,"_21528":53409,"_5":14794,"_28279":53387,"_3062":53410},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3607":849,"_31098":836,"_21528":53412,"_5":14794,"_28279":53391,"_3062":53413},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3607":850,"_31098":850,"_5":15159,"_3062":53415,"_31457":53416,"_21528":53417,"_28279":850},"How Lamassu works",[50787,52299],[],{"_3607":851,"_31098":850,"_21528":53419,"_5":14794,"_28279":850,"_3062":53420},[],"The mental model of trust, keys, certificates and devices.",{"_3607":852,"_31098":850,"_5":31454,"_21528":53422,"_28279":53423,"_3062":53424},[],"/docs/pr-preview/pr-75/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3607":853,"_31098":850,"_5":31454,"_21528":53426,"_28279":53427,"_3062":53428},[],"/docs/pr-preview/pr-75/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3607":854,"_31098":850,"_21528":53430,"_5":14794,"_28279":850,"_3062":53431},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3607":855,"_31098":850,"_21528":53433,"_5":14794,"_28279":53423,"_3062":53434},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3607":856,"_31098":850,"_21528":53436,"_5":14794,"_28279":53423,"_3062":53437},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3607":857,"_31098":850,"_21528":53439,"_5":14794,"_28279":53423,"_3062":53440},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3607":858,"_31098":850,"_21528":53442,"_5":14794,"_28279":53423,"_3062":53443},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3607":859,"_31098":850,"_21528":53445,"_5":14794,"_28279":53423,"_3062":53446},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3607":860,"_31098":850,"_21528":53448,"_5":14794,"_28279":53427,"_3062":53449},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3607":861,"_31098":850,"_21528":53451,"_5":14794,"_28279":53427,"_3062":53452},[],"A DMS relates that CA to an enrollment policy.",{"_3607":862,"_31098":850,"_21528":53454,"_5":14794,"_28279":53427,"_3062":53455},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3607":863,"_31098":850,"_21528":53457,"_5":14794,"_28279":53427,"_3062":53458},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3607":864,"_31098":850,"_21528":53460,"_5":14794,"_28279":53427,"_3062":53461},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3607":865,"_31098":850,"_21528":53463,"_5":14794,"_28279":53427,"_3062":53464},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3607":866,"_31098":850,"_21528":53466,"_5":14794,"_28279":53427,"_3062":53467},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3607":867,"_31098":867,"_5":15159,"_3062":53469,"_31457":53470,"_21528":53472,"_28279":867},"Devices and identities",[50787,52299,53471,53469],"IoT Fleets",[],{"_3607":868,"_31098":867,"_21528":53474,"_5":14794,"_28279":867,"_3062":53475},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3607":869,"_31098":867,"_5":31454,"_21528":53477,"_28279":53478,"_3062":53479},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#device-states","Device states",{"_3607":870,"_31098":867,"_5":31454,"_21528":53481,"_28279":53482,"_3062":53483},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3607":871,"_31098":867,"_5":31454,"_21528":53485,"_28279":53486,"_3062":53487},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3607":872,"_31098":867,"_5":31454,"_21528":53489,"_28279":53490,"_3062":53491},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3607":873,"_31098":867,"_5":31454,"_21528":53493,"_28279":53494,"_3062":53495},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3607":874,"_31098":867,"_5":31454,"_21528":53497,"_28279":53498,"_3062":53499},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3607":875,"_31098":867,"_5":31454,"_21528":53501,"_28279":53502,"_3062":53503},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3607":876,"_31098":867,"_5":31454,"_21528":53505,"_28279":53506,"_3062":53507},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3607":877,"_31098":867,"_5":31454,"_21528":53509,"_28279":53510,"_3062":53511},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3607":878,"_31098":867,"_5":31454,"_21528":53513,"_28279":53514,"_3062":53515},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3607":879,"_31098":867,"_5":31454,"_21528":53517,"_28279":53518,"_3062":53519},[],"/docs/pr-preview/pr-75/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3607":880,"_31098":867,"_21528":53521,"_5":14794,"_28279":867,"_3062":53522},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3607":881,"_31098":867,"_21528":53524,"_5":14794,"_28279":867,"_3062":53525},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3607":882,"_31098":867,"_21528":53527,"_5":14794,"_28279":53478,"_3062":53528},[],"Operational view",{"_3607":883,"_31098":867,"_21528":53530,"_5":14794,"_28279":53478,"_3062":53531},[],"Meaning",{"_3607":884,"_31098":867,"_21528":53533,"_5":14794,"_28279":53478,"_3062":53534},[],"**No Identity**",{"_3607":885,"_31098":867,"_21528":53536,"_5":14794,"_28279":53478,"_3062":53537},[],"A record exists without an associated identity.",{"_3607":886,"_31098":867,"_21528":53539,"_5":14794,"_28279":53478,"_3062":53540},[],"**Active**",{"_3607":887,"_31098":867,"_21528":53542,"_5":14794,"_28279":53478,"_3062":53543},[],"The slot is active; also check certificate dates, status and usages.",{"_3607":888,"_31098":867,"_21528":53545,"_5":14794,"_28279":53478,"_3062":53546},[],"**Renewal Pending**",{"_3607":889,"_31098":867,"_21528":53548,"_5":14794,"_28279":53478,"_3062":53549},[],"The identity is in the operational renewal window.",{"_3607":890,"_31098":867,"_21528":53551,"_5":14794,"_28279":53478,"_3062":53552},[],"**Expiring Soon**",{"_3607":891,"_31098":867,"_21528":53554,"_5":14794,"_28279":53478,"_3062":53555},[],"Expiration is approaching according to configured thresholds.",{"_3607":892,"_31098":867,"_21528":53557,"_5":14794,"_28279":53478,"_3062":53558},[],"**Expired**",{"_3607":893,"_31098":867,"_21528":53560,"_5":14794,"_28279":53478,"_3062":53561},[],"The identity has expired.",{"_3607":894,"_31098":867,"_21528":53563,"_5":14794,"_28279":53478,"_3062":53564},[],"**Revoked**",{"_3607":895,"_31098":867,"_21528":53566,"_5":14794,"_28279":53478,"_3062":53567},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3607":896,"_31098":867,"_21528":53569,"_5":14794,"_28279":53478,"_3062":53570},[],"**Decommissioned**",{"_3607":897,"_31098":867,"_21528":53572,"_5":14794,"_28279":53478,"_3062":53573},[],"The record is retired and ordinary updates do not restore operation.",{"_3607":898,"_31098":867,"_21528":53575,"_5":14794,"_28279":53478,"_3062":53576},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3607":899,"_31098":867,"_21528":53578,"_5":14794,"_28279":53482,"_3062":53579},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3607":900,"_31098":867,"_21528":53581,"_5":14794,"_28279":53482,"_3062":53582},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3607":901,"_31098":867,"_21528":53584,"_5":14794,"_28279":53482,"_3062":53585},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3607":902,"_31098":867,"_21528":53587,"_5":14794,"_28279":53482,"_3062":53588},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3607":903,"_31098":867,"_21528":53590,"_5":14794,"_28279":53486,"_3062":53591},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3607":904,"_31098":867,"_21528":53593,"_5":14794,"_28279":53490,"_3062":53594},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3607":905,"_31098":867,"_21528":53596,"_5":14794,"_28279":53494,"_3062":53597},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3607":906,"_31098":867,"_21528":53599,"_5":14794,"_28279":53498,"_3062":53600},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3607":907,"_31098":867,"_21528":53602,"_5":14794,"_28279":53502,"_3062":53603},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3607":908,"_31098":867,"_21528":53605,"_5":14794,"_28279":53502,"_3062":53606},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3607":909,"_31098":867,"_21528":53608,"_5":14794,"_28279":53506,"_3062":53609},[],"From **No Identity**, use **Assign Identity**:",{"_3607":910,"_31098":867,"_21528":53611,"_5":14794,"_28279":53506,"_3062":53612},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3607":911,"_31098":867,"_21528":53614,"_5":14794,"_28279":53506,"_3062":53615},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3607":912,"_31098":867,"_21528":53617,"_5":14794,"_28279":53506,"_3062":53618},[],"Confirm and read the serial, active version and history again.",{"_3607":913,"_31098":867,"_21528":53620,"_5":14794,"_28279":53506,"_3062":53621},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3607":914,"_31098":867,"_21528":53623,"_5":14794,"_28279":53506,"_3062":53624},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3607":915,"_31098":867,"_21528":53626,"_5":14794,"_28279":53510,"_3062":53627},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3607":916,"_31098":867,"_21528":53629,"_5":14794,"_28279":53510,"_3062":53630},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3607":917,"_31098":867,"_21528":53632,"_5":14794,"_28279":53510,"_3062":53633},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3607":918,"_31098":867,"_21528":53635,"_5":14794,"_28279":53514,"_3062":53636},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3607":919,"_31098":867,"_21528":53638,"_5":14794,"_28279":53514,"_3062":53639},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3607":920,"_31098":867,"_21528":53641,"_5":14794,"_28279":53514,"_3062":53642},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3607":921,"_31098":867,"_21528":53644,"_5":14794,"_28279":53514,"_3062":53645},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3607":922,"_31098":867,"_21528":53647,"_5":14794,"_28279":53518,"_3062":53648},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3607":923,"_31098":867,"_21528":53650,"_5":14794,"_28279":53518,"_3062":53651},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3607":924,"_31098":924,"_5":15159,"_3062":53653,"_31457":53654,"_21528":53656,"_28279":924},"Bootstrap identity and authentication",[50787,52299,53471,53469,53655],"Enrollment with PKI",[],{"_3607":925,"_31098":924,"_21528":53658,"_5":14794,"_28279":924,"_3062":53659},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3607":926,"_31098":924,"_5":31454,"_21528":53661,"_28279":53662,"_3062":53663},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3607":927,"_31098":924,"_5":31454,"_21528":53665,"_28279":53666,"_3062":53667},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3607":928,"_31098":924,"_5":31454,"_21528":53669,"_28279":53670,"_3062":53671},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3607":929,"_31098":924,"_5":31454,"_21528":53673,"_28279":53674,"_3062":53675},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3607":930,"_31098":924,"_5":31454,"_21528":53677,"_28279":53678,"_3062":53679},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3607":931,"_31098":924,"_21528":53681,"_5":14794,"_28279":924,"_3062":53682},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3607":932,"_31098":924,"_21528":53684,"_5":14794,"_28279":53662,"_3062":53685},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3607":933,"_31098":924,"_21528":53687,"_5":14794,"_28279":53662,"_3062":53688},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3607":934,"_31098":924,"_21528":53690,"_5":14794,"_28279":53666,"_3062":53691},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3607":935,"_31098":924,"_21528":53693,"_5":14794,"_28279":53666,"_3062":53694},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3607":936,"_31098":924,"_21528":53696,"_5":14794,"_28279":53666,"_3062":53697},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3607":937,"_31098":924,"_21528":53699,"_5":14794,"_28279":53670,"_3062":53700},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3607":938,"_31098":924,"_21528":53702,"_5":14794,"_28279":53670,"_3062":53703},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3607":939,"_31098":924,"_21528":53705,"_5":14794,"_28279":53674,"_3062":53706},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3607":940,"_31098":924,"_21528":53708,"_5":14794,"_28279":53674,"_3062":53709},[],"Example body:",{"_3607":941,"_31098":924,"_21528":53711,"_5":14794,"_28279":53674,"_3062":53712},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3607":942,"_31098":924,"_21528":53714,"_5":14794,"_28279":53674,"_3062":53715},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3607":943,"_31098":924,"_21528":53717,"_5":14794,"_28279":53674,"_3062":53718},[],"Continuation requires a successful HTTP response and JSON:",{"_3607":944,"_31098":924,"_21528":53720,"_5":14794,"_28279":53674,"_3062":53721},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3607":945,"_31098":924,"_21528":53723,"_5":14794,"_28279":53678,"_3062":53724},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3607":946,"_31098":924,"_21528":53726,"_5":14794,"_28279":53678,"_3062":53727},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3607":947,"_31098":947,"_5":15159,"_3062":53729,"_31457":53730,"_21528":53731,"_28279":947},"Configure and operate the DMS",[50787,52299,53471,53469,53655],[],{"_3607":948,"_31098":947,"_21528":53733,"_5":14794,"_28279":947,"_3062":53734},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3607":949,"_31098":947,"_5":31454,"_21528":53736,"_28279":53737,"_3062":50797},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3607":950,"_31098":947,"_5":31454,"_21528":53739,"_28279":53740,"_3062":53741},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3607":951,"_31098":947,"_5":31454,"_21528":53743,"_28279":53744,"_3062":53745},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3607":952,"_31098":947,"_5":31454,"_21528":53747,"_28279":53748,"_3062":53749},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3607":953,"_31098":947,"_5":31454,"_21528":53751,"_28279":53752,"_3062":53753},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3607":954,"_31098":947,"_5":31454,"_21528":53755,"_28279":53756,"_3062":53757},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3607":955,"_31098":947,"_5":31454,"_21528":53759,"_28279":53760,"_3062":53761},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3607":956,"_31098":947,"_5":31454,"_21528":53763,"_28279":53764,"_3062":53765},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3607":957,"_31098":947,"_5":31454,"_21528":53767,"_28279":53768,"_3062":53769},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3607":958,"_31098":947,"_5":31454,"_21528":53771,"_28279":53772,"_3062":53773},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3607":959,"_31098":947,"_5":31454,"_21528":53775,"_28279":53776,"_3062":53777},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3607":960,"_31098":947,"_5":31454,"_21528":53779,"_28279":53780,"_3062":53781},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3607":961,"_31098":947,"_5":31454,"_21528":53783,"_28279":53784,"_3062":53785},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3607":962,"_31098":947,"_5":31454,"_21528":53787,"_28279":53788,"_3062":53789},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3607":963,"_31098":947,"_5":31454,"_21528":53791,"_28279":53792,"_3062":53793},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3607":964,"_31098":947,"_5":31454,"_21528":53795,"_28279":53796,"_3062":53797},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3607":965,"_31098":947,"_5":31454,"_21528":53799,"_28279":53800,"_3062":53801},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3607":966,"_31098":947,"_5":31454,"_21528":53803,"_28279":53804,"_3062":53805},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3607":967,"_31098":947,"_21528":53807,"_5":14794,"_28279":947,"_3062":53808},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3607":968,"_31098":947,"_21528":53810,"_5":14794,"_28279":53737,"_3062":53811},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3607":969,"_31098":947,"_21528":53813,"_5":14794,"_28279":53737,"_3062":53814},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3607":970,"_31098":947,"_21528":53816,"_5":14794,"_28279":53744,"_3062":53817},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3607":971,"_31098":947,"_21528":53819,"_5":14794,"_28279":53748,"_3062":53820},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3607":972,"_31098":947,"_21528":53822,"_5":14794,"_28279":53752,"_3062":53823},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3607":973,"_31098":947,"_21528":53825,"_5":14794,"_28279":53756,"_3062":53826},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3607":974,"_31098":947,"_21528":53828,"_5":14794,"_28279":53760,"_3062":53829},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3607":975,"_31098":947,"_21528":53831,"_5":14794,"_28279":53768,"_3062":53832},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3607":976,"_31098":947,"_21528":53834,"_5":14794,"_28279":53768,"_3062":53835},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3607":977,"_31098":947,"_21528":53837,"_5":14794,"_28279":53772,"_3062":53838},[],"`settings.enrollment_settings` field",{"_3607":978,"_31098":947,"_21528":53840,"_5":14794,"_28279":53772,"_3062":53841},[],"Decision",{"_3607":979,"_31098":947,"_21528":53843,"_5":14794,"_28279":53772,"_3062":53844},[],"`protocol`",{"_3607":980,"_31098":947,"_21528":53846,"_5":14794,"_28279":53772,"_3062":53847},[],"`EST_RFC7030` for these operations.",{"_3607":981,"_31098":947,"_21528":53849,"_5":14794,"_28279":53772,"_3062":53850},[],"`enrollment_ca`",{"_3607":982,"_31098":947,"_21528":53852,"_5":14794,"_28279":53772,"_3062":53853},[],"ID of the signing CA.",{"_3607":983,"_31098":947,"_21528":53855,"_5":14794,"_28279":53772,"_3062":53856},[],"`verify_csr_signature`",{"_3607":984,"_31098":947,"_21528":53858,"_5":14794,"_28279":53772,"_3062":53859},[],"Keep `true` to verify CSR key possession.",{"_3607":985,"_31098":947,"_21528":53861,"_5":14794,"_28279":53772,"_3062":53862},[],"`enable_replaceable_enrollment`",{"_3607":986,"_31098":947,"_21528":53864,"_5":14794,"_28279":53772,"_3062":53865},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3607":987,"_31098":947,"_21528":53867,"_5":14794,"_28279":53772,"_3062":53868},[],"`est_rfc7030_settings.auth_mode`",{"_3607":988,"_31098":947,"_21528":53870,"_5":14794,"_28279":53772,"_3062":53871},[],"One of the four authentication modes.",{"_3607":989,"_31098":947,"_21528":53873,"_5":14794,"_28279":53772,"_3062":53874},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3607":990,"_31098":947,"_21528":53876,"_5":14794,"_28279":53776,"_3062":53877},[],"The blocks are independent:",{"_3607":991,"_31098":947,"_21528":53879,"_5":14794,"_28279":53776,"_3062":53880},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3607":992,"_31098":947,"_21528":53882,"_5":14794,"_28279":53776,"_3062":53883},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3607":993,"_31098":947,"_21528":53885,"_5":14794,"_28279":53776,"_3062":53886},[],"`auth_mode`",{"_3607":994,"_31098":947,"_21528":53888,"_5":14794,"_28279":53776,"_3062":53889},[],"Control applied in the configured operation",{"_3607":995,"_31098":947,"_21528":53891,"_5":14794,"_28279":53776,"_3062":53892},[],"`CLIENT_CERTIFICATE`",{"_3607":996,"_31098":947,"_21528":53894,"_5":14794,"_28279":53776,"_3062":53895},[],"Presented certificate validation.",{"_3607":997,"_31098":947,"_21528":53897,"_5":14794,"_28279":53776,"_3062":53898},[],"`EXTERNAL_WEBHOOK`",{"_3607":998,"_31098":947,"_21528":53900,"_5":14794,"_28279":53776,"_3062":53901},[],"Configured webhook authorization.",{"_3607":999,"_31098":947,"_21528":53903,"_5":14794,"_28279":53776,"_3062":53904},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3607":1000,"_31098":947,"_21528":53906,"_5":14794,"_28279":53776,"_3062":53907},[],"Certificate validation followed by webhook approval.",{"_3607":1001,"_31098":947,"_21528":53909,"_5":14794,"_28279":53776,"_3062":53910},[],"`NO_AUTH`",{"_3607":1002,"_31098":947,"_21528":53912,"_5":14794,"_28279":53776,"_3062":53913},[],"No DMS requester authentication.",{"_3607":1003,"_31098":947,"_21528":53915,"_5":14794,"_28279":53776,"_3062":53916},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3607":1004,"_31098":947,"_21528":53918,"_5":14794,"_28279":53776,"_3062":53919},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3607":1005,"_31098":947,"_21528":53921,"_5":14794,"_28279":53776,"_3062":53922},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3607":1006,"_31098":947,"_21528":53924,"_5":14794,"_28279":53776,"_3062":53925},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3607":1007,"_31098":947,"_21528":53927,"_5":14794,"_28279":53780,"_3062":53928},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3607":1008,"_31098":947,"_21528":53930,"_5":14794,"_28279":53780,"_3062":53931},[],"`external_webhook_settings` field",{"_3607":1009,"_31098":947,"_21528":53933,"_5":14794,"_28279":53780,"_3062":53841},[],{"_3607":1010,"_31098":947,"_21528":53935,"_5":14794,"_28279":53780,"_3062":53936},[],"`url`",{"_3607":1011,"_31098":947,"_21528":53938,"_5":14794,"_28279":53780,"_3062":53939},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3607":1012,"_31098":947,"_21528":53941,"_5":14794,"_28279":53780,"_3062":53942},[],"`method`",{"_3607":1013,"_31098":947,"_21528":53944,"_5":14794,"_28279":53780,"_3062":53945},[],"`POST` or `PUT`; `POST` by default.",{"_3607":1014,"_31098":947,"_21528":53947,"_5":14794,"_28279":53780,"_3062":53948},[],"`name`",{"_3607":1015,"_31098":947,"_21528":53950,"_5":14794,"_28279":53780,"_3062":53951},[],"Label used in service logs.",{"_3607":1016,"_31098":947,"_21528":53953,"_5":14794,"_28279":53780,"_3062":53954},[],"`config.auth_mode`",{"_3607":1017,"_31098":947,"_21528":53956,"_5":14794,"_28279":53780,"_3062":53957},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3607":1018,"_31098":947,"_21528":53959,"_5":14794,"_28279":53780,"_3062":53960},[],"`config.log_level`",{"_3607":1019,"_31098":947,"_21528":53962,"_5":14794,"_28279":53780,"_3062":53963},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3607":1020,"_31098":947,"_21528":53965,"_5":14794,"_28279":53780,"_3062":53966},[],"`config.apikey_options`",{"_3607":1021,"_31098":947,"_21528":53968,"_5":14794,"_28279":53780,"_3062":53969},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3607":1022,"_31098":947,"_21528":53971,"_5":14794,"_28279":53780,"_3062":53972},[],"`config.jwt_options`",{"_3607":1023,"_31098":947,"_21528":53974,"_5":14794,"_28279":53780,"_3062":53975},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3607":1024,"_31098":947,"_21528":53977,"_5":14794,"_28279":53780,"_3062":53978},[],"`config.mtls_options`",{"_3607":1025,"_31098":947,"_21528":53980,"_5":14794,"_28279":53780,"_3062":53981},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3607":1026,"_31098":947,"_21528":53983,"_5":14794,"_28279":53780,"_3062":53984},[],"`config.insecure_skip_verify`",{"_3607":1027,"_31098":947,"_21528":53986,"_5":14794,"_28279":53780,"_3062":53987},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3607":1028,"_31098":947,"_21528":53989,"_5":14794,"_28279":53780,"_3062":53990},[],"`config.call_timeout`",{"_3607":1029,"_31098":947,"_21528":53992,"_5":14794,"_28279":53780,"_3062":53993},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3607":1030,"_31098":947,"_21528":53995,"_5":14794,"_28279":53780,"_3062":53996},[],"Rules for that configuration:",{"_3607":1031,"_31098":947,"_21528":53998,"_5":14794,"_28279":53780,"_3062":53999},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3607":1032,"_31098":947,"_21528":54001,"_5":14794,"_28279":53780,"_3062":54002},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3607":1033,"_31098":947,"_21528":54004,"_5":14794,"_28279":53780,"_3062":54005},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3607":1034,"_31098":947,"_21528":54007,"_5":14794,"_28279":53780,"_3062":54008},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3607":1035,"_31098":947,"_21528":54010,"_5":14794,"_28279":53780,"_3062":54011},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3607":1036,"_31098":947,"_21528":54013,"_5":14794,"_28279":53780,"_3062":54014},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3607":1037,"_31098":947,"_21528":54016,"_5":14794,"_28279":53780,"_3062":54017},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3607":1038,"_31098":947,"_21528":54019,"_5":14794,"_28279":53780,"_3062":54020},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3607":1039,"_31098":947,"_21528":54022,"_5":14794,"_28279":53780,"_3062":54023},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3607":1040,"_31098":947,"_21528":54025,"_5":14794,"_28279":53784,"_3062":54026},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3607":1041,"_31098":947,"_21528":54028,"_5":14794,"_28279":53788,"_3062":54029},[],"`settings.reenrollment_settings` field",{"_3607":1042,"_31098":947,"_21528":54031,"_5":14794,"_28279":53788,"_3062":51177},[],{"_3607":1043,"_31098":947,"_21528":54033,"_5":14794,"_28279":53788,"_3062":54034},[],"`reenrollment_delta`",{"_3607":1044,"_31098":947,"_21528":54036,"_5":14794,"_28279":53788,"_3062":54037},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3607":1045,"_31098":947,"_21528":54039,"_5":14794,"_28279":53788,"_3062":54040},[],"`preventive_delta`",{"_3607":1046,"_31098":947,"_21528":54042,"_5":14794,"_28279":53788,"_3062":54043},[],"Preventive operational monitoring threshold.",{"_3607":1047,"_31098":947,"_21528":54045,"_5":14794,"_28279":53788,"_3062":54046},[],"`critical_delta`",{"_3607":1048,"_31098":947,"_21528":54048,"_5":14794,"_28279":53788,"_3062":54049},[],"Critical operational monitoring threshold.",{"_3607":1049,"_31098":947,"_21528":54051,"_5":14794,"_28279":53788,"_3062":54052},[],"`enable_expired_renewal`",{"_3607":1050,"_31098":947,"_21528":54054,"_5":14794,"_28279":53788,"_3062":54055},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3607":1051,"_31098":947,"_21528":54057,"_5":14794,"_28279":53788,"_3062":54058},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3607":1052,"_31098":947,"_21528":54060,"_5":14794,"_28279":53788,"_3062":54061},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3607":1053,"_31098":947,"_21528":54063,"_5":14794,"_28279":53788,"_3062":54064},[],"`revoke_on_reenrollment`",{"_3607":1054,"_31098":947,"_21528":54066,"_5":14794,"_28279":53788,"_3062":54067},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3607":1055,"_31098":947,"_21528":54069,"_5":14794,"_28279":53788,"_3062":54070},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3607":1056,"_31098":947,"_21528":54072,"_5":14794,"_28279":53792,"_3062":54073},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3607":1057,"_31098":947,"_21528":54075,"_5":14794,"_28279":53796,"_3062":51171},[],{"_3607":1058,"_31098":947,"_21528":54077,"_5":14794,"_28279":53796,"_3062":54078},[],"Published material",{"_3607":1059,"_31098":947,"_21528":54080,"_5":14794,"_28279":53796,"_3062":54081},[],"**Include Lamassu System CA**",{"_3607":1060,"_31098":947,"_21528":54083,"_5":14794,"_28279":53796,"_3062":54084},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3607":1061,"_31098":947,"_21528":54086,"_5":14794,"_28279":53796,"_3062":54087},[],"**Include Enrollment CA**",{"_3607":1062,"_31098":947,"_21528":54089,"_5":14794,"_28279":53796,"_3062":54090},[],"Selected issuing CA certificate.",{"_3607":1063,"_31098":947,"_21528":54092,"_5":14794,"_28279":53796,"_3062":54093},[],"**Managed CAs**",{"_3607":1064,"_31098":947,"_21528":54095,"_5":14794,"_28279":53796,"_3062":54096},[],"Explicitly selected CA certificates.",{"_3607":1065,"_31098":947,"_21528":54098,"_5":14794,"_28279":53796,"_3062":54099},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3607":1066,"_31098":947,"_21528":54101,"_5":14794,"_28279":53800,"_3062":54102},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3607":1067,"_31098":947,"_21528":54104,"_5":14794,"_28279":53800,"_3062":54105},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3607":1068,"_31098":947,"_21528":54107,"_5":14794,"_28279":53800,"_3062":54108},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3607":1069,"_31098":947,"_21528":54110,"_5":14794,"_28279":53804,"_3062":54111},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3607":1070,"_31098":1070,"_5":15159,"_3062":54113,"_31457":54114,"_21528":54115,"_28279":1070},"Integrate the EST client",[50787,52299,53471,53469,53655],[],{"_3607":1071,"_31098":1070,"_21528":54117,"_5":14794,"_28279":1070,"_3062":54118},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3607":1072,"_31098":1070,"_5":31454,"_21528":54120,"_28279":54121,"_3062":50797},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3607":1073,"_31098":1070,"_5":31454,"_21528":54123,"_28279":54124,"_3062":54125},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3607":1074,"_31098":1070,"_5":31454,"_21528":54127,"_28279":54128,"_3062":54129},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3607":1075,"_31098":1070,"_5":31454,"_21528":54131,"_28279":54132,"_3062":54133},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3607":1076,"_31098":1070,"_5":31454,"_21528":54135,"_28279":54136,"_3062":54137},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3607":1077,"_31098":1070,"_5":31454,"_21528":54139,"_28279":54140,"_3062":54141},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3607":1078,"_31098":1070,"_21528":54143,"_5":14794,"_28279":1070,"_3062":54144},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3607":1079,"_31098":1070,"_21528":54146,"_5":14794,"_28279":54121,"_3062":54147},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3607":1080,"_31098":1070,"_21528":54149,"_5":14794,"_28279":54121,"_3062":54150},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3607":1081,"_31098":1070,"_21528":54152,"_5":14794,"_28279":54121,"_3062":54153},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3607":1082,"_31098":1070,"_21528":54155,"_5":14794,"_28279":54124,"_3062":54156},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3607":1083,"_31098":1070,"_21528":54158,"_5":14794,"_28279":54124,"_3062":54159},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3607":1084,"_31098":1070,"_21528":54161,"_5":14794,"_28279":54128,"_3062":54162},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3607":1085,"_31098":1070,"_21528":54164,"_5":14794,"_28279":54128,"_3062":54165},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3607":1086,"_31098":1070,"_21528":54167,"_5":14794,"_28279":54132,"_3062":54168},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3607":1087,"_31098":1070,"_21528":54170,"_5":14794,"_28279":54132,"_3062":54171},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3607":1088,"_31098":1070,"_21528":54173,"_5":14794,"_28279":54136,"_3062":54174},[],"For a root that issues directly:",{"_3607":1089,"_31098":1070,"_21528":54176,"_5":14794,"_28279":54136,"_3062":54177},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3607":1090,"_31098":1070,"_21528":54179,"_5":14794,"_28279":54136,"_3062":54180},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3607":1091,"_31098":1070,"_21528":54182,"_5":14794,"_28279":54140,"_3062":54183},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3607":1092,"_31098":1092,"_5":15159,"_3062":54185,"_31457":54186,"_21528":54187,"_28279":1092},"EST reference",[50787,52299,53471,53469,53655],[],{"_3607":1093,"_31098":1092,"_21528":54189,"_5":14794,"_28279":1092,"_3062":54190},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3607":1094,"_31098":1092,"_5":31454,"_21528":54192,"_28279":54193,"_3062":54194},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3607":1095,"_31098":1092,"_5":31454,"_21528":54196,"_28279":54197,"_3062":23330},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3607":1096,"_31098":1092,"_5":31454,"_21528":54199,"_28279":54200,"_3062":26824},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3607":1097,"_31098":1092,"_5":31454,"_21528":54202,"_28279":54203,"_3062":26831},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3607":1098,"_31098":1092,"_5":31454,"_21528":54205,"_28279":54206,"_3062":26093},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3607":1099,"_31098":1092,"_5":31454,"_21528":54208,"_28279":54209,"_3062":54210},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3607":1100,"_31098":1092,"_5":31454,"_21528":54212,"_28279":54213,"_3062":54214},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3607":1101,"_31098":1092,"_5":31454,"_21528":54216,"_28279":54217,"_3062":54218},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3607":1102,"_31098":1092,"_21528":54220,"_5":14794,"_28279":1092,"_3062":54221},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3607":1103,"_31098":1092,"_21528":54223,"_5":14794,"_28279":54193,"_3062":54224},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3607":1104,"_31098":1092,"_21528":54226,"_5":14794,"_28279":54193,"_3062":54227},[],"Operation",{"_3607":1105,"_31098":1092,"_21528":54229,"_5":14794,"_28279":54193,"_3062":54230},[],"Method",{"_3607":1106,"_31098":1092,"_21528":54232,"_5":14794,"_28279":54193,"_3062":54233},[],"Authentication and condition",{"_3607":1107,"_31098":1092,"_21528":54235,"_5":14794,"_28279":54193,"_3062":54236},[],"`/cacerts`",{"_3607":1108,"_31098":1092,"_21528":54238,"_5":14794,"_28279":54193,"_3062":54239},[],"GET",{"_3607":1109,"_31098":1092,"_21528":54241,"_5":14794,"_28279":54193,"_3062":54242},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3607":1110,"_31098":1092,"_21528":54244,"_5":14794,"_28279":54193,"_3062":54245},[],"`/simpleenroll`",{"_3607":1111,"_31098":1092,"_21528":54247,"_5":14794,"_28279":54193,"_3062":54248},[],"POST",{"_3607":1112,"_31098":1092,"_21528":54250,"_5":14794,"_28279":54193,"_3062":54251},[],"Initial authentication and DMS registration/replacement policy.",{"_3607":1113,"_31098":1092,"_21528":54253,"_5":14794,"_28279":54193,"_3062":54254},[],"`/simplereenroll`",{"_3607":1114,"_31098":1092,"_21528":54256,"_5":14794,"_28279":54193,"_3062":54248},[],{"_3607":1115,"_31098":1092,"_21528":54258,"_5":14794,"_28279":54193,"_3062":54259},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3607":1116,"_31098":1092,"_21528":54261,"_5":14794,"_28279":54193,"_3062":54262},[],"`/serverkeygen`",{"_3607":1117,"_31098":1092,"_21528":54264,"_5":14794,"_28279":54193,"_3062":54248},[],{"_3607":1118,"_31098":1092,"_21528":54266,"_5":14794,"_28279":54193,"_3062":54267},[],"Initial authentication and admission; server generation enabled.",{"_3607":1119,"_31098":1092,"_21528":54269,"_5":14794,"_28279":54193,"_3062":54270},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3607":1120,"_31098":1092,"_21528":54272,"_5":14794,"_28279":54197,"_3062":54273},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3607":1121,"_31098":1092,"_21528":54275,"_5":14794,"_28279":54197,"_3062":54276},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3607":1122,"_31098":1092,"_21528":54278,"_5":14794,"_28279":54200,"_3062":54279},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3607":1123,"_31098":1092,"_21528":54281,"_5":14794,"_28279":54200,"_3062":54282},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3607":1124,"_31098":1092,"_21528":54284,"_5":14794,"_28279":54203,"_3062":54285},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3607":1125,"_31098":1092,"_21528":54287,"_5":14794,"_28279":54203,"_3062":54288},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3607":1126,"_31098":1092,"_21528":54290,"_5":14794,"_28279":54206,"_3062":54291},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3607":1127,"_31098":1092,"_21528":54293,"_5":14794,"_28279":54206,"_3062":54294},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3607":1128,"_31098":1092,"_21528":54296,"_5":14794,"_28279":54209,"_3062":54297},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3607":1129,"_31098":1092,"_21528":54299,"_5":14794,"_28279":54209,"_3062":54300},[],"Part",{"_3607":1130,"_31098":1092,"_21528":54302,"_5":14794,"_28279":54209,"_3062":54303},[],"Content after decoding its Base64",{"_3607":1131,"_31098":1092,"_21528":54305,"_5":14794,"_28279":54209,"_3062":54306},[],"`application/pkcs8`",{"_3607":1132,"_31098":1092,"_21528":54308,"_5":14794,"_28279":54209,"_3062":54309},[],"Unencrypted DER PKCS#8 private key.",{"_3607":1133,"_31098":1092,"_21528":54311,"_5":14794,"_28279":54209,"_3062":54312},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3607":1134,"_31098":1092,"_21528":54314,"_5":14794,"_28279":54209,"_3062":54315},[],"DER PKCS#7 containing the issued certificate.",{"_3607":1135,"_31098":1092,"_21528":54317,"_5":14794,"_28279":54209,"_3062":54318},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3607":1136,"_31098":1092,"_21528":54320,"_5":14794,"_28279":54213,"_3062":54321},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3607":1137,"_31098":1092,"_21528":54323,"_5":14794,"_28279":54213,"_3062":54324},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3607":1138,"_31098":1092,"_21528":54326,"_5":14794,"_28279":54213,"_3062":54327},[],"Convert and check the result:",{"_3607":1139,"_31098":1092,"_21528":54329,"_5":14794,"_28279":54213,"_3062":54330},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3607":1140,"_31098":1092,"_21528":54332,"_5":14794,"_28279":54217,"_3062":54333},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3607":1141,"_31098":1092,"_21528":54335,"_5":14794,"_28279":54217,"_3062":54336},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3607":1142,"_31098":1142,"_5":15159,"_3062":53655,"_31457":54338,"_21528":54339,"_28279":1142},[50787,52299,53471,53469,53655],[],{"_3607":1143,"_31098":1142,"_21528":54341,"_5":14794,"_28279":1142,"_3062":54342},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3607":1144,"_31098":1142,"_5":31454,"_21528":54344,"_28279":54345,"_3062":54346},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3607":1145,"_31098":1142,"_5":31454,"_21528":54348,"_28279":54349,"_3062":54350},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3607":1146,"_31098":1142,"_5":31454,"_21528":54352,"_28279":54353,"_3062":54354},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3607":1147,"_31098":1142,"_5":31454,"_21528":54356,"_28279":54357,"_3062":54358},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3607":1148,"_31098":1142,"_21528":54360,"_5":14794,"_28279":1142,"_3062":54361},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3607":1149,"_31098":1142,"_21528":54363,"_5":14794,"_28279":54345,"_3062":54364},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3607":1150,"_31098":1142,"_21528":54366,"_5":14794,"_28279":54345,"_3062":54367},[],"The integrator installs initial EST server trust and an admission credential.",{"_3607":1151,"_31098":1142,"_21528":54369,"_5":14794,"_28279":54345,"_3062":54370},[],"The client requests an identity for its `Device ID` through EST.",{"_3607":1152,"_31098":1142,"_21528":54372,"_5":14794,"_28279":54345,"_3062":54373},[],"Certificate, device binding and key/certificate installation are checked.",{"_3607":1153,"_31098":1142,"_21528":54375,"_5":14794,"_28279":54345,"_3062":54376},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3607":1154,"_31098":1142,"_21528":54378,"_5":14794,"_28279":54345,"_3062":54379},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3607":1155,"_31098":1142,"_21528":54381,"_5":14794,"_28279":54349,"_3062":54382},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3607":1156,"_31098":1142,"_21528":54384,"_5":14794,"_28279":54349,"_3062":54385},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3607":1157,"_31098":1142,"_21528":54387,"_5":14794,"_28279":54349,"_3062":54388},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3607":1158,"_31098":1142,"_21528":54390,"_5":14794,"_28279":54349,"_3062":54391},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3607":1159,"_31098":1142,"_21528":54393,"_5":14794,"_28279":54353,"_3062":54394},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3607":1160,"_31098":1142,"_21528":54396,"_5":14794,"_28279":54353,"_3062":54397},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3607":1161,"_31098":1142,"_21528":54399,"_5":14794,"_28279":54353,"_3062":54400},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3607":1162,"_31098":1142,"_21528":54402,"_5":14794,"_28279":54353,"_3062":54403},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3607":1163,"_31098":1142,"_21528":54405,"_5":14794,"_28279":54357,"_3062":54406},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3607":1164,"_31098":1142,"_21528":54408,"_5":14794,"_28279":54357,"_3062":54409},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3607":1165,"_31098":1165,"_5":15159,"_3062":54411,"_31457":54412,"_21528":54413,"_28279":1165},"Provisioning strategies",[50787,52299,53471,53469,53655],[],{"_3607":1166,"_31098":1165,"_21528":54415,"_5":14794,"_28279":1165,"_3062":54416},[],"Choose device registration, identity authorization and key generation.",{"_3607":1167,"_31098":1165,"_5":31454,"_21528":54418,"_28279":54419,"_3062":54420},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3607":1168,"_31098":1165,"_5":31454,"_21528":54422,"_28279":54423,"_3062":54424},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3607":1169,"_31098":1165,"_5":31454,"_21528":54426,"_28279":54427,"_3062":54428},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3607":1170,"_31098":1165,"_5":31454,"_21528":54430,"_28279":54431,"_3062":54432},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3607":1171,"_31098":1165,"_5":31454,"_21528":54434,"_28279":54435,"_3062":54436},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3607":1172,"_31098":1165,"_21528":54438,"_5":14794,"_28279":1165,"_3062":54439},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3607":1173,"_31098":1165,"_21528":54441,"_5":14794,"_28279":54419,"_3062":54442},[],"Path",{"_3607":1174,"_31098":1165,"_21528":54444,"_5":14794,"_28279":54419,"_3062":54445},[],"When the device exists",{"_3607":1175,"_31098":1165,"_21528":54447,"_5":14794,"_28279":54419,"_3062":54448},[],"What to check",{"_3607":1176,"_31098":1165,"_21528":54450,"_5":14794,"_28279":54419,"_3062":54451},[],"Manual assignment",{"_3607":1177,"_31098":1165,"_21528":54453,"_5":14794,"_28279":54419,"_3062":54454},[],"An operator creates it before associating a certificate.",{"_3607":1178,"_31098":1165,"_21528":54456,"_5":14794,"_28279":54419,"_3062":54457},[],"ID, owning DMS, certificate CN and bound serial.",{"_3607":1179,"_31098":1165,"_21528":54459,"_5":14794,"_28279":54419,"_3062":54460},[],"EST with `JITP`",{"_3607":1180,"_31098":1165,"_21528":54462,"_5":14794,"_28279":54419,"_3062":54463},[],"Created for an unknown CN during `/simpleenroll`.",{"_3607":1181,"_31098":1165,"_21528":54465,"_5":14794,"_28279":54419,"_3062":54466},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3607":1182,"_31098":1165,"_21528":54468,"_5":14794,"_28279":54419,"_3062":54469},[],"EST with `PRE_REGISTRATION`",{"_3607":1183,"_31098":1165,"_21528":54471,"_5":14794,"_28279":54419,"_3062":54472},[],"Must exist before `/simpleenroll`.",{"_3607":1184,"_31098":1165,"_21528":54474,"_5":14794,"_28279":54419,"_3062":54475},[],"Approved record, same DMS and replacement conditions for your version.",{"_3607":1185,"_31098":1165,"_21528":54477,"_5":14794,"_28279":54419,"_3062":54478},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3607":1186,"_31098":1165,"_21528":54480,"_5":14794,"_28279":54419,"_3062":54481},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3607":1187,"_31098":1165,"_21528":54483,"_5":14794,"_28279":54423,"_3062":54484},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3607":1188,"_31098":1165,"_21528":54486,"_5":14794,"_28279":54423,"_3062":54487},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3607":1189,"_31098":1165,"_21528":54489,"_5":14794,"_28279":54423,"_3062":54490},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3607":1190,"_31098":1165,"_21528":54492,"_5":14794,"_28279":54427,"_3062":54493},[],"Decide initial enrollment and re-enrollment separately:",{"_3607":1191,"_31098":1165,"_21528":54495,"_5":14794,"_28279":54427,"_3062":54496},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3607":1192,"_31098":1165,"_21528":54498,"_5":14794,"_28279":54427,"_3062":54499},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3607":1193,"_31098":1165,"_21528":54501,"_5":14794,"_28279":54427,"_3062":54502},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3607":1194,"_31098":1165,"_21528":54504,"_5":14794,"_28279":54427,"_3062":54505},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3607":1195,"_31098":1165,"_21528":54507,"_5":14794,"_28279":54427,"_3062":54508},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3607":1196,"_31098":1165,"_21528":54510,"_5":14794,"_28279":54431,"_3062":51171},[],{"_3607":1197,"_31098":1165,"_21528":54512,"_5":14794,"_28279":54431,"_3062":54513},[],"Material crossing EST",{"_3607":1198,"_31098":1165,"_21528":54515,"_5":14794,"_28279":54431,"_3062":54516},[],"Device-generated key",{"_3607":1199,"_31098":1165,"_21528":54518,"_5":14794,"_28279":54431,"_3062":54519},[],"Public CSR and certificate; the key stays on the client.",{"_3607":1200,"_31098":1165,"_21528":54521,"_5":14794,"_28279":54431,"_3062":54522},[],"Existing device key",{"_3607":1201,"_31098":1165,"_21528":54524,"_5":14794,"_28279":54431,"_3062":54525},[],"CSR signed with that key and a new certificate.",{"_3607":1202,"_31098":1165,"_21528":54527,"_5":14794,"_28279":54431,"_3062":53793},[],{"_3607":1203,"_31098":1165,"_21528":54529,"_5":14794,"_28279":54431,"_3062":54530},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3607":1204,"_31098":1165,"_21528":54532,"_5":14794,"_28279":54431,"_3062":54533},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3607":1205,"_31098":1165,"_21528":54535,"_5":14794,"_28279":54435,"_3062":54536},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3607":1206,"_31098":1206,"_5":15159,"_3062":54538,"_31457":54539,"_21528":54540,"_28279":1206},"Renewal and recovery",[50787,52299,53471,53469,53655],[],{"_3607":1207,"_31098":1206,"_21528":54542,"_5":14794,"_28279":1206,"_3062":54543},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3607":1208,"_31098":1206,"_5":31454,"_21528":54545,"_28279":54546,"_3062":54547},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3607":1209,"_31098":1206,"_5":31454,"_21528":54549,"_28279":54550,"_3062":54551},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3607":1210,"_31098":1206,"_5":31454,"_21528":54553,"_28279":54554,"_3062":54555},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3607":1211,"_31098":1206,"_5":31454,"_21528":54557,"_28279":54558,"_3062":54559},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3607":1212,"_31098":1206,"_5":31454,"_21528":54561,"_28279":54562,"_3062":54563},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3607":1213,"_31098":1206,"_21528":54565,"_5":14794,"_28279":1206,"_3062":54566},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3607":1214,"_31098":1206,"_21528":54568,"_5":14794,"_28279":54546,"_3062":54569},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3607":1215,"_31098":1206,"_21528":54571,"_5":14794,"_28279":54546,"_3062":54572},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3607":1216,"_31098":1206,"_21528":54574,"_5":14794,"_28279":54546,"_3062":54575},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3607":1217,"_31098":1206,"_21528":54577,"_5":14794,"_28279":54546,"_3062":54578},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3607":1218,"_31098":1206,"_21528":54580,"_5":14794,"_28279":54550,"_3062":54581},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3607":1219,"_31098":1206,"_21528":54583,"_5":14794,"_28279":54550,"_3062":54584},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3607":1220,"_31098":1206,"_21528":54586,"_5":14794,"_28279":54554,"_3062":54587},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3607":1221,"_31098":1206,"_21528":54589,"_5":14794,"_28279":54554,"_3062":54590},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3607":1222,"_31098":1206,"_21528":54592,"_5":14794,"_28279":54554,"_3062":54593},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3607":1223,"_31098":1206,"_21528":54595,"_5":14794,"_28279":54558,"_3062":54596},[],"Situation",{"_3607":1224,"_31098":1206,"_21528":54598,"_5":14794,"_28279":54558,"_3062":54599},[],"Procedure",{"_3607":1225,"_31098":1206,"_21528":54601,"_5":14794,"_28279":54558,"_3062":54602},[],"Valid certificate, outside the window",{"_3607":1226,"_31098":1206,"_21528":54604,"_5":14794,"_28279":54558,"_3062":54605},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3607":1227,"_31098":1206,"_21528":54607,"_5":14794,"_28279":54558,"_3062":54608},[],"Expired certificate, key available",{"_3607":1228,"_31098":1206,"_21528":54610,"_5":14794,"_28279":54558,"_3062":54611},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3607":1229,"_31098":1206,"_21528":54613,"_5":14794,"_28279":54558,"_3062":54614},[],"Renewal through webhook or `NO_AUTH`",{"_3607":1230,"_31098":1206,"_21528":54616,"_5":14794,"_28279":54558,"_3062":54617},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3607":1231,"_31098":1206,"_21528":54619,"_5":14794,"_28279":54558,"_3062":54620},[],"Lost or inaccessible key",{"_3607":1232,"_31098":1206,"_21528":54622,"_5":14794,"_28279":54558,"_3062":54623},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3607":1233,"_31098":1206,"_21528":54625,"_5":14794,"_28279":54558,"_3062":54626},[],"Current identity revoked",{"_3607":1234,"_31098":1206,"_21528":54628,"_5":14794,"_28279":54558,"_3062":54629},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3607":1235,"_31098":1206,"_21528":54631,"_5":14794,"_28279":54558,"_3062":54632},[],"Device without an identity",{"_3607":1236,"_31098":1206,"_21528":54634,"_5":14794,"_28279":54558,"_3062":54635},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3607":1237,"_31098":1206,"_21528":54637,"_5":14794,"_28279":54558,"_3062":54638},[],"Retired device",{"_3607":1238,"_31098":1206,"_21528":54640,"_5":14794,"_28279":54558,"_3062":54641},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3607":1239,"_31098":1206,"_21528":54643,"_5":14794,"_28279":54558,"_3062":54644},[],"Timeout, HTTP 500 or installation failure",{"_3607":1240,"_31098":1206,"_21528":54646,"_5":14794,"_28279":54558,"_3062":54647},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3607":1241,"_31098":1206,"_21528":54649,"_5":14794,"_28279":54562,"_3062":54650},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3607":1242,"_31098":1206,"_21528":54652,"_5":14794,"_28279":54562,"_3062":54653},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3607":1243,"_31098":1243,"_5":15159,"_3062":54655,"_31457":54656,"_21528":54657,"_28279":1243},"Enrollment troubleshooting",[50787,52299,53471,53469,53655],[],{"_3607":1244,"_31098":1243,"_21528":54659,"_5":14794,"_28279":1243,"_3062":54660},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3607":1245,"_31098":1243,"_5":31454,"_21528":54662,"_28279":54663,"_3062":54664},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3607":1246,"_31098":1243,"_5":31454,"_21528":54666,"_28279":54667,"_3062":54668},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3607":1247,"_31098":1243,"_5":31454,"_21528":54670,"_28279":54671,"_3062":54218},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3607":1248,"_31098":1243,"_5":31454,"_21528":54673,"_28279":54674,"_3062":54675},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3607":1249,"_31098":1243,"_21528":54677,"_5":14794,"_28279":1243,"_3062":54678},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3607":1250,"_31098":1243,"_21528":54680,"_5":14794,"_28279":54667,"_3062":54681},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3607":1251,"_31098":1243,"_21528":54683,"_5":14794,"_28279":54667,"_3062":54684},[],"Symptom or message",{"_3607":1252,"_31098":1243,"_21528":54686,"_5":14794,"_28279":54667,"_3062":54448},[],{"_3607":1253,"_31098":1243,"_21528":54688,"_5":14794,"_28279":54667,"_3062":54689},[],"curl rejects TLS, name or issuer",{"_3607":1254,"_31098":1243,"_21528":54691,"_5":14794,"_28279":54667,"_3062":54692},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3607":1255,"_31098":1243,"_21528":54694,"_5":14794,"_28279":54667,"_3062":54695},[],"404 or missing APS",{"_3607":1256,"_31098":1243,"_21528":54697,"_5":14794,"_28279":54667,"_3062":54698},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3607":1257,"_31098":1243,"_21528":54700,"_5":14794,"_28279":54667,"_3062":54701},[],"400, CSR or format error",{"_3607":1258,"_31098":1243,"_21528":54703,"_5":14794,"_28279":54667,"_3062":54704},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3607":1259,"_31098":1243,"_21528":54706,"_5":14794,"_28279":54667,"_3062":54707},[],"Missing credential or invalid certificate",{"_3607":1260,"_31098":1243,"_21528":54709,"_5":14794,"_28279":54667,"_3062":54710},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3607":1261,"_31098":1243,"_21528":54712,"_5":14794,"_28279":54667,"_3062":54713},[],"Webhook denies, times out or responds without authorization",{"_3607":1262,"_31098":1243,"_21528":54715,"_5":14794,"_28279":54667,"_3062":54716},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3607":1263,"_31098":1243,"_21528":54718,"_5":14794,"_28279":54667,"_3062":54719},[],"`unexpected status code: <n>: redirects are not followed`",{"_3607":1264,"_31098":1243,"_21528":54721,"_5":14794,"_28279":54667,"_3062":54722},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3607":1265,"_31098":1243,"_21528":54724,"_5":14794,"_28279":54667,"_3062":54725},[],"`webhook response exceeds 1048576 bytes`",{"_3607":1266,"_31098":1243,"_21528":54727,"_5":14794,"_28279":54667,"_3062":54728},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3607":1267,"_31098":1243,"_21528":54730,"_5":14794,"_28279":54667,"_3062":54731},[],"`webhook config must not reference files`",{"_3607":1268,"_31098":1243,"_21528":54733,"_5":14794,"_28279":54667,"_3062":54734},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3607":1269,"_31098":1243,"_21528":54736,"_5":14794,"_28279":54667,"_3062":54737},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3607":1270,"_31098":1243,"_21528":54739,"_5":14794,"_28279":54667,"_3062":54740},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3607":1271,"_31098":1243,"_21528":54742,"_5":14794,"_28279":54667,"_3062":54743},[],"`webhook mTLS certificate and key are invalid: …`",{"_3607":1272,"_31098":1243,"_21528":54745,"_5":14794,"_28279":54667,"_3062":54746},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3607":1273,"_31098":1243,"_21528":54748,"_5":14794,"_28279":54667,"_3062":54749},[],"400 `struct validation error` creating or updating a DMS",{"_3607":1274,"_31098":1243,"_21528":54751,"_5":14794,"_28279":54667,"_3062":54752},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3607":1275,"_31098":1243,"_21528":54754,"_5":14794,"_28279":54667,"_3062":54755},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3607":1276,"_31098":1243,"_21528":54757,"_5":14794,"_28279":54667,"_3062":54758},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3607":1277,"_31098":1243,"_21528":54760,"_5":14794,"_28279":54667,"_3062":54761},[],"`device not preregistered`",{"_3607":1278,"_31098":1243,"_21528":54763,"_5":14794,"_28279":54667,"_3062":54764},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3607":1279,"_31098":1243,"_21528":54766,"_5":14794,"_28279":54667,"_3062":54767},[],"`forbiddenNewEnrollment`",{"_3607":1280,"_31098":1243,"_21528":54769,"_5":14794,"_28279":54667,"_3062":54770},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3607":1281,"_31098":1243,"_21528":54772,"_5":14794,"_28279":54667,"_3062":54773},[],"Different owning DMS",{"_3607":1282,"_31098":1243,"_21528":54775,"_5":14794,"_28279":54667,"_3062":54776},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3607":1283,"_31098":1243,"_21528":54778,"_5":14794,"_28279":54667,"_3062":54779},[],"`invalid RawSubject bytes`",{"_3607":1284,"_31098":1243,"_21528":54781,"_5":14794,"_28279":54667,"_3062":54782},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3607":1285,"_31098":1243,"_21528":54784,"_5":14794,"_28279":54667,"_3062":54785},[],"`invalid reenroll window`",{"_3607":1286,"_31098":1243,"_21528":54787,"_5":14794,"_28279":54667,"_3062":54788},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3607":1287,"_31098":1243,"_21528":54790,"_5":14794,"_28279":54667,"_3062":54791},[],"Current certificate revoked",{"_3607":1288,"_31098":1243,"_21528":54793,"_5":14794,"_28279":54667,"_3062":54794},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3607":1289,"_31098":1243,"_21528":54796,"_5":14794,"_28279":54667,"_3062":54797},[],"CA, profile or signing error",{"_3607":1290,"_31098":1243,"_21528":54799,"_5":14794,"_28279":54667,"_3062":54800},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3607":1291,"_31098":1243,"_21528":54802,"_5":14794,"_28279":54667,"_3062":54803},[],"HTTP 200 without a device connection",{"_3607":1292,"_31098":1243,"_21528":54805,"_5":14794,"_28279":54667,"_3062":54806},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3607":1293,"_31098":1243,"_21528":54808,"_5":14794,"_28279":54667,"_3062":54809},[],"Timeout or error after issuance",{"_3607":1294,"_31098":1243,"_21528":54811,"_5":14794,"_28279":54667,"_3062":54812},[],"New certificates, current slot and previous identity's state before retrying.",{"_3607":1295,"_31098":1243,"_21528":54814,"_5":14794,"_28279":54671,"_3062":54815},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3607":1296,"_31098":1243,"_21528":54817,"_5":14794,"_28279":54671,"_3062":54818},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3607":1297,"_31098":1243,"_21528":54820,"_5":14794,"_28279":54674,"_3062":54821},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3607":1298,"_31098":1243,"_21528":54823,"_5":14794,"_28279":54674,"_3062":54824},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3607":1299,"_31098":1243,"_21528":54826,"_5":14794,"_28279":54674,"_3062":54827},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3607":1300,"_31098":1243,"_21528":54829,"_5":14794,"_28279":54674,"_3062":54830},[],"Make one request, save headers/body and query the device and certificates.",{"_3607":1301,"_31098":1243,"_21528":54832,"_5":14794,"_28279":54674,"_3062":54833},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3607":1302,"_31098":1243,"_21528":54835,"_5":14794,"_28279":54674,"_3062":54836},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3607":1303,"_31098":1243,"_21528":54838,"_5":14794,"_28279":54674,"_3062":54839},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3607":1304,"_31098":1304,"_5":15159,"_3062":54841,"_31457":54842,"_21528":54843,"_28279":1304},"Trust distribution and updates",[50787,52299,53471,53469,53655],[],{"_3607":1305,"_31098":1304,"_21528":54845,"_5":14794,"_28279":1304,"_3062":54846},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3607":1306,"_31098":1304,"_5":31454,"_21528":54848,"_28279":54849,"_3062":54850},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3607":1307,"_31098":1304,"_5":31454,"_21528":54852,"_28279":54853,"_3062":54854},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3607":1308,"_31098":1304,"_5":31454,"_21528":54856,"_28279":54857,"_3062":54858},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3607":1309,"_31098":1304,"_5":31454,"_21528":54860,"_28279":54861,"_3062":54862},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3607":1310,"_31098":1304,"_5":31454,"_21528":54864,"_28279":54865,"_3062":54866},[],"/docs/pr-preview/pr-75/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3607":1311,"_31098":1304,"_21528":54868,"_5":14794,"_28279":1304,"_3062":54869},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3607":1312,"_31098":1304,"_21528":54871,"_5":14794,"_28279":54849,"_3062":54872},[],"Relationship",{"_3607":1313,"_31098":1304,"_21528":54874,"_5":14794,"_28279":54849,"_3062":54875},[],"Material prepared by its owner",{"_3607":1314,"_31098":1304,"_21528":54877,"_5":14794,"_28279":54849,"_3062":54878},[],"Device → EST server",{"_3607":1315,"_31098":1304,"_21528":54880,"_5":14794,"_28279":54849,"_3062":54881},[],"Previously verified server root, chain or pin and TLS name.",{"_3607":1316,"_31098":1304,"_21528":54883,"_5":14794,"_28279":54849,"_3062":54884},[],"DMS → requester",{"_3607":1317,"_31098":1304,"_21528":54886,"_5":14794,"_28279":54849,"_3062":54887},[],"CAs and rules authorizing initial or renewal credentials.",{"_3607":1318,"_31098":1304,"_21528":54889,"_5":14794,"_28279":54849,"_3062":54890},[],"Consumer → device",{"_3607":1319,"_31098":1304,"_21528":54892,"_5":14794,"_28279":54849,"_3062":54893},[],"Operational identity roots, intermediates, validation and permissions.",{"_3607":1320,"_31098":1304,"_21528":54895,"_5":14794,"_28279":54849,"_3062":54896},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3607":1321,"_31098":1304,"_21528":54898,"_5":14794,"_28279":54853,"_3062":54899},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3607":1322,"_31098":1304,"_21528":54901,"_5":14794,"_28279":54853,"_3062":54902},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3607":1323,"_31098":1304,"_21528":54904,"_5":14794,"_28279":54857,"_3062":54905},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3607":1324,"_31098":1304,"_21528":54907,"_5":14794,"_28279":54857,"_3062":54908},[],"Select policy-approved roots as anchors.",{"_3607":1325,"_31098":1304,"_21528":54910,"_5":14794,"_28279":54857,"_3062":54911},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3607":1326,"_31098":1304,"_21528":54913,"_5":14794,"_28279":54857,"_3062":54914},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3607":1327,"_31098":1304,"_21528":54916,"_5":14794,"_28279":54857,"_3062":54917},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3607":1328,"_31098":1304,"_21528":54919,"_5":14794,"_28279":54857,"_3062":54920},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3607":1329,"_31098":1304,"_21528":54922,"_5":14794,"_28279":54861,"_3062":54923},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3607":1330,"_31098":1304,"_21528":54925,"_5":14794,"_28279":54861,"_3062":54926},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3607":1331,"_31098":1304,"_21528":54928,"_5":14794,"_28279":54861,"_3062":54929},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3607":1332,"_31098":1304,"_21528":54931,"_5":14794,"_28279":54865,"_3062":54932},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3607":1333,"_31098":1333,"_5":15159,"_3062":54934,"_31457":54935,"_21528":54937,"_28279":1333},"AWS IoT Core",[50787,52299,53471,53469,54936],"Integrations",[],{"_3607":1334,"_31098":1333,"_21528":54939,"_5":14794,"_28279":1333,"_3062":54940},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3607":1335,"_31098":1333,"_5":31454,"_21528":54942,"_28279":54943,"_3062":54944},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3607":1336,"_31098":1333,"_5":31454,"_21528":54946,"_28279":54947,"_3062":54948},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3607":1337,"_31098":1333,"_5":31454,"_21528":54950,"_28279":54951,"_3062":54952},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3607":1338,"_31098":1333,"_5":31454,"_21528":54954,"_28279":54955,"_3062":54956},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3607":1339,"_31098":1333,"_5":31454,"_21528":54958,"_28279":54959,"_3062":54960},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3607":1340,"_31098":1333,"_5":31454,"_21528":54962,"_28279":54963,"_3062":54964},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3607":1341,"_31098":1333,"_5":31454,"_21528":54966,"_28279":54967,"_3062":54968},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3607":1342,"_31098":1333,"_5":31454,"_21528":54970,"_28279":54971,"_3062":54972},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3607":1343,"_31098":1333,"_5":31454,"_21528":54974,"_28279":54975,"_3062":54976},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3607":1344,"_31098":1333,"_5":31454,"_21528":54978,"_28279":54979,"_3062":54980},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3607":1345,"_31098":1333,"_5":31454,"_21528":54982,"_28279":54983,"_3062":54984},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3607":1346,"_31098":1333,"_5":31454,"_21528":54986,"_28279":54987,"_3062":54988},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3607":1347,"_31098":1333,"_5":31454,"_21528":54990,"_28279":54991,"_3062":54992},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3607":1348,"_31098":1333,"_5":31454,"_21528":54994,"_28279":54995,"_3062":54996},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3607":1349,"_31098":1333,"_5":31454,"_21528":54998,"_28279":54999,"_3062":55000},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3607":1350,"_31098":1333,"_5":31454,"_21528":55002,"_28279":55003,"_3062":55004},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3607":1351,"_31098":1333,"_5":31454,"_21528":55006,"_28279":55007,"_3062":55008},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3607":1352,"_31098":1333,"_5":31454,"_21528":55010,"_28279":55011,"_3062":55012},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3607":1353,"_31098":1333,"_5":31454,"_21528":55014,"_28279":55015,"_3062":55016},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3607":1354,"_31098":1333,"_5":31454,"_21528":55018,"_28279":55019,"_3062":55020},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3607":1355,"_31098":1333,"_5":31454,"_21528":55022,"_28279":55023,"_3062":55024},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3607":1356,"_31098":1333,"_5":31454,"_21528":55026,"_28279":55027,"_3062":55028},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3607":1357,"_31098":1333,"_5":31454,"_21528":55030,"_28279":55031,"_3062":55032},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3607":1358,"_31098":1333,"_5":31454,"_21528":55034,"_28279":55035,"_3062":55036},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3607":1359,"_31098":1333,"_5":31454,"_21528":55038,"_28279":55039,"_3062":55040},[],"/docs/pr-preview/pr-75/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3607":1360,"_31098":1333,"_21528":55042,"_5":14794,"_28279":1333,"_3062":55043},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3607":1361,"_31098":1333,"_21528":55045,"_5":14794,"_28279":1333,"_3062":55046},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3607":1362,"_31098":1333,"_21528":55048,"_5":14794,"_28279":1333,"_3062":55049},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3607":1363,"_31098":1333,"_21528":55051,"_5":14794,"_28279":54943,"_3062":55052},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3607":1364,"_31098":1333,"_21528":55054,"_5":14794,"_28279":54943,"_3062":55055},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3607":1365,"_31098":1333,"_21528":55057,"_5":14794,"_28279":54943,"_3062":55058},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3607":1366,"_31098":1333,"_21528":55060,"_5":14794,"_28279":54943,"_3062":55061},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3607":1367,"_31098":1333,"_21528":55063,"_5":14794,"_28279":54947,"_3062":55064},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3607":1368,"_31098":1333,"_21528":55066,"_5":14794,"_28279":54951,"_3062":55067},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3607":1369,"_31098":1333,"_21528":55069,"_5":14794,"_28279":54951,"_3062":55070},[],"IAM action",{"_3607":1370,"_31098":1333,"_21528":55072,"_5":14794,"_28279":54951,"_3062":51177},[],{"_3607":1371,"_31098":1333,"_21528":55074,"_5":14794,"_28279":54951,"_3062":55075},[],"`iot:GetRegistrationCode`",{"_3607":1372,"_31098":1333,"_21528":55077,"_5":14794,"_28279":54951,"_3062":55078},[],"Obtain the verification code for CA registration in the Primary Account",{"_3607":1373,"_31098":1333,"_21528":55080,"_5":14794,"_28279":54951,"_3062":55081},[],"`iot:RegisterCACertificate`",{"_3607":1374,"_31098":1333,"_21528":55083,"_5":14794,"_28279":54951,"_3062":55084},[],"Register the CA in AWS IoT",{"_3607":1375,"_31098":1333,"_21528":55086,"_5":14794,"_28279":54951,"_3062":55087},[],"`iot:DescribeCACertificate`",{"_3607":1376,"_31098":1333,"_21528":55089,"_5":14794,"_28279":54951,"_3062":55090},[],"Check the CA registration status",{"_3607":1377,"_31098":1333,"_21528":55092,"_5":14794,"_28279":54951,"_3062":55093},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3607":1378,"_31098":1333,"_21528":55095,"_5":14794,"_28279":54951,"_3062":55096},[],"Create or update Things in IoT Core",{"_3607":1379,"_31098":1333,"_21528":55098,"_5":14794,"_28279":54951,"_3062":55099},[],"`iot:RegisterThing`",{"_3607":1380,"_31098":1333,"_21528":55101,"_5":14794,"_28279":54951,"_3062":55102},[],"Provision Things through a template",{"_3607":1381,"_31098":1333,"_21528":55104,"_5":14794,"_28279":54951,"_3062":55105},[],"`iot:RegisterCertificate`",{"_3607":1382,"_31098":1333,"_21528":55107,"_5":14794,"_28279":54951,"_3062":55108},[],"Register device certificates",{"_3607":1383,"_31098":1333,"_21528":55110,"_5":14794,"_28279":54951,"_3062":55111},[],"`iot:UpdateCertificate`",{"_3607":1384,"_31098":1333,"_21528":55113,"_5":14794,"_28279":54951,"_3062":55114},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3607":1385,"_31098":1333,"_21528":55116,"_5":14794,"_28279":54951,"_3062":55117},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3607":1386,"_31098":1333,"_21528":55119,"_5":14794,"_28279":54951,"_3062":55120},[],"Create and attach IoT policies",{"_3607":1387,"_31098":1333,"_21528":55122,"_5":14794,"_28279":54951,"_3062":55123},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3607":1388,"_31098":1333,"_21528":55125,"_5":14794,"_28279":54951,"_3062":55126},[],"Manage Thing groups",{"_3607":1389,"_31098":1333,"_21528":55128,"_5":14794,"_28279":54951,"_3062":55129},[],"`iot:CreateProvisioningTemplate`",{"_3607":1390,"_31098":1333,"_21528":55131,"_5":14794,"_28279":54951,"_3062":55132},[],"Create JITP templates",{"_3607":1391,"_31098":1333,"_21528":55134,"_5":14794,"_28279":54951,"_3062":55135},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3607":1392,"_31098":1333,"_21528":55137,"_5":14794,"_28279":54951,"_3062":55138},[],"Read and write the Device Shadow",{"_3607":1393,"_31098":1333,"_21528":55140,"_5":14794,"_28279":54951,"_3062":55141},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3607":1394,"_31098":1333,"_21528":55143,"_5":14794,"_28279":54955,"_3062":55144},[],"Parameter",{"_3607":1395,"_31098":1333,"_21528":55146,"_5":14794,"_28279":54955,"_3062":55147},[],"Type",{"_3607":1396,"_31098":1333,"_21528":55149,"_5":14794,"_28279":54955,"_3062":55150},[],"Required",{"_3607":1397,"_31098":1333,"_21528":55152,"_5":14794,"_28279":54955,"_3062":55153},[],"Description",{"_3607":1398,"_31098":1333,"_21528":55155,"_5":14794,"_28279":54955,"_3062":55156},[],"`connector_id`",{"_3607":1399,"_31098":1333,"_21528":55158,"_5":14794,"_28279":54955,"_3062":25703},[],{"_3607":1400,"_31098":1333,"_21528":55160,"_5":14794,"_28279":54955,"_3062":55161},[],"Yes",{"_3607":1401,"_31098":1333,"_21528":55163,"_5":14794,"_28279":54955,"_3062":55164},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3607":1402,"_31098":1333,"_21528":55166,"_5":14794,"_28279":54955,"_3062":55167},[],"`aws_config.region`",{"_3607":1403,"_31098":1333,"_21528":55169,"_5":14794,"_28279":54955,"_3062":25703},[],{"_3607":1404,"_31098":1333,"_21528":55171,"_5":14794,"_28279":54955,"_3062":55161},[],{"_3607":1405,"_31098":1333,"_21528":55173,"_5":14794,"_28279":54955,"_3062":55174},[],"AWS region where the connector operates.",{"_3607":1406,"_31098":1333,"_21528":55176,"_5":14794,"_28279":54955,"_3062":55177},[],"`aws_config.auth_method`",{"_3607":1407,"_31098":1333,"_21528":55179,"_5":14794,"_28279":54955,"_3062":25703},[],{"_3607":1408,"_31098":1333,"_21528":55181,"_5":14794,"_28279":54955,"_3062":55161},[],{"_3607":1409,"_31098":1333,"_21528":55183,"_5":14794,"_28279":54955,"_3062":55184},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3607":1410,"_31098":1333,"_21528":55186,"_5":14794,"_28279":54955,"_3062":55187},[],"`aws_config.access_key_id`",{"_3607":1411,"_31098":1333,"_21528":55189,"_5":14794,"_28279":54955,"_3062":25703},[],{"_3607":1412,"_31098":1333,"_21528":55191,"_5":14794,"_28279":54955,"_3062":55192},[],"Only with `auth_method=static`",{"_3607":1413,"_31098":1333,"_21528":55194,"_5":14794,"_28279":54955,"_3062":55195},[],"AWS access key.",{"_3607":1414,"_31098":1333,"_21528":55197,"_5":14794,"_28279":54955,"_3062":55198},[],"`aws_config.secret_access_key`",{"_3607":1415,"_31098":1333,"_21528":55200,"_5":14794,"_28279":54955,"_3062":25703},[],{"_3607":1416,"_31098":1333,"_21528":55202,"_5":14794,"_28279":54955,"_3062":55192},[],{"_3607":1417,"_31098":1333,"_21528":55204,"_5":14794,"_28279":54955,"_3062":55205},[],"AWS secret key.",{"_3607":1418,"_31098":1333,"_21528":55207,"_5":14794,"_28279":54955,"_3062":55208},[],"`aws_config.session_token`",{"_3607":1419,"_31098":1333,"_21528":55210,"_5":14794,"_28279":54955,"_3062":25703},[],{"_3607":1420,"_31098":1333,"_21528":55212,"_5":14794,"_28279":54955,"_3062":55213},[],"No",{"_3607":1421,"_31098":1333,"_21528":55215,"_5":14794,"_28279":54955,"_3062":55216},[],"Session token (with `auth_method=static`).",{"_3607":1422,"_31098":1333,"_21528":55218,"_5":14794,"_28279":54955,"_3062":55219},[],"`aws_config.role_arn`",{"_3607":1423,"_31098":1333,"_21528":55221,"_5":14794,"_28279":54955,"_3062":25703},[],{"_3607":1424,"_31098":1333,"_21528":55223,"_5":14794,"_28279":54955,"_3062":55224},[],"Only with `auth_method=role`",{"_3607":1425,"_31098":1333,"_21528":55226,"_5":14794,"_28279":54955,"_3062":55227},[],"ARN of the role to assume.",{"_3607":1426,"_31098":1333,"_21528":55229,"_5":14794,"_28279":54955,"_3062":55230},[],"`aws_config.endpoint_url`",{"_3607":1427,"_31098":1333,"_21528":55232,"_5":14794,"_28279":54955,"_3062":25703},[],{"_3607":1428,"_31098":1333,"_21528":55234,"_5":14794,"_28279":54955,"_3062":55213},[],{"_3607":1429,"_31098":1333,"_21528":55236,"_5":14794,"_28279":54955,"_3062":55237},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3607":1430,"_31098":1333,"_21528":55239,"_5":14794,"_28279":54955,"_3062":55240},[],"`subscriber_event_bus`",{"_3607":1431,"_31098":1333,"_21528":55242,"_5":14794,"_28279":54955,"_3062":18129},[],{"_3607":1432,"_31098":1333,"_21528":55244,"_5":14794,"_28279":54955,"_3062":55161},[],{"_3607":1433,"_31098":1333,"_21528":55246,"_5":14794,"_28279":54955,"_3062":55247},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3607":1434,"_31098":1333,"_21528":55249,"_5":14794,"_28279":54955,"_3062":55250},[],"`dms_manager_client`",{"_3607":1435,"_31098":1333,"_21528":55252,"_5":14794,"_28279":54955,"_3062":25703},[],{"_3607":1436,"_31098":1333,"_21528":55254,"_5":14794,"_28279":54955,"_3062":55161},[],{"_3607":1437,"_31098":1333,"_21528":55256,"_5":14794,"_28279":54955,"_3062":55257},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3607":1438,"_31098":1333,"_21528":55259,"_5":14794,"_28279":54955,"_3062":55260},[],"`device_manager_client`",{"_3607":1439,"_31098":1333,"_21528":55262,"_5":14794,"_28279":54955,"_3062":25703},[],{"_3607":1440,"_31098":1333,"_21528":55264,"_5":14794,"_28279":54955,"_3062":55161},[],{"_3607":1441,"_31098":1333,"_21528":55266,"_5":14794,"_28279":54955,"_3062":55267},[],"HTTP URL of Lamassu's Device Manager.",{"_3607":1442,"_31098":1333,"_21528":55269,"_5":14794,"_28279":54955,"_3062":55270},[],"`ca_client`",{"_3607":1443,"_31098":1333,"_21528":55272,"_5":14794,"_28279":54955,"_3062":25703},[],{"_3607":1444,"_31098":1333,"_21528":55274,"_5":14794,"_28279":54955,"_3062":55161},[],{"_3607":1445,"_31098":1333,"_21528":55276,"_5":14794,"_28279":54955,"_3062":55277},[],"HTTP URL of Lamassu's CA service.",{"_3607":1446,"_31098":1333,"_21528":55279,"_5":14794,"_28279":54959,"_3062":55280},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3607":1447,"_31098":1333,"_21528":55282,"_5":14794,"_28279":54959,"_3062":55283},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3607":1448,"_31098":1333,"_21528":55285,"_5":14794,"_28279":54959,"_3062":55286},[],"CloudEvent type",{"_3607":1449,"_31098":1333,"_21528":55288,"_5":14794,"_28279":54959,"_3062":55289},[],"Lamassu resource",{"_3607":1450,"_31098":1333,"_21528":55291,"_5":14794,"_28279":54959,"_3062":55292},[],"AWS Resource",{"_3607":1451,"_31098":1333,"_21528":55294,"_5":14794,"_28279":54959,"_3062":55295},[],"IAM actions",{"_3607":1452,"_31098":1333,"_21528":55297,"_5":14794,"_28279":54959,"_3062":55298},[],"AWS calls and effect",{"_3607":1453,"_31098":1333,"_21528":55300,"_5":14794,"_28279":54959,"_3062":55301},[],"Where in this page",{"_3607":1454,"_31098":1333,"_21528":55303,"_5":14794,"_28279":54959,"_3062":55304},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3607":1455,"_31098":1333,"_21528":55306,"_5":14794,"_28279":54959,"_3062":55307},[],"CA",{"_3607":1456,"_31098":1333,"_21528":55309,"_5":14794,"_28279":54959,"_3062":55310},[],"`IoTCore/CACertificate`",{"_3607":1457,"_31098":1333,"_21528":55312,"_5":14794,"_28279":54959,"_3062":55313},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3607":1458,"_31098":1333,"_21528":55315,"_5":14794,"_28279":54959,"_3062":55316},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3607":1459,"_31098":1333,"_21528":55318,"_5":14794,"_28279":54959,"_3062":54972},[],{"_3607":1460,"_31098":1333,"_21528":55320,"_5":14794,"_28279":54959,"_3062":55321},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3607":1461,"_31098":1333,"_21528":55323,"_5":14794,"_28279":54959,"_3062":55324},[],"DMS",{"_3607":1462,"_31098":1333,"_21528":55326,"_5":14794,"_28279":54959,"_3062":55327},[],"`IoTCore/ProvisioningTemplate`",{"_3607":1463,"_31098":1333,"_21528":55329,"_5":14794,"_28279":54959,"_3062":55330},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3607":1464,"_31098":1333,"_21528":55332,"_5":14794,"_28279":54959,"_3062":55333},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3607":1465,"_31098":1333,"_21528":55335,"_5":14794,"_28279":54959,"_3062":55000},[],{"_3607":1466,"_31098":1333,"_21528":55337,"_5":14794,"_28279":54959,"_3062":55338},[],"`EventBindDeviceIdentityKey`",{"_3607":1467,"_31098":1333,"_21528":55340,"_5":14794,"_28279":54959,"_3062":55341},[],"Device",{"_3607":1468,"_31098":1333,"_21528":55343,"_5":14794,"_28279":54959,"_3062":55344},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3607":1469,"_31098":1333,"_21528":55346,"_5":14794,"_28279":54959,"_3062":55347},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3607":1470,"_31098":1333,"_21528":55349,"_5":14794,"_28279":54959,"_3062":55350},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3607":1471,"_31098":1333,"_21528":55352,"_5":14794,"_28279":54959,"_3062":55008},[],{"_3607":1472,"_31098":1333,"_21528":55354,"_5":14794,"_28279":54959,"_3062":55355},[],"`EventUpdateCertificateStatusKey`",{"_3607":1473,"_31098":1333,"_21528":55357,"_5":14794,"_28279":54959,"_3062":55358},[],"Certificate",{"_3607":1474,"_31098":1333,"_21528":55360,"_5":14794,"_28279":54959,"_3062":55361},[],"`IoTCore/Certificate`",{"_3607":1475,"_31098":1333,"_21528":55363,"_5":14794,"_28279":54959,"_3062":55364},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3607":1476,"_31098":1333,"_21528":55366,"_5":14794,"_28279":54959,"_3062":55367},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3607":1477,"_31098":1333,"_21528":55369,"_5":14794,"_28279":54959,"_3062":55020},[],{"_3607":1478,"_31098":1333,"_21528":55371,"_5":14794,"_28279":54959,"_3062":55372},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3607":1479,"_31098":1333,"_21528":55374,"_5":14794,"_28279":54959,"_3062":55375},[],"Certificate / Device",{"_3607":1480,"_31098":1333,"_21528":55377,"_5":14794,"_28279":54959,"_3062":55378},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3607":1481,"_31098":1333,"_21528":55380,"_5":14794,"_28279":54959,"_3062":51183},[],{"_3607":1482,"_31098":1333,"_21528":55382,"_5":14794,"_28279":54959,"_3062":55383},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3607":1483,"_31098":1333,"_21528":55385,"_5":14794,"_28279":54959,"_3062":55028},[],{"_3607":1484,"_31098":1333,"_21528":55387,"_5":14794,"_28279":54963,"_3062":55388},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3607":1485,"_31098":1333,"_21528":55390,"_5":14794,"_28279":54967,"_3062":55391},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3607":1486,"_31098":1333,"_21528":55393,"_5":14794,"_28279":54967,"_3062":55394},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3607":1487,"_31098":1333,"_21528":55396,"_5":14794,"_28279":54971,"_3062":55397},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3607":1488,"_31098":1333,"_21528":55399,"_5":14794,"_28279":54971,"_3062":55400},[],"Transition",{"_3607":1489,"_31098":1333,"_21528":55402,"_5":14794,"_28279":54971,"_3062":55403},[],"AWS calls",{"_3607":1490,"_31098":1333,"_21528":55405,"_5":14794,"_28279":54971,"_3062":55406},[],"`NotRegistered` → `Requested`",{"_3607":1491,"_31098":1333,"_21528":55408,"_5":14794,"_28279":54971,"_3062":55409},[],"none (metadata write only)",{"_3607":1492,"_31098":1333,"_21528":55411,"_5":14794,"_28279":54971,"_3062":55412},[],"`Requested` → `Registering`",{"_3607":1493,"_31098":1333,"_21528":55414,"_5":14794,"_28279":54971,"_3062":55415},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3607":1494,"_31098":1333,"_21528":55417,"_5":14794,"_28279":54971,"_3062":55418},[],"`Registering` → `Succeeded`",{"_3607":1495,"_31098":1333,"_21528":55420,"_5":14794,"_28279":54971,"_3062":55421},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3607":1496,"_31098":1333,"_21528":55423,"_5":14794,"_28279":54971,"_3062":55424},[],"`Registering` → `Failed`",{"_3607":1497,"_31098":1333,"_21528":55426,"_5":14794,"_28279":54971,"_3062":55427},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3607":1498,"_31098":1333,"_21528":55429,"_5":14794,"_28279":54971,"_3062":55430},[],"`Failed` / `Succeeded` → `Requested`",{"_3607":1499,"_31098":1333,"_21528":55432,"_5":14794,"_28279":54971,"_3062":55433},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3607":1500,"_31098":1333,"_21528":55435,"_5":14794,"_28279":54975,"_3062":55436},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3607":1501,"_31098":1333,"_21528":55438,"_5":14794,"_28279":54975,"_3062":55439},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3607":1502,"_31098":1333,"_21528":55441,"_5":14794,"_28279":54975,"_3062":55442},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3607":1503,"_31098":1333,"_21528":55444,"_5":14794,"_28279":54975,"_3062":55445},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3607":1504,"_31098":1333,"_21528":55447,"_5":14794,"_28279":54975,"_3062":55448},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3607":1505,"_31098":1333,"_21528":55450,"_5":14794,"_28279":54975,"_3062":55451},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3607":1506,"_31098":1333,"_21528":55453,"_5":14794,"_28279":54979,"_3062":55454},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3607":1507,"_31098":1333,"_21528":55456,"_5":14794,"_28279":54983,"_3062":55457},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3607":1508,"_31098":1333,"_21528":55459,"_5":14794,"_28279":54983,"_3062":55460},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3607":1509,"_31098":1333,"_21528":55462,"_5":14794,"_28279":54987,"_3062":55463},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3607":1510,"_31098":1333,"_21528":55465,"_5":14794,"_28279":54991,"_3062":55466},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3607":1511,"_31098":1333,"_21528":55468,"_5":14794,"_28279":54991,"_3062":55469},[],"Creates or updates the IoT policies configured in the DMS.",{"_3607":1512,"_31098":1333,"_21528":55471,"_5":14794,"_28279":54991,"_3062":55472},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3607":1513,"_31098":1333,"_21528":55474,"_5":14794,"_28279":54991,"_3062":55475},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3607":1514,"_31098":1333,"_21528":55477,"_5":14794,"_28279":54991,"_3062":55478},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3607":1515,"_31098":1333,"_21528":55480,"_5":14794,"_28279":54991,"_3062":55481},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3607":1516,"_31098":1333,"_21528":55483,"_5":14794,"_28279":54991,"_3062":55484},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3607":1517,"_31098":1333,"_21528":55486,"_5":14794,"_28279":54995,"_3062":55487},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3607":1518,"_31098":1333,"_21528":55489,"_5":14794,"_28279":54995,"_3062":55490},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3607":1519,"_31098":1333,"_21528":55492,"_5":14794,"_28279":54995,"_3062":55493},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3607":1520,"_31098":1333,"_21528":55495,"_5":14794,"_28279":54995,"_3062":55496},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3607":1521,"_31098":1333,"_21528":55498,"_5":14794,"_28279":54995,"_3062":55499},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3607":1522,"_31098":1333,"_21528":55501,"_5":14794,"_28279":54999,"_3062":55502},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3607":1523,"_31098":1333,"_21528":55504,"_5":14794,"_28279":54999,"_3062":55400},[],{"_3607":1524,"_31098":1333,"_21528":55506,"_5":14794,"_28279":54999,"_3062":55403},[],{"_3607":1525,"_31098":1333,"_21528":55508,"_5":14794,"_28279":54999,"_3062":55509},[],"`Unconfigured` → `None` / `Auto`",{"_3607":1526,"_31098":1333,"_21528":55511,"_5":14794,"_28279":54999,"_3062":55512},[],"none (configuration only)",{"_3607":1527,"_31098":1333,"_21528":55514,"_5":14794,"_28279":54999,"_3062":55515},[],"`None` ↔ `Auto`",{"_3607":1528,"_31098":1333,"_21528":55517,"_5":14794,"_28279":54999,"_3062":55512},[],{"_3607":1529,"_31098":1333,"_21528":55519,"_5":14794,"_28279":54999,"_3062":55520},[],"Any → `Jitp`",{"_3607":1530,"_31098":1333,"_21528":55522,"_5":14794,"_28279":54999,"_3062":55523},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3607":1531,"_31098":1333,"_21528":55525,"_5":14794,"_28279":54999,"_3062":55526},[],"`Jitp` → `None` / `Auto`",{"_3607":1532,"_31098":1333,"_21528":55528,"_5":14794,"_28279":54999,"_3062":55529},[],"none (the template stays in the AWS account)",{"_3607":1533,"_31098":1333,"_21528":55531,"_5":14794,"_28279":55003,"_3062":55532},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3607":1534,"_31098":1333,"_21528":55534,"_5":14794,"_28279":55003,"_3062":55535},[],"The full flow from the device's perspective is:",{"_3607":1535,"_31098":1333,"_21528":55537,"_5":14794,"_28279":55003,"_3062":55538},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3607":1536,"_31098":1333,"_21528":55540,"_5":14794,"_28279":55007,"_3062":55541},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3607":1537,"_31098":1333,"_21528":55543,"_5":14794,"_28279":55007,"_3062":55400},[],{"_3607":1538,"_31098":1333,"_21528":55545,"_5":14794,"_28279":55007,"_3062":55403},[],{"_3607":1539,"_31098":1333,"_21528":55547,"_5":14794,"_28279":55007,"_3062":55548},[],"`Absent` → `Provisioned`",{"_3607":1540,"_31098":1333,"_21528":55550,"_5":14794,"_28279":55007,"_3062":55551},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3607":1541,"_31098":1333,"_21528":55553,"_5":14794,"_28279":55007,"_3062":55554},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3607":1542,"_31098":1333,"_21528":55556,"_5":14794,"_28279":55007,"_3062":55557},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3607":1543,"_31098":1333,"_21528":55559,"_5":14794,"_28279":55007,"_3062":55560},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3607":1544,"_31098":1333,"_21528":55562,"_5":14794,"_28279":55011,"_3062":55563},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3607":1545,"_31098":1333,"_21528":55565,"_5":14794,"_28279":55011,"_3062":55566},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3607":1546,"_31098":1333,"_21528":55568,"_5":14794,"_28279":55011,"_3062":55569},[],"For the JITP flow to work correctly:",{"_3607":1547,"_31098":1333,"_21528":55571,"_5":14794,"_28279":55011,"_3062":55572},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3607":1548,"_31098":1333,"_21528":55574,"_5":14794,"_28279":55011,"_3062":55575},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3607":1549,"_31098":1333,"_21528":55577,"_5":14794,"_28279":55011,"_3062":55578},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3607":1550,"_31098":1333,"_21528":55580,"_5":14794,"_28279":55011,"_3062":55581},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3607":1551,"_31098":1333,"_21528":55583,"_5":14794,"_28279":55015,"_3062":55584},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3607":1552,"_31098":1333,"_21528":55586,"_5":14794,"_28279":55015,"_3062":55587},[],"Status in Lamassu",{"_3607":1553,"_31098":1333,"_21528":55589,"_5":14794,"_28279":55015,"_3062":55590},[],"Revocation reason",{"_3607":1554,"_31098":1333,"_21528":55592,"_5":14794,"_28279":55015,"_3062":55593},[],"Status in AWS IoT Core",{"_3607":1555,"_31098":1333,"_21528":55595,"_5":14794,"_28279":55015,"_3062":55596},[],"`Active`",{"_3607":1556,"_31098":1333,"_21528":55598,"_5":14794,"_28279":55015,"_3062":55599},[],"None",{"_3607":1557,"_31098":1333,"_21528":55601,"_5":14794,"_28279":55015,"_3062":55602},[],"`ACTIVE`",{"_3607":1558,"_31098":1333,"_21528":55604,"_5":14794,"_28279":55015,"_3062":55605},[],"`Revoked`",{"_3607":1559,"_31098":1333,"_21528":55607,"_5":14794,"_28279":55015,"_3062":55608},[],"`certificateHold`",{"_3607":1560,"_31098":1333,"_21528":55610,"_5":14794,"_28279":55015,"_3062":55611},[],"`INACTIVE`",{"_3607":1561,"_31098":1333,"_21528":55613,"_5":14794,"_28279":55015,"_3062":55605},[],{"_3607":1562,"_31098":1333,"_21528":55615,"_5":14794,"_28279":55015,"_3062":55616},[],"Any other reason",{"_3607":1563,"_31098":1333,"_21528":55618,"_5":14794,"_28279":55015,"_3062":55619},[],"`REVOKED`",{"_3607":1564,"_31098":1333,"_21528":55621,"_5":14794,"_28279":55015,"_3062":55622},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3607":1565,"_31098":1333,"_21528":55624,"_5":14794,"_28279":55019,"_3062":55625},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3607":1566,"_31098":1333,"_21528":55627,"_5":14794,"_28279":55019,"_3062":55400},[],{"_3607":1567,"_31098":1333,"_21528":55629,"_5":14794,"_28279":55019,"_3062":55403},[],{"_3607":1568,"_31098":1333,"_21528":55631,"_5":14794,"_28279":55019,"_3062":55632},[],"`NotSynced` → `Active`",{"_3607":1569,"_31098":1333,"_21528":55634,"_5":14794,"_28279":55019,"_3062":55111},[],{"_3607":1570,"_31098":1333,"_21528":55636,"_5":14794,"_28279":55019,"_3062":55637},[],"`Active` → `Inactive`",{"_3607":1571,"_31098":1333,"_21528":55639,"_5":14794,"_28279":55019,"_3062":55640},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3607":1572,"_31098":1333,"_21528":55642,"_5":14794,"_28279":55019,"_3062":55643},[],"`Active` → `Revoked`",{"_3607":1573,"_31098":1333,"_21528":55645,"_5":14794,"_28279":55019,"_3062":55640},[],{"_3607":1574,"_31098":1333,"_21528":55647,"_5":14794,"_28279":55019,"_3062":55648},[],"`Inactive` / `Revoked` → `Active`",{"_3607":1575,"_31098":1333,"_21528":55650,"_5":14794,"_28279":55019,"_3062":55111},[],{"_3607":1576,"_31098":1333,"_21528":55652,"_5":14794,"_28279":55019,"_3062":55653},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3607":1577,"_31098":1333,"_21528":55655,"_5":14794,"_28279":55019,"_3062":55656},[],"none (these states are not synced to AWS)",{"_3607":1578,"_31098":1333,"_21528":55658,"_5":14794,"_28279":55023,"_3062":55659},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3607":1579,"_31098":1333,"_21528":55661,"_5":14794,"_28279":55023,"_3062":55662},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3607":1580,"_31098":1333,"_21528":55664,"_5":14794,"_28279":55023,"_3062":55665},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3607":1581,"_31098":1333,"_21528":55667,"_5":14794,"_28279":55027,"_3062":55668},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3607":1582,"_31098":1333,"_21528":55670,"_5":14794,"_28279":55027,"_3062":55671},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3607":1583,"_31098":1333,"_21528":55673,"_5":14794,"_28279":55031,"_3062":55674},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3607":1584,"_31098":1333,"_21528":55676,"_5":14794,"_28279":55031,"_3062":55677},[],"There are two action types:",{"_3607":1585,"_31098":1333,"_21528":55679,"_5":14794,"_28279":55031,"_3062":55680},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3607":1586,"_31098":1333,"_21528":55682,"_5":14794,"_28279":55031,"_3062":55683},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3607":1587,"_31098":1333,"_21528":55685,"_5":14794,"_28279":55031,"_3062":55686},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3607":1588,"_31098":1333,"_21528":55688,"_5":14794,"_28279":55035,"_3062":55689},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3607":1589,"_31098":1333,"_21528":55691,"_5":14794,"_28279":55035,"_3062":55692},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3607":1590,"_31098":1333,"_21528":55694,"_5":14794,"_28279":55035,"_3062":55695},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3607":1591,"_31098":1333,"_21528":55697,"_5":14794,"_28279":55039,"_3062":55698},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3607":1592,"_31098":1333,"_21528":55700,"_5":14794,"_28279":55039,"_3062":55701},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3607":1593,"_31098":1333,"_21528":55703,"_5":14794,"_28279":55039,"_3062":55704},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3607":1594,"_31098":1333,"_21528":55706,"_5":14794,"_28279":55039,"_3062":55707},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3607":1595,"_31098":1333,"_21528":55709,"_5":14794,"_28279":55039,"_3062":55710},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3607":1596,"_31098":1333,"_21528":55712,"_5":14794,"_28279":55039,"_3062":55713},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3607":1597,"_31098":1333,"_21528":55715,"_5":14794,"_28279":55039,"_3062":55716},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3607":1598,"_31098":1333,"_21528":55718,"_5":14794,"_28279":55039,"_3062":55719},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3607":1599,"_31098":1333,"_21528":55721,"_5":14794,"_28279":55039,"_3062":55722},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3607":1600,"_31098":1333,"_21528":55724,"_5":14794,"_28279":55039,"_3062":55725},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3607":1601,"_31098":1333,"_21528":55727,"_5":14794,"_28279":55039,"_3062":55728},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3607":1602,"_31098":1333,"_21528":55730,"_5":14794,"_28279":55039,"_3062":55731},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3607":1603,"_31098":1333,"_21528":55733,"_5":14794,"_28279":55039,"_3062":55734},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3607":1604,"_31098":1333,"_21528":55736,"_5":14794,"_28279":55039,"_3062":55737},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3607":1605,"_31098":1333,"_21528":55739,"_5":14794,"_28279":55039,"_3062":55740},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3607":1606,"_31098":1333,"_21528":55742,"_5":14794,"_28279":55039,"_3062":55743},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3607":1607,"_31098":1333,"_21528":55745,"_5":14794,"_28279":55039,"_3062":55746},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3607":1608,"_31098":1333,"_21528":55748,"_5":14794,"_28279":55039,"_3062":55749},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3607":1609,"_31098":1333,"_21528":55751,"_5":14794,"_28279":55039,"_3062":55752},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3607":1610,"_31098":1333,"_21528":55754,"_5":14794,"_28279":55039,"_3062":55755},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3607":1611,"_31098":1333,"_21528":55757,"_5":14794,"_28279":55039,"_3062":55758},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3607":1612,"_31098":1333,"_21528":55760,"_5":14794,"_28279":55039,"_3062":55761},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3607":1613,"_31098":1333,"_21528":55763,"_5":14794,"_28279":55039,"_3062":55764},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3607":1614,"_31098":1333,"_21528":55766,"_5":14794,"_28279":55039,"_3062":55767},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3607":1615,"_31098":1615,"_5":15159,"_3062":53471,"_31457":55769,"_21528":55770,"_28279":1615},[50787,52299,53471],[],{"_3607":1616,"_31098":1615,"_21528":55772,"_5":14794,"_28279":1615,"_3062":55773},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3607":1617,"_31098":1615,"_5":31454,"_21528":55775,"_28279":55776,"_3062":55777},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#start-here","Start here",{"_3607":1618,"_31098":1615,"_5":31454,"_21528":55779,"_28279":55780,"_3062":53469},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#devices-and-identities",{"_3607":1619,"_31098":1615,"_5":31454,"_21528":55782,"_28279":55783,"_3062":53655},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#enrollment-with-pki",{"_3607":1620,"_31098":1615,"_5":31454,"_21528":55785,"_28279":55786,"_3062":54936},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#integrations",{"_3607":1621,"_31098":1615,"_5":31454,"_21528":55788,"_28279":55789,"_3062":55790},[],"/docs/pr-preview/pr-75/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3607":1622,"_31098":1615,"_21528":55792,"_5":14794,"_28279":1615,"_3062":55793},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3607":1623,"_31098":1615,"_21528":55795,"_5":14794,"_28279":55776,"_3062":55796},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3607":1624,"_31098":1615,"_21528":55798,"_5":14794,"_28279":55776,"_3062":55799},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3607":1625,"_31098":1615,"_21528":55801,"_5":14794,"_28279":55780,"_3062":55802},[],"Resource",{"_3607":1626,"_31098":1615,"_21528":55804,"_5":14794,"_28279":55780,"_3062":55805},[],"What it represents",{"_3607":1627,"_31098":1615,"_21528":55807,"_5":14794,"_28279":55780,"_3062":55808},[],"**Device**",{"_3607":1628,"_31098":1615,"_21528":55810,"_5":14794,"_28279":55780,"_3062":55811},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3607":1629,"_31098":1615,"_21528":55813,"_5":14794,"_28279":55780,"_3062":55814},[],"**Identity**",{"_3607":1630,"_31098":1615,"_21528":55816,"_5":14794,"_28279":55780,"_3062":55817},[],"The device's association with its certificates: an active version and a history.",{"_3607":1631,"_31098":1615,"_21528":55819,"_5":14794,"_28279":55780,"_3062":55820},[],"**DMS**",{"_3607":1632,"_31098":1615,"_21528":55822,"_5":14794,"_28279":55780,"_3062":55823},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3607":1633,"_31098":1615,"_21528":55825,"_5":14794,"_28279":55780,"_3062":55826},[],"**Fleet**",{"_3607":1634,"_31098":1615,"_21528":55828,"_5":14794,"_28279":55780,"_3062":55829},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3607":1635,"_31098":1615,"_21528":55831,"_5":14794,"_28279":55780,"_3062":55832},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3607":1636,"_31098":1615,"_21528":55834,"_5":14794,"_28279":55780,"_3062":55835},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3607":1637,"_31098":1615,"_21528":55837,"_5":14794,"_28279":55783,"_3062":55838},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3607":1638,"_31098":1615,"_21528":55840,"_5":14794,"_28279":55783,"_3062":55841},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3607":1639,"_31098":1615,"_21528":55843,"_5":14794,"_28279":55783,"_3062":55844},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3607":1640,"_31098":1615,"_21528":55846,"_5":14794,"_28279":55783,"_3062":55847},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3607":1641,"_31098":1615,"_21528":55849,"_5":14794,"_28279":55783,"_3062":55850},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3607":1642,"_31098":1615,"_21528":55852,"_5":14794,"_28279":55783,"_3062":55853},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3607":1643,"_31098":1615,"_21528":55855,"_5":14794,"_28279":55783,"_3062":55856},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3607":1644,"_31098":1615,"_21528":55858,"_5":14794,"_28279":55783,"_3062":55859},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3607":1645,"_31098":1615,"_21528":55861,"_5":14794,"_28279":55786,"_3062":55862},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3607":1646,"_31098":1615,"_21528":55864,"_5":14794,"_28279":55786,"_3062":55865},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3607":1647,"_31098":1615,"_21528":55867,"_5":14794,"_28279":55789,"_3062":55868},[],"Participant",{"_3607":1648,"_31098":1615,"_21528":55870,"_5":14794,"_28279":55789,"_3062":55871},[],"Responsibility",{"_3607":1649,"_31098":1615,"_21528":55873,"_5":14794,"_28279":55789,"_3062":55874},[],"PKI administrator",{"_3607":1650,"_31098":1615,"_21528":55876,"_5":14794,"_28279":55789,"_3062":55877},[],"CA, issuance profile, chain and revocation publication.",{"_3607":1651,"_31098":1615,"_21528":55879,"_5":14794,"_28279":55789,"_3062":55880},[],"Provisioning administrator",{"_3607":1652,"_31098":1615,"_21528":55882,"_5":14794,"_28279":55789,"_3062":55883},[],"DMS, admission, authentication per operation and inventory.",{"_3607":1653,"_31098":1615,"_21528":55885,"_5":14794,"_28279":55789,"_3062":55886},[],"Device integrator",{"_3607":1654,"_31098":1615,"_21528":55888,"_5":14794,"_28279":55789,"_3062":55889},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3607":1655,"_31098":1615,"_21528":55891,"_5":14794,"_28279":55789,"_3062":55892},[],"Consumer integrator",{"_3607":1656,"_31098":1615,"_21528":55894,"_5":14794,"_28279":55789,"_3062":55895},[],"Trusted issuers, validation and device permissions in the destination.",{"_3607":1657,"_31098":1615,"_21528":55897,"_5":14794,"_28279":55789,"_3062":55898},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3607":1658,"_31098":1658,"_5":15159,"_3062":55900,"_31457":55901,"_21528":55903,"_28279":1658},"Enroll and connect your first device",[50787,52299,53471,55902],"Getting started",[],{"_3607":1659,"_31098":1658,"_21528":55905,"_5":14794,"_28279":1658,"_3062":55906},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3607":1660,"_31098":1658,"_5":31454,"_21528":55908,"_28279":55909,"_3062":50797},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3607":1661,"_31098":1658,"_5":31454,"_21528":55911,"_28279":55912,"_3062":55913},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3607":1662,"_31098":1658,"_5":31454,"_21528":55915,"_28279":55916,"_3062":55917},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3607":1663,"_31098":1658,"_5":31454,"_21528":55919,"_28279":55920,"_3062":55921},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3607":1664,"_31098":1658,"_5":31454,"_21528":55923,"_28279":55924,"_3062":55925},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3607":1665,"_31098":1658,"_5":31454,"_21528":55927,"_28279":55928,"_3062":55929},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3607":1666,"_31098":1658,"_5":31454,"_21528":55931,"_28279":55932,"_3062":55933},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3607":1667,"_31098":1658,"_5":31454,"_21528":55935,"_28279":55936,"_3062":55937},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3607":1668,"_31098":1658,"_21528":55939,"_5":14794,"_28279":1658,"_3062":55940},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3607":1669,"_31098":1658,"_21528":55942,"_5":14794,"_28279":55909,"_3062":55943},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3607":1670,"_31098":1658,"_21528":55945,"_5":14794,"_28279":55909,"_3062":55946},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3607":1671,"_31098":1658,"_21528":55948,"_5":14794,"_28279":55909,"_3062":55949},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3607":1672,"_31098":1658,"_21528":55951,"_5":14794,"_28279":55909,"_3062":55952},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3607":1673,"_31098":1658,"_21528":55954,"_5":14794,"_28279":55909,"_3062":55955},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3607":1674,"_31098":1658,"_21528":55957,"_5":14794,"_28279":55912,"_3062":55958},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3607":1675,"_31098":1658,"_21528":55960,"_5":14794,"_28279":55912,"_3062":55961},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3607":1676,"_31098":1658,"_21528":55963,"_5":14794,"_28279":55916,"_3062":55964},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3607":1677,"_31098":1658,"_21528":55966,"_5":14794,"_28279":55916,"_3062":55967},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3607":1678,"_31098":1658,"_21528":55969,"_5":14794,"_28279":55916,"_3062":55970},[],"Setting",{"_3607":1679,"_31098":1658,"_21528":55972,"_5":14794,"_28279":55916,"_3062":55973},[],"Evaluation value",{"_3607":1680,"_31098":1658,"_21528":55975,"_5":14794,"_28279":55916,"_3062":55976},[],"Enrollment CA",{"_3607":1681,"_31098":1658,"_21528":55978,"_5":14794,"_28279":55916,"_3062":55979},[],"Issuing root from `device-root.pem`.",{"_3607":1682,"_31098":1658,"_21528":55981,"_5":14794,"_28279":55916,"_3062":53785},[],{"_3607":1683,"_31098":1658,"_21528":55983,"_5":14794,"_28279":55916,"_3062":55984},[],"The 1-hour leaf profile you just prepared.",{"_3607":1684,"_31098":1658,"_21528":55986,"_5":14794,"_28279":55916,"_3062":55987},[],"Protocol / Registration Mode",{"_3607":1685,"_31098":1658,"_21528":55989,"_5":14794,"_28279":55916,"_3062":55990},[],"`EST_RFC7030` / `JITP`.",{"_3607":1686,"_31098":1658,"_21528":55992,"_5":14794,"_28279":55916,"_3062":55993},[],"Verify CSR Signature",{"_3607":1687,"_31098":1658,"_21528":55995,"_5":14794,"_28279":55916,"_3062":55996},[],"Enabled.",{"_3607":1688,"_31098":1658,"_21528":55998,"_5":14794,"_28279":55916,"_3062":55999},[],"Enable Replaceable Enrollment",{"_3607":1689,"_31098":1658,"_21528":56001,"_5":14794,"_28279":55916,"_3062":56002},[],"Disabled; the ID must be new.",{"_3607":1690,"_31098":1658,"_21528":56004,"_5":14794,"_28279":55916,"_3062":56005},[],"Initial authentication",{"_3607":1691,"_31098":1658,"_21528":56007,"_5":14794,"_28279":55916,"_3062":56008},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3607":1692,"_31098":1658,"_21528":56010,"_5":14794,"_28279":55916,"_3062":56011},[],"Renewal authentication",{"_3607":1693,"_31098":1658,"_21528":56013,"_5":14794,"_28279":55916,"_3062":56014},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3607":1694,"_31098":1658,"_21528":56016,"_5":14794,"_28279":55916,"_3062":56017},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3607":1695,"_31098":1658,"_21528":56019,"_5":14794,"_28279":55916,"_3062":56020},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3607":1696,"_31098":1658,"_21528":56022,"_5":14794,"_28279":55916,"_3062":56023},[],"Re-enrollment Delta",{"_3607":1697,"_31098":1658,"_21528":56025,"_5":14794,"_28279":55916,"_3062":56026},[],"1 hour.",{"_3607":1698,"_31098":1658,"_21528":56028,"_5":14794,"_28279":55916,"_3062":56029},[],"Preventive / Critical Delta",{"_3607":1699,"_31098":1658,"_21528":56031,"_5":14794,"_28279":55916,"_3062":56032},[],"30 minutes / 10 minutes.",{"_3607":1700,"_31098":1658,"_21528":56034,"_5":14794,"_28279":55916,"_3062":56035},[],"Revoke on Re-enrollment",{"_3607":1701,"_31098":1658,"_21528":56037,"_5":14794,"_28279":55916,"_3062":56038},[],"Disabled to test the successor before retiring the previous identity.",{"_3607":1702,"_31098":1658,"_21528":56040,"_5":14794,"_28279":55916,"_3062":53793},[],{"_3607":1703,"_31098":1658,"_21528":56042,"_5":14794,"_28279":55916,"_3062":56043},[],"Disabled; the operational key is generated in the client.",{"_3607":1704,"_31098":1658,"_21528":56045,"_5":14794,"_28279":55916,"_3062":56046},[],"CA Distribution",{"_3607":1705,"_31098":1658,"_21528":56048,"_5":14794,"_28279":55916,"_3062":56049},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3607":1706,"_31098":1658,"_21528":56051,"_5":14794,"_28279":55916,"_3062":56052},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3607":1707,"_31098":1658,"_21528":56054,"_5":14794,"_28279":55920,"_3062":56055},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3607":1708,"_31098":1658,"_21528":56057,"_5":14794,"_28279":55920,"_3062":56058},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3607":1709,"_31098":1658,"_21528":56060,"_5":14794,"_28279":55924,"_3062":56061},[],"Generate a new key and CSR with the selected identifier:",{"_3607":1710,"_31098":1658,"_21528":56063,"_5":14794,"_28279":55924,"_3062":56064},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3607":1711,"_31098":1658,"_21528":56066,"_5":14794,"_28279":55924,"_3062":56067},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3607":1712,"_31098":1658,"_21528":56069,"_5":14794,"_28279":55928,"_3062":56070},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3607":1713,"_31098":1658,"_21528":56072,"_5":14794,"_28279":55928,"_3062":56073},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3607":1714,"_31098":1658,"_21528":56075,"_5":14794,"_28279":55932,"_3062":56076},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3607":1715,"_31098":1658,"_21528":56078,"_5":14794,"_28279":55932,"_3062":56079},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3607":1716,"_31098":1658,"_21528":56081,"_5":14794,"_28279":55932,"_3062":56082},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3607":1717,"_31098":1658,"_21528":56084,"_5":14794,"_28279":55932,"_3062":56085},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3607":1718,"_31098":1658,"_21528":56087,"_5":14794,"_28279":55932,"_3062":56088},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3607":1719,"_31098":1658,"_21528":56090,"_5":14794,"_28279":55936,"_3062":56091},[],"Check",{"_3607":1720,"_31098":1658,"_21528":56093,"_5":14794,"_28279":55936,"_3062":56094},[],"Expected result",{"_3607":1721,"_31098":1658,"_21528":56096,"_5":14794,"_28279":55936,"_3062":56097},[],"Registration",{"_3607":1722,"_31098":1658,"_21528":56099,"_5":14794,"_28279":55936,"_3062":56100},[],"ID created automatically and correct DMS.",{"_3607":1723,"_31098":1658,"_21528":56102,"_5":14794,"_28279":55936,"_3062":55358},[],{"_3607":1724,"_31098":1658,"_21528":56104,"_5":14794,"_28279":55936,"_3062":56105},[],"CN, profile, serial and key verified.",{"_3607":1725,"_31098":1658,"_21528":56107,"_5":14794,"_28279":55936,"_3062":56108},[],"Inventory",{"_3607":1726,"_31098":1658,"_21528":56110,"_5":14794,"_28279":55936,"_3062":56111},[],"Received serial visible as the current identity and in history.",{"_3607":1727,"_31098":1658,"_21528":56113,"_5":14794,"_28279":55936,"_3062":56114},[],"Consumer",{"_3607":1728,"_31098":1658,"_21528":56116,"_5":14794,"_28279":55936,"_3062":56117},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3607":1729,"_31098":1658,"_21528":56119,"_5":14794,"_28279":55936,"_3062":56120},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3607":1730,"_31098":1658,"_21528":56122,"_5":14794,"_28279":55936,"_3062":56123},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3607":1731,"_31098":1731,"_5":15159,"_3062":53487,"_31457":56125,"_21528":56126,"_28279":1731},[50787,52299,53471,55902],[],{"_3607":1732,"_31098":1731,"_21528":56128,"_5":14794,"_28279":1731,"_3062":56129},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3607":1733,"_31098":1731,"_5":31454,"_21528":56131,"_28279":56132,"_3062":50797},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3607":1734,"_31098":1731,"_5":31454,"_21528":56134,"_28279":56135,"_3062":56136},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3607":1735,"_31098":1731,"_5":31454,"_21528":56138,"_28279":56139,"_3062":56140},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3607":1736,"_31098":1731,"_5":31454,"_21528":56142,"_28279":56143,"_3062":56144},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3607":1737,"_31098":1731,"_5":31454,"_21528":56146,"_28279":56147,"_3062":56148},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3607":1738,"_31098":1731,"_5":31454,"_21528":56150,"_28279":56151,"_3062":56152},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3607":1739,"_31098":1731,"_5":31454,"_21528":56154,"_28279":56155,"_3062":56094},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3607":1740,"_31098":1731,"_5":31454,"_21528":56157,"_28279":56158,"_3062":56159},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3607":1741,"_31098":1731,"_5":31454,"_21528":56161,"_28279":56162,"_3062":56163},[],"/docs/pr-preview/pr-75/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3607":1742,"_31098":1731,"_21528":56165,"_5":14794,"_28279":1731,"_3062":56166},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3607":1743,"_31098":1731,"_21528":56168,"_5":14794,"_28279":1731,"_3062":56169},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3607":1744,"_31098":1731,"_21528":56171,"_5":14794,"_28279":56132,"_3062":56172},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3607":1745,"_31098":1731,"_21528":56174,"_5":14794,"_28279":56132,"_3062":56175},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3607":1746,"_31098":1731,"_21528":56177,"_5":14794,"_28279":56132,"_3062":56178},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3607":1747,"_31098":1731,"_21528":56180,"_5":14794,"_28279":56132,"_3062":56181},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3607":1748,"_31098":1731,"_21528":56183,"_5":14794,"_28279":56135,"_3062":56184},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3607":1749,"_31098":1731,"_21528":56186,"_5":14794,"_28279":56135,"_3062":56187},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3607":1750,"_31098":1731,"_21528":56189,"_5":14794,"_28279":56135,"_3062":56190},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3607":1751,"_31098":1731,"_21528":56192,"_5":14794,"_28279":56135,"_3062":56193},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3607":1752,"_31098":1731,"_21528":56195,"_5":14794,"_28279":56135,"_3062":56196},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3607":1753,"_31098":1731,"_21528":56198,"_5":14794,"_28279":56135,"_3062":56199},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3607":1754,"_31098":1731,"_21528":56201,"_5":14794,"_28279":56135,"_3062":56202},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3607":1755,"_31098":1731,"_21528":56204,"_5":14794,"_28279":56135,"_3062":56205},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3607":1756,"_31098":1731,"_21528":56207,"_5":14794,"_28279":56139,"_3062":56208},[],"Open **Managed Devices** and the registration action. Complete:",{"_3607":1757,"_31098":1731,"_21528":56210,"_5":14794,"_28279":56139,"_3062":56211},[],"**Device ID**: `device-001`.",{"_3607":1758,"_31098":1731,"_21528":56213,"_5":14794,"_28279":56139,"_3062":56214},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3607":1759,"_31098":1731,"_21528":56216,"_5":14794,"_28279":56139,"_3062":56217},[],"**Icon** and **Tags**: optional classification.",{"_3607":1760,"_31098":1731,"_21528":56219,"_5":14794,"_28279":56139,"_3062":56220},[],"Confirm registration.",{"_3607":1761,"_31098":1731,"_21528":56222,"_5":14794,"_28279":56143,"_3062":56223},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3607":1762,"_31098":1731,"_21528":56225,"_5":14794,"_28279":56143,"_3062":56226},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3607":1763,"_31098":1731,"_21528":56228,"_5":14794,"_28279":56147,"_3062":56229},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3607":1764,"_31098":1731,"_21528":56231,"_5":14794,"_28279":56147,"_3062":56232},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3607":1765,"_31098":1731,"_21528":56234,"_5":14794,"_28279":56151,"_3062":56235},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3607":1766,"_31098":1731,"_21528":56237,"_5":14794,"_28279":56151,"_3062":56238},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3607":1767,"_31098":1731,"_21528":56240,"_5":14794,"_28279":56155,"_3062":56091},[],{"_3607":1768,"_31098":1731,"_21528":56242,"_5":14794,"_28279":56155,"_3062":56243},[],"Result",{"_3607":1769,"_31098":1731,"_21528":56245,"_5":14794,"_28279":56155,"_3062":55341},[],{"_3607":1770,"_31098":1731,"_21528":56247,"_5":14794,"_28279":56155,"_3062":56248},[],"`device-001` appears in inventory with the expected DMS.",{"_3607":1771,"_31098":1731,"_21528":56250,"_5":14794,"_28279":56155,"_3062":56251},[],"Current identity",{"_3607":1772,"_31098":1731,"_21528":56253,"_5":14794,"_28279":56155,"_3062":56254},[],"The associated certificate matches the one you verified in PKI.",{"_3607":1773,"_31098":1731,"_21528":56256,"_5":14794,"_28279":56155,"_3062":56257},[],"History",{"_3607":1774,"_31098":1731,"_21528":56259,"_5":14794,"_28279":56155,"_3062":56260},[],"The associated issuance appears with its serial number and dates.",{"_3607":1775,"_31098":1731,"_21528":56262,"_5":14794,"_28279":56155,"_3062":56263},[],"Key and certificate",{"_3607":1776,"_31098":1731,"_21528":56265,"_5":14794,"_28279":56155,"_3062":56266},[],"You have the verified pair ready to install on the device.",{"_3607":1777,"_31098":1731,"_21528":56268,"_5":14794,"_28279":56158,"_3062":56269},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3607":1778,"_31098":1731,"_21528":56271,"_5":14794,"_28279":56158,"_3062":56272},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3607":1779,"_31098":1731,"_21528":56274,"_5":14794,"_28279":56158,"_3062":56275},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3607":1780,"_31098":1731,"_21528":56277,"_5":14794,"_28279":56158,"_3062":56278},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3607":1781,"_31098":1731,"_21528":56280,"_5":14794,"_28279":56162,"_3062":56281},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3607":1782,"_31098":1731,"_21528":56283,"_5":14794,"_28279":56162,"_3062":56284},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3607":1783,"_31098":1731,"_21528":56286,"_5":14794,"_28279":56162,"_3062":56287},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3607":1784,"_31098":1784,"_5":15159,"_3062":56289,"_31457":56290,"_21528":56291,"_28279":1784},"Lamassu IoT Platform",[50787,52299],[],{"_3607":1785,"_31098":1784,"_21528":56293,"_5":14794,"_28279":1784,"_3062":56294},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3607":1786,"_31098":1784,"_5":31454,"_21528":56296,"_28279":56297,"_3062":55777},[],"/docs/pr-preview/pr-75/platform/overview#start-here",{"_3607":1787,"_31098":1784,"_5":31454,"_21528":56299,"_28279":56300,"_3062":56301},[],"/docs/pr-preview/pr-75/platform/overview#choose-your-path","Choose your path",{"_3607":1788,"_31098":1784,"_5":31454,"_21528":56303,"_28279":56304,"_3062":56305},[],"/docs/pr-preview/pr-75/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3607":1789,"_31098":1784,"_5":31454,"_21528":56307,"_28279":56308,"_3062":56309},[],"/docs/pr-preview/pr-75/platform/overview#core-capabilities","Core capabilities",{"_3607":1790,"_31098":1784,"_5":31454,"_21528":56311,"_28279":56312,"_3062":56313},[],"/docs/pr-preview/pr-75/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3607":1791,"_31098":1784,"_5":31454,"_21528":56315,"_28279":56316,"_3062":56317},[],"/docs/pr-preview/pr-75/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3607":1792,"_31098":1784,"_5":31454,"_21528":56319,"_28279":56320,"_3062":56321},[],"/docs/pr-preview/pr-75/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3607":1793,"_31098":1784,"_5":31454,"_21528":56323,"_28279":56324,"_3062":56325},[],"/docs/pr-preview/pr-75/platform/overview#automate-device-identities","Automate device identities",{"_3607":1794,"_31098":1784,"_5":31454,"_21528":56327,"_28279":56328,"_3062":56329},[],"/docs/pr-preview/pr-75/platform/overview#publish-validation-status","Publish validation status",{"_3607":1795,"_31098":1784,"_5":31454,"_21528":56331,"_28279":56332,"_3062":56333},[],"/docs/pr-preview/pr-75/platform/overview#react-to-events","React to events",{"_3607":1796,"_31098":1784,"_5":31454,"_21528":56335,"_28279":56336,"_3062":56337},[],"/docs/pr-preview/pr-75/platform/overview#operational-reference","Operational reference",{"_3607":1797,"_31098":1784,"_21528":56339,"_5":14794,"_28279":1784,"_3062":56340},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3607":1798,"_31098":1784,"_21528":56342,"_5":14794,"_28279":56297,"_3062":56343},[],"Choose the result you need:",{"_3607":1799,"_31098":1784,"_21528":56345,"_5":14794,"_28279":56297,"_3062":56346},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3607":1800,"_31098":1784,"_21528":56348,"_5":14794,"_28279":56297,"_3062":56349},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3607":1801,"_31098":1784,"_21528":56351,"_5":14794,"_28279":56297,"_3062":56352},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3607":1802,"_31098":1784,"_21528":56354,"_5":14794,"_28279":56300,"_3062":56355},[],"Section",{"_3607":1803,"_31098":1784,"_21528":56357,"_5":14794,"_28279":56300,"_3062":56358},[],"What you manage",{"_3607":1804,"_31098":1784,"_21528":56360,"_5":14794,"_28279":56300,"_3062":56361},[],"Entry point",{"_3607":1805,"_31098":1784,"_21528":56363,"_5":14794,"_28279":56300,"_3062":56364},[],"**PKI**",{"_3607":1806,"_31098":1784,"_21528":56366,"_5":14794,"_28279":56300,"_3062":56367},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3607":1807,"_31098":1784,"_21528":56369,"_5":14794,"_28279":56300,"_3062":56370},[],"PKI overview",{"_3607":1808,"_31098":1784,"_21528":56372,"_5":14794,"_28279":56300,"_3062":56373},[],"**IoT Fleets**",{"_3607":1809,"_31098":1784,"_21528":56375,"_5":14794,"_28279":56300,"_3062":56376},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3607":1810,"_31098":1784,"_21528":56378,"_5":14794,"_28279":56300,"_3062":56379},[],"IoT Fleets overview",{"_3607":1811,"_31098":1784,"_21528":56381,"_5":14794,"_28279":56300,"_3062":56382},[],"**Administration**",{"_3607":1812,"_31098":1784,"_21528":56384,"_5":14794,"_28279":56300,"_3062":56385},[],"Operator permissions, audit and event subscriptions.",{"_3607":1813,"_31098":1784,"_21528":56387,"_5":14794,"_28279":56300,"_3062":52301},[],{"_3607":1814,"_31098":1784,"_21528":56389,"_5":14794,"_28279":56300,"_3062":56390},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3607":1815,"_31098":1784,"_21528":56392,"_5":14794,"_28279":56304,"_3062":56393},[],"An identity's journey connects four responsibilities:",{"_3607":1816,"_31098":1784,"_21528":56395,"_5":14794,"_28279":56304,"_3062":56396},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3607":1817,"_31098":1784,"_21528":56398,"_5":14794,"_28279":56304,"_3062":56399},[],"The provisioning administrator configures the DMS and initial trust.",{"_3607":1818,"_31098":1784,"_21528":56401,"_5":14794,"_28279":56304,"_3062":56402},[],"The device client requests a certificate and installs it with the matching key.",{"_3607":1819,"_31098":1784,"_21528":56404,"_5":14794,"_28279":56304,"_3062":56405},[],"The consumer validates the identity and applies its access permissions.",{"_3607":1820,"_31098":1784,"_21528":56407,"_5":14794,"_28279":56304,"_3062":56408},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3607":1821,"_31098":1784,"_21528":56410,"_5":14794,"_28279":56312,"_3062":56411},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3607":1822,"_31098":1784,"_21528":56413,"_5":14794,"_28279":56316,"_3062":56414},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3607":1823,"_31098":1784,"_21528":56416,"_5":14794,"_28279":56320,"_3062":56417},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3607":1824,"_31098":1784,"_21528":56419,"_5":14794,"_28279":56324,"_3062":56420},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3607":1825,"_31098":1784,"_21528":56422,"_5":14794,"_28279":56328,"_3062":56423},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3607":1826,"_31098":1784,"_21528":56425,"_5":14794,"_28279":56332,"_3062":56426},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3607":1827,"_31098":1784,"_21528":56428,"_5":14794,"_28279":56336,"_3062":55871},[],{"_3607":1828,"_31098":1784,"_21528":56430,"_5":14794,"_28279":56336,"_3062":56431},[],"What it prepares or checks",{"_3607":1829,"_31098":1784,"_21528":56433,"_5":14794,"_28279":56336,"_3062":55874},[],{"_3607":1830,"_31098":1784,"_21528":56435,"_5":14794,"_28279":56336,"_3062":56436},[],"Key custody, CA hierarchy, profiles and validation.",{"_3607":1831,"_31098":1784,"_21528":56438,"_5":14794,"_28279":56336,"_3062":56439},[],"Fleet administrator",{"_3607":1832,"_31098":1784,"_21528":56441,"_5":14794,"_28279":56336,"_3062":56442},[],"DMS, device admission, renewal policy and inventory.",{"_3607":1833,"_31098":1784,"_21528":56444,"_5":14794,"_28279":56336,"_3062":55886},[],{"_3607":1834,"_31098":1784,"_21528":56446,"_5":14794,"_28279":56336,"_3062":56447},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3607":1835,"_31098":1784,"_21528":56449,"_5":14794,"_28279":56336,"_3062":55892},[],{"_3607":1836,"_31098":1784,"_21528":56451,"_5":14794,"_28279":56336,"_3062":56452},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3607":1837,"_31098":1784,"_21528":56454,"_5":14794,"_28279":56336,"_3062":56455},[],"Infrastructure operator",{"_3607":1838,"_31098":1784,"_21528":56457,"_5":14794,"_28279":56336,"_3062":56458},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3607":1839,"_31098":1784,"_21528":56460,"_5":14794,"_28279":56336,"_3062":56461},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3607":1840,"_31098":1840,"_5":15159,"_3062":56463,"_31457":56464,"_21528":56467,"_28279":1840},"CA hierarchy and rotation",[50787,52299,56465,56466],"PKI","Keys, authorities and certificates",[],{"_3607":1841,"_31098":1840,"_21528":56469,"_5":14794,"_28279":1840,"_3062":56470},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3607":1842,"_31098":1840,"_5":31454,"_21528":56472,"_28279":56473,"_3062":56474},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3607":1843,"_31098":1840,"_5":31454,"_21528":56476,"_28279":56477,"_3062":56478},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3607":1844,"_31098":1840,"_5":31454,"_21528":56480,"_28279":56481,"_3062":56482},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3607":1845,"_31098":1840,"_5":31454,"_21528":56484,"_28279":56485,"_3062":56486},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3607":1846,"_31098":1840,"_5":31454,"_21528":56488,"_28279":56489,"_3062":56490},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3607":1847,"_31098":1840,"_5":31454,"_21528":56492,"_28279":56493,"_3062":56494},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3607":1848,"_31098":1840,"_5":31454,"_21528":56496,"_28279":56497,"_3062":56498},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3607":1849,"_31098":1840,"_5":31454,"_21528":56500,"_28279":56501,"_3062":56502},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3607":1850,"_31098":1840,"_5":31454,"_21528":56504,"_28279":56505,"_3062":56506},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3607":1851,"_31098":1840,"_5":31454,"_21528":56508,"_28279":56509,"_3062":56510},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3607":1852,"_31098":1840,"_5":31454,"_21528":56512,"_28279":56513,"_3062":56514},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3607":1853,"_31098":1840,"_5":31454,"_21528":56516,"_28279":56517,"_3062":56518},[],"/docs/pr-preview/pr-75/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3607":1854,"_31098":1840,"_21528":56520,"_5":14794,"_28279":1840,"_3062":56521},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3607":1855,"_31098":1840,"_21528":56523,"_5":14794,"_28279":1840,"_3062":56524},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3607":1856,"_31098":1840,"_21528":56526,"_5":14794,"_28279":56473,"_3062":56527},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3607":1857,"_31098":1840,"_21528":56529,"_5":14794,"_28279":56473,"_3062":56530},[],"environment, such as production and preproduction;",{"_3607":1858,"_31098":1840,"_21528":56532,"_5":14794,"_28279":56473,"_3062":56533},[],"owner or operating team;",{"_3607":1859,"_31098":1840,"_21528":56535,"_5":14794,"_28279":56473,"_3062":56536},[],"device family or manufacturing process;",{"_3607":1860,"_31098":1840,"_21528":56538,"_5":14794,"_28279":56473,"_3062":56539},[],"region or regulatory requirement;",{"_3607":1861,"_31098":1840,"_21528":56541,"_5":14794,"_28279":56473,"_3062":56542},[],"cryptographic engine or key policy;",{"_3607":1862,"_31098":1840,"_21528":56544,"_5":14794,"_28279":56473,"_3062":56545},[],"maintenance window and renewal cadence.",{"_3607":1863,"_31098":1840,"_21528":56547,"_5":14794,"_28279":56473,"_3062":56548},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3607":1864,"_31098":1840,"_21528":56550,"_5":14794,"_28279":56473,"_3062":56551},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3607":1865,"_31098":1840,"_21528":56553,"_5":14794,"_28279":56477,"_3062":56554},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3607":1866,"_31098":1840,"_21528":56556,"_5":14794,"_28279":56477,"_3062":56557},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3607":1867,"_31098":1840,"_21528":56559,"_5":14794,"_28279":56477,"_3062":56560},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3607":1868,"_31098":1840,"_21528":56562,"_5":14794,"_28279":56477,"_3062":56563},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3607":1869,"_31098":1840,"_21528":56565,"_5":14794,"_28279":56481,"_3062":56566},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3607":1870,"_31098":1840,"_21528":56568,"_5":14794,"_28279":56481,"_3062":56569},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3607":1871,"_31098":1840,"_21528":56571,"_5":14794,"_28279":56481,"_3062":56572},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3607":1872,"_31098":1840,"_21528":56574,"_5":14794,"_28279":56481,"_3062":56575},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3607":1873,"_31098":1840,"_21528":56577,"_5":14794,"_28279":56489,"_3062":56578},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3607":1874,"_31098":1840,"_21528":56580,"_5":14794,"_28279":56493,"_3062":56581},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3607":1875,"_31098":1840,"_21528":56583,"_5":14794,"_28279":56497,"_3062":56584},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3607":1876,"_31098":1840,"_21528":56586,"_5":14794,"_28279":56501,"_3062":56587},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3607":1877,"_31098":1840,"_21528":56589,"_5":14794,"_28279":56505,"_3062":56590},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3607":1878,"_31098":1840,"_21528":56592,"_5":14794,"_28279":56509,"_3062":56593},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3607":1879,"_31098":1840,"_21528":56595,"_5":14794,"_28279":56513,"_3062":56596},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3607":1880,"_31098":1840,"_21528":56598,"_5":14794,"_28279":56513,"_3062":56599},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3607":1881,"_31098":1840,"_21528":56601,"_5":14794,"_28279":56513,"_3062":56602},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3607":1882,"_31098":1840,"_21528":56604,"_5":14794,"_28279":56513,"_3062":56605},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3607":1883,"_31098":1840,"_21528":56607,"_5":14794,"_28279":56517,"_3062":56608},[],"The new chain ends in an anchor installed by the consumer.",{"_3607":1884,"_31098":1840,"_21528":56610,"_5":14794,"_28279":56517,"_3062":56611},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3607":1885,"_31098":1840,"_21528":56613,"_5":14794,"_28279":56517,"_3062":56614},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3607":1886,"_31098":1840,"_21528":56616,"_5":14794,"_28279":56517,"_3062":56617},[],"Re-enrollment accepts the old identity during the planned period.",{"_3607":1887,"_31098":1840,"_21528":56619,"_5":14794,"_28279":56517,"_3062":56620},[],"OCSP and CRL respond for the authorities that remain active.",{"_3607":1888,"_31098":1840,"_21528":56622,"_5":14794,"_28279":56517,"_3062":56623},[],"No DMS is left accidentally issuing from the old CA.",{"_3607":1889,"_31098":1840,"_21528":56625,"_5":14794,"_28279":56517,"_3062":56626},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3607":1890,"_31098":1890,"_5":15159,"_3062":56628,"_31457":56629,"_21528":56630,"_28279":1890},"Certification authorities",[50787,52299,56465,56466],[],{"_3607":1891,"_31098":1890,"_21528":56632,"_5":14794,"_28279":1890,"_3062":56633},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3607":1892,"_31098":1890,"_5":31454,"_21528":56635,"_28279":56636,"_3062":56637},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3607":1893,"_31098":1890,"_5":31454,"_21528":56639,"_28279":56640,"_3062":56641},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3607":1894,"_31098":1890,"_5":31454,"_21528":56643,"_28279":56644,"_3062":50797},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#before-you-begin",{"_3607":1895,"_31098":1890,"_5":31454,"_21528":56646,"_28279":56647,"_3062":56648},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3607":1896,"_31098":1890,"_5":31454,"_21528":56650,"_28279":56651,"_3062":56652},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3607":1897,"_31098":1890,"_5":31454,"_21528":56654,"_28279":56655,"_3062":56656},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3607":1898,"_31098":1890,"_5":31454,"_21528":56658,"_28279":56659,"_3062":56660},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3607":1899,"_31098":1890,"_5":31454,"_21528":56662,"_28279":56663,"_3062":56664},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3607":1900,"_31098":1890,"_5":31454,"_21528":56666,"_28279":56667,"_3062":56668},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3607":1901,"_31098":1890,"_5":31454,"_21528":56670,"_28279":56671,"_3062":56672},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3607":1902,"_31098":1890,"_5":31454,"_21528":56674,"_28279":56675,"_3062":56676},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3607":1903,"_31098":1890,"_5":31454,"_21528":56678,"_28279":56679,"_3062":56680},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3607":1904,"_31098":1890,"_5":31454,"_21528":56682,"_28279":56683,"_3062":56684},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3607":1905,"_31098":1890,"_5":31454,"_21528":56686,"_28279":56687,"_3062":56688},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3607":1906,"_31098":1890,"_5":31454,"_21528":56690,"_28279":56691,"_3062":56692},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3607":1907,"_31098":1890,"_5":31454,"_21528":56694,"_28279":56695,"_3062":56696},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3607":1908,"_31098":1890,"_5":31454,"_21528":56698,"_28279":56699,"_3062":56700},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3607":1909,"_31098":1890,"_5":31454,"_21528":56702,"_28279":56703,"_3062":56704},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3607":1910,"_31098":1890,"_5":31454,"_21528":56706,"_28279":56707,"_3062":56708},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3607":1911,"_31098":1890,"_5":31454,"_21528":56710,"_28279":56711,"_3062":56712},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3607":1912,"_31098":1890,"_5":31454,"_21528":56714,"_28279":56715,"_3062":56716},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3607":1913,"_31098":1890,"_5":31454,"_21528":56718,"_28279":56719,"_3062":56720},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3607":1914,"_31098":1890,"_5":31454,"_21528":56722,"_28279":56723,"_3062":56724},[],"/docs/pr-preview/pr-75/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3607":1915,"_31098":1890,"_21528":56726,"_5":14794,"_28279":1890,"_3062":56727},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3607":1916,"_31098":1890,"_21528":56729,"_5":14794,"_28279":1890,"_3062":56730},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3607":1917,"_31098":1890,"_21528":56732,"_5":14794,"_28279":1890,"_3062":56733},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3607":1918,"_31098":1890,"_21528":56735,"_5":14794,"_28279":56636,"_3062":56736},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3607":1919,"_31098":1890,"_21528":56738,"_5":14794,"_28279":56636,"_3062":56739},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3607":1920,"_31098":1890,"_21528":56741,"_5":14794,"_28279":56636,"_3062":56742},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3607":1921,"_31098":1890,"_21528":56744,"_5":14794,"_28279":56636,"_3062":56745},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3607":1922,"_31098":1890,"_21528":56747,"_5":14794,"_28279":56636,"_3062":56748},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3607":1923,"_31098":1890,"_21528":56750,"_5":14794,"_28279":56644,"_3062":56751},[],"Decide whether the CA will be a root or an intermediate.",{"_3607":1924,"_31098":1890,"_21528":56753,"_5":14794,"_28279":56644,"_3062":56754},[],"Choose the engine that will keep the key.",{"_3607":1925,"_31098":1890,"_21528":56756,"_5":14794,"_28279":56644,"_3062":56757},[],"Define a validity longer than that of the certificates it will issue.",{"_3607":1926,"_31098":1890,"_21528":56759,"_5":14794,"_28279":56644,"_3062":56760},[],"For an intermediate CA, make sure the parent CA is active.",{"_3607":1927,"_31098":1890,"_21528":56762,"_5":14794,"_28279":56647,"_3062":56763},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3607":1928,"_31098":1890,"_21528":56765,"_5":14794,"_28279":56651,"_3062":56766},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3607":1929,"_31098":1890,"_21528":56768,"_5":14794,"_28279":56651,"_3062":56769},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3607":1930,"_31098":1890,"_21528":56771,"_5":14794,"_28279":56655,"_3062":56772},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3607":1931,"_31098":1890,"_21528":56774,"_5":14794,"_28279":56659,"_3062":56775},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3607":1932,"_31098":1890,"_21528":56777,"_5":14794,"_28279":56659,"_3062":56778},[],"`C`: two-letter ISO 3166-1 country code.",{"_3607":1933,"_31098":1890,"_21528":56780,"_5":14794,"_28279":56659,"_3062":56781},[],"`ST`: state or province.",{"_3607":1934,"_31098":1890,"_21528":56783,"_5":14794,"_28279":56659,"_3062":56784},[],"`L`: locality.",{"_3607":1935,"_31098":1890,"_21528":56786,"_5":14794,"_28279":56659,"_3062":56787},[],"`O`: organization.",{"_3607":1936,"_31098":1890,"_21528":56789,"_5":14794,"_28279":56659,"_3062":56790},[],"`OU`: organizational unit.",{"_3607":1937,"_31098":1890,"_21528":56792,"_5":14794,"_28279":56659,"_3062":56793},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3607":1938,"_31098":1890,"_21528":56795,"_5":14794,"_28279":56663,"_3062":56796},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3607":1939,"_31098":1890,"_21528":56798,"_5":14794,"_28279":56663,"_3062":56799},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3607":1940,"_31098":1890,"_21528":56801,"_5":14794,"_28279":56667,"_3062":56802},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3607":1941,"_31098":1890,"_21528":56804,"_5":14794,"_28279":56667,"_3062":56805},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3607":1942,"_31098":1890,"_21528":56807,"_5":14794,"_28279":56671,"_3062":56808},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3607":1943,"_31098":1890,"_21528":56810,"_5":14794,"_28279":56671,"_3062":56811},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3607":1944,"_31098":1890,"_21528":56813,"_5":14794,"_28279":56675,"_3062":56814},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3607":1945,"_31098":1890,"_21528":56816,"_5":14794,"_28279":56675,"_3062":56817},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3607":1946,"_31098":1890,"_21528":56819,"_5":14794,"_28279":56675,"_3062":56820},[],"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. An `EXPIRED` CA rejects status changes; see certificate lifecycle.",{"_3607":1947,"_31098":1890,"_21528":56822,"_5":14794,"_28279":56675,"_3062":56823},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3607":1948,"_31098":1890,"_21528":56825,"_5":14794,"_28279":56679,"_3062":56826},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3607":1949,"_31098":1890,"_21528":56828,"_5":14794,"_28279":56683,"_3062":56829},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3607":1950,"_31098":1890,"_21528":56831,"_5":14794,"_28279":56683,"_3062":56832},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3607":1951,"_31098":1890,"_21528":56834,"_5":14794,"_28279":56687,"_3062":56835},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3607":1952,"_31098":1890,"_21528":56837,"_5":14794,"_28279":56691,"_3062":56838},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3607":1953,"_31098":1890,"_21528":56840,"_5":14794,"_28279":56691,"_3062":56841},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3607":1954,"_31098":1890,"_21528":56843,"_5":14794,"_28279":56691,"_3062":56844},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3607":1955,"_31098":1890,"_21528":56846,"_5":14794,"_28279":56695,"_3062":56847},[],"Open a CA from the inventory to review:",{"_3607":1956,"_31098":1890,"_21528":56849,"_5":14794,"_28279":56695,"_3062":56850},[],"Status and validity period.",{"_3607":1957,"_31098":1890,"_21528":56852,"_5":14794,"_28279":56695,"_3062":56853},[],"Certificate and chain in PEM format.",{"_3607":1958,"_31098":1890,"_21528":56855,"_5":14794,"_28279":56695,"_3062":56856},[],"Number of active, expired and revoked certificates.",{"_3607":1959,"_31098":1890,"_21528":56858,"_5":14794,"_28279":56695,"_3062":56859},[],"Certificates issued in **Issued Certificates**.",{"_3607":1960,"_31098":1890,"_21528":56861,"_5":14794,"_28279":56695,"_3062":56862},[],"The CRL linked to the authority.",{"_3607":1961,"_31098":1890,"_21528":56864,"_5":14794,"_28279":56695,"_3062":56865},[],"Metadata and the associated cryptographic engine.",{"_3607":1962,"_31098":1890,"_21528":56867,"_5":14794,"_28279":56695,"_3062":56868},[],"You can filter the inventory by name, status and CA type.",{"_3607":1963,"_31098":1890,"_21528":56870,"_5":14794,"_28279":56699,"_3062":56871},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3607":1964,"_31098":1890,"_21528":56873,"_5":14794,"_28279":56699,"_3062":56874},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3607":1965,"_31098":1890,"_21528":56876,"_5":14794,"_28279":56699,"_3062":56877},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3607":1966,"_31098":1890,"_21528":56879,"_5":14794,"_28279":56699,"_3062":56880},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3607":1967,"_31098":1890,"_21528":56882,"_5":14794,"_28279":56699,"_3062":56883},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3607":1968,"_31098":1890,"_21528":56885,"_5":14794,"_28279":56699,"_3062":56886},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3607":1969,"_31098":1890,"_21528":56888,"_5":14794,"_28279":56703,"_3062":56889},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3607":1970,"_31098":1890,"_21528":56891,"_5":14794,"_28279":56707,"_3062":56892},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3607":1971,"_31098":1890,"_21528":56894,"_5":14794,"_28279":56711,"_3062":56895},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3607":1972,"_31098":1890,"_21528":56897,"_5":14794,"_28279":56715,"_3062":56898},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3607":1973,"_31098":1890,"_21528":56900,"_5":14794,"_28279":56719,"_3062":56901},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3607":1974,"_31098":1890,"_21528":56903,"_5":14794,"_28279":56723,"_3062":56904},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3607":1975,"_31098":1890,"_21528":56906,"_5":14794,"_28279":56723,"_3062":56907},[],"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it.",{"_3607":1976,"_31098":1890,"_21528":56909,"_5":14794,"_28279":56723,"_3062":56910},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3607":1977,"_31098":1890,"_21528":56912,"_5":14794,"_28279":56723,"_3062":56913},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3607":1978,"_31098":1890,"_21528":56915,"_5":14794,"_28279":56723,"_3062":56916},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3607":1979,"_31098":1979,"_5":15159,"_3062":56918,"_31457":56919,"_21528":56920,"_28279":1979},"Certificate profiles",[50787,52299,56465,56466],[],{"_3607":1980,"_31098":1979,"_21528":56922,"_5":14794,"_28279":1979,"_3062":56923},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3607":1981,"_31098":1979,"_5":31454,"_21528":56925,"_28279":56926,"_3062":56927},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3607":1982,"_31098":1979,"_5":31454,"_21528":56929,"_28279":56930,"_3062":56931},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#validity","Validity",{"_3607":1983,"_31098":1979,"_5":31454,"_21528":56933,"_28279":56934,"_3062":56935},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3607":1984,"_31098":1979,"_5":31454,"_21528":56937,"_28279":56938,"_3062":56939},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3607":1985,"_31098":1979,"_5":31454,"_21528":56941,"_28279":56942,"_3062":56943},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#subject","Subject",{"_3607":1986,"_31098":1979,"_5":31454,"_21528":56945,"_28279":56946,"_3062":56947},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3607":1987,"_31098":1979,"_5":31454,"_21528":56949,"_28279":56950,"_3062":56951},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3607":1988,"_31098":1979,"_5":31454,"_21528":56953,"_28279":56954,"_3062":56955},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3607":1989,"_31098":1979,"_5":31454,"_21528":56957,"_28279":56958,"_3062":56959},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3607":1990,"_31098":1979,"_5":31454,"_21528":56961,"_28279":56962,"_3062":56963},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3607":1991,"_31098":1979,"_5":31454,"_21528":56965,"_28279":56966,"_3062":56967},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3607":1992,"_31098":1979,"_5":31454,"_21528":56969,"_28279":56970,"_3062":56971},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3607":1993,"_31098":1979,"_5":31454,"_21528":56973,"_28279":56974,"_3062":56975},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3607":1994,"_31098":1979,"_5":31454,"_21528":56977,"_28279":56978,"_3062":56979},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3607":1995,"_31098":1979,"_5":31454,"_21528":56981,"_28279":56982,"_3062":56983},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#design-examples","Design examples",{"_3607":1996,"_31098":1979,"_5":31454,"_21528":56985,"_28279":56986,"_3062":56987},[],"/docs/pr-preview/pr-75/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3607":1997,"_31098":1979,"_21528":56989,"_5":14794,"_28279":1979,"_3062":56990},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3607":1998,"_31098":1979,"_21528":56992,"_5":14794,"_28279":1979,"_3062":56993},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3607":1999,"_31098":1979,"_21528":56995,"_5":14794,"_28279":56930,"_3062":56996},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3607":2000,"_31098":1979,"_21528":56998,"_5":14794,"_28279":56930,"_3062":56999},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3607":2001,"_31098":1979,"_21528":57001,"_5":14794,"_28279":56934,"_3062":57002},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3607":2002,"_31098":1979,"_21528":57004,"_5":14794,"_28279":56938,"_3062":57005},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3607":2003,"_31098":1979,"_21528":57007,"_5":14794,"_28279":56938,"_3062":57008},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3607":2004,"_31098":1979,"_21528":57010,"_5":14794,"_28279":56938,"_3062":57011},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3607":2005,"_31098":1979,"_21528":57013,"_5":14794,"_28279":56942,"_3062":57014},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3607":2006,"_31098":1979,"_21528":57016,"_5":14794,"_28279":56946,"_3062":57017},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3607":2007,"_31098":1979,"_21528":57019,"_5":14794,"_28279":56946,"_3062":57020},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3607":2008,"_31098":1979,"_21528":57022,"_5":14794,"_28279":56950,"_3062":57023},[],"The cryptographic enforcement can:",{"_3607":2009,"_31098":1979,"_21528":57025,"_5":14794,"_28279":56950,"_3062":57026},[],"allow or block RSA keys;",{"_3607":2010,"_31098":1979,"_21528":57028,"_5":14794,"_28279":56950,"_3062":57029},[],"limit the supported RSA sizes;",{"_3607":2011,"_31098":1979,"_21528":57031,"_5":14794,"_28279":56950,"_3062":57032},[],"allow or block ECDSA keys;",{"_3607":2012,"_31098":1979,"_21528":57034,"_5":14794,"_28279":56950,"_3062":57035},[],"limit the supported ECDSA sizes or curves.",{"_3607":2013,"_31098":1979,"_21528":57037,"_5":14794,"_28279":56950,"_3062":57038},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3607":2014,"_31098":1979,"_21528":57040,"_5":14794,"_28279":56954,"_3062":57041},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3607":2015,"_31098":1979,"_21528":57043,"_5":14794,"_28279":56954,"_3062":54227},[],{"_3607":2016,"_31098":1979,"_21528":57045,"_5":14794,"_28279":56954,"_3062":57046},[],"First choice",{"_3607":2017,"_31098":1979,"_21528":57048,"_5":14794,"_28279":56954,"_3062":57049},[],"Second choice",{"_3607":2018,"_31098":1979,"_21528":57051,"_5":14794,"_28279":56954,"_3062":57052},[],"If neither is supplied",{"_3607":2019,"_31098":1979,"_21528":57054,"_5":14794,"_28279":56954,"_3062":57055},[],"Direct signing with a CA",{"_3607":2020,"_31098":1979,"_21528":57057,"_5":14794,"_28279":56954,"_3062":57058},[],"`issuance_profile` embedded in the request",{"_3607":2021,"_31098":1979,"_21528":57060,"_5":14794,"_28279":56954,"_3062":57061},[],"Request `issuance_profile_id`",{"_3607":2022,"_31098":1979,"_21528":57063,"_5":14794,"_28279":56954,"_3062":57064},[],"CA default profile (`profile_id`).",{"_3607":2023,"_31098":1979,"_21528":57066,"_5":14794,"_28279":56954,"_3062":57067},[],"Issuance through a DMS",{"_3607":2024,"_31098":1979,"_21528":57069,"_5":14794,"_28279":56954,"_3062":57070},[],"`settings.issuance_profile_id`",{"_3607":2025,"_31098":1979,"_21528":57072,"_5":14794,"_28279":56954,"_3062":57073},[],"`settings.issuance_profile` embedded in the DMS",{"_3607":2026,"_31098":1979,"_21528":57075,"_5":14794,"_28279":56954,"_3062":57076},[],"Enrollment CA default profile.",{"_3607":2027,"_31098":1979,"_21528":57078,"_5":14794,"_28279":56954,"_3062":57079},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3607":2028,"_31098":1979,"_21528":57081,"_5":14794,"_28279":56954,"_3062":57082},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3607":2029,"_31098":1979,"_21528":57084,"_5":14794,"_28279":56962,"_3062":57085},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3607":2030,"_31098":1979,"_21528":57087,"_5":14794,"_28279":56966,"_3062":57088},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3607":2031,"_31098":1979,"_21528":57090,"_5":14794,"_28279":56970,"_3062":57091},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3607":2032,"_31098":1979,"_21528":57093,"_5":14794,"_28279":56974,"_3062":57094},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3607":2033,"_31098":1979,"_21528":57096,"_5":14794,"_28279":56978,"_3062":57097},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3607":2034,"_31098":1979,"_21528":57099,"_5":14794,"_28279":56978,"_3062":57100},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3607":2035,"_31098":1979,"_21528":57102,"_5":14794,"_28279":56982,"_3062":57103},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3607":2036,"_31098":1979,"_21528":57105,"_5":14794,"_28279":56982,"_3062":57106},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3607":2037,"_31098":1979,"_21528":57108,"_5":14794,"_28279":56982,"_3062":57109},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3607":2038,"_31098":1979,"_21528":57111,"_5":14794,"_28279":56982,"_3062":57112},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3607":2039,"_31098":1979,"_21528":57114,"_5":14794,"_28279":56986,"_3062":57115},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3607":2040,"_31098":1979,"_21528":57117,"_5":14794,"_28279":56986,"_3062":57118},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3607":2041,"_31098":2041,"_5":15159,"_3062":57120,"_31457":57121,"_21528":57123,"_28279":2041},"Certificate validation",[50787,52299,56465,57122],"Validation",[],{"_3607":2042,"_31098":2041,"_21528":57125,"_5":14794,"_28279":2041,"_3062":57126},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3607":2043,"_31098":2041,"_5":31454,"_21528":57128,"_28279":57129,"_3062":57130},[],"/docs/pr-preview/pr-75/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3607":2044,"_31098":2041,"_5":31454,"_21528":57132,"_28279":57133,"_3062":57134},[],"/docs/pr-preview/pr-75/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3607":2045,"_31098":2041,"_5":31454,"_21528":57136,"_28279":57137,"_3062":57138},[],"/docs/pr-preview/pr-75/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3607":2046,"_31098":2041,"_21528":57140,"_5":14794,"_28279":2041,"_3062":57141},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3607":2047,"_31098":2041,"_21528":57143,"_5":14794,"_28279":57129,"_3062":57144},[],"Verify these criteria together:",{"_3607":2048,"_31098":2041,"_21528":57146,"_5":14794,"_28279":57129,"_3062":56091},[],{"_3607":2049,"_31098":2041,"_21528":57148,"_5":14794,"_28279":57129,"_3062":57149},[],"Required result",{"_3607":2050,"_31098":2041,"_21528":57151,"_5":14794,"_28279":57129,"_3062":57152},[],"Chain and signature",{"_3607":2051,"_31098":2041,"_21528":57154,"_5":14794,"_28279":57129,"_3062":57155},[],"Valid chain to a root deliberately installed in the consumer.",{"_3607":2052,"_31098":2041,"_21528":57157,"_5":14794,"_28279":57129,"_3062":57158},[],"Dates",{"_3607":2053,"_31098":2041,"_21528":57160,"_5":14794,"_28279":57129,"_3062":57161},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3607":2054,"_31098":2041,"_21528":57163,"_5":14794,"_28279":57129,"_3062":51968},[],{"_3607":2055,"_31098":2041,"_21528":57165,"_5":14794,"_28279":57129,"_3062":57166},[],"Name, SAN or identifier matches the expected peer.",{"_3607":2056,"_31098":2041,"_21528":57168,"_5":14794,"_28279":57129,"_3062":51177},[],{"_3607":2057,"_31098":2041,"_21528":57170,"_5":14794,"_28279":57129,"_3062":57171},[],"KU, EKU and constraints permit the specific operation.",{"_3607":2058,"_31098":2041,"_21528":57173,"_5":14794,"_28279":57129,"_3062":57174},[],"Revocation",{"_3607":2059,"_31098":2041,"_21528":57176,"_5":14794,"_28279":57129,"_3062":57177},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3607":2060,"_31098":2041,"_21528":57179,"_5":14794,"_28279":57129,"_3062":57180},[],"Authorization",{"_3607":2061,"_31098":2041,"_21528":57182,"_5":14794,"_28279":57129,"_3062":57183},[],"The application permits that identity to perform the action.",{"_3607":2062,"_31098":2041,"_21528":57185,"_5":14794,"_28279":57129,"_3062":57186},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3607":2063,"_31098":2041,"_21528":57188,"_5":14794,"_28279":57133,"_3062":57189},[],"Mechanism",{"_3607":2064,"_31098":2041,"_21528":57191,"_5":14794,"_28279":57133,"_3062":57192},[],"When to use it",{"_3607":2065,"_31098":2041,"_21528":57194,"_5":14794,"_28279":57133,"_3062":57195},[],"What you must maintain",{"_3607":2066,"_31098":2041,"_21528":57197,"_5":14794,"_28279":57133,"_3062":57198},[],"OCSP",{"_3607":2067,"_31098":2041,"_21528":57200,"_5":14794,"_28279":57133,"_3062":57201},[],"Status query for a specific certificate.",{"_3607":2068,"_31098":2041,"_21528":57203,"_5":14794,"_28279":57133,"_3062":57204},[],"Responder access, signature verification and cache/freshness policy.",{"_3607":2069,"_31098":2041,"_21528":57206,"_5":14794,"_28279":57133,"_3062":57207},[],"CRL",{"_3607":2070,"_31098":2041,"_21528":57209,"_5":14794,"_28279":57133,"_3062":57210},[],"Local checks for many certificates or offline operation.",{"_3607":2071,"_31098":2041,"_21528":57212,"_5":14794,"_28279":57133,"_3062":57213},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3607":2072,"_31098":2041,"_21528":57215,"_5":14794,"_28279":57133,"_3062":57216},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3607":2073,"_31098":2041,"_21528":57218,"_5":14794,"_28279":57133,"_3062":57219},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3607":2074,"_31098":2041,"_21528":57221,"_5":14794,"_28279":57137,"_3062":57222},[],"Accept a current, authorized certificate with a known chain.",{"_3607":2075,"_31098":2041,"_21528":57224,"_5":14794,"_28279":57137,"_3062":57225},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3607":2076,"_31098":2041,"_21528":57227,"_5":14794,"_28279":57137,"_3062":57228},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3607":2077,"_31098":2041,"_21528":57230,"_5":14794,"_28279":57137,"_3062":57231},[],"Check that a new connection with that identity is rejected.",{"_3607":2078,"_31098":2041,"_21528":57233,"_5":14794,"_28279":57137,"_3062":57234},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3607":2079,"_31098":2041,"_21528":57236,"_5":14794,"_28279":57137,"_3062":57237},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3607":2080,"_31098":2041,"_21528":57239,"_5":14794,"_28279":57137,"_3062":57240},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3607":2081,"_31098":2041,"_21528":57242,"_5":14794,"_28279":57137,"_3062":57243},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3607":2082,"_31098":2041,"_21528":57245,"_5":14794,"_28279":57137,"_3062":57246},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3607":2083,"_31098":2083,"_5":15159,"_3062":57248,"_31457":57249,"_21528":57250,"_28279":2083},"Certificates",[50787,52299,56465,56466],[],{"_3607":2084,"_31098":2083,"_21528":57252,"_5":14794,"_28279":2083,"_3062":57253},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3607":2085,"_31098":2083,"_5":31454,"_21528":57255,"_28279":57256,"_3062":57257},[],"/docs/pr-preview/pr-75/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3607":2086,"_31098":2083,"_5":31454,"_21528":57259,"_28279":57260,"_3062":57261},[],"/docs/pr-preview/pr-75/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3607":2087,"_31098":2083,"_5":31454,"_21528":57263,"_28279":57264,"_3062":57265},[],"/docs/pr-preview/pr-75/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3607":2088,"_31098":2083,"_5":31454,"_21528":57267,"_28279":57268,"_3062":57269},[],"/docs/pr-preview/pr-75/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3607":2089,"_31098":2083,"_5":31454,"_21528":57271,"_28279":57272,"_3062":57273},[],"/docs/pr-preview/pr-75/platform/pki/certificates#open-the-action","Open the action",{"_3607":2090,"_31098":2083,"_5":31454,"_21528":57275,"_28279":57276,"_3062":57277},[],"/docs/pr-preview/pr-75/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3607":2091,"_31098":2083,"_5":31454,"_21528":57279,"_28279":57280,"_3062":57281},[],"/docs/pr-preview/pr-75/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3607":2092,"_31098":2083,"_5":31454,"_21528":57283,"_28279":57284,"_3062":57285},[],"/docs/pr-preview/pr-75/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3607":2093,"_31098":2083,"_5":31454,"_21528":57287,"_28279":57288,"_3062":57289},[],"/docs/pr-preview/pr-75/platform/pki/certificates#continue","Continue",{"_3607":2094,"_31098":2083,"_21528":57291,"_5":14794,"_28279":2083,"_3062":57292},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3607":2095,"_31098":2083,"_21528":57294,"_5":14794,"_28279":57256,"_3062":57295},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3607":2096,"_31098":2083,"_21528":57297,"_5":14794,"_28279":57256,"_3062":57298},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3607":2097,"_31098":2083,"_21528":57300,"_5":14794,"_28279":57256,"_3062":57301},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3607":2098,"_31098":2083,"_21528":57303,"_5":14794,"_28279":57256,"_3062":57304},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3607":2099,"_31098":2083,"_21528":57306,"_5":14794,"_28279":57256,"_3062":57307},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3607":2100,"_31098":2083,"_21528":57309,"_5":14794,"_28279":57256,"_3062":57310},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3607":2101,"_31098":2083,"_21528":57312,"_5":14794,"_28279":57256,"_3062":57313},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3607":2102,"_31098":2083,"_21528":57315,"_5":14794,"_28279":57260,"_3062":57316},[],"Download the PEM and inspect it:",{"_3607":2103,"_31098":2083,"_21528":57318,"_5":14794,"_28279":57260,"_3062":57319},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3607":2104,"_31098":2083,"_21528":57321,"_5":14794,"_28279":57264,"_3062":57322},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3607":2105,"_31098":2083,"_21528":57324,"_5":14794,"_28279":57264,"_3062":57325},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3607":2106,"_31098":2083,"_21528":57327,"_5":14794,"_28279":57264,"_3062":57328},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3607":2107,"_31098":2083,"_21528":57330,"_5":14794,"_28279":57264,"_3062":57331},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3607":2108,"_31098":2083,"_21528":57333,"_5":14794,"_28279":57264,"_3062":57334},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3607":2109,"_31098":2083,"_21528":57336,"_5":14794,"_28279":57264,"_3062":57337},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3607":2110,"_31098":2083,"_21528":57339,"_5":14794,"_28279":57264,"_3062":57340},[],"For browser key generation, follow Issue your first certificate.",{"_3607":2111,"_31098":2083,"_21528":57342,"_5":14794,"_28279":57268,"_3062":57343},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3607":2112,"_31098":2083,"_21528":57345,"_5":14794,"_28279":57272,"_3062":57346},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3607":2113,"_31098":2083,"_21528":57348,"_5":14794,"_28279":57276,"_3062":57349},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3607":2114,"_31098":2083,"_21528":57351,"_5":14794,"_28279":57280,"_3062":57352},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3607":2115,"_31098":2083,"_21528":57354,"_5":14794,"_28279":57280,"_3062":57355},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3607":2116,"_31098":2083,"_21528":57357,"_5":14794,"_28279":57280,"_3062":57358},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3607":2117,"_31098":2083,"_21528":57360,"_5":14794,"_28279":57284,"_3062":57361},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3607":2118,"_31098":2083,"_21528":57363,"_5":14794,"_28279":57284,"_3062":57364},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3607":2119,"_31098":2083,"_21528":57366,"_5":14794,"_28279":57284,"_3062":57367},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3607":2120,"_31098":2083,"_21528":57369,"_5":14794,"_28279":57288,"_3062":57370},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3607":2121,"_31098":2083,"_21528":57372,"_5":14794,"_28279":57288,"_3062":57373},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3607":2122,"_31098":2122,"_5":15159,"_3062":57375,"_31457":57376,"_21528":57378,"_28279":2122},"Certificate lifecycle",[50787,52299,56465,57377],"Concepts",[],{"_3607":2123,"_31098":2122,"_21528":57380,"_5":14794,"_28279":2122,"_3062":57381},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3607":2124,"_31098":2122,"_5":31454,"_21528":57383,"_28279":57384,"_3062":57385},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3607":2125,"_31098":2122,"_5":31454,"_21528":57387,"_28279":57388,"_3062":57389},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3607":2126,"_31098":2122,"_5":31454,"_21528":57391,"_28279":57392,"_3062":57393},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3607":2127,"_31098":2122,"_5":31454,"_21528":57395,"_28279":57396,"_3062":57397},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3607":2128,"_31098":2122,"_5":31454,"_21528":57399,"_28279":57400,"_3062":57401},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3607":2129,"_31098":2122,"_5":31454,"_21528":57403,"_28279":57404,"_3062":57405},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3607":2130,"_31098":2122,"_5":31454,"_21528":57407,"_28279":57408,"_3062":57409},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3607":2131,"_31098":2122,"_5":31454,"_21528":57411,"_28279":57412,"_3062":57413},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3607":2132,"_31098":2122,"_5":31454,"_21528":57415,"_28279":57416,"_3062":57417},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3607":2133,"_31098":2122,"_5":31454,"_21528":57419,"_28279":57420,"_3062":57421},[],"/docs/pr-preview/pr-75/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3607":2134,"_31098":2122,"_21528":57423,"_5":14794,"_28279":2122,"_3062":57424},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3607":2135,"_31098":2122,"_21528":57426,"_5":14794,"_28279":57388,"_3062":57427},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3607":2136,"_31098":2122,"_21528":57429,"_5":14794,"_28279":57392,"_3062":57430},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3607":2137,"_31098":2122,"_21528":57432,"_5":14794,"_28279":57396,"_3062":57433},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3607":2138,"_31098":2122,"_21528":57435,"_5":14794,"_28279":57400,"_3062":57436},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3607":2139,"_31098":2122,"_21528":57438,"_5":14794,"_28279":57404,"_3062":57439},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3607":2140,"_31098":2122,"_21528":57441,"_5":14794,"_28279":57408,"_3062":57442},[],"Lamassu persists four X.509 states:",{"_3607":2141,"_31098":2122,"_21528":57444,"_5":14794,"_28279":57408,"_3062":57445},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3607":2142,"_31098":2122,"_21528":57447,"_5":14794,"_28279":57408,"_3062":57448},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3607":2143,"_31098":2122,"_21528":57450,"_5":14794,"_28279":57408,"_3062":57451},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3607":2144,"_31098":2122,"_21528":57453,"_5":14794,"_28279":57408,"_3062":57454},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3607":2145,"_31098":2122,"_21528":57456,"_5":14794,"_28279":57408,"_3062":57457},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3607":2146,"_31098":2122,"_21528":57459,"_5":14794,"_28279":57412,"_3062":57460},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3607":2147,"_31098":2122,"_21528":57462,"_5":14794,"_28279":57412,"_3062":57463},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3607":2148,"_31098":2122,"_21528":57465,"_5":14794,"_28279":57412,"_3062":57466},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3607":2149,"_31098":2122,"_21528":57468,"_5":14794,"_28279":57416,"_3062":57469},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3607":2150,"_31098":2122,"_21528":57471,"_5":14794,"_28279":57416,"_3062":57472},[],"Before confirming:",{"_3607":2151,"_31098":2122,"_21528":57474,"_5":14794,"_28279":57416,"_3062":57475},[],"Identify DMSs, devices and services that trust that chain.",{"_3607":2152,"_31098":2122,"_21528":57477,"_5":14794,"_28279":57416,"_3062":57478},[],"Distribute the new chain of trust.",{"_3607":2153,"_31098":2122,"_21528":57480,"_5":14794,"_28279":57416,"_3062":57481},[],"Reissue the necessary identities.",{"_3607":2154,"_31098":2122,"_21528":57483,"_5":14794,"_28279":57416,"_3062":57484},[],"Check OCSP and CRL from a real consumer.",{"_3607":2155,"_31098":2122,"_21528":57486,"_5":14794,"_28279":57416,"_3062":57487},[],"Revoke the old CA once no legitimate traffic remains.",{"_3607":2156,"_31098":2122,"_21528":57489,"_5":14794,"_28279":57416,"_3062":57490},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3607":2157,"_31098":2122,"_21528":57492,"_5":14794,"_28279":57420,"_3062":57493},[],"Certificates entering the preventive or critical renewal window.",{"_3607":2158,"_31098":2122,"_21528":57495,"_5":14794,"_28279":57420,"_3062":57496},[],"Repeated enrollment or re-enrollment failures.",{"_3607":2159,"_31098":2122,"_21528":57498,"_5":14794,"_28279":57420,"_3062":57499},[],"Status changes and revocation reasons.",{"_3607":2160,"_31098":2122,"_21528":57501,"_5":14794,"_28279":57420,"_3062":57502},[],"OCSP and CRL publication and validity.",{"_3607":2161,"_31098":2122,"_21528":57504,"_5":14794,"_28279":57420,"_3062":57505},[],"Dependencies still presenting a replaced certificate.",{"_3607":2162,"_31098":2122,"_21528":57507,"_5":14794,"_28279":57420,"_3062":57508},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3607":2163,"_31098":2163,"_5":15159,"_3062":57510,"_31457":57511,"_21528":57512,"_28279":2163},"Trust model",[50787,52299,56465,57377],[],{"_3607":2164,"_31098":2163,"_21528":57514,"_5":14794,"_28279":2163,"_3062":57515},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3607":2165,"_31098":2163,"_5":31454,"_21528":57517,"_28279":57518,"_3062":57519},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3607":2166,"_31098":2163,"_5":31454,"_21528":57521,"_28279":57522,"_3062":57523},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3607":2167,"_31098":2163,"_5":31454,"_21528":57525,"_28279":57526,"_3062":57527},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3607":2168,"_31098":2163,"_5":31454,"_21528":57529,"_28279":57530,"_3062":57531},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3607":2169,"_31098":2163,"_5":31454,"_21528":57533,"_28279":57534,"_3062":57535},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3607":2170,"_31098":2163,"_5":31454,"_21528":57537,"_28279":57538,"_3062":57539},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3607":2171,"_31098":2163,"_5":31454,"_21528":57541,"_28279":57542,"_3062":57543},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3607":2172,"_31098":2163,"_5":31454,"_21528":57545,"_28279":57546,"_3062":57547},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3607":2173,"_31098":2163,"_5":31454,"_21528":57549,"_28279":57550,"_3062":57551},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3607":2174,"_31098":2163,"_5":31454,"_21528":57553,"_28279":57554,"_3062":57555},[],"/docs/pr-preview/pr-75/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3607":2175,"_31098":2163,"_21528":57557,"_5":14794,"_28279":2163,"_3062":57558},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3607":2176,"_31098":2163,"_21528":57560,"_5":14794,"_28279":57522,"_3062":57561},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3607":2177,"_31098":2163,"_21528":57563,"_5":14794,"_28279":57526,"_3062":57564},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3607":2178,"_31098":2163,"_21528":57566,"_5":14794,"_28279":57530,"_3062":57567},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3607":2179,"_31098":2163,"_21528":57569,"_5":14794,"_28279":57534,"_3062":57570},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3607":2180,"_31098":2163,"_21528":57572,"_5":14794,"_28279":57538,"_3062":57573},[],"The device proves it can enroll according to the DMS policy.",{"_3607":2181,"_31098":2163,"_21528":57575,"_5":14794,"_28279":57538,"_3062":57576},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3607":2182,"_31098":2163,"_21528":57578,"_5":14794,"_28279":57538,"_3062":57579},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3607":2183,"_31098":2163,"_21528":57581,"_5":14794,"_28279":57538,"_3062":57582},[],"The device installs the certificate and the chain it needs.",{"_3607":2184,"_31098":2163,"_21528":57584,"_5":14794,"_28279":57538,"_3062":57585},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3607":2185,"_31098":2163,"_21528":57587,"_5":14794,"_28279":57538,"_3062":57588},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3607":2186,"_31098":2163,"_21528":57590,"_5":14794,"_28279":57542,"_3062":57591},[],"A DMS relates three sets that are worth designing separately:",{"_3607":2187,"_31098":2163,"_21528":57593,"_5":14794,"_28279":57542,"_3062":57594},[],"**Enrollment CA:** signs the new identities.",{"_3607":2188,"_31098":2163,"_21528":57596,"_5":14794,"_28279":57542,"_3062":57597},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3607":2189,"_31098":2163,"_21528":57599,"_5":14794,"_28279":57542,"_3062":57600},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3607":2190,"_31098":2163,"_21528":57602,"_5":14794,"_28279":57542,"_3062":57603},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3607":2191,"_31098":2163,"_21528":57605,"_5":14794,"_28279":57546,"_3062":57606},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3607":2192,"_31098":2163,"_21528":57608,"_5":14794,"_28279":57546,"_3062":57609},[],"that the current date is between `Not Before` and `Not After`;",{"_3607":2193,"_31098":2163,"_21528":57611,"_5":14794,"_28279":57546,"_3062":57612},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3607":2194,"_31098":2163,"_21528":57614,"_5":14794,"_28279":57546,"_3062":57615},[],"that names, SANs and subject match the expected identity;",{"_3607":2195,"_31098":2163,"_21528":57617,"_5":14794,"_28279":57546,"_3062":57618},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3607":2196,"_31098":2163,"_21528":57620,"_5":14794,"_28279":57546,"_3062":57621},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3607":2197,"_31098":2163,"_21528":57623,"_5":14794,"_28279":57546,"_3062":57624},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3607":2198,"_31098":2163,"_21528":57626,"_5":14794,"_28279":57550,"_3062":57627},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3607":2199,"_31098":2163,"_21528":57629,"_5":14794,"_28279":57554,"_3062":57630},[],"Keep the root out of daily operations, or with very restricted access.",{"_3607":2200,"_31098":2163,"_21528":57632,"_5":14794,"_28279":57554,"_3062":57633},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3607":2201,"_31098":2163,"_21528":57635,"_5":14794,"_28279":57554,"_3062":57636},[],"Assign explicit profiles to every use case.",{"_3607":2202,"_31098":2163,"_21528":57638,"_5":14794,"_28279":57554,"_3062":57639},[],"Distribute the new trust before starting a rotation.",{"_3607":2203,"_31098":2163,"_21528":57641,"_5":14794,"_28279":57554,"_3062":57642},[],"Keep enough overlap to renew a disconnected fleet.",{"_3607":2204,"_31098":2163,"_21528":57644,"_5":14794,"_28279":57554,"_3062":57645},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3607":2205,"_31098":2163,"_21528":57647,"_5":14794,"_28279":57554,"_3062":57648},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3607":2206,"_31098":2206,"_5":15159,"_3062":57650,"_31457":57651,"_21528":57652,"_28279":2206},"Revocation lists (CRL)",[50787,52299,56465,57122],[],{"_3607":2207,"_31098":2206,"_21528":57654,"_5":14794,"_28279":2206,"_3062":57655},[],"Generate and distribute signed lists to validate certificates offline.",{"_3607":2208,"_31098":2206,"_5":31454,"_21528":57657,"_28279":57658,"_3062":57659},[],"/docs/pr-preview/pr-75/platform/pki/crl#crl-settings","CRL settings",{"_3607":2209,"_31098":2206,"_5":31454,"_21528":57661,"_28279":57662,"_3062":57663},[],"/docs/pr-preview/pr-75/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3607":2210,"_31098":2206,"_5":31454,"_21528":57665,"_28279":57666,"_3062":57667},[],"/docs/pr-preview/pr-75/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3607":2211,"_31098":2206,"_5":31454,"_21528":57669,"_28279":57670,"_3062":57671},[],"/docs/pr-preview/pr-75/platform/pki/crl#crl-contents","CRL contents",{"_3607":2212,"_31098":2206,"_5":31454,"_21528":57673,"_28279":57674,"_3062":57675},[],"/docs/pr-preview/pr-75/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3607":2213,"_31098":2206,"_5":31454,"_21528":57677,"_28279":57678,"_3062":57679},[],"/docs/pr-preview/pr-75/platform/pki/crl#crl-settings-api","CRL settings API",{"_3607":2214,"_31098":2206,"_5":31454,"_21528":57681,"_28279":57682,"_3062":57683},[],"/docs/pr-preview/pr-75/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3607":2215,"_31098":2206,"_5":31454,"_21528":57685,"_28279":57686,"_3062":57687},[],"/docs/pr-preview/pr-75/platform/pki/crl#references","References",{"_3607":2216,"_31098":2206,"_21528":57689,"_5":14794,"_28279":2206,"_3062":57690},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3607":2217,"_31098":2206,"_21528":57692,"_5":14794,"_28279":57658,"_3062":57693},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3607":2218,"_31098":2206,"_21528":57695,"_5":14794,"_28279":57658,"_3062":57696},[],"Field",{"_3607":2219,"_31098":2206,"_21528":57698,"_5":14794,"_28279":57658,"_3062":51177},[],{"_3607":2220,"_31098":2206,"_21528":57700,"_5":14794,"_28279":57658,"_3062":52419},[],{"_3607":2221,"_31098":2206,"_21528":57702,"_5":14794,"_28279":57658,"_3062":57703},[],"ID of the CA the settings belong to.",{"_3607":2222,"_31098":2206,"_21528":57705,"_5":14794,"_28279":57658,"_3062":57706},[],"`status`",{"_3607":2223,"_31098":2206,"_21528":57708,"_5":14794,"_28279":57658,"_3062":57709},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3607":2224,"_31098":2206,"_21528":57711,"_5":14794,"_28279":57658,"_3062":57712},[],"`legacy_ski`",{"_3607":2225,"_31098":2206,"_21528":57714,"_5":14794,"_28279":57658,"_3062":57715},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3607":2226,"_31098":2206,"_21528":57717,"_5":14794,"_28279":57658,"_3062":57718},[],"`latest_crl`",{"_3607":2227,"_31098":2206,"_21528":57720,"_5":14794,"_28279":57658,"_3062":57721},[],"Version, validity start and end of the last published list. Read-only.",{"_3607":2228,"_31098":2206,"_21528":57723,"_5":14794,"_28279":57658,"_3062":57724},[],"`crl_options` field",{"_3607":2229,"_31098":2206,"_21528":57726,"_5":14794,"_28279":57658,"_3062":51177},[],{"_3607":2230,"_31098":2206,"_21528":57728,"_5":14794,"_28279":57658,"_3062":57729},[],"Initial value",{"_3607":2231,"_31098":2206,"_21528":57731,"_5":14794,"_28279":57658,"_3062":57732},[],"`validity`",{"_3607":2232,"_31098":2206,"_21528":57734,"_5":14794,"_28279":57658,"_3062":57735},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3607":2233,"_31098":2206,"_21528":57737,"_5":14794,"_28279":57658,"_3062":57738},[],"7 days.",{"_3607":2234,"_31098":2206,"_21528":57740,"_5":14794,"_28279":57658,"_3062":57741},[],"`refresh_interval`",{"_3607":2235,"_31098":2206,"_21528":57743,"_5":14794,"_28279":57658,"_3062":57744},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3607":2236,"_31098":2206,"_21528":57746,"_5":14794,"_28279":57658,"_3062":57747},[],"6 days and 23 hours.",{"_3607":2237,"_31098":2206,"_21528":57749,"_5":14794,"_28279":57658,"_3062":57750},[],"`regenerate_on_revoke`",{"_3607":2238,"_31098":2206,"_21528":57752,"_5":14794,"_28279":57658,"_3062":57753},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3607":2239,"_31098":2206,"_21528":57755,"_5":14794,"_28279":57658,"_3062":57756},[],"`true`.",{"_3607":2240,"_31098":2206,"_21528":57758,"_5":14794,"_28279":57658,"_3062":57759},[],"`signer_serial_number`",{"_3607":2241,"_31098":2206,"_21528":57761,"_5":14794,"_28279":57658,"_3062":57762},[],"Serial number of the existing certificate that signs the CRL.",{"_3607":2242,"_31098":2206,"_21528":57764,"_5":14794,"_28279":57658,"_3062":57765},[],"Serial number of the CA’s current certificate.",{"_3607":2243,"_31098":2206,"_21528":57767,"_5":14794,"_28279":57658,"_3062":57768},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3607":2244,"_31098":2206,"_21528":57770,"_5":14794,"_28279":57658,"_3062":57771},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3607":2245,"_31098":2206,"_21528":57773,"_5":14794,"_28279":57658,"_3062":57774},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3607":2246,"_31098":2206,"_21528":57776,"_5":14794,"_28279":57658,"_3062":57777},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3607":2247,"_31098":2206,"_21528":57779,"_5":14794,"_28279":57658,"_3062":57780},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3607":2248,"_31098":2206,"_21528":57782,"_5":14794,"_28279":57658,"_3062":57783},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3607":2249,"_31098":2206,"_21528":57785,"_5":14794,"_28279":57658,"_3062":57786},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3607":2250,"_31098":2206,"_21528":57788,"_5":14794,"_28279":57658,"_3062":57789},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3607":2251,"_31098":2206,"_21528":57791,"_5":14794,"_28279":57658,"_3062":57792},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3607":2252,"_31098":2206,"_21528":57794,"_5":14794,"_28279":57658,"_3062":57795},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3607":2253,"_31098":2206,"_21528":57797,"_5":14794,"_28279":57658,"_3062":57798},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3607":2254,"_31098":2206,"_21528":57800,"_5":14794,"_28279":57662,"_3062":57801},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3607":2255,"_31098":2206,"_21528":57803,"_5":14794,"_28279":57662,"_3062":57804},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3607":2256,"_31098":2206,"_21528":57806,"_5":14794,"_28279":57662,"_3062":57807},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3607":2257,"_31098":2206,"_21528":57809,"_5":14794,"_28279":57662,"_3062":57810},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3607":2258,"_31098":2206,"_21528":57812,"_5":14794,"_28279":57666,"_3062":57813},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3607":2259,"_31098":2206,"_21528":57815,"_5":14794,"_28279":57666,"_3062":57816},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3607":2260,"_31098":2206,"_21528":57818,"_5":14794,"_28279":57666,"_3062":57819},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3607":2261,"_31098":2206,"_21528":57821,"_5":14794,"_28279":57666,"_3062":57822},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3607":2262,"_31098":2206,"_21528":57824,"_5":14794,"_28279":57666,"_3062":57825},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3607":2263,"_31098":2206,"_21528":57827,"_5":14794,"_28279":57666,"_3062":57828},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3607":2264,"_31098":2206,"_21528":57830,"_5":14794,"_28279":57666,"_3062":57831},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3607":2265,"_31098":2206,"_21528":57833,"_5":14794,"_28279":57666,"_3062":57834},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3607":2266,"_31098":2206,"_21528":57836,"_5":14794,"_28279":57666,"_3062":57837},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3607":2267,"_31098":2206,"_21528":57839,"_5":14794,"_28279":57670,"_3062":57840},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3607":2268,"_31098":2206,"_21528":57842,"_5":14794,"_28279":57670,"_3062":57843},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3607":2269,"_31098":2206,"_21528":57845,"_5":14794,"_28279":57674,"_3062":57846},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3607":2270,"_31098":2206,"_21528":57848,"_5":14794,"_28279":57674,"_3062":57849},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3607":2271,"_31098":2206,"_21528":57851,"_5":14794,"_28279":57674,"_3062":57852},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3607":2272,"_31098":2206,"_21528":57854,"_5":14794,"_28279":57674,"_3062":57855},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3607":2273,"_31098":2206,"_21528":57857,"_5":14794,"_28279":57674,"_3062":57858},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3607":2274,"_31098":2206,"_21528":57860,"_5":14794,"_28279":57678,"_3062":57861},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3607":2275,"_31098":2206,"_21528":57863,"_5":14794,"_28279":57678,"_3062":54230},[],{"_3607":2276,"_31098":2206,"_21528":57865,"_5":14794,"_28279":57678,"_3062":57866},[],"Relative path",{"_3607":2277,"_31098":2206,"_21528":57868,"_5":14794,"_28279":57678,"_3062":54227},[],{"_3607":2278,"_31098":2206,"_21528":57870,"_5":14794,"_28279":57678,"_3062":57871},[],"`GET`",{"_3607":2279,"_31098":2206,"_21528":57873,"_5":14794,"_28279":57678,"_3062":57874},[],"`/v1/crl-settings`",{"_3607":2280,"_31098":2206,"_21528":57876,"_5":14794,"_28279":57678,"_3062":57877},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3607":2281,"_31098":2206,"_21528":57879,"_5":14794,"_28279":57678,"_3062":57871},[],{"_3607":2282,"_31098":2206,"_21528":57881,"_5":14794,"_28279":57678,"_3062":57882},[],"`/v1/crl-settings/{ca-id}`",{"_3607":2283,"_31098":2206,"_21528":57884,"_5":14794,"_28279":57678,"_3062":57885},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3607":2284,"_31098":2206,"_21528":57887,"_5":14794,"_28279":57678,"_3062":57888},[],"`PUT`",{"_3607":2285,"_31098":2206,"_21528":57890,"_5":14794,"_28279":57678,"_3062":57882},[],{"_3607":2286,"_31098":2206,"_21528":57892,"_5":14794,"_28279":57678,"_3062":57893},[],"Replace the CRL configuration of a CA.",{"_3607":2287,"_31098":2206,"_21528":57895,"_5":14794,"_28279":57678,"_3062":57896},[],"`DELETE`",{"_3607":2288,"_31098":2206,"_21528":57898,"_5":14794,"_28279":57678,"_3062":57882},[],{"_3607":2289,"_31098":2206,"_21528":57900,"_5":14794,"_28279":57678,"_3062":57901},[],"Remove the archived CRL settings of a CA.",{"_3607":2290,"_31098":2206,"_21528":57903,"_5":14794,"_28279":57678,"_3062":57904},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3607":2291,"_31098":2206,"_21528":57906,"_5":14794,"_28279":57678,"_3062":57907},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3607":2292,"_31098":2206,"_21528":57909,"_5":14794,"_28279":57678,"_3062":57910},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3607":2293,"_31098":2206,"_21528":57912,"_5":14794,"_28279":57682,"_3062":57913},[],"Symptom",{"_3607":2294,"_31098":2206,"_21528":57915,"_5":14794,"_28279":57682,"_3062":57916},[],"Cause",{"_3607":2295,"_31098":2206,"_21528":57918,"_5":14794,"_28279":57682,"_3062":57919},[],"Action",{"_3607":2296,"_31098":2206,"_21528":57921,"_5":14794,"_28279":57682,"_3062":57922},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3607":2297,"_31098":2206,"_21528":57924,"_5":14794,"_28279":57682,"_3062":57925},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3607":2298,"_31098":2206,"_21528":57927,"_5":14794,"_28279":57682,"_3062":57928},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3607":2299,"_31098":2206,"_21528":57930,"_5":14794,"_28279":57682,"_3062":57931},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3607":2300,"_31098":2206,"_21528":57933,"_5":14794,"_28279":57682,"_3062":57934},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3607":2301,"_31098":2206,"_21528":57936,"_5":14794,"_28279":57682,"_3062":57937},[],"Delete the CA first; deleting it archives its settings.",{"_3607":2302,"_31098":2206,"_21528":57939,"_5":14794,"_28279":57682,"_3062":57940},[],"`PUT` returns 400.",{"_3607":2303,"_31098":2206,"_21528":57942,"_5":14794,"_28279":57682,"_3062":57943},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3607":2304,"_31098":2206,"_21528":57945,"_5":14794,"_28279":57682,"_3062":57946},[],"Set the serial number of a valid certificate of that CA.",{"_3607":2305,"_31098":2206,"_21528":57948,"_5":14794,"_28279":57682,"_3062":57949},[],"`PUT` returns 404.",{"_3607":2306,"_31098":2206,"_21528":57951,"_5":14794,"_28279":57682,"_3062":57952},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3607":2307,"_31098":2206,"_21528":57954,"_5":14794,"_28279":57682,"_3062":57955},[],"Check the CA ID and the signer serial number.",{"_3607":2308,"_31098":2206,"_21528":57957,"_5":14794,"_28279":57682,"_3062":57958},[],"`PUT` returns 400 from a 3.x client.",{"_3607":2309,"_31098":2206,"_21528":57960,"_5":14794,"_28279":57682,"_3062":57961},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3607":2310,"_31098":2206,"_21528":57963,"_5":14794,"_28279":57682,"_3062":57964},[],"Update the client to send the new field.",{"_3607":2311,"_31098":2206,"_21528":57966,"_5":14794,"_28279":57682,"_3062":57967},[],"The CRL does not change after revoking a certificate.",{"_3607":2312,"_31098":2206,"_21528":57969,"_5":14794,"_28279":57682,"_3062":57970},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3607":2313,"_31098":2206,"_21528":57972,"_5":14794,"_28279":57682,"_3062":57973},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3607":2314,"_31098":2206,"_21528":57975,"_5":14794,"_28279":57682,"_3062":57976},[],"A verifier rejects the CRL because of the issuer.",{"_3607":2315,"_31098":2206,"_21528":57978,"_5":14794,"_28279":57682,"_3062":57979},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3607":2316,"_31098":2206,"_21528":57981,"_5":14794,"_28279":57682,"_3062":57982},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3607":2317,"_31098":2206,"_21528":57984,"_5":14794,"_28279":57686,"_3062":57985},[],"RFC 5280: X.509 and CRL profile.",{"_3607":2318,"_31098":2206,"_21528":57987,"_5":14794,"_28279":57686,"_3062":57988},[],"OpenSSL: openssl-crl.",{"_3607":2319,"_31098":2206,"_21528":57990,"_5":14794,"_28279":57686,"_3062":57991},[],"OpenSSL: openssl-verify.",{"_3607":2320,"_31098":2206,"_21528":57993,"_5":14794,"_28279":57686,"_3062":57994},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3607":2321,"_31098":2206,"_21528":57996,"_5":14794,"_28279":57686,"_3062":57997},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3607":2322,"_31098":2322,"_5":15159,"_3062":57999,"_31457":58000,"_21528":58001,"_28279":2322},"Keys and cryptographic engines",[50787,52299,56465,56466],[],{"_3607":2323,"_31098":2322,"_21528":58003,"_5":14794,"_28279":2322,"_3062":58004},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3607":2324,"_31098":2322,"_5":31454,"_21528":58006,"_28279":58007,"_3062":58008},[],"/docs/pr-preview/pr-75/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3607":2325,"_31098":2322,"_5":31454,"_21528":58010,"_28279":58011,"_3062":58012},[],"/docs/pr-preview/pr-75/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3607":2326,"_31098":2322,"_5":31454,"_21528":58014,"_28279":58015,"_3062":58016},[],"/docs/pr-preview/pr-75/platform/pki/key-management#file-system","File System",{"_3607":2327,"_31098":2322,"_5":31454,"_21528":58018,"_28279":58019,"_3062":58020},[],"/docs/pr-preview/pr-75/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3607":2328,"_31098":2322,"_5":31454,"_21528":58022,"_28279":58023,"_3062":58024},[],"/docs/pr-preview/pr-75/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3607":2329,"_31098":2322,"_5":31454,"_21528":58026,"_28279":58027,"_3062":58028},[],"/docs/pr-preview/pr-75/platform/pki/key-management#aws-kms","AWS KMS",{"_3607":2330,"_31098":2322,"_5":31454,"_21528":58030,"_28279":58031,"_3062":58032},[],"/docs/pr-preview/pr-75/platform/pki/key-management#pkcs11","PKCS#11",{"_3607":2331,"_31098":2322,"_5":31454,"_21528":58034,"_28279":58035,"_3062":58036},[],"/docs/pr-preview/pr-75/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3607":2332,"_31098":2322,"_5":31454,"_21528":58038,"_28279":58039,"_3062":58040},[],"/docs/pr-preview/pr-75/platform/pki/key-management#key-inventory","Key inventory",{"_3607":2333,"_31098":2322,"_5":31454,"_21528":58042,"_28279":58043,"_3062":58044},[],"/docs/pr-preview/pr-75/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3607":2334,"_31098":2322,"_5":31454,"_21528":58046,"_28279":58047,"_3062":58048},[],"/docs/pr-preview/pr-75/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3607":2335,"_31098":2322,"_5":31454,"_21528":58050,"_28279":58051,"_3062":58052},[],"/docs/pr-preview/pr-75/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3607":2336,"_31098":2322,"_5":31454,"_21528":58054,"_28279":58055,"_3062":58056},[],"/docs/pr-preview/pr-75/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3607":2337,"_31098":2322,"_5":31454,"_21528":58058,"_28279":58059,"_3062":58060},[],"/docs/pr-preview/pr-75/platform/pki/key-management#view-details","View details",{"_3607":2338,"_31098":2322,"_5":31454,"_21528":58062,"_28279":58063,"_3062":58064},[],"/docs/pr-preview/pr-75/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3607":2339,"_31098":2322,"_5":31454,"_21528":58066,"_28279":58067,"_3062":58068},[],"/docs/pr-preview/pr-75/platform/pki/key-management#sign","Sign",{"_3607":2340,"_31098":2322,"_5":31454,"_21528":58070,"_28279":58071,"_3062":58072},[],"/docs/pr-preview/pr-75/platform/pki/key-management#verify","Verify",{"_3607":2341,"_31098":2322,"_5":31454,"_21528":58074,"_28279":58075,"_3062":58076},[],"/docs/pr-preview/pr-75/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3607":2342,"_31098":2322,"_5":31454,"_21528":58078,"_28279":58079,"_3062":58080},[],"/docs/pr-preview/pr-75/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3607":2343,"_31098":2322,"_5":31454,"_21528":58082,"_28279":58083,"_3062":58084},[],"/docs/pr-preview/pr-75/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3607":2344,"_31098":2322,"_21528":58086,"_5":14794,"_28279":2322,"_3062":58087},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3607":2345,"_31098":2322,"_21528":58089,"_5":14794,"_28279":2322,"_3062":58090},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3607":2346,"_31098":2322,"_21528":58092,"_5":14794,"_28279":58007,"_3062":58093},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3607":2347,"_31098":2322,"_21528":58095,"_5":14794,"_28279":58007,"_3062":58096},[],"In practice, it lets you:",{"_3607":2348,"_31098":2322,"_21528":58098,"_5":14794,"_28279":58007,"_3062":58099},[],"Generate new key pairs from Lamassu IoT.",{"_3607":2349,"_31098":2322,"_21528":58101,"_5":14794,"_28279":58007,"_3062":58102},[],"Import keys created externally.",{"_3607":2350,"_31098":2322,"_21528":58104,"_5":14794,"_28279":58007,"_3062":58105},[],"Delegate custody and cryptographic operations to external engines.",{"_3607":2351,"_31098":2322,"_21528":58107,"_5":14794,"_28279":58007,"_3062":58108},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3607":2352,"_31098":2322,"_21528":58110,"_5":14794,"_28279":58011,"_3062":58111},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3607":2353,"_31098":2322,"_21528":58113,"_5":14794,"_28279":58011,"_3062":58114},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3607":2354,"_31098":2322,"_21528":58116,"_5":14794,"_28279":58011,"_3062":58117},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3607":2355,"_31098":2322,"_21528":58119,"_5":14794,"_28279":58015,"_3062":58120},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3607":2356,"_31098":2322,"_21528":58122,"_5":14794,"_28279":58019,"_3062":58123},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3607":2357,"_31098":2322,"_21528":58125,"_5":14794,"_28279":58019,"_3062":58126},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3607":2358,"_31098":2322,"_21528":58128,"_5":14794,"_28279":58023,"_3062":58129},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3607":2359,"_31098":2322,"_21528":58131,"_5":14794,"_28279":58027,"_3062":58132},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3607":2360,"_31098":2322,"_21528":58134,"_5":14794,"_28279":58031,"_3062":58135},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3607":2361,"_31098":2322,"_21528":58137,"_5":14794,"_28279":58035,"_3062":58138},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3607":2362,"_31098":2322,"_21528":58140,"_5":14794,"_28279":58035,"_3062":58141},[],"Lamassu shows the enabled engines in the console.",{"_3607":2363,"_31098":2322,"_21528":58143,"_5":14794,"_28279":58035,"_3062":58144},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3607":2364,"_31098":2322,"_21528":58146,"_5":14794,"_28279":58035,"_3062":58147},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3607":2365,"_31098":2322,"_21528":58149,"_5":14794,"_28279":58039,"_3062":58150},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3607":2366,"_31098":2322,"_21528":58152,"_5":14794,"_28279":58039,"_3062":58153},[],"The table includes the following fields:",{"_3607":2367,"_31098":2322,"_21528":58155,"_5":14794,"_28279":58039,"_3062":58156},[],"**Name**: descriptive name of the key.",{"_3607":2368,"_31098":2322,"_21528":58158,"_5":14794,"_28279":58039,"_3062":58159},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3607":2369,"_31098":2322,"_21528":58161,"_5":14794,"_28279":58039,"_3062":58162},[],"**Strength**: visual indicator of cryptographic strength.",{"_3607":2370,"_31098":2322,"_21528":58164,"_5":14794,"_28279":58039,"_3062":58165},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3607":2371,"_31098":2322,"_21528":58167,"_5":14794,"_28279":58039,"_3062":58168},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3607":2372,"_31098":2322,"_21528":58170,"_5":14794,"_28279":58039,"_3062":58171},[],"**Aliases**: alternative names associated with the key.",{"_3607":2373,"_31098":2322,"_21528":58173,"_5":14794,"_28279":58039,"_3062":58174},[],"**Tags**: labels for classification and search.",{"_3607":2374,"_31098":2322,"_21528":58176,"_5":14794,"_28279":58039,"_3062":58177},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3607":2375,"_31098":2322,"_21528":58179,"_5":14794,"_28279":58039,"_3062":58180},[],"From this view you also reach the most common actions:",{"_3607":2376,"_31098":2322,"_21528":58182,"_5":14794,"_28279":58039,"_3062":58183},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3607":2377,"_31098":2322,"_21528":58185,"_5":14794,"_28279":58039,"_3062":58186},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3607":2378,"_31098":2322,"_21528":58188,"_5":14794,"_28279":58039,"_3062":58189},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3607":2379,"_31098":2322,"_21528":58191,"_5":14794,"_28279":58039,"_3062":58192},[],"**Delete Key** to remove the key from the system.",{"_3607":2380,"_31098":2322,"_21528":58194,"_5":14794,"_28279":58043,"_3062":58195},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3607":2381,"_31098":2322,"_21528":58197,"_5":14794,"_28279":58047,"_3062":58198},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3607":2382,"_31098":2322,"_21528":58200,"_5":14794,"_28279":58047,"_3062":58201},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3607":2383,"_31098":2322,"_21528":58203,"_5":14794,"_28279":58047,"_3062":58204},[],"**Key Name**: unique and descriptive name.",{"_3607":2384,"_31098":2322,"_21528":58206,"_5":14794,"_28279":58047,"_3062":58207},[],"**Crypto Engine**: engine that will keep the key.",{"_3607":2385,"_31098":2322,"_21528":58209,"_5":14794,"_28279":58047,"_3062":58210},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3607":2386,"_31098":2322,"_21528":58212,"_5":14794,"_28279":58047,"_3062":58213},[],"**Tags**: metadata to classify the key.",{"_3607":2387,"_31098":2322,"_21528":58215,"_5":14794,"_28279":58047,"_3062":58216},[],"**Metadata**: additional information for advanced uses.",{"_3607":2388,"_31098":2322,"_21528":58218,"_5":14794,"_28279":58051,"_3062":58219},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3607":2389,"_31098":2322,"_21528":58221,"_5":14794,"_28279":58051,"_3062":58222},[],"When you have an exportable private key and the destination engine supports import.",{"_3607":2390,"_31098":2322,"_21528":58224,"_5":14794,"_28279":58051,"_3062":58225},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3607":2391,"_31098":2322,"_21528":58227,"_5":14794,"_28279":58051,"_3062":58228},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3607":2392,"_31098":2322,"_21528":58230,"_5":14794,"_28279":58051,"_3062":58231},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3607":2393,"_31098":2322,"_21528":58233,"_5":14794,"_28279":58051,"_3062":58234},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3607":2394,"_31098":2322,"_21528":58236,"_5":14794,"_28279":58051,"_3062":58237},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3607":2395,"_31098":2322,"_21528":58239,"_5":14794,"_28279":58051,"_3062":58240},[],"**Tags**: labels for organization and search.",{"_3607":2396,"_31098":2322,"_21528":58242,"_5":14794,"_28279":58051,"_3062":58243},[],"**Metadata**: additional optional information.",{"_3607":2397,"_31098":2322,"_21528":58245,"_5":14794,"_28279":58051,"_3062":58246},[],"**Private Key (PEM)**: private key in PEM format.",{"_3607":2398,"_31098":2322,"_21528":58248,"_5":14794,"_28279":58051,"_3062":58249},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3607":2399,"_31098":2322,"_21528":58251,"_5":14794,"_28279":58055,"_3062":58252},[],"Each registered key has a detail view and several operational actions.",{"_3607":2400,"_31098":2322,"_21528":58254,"_5":14794,"_28279":58059,"_3062":58255},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3607":2401,"_31098":2322,"_21528":58257,"_5":14794,"_28279":58059,"_3062":58258},[],"The **Overview** tab shows, among others, these fields:",{"_3607":2402,"_31098":2322,"_21528":58260,"_5":14794,"_28279":58059,"_3062":58261},[],"**Key Name**: descriptive name.",{"_3607":2403,"_31098":2322,"_21528":58263,"_5":14794,"_28279":58059,"_3062":58264},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3607":2404,"_31098":2322,"_21528":58266,"_5":14794,"_28279":58059,"_3062":58267},[],"**Tags**: associated labels.",{"_3607":2405,"_31098":2322,"_21528":58269,"_5":14794,"_28279":58059,"_3062":58270},[],"**Aliases**: alternative names.",{"_3607":2406,"_31098":2322,"_21528":58272,"_5":14794,"_28279":58059,"_3062":58273},[],"**Crypto Engine**: engine where the key resides.",{"_3607":2407,"_31098":2322,"_21528":58275,"_5":14794,"_28279":58059,"_3062":58276},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3607":2408,"_31098":2322,"_21528":58278,"_5":14794,"_28279":58059,"_3062":58279},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3607":2409,"_31098":2322,"_21528":58281,"_5":14794,"_28279":58059,"_3062":58282},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3607":2410,"_31098":2322,"_21528":58284,"_5":14794,"_28279":58063,"_3062":58285},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3607":2411,"_31098":2322,"_21528":58287,"_5":14794,"_28279":58063,"_3062":58288},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3607":2412,"_31098":2322,"_21528":58290,"_5":14794,"_28279":58063,"_3062":58291},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3607":2413,"_31098":2322,"_21528":58293,"_5":14794,"_28279":58067,"_3062":58294},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3607":2414,"_31098":2322,"_21528":58296,"_5":14794,"_28279":58067,"_3062":58297},[],"Main fields:",{"_3607":2415,"_31098":2322,"_21528":58299,"_5":14794,"_28279":58067,"_3062":58300},[],"**Algorithm**: signing algorithm available for the key type.",{"_3607":2416,"_31098":2322,"_21528":58302,"_5":14794,"_28279":58067,"_3062":58303},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3607":2417,"_31098":2322,"_21528":58305,"_5":14794,"_28279":58067,"_3062":58306},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3607":2418,"_31098":2322,"_21528":58308,"_5":14794,"_28279":58067,"_3062":58309},[],"**Message**: content to sign.",{"_3607":2419,"_31098":2322,"_21528":58311,"_5":14794,"_28279":58067,"_3062":58312},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3607":2420,"_31098":2322,"_21528":58314,"_5":14794,"_28279":58071,"_3062":58315},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3607":2421,"_31098":2322,"_21528":58317,"_5":14794,"_28279":58071,"_3062":58297},[],{"_3607":2422,"_31098":2322,"_21528":58319,"_5":14794,"_28279":58071,"_3062":58320},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3607":2423,"_31098":2322,"_21528":58322,"_5":14794,"_28279":58071,"_3062":58323},[],"**Message Type**: `Raw` or `Digest`.",{"_3607":2424,"_31098":2322,"_21528":58325,"_5":14794,"_28279":58071,"_3062":58326},[],"**Payload Encoding**: encoding of the message.",{"_3607":2425,"_31098":2322,"_21528":58328,"_5":14794,"_28279":58071,"_3062":58329},[],"**Message**: original message or hash.",{"_3607":2426,"_31098":2322,"_21528":58331,"_5":14794,"_28279":58071,"_3062":58332},[],"**Signature**: signature to check.",{"_3607":2427,"_31098":2322,"_21528":58334,"_5":14794,"_28279":58071,"_3062":58335},[],"**Result**: indicator of the validation result.",{"_3607":2428,"_31098":2322,"_21528":58337,"_5":14794,"_28279":58075,"_3062":58338},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3607":2429,"_31098":2322,"_21528":58340,"_5":14794,"_28279":58075,"_3062":58341},[],"This flow is useful for:",{"_3607":2430,"_31098":2322,"_21528":58343,"_5":14794,"_28279":58075,"_3062":58344},[],"Requesting certificates from an external CA.",{"_3607":2431,"_31098":2322,"_21528":58346,"_5":14794,"_28279":58075,"_3062":58347},[],"Renewing an identity while keeping the same key.",{"_3607":2432,"_31098":2322,"_21528":58349,"_5":14794,"_28279":58075,"_3062":58350},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3607":2433,"_31098":2322,"_21528":58352,"_5":14794,"_28279":58075,"_3062":58353},[],"**Common Name (CN)**: main name of the identity.",{"_3607":2434,"_31098":2322,"_21528":58355,"_5":14794,"_28279":58075,"_3062":58356},[],"**Organization (O)**: organization or company.",{"_3607":2435,"_31098":2322,"_21528":58358,"_5":14794,"_28279":58075,"_3062":58359},[],"**Organizational Unit (OU)**: department or unit.",{"_3607":2436,"_31098":2322,"_21528":58361,"_5":14794,"_28279":58075,"_3062":58362},[],"**Country (C)**: two-letter country code.",{"_3607":2437,"_31098":2322,"_21528":58364,"_5":14794,"_28279":58075,"_3062":58365},[],"**State / Province (ST)**: state or province.",{"_3607":2438,"_31098":2322,"_21528":58367,"_5":14794,"_28279":58075,"_3062":58368},[],"**Locality (L)**: city or locality.",{"_3607":2439,"_31098":2322,"_21528":58370,"_5":14794,"_28279":58075,"_3062":58371},[],"**Email Address**: contact email.",{"_3607":2440,"_31098":2322,"_21528":58373,"_5":14794,"_28279":58075,"_3062":58374},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3607":2441,"_31098":2322,"_21528":58376,"_5":14794,"_28279":58075,"_3062":58377},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3607":2442,"_31098":2322,"_21528":58379,"_5":14794,"_28279":58079,"_3062":58380},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3607":2443,"_31098":2322,"_21528":58382,"_5":14794,"_28279":58079,"_3062":58383},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3607":2444,"_31098":2322,"_21528":58385,"_5":14794,"_28279":58083,"_3062":58386},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3607":2445,"_31098":2322,"_21528":58388,"_5":14794,"_28279":58083,"_3062":58389},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3607":2446,"_31098":2446,"_5":15159,"_3062":58391,"_31457":58392,"_21528":58393,"_28279":2446},"Online validation with OCSP",[50787,52299,56465,57122],[],{"_3607":2447,"_31098":2446,"_21528":58395,"_5":14794,"_28279":2446,"_3062":58396},[],"Query signed status and verify the responder’s response.",{"_3607":2448,"_31098":2446,"_5":31454,"_21528":58398,"_28279":58399,"_3062":58400},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3607":2449,"_31098":2446,"_5":31454,"_21528":58402,"_28279":58403,"_3062":58404},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3607":2450,"_31098":2446,"_5":31454,"_21528":58406,"_28279":58407,"_3062":58408},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3607":2451,"_31098":2446,"_5":31454,"_21528":58410,"_28279":58411,"_3062":58412},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3607":2452,"_31098":2446,"_5":31454,"_21528":58414,"_28279":58415,"_3062":58416},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3607":2453,"_31098":2446,"_5":31454,"_21528":58418,"_28279":58419,"_3062":57687},[],"/docs/pr-preview/pr-75/platform/pki/ocsp#references",{"_3607":2454,"_31098":2446,"_21528":58421,"_5":14794,"_28279":2446,"_3062":58422},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3607":2455,"_31098":2446,"_21528":58424,"_5":14794,"_28279":58399,"_3062":58425},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3607":2456,"_31098":2446,"_21528":58427,"_5":14794,"_28279":58399,"_3062":58428},[],"Record status",{"_3607":2457,"_31098":2446,"_21528":58430,"_5":14794,"_28279":58399,"_3062":58431},[],"Signed response",{"_3607":2458,"_31098":2446,"_21528":58433,"_5":14794,"_28279":58399,"_3062":55602},[],{"_3607":2459,"_31098":2446,"_21528":58435,"_5":14794,"_28279":58399,"_3062":58436},[],"`Good`.",{"_3607":2460,"_31098":2446,"_21528":58438,"_5":14794,"_28279":58399,"_3062":55619},[],{"_3607":2461,"_31098":2446,"_21528":58440,"_5":14794,"_28279":58399,"_3062":58441},[],"`Revoked`, with revocation reason and timestamp.",{"_3607":2462,"_31098":2446,"_21528":58443,"_5":14794,"_28279":58399,"_3062":58444},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3607":2463,"_31098":2446,"_21528":58446,"_5":14794,"_28279":58399,"_3062":58447},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3607":2464,"_31098":2446,"_21528":58449,"_5":14794,"_28279":58399,"_3062":58450},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3607":2465,"_31098":2446,"_21528":58452,"_5":14794,"_28279":58399,"_3062":58453},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3607":2466,"_31098":2446,"_21528":58455,"_5":14794,"_28279":58399,"_3062":58456},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3607":2467,"_31098":2446,"_21528":58458,"_5":14794,"_28279":58403,"_3062":58459},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3607":2468,"_31098":2446,"_21528":58461,"_5":14794,"_28279":58403,"_3062":58462},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3607":2469,"_31098":2446,"_21528":58464,"_5":14794,"_28279":58407,"_3062":58465},[],"The service accepts:",{"_3607":2470,"_31098":2446,"_21528":58467,"_5":14794,"_28279":58407,"_3062":54230},[],{"_3607":2471,"_31098":2446,"_21528":58469,"_5":14794,"_28279":58407,"_3062":58470},[],"VA service path",{"_3607":2472,"_31098":2446,"_21528":58472,"_5":14794,"_28279":58407,"_3062":58473},[],"Format",{"_3607":2473,"_31098":2446,"_21528":58475,"_5":14794,"_28279":58407,"_3062":58476},[],"`POST`",{"_3607":2474,"_31098":2446,"_21528":58478,"_5":14794,"_28279":58407,"_3062":58479},[],"`/ocsp`",{"_3607":2475,"_31098":2446,"_21528":58481,"_5":14794,"_28279":58407,"_3062":58482},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3607":2476,"_31098":2446,"_21528":58484,"_5":14794,"_28279":58407,"_3062":57871},[],{"_3607":2477,"_31098":2446,"_21528":58486,"_5":14794,"_28279":58407,"_3062":58487},[],"`/ocsp/{ocsp_request}`",{"_3607":2478,"_31098":2446,"_21528":58489,"_5":14794,"_28279":58407,"_3062":58490},[],"DER request encoded using padded URL Base64.",{"_3607":2479,"_31098":2446,"_21528":58492,"_5":14794,"_28279":58407,"_3062":58493},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3607":2480,"_31098":2446,"_21528":58495,"_5":14794,"_28279":58411,"_3062":58496},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3607":2481,"_31098":2446,"_21528":58498,"_5":14794,"_28279":58411,"_3062":58499},[],"Generate the request:",{"_3607":2482,"_31098":2446,"_21528":58501,"_5":14794,"_28279":58411,"_3062":58502},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3607":2483,"_31098":2446,"_21528":58504,"_5":14794,"_28279":58411,"_3062":58505},[],"Replace the example URL with the inspected endpoint:",{"_3607":2484,"_31098":2446,"_21528":58507,"_5":14794,"_28279":58411,"_3062":58508},[],"Verify the returned DER:",{"_3607":2485,"_31098":2446,"_21528":58510,"_5":14794,"_28279":58411,"_3062":58511},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3607":2486,"_31098":2446,"_21528":58513,"_5":14794,"_28279":58415,"_3062":58514},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3607":2487,"_31098":2446,"_21528":58516,"_5":14794,"_28279":58415,"_3062":58517},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3607":2488,"_31098":2446,"_21528":58519,"_5":14794,"_28279":58419,"_3062":58520},[],"RFC 6960: OCSP.",{"_3607":2489,"_31098":2446,"_21528":58522,"_5":14794,"_28279":58419,"_3062":58523},[],"OpenSSL: openssl-ocsp.",{"_3607":2490,"_31098":2446,"_21528":58525,"_5":14794,"_28279":58419,"_3062":58526},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3607":2491,"_31098":2446,"_21528":58528,"_5":14794,"_28279":58419,"_3062":57997},[],{"_3607":2492,"_31098":2492,"_5":15159,"_3062":56465,"_31457":58530,"_21528":58531,"_28279":2492},[50787,52299,56465],[],{"_3607":2493,"_31098":2492,"_21528":58533,"_5":14794,"_28279":2492,"_3062":58534},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3607":2494,"_31098":2492,"_5":31454,"_21528":58536,"_28279":58537,"_3062":55777},[],"/docs/pr-preview/pr-75/platform/pki/overview#start-here",{"_3607":2495,"_31098":2492,"_5":31454,"_21528":58539,"_28279":58540,"_3062":58541},[],"/docs/pr-preview/pr-75/platform/pki/overview#what-you-need","What you need",{"_3607":2496,"_31098":2492,"_5":31454,"_21528":58543,"_28279":58544,"_3062":56309},[],"/docs/pr-preview/pr-75/platform/pki/overview#core-capabilities",{"_3607":2497,"_31098":2492,"_5":31454,"_21528":58546,"_28279":58547,"_3062":56313},[],"/docs/pr-preview/pr-75/platform/pki/overview#build-your-trust-hierarchy",{"_3607":2498,"_31098":2492,"_5":31454,"_21528":58549,"_28279":58550,"_3062":56317},[],"/docs/pr-preview/pr-75/platform/pki/overview#protect-cryptographic-keys",{"_3607":2499,"_31098":2492,"_5":31454,"_21528":58552,"_28279":58553,"_3062":56321},[],"/docs/pr-preview/pr-75/platform/pki/overview#issue-and-control-certificates",{"_3607":2500,"_31098":2492,"_5":31454,"_21528":58555,"_28279":58556,"_3062":56329},[],"/docs/pr-preview/pr-75/platform/pki/overview#publish-validation-status",{"_3607":2501,"_31098":2492,"_5":31454,"_21528":58558,"_28279":58559,"_3062":58560},[],"/docs/pr-preview/pr-75/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3607":2502,"_31098":2492,"_5":31454,"_21528":58562,"_28279":58563,"_3062":57289},[],"/docs/pr-preview/pr-75/platform/pki/overview#continue",{"_3607":2503,"_31098":2492,"_21528":58565,"_5":14794,"_28279":2492,"_3062":58566},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3607":2504,"_31098":2492,"_21528":58568,"_5":14794,"_28279":58537,"_3062":58569},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3607":2505,"_31098":2492,"_21528":58571,"_5":14794,"_28279":58537,"_3062":58572},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3607":2506,"_31098":2492,"_21528":58574,"_5":14794,"_28279":58540,"_3062":58575},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3607":2507,"_31098":2492,"_21528":58577,"_5":14794,"_28279":58540,"_3062":58578},[],"An available cryptographic engine to keep the authority's key.",{"_3607":2508,"_31098":2492,"_21528":58580,"_5":14794,"_28279":58540,"_3062":58581},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3607":2509,"_31098":2492,"_21528":58583,"_5":14794,"_28279":58540,"_3062":58584},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3607":2510,"_31098":2492,"_21528":58586,"_5":14794,"_28279":58540,"_3062":58587},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3607":2511,"_31098":2492,"_21528":58589,"_5":14794,"_28279":58547,"_3062":58590},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3607":2512,"_31098":2492,"_21528":58592,"_5":14794,"_28279":58550,"_3062":58593},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3607":2513,"_31098":2492,"_21528":58595,"_5":14794,"_28279":58553,"_3062":58596},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3607":2514,"_31098":2492,"_21528":58598,"_5":14794,"_28279":58556,"_3062":58599},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3607":2515,"_31098":2492,"_21528":58601,"_5":14794,"_28279":58559,"_3062":58602},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3607":2516,"_31098":2492,"_21528":58604,"_5":14794,"_28279":58559,"_3062":58605},[],"its subject and extensions identify the expected client;",{"_3607":2517,"_31098":2492,"_21528":58607,"_5":14794,"_28279":58559,"_3062":58608},[],"its public key matches the client's private key;",{"_3607":2518,"_31098":2492,"_21528":58610,"_5":14794,"_28279":58559,"_3062":58611},[],"its chain reaches a root trusted by the consumer;",{"_3607":2519,"_31098":2492,"_21528":58613,"_5":14794,"_28279":58559,"_3062":58614},[],"its dates and usages allow the operation;",{"_3607":2520,"_31098":2492,"_21528":58616,"_5":14794,"_28279":58559,"_3062":58617},[],"the consumer applies revocation checks and authorization.",{"_3607":2521,"_31098":2492,"_21528":58619,"_5":14794,"_28279":58559,"_3062":58620},[],"The issuance path includes the first independent checks.",{"_3607":2522,"_31098":2492,"_21528":58622,"_5":14794,"_28279":58563,"_3062":58623},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3607":2523,"_31098":2492,"_21528":58625,"_5":14794,"_28279":58563,"_3062":58626},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3607":2524,"_31098":2492,"_21528":58628,"_5":14794,"_28279":58563,"_3062":58629},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3607":2525,"_31098":2525,"_5":15159,"_3062":58631,"_31457":58632,"_21528":58633,"_28279":2525},"Create your first CA",[50787,52299,56465,55902],[],{"_3607":2526,"_31098":2525,"_21528":58635,"_5":14794,"_28279":2525,"_3062":58636},[],"Create an evaluation root and check its certificate before issuing.",{"_3607":2527,"_31098":2525,"_5":31454,"_21528":58638,"_28279":58639,"_3062":50797},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3607":2528,"_31098":2525,"_5":31454,"_21528":58641,"_28279":58642,"_3062":58643},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3607":2529,"_31098":2525,"_5":31454,"_21528":58645,"_28279":58646,"_3062":58647},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3607":2530,"_31098":2525,"_5":31454,"_21528":58649,"_28279":58650,"_3062":58651},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3607":2531,"_31098":2525,"_5":31454,"_21528":58653,"_28279":58654,"_3062":58655},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3607":2532,"_31098":2525,"_5":31454,"_21528":58657,"_28279":58658,"_3062":58659},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3607":2533,"_31098":2525,"_5":31454,"_21528":58661,"_28279":58662,"_3062":58663},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3607":2534,"_31098":2525,"_5":31454,"_21528":58665,"_28279":58666,"_3062":56159},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3607":2535,"_31098":2525,"_5":31454,"_21528":58668,"_28279":58669,"_3062":50821},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3607":2536,"_31098":2525,"_21528":58671,"_5":14794,"_28279":2525,"_3062":58672},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3607":2537,"_31098":2525,"_21528":58674,"_5":14794,"_28279":58639,"_3062":58675},[],"Console access and permission to create keys and authorities.",{"_3607":2538,"_31098":2525,"_21528":58677,"_5":14794,"_28279":58639,"_3062":58678},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3607":2539,"_31098":2525,"_21528":58680,"_5":14794,"_28279":58639,"_3062":58681},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3607":2540,"_31098":2525,"_21528":58683,"_5":14794,"_28279":58639,"_3062":58684},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3607":2541,"_31098":2525,"_21528":58686,"_5":14794,"_28279":58642,"_3062":58687},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3607":2542,"_31098":2525,"_21528":58689,"_5":14794,"_28279":58642,"_3062":58690},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3607":2543,"_31098":2525,"_21528":58692,"_5":14794,"_28279":58646,"_3062":58693},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3607":2544,"_31098":2525,"_21528":58695,"_5":14794,"_28279":58646,"_3062":58696},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3607":2545,"_31098":2525,"_21528":58698,"_5":14794,"_28279":58650,"_3062":58699},[],"Select **Root CA** and complete:",{"_3607":2546,"_31098":2525,"_21528":58701,"_5":14794,"_28279":58650,"_3062":58702},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3607":2547,"_31098":2525,"_21528":58704,"_5":14794,"_28279":58650,"_3062":58705},[],"**Subject**: organization and country details for your evaluation.",{"_3607":2548,"_31098":2525,"_21528":58707,"_5":14794,"_28279":58650,"_3062":58708},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3607":2549,"_31098":2525,"_21528":58710,"_5":14794,"_28279":58650,"_3062":58711},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3607":2550,"_31098":2525,"_21528":58713,"_5":14794,"_28279":58650,"_3062":58714},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3607":2551,"_31098":2525,"_21528":58716,"_5":14794,"_28279":58654,"_3062":58717},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3607":2552,"_31098":2525,"_21528":58719,"_5":14794,"_28279":58658,"_3062":58720},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3607":2553,"_31098":2525,"_21528":58722,"_5":14794,"_28279":58658,"_3062":58723},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3607":2554,"_31098":2525,"_21528":58725,"_5":14794,"_28279":58662,"_3062":58726},[],"Run from the directory where you saved `ca.pem`:",{"_3607":2555,"_31098":2525,"_21528":58728,"_5":14794,"_28279":58662,"_3062":58729},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3607":2556,"_31098":2525,"_21528":58731,"_5":14794,"_28279":58662,"_3062":58732},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3607":2557,"_31098":2525,"_21528":58734,"_5":14794,"_28279":58666,"_3062":58735},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3607":2558,"_31098":2525,"_21528":58737,"_5":14794,"_28279":58666,"_3062":58738},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3607":2559,"_31098":2525,"_21528":58740,"_5":14794,"_28279":58666,"_3062":58741},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3607":2560,"_31098":2525,"_21528":58743,"_5":14794,"_28279":58666,"_3062":58744},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3607":2561,"_31098":2525,"_21528":58746,"_5":14794,"_28279":58669,"_3062":58747},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3607":2562,"_31098":2562,"_5":15159,"_3062":58749,"_31457":58750,"_21528":58751,"_28279":2562},"Issue and verify a certificate",[50787,52299,56465,55902],[],{"_3607":2563,"_31098":2562,"_21528":58753,"_5":14794,"_28279":2562,"_3062":58754},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3607":2564,"_31098":2562,"_5":31454,"_21528":58756,"_28279":58757,"_3062":50797},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3607":2565,"_31098":2562,"_5":31454,"_21528":58759,"_28279":58760,"_3062":58761},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3607":2566,"_31098":2562,"_5":31454,"_21528":58763,"_28279":58764,"_3062":58765},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3607":2567,"_31098":2562,"_5":31454,"_21528":58767,"_28279":58768,"_3062":58769},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3607":2568,"_31098":2562,"_5":31454,"_21528":58771,"_28279":58772,"_3062":58773},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3607":2569,"_31098":2562,"_5":31454,"_21528":58775,"_28279":58776,"_3062":58777},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3607":2570,"_31098":2562,"_5":31454,"_21528":58779,"_28279":58780,"_3062":58781},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3607":2571,"_31098":2562,"_5":31454,"_21528":58783,"_28279":58784,"_3062":58785},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3607":2572,"_31098":2562,"_5":31454,"_21528":58787,"_28279":58788,"_3062":58789},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3607":2573,"_31098":2562,"_5":31454,"_21528":58791,"_28279":58792,"_3062":58793},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3607":2574,"_31098":2562,"_5":31454,"_21528":58795,"_28279":58796,"_3062":56159},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3607":2575,"_31098":2562,"_5":31454,"_21528":58798,"_28279":58799,"_3062":50821},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/issue-certificate#next-step",{"_3607":2576,"_31098":2562,"_21528":58801,"_5":14794,"_28279":2562,"_3062":58802},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3607":2577,"_31098":2562,"_21528":58804,"_5":14794,"_28279":58757,"_3062":58805},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3607":2578,"_31098":2562,"_21528":58807,"_5":14794,"_28279":58757,"_3062":58808},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3607":2579,"_31098":2562,"_21528":58810,"_5":14794,"_28279":58757,"_3062":58811},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3607":2580,"_31098":2562,"_21528":58813,"_5":14794,"_28279":58757,"_3062":58814},[],"A client identifier: here we use `device-001`.",{"_3607":2581,"_31098":2562,"_21528":58816,"_5":14794,"_28279":58757,"_3062":58817},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3607":2582,"_31098":2562,"_21528":58819,"_5":14794,"_28279":58760,"_3062":58820},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3607":2583,"_31098":2562,"_21528":58822,"_5":14794,"_28279":58764,"_3062":58823},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3607":2584,"_31098":2562,"_21528":58825,"_5":14794,"_28279":58764,"_3062":58826},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3607":2585,"_31098":2562,"_21528":58828,"_5":14794,"_28279":58768,"_3062":58829},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3607":2586,"_31098":2562,"_21528":58831,"_5":14794,"_28279":58768,"_3062":58832},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3607":2587,"_31098":2562,"_21528":58834,"_5":14794,"_28279":58772,"_3062":58835},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3607":2588,"_31098":2562,"_21528":58837,"_5":14794,"_28279":58772,"_3062":58838},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3607":2589,"_31098":2562,"_21528":58840,"_5":14794,"_28279":58776,"_3062":58841},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3607":2590,"_31098":2562,"_21528":58843,"_5":14794,"_28279":58780,"_3062":58844},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3607":2591,"_31098":2562,"_21528":58846,"_5":14794,"_28279":58784,"_3062":58847},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3607":2592,"_31098":2562,"_21528":58849,"_5":14794,"_28279":58788,"_3062":58850},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3607":2593,"_31098":2562,"_21528":58852,"_5":14794,"_28279":58788,"_3062":58853},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3607":2594,"_31098":2562,"_21528":58855,"_5":14794,"_28279":58788,"_3062":58856},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3607":2595,"_31098":2562,"_21528":58858,"_5":14794,"_28279":58792,"_3062":58859},[],"In Bash, compare the two public-key digests:",{"_3607":2596,"_31098":2562,"_21528":58861,"_5":14794,"_28279":58792,"_3062":58862},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3607":2597,"_31098":2562,"_21528":58864,"_5":14794,"_28279":58792,"_3062":58865},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3607":2598,"_31098":2562,"_21528":58867,"_5":14794,"_28279":58796,"_3062":56243},[],{"_3607":2599,"_31098":2562,"_21528":58869,"_5":14794,"_28279":58796,"_3062":58870},[],"What to review",{"_3607":2600,"_31098":2562,"_21528":58872,"_5":14794,"_28279":58796,"_3062":58873},[],"The CA rejects issuance",{"_3607":2601,"_31098":2562,"_21528":58875,"_5":14794,"_28279":58796,"_3062":58876},[],"Permissions, CA state and key, algorithm and profile.",{"_3607":2602,"_31098":2562,"_21528":58878,"_5":14794,"_28279":58796,"_3062":58879},[],"Different subject or usages",{"_3607":2603,"_31098":2562,"_21528":58881,"_5":14794,"_28279":58796,"_3062":58882},[],"Applied profile and requested values.",{"_3607":2604,"_31098":2562,"_21528":58884,"_5":14794,"_28279":58796,"_3062":58885},[],"Issuer cannot be found",{"_3607":2605,"_31098":2562,"_21528":58887,"_5":14794,"_28279":58796,"_3062":58888},[],"Downloaded CA and required intermediate chain.",{"_3607":2606,"_31098":2562,"_21528":58890,"_5":14794,"_28279":58796,"_3062":58891},[],"Validity fails",{"_3607":2607,"_31098":2562,"_21528":58893,"_5":14794,"_28279":58796,"_3062":58894},[],"Certificate and CA dates, and the computer's clock.",{"_3607":2608,"_31098":2562,"_21528":58896,"_5":14794,"_28279":58796,"_3062":58897},[],"Public-key digests differ",{"_3607":2609,"_31098":2562,"_21528":58899,"_5":14794,"_28279":58796,"_3062":58900},[],"Certificate and key files from the same issuance.",{"_3607":2610,"_31098":2562,"_21528":58902,"_5":14794,"_28279":58796,"_3062":58903},[],"See PKI diagnostics to narrow an issuance failure.",{"_3607":2611,"_31098":2562,"_21528":58905,"_5":14794,"_28279":58799,"_3062":58906},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3607":2612,"_31098":2562,"_21528":58908,"_5":14794,"_28279":58799,"_3062":58909},[],"Manage certificates for inspection, status and revocation.",{"_3607":2613,"_31098":2562,"_21528":58911,"_5":14794,"_28279":58799,"_3062":58912},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3607":2614,"_31098":2562,"_21528":58914,"_5":14794,"_28279":58799,"_3062":58915},[],"Prepare EST for the device to request its next identities.",{"_3607":2615,"_31098":2562,"_21528":58917,"_5":14794,"_28279":58799,"_3062":58918},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3607":2616,"_31098":2616,"_5":15159,"_3062":58920,"_31457":58921,"_21528":58922,"_28279":2616},"PKI getting started",[50787,52299,56465,55902],[],{"_3607":2617,"_31098":2616,"_21528":58924,"_5":14794,"_28279":2616,"_3062":58925},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3607":2618,"_31098":2616,"_5":31454,"_21528":58927,"_28279":58928,"_3062":50797},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#before-you-begin",{"_3607":2619,"_31098":2616,"_5":31454,"_21528":58930,"_28279":58931,"_3062":58932},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3607":2620,"_31098":2616,"_5":31454,"_21528":58934,"_28279":58935,"_3062":56094},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#expected-result",{"_3607":2621,"_31098":2616,"_5":31454,"_21528":58937,"_28279":58938,"_3062":58939},[],"/docs/pr-preview/pr-75/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3607":2622,"_31098":2616,"_21528":58941,"_5":14794,"_28279":2616,"_3062":58942},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3607":2623,"_31098":2616,"_21528":58944,"_5":14794,"_28279":58928,"_3062":58945},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3607":2624,"_31098":2616,"_21528":58947,"_5":14794,"_28279":58928,"_3062":58948},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3607":2625,"_31098":2616,"_21528":58950,"_5":14794,"_28279":58928,"_3062":58951},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3607":2626,"_31098":2616,"_21528":58953,"_5":14794,"_28279":58928,"_3062":58954},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3607":2627,"_31098":2616,"_21528":58956,"_5":14794,"_28279":58928,"_3062":58957},[],"A working directory with restricted access for the downloaded key.",{"_3607":2628,"_31098":2616,"_21528":58959,"_5":14794,"_28279":58931,"_3062":58960},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3607":2629,"_31098":2616,"_21528":58962,"_5":14794,"_28279":58931,"_3062":58963},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3607":2630,"_31098":2616,"_21528":58965,"_5":14794,"_28279":58931,"_3062":58966},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3607":2631,"_31098":2616,"_21528":58968,"_5":14794,"_28279":58931,"_3062":58969},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3607":2632,"_31098":2616,"_21528":58971,"_5":14794,"_28279":58935,"_3062":58972},[],"File or resource",{"_3607":2633,"_31098":2616,"_21528":58974,"_5":14794,"_28279":58935,"_3062":56091},[],{"_3607":2634,"_31098":2616,"_21528":58976,"_5":14794,"_28279":58935,"_3062":58977},[],"Active root CA and `ca.pem`",{"_3607":2635,"_31098":2616,"_21528":58979,"_5":14794,"_28279":58935,"_3062":58980},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3607":2636,"_31098":2616,"_21528":58982,"_5":14794,"_28279":58935,"_3062":58983},[],"End-entity certificate and `device.crt`",{"_3607":2637,"_31098":2616,"_21528":58985,"_5":14794,"_28279":58935,"_3062":58986},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3607":2638,"_31098":2616,"_21528":58988,"_5":14794,"_28279":58935,"_3062":58989},[],"Private key `device.key`",{"_3607":2639,"_31098":2616,"_21528":58991,"_5":14794,"_28279":58935,"_3062":58992},[],"Its public key matches the one included in `device.crt`.",{"_3607":2640,"_31098":2616,"_21528":58994,"_5":14794,"_28279":58935,"_3062":58995},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3607":2641,"_31098":2616,"_21528":58997,"_5":14794,"_28279":58938,"_3062":58998},[],"To operate certificates, continue with Certificates and Validation.",{"_3607":2642,"_31098":2616,"_21528":59000,"_5":14794,"_28279":58938,"_3062":59001},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3607":2643,"_31098":2616,"_21528":59003,"_5":14794,"_28279":58938,"_3062":59004},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3607":2644,"_31098":2644,"_5":15159,"_3062":59006,"_31457":59007,"_21528":59008,"_28279":2644},"PKI troubleshooting",[50787,52299,56465,55040],[],{"_3607":2645,"_31098":2644,"_21528":59010,"_5":14794,"_28279":2644,"_3062":59011},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3607":2646,"_31098":2644,"_5":31454,"_21528":59013,"_28279":59014,"_3062":59015},[],"/docs/pr-preview/pr-75/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3607":2647,"_31098":2644,"_5":31454,"_21528":59017,"_28279":59018,"_3062":59019},[],"/docs/pr-preview/pr-75/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3607":2648,"_31098":2644,"_5":31454,"_21528":59021,"_28279":59022,"_3062":59023},[],"/docs/pr-preview/pr-75/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3607":2649,"_31098":2644,"_21528":59025,"_5":14794,"_28279":2644,"_3062":59026},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3607":2650,"_31098":2644,"_21528":59028,"_5":14794,"_28279":2644,"_3062":59029},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3607":2651,"_31098":2644,"_21528":59031,"_5":14794,"_28279":59014,"_3062":56091},[],{"_3607":2652,"_31098":2644,"_21528":59033,"_5":14794,"_28279":59014,"_3062":59034},[],"What to inspect",{"_3607":2653,"_31098":2644,"_21528":59036,"_5":14794,"_28279":59014,"_3062":50821},[],{"_3607":2654,"_31098":2644,"_21528":59038,"_5":14794,"_28279":59014,"_3062":55307},[],{"_3607":2655,"_31098":2644,"_21528":59040,"_5":14794,"_28279":59014,"_3062":59041},[],"Exists, is active and has usable dates.",{"_3607":2656,"_31098":2644,"_21528":59043,"_5":14794,"_28279":59014,"_3062":59044},[],"Authorities.",{"_3607":2657,"_31098":2644,"_21528":59046,"_5":14794,"_28279":59014,"_3062":59047},[],"Key",{"_3607":2658,"_31098":2644,"_21528":59049,"_5":14794,"_28279":59014,"_3062":59050},[],"The record has a usable private key and the engine can sign.",{"_3607":2659,"_31098":2644,"_21528":59052,"_5":14794,"_28279":59014,"_3062":59053},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3607":2660,"_31098":2644,"_21528":59055,"_5":14794,"_28279":59014,"_3062":59056},[],"CSR",{"_3607":2661,"_31098":2644,"_21528":59058,"_5":14794,"_28279":59014,"_3062":59059},[],"Correct PEM and verifiable signature.",{"_3607":2662,"_31098":2644,"_21528":59061,"_5":14794,"_28279":59014,"_3062":59062},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3607":2663,"_31098":2644,"_21528":59064,"_5":14794,"_28279":59014,"_3062":59065},[],"Profile",{"_3607":2664,"_31098":2644,"_21528":59067,"_5":14794,"_28279":59014,"_3062":59068},[],"Selected source, existing ID, allowed algorithm and size.",{"_3607":2665,"_31098":2644,"_21528":59070,"_5":14794,"_28279":59014,"_3062":59071},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3607":2666,"_31098":2644,"_21528":59073,"_5":14794,"_28279":59014,"_3062":56243},[],{"_3607":2667,"_31098":2644,"_21528":59075,"_5":14794,"_28279":59014,"_3062":59076},[],"Appropriate subject, SAN, usages and dates.",{"_3607":2668,"_31098":2644,"_21528":59078,"_5":14794,"_28279":59014,"_3062":59079},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3607":2669,"_31098":2644,"_21528":59081,"_5":14794,"_28279":59014,"_3062":59082},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3607":2670,"_31098":2644,"_21528":59084,"_5":14794,"_28279":59014,"_3062":59085},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3607":2671,"_31098":2644,"_21528":59087,"_5":14794,"_28279":59014,"_3062":59088},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3607":2672,"_31098":2644,"_21528":59090,"_5":14794,"_28279":59018,"_3062":59091},[],"Check each boundary independently:",{"_3607":2673,"_31098":2644,"_21528":59093,"_5":14794,"_28279":59018,"_3062":59094},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3607":2674,"_31098":2644,"_21528":59096,"_5":14794,"_28279":59018,"_3062":59097},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3607":2675,"_31098":2644,"_21528":59099,"_5":14794,"_28279":59018,"_3062":59100},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3607":2676,"_31098":2644,"_21528":59102,"_5":14794,"_28279":59018,"_3062":59103},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3607":2677,"_31098":2644,"_21528":59105,"_5":14794,"_28279":59018,"_3062":59106},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3607":2678,"_31098":2644,"_21528":59108,"_5":14794,"_28279":59018,"_3062":59109},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3607":2679,"_31098":2644,"_21528":59111,"_5":14794,"_28279":59022,"_3062":59112},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3607":2680,"_31098":2644,"_21528":59114,"_5":14794,"_28279":59022,"_3062":59115},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3607":2681,"_31098":2681,"_5":15159,"_3062":59117,"_31457":59118,"_21528":59119,"_28279":2681},"Security",[50787],[],{"_3607":2682,"_31098":2681,"_21528":59121,"_5":14794,"_28279":2681,"_3062":59122},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3607":2683,"_31098":2681,"_5":31454,"_21528":59124,"_28279":59125,"_3062":59126},[],"/docs/pr-preview/pr-75/security#report-a-vulnerability","Report a vulnerability",{"_3607":2684,"_31098":2681,"_5":31454,"_21528":59128,"_28279":59129,"_3062":59130},[],"/docs/pr-preview/pr-75/security#what-to-include-in-a-report","What to include in a report",{"_3607":2685,"_31098":2681,"_5":31454,"_21528":59132,"_28279":59133,"_3062":59134},[],"/docs/pr-preview/pr-75/security#supported-versions","Supported versions",{"_3607":2686,"_31098":2681,"_5":31454,"_21528":59136,"_28279":59137,"_3062":59138},[],"/docs/pr-preview/pr-75/security#responsible-disclosure","Responsible disclosure",{"_3607":2687,"_31098":2681,"_21528":59140,"_5":14794,"_28279":2681,"_3062":59141},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3607":2688,"_31098":2681,"_21528":59143,"_5":14794,"_28279":59125,"_3062":59144},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3607":2689,"_31098":2681,"_21528":59146,"_5":14794,"_28279":59125,"_3062":59147},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3607":2690,"_31098":2681,"_21528":59149,"_5":14794,"_28279":59125,"_3062":15433},[],{"_3607":2691,"_31098":2681,"_21528":59151,"_5":14794,"_28279":59125,"_3062":15362},[],{"_3607":2692,"_31098":2681,"_21528":59153,"_5":14794,"_28279":59125,"_3062":15420},[],{"_3607":2693,"_31098":2681,"_21528":59155,"_5":14794,"_28279":59125,"_3062":59156},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3607":2694,"_31098":2681,"_21528":59158,"_5":14794,"_28279":59125,"_3062":59159},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3607":2695,"_31098":2681,"_21528":59161,"_5":14794,"_28279":59129,"_3062":59162},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3607":2696,"_31098":2681,"_21528":59164,"_5":14794,"_28279":59129,"_3062":59165},[],"Do not include in the report:",{"_3607":2697,"_31098":2681,"_21528":59167,"_5":14794,"_28279":59129,"_3062":59168},[],"Credentials, tokens, or private keys",{"_3607":2698,"_31098":2681,"_21528":59170,"_5":14794,"_28279":59129,"_3062":59171},[],"Customer data or customer-identifiable information",{"_3607":2699,"_31098":2681,"_21528":59173,"_5":14794,"_28279":59129,"_3062":59174},[],"Confidential architecture or internal infrastructure details",{"_3607":2700,"_31098":2681,"_21528":59176,"_5":14794,"_28279":59133,"_3062":59177},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3607":2701,"_31098":2681,"_21528":59179,"_5":14794,"_28279":59133,"_3062":59180},[],"For upgrade guidance, see Upgrades.",{"_3607":2702,"_31098":2681,"_21528":59182,"_5":14794,"_28279":59137,"_3062":59183},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3607":2703,"_31098":2681,"_21528":59185,"_5":14794,"_28279":59137,"_3062":59186},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3607":2704,"_31098":2681,"_21528":59188,"_5":14794,"_28279":59137,"_3062":59189},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3607":2705,"_31098":2681,"_21528":59191,"_5":14794,"_28279":59137,"_3062":59192},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3607":2706,"_31098":2681,"_21528":59194,"_5":14794,"_28279":59137,"_3062":59195},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3607":2707,"_31098":2707,"_5":15159,"_3062":59197,"_31457":59198,"_21528":59200,"_28279":2707},"3.8.0 to 4.0.0",[50787,59199],"Upgrades",[],{"_3607":2708,"_31098":2707,"_21528":59202,"_5":14794,"_28279":2707,"_3062":59203},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3607":2709,"_31098":2707,"_5":31454,"_21528":59205,"_28279":59206,"_3062":59207},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3607":2710,"_31098":2707,"_5":31454,"_21528":59209,"_28279":59210,"_3062":59211},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3607":2711,"_31098":2707,"_5":31454,"_21528":59213,"_28279":59214,"_3062":59215},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3607":2712,"_31098":2707,"_5":31454,"_21528":59217,"_28279":59218,"_3062":59219},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3607":2713,"_31098":2707,"_5":31454,"_21528":59221,"_28279":59222,"_3062":59223},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3607":2714,"_31098":2707,"_5":31454,"_21528":59225,"_28279":59226,"_3062":59227},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3607":2715,"_31098":2707,"_5":31454,"_21528":59229,"_28279":59230,"_3062":59231},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3607":2716,"_31098":2707,"_5":31454,"_21528":59233,"_28279":59234,"_3062":59235},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3607":2717,"_31098":2707,"_5":31454,"_21528":59237,"_28279":59238,"_3062":59239},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3607":2718,"_31098":2707,"_5":31454,"_21528":59241,"_28279":59242,"_3062":59243},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3607":2719,"_31098":2707,"_5":31454,"_21528":59245,"_28279":59246,"_3062":51425},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3607":2720,"_31098":2707,"_5":31454,"_21528":59248,"_28279":59249,"_3062":59250},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3607":2721,"_31098":2707,"_5":31454,"_21528":59252,"_28279":59253,"_3062":59254},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3607":2722,"_31098":2707,"_5":31454,"_21528":59256,"_28279":59257,"_3062":59258},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3607":2723,"_31098":2707,"_5":31454,"_21528":59260,"_28279":59261,"_3062":59262},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3607":2724,"_31098":2707,"_5":31454,"_21528":59264,"_28279":59265,"_3062":59266},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3607":2725,"_31098":2707,"_5":31454,"_21528":59268,"_28279":59269,"_3062":59270},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3607":2726,"_31098":2707,"_5":31454,"_21528":59272,"_28279":59273,"_3062":59274},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3607":2727,"_31098":2707,"_5":31454,"_21528":59276,"_28279":59277,"_3062":59278},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3607":2728,"_31098":2707,"_5":31454,"_21528":59280,"_28279":59281,"_3062":59282},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3607":2729,"_31098":2707,"_5":31454,"_21528":59284,"_28279":59285,"_3062":59286},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3607":2730,"_31098":2707,"_5":31454,"_21528":59288,"_28279":59289,"_3062":59290},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3607":2731,"_31098":2707,"_5":31454,"_21528":59292,"_28279":59293,"_3062":59294},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3607":2732,"_31098":2707,"_5":31454,"_21528":59296,"_28279":59297,"_3062":59298},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3607":2733,"_31098":2707,"_5":31454,"_21528":59300,"_28279":59301,"_3062":59302},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3607":2734,"_31098":2707,"_5":31454,"_21528":59304,"_28279":59305,"_3062":59306},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3607":2735,"_31098":2707,"_5":31454,"_21528":59308,"_28279":59309,"_3062":59310},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3607":2736,"_31098":2707,"_5":31454,"_21528":59312,"_28279":59313,"_3062":59314},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3607":2737,"_31098":2707,"_5":31454,"_21528":59316,"_28279":59317,"_3062":59318},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3607":2738,"_31098":2707,"_5":31454,"_21528":59320,"_28279":59321,"_3062":59322},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3607":2739,"_31098":2707,"_5":31454,"_21528":59324,"_28279":59325,"_3062":59326},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3607":2740,"_31098":2707,"_5":31454,"_21528":59328,"_28279":59329,"_3062":59330},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3607":2741,"_31098":2707,"_5":31454,"_21528":59332,"_28279":59333,"_3062":59334},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3607":2742,"_31098":2707,"_5":31454,"_21528":59336,"_28279":59337,"_3062":59338},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3607":2743,"_31098":2707,"_5":31454,"_21528":59340,"_28279":59341,"_3062":59342},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3607":2744,"_31098":2707,"_5":31454,"_21528":59344,"_28279":59345,"_3062":59346},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3607":2745,"_31098":2707,"_5":31454,"_21528":59348,"_28279":59349,"_3062":59350},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3607":2746,"_31098":2707,"_5":31454,"_21528":59352,"_28279":59353,"_3062":59354},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3607":2747,"_31098":2707,"_5":31454,"_21528":59356,"_28279":59357,"_3062":59358},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3607":2748,"_31098":2707,"_5":31454,"_21528":59360,"_28279":59361,"_3062":59362},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3607":2749,"_31098":2707,"_5":31454,"_21528":59364,"_28279":59365,"_3062":59366},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3607":2750,"_31098":2707,"_5":31454,"_21528":59368,"_28279":59369,"_3062":59370},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3607":2751,"_31098":2707,"_5":31454,"_21528":59372,"_28279":59373,"_3062":55040},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3607":2752,"_31098":2707,"_5":31454,"_21528":59375,"_28279":59376,"_3062":59377},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3607":2753,"_31098":2707,"_5":31454,"_21528":59379,"_28279":59380,"_3062":59381},[],"/docs/pr-preview/pr-75/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3607":2754,"_31098":2707,"_21528":59383,"_5":14794,"_28279":2707,"_3062":59384},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3607":2755,"_31098":2707,"_21528":59386,"_5":14794,"_28279":2707,"_3062":59387},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3607":2756,"_31098":2707,"_21528":59389,"_5":14794,"_28279":2707,"_3062":59390},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3607":2757,"_31098":2707,"_21528":59392,"_5":14794,"_28279":2707,"_3062":59393},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3607":2758,"_31098":2707,"_21528":59395,"_5":14794,"_28279":2707,"_3062":59396},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3607":2759,"_31098":2707,"_21528":59398,"_5":14794,"_28279":2707,"_3062":59399},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3607":2760,"_31098":2707,"_21528":59401,"_5":14794,"_28279":2707,"_3062":59402},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3607":2761,"_31098":2707,"_21528":59404,"_5":14794,"_28279":59210,"_3062":59405},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3607":2762,"_31098":2707,"_21528":59407,"_5":14794,"_28279":59210,"_3062":59408},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3607":2763,"_31098":2707,"_21528":59410,"_5":14794,"_28279":59214,"_3062":59411},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3607":2764,"_31098":2707,"_21528":59413,"_5":14794,"_28279":59214,"_3062":59414},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3607":2765,"_31098":2707,"_21528":59416,"_5":14794,"_28279":59218,"_3062":59417},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3607":2766,"_31098":2707,"_21528":59419,"_5":14794,"_28279":59222,"_3062":59420},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3607":2767,"_31098":2707,"_21528":59422,"_5":14794,"_28279":59222,"_3062":59423},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3607":2768,"_31098":2707,"_21528":59425,"_5":14794,"_28279":59222,"_3062":59426},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3607":2769,"_31098":2707,"_21528":59428,"_5":14794,"_28279":59222,"_3062":59429},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3607":2770,"_31098":2707,"_21528":59431,"_5":14794,"_28279":59222,"_3062":59432},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3607":2771,"_31098":2707,"_21528":59434,"_5":14794,"_28279":59226,"_3062":59435},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3607":2772,"_31098":2707,"_21528":59437,"_5":14794,"_28279":59226,"_3062":59438},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3607":2773,"_31098":2707,"_21528":59440,"_5":14794,"_28279":59226,"_3062":59441},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3607":2774,"_31098":2707,"_21528":59443,"_5":14794,"_28279":59226,"_3062":59444},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3607":2775,"_31098":2707,"_21528":59446,"_5":14794,"_28279":59226,"_3062":59447},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3607":2776,"_31098":2707,"_21528":59449,"_5":14794,"_28279":59226,"_3062":59450},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3607":2777,"_31098":2707,"_21528":59452,"_5":14794,"_28279":59230,"_3062":59453},[],"Change",{"_3607":2778,"_31098":2707,"_21528":59455,"_5":14794,"_28279":59230,"_3062":59456},[],"Who is affected",{"_3607":2779,"_31098":2707,"_21528":59458,"_5":14794,"_28279":59230,"_3062":59459},[],"Severity",{"_3607":2780,"_31098":2707,"_21528":59461,"_5":14794,"_28279":59230,"_3062":57919},[],{"_3607":2781,"_31098":2707,"_21528":59463,"_5":14794,"_28279":59230,"_3062":59239},[],{"_3607":2782,"_31098":2707,"_21528":59465,"_5":14794,"_28279":59230,"_3062":59466},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3607":2783,"_31098":2707,"_21528":59468,"_5":14794,"_28279":59230,"_3062":59469},[],"High: KMS and VA start on empty volumes",{"_3607":2784,"_31098":2707,"_21528":59471,"_5":14794,"_28279":59230,"_3062":59472},[],"Copy the data into the new volumes",{"_3607":2785,"_31098":2707,"_21528":59474,"_5":14794,"_28279":59230,"_3062":59243},[],{"_3607":2786,"_31098":2707,"_21528":59476,"_5":14794,"_28279":59230,"_3062":59477},[],"Every Helm release",{"_3607":2787,"_31098":2707,"_21528":59479,"_5":14794,"_28279":59230,"_3062":59480},[],"High: `helm upgrade` fails",{"_3607":2788,"_31098":2707,"_21528":59482,"_5":14794,"_28279":59230,"_3062":59483},[],"Remove or rename legacy keys",{"_3607":2789,"_31098":2707,"_21528":59485,"_5":14794,"_28279":59230,"_3062":51425},[],{"_3607":2790,"_31098":2707,"_21528":59487,"_5":14794,"_28279":59230,"_3062":59477},[],{"_3607":2791,"_31098":2707,"_21528":59489,"_5":14794,"_28279":59230,"_3062":59490},[],"High: `helm upgrade` fails on inline credentials",{"_3607":2792,"_31098":2707,"_21528":59492,"_5":14794,"_28279":59230,"_3062":59493},[],"Create the Secrets first; see Step 2",{"_3607":2793,"_31098":2707,"_21528":59495,"_5":14794,"_28279":59230,"_3062":59250},[],{"_3607":2794,"_31098":2707,"_21528":59497,"_5":14794,"_28279":59230,"_3062":59498},[],"Every deployment",{"_3607":2795,"_31098":2707,"_21528":59500,"_5":14794,"_28279":59230,"_3062":59501},[],"High: without a bootstrap principal there is no administrator",{"_3607":2796,"_31098":2707,"_21528":59503,"_5":14794,"_28279":59230,"_3062":59504},[],"Configure `services.authz`",{"_3607":2797,"_31098":2707,"_21528":59506,"_5":14794,"_28279":59230,"_3062":59254},[],{"_3607":2798,"_31098":2707,"_21528":59508,"_5":14794,"_28279":59230,"_3062":59477},[],{"_3607":2799,"_31098":2707,"_21528":59510,"_5":14794,"_28279":59230,"_3062":59511},[],"High: `helm upgrade` fails on the old keys",{"_3607":2800,"_31098":2707,"_21528":59513,"_5":14794,"_28279":59230,"_3062":59514},[],"Move JWKS and roles into `services.authz`",{"_3607":2801,"_31098":2707,"_21528":59516,"_5":14794,"_28279":59230,"_3062":59274},[],{"_3607":2802,"_31098":2707,"_21528":59518,"_5":14794,"_28279":59230,"_3062":59519},[],"3.8.0 deployments with per-service databases",{"_3607":2803,"_31098":2707,"_21528":59521,"_5":14794,"_28279":59230,"_3062":59522},[],"High: services find no data, or a migration aborts",{"_3607":2804,"_31098":2707,"_21528":59524,"_5":14794,"_28279":59230,"_3062":59525},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3607":2805,"_31098":2707,"_21528":59527,"_5":14794,"_28279":59230,"_3062":59278},[],{"_3607":2806,"_31098":2707,"_21528":59529,"_5":14794,"_28279":59230,"_3062":59530},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3607":2807,"_31098":2707,"_21528":59532,"_5":14794,"_28279":59230,"_3062":59533},[],"High: the backend no longer starts with them",{"_3607":2808,"_31098":2707,"_21528":59535,"_5":14794,"_28279":59230,"_3062":59536},[],"Move to PostgreSQL before upgrading",{"_3607":2809,"_31098":2707,"_21528":59538,"_5":14794,"_28279":59230,"_3062":59322},[],{"_3607":2810,"_31098":2707,"_21528":59540,"_5":14794,"_28279":59230,"_3062":59541},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3607":2811,"_31098":2707,"_21528":59543,"_5":14794,"_28279":59230,"_3062":59544},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3607":2812,"_31098":2707,"_21528":59546,"_5":14794,"_28279":59230,"_3062":59547},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3607":2813,"_31098":2707,"_21528":59549,"_5":14794,"_28279":59230,"_3062":59550},[],"Webhooks with file references",{"_3607":2814,"_31098":2707,"_21528":59552,"_5":14794,"_28279":59230,"_3062":59553},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3607":2815,"_31098":2707,"_21528":59555,"_5":14794,"_28279":59230,"_3062":59556},[],"High: enrollments calling the webhook fail",{"_3607":2816,"_31098":2707,"_21528":59558,"_5":14794,"_28279":59230,"_3062":59559},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3607":2817,"_31098":2707,"_21528":59561,"_5":14794,"_28279":59230,"_3062":59258},[],{"_3607":2818,"_31098":2707,"_21528":59563,"_5":14794,"_28279":59230,"_3062":59564},[],"Releases with per-service identity overrides or mounted key material",{"_3607":2819,"_31098":2707,"_21528":59566,"_5":14794,"_28279":59230,"_3062":59567},[],"Medium: services cannot read their files",{"_3607":2820,"_31098":2707,"_21528":59569,"_5":14794,"_28279":59230,"_3062":59570},[],"Remove the overrides and fix volume ownership",{"_3607":2821,"_31098":2707,"_21528":59572,"_5":14794,"_28279":59230,"_3062":59262},[],{"_3607":2822,"_31098":2707,"_21528":59574,"_5":14794,"_28279":59230,"_3062":59575},[],"Releases that set `amqp.tls`",{"_3607":2823,"_31098":2707,"_21528":59577,"_5":14794,"_28279":59230,"_3062":59578},[],"Medium: clients connect to the wrong port",{"_3607":2824,"_31098":2707,"_21528":59580,"_5":14794,"_28279":59230,"_3062":59581},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3607":2825,"_31098":2707,"_21528":59583,"_5":14794,"_28279":59230,"_3062":59282},[],{"_3607":2826,"_31098":2707,"_21528":59585,"_5":14794,"_28279":59230,"_3062":59586},[],"Installations whose CA keys predate the KMS",{"_3607":2827,"_31098":2707,"_21528":59588,"_5":14794,"_28279":59230,"_3062":59589},[],"Medium: CA keys stay unmanaged",{"_3607":2828,"_31098":2707,"_21528":59591,"_5":14794,"_28279":59230,"_3062":59592},[],"Run the CA-to-KMS migration",{"_3607":2829,"_31098":2707,"_21528":59594,"_5":14794,"_28279":59230,"_3062":59595},[],"Receiver certificate verification",{"_3607":2830,"_31098":2707,"_21528":59597,"_5":14794,"_28279":59230,"_3062":59598},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3607":2831,"_31098":2707,"_21528":59600,"_5":14794,"_28279":59230,"_3062":59601},[],"Medium: credentials go to an unverified receiver",{"_3607":2832,"_31098":2707,"_21528":59603,"_5":14794,"_28279":59230,"_3062":59604},[],"Set `insecure_skip_verify` to `false`",{"_3607":2833,"_31098":2707,"_21528":59606,"_5":14794,"_28279":59230,"_3062":59298},[],{"_3607":2834,"_31098":2707,"_21528":59608,"_5":14794,"_28279":59230,"_3062":59609},[],"Scripts and consoles that edit DMSs through the API",{"_3607":2835,"_31098":2707,"_21528":59611,"_5":14794,"_28279":59230,"_3062":59612},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3607":2836,"_31098":2707,"_21528":59614,"_5":14794,"_28279":59230,"_3062":59615},[],"Read the DMS before editing and use the new field",{"_3607":2837,"_31098":2707,"_21528":59617,"_5":14794,"_28279":59230,"_3062":59318},[],{"_3607":2838,"_31098":2707,"_21528":59619,"_5":14794,"_28279":59230,"_3062":59620},[],"Clients that create or update CRL settings through the API",{"_3607":2839,"_31098":2707,"_21528":59622,"_5":14794,"_28279":59230,"_3062":59623},[],"Medium: requests with the old field return an error",{"_3607":2840,"_31098":2707,"_21528":59625,"_5":14794,"_28279":59230,"_3062":59626},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3607":2841,"_31098":2707,"_21528":59628,"_5":14794,"_28279":59230,"_3062":59326},[],{"_3607":2842,"_31098":2707,"_21528":59630,"_5":14794,"_28279":59230,"_3062":59631},[],"Alert subscriptions and consumers of the VA events",{"_3607":2843,"_31098":2707,"_21528":59633,"_5":14794,"_28279":59230,"_3062":59634},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3607":2844,"_31098":2707,"_21528":59636,"_5":14794,"_28279":59230,"_3062":59637},[],"Review conditions filtering on the old event payload or subject",{"_3607":2845,"_31098":2707,"_21528":59639,"_5":14794,"_28279":59230,"_3062":59314},[],{"_3607":2846,"_31098":2707,"_21528":59641,"_5":14794,"_28279":59230,"_3062":59642},[],"Consumers that read the device `events` field",{"_3607":2847,"_31098":2707,"_21528":59644,"_5":14794,"_28279":59230,"_3062":59645},[],"Medium: the field disappears",{"_3607":2848,"_31098":2707,"_21528":59647,"_5":14794,"_28279":59230,"_3062":59648},[],"Use the new event endpoints",{"_3607":2849,"_31098":2707,"_21528":59650,"_5":14794,"_28279":59230,"_3062":59338},[],{"_3607":2850,"_31098":2707,"_21528":59652,"_5":14794,"_28279":59230,"_3062":59653},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3607":2851,"_31098":2707,"_21528":59655,"_5":14794,"_28279":59230,"_3062":59656},[],"Medium: the VA migration aborts",{"_3607":2852,"_31098":2707,"_21528":59658,"_5":14794,"_28279":59230,"_3062":59659},[],"Fix the affected roles before upgrading",{"_3607":2853,"_31098":2707,"_21528":59661,"_5":14794,"_28279":59230,"_3062":59266},[],{"_3607":2854,"_31098":2707,"_21528":59663,"_5":14794,"_28279":59230,"_3062":59664},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3607":2855,"_31098":2707,"_21528":59666,"_5":14794,"_28279":59230,"_3062":59667},[],"Low to medium: validation errors or changed defaults",{"_3607":2856,"_31098":2707,"_21528":59669,"_5":14794,"_28279":59230,"_3062":59670},[],"Update the values file",{"_3607":2857,"_31098":2707,"_21528":59672,"_5":14794,"_28279":59230,"_3062":59306},[],{"_3607":2858,"_31098":2707,"_21528":59674,"_5":14794,"_28279":59230,"_3062":59675},[],"Clients that send the DMS ID in the update body",{"_3607":2859,"_31098":2707,"_21528":59677,"_5":14794,"_28279":59230,"_3062":59678},[],"Low: the ID in the URL wins",{"_3607":2860,"_31098":2707,"_21528":59680,"_5":14794,"_28279":59230,"_3062":59681},[],"Send the ID in the URL",{"_3607":2861,"_31098":2707,"_21528":59683,"_5":14794,"_28279":59230,"_3062":59330},[],{"_3607":2862,"_31098":2707,"_21528":59685,"_5":14794,"_28279":59230,"_3062":59686},[],"Clients that send an `id` when creating or importing CAs",{"_3607":2863,"_31098":2707,"_21528":59688,"_5":14794,"_28279":59230,"_3062":59689},[],"Low: the ID in the body is ignored, and the field is removed",{"_3607":2864,"_31098":2707,"_21528":59691,"_5":14794,"_28279":59230,"_3062":59692},[],"Let the backend assign the ID and use the returned one",{"_3607":2865,"_31098":2707,"_21528":59694,"_5":14794,"_28279":59230,"_3062":59334},[],{"_3607":2866,"_31098":2707,"_21528":59696,"_5":14794,"_28279":59230,"_3062":59697},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3607":2867,"_31098":2707,"_21528":59699,"_5":14794,"_28279":59230,"_3062":59700},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3607":2868,"_31098":2707,"_21528":59702,"_5":14794,"_28279":59230,"_3062":59703},[],"Use the KMS `sign` and `verify` operations",{"_3607":2869,"_31098":2707,"_21528":59705,"_5":14794,"_28279":59230,"_3062":59310},[],{"_3607":2870,"_31098":2707,"_21528":59707,"_5":14794,"_28279":59230,"_3062":59708},[],"Consumers that match on certificate `type`",{"_3607":2871,"_31098":2707,"_21528":59710,"_5":14794,"_28279":59230,"_3062":59711},[],"Low: two values are renamed",{"_3607":2872,"_31098":2707,"_21528":59713,"_5":14794,"_28279":59230,"_3062":59714},[],"Adapt consumers",{"_3607":2873,"_31098":2707,"_21528":59716,"_5":14794,"_28279":59230,"_3062":59302},[],{"_3607":2874,"_31098":2707,"_21528":59718,"_5":14794,"_28279":59230,"_3062":59719},[],"Any DMS",{"_3607":2875,"_31098":2707,"_21528":59721,"_5":14794,"_28279":59230,"_3062":59722},[],"Low: informational",{"_3607":2876,"_31098":2707,"_21528":59724,"_5":14794,"_28279":59230,"_3062":59725},[],"Read both blocks before editing",{"_3607":2877,"_31098":2707,"_21528":59727,"_5":14794,"_28279":59238,"_3062":59728},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3607":2878,"_31098":2707,"_21528":59730,"_5":14794,"_28279":59238,"_3062":59731},[],"Step 4 of the migration guide copies the data.",{"_3607":2879,"_31098":2707,"_21528":59733,"_5":14794,"_28279":59242,"_3062":59734},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3607":2880,"_31098":2707,"_21528":59736,"_5":14794,"_28279":59246,"_3062":59737},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3607":2881,"_31098":2707,"_21528":59739,"_5":14794,"_28279":59246,"_3062":59740},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3607":2882,"_31098":2707,"_21528":59742,"_5":14794,"_28279":59249,"_3062":59743},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3607":2883,"_31098":2707,"_21528":59745,"_5":14794,"_28279":59253,"_3062":59746},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3607":2884,"_31098":2707,"_21528":59748,"_5":14794,"_28279":59257,"_3062":59749},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3607":2885,"_31098":2707,"_21528":59751,"_5":14794,"_28279":59257,"_3062":59752},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3607":2886,"_31098":2707,"_21528":59754,"_5":14794,"_28279":59257,"_3062":59755},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3607":2887,"_31098":2707,"_21528":59757,"_5":14794,"_28279":59261,"_3062":59758},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3607":2888,"_31098":2707,"_21528":59760,"_5":14794,"_28279":59265,"_3062":59761},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3607":2889,"_31098":2707,"_21528":59763,"_5":14794,"_28279":59265,"_3062":59764},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3607":2890,"_31098":2707,"_21528":59766,"_5":14794,"_28279":59265,"_3062":59767},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3607":2891,"_31098":2707,"_21528":59769,"_5":14794,"_28279":59265,"_3062":59770},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3607":2892,"_31098":2707,"_21528":59772,"_5":14794,"_28279":59265,"_3062":59773},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3607":2893,"_31098":2707,"_21528":59775,"_5":14794,"_28279":59265,"_3062":59776},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3607":2894,"_31098":2707,"_21528":59778,"_5":14794,"_28279":59273,"_3062":59779},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3607":2895,"_31098":2707,"_21528":59781,"_5":14794,"_28279":59273,"_3062":59782},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3607":2896,"_31098":2707,"_21528":59784,"_5":14794,"_28279":59273,"_3062":59785},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3607":2897,"_31098":2707,"_21528":59787,"_5":14794,"_28279":59273,"_3062":59788},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3607":2898,"_31098":2707,"_21528":59790,"_5":14794,"_28279":59273,"_3062":59791},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3607":2899,"_31098":2707,"_21528":59793,"_5":14794,"_28279":59277,"_3062":59794},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3607":2900,"_31098":2707,"_21528":59796,"_5":14794,"_28279":59281,"_3062":59797},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3607":2901,"_31098":2707,"_21528":59799,"_5":14794,"_28279":59281,"_3062":59800},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3607":2902,"_31098":2707,"_21528":59802,"_5":14794,"_28279":59281,"_3062":59803},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3607":2903,"_31098":2707,"_21528":59805,"_5":14794,"_28279":59281,"_3062":59806},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3607":2904,"_31098":2707,"_21528":59808,"_5":14794,"_28279":59281,"_3062":59809},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3607":2905,"_31098":2707,"_21528":59811,"_5":14794,"_28279":59281,"_3062":59812},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3607":2906,"_31098":2707,"_21528":59814,"_5":14794,"_28279":59281,"_3062":59815},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3607":2907,"_31098":2707,"_21528":59817,"_5":14794,"_28279":59281,"_3062":59818},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3607":2908,"_31098":2707,"_21528":59820,"_5":14794,"_28279":59285,"_3062":59821},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3607":2909,"_31098":2707,"_21528":59823,"_5":14794,"_28279":59293,"_3062":59824},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3607":2910,"_31098":2707,"_21528":59826,"_5":14794,"_28279":59293,"_3062":59827},[],"Field in 3.8.0",{"_3607":2911,"_31098":2707,"_21528":59829,"_5":14794,"_28279":59293,"_3062":59830},[],"Field in 4.0.0",{"_3607":2912,"_31098":2707,"_21528":59832,"_5":14794,"_28279":59293,"_3062":59833},[],"`validate_server_cert`",{"_3607":2913,"_31098":2707,"_21528":59835,"_5":14794,"_28279":59293,"_3062":59836},[],"`insecure_skip_verify` (value negated)",{"_3607":2914,"_31098":2707,"_21528":59838,"_5":14794,"_28279":59293,"_3062":59839},[],"`oidc`",{"_3607":2915,"_31098":2707,"_21528":59841,"_5":14794,"_28279":59293,"_3062":59842},[],"`jwt_options`",{"_3607":2916,"_31098":2707,"_21528":59844,"_5":14794,"_28279":59293,"_3062":59845},[],"`apikey`",{"_3607":2917,"_31098":2707,"_21528":59847,"_5":14794,"_28279":59293,"_3062":59848},[],"`apikey_options`",{"_3607":2918,"_31098":2707,"_21528":59850,"_5":14794,"_28279":59293,"_3062":59851},[],"`mtls`",{"_3607":2919,"_31098":2707,"_21528":59853,"_5":14794,"_28279":59293,"_3062":59854},[],"`mtls_options`",{"_3607":2920,"_31098":2707,"_21528":59856,"_5":14794,"_28279":59293,"_3062":59857},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3607":2921,"_31098":2707,"_21528":59859,"_5":14794,"_28279":59293,"_3062":59860},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3607":2922,"_31098":2707,"_21528":59862,"_5":14794,"_28279":59293,"_3062":59863},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3607":2923,"_31098":2707,"_21528":59865,"_5":14794,"_28279":59297,"_3062":59866},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3607":2924,"_31098":2707,"_21528":59868,"_5":14794,"_28279":59297,"_3062":59869},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3607":2925,"_31098":2707,"_21528":59871,"_5":14794,"_28279":59297,"_3062":59872},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3607":2926,"_31098":2707,"_21528":59874,"_5":14794,"_28279":59301,"_3062":59875},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3607":2927,"_31098":2707,"_21528":59877,"_5":14794,"_28279":59305,"_3062":59878},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3607":2928,"_31098":2707,"_21528":59880,"_5":14794,"_28279":59309,"_3062":59881},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3607":2929,"_31098":2707,"_21528":59883,"_5":14794,"_28279":59313,"_3062":59884},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3607":2930,"_31098":2707,"_21528":59886,"_5":14794,"_28279":59313,"_3062":59887},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3607":2931,"_31098":2707,"_21528":59889,"_5":14794,"_28279":59313,"_3062":59890},[],"`POST /v1/devices/:id/events` creates an event.",{"_3607":2932,"_31098":2707,"_21528":59892,"_5":14794,"_28279":59313,"_3062":59893},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3607":2933,"_31098":2707,"_21528":59895,"_5":14794,"_28279":59317,"_3062":59896},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3607":2934,"_31098":2707,"_21528":59898,"_5":14794,"_28279":59321,"_3062":59899},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3607":2935,"_31098":2707,"_21528":59901,"_5":14794,"_28279":59321,"_3062":59902},[],"Route",{"_3607":2936,"_31098":2707,"_21528":59904,"_5":14794,"_28279":59321,"_3062":54227},[],{"_3607":2937,"_31098":2707,"_21528":59906,"_5":14794,"_28279":59321,"_3062":59907},[],"`GET /v1/crl-settings`",{"_3607":2938,"_31098":2707,"_21528":59909,"_5":14794,"_28279":59321,"_3062":59910},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3607":2939,"_31098":2707,"_21528":59912,"_5":14794,"_28279":59321,"_3062":59913},[],"`GET /v1/crl-settings/{ca-id}`",{"_3607":2940,"_31098":2707,"_21528":59915,"_5":14794,"_28279":59321,"_3062":59916},[],"Reads the settings of a CA.",{"_3607":2941,"_31098":2707,"_21528":59918,"_5":14794,"_28279":59321,"_3062":59919},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3607":2942,"_31098":2707,"_21528":59921,"_5":14794,"_28279":59321,"_3062":59922},[],"Replaces `crl_options`.",{"_3607":2943,"_31098":2707,"_21528":59924,"_5":14794,"_28279":59321,"_3062":59925},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3607":2944,"_31098":2707,"_21528":59927,"_5":14794,"_28279":59321,"_3062":59928},[],"Removes the archived settings of a CA.",{"_3607":2945,"_31098":2707,"_21528":59930,"_5":14794,"_28279":59321,"_3062":59931},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3607":2946,"_31098":2707,"_21528":59933,"_5":14794,"_28279":59321,"_3062":59934},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3607":2947,"_31098":2707,"_21528":59936,"_5":14794,"_28279":59321,"_3062":59937},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3607":2948,"_31098":2707,"_21528":59939,"_5":14794,"_28279":59321,"_3062":59940},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3607":2949,"_31098":2707,"_21528":59942,"_5":14794,"_28279":59321,"_3062":59943},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3607":2950,"_31098":2707,"_21528":59945,"_5":14794,"_28279":59321,"_3062":59946},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3607":2951,"_31098":2707,"_21528":59948,"_5":14794,"_28279":59321,"_3062":59949},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3607":2952,"_31098":2707,"_21528":59951,"_5":14794,"_28279":59321,"_3062":59952},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3607":2953,"_31098":2707,"_21528":59954,"_5":14794,"_28279":59321,"_3062":59955},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3607":2954,"_31098":2707,"_21528":59957,"_5":14794,"_28279":59321,"_3062":59958},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3607":2955,"_31098":2707,"_21528":59960,"_5":14794,"_28279":59321,"_3062":59961},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3607":2956,"_31098":2707,"_21528":59963,"_5":14794,"_28279":59325,"_3062":59964},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3607":2957,"_31098":2707,"_21528":59966,"_5":14794,"_28279":59329,"_3062":59967},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3607":2958,"_31098":2707,"_21528":59969,"_5":14794,"_28279":59333,"_3062":59970},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3607":2959,"_31098":2707,"_21528":59972,"_5":14794,"_28279":59333,"_3062":59973},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3607":2960,"_31098":2707,"_21528":59975,"_5":14794,"_28279":59337,"_3062":59976},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3607":2961,"_31098":2707,"_21528":59978,"_5":14794,"_28279":59341,"_3062":59979},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3607":2962,"_31098":2707,"_21528":59981,"_5":14794,"_28279":59345,"_3062":59982},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3607":2963,"_31098":2707,"_21528":59984,"_5":14794,"_28279":59345,"_3062":59985},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3607":2964,"_31098":2707,"_21528":59987,"_5":14794,"_28279":59345,"_3062":59988},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3607":2965,"_31098":2707,"_21528":59990,"_5":14794,"_28279":59345,"_3062":59991},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3607":2966,"_31098":2707,"_21528":59993,"_5":14794,"_28279":59345,"_3062":59994},[],"Record the names of your local-storage PVCs:",{"_3607":2967,"_31098":2707,"_21528":59996,"_5":14794,"_28279":59345,"_3062":59997},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3607":2968,"_31098":2707,"_21528":59999,"_5":14794,"_28279":59349,"_3062":60000},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3607":2969,"_31098":2707,"_21528":60002,"_5":14794,"_28279":59349,"_3062":60003},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3607":2970,"_31098":2707,"_21528":60005,"_5":14794,"_28279":59349,"_3062":60006},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3607":2971,"_31098":2707,"_21528":60008,"_5":14794,"_28279":59349,"_3062":60009},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3607":2972,"_31098":2707,"_21528":60011,"_5":14794,"_28279":59349,"_3062":60012},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3607":2973,"_31098":2707,"_21528":60014,"_5":14794,"_28279":59353,"_3062":60015},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3607":2974,"_31098":2707,"_21528":60017,"_5":14794,"_28279":59353,"_3062":60018},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3607":2975,"_31098":2707,"_21528":60020,"_5":14794,"_28279":59353,"_3062":60021},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3607":2976,"_31098":2707,"_21528":60023,"_5":14794,"_28279":59353,"_3062":60024},[],"Secret (`existingSecret`)",{"_3607":2977,"_31098":2707,"_21528":60026,"_5":14794,"_28279":59353,"_3062":60027},[],"Required data keys",{"_3607":2978,"_31098":2707,"_21528":60029,"_5":14794,"_28279":59353,"_3062":60030},[],"When",{"_3607":2979,"_31098":2707,"_21528":60032,"_5":14794,"_28279":59353,"_3062":60033},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3607":2980,"_31098":2707,"_21528":60035,"_5":14794,"_28279":59353,"_3062":60036},[],"`username`, `password`",{"_3607":2981,"_31098":2707,"_21528":60038,"_5":14794,"_28279":59353,"_3062":60039},[],"Always",{"_3607":2982,"_31098":2707,"_21528":60041,"_5":14794,"_28279":59353,"_3062":60042},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3607":2983,"_31098":2707,"_21528":60044,"_5":14794,"_28279":59353,"_3062":60036},[],{"_3607":2984,"_31098":2707,"_21528":60046,"_5":14794,"_28279":59353,"_3062":60039},[],{"_3607":2985,"_31098":2707,"_21528":60048,"_5":14794,"_28279":59353,"_3062":60049},[],"`services.alerts.smtp_server.existingSecret`",{"_3607":2986,"_31098":2707,"_21528":60051,"_5":14794,"_28279":59353,"_3062":60036},[],{"_3607":2987,"_31098":2707,"_21528":60053,"_5":14794,"_28279":59353,"_3062":60054},[],"Only when SMTP authentication is enabled",{"_3607":2988,"_31098":2707,"_21528":60056,"_5":14794,"_28279":59353,"_3062":60057},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3607":2989,"_31098":2707,"_21528":60059,"_5":14794,"_28279":59353,"_3062":60060},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3607":2990,"_31098":2707,"_21528":60062,"_5":14794,"_28279":59353,"_3062":60063},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3607":2991,"_31098":2707,"_21528":60065,"_5":14794,"_28279":59353,"_3062":60066},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3607":2992,"_31098":2707,"_21528":60068,"_5":14794,"_28279":59353,"_3062":60069},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3607":2993,"_31098":2707,"_21528":60071,"_5":14794,"_28279":59353,"_3062":60072},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3607":2994,"_31098":2707,"_21528":60074,"_5":14794,"_28279":59353,"_3062":60075},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3607":2995,"_31098":2707,"_21528":60077,"_5":14794,"_28279":59353,"_3062":60078},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3607":2996,"_31098":2707,"_21528":60080,"_5":14794,"_28279":59353,"_3062":60081},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3607":2997,"_31098":2707,"_21528":60083,"_5":14794,"_28279":59353,"_3062":60084},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3607":2998,"_31098":2707,"_21528":60086,"_5":14794,"_28279":59353,"_3062":60087},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3607":2999,"_31098":2707,"_21528":60089,"_5":14794,"_28279":59353,"_3062":60090},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3607":3000,"_31098":2707,"_21528":60092,"_5":14794,"_28279":59353,"_3062":60093},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3607":3001,"_31098":2707,"_21528":60095,"_5":14794,"_28279":59353,"_3062":60096},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3607":3002,"_31098":2707,"_21528":60098,"_5":14794,"_28279":59353,"_3062":60099},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3607":3003,"_31098":2707,"_21528":60101,"_5":14794,"_28279":59357,"_3062":60102},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3607":3004,"_31098":2707,"_21528":60104,"_5":14794,"_28279":59357,"_3062":60105},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3607":3005,"_31098":2707,"_21528":60107,"_5":14794,"_28279":59361,"_3062":60108},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3607":3006,"_31098":2707,"_21528":60110,"_5":14794,"_28279":59361,"_3062":60111},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3607":3007,"_31098":2707,"_21528":60113,"_5":14794,"_28279":59361,"_3062":60114},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3607":3008,"_31098":2707,"_21528":60116,"_5":14794,"_28279":59361,"_3062":60117},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3607":3009,"_31098":2707,"_21528":60119,"_5":14794,"_28279":59361,"_3062":60120},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3607":3010,"_31098":2707,"_21528":60122,"_5":14794,"_28279":59361,"_3062":60123},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3607":3011,"_31098":2707,"_21528":60125,"_5":14794,"_28279":59361,"_3062":60126},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3607":3012,"_31098":2707,"_21528":60128,"_5":14794,"_28279":59361,"_3062":60129},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3607":3013,"_31098":2707,"_21528":60131,"_5":14794,"_28279":59361,"_3062":60132},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3607":3014,"_31098":2707,"_21528":60134,"_5":14794,"_28279":59361,"_3062":60135},[],"**Remove the helper and restore the recorded replica counts:**",{"_3607":3015,"_31098":2707,"_21528":60137,"_5":14794,"_28279":59361,"_3062":60138},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3607":3016,"_31098":2707,"_21528":60140,"_5":14794,"_28279":59365,"_3062":60141},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3607":3017,"_31098":2707,"_21528":60143,"_5":14794,"_28279":59365,"_3062":60144},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3607":3018,"_31098":2707,"_21528":60146,"_5":14794,"_28279":59369,"_3062":60147},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3607":3019,"_31098":2707,"_21528":60149,"_5":14794,"_28279":59369,"_3062":60150},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3607":3020,"_31098":2707,"_21528":60152,"_5":14794,"_28279":59369,"_3062":60153},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3607":3021,"_31098":2707,"_21528":60155,"_5":14794,"_28279":59369,"_3062":60156},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3607":3022,"_31098":2707,"_21528":60158,"_5":14794,"_28279":59369,"_3062":60159},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3607":3023,"_31098":2707,"_21528":60161,"_5":14794,"_28279":59369,"_3062":60162},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3607":3024,"_31098":2707,"_21528":60164,"_5":14794,"_28279":59369,"_3062":60165},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3607":3025,"_31098":2707,"_21528":60167,"_5":14794,"_28279":59369,"_3062":60168},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3607":3026,"_31098":2707,"_21528":60170,"_5":14794,"_28279":59373,"_3062":60171},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3607":3027,"_31098":2707,"_21528":60173,"_5":14794,"_28279":59373,"_3062":60174},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3607":3028,"_31098":2707,"_21528":60176,"_5":14794,"_28279":59373,"_3062":60177},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3607":3029,"_31098":2707,"_21528":60179,"_5":14794,"_28279":59373,"_3062":60180},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3607":3030,"_31098":2707,"_21528":60182,"_5":14794,"_28279":59373,"_3062":60183},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3607":3031,"_31098":2707,"_21528":60185,"_5":14794,"_28279":59373,"_3062":60186},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3607":3032,"_31098":2707,"_21528":60188,"_5":14794,"_28279":59373,"_3062":60189},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3607":3033,"_31098":2707,"_21528":60191,"_5":14794,"_28279":59373,"_3062":60192},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3607":3034,"_31098":2707,"_21528":60194,"_5":14794,"_28279":59373,"_3062":60195},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3607":3035,"_31098":2707,"_21528":60197,"_5":14794,"_28279":59373,"_3062":60198},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3607":3036,"_31098":2707,"_21528":60200,"_5":14794,"_28279":59373,"_3062":60201},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3607":3037,"_31098":2707,"_21528":60203,"_5":14794,"_28279":59376,"_3062":60204},[],"After the upgrade, check in this order:",{"_3607":3038,"_31098":2707,"_21528":60206,"_5":14794,"_28279":59376,"_3062":60207},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3607":3039,"_31098":2707,"_21528":60209,"_5":14794,"_28279":59376,"_3062":60210},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3607":3040,"_31098":2707,"_21528":60212,"_5":14794,"_28279":59376,"_3062":60213},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3607":3041,"_31098":2707,"_21528":60215,"_5":14794,"_28279":59376,"_3062":60216},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3607":3042,"_31098":2707,"_21528":60218,"_5":14794,"_28279":59376,"_3062":60219},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3607":3043,"_31098":2707,"_21528":60221,"_5":14794,"_28279":59376,"_3062":60222},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3607":3044,"_31098":2707,"_21528":60224,"_5":14794,"_28279":59376,"_3062":60225},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3607":3045,"_31098":2707,"_21528":60227,"_5":14794,"_28279":59376,"_3062":60228},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3607":3046,"_31098":2707,"_21528":60230,"_5":14794,"_28279":59376,"_3062":60231},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3607":3047,"_31098":2707,"_21528":60233,"_5":14794,"_28279":59376,"_3062":60234},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3607":3048,"_31098":2707,"_21528":60236,"_5":14794,"_28279":59376,"_3062":60237},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3607":3049,"_31098":2707,"_21528":60239,"_5":14794,"_28279":59376,"_3062":60240},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3607":3050,"_31098":2707,"_21528":60242,"_5":14794,"_28279":59376,"_3062":60243},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3607":3051,"_31098":2707,"_21528":60245,"_5":14794,"_28279":59376,"_3062":60246},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3607":3052,"_31098":2707,"_21528":60248,"_5":14794,"_28279":59376,"_3062":60249},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3607":3053,"_31098":2707,"_21528":60251,"_5":14794,"_28279":59380,"_3062":60252},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3607":3054,"_31098":2707,"_21528":60254,"_5":14794,"_28279":59380,"_3062":60255},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3607":3055,"_31098":2707,"_21528":60257,"_5":14794,"_28279":59380,"_3062":60258},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3607":3056,"_31098":2707,"_21528":60260,"_5":14794,"_28279":59380,"_3062":60261},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3607":3057,"_31098":2707,"_21528":60263,"_5":14794,"_28279":59380,"_3062":60264},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60267":60268,"_60269":60270,"_60271":60272,"_60273":60274,"_18653":3097,"_72460":3097},"language","english","sortableProperties",[3062,31098,5,28279],"sortablePropertiesWithTypes",{"_3062":25703,"_31098":25703,"_5":25703,"_28279":25703},"sorts",{"_3062":60275,"_31098":63322,"_5":66368,"_28279":69414},{"_4805":60276,"_60277":60278,"_5":25703},{"_14875":4324,"_15254":7238,"_15273":9373,"_30097":3440,"_15260":3870,"_20435":5901,"_14896":3472,"_14903":7870,"_30039":8926,"_30453":20743,"_30474":23403,"_30073":6159,"_35498":4333,"_30176":7775,"_30518":5101,"_35505":30689,"_35508":4068,"_35511":7912,"_35514":6178,"_30920":10409,"_35519":10776,"_35521":3371,"_30955":9215,"_15269":3355,"_35525":3453,"_35528":