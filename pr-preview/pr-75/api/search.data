":128923,"_41459":128926,"_41461":128929,"_41463":128932,"_41465":128935,"_41467":128938,"_41469":128941,"_41471":128944,"_41473":128947,"_41475":128950,"_41477":128953,"_41480":128956,"_41482":128959,"_41484":128962,"_41486":128965,"_41488":128968,"_41490":128971,"_41492":128974,"_41494":128977,"_41496":128980,"_41498":128983,"_41500":128986,"_41502":128989,"_41504":128992,"_41506":128995,"_41509":128998,"_41511":129001,"_41513":129004,"_41515":129007,"_41517":129010,"_41519":129013,"_41521":129016,"_41523":129019,"_41525":129022,"_41527":129025,"_41529":129028,"_41531":129031,"_41533":129034,"_41535":129037,"_41537":129040,"_41539":129043,"_41541":129046,"_41543":129049,"_41545":129052,"_41547":129055,"_41549":129058,"_41551":129061,"_41553":129064,"_41555":129067,"_41557":129070,"_41559":129073,"_41561":129076,"_41563":129079,"_41565":129082,"_41567":129085,"_41569":129088,"_41571":129091,"_41574":129094,"_41576":129097,"_41578":129100},{"_3607":72467,"_31098":72467,"_5":15159,"_3062":119864,"_31457":119865,"_21528":119868,"_28279":72467},"Despliega desde AWS Marketplace",[50787,119866,119867],"Despliegue","Otros modelos",[],{"_3607":72468,"_31098":72467,"_21528":119870,"_5":14794,"_28279":72467,"_3062":119871},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3607":72469,"_31098":72467,"_5":31454,"_21528":119873,"_28279":119874,"_3062":119875},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3607":72470,"_31098":72467,"_5":31454,"_21528":119877,"_28279":119878,"_3062":119879},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3607":72471,"_31098":72467,"_5":31454,"_21528":119881,"_28279":119882,"_3062":119883},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3607":72472,"_31098":72467,"_5":31454,"_21528":119885,"_28279":119886,"_3062":119887},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3607":72473,"_31098":72467,"_5":31454,"_21528":119889,"_28279":119890,"_3062":119891},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3607":72474,"_31098":72467,"_5":31454,"_21528":119893,"_28279":119894,"_3062":119895},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3607":72475,"_31098":72467,"_5":31454,"_21528":119897,"_28279":119898,"_3062":119899},[],"/docs/pr-preview/pr-75/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3607":72476,"_31098":72467,"_21528":119901,"_5":14794,"_28279":72467,"_3062":119902},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3607":72477,"_31098":72467,"_21528":119904,"_5":14794,"_28279":119874,"_3062":119905},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3607":72478,"_31098":72467,"_21528":119907,"_5":14794,"_28279":119874,"_3062":119908},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3607":72479,"_31098":72467,"_21528":119910,"_5":14794,"_28279":119874,"_3062":119911},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3607":72480,"_31098":72467,"_21528":119913,"_5":14794,"_28279":119878,"_3062":119914},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3607":72481,"_31098":72467,"_21528":119916,"_5":14794,"_28279":119878,"_3062":119917},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3607":72482,"_31098":72467,"_21528":119919,"_5":14794,"_28279":119878,"_3062":119920},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3607":72483,"_31098":72467,"_21528":119922,"_5":14794,"_28279":119882,"_3062":119923},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3607":72484,"_31098":72467,"_21528":119925,"_5":14794,"_28279":119886,"_3062":119926},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3607":72485,"_31098":72467,"_21528":119928,"_5":14794,"_28279":119890,"_3062":119929},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3607":72486,"_31098":72467,"_21528":119931,"_5":14794,"_28279":119894,"_3062":119932},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3607":72487,"_31098":72467,"_21528":119934,"_5":14794,"_28279":119898,"_3062":119935},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3607":72488,"_31098":72488,"_5":15159,"_3062":119937,"_31457":119938,"_21528":119939,"_28279":72488},"Despliega Lamassu",[50787,119866],[],{"_3607":72489,"_31098":72488,"_21528":119941,"_5":14794,"_28279":72488,"_3062":119942},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3607":72490,"_31098":72488,"_5":31454,"_21528":119944,"_28279":119945,"_3062":119946},[],"/docs/pr-preview/pr-75/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3607":72491,"_31098":72488,"_5":31454,"_21528":119948,"_28279":119949,"_3062":119950},[],"/docs/pr-preview/pr-75/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3607":72492,"_31098":72488,"_5":31454,"_21528":119952,"_28279":119953,"_3062":119954},[],"/docs/pr-preview/pr-75/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3607":72493,"_31098":72488,"_21528":119956,"_5":14794,"_28279":72488,"_3062":119957},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3607":72494,"_31098":72488,"_21528":119959,"_5":14794,"_28279":119945,"_3062":119960},[],"Modelo",{"_3607":72495,"_31098":72488,"_21528":119962,"_5":14794,"_28279":119945,"_3062":119963},[],"Recomendado para",{"_3607":72496,"_31098":72488,"_21528":119965,"_5":14794,"_28279":119945,"_3062":119966},[],"Quién opera la infraestructura",{"_3607":72497,"_31098":72488,"_21528":119968,"_5":14794,"_28279":119945,"_3062":119969},[],"Punto de partida",{"_3607":72498,"_31098":72488,"_21528":119971,"_5":14794,"_28279":119945,"_3062":50894},[],{"_3607":72499,"_31098":72488,"_21528":119973,"_5":14794,"_28279":119945,"_3062":119974},[],"Producción, entornos regulados y despliegues personalizados",{"_3607":72500,"_31098":72488,"_21528":119976,"_5":14794,"_28279":119945,"_3062":119977},[],"Tu equipo",{"_3607":72501,"_31098":72488,"_21528":119979,"_5":14794,"_28279":119945,"_3062":119980},[],"Helm o Fastlane",{"_3607":72502,"_31098":72488,"_21528":119982,"_5":14794,"_28279":119945,"_3062":50906},[],{"_3607":72503,"_31098":72488,"_21528":119984,"_5":14794,"_28279":119945,"_3062":119985},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3607":72504,"_31098":72488,"_21528":119987,"_5":14794,"_28279":119945,"_3062":119977},[],{"_3607":72505,"_31098":72488,"_21528":119989,"_5":14794,"_28279":119945,"_3062":119990},[],"Imagen preconfigurada en EC2",{"_3607":72506,"_31098":72488,"_21528":119992,"_5":14794,"_28279":119945,"_3062":50917},[],{"_3607":72507,"_31098":72488,"_21528":119994,"_5":14794,"_28279":119945,"_3062":119995},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3607":72508,"_31098":72488,"_21528":119997,"_5":14794,"_28279":119945,"_3062":50923},[],{"_3607":72509,"_31098":72488,"_21528":119999,"_5":14794,"_28279":119945,"_3062":120000},[],"Suscripción gestionada",{"_3607":72510,"_31098":72488,"_21528":120002,"_5":14794,"_28279":119945,"_3062":120003},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3607":72511,"_31098":72488,"_21528":120005,"_5":14794,"_28279":119945,"_3062":120006},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3607":72512,"_31098":72488,"_21528":120008,"_5":14794,"_28279":119945,"_3062":120009},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3607":72513,"_31098":72488,"_21528":120011,"_5":14794,"_28279":119949,"_3062":120012},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3607":72514,"_31098":72488,"_21528":120014,"_5":14794,"_28279":119953,"_3062":120015},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3607":72515,"_31098":72515,"_5":15159,"_3062":120017,"_31457":120018,"_21528":120019,"_28279":72515},"Utiliza Lamassu como SaaS",[50787,119866,119867],[],{"_3607":72516,"_31098":72515,"_21528":120021,"_5":14794,"_28279":72515,"_3062":120022},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3607":72517,"_31098":72515,"_5":31454,"_21528":120024,"_28279":120025,"_3062":120026},[],"/docs/pr-preview/pr-75/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3607":72518,"_31098":72515,"_5":31454,"_21528":120028,"_28279":120029,"_3062":120030},[],"/docs/pr-preview/pr-75/es/deployment/saas#planes","Planes",{"_3607":72519,"_31098":72515,"_5":31454,"_21528":120032,"_28279":120033,"_3062":120034},[],"/docs/pr-preview/pr-75/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3607":72520,"_31098":72515,"_21528":120036,"_5":14794,"_28279":72515,"_3062":120037},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3607":72521,"_31098":72515,"_21528":120039,"_5":14794,"_28279":120025,"_3062":120040},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3607":72522,"_31098":72515,"_21528":120042,"_5":14794,"_28279":120025,"_3062":120043},[],"Copias de seguridad automáticas.",{"_3607":72523,"_31098":72515,"_21528":120045,"_5":14794,"_28279":120025,"_3062":120046},[],"Actualizaciones de versión.",{"_3607":72524,"_31098":72515,"_21528":120048,"_5":14794,"_28279":120025,"_3062":120049},[],"Soporte técnico y SLA según el plan contratado.",{"_3607":72525,"_31098":72515,"_21528":120051,"_5":14794,"_28279":120029,"_3062":50978},[],{"_3607":72526,"_31098":72515,"_21528":120053,"_5":14794,"_28279":120029,"_3062":120054},[],"Dispositivos",{"_3607":72527,"_31098":72515,"_21528":120056,"_5":14794,"_28279":120029,"_3062":120057},[],"Soporte",{"_3607":72528,"_31098":72515,"_21528":120059,"_5":14794,"_28279":120029,"_3062":50987},[],{"_3607":72529,"_31098":72515,"_21528":120061,"_5":14794,"_28279":120029,"_3062":50990},[],{"_3607":72530,"_31098":72515,"_21528":120063,"_5":14794,"_28279":120029,"_3062":120064},[],"Hasta 1.000",{"_3607":72531,"_31098":72515,"_21528":120066,"_5":14794,"_28279":120029,"_3062":50996},[],{"_3607":72532,"_31098":72515,"_21528":120068,"_5":14794,"_28279":120029,"_3062":120069},[],"99,5 %",{"_3607":72533,"_31098":72515,"_21528":120071,"_5":14794,"_28279":120029,"_3062":51002},[],{"_3607":72534,"_31098":72515,"_21528":120073,"_5":14794,"_28279":120029,"_3062":120074},[],"Hasta 10.000",{"_3607":72535,"_31098":72515,"_21528":120076,"_5":14794,"_28279":120029,"_3062":120077},[],"Email y chat",{"_3607":72536,"_31098":72515,"_21528":120079,"_5":14794,"_28279":120029,"_3062":120080},[],"99,9 %",{"_3607":72537,"_31098":72515,"_21528":120082,"_5":14794,"_28279":120029,"_3062":51014},[],{"_3607":72538,"_31098":72515,"_21528":120084,"_5":14794,"_28279":120029,"_3062":120085},[],"Ilimitados",{"_3607":72539,"_31098":72515,"_21528":120087,"_5":14794,"_28279":120029,"_3062":120088},[],"Dedicado",{"_3607":72540,"_31098":72515,"_21528":120090,"_5":14794,"_28279":120029,"_3062":120091},[],"99,99 %",{"_3607":72541,"_31098":72515,"_21528":120093,"_5":14794,"_28279":120033,"_3062":120094},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3607":72542,"_31098":72515,"_21528":120096,"_5":14794,"_28279":120033,"_3062":120097},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3607":72543,"_31098":72543,"_5":15159,"_3062":51031,"_31457":120099,"_21528":120101,"_28279":72543},[50787,119866,120100],"Kubernetes autogestionado",[],{"_3607":72544,"_31098":72543,"_21528":120103,"_5":14794,"_28279":72543,"_3062":120104},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3607":72545,"_31098":72543,"_5":31454,"_21528":120106,"_28279":120107,"_3062":120108},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3607":72546,"_31098":72543,"_5":31454,"_21528":120110,"_28279":120111,"_3062":120112},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3607":72547,"_31098":72543,"_5":31454,"_21528":120114,"_28279":120115,"_3062":120116},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3607":72548,"_31098":72543,"_5":31454,"_21528":120118,"_28279":120119,"_3062":120120},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3607":72549,"_31098":72543,"_5":31454,"_21528":120122,"_28279":120123,"_3062":120124},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3607":72550,"_31098":72543,"_5":31454,"_21528":120126,"_28279":120127,"_3062":120128},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3607":72551,"_31098":72543,"_5":31454,"_21528":120130,"_28279":120131,"_3062":120132},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3607":72552,"_31098":72543,"_5":31454,"_21528":120134,"_28279":120135,"_3062":120136},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3607":72553,"_31098":72543,"_5":31454,"_21528":120138,"_28279":120139,"_3062":120140},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3607":72554,"_31098":72543,"_5":31454,"_21528":120142,"_28279":120143,"_3062":120144},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3607":72555,"_31098":72543,"_5":31454,"_21528":120146,"_28279":120147,"_3062":120148},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3607":72556,"_31098":72543,"_21528":120150,"_5":14794,"_28279":120107,"_3062":120151},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3607":72557,"_31098":72543,"_21528":120153,"_5":14794,"_28279":120107,"_3062":120154},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3607":72558,"_31098":72543,"_21528":120156,"_5":14794,"_28279":120111,"_3062":120157},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3607":72559,"_31098":72543,"_21528":120159,"_5":14794,"_28279":120111,"_3062":120160},[],"Fastlane instala o configura",{"_3607":72560,"_31098":72543,"_21528":120162,"_5":14794,"_28279":120111,"_3062":120163},[],"Tú sigues proporcionando",{"_3607":72561,"_31098":72543,"_21528":120165,"_5":14794,"_28279":120111,"_3062":120166},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3607":72562,"_31098":72543,"_21528":120168,"_5":14794,"_28279":120111,"_3062":120169},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3607":72563,"_31098":72543,"_21528":120171,"_5":14794,"_28279":120111,"_3062":120172},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3607":72564,"_31098":72543,"_21528":120174,"_5":14794,"_28279":120111,"_3062":120175},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3607":72565,"_31098":72543,"_21528":120177,"_5":14794,"_28279":120111,"_3062":120178},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3607":72566,"_31098":72543,"_21528":120180,"_5":14794,"_28279":120111,"_3062":120181},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3607":72567,"_31098":72543,"_21528":120183,"_5":14794,"_28279":120111,"_3062":120184},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3607":72568,"_31098":72543,"_21528":120186,"_5":14794,"_28279":120111,"_3062":120187},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3607":72569,"_31098":72543,"_21528":120189,"_5":14794,"_28279":120111,"_3062":120190},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3607":72570,"_31098":72543,"_21528":120192,"_5":14794,"_28279":120115,"_3062":120193},[],"Necesitas:",{"_3607":72571,"_31098":72543,"_21528":120195,"_5":14794,"_28279":120115,"_3062":120196},[],"un clúster Kubernetes existente",{"_3607":72572,"_31098":72543,"_21528":120198,"_5":14794,"_28279":120115,"_3062":120199},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3607":72573,"_31098":72543,"_21528":120201,"_5":14794,"_28279":120115,"_3062":51133},[],{"_3607":72574,"_31098":72543,"_21528":120203,"_5":14794,"_28279":120115,"_3062":24334},[],{"_3607":72575,"_31098":72543,"_21528":120205,"_5":14794,"_28279":120115,"_3062":120206},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3607":72576,"_31098":72543,"_21528":120208,"_5":14794,"_28279":120115,"_3062":120209},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3607":72577,"_31098":72543,"_21528":120211,"_5":14794,"_28279":120115,"_3062":120212},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3607":72578,"_31098":72543,"_21528":120214,"_5":14794,"_28279":120115,"_3062":120215},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3607":72579,"_31098":72543,"_21528":120217,"_5":14794,"_28279":120115,"_3062":120218},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3607":72580,"_31098":72543,"_21528":120220,"_5":14794,"_28279":120119,"_3062":120221},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3607":72581,"_31098":72543,"_21528":120223,"_5":14794,"_28279":120119,"_3062":120224},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3607":72582,"_31098":72543,"_21528":120226,"_5":14794,"_28279":120123,"_3062":120227},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3607":72583,"_31098":72543,"_21528":120229,"_5":14794,"_28279":120123,"_3062":120230},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3607":72584,"_31098":72543,"_21528":120232,"_5":14794,"_28279":120123,"_3062":120233},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3607":72585,"_31098":72543,"_21528":120235,"_5":14794,"_28279":120123,"_3062":120236},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3607":72586,"_31098":72543,"_21528":120238,"_5":14794,"_28279":120127,"_3062":120239},[],"Opción",{"_3607":72587,"_31098":72543,"_21528":120241,"_5":14794,"_28279":120127,"_3062":120242},[],"Valor predeterminado",{"_3607":72588,"_31098":72543,"_21528":120244,"_5":14794,"_28279":120127,"_3062":120245},[],"Propósito",{"_3607":72589,"_31098":72543,"_21528":120247,"_5":14794,"_28279":120127,"_3062":51180},[],{"_3607":72590,"_31098":72543,"_21528":120249,"_5":14794,"_28279":120127,"_3062":51183},[],{"_3607":72591,"_31098":72543,"_21528":120251,"_5":14794,"_28279":120127,"_3062":120252},[],"Muestra la ayuda",{"_3607":72592,"_31098":72543,"_21528":120254,"_5":14794,"_28279":120127,"_3062":51189},[],{"_3607":72593,"_31098":72543,"_21528":120256,"_5":14794,"_28279":120127,"_3062":120257},[],"contexto actual",{"_3607":72594,"_31098":72543,"_21528":120259,"_5":14794,"_28279":120127,"_3062":120260},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3607":72595,"_31098":72543,"_21528":120262,"_5":14794,"_28279":120127,"_3062":51198},[],{"_3607":72596,"_31098":72543,"_21528":120264,"_5":14794,"_28279":120127,"_3062":6768},[],{"_3607":72597,"_31098":72543,"_21528":120266,"_5":14794,"_28279":120127,"_3062":120267},[],"Omite prompts y genera credenciales para las dependencias",{"_3607":72598,"_31098":72543,"_21528":120269,"_5":14794,"_28279":120127,"_3062":51206},[],{"_3607":72599,"_31098":72543,"_21528":120271,"_5":14794,"_28279":120127,"_3062":51209},[],{"_3607":72600,"_31098":72543,"_21528":120273,"_5":14794,"_28279":120127,"_3062":120274},[],"Namespace de la instalación",{"_3607":72601,"_31098":72543,"_21528":120276,"_5":14794,"_28279":120127,"_3062":51215},[],{"_3607":72602,"_31098":72543,"_21528":120278,"_5":14794,"_28279":120127,"_3062":51218},[],{"_3607":72603,"_31098":72543,"_21528":120280,"_5":14794,"_28279":120127,"_3062":120281},[],"Dominio usado por la UI, OIDC y el certificado",{"_3607":72604,"_31098":72543,"_21528":120283,"_5":14794,"_28279":120127,"_3062":51224},[],{"_3607":72605,"_31098":72543,"_21528":120285,"_5":14794,"_28279":120127,"_3062":15506},[],{"_3607":72606,"_31098":72543,"_21528":120287,"_5":14794,"_28279":120127,"_3062":120288},[],"Versión del chart de Lamassu",{"_3607":72607,"_31098":72543,"_21528":120290,"_5":14794,"_28279":120127,"_3062":51232},[],{"_3607":72608,"_31098":72543,"_21528":120292,"_5":14794,"_28279":120127,"_3062":51235},[],{"_3607":72609,"_31098":72543,"_21528":120294,"_5":14794,"_28279":120127,"_3062":120295},[],"Puerto del listener HTTPS",{"_3607":72610,"_31098":72543,"_21528":120297,"_5":14794,"_28279":120127,"_3062":51241},[],{"_3607":72611,"_31098":72543,"_21528":120299,"_5":14794,"_28279":120127,"_3062":51244},[],{"_3607":72612,"_31098":72543,"_21528":120301,"_5":14794,"_28279":120127,"_3062":120302},[],"Puerto del listener HTTP",{"_3607":72613,"_31098":72543,"_21528":120304,"_5":14794,"_28279":120127,"_3062":51250},[],{"_3607":72614,"_31098":72543,"_21528":120306,"_5":14794,"_28279":120127,"_3062":51183},[],{"_3607":72615,"_31098":72543,"_21528":120308,"_5":14794,"_28279":120127,"_3062":120309},[],"Certificado PEM para TLS downstream",{"_3607":72616,"_31098":72543,"_21528":120311,"_5":14794,"_28279":120127,"_3062":51258},[],{"_3607":72617,"_31098":72543,"_21528":120313,"_5":14794,"_28279":120127,"_3062":51183},[],{"_3607":72618,"_31098":72543,"_21528":120315,"_5":14794,"_28279":120127,"_3062":120316},[],"Clave privada PEM para TLS downstream",{"_3607":72619,"_31098":72543,"_21528":120318,"_5":14794,"_28279":120127,"_3062":51266},[],{"_3607":72620,"_31098":72543,"_21528":120320,"_5":14794,"_28279":120127,"_3062":120321},[],"chart del repositorio",{"_3607":72621,"_31098":72543,"_21528":120323,"_5":14794,"_28279":120127,"_3062":120324},[],"Usa un chart local de Lamassu sin empaquetar",{"_3607":72622,"_31098":72543,"_21528":120326,"_5":14794,"_28279":120127,"_3062":51275},[],{"_3607":72623,"_31098":72543,"_21528":120328,"_5":14794,"_28279":120127,"_3062":120329},[],"detección automática",{"_3607":72624,"_31098":72543,"_21528":120331,"_5":14794,"_28279":120127,"_3062":120332},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3607":72625,"_31098":72543,"_21528":120334,"_5":14794,"_28279":120127,"_3062":51283},[],{"_3607":72626,"_31098":72543,"_21528":120336,"_5":14794,"_28279":120127,"_3062":6768},[],{"_3607":72627,"_31098":72543,"_21528":120338,"_5":14794,"_28279":120127,"_3062":120339},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3607":72628,"_31098":72543,"_21528":120341,"_5":14794,"_28279":120127,"_3062":51291},[],{"_3607":72629,"_31098":72543,"_21528":120343,"_5":14794,"_28279":120127,"_3062":6768},[],{"_3607":72630,"_31098":72543,"_21528":120345,"_5":14794,"_28279":120127,"_3062":120346},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3607":72631,"_31098":72543,"_21528":120348,"_5":14794,"_28279":120127,"_3062":51299},[],{"_3607":72632,"_31098":72543,"_21528":120350,"_5":14794,"_28279":120127,"_3062":6768},[],{"_3607":72633,"_31098":72543,"_21528":120352,"_5":14794,"_28279":120127,"_3062":120353},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3607":72634,"_31098":72543,"_21528":120355,"_5":14794,"_28279":120127,"_3062":51307},[],{"_3607":72635,"_31098":72543,"_21528":120357,"_5":14794,"_28279":120127,"_3062":6768},[],{"_3607":72636,"_31098":72543,"_21528":120359,"_5":14794,"_28279":120127,"_3062":120360},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3607":72637,"_31098":72543,"_21528":120362,"_5":14794,"_28279":120127,"_3062":51315},[],{"_3607":72638,"_31098":72543,"_21528":120364,"_5":14794,"_28279":120127,"_3062":51318},[],{"_3607":72639,"_31098":72543,"_21528":120366,"_5":14794,"_28279":120127,"_3062":120367},[],"Usa otro chart local de SoftHSM",{"_3607":72640,"_31098":72543,"_21528":120369,"_5":14794,"_28279":120127,"_3062":120370},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3607":72641,"_31098":72543,"_21528":120372,"_5":14794,"_28279":120131,"_3062":120373},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3607":72642,"_31098":72543,"_21528":120375,"_5":14794,"_28279":120131,"_3062":120376},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3607":72643,"_31098":72543,"_21528":120378,"_5":14794,"_28279":120131,"_3062":120379},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3607":72644,"_31098":72543,"_21528":120381,"_5":14794,"_28279":120131,"_3062":120382},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3607":72645,"_31098":72543,"_21528":120384,"_5":14794,"_28279":120131,"_3062":120385},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3607":72646,"_31098":72543,"_21528":120387,"_5":14794,"_28279":120131,"_3062":120388},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3607":72647,"_31098":72543,"_21528":120390,"_5":14794,"_28279":120135,"_3062":51345},[],{"_3607":72648,"_31098":72543,"_21528":120392,"_5":14794,"_28279":120135,"_3062":120393},[],"valida las herramientas locales y el clúster seleccionado",{"_3607":72649,"_31098":72543,"_21528":120395,"_5":14794,"_28279":120135,"_3062":120396},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3607":72650,"_31098":72543,"_21528":120398,"_5":14794,"_28279":120135,"_3062":120399},[],"crea el namespace",{"_3607":72651,"_31098":72543,"_21528":120401,"_5":14794,"_28279":120135,"_3062":120402},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3607":72652,"_31098":72543,"_21528":120404,"_5":14794,"_28279":120135,"_3062":120405},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3607":72653,"_31098":72543,"_21528":120407,"_5":14794,"_28279":120135,"_3062":120408},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3607":72654,"_31098":72543,"_21528":120410,"_5":14794,"_28279":120135,"_3062":120411},[],"instala RabbitMQ",{"_3607":72655,"_31098":72543,"_21528":120413,"_5":14794,"_28279":120135,"_3062":120414},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3607":72656,"_31098":72543,"_21528":120416,"_5":14794,"_28279":120135,"_3062":120417},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3607":72657,"_31098":72543,"_21528":120419,"_5":14794,"_28279":120135,"_3062":120420},[],"carga datos de ejemplo opcionalmente",{"_3607":72658,"_31098":72543,"_21528":120422,"_5":14794,"_28279":120135,"_3062":120423},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3607":72659,"_31098":72543,"_21528":120425,"_5":14794,"_28279":120139,"_3062":120426},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3607":72660,"_31098":72543,"_21528":120428,"_5":14794,"_28279":120139,"_3062":120429},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3607":72661,"_31098":72543,"_21528":120431,"_5":14794,"_28279":120143,"_3062":120432},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3607":72662,"_31098":72543,"_21528":120434,"_5":14794,"_28279":120143,"_3062":120435},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3607":72663,"_31098":72543,"_21528":120437,"_5":14794,"_28279":120143,"_3062":120438},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3607":72664,"_31098":72543,"_21528":120440,"_5":14794,"_28279":120143,"_3062":120441},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3607":72665,"_31098":72543,"_21528":120443,"_5":14794,"_28279":120147,"_3062":120444},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3607":72666,"_31098":72666,"_5":15159,"_3062":120446,"_31457":120447,"_21528":120448,"_28279":72666},"Instala con Helm",[50787,119866,120100],[],{"_3607":72667,"_31098":72666,"_21528":120450,"_5":14794,"_28279":72666,"_3062":120451},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3607":72668,"_31098":72666,"_5":31454,"_21528":120453,"_28279":120454,"_3062":120455},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3607":72669,"_31098":72666,"_5":31454,"_21528":120457,"_28279":120458,"_3062":120116},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3607":72670,"_31098":72666,"_5":31454,"_21528":120460,"_28279":120461,"_3062":120462},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3607":72671,"_31098":72666,"_5":31454,"_21528":120464,"_28279":120465,"_3062":120466},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3607":72672,"_31098":72666,"_5":31454,"_21528":120468,"_28279":120469,"_3062":120470},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3607":72673,"_31098":72666,"_5":31454,"_21528":120472,"_28279":120473,"_3062":120474},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3607":72674,"_31098":72666,"_5":31454,"_21528":120476,"_28279":120477,"_3062":120478},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3607":72675,"_31098":72666,"_5":31454,"_21528":120480,"_28279":120481,"_3062":120482},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3607":72676,"_31098":72666,"_5":31454,"_21528":120484,"_28279":120485,"_3062":120486},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3607":72677,"_31098":72666,"_5":31454,"_21528":120488,"_28279":120489,"_3062":120490},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3607":72678,"_31098":72666,"_5":31454,"_21528":120492,"_28279":120493,"_3062":120494},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3607":72679,"_31098":72666,"_5":31454,"_21528":120496,"_28279":120497,"_3062":120498},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3607":72680,"_31098":72666,"_21528":120500,"_5":14794,"_28279":120454,"_3062":120501},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3607":72681,"_31098":72666,"_21528":120503,"_5":14794,"_28279":120458,"_3062":120504},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3607":72682,"_31098":72666,"_21528":120506,"_5":14794,"_28279":120458,"_3062":120507},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3607":72683,"_31098":72666,"_21528":120509,"_5":14794,"_28279":120458,"_3062":120510},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3607":72684,"_31098":72666,"_21528":120512,"_5":14794,"_28279":120458,"_3062":120513},[],"un broker RabbitMQ accesible y sus credenciales",{"_3607":72685,"_31098":72666,"_21528":120515,"_5":14794,"_28279":120458,"_3062":120516},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3607":72686,"_31098":72666,"_21528":120518,"_5":14794,"_28279":120458,"_3062":120519},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3607":72687,"_31098":72666,"_21528":120521,"_5":14794,"_28279":120458,"_3062":120522},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3607":72688,"_31098":72666,"_21528":120524,"_5":14794,"_28279":120458,"_3062":120525},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3607":72689,"_31098":72666,"_21528":120527,"_5":14794,"_28279":120458,"_3062":120528},[],"una StorageClass y un diseño de tráfico externo",{"_3607":72690,"_31098":72666,"_21528":120530,"_5":14794,"_28279":120458,"_3062":120531},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3607":72691,"_31098":72666,"_21528":120533,"_5":14794,"_28279":120458,"_3062":120534},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3607":72692,"_31098":72666,"_21528":120536,"_5":14794,"_28279":120458,"_3062":120537},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3607":72693,"_31098":72666,"_21528":120539,"_5":14794,"_28279":120461,"_3062":120540},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3607":72694,"_31098":72666,"_21528":120542,"_5":14794,"_28279":120461,"_3062":120543},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3607":72695,"_31098":72666,"_21528":120545,"_5":14794,"_28279":120461,"_3062":120546},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3607":72696,"_31098":72666,"_21528":120548,"_5":14794,"_28279":120465,"_3062":120549},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3607":72697,"_31098":72666,"_21528":120551,"_5":14794,"_28279":120465,"_3062":120552},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3607":72698,"_31098":72666,"_21528":120554,"_5":14794,"_28279":120465,"_3062":120555},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3607":72699,"_31098":72666,"_21528":120557,"_5":14794,"_28279":120465,"_3062":120558},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3607":72700,"_31098":72666,"_21528":120560,"_5":14794,"_28279":120469,"_3062":120561},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3607":72701,"_31098":72666,"_21528":120563,"_5":14794,"_28279":120469,"_3062":120564},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3607":72702,"_31098":72666,"_21528":120566,"_5":14794,"_28279":120469,"_3062":120567},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3607":72703,"_31098":72666,"_21528":120569,"_5":14794,"_28279":120469,"_3062":120570},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3607":72704,"_31098":72666,"_21528":120572,"_5":14794,"_28279":120469,"_3062":120573},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3607":72705,"_31098":72666,"_21528":120575,"_5":14794,"_28279":120469,"_3062":120576},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3607":72706,"_31098":72666,"_21528":120578,"_5":14794,"_28279":120469,"_3062":120579},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3607":72707,"_31098":72666,"_21528":120581,"_5":14794,"_28279":120469,"_3062":120582},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3607":72708,"_31098":72666,"_21528":120584,"_5":14794,"_28279":120473,"_3062":120585},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3607":72709,"_31098":72666,"_21528":120587,"_5":14794,"_28279":120477,"_3062":120588},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3607":72710,"_31098":72666,"_21528":120590,"_5":14794,"_28279":120477,"_3062":120591},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3607":72711,"_31098":72666,"_21528":120593,"_5":14794,"_28279":120477,"_3062":120594},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3607":72712,"_31098":72666,"_21528":120596,"_5":14794,"_28279":120477,"_3062":120597},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3607":72713,"_31098":72666,"_21528":120599,"_5":14794,"_28279":120477,"_3062":120600},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3607":72714,"_31098":72666,"_21528":120602,"_5":14794,"_28279":120477,"_3062":120603},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3607":72715,"_31098":72666,"_21528":120605,"_5":14794,"_28279":120477,"_3062":120606},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3607":72716,"_31098":72666,"_21528":120608,"_5":14794,"_28279":120481,"_3062":120609},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3607":72717,"_31098":72666,"_21528":120611,"_5":14794,"_28279":120481,"_3062":120612},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3607":72718,"_31098":72666,"_21528":120614,"_5":14794,"_28279":120481,"_3062":120615},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3607":72719,"_31098":72666,"_21528":120617,"_5":14794,"_28279":120481,"_3062":120618},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3607":72720,"_31098":72666,"_21528":120620,"_5":14794,"_28279":120485,"_3062":120621},[],"Para instalar un checkout local:",{"_3607":72721,"_31098":72666,"_21528":120623,"_5":14794,"_28279":120489,"_3062":120624},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3607":72722,"_31098":72666,"_21528":120626,"_5":14794,"_28279":120489,"_3062":120627},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3607":72723,"_31098":72666,"_21528":120629,"_5":14794,"_28279":120493,"_3062":120630},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3607":72724,"_31098":72666,"_21528":120632,"_5":14794,"_28279":120493,"_3062":120633},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3607":72725,"_31098":72666,"_21528":120635,"_5":14794,"_28279":120493,"_3062":120636},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3607":72726,"_31098":72666,"_21528":120638,"_5":14794,"_28279":120493,"_3062":120639},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3607":72727,"_31098":72666,"_21528":120641,"_5":14794,"_28279":120493,"_3062":120642},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3607":72728,"_31098":72666,"_21528":120644,"_5":14794,"_28279":120497,"_3062":120645},[],"Antes de pasar a producción, revisa:",{"_3607":72729,"_31098":72666,"_21528":120647,"_5":14794,"_28279":120497,"_3062":120648},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3607":72730,"_31098":72666,"_21528":120650,"_5":14794,"_28279":120497,"_3062":120651},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3607":72731,"_31098":72666,"_21528":120653,"_5":14794,"_28279":120497,"_3062":120654},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3607":72732,"_31098":72666,"_21528":120656,"_5":14794,"_28279":120497,"_3062":120657},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3607":72733,"_31098":72666,"_21528":120659,"_5":14794,"_28279":120497,"_3062":120660},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3607":72734,"_31098":72666,"_21528":120662,"_5":14794,"_28279":120497,"_3062":120663},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3607":72735,"_31098":72666,"_21528":120665,"_5":14794,"_28279":120497,"_3062":120666},[],"SMTP, observabilidad y entrega de alertas",{"_3607":72736,"_31098":72666,"_21528":120668,"_5":14794,"_28279":120497,"_3062":120669},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3607":72737,"_31098":72666,"_21528":120671,"_5":14794,"_28279":120497,"_3062":120672},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3607":72738,"_31098":72738,"_5":15159,"_3062":120674,"_31457":120675,"_21528":120676,"_28279":72738},"Expón el Gateway",[50787,119866,120100],[],{"_3607":72739,"_31098":72738,"_21528":120678,"_5":14794,"_28279":72738,"_3062":120679},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3607":72740,"_31098":72738,"_5":31454,"_21528":120681,"_28279":120682,"_3062":120683},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3607":72741,"_31098":72738,"_5":31454,"_21528":120685,"_28279":120686,"_3062":120687},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3607":72742,"_31098":72738,"_5":31454,"_21528":120689,"_28279":120690,"_3062":120691},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3607":72743,"_31098":72738,"_5":31454,"_21528":120693,"_28279":120694,"_3062":51650},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#k3s",{"_3607":72744,"_31098":72738,"_5":31454,"_21528":120696,"_28279":120697,"_3062":120698},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3607":72745,"_31098":72738,"_5":31454,"_21528":120700,"_28279":120701,"_3062":120702},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3607":72746,"_31098":72738,"_5":31454,"_21528":120704,"_28279":120705,"_3062":120706},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3607":72747,"_31098":72738,"_5":31454,"_21528":120708,"_28279":120709,"_3062":120710},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3607":72748,"_31098":72738,"_5":31454,"_21528":120712,"_28279":120713,"_3062":120714},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3607":72749,"_31098":72738,"_5":31454,"_21528":120716,"_28279":120717,"_3062":120718},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3607":72750,"_31098":72738,"_5":31454,"_21528":120720,"_28279":120721,"_3062":120722},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3607":72751,"_31098":72738,"_21528":120724,"_5":14794,"_28279":120682,"_3062":120725},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3607":72752,"_31098":72738,"_21528":120727,"_5":14794,"_28279":120682,"_3062":120728},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3607":72753,"_31098":72738,"_21528":120730,"_5":14794,"_28279":120686,"_3062":120731},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3607":72754,"_31098":72738,"_21528":120733,"_5":14794,"_28279":120686,"_3062":120734},[],"Defínelo únicamente cuando:",{"_3607":72755,"_31098":72738,"_21528":120736,"_5":14794,"_28279":120686,"_3062":120737},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3607":72756,"_31098":72738,"_21528":120739,"_5":14794,"_28279":120686,"_3062":120740},[],"esa dirección está asignada a este Gateway",{"_3607":72757,"_31098":72738,"_21528":120742,"_5":14794,"_28279":120686,"_3062":120743},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3607":72758,"_31098":72738,"_21528":120745,"_5":14794,"_28279":120686,"_3062":120746},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3607":72759,"_31098":72738,"_21528":120748,"_5":14794,"_28279":120686,"_3062":120749},[],"No confundas estos valores:",{"_3607":72760,"_31098":72738,"_21528":120751,"_5":14794,"_28279":120686,"_3062":120752},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3607":72761,"_31098":72738,"_21528":120754,"_5":14794,"_28279":120686,"_3062":120755},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3607":72762,"_31098":72738,"_21528":120757,"_5":14794,"_28279":120686,"_3062":120758},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3607":72763,"_31098":72738,"_21528":120760,"_5":14794,"_28279":120690,"_3062":120761},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3607":72764,"_31098":72738,"_21528":120763,"_5":14794,"_28279":120690,"_3062":120764},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3607":72765,"_31098":72738,"_21528":120766,"_5":14794,"_28279":120694,"_3062":120767},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3607":72766,"_31098":72738,"_21528":120769,"_5":14794,"_28279":120694,"_3062":120770},[],"Para el diseño recomendado:",{"_3607":72767,"_31098":72738,"_21528":120772,"_5":14794,"_28279":120694,"_3062":120773},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3607":72768,"_31098":72738,"_21528":120775,"_5":14794,"_28279":120694,"_3062":120776},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3607":72769,"_31098":72738,"_21528":120778,"_5":14794,"_28279":120694,"_3062":120779},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3607":72770,"_31098":72738,"_21528":120781,"_5":14794,"_28279":120694,"_3062":120782},[],"Apunta DNS a la dirección accesible de la VM.",{"_3607":72771,"_31098":72738,"_21528":120784,"_5":14794,"_28279":120694,"_3062":120785},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3607":72772,"_31098":72738,"_21528":120787,"_5":14794,"_28279":120697,"_3062":120788},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3607":72773,"_31098":72738,"_21528":120790,"_5":14794,"_28279":120701,"_3062":120791},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3607":72774,"_31098":72738,"_21528":120793,"_5":14794,"_28279":120701,"_3062":120794},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3607":72775,"_31098":72738,"_21528":120796,"_5":14794,"_28279":120705,"_3062":120797},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3607":72776,"_31098":72738,"_21528":120799,"_5":14794,"_28279":120705,"_3062":120800},[],"Requisito",{"_3607":72777,"_31098":72738,"_21528":120802,"_5":14794,"_28279":120705,"_3062":120803},[],"Diseño recomendado",{"_3607":72778,"_31098":72738,"_21528":120805,"_5":14794,"_28279":120705,"_3062":120806},[],"Consecuencia",{"_3607":72779,"_31098":72738,"_21528":120808,"_5":14794,"_28279":120705,"_3062":120809},[],"Varias URL o servicios de Lamassu",{"_3607":72780,"_31098":72738,"_21528":120811,"_5":14794,"_28279":120705,"_3062":120812},[],"Un Gateway con varias rutas",{"_3607":72781,"_31098":72738,"_21528":120814,"_5":14794,"_28279":120705,"_3062":120815},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3607":72782,"_31098":72738,"_21528":120817,"_5":14794,"_28279":120705,"_3062":120818},[],"Gateways independientes e IP externas distintas",{"_3607":72783,"_31098":72738,"_21528":120820,"_5":14794,"_28279":120705,"_3062":120821},[],"Una VIP por Gateway",{"_3607":72784,"_31098":72738,"_21528":120823,"_5":14794,"_28279":120705,"_3062":120824},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3607":72785,"_31098":72738,"_21528":120826,"_5":14794,"_28279":120705,"_3062":120827},[],"Gateways independientes, un nodo y una IP",{"_3607":72786,"_31098":72738,"_21528":120829,"_5":14794,"_28279":120705,"_3062":120830},[],"Puertos externos diferentes",{"_3607":72787,"_31098":72738,"_21528":120832,"_5":14794,"_28279":120705,"_3062":120833},[],"Los clientes deben indicar puertos no estándar",{"_3607":72788,"_31098":72738,"_21528":120835,"_5":14794,"_28279":120705,"_3062":120836},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3607":72789,"_31098":72738,"_21528":120838,"_5":14794,"_28279":120705,"_3062":120839},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3607":72790,"_31098":72738,"_21528":120841,"_5":14794,"_28279":120705,"_3062":120842},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3607":72791,"_31098":72738,"_21528":120844,"_5":14794,"_28279":120705,"_3062":120845},[],"Recursos Gateway separados pero proxy compartido",{"_3607":72792,"_31098":72738,"_21528":120847,"_5":14794,"_28279":120705,"_3062":120848},[],"Modo merged Gateway de Envoy",{"_3607":72793,"_31098":72738,"_21528":120850,"_5":14794,"_28279":120705,"_3062":120851},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3607":72794,"_31098":72738,"_21528":120853,"_5":14794,"_28279":120705,"_3062":120854},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3607":72795,"_31098":72738,"_21528":120856,"_5":14794,"_28279":120705,"_3062":120857},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3607":72796,"_31098":72738,"_21528":120859,"_5":14794,"_28279":120705,"_3062":120860},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3607":72797,"_31098":72738,"_21528":120862,"_5":14794,"_28279":120705,"_3062":120863},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3607":72798,"_31098":72738,"_21528":120865,"_5":14794,"_28279":120709,"_3062":120866},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3607":72799,"_31098":72738,"_21528":120868,"_5":14794,"_28279":120713,"_3062":120869},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3607":72800,"_31098":72738,"_21528":120871,"_5":14794,"_28279":120713,"_3062":120872},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3607":72801,"_31098":72738,"_21528":120874,"_5":14794,"_28279":120713,"_3062":120875},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3607":72802,"_31098":72738,"_21528":120877,"_5":14794,"_28279":120713,"_3062":120878},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3607":72803,"_31098":72738,"_21528":120880,"_5":14794,"_28279":120713,"_3062":120881},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3607":72804,"_31098":72738,"_21528":120883,"_5":14794,"_28279":120717,"_3062":120884},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3607":72805,"_31098":72738,"_21528":120886,"_5":14794,"_28279":120717,"_3062":120887},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3607":72806,"_31098":72738,"_21528":120889,"_5":14794,"_28279":120721,"_3062":120890},[],"Comprueba, en orden:",{"_3607":72807,"_31098":72738,"_21528":120892,"_5":14794,"_28279":120721,"_3062":120893},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3607":72808,"_31098":72738,"_21528":120895,"_5":14794,"_28279":120721,"_3062":120896},[],"Su estado contiene la dirección esperada.",{"_3607":72809,"_31098":72738,"_21528":120898,"_5":14794,"_28279":120721,"_3062":120899},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3607":72810,"_31098":72738,"_21528":120901,"_5":14794,"_28279":120721,"_3062":120902},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3607":72811,"_31098":72738,"_21528":120904,"_5":14794,"_28279":120721,"_3062":120905},[],"DNS resuelve al endpoint accesible externamente.",{"_3607":72812,"_31098":72738,"_21528":120907,"_5":14794,"_28279":120721,"_3062":120908},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3607":72813,"_31098":72738,"_21528":120910,"_5":14794,"_28279":120721,"_3062":120911},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3607":72814,"_31098":72814,"_5":15159,"_3062":50894,"_31457":120913,"_21528":120914,"_28279":72814},[50787,119866,120100],[],{"_3607":72815,"_31098":72814,"_21528":120916,"_5":14794,"_28279":72814,"_3062":120917},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3607":72816,"_31098":72814,"_5":31454,"_21528":120919,"_28279":120920,"_3062":120921},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3607":72817,"_31098":72814,"_5":31454,"_21528":120923,"_28279":120924,"_3062":120925},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3607":72818,"_31098":72814,"_5":31454,"_21528":120927,"_28279":120928,"_3062":120929},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3607":72819,"_31098":72814,"_5":31454,"_21528":120931,"_28279":120932,"_3062":120933},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3607":72820,"_31098":72814,"_5":31454,"_21528":120935,"_28279":120936,"_3062":120937},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3607":72821,"_31098":72814,"_5":31454,"_21528":120939,"_28279":120940,"_3062":120941},[],"/docs/pr-preview/pr-75/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3607":72822,"_31098":72814,"_21528":120943,"_5":14794,"_28279":120920,"_3062":120944},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3607":72823,"_31098":72814,"_21528":120946,"_5":14794,"_28279":120924,"_3062":120947},[],"Flujo",{"_3607":72824,"_31098":72814,"_21528":120949,"_5":14794,"_28279":120924,"_3062":120950},[],"Úsalo para",{"_3607":72825,"_31098":72814,"_21528":120952,"_5":14794,"_28279":120924,"_3062":120953},[],"Qué instala",{"_3607":72826,"_31098":72814,"_21528":120955,"_5":14794,"_28279":120924,"_3062":51912},[],{"_3607":72827,"_31098":72814,"_21528":120957,"_5":14794,"_28279":120924,"_3062":120958},[],"Producción y entornos controlados",{"_3607":72828,"_31098":72814,"_21528":120960,"_5":14794,"_28279":120924,"_3062":120961},[],"Servicios de Lamassu y recursos de Gateway API",{"_3607":72829,"_31098":72814,"_21528":120963,"_5":14794,"_28279":120924,"_3062":51031},[],{"_3607":72830,"_31098":72814,"_21528":120965,"_5":14794,"_28279":120924,"_3062":120966},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3607":72831,"_31098":72814,"_21528":120968,"_5":14794,"_28279":120924,"_3062":120969},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3607":72832,"_31098":72814,"_21528":120971,"_5":14794,"_28279":120928,"_3062":120972},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3607":72833,"_31098":72814,"_21528":120974,"_5":14794,"_28279":120928,"_3062":120975},[],"Área",{"_3607":72834,"_31098":72814,"_21528":120977,"_5":14794,"_28279":120928,"_3062":120978},[],"El chart de Lamassu proporciona",{"_3607":72835,"_31098":72814,"_21528":120980,"_5":14794,"_28279":120928,"_3062":120981},[],"Tú proporcionas",{"_3607":72836,"_31098":72814,"_21528":120983,"_5":14794,"_28279":120928,"_3062":120984},[],"Aplicaciones Lamassu",{"_3607":72837,"_31098":72814,"_21528":120986,"_5":14794,"_28279":120928,"_3062":120987},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3607":72838,"_31098":72814,"_21528":120989,"_5":14794,"_28279":120928,"_3062":120990},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3607":72839,"_31098":72814,"_21528":120992,"_5":14794,"_28279":120928,"_3062":120993},[],"Datos PostgreSQL",{"_3607":72840,"_31098":72814,"_21528":120995,"_5":14794,"_28279":120928,"_3062":120996},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3607":72841,"_31098":72814,"_21528":120998,"_5":14794,"_28279":120928,"_3062":120999},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3607":72842,"_31098":72814,"_21528":121001,"_5":14794,"_28279":120928,"_3062":121002},[],"Mensajería",{"_3607":72843,"_31098":72814,"_21528":121004,"_5":14794,"_28279":120928,"_3062":121005},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3607":72844,"_31098":72814,"_21528":121007,"_5":14794,"_28279":120928,"_3062":121008},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3607":72845,"_31098":72814,"_21528":121010,"_5":14794,"_28279":120928,"_3062":121011},[],"Identidad",{"_3607":72846,"_31098":72814,"_21528":121013,"_5":14794,"_28279":120928,"_3062":121014},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3607":72847,"_31098":72814,"_21528":121016,"_5":14794,"_28279":120928,"_3062":121017},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3607":72848,"_31098":72814,"_21528":121019,"_5":14794,"_28279":120928,"_3062":121020},[],"Enrutamiento externo",{"_3607":72849,"_31098":72814,"_21528":121022,"_5":14794,"_28279":120928,"_3062":121023},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3607":72850,"_31098":72814,"_21528":121025,"_5":14794,"_28279":120928,"_3062":121026},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3607":72851,"_31098":72814,"_21528":121028,"_5":14794,"_28279":120928,"_3062":51986},[],{"_3607":72852,"_31098":72814,"_21528":121030,"_5":14794,"_28279":120928,"_3062":121031},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3607":72853,"_31098":72814,"_21528":121033,"_5":14794,"_28279":120928,"_3062":121034},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3607":72854,"_31098":72814,"_21528":121036,"_5":14794,"_28279":120928,"_3062":121037},[],"Datos persistentes de la aplicación",{"_3607":72855,"_31098":72814,"_21528":121039,"_5":14794,"_28279":120928,"_3062":121040},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3607":72856,"_31098":72814,"_21528":121042,"_5":14794,"_28279":120928,"_3062":121043},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3607":72857,"_31098":72814,"_21528":121045,"_5":14794,"_28279":120928,"_3062":121046},[],"Integraciones opcionales",{"_3607":72858,"_31098":72814,"_21528":121048,"_5":14794,"_28279":120928,"_3062":121049},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3607":72859,"_31098":72814,"_21528":121051,"_5":14794,"_28279":120928,"_3062":121052},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3607":72860,"_31098":72814,"_21528":121054,"_5":14794,"_28279":120928,"_3062":121055},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3607":72861,"_31098":72814,"_21528":121057,"_5":14794,"_28279":120928,"_3062":121058},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3607":72862,"_31098":72814,"_21528":121060,"_5":14794,"_28279":120932,"_3062":121061},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3607":72863,"_31098":72814,"_21528":121063,"_5":14794,"_28279":120932,"_3062":121064},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3607":72864,"_31098":72814,"_21528":121066,"_5":14794,"_28279":120936,"_3062":121067},[],"Kubernetes 1.24 o posterior",{"_3607":72865,"_31098":72814,"_21528":121069,"_5":14794,"_28279":120936,"_3062":121070},[],"Helm 3.2 o posterior",{"_3607":72866,"_31098":72814,"_21528":121072,"_5":14794,"_28279":120936,"_3062":121073},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3607":72867,"_31098":72814,"_21528":121075,"_5":14794,"_28279":120936,"_3062":121076},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3607":72868,"_31098":72814,"_21528":121078,"_5":14794,"_28279":120936,"_3062":121079},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3607":72869,"_31098":72814,"_21528":121081,"_5":14794,"_28279":120936,"_3062":121082},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3607":72870,"_31098":72814,"_21528":121084,"_5":14794,"_28279":120936,"_3062":121085},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3607":72871,"_31098":72814,"_21528":121087,"_5":14794,"_28279":120940,"_3062":121088},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3607":72872,"_31098":72814,"_21528":121090,"_5":14794,"_28279":120940,"_3062":121091},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3607":72873,"_31098":72814,"_21528":121093,"_5":14794,"_28279":120940,"_3062":121094},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3607":72874,"_31098":72814,"_21528":121096,"_5":14794,"_28279":120940,"_3062":121097},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3607":72875,"_31098":72875,"_5":15159,"_3062":121099,"_31457":121100,"_21528":121102,"_28279":72875},"Resolución de problemas de despliegue",[50787,119866,121101],"Operación",[],{"_3607":72876,"_31098":72875,"_21528":121104,"_5":14794,"_28279":72875,"_3062":121105},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3607":72877,"_31098":72875,"_5":31454,"_21528":121107,"_28279":121108,"_3062":121109},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3607":72878,"_31098":72875,"_5":31454,"_21528":121111,"_28279":121112,"_3062":121113},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3607":72879,"_31098":72875,"_5":31454,"_21528":121115,"_28279":121116,"_3062":121117},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3607":72880,"_31098":72875,"_5":31454,"_21528":121119,"_28279":121120,"_3062":121121},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3607":72881,"_31098":72875,"_5":31454,"_21528":121123,"_28279":121124,"_3062":121125},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3607":72882,"_31098":72875,"_5":31454,"_21528":121127,"_28279":121128,"_3062":121129},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3607":72883,"_31098":72875,"_5":31454,"_21528":121131,"_28279":121132,"_3062":121133},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3607":72884,"_31098":72875,"_5":31454,"_21528":121135,"_28279":121136,"_3062":121137},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3607":72885,"_31098":72875,"_5":31454,"_21528":121139,"_28279":121140,"_3062":121141},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3607":72886,"_31098":72875,"_5":31454,"_21528":121143,"_28279":121144,"_3062":121145},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3607":72887,"_31098":72875,"_5":31454,"_21528":121147,"_28279":121148,"_3062":121149},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3607":72888,"_31098":72875,"_5":31454,"_21528":121151,"_28279":121152,"_3062":121153},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3607":72889,"_31098":72875,"_5":31454,"_21528":121155,"_28279":121156,"_3062":121157},[],"/docs/pr-preview/pr-75/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3607":72890,"_31098":72875,"_21528":121159,"_5":14794,"_28279":72875,"_3062":121160},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3607":72891,"_31098":72875,"_21528":121162,"_5":14794,"_28279":121112,"_3062":121163},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3607":72892,"_31098":72875,"_21528":121165,"_5":14794,"_28279":121116,"_3062":121166},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3607":72893,"_31098":72875,"_21528":121168,"_5":14794,"_28279":121120,"_3062":121169},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3607":72894,"_31098":72875,"_21528":121171,"_5":14794,"_28279":121124,"_3062":121172},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3607":72895,"_31098":72875,"_21528":121174,"_5":14794,"_28279":121128,"_3062":121175},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3607":72896,"_31098":72875,"_21528":121177,"_5":14794,"_28279":121132,"_3062":121178},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3607":72897,"_31098":72875,"_21528":121180,"_5":14794,"_28279":121132,"_3062":121181},[],"Ejecuta también la prueba de conectividad del chart:",{"_3607":72898,"_31098":72875,"_21528":121183,"_5":14794,"_28279":121132,"_3062":121184},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3607":72899,"_31098":72875,"_21528":121186,"_5":14794,"_28279":121132,"_3062":121187},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3607":72900,"_31098":72875,"_21528":121189,"_5":14794,"_28279":121136,"_3062":121190},[],"Si recibes un 401:",{"_3607":72901,"_31098":72875,"_21528":121192,"_5":14794,"_28279":121136,"_3062":121193},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3607":72902,"_31098":72875,"_21528":121195,"_5":14794,"_28279":121136,"_3062":121196},[],"verifica emisor, audiencia y expiración del token;",{"_3607":72903,"_31098":72875,"_21528":121198,"_5":14794,"_28279":121136,"_3062":121199},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3607":72904,"_31098":72875,"_21528":121201,"_5":14794,"_28279":121136,"_3062":121202},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3607":72905,"_31098":72875,"_21528":121204,"_5":14794,"_28279":121136,"_3062":121205},[],"Si el login termina pero las APIs devuelven 403:",{"_3607":72906,"_31098":72875,"_21528":121207,"_5":14794,"_28279":121136,"_3062":121208},[],"inspecciona los claims reales del token;",{"_3607":72907,"_31098":72875,"_21528":121210,"_5":14794,"_28279":121136,"_3062":121211},[],"confirma que coinciden con un principal activo;",{"_3607":72908,"_31098":72875,"_21528":121213,"_5":14794,"_28279":121136,"_3062":121214},[],"revisa las políticas concedidas al principal;",{"_3607":72909,"_31098":72875,"_21528":121216,"_5":14794,"_28279":121136,"_3062":121217},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3607":72910,"_31098":72875,"_21528":121219,"_5":14794,"_28279":121136,"_3062":121220},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3607":72911,"_31098":72875,"_21528":121222,"_5":14794,"_28279":121140,"_3062":121223},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3607":72912,"_31098":72875,"_21528":121225,"_5":14794,"_28279":121140,"_3062":121226},[],"Localiza el pod y Service de authz.",{"_3607":72913,"_31098":72875,"_21528":121228,"_5":14794,"_28279":121140,"_3062":121229},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3607":72914,"_31098":72875,"_21528":121231,"_5":14794,"_28279":121140,"_3062":121232},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3607":72915,"_31098":72875,"_21528":121234,"_5":14794,"_28279":121140,"_3062":121235},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3607":72916,"_31098":72875,"_21528":121237,"_5":14794,"_28279":121140,"_3062":121238},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3607":72917,"_31098":72875,"_21528":121240,"_5":14794,"_28279":121144,"_3062":121241},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3607":72918,"_31098":72875,"_21528":121243,"_5":14794,"_28279":121148,"_3062":121244},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3607":72919,"_31098":72875,"_21528":121246,"_5":14794,"_28279":121148,"_3062":121247},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3607":72920,"_31098":72875,"_21528":121249,"_5":14794,"_28279":121148,"_3062":121250},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3607":72921,"_31098":72875,"_21528":121252,"_5":14794,"_28279":121148,"_3062":121253},[],"volumen persistente sin enlazar;",{"_3607":72922,"_31098":72875,"_21528":121255,"_5":14794,"_28279":121148,"_3062":121256},[],"imagen inaccesible o política de pull incorrecta;",{"_3607":72923,"_31098":72875,"_21528":121258,"_5":14794,"_28279":121148,"_3062":121259},[],"configuración inválida del motor criptográfico;",{"_3607":72924,"_31098":72875,"_21528":121261,"_5":14794,"_28279":121148,"_3062":121262},[],"límites de CPU o memoria demasiado bajos;",{"_3607":72925,"_31098":72875,"_21528":121264,"_5":14794,"_28279":121148,"_3062":121265},[],"migración previa incompleta.",{"_3607":72926,"_31098":72875,"_21528":121267,"_5":14794,"_28279":121148,"_3062":121268},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3607":72927,"_31098":72875,"_21528":121270,"_5":14794,"_28279":121148,"_3062":121271},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3607":72928,"_31098":72875,"_21528":121273,"_5":14794,"_28279":121148,"_3062":121274},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3607":72929,"_31098":72875,"_21528":121276,"_5":14794,"_28279":121152,"_3062":121277},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3607":72930,"_31098":72875,"_21528":121279,"_5":14794,"_28279":121152,"_3062":121280},[],"verifica que esté habilitado en el servicio emisor;",{"_3607":72931,"_31098":72875,"_21528":121282,"_5":14794,"_28279":121152,"_3062":121283},[],"comprueba conectividad y credenciales AMQP;",{"_3607":72932,"_31098":72875,"_21528":121285,"_5":14794,"_28279":121152,"_3062":121286},[],"revisa exchange, routing key, colas y consumidores;",{"_3607":72933,"_31098":72875,"_21528":121288,"_5":14794,"_28279":121152,"_3062":121289},[],"inspecciona dead-letter queues;",{"_3607":72934,"_31098":72875,"_21528":121291,"_5":14794,"_28279":121152,"_3062":121292},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3607":72935,"_31098":72875,"_21528":121294,"_5":14794,"_28279":121152,"_3062":121295},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3607":72936,"_31098":72875,"_21528":121297,"_5":14794,"_28279":121152,"_3062":121298},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3607":72937,"_31098":72875,"_21528":121300,"_5":14794,"_28279":121152,"_3062":121301},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3607":72938,"_31098":72875,"_21528":121303,"_5":14794,"_28279":121152,"_3062":121304},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3607":72939,"_31098":72875,"_21528":121306,"_5":14794,"_28279":121152,"_3062":121307},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3607":72940,"_31098":72875,"_21528":121309,"_5":14794,"_28279":121152,"_3062":121310},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3607":72941,"_31098":72875,"_21528":121312,"_5":14794,"_28279":121152,"_3062":121313},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3607":72942,"_31098":72875,"_21528":121315,"_5":14794,"_28279":121156,"_3062":121316},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3607":72943,"_31098":72875,"_21528":121318,"_5":14794,"_28279":121156,"_3062":121319},[],"Antes de cerrar una incidencia, guarda:",{"_3607":72944,"_31098":72875,"_21528":121321,"_5":14794,"_28279":121156,"_3062":121322},[],"causa confirmada;",{"_3607":72945,"_31098":72875,"_21528":121324,"_5":14794,"_28279":121156,"_3062":121325},[],"alcance temporal y recursos afectados;",{"_3607":72946,"_31098":72875,"_21528":121327,"_5":14794,"_28279":121156,"_3062":121328},[],"comandos o consultas utilizados;",{"_3607":72947,"_31098":72875,"_21528":121330,"_5":14794,"_28279":121156,"_3062":121331},[],"cambio aplicado y forma de revertirlo;",{"_3607":72948,"_31098":72875,"_21528":121333,"_5":14794,"_28279":121156,"_3062":121334},[],"validación desde un consumidor;",{"_3607":72949,"_31098":72875,"_21528":121336,"_5":14794,"_28279":121156,"_3062":121337},[],"acción preventiva y propietario.",{"_3607":72950,"_31098":72950,"_5":15159,"_3062":121339,"_31457":121340,"_21528":121344,"_28279":72950},"Modelo de datos",[50787,121341,121342,121343],"Plataforma","Administración","Control de acceso",[],{"_3607":72951,"_31098":72950,"_21528":121346,"_5":14794,"_28279":72950,"_3062":121347},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3607":72952,"_31098":72950,"_5":31454,"_21528":121349,"_28279":121350,"_3062":121351},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3607":72953,"_31098":72950,"_5":31454,"_21528":121353,"_28279":121354,"_3062":121355},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3607":72954,"_31098":72950,"_21528":121357,"_5":14794,"_28279":72950,"_3062":121358},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3607":72955,"_31098":72950,"_21528":121360,"_5":14794,"_28279":121350,"_3062":121361},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3607":72956,"_31098":72950,"_21528":121363,"_5":14794,"_28279":121350,"_3062":121364},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3607":72957,"_31098":72950,"_21528":121366,"_5":14794,"_28279":121350,"_3062":121367},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3607":72958,"_31098":72950,"_21528":121369,"_5":14794,"_28279":121354,"_3062":121370},[],"Entidad (`schema_name.entity_type`)",{"_3607":72959,"_31098":72950,"_21528":121372,"_5":14794,"_28279":121354,"_3062":121373},[],"Tabla (`table_name`)",{"_3607":72960,"_31098":72950,"_21528":121375,"_5":14794,"_28279":121354,"_3062":121376},[],"Clave (`primary_key`)",{"_3607":72961,"_31098":72950,"_21528":121378,"_5":14794,"_28279":121354,"_3062":52337},[],{"_3607":72962,"_31098":72950,"_21528":121380,"_5":14794,"_28279":121354,"_3062":52340},[],{"_3607":72963,"_31098":72950,"_21528":121382,"_5":14794,"_28279":121354,"_3062":52343},[],{"_3607":72964,"_31098":72950,"_21528":121384,"_5":14794,"_28279":121354,"_3062":52346},[],{"_3607":72965,"_31098":72950,"_21528":121386,"_5":14794,"_28279":121354,"_3062":52349},[],{"_3607":72966,"_31098":72950,"_21528":121388,"_5":14794,"_28279":121354,"_3062":52352},[],{"_3607":72967,"_31098":72950,"_21528":121390,"_5":14794,"_28279":121354,"_3062":52355},[],{"_3607":72968,"_31098":72950,"_21528":121392,"_5":14794,"_28279":121354,"_3062":52358},[],{"_3607":72969,"_31098":72950,"_21528":121394,"_5":14794,"_28279":121354,"_3062":52352},[],{"_3607":72970,"_31098":72950,"_21528":121396,"_5":14794,"_28279":121354,"_3062":52363},[],{"_3607":72971,"_31098":72950,"_21528":121398,"_5":14794,"_28279":121354,"_3062":52366},[],{"_3607":72972,"_31098":72950,"_21528":121400,"_5":14794,"_28279":121354,"_3062":52369},[],{"_3607":72973,"_31098":72950,"_21528":121402,"_5":14794,"_28279":121354,"_3062":52372},[],{"_3607":72974,"_31098":72950,"_21528":121404,"_5":14794,"_28279":121354,"_3062":52375},[],{"_3607":72975,"_31098":72950,"_21528":121406,"_5":14794,"_28279":121354,"_3062":52352},[],{"_3607":72976,"_31098":72950,"_21528":121408,"_5":14794,"_28279":121354,"_3062":52380},[],{"_3607":72977,"_31098":72950,"_21528":121410,"_5":14794,"_28279":121354,"_3062":52383},[],{"_3607":72978,"_31098":72950,"_21528":121412,"_5":14794,"_28279":121354,"_3062":52352},[],{"_3607":72979,"_31098":72950,"_21528":121414,"_5":14794,"_28279":121354,"_3062":52388},[],{"_3607":72980,"_31098":72950,"_21528":121416,"_5":14794,"_28279":121354,"_3062":52391},[],{"_3607":72981,"_31098":72950,"_21528":121418,"_5":14794,"_28279":121354,"_3062":52352},[],{"_3607":72982,"_31098":72950,"_21528":121420,"_5":14794,"_28279":121354,"_3062":52396},[],{"_3607":72983,"_31098":72950,"_21528":121422,"_5":14794,"_28279":121354,"_3062":52399},[],{"_3607":72984,"_31098":72950,"_21528":121424,"_5":14794,"_28279":121354,"_3062":52352},[],{"_3607":72985,"_31098":72950,"_21528":121426,"_5":14794,"_28279":121354,"_3062":52404},[],{"_3607":72986,"_31098":72950,"_21528":121428,"_5":14794,"_28279":121354,"_3062":52407},[],{"_3607":72987,"_31098":72950,"_21528":121430,"_5":14794,"_28279":121354,"_3062":52410},[],{"_3607":72988,"_31098":72950,"_21528":121432,"_5":14794,"_28279":121354,"_3062":52413},[],{"_3607":72989,"_31098":72950,"_21528":121434,"_5":14794,"_28279":121354,"_3062":52416},[],{"_3607":72990,"_31098":72950,"_21528":121436,"_5":14794,"_28279":121354,"_3062":52419},[],{"_3607":72991,"_31098":72950,"_21528":121438,"_5":14794,"_28279":121354,"_3062":121439},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3607":72992,"_31098":72950,"_21528":121441,"_5":14794,"_28279":121354,"_3062":121442},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3607":72993,"_31098":72950,"_21528":121444,"_5":14794,"_28279":121354,"_3062":121445},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3607":72994,"_31098":72994,"_5":15159,"_3062":121447,"_31457":121448,"_21528":121449,"_28279":72994},"Visión general del control de acceso",[50787,121341,121342,121343],[],{"_3607":72995,"_31098":72994,"_21528":121451,"_5":14794,"_28279":72994,"_3062":121452},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3607":72996,"_31098":72994,"_5":31454,"_21528":121454,"_28279":121455,"_3062":121456},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3607":72997,"_31098":72994,"_5":31454,"_21528":121458,"_28279":121459,"_3062":121460},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3607":72998,"_31098":72994,"_5":31454,"_21528":121462,"_28279":121463,"_3062":121464},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3607":72999,"_31098":72994,"_5":31454,"_21528":121466,"_28279":121467,"_3062":121468},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3607":73000,"_31098":72994,"_5":31454,"_21528":121470,"_28279":121471,"_3062":121472},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3607":73001,"_31098":72994,"_5":31454,"_21528":121474,"_28279":121475,"_3062":121476},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3607":73002,"_31098":72994,"_5":31454,"_21528":121478,"_28279":121479,"_3062":121480},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3607":73003,"_31098":72994,"_5":31454,"_21528":121482,"_28279":121483,"_3062":121484},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3607":73004,"_31098":72994,"_5":31454,"_21528":121486,"_28279":121487,"_3062":121488},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3607":73005,"_31098":72994,"_5":31454,"_21528":121490,"_28279":121491,"_3062":121492},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3607":73006,"_31098":72994,"_5":31454,"_21528":121494,"_28279":121495,"_3062":121496},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3607":73007,"_31098":72994,"_5":31454,"_21528":121498,"_28279":121499,"_3062":121500},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3607":73008,"_31098":72994,"_5":31454,"_21528":121502,"_28279":121503,"_3062":121504},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3607":73009,"_31098":72994,"_5":31454,"_21528":121506,"_28279":121507,"_3062":121508},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3607":73010,"_31098":72994,"_5":31454,"_21528":121510,"_28279":121511,"_3062":121512},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3607":73011,"_31098":72994,"_5":31454,"_21528":121514,"_28279":121515,"_3062":120482},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3607":73012,"_31098":72994,"_5":31454,"_21528":121517,"_28279":121518,"_3062":121519},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3607":73013,"_31098":72994,"_5":31454,"_21528":121521,"_28279":121522,"_3062":121523},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3607":73014,"_31098":72994,"_5":31454,"_21528":121525,"_28279":121526,"_3062":121527},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3607":73015,"_31098":72994,"_5":31454,"_21528":121529,"_28279":121530,"_3062":121531},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3607":73016,"_31098":72994,"_5":31454,"_21528":121533,"_28279":121534,"_3062":121535},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3607":73017,"_31098":72994,"_5":31454,"_21528":121537,"_28279":121538,"_3062":121539},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3607":73018,"_31098":72994,"_5":31454,"_21528":121541,"_28279":121542,"_3062":121543},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3607":73019,"_31098":72994,"_5":31454,"_21528":121545,"_28279":121546,"_3062":121547},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3607":73020,"_31098":72994,"_5":31454,"_21528":121549,"_28279":121550,"_3062":121551},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3607":73021,"_31098":72994,"_5":31454,"_21528":121553,"_28279":121554,"_3062":121555},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3607":73022,"_31098":72994,"_5":31454,"_21528":121557,"_28279":121558,"_3062":121559},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3607":73023,"_31098":72994,"_5":31454,"_21528":121561,"_28279":121562,"_3062":121563},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3607":73024,"_31098":72994,"_5":31454,"_21528":121565,"_28279":121566,"_3062":121567},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3607":73025,"_31098":72994,"_5":31454,"_21528":121569,"_28279":121570,"_3062":121571},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3607":73026,"_31098":72994,"_5":31454,"_21528":121573,"_28279":121574,"_3062":121575},[],"/docs/pr-preview/pr-75/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3607":73027,"_31098":72994,"_21528":121577,"_5":14794,"_28279":72994,"_3062":121578},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3607":73028,"_31098":72994,"_21528":121580,"_5":14794,"_28279":72994,"_3062":121581},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3607":73029,"_31098":72994,"_21528":121583,"_5":14794,"_28279":72994,"_3062":121584},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3607":73030,"_31098":72994,"_21528":121586,"_5":14794,"_28279":121455,"_3062":121587},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3607":73031,"_31098":72994,"_21528":121589,"_5":14794,"_28279":121455,"_3062":121590},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3607":73032,"_31098":72994,"_21528":121592,"_5":14794,"_28279":121455,"_3062":121593},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3607":73033,"_31098":72994,"_21528":121595,"_5":14794,"_28279":121455,"_3062":121596},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3607":73034,"_31098":72994,"_21528":121598,"_5":14794,"_28279":121455,"_3062":121599},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3607":73035,"_31098":72994,"_21528":121601,"_5":14794,"_28279":121455,"_3062":121602},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3607":73036,"_31098":72994,"_21528":121604,"_5":14794,"_28279":121459,"_3062":121605},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3607":73037,"_31098":72994,"_21528":121607,"_5":14794,"_28279":121459,"_3062":121608},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3607":73038,"_31098":72994,"_21528":121610,"_5":14794,"_28279":121463,"_3062":121611},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3607":73039,"_31098":72994,"_21528":121613,"_5":14794,"_28279":121463,"_3062":121614},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3607":73040,"_31098":72994,"_21528":121616,"_5":14794,"_28279":121463,"_3062":121617},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3607":73041,"_31098":72994,"_21528":121619,"_5":14794,"_28279":121463,"_3062":121620},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3607":73042,"_31098":72994,"_21528":121622,"_5":14794,"_28279":121463,"_3062":121623},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3607":73043,"_31098":72994,"_21528":121625,"_5":14794,"_28279":121463,"_3062":121626},[],"Carga por separado las políticas concedidas a cada principal.",{"_3607":73044,"_31098":72994,"_21528":121628,"_5":14794,"_28279":121463,"_3062":121629},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3607":73045,"_31098":72994,"_21528":121631,"_5":14794,"_28279":121463,"_3062":121632},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3607":73046,"_31098":72994,"_21528":121634,"_5":14794,"_28279":121463,"_3062":121635},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3607":73047,"_31098":72994,"_21528":121637,"_5":14794,"_28279":121463,"_3062":121638},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3607":73048,"_31098":72994,"_21528":121640,"_5":14794,"_28279":121463,"_3062":121641},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3607":73049,"_31098":72994,"_21528":121643,"_5":14794,"_28279":121463,"_3062":121644},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3607":73050,"_31098":72994,"_21528":121646,"_5":14794,"_28279":121467,"_3062":121647},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3607":73051,"_31098":72994,"_21528":121649,"_5":14794,"_28279":121467,"_3062":121650},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3607":73052,"_31098":72994,"_21528":121652,"_5":14794,"_28279":121467,"_3062":121653},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3607":73053,"_31098":72994,"_21528":121655,"_5":14794,"_28279":121467,"_3062":121656},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3607":73054,"_31098":72994,"_21528":121658,"_5":14794,"_28279":121467,"_3062":121659},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3607":73055,"_31098":72994,"_21528":121661,"_5":14794,"_28279":121467,"_3062":121662},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3607":73056,"_31098":72994,"_21528":121664,"_5":14794,"_28279":121467,"_3062":121665},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3607":73057,"_31098":72994,"_21528":121667,"_5":14794,"_28279":121467,"_3062":121668},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3607":73058,"_31098":72994,"_21528":121670,"_5":14794,"_28279":121467,"_3062":121671},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3607":73059,"_31098":72994,"_21528":121673,"_5":14794,"_28279":121467,"_3062":121674},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3607":73060,"_31098":72994,"_21528":121676,"_5":14794,"_28279":121471,"_3062":121677},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3607":73061,"_31098":72994,"_21528":121679,"_5":14794,"_28279":121471,"_3062":121680},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3607":73062,"_31098":72994,"_21528":121682,"_5":14794,"_28279":121471,"_3062":121683},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3607":73063,"_31098":72994,"_21528":121685,"_5":14794,"_28279":121471,"_3062":121686},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3607":73064,"_31098":72994,"_21528":121688,"_5":14794,"_28279":121471,"_3062":121689},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3607":73065,"_31098":72994,"_21528":121691,"_5":14794,"_28279":121471,"_3062":121692},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3607":73066,"_31098":72994,"_21528":121694,"_5":14794,"_28279":121471,"_3062":121695},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3607":73067,"_31098":72994,"_21528":121697,"_5":14794,"_28279":121471,"_3062":121698},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3607":73068,"_31098":72994,"_21528":121700,"_5":14794,"_28279":121471,"_3062":121701},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3607":73069,"_31098":72994,"_21528":121703,"_5":14794,"_28279":121471,"_3062":121704},[],"Las acciones se dividen en dos grupos:",{"_3607":73070,"_31098":72994,"_21528":121706,"_5":14794,"_28279":121471,"_3062":121707},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3607":73071,"_31098":72994,"_21528":121709,"_5":14794,"_28279":121471,"_3062":121710},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3607":73072,"_31098":72994,"_21528":121712,"_5":14794,"_28279":121471,"_3062":121713},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3607":73073,"_31098":72994,"_21528":121715,"_5":14794,"_28279":121475,"_3062":121716},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3607":73074,"_31098":72994,"_21528":121718,"_5":14794,"_28279":121475,"_3062":121719},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3607":73075,"_31098":72994,"_21528":121721,"_5":14794,"_28279":121475,"_3062":121722},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3607":73076,"_31098":72994,"_21528":121724,"_5":14794,"_28279":121479,"_3062":121725},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3607":73077,"_31098":72994,"_21528":121727,"_5":14794,"_28279":121479,"_3062":121728},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3607":73078,"_31098":72994,"_21528":121730,"_5":14794,"_28279":121479,"_3062":121731},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3607":73079,"_31098":72994,"_21528":121733,"_5":14794,"_28279":121479,"_3062":121734},[],"Los operadores implementados son:",{"_3607":73080,"_31098":72994,"_21528":121736,"_5":14794,"_28279":121479,"_3062":121737},[],"`equals`, para igualdad exacta;",{"_3607":73081,"_31098":72994,"_21528":121739,"_5":14794,"_28279":121479,"_3062":121740},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3607":73082,"_31098":72994,"_21528":121742,"_5":14794,"_28279":121479,"_3062":121743},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3607":73083,"_31098":72994,"_21528":121745,"_5":14794,"_28279":121479,"_3062":121746},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3607":73084,"_31098":72994,"_21528":121748,"_5":14794,"_28279":121483,"_3062":121749},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3607":73085,"_31098":72994,"_21528":121751,"_5":14794,"_28279":121483,"_3062":121752},[],"Los modos disponibles son:",{"_3607":73086,"_31098":72994,"_21528":121754,"_5":14794,"_28279":121483,"_3062":121755},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3607":73087,"_31098":72994,"_21528":121757,"_5":14794,"_28279":121483,"_3062":121758},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3607":73088,"_31098":72994,"_21528":121760,"_5":14794,"_28279":121483,"_3062":121761},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3607":73089,"_31098":72994,"_21528":121763,"_5":14794,"_28279":121483,"_3062":121764},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3607":73090,"_31098":72994,"_21528":121766,"_5":14794,"_28279":121483,"_3062":121767},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3607":73091,"_31098":72994,"_21528":121769,"_5":14794,"_28279":121483,"_3062":121770},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3607":73092,"_31098":72994,"_21528":121772,"_5":14794,"_28279":121487,"_3062":121773},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3607":73093,"_31098":72994,"_21528":121775,"_5":14794,"_28279":121487,"_3062":121776},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3607":73094,"_31098":72994,"_21528":121778,"_5":14794,"_28279":121487,"_3062":121779},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3607":73095,"_31098":72994,"_21528":121781,"_5":14794,"_28279":121487,"_3062":121782},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3607":73096,"_31098":72994,"_21528":121784,"_5":14794,"_28279":121495,"_3062":121785},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3607":73097,"_31098":72994,"_21528":121787,"_5":14794,"_28279":121495,"_3062":121788},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3607":73098,"_31098":72994,"_21528":121790,"_5":14794,"_28279":121499,"_3062":121791},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3607":73099,"_31098":72994,"_21528":121793,"_5":14794,"_28279":121499,"_3062":121794},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3607":73100,"_31098":72994,"_21528":121796,"_5":14794,"_28279":121499,"_3062":121797},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3607":73101,"_31098":72994,"_21528":121799,"_5":14794,"_28279":121499,"_3062":121800},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3607":73102,"_31098":72994,"_21528":121802,"_5":14794,"_28279":121499,"_3062":121803},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3607":73103,"_31098":72994,"_21528":121805,"_5":14794,"_28279":121503,"_3062":121806},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3607":73104,"_31098":72994,"_21528":121808,"_5":14794,"_28279":121503,"_3062":121809},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3607":73105,"_31098":72994,"_21528":121811,"_5":14794,"_28279":121503,"_3062":121812},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3607":73106,"_31098":72994,"_21528":121814,"_5":14794,"_28279":121507,"_3062":121815},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3607":73107,"_31098":72994,"_21528":121817,"_5":14794,"_28279":121507,"_3062":121818},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3607":73108,"_31098":72994,"_21528":121820,"_5":14794,"_28279":121507,"_3062":121821},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3607":73109,"_31098":72994,"_21528":121823,"_5":14794,"_28279":121507,"_3062":121824},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3607":73110,"_31098":72994,"_21528":121826,"_5":14794,"_28279":121507,"_3062":121827},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3607":73111,"_31098":72994,"_21528":121829,"_5":14794,"_28279":121507,"_3062":121830},[],"Ten en cuenta que:",{"_3607":73112,"_31098":72994,"_21528":121832,"_5":14794,"_28279":121507,"_3062":121833},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3607":73113,"_31098":72994,"_21528":121835,"_5":14794,"_28279":121507,"_3062":121836},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3607":73114,"_31098":72994,"_21528":121838,"_5":14794,"_28279":121507,"_3062":121839},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3607":73115,"_31098":72994,"_21528":121841,"_5":14794,"_28279":121511,"_3062":121842},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3607":73116,"_31098":72994,"_21528":121844,"_5":14794,"_28279":121511,"_3062":121845},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3607":73117,"_31098":72994,"_21528":121847,"_5":14794,"_28279":121511,"_3062":121848},[],"acceso completo y de solo lectura a KMS;",{"_3607":73118,"_31098":72994,"_21528":121850,"_5":14794,"_28279":121511,"_3062":121851},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3607":73119,"_31098":72994,"_21528":121853,"_5":14794,"_28279":121511,"_3062":121854},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3607":73120,"_31098":72994,"_21528":121856,"_5":14794,"_28279":121511,"_3062":121857},[],"acceso a la interfaz;",{"_3607":73121,"_31098":72994,"_21528":121859,"_5":14794,"_28279":121511,"_3062":121860},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3607":73122,"_31098":72994,"_21528":121862,"_5":14794,"_28279":121511,"_3062":121863},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3607":73123,"_31098":72994,"_21528":121865,"_5":14794,"_28279":121511,"_3062":121866},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3607":73124,"_31098":72994,"_21528":121868,"_5":14794,"_28279":121511,"_3062":121869},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3607":73125,"_31098":72994,"_21528":121871,"_5":14794,"_28279":121511,"_3062":121872},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3607":73126,"_31098":72994,"_21528":121874,"_5":14794,"_28279":121515,"_3062":121875},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3607":73127,"_31098":72994,"_21528":121877,"_5":14794,"_28279":121515,"_3062":121878},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3607":73128,"_31098":72994,"_21528":121880,"_5":14794,"_28279":121515,"_3062":121881},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3607":73129,"_31098":72994,"_21528":121883,"_5":14794,"_28279":121518,"_3062":121884},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3607":73130,"_31098":72994,"_21528":121886,"_5":14794,"_28279":121522,"_3062":121887},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3607":73131,"_31098":72994,"_21528":121889,"_5":14794,"_28279":121522,"_3062":121890},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3607":73132,"_31098":72994,"_21528":121892,"_5":14794,"_28279":121526,"_3062":121893},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3607":73133,"_31098":72994,"_21528":121895,"_5":14794,"_28279":121530,"_3062":121896},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3607":73134,"_31098":72994,"_21528":121898,"_5":14794,"_28279":121534,"_3062":121899},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3607":73135,"_31098":72994,"_21528":121901,"_5":14794,"_28279":121538,"_3062":121902},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3607":73136,"_31098":72994,"_21528":121904,"_5":14794,"_28279":121538,"_3062":121905},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3607":73137,"_31098":72994,"_21528":121907,"_5":14794,"_28279":121542,"_3062":121908},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3607":73138,"_31098":72994,"_21528":121910,"_5":14794,"_28279":121542,"_3062":121911},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3607":73139,"_31098":72994,"_21528":121913,"_5":14794,"_28279":121542,"_3062":121914},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3607":73140,"_31098":72994,"_21528":121916,"_5":14794,"_28279":121542,"_3062":121917},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3607":73141,"_31098":72994,"_21528":121919,"_5":14794,"_28279":121542,"_3062":121920},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3607":73142,"_31098":72994,"_21528":121922,"_5":14794,"_28279":121542,"_3062":121923},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3607":73143,"_31098":72994,"_21528":121925,"_5":14794,"_28279":121542,"_3062":121926},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3607":73144,"_31098":72994,"_21528":121928,"_5":14794,"_28279":121542,"_3062":121929},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3607":73145,"_31098":72994,"_21528":121931,"_5":14794,"_28279":121546,"_3062":121932},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3607":73146,"_31098":72994,"_21528":121934,"_5":14794,"_28279":121546,"_3062":121935},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3607":73147,"_31098":72994,"_21528":121937,"_5":14794,"_28279":121546,"_3062":121938},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3607":73148,"_31098":72994,"_21528":121940,"_5":14794,"_28279":121550,"_3062":121941},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3607":73149,"_31098":72994,"_21528":121943,"_5":14794,"_28279":121550,"_3062":121944},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3607":73150,"_31098":72994,"_21528":121946,"_5":14794,"_28279":121550,"_3062":121947},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3607":73151,"_31098":72994,"_21528":121949,"_5":14794,"_28279":121550,"_3062":121950},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3607":73152,"_31098":72994,"_21528":121952,"_5":14794,"_28279":121550,"_3062":121953},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3607":73153,"_31098":72994,"_21528":121955,"_5":14794,"_28279":121550,"_3062":121956},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3607":73154,"_31098":72994,"_21528":121958,"_5":14794,"_28279":121550,"_3062":121959},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3607":73155,"_31098":72994,"_21528":121961,"_5":14794,"_28279":121550,"_3062":121962},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3607":73156,"_31098":72994,"_21528":121964,"_5":14794,"_28279":121558,"_3062":121965},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3607":73157,"_31098":72994,"_21528":121967,"_5":14794,"_28279":121562,"_3062":121968},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3607":73158,"_31098":72994,"_21528":121970,"_5":14794,"_28279":121562,"_3062":121971},[],"que exista un principal activo del tipo correcto;",{"_3607":73159,"_31098":72994,"_21528":121973,"_5":14794,"_28279":121562,"_3062":121974},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3607":73160,"_31098":72994,"_21528":121976,"_5":14794,"_28279":121562,"_3062":121977},[],"que todas las condiciones del principal se cumplan;",{"_3607":73161,"_31098":72994,"_21528":121979,"_5":14794,"_28279":121562,"_3062":121980},[],"que el principal tenga concedida la política esperada;",{"_3607":73162,"_31098":72994,"_21528":121982,"_5":14794,"_28279":121562,"_3062":121983},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3607":73163,"_31098":72994,"_21528":121985,"_5":14794,"_28279":121562,"_3062":121986},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3607":73164,"_31098":72994,"_21528":121988,"_5":14794,"_28279":121562,"_3062":121989},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3607":73165,"_31098":72994,"_21528":121991,"_5":14794,"_28279":121562,"_3062":121992},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3607":73166,"_31098":72994,"_21528":121994,"_5":14794,"_28279":121566,"_3062":121995},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3607":73167,"_31098":72994,"_21528":121997,"_5":14794,"_28279":121570,"_3062":121998},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3607":73168,"_31098":72994,"_21528":122000,"_5":14794,"_28279":121574,"_3062":122001},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3607":73169,"_31098":72994,"_21528":122003,"_5":14794,"_28279":121574,"_3062":122004},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3607":73170,"_31098":73170,"_5":15159,"_3062":122006,"_31457":122007,"_21528":122008,"_28279":73170},"Alertas y suscripciones",[50787,121341,121342],[],{"_3607":73171,"_31098":73170,"_21528":122010,"_5":14794,"_28279":73170,"_3062":122011},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3607":73172,"_31098":73170,"_5":31454,"_21528":122013,"_28279":122014,"_3062":122015},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3607":73173,"_31098":73170,"_5":31454,"_21528":122017,"_28279":122018,"_3062":122019},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3607":73174,"_31098":73170,"_5":31454,"_21528":122021,"_28279":122022,"_3062":122023},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3607":73175,"_31098":73170,"_5":31454,"_21528":122025,"_28279":122026,"_3062":122027},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3607":73176,"_31098":73170,"_5":31454,"_21528":122029,"_28279":122030,"_3062":122031},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3607":73177,"_31098":73170,"_5":31454,"_21528":122033,"_28279":122034,"_3062":122035},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3607":73178,"_31098":73170,"_5":31454,"_21528":122037,"_28279":122038,"_3062":122039},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3607":73179,"_31098":73170,"_5":31454,"_21528":122041,"_28279":122042,"_3062":122043},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3607":73180,"_31098":73170,"_5":31454,"_21528":122045,"_28279":122046,"_3062":122047},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3607":73181,"_31098":73170,"_5":31454,"_21528":122049,"_28279":122050,"_3062":122051},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3607":73182,"_31098":73170,"_5":31454,"_21528":122053,"_28279":122054,"_3062":122055},[],"/docs/pr-preview/pr-75/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3607":73183,"_31098":73170,"_21528":122057,"_5":14794,"_28279":73170,"_3062":122058},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3607":73184,"_31098":73170,"_21528":122060,"_5":14794,"_28279":122014,"_3062":122061},[],"Un servicio publica un evento de dominio.",{"_3607":73185,"_31098":73170,"_21528":122063,"_5":14794,"_28279":122014,"_3062":122064},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3607":73186,"_31098":73170,"_21528":122066,"_5":14794,"_28279":122014,"_3062":122067},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3607":73187,"_31098":73170,"_21528":122069,"_5":14794,"_28279":122014,"_3062":122070},[],"Lamassu entrega el evento al canal configurado.",{"_3607":73188,"_31098":73170,"_21528":122072,"_5":14794,"_28279":122014,"_3062":122073},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3607":73189,"_31098":73170,"_21528":122075,"_5":14794,"_28279":122018,"_3062":122076},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3607":73190,"_31098":73170,"_21528":122078,"_5":14794,"_28279":122018,"_3062":122079},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3607":73191,"_31098":73170,"_21528":122081,"_5":14794,"_28279":122018,"_3062":122082},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3607":73192,"_31098":73170,"_21528":122084,"_5":14794,"_28279":122018,"_3062":122085},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3607":73193,"_31098":73170,"_21528":122087,"_5":14794,"_28279":122018,"_3062":122088},[],"`apikey_options` necesita `header` y `key`.",{"_3607":73194,"_31098":73170,"_21528":122090,"_5":14794,"_28279":122018,"_3062":122091},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3607":73195,"_31098":73170,"_21528":122093,"_5":14794,"_28279":122018,"_3062":122094},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3607":73196,"_31098":73170,"_21528":122096,"_5":14794,"_28279":122018,"_3062":122097},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3607":73197,"_31098":73170,"_21528":122099,"_5":14794,"_28279":122026,"_3062":122100},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3607":73198,"_31098":73170,"_21528":122102,"_5":14794,"_28279":122030,"_3062":122103},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3607":73199,"_31098":73170,"_21528":122105,"_5":14794,"_28279":122034,"_3062":122106},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3607":73200,"_31098":73170,"_21528":122108,"_5":14794,"_28279":122034,"_3062":122109},[],"**None** notifica todas las instancias del evento.",{"_3607":73201,"_31098":73170,"_21528":122111,"_5":14794,"_28279":122034,"_3062":122112},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3607":73202,"_31098":73170,"_21528":122114,"_5":14794,"_28279":122034,"_3062":122115},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3607":73203,"_31098":73170,"_21528":122117,"_5":14794,"_28279":122034,"_3062":122118},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3607":73204,"_31098":73170,"_21528":122120,"_5":14794,"_28279":122034,"_3062":122121},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3607":73205,"_31098":73170,"_21528":122123,"_5":14794,"_28279":122034,"_3062":122124},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3607":73206,"_31098":73170,"_21528":122126,"_5":14794,"_28279":122038,"_3062":122127},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3607":73207,"_31098":73170,"_21528":122129,"_5":14794,"_28279":122042,"_3062":122130},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3607":73208,"_31098":73170,"_21528":122132,"_5":14794,"_28279":122042,"_3062":122133},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3607":73209,"_31098":73170,"_21528":122135,"_5":14794,"_28279":122042,"_3062":122136},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3607":73210,"_31098":73170,"_21528":122138,"_5":14794,"_28279":122042,"_3062":122139},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3607":73211,"_31098":73170,"_21528":122141,"_5":14794,"_28279":122042,"_3062":122142},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3607":73212,"_31098":73170,"_21528":122144,"_5":14794,"_28279":122042,"_3062":122145},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3607":73213,"_31098":73170,"_21528":122147,"_5":14794,"_28279":122042,"_3062":122148},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3607":73214,"_31098":73170,"_21528":122150,"_5":14794,"_28279":122042,"_3062":122151},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3607":73215,"_31098":73170,"_21528":122153,"_5":14794,"_28279":122046,"_3062":122154},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3607":73216,"_31098":73170,"_21528":122156,"_5":14794,"_28279":122046,"_3062":122157},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3607":73217,"_31098":73170,"_21528":122159,"_5":14794,"_28279":122046,"_3062":122160},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3607":73218,"_31098":73170,"_21528":122162,"_5":14794,"_28279":122046,"_3062":122163},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3607":73219,"_31098":73170,"_21528":122165,"_5":14794,"_28279":122046,"_3062":122166},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3607":73220,"_31098":73170,"_21528":122168,"_5":14794,"_28279":122046,"_3062":122169},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3607":73221,"_31098":73170,"_21528":122171,"_5":14794,"_28279":122046,"_3062":122172},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3607":73222,"_31098":73170,"_21528":122174,"_5":14794,"_28279":122046,"_3062":122175},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3607":73223,"_31098":73170,"_21528":122177,"_5":14794,"_28279":122050,"_3062":122178},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3607":73224,"_31098":73170,"_21528":122180,"_5":14794,"_28279":122050,"_3062":122181},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3607":73225,"_31098":73170,"_21528":122183,"_5":14794,"_28279":122054,"_3062":122184},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3607":73226,"_31098":73170,"_21528":122186,"_5":14794,"_28279":122054,"_3062":122187},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3607":73227,"_31098":73170,"_21528":122189,"_5":14794,"_28279":122054,"_3062":122190},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3607":73228,"_31098":73170,"_21528":122192,"_5":14794,"_28279":122054,"_3062":122193},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3607":73229,"_31098":73170,"_21528":122195,"_5":14794,"_28279":122054,"_3062":122196},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3607":73230,"_31098":73170,"_21528":122198,"_5":14794,"_28279":122054,"_3062":122199},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3607":73231,"_31098":73170,"_21528":122201,"_5":14794,"_28279":122054,"_3062":122202},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3607":73232,"_31098":73170,"_21528":122204,"_5":14794,"_28279":122054,"_3062":122205},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3607":73233,"_31098":73170,"_21528":122207,"_5":14794,"_28279":122054,"_3062":122208},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3607":73234,"_31098":73170,"_21528":122210,"_5":14794,"_28279":122054,"_3062":122211},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3607":73235,"_31098":73235,"_5":15159,"_3062":122213,"_31457":122214,"_21528":122215,"_28279":73235},"Registros de auditoría",[50787,121341,121342],[],{"_3607":73236,"_31098":73235,"_21528":122217,"_5":14794,"_28279":73235,"_3062":122218},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3607":73237,"_31098":73235,"_5":31454,"_21528":122220,"_28279":122221,"_3062":122222},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3607":73238,"_31098":73235,"_5":31454,"_21528":122224,"_28279":122225,"_3062":122226},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3607":73239,"_31098":73235,"_5":31454,"_21528":122228,"_28279":122229,"_3062":122230},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3607":73240,"_31098":73235,"_5":31454,"_21528":122232,"_28279":122233,"_3062":122234},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3607":73241,"_31098":73235,"_5":31454,"_21528":122236,"_28279":122237,"_3062":122238},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3607":73242,"_31098":73235,"_5":31454,"_21528":122240,"_28279":122241,"_3062":122242},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3607":73243,"_31098":73235,"_5":31454,"_21528":122244,"_28279":122245,"_3062":122246},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3607":73244,"_31098":73235,"_5":31454,"_21528":122248,"_28279":122249,"_3062":122250},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3607":73245,"_31098":73235,"_5":31454,"_21528":122252,"_28279":122253,"_3062":122254},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3607":73246,"_31098":73235,"_5":31454,"_21528":122256,"_28279":122257,"_3062":122258},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3607":73247,"_31098":73235,"_5":31454,"_21528":122260,"_28279":122261,"_3062":122262},[],"/docs/pr-preview/pr-75/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3607":73248,"_31098":73235,"_21528":122264,"_5":14794,"_28279":73235,"_3062":122265},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3607":73249,"_31098":73235,"_21528":122267,"_5":14794,"_28279":122221,"_3062":122268},[],"El cuerpo de auditoría incluye:",{"_3607":73250,"_31098":73235,"_21528":122270,"_5":14794,"_28279":122221,"_3062":122271},[],"input: datos recibidos por la operación;",{"_3607":73251,"_31098":73235,"_21528":122273,"_5":14794,"_28279":122221,"_3062":122274},[],"has\\_error: indica si el servicio devolvió un error;",{"_3607":73252,"_31098":73235,"_21528":122276,"_5":14794,"_28279":122221,"_3062":122277},[],"output: resultado producido o mensaje de error;",{"_3607":73253,"_31098":73235,"_21528":122279,"_5":14794,"_28279":122221,"_3062":122280},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3607":73254,"_31098":73235,"_21528":122282,"_5":14794,"_28279":122221,"_3062":122283},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3607":73255,"_31098":73235,"_21528":122285,"_5":14794,"_28279":122221,"_3062":122286},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3607":73256,"_31098":73235,"_21528":122288,"_5":14794,"_28279":122225,"_3062":122289},[],"El backend aplica auditoría a mutaciones de:",{"_3607":73257,"_31098":73235,"_21528":122291,"_5":14794,"_28279":122225,"_3062":122292},[],"autoridades, certificados y perfiles de emisión;",{"_3607":73258,"_31098":73235,"_21528":122294,"_5":14794,"_28279":122225,"_3062":122295},[],"claves y motores KMS;",{"_3607":73259,"_31098":73235,"_21528":122297,"_5":14794,"_28279":122225,"_3062":122298},[],"dispositivos e identidades;",{"_3607":73260,"_31098":73235,"_21528":122300,"_5":14794,"_28279":122225,"_3062":122301},[],"DMS y operaciones de enrolamiento;",{"_3607":73261,"_31098":73235,"_21528":122303,"_5":14794,"_28279":122225,"_3062":122304},[],"funciones de validación y CRL;",{"_3607":73262,"_31098":73235,"_21528":122306,"_5":14794,"_28279":122225,"_3062":122307},[],"principales, políticas y concesiones de autorización.",{"_3607":73263,"_31098":73235,"_21528":122309,"_5":14794,"_28279":122225,"_3062":122310},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3607":73264,"_31098":73235,"_21528":122312,"_5":14794,"_28279":122229,"_3062":122313},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3607":73265,"_31098":73235,"_21528":122315,"_5":14794,"_28279":122229,"_3062":122316},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3607":73266,"_31098":73235,"_21528":122318,"_5":14794,"_28279":122229,"_3062":122319},[],"Diseña el consumidor para:",{"_3607":73267,"_31098":73235,"_21528":122321,"_5":14794,"_28279":122229,"_3062":122322},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3607":73268,"_31098":73235,"_21528":122324,"_5":14794,"_28279":122229,"_3062":122325},[],"conservar el CloudEvent completo sin modificar;",{"_3607":73269,"_31098":73235,"_21528":122327,"_5":14794,"_28279":122229,"_3062":122328},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3607":73270,"_31098":73235,"_21528":122330,"_5":14794,"_28279":122229,"_3062":122331},[],"cifrar en tránsito y en reposo;",{"_3607":73271,"_31098":73235,"_21528":122333,"_5":14794,"_28279":122229,"_3062":122334},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3607":73272,"_31098":73235,"_21528":122336,"_5":14794,"_28279":122229,"_3062":122337},[],"aplicar una política explícita de retención y legal hold;",{"_3607":73273,"_31098":73235,"_21528":122339,"_5":14794,"_28279":122229,"_3062":122340},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3607":73274,"_31098":73235,"_21528":122342,"_5":14794,"_28279":122233,"_3062":122343},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3607":73275,"_31098":73235,"_21528":122345,"_5":14794,"_28279":122233,"_3062":122346},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3607":73276,"_31098":73235,"_21528":122348,"_5":14794,"_28279":122241,"_3062":122349},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3607":73277,"_31098":73235,"_21528":122351,"_5":14794,"_28279":122245,"_3062":122352},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3607":73278,"_31098":73235,"_21528":122354,"_5":14794,"_28279":122249,"_3062":122355},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3607":73279,"_31098":73235,"_21528":122357,"_5":14794,"_28279":122253,"_3062":122358},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3607":73280,"_31098":73235,"_21528":122360,"_5":14794,"_28279":122257,"_3062":122361},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3607":73281,"_31098":73235,"_21528":122363,"_5":14794,"_28279":122261,"_3062":122364},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3607":73282,"_31098":73235,"_21528":122366,"_5":14794,"_28279":122261,"_3062":122367},[],"aparece un evento de auditoría correcto;",{"_3607":73283,"_31098":73235,"_21528":122369,"_5":14794,"_28279":122261,"_3062":122370},[],"el principal coincide con la identidad utilizada;",{"_3607":73284,"_31098":73235,"_21528":122372,"_5":14794,"_28279":122261,"_3062":122373},[],"el consumidor lo persiste una sola vez;",{"_3607":73285,"_31098":73235,"_21528":122375,"_5":14794,"_28279":122261,"_3062":122376},[],"puede recuperarse por recurso, actor y periodo;",{"_3607":73286,"_31098":73235,"_21528":122378,"_5":14794,"_28279":122261,"_3062":122379},[],"una interrupción del consumidor produce una alerta.",{"_3607":73287,"_31098":73235,"_21528":122381,"_5":14794,"_28279":122261,"_3062":122382},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3607":73288,"_31098":73288,"_5":15159,"_3062":122384,"_31457":122385,"_21528":122386,"_28279":73288},"Arquitectura de la plataforma",[50787,121341],[],{"_3607":73289,"_31098":73288,"_21528":122388,"_5":14794,"_28279":73288,"_3062":122389},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3607":73290,"_31098":73288,"_5":31454,"_21528":122391,"_28279":122392,"_3062":122393},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3607":73291,"_31098":73288,"_5":31454,"_21528":122395,"_28279":122396,"_3062":122397},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3607":73292,"_31098":73288,"_5":31454,"_21528":122399,"_28279":122400,"_3062":122401},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3607":73293,"_31098":73288,"_5":31454,"_21528":122403,"_28279":122404,"_3062":122405},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3607":73294,"_31098":73288,"_5":31454,"_21528":122407,"_28279":122408,"_3062":122409},[],"/docs/pr-preview/pr-75/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3607":73295,"_31098":73288,"_21528":122411,"_5":14794,"_28279":73288,"_3062":122412},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3607":73296,"_31098":73288,"_21528":122414,"_5":14794,"_28279":73288,"_3062":122415},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3607":73297,"_31098":73288,"_21528":122417,"_5":14794,"_28279":122392,"_3062":122418},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3607":73298,"_31098":73288,"_21528":122420,"_5":14794,"_28279":122396,"_3062":122421},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3607":73299,"_31098":73288,"_21528":122423,"_5":14794,"_28279":122400,"_3062":122424},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3607":73300,"_31098":73288,"_21528":122426,"_5":14794,"_28279":122404,"_3062":122427},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3607":73301,"_31098":73288,"_21528":122429,"_5":14794,"_28279":122408,"_3062":122430},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3607":73302,"_31098":73302,"_5":15159,"_3062":122432,"_31457":122433,"_21528":122434,"_28279":73302},"Cómo funciona Lamassu",[50787,121341],[],{"_3607":73303,"_31098":73302,"_21528":122436,"_5":14794,"_28279":73302,"_3062":122437},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3607":73304,"_31098":73302,"_5":31454,"_21528":122439,"_28279":122440,"_3062":122441},[],"/docs/pr-preview/pr-75/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3607":73305,"_31098":73302,"_5":31454,"_21528":122443,"_28279":122444,"_3062":122445},[],"/docs/pr-preview/pr-75/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3607":73306,"_31098":73302,"_21528":122447,"_5":14794,"_28279":73302,"_3062":122448},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3607":73307,"_31098":73302,"_21528":122450,"_5":14794,"_28279":122440,"_3062":122451},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3607":73308,"_31098":73302,"_21528":122453,"_5":14794,"_28279":122440,"_3062":122454},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3607":73309,"_31098":73302,"_21528":122456,"_5":14794,"_28279":122440,"_3062":122457},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3607":73310,"_31098":73302,"_21528":122459,"_5":14794,"_28279":122440,"_3062":122460},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3607":73311,"_31098":73302,"_21528":122462,"_5":14794,"_28279":122440,"_3062":122463},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3607":73312,"_31098":73302,"_21528":122465,"_5":14794,"_28279":122444,"_3062":122466},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3607":73313,"_31098":73302,"_21528":122468,"_5":14794,"_28279":122444,"_3062":122469},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3607":73314,"_31098":73302,"_21528":122471,"_5":14794,"_28279":122444,"_3062":122472},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3607":73315,"_31098":73302,"_21528":122474,"_5":14794,"_28279":122444,"_3062":122475},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3607":73316,"_31098":73302,"_21528":122477,"_5":14794,"_28279":122444,"_3062":122478},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3607":73317,"_31098":73302,"_21528":122480,"_5":14794,"_28279":122444,"_3062":122481},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3607":73318,"_31098":73302,"_21528":122483,"_5":14794,"_28279":122444,"_3062":122484},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3607":73319,"_31098":73319,"_5":15159,"_3062":122486,"_31457":122487,"_21528":122488,"_28279":73319},"Dispositivos e identidades",[50787,121341,53471,122486],[],{"_3607":73320,"_31098":73319,"_21528":122490,"_5":14794,"_28279":73319,"_3062":122491},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3607":73321,"_31098":73319,"_5":31454,"_21528":122493,"_28279":122494,"_3062":122495},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3607":73322,"_31098":73319,"_5":31454,"_21528":122497,"_28279":122498,"_3062":122499},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3607":73323,"_31098":73319,"_5":31454,"_21528":122501,"_28279":122502,"_3062":122503},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3607":73324,"_31098":73319,"_5":31454,"_21528":122505,"_28279":122506,"_3062":122507},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3607":73325,"_31098":73319,"_5":31454,"_21528":122509,"_28279":122510,"_3062":122511},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3607":73326,"_31098":73319,"_5":31454,"_21528":122513,"_28279":122514,"_3062":122515},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3607":73327,"_31098":73319,"_5":31454,"_21528":122517,"_28279":122518,"_3062":122519},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3607":73328,"_31098":73319,"_5":31454,"_21528":122521,"_28279":122522,"_3062":122523},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3607":73329,"_31098":73319,"_5":31454,"_21528":122525,"_28279":122526,"_3062":122527},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3607":73330,"_31098":73319,"_5":31454,"_21528":122529,"_28279":122530,"_3062":122531},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3607":73331,"_31098":73319,"_5":31454,"_21528":122533,"_28279":122534,"_3062":122535},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3607":73332,"_31098":73319,"_21528":122537,"_5":14794,"_28279":73319,"_3062":122538},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3607":73333,"_31098":73319,"_21528":122540,"_5":14794,"_28279":73319,"_3062":122541},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3607":73334,"_31098":73319,"_21528":122543,"_5":14794,"_28279":122494,"_3062":122544},[],"Vista operativa",{"_3607":73335,"_31098":73319,"_21528":122546,"_5":14794,"_28279":122494,"_3062":122547},[],"Interpretación",{"_3607":73336,"_31098":73319,"_21528":122549,"_5":14794,"_28279":122494,"_3062":53534},[],{"_3607":73337,"_31098":73319,"_21528":122551,"_5":14794,"_28279":122494,"_3062":122552},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3607":73338,"_31098":73319,"_21528":122554,"_5":14794,"_28279":122494,"_3062":53540},[],{"_3607":73339,"_31098":73319,"_21528":122556,"_5":14794,"_28279":122494,"_3062":122557},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3607":73340,"_31098":73319,"_21528":122559,"_5":14794,"_28279":122494,"_3062":53546},[],{"_3607":73341,"_31098":73319,"_21528":122561,"_5":14794,"_28279":122494,"_3062":122562},[],"La identidad está en la ventana operativa de renovación.",{"_3607":73342,"_31098":73319,"_21528":122564,"_5":14794,"_28279":122494,"_3062":53552},[],{"_3607":73343,"_31098":73319,"_21528":122566,"_5":14794,"_28279":122494,"_3062":122567},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3607":73344,"_31098":73319,"_21528":122569,"_5":14794,"_28279":122494,"_3062":53558},[],{"_3607":73345,"_31098":73319,"_21528":122571,"_5":14794,"_28279":122494,"_3062":122572},[],"La identidad ha vencido.",{"_3607":73346,"_31098":73319,"_21528":122574,"_5":14794,"_28279":122494,"_3062":53564},[],{"_3607":73347,"_31098":73319,"_21528":122576,"_5":14794,"_28279":122494,"_3062":122577},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3607":73348,"_31098":73319,"_21528":122579,"_5":14794,"_28279":122494,"_3062":53570},[],{"_3607":73349,"_31098":73319,"_21528":122581,"_5":14794,"_28279":122494,"_3062":122582},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3607":73350,"_31098":73319,"_21528":122584,"_5":14794,"_28279":122494,"_3062":122585},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3607":73351,"_31098":73319,"_21528":122587,"_5":14794,"_28279":122498,"_3062":122588},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3607":73352,"_31098":73319,"_21528":122590,"_5":14794,"_28279":122498,"_3062":122591},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3607":73353,"_31098":73319,"_21528":122593,"_5":14794,"_28279":122498,"_3062":122594},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3607":73354,"_31098":73319,"_21528":122596,"_5":14794,"_28279":122498,"_3062":122597},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3607":73355,"_31098":73319,"_21528":122599,"_5":14794,"_28279":122502,"_3062":122600},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3607":73356,"_31098":73319,"_21528":122602,"_5":14794,"_28279":122506,"_3062":122603},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3607":73357,"_31098":73319,"_21528":122605,"_5":14794,"_28279":122510,"_3062":122606},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3607":73358,"_31098":73319,"_21528":122608,"_5":14794,"_28279":122514,"_3062":122609},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3607":73359,"_31098":73319,"_21528":122611,"_5":14794,"_28279":122518,"_3062":122612},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3607":73360,"_31098":73319,"_21528":122614,"_5":14794,"_28279":122518,"_3062":122615},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3607":73361,"_31098":73319,"_21528":122617,"_5":14794,"_28279":122522,"_3062":122618},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3607":73362,"_31098":73319,"_21528":122620,"_5":14794,"_28279":122522,"_3062":122621},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3607":73363,"_31098":73319,"_21528":122623,"_5":14794,"_28279":122522,"_3062":122624},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3607":73364,"_31098":73319,"_21528":122626,"_5":14794,"_28279":122522,"_3062":122627},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3607":73365,"_31098":73319,"_21528":122629,"_5":14794,"_28279":122522,"_3062":122630},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3607":73366,"_31098":73319,"_21528":122632,"_5":14794,"_28279":122522,"_3062":122633},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3607":73367,"_31098":73319,"_21528":122635,"_5":14794,"_28279":122526,"_3062":122636},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3607":73368,"_31098":73319,"_21528":122638,"_5":14794,"_28279":122526,"_3062":122639},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3607":73369,"_31098":73319,"_21528":122641,"_5":14794,"_28279":122526,"_3062":122642},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3607":73370,"_31098":73319,"_21528":122644,"_5":14794,"_28279":122530,"_3062":122645},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3607":73371,"_31098":73319,"_21528":122647,"_5":14794,"_28279":122530,"_3062":122648},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3607":73372,"_31098":73319,"_21528":122650,"_5":14794,"_28279":122530,"_3062":122651},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3607":73373,"_31098":73319,"_21528":122653,"_5":14794,"_28279":122530,"_3062":122654},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3607":73374,"_31098":73319,"_21528":122656,"_5":14794,"_28279":122534,"_3062":122657},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3607":73375,"_31098":73319,"_21528":122659,"_5":14794,"_28279":122534,"_3062":122660},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3607":73376,"_31098":73376,"_5":15159,"_3062":122662,"_31457":122663,"_21528":122665,"_28279":73376},"Identidad inicial y autenticación",[50787,121341,53471,122486,122664],"Enrolamiento con PKI",[],{"_3607":73377,"_31098":73376,"_21528":122667,"_5":14794,"_28279":73376,"_3062":122668},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3607":73378,"_31098":73376,"_5":31454,"_21528":122670,"_28279":122671,"_3062":122672},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3607":73379,"_31098":73376,"_5":31454,"_21528":122674,"_28279":122675,"_3062":122676},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3607":73380,"_31098":73376,"_5":31454,"_21528":122678,"_28279":122679,"_3062":122680},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3607":73381,"_31098":73376,"_5":31454,"_21528":122682,"_28279":122683,"_3062":122684},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3607":73382,"_31098":73376,"_5":31454,"_21528":122686,"_28279":122687,"_3062":122688},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3607":73383,"_31098":73376,"_21528":122690,"_5":14794,"_28279":73376,"_3062":122691},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3607":73384,"_31098":73376,"_21528":122693,"_5":14794,"_28279":122671,"_3062":122694},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3607":73385,"_31098":73376,"_21528":122696,"_5":14794,"_28279":122671,"_3062":122697},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3607":73386,"_31098":73376,"_21528":122699,"_5":14794,"_28279":122675,"_3062":122700},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3607":73387,"_31098":73376,"_21528":122702,"_5":14794,"_28279":122675,"_3062":122703},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3607":73388,"_31098":73376,"_21528":122705,"_5":14794,"_28279":122675,"_3062":122706},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3607":73389,"_31098":73376,"_21528":122708,"_5":14794,"_28279":122679,"_3062":122709},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3607":73390,"_31098":73376,"_21528":122711,"_5":14794,"_28279":122679,"_3062":122712},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3607":73391,"_31098":73376,"_21528":122714,"_5":14794,"_28279":122683,"_3062":122715},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3607":73392,"_31098":73376,"_21528":122717,"_5":14794,"_28279":122683,"_3062":122718},[],"Ejemplo de cuerpo:",{"_3607":73393,"_31098":73376,"_21528":122720,"_5":14794,"_28279":122683,"_3062":122721},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3607":73394,"_31098":73376,"_21528":122723,"_5":14794,"_28279":122683,"_3062":122724},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3607":73395,"_31098":73376,"_21528":122726,"_5":14794,"_28279":122683,"_3062":122727},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3607":73396,"_31098":73376,"_21528":122729,"_5":14794,"_28279":122683,"_3062":122730},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3607":73397,"_31098":73376,"_21528":122732,"_5":14794,"_28279":122687,"_3062":122733},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3607":73398,"_31098":73376,"_21528":122735,"_5":14794,"_28279":122687,"_3062":122736},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3607":73399,"_31098":73399,"_5":15159,"_3062":122738,"_31457":122739,"_21528":122740,"_28279":73399},"Configura y opera el DMS",[50787,121341,53471,122486,122664],[],{"_3607":73400,"_31098":73399,"_21528":122742,"_5":14794,"_28279":73399,"_3062":122743},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3607":73401,"_31098":73399,"_5":31454,"_21528":122745,"_28279":122746,"_3062":119875},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3607":73402,"_31098":73399,"_5":31454,"_21528":122748,"_28279":122749,"_3062":122750},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3607":73403,"_31098":73399,"_5":31454,"_21528":122752,"_28279":122753,"_3062":122754},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3607":73404,"_31098":73399,"_5":31454,"_21528":122756,"_28279":122757,"_3062":122758},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3607":73405,"_31098":73399,"_5":31454,"_21528":122760,"_28279":122761,"_3062":122762},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3607":73406,"_31098":73399,"_5":31454,"_21528":122764,"_28279":122765,"_3062":122766},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3607":73407,"_31098":73399,"_5":31454,"_21528":122768,"_28279":122769,"_3062":122770},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3607":73408,"_31098":73399,"_5":31454,"_21528":122772,"_28279":122773,"_3062":122774},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3607":73409,"_31098":73399,"_5":31454,"_21528":122776,"_28279":122777,"_3062":53769},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3607":73410,"_31098":73399,"_5":31454,"_21528":122779,"_28279":122780,"_3062":53773},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3607":73411,"_31098":73399,"_5":31454,"_21528":122782,"_28279":122783,"_3062":122784},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3607":73412,"_31098":73399,"_5":31454,"_21528":122786,"_28279":122787,"_3062":122788},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3607":73413,"_31098":73399,"_5":31454,"_21528":122790,"_28279":122791,"_3062":122792},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3607":73414,"_31098":73399,"_5":31454,"_21528":122794,"_28279":122795,"_3062":122796},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3607":73415,"_31098":73399,"_5":31454,"_21528":122798,"_28279":122799,"_3062":53793},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3607":73416,"_31098":73399,"_5":31454,"_21528":122801,"_28279":122802,"_3062":122803},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3607":73417,"_31098":73399,"_5":31454,"_21528":122805,"_28279":122806,"_3062":122807},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3607":73418,"_31098":73399,"_5":31454,"_21528":122809,"_28279":122810,"_3062":122811},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3607":73419,"_31098":73399,"_21528":122813,"_5":14794,"_28279":73399,"_3062":122814},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3607":73420,"_31098":73399,"_21528":122816,"_5":14794,"_28279":122746,"_3062":122817},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3607":73421,"_31098":73399,"_21528":122819,"_5":14794,"_28279":122746,"_3062":122820},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3607":73422,"_31098":73399,"_21528":122822,"_5":14794,"_28279":122753,"_3062":122823},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3607":73423,"_31098":73399,"_21528":122825,"_5":14794,"_28279":122757,"_3062":122826},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3607":73424,"_31098":73399,"_21528":122828,"_5":14794,"_28279":122761,"_3062":122829},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3607":73425,"_31098":73399,"_21528":122831,"_5":14794,"_28279":122765,"_3062":122832},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3607":73426,"_31098":73399,"_21528":122834,"_5":14794,"_28279":122769,"_3062":122835},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3607":73427,"_31098":73399,"_21528":122837,"_5":14794,"_28279":122777,"_3062":122838},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3607":73428,"_31098":73399,"_21528":122840,"_5":14794,"_28279":122777,"_3062":122841},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3607":73429,"_31098":73399,"_21528":122843,"_5":14794,"_28279":122780,"_3062":122844},[],"Campo de `settings.enrollment_settings`",{"_3607":73430,"_31098":73399,"_21528":122846,"_5":14794,"_28279":122780,"_3062":122847},[],"Decisión",{"_3607":73431,"_31098":73399,"_21528":122849,"_5":14794,"_28279":122780,"_3062":53844},[],{"_3607":73432,"_31098":73399,"_21528":122851,"_5":14794,"_28279":122780,"_3062":122852},[],"`EST_RFC7030` para estas operaciones.",{"_3607":73433,"_31098":73399,"_21528":122854,"_5":14794,"_28279":122780,"_3062":53850},[],{"_3607":73434,"_31098":73399,"_21528":122856,"_5":14794,"_28279":122780,"_3062":122857},[],"ID de la CA que firmará.",{"_3607":73435,"_31098":73399,"_21528":122859,"_5":14794,"_28279":122780,"_3062":53856},[],{"_3607":73436,"_31098":73399,"_21528":122861,"_5":14794,"_28279":122780,"_3062":122862},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3607":73437,"_31098":73399,"_21528":122864,"_5":14794,"_28279":122780,"_3062":53862},[],{"_3607":73438,"_31098":73399,"_21528":122866,"_5":14794,"_28279":122780,"_3062":122867},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3607":73439,"_31098":73399,"_21528":122869,"_5":14794,"_28279":122780,"_3062":53868},[],{"_3607":73440,"_31098":73399,"_21528":122871,"_5":14794,"_28279":122780,"_3062":122872},[],"Uno de los cuatro modos de autenticación.",{"_3607":73441,"_31098":73399,"_21528":122874,"_5":14794,"_28279":122780,"_3062":122875},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3607":73442,"_31098":73399,"_21528":122877,"_5":14794,"_28279":122783,"_3062":122878},[],"Los bloques son independientes:",{"_3607":73443,"_31098":73399,"_21528":122880,"_5":14794,"_28279":122783,"_3062":122881},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3607":73444,"_31098":73399,"_21528":122883,"_5":14794,"_28279":122783,"_3062":122884},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3607":73445,"_31098":73399,"_21528":122886,"_5":14794,"_28279":122783,"_3062":53886},[],{"_3607":73446,"_31098":73399,"_21528":122888,"_5":14794,"_28279":122783,"_3062":122889},[],"Control aplicado en la operación configurada",{"_3607":73447,"_31098":73399,"_21528":122891,"_5":14794,"_28279":122783,"_3062":53892},[],{"_3607":73448,"_31098":73399,"_21528":122893,"_5":14794,"_28279":122783,"_3062":122894},[],"Validación del certificado presentado.",{"_3607":73449,"_31098":73399,"_21528":122896,"_5":14794,"_28279":122783,"_3062":53898},[],{"_3607":73450,"_31098":73399,"_21528":122898,"_5":14794,"_28279":122783,"_3062":122899},[],"Autorización del webhook configurado.",{"_3607":73451,"_31098":73399,"_21528":122901,"_5":14794,"_28279":122783,"_3062":53904},[],{"_3607":73452,"_31098":73399,"_21528":122903,"_5":14794,"_28279":122783,"_3062":122904},[],"Validación del certificado y, después, aprobación del webhook.",{"_3607":73453,"_31098":73399,"_21528":122906,"_5":14794,"_28279":122783,"_3062":53910},[],{"_3607":73454,"_31098":73399,"_21528":122908,"_5":14794,"_28279":122783,"_3062":122909},[],"Sin autenticación del solicitante por el DMS.",{"_3607":73455,"_31098":73399,"_21528":122911,"_5":14794,"_28279":122783,"_3062":122912},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3607":73456,"_31098":73399,"_21528":122914,"_5":14794,"_28279":122783,"_3062":122915},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3607":73457,"_31098":73399,"_21528":122917,"_5":14794,"_28279":122783,"_3062":122918},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3607":73458,"_31098":73399,"_21528":122920,"_5":14794,"_28279":122783,"_3062":122921},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3607":73459,"_31098":73399,"_21528":122923,"_5":14794,"_28279":122787,"_3062":122924},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3607":73460,"_31098":73399,"_21528":122926,"_5":14794,"_28279":122787,"_3062":122927},[],"Campo de `external_webhook_settings`",{"_3607":73461,"_31098":73399,"_21528":122929,"_5":14794,"_28279":122787,"_3062":122847},[],{"_3607":73462,"_31098":73399,"_21528":122931,"_5":14794,"_28279":122787,"_3062":53936},[],{"_3607":73463,"_31098":73399,"_21528":122933,"_5":14794,"_28279":122787,"_3062":122934},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3607":73464,"_31098":73399,"_21528":122936,"_5":14794,"_28279":122787,"_3062":53942},[],{"_3607":73465,"_31098":73399,"_21528":122938,"_5":14794,"_28279":122787,"_3062":122939},[],"`POST` o `PUT`; `POST` por defecto.",{"_3607":73466,"_31098":73399,"_21528":122941,"_5":14794,"_28279":122787,"_3062":53948},[],{"_3607":73467,"_31098":73399,"_21528":122943,"_5":14794,"_28279":122787,"_3062":122944},[],"Etiqueta usada en los logs del servicio.",{"_3607":73468,"_31098":73399,"_21528":122946,"_5":14794,"_28279":122787,"_3062":53954},[],{"_3607":73469,"_31098":73399,"_21528":122948,"_5":14794,"_28279":122787,"_3062":122949},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3607":73470,"_31098":73399,"_21528":122951,"_5":14794,"_28279":122787,"_3062":53960},[],{"_3607":73471,"_31098":73399,"_21528":122953,"_5":14794,"_28279":122787,"_3062":122954},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3607":73472,"_31098":73399,"_21528":122956,"_5":14794,"_28279":122787,"_3062":53966},[],{"_3607":73473,"_31098":73399,"_21528":122958,"_5":14794,"_28279":122787,"_3062":122959},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3607":73474,"_31098":73399,"_21528":122961,"_5":14794,"_28279":122787,"_3062":53972},[],{"_3607":73475,"_31098":73399,"_21528":122963,"_5":14794,"_28279":122787,"_3062":122964},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3607":73476,"_31098":73399,"_21528":122966,"_5":14794,"_28279":122787,"_3062":53978},[],{"_3607":73477,"_31098":73399,"_21528":122968,"_5":14794,"_28279":122787,"_3062":122969},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3607":73478,"_31098":73399,"_21528":122971,"_5":14794,"_28279":122787,"_3062":53984},[],{"_3607":73479,"_31098":73399,"_21528":122973,"_5":14794,"_28279":122787,"_3062":122974},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3607":73480,"_31098":73399,"_21528":122976,"_5":14794,"_28279":122787,"_3062":53990},[],{"_3607":73481,"_31098":73399,"_21528":122978,"_5":14794,"_28279":122787,"_3062":122979},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3607":73482,"_31098":73399,"_21528":122981,"_5":14794,"_28279":122787,"_3062":122982},[],"Reglas de esa configuración:",{"_3607":73483,"_31098":73399,"_21528":122984,"_5":14794,"_28279":122787,"_3062":122985},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3607":73484,"_31098":73399,"_21528":122987,"_5":14794,"_28279":122787,"_3062":122988},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3607":73485,"_31098":73399,"_21528":122990,"_5":14794,"_28279":122787,"_3062":122991},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3607":73486,"_31098":73399,"_21528":122993,"_5":14794,"_28279":122787,"_3062":122994},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3607":73487,"_31098":73399,"_21528":122996,"_5":14794,"_28279":122787,"_3062":122997},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3607":73488,"_31098":73399,"_21528":122999,"_5":14794,"_28279":122787,"_3062":123000},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3607":73489,"_31098":73399,"_21528":123002,"_5":14794,"_28279":122787,"_3062":123003},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3607":73490,"_31098":73399,"_21528":123005,"_5":14794,"_28279":122787,"_3062":123006},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3607":73491,"_31098":73399,"_21528":123008,"_5":14794,"_28279":122787,"_3062":123009},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3607":73492,"_31098":73399,"_21528":123011,"_5":14794,"_28279":122791,"_3062":123012},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3607":73493,"_31098":73399,"_21528":123014,"_5":14794,"_28279":122795,"_3062":123015},[],"Campo de `settings.reenrollment_settings`",{"_3607":73494,"_31098":73399,"_21528":123017,"_5":14794,"_28279":122795,"_3062":123018},[],"Función",{"_3607":73495,"_31098":73399,"_21528":123020,"_5":14794,"_28279":122795,"_3062":54034},[],{"_3607":73496,"_31098":73399,"_21528":123022,"_5":14794,"_28279":122795,"_3062":123023},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3607":73497,"_31098":73399,"_21528":123025,"_5":14794,"_28279":122795,"_3062":54040},[],{"_3607":73498,"_31098":73399,"_21528":123027,"_5":14794,"_28279":122795,"_3062":123028},[],"Umbral operativo preventivo de monitorización.",{"_3607":73499,"_31098":73399,"_21528":123030,"_5":14794,"_28279":122795,"_3062":54046},[],{"_3607":73500,"_31098":73399,"_21528":123032,"_5":14794,"_28279":122795,"_3062":123033},[],"Umbral operativo crítico de monitorización.",{"_3607":73501,"_31098":73399,"_21528":123035,"_5":14794,"_28279":122795,"_3062":54052},[],{"_3607":73502,"_31098":73399,"_21528":123037,"_5":14794,"_28279":122795,"_3062":123038},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3607":73503,"_31098":73399,"_21528":123040,"_5":14794,"_28279":122795,"_3062":54058},[],{"_3607":73504,"_31098":73399,"_21528":123042,"_5":14794,"_28279":122795,"_3062":123043},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3607":73505,"_31098":73399,"_21528":123045,"_5":14794,"_28279":122795,"_3062":54064},[],{"_3607":73506,"_31098":73399,"_21528":123047,"_5":14794,"_28279":122795,"_3062":123048},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3607":73507,"_31098":73399,"_21528":123050,"_5":14794,"_28279":122795,"_3062":123051},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3607":73508,"_31098":73399,"_21528":123053,"_5":14794,"_28279":122799,"_3062":123054},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3607":73509,"_31098":73399,"_21528":123056,"_5":14794,"_28279":122802,"_3062":120239},[],{"_3607":73510,"_31098":73399,"_21528":123058,"_5":14794,"_28279":122802,"_3062":123059},[],"Qué publica",{"_3607":73511,"_31098":73399,"_21528":123061,"_5":14794,"_28279":122802,"_3062":54081},[],{"_3607":73512,"_31098":73399,"_21528":123063,"_5":14794,"_28279":122802,"_3062":123064},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3607":73513,"_31098":73399,"_21528":123066,"_5":14794,"_28279":122802,"_3062":54087},[],{"_3607":73514,"_31098":73399,"_21528":123068,"_5":14794,"_28279":122802,"_3062":123069},[],"Certificado de la CA emisora seleccionada.",{"_3607":73515,"_31098":73399,"_21528":123071,"_5":14794,"_28279":122802,"_3062":54093},[],{"_3607":73516,"_31098":73399,"_21528":123073,"_5":14794,"_28279":122802,"_3062":123074},[],"Certificados de las CAs elegidas explícitamente.",{"_3607":73517,"_31098":73399,"_21528":123076,"_5":14794,"_28279":122802,"_3062":123077},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3607":73518,"_31098":73399,"_21528":123079,"_5":14794,"_28279":122806,"_3062":123080},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3607":73519,"_31098":73399,"_21528":123082,"_5":14794,"_28279":122806,"_3062":123083},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3607":73520,"_31098":73399,"_21528":123085,"_5":14794,"_28279":122806,"_3062":123086},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3607":73521,"_31098":73399,"_21528":123088,"_5":14794,"_28279":122810,"_3062":123089},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3607":73522,"_31098":73522,"_5":15159,"_3062":123091,"_31457":123092,"_21528":123093,"_28279":73522},"Integra el cliente EST",[50787,121341,53471,122486,122664],[],{"_3607":73523,"_31098":73522,"_21528":123095,"_5":14794,"_28279":73522,"_3062":123096},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3607":73524,"_31098":73522,"_5":31454,"_21528":123098,"_28279":123099,"_3062":119875},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3607":73525,"_31098":73522,"_5":31454,"_21528":123101,"_28279":123102,"_3062":123103},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3607":73526,"_31098":73522,"_5":31454,"_21528":123105,"_28279":123106,"_3062":123107},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3607":73527,"_31098":73522,"_5":31454,"_21528":123109,"_28279":123110,"_3062":123111},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3607":73528,"_31098":73522,"_5":31454,"_21528":123113,"_28279":123114,"_3062":123115},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3607":73529,"_31098":73522,"_5":31454,"_21528":123117,"_28279":123118,"_3062":123119},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3607":73530,"_31098":73522,"_21528":123121,"_5":14794,"_28279":73522,"_3062":123122},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3607":73531,"_31098":73522,"_21528":123124,"_5":14794,"_28279":123099,"_3062":123125},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3607":73532,"_31098":73522,"_21528":123127,"_5":14794,"_28279":123099,"_3062":123128},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3607":73533,"_31098":73522,"_21528":123130,"_5":14794,"_28279":123099,"_3062":123131},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3607":73534,"_31098":73522,"_21528":123133,"_5":14794,"_28279":123102,"_3062":123134},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3607":73535,"_31098":73522,"_21528":123136,"_5":14794,"_28279":123102,"_3062":123137},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3607":73536,"_31098":73522,"_21528":123139,"_5":14794,"_28279":123106,"_3062":123140},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3607":73537,"_31098":73522,"_21528":123142,"_5":14794,"_28279":123106,"_3062":123143},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3607":73538,"_31098":73522,"_21528":123145,"_5":14794,"_28279":123110,"_3062":123146},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3607":73539,"_31098":73522,"_21528":123148,"_5":14794,"_28279":123110,"_3062":123149},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3607":73540,"_31098":73522,"_21528":123151,"_5":14794,"_28279":123114,"_3062":123152},[],"Para el caso de una raíz que emite directamente:",{"_3607":73541,"_31098":73522,"_21528":123154,"_5":14794,"_28279":123114,"_3062":123155},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3607":73542,"_31098":73522,"_21528":123157,"_5":14794,"_28279":123114,"_3062":123158},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3607":73543,"_31098":73522,"_21528":123160,"_5":14794,"_28279":123118,"_3062":123161},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3607":73544,"_31098":73544,"_5":15159,"_3062":123163,"_31457":123164,"_21528":123165,"_28279":73544},"Referencia EST",[50787,121341,53471,122486,122664],[],{"_3607":73545,"_31098":73544,"_21528":123167,"_5":14794,"_28279":73544,"_3062":123168},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3607":73546,"_31098":73544,"_5":31454,"_21528":123170,"_28279":123171,"_3062":123172},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3607":73547,"_31098":73544,"_5":31454,"_21528":123174,"_28279":123175,"_3062":23330},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3607":73548,"_31098":73544,"_5":31454,"_21528":123177,"_28279":123178,"_3062":26824},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3607":73549,"_31098":73544,"_5":31454,"_21528":123180,"_28279":123181,"_3062":26831},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3607":73550,"_31098":73544,"_5":31454,"_21528":123183,"_28279":123184,"_3062":26093},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3607":73551,"_31098":73544,"_5":31454,"_21528":123186,"_28279":123187,"_3062":123188},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3607":73552,"_31098":73544,"_5":31454,"_21528":123190,"_28279":123191,"_3062":123192},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3607":73553,"_31098":73544,"_5":31454,"_21528":123194,"_28279":123195,"_3062":123196},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3607":73554,"_31098":73544,"_21528":123198,"_5":14794,"_28279":73544,"_3062":123199},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3607":73555,"_31098":73544,"_21528":123201,"_5":14794,"_28279":123171,"_3062":123202},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3607":73556,"_31098":73544,"_21528":123204,"_5":14794,"_28279":123171,"_3062":121101},[],{"_3607":73557,"_31098":73544,"_21528":123206,"_5":14794,"_28279":123171,"_3062":123207},[],"Método",{"_3607":73558,"_31098":73544,"_21528":123209,"_5":14794,"_28279":123171,"_3062":123210},[],"Autenticación y condición",{"_3607":73559,"_31098":73544,"_21528":123212,"_5":14794,"_28279":123171,"_3062":54236},[],{"_3607":73560,"_31098":73544,"_21528":123214,"_5":14794,"_28279":123171,"_3062":54239},[],{"_3607":73561,"_31098":73544,"_21528":123216,"_5":14794,"_28279":123171,"_3062":123217},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3607":73562,"_31098":73544,"_21528":123219,"_5":14794,"_28279":123171,"_3062":54245},[],{"_3607":73563,"_31098":73544,"_21528":123221,"_5":14794,"_28279":123171,"_3062":54248},[],{"_3607":73564,"_31098":73544,"_21528":123223,"_5":14794,"_28279":123171,"_3062":123224},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3607":73565,"_31098":73544,"_21528":123226,"_5":14794,"_28279":123171,"_3062":54254},[],{"_3607":73566,"_31098":73544,"_21528":123228,"_5":14794,"_28279":123171,"_3062":54248},[],{"_3607":73567,"_31098":73544,"_21528":123230,"_5":14794,"_28279":123171,"_3062":123231},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3607":73568,"_31098":73544,"_21528":123233,"_5":14794,"_28279":123171,"_3062":54262},[],{"_3607":73569,"_31098":73544,"_21528":123235,"_5":14794,"_28279":123171,"_3062":54248},[],{"_3607":73570,"_31098":73544,"_21528":123237,"_5":14794,"_28279":123171,"_3062":123238},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3607":73571,"_31098":73544,"_21528":123240,"_5":14794,"_28279":123171,"_3062":123241},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3607":73572,"_31098":73544,"_21528":123243,"_5":14794,"_28279":123175,"_3062":123244},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3607":73573,"_31098":73544,"_21528":123246,"_5":14794,"_28279":123175,"_3062":123247},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3607":73574,"_31098":73544,"_21528":123249,"_5":14794,"_28279":123178,"_3062":123250},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3607":73575,"_31098":73544,"_21528":123252,"_5":14794,"_28279":123178,"_3062":123253},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3607":73576,"_31098":73544,"_21528":123255,"_5":14794,"_28279":123181,"_3062":123256},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3607":73577,"_31098":73544,"_21528":123258,"_5":14794,"_28279":123181,"_3062":123259},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3607":73578,"_31098":73544,"_21528":123261,"_5":14794,"_28279":123184,"_3062":123262},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3607":73579,"_31098":73544,"_21528":123264,"_5":14794,"_28279":123184,"_3062":123265},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3607":73580,"_31098":73544,"_21528":123267,"_5":14794,"_28279":123187,"_3062":123268},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3607":73581,"_31098":73544,"_21528":123270,"_5":14794,"_28279":123187,"_3062":123271},[],"Parte",{"_3607":73582,"_31098":73544,"_21528":123273,"_5":14794,"_28279":123187,"_3062":123274},[],"Contenido tras decodificar su Base64",{"_3607":73583,"_31098":73544,"_21528":123276,"_5":14794,"_28279":123187,"_3062":54306},[],{"_3607":73584,"_31098":73544,"_21528":123278,"_5":14794,"_28279":123187,"_3062":123279},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3607":73585,"_31098":73544,"_21528":123281,"_5":14794,"_28279":123187,"_3062":54312},[],{"_3607":73586,"_31098":73544,"_21528":123283,"_5":14794,"_28279":123187,"_3062":123284},[],"PKCS#7 DER con el certificado emitido.",{"_3607":73587,"_31098":73544,"_21528":123286,"_5":14794,"_28279":123187,"_3062":123287},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3607":73588,"_31098":73544,"_21528":123289,"_5":14794,"_28279":123191,"_3062":123290},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3607":73589,"_31098":73544,"_21528":123292,"_5":14794,"_28279":123191,"_3062":123293},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3607":73590,"_31098":73544,"_21528":123295,"_5":14794,"_28279":123191,"_3062":123296},[],"Convierte y comprueba el resultado:",{"_3607":73591,"_31098":73544,"_21528":123298,"_5":14794,"_28279":123191,"_3062":123299},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3607":73592,"_31098":73544,"_21528":123301,"_5":14794,"_28279":123195,"_3062":123302},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3607":73593,"_31098":73544,"_21528":123304,"_5":14794,"_28279":123195,"_3062":123305},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3607":73594,"_31098":73594,"_5":15159,"_3062":122664,"_31457":123307,"_21528":123308,"_28279":73594},[50787,121341,53471,122486,122664],[],{"_3607":73595,"_31098":73594,"_21528":123310,"_5":14794,"_28279":73594,"_3062":123311},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3607":73596,"_31098":73594,"_5":31454,"_21528":123313,"_28279":123314,"_3062":123315},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3607":73597,"_31098":73594,"_5":31454,"_21528":123317,"_28279":123318,"_3062":123319},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3607":73598,"_31098":73594,"_5":31454,"_21528":123321,"_28279":123322,"_3062":123323},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3607":73599,"_31098":73594,"_5":31454,"_21528":123325,"_28279":123326,"_3062":123327},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3607":73600,"_31098":73594,"_21528":123329,"_5":14794,"_28279":73594,"_3062":123330},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3607":73601,"_31098":73594,"_21528":123332,"_5":14794,"_28279":123314,"_3062":123333},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3607":73602,"_31098":73594,"_21528":123335,"_5":14794,"_28279":123314,"_3062":123336},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3607":73603,"_31098":73594,"_21528":123338,"_5":14794,"_28279":123314,"_3062":123339},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3607":73604,"_31098":73594,"_21528":123341,"_5":14794,"_28279":123314,"_3062":123342},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3607":73605,"_31098":73594,"_21528":123344,"_5":14794,"_28279":123314,"_3062":123345},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3607":73606,"_31098":73594,"_21528":123347,"_5":14794,"_28279":123314,"_3062":123348},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3607":73607,"_31098":73594,"_21528":123350,"_5":14794,"_28279":123318,"_3062":123351},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3607":73608,"_31098":73594,"_21528":123353,"_5":14794,"_28279":123318,"_3062":123354},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3607":73609,"_31098":73594,"_21528":123356,"_5":14794,"_28279":123318,"_3062":123357},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3607":73610,"_31098":73594,"_21528":123359,"_5":14794,"_28279":123318,"_3062":123360},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3607":73611,"_31098":73594,"_21528":123362,"_5":14794,"_28279":123322,"_3062":123363},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3607":73612,"_31098":73594,"_21528":123365,"_5":14794,"_28279":123322,"_3062":123366},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3607":73613,"_31098":73594,"_21528":123368,"_5":14794,"_28279":123322,"_3062":123369},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3607":73614,"_31098":73594,"_21528":123371,"_5":14794,"_28279":123322,"_3062":123372},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3607":73615,"_31098":73594,"_21528":123374,"_5":14794,"_28279":123326,"_3062":123375},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3607":73616,"_31098":73594,"_21528":123377,"_5":14794,"_28279":123326,"_3062":123378},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3607":73617,"_31098":73617,"_5":15159,"_3062":123380,"_31457":123381,"_21528":123382,"_28279":73617},"Estrategias de aprovisionamiento",[50787,121341,53471,122486,122664],[],{"_3607":73618,"_31098":73617,"_21528":123384,"_5":14794,"_28279":73617,"_3062":123385},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3607":73619,"_31098":73617,"_5":31454,"_21528":123387,"_28279":123388,"_3062":123389},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3607":73620,"_31098":73617,"_5":31454,"_21528":123391,"_28279":123392,"_3062":123393},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3607":73621,"_31098":73617,"_5":31454,"_21528":123395,"_28279":123396,"_3062":123397},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3607":73622,"_31098":73617,"_5":31454,"_21528":123399,"_28279":123400,"_3062":123401},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3607":73623,"_31098":73617,"_5":31454,"_21528":123403,"_28279":123404,"_3062":123405},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3607":73624,"_31098":73617,"_21528":123407,"_5":14794,"_28279":73617,"_3062":123408},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3607":73625,"_31098":73617,"_21528":123410,"_5":14794,"_28279":123388,"_3062":123411},[],"Recorrido",{"_3607":73626,"_31098":73617,"_21528":123413,"_5":14794,"_28279":123388,"_3062":123414},[],"Cuándo existe el dispositivo",{"_3607":73627,"_31098":73617,"_21528":123416,"_5":14794,"_28279":123388,"_3062":123417},[],"Qué compruebas",{"_3607":73628,"_31098":73617,"_21528":123419,"_5":14794,"_28279":123388,"_3062":123420},[],"Asignación manual",{"_3607":73629,"_31098":73617,"_21528":123422,"_5":14794,"_28279":123388,"_3062":123423},[],"El operador lo crea antes de asociar un certificado.",{"_3607":73630,"_31098":73617,"_21528":123425,"_5":14794,"_28279":123388,"_3062":123426},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3607":73631,"_31098":73617,"_21528":123428,"_5":14794,"_28279":123388,"_3062":123429},[],"EST con `JITP`",{"_3607":73632,"_31098":73617,"_21528":123431,"_5":14794,"_28279":123388,"_3062":123432},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3607":73633,"_31098":73617,"_21528":123434,"_5":14794,"_28279":123388,"_3062":123435},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3607":73634,"_31098":73617,"_21528":123437,"_5":14794,"_28279":123388,"_3062":123438},[],"EST con `PRE_REGISTRATION`",{"_3607":73635,"_31098":73617,"_21528":123440,"_5":14794,"_28279":123388,"_3062":123441},[],"Debe existir antes de `/simpleenroll`.",{"_3607":73636,"_31098":73617,"_21528":123443,"_5":14794,"_28279":123388,"_3062":123444},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3607":73637,"_31098":73617,"_21528":123446,"_5":14794,"_28279":123388,"_3062":123447},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3607":73638,"_31098":73617,"_21528":123449,"_5":14794,"_28279":123388,"_3062":123450},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3607":73639,"_31098":73617,"_21528":123452,"_5":14794,"_28279":123392,"_3062":123453},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3607":73640,"_31098":73617,"_21528":123455,"_5":14794,"_28279":123392,"_3062":123456},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3607":73641,"_31098":73617,"_21528":123458,"_5":14794,"_28279":123392,"_3062":123459},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3607":73642,"_31098":73617,"_21528":123461,"_5":14794,"_28279":123396,"_3062":123462},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3607":73643,"_31098":73617,"_21528":123464,"_5":14794,"_28279":123396,"_3062":123465},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3607":73644,"_31098":73617,"_21528":123467,"_5":14794,"_28279":123396,"_3062":123468},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3607":73645,"_31098":73617,"_21528":123470,"_5":14794,"_28279":123396,"_3062":123471},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3607":73646,"_31098":73617,"_21528":123473,"_5":14794,"_28279":123396,"_3062":123474},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3607":73647,"_31098":73617,"_21528":123476,"_5":14794,"_28279":123396,"_3062":123477},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3607":73648,"_31098":73617,"_21528":123479,"_5":14794,"_28279":123400,"_3062":120239},[],{"_3607":73649,"_31098":73617,"_21528":123481,"_5":14794,"_28279":123400,"_3062":123482},[],"Material que atraviesa EST",{"_3607":73650,"_31098":73617,"_21528":123484,"_5":14794,"_28279":123400,"_3062":123485},[],"Clave generada por el dispositivo",{"_3607":73651,"_31098":73617,"_21528":123487,"_5":14794,"_28279":123400,"_3062":123488},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3607":73652,"_31098":73617,"_21528":123490,"_5":14794,"_28279":123400,"_3062":123491},[],"Clave ya disponible en el dispositivo",{"_3607":73653,"_31098":73617,"_21528":123493,"_5":14794,"_28279":123400,"_3062":123494},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3607":73654,"_31098":73617,"_21528":123496,"_5":14794,"_28279":123400,"_3062":53793},[],{"_3607":73655,"_31098":73617,"_21528":123498,"_5":14794,"_28279":123400,"_3062":123499},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3607":73656,"_31098":73617,"_21528":123501,"_5":14794,"_28279":123400,"_3062":123502},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3607":73657,"_31098":73617,"_21528":123504,"_5":14794,"_28279":123404,"_3062":123505},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3607":73658,"_31098":73658,"_5":15159,"_3062":123507,"_31457":123508,"_21528":123509,"_28279":73658},"Renovación y recuperación",[50787,121341,53471,122486,122664],[],{"_3607":73659,"_31098":73658,"_21528":123511,"_5":14794,"_28279":73658,"_3062":123512},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3607":73660,"_31098":73658,"_5":31454,"_21528":123514,"_28279":123515,"_3062":123516},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3607":73661,"_31098":73658,"_5":31454,"_21528":123518,"_28279":123519,"_3062":123520},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3607":73662,"_31098":73658,"_5":31454,"_21528":123522,"_28279":123523,"_3062":123524},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3607":73663,"_31098":73658,"_5":31454,"_21528":123526,"_28279":123527,"_3062":123528},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3607":73664,"_31098":73658,"_5":31454,"_21528":123530,"_28279":123531,"_3062":123532},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3607":73665,"_31098":73658,"_21528":123534,"_5":14794,"_28279":73658,"_3062":123535},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3607":73666,"_31098":73658,"_21528":123537,"_5":14794,"_28279":123515,"_3062":123538},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3607":73667,"_31098":73658,"_21528":123540,"_5":14794,"_28279":123515,"_3062":123541},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3607":73668,"_31098":73658,"_21528":123543,"_5":14794,"_28279":123515,"_3062":123544},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3607":73669,"_31098":73658,"_21528":123546,"_5":14794,"_28279":123515,"_3062":123547},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3607":73670,"_31098":73658,"_21528":123549,"_5":14794,"_28279":123519,"_3062":123550},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3607":73671,"_31098":73658,"_21528":123552,"_5":14794,"_28279":123519,"_3062":123553},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3607":73672,"_31098":73658,"_21528":123555,"_5":14794,"_28279":123523,"_3062":123556},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3607":73673,"_31098":73658,"_21528":123558,"_5":14794,"_28279":123523,"_3062":123559},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3607":73674,"_31098":73658,"_21528":123561,"_5":14794,"_28279":123523,"_3062":123562},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3607":73675,"_31098":73658,"_21528":123564,"_5":14794,"_28279":123527,"_3062":123565},[],"Situación",{"_3607":73676,"_31098":73658,"_21528":123567,"_5":14794,"_28279":123527,"_3062":123568},[],"Procedimiento",{"_3607":73677,"_31098":73658,"_21528":123570,"_5":14794,"_28279":123527,"_3062":123571},[],"Certificado vigente, fuera de ventana",{"_3607":73678,"_31098":73658,"_21528":123573,"_5":14794,"_28279":123527,"_3062":123574},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3607":73679,"_31098":73658,"_21528":123576,"_5":14794,"_28279":123527,"_3062":123577},[],"Certificado vencido, clave disponible",{"_3607":73680,"_31098":73658,"_21528":123579,"_5":14794,"_28279":123527,"_3062":123580},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3607":73681,"_31098":73658,"_21528":123582,"_5":14794,"_28279":123527,"_3062":123583},[],"Renovación por webhook o `NO_AUTH`",{"_3607":73682,"_31098":73658,"_21528":123585,"_5":14794,"_28279":123527,"_3062":123586},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3607":73683,"_31098":73658,"_21528":123588,"_5":14794,"_28279":123527,"_3062":123589},[],"Clave perdida o inaccesible",{"_3607":73684,"_31098":73658,"_21528":123591,"_5":14794,"_28279":123527,"_3062":123592},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3607":73685,"_31098":73658,"_21528":123594,"_5":14794,"_28279":123527,"_3062":123595},[],"Identidad actual revocada",{"_3607":73686,"_31098":73658,"_21528":123597,"_5":14794,"_28279":123527,"_3062":123598},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3607":73687,"_31098":73658,"_21528":123600,"_5":14794,"_28279":123527,"_3062":123601},[],"Dispositivo sin identidad",{"_3607":73688,"_31098":73658,"_21528":123603,"_5":14794,"_28279":123527,"_3062":123604},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3607":73689,"_31098":73658,"_21528":123606,"_5":14794,"_28279":123527,"_3062":123607},[],"Dispositivo retirado",{"_3607":73690,"_31098":73658,"_21528":123609,"_5":14794,"_28279":123527,"_3062":123610},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3607":73691,"_31098":73658,"_21528":123612,"_5":14794,"_28279":123527,"_3062":123613},[],"Timeout, HTTP 500 o fallo de instalación",{"_3607":73692,"_31098":73658,"_21528":123615,"_5":14794,"_28279":123527,"_3062":123616},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3607":73693,"_31098":73658,"_21528":123618,"_5":14794,"_28279":123531,"_3062":123619},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3607":73694,"_31098":73658,"_21528":123621,"_5":14794,"_28279":123531,"_3062":123622},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3607":73695,"_31098":73695,"_5":15159,"_3062":123624,"_31457":123625,"_21528":123626,"_28279":73695},"Diagnóstico de enrolamiento",[50787,121341,53471,122486,122664],[],{"_3607":73696,"_31098":73695,"_21528":123628,"_5":14794,"_28279":73695,"_3062":123629},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3607":73697,"_31098":73695,"_5":31454,"_21528":123631,"_28279":123632,"_3062":123633},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3607":73698,"_31098":73695,"_5":31454,"_21528":123635,"_28279":123636,"_3062":123637},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3607":73699,"_31098":73695,"_5":31454,"_21528":123639,"_28279":123640,"_3062":123196},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3607":73700,"_31098":73695,"_5":31454,"_21528":123642,"_28279":123643,"_3062":123644},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3607":73701,"_31098":73695,"_21528":123646,"_5":14794,"_28279":73695,"_3062":123647},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3607":73702,"_31098":73695,"_21528":123649,"_5":14794,"_28279":123636,"_3062":123650},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3607":73703,"_31098":73695,"_21528":123652,"_5":14794,"_28279":123636,"_3062":123653},[],"Síntoma o mensaje",{"_3607":73704,"_31098":73695,"_21528":123655,"_5":14794,"_28279":123636,"_3062":123656},[],"Qué revisar",{"_3607":73705,"_31098":73695,"_21528":123658,"_5":14794,"_28279":123636,"_3062":123659},[],"curl rechaza TLS, nombre o emisor",{"_3607":73706,"_31098":73695,"_21528":123661,"_5":14794,"_28279":123636,"_3062":123662},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3607":73707,"_31098":73695,"_21528":123664,"_5":14794,"_28279":123636,"_3062":123665},[],"404 o APS ausente",{"_3607":73708,"_31098":73695,"_21528":123667,"_5":14794,"_28279":123636,"_3062":123668},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3607":73709,"_31098":73695,"_21528":123670,"_5":14794,"_28279":123636,"_3062":123671},[],"400, error de CSR o formato",{"_3607":73710,"_31098":73695,"_21528":123673,"_5":14794,"_28279":123636,"_3062":123674},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3607":73711,"_31098":73695,"_21528":123676,"_5":14794,"_28279":123636,"_3062":123677},[],"Credencial ausente o certificado no válido",{"_3607":73712,"_31098":73695,"_21528":123679,"_5":14794,"_28279":123636,"_3062":123680},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3607":73713,"_31098":73695,"_21528":123682,"_5":14794,"_28279":123636,"_3062":123683},[],"Webhook deniega, expira o responde sin autorización",{"_3607":73714,"_31098":73695,"_21528":123685,"_5":14794,"_28279":123636,"_3062":123686},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3607":73715,"_31098":73695,"_21528":123688,"_5":14794,"_28279":123636,"_3062":54719},[],{"_3607":73716,"_31098":73695,"_21528":123690,"_5":14794,"_28279":123636,"_3062":123691},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3607":73717,"_31098":73695,"_21528":123693,"_5":14794,"_28279":123636,"_3062":54725},[],{"_3607":73718,"_31098":73695,"_21528":123695,"_5":14794,"_28279":123636,"_3062":123696},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3607":73719,"_31098":73695,"_21528":123698,"_5":14794,"_28279":123636,"_3062":54731},[],{"_3607":73720,"_31098":73695,"_21528":123700,"_5":14794,"_28279":123636,"_3062":123701},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3607":73721,"_31098":73695,"_21528":123703,"_5":14794,"_28279":123636,"_3062":54737},[],{"_3607":73722,"_31098":73695,"_21528":123705,"_5":14794,"_28279":123636,"_3062":123706},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3607":73723,"_31098":73695,"_21528":123708,"_5":14794,"_28279":123636,"_3062":54743},[],{"_3607":73724,"_31098":73695,"_21528":123710,"_5":14794,"_28279":123636,"_3062":123711},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3607":73725,"_31098":73695,"_21528":123713,"_5":14794,"_28279":123636,"_3062":123714},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3607":73726,"_31098":73695,"_21528":123716,"_5":14794,"_28279":123636,"_3062":123717},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3607":73727,"_31098":73695,"_21528":123719,"_5":14794,"_28279":123636,"_3062":123720},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3607":73728,"_31098":73695,"_21528":123722,"_5":14794,"_28279":123636,"_3062":123723},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3607":73729,"_31098":73695,"_21528":123725,"_5":14794,"_28279":123636,"_3062":54761},[],{"_3607":73730,"_31098":73695,"_21528":123727,"_5":14794,"_28279":123636,"_3062":123728},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3607":73731,"_31098":73695,"_21528":123730,"_5":14794,"_28279":123636,"_3062":54767},[],{"_3607":73732,"_31098":73695,"_21528":123732,"_5":14794,"_28279":123636,"_3062":123733},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3607":73733,"_31098":73695,"_21528":123735,"_5":14794,"_28279":123636,"_3062":123736},[],"DMS propietario distinto",{"_3607":73734,"_31098":73695,"_21528":123738,"_5":14794,"_28279":123636,"_3062":123739},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3607":73735,"_31098":73695,"_21528":123741,"_5":14794,"_28279":123636,"_3062":54779},[],{"_3607":73736,"_31098":73695,"_21528":123743,"_5":14794,"_28279":123636,"_3062":123744},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3607":73737,"_31098":73695,"_21528":123746,"_5":14794,"_28279":123636,"_3062":54785},[],{"_3607":73738,"_31098":73695,"_21528":123748,"_5":14794,"_28279":123636,"_3062":123749},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3607":73739,"_31098":73695,"_21528":123751,"_5":14794,"_28279":123636,"_3062":123752},[],"Certificado actual revocado",{"_3607":73740,"_31098":73695,"_21528":123754,"_5":14794,"_28279":123636,"_3062":123755},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3607":73741,"_31098":73695,"_21528":123757,"_5":14794,"_28279":123636,"_3062":123758},[],"Error de CA, perfil o firma",{"_3607":73742,"_31098":73695,"_21528":123760,"_5":14794,"_28279":123636,"_3062":123761},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3607":73743,"_31098":73695,"_21528":123763,"_5":14794,"_28279":123636,"_3062":123764},[],"HTTP 200 sin conexión del dispositivo",{"_3607":73744,"_31098":73695,"_21528":123766,"_5":14794,"_28279":123636,"_3062":123767},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3607":73745,"_31098":73695,"_21528":123769,"_5":14794,"_28279":123636,"_3062":123770},[],"Timeout o error después de emitir",{"_3607":73746,"_31098":73695,"_21528":123772,"_5":14794,"_28279":123636,"_3062":123773},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3607":73747,"_31098":73695,"_21528":123775,"_5":14794,"_28279":123640,"_3062":123776},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3607":73748,"_31098":73695,"_21528":123778,"_5":14794,"_28279":123640,"_3062":123779},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3607":73749,"_31098":73695,"_21528":123781,"_5":14794,"_28279":123643,"_3062":123782},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3607":73750,"_31098":73695,"_21528":123784,"_5":14794,"_28279":123643,"_3062":123785},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3607":73751,"_31098":73695,"_21528":123787,"_5":14794,"_28279":123643,"_3062":123788},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3607":73752,"_31098":73695,"_21528":123790,"_5":14794,"_28279":123643,"_3062":123791},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3607":73753,"_31098":73695,"_21528":123793,"_5":14794,"_28279":123643,"_3062":123794},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3607":73754,"_31098":73695,"_21528":123796,"_5":14794,"_28279":123643,"_3062":123797},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3607":73755,"_31098":73695,"_21528":123799,"_5":14794,"_28279":123643,"_3062":123800},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3607":73756,"_31098":73756,"_5":15159,"_3062":123802,"_31457":123803,"_21528":123804,"_28279":73756},"Distribución y actualización de confianza",[50787,121341,53471,122486,122664],[],{"_3607":73757,"_31098":73756,"_21528":123806,"_5":14794,"_28279":73756,"_3062":123807},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3607":73758,"_31098":73756,"_5":31454,"_21528":123809,"_28279":123810,"_3062":123811},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3607":73759,"_31098":73756,"_5":31454,"_21528":123813,"_28279":123814,"_3062":123815},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3607":73760,"_31098":73756,"_5":31454,"_21528":123817,"_28279":123818,"_3062":123819},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3607":73761,"_31098":73756,"_5":31454,"_21528":123821,"_28279":123822,"_3062":123823},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3607":73762,"_31098":73756,"_5":31454,"_21528":123825,"_28279":123826,"_3062":123827},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3607":73763,"_31098":73756,"_21528":123829,"_5":14794,"_28279":73756,"_3062":123830},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3607":73764,"_31098":73756,"_21528":123832,"_5":14794,"_28279":123810,"_3062":123833},[],"Relación",{"_3607":73765,"_31098":73756,"_21528":123835,"_5":14794,"_28279":123810,"_3062":123836},[],"Material que prepara el responsable",{"_3607":73766,"_31098":73756,"_21528":123838,"_5":14794,"_28279":123810,"_3062":123839},[],"Dispositivo → servidor EST",{"_3607":73767,"_31098":73756,"_21528":123841,"_5":14794,"_28279":123810,"_3062":123842},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3607":73768,"_31098":73756,"_21528":123844,"_5":14794,"_28279":123810,"_3062":123845},[],"DMS → solicitante",{"_3607":73769,"_31098":73756,"_21528":123847,"_5":14794,"_28279":123810,"_3062":123848},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3607":73770,"_31098":73756,"_21528":123850,"_5":14794,"_28279":123810,"_3062":123851},[],"Consumidor → dispositivo",{"_3607":73771,"_31098":73756,"_21528":123853,"_5":14794,"_28279":123810,"_3062":123854},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3607":73772,"_31098":73756,"_21528":123856,"_5":14794,"_28279":123810,"_3062":123857},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3607":73773,"_31098":73756,"_21528":123859,"_5":14794,"_28279":123814,"_3062":123860},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3607":73774,"_31098":73756,"_21528":123862,"_5":14794,"_28279":123814,"_3062":123863},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3607":73775,"_31098":73756,"_21528":123865,"_5":14794,"_28279":123818,"_3062":123866},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3607":73776,"_31098":73756,"_21528":123868,"_5":14794,"_28279":123818,"_3062":123869},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3607":73777,"_31098":73756,"_21528":123871,"_5":14794,"_28279":123818,"_3062":123872},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3607":73778,"_31098":73756,"_21528":123874,"_5":14794,"_28279":123818,"_3062":123875},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3607":73779,"_31098":73756,"_21528":123877,"_5":14794,"_28279":123818,"_3062":123878},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3607":73780,"_31098":73756,"_21528":123880,"_5":14794,"_28279":123818,"_3062":123881},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3607":73781,"_31098":73756,"_21528":123883,"_5":14794,"_28279":123822,"_3062":123884},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3607":73782,"_31098":73756,"_21528":123886,"_5":14794,"_28279":123822,"_3062":123887},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3607":73783,"_31098":73756,"_21528":123889,"_5":14794,"_28279":123822,"_3062":123890},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3607":73784,"_31098":73756,"_21528":123892,"_5":14794,"_28279":123826,"_3062":123893},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3607":73785,"_31098":73785,"_5":15159,"_3062":54934,"_31457":123895,"_21528":123897,"_28279":73785},[50787,121341,53471,122486,123896],"Integraciones",[],{"_3607":73786,"_31098":73785,"_21528":123899,"_5":14794,"_28279":73785,"_3062":123900},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3607":73787,"_31098":73785,"_5":31454,"_21528":123902,"_28279":123903,"_3062":123904},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3607":73788,"_31098":73785,"_5":31454,"_21528":123906,"_28279":123907,"_3062":123908},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3607":73789,"_31098":73785,"_5":31454,"_21528":123910,"_28279":123911,"_3062":123912},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3607":73790,"_31098":73785,"_5":31454,"_21528":123914,"_28279":123915,"_3062":123916},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3607":73791,"_31098":73785,"_5":31454,"_21528":123918,"_28279":123919,"_3062":123920},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3607":73792,"_31098":73785,"_5":31454,"_21528":123922,"_28279":123923,"_3062":123924},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3607":73793,"_31098":73785,"_5":31454,"_21528":123926,"_28279":123927,"_3062":123928},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3607":73794,"_31098":73785,"_5":31454,"_21528":123930,"_28279":123931,"_3062":123932},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3607":73795,"_31098":73785,"_5":31454,"_21528":123934,"_28279":123935,"_3062":54976},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3607":73796,"_31098":73785,"_5":31454,"_21528":123937,"_28279":123938,"_3062":54980},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3607":73797,"_31098":73785,"_5":31454,"_21528":123940,"_28279":123941,"_3062":123942},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3607":73798,"_31098":73785,"_5":31454,"_21528":123944,"_28279":123945,"_3062":123946},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3607":73799,"_31098":73785,"_5":31454,"_21528":123948,"_28279":123949,"_3062":123950},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3607":73800,"_31098":73785,"_5":31454,"_21528":123952,"_28279":123953,"_3062":123954},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3607":73801,"_31098":73785,"_5":31454,"_21528":123956,"_28279":123957,"_3062":123958},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3607":73802,"_31098":73785,"_5":31454,"_21528":123960,"_28279":123961,"_3062":123962},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3607":73803,"_31098":73785,"_5":31454,"_21528":123964,"_28279":123965,"_3062":123966},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3607":73804,"_31098":73785,"_5":31454,"_21528":123968,"_28279":123969,"_3062":123970},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3607":73805,"_31098":73785,"_5":31454,"_21528":123972,"_28279":123973,"_3062":123974},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3607":73806,"_31098":73785,"_5":31454,"_21528":123976,"_28279":123977,"_3062":123978},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3607":73807,"_31098":73785,"_5":31454,"_21528":123980,"_28279":123981,"_3062":123982},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3607":73808,"_31098":73785,"_5":31454,"_21528":123984,"_28279":123985,"_3062":123986},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3607":73809,"_31098":73785,"_5":31454,"_21528":123988,"_28279":123989,"_3062":123990},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3607":73810,"_31098":73785,"_5":31454,"_21528":123992,"_28279":123993,"_3062":123994},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3607":73811,"_31098":73785,"_5":31454,"_21528":123996,"_28279":123997,"_3062":123998},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3607":73812,"_31098":73785,"_21528":124000,"_5":14794,"_28279":73785,"_3062":124001},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3607":73813,"_31098":73785,"_21528":124003,"_5":14794,"_28279":73785,"_3062":124004},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3607":73814,"_31098":73785,"_21528":124006,"_5":14794,"_28279":73785,"_3062":124007},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3607":73815,"_31098":73785,"_21528":124009,"_5":14794,"_28279":123903,"_3062":124010},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3607":73816,"_31098":73785,"_21528":124012,"_5":14794,"_28279":123903,"_3062":124013},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3607":73817,"_31098":73785,"_21528":124015,"_5":14794,"_28279":123903,"_3062":124016},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3607":73818,"_31098":73785,"_21528":124018,"_5":14794,"_28279":123903,"_3062":124019},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3607":73819,"_31098":73785,"_21528":124021,"_5":14794,"_28279":123907,"_3062":124022},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3607":73820,"_31098":73785,"_21528":124024,"_5":14794,"_28279":123911,"_3062":124025},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3607":73821,"_31098":73785,"_21528":124027,"_5":14794,"_28279":123911,"_3062":124028},[],"Acción IAM",{"_3607":73822,"_31098":73785,"_21528":124030,"_5":14794,"_28279":123911,"_3062":120245},[],{"_3607":73823,"_31098":73785,"_21528":124032,"_5":14794,"_28279":123911,"_3062":55075},[],{"_3607":73824,"_31098":73785,"_21528":124034,"_5":14794,"_28279":123911,"_3062":124035},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3607":73825,"_31098":73785,"_21528":124037,"_5":14794,"_28279":123911,"_3062":55081},[],{"_3607":73826,"_31098":73785,"_21528":124039,"_5":14794,"_28279":123911,"_3062":124040},[],"Registrar la CA en AWS IoT",{"_3607":73827,"_31098":73785,"_21528":124042,"_5":14794,"_28279":123911,"_3062":55087},[],{"_3607":73828,"_31098":73785,"_21528":124044,"_5":14794,"_28279":123911,"_3062":124045},[],"Consultar el estado del registro de la CA",{"_3607":73829,"_31098":73785,"_21528":124047,"_5":14794,"_28279":123911,"_3062":55093},[],{"_3607":73830,"_31098":73785,"_21528":124049,"_5":14794,"_28279":123911,"_3062":124050},[],"Crear o actualizar Things en IoT Core",{"_3607":73831,"_31098":73785,"_21528":124052,"_5":14794,"_28279":123911,"_3062":55099},[],{"_3607":73832,"_31098":73785,"_21528":124054,"_5":14794,"_28279":123911,"_3062":124055},[],"Aprovisionar Things mediante plantilla",{"_3607":73833,"_31098":73785,"_21528":124057,"_5":14794,"_28279":123911,"_3062":55105},[],{"_3607":73834,"_31098":73785,"_21528":124059,"_5":14794,"_28279":123911,"_3062":124060},[],"Registrar certificados de dispositivo",{"_3607":73835,"_31098":73785,"_21528":124062,"_5":14794,"_28279":123911,"_3062":55111},[],{"_3607":73836,"_31098":73785,"_21528":124064,"_5":14794,"_28279":123911,"_3062":124065},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3607":73837,"_31098":73785,"_21528":124067,"_5":14794,"_28279":123911,"_3062":55117},[],{"_3607":73838,"_31098":73785,"_21528":124069,"_5":14794,"_28279":123911,"_3062":124070},[],"Crear y adjuntar políticas IoT",{"_3607":73839,"_31098":73785,"_21528":124072,"_5":14794,"_28279":123911,"_3062":55123},[],{"_3607":73840,"_31098":73785,"_21528":124074,"_5":14794,"_28279":123911,"_3062":124075},[],"Gestionar grupos de Things",{"_3607":73841,"_31098":73785,"_21528":124077,"_5":14794,"_28279":123911,"_3062":55129},[],{"_3607":73842,"_31098":73785,"_21528":124079,"_5":14794,"_28279":123911,"_3062":124080},[],"Crear plantillas JITP",{"_3607":73843,"_31098":73785,"_21528":124082,"_5":14794,"_28279":123911,"_3062":55135},[],{"_3607":73844,"_31098":73785,"_21528":124084,"_5":14794,"_28279":123911,"_3062":124085},[],"Leer y escribir el Device Shadow",{"_3607":73845,"_31098":73785,"_21528":124087,"_5":14794,"_28279":123911,"_3062":124088},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3607":73846,"_31098":73785,"_21528":124090,"_5":14794,"_28279":123915,"_3062":124091},[],"Parámetro",{"_3607":73847,"_31098":73785,"_21528":124093,"_5":14794,"_28279":123915,"_3062":124094},[],"Tipo",{"_3607":73848,"_31098":73785,"_21528":124096,"_5":14794,"_28279":123915,"_3062":124097},[],"Requerido",{"_3607":73849,"_31098":73785,"_21528":124099,"_5":14794,"_28279":123915,"_3062":124100},[],"Descripción",{"_3607":73850,"_31098":73785,"_21528":124102,"_5":14794,"_28279":123915,"_3062":55156},[],{"_3607":73851,"_31098":73785,"_21528":124104,"_5":14794,"_28279":123915,"_3062":25703},[],{"_3607":73852,"_31098":73785,"_21528":124106,"_5":14794,"_28279":123915,"_3062":124107},[],"Sí",{"_3607":73853,"_31098":73785,"_21528":124109,"_5":14794,"_28279":123915,"_3062":124110},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3607":73854,"_31098":73785,"_21528":124112,"_5":14794,"_28279":123915,"_3062":55167},[],{"_3607":73855,"_31098":73785,"_21528":124114,"_5":14794,"_28279":123915,"_3062":25703},[],{"_3607":73856,"_31098":73785,"_21528":124116,"_5":14794,"_28279":123915,"_3062":124107},[],{"_3607":73857,"_31098":73785,"_21528":124118,"_5":14794,"_28279":123915,"_3062":124119},[],"Región AWS donde opera el conector.",{"_3607":73858,"_31098":73785,"_21528":124121,"_5":14794,"_28279":123915,"_3062":55177},[],{"_3607":73859,"_31098":73785,"_21528":124123,"_5":14794,"_28279":123915,"_3062":25703},[],{"_3607":73860,"_31098":73785,"_21528":124125,"_5":14794,"_28279":123915,"_3062":124107},[],{"_3607":73861,"_31098":73785,"_21528":124127,"_5":14794,"_28279":123915,"_3062":124128},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3607":73862,"_31098":73785,"_21528":124130,"_5":14794,"_28279":123915,"_3062":55187},[],{"_3607":73863,"_31098":73785,"_21528":124132,"_5":14794,"_28279":123915,"_3062":25703},[],{"_3607":73864,"_31098":73785,"_21528":124134,"_5":14794,"_28279":123915,"_3062":124135},[],"Solo con `auth_method=static`",{"_3607":73865,"_31098":73785,"_21528":124137,"_5":14794,"_28279":123915,"_3062":124138},[],"Clave de acceso AWS.",{"_3607":73866,"_31098":73785,"_21528":124140,"_5":14794,"_28279":123915,"_3062":55198},[],{"_3607":73867,"_31098":73785,"_21528":124142,"_5":14794,"_28279":123915,"_3062":25703},[],{"_3607":73868,"_31098":73785,"_21528":124144,"_5":14794,"_28279":123915,"_3062":124135},[],{"_3607":73869,"_31098":73785,"_21528":124146,"_5":14794,"_28279":123915,"_3062":124147},[],"Clave secreta AWS.",{"_3607":73870,"_31098":73785,"_21528":124149,"_5":14794,"_28279":123915,"_3062":55208},[],{"_3607":73871,"_31098":73785,"_21528":124151,"_5":14794,"_28279":123915,"_3062":25703},[],{"_3607":73872,"_31098":73785,"_21528":124153,"_5":14794,"_28279":123915,"_3062":55213},[],{"_3607":73873,"_31098":73785,"_21528":124155,"_5":14794,"_28279":123915,"_3062":124156},[],"Token de sesión (con `auth_method=static`).",{"_3607":73874,"_31098":73785,"_21528":124158,"_5":14794,"_28279":123915,"_3062":55219},[],{"_3607":73875,"_31098":73785,"_21528":124160,"_5":14794,"_28279":123915,"_3062":25703},[],{"_3607":73876,"_31098":73785,"_21528":124162,"_5":14794,"_28279":123915,"_3062":124163},[],"Solo con `auth_method=role`",{"_3607":73877,"_31098":73785,"_21528":124165,"_5":14794,"_28279":123915,"_3062":124166},[],"ARN del rol a asumir.",{"_3607":73878,"_31098":73785,"_21528":124168,"_5":14794,"_28279":123915,"_3062":55230},[],{"_3607":73879,"_31098":73785,"_21528":124170,"_5":14794,"_28279":123915,"_3062":25703},[],{"_3607":73880,"_31098":73785,"_21528":124172,"_5":14794,"_28279":123915,"_3062":55213},[],{"_3607":73881,"_31098":73785,"_21528":124174,"_5":14794,"_28279":123915,"_3062":124175},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3607":73882,"_31098":73785,"_21528":124177,"_5":14794,"_28279":123915,"_3062":55240},[],{"_3607":73883,"_31098":73785,"_21528":124179,"_5":14794,"_28279":123915,"_3062":92578},[],{"_3607":73884,"_31098":73785,"_21528":124181,"_5":14794,"_28279":123915,"_3062":124107},[],{"_3607":73885,"_31098":73785,"_21528":124183,"_5":14794,"_28279":123915,"_3062":124184},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3607":73886,"_31098":73785,"_21528":124186,"_5":14794,"_28279":123915,"_3062":55250},[],{"_3607":73887,"_31098":73785,"_21528":124188,"_5":14794,"_28279":123915,"_3062":25703},[],{"_3607":73888,"_31098":73785,"_21528":124190,"_5":14794,"_28279":123915,"_3062":124107},[],{"_3607":73889,"_31098":73785,"_21528":124192,"_5":14794,"_28279":123915,"_3062":124193},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3607":73890,"_31098":73785,"_21528":124195,"_5":14794,"_28279":123915,"_3062":55260},[],{"_3607":73891,"_31098":73785,"_21528":124197,"_5":14794,"_28279":123915,"_3062":25703},[],{"_3607":73892,"_31098":73785,"_21528":124199,"_5":14794,"_28279":123915,"_3062":124107},[],{"_3607":73893,"_31098":73785,"_21528":124201,"_5":14794,"_28279":123915,"_3062":124202},[],"URL HTTP del Device Manager de Lamassu.",{"_3607":73894,"_31098":73785,"_21528":124204,"_5":14794,"_28279":123915,"_3062":55270},[],{"_3607":73895,"_31098":73785,"_21528":124206,"_5":14794,"_28279":123915,"_3062":25703},[],{"_3607":73896,"_31098":73785,"_21528":124208,"_5":14794,"_28279":123915,"_3062":124107},[],{"_3607":73897,"_31098":73785,"_21528":124210,"_5":14794,"_28279":123915,"_3062":124211},[],"URL HTTP del servicio de CA de Lamassu.",{"_3607":73898,"_31098":73785,"_21528":124213,"_5":14794,"_28279":123919,"_3062":124214},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3607":73899,"_31098":73785,"_21528":124216,"_5":14794,"_28279":123919,"_3062":124217},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3607":73900,"_31098":73785,"_21528":124219,"_5":14794,"_28279":123919,"_3062":124220},[],"Tipo de CloudEvent",{"_3607":73901,"_31098":73785,"_21528":124222,"_5":14794,"_28279":123919,"_3062":124223},[],"Recurso en Lamassu",{"_3607":73902,"_31098":73785,"_21528":124225,"_5":14794,"_28279":123919,"_3062":124226},[],"Recurso AWS",{"_3607":73903,"_31098":73785,"_21528":124228,"_5":14794,"_28279":123919,"_3062":124229},[],"Acciones IAM",{"_3607":73904,"_31098":73785,"_21528":124231,"_5":14794,"_28279":123919,"_3062":124232},[],"Llamadas AWS y efecto",{"_3607":73905,"_31098":73785,"_21528":124234,"_5":14794,"_28279":123919,"_3062":124235},[],"Dónde en esta página",{"_3607":73906,"_31098":73785,"_21528":124237,"_5":14794,"_28279":123919,"_3062":55304},[],{"_3607":73907,"_31098":73785,"_21528":124239,"_5":14794,"_28279":123919,"_3062":55307},[],{"_3607":73908,"_31098":73785,"_21528":124241,"_5":14794,"_28279":123919,"_3062":55310},[],{"_3607":73909,"_31098":73785,"_21528":124243,"_5":14794,"_28279":123919,"_3062":55313},[],{"_3607":73910,"_31098":73785,"_21528":124245,"_5":14794,"_28279":123919,"_3062":124246},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3607":73911,"_31098":73785,"_21528":124248,"_5":14794,"_28279":123919,"_3062":123932},[],{"_3607":73912,"_31098":73785,"_21528":124250,"_5":14794,"_28279":123919,"_3062":55321},[],{"_3607":73913,"_31098":73785,"_21528":124252,"_5":14794,"_28279":123919,"_3062":55324},[],{"_3607":73914,"_31098":73785,"_21528":124254,"_5":14794,"_28279":123919,"_3062":55327},[],{"_3607":73915,"_31098":73785,"_21528":124256,"_5":14794,"_28279":123919,"_3062":55330},[],{"_3607":73916,"_31098":73785,"_21528":124258,"_5":14794,"_28279":123919,"_3062":124259},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3607":73917,"_31098":73785,"_21528":124261,"_5":14794,"_28279":123919,"_3062":123958},[],{"_3607":73918,"_31098":73785,"_21528":124263,"_5":14794,"_28279":123919,"_3062":55338},[],{"_3607":73919,"_31098":73785,"_21528":124265,"_5":14794,"_28279":123919,"_3062":124266},[],"Dispositivo",{"_3607":73920,"_31098":73785,"_21528":124268,"_5":14794,"_28279":123919,"_3062":55344},[],{"_3607":73921,"_31098":73785,"_21528":124270,"_5":14794,"_28279":123919,"_3062":55347},[],{"_3607":73922,"_31098":73785,"_21528":124272,"_5":14794,"_28279":123919,"_3062":124273},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3607":73923,"_31098":73785,"_21528":124275,"_5":14794,"_28279":123919,"_3062":123966},[],{"_3607":73924,"_31098":73785,"_21528":124277,"_5":14794,"_28279":123919,"_3062":55355},[],{"_3607":73925,"_31098":73785,"_21528":124279,"_5":14794,"_28279":123919,"_3062":124280},[],"Certificado",{"_3607":73926,"_31098":73785,"_21528":124282,"_5":14794,"_28279":123919,"_3062":55361},[],{"_3607":73927,"_31098":73785,"_21528":124284,"_5":14794,"_28279":123919,"_3062":124285},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3607":73928,"_31098":73785,"_21528":124287,"_5":14794,"_28279":123919,"_3062":124288},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3607":73929,"_31098":73785,"_21528":124290,"_5":14794,"_28279":123919,"_3062":123978},[],{"_3607":73930,"_31098":73785,"_21528":124292,"_5":14794,"_28279":123919,"_3062":55372},[],{"_3607":73931,"_31098":73785,"_21528":124294,"_5":14794,"_28279":123919,"_3062":124295},[],"Certificado / Dispositivo",{"_3607":73932,"_31098":73785,"_21528":124297,"_5":14794,"_28279":123919,"_3062":55378},[],{"_3607":73933,"_31098":73785,"_21528":124299,"_5":14794,"_28279":123919,"_3062":51183},[],{"_3607":73934,"_31098":73785,"_21528":124301,"_5":14794,"_28279":123919,"_3062":124302},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3607":73935,"_31098":73785,"_21528":124304,"_5":14794,"_28279":123919,"_3062":123986},[],{"_3607":73936,"_31098":73785,"_21528":124306,"_5":14794,"_28279":123923,"_3062":124307},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3607":73937,"_31098":73785,"_21528":124309,"_5":14794,"_28279":123927,"_3062":124310},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3607":73938,"_31098":73785,"_21528":124312,"_5":14794,"_28279":123927,"_3062":124313},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3607":73939,"_31098":73785,"_21528":124315,"_5":14794,"_28279":123931,"_3062":124316},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3607":73940,"_31098":73785,"_21528":124318,"_5":14794,"_28279":123931,"_3062":124319},[],"Transición",{"_3607":73941,"_31098":73785,"_21528":124321,"_5":14794,"_28279":123931,"_3062":124322},[],"Llamadas AWS",{"_3607":73942,"_31098":73785,"_21528":124324,"_5":14794,"_28279":123931,"_3062":124325},[],"`NoRegistrada` → `Solicitada`",{"_3607":73943,"_31098":73785,"_21528":124327,"_5":14794,"_28279":123931,"_3062":124328},[],"ninguna (solo escritura de metadatos)",{"_3607":73944,"_31098":73785,"_21528":124330,"_5":14794,"_28279":123931,"_3062":124331},[],"`Solicitada` → `Registrando`",{"_3607":73945,"_31098":73785,"_21528":124333,"_5":14794,"_28279":123931,"_3062":124334},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3607":73946,"_31098":73785,"_21528":124336,"_5":14794,"_28279":123931,"_3062":124337},[],"`Registrando` → `Completada`",{"_3607":73947,"_31098":73785,"_21528":124339,"_5":14794,"_28279":123931,"_3062":124340},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3607":73948,"_31098":73785,"_21528":124342,"_5":14794,"_28279":123931,"_3062":124343},[],"`Registrando` → `Fallida`",{"_3607":73949,"_31098":73785,"_21528":124345,"_5":14794,"_28279":123931,"_3062":124346},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3607":73950,"_31098":73785,"_21528":124348,"_5":14794,"_28279":123931,"_3062":124349},[],"`Fallida` / `Completada` → `Solicitada`",{"_3607":73951,"_31098":73785,"_21528":124351,"_5":14794,"_28279":123931,"_3062":124352},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3607":73952,"_31098":73785,"_21528":124354,"_5":14794,"_28279":123935,"_3062":124355},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3607":73953,"_31098":73785,"_21528":124357,"_5":14794,"_28279":123935,"_3062":124358},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3607":73954,"_31098":73785,"_21528":124360,"_5":14794,"_28279":123935,"_3062":124361},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3607":73955,"_31098":73785,"_21528":124363,"_5":14794,"_28279":123935,"_3062":124364},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3607":73956,"_31098":73785,"_21528":124366,"_5":14794,"_28279":123935,"_3062":124367},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3607":73957,"_31098":73785,"_21528":124369,"_5":14794,"_28279":123935,"_3062":124370},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3607":73958,"_31098":73785,"_21528":124372,"_5":14794,"_28279":123938,"_3062":124373},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3607":73959,"_31098":73785,"_21528":124375,"_5":14794,"_28279":123941,"_3062":124376},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3607":73960,"_31098":73785,"_21528":124378,"_5":14794,"_28279":123941,"_3062":124379},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3607":73961,"_31098":73785,"_21528":124381,"_5":14794,"_28279":123945,"_3062":124382},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3607":73962,"_31098":73785,"_21528":124384,"_5":14794,"_28279":123949,"_3062":124385},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3607":73963,"_31098":73785,"_21528":124387,"_5":14794,"_28279":123949,"_3062":124388},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3607":73964,"_31098":73785,"_21528":124390,"_5":14794,"_28279":123949,"_3062":124391},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3607":73965,"_31098":73785,"_21528":124393,"_5":14794,"_28279":123949,"_3062":124394},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3607":73966,"_31098":73785,"_21528":124396,"_5":14794,"_28279":123949,"_3062":124397},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3607":73967,"_31098":73785,"_21528":124399,"_5":14794,"_28279":123949,"_3062":124400},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3607":73968,"_31098":73785,"_21528":124402,"_5":14794,"_28279":123953,"_3062":124403},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3607":73969,"_31098":73785,"_21528":124405,"_5":14794,"_28279":123953,"_3062":124406},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3607":73970,"_31098":73785,"_21528":124408,"_5":14794,"_28279":123953,"_3062":124409},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3607":73971,"_31098":73785,"_21528":124411,"_5":14794,"_28279":123953,"_3062":124412},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3607":73972,"_31098":73785,"_21528":124414,"_5":14794,"_28279":123953,"_3062":124415},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3607":73973,"_31098":73785,"_21528":124417,"_5":14794,"_28279":123957,"_3062":124418},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3607":73974,"_31098":73785,"_21528":124420,"_5":14794,"_28279":123957,"_3062":124319},[],{"_3607":73975,"_31098":73785,"_21528":124422,"_5":14794,"_28279":123957,"_3062":124322},[],{"_3607":73976,"_31098":73785,"_21528":124424,"_5":14794,"_28279":123957,"_3062":124425},[],"`SinConfigurar` → `None` / `Auto`",{"_3607":73977,"_31098":73785,"_21528":124427,"_5":14794,"_28279":123957,"_3062":124428},[],"ninguna (solo configuración)",{"_3607":73978,"_31098":73785,"_21528":124430,"_5":14794,"_28279":123957,"_3062":55515},[],{"_3607":73979,"_31098":73785,"_21528":124432,"_5":14794,"_28279":123957,"_3062":124428},[],{"_3607":73980,"_31098":73785,"_21528":124434,"_5":14794,"_28279":123957,"_3062":124435},[],"Cualquiera → `Jitp`",{"_3607":73981,"_31098":73785,"_21528":124437,"_5":14794,"_28279":123957,"_3062":124438},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3607":73982,"_31098":73785,"_21528":124440,"_5":14794,"_28279":123957,"_3062":55526},[],{"_3607":73983,"_31098":73785,"_21528":124442,"_5":14794,"_28279":123957,"_3062":124443},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3607":73984,"_31098":73785,"_21528":124445,"_5":14794,"_28279":123961,"_3062":124446},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3607":73985,"_31098":73785,"_21528":124448,"_5":14794,"_28279":123961,"_3062":124449},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3607":73986,"_31098":73785,"_21528":124451,"_5":14794,"_28279":123961,"_3062":124452},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3607":73987,"_31098":73785,"_21528":124454,"_5":14794,"_28279":123965,"_3062":124455},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3607":73988,"_31098":73785,"_21528":124457,"_5":14794,"_28279":123965,"_3062":124319},[],{"_3607":73989,"_31098":73785,"_21528":124459,"_5":14794,"_28279":123965,"_3062":124322},[],{"_3607":73990,"_31098":73785,"_21528":124461,"_5":14794,"_28279":123965,"_3062":124462},[],"`Ausente` → `Aprovisionado`",{"_3607":73991,"_31098":73785,"_21528":124464,"_5":14794,"_28279":123965,"_3062":124465},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3607":73992,"_31098":73785,"_21528":124467,"_5":14794,"_28279":123965,"_3062":124468},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3607":73993,"_31098":73785,"_21528":124470,"_5":14794,"_28279":123965,"_3062":124471},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3607":73994,"_31098":73785,"_21528":124473,"_5":14794,"_28279":123965,"_3062":124474},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3607":73995,"_31098":73785,"_21528":124476,"_5":14794,"_28279":123969,"_3062":124477},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3607":73996,"_31098":73785,"_21528":124479,"_5":14794,"_28279":123969,"_3062":124480},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3607":73997,"_31098":73785,"_21528":124482,"_5":14794,"_28279":123969,"_3062":124483},[],"Para que el flujo JITP funcione correctamente:",{"_3607":73998,"_31098":73785,"_21528":124485,"_5":14794,"_28279":123969,"_3062":124486},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3607":73999,"_31098":73785,"_21528":124488,"_5":14794,"_28279":123969,"_3062":124489},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3607":74000,"_31098":73785,"_21528":124491,"_5":14794,"_28279":123969,"_3062":124492},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3607":74001,"_31098":73785,"_21528":124494,"_5":14794,"_28279":123969,"_3062":124495},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3607":74002,"_31098":73785,"_21528":124497,"_5":14794,"_28279":123973,"_3062":124498},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3607":74003,"_31098":73785,"_21528":124500,"_5":14794,"_28279":123973,"_3062":124501},[],"Estado en Lamassu",{"_3607":74004,"_31098":73785,"_21528":124503,"_5":14794,"_28279":123973,"_3062":124504},[],"Razón de revocación",{"_3607":74005,"_31098":73785,"_21528":124506,"_5":14794,"_28279":123973,"_3062":124507},[],"Estado en AWS IoT Core",{"_3607":74006,"_31098":73785,"_21528":124509,"_5":14794,"_28279":123973,"_3062":55596},[],{"_3607":74007,"_31098":73785,"_21528":124511,"_5":14794,"_28279":123973,"_3062":124512},[],"Ninguna",{"_3607":74008,"_31098":73785,"_21528":124514,"_5":14794,"_28279":123973,"_3062":55602},[],{"_3607":74009,"_31098":73785,"_21528":124516,"_5":14794,"_28279":123973,"_3062":55605},[],{"_3607":74010,"_31098":73785,"_21528":124518,"_5":14794,"_28279":123973,"_3062":55608},[],{"_3607":74011,"_31098":73785,"_21528":124520,"_5":14794,"_28279":123973,"_3062":55611},[],{"_3607":74012,"_31098":73785,"_21528":124522,"_5":14794,"_28279":123973,"_3062":55605},[],{"_3607":74013,"_31098":73785,"_21528":124524,"_5":14794,"_28279":123973,"_3062":124525},[],"Cualquier otra razón",{"_3607":74014,"_31098":73785,"_21528":124527,"_5":14794,"_28279":123973,"_3062":55619},[],{"_3607":74015,"_31098":73785,"_21528":124529,"_5":14794,"_28279":123973,"_3062":124530},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3607":74016,"_31098":73785,"_21528":124532,"_5":14794,"_28279":123977,"_3062":124533},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3607":74017,"_31098":73785,"_21528":124535,"_5":14794,"_28279":123977,"_3062":124319},[],{"_3607":74018,"_31098":73785,"_21528":124537,"_5":14794,"_28279":123977,"_3062":124322},[],{"_3607":74019,"_31098":73785,"_21528":124539,"_5":14794,"_28279":123977,"_3062":124540},[],"`NoSincronizado` → `Active`",{"_3607":74020,"_31098":73785,"_21528":124542,"_5":14794,"_28279":123977,"_3062":55111},[],{"_3607":74021,"_31098":73785,"_21528":124544,"_5":14794,"_28279":123977,"_3062":55637},[],{"_3607":74022,"_31098":73785,"_21528":124546,"_5":14794,"_28279":123977,"_3062":124547},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3607":74023,"_31098":73785,"_21528":124549,"_5":14794,"_28279":123977,"_3062":55643},[],{"_3607":74024,"_31098":73785,"_21528":124551,"_5":14794,"_28279":123977,"_3062":124547},[],{"_3607":74025,"_31098":73785,"_21528":124553,"_5":14794,"_28279":123977,"_3062":55648},[],{"_3607":74026,"_31098":73785,"_21528":124555,"_5":14794,"_28279":123977,"_3062":55111},[],{"_3607":74027,"_31098":73785,"_21528":124557,"_5":14794,"_28279":123977,"_3062":55653},[],{"_3607":74028,"_31098":73785,"_21528":124559,"_5":14794,"_28279":123977,"_3062":124560},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3607":74029,"_31098":73785,"_21528":124562,"_5":14794,"_28279":123981,"_3062":124563},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3607":74030,"_31098":73785,"_21528":124565,"_5":14794,"_28279":123981,"_3062":124566},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3607":74031,"_31098":73785,"_21528":124568,"_5":14794,"_28279":123981,"_3062":124569},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3607":74032,"_31098":73785,"_21528":124571,"_5":14794,"_28279":123985,"_3062":124572},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3607":74033,"_31098":73785,"_21528":124574,"_5":14794,"_28279":123985,"_3062":124575},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3607":74034,"_31098":73785,"_21528":124577,"_5":14794,"_28279":123989,"_3062":124578},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3607":74035,"_31098":73785,"_21528":124580,"_5":14794,"_28279":123989,"_3062":124581},[],"Existen dos tipos de acciones:",{"_3607":74036,"_31098":73785,"_21528":124583,"_5":14794,"_28279":123989,"_3062":124584},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3607":74037,"_31098":73785,"_21528":124586,"_5":14794,"_28279":123989,"_3062":124587},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3607":74038,"_31098":73785,"_21528":124589,"_5":14794,"_28279":123989,"_3062":124590},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3607":74039,"_31098":73785,"_21528":124592,"_5":14794,"_28279":123993,"_3062":124593},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3607":74040,"_31098":73785,"_21528":124595,"_5":14794,"_28279":123993,"_3062":124596},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3607":74041,"_31098":73785,"_21528":124598,"_5":14794,"_28279":123993,"_3062":124599},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3607":74042,"_31098":73785,"_21528":124601,"_5":14794,"_28279":123997,"_3062":124602},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3607":74043,"_31098":73785,"_21528":124604,"_5":14794,"_28279":123997,"_3062":124605},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3607":74044,"_31098":73785,"_21528":124607,"_5":14794,"_28279":123997,"_3062":124608},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3607":74045,"_31098":73785,"_21528":124610,"_5":14794,"_28279":123997,"_3062":124611},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3607":74046,"_31098":73785,"_21528":124613,"_5":14794,"_28279":123997,"_3062":124614},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3607":74047,"_31098":73785,"_21528":124616,"_5":14794,"_28279":123997,"_3062":124617},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3607":74048,"_31098":73785,"_21528":124619,"_5":14794,"_28279":123997,"_3062":124620},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3607":74049,"_31098":73785,"_21528":124622,"_5":14794,"_28279":123997,"_3062":124623},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3607":74050,"_31098":73785,"_21528":124625,"_5":14794,"_28279":123997,"_3062":124626},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3607":74051,"_31098":73785,"_21528":124628,"_5":14794,"_28279":123997,"_3062":124629},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3607":74052,"_31098":73785,"_21528":124631,"_5":14794,"_28279":123997,"_3062":124632},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3607":74053,"_31098":73785,"_21528":124634,"_5":14794,"_28279":123997,"_3062":124635},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3607":74054,"_31098":73785,"_21528":124637,"_5":14794,"_28279":123997,"_3062":124638},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3607":74055,"_31098":73785,"_21528":124640,"_5":14794,"_28279":123997,"_3062":124641},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3607":74056,"_31098":73785,"_21528":124643,"_5":14794,"_28279":123997,"_3062":124644},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3607":74057,"_31098":73785,"_21528":124646,"_5":14794,"_28279":123997,"_3062":124647},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3607":74058,"_31098":73785,"_21528":124649,"_5":14794,"_28279":123997,"_3062":124650},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3607":74059,"_31098":73785,"_21528":124652,"_5":14794,"_28279":123997,"_3062":124653},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3607":74060,"_31098":73785,"_21528":124655,"_5":14794,"_28279":123997,"_3062":124656},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3607":74061,"_31098":73785,"_21528":124658,"_5":14794,"_28279":123997,"_3062":124659},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3607":74062,"_31098":73785,"_21528":124661,"_5":14794,"_28279":123997,"_3062":124662},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3607":74063,"_31098":73785,"_21528":124664,"_5":14794,"_28279":123997,"_3062":124665},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3607":74064,"_31098":73785,"_21528":124667,"_5":14794,"_28279":123997,"_3062":124668},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3607":74065,"_31098":73785,"_21528":124670,"_5":14794,"_28279":123997,"_3062":124671},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3607":74066,"_31098":74066,"_5":15159,"_3062":53471,"_31457":124673,"_21528":124674,"_28279":74066},[50787,121341,53471],[],{"_3607":74067,"_31098":74066,"_21528":124676,"_5":14794,"_28279":74066,"_3062":124677},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3607":74068,"_31098":74066,"_5":31454,"_21528":124679,"_28279":124680,"_3062":124681},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3607":74069,"_31098":74066,"_5":31454,"_21528":124683,"_28279":124684,"_3062":122486},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3607":74070,"_31098":74066,"_5":31454,"_21528":124686,"_28279":124687,"_3062":122664},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3607":74071,"_31098":74066,"_5":31454,"_21528":124689,"_28279":124690,"_3062":123896},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#integraciones",{"_3607":74072,"_31098":74066,"_5":31454,"_21528":124692,"_28279":124693,"_3062":124694},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3607":74073,"_31098":74066,"_21528":124696,"_5":14794,"_28279":74066,"_3062":124697},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3607":74074,"_31098":74066,"_21528":124699,"_5":14794,"_28279":124680,"_3062":124700},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3607":74075,"_31098":74066,"_21528":124702,"_5":14794,"_28279":124680,"_3062":124703},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3607":74076,"_31098":74066,"_21528":124705,"_5":14794,"_28279":124684,"_3062":124706},[],"Recurso",{"_3607":74077,"_31098":74066,"_21528":124708,"_5":14794,"_28279":124684,"_3062":124709},[],"Qué representa",{"_3607":74078,"_31098":74066,"_21528":124711,"_5":14794,"_28279":124684,"_3062":124712},[],"**Dispositivo**",{"_3607":74079,"_31098":74066,"_21528":124714,"_5":14794,"_28279":124684,"_3062":124715},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3607":74080,"_31098":74066,"_21528":124717,"_5":14794,"_28279":124684,"_3062":124718},[],"**Identidad**",{"_3607":74081,"_31098":74066,"_21528":124720,"_5":14794,"_28279":124684,"_3062":124721},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3607":74082,"_31098":74066,"_21528":124723,"_5":14794,"_28279":124684,"_3062":55820},[],{"_3607":74083,"_31098":74066,"_21528":124725,"_5":14794,"_28279":124684,"_3062":124726},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3607":74084,"_31098":74066,"_21528":124728,"_5":14794,"_28279":124684,"_3062":124729},[],"**Flota**",{"_3607":74085,"_31098":74066,"_21528":124731,"_5":14794,"_28279":124684,"_3062":124732},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3607":74086,"_31098":74066,"_21528":124734,"_5":14794,"_28279":124684,"_3062":124735},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3607":74087,"_31098":74066,"_21528":124737,"_5":14794,"_28279":124684,"_3062":124738},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3607":74088,"_31098":74066,"_21528":124740,"_5":14794,"_28279":124687,"_3062":124741},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3607":74089,"_31098":74066,"_21528":124743,"_5":14794,"_28279":124687,"_3062":124744},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3607":74090,"_31098":74066,"_21528":124746,"_5":14794,"_28279":124687,"_3062":124747},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3607":74091,"_31098":74066,"_21528":124749,"_5":14794,"_28279":124687,"_3062":124750},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3607":74092,"_31098":74066,"_21528":124752,"_5":14794,"_28279":124687,"_3062":124753},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3607":74093,"_31098":74066,"_21528":124755,"_5":14794,"_28279":124687,"_3062":124756},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3607":74094,"_31098":74066,"_21528":124758,"_5":14794,"_28279":124687,"_3062":124759},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3607":74095,"_31098":74066,"_21528":124761,"_5":14794,"_28279":124687,"_3062":124762},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3607":74096,"_31098":74066,"_21528":124764,"_5":14794,"_28279":124690,"_3062":124765},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3607":74097,"_31098":74066,"_21528":124767,"_5":14794,"_28279":124690,"_3062":124768},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3607":74098,"_31098":74066,"_21528":124770,"_5":14794,"_28279":124693,"_3062":124771},[],"Participante",{"_3607":74099,"_31098":74066,"_21528":124773,"_5":14794,"_28279":124693,"_3062":124774},[],"Responsabilidad",{"_3607":74100,"_31098":74066,"_21528":124776,"_5":14794,"_28279":124693,"_3062":124777},[],"Administrador PKI",{"_3607":74101,"_31098":74066,"_21528":124779,"_5":14794,"_28279":124693,"_3062":124780},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3607":74102,"_31098":74066,"_21528":124782,"_5":14794,"_28279":124693,"_3062":124783},[],"Administrador del aprovisionamiento",{"_3607":74103,"_31098":74066,"_21528":124785,"_5":14794,"_28279":124693,"_3062":124786},[],"DMS, admisión, autenticación por operación e inventario.",{"_3607":74104,"_31098":74066,"_21528":124788,"_5":14794,"_28279":124693,"_3062":124789},[],"Integrador del dispositivo",{"_3607":74105,"_31098":74066,"_21528":124791,"_5":14794,"_28279":124693,"_3062":124792},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3607":74106,"_31098":74066,"_21528":124794,"_5":14794,"_28279":124693,"_3062":124795},[],"Integrador del consumidor",{"_3607":74107,"_31098":74066,"_21528":124797,"_5":14794,"_28279":124693,"_3062":124798},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3607":74108,"_31098":74066,"_21528":124800,"_5":14794,"_28279":124693,"_3062":124801},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3607":74109,"_31098":74109,"_5":15159,"_3062":124803,"_31457":124804,"_21528":124806,"_28279":74109},"Enrola y conecta tu primer dispositivo",[50787,121341,53471,124805],"Primeros pasos",[],{"_3607":74110,"_31098":74109,"_21528":124808,"_5":14794,"_28279":74109,"_3062":124809},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3607":74111,"_31098":74109,"_5":31454,"_21528":124811,"_28279":124812,"_3062":119875},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3607":74112,"_31098":74109,"_5":31454,"_21528":124814,"_28279":124815,"_3062":124816},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3607":74113,"_31098":74109,"_5":31454,"_21528":124818,"_28279":124819,"_3062":124820},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3607":74114,"_31098":74109,"_5":31454,"_21528":124822,"_28279":124823,"_3062":124824},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3607":74115,"_31098":74109,"_5":31454,"_21528":124826,"_28279":124827,"_3062":124828},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3607":74116,"_31098":74109,"_5":31454,"_21528":124830,"_28279":124831,"_3062":124832},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3607":74117,"_31098":74109,"_5":31454,"_21528":124834,"_28279":124835,"_3062":124836},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3607":74118,"_31098":74109,"_5":31454,"_21528":124838,"_28279":124839,"_3062":124840},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3607":74119,"_31098":74109,"_21528":124842,"_5":14794,"_28279":74109,"_3062":124843},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3607":74120,"_31098":74109,"_21528":124845,"_5":14794,"_28279":124812,"_3062":124846},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3607":74121,"_31098":74109,"_21528":124848,"_5":14794,"_28279":124812,"_3062":124849},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3607":74122,"_31098":74109,"_21528":124851,"_5":14794,"_28279":124812,"_3062":124852},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3607":74123,"_31098":74109,"_21528":124854,"_5":14794,"_28279":124812,"_3062":124855},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3607":74124,"_31098":74109,"_21528":124857,"_5":14794,"_28279":124812,"_3062":124858},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3607":74125,"_31098":74109,"_21528":124860,"_5":14794,"_28279":124815,"_3062":124861},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3607":74126,"_31098":74109,"_21528":124863,"_5":14794,"_28279":124815,"_3062":124864},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3607":74127,"_31098":74109,"_21528":124866,"_5":14794,"_28279":124819,"_3062":124867},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3607":74128,"_31098":74109,"_21528":124869,"_5":14794,"_28279":124819,"_3062":124870},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3607":74129,"_31098":74109,"_21528":124872,"_5":14794,"_28279":124819,"_3062":124873},[],"Ajuste",{"_3607":74130,"_31098":74109,"_21528":124875,"_5":14794,"_28279":124819,"_3062":124876},[],"Valor de evaluación",{"_3607":74131,"_31098":74109,"_21528":124878,"_5":14794,"_28279":124819,"_3062":55976},[],{"_3607":74132,"_31098":74109,"_21528":124880,"_5":14794,"_28279":124819,"_3062":124881},[],"Raíz emisora de `device-root.pem`.",{"_3607":74133,"_31098":74109,"_21528":124883,"_5":14794,"_28279":124819,"_3062":122792},[],{"_3607":74134,"_31098":74109,"_21528":124885,"_5":14794,"_28279":124819,"_3062":124886},[],"Perfil final de 1 hora que acabas de preparar.",{"_3607":74135,"_31098":74109,"_21528":124888,"_5":14794,"_28279":124819,"_3062":55987},[],{"_3607":74136,"_31098":74109,"_21528":124890,"_5":14794,"_28279":124819,"_3062":55990},[],{"_3607":74137,"_31098":74109,"_21528":124892,"_5":14794,"_28279":124819,"_3062":55993},[],{"_3607":74138,"_31098":74109,"_21528":124894,"_5":14794,"_28279":124819,"_3062":124895},[],"Habilitado.",{"_3607":74139,"_31098":74109,"_21528":124897,"_5":14794,"_28279":124819,"_3062":55999},[],{"_3607":74140,"_31098":74109,"_21528":124899,"_5":14794,"_28279":124819,"_3062":124900},[],"Deshabilitado; el ID debe ser nuevo.",{"_3607":74141,"_31098":74109,"_21528":124902,"_5":14794,"_28279":124819,"_3062":124903},[],"Autenticación inicial",{"_3607":74142,"_31098":74109,"_21528":124905,"_5":14794,"_28279":124819,"_3062":124906},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3607":74143,"_31098":74109,"_21528":124908,"_5":14794,"_28279":124819,"_3062":124909},[],"Autenticación de renovación",{"_3607":74144,"_31098":74109,"_21528":124911,"_5":14794,"_28279":124819,"_3062":124912},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3607":74145,"_31098":74109,"_21528":124914,"_5":14794,"_28279":124819,"_3062":56017},[],{"_3607":74146,"_31098":74109,"_21528":124916,"_5":14794,"_28279":124819,"_3062":124917},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3607":74147,"_31098":74109,"_21528":124919,"_5":14794,"_28279":124819,"_3062":56023},[],{"_3607":74148,"_31098":74109,"_21528":124921,"_5":14794,"_28279":124819,"_3062":124922},[],"1 hora.",{"_3607":74149,"_31098":74109,"_21528":124924,"_5":14794,"_28279":124819,"_3062":56029},[],{"_3607":74150,"_31098":74109,"_21528":124926,"_5":14794,"_28279":124819,"_3062":124927},[],"30 minutos / 10 minutos.",{"_3607":74151,"_31098":74109,"_21528":124929,"_5":14794,"_28279":124819,"_3062":56035},[],{"_3607":74152,"_31098":74109,"_21528":124931,"_5":14794,"_28279":124819,"_3062":124932},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3607":74153,"_31098":74109,"_21528":124934,"_5":14794,"_28279":124819,"_3062":53793},[],{"_3607":74154,"_31098":74109,"_21528":124936,"_5":14794,"_28279":124819,"_3062":124937},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3607":74155,"_31098":74109,"_21528":124939,"_5":14794,"_28279":124819,"_3062":56046},[],{"_3607":74156,"_31098":74109,"_21528":124941,"_5":14794,"_28279":124819,"_3062":124942},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3607":74157,"_31098":74109,"_21528":124944,"_5":14794,"_28279":124819,"_3062":124945},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3607":74158,"_31098":74109,"_21528":124947,"_5":14794,"_28279":124823,"_3062":124948},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3607":74159,"_31098":74109,"_21528":124950,"_5":14794,"_28279":124823,"_3062":124951},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3607":74160,"_31098":74109,"_21528":124953,"_5":14794,"_28279":124827,"_3062":124954},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3607":74161,"_31098":74109,"_21528":124956,"_5":14794,"_28279":124827,"_3062":124957},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3607":74162,"_31098":74109,"_21528":124959,"_5":14794,"_28279":124827,"_3062":124960},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3607":74163,"_31098":74109,"_21528":124962,"_5":14794,"_28279":124831,"_3062":124963},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3607":74164,"_31098":74109,"_21528":124965,"_5":14794,"_28279":124831,"_3062":124966},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3607":74165,"_31098":74109,"_21528":124968,"_5":14794,"_28279":124835,"_3062":124969},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3607":74166,"_31098":74109,"_21528":124971,"_5":14794,"_28279":124835,"_3062":124972},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3607":74167,"_31098":74109,"_21528":124974,"_5":14794,"_28279":124835,"_3062":124975},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3607":74168,"_31098":74109,"_21528":124977,"_5":14794,"_28279":124835,"_3062":124978},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3607":74169,"_31098":74109,"_21528":124980,"_5":14794,"_28279":124835,"_3062":124981},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3607":74170,"_31098":74109,"_21528":124983,"_5":14794,"_28279":124839,"_3062":124984},[],"Comprobación",{"_3607":74171,"_31098":74109,"_21528":124986,"_5":14794,"_28279":124839,"_3062":124987},[],"Resultado esperado",{"_3607":74172,"_31098":74109,"_21528":124989,"_5":14794,"_28279":124839,"_3062":124990},[],"Registro",{"_3607":74173,"_31098":74109,"_21528":124992,"_5":14794,"_28279":124839,"_3062":124993},[],"ID creado automáticamente y DMS correcto.",{"_3607":74174,"_31098":74109,"_21528":124995,"_5":14794,"_28279":124839,"_3062":124280},[],{"_3607":74175,"_31098":74109,"_21528":124997,"_5":14794,"_28279":124839,"_3062":124998},[],"CN, perfil, serie y clave verificados.",{"_3607":74176,"_31098":74109,"_21528":125000,"_5":14794,"_28279":124839,"_3062":125001},[],"Inventario",{"_3607":74177,"_31098":74109,"_21528":125003,"_5":14794,"_28279":124839,"_3062":125004},[],"Serie recibida visible como identidad actual y en el historial.",{"_3607":74178,"_31098":74109,"_21528":125006,"_5":14794,"_28279":124839,"_3062":125007},[],"Consumidor",{"_3607":74179,"_31098":74109,"_21528":125009,"_5":14794,"_28279":124839,"_3062":125010},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3607":74180,"_31098":74109,"_21528":125012,"_5":14794,"_28279":124839,"_3062":125013},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3607":74181,"_31098":74109,"_21528":125015,"_5":14794,"_28279":124839,"_3062":125016},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3607":74182,"_31098":74182,"_5":15159,"_3062":122503,"_31457":125018,"_21528":125019,"_28279":74182},[50787,121341,53471,124805],[],{"_3607":74183,"_31098":74182,"_21528":125021,"_5":14794,"_28279":74182,"_3062":125022},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3607":74184,"_31098":74182,"_5":31454,"_21528":125024,"_28279":125025,"_3062":119875},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3607":74185,"_31098":74182,"_5":31454,"_21528":125027,"_28279":125028,"_3062":125029},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3607":74186,"_31098":74182,"_5":31454,"_21528":125031,"_28279":125032,"_3062":125033},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3607":74187,"_31098":74182,"_5":31454,"_21528":125035,"_28279":125036,"_3062":125037},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3607":74188,"_31098":74182,"_5":31454,"_21528":125039,"_28279":125040,"_3062":125041},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3607":74189,"_31098":74182,"_5":31454,"_21528":125043,"_28279":125044,"_3062":125045},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3607":74190,"_31098":74182,"_5":31454,"_21528":125047,"_28279":125048,"_3062":124987},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3607":74191,"_31098":74182,"_5":31454,"_21528":125050,"_28279":125051,"_3062":125052},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3607":74192,"_31098":74182,"_5":31454,"_21528":125054,"_28279":125055,"_3062":125056},[],"/docs/pr-preview/pr-75/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3607":74193,"_31098":74182,"_21528":125058,"_5":14794,"_28279":74182,"_3062":125059},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3607":74194,"_31098":74182,"_21528":125061,"_5":14794,"_28279":74182,"_3062":125062},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3607":74195,"_31098":74182,"_21528":125064,"_5":14794,"_28279":125025,"_3062":125065},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3607":74196,"_31098":74182,"_21528":125067,"_5":14794,"_28279":125025,"_3062":125068},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3607":74197,"_31098":74182,"_21528":125070,"_5":14794,"_28279":125025,"_3062":125071},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3607":74198,"_31098":74182,"_21528":125073,"_5":14794,"_28279":125025,"_3062":125074},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3607":74199,"_31098":74182,"_21528":125076,"_5":14794,"_28279":125028,"_3062":125077},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3607":74200,"_31098":74182,"_21528":125079,"_5":14794,"_28279":125028,"_3062":125080},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3607":74201,"_31098":74182,"_21528":125082,"_5":14794,"_28279":125028,"_3062":125083},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3607":74202,"_31098":74182,"_21528":125085,"_5":14794,"_28279":125028,"_3062":125086},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3607":74203,"_31098":74182,"_21528":125088,"_5":14794,"_28279":125028,"_3062":125089},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3607":74204,"_31098":74182,"_21528":125091,"_5":14794,"_28279":125028,"_3062":125092},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3607":74205,"_31098":74182,"_21528":125094,"_5":14794,"_28279":125028,"_3062":125095},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3607":74206,"_31098":74182,"_21528":125097,"_5":14794,"_28279":125028,"_3062":125098},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3607":74207,"_31098":74182,"_21528":125100,"_5":14794,"_28279":125032,"_3062":125101},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3607":74208,"_31098":74182,"_21528":125103,"_5":14794,"_28279":125032,"_3062":56211},[],{"_3607":74209,"_31098":74182,"_21528":125105,"_5":14794,"_28279":125032,"_3062":125106},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3607":74210,"_31098":74182,"_21528":125108,"_5":14794,"_28279":125032,"_3062":125109},[],"**Icon** y **Tags**: clasificación opcional.",{"_3607":74211,"_31098":74182,"_21528":125111,"_5":14794,"_28279":125032,"_3062":125112},[],"Confirma el registro.",{"_3607":74212,"_31098":74182,"_21528":125114,"_5":14794,"_28279":125036,"_3062":125115},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3607":74213,"_31098":74182,"_21528":125117,"_5":14794,"_28279":125036,"_3062":125118},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3607":74214,"_31098":74182,"_21528":125120,"_5":14794,"_28279":125040,"_3062":125121},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3607":74215,"_31098":74182,"_21528":125123,"_5":14794,"_28279":125040,"_3062":125124},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3607":74216,"_31098":74182,"_21528":125126,"_5":14794,"_28279":125044,"_3062":125127},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3607":74217,"_31098":74182,"_21528":125129,"_5":14794,"_28279":125044,"_3062":125130},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3607":74218,"_31098":74182,"_21528":125132,"_5":14794,"_28279":125048,"_3062":124984},[],{"_3607":74219,"_31098":74182,"_21528":125134,"_5":14794,"_28279":125048,"_3062":125135},[],"Resultado",{"_3607":74220,"_31098":74182,"_21528":125137,"_5":14794,"_28279":125048,"_3062":124266},[],{"_3607":74221,"_31098":74182,"_21528":125139,"_5":14794,"_28279":125048,"_3062":125140},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3607":74222,"_31098":74182,"_21528":125142,"_5":14794,"_28279":125048,"_3062":125143},[],"Identidad actual",{"_3607":74223,"_31098":74182,"_21528":125145,"_5":14794,"_28279":125048,"_3062":125146},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3607":74224,"_31098":74182,"_21528":125148,"_5":14794,"_28279":125048,"_3062":125149},[],"Historial",{"_3607":74225,"_31098":74182,"_21528":125151,"_5":14794,"_28279":125048,"_3062":125152},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3607":74226,"_31098":74182,"_21528":125154,"_5":14794,"_28279":125048,"_3062":125155},[],"Clave y certificado",{"_3607":74227,"_31098":74182,"_21528":125157,"_5":14794,"_28279":125048,"_3062":125158},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3607":74228,"_31098":74182,"_21528":125160,"_5":14794,"_28279":125051,"_3062":125161},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3607":74229,"_31098":74182,"_21528":125163,"_5":14794,"_28279":125051,"_3062":125164},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3607":74230,"_31098":74182,"_21528":125166,"_5":14794,"_28279":125051,"_3062":125167},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3607":74231,"_31098":74182,"_21528":125169,"_5":14794,"_28279":125051,"_3062":125170},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3607":74232,"_31098":74182,"_21528":125172,"_5":14794,"_28279":125055,"_3062":125173},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3607":74233,"_31098":74182,"_21528":125175,"_5":14794,"_28279":125055,"_3062":125176},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3607":74234,"_31098":74182,"_21528":125178,"_5":14794,"_28279":125055,"_3062":125179},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3607":74235,"_31098":74235,"_5":15159,"_3062":125181,"_31457":125182,"_21528":125183,"_28279":74235},"Plataforma Lamassu IoT",[50787,121341],[],{"_3607":74236,"_31098":74235,"_21528":125185,"_5":14794,"_28279":74235,"_3062":125186},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3607":74237,"_31098":74235,"_5":31454,"_21528":125188,"_28279":125189,"_3062":124681},[],"/docs/pr-preview/pr-75/es/platform/overview#empieza-aquí",{"_3607":74238,"_31098":74235,"_5":31454,"_21528":125191,"_28279":125192,"_3062":125193},[],"/docs/pr-preview/pr-75/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3607":74239,"_31098":74235,"_5":31454,"_21528":125195,"_28279":125196,"_3062":125197},[],"/docs/pr-preview/pr-75/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3607":74240,"_31098":74235,"_5":31454,"_21528":125199,"_28279":125200,"_3062":125201},[],"/docs/pr-preview/pr-75/es/platform/overview#capacidades-principales","Capacidades principales",{"_3607":74241,"_31098":74235,"_5":31454,"_21528":125203,"_28279":125204,"_3062":125205},[],"/docs/pr-preview/pr-75/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3607":74242,"_31098":74235,"_5":31454,"_21528":125207,"_28279":125208,"_3062":125209},[],"/docs/pr-preview/pr-75/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3607":74243,"_31098":74235,"_5":31454,"_21528":125211,"_28279":125212,"_3062":125213},[],"/docs/pr-preview/pr-75/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3607":74244,"_31098":74235,"_5":31454,"_21528":125215,"_28279":125216,"_3062":125217},[],"/docs/pr-preview/pr-75/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3607":74245,"_31098":74235,"_5":31454,"_21528":125219,"_28279":125220,"_3062":125221},[],"/docs/pr-preview/pr-75/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3607":74246,"_31098":74235,"_5":31454,"_21528":125223,"_28279":125224,"_3062":125225},[],"/docs/pr-preview/pr-75/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3607":74247,"_31098":74235,"_5":31454,"_21528":125227,"_28279":125228,"_3062":125229},[],"/docs/pr-preview/pr-75/es/platform/overview#referencia-operativa","Referencia operativa",{"_3607":74248,"_31098":74235,"_21528":125231,"_5":14794,"_28279":74235,"_3062":125232},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3607":74249,"_31098":74235,"_21528":125234,"_5":14794,"_28279":125189,"_3062":125235},[],"Elige el resultado que necesitas obtener:",{"_3607":74250,"_31098":74235,"_21528":125237,"_5":14794,"_28279":125189,"_3062":125238},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3607":74251,"_31098":74235,"_21528":125240,"_5":14794,"_28279":125189,"_3062":125241},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3607":74252,"_31098":74235,"_21528":125243,"_5":14794,"_28279":125189,"_3062":125244},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3607":74253,"_31098":74235,"_21528":125246,"_5":14794,"_28279":125192,"_3062":125247},[],"Bloque",{"_3607":74254,"_31098":74235,"_21528":125249,"_5":14794,"_28279":125192,"_3062":125250},[],"Qué gestionas",{"_3607":74255,"_31098":74235,"_21528":125252,"_5":14794,"_28279":125192,"_3062":125253},[],"Punto de entrada",{"_3607":74256,"_31098":74235,"_21528":125255,"_5":14794,"_28279":125192,"_3062":56364},[],{"_3607":74257,"_31098":74235,"_21528":125257,"_5":14794,"_28279":125192,"_3062":125258},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3607":74258,"_31098":74235,"_21528":125260,"_5":14794,"_28279":125192,"_3062":125261},[],"Visión general de PKI",{"_3607":74259,"_31098":74235,"_21528":125263,"_5":14794,"_28279":125192,"_3062":56373},[],{"_3607":74260,"_31098":74235,"_21528":125265,"_5":14794,"_28279":125192,"_3062":125266},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3607":74261,"_31098":74235,"_21528":125268,"_5":14794,"_28279":125192,"_3062":125269},[],"Visión general de IoT Fleets",{"_3607":74262,"_31098":74235,"_21528":125271,"_5":14794,"_28279":125192,"_3062":125272},[],"**Administración**",{"_3607":74263,"_31098":74235,"_21528":125274,"_5":14794,"_28279":125192,"_3062":125275},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3607":74264,"_31098":74235,"_21528":125277,"_5":14794,"_28279":125192,"_3062":121343},[],{"_3607":74265,"_31098":74235,"_21528":125279,"_5":14794,"_28279":125192,"_3062":125280},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3607":74266,"_31098":74235,"_21528":125282,"_5":14794,"_28279":125196,"_3062":125283},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3607":74267,"_31098":74235,"_21528":125285,"_5":14794,"_28279":125196,"_3062":125286},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3607":74268,"_31098":74235,"_21528":125288,"_5":14794,"_28279":125196,"_3062":125289},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3607":74269,"_31098":74235,"_21528":125291,"_5":14794,"_28279":125196,"_3062":125292},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3607":74270,"_31098":74235,"_21528":125294,"_5":14794,"_28279":125196,"_3062":125295},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3607":74271,"_31098":74235,"_21528":125297,"_5":14794,"_28279":125196,"_3062":125298},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3607":74272,"_31098":74235,"_21528":125300,"_5":14794,"_28279":125204,"_3062":125301},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3607":74273,"_31098":74235,"_21528":125303,"_5":14794,"_28279":125208,"_3062":125304},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3607":74274,"_31098":74235,"_21528":125306,"_5":14794,"_28279":125212,"_3062":125307},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3607":74275,"_31098":74235,"_21528":125309,"_5":14794,"_28279":125216,"_3062":125310},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3607":74276,"_31098":74235,"_21528":125312,"_5":14794,"_28279":125220,"_3062":125313},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3607":74277,"_31098":74235,"_21528":125315,"_5":14794,"_28279":125224,"_3062":125316},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3607":74278,"_31098":74235,"_21528":125318,"_5":14794,"_28279":125228,"_3062":124774},[],{"_3607":74279,"_31098":74235,"_21528":125320,"_5":14794,"_28279":125228,"_3062":125321},[],"Qué prepara o comprueba",{"_3607":74280,"_31098":74235,"_21528":125323,"_5":14794,"_28279":125228,"_3062":124777},[],{"_3607":74281,"_31098":74235,"_21528":125325,"_5":14794,"_28279":125228,"_3062":125326},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3607":74282,"_31098":74235,"_21528":125328,"_5":14794,"_28279":125228,"_3062":125329},[],"Administrador de la flota",{"_3607":74283,"_31098":74235,"_21528":125331,"_5":14794,"_28279":125228,"_3062":125332},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3607":74284,"_31098":74235,"_21528":125334,"_5":14794,"_28279":125228,"_3062":124789},[],{"_3607":74285,"_31098":74235,"_21528":125336,"_5":14794,"_28279":125228,"_3062":125337},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3607":74286,"_31098":74235,"_21528":125339,"_5":14794,"_28279":125228,"_3062":124795},[],{"_3607":74287,"_31098":74235,"_21528":125341,"_5":14794,"_28279":125228,"_3062":125342},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3607":74288,"_31098":74235,"_21528":125344,"_5":14794,"_28279":125228,"_3062":125345},[],"Operador de infraestructura",{"_3607":74289,"_31098":74235,"_21528":125347,"_5":14794,"_28279":125228,"_3062":125348},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3607":74290,"_31098":74235,"_21528":125350,"_5":14794,"_28279":125228,"_3062":125351},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3607":74291,"_31098":74291,"_5":15159,"_3062":125353,"_31457":125354,"_21528":125356,"_28279":74291},"Jerarquía y rotación de CAs",[50787,121341,56465,125355],"Claves, autoridades y certificados",[],{"_3607":74292,"_31098":74291,"_21528":125358,"_5":14794,"_28279":74291,"_3062":125359},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3607":74293,"_31098":74291,"_5":31454,"_21528":125361,"_28279":125362,"_3062":125363},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3607":74294,"_31098":74291,"_5":31454,"_21528":125365,"_28279":125366,"_3062":125367},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3607":74295,"_31098":74291,"_5":31454,"_21528":125369,"_28279":125370,"_3062":125371},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3607":74296,"_31098":74291,"_5":31454,"_21528":125373,"_28279":125374,"_3062":125375},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3607":74297,"_31098":74291,"_5":31454,"_21528":125377,"_28279":125378,"_3062":125379},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3607":74298,"_31098":74291,"_5":31454,"_21528":125381,"_28279":125382,"_3062":125383},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3607":74299,"_31098":74291,"_5":31454,"_21528":125385,"_28279":125386,"_3062":125387},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3607":74300,"_31098":74291,"_5":31454,"_21528":125389,"_28279":125390,"_3062":125391},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3607":74301,"_31098":74291,"_5":31454,"_21528":125393,"_28279":125394,"_3062":125395},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3607":74302,"_31098":74291,"_5":31454,"_21528":125397,"_28279":125398,"_3062":125399},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3607":74303,"_31098":74291,"_5":31454,"_21528":125401,"_28279":125402,"_3062":125403},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3607":74304,"_31098":74291,"_5":31454,"_21528":125405,"_28279":125406,"_3062":125407},[],"/docs/pr-preview/pr-75/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3607":74305,"_31098":74291,"_21528":125409,"_5":14794,"_28279":74291,"_3062":125410},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3607":74306,"_31098":74291,"_21528":125412,"_5":14794,"_28279":74291,"_3062":125413},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3607":74307,"_31098":74291,"_21528":125415,"_5":14794,"_28279":125362,"_3062":125416},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3607":74308,"_31098":74291,"_21528":125418,"_5":14794,"_28279":125362,"_3062":125419},[],"entorno, como producción y preproducción;",{"_3607":74309,"_31098":74291,"_21528":125421,"_5":14794,"_28279":125362,"_3062":125422},[],"propietario o equipo operador;",{"_3607":74310,"_31098":74291,"_21528":125424,"_5":14794,"_28279":125362,"_3062":125425},[],"familia de dispositivos o proceso de fabricación;",{"_3607":74311,"_31098":74291,"_21528":125427,"_5":14794,"_28279":125362,"_3062":125428},[],"región o requisito regulatorio;",{"_3607":74312,"_31098":74291,"_21528":125430,"_5":14794,"_28279":125362,"_3062":125431},[],"motor criptográfico o política de clave;",{"_3607":74313,"_31098":74291,"_21528":125433,"_5":14794,"_28279":125362,"_3062":125434},[],"ventana de mantenimiento y ritmo de renovación.",{"_3607":74314,"_31098":74291,"_21528":125436,"_5":14794,"_28279":125362,"_3062":125437},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3607":74315,"_31098":74291,"_21528":125439,"_5":14794,"_28279":125362,"_3062":125440},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3607":74316,"_31098":74291,"_21528":125442,"_5":14794,"_28279":125366,"_3062":125443},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3607":74317,"_31098":74291,"_21528":125445,"_5":14794,"_28279":125366,"_3062":125446},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3607":74318,"_31098":74291,"_21528":125448,"_5":14794,"_28279":125366,"_3062":125449},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3607":74319,"_31098":74291,"_21528":125451,"_5":14794,"_28279":125366,"_3062":125452},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3607":74320,"_31098":74291,"_21528":125454,"_5":14794,"_28279":125370,"_3062":125455},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3607":74321,"_31098":74291,"_21528":125457,"_5":14794,"_28279":125370,"_3062":125458},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3607":74322,"_31098":74291,"_21528":125460,"_5":14794,"_28279":125370,"_3062":125461},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3607":74323,"_31098":74291,"_21528":125463,"_5":14794,"_28279":125370,"_3062":125464},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3607":74324,"_31098":74291,"_21528":125466,"_5":14794,"_28279":125378,"_3062":125467},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3607":74325,"_31098":74291,"_21528":125469,"_5":14794,"_28279":125382,"_3062":125470},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3607":74326,"_31098":74291,"_21528":125472,"_5":14794,"_28279":125386,"_3062":125473},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3607":74327,"_31098":74291,"_21528":125475,"_5":14794,"_28279":125390,"_3062":125476},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3607":74328,"_31098":74291,"_21528":125478,"_5":14794,"_28279":125394,"_3062":125479},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3607":74329,"_31098":74291,"_21528":125481,"_5":14794,"_28279":125398,"_3062":125482},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3607":74330,"_31098":74291,"_21528":125484,"_5":14794,"_28279":125402,"_3062":125485},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3607":74331,"_31098":74291,"_21528":125487,"_5":14794,"_28279":125402,"_3062":125488},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3607":74332,"_31098":74291,"_21528":125490,"_5":14794,"_28279":125402,"_3062":125491},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3607":74333,"_31098":74291,"_21528":125493,"_5":14794,"_28279":125402,"_3062":125494},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3607":74334,"_31098":74291,"_21528":125496,"_5":14794,"_28279":125406,"_3062":125497},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3607":74335,"_31098":74291,"_21528":125499,"_5":14794,"_28279":125406,"_3062":125500},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3607":74336,"_31098":74291,"_21528":125502,"_5":14794,"_28279":125406,"_3062":125503},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3607":74337,"_31098":74291,"_21528":125505,"_5":14794,"_28279":125406,"_3062":125506},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3607":74338,"_31098":74291,"_21528":125508,"_5":14794,"_28279":125406,"_3062":125509},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3607":74339,"_31098":74291,"_21528":125511,"_5":14794,"_28279":125406,"_3062":125512},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3607":74340,"_31098":74291,"_21528":125514,"_5":14794,"_28279":125406,"_3062":125515},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3607":74341,"_31098":74341,"_5":15159,"_3062":125517,"_31457":125518,"_21528":125519,"_28279":74341},"Autoridades de certificación",[50787,121341,56465,125355],[],{"_3607":74342,"_31098":74341,"_21528":125521,"_5":14794,"_28279":74341,"_3062":125522},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3607":74343,"_31098":74341,"_5":31454,"_21528":125524,"_28279":125525,"_3062":125526},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3607":74344,"_31098":74341,"_5":31454,"_21528":125528,"_28279":125529,"_3062":125530},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3607":74345,"_31098":74341,"_5":31454,"_21528":125532,"_28279":125533,"_3062":119875},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3607":74346,"_31098":74341,"_5":31454,"_21528":125535,"_28279":125536,"_3062":125537},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3607":74347,"_31098":74341,"_5":31454,"_21528":125539,"_28279":125540,"_3062":125541},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3607":74348,"_31098":74341,"_5":31454,"_21528":125543,"_28279":125544,"_3062":125545},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3607":74349,"_31098":74341,"_5":31454,"_21528":125547,"_28279":125548,"_3062":125549},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3607":74350,"_31098":74341,"_5":31454,"_21528":125551,"_28279":125552,"_3062":125553},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3607":74351,"_31098":74341,"_5":31454,"_21528":125555,"_28279":125556,"_3062":125557},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3607":74352,"_31098":74341,"_5":31454,"_21528":125559,"_28279":125560,"_3062":125561},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3607":74353,"_31098":74341,"_5":31454,"_21528":125563,"_28279":125564,"_3062":125565},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3607":74354,"_31098":74341,"_5":31454,"_21528":125567,"_28279":125568,"_3062":125569},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3607":74355,"_31098":74341,"_5":31454,"_21528":125571,"_28279":125572,"_3062":125573},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3607":74356,"_31098":74341,"_5":31454,"_21528":125575,"_28279":125576,"_3062":125577},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3607":74357,"_31098":74341,"_5":31454,"_21528":125579,"_28279":125580,"_3062":125581},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3607":74358,"_31098":74341,"_5":31454,"_21528":125583,"_28279":125584,"_3062":125585},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3607":74359,"_31098":74341,"_5":31454,"_21528":125587,"_28279":125588,"_3062":125589},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3607":74360,"_31098":74341,"_5":31454,"_21528":125591,"_28279":125592,"_3062":125593},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3607":74361,"_31098":74341,"_5":31454,"_21528":125595,"_28279":125596,"_3062":125597},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3607":74362,"_31098":74341,"_5":31454,"_21528":125599,"_28279":125600,"_3062":125601},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3607":74363,"_31098":74341,"_5":31454,"_21528":125603,"_28279":125604,"_3062":125605},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3607":74364,"_31098":74341,"_5":31454,"_21528":125607,"_28279":125608,"_3062":125609},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3607":74365,"_31098":74341,"_5":31454,"_21528":125611,"_28279":125612,"_3062":125613},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3607":74366,"_31098":74341,"_21528":125615,"_5":14794,"_28279":74341,"_3062":125616},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3607":74367,"_31098":74341,"_21528":125618,"_5":14794,"_28279":74341,"_3062":125619},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3607":74368,"_31098":74341,"_21528":125621,"_5":14794,"_28279":74341,"_3062":125622},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3607":74369,"_31098":74341,"_21528":125624,"_5":14794,"_28279":125525,"_3062":125625},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3607":74370,"_31098":74341,"_21528":125627,"_5":14794,"_28279":125525,"_3062":125628},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3607":74371,"_31098":74341,"_21528":125630,"_5":14794,"_28279":125525,"_3062":125631},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3607":74372,"_31098":74341,"_21528":125633,"_5":14794,"_28279":125525,"_3062":125634},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3607":74373,"_31098":74341,"_21528":125636,"_5":14794,"_28279":125525,"_3062":125637},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3607":74374,"_31098":74341,"_21528":125639,"_5":14794,"_28279":125533,"_3062":125640},[],"Decide si la CA será raíz o intermedia.",{"_3607":74375,"_31098":74341,"_21528":125642,"_5":14794,"_28279":125533,"_3062":125643},[],"Elige el motor que custodiará la clave.",{"_3607":74376,"_31098":74341,"_21528":125645,"_5":14794,"_28279":125533,"_3062":125646},[],"Define una validez superior a la de los certificados que emitirá.",{"_3607":74377,"_31098":74341,"_21528":125648,"_5":14794,"_28279":125533,"_3062":125649},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3607":74378,"_31098":74341,"_21528":125651,"_5":14794,"_28279":125536,"_3062":125652},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3607":74379,"_31098":74341,"_21528":125654,"_5":14794,"_28279":125540,"_3062":125655},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3607":74380,"_31098":74341,"_21528":125657,"_5":14794,"_28279":125540,"_3062":125658},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3607":74381,"_31098":74341,"_21528":125660,"_5":14794,"_28279":125544,"_3062":125661},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3607":74382,"_31098":74341,"_21528":125663,"_5":14794,"_28279":125548,"_3062":125664},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3607":74383,"_31098":74341,"_21528":125666,"_5":14794,"_28279":125548,"_3062":125667},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3607":74384,"_31098":74341,"_21528":125669,"_5":14794,"_28279":125548,"_3062":125670},[],"`ST`: estado o provincia.",{"_3607":74385,"_31098":74341,"_21528":125672,"_5":14794,"_28279":125548,"_3062":125673},[],"`L`: localidad.",{"_3607":74386,"_31098":74341,"_21528":125675,"_5":14794,"_28279":125548,"_3062":125676},[],"`O`: organización.",{"_3607":74387,"_31098":74341,"_21528":125678,"_5":14794,"_28279":125548,"_3062":125679},[],"`OU`: unidad organizativa.",{"_3607":74388,"_31098":74341,"_21528":125681,"_5":14794,"_28279":125548,"_3062":125682},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3607":74389,"_31098":74341,"_21528":125684,"_5":14794,"_28279":125552,"_3062":125685},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3607":74390,"_31098":74341,"_21528":125687,"_5":14794,"_28279":125552,"_3062":125688},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3607":74391,"_31098":74341,"_21528":125690,"_5":14794,"_28279":125556,"_3062":125691},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3607":74392,"_31098":74341,"_21528":125693,"_5":14794,"_28279":125556,"_3062":125694},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3607":74393,"_31098":74341,"_21528":125696,"_5":14794,"_28279":125560,"_3062":125697},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3607":74394,"_31098":74341,"_21528":125699,"_5":14794,"_28279":125560,"_3062":125700},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3607":74395,"_31098":74341,"_21528":125702,"_5":14794,"_28279":125564,"_3062":125703},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3607":74396,"_31098":74341,"_21528":125705,"_5":14794,"_28279":125564,"_3062":125706},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3607":74397,"_31098":74341,"_21528":125708,"_5":14794,"_28279":125564,"_3062":125709},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3607":74398,"_31098":74341,"_21528":125711,"_5":14794,"_28279":125564,"_3062":125712},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3607":74399,"_31098":74341,"_21528":125714,"_5":14794,"_28279":125568,"_3062":125715},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3607":74400,"_31098":74341,"_21528":125717,"_5":14794,"_28279":125572,"_3062":125718},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3607":74401,"_31098":74341,"_21528":125720,"_5":14794,"_28279":125572,"_3062":125721},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3607":74402,"_31098":74341,"_21528":125723,"_5":14794,"_28279":125576,"_3062":125724},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3607":74403,"_31098":74341,"_21528":125726,"_5":14794,"_28279":125580,"_3062":125727},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3607":74404,"_31098":74341,"_21528":125729,"_5":14794,"_28279":125580,"_3062":125730},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3607":74405,"_31098":74341,"_21528":125732,"_5":14794,"_28279":125580,"_3062":125733},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3607":74406,"_31098":74341,"_21528":125735,"_5":14794,"_28279":125584,"_3062":125736},[],"Abre una CA desde el inventario para consultar:",{"_3607":74407,"_31098":74341,"_21528":125738,"_5":14794,"_28279":125584,"_3062":125739},[],"Estado y periodo de validez.",{"_3607":74408,"_31098":74341,"_21528":125741,"_5":14794,"_28279":125584,"_3062":125742},[],"Certificado y cadena en formato PEM.",{"_3607":74409,"_31098":74341,"_21528":125744,"_5":14794,"_28279":125584,"_3062":125745},[],"Número de certificados activos, expirados y revocados.",{"_3607":74410,"_31098":74341,"_21528":125747,"_5":14794,"_28279":125584,"_3062":125748},[],"Certificados emitidos en **Issued Certificates**.",{"_3607":74411,"_31098":74341,"_21528":125750,"_5":14794,"_28279":125584,"_3062":125751},[],"CRL vinculada a la autoridad.",{"_3607":74412,"_31098":74341,"_21528":125753,"_5":14794,"_28279":125584,"_3062":125754},[],"Metadatos y motor criptográfico asociado.",{"_3607":74413,"_31098":74341,"_21528":125756,"_5":14794,"_28279":125584,"_3062":125757},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3607":74414,"_31098":74341,"_21528":125759,"_5":14794,"_28279":125588,"_3062":125760},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3607":74415,"_31098":74341,"_21528":125762,"_5":14794,"_28279":125588,"_3062":125763},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3607":74416,"_31098":74341,"_21528":125765,"_5":14794,"_28279":125588,"_3062":125766},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3607":74417,"_31098":74341,"_21528":125768,"_5":14794,"_28279":125588,"_3062":125769},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3607":74418,"_31098":74341,"_21528":125771,"_5":14794,"_28279":125588,"_3062":125772},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3607":74419,"_31098":74341,"_21528":125774,"_5":14794,"_28279":125588,"_3062":125775},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3607":74420,"_31098":74341,"_21528":125777,"_5":14794,"_28279":125592,"_3062":125778},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3607":74421,"_31098":74341,"_21528":125780,"_5":14794,"_28279":125596,"_3062":125781},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3607":74422,"_31098":74341,"_21528":125783,"_5":14794,"_28279":125600,"_3062":125784},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3607":74423,"_31098":74341,"_21528":125786,"_5":14794,"_28279":125604,"_3062":125787},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3607":74424,"_31098":74341,"_21528":125789,"_5":14794,"_28279":125608,"_3062":125790},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3607":74425,"_31098":74341,"_21528":125792,"_5":14794,"_28279":125612,"_3062":125793},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3607":74426,"_31098":74341,"_21528":125795,"_5":14794,"_28279":125612,"_3062":125796},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3607":74427,"_31098":74341,"_21528":125798,"_5":14794,"_28279":125612,"_3062":125799},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3607":74428,"_31098":74341,"_21528":125801,"_5":14794,"_28279":125612,"_3062":125802},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3607":74429,"_31098":74341,"_21528":125804,"_5":14794,"_28279":125612,"_3062":125805},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3607":74430,"_31098":74430,"_5":15159,"_3062":125807,"_31457":125808,"_21528":125809,"_28279":74430},"Perfiles de certificado",[50787,121341,56465,125355],[],{"_3607":74431,"_31098":74430,"_21528":125811,"_5":14794,"_28279":74430,"_3062":125812},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3607":74432,"_31098":74430,"_5":31454,"_21528":125814,"_28279":125815,"_3062":125816},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3607":74433,"_31098":74430,"_5":31454,"_21528":125818,"_28279":125819,"_3062":125820},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#validez","Validez",{"_3607":74434,"_31098":74430,"_5":31454,"_21528":125822,"_28279":125823,"_3062":125824},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3607":74435,"_31098":74430,"_5":31454,"_21528":125826,"_28279":125827,"_3062":125828},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3607":74436,"_31098":74430,"_5":31454,"_21528":125830,"_28279":125831,"_3062":125832},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3607":74437,"_31098":74430,"_5":31454,"_21528":125834,"_28279":125835,"_3062":125836},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3607":74438,"_31098":74430,"_5":31454,"_21528":125838,"_28279":125839,"_3062":125840},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3607":74439,"_31098":74430,"_5":31454,"_21528":125842,"_28279":125843,"_3062":125844},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3607":74440,"_31098":74430,"_5":31454,"_21528":125846,"_28279":125847,"_3062":125848},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3607":74441,"_31098":74430,"_5":31454,"_21528":125850,"_28279":125851,"_3062":125852},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3607":74442,"_31098":74430,"_5":31454,"_21528":125854,"_28279":125855,"_3062":125856},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3607":74443,"_31098":74430,"_5":31454,"_21528":125858,"_28279":125859,"_3062":125860},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3607":74444,"_31098":74430,"_5":31454,"_21528":125862,"_28279":125863,"_3062":125864},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3607":74445,"_31098":74430,"_5":31454,"_21528":125866,"_28279":125867,"_3062":125868},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3607":74446,"_31098":74430,"_5":31454,"_21528":125870,"_28279":125871,"_3062":125872},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3607":74447,"_31098":74430,"_5":31454,"_21528":125874,"_28279":125875,"_3062":125876},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3607":74448,"_31098":74430,"_21528":125878,"_5":14794,"_28279":74430,"_3062":125879},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3607":74449,"_31098":74430,"_21528":125881,"_5":14794,"_28279":74430,"_3062":125882},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3607":74450,"_31098":74430,"_21528":125884,"_5":14794,"_28279":125819,"_3062":125885},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3607":74451,"_31098":74430,"_21528":125887,"_5":14794,"_28279":125819,"_3062":125888},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3607":74452,"_31098":74430,"_21528":125890,"_5":14794,"_28279":125823,"_3062":125891},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3607":74453,"_31098":74430,"_21528":125893,"_5":14794,"_28279":125827,"_3062":125894},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3607":74454,"_31098":74430,"_21528":125896,"_5":14794,"_28279":125827,"_3062":125897},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3607":74455,"_31098":74430,"_21528":125899,"_5":14794,"_28279":125827,"_3062":125900},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3607":74456,"_31098":74430,"_21528":125902,"_5":14794,"_28279":125831,"_3062":125903},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3607":74457,"_31098":74430,"_21528":125905,"_5":14794,"_28279":125835,"_3062":125906},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3607":74458,"_31098":74430,"_21528":125908,"_5":14794,"_28279":125835,"_3062":125909},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3607":74459,"_31098":74430,"_21528":125911,"_5":14794,"_28279":125839,"_3062":125912},[],"La aplicación criptográfica puede:",{"_3607":74460,"_31098":74430,"_21528":125914,"_5":14794,"_28279":125839,"_3062":125915},[],"permitir o bloquear claves RSA;",{"_3607":74461,"_31098":74430,"_21528":125917,"_5":14794,"_28279":125839,"_3062":125918},[],"limitar los tamaños RSA admitidos;",{"_3607":74462,"_31098":74430,"_21528":125920,"_5":14794,"_28279":125839,"_3062":125921},[],"permitir o bloquear claves ECDSA;",{"_3607":74463,"_31098":74430,"_21528":125923,"_5":14794,"_28279":125839,"_3062":125924},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3607":74464,"_31098":74430,"_21528":125926,"_5":14794,"_28279":125839,"_3062":125927},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3607":74465,"_31098":74430,"_21528":125929,"_5":14794,"_28279":125843,"_3062":125930},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3607":74466,"_31098":74430,"_21528":125932,"_5":14794,"_28279":125843,"_3062":121101},[],{"_3607":74467,"_31098":74430,"_21528":125934,"_5":14794,"_28279":125843,"_3062":125935},[],"Primera opción",{"_3607":74468,"_31098":74430,"_21528":125937,"_5":14794,"_28279":125843,"_3062":125938},[],"Segunda opción",{"_3607":74469,"_31098":74430,"_21528":125940,"_5":14794,"_28279":125843,"_3062":125941},[],"Si no hay ninguna",{"_3607":74470,"_31098":74430,"_21528":125943,"_5":14794,"_28279":125843,"_3062":125944},[],"Firma directa con una CA",{"_3607":74471,"_31098":74430,"_21528":125946,"_5":14794,"_28279":125843,"_3062":125947},[],"`issuance_profile` incluido en la solicitud",{"_3607":74472,"_31098":74430,"_21528":125949,"_5":14794,"_28279":125843,"_3062":125950},[],"`issuance_profile_id` de la solicitud",{"_3607":74473,"_31098":74430,"_21528":125952,"_5":14794,"_28279":125843,"_3062":125953},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3607":74474,"_31098":74430,"_21528":125955,"_5":14794,"_28279":125843,"_3062":125956},[],"Emisión mediante DMS",{"_3607":74475,"_31098":74430,"_21528":125958,"_5":14794,"_28279":125843,"_3062":57070},[],{"_3607":74476,"_31098":74430,"_21528":125960,"_5":14794,"_28279":125843,"_3062":125961},[],"`settings.issuance_profile` incluido en el DMS",{"_3607":74477,"_31098":74430,"_21528":125963,"_5":14794,"_28279":125843,"_3062":125964},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3607":74478,"_31098":74430,"_21528":125966,"_5":14794,"_28279":125843,"_3062":125967},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3607":74479,"_31098":74430,"_21528":125969,"_5":14794,"_28279":125843,"_3062":125970},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3607":74480,"_31098":74430,"_21528":125972,"_5":14794,"_28279":125851,"_3062":125973},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3607":74481,"_31098":74430,"_21528":125975,"_5":14794,"_28279":125855,"_3062":125976},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3607":74482,"_31098":74430,"_21528":125978,"_5":14794,"_28279":125859,"_3062":125979},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3607":74483,"_31098":74430,"_21528":125981,"_5":14794,"_28279":125863,"_3062":125982},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3607":74484,"_31098":74430,"_21528":125984,"_5":14794,"_28279":125867,"_3062":125985},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3607":74485,"_31098":74430,"_21528":125987,"_5":14794,"_28279":125867,"_3062":125988},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3607":74486,"_31098":74430,"_21528":125990,"_5":14794,"_28279":125871,"_3062":125991},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3607":74487,"_31098":74430,"_21528":125993,"_5":14794,"_28279":125871,"_3062":125994},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3607":74488,"_31098":74430,"_21528":125996,"_5":14794,"_28279":125871,"_3062":125997},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3607":74489,"_31098":74430,"_21528":125999,"_5":14794,"_28279":125871,"_3062":126000},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3607":74490,"_31098":74430,"_21528":126002,"_5":14794,"_28279":125875,"_3062":126003},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3607":74491,"_31098":74430,"_21528":126005,"_5":14794,"_28279":125875,"_3062":126006},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3607":74492,"_31098":74492,"_5":15159,"_3062":126008,"_31457":126009,"_21528":126011,"_28279":74492},"Validación de certificados",[50787,121341,56465,126010],"Validación",[],{"_3607":74493,"_31098":74492,"_21528":126013,"_5":14794,"_28279":74492,"_3062":126014},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3607":74494,"_31098":74492,"_5":31454,"_21528":126016,"_28279":126017,"_3062":126018},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3607":74495,"_31098":74492,"_5":31454,"_21528":126020,"_28279":126021,"_3062":126022},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3607":74496,"_31098":74492,"_5":31454,"_21528":126024,"_28279":126025,"_3062":126026},[],"/docs/pr-preview/pr-75/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3607":74497,"_31098":74492,"_21528":126028,"_5":14794,"_28279":74492,"_3062":126029},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3607":74498,"_31098":74492,"_21528":126031,"_5":14794,"_28279":126017,"_3062":126032},[],"Verifica estos criterios juntos:",{"_3607":74499,"_31098":74492,"_21528":126034,"_5":14794,"_28279":126017,"_3062":124984},[],{"_3607":74500,"_31098":74492,"_21528":126036,"_5":14794,"_28279":126017,"_3062":126037},[],"Resultado necesario",{"_3607":74501,"_31098":74492,"_21528":126039,"_5":14794,"_28279":126017,"_3062":126040},[],"Cadena y firma",{"_3607":74502,"_31098":74492,"_21528":126042,"_5":14794,"_28279":126017,"_3062":126043},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3607":74503,"_31098":74492,"_21528":126045,"_5":14794,"_28279":126017,"_3062":126046},[],"Fechas",{"_3607":74504,"_31098":74492,"_21528":126048,"_5":14794,"_28279":126017,"_3062":126049},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3607":74505,"_31098":74492,"_21528":126051,"_5":14794,"_28279":126017,"_3062":121011},[],{"_3607":74506,"_31098":74492,"_21528":126053,"_5":14794,"_28279":126017,"_3062":126054},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3607":74507,"_31098":74492,"_21528":126056,"_5":14794,"_28279":126017,"_3062":126057},[],"Uso",{"_3607":74508,"_31098":74492,"_21528":126059,"_5":14794,"_28279":126017,"_3062":126060},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3607":74509,"_31098":74492,"_21528":126062,"_5":14794,"_28279":126017,"_3062":126063},[],"Revocación",{"_3607":74510,"_31098":74492,"_21528":126065,"_5":14794,"_28279":126017,"_3062":126066},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3607":74511,"_31098":74492,"_21528":126068,"_5":14794,"_28279":126017,"_3062":126069},[],"Autorización",{"_3607":74512,"_31098":74492,"_21528":126071,"_5":14794,"_28279":126017,"_3062":126072},[],"La aplicación permite la acción a esa identidad.",{"_3607":74513,"_31098":74492,"_21528":126074,"_5":14794,"_28279":126017,"_3062":126075},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3607":74514,"_31098":74492,"_21528":126077,"_5":14794,"_28279":126021,"_3062":126078},[],"Mecanismo",{"_3607":74515,"_31098":74492,"_21528":126080,"_5":14794,"_28279":126021,"_3062":126081},[],"Cuándo utilizarlo",{"_3607":74516,"_31098":74492,"_21528":126083,"_5":14794,"_28279":126021,"_3062":126084},[],"Qué debes mantener",{"_3607":74517,"_31098":74492,"_21528":126086,"_5":14794,"_28279":126021,"_3062":57198},[],{"_3607":74518,"_31098":74492,"_21528":126088,"_5":14794,"_28279":126021,"_3062":126089},[],"Consulta del estado de un certificado concreto.",{"_3607":74519,"_31098":74492,"_21528":126091,"_5":14794,"_28279":126021,"_3062":126092},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3607":74520,"_31098":74492,"_21528":126094,"_5":14794,"_28279":126021,"_3062":57207},[],{"_3607":74521,"_31098":74492,"_21528":126096,"_5":14794,"_28279":126021,"_3062":126097},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3607":74522,"_31098":74492,"_21528":126099,"_5":14794,"_28279":126021,"_3062":126100},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3607":74523,"_31098":74492,"_21528":126102,"_5":14794,"_28279":126021,"_3062":126103},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3607":74524,"_31098":74492,"_21528":126105,"_5":14794,"_28279":126021,"_3062":126106},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3607":74525,"_31098":74492,"_21528":126108,"_5":14794,"_28279":126025,"_3062":126109},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3607":74526,"_31098":74492,"_21528":126111,"_5":14794,"_28279":126025,"_3062":126112},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3607":74527,"_31098":74492,"_21528":126114,"_5":14794,"_28279":126025,"_3062":126115},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3607":74528,"_31098":74492,"_21528":126117,"_5":14794,"_28279":126025,"_3062":126118},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3607":74529,"_31098":74492,"_21528":126120,"_5":14794,"_28279":126025,"_3062":126121},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3607":74530,"_31098":74492,"_21528":126123,"_5":14794,"_28279":126025,"_3062":126124},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3607":74531,"_31098":74492,"_21528":126126,"_5":14794,"_28279":126025,"_3062":126127},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3607":74532,"_31098":74492,"_21528":126129,"_5":14794,"_28279":126025,"_3062":126130},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3607":74533,"_31098":74492,"_21528":126132,"_5":14794,"_28279":126025,"_3062":126133},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3607":74534,"_31098":74534,"_5":15159,"_3062":126135,"_31457":126136,"_21528":126137,"_28279":74534},"Certificados",[50787,121341,56465,125355],[],{"_3607":74535,"_31098":74534,"_21528":126139,"_5":14794,"_28279":74534,"_3062":126140},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3607":74536,"_31098":74534,"_5":31454,"_21528":126142,"_28279":126143,"_3062":126144},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3607":74537,"_31098":74534,"_5":31454,"_21528":126146,"_28279":126147,"_3062":126148},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3607":74538,"_31098":74534,"_5":31454,"_21528":126150,"_28279":126151,"_3062":126152},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3607":74539,"_31098":74534,"_5":31454,"_21528":126154,"_28279":126155,"_3062":126156},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3607":74540,"_31098":74534,"_5":31454,"_21528":126158,"_28279":126159,"_3062":126160},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3607":74541,"_31098":74534,"_5":31454,"_21528":126162,"_28279":126163,"_3062":126164},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3607":74542,"_31098":74534,"_5":31454,"_21528":126166,"_28279":126167,"_3062":126168},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3607":74543,"_31098":74534,"_5":31454,"_21528":126170,"_28279":126171,"_3062":126172},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3607":74544,"_31098":74534,"_5":31454,"_21528":126174,"_28279":126175,"_3062":126176},[],"/docs/pr-preview/pr-75/es/platform/pki/certificates#continúa","Continúa",{"_3607":74545,"_31098":74534,"_21528":126178,"_5":14794,"_28279":74534,"_3062":126179},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3607":74546,"_31098":74534,"_21528":126181,"_5":14794,"_28279":126143,"_3062":126182},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3607":74547,"_31098":74534,"_21528":126184,"_5":14794,"_28279":126143,"_3062":126185},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3607":74548,"_31098":74534,"_21528":126187,"_5":14794,"_28279":126143,"_3062":126188},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3607":74549,"_31098":74534,"_21528":126190,"_5":14794,"_28279":126143,"_3062":126191},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3607":74550,"_31098":74534,"_21528":126193,"_5":14794,"_28279":126143,"_3062":126194},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3607":74551,"_31098":74534,"_21528":126196,"_5":14794,"_28279":126143,"_3062":126197},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3607":74552,"_31098":74534,"_21528":126199,"_5":14794,"_28279":126143,"_3062":126200},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3607":74553,"_31098":74534,"_21528":126202,"_5":14794,"_28279":126147,"_3062":126203},[],"Descarga el PEM e inspecciónalo:",{"_3607":74554,"_31098":74534,"_21528":126205,"_5":14794,"_28279":126147,"_3062":126206},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3607":74555,"_31098":74534,"_21528":126208,"_5":14794,"_28279":126151,"_3062":126209},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3607":74556,"_31098":74534,"_21528":126211,"_5":14794,"_28279":126151,"_3062":126212},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3607":74557,"_31098":74534,"_21528":126214,"_5":14794,"_28279":126151,"_3062":126215},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3607":74558,"_31098":74534,"_21528":126217,"_5":14794,"_28279":126151,"_3062":126218},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3607":74559,"_31098":74534,"_21528":126220,"_5":14794,"_28279":126151,"_3062":126221},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3607":74560,"_31098":74534,"_21528":126223,"_5":14794,"_28279":126151,"_3062":126224},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3607":74561,"_31098":74534,"_21528":126226,"_5":14794,"_28279":126151,"_3062":126227},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3607":74562,"_31098":74534,"_21528":126229,"_5":14794,"_28279":126155,"_3062":126230},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3607":74563,"_31098":74534,"_21528":126232,"_5":14794,"_28279":126159,"_3062":126233},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3607":74564,"_31098":74534,"_21528":126235,"_5":14794,"_28279":126163,"_3062":126236},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3607":74565,"_31098":74534,"_21528":126238,"_5":14794,"_28279":126167,"_3062":126239},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3607":74566,"_31098":74534,"_21528":126241,"_5":14794,"_28279":126167,"_3062":126242},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3607":74567,"_31098":74534,"_21528":126244,"_5":14794,"_28279":126167,"_3062":126245},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3607":74568,"_31098":74534,"_21528":126247,"_5":14794,"_28279":126171,"_3062":126248},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3607":74569,"_31098":74534,"_21528":126250,"_5":14794,"_28279":126171,"_3062":126251},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3607":74570,"_31098":74534,"_21528":126253,"_5":14794,"_28279":126171,"_3062":126254},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3607":74571,"_31098":74534,"_21528":126256,"_5":14794,"_28279":126175,"_3062":126257},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3607":74572,"_31098":74534,"_21528":126259,"_5":14794,"_28279":126175,"_3062":126260},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3607":74573,"_31098":74573,"_5":15159,"_3062":126262,"_31457":126263,"_21528":126265,"_28279":74573},"Ciclo de vida de un certificado",[50787,121341,56465,126264],"Conceptos",[],{"_3607":74574,"_31098":74573,"_21528":126267,"_5":14794,"_28279":74573,"_3062":126268},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3607":74575,"_31098":74573,"_5":31454,"_21528":126270,"_28279":126271,"_3062":126272},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3607":74576,"_31098":74573,"_5":31454,"_21528":126274,"_28279":126275,"_3062":126276},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3607":74577,"_31098":74573,"_5":31454,"_21528":126278,"_28279":126279,"_3062":126280},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3607":74578,"_31098":74573,"_5":31454,"_21528":126282,"_28279":126283,"_3062":126284},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3607":74579,"_31098":74573,"_5":31454,"_21528":126286,"_28279":126287,"_3062":126288},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3607":74580,"_31098":74573,"_5":31454,"_21528":126290,"_28279":126291,"_3062":126292},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3607":74581,"_31098":74573,"_5":31454,"_21528":126294,"_28279":126295,"_3062":123978},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3607":74582,"_31098":74573,"_5":31454,"_21528":126297,"_28279":126298,"_3062":126299},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3607":74583,"_31098":74573,"_5":31454,"_21528":126301,"_28279":126302,"_3062":126303},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3607":74584,"_31098":74573,"_5":31454,"_21528":126305,"_28279":126306,"_3062":126307},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3607":74585,"_31098":74573,"_21528":126309,"_5":14794,"_28279":74573,"_3062":126310},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3607":74586,"_31098":74573,"_21528":126312,"_5":14794,"_28279":126275,"_3062":126313},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3607":74587,"_31098":74573,"_21528":126315,"_5":14794,"_28279":126279,"_3062":126316},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3607":74588,"_31098":74573,"_21528":126318,"_5":14794,"_28279":126283,"_3062":126319},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3607":74589,"_31098":74573,"_21528":126321,"_5":14794,"_28279":126287,"_3062":126322},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3607":74590,"_31098":74573,"_21528":126324,"_5":14794,"_28279":126291,"_3062":126325},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3607":74591,"_31098":74573,"_21528":126327,"_5":14794,"_28279":126295,"_3062":126328},[],"Lamassu persiste cuatro estados X.509:",{"_3607":74592,"_31098":74573,"_21528":126330,"_5":14794,"_28279":126295,"_3062":126331},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3607":74593,"_31098":74573,"_21528":126333,"_5":14794,"_28279":126295,"_3062":126334},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3607":74594,"_31098":74573,"_21528":126336,"_5":14794,"_28279":126295,"_3062":126337},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3607":74595,"_31098":74573,"_21528":126339,"_5":14794,"_28279":126295,"_3062":126340},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3607":74596,"_31098":74573,"_21528":126342,"_5":14794,"_28279":126295,"_3062":126343},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3607":74597,"_31098":74573,"_21528":126345,"_5":14794,"_28279":126298,"_3062":126346},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3607":74598,"_31098":74573,"_21528":126348,"_5":14794,"_28279":126298,"_3062":126349},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3607":74599,"_31098":74573,"_21528":126351,"_5":14794,"_28279":126298,"_3062":126352},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3607":74600,"_31098":74573,"_21528":126354,"_5":14794,"_28279":126302,"_3062":126355},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3607":74601,"_31098":74573,"_21528":126357,"_5":14794,"_28279":126302,"_3062":126358},[],"Antes de confirmar:",{"_3607":74602,"_31098":74573,"_21528":126360,"_5":14794,"_28279":126302,"_3062":126361},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3607":74603,"_31098":74573,"_21528":126363,"_5":14794,"_28279":126302,"_3062":126364},[],"Distribuye la nueva cadena de confianza.",{"_3607":74604,"_31098":74573,"_21528":126366,"_5":14794,"_28279":126302,"_3062":126367},[],"Reemite las identidades necesarias.",{"_3607":74605,"_31098":74573,"_21528":126369,"_5":14794,"_28279":126302,"_3062":126370},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3607":74606,"_31098":74573,"_21528":126372,"_5":14794,"_28279":126302,"_3062":126373},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3607":74607,"_31098":74573,"_21528":126375,"_5":14794,"_28279":126302,"_3062":126376},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3607":74608,"_31098":74573,"_21528":126378,"_5":14794,"_28279":126306,"_3062":126379},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3607":74609,"_31098":74573,"_21528":126381,"_5":14794,"_28279":126306,"_3062":126382},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3607":74610,"_31098":74573,"_21528":126384,"_5":14794,"_28279":126306,"_3062":126385},[],"Cambios de estado y razones de revocación.",{"_3607":74611,"_31098":74573,"_21528":126387,"_5":14794,"_28279":126306,"_3062":126388},[],"Publicación y vigencia de OCSP y CRLs.",{"_3607":74612,"_31098":74573,"_21528":126390,"_5":14794,"_28279":126306,"_3062":126391},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3607":74613,"_31098":74573,"_21528":126393,"_5":14794,"_28279":126306,"_3062":126394},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3607":74614,"_31098":74614,"_5":15159,"_3062":126396,"_31457":126397,"_21528":126398,"_28279":74614},"Modelo de confianza",[50787,121341,56465,126264],[],{"_3607":74615,"_31098":74614,"_21528":126400,"_5":14794,"_28279":74614,"_3062":126401},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3607":74616,"_31098":74614,"_5":31454,"_21528":126403,"_28279":126404,"_3062":126405},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3607":74617,"_31098":74614,"_5":31454,"_21528":126407,"_28279":126408,"_3062":126409},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3607":74618,"_31098":74614,"_5":31454,"_21528":126411,"_28279":126412,"_3062":126413},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3607":74619,"_31098":74614,"_5":31454,"_21528":126415,"_28279":126416,"_3062":126417},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3607":74620,"_31098":74614,"_5":31454,"_21528":126419,"_28279":126420,"_3062":126421},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3607":74621,"_31098":74614,"_5":31454,"_21528":126423,"_28279":126424,"_3062":126425},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3607":74622,"_31098":74614,"_5":31454,"_21528":126427,"_28279":126428,"_3062":126429},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3607":74623,"_31098":74614,"_5":31454,"_21528":126431,"_28279":126432,"_3062":126433},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3607":74624,"_31098":74614,"_5":31454,"_21528":126435,"_28279":126436,"_3062":126437},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3607":74625,"_31098":74614,"_5":31454,"_21528":126439,"_28279":126440,"_3062":126441},[],"/docs/pr-preview/pr-75/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3607":74626,"_31098":74614,"_21528":126443,"_5":14794,"_28279":74614,"_3062":126444},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3607":74627,"_31098":74614,"_21528":126446,"_5":14794,"_28279":126408,"_3062":126447},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3607":74628,"_31098":74614,"_21528":126449,"_5":14794,"_28279":126412,"_3062":126450},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3607":74629,"_31098":74614,"_21528":126452,"_5":14794,"_28279":126416,"_3062":126453},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3607":74630,"_31098":74614,"_21528":126455,"_5":14794,"_28279":126420,"_3062":126456},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3607":74631,"_31098":74614,"_21528":126458,"_5":14794,"_28279":126424,"_3062":126459},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3607":74632,"_31098":74614,"_21528":126461,"_5":14794,"_28279":126424,"_3062":126462},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3607":74633,"_31098":74614,"_21528":126464,"_5":14794,"_28279":126424,"_3062":126465},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3607":74634,"_31098":74614,"_21528":126467,"_5":14794,"_28279":126424,"_3062":126468},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3607":74635,"_31098":74614,"_21528":126470,"_5":14794,"_28279":126424,"_3062":126471},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3607":74636,"_31098":74614,"_21528":126473,"_5":14794,"_28279":126424,"_3062":126474},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3607":74637,"_31098":74614,"_21528":126476,"_5":14794,"_28279":126428,"_3062":126477},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3607":74638,"_31098":74614,"_21528":126479,"_5":14794,"_28279":126428,"_3062":126480},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3607":74639,"_31098":74614,"_21528":126482,"_5":14794,"_28279":126428,"_3062":126483},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3607":74640,"_31098":74614,"_21528":126485,"_5":14794,"_28279":126428,"_3062":126486},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3607":74641,"_31098":74614,"_21528":126488,"_5":14794,"_28279":126428,"_3062":126489},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3607":74642,"_31098":74614,"_21528":126491,"_5":14794,"_28279":126432,"_3062":126492},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3607":74643,"_31098":74614,"_21528":126494,"_5":14794,"_28279":126432,"_3062":126495},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3607":74644,"_31098":74614,"_21528":126497,"_5":14794,"_28279":126432,"_3062":126498},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3607":74645,"_31098":74614,"_21528":126500,"_5":14794,"_28279":126432,"_3062":126501},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3607":74646,"_31098":74614,"_21528":126503,"_5":14794,"_28279":126432,"_3062":126504},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3607":74647,"_31098":74614,"_21528":126506,"_5":14794,"_28279":126432,"_3062":126507},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3607":74648,"_31098":74614,"_21528":126509,"_5":14794,"_28279":126432,"_3062":126510},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3607":74649,"_31098":74614,"_21528":126512,"_5":14794,"_28279":126436,"_3062":126513},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3607":74650,"_31098":74614,"_21528":126515,"_5":14794,"_28279":126440,"_3062":126516},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3607":74651,"_31098":74614,"_21528":126518,"_5":14794,"_28279":126440,"_3062":126519},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3607":74652,"_31098":74614,"_21528":126521,"_5":14794,"_28279":126440,"_3062":126522},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3607":74653,"_31098":74614,"_21528":126524,"_5":14794,"_28279":126440,"_3062":126525},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3607":74654,"_31098":74614,"_21528":126527,"_5":14794,"_28279":126440,"_3062":126528},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3607":74655,"_31098":74614,"_21528":126530,"_5":14794,"_28279":126440,"_3062":126531},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3607":74656,"_31098":74614,"_21528":126533,"_5":14794,"_28279":126440,"_3062":126534},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3607":74657,"_31098":74657,"_5":15159,"_3062":126536,"_31457":126537,"_21528":126538,"_28279":74657},"Listas de revocación (CRL)",[50787,121341,56465,126010],[],{"_3607":74658,"_31098":74657,"_21528":126540,"_5":14794,"_28279":74657,"_3062":126541},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3607":74659,"_31098":74657,"_5":31454,"_21528":126543,"_28279":126544,"_3062":126545},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3607":74660,"_31098":74657,"_5":31454,"_21528":126547,"_28279":126548,"_3062":126549},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3607":74661,"_31098":74657,"_5":31454,"_21528":126551,"_28279":126552,"_3062":126553},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3607":74662,"_31098":74657,"_5":31454,"_21528":126555,"_28279":126556,"_3062":126557},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3607":74663,"_31098":74657,"_5":31454,"_21528":126559,"_28279":126560,"_3062":126561},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3607":74664,"_31098":74657,"_5":31454,"_21528":126563,"_28279":126564,"_3062":126565},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3607":74665,"_31098":74657,"_5":31454,"_21528":126567,"_28279":126568,"_3062":126569},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3607":74666,"_31098":74657,"_5":31454,"_21528":126571,"_28279":126572,"_3062":126573},[],"/docs/pr-preview/pr-75/es/platform/pki/crl#referencias","Referencias",{"_3607":74667,"_31098":74657,"_21528":126575,"_5":14794,"_28279":74657,"_3062":126576},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3607":74668,"_31098":74657,"_21528":126578,"_5":14794,"_28279":126544,"_3062":126579},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3607":74669,"_31098":74657,"_21528":126581,"_5":14794,"_28279":126544,"_3062":126582},[],"Campo",{"_3607":74670,"_31098":74657,"_21528":126584,"_5":14794,"_28279":126544,"_3062":123018},[],{"_3607":74671,"_31098":74657,"_21528":126586,"_5":14794,"_28279":126544,"_3062":52419},[],{"_3607":74672,"_31098":74657,"_21528":126588,"_5":14794,"_28279":126544,"_3062":126589},[],"ID de la CA a la que pertenecen los ajustes.",{"_3607":74673,"_31098":74657,"_21528":126591,"_5":14794,"_28279":126544,"_3062":57706},[],{"_3607":74674,"_31098":74657,"_21528":126593,"_5":14794,"_28279":126544,"_3062":126594},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3607":74675,"_31098":74657,"_21528":126596,"_5":14794,"_28279":126544,"_3062":57712},[],{"_3607":74676,"_31098":74657,"_21528":126598,"_5":14794,"_28279":126544,"_3062":126599},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3607":74677,"_31098":74657,"_21528":126601,"_5":14794,"_28279":126544,"_3062":57718},[],{"_3607":74678,"_31098":74657,"_21528":126603,"_5":14794,"_28279":126544,"_3062":126604},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3607":74679,"_31098":74657,"_21528":126606,"_5":14794,"_28279":126544,"_3062":126607},[],"Campo de `crl_options`",{"_3607":74680,"_31098":74657,"_21528":126609,"_5":14794,"_28279":126544,"_3062":123018},[],{"_3607":74681,"_31098":74657,"_21528":126611,"_5":14794,"_28279":126544,"_3062":126612},[],"Valor inicial",{"_3607":74682,"_31098":74657,"_21528":126614,"_5":14794,"_28279":126544,"_3062":57732},[],{"_3607":74683,"_31098":74657,"_21528":126616,"_5":14794,"_28279":126544,"_3062":126617},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3607":74684,"_31098":74657,"_21528":126619,"_5":14794,"_28279":126544,"_3062":126620},[],"7 días.",{"_3607":74685,"_31098":74657,"_21528":126622,"_5":14794,"_28279":126544,"_3062":57741},[],{"_3607":74686,"_31098":74657,"_21528":126624,"_5":14794,"_28279":126544,"_3062":126625},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3607":74687,"_31098":74657,"_21528":126627,"_5":14794,"_28279":126544,"_3062":126628},[],"6 días y 23 horas.",{"_3607":74688,"_31098":74657,"_21528":126630,"_5":14794,"_28279":126544,"_3062":57750},[],{"_3607":74689,"_31098":74657,"_21528":126632,"_5":14794,"_28279":126544,"_3062":126633},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3607":74690,"_31098":74657,"_21528":126635,"_5":14794,"_28279":126544,"_3062":57756},[],{"_3607":74691,"_31098":74657,"_21528":126637,"_5":14794,"_28279":126544,"_3062":57759},[],{"_3607":74692,"_31098":74657,"_21528":126639,"_5":14794,"_28279":126544,"_3062":126640},[],"Número de serie del certificado existente que firma la CRL.",{"_3607":74693,"_31098":74657,"_21528":126642,"_5":14794,"_28279":126544,"_3062":126643},[],"Número de serie del certificado actual de la CA.",{"_3607":74694,"_31098":74657,"_21528":126645,"_5":14794,"_28279":126544,"_3062":126646},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3607":74695,"_31098":74657,"_21528":126648,"_5":14794,"_28279":126544,"_3062":126649},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3607":74696,"_31098":74657,"_21528":126651,"_5":14794,"_28279":126544,"_3062":126652},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3607":74697,"_31098":74657,"_21528":126654,"_5":14794,"_28279":126544,"_3062":126655},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3607":74698,"_31098":74657,"_21528":126657,"_5":14794,"_28279":126544,"_3062":126658},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3607":74699,"_31098":74657,"_21528":126660,"_5":14794,"_28279":126544,"_3062":126661},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3607":74700,"_31098":74657,"_21528":126663,"_5":14794,"_28279":126544,"_3062":126664},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3607":74701,"_31098":74657,"_21528":126666,"_5":14794,"_28279":126544,"_3062":126667},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3607":74702,"_31098":74657,"_21528":126669,"_5":14794,"_28279":126544,"_3062":126670},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3607":74703,"_31098":74657,"_21528":126672,"_5":14794,"_28279":126544,"_3062":126673},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3607":74704,"_31098":74657,"_21528":126675,"_5":14794,"_28279":126544,"_3062":126676},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3607":74705,"_31098":74657,"_21528":126678,"_5":14794,"_28279":126548,"_3062":126679},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3607":74706,"_31098":74657,"_21528":126681,"_5":14794,"_28279":126548,"_3062":126682},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3607":74707,"_31098":74657,"_21528":126684,"_5":14794,"_28279":126548,"_3062":126685},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3607":74708,"_31098":74657,"_21528":126687,"_5":14794,"_28279":126548,"_3062":126688},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3607":74709,"_31098":74657,"_21528":126690,"_5":14794,"_28279":126552,"_3062":126691},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3607":74710,"_31098":74657,"_21528":126693,"_5":14794,"_28279":126552,"_3062":126694},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3607":74711,"_31098":74657,"_21528":126696,"_5":14794,"_28279":126552,"_3062":126697},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3607":74712,"_31098":74657,"_21528":126699,"_5":14794,"_28279":126552,"_3062":126700},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3607":74713,"_31098":74657,"_21528":126702,"_5":14794,"_28279":126552,"_3062":126703},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3607":74714,"_31098":74657,"_21528":126705,"_5":14794,"_28279":126552,"_3062":126706},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3607":74715,"_31098":74657,"_21528":126708,"_5":14794,"_28279":126552,"_3062":126709},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3607":74716,"_31098":74657,"_21528":126711,"_5":14794,"_28279":126552,"_3062":126712},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3607":74717,"_31098":74657,"_21528":126714,"_5":14794,"_28279":126552,"_3062":126715},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3607":74718,"_31098":74657,"_21528":126717,"_5":14794,"_28279":126556,"_3062":126718},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3607":74719,"_31098":74657,"_21528":126720,"_5":14794,"_28279":126556,"_3062":126721},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3607":74720,"_31098":74657,"_21528":126723,"_5":14794,"_28279":126560,"_3062":126724},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3607":74721,"_31098":74657,"_21528":126726,"_5":14794,"_28279":126560,"_3062":126727},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3607":74722,"_31098":74657,"_21528":126729,"_5":14794,"_28279":126560,"_3062":126730},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3607":74723,"_31098":74657,"_21528":126732,"_5":14794,"_28279":126560,"_3062":126733},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3607":74724,"_31098":74657,"_21528":126735,"_5":14794,"_28279":126560,"_3062":126736},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3607":74725,"_31098":74657,"_21528":126738,"_5":14794,"_28279":126564,"_3062":126739},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3607":74726,"_31098":74657,"_21528":126741,"_5":14794,"_28279":126564,"_3062":123207},[],{"_3607":74727,"_31098":74657,"_21528":126743,"_5":14794,"_28279":126564,"_3062":126744},[],"Path relativo",{"_3607":74728,"_31098":74657,"_21528":126746,"_5":14794,"_28279":126564,"_3062":121101},[],{"_3607":74729,"_31098":74657,"_21528":126748,"_5":14794,"_28279":126564,"_3062":57871},[],{"_3607":74730,"_31098":74657,"_21528":126750,"_5":14794,"_28279":126564,"_3062":57874},[],{"_3607":74731,"_31098":74657,"_21528":126752,"_5":14794,"_28279":126564,"_3062":126753},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3607":74732,"_31098":74657,"_21528":126755,"_5":14794,"_28279":126564,"_3062":57871},[],{"_3607":74733,"_31098":74657,"_21528":126757,"_5":14794,"_28279":126564,"_3062":57882},[],{"_3607":74734,"_31098":74657,"_21528":126759,"_5":14794,"_28279":126564,"_3062":126760},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3607":74735,"_31098":74657,"_21528":126762,"_5":14794,"_28279":126564,"_3062":57888},[],{"_3607":74736,"_31098":74657,"_21528":126764,"_5":14794,"_28279":126564,"_3062":57882},[],{"_3607":74737,"_31098":74657,"_21528":126766,"_5":14794,"_28279":126564,"_3062":126767},[],"Sustituir la configuración de CRL de una CA.",{"_3607":74738,"_31098":74657,"_21528":126769,"_5":14794,"_28279":126564,"_3062":57896},[],{"_3607":74739,"_31098":74657,"_21528":126771,"_5":14794,"_28279":126564,"_3062":57882},[],{"_3607":74740,"_31098":74657,"_21528":126773,"_5":14794,"_28279":126564,"_3062":126774},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3607":74741,"_31098":74657,"_21528":126776,"_5":14794,"_28279":126564,"_3062":126777},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3607":74742,"_31098":74657,"_21528":126779,"_5":14794,"_28279":126564,"_3062":126780},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3607":74743,"_31098":74657,"_21528":126782,"_5":14794,"_28279":126564,"_3062":126783},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3607":74744,"_31098":74657,"_21528":126785,"_5":14794,"_28279":126568,"_3062":126786},[],"Síntoma",{"_3607":74745,"_31098":74657,"_21528":126788,"_5":14794,"_28279":126568,"_3062":126789},[],"Causa",{"_3607":74746,"_31098":74657,"_21528":126791,"_5":14794,"_28279":126568,"_3062":126792},[],"Acción",{"_3607":74747,"_31098":74657,"_21528":126794,"_5":14794,"_28279":126568,"_3062":126795},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3607":74748,"_31098":74657,"_21528":126797,"_5":14794,"_28279":126568,"_3062":126798},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3607":74749,"_31098":74657,"_21528":126800,"_5":14794,"_28279":126568,"_3062":126801},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3607":74750,"_31098":74657,"_21528":126803,"_5":14794,"_28279":126568,"_3062":126804},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3607":74751,"_31098":74657,"_21528":126806,"_5":14794,"_28279":126568,"_3062":126807},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3607":74752,"_31098":74657,"_21528":126809,"_5":14794,"_28279":126568,"_3062":126810},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3607":74753,"_31098":74657,"_21528":126812,"_5":14794,"_28279":126568,"_3062":126813},[],"`PUT` devuelve 400.",{"_3607":74754,"_31098":74657,"_21528":126815,"_5":14794,"_28279":126568,"_3062":126816},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3607":74755,"_31098":74657,"_21528":126818,"_5":14794,"_28279":126568,"_3062":126819},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3607":74756,"_31098":74657,"_21528":126821,"_5":14794,"_28279":126568,"_3062":126822},[],"`PUT` devuelve 404.",{"_3607":74757,"_31098":74657,"_21528":126824,"_5":14794,"_28279":126568,"_3062":126825},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3607":74758,"_31098":74657,"_21528":126827,"_5":14794,"_28279":126568,"_3062":126828},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3607":74759,"_31098":74657,"_21528":126830,"_5":14794,"_28279":126568,"_3062":126831},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3607":74760,"_31098":74657,"_21528":126833,"_5":14794,"_28279":126568,"_3062":126834},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3607":74761,"_31098":74657,"_21528":126836,"_5":14794,"_28279":126568,"_3062":126837},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3607":74762,"_31098":74657,"_21528":126839,"_5":14794,"_28279":126568,"_3062":126840},[],"La CRL no cambia tras revocar un certificado.",{"_3607":74763,"_31098":74657,"_21528":126842,"_5":14794,"_28279":126568,"_3062":126843},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3607":74764,"_31098":74657,"_21528":126845,"_5":14794,"_28279":126568,"_3062":126846},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3607":74765,"_31098":74657,"_21528":126848,"_5":14794,"_28279":126568,"_3062":126849},[],"Un verificador rechaza la CRL por el emisor.",{"_3607":74766,"_31098":74657,"_21528":126851,"_5":14794,"_28279":126568,"_3062":126852},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3607":74767,"_31098":74657,"_21528":126854,"_5":14794,"_28279":126568,"_3062":126855},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3607":74768,"_31098":74657,"_21528":126857,"_5":14794,"_28279":126572,"_3062":126858},[],"RFC 5280: perfil X.509 y CRL.",{"_3607":74769,"_31098":74657,"_21528":126860,"_5":14794,"_28279":126572,"_3062":57988},[],{"_3607":74770,"_31098":74657,"_21528":126862,"_5":14794,"_28279":126572,"_3062":57991},[],{"_3607":74771,"_31098":74657,"_21528":126864,"_5":14794,"_28279":126572,"_3062":126865},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3607":74772,"_31098":74657,"_21528":126867,"_5":14794,"_28279":126572,"_3062":126868},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3607":74773,"_31098":74773,"_5":15159,"_3062":126870,"_31457":126871,"_21528":126872,"_28279":74773},"Claves y motores criptográficos",[50787,121341,56465,125355],[],{"_3607":74774,"_31098":74773,"_21528":126874,"_5":14794,"_28279":74773,"_3062":126875},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3607":74775,"_31098":74773,"_5":31454,"_21528":126877,"_28279":126878,"_3062":126879},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3607":74776,"_31098":74773,"_5":31454,"_21528":126881,"_28279":126882,"_3062":126883},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3607":74777,"_31098":74773,"_5":31454,"_21528":126885,"_28279":126886,"_3062":58016},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#file-system",{"_3607":74778,"_31098":74773,"_5":31454,"_21528":126888,"_28279":126889,"_3062":58020},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#hashicorp-vault",{"_3607":74779,"_31098":74773,"_5":31454,"_21528":126891,"_28279":126892,"_3062":58024},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#aws-secrets-manager",{"_3607":74780,"_31098":74773,"_5":31454,"_21528":126894,"_28279":126895,"_3062":58028},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#aws-kms",{"_3607":74781,"_31098":74773,"_5":31454,"_21528":126897,"_28279":126898,"_3062":58032},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#pkcs11",{"_3607":74782,"_31098":74773,"_5":31454,"_21528":126900,"_28279":126901,"_3062":58036},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#azure-key-vault",{"_3607":74783,"_31098":74773,"_5":31454,"_21528":126903,"_28279":126904,"_3062":126905},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3607":74784,"_31098":74773,"_5":31454,"_21528":126907,"_28279":126908,"_3062":126909},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3607":74785,"_31098":74773,"_5":31454,"_21528":126911,"_28279":126912,"_3062":126913},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3607":74786,"_31098":74773,"_5":31454,"_21528":126915,"_28279":126916,"_3062":126917},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3607":74787,"_31098":74773,"_5":31454,"_21528":126919,"_28279":126920,"_3062":126921},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3607":74788,"_31098":74773,"_5":31454,"_21528":126923,"_28279":126924,"_3062":126925},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3607":74789,"_31098":74773,"_5":31454,"_21528":126927,"_28279":126928,"_3062":126929},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3607":74790,"_31098":74773,"_5":31454,"_21528":126931,"_28279":126932,"_3062":58068},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#sign",{"_3607":74791,"_31098":74773,"_5":31454,"_21528":126934,"_28279":126935,"_3062":58072},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#verify",{"_3607":74792,"_31098":74773,"_5":31454,"_21528":126937,"_28279":126938,"_3062":126939},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3607":74793,"_31098":74773,"_5":31454,"_21528":126941,"_28279":126942,"_3062":126943},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3607":74794,"_31098":74773,"_5":31454,"_21528":126945,"_28279":126946,"_3062":126947},[],"/docs/pr-preview/pr-75/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3607":74795,"_31098":74773,"_21528":126949,"_5":14794,"_28279":74773,"_3062":126950},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3607":74796,"_31098":74773,"_21528":126952,"_5":14794,"_28279":74773,"_3062":126953},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3607":74797,"_31098":74773,"_21528":126955,"_5":14794,"_28279":126878,"_3062":126956},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3607":74798,"_31098":74773,"_21528":126958,"_5":14794,"_28279":126878,"_3062":126959},[],"En la práctica, permite:",{"_3607":74799,"_31098":74773,"_21528":126961,"_5":14794,"_28279":126878,"_3062":126962},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3607":74800,"_31098":74773,"_21528":126964,"_5":14794,"_28279":126878,"_3062":126965},[],"Importar claves creadas externamente.",{"_3607":74801,"_31098":74773,"_21528":126967,"_5":14794,"_28279":126878,"_3062":126968},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3607":74802,"_31098":74773,"_21528":126970,"_5":14794,"_28279":126878,"_3062":126971},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3607":74803,"_31098":74773,"_21528":126973,"_5":14794,"_28279":126882,"_3062":126974},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3607":74804,"_31098":74773,"_21528":126976,"_5":14794,"_28279":126882,"_3062":126977},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3607":74805,"_31098":74773,"_21528":126979,"_5":14794,"_28279":126882,"_3062":126980},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3607":74806,"_31098":74773,"_21528":126982,"_5":14794,"_28279":126886,"_3062":126983},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3607":74807,"_31098":74773,"_21528":126985,"_5":14794,"_28279":126889,"_3062":126986},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3607":74808,"_31098":74773,"_21528":126988,"_5":14794,"_28279":126889,"_3062":126989},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3607":74809,"_31098":74773,"_21528":126991,"_5":14794,"_28279":126892,"_3062":126992},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3607":74810,"_31098":74773,"_21528":126994,"_5":14794,"_28279":126895,"_3062":126995},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3607":74811,"_31098":74773,"_21528":126997,"_5":14794,"_28279":126898,"_3062":126998},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3607":74812,"_31098":74773,"_21528":127000,"_5":14794,"_28279":126901,"_3062":127001},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3607":74813,"_31098":74773,"_21528":127003,"_5":14794,"_28279":126901,"_3062":127004},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3607":74814,"_31098":74773,"_21528":127006,"_5":14794,"_28279":126901,"_3062":127007},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3607":74815,"_31098":74773,"_21528":127009,"_5":14794,"_28279":126901,"_3062":127010},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3607":74816,"_31098":74773,"_21528":127012,"_5":14794,"_28279":126904,"_3062":127013},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3607":74817,"_31098":74773,"_21528":127015,"_5":14794,"_28279":126904,"_3062":127016},[],"La tabla incluye los siguientes campos:",{"_3607":74818,"_31098":74773,"_21528":127018,"_5":14794,"_28279":126904,"_3062":127019},[],"**Name**: nombre descriptivo de la clave.",{"_3607":74819,"_31098":74773,"_21528":127021,"_5":14794,"_28279":126904,"_3062":127022},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3607":74820,"_31098":74773,"_21528":127024,"_5":14794,"_28279":126904,"_3062":127025},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3607":74821,"_31098":74773,"_21528":127027,"_5":14794,"_28279":126904,"_3062":127028},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3607":74822,"_31098":74773,"_21528":127030,"_5":14794,"_28279":126904,"_3062":127031},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3607":74823,"_31098":74773,"_21528":127033,"_5":14794,"_28279":126904,"_3062":127034},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3607":74824,"_31098":74773,"_21528":127036,"_5":14794,"_28279":126904,"_3062":127037},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3607":74825,"_31098":74773,"_21528":127039,"_5":14794,"_28279":126904,"_3062":127040},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3607":74826,"_31098":74773,"_21528":127042,"_5":14794,"_28279":126904,"_3062":127043},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3607":74827,"_31098":74773,"_21528":127045,"_5":14794,"_28279":126904,"_3062":127046},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3607":74828,"_31098":74773,"_21528":127048,"_5":14794,"_28279":126904,"_3062":127049},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3607":74829,"_31098":74773,"_21528":127051,"_5":14794,"_28279":126904,"_3062":127052},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3607":74830,"_31098":74773,"_21528":127054,"_5":14794,"_28279":126904,"_3062":127055},[],"**Delete Key** para eliminar la clave del sistema.",{"_3607":74831,"_31098":74773,"_21528":127057,"_5":14794,"_28279":126908,"_3062":127058},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3607":74832,"_31098":74773,"_21528":127060,"_5":14794,"_28279":126912,"_3062":127061},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3607":74833,"_31098":74773,"_21528":127063,"_5":14794,"_28279":126912,"_3062":127064},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3607":74834,"_31098":74773,"_21528":127066,"_5":14794,"_28279":126912,"_3062":127067},[],"**Key Name**: nombre único y descriptivo.",{"_3607":74835,"_31098":74773,"_21528":127069,"_5":14794,"_28279":126912,"_3062":127070},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3607":74836,"_31098":74773,"_21528":127072,"_5":14794,"_28279":126912,"_3062":127073},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3607":74837,"_31098":74773,"_21528":127075,"_5":14794,"_28279":126912,"_3062":127076},[],"**Tags**: metadatos para clasificar la clave.",{"_3607":74838,"_31098":74773,"_21528":127078,"_5":14794,"_28279":126912,"_3062":127079},[],"**Metadata**: información adicional para usos avanzados.",{"_3607":74839,"_31098":74773,"_21528":127081,"_5":14794,"_28279":126916,"_3062":127082},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3607":74840,"_31098":74773,"_21528":127084,"_5":14794,"_28279":126916,"_3062":127085},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3607":74841,"_31098":74773,"_21528":127087,"_5":14794,"_28279":126916,"_3062":127088},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3607":74842,"_31098":74773,"_21528":127090,"_5":14794,"_28279":126916,"_3062":127091},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3607":74843,"_31098":74773,"_21528":127093,"_5":14794,"_28279":126916,"_3062":127094},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3607":74844,"_31098":74773,"_21528":127096,"_5":14794,"_28279":126916,"_3062":127097},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3607":74845,"_31098":74773,"_21528":127099,"_5":14794,"_28279":126916,"_3062":127100},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3607":74846,"_31098":74773,"_21528":127102,"_5":14794,"_28279":126916,"_3062":127103},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3607":74847,"_31098":74773,"_21528":127105,"_5":14794,"_28279":126916,"_3062":127106},[],"**Metadata**: información adicional opcional.",{"_3607":74848,"_31098":74773,"_21528":127108,"_5":14794,"_28279":126916,"_3062":127109},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3607":74849,"_31098":74773,"_21528":127111,"_5":14794,"_28279":126916,"_3062":127112},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3607":74850,"_31098":74773,"_21528":127114,"_5":14794,"_28279":126920,"_3062":127115},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3607":74851,"_31098":74773,"_21528":127117,"_5":14794,"_28279":126924,"_3062":127118},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3607":74852,"_31098":74773,"_21528":127120,"_5":14794,"_28279":126924,"_3062":127121},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3607":74853,"_31098":74773,"_21528":127123,"_5":14794,"_28279":126924,"_3062":127124},[],"**Key Name**: nombre descriptivo.",{"_3607":74854,"_31098":74773,"_21528":127126,"_5":14794,"_28279":126924,"_3062":127127},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3607":74855,"_31098":74773,"_21528":127129,"_5":14794,"_28279":126924,"_3062":127130},[],"**Tags**: etiquetas asociadas.",{"_3607":74856,"_31098":74773,"_21528":127132,"_5":14794,"_28279":126924,"_3062":127133},[],"**Aliases**: nombres alternativos.",{"_3607":74857,"_31098":74773,"_21528":127135,"_5":14794,"_28279":126924,"_3062":127136},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3607":74858,"_31098":74773,"_21528":127138,"_5":14794,"_28279":126924,"_3062":127139},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3607":74859,"_31098":74773,"_21528":127141,"_5":14794,"_28279":126924,"_3062":127142},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3607":74860,"_31098":74773,"_21528":127144,"_5":14794,"_28279":126924,"_3062":127145},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3607":74861,"_31098":74773,"_21528":127147,"_5":14794,"_28279":126928,"_3062":127148},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3607":74862,"_31098":74773,"_21528":127150,"_5":14794,"_28279":126928,"_3062":127151},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3607":74863,"_31098":74773,"_21528":127153,"_5":14794,"_28279":126928,"_3062":127154},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3607":74864,"_31098":74773,"_21528":127156,"_5":14794,"_28279":126932,"_3062":127157},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3607":74865,"_31098":74773,"_21528":127159,"_5":14794,"_28279":126932,"_3062":127160},[],"Campos principales:",{"_3607":74866,"_31098":74773,"_21528":127162,"_5":14794,"_28279":126932,"_3062":127163},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3607":74867,"_31098":74773,"_21528":127165,"_5":14794,"_28279":126932,"_3062":127166},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3607":74868,"_31098":74773,"_21528":127168,"_5":14794,"_28279":126932,"_3062":127169},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3607":74869,"_31098":74773,"_21528":127171,"_5":14794,"_28279":126932,"_3062":127172},[],"**Message**: contenido que se va a firmar.",{"_3607":74870,"_31098":74773,"_21528":127174,"_5":14794,"_28279":126932,"_3062":127175},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3607":74871,"_31098":74773,"_21528":127177,"_5":14794,"_28279":126935,"_3062":127178},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3607":74872,"_31098":74773,"_21528":127180,"_5":14794,"_28279":126935,"_3062":127160},[],{"_3607":74873,"_31098":74773,"_21528":127182,"_5":14794,"_28279":126935,"_3062":127183},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3607":74874,"_31098":74773,"_21528":127185,"_5":14794,"_28279":126935,"_3062":127186},[],"**Message Type**: `Raw` o `Digest`.",{"_3607":74875,"_31098":74773,"_21528":127188,"_5":14794,"_28279":126935,"_3062":127189},[],"**Payload Encoding**: codificación del mensaje.",{"_3607":74876,"_31098":74773,"_21528":127191,"_5":14794,"_28279":126935,"_3062":127192},[],"**Message**: mensaje original o hash.",{"_3607":74877,"_31098":74773,"_21528":127194,"_5":14794,"_28279":126935,"_3062":127195},[],"**Signature**: firma que se desea comprobar.",{"_3607":74878,"_31098":74773,"_21528":127197,"_5":14794,"_28279":126935,"_3062":127198},[],"**Result**: indicador del resultado de la validación.",{"_3607":74879,"_31098":74773,"_21528":127200,"_5":14794,"_28279":126938,"_3062":127201},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3607":74880,"_31098":74773,"_21528":127203,"_5":14794,"_28279":126938,"_3062":127204},[],"Este flujo es útil para:",{"_3607":74881,"_31098":74773,"_21528":127206,"_5":14794,"_28279":126938,"_3062":127207},[],"Solicitar certificados a una CA externa.",{"_3607":74882,"_31098":74773,"_21528":127209,"_5":14794,"_28279":126938,"_3062":127210},[],"Renovar una identidad manteniendo la misma clave.",{"_3607":74883,"_31098":74773,"_21528":127212,"_5":14794,"_28279":126938,"_3062":127213},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3607":74884,"_31098":74773,"_21528":127215,"_5":14794,"_28279":126938,"_3062":127216},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3607":74885,"_31098":74773,"_21528":127218,"_5":14794,"_28279":126938,"_3062":127219},[],"**Organization (O)**: organización o empresa.",{"_3607":74886,"_31098":74773,"_21528":127221,"_5":14794,"_28279":126938,"_3062":127222},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3607":74887,"_31098":74773,"_21528":127224,"_5":14794,"_28279":126938,"_3062":127225},[],"**Country (C)**: código de país de dos letras.",{"_3607":74888,"_31098":74773,"_21528":127227,"_5":14794,"_28279":126938,"_3062":127228},[],"**State / Province (ST)**: estado o provincia.",{"_3607":74889,"_31098":74773,"_21528":127230,"_5":14794,"_28279":126938,"_3062":127231},[],"**Locality (L)**: ciudad o localidad.",{"_3607":74890,"_31098":74773,"_21528":127233,"_5":14794,"_28279":126938,"_3062":127234},[],"**Email Address**: correo de contacto.",{"_3607":74891,"_31098":74773,"_21528":127236,"_5":14794,"_28279":126938,"_3062":127237},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3607":74892,"_31098":74773,"_21528":127239,"_5":14794,"_28279":126938,"_3062":127240},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3607":74893,"_31098":74773,"_21528":127242,"_5":14794,"_28279":126942,"_3062":127243},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3607":74894,"_31098":74773,"_21528":127245,"_5":14794,"_28279":126942,"_3062":127246},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3607":74895,"_31098":74773,"_21528":127248,"_5":14794,"_28279":126946,"_3062":127249},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3607":74896,"_31098":74773,"_21528":127251,"_5":14794,"_28279":126946,"_3062":127252},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3607":74897,"_31098":74897,"_5":15159,"_3062":127254,"_31457":127255,"_21528":127256,"_28279":74897},"Validación online con OCSP",[50787,121341,56465,126010],[],{"_3607":74898,"_31098":74897,"_21528":127258,"_5":14794,"_28279":74897,"_3062":127259},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3607":74899,"_31098":74897,"_5":31454,"_21528":127261,"_28279":127262,"_3062":127263},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3607":74900,"_31098":74897,"_5":31454,"_21528":127265,"_28279":127266,"_3062":127267},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3607":74901,"_31098":74897,"_5":31454,"_21528":127269,"_28279":127270,"_3062":127271},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3607":74902,"_31098":74897,"_5":31454,"_21528":127273,"_28279":127274,"_3062":127275},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3607":74903,"_31098":74897,"_5":31454,"_21528":127277,"_28279":127278,"_3062":127279},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3607":74904,"_31098":74897,"_5":31454,"_21528":127281,"_28279":127282,"_3062":126573},[],"/docs/pr-preview/pr-75/es/platform/pki/ocsp#referencias",{"_3607":74905,"_31098":74897,"_21528":127284,"_5":14794,"_28279":74897,"_3062":127285},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3607":74906,"_31098":74897,"_21528":127287,"_5":14794,"_28279":127262,"_3062":127288},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3607":74907,"_31098":74897,"_21528":127290,"_5":14794,"_28279":127262,"_3062":127291},[],"Estado del registro",{"_3607":74908,"_31098":74897,"_21528":127293,"_5":14794,"_28279":127262,"_3062":127294},[],"Respuesta firmada",{"_3607":74909,"_31098":74897,"_21528":127296,"_5":14794,"_28279":127262,"_3062":55602},[],{"_3607":74910,"_31098":74897,"_21528":127298,"_5":14794,"_28279":127262,"_3062":58436},[],{"_3607":74911,"_31098":74897,"_21528":127300,"_5":14794,"_28279":127262,"_3062":55619},[],{"_3607":74912,"_31098":74897,"_21528":127302,"_5":14794,"_28279":127262,"_3062":127303},[],"`Revoked`, con razón y fecha de revocación.",{"_3607":74913,"_31098":74897,"_21528":127305,"_5":14794,"_28279":127262,"_3062":127306},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3607":74914,"_31098":74897,"_21528":127308,"_5":14794,"_28279":127262,"_3062":127309},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3607":74915,"_31098":74897,"_21528":127311,"_5":14794,"_28279":127262,"_3062":127312},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3607":74916,"_31098":74897,"_21528":127314,"_5":14794,"_28279":127262,"_3062":127315},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3607":74917,"_31098":74897,"_21528":127317,"_5":14794,"_28279":127262,"_3062":127318},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3607":74918,"_31098":74897,"_21528":127320,"_5":14794,"_28279":127266,"_3062":127321},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3607":74919,"_31098":74897,"_21528":127323,"_5":14794,"_28279":127266,"_3062":127324},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3607":74920,"_31098":74897,"_21528":127326,"_5":14794,"_28279":127270,"_3062":127327},[],"El servicio acepta:",{"_3607":74921,"_31098":74897,"_21528":127329,"_5":14794,"_28279":127270,"_3062":123207},[],{"_3607":74922,"_31098":74897,"_21528":127331,"_5":14794,"_28279":127270,"_3062":127332},[],"Ruta del servicio VA",{"_3607":74923,"_31098":74897,"_21528":127334,"_5":14794,"_28279":127270,"_3062":127335},[],"Formato",{"_3607":74924,"_31098":74897,"_21528":127337,"_5":14794,"_28279":127270,"_3062":58476},[],{"_3607":74925,"_31098":74897,"_21528":127339,"_5":14794,"_28279":127270,"_3062":58479},[],{"_3607":74926,"_31098":74897,"_21528":127341,"_5":14794,"_28279":127270,"_3062":127342},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3607":74927,"_31098":74897,"_21528":127344,"_5":14794,"_28279":127270,"_3062":57871},[],{"_3607":74928,"_31098":74897,"_21528":127346,"_5":14794,"_28279":127270,"_3062":58487},[],{"_3607":74929,"_31098":74897,"_21528":127348,"_5":14794,"_28279":127270,"_3062":127349},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3607":74930,"_31098":74897,"_21528":127351,"_5":14794,"_28279":127270,"_3062":127352},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3607":74931,"_31098":74897,"_21528":127354,"_5":14794,"_28279":127274,"_3062":127355},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3607":74932,"_31098":74897,"_21528":127357,"_5":14794,"_28279":127274,"_3062":127358},[],"Genera la solicitud:",{"_3607":74933,"_31098":74897,"_21528":127360,"_5":14794,"_28279":127274,"_3062":127361},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3607":74934,"_31098":74897,"_21528":127363,"_5":14794,"_28279":127274,"_3062":127364},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3607":74935,"_31098":74897,"_21528":127366,"_5":14794,"_28279":127274,"_3062":127367},[],"Verifica el DER recibido:",{"_3607":74936,"_31098":74897,"_21528":127369,"_5":14794,"_28279":127274,"_3062":127370},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3607":74937,"_31098":74897,"_21528":127372,"_5":14794,"_28279":127278,"_3062":127373},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3607":74938,"_31098":74897,"_21528":127375,"_5":14794,"_28279":127278,"_3062":127376},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3607":74939,"_31098":74897,"_21528":127378,"_5":14794,"_28279":127282,"_3062":58520},[],{"_3607":74940,"_31098":74897,"_21528":127380,"_5":14794,"_28279":127282,"_3062":58523},[],{"_3607":74941,"_31098":74897,"_21528":127382,"_5":14794,"_28279":127282,"_3062":127383},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3607":74942,"_31098":74897,"_21528":127385,"_5":14794,"_28279":127282,"_3062":126868},[],{"_3607":74943,"_31098":74943,"_5":15159,"_3062":56465,"_31457":127387,"_21528":127388,"_28279":74943},[50787,121341,56465],[],{"_3607":74944,"_31098":74943,"_21528":127390,"_5":14794,"_28279":74943,"_3062":127391},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3607":74945,"_31098":74943,"_5":31454,"_21528":127393,"_28279":127394,"_3062":124681},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#empieza-aquí",{"_3607":74946,"_31098":74943,"_5":31454,"_21528":127396,"_28279":127397,"_3062":127398},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3607":74947,"_31098":74943,"_5":31454,"_21528":127400,"_28279":127401,"_3062":125201},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#capacidades-principales",{"_3607":74948,"_31098":74943,"_5":31454,"_21528":127403,"_28279":127404,"_3062":125205},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3607":74949,"_31098":74943,"_5":31454,"_21528":127406,"_28279":127407,"_3062":125209},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3607":74950,"_31098":74943,"_5":31454,"_21528":127409,"_28279":127410,"_3062":125213},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#emite-y-controla-certificados",{"_3607":74951,"_31098":74943,"_5":31454,"_21528":127412,"_28279":127413,"_3062":125221},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#publica-el-estado-de-validación",{"_3607":74952,"_31098":74943,"_5":31454,"_21528":127415,"_28279":127416,"_3062":127417},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3607":74953,"_31098":74943,"_5":31454,"_21528":127419,"_28279":127420,"_3062":126176},[],"/docs/pr-preview/pr-75/es/platform/pki/overview#continúa",{"_3607":74954,"_31098":74943,"_21528":127422,"_5":14794,"_28279":74943,"_3062":127423},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3607":74955,"_31098":74943,"_21528":127425,"_5":14794,"_28279":127394,"_3062":127426},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3607":74956,"_31098":74943,"_21528":127428,"_5":14794,"_28279":127394,"_3062":127429},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3607":74957,"_31098":74943,"_21528":127431,"_5":14794,"_28279":127397,"_3062":127432},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3607":74958,"_31098":74943,"_21528":127434,"_5":14794,"_28279":127397,"_3062":127435},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3607":74959,"_31098":74943,"_21528":127437,"_5":14794,"_28279":127397,"_3062":127438},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3607":74960,"_31098":74943,"_21528":127440,"_5":14794,"_28279":127397,"_3062":127441},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3607":74961,"_31098":74943,"_21528":127443,"_5":14794,"_28279":127397,"_3062":127444},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3607":74962,"_31098":74943,"_21528":127446,"_5":14794,"_28279":127404,"_3062":127447},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3607":74963,"_31098":74943,"_21528":127449,"_5":14794,"_28279":127407,"_3062":127450},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3607":74964,"_31098":74943,"_21528":127452,"_5":14794,"_28279":127410,"_3062":127453},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3607":74965,"_31098":74943,"_21528":127455,"_5":14794,"_28279":127413,"_3062":127456},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3607":74966,"_31098":74943,"_21528":127458,"_5":14794,"_28279":127416,"_3062":127459},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3607":74967,"_31098":74943,"_21528":127461,"_5":14794,"_28279":127416,"_3062":127462},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3607":74968,"_31098":74943,"_21528":127464,"_5":14794,"_28279":127416,"_3062":127465},[],"su clave pública corresponda a la clave privada del cliente;",{"_3607":74969,"_31098":74943,"_21528":127467,"_5":14794,"_28279":127416,"_3062":127468},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3607":74970,"_31098":74943,"_21528":127470,"_5":14794,"_28279":127416,"_3062":127471},[],"sus fechas y usos permitan la operación;",{"_3607":74971,"_31098":74943,"_21528":127473,"_5":14794,"_28279":127416,"_3062":127474},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3607":74972,"_31098":74943,"_21528":127476,"_5":14794,"_28279":127416,"_3062":127477},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3607":74973,"_31098":74943,"_21528":127479,"_5":14794,"_28279":127420,"_3062":127480},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3607":74974,"_31098":74943,"_21528":127482,"_5":14794,"_28279":127420,"_3062":127483},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3607":74975,"_31098":74943,"_21528":127485,"_5":14794,"_28279":127420,"_3062":127486},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3607":74976,"_31098":74976,"_5":15159,"_3062":127488,"_31457":127489,"_21528":127490,"_28279":74976},"Crea tu primera CA",[50787,121341,56465,124805],[],{"_3607":74977,"_31098":74976,"_21528":127492,"_5":14794,"_28279":74976,"_3062":127493},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3607":74978,"_31098":74976,"_5":31454,"_21528":127495,"_28279":127496,"_3062":119875},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3607":74979,"_31098":74976,"_5":31454,"_21528":127498,"_28279":127499,"_3062":127500},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3607":74980,"_31098":74976,"_5":31454,"_21528":127502,"_28279":127503,"_3062":127504},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3607":74981,"_31098":74976,"_5":31454,"_21528":127506,"_28279":127507,"_3062":127508},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3607":74982,"_31098":74976,"_5":31454,"_21528":127510,"_28279":127511,"_3062":127512},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3607":74983,"_31098":74976,"_5":31454,"_21528":127514,"_28279":127515,"_3062":127516},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3607":74984,"_31098":74976,"_5":31454,"_21528":127518,"_28279":127519,"_3062":127520},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3607":74985,"_31098":74976,"_5":31454,"_21528":127522,"_28279":127523,"_3062":125052},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3607":74986,"_31098":74976,"_5":31454,"_21528":127525,"_28279":127526,"_3062":119899},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3607":74987,"_31098":74976,"_21528":127528,"_5":14794,"_28279":74976,"_3062":127529},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3607":74988,"_31098":74976,"_21528":127531,"_5":14794,"_28279":127496,"_3062":127532},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3607":74989,"_31098":74976,"_21528":127534,"_5":14794,"_28279":127496,"_3062":127535},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3607":74990,"_31098":74976,"_21528":127537,"_5":14794,"_28279":127496,"_3062":127538},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3607":74991,"_31098":74976,"_21528":127540,"_5":14794,"_28279":127496,"_3062":127541},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3607":74992,"_31098":74976,"_21528":127543,"_5":14794,"_28279":127499,"_3062":127544},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3607":74993,"_31098":74976,"_21528":127546,"_5":14794,"_28279":127499,"_3062":127547},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3607":74994,"_31098":74976,"_21528":127549,"_5":14794,"_28279":127503,"_3062":127550},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3607":74995,"_31098":74976,"_21528":127552,"_5":14794,"_28279":127503,"_3062":127553},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3607":74996,"_31098":74976,"_21528":127555,"_5":14794,"_28279":127507,"_3062":127556},[],"Selecciona **Root CA** y completa:",{"_3607":74997,"_31098":74976,"_21528":127558,"_5":14794,"_28279":127507,"_3062":58702},[],{"_3607":74998,"_31098":74976,"_21528":127560,"_5":14794,"_28279":127507,"_3062":127561},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3607":74999,"_31098":74976,"_21528":127563,"_5":14794,"_28279":127507,"_3062":127564},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3607":75000,"_31098":74976,"_21528":127566,"_5":14794,"_28279":127507,"_3062":127567},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3607":75001,"_31098":74976,"_21528":127569,"_5":14794,"_28279":127507,"_3062":127570},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3607":75002,"_31098":74976,"_21528":127572,"_5":14794,"_28279":127511,"_3062":127573},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3607":75003,"_31098":74976,"_21528":127575,"_5":14794,"_28279":127515,"_3062":127576},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3607":75004,"_31098":74976,"_21528":127578,"_5":14794,"_28279":127515,"_3062":127579},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3607":75005,"_31098":74976,"_21528":127581,"_5":14794,"_28279":127519,"_3062":127582},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3607":75006,"_31098":74976,"_21528":127584,"_5":14794,"_28279":127519,"_3062":127585},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3607":75007,"_31098":74976,"_21528":127587,"_5":14794,"_28279":127519,"_3062":127588},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3607":75008,"_31098":74976,"_21528":127590,"_5":14794,"_28279":127523,"_3062":127591},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3607":75009,"_31098":74976,"_21528":127593,"_5":14794,"_28279":127523,"_3062":127594},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3607":75010,"_31098":74976,"_21528":127596,"_5":14794,"_28279":127523,"_3062":127597},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3607":75011,"_31098":74976,"_21528":127599,"_5":14794,"_28279":127523,"_3062":127600},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3607":75012,"_31098":74976,"_21528":127602,"_5":14794,"_28279":127526,"_3062":127603},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3607":75013,"_31098":75013,"_5":15159,"_3062":127605,"_31457":127606,"_21528":127607,"_28279":75013},"Emite y verifica un certificado",[50787,121341,56465,124805],[],{"_3607":75014,"_31098":75013,"_21528":127609,"_5":14794,"_28279":75013,"_3062":127610},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3607":75015,"_31098":75013,"_5":31454,"_21528":127612,"_28279":127613,"_3062":119875},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3607":75016,"_31098":75013,"_5":31454,"_21528":127615,"_28279":127616,"_3062":127617},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3607":75017,"_31098":75013,"_5":31454,"_21528":127619,"_28279":127620,"_3062":127621},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3607":75018,"_31098":75013,"_5":31454,"_21528":127623,"_28279":127624,"_3062":127625},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3607":75019,"_31098":75013,"_5":31454,"_21528":127627,"_28279":127628,"_3062":127629},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3607":75020,"_31098":75013,"_5":31454,"_21528":127631,"_28279":127632,"_3062":127633},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3607":75021,"_31098":75013,"_5":31454,"_21528":127635,"_28279":127636,"_3062":127637},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3607":75022,"_31098":75013,"_5":31454,"_21528":127639,"_28279":127640,"_3062":127641},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3607":75023,"_31098":75013,"_5":31454,"_21528":127643,"_28279":127644,"_3062":127645},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3607":75024,"_31098":75013,"_5":31454,"_21528":127647,"_28279":127648,"_3062":127649},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3607":75025,"_31098":75013,"_5":31454,"_21528":127651,"_28279":127652,"_3062":125052},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3607":75026,"_31098":75013,"_5":31454,"_21528":127654,"_28279":127655,"_3062":119899},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3607":75027,"_31098":75013,"_21528":127657,"_5":14794,"_28279":75013,"_3062":127658},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3607":75028,"_31098":75013,"_21528":127660,"_5":14794,"_28279":127613,"_3062":127661},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3607":75029,"_31098":75013,"_21528":127663,"_5":14794,"_28279":127613,"_3062":127664},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3607":75030,"_31098":75013,"_21528":127666,"_5":14794,"_28279":127613,"_3062":127667},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3607":75031,"_31098":75013,"_21528":127669,"_5":14794,"_28279":127613,"_3062":127670},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3607":75032,"_31098":75013,"_21528":127672,"_5":14794,"_28279":127613,"_3062":127673},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3607":75033,"_31098":75013,"_21528":127675,"_5":14794,"_28279":127616,"_3062":127676},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3607":75034,"_31098":75013,"_21528":127678,"_5":14794,"_28279":127620,"_3062":127679},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3607":75035,"_31098":75013,"_21528":127681,"_5":14794,"_28279":127620,"_3062":127682},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3607":75036,"_31098":75013,"_21528":127684,"_5":14794,"_28279":127624,"_3062":127685},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3607":75037,"_31098":75013,"_21528":127687,"_5":14794,"_28279":127624,"_3062":127688},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3607":75038,"_31098":75013,"_21528":127690,"_5":14794,"_28279":127628,"_3062":127691},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3607":75039,"_31098":75013,"_21528":127693,"_5":14794,"_28279":127628,"_3062":127694},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3607":75040,"_31098":75013,"_21528":127696,"_5":14794,"_28279":127632,"_3062":127697},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3607":75041,"_31098":75013,"_21528":127699,"_5":14794,"_28279":127636,"_3062":127700},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3607":75042,"_31098":75013,"_21528":127702,"_5":14794,"_28279":127640,"_3062":127703},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3607":75043,"_31098":75013,"_21528":127705,"_5":14794,"_28279":127644,"_3062":127706},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3607":75044,"_31098":75013,"_21528":127708,"_5":14794,"_28279":127644,"_3062":127709},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3607":75045,"_31098":75013,"_21528":127711,"_5":14794,"_28279":127644,"_3062":127712},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3607":75046,"_31098":75013,"_21528":127714,"_5":14794,"_28279":127648,"_3062":127715},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3607":75047,"_31098":75013,"_21528":127717,"_5":14794,"_28279":127648,"_3062":127718},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3607":75048,"_31098":75013,"_21528":127720,"_5":14794,"_28279":127648,"_3062":127721},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3607":75049,"_31098":75013,"_21528":127723,"_5":14794,"_28279":127652,"_3062":125135},[],{"_3607":75050,"_31098":75013,"_21528":127725,"_5":14794,"_28279":127652,"_3062":123656},[],{"_3607":75051,"_31098":75013,"_21528":127727,"_5":14794,"_28279":127652,"_3062":127728},[],"La CA rechaza la emisión",{"_3607":75052,"_31098":75013,"_21528":127730,"_5":14794,"_28279":127652,"_3062":127731},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3607":75053,"_31098":75013,"_21528":127733,"_5":14794,"_28279":127652,"_3062":127734},[],"Sujeto o usos diferentes",{"_3607":75054,"_31098":75013,"_21528":127736,"_5":14794,"_28279":127652,"_3062":127737},[],"Perfil aplicado y valores solicitados.",{"_3607":75055,"_31098":75013,"_21528":127739,"_5":14794,"_28279":127652,"_3062":127740},[],"No se encuentra el emisor",{"_3607":75056,"_31098":75013,"_21528":127742,"_5":14794,"_28279":127652,"_3062":127743},[],"CA descargada y cadena intermedia necesaria.",{"_3607":75057,"_31098":75013,"_21528":127745,"_5":14794,"_28279":127652,"_3062":127746},[],"Falla la vigencia",{"_3607":75058,"_31098":75013,"_21528":127748,"_5":14794,"_28279":127652,"_3062":127749},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3607":75059,"_31098":75013,"_21528":127751,"_5":14794,"_28279":127652,"_3062":127752},[],"Los resúmenes de clave difieren",{"_3607":75060,"_31098":75013,"_21528":127754,"_5":14794,"_28279":127652,"_3062":127755},[],"Archivos de certificado y clave de la misma emisión.",{"_3607":75061,"_31098":75013,"_21528":127757,"_5":14794,"_28279":127652,"_3062":127758},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3607":75062,"_31098":75013,"_21528":127760,"_5":14794,"_28279":127655,"_3062":127761},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3607":75063,"_31098":75013,"_21528":127763,"_5":14794,"_28279":127655,"_3062":127764},[],"Gestionar certificados para inspección, estado y revocación.",{"_3607":75064,"_31098":75013,"_21528":127766,"_5":14794,"_28279":127655,"_3062":127767},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3607":75065,"_31098":75013,"_21528":127769,"_5":14794,"_28279":127655,"_3062":127770},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3607":75066,"_31098":75013,"_21528":127772,"_5":14794,"_28279":127655,"_3062":127773},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3607":75067,"_31098":75067,"_5":15159,"_3062":127775,"_31457":127776,"_21528":127777,"_28279":75067},"Primeros pasos de PKI",[50787,121341,56465,124805],[],{"_3607":75068,"_31098":75067,"_21528":127779,"_5":14794,"_28279":75067,"_3062":127780},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3607":75069,"_31098":75067,"_5":31454,"_21528":127782,"_28279":127783,"_3062":119875},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3607":75070,"_31098":75067,"_5":31454,"_21528":127785,"_28279":127786,"_3062":127787},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3607":75071,"_31098":75067,"_5":31454,"_21528":127789,"_28279":127790,"_3062":124987},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3607":75072,"_31098":75067,"_5":31454,"_21528":127792,"_28279":127793,"_3062":127794},[],"/docs/pr-preview/pr-75/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3607":75073,"_31098":75067,"_21528":127796,"_5":14794,"_28279":75067,"_3062":127797},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3607":75074,"_31098":75067,"_21528":127799,"_5":14794,"_28279":127783,"_3062":127800},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3607":75075,"_31098":75067,"_21528":127802,"_5":14794,"_28279":127783,"_3062":127803},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3607":75076,"_31098":75067,"_21528":127805,"_5":14794,"_28279":127783,"_3062":127806},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3607":75077,"_31098":75067,"_21528":127808,"_5":14794,"_28279":127783,"_3062":127809},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3607":75078,"_31098":75067,"_21528":127811,"_5":14794,"_28279":127783,"_3062":127812},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3607":75079,"_31098":75067,"_21528":127814,"_5":14794,"_28279":127786,"_3062":127815},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3607":75080,"_31098":75067,"_21528":127817,"_5":14794,"_28279":127786,"_3062":127818},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3607":75081,"_31098":75067,"_21528":127820,"_5":14794,"_28279":127786,"_3062":127821},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3607":75082,"_31098":75067,"_21528":127823,"_5":14794,"_28279":127786,"_3062":127824},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3607":75083,"_31098":75067,"_21528":127826,"_5":14794,"_28279":127790,"_3062":127827},[],"Archivo o recurso",{"_3607":75084,"_31098":75067,"_21528":127829,"_5":14794,"_28279":127790,"_3062":124984},[],{"_3607":75085,"_31098":75067,"_21528":127831,"_5":14794,"_28279":127790,"_3062":127832},[],"CA raíz activa y `ca.pem`",{"_3607":75086,"_31098":75067,"_21528":127834,"_5":14794,"_28279":127790,"_3062":127835},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3607":75087,"_31098":75067,"_21528":127837,"_5":14794,"_28279":127790,"_3062":127838},[],"Certificado final y `device.crt`",{"_3607":75088,"_31098":75067,"_21528":127840,"_5":14794,"_28279":127790,"_3062":127841},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3607":75089,"_31098":75067,"_21528":127843,"_5":14794,"_28279":127790,"_3062":127844},[],"Clave privada `device.key`",{"_3607":75090,"_31098":75067,"_21528":127846,"_5":14794,"_28279":127790,"_3062":127847},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3607":75091,"_31098":75067,"_21528":127849,"_5":14794,"_28279":127790,"_3062":127850},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3607":75092,"_31098":75067,"_21528":127852,"_5":14794,"_28279":127793,"_3062":127853},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3607":75093,"_31098":75067,"_21528":127855,"_5":14794,"_28279":127793,"_3062":127856},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3607":75094,"_31098":75067,"_21528":127858,"_5":14794,"_28279":127793,"_3062":127859},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3607":75095,"_31098":75095,"_5":15159,"_3062":127861,"_31457":127862,"_21528":127864,"_28279":75095},"Resolución de problemas PKI",[50787,121341,56465,127863],"Resolución de problemas",[],{"_3607":75096,"_31098":75095,"_21528":127866,"_5":14794,"_28279":75095,"_3062":127867},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3607":75097,"_31098":75095,"_5":31454,"_21528":127869,"_28279":127870,"_3062":127871},[],"/docs/pr-preview/pr-75/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3607":75098,"_31098":75095,"_5":31454,"_21528":127873,"_28279":127874,"_3062":127875},[],"/docs/pr-preview/pr-75/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3607":75099,"_31098":75095,"_5":31454,"_21528":127877,"_28279":127878,"_3062":127879},[],"/docs/pr-preview/pr-75/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3607":75100,"_31098":75095,"_21528":127881,"_5":14794,"_28279":75095,"_3062":127882},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3607":75101,"_31098":75095,"_21528":127884,"_5":14794,"_28279":75095,"_3062":127885},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3607":75102,"_31098":75095,"_21528":127887,"_5":14794,"_28279":127870,"_3062":124984},[],{"_3607":75103,"_31098":75095,"_21528":127889,"_5":14794,"_28279":127870,"_3062":123656},[],{"_3607":75104,"_31098":75095,"_21528":127891,"_5":14794,"_28279":127870,"_3062":119899},[],{"_3607":75105,"_31098":75095,"_21528":127893,"_5":14794,"_28279":127870,"_3062":55307},[],{"_3607":75106,"_31098":75095,"_21528":127895,"_5":14794,"_28279":127870,"_3062":127896},[],"Existe, está activa y sus fechas son utilizables.",{"_3607":75107,"_31098":75095,"_21528":127898,"_5":14794,"_28279":127870,"_3062":127899},[],"Autoridades.",{"_3607":75108,"_31098":75095,"_21528":127901,"_5":14794,"_28279":127870,"_3062":127902},[],"Clave",{"_3607":75109,"_31098":75095,"_21528":127904,"_5":14794,"_28279":127870,"_3062":127905},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3607":75110,"_31098":75095,"_21528":127907,"_5":14794,"_28279":127870,"_3062":127908},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3607":75111,"_31098":75095,"_21528":127910,"_5":14794,"_28279":127870,"_3062":59056},[],{"_3607":75112,"_31098":75095,"_21528":127912,"_5":14794,"_28279":127870,"_3062":127913},[],"PEM correcto y firma verificable.",{"_3607":75113,"_31098":75095,"_21528":127915,"_5":14794,"_28279":127870,"_3062":59062},[],{"_3607":75114,"_31098":75095,"_21528":127917,"_5":14794,"_28279":127870,"_3062":127918},[],"Perfil",{"_3607":75115,"_31098":75095,"_21528":127920,"_5":14794,"_28279":127870,"_3062":127921},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3607":75116,"_31098":75095,"_21528":127923,"_5":14794,"_28279":127870,"_3062":127924},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3607":75117,"_31098":75095,"_21528":127926,"_5":14794,"_28279":127870,"_3062":125135},[],{"_3607":75118,"_31098":75095,"_21528":127928,"_5":14794,"_28279":127870,"_3062":127929},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3607":75119,"_31098":75095,"_21528":127931,"_5":14794,"_28279":127870,"_3062":127932},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3607":75120,"_31098":75095,"_21528":127934,"_5":14794,"_28279":127870,"_3062":127935},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3607":75121,"_31098":75095,"_21528":127937,"_5":14794,"_28279":127870,"_3062":127938},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3607":75122,"_31098":75095,"_21528":127940,"_5":14794,"_28279":127870,"_3062":127941},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3607":75123,"_31098":75095,"_21528":127943,"_5":14794,"_28279":127874,"_3062":127944},[],"Revisa cada frontera por separado:",{"_3607":75124,"_31098":75095,"_21528":127946,"_5":14794,"_28279":127874,"_3062":127947},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3607":75125,"_31098":75095,"_21528":127949,"_5":14794,"_28279":127874,"_3062":127950},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3607":75126,"_31098":75095,"_21528":127952,"_5":14794,"_28279":127874,"_3062":127953},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3607":75127,"_31098":75095,"_21528":127955,"_5":14794,"_28279":127874,"_3062":127956},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3607":75128,"_31098":75095,"_21528":127958,"_5":14794,"_28279":127874,"_3062":127959},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3607":75129,"_31098":75095,"_21528":127961,"_5":14794,"_28279":127874,"_3062":127962},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3607":75130,"_31098":75095,"_21528":127964,"_5":14794,"_28279":127878,"_3062":127965},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3607":75131,"_31098":75095,"_21528":127967,"_5":14794,"_28279":127878,"_3062":127968},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3607":75132,"_31098":75132,"_5":15159,"_3062":127970,"_31457":127971,"_21528":127972,"_28279":75132},"Seguridad",[50787],[],{"_3607":75133,"_31098":75132,"_21528":127974,"_5":14794,"_28279":75132,"_3062":127975},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3607":75134,"_31098":75132,"_5":31454,"_21528":127977,"_28279":127978,"_3062":127979},[],"/docs/pr-preview/pr-75/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3607":75135,"_31098":75132,"_5":31454,"_21528":127981,"_28279":127982,"_3062":127983},[],"/docs/pr-preview/pr-75/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3607":75136,"_31098":75132,"_5":31454,"_21528":127985,"_28279":127986,"_3062":127987},[],"/docs/pr-preview/pr-75/es/security#versiones-soportadas","Versiones soportadas",{"_3607":75137,"_31098":75132,"_5":31454,"_21528":127989,"_28279":127990,"_3062":127991},[],"/docs/pr-preview/pr-75/es/security#divulgación-responsable","Divulgación responsable",{"_3607":75138,"_31098":75132,"_21528":127993,"_5":14794,"_28279":75132,"_3062":127994},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3607":75139,"_31098":75132,"_21528":127996,"_5":14794,"_28279":127978,"_3062":127997},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3607":75140,"_31098":75132,"_21528":127999,"_5":14794,"_28279":127978,"_3062":128000},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3607":75141,"_31098":75132,"_21528":128002,"_5":14794,"_28279":127978,"_3062":15433},[],{"_3607":75142,"_31098":75132,"_21528":128004,"_5":14794,"_28279":127978,"_3062":15362},[],{"_3607":75143,"_31098":75132,"_21528":128006,"_5":14794,"_28279":127978,"_3062":15420},[],{"_3607":75144,"_31098":75132,"_21528":128008,"_5":14794,"_28279":127978,"_3062":128009},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3607":75145,"_31098":75132,"_21528":128011,"_5":14794,"_28279":127978,"_3062":128012},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3607":75146,"_31098":75132,"_21528":128014,"_5":14794,"_28279":127982,"_3062":128015},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3607":75147,"_31098":75132,"_21528":128017,"_5":14794,"_28279":127982,"_3062":128018},[],"No incluyas en el reporte:",{"_3607":75148,"_31098":75132,"_21528":128020,"_5":14794,"_28279":127982,"_3062":128021},[],"Credenciales, tokens o claves privadas",{"_3607":75149,"_31098":75132,"_21528":128023,"_5":14794,"_28279":127982,"_3062":128024},[],"Datos de clientes o información identificable de clientes",{"_3607":75150,"_31098":75132,"_21528":128026,"_5":14794,"_28279":127982,"_3062":128027},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3607":75151,"_31098":75132,"_21528":128029,"_5":14794,"_28279":127986,"_3062":128030},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3607":75152,"_31098":75132,"_21528":128032,"_5":14794,"_28279":127986,"_3062":128033},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3607":75153,"_31098":75132,"_21528":128035,"_5":14794,"_28279":127990,"_3062":128036},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3607":75154,"_31098":75132,"_21528":128038,"_5":14794,"_28279":127990,"_3062":128039},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3607":75155,"_31098":75132,"_21528":128041,"_5":14794,"_28279":127990,"_3062":128042},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3607":75156,"_31098":75132,"_21528":128044,"_5":14794,"_28279":127990,"_3062":128045},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3607":75157,"_31098":75132,"_21528":128047,"_5":14794,"_28279":127990,"_3062":128048},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3607":75158,"_31098":75158,"_5":15159,"_3062":128050,"_31457":128051,"_21528":128053,"_28279":75158},"3.8.0 a 4.0.0",[50787,128052],"Actualizaciones",[],{"_3607":75159,"_31098":75158,"_21528":128055,"_5":14794,"_28279":75158,"_3062":128056},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3607":75160,"_31098":75158,"_5":31454,"_21528":128058,"_28279":128059,"_3062":128060},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3607":75161,"_31098":75158,"_5":31454,"_21528":128062,"_28279":128063,"_3062":128064},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3607":75162,"_31098":75158,"_5":31454,"_21528":128066,"_28279":128067,"_3062":128068},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3607":75163,"_31098":75158,"_5":31454,"_21528":128070,"_28279":128071,"_3062":128072},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3607":75164,"_31098":75158,"_5":31454,"_21528":128074,"_28279":128075,"_3062":128076},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3607":75165,"_31098":75158,"_5":31454,"_21528":128078,"_28279":128079,"_3062":128080},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3607":75166,"_31098":75158,"_5":31454,"_21528":128082,"_28279":128083,"_3062":59231},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3607":75167,"_31098":75158,"_5":31454,"_21528":128085,"_28279":128086,"_3062":128087},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3607":75168,"_31098":75158,"_5":31454,"_21528":128089,"_28279":128090,"_3062":128091},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3607":75169,"_31098":75158,"_5":31454,"_21528":128093,"_28279":128094,"_3062":128095},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3607":75170,"_31098":75158,"_5":31454,"_21528":128097,"_28279":128098,"_3062":120470},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3607":75171,"_31098":75158,"_5":31454,"_21528":128100,"_28279":128101,"_3062":128102},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3607":75172,"_31098":75158,"_5":31454,"_21528":128104,"_28279":128105,"_3062":128106},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3607":75173,"_31098":75158,"_5":31454,"_21528":128108,"_28279":128109,"_3062":128110},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3607":75174,"_31098":75158,"_5":31454,"_21528":128112,"_28279":128113,"_3062":128114},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3607":75175,"_31098":75158,"_5":31454,"_21528":128116,"_28279":128117,"_3062":128118},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3607":75176,"_31098":75158,"_5":31454,"_21528":128120,"_28279":128121,"_3062":128122},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3607":75177,"_31098":75158,"_5":31454,"_21528":128124,"_28279":128125,"_3062":128126},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3607":75178,"_31098":75158,"_5":31454,"_21528":128128,"_28279":128129,"_3062":128130},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3607":75179,"_31098":75158,"_5":31454,"_21528":128132,"_28279":128133,"_3062":128134},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3607":75180,"_31098":75158,"_5":31454,"_21528":128136,"_28279":128137,"_3062":128138},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3607":75181,"_31098":75158,"_5":31454,"_21528":128140,"_28279":128141,"_3062":128142},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3607":75182,"_31098":75158,"_5":31454,"_21528":128144,"_28279":128145,"_3062":128146},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3607":75183,"_31098":75158,"_5":31454,"_21528":128148,"_28279":128149,"_3062":128150},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3607":75184,"_31098":75158,"_5":31454,"_21528":128152,"_28279":128153,"_3062":128154},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3607":75185,"_31098":75158,"_5":31454,"_21528":128156,"_28279":128157,"_3062":128158},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3607":75186,"_31098":75158,"_5":31454,"_21528":128160,"_28279":128161,"_3062":128162},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3607":75187,"_31098":75158,"_5":31454,"_21528":128164,"_28279":128165,"_3062":128166},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3607":75188,"_31098":75158,"_5":31454,"_21528":128168,"_28279":128169,"_3062":128170},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3607":75189,"_31098":75158,"_5":31454,"_21528":128172,"_28279":128173,"_3062":128174},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3607":75190,"_31098":75158,"_5":31454,"_21528":128176,"_28279":128177,"_3062":128178},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3607":75191,"_31098":75158,"_5":31454,"_21528":128180,"_28279":128181,"_3062":128182},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3607":75192,"_31098":75158,"_5":31454,"_21528":128184,"_28279":128185,"_3062":128186},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3607":75193,"_31098":75158,"_5":31454,"_21528":128188,"_28279":128189,"_3062":128190},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3607":75194,"_31098":75158,"_5":31454,"_21528":128192,"_28279":128193,"_3062":128194},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3607":75195,"_31098":75158,"_5":31454,"_21528":128196,"_28279":128197,"_3062":128198},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3607":75196,"_31098":75158,"_5":31454,"_21528":128200,"_28279":128201,"_3062":128202},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3607":75197,"_31098":75158,"_5":31454,"_21528":128204,"_28279":128205,"_3062":128206},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3607":75198,"_31098":75158,"_5":31454,"_21528":128208,"_28279":128209,"_3062":128210},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3607":75199,"_31098":75158,"_5":31454,"_21528":128212,"_28279":128213,"_3062":128214},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3607":75200,"_31098":75158,"_5":31454,"_21528":128216,"_28279":128217,"_3062":128218},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3607":75201,"_31098":75158,"_5":31454,"_21528":128220,"_28279":128221,"_3062":128222},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3607":75202,"_31098":75158,"_5":31454,"_21528":128224,"_28279":128225,"_3062":123998},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3607":75203,"_31098":75158,"_5":31454,"_21528":128227,"_28279":128228,"_3062":128229},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3607":75204,"_31098":75158,"_5":31454,"_21528":128231,"_28279":128232,"_3062":128233},[],"/docs/pr-preview/pr-75/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3607":75205,"_31098":75158,"_21528":128235,"_5":14794,"_28279":75158,"_3062":128236},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3607":75206,"_31098":75158,"_21528":128238,"_5":14794,"_28279":75158,"_3062":128239},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3607":75207,"_31098":75158,"_21528":128241,"_5":14794,"_28279":75158,"_3062":128242},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3607":75208,"_31098":75158,"_21528":128244,"_5":14794,"_28279":75158,"_3062":128245},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3607":75209,"_31098":75158,"_21528":128247,"_5":14794,"_28279":75158,"_3062":128248},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3607":75210,"_31098":75158,"_21528":128250,"_5":14794,"_28279":75158,"_3062":128251},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3607":75211,"_31098":75158,"_21528":128253,"_5":14794,"_28279":75158,"_3062":128254},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3607":75212,"_31098":75158,"_21528":128256,"_5":14794,"_28279":128063,"_3062":128257},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3607":75213,"_31098":75158,"_21528":128259,"_5":14794,"_28279":128063,"_3062":128260},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3607":75214,"_31098":75158,"_21528":128262,"_5":14794,"_28279":128067,"_3062":128263},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3607":75215,"_31098":75158,"_21528":128265,"_5":14794,"_28279":128067,"_3062":128266},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3607":75216,"_31098":75158,"_21528":128268,"_5":14794,"_28279":128071,"_3062":128269},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3607":75217,"_31098":75158,"_21528":128271,"_5":14794,"_28279":128075,"_3062":128272},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3607":75218,"_31098":75158,"_21528":128274,"_5":14794,"_28279":128075,"_3062":128275},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3607":75219,"_31098":75158,"_21528":128277,"_5":14794,"_28279":128075,"_3062":128278},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3607":75220,"_31098":75158,"_21528":128280,"_5":14794,"_28279":128075,"_3062":128281},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3607":75221,"_31098":75158,"_21528":128283,"_5":14794,"_28279":128075,"_3062":128284},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3607":75222,"_31098":75158,"_21528":128286,"_5":14794,"_28279":128079,"_3062":128287},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3607":75223,"_31098":75158,"_21528":128289,"_5":14794,"_28279":128079,"_3062":128290},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3607":75224,"_31098":75158,"_21528":128292,"_5":14794,"_28279":128079,"_3062":128293},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3607":75225,"_31098":75158,"_21528":128295,"_5":14794,"_28279":128079,"_3062":128296},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3607":75226,"_31098":75158,"_21528":128298,"_5":14794,"_28279":128079,"_3062":128299},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3607":75227,"_31098":75158,"_21528":128301,"_5":14794,"_28279":128079,"_3062":128302},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3607":75228,"_31098":75158,"_21528":128304,"_5":14794,"_28279":128083,"_3062":128305},[],"Cambio",{"_3607":75229,"_31098":75158,"_21528":128307,"_5":14794,"_28279":128083,"_3062":128308},[],"A quién afecta",{"_3607":75230,"_31098":75158,"_21528":128310,"_5":14794,"_28279":128083,"_3062":128311},[],"Gravedad",{"_3607":75231,"_31098":75158,"_21528":128313,"_5":14794,"_28279":128083,"_3062":126792},[],{"_3607":75232,"_31098":75158,"_21528":128315,"_5":14794,"_28279":128083,"_3062":128091},[],{"_3607":75233,"_31098":75158,"_21528":128317,"_5":14794,"_28279":128083,"_3062":128318},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3607":75234,"_31098":75158,"_21528":128320,"_5":14794,"_28279":128083,"_3062":128321},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3607":75235,"_31098":75158,"_21528":128323,"_5":14794,"_28279":128083,"_3062":128324},[],"Copiar los datos a los volúmenes nuevos",{"_3607":75236,"_31098":75158,"_21528":128326,"_5":14794,"_28279":128083,"_3062":128095},[],{"_3607":75237,"_31098":75158,"_21528":128328,"_5":14794,"_28279":128083,"_3062":128329},[],"Todas las releases de Helm",{"_3607":75238,"_31098":75158,"_21528":128331,"_5":14794,"_28279":128083,"_3062":128332},[],"Alta: `helm upgrade` falla",{"_3607":75239,"_31098":75158,"_21528":128334,"_5":14794,"_28279":128083,"_3062":128335},[],"Eliminar o renombrar las claves heredadas",{"_3607":75240,"_31098":75158,"_21528":128337,"_5":14794,"_28279":128083,"_3062":120470},[],{"_3607":75241,"_31098":75158,"_21528":128339,"_5":14794,"_28279":128083,"_3062":128329},[],{"_3607":75242,"_31098":75158,"_21528":128341,"_5":14794,"_28279":128083,"_3062":128342},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3607":75243,"_31098":75158,"_21528":128344,"_5":14794,"_28279":128083,"_3062":128345},[],"Crear primero los Secrets; consulta el paso 2",{"_3607":75244,"_31098":75158,"_21528":128347,"_5":14794,"_28279":128083,"_3062":128102},[],{"_3607":75245,"_31098":75158,"_21528":128349,"_5":14794,"_28279":128083,"_3062":128350},[],"Todos los despliegues",{"_3607":75246,"_31098":75158,"_21528":128352,"_5":14794,"_28279":128083,"_3062":128353},[],"Alta: sin principal de bootstrap no hay administrador",{"_3607":75247,"_31098":75158,"_21528":128355,"_5":14794,"_28279":128083,"_3062":128356},[],"Configurar `services.authz`",{"_3607":75248,"_31098":75158,"_21528":128358,"_5":14794,"_28279":128083,"_3062":128106},[],{"_3607":75249,"_31098":75158,"_21528":128360,"_5":14794,"_28279":128083,"_3062":128329},[],{"_3607":75250,"_31098":75158,"_21528":128362,"_5":14794,"_28279":128083,"_3062":128363},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3607":75251,"_31098":75158,"_21528":128365,"_5":14794,"_28279":128083,"_3062":128366},[],"Mover JWKS y roles a `services.authz`",{"_3607":75252,"_31098":75158,"_21528":128368,"_5":14794,"_28279":128083,"_3062":128126},[],{"_3607":75253,"_31098":75158,"_21528":128370,"_5":14794,"_28279":128083,"_3062":128371},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3607":75254,"_31098":75158,"_21528":128373,"_5":14794,"_28279":128083,"_3062":128374},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3607":75255,"_31098":75158,"_21528":128376,"_5":14794,"_28279":128083,"_3062":128377},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3607":75256,"_31098":75158,"_21528":128379,"_5":14794,"_28279":128083,"_3062":128130},[],{"_3607":75257,"_31098":75158,"_21528":128381,"_5":14794,"_28279":128083,"_3062":128382},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3607":75258,"_31098":75158,"_21528":128384,"_5":14794,"_28279":128083,"_3062":128385},[],"Alta: el backend ya no arranca con ellos",{"_3607":75259,"_31098":75158,"_21528":128387,"_5":14794,"_28279":128083,"_3062":128388},[],"Pasar a PostgreSQL antes de actualizar",{"_3607":75260,"_31098":75158,"_21528":128390,"_5":14794,"_28279":128083,"_3062":128174},[],{"_3607":75261,"_31098":75158,"_21528":128392,"_5":14794,"_28279":128083,"_3062":128393},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3607":75262,"_31098":75158,"_21528":128395,"_5":14794,"_28279":128083,"_3062":128396},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3607":75263,"_31098":75158,"_21528":128398,"_5":14794,"_28279":128083,"_3062":128399},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3607":75264,"_31098":75158,"_21528":128401,"_5":14794,"_28279":128083,"_3062":128402},[],"Webhooks con referencias a archivos",{"_3607":75265,"_31098":75158,"_21528":128404,"_5":14794,"_28279":128083,"_3062":128405},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3607":75266,"_31098":75158,"_21528":128407,"_5":14794,"_28279":128083,"_3062":128408},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3607":75267,"_31098":75158,"_21528":128410,"_5":14794,"_28279":128083,"_3062":128411},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3607":75268,"_31098":75158,"_21528":128413,"_5":14794,"_28279":128083,"_3062":128110},[],{"_3607":75269,"_31098":75158,"_21528":128415,"_5":14794,"_28279":128083,"_3062":128416},[],"Releases con identidades por servicio o material de claves montado",{"_3607":75270,"_31098":75158,"_21528":128418,"_5":14794,"_28279":128083,"_3062":128419},[],"Media: los servicios no pueden leer sus archivos",{"_3607":75271,"_31098":75158,"_21528":128421,"_5":14794,"_28279":128083,"_3062":128422},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3607":75272,"_31098":75158,"_21528":128424,"_5":14794,"_28279":128083,"_3062":128114},[],{"_3607":75273,"_31098":75158,"_21528":128426,"_5":14794,"_28279":128083,"_3062":128427},[],"Releases que definen `amqp.tls`",{"_3607":75274,"_31098":75158,"_21528":128429,"_5":14794,"_28279":128083,"_3062":128430},[],"Media: los clientes se conectan al puerto equivocado",{"_3607":75275,"_31098":75158,"_21528":128432,"_5":14794,"_28279":128083,"_3062":128433},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3607":75276,"_31098":75158,"_21528":128435,"_5":14794,"_28279":128083,"_3062":128134},[],{"_3607":75277,"_31098":75158,"_21528":128437,"_5":14794,"_28279":128083,"_3062":128438},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3607":75278,"_31098":75158,"_21528":128440,"_5":14794,"_28279":128083,"_3062":128441},[],"Media: las claves de CA quedan sin gestionar",{"_3607":75279,"_31098":75158,"_21528":128443,"_5":14794,"_28279":128083,"_3062":128444},[],"Ejecutar la migración de CA a KMS",{"_3607":75280,"_31098":75158,"_21528":128446,"_5":14794,"_28279":128083,"_3062":128447},[],"Verificación del certificado del receptor",{"_3607":75281,"_31098":75158,"_21528":128449,"_5":14794,"_28279":128083,"_3062":128450},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3607":75282,"_31098":75158,"_21528":128452,"_5":14794,"_28279":128083,"_3062":128453},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3607":75283,"_31098":75158,"_21528":128455,"_5":14794,"_28279":128083,"_3062":128456},[],"Poner `insecure_skip_verify` a `false`",{"_3607":75284,"_31098":75158,"_21528":128458,"_5":14794,"_28279":128083,"_3062":128150},[],{"_3607":75285,"_31098":75158,"_21528":128460,"_5":14794,"_28279":128083,"_3062":128461},[],"Scripts y consolas que editan DMS por API",{"_3607":75286,"_31098":75158,"_21528":128463,"_5":14794,"_28279":128083,"_3062":128464},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3607":75287,"_31098":75158,"_21528":128466,"_5":14794,"_28279":128083,"_3062":128467},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3607":75288,"_31098":75158,"_21528":128469,"_5":14794,"_28279":128083,"_3062":128170},[],{"_3607":75289,"_31098":75158,"_21528":128471,"_5":14794,"_28279":128083,"_3062":128472},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3607":75290,"_31098":75158,"_21528":128474,"_5":14794,"_28279":128083,"_3062":128475},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3607":75291,"_31098":75158,"_21528":128477,"_5":14794,"_28279":128083,"_3062":128478},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3607":75292,"_31098":75158,"_21528":128480,"_5":14794,"_28279":128083,"_3062":128178},[],{"_3607":75293,"_31098":75158,"_21528":128482,"_5":14794,"_28279":128083,"_3062":128483},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3607":75294,"_31098":75158,"_21528":128485,"_5":14794,"_28279":128083,"_3062":128486},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3607":75295,"_31098":75158,"_21528":128488,"_5":14794,"_28279":128083,"_3062":128489},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3607":75296,"_31098":75158,"_21528":128491,"_5":14794,"_28279":128083,"_3062":128166},[],{"_3607":75297,"_31098":75158,"_21528":128493,"_5":14794,"_28279":128083,"_3062":128494},[],"Consumidores que leen el campo `events` del dispositivo",{"_3607":75298,"_31098":75158,"_21528":128496,"_5":14794,"_28279":128083,"_3062":128497},[],"Media: el campo desaparece",{"_3607":75299,"_31098":75158,"_21528":128499,"_5":14794,"_28279":128083,"_3062":128500},[],"Usar los nuevos endpoints de eventos",{"_3607":75300,"_31098":75158,"_21528":128502,"_5":14794,"_28279":128083,"_3062":128190},[],{"_3607":75301,"_31098":75158,"_21528":128504,"_5":14794,"_28279":128083,"_3062":128505},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3607":75302,"_31098":75158,"_21528":128507,"_5":14794,"_28279":128083,"_3062":128508},[],"Media: la migración de la VA aborta",{"_3607":75303,"_31098":75158,"_21528":128510,"_5":14794,"_28279":128083,"_3062":128511},[],"Corregir los roles afectados antes de actualizar",{"_3607":75304,"_31098":75158,"_21528":128513,"_5":14794,"_28279":128083,"_3062":128118},[],{"_3607":75305,"_31098":75158,"_21528":128515,"_5":14794,"_28279":128083,"_3062":128516},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3607":75306,"_31098":75158,"_21528":128518,"_5":14794,"_28279":128083,"_3062":128519},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3607":75307,"_31098":75158,"_21528":128521,"_5":14794,"_28279":128083,"_3062":128522},[],"Actualizar el archivo de values",{"_3607":75308,"_31098":75158,"_21528":128524,"_5":14794,"_28279":128083,"_3062":128158},[],{"_3607":75309,"_31098":75158,"_21528":128526,"_5":14794,"_28279":128083,"_3062":128527},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3607":75310,"_31098":75158,"_21528":128529,"_5":14794,"_28279":128083,"_3062":128530},[],"Baja: prevalece el ID de la URL",{"_3607":75311,"_31098":75158,"_21528":128532,"_5":14794,"_28279":128083,"_3062":128533},[],"Enviar el ID en la URL",{"_3607":75312,"_31098":75158,"_21528":128535,"_5":14794,"_28279":128083,"_3062":128182},[],{"_3607":75313,"_31098":75158,"_21528":128537,"_5":14794,"_28279":128083,"_3062":128538},[],"Clientes que envían un `id` al crear o importar CAs",{"_3607":75314,"_31098":75158,"_21528":128540,"_5":14794,"_28279":128083,"_3062":128541},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3607":75315,"_31098":75158,"_21528":128543,"_5":14794,"_28279":128083,"_3062":128544},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3607":75316,"_31098":75158,"_21528":128546,"_5":14794,"_28279":128083,"_3062":128186},[],{"_3607":75317,"_31098":75158,"_21528":128548,"_5":14794,"_28279":128083,"_3062":128549},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3607":75318,"_31098":75158,"_21528":128551,"_5":14794,"_28279":128083,"_3062":128552},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3607":75319,"_31098":75158,"_21528":128554,"_5":14794,"_28279":128083,"_3062":128555},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3607":75320,"_31098":75158,"_21528":128557,"_5":14794,"_28279":128083,"_3062":128162},[],{"_3607":75321,"_31098":75158,"_21528":128559,"_5":14794,"_28279":128083,"_3062":128560},[],"Consumidores que comparan el `type` del certificado",{"_3607":75322,"_31098":75158,"_21528":128562,"_5":14794,"_28279":128083,"_3062":128563},[],"Baja: dos valores cambian de nombre",{"_3607":75323,"_31098":75158,"_21528":128565,"_5":14794,"_28279":128083,"_3062":128566},[],"Adaptar los consumidores",{"_3607":75324,"_31098":75158,"_21528":128568,"_5":14794,"_28279":128083,"_3062":128154},[],{"_3607":75325,"_31098":75158,"_21528":128570,"_5":14794,"_28279":128083,"_3062":128571},[],"Cualquier DMS",{"_3607":75326,"_31098":75158,"_21528":128573,"_5":14794,"_28279":128083,"_3062":128574},[],"Baja: solo informativo",{"_3607":75327,"_31098":75158,"_21528":128576,"_5":14794,"_28279":128083,"_3062":128577},[],"Revisar ambos bloques antes de editar",{"_3607":75328,"_31098":75158,"_21528":128579,"_5":14794,"_28279":128090,"_3062":128580},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3607":75329,"_31098":75158,"_21528":128582,"_5":14794,"_28279":128090,"_3062":128583},[],"El paso 4 de la guía de migración copia los datos.",{"_3607":75330,"_31098":75158,"_21528":128585,"_5":14794,"_28279":128094,"_3062":128586},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3607":75331,"_31098":75158,"_21528":128588,"_5":14794,"_28279":128098,"_3062":128589},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3607":75332,"_31098":75158,"_21528":128591,"_5":14794,"_28279":128098,"_3062":128592},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3607":75333,"_31098":75158,"_21528":128594,"_5":14794,"_28279":128101,"_3062":128595},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3607":75334,"_31098":75158,"_21528":128597,"_5":14794,"_28279":128105,"_3062":128598},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3607":75335,"_31098":75158,"_21528":128600,"_5":14794,"_28279":128109,"_3062":128601},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3607":75336,"_31098":75158,"_21528":128603,"_5":14794,"_28279":128109,"_3062":128604},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3607":75337,"_31098":75158,"_21528":128606,"_5":14794,"_28279":128109,"_3062":128607},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3607":75338,"_31098":75158,"_21528":128609,"_5":14794,"_28279":128113,"_3062":128610},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3607":75339,"_31098":75158,"_21528":128612,"_5":14794,"_28279":128117,"_3062":128613},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3607":75340,"_31098":75158,"_21528":128615,"_5":14794,"_28279":128117,"_3062":128616},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3607":75341,"_31098":75158,"_21528":128618,"_5":14794,"_28279":128117,"_3062":128619},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3607":75342,"_31098":75158,"_21528":128621,"_5":14794,"_28279":128117,"_3062":128622},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3607":75343,"_31098":75158,"_21528":128624,"_5":14794,"_28279":128117,"_3062":128625},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3607":75344,"_31098":75158,"_21528":128627,"_5":14794,"_28279":128117,"_3062":128628},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3607":75345,"_31098":75158,"_21528":128630,"_5":14794,"_28279":128125,"_3062":128631},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3607":75346,"_31098":75158,"_21528":128633,"_5":14794,"_28279":128125,"_3062":128634},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3607":75347,"_31098":75158,"_21528":128636,"_5":14794,"_28279":128125,"_3062":128637},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3607":75348,"_31098":75158,"_21528":128639,"_5":14794,"_28279":128125,"_3062":128640},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3607":75349,"_31098":75158,"_21528":128642,"_5":14794,"_28279":128125,"_3062":128643},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3607":75350,"_31098":75158,"_21528":128645,"_5":14794,"_28279":128129,"_3062":128646},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3607":75351,"_31098":75158,"_21528":128648,"_5":14794,"_28279":128133,"_3062":128649},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3607":75352,"_31098":75158,"_21528":128651,"_5":14794,"_28279":128133,"_3062":128652},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3607":75353,"_31098":75158,"_21528":128654,"_5":14794,"_28279":128133,"_3062":128655},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3607":75354,"_31098":75158,"_21528":128657,"_5":14794,"_28279":128133,"_3062":128658},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3607":75355,"_31098":75158,"_21528":128660,"_5":14794,"_28279":128133,"_3062":128661},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3607":75356,"_31098":75158,"_21528":128663,"_5":14794,"_28279":128133,"_3062":128664},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3607":75357,"_31098":75158,"_21528":128666,"_5":14794,"_28279":128133,"_3062":128667},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3607":75358,"_31098":75158,"_21528":128669,"_5":14794,"_28279":128133,"_3062":128670},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3607":75359,"_31098":75158,"_21528":128672,"_5":14794,"_28279":128137,"_3062":128673},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3607":75360,"_31098":75158,"_21528":128675,"_5":14794,"_28279":128145,"_3062":128676},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3607":75361,"_31098":75158,"_21528":128678,"_5":14794,"_28279":128145,"_3062":128679},[],"Campo en 3.8.0",{"_3607":75362,"_31098":75158,"_21528":128681,"_5":14794,"_28279":128145,"_3062":128682},[],"Campo en 4.0.0",{"_3607":75363,"_31098":75158,"_21528":128684,"_5":14794,"_28279":128145,"_3062":59833},[],{"_3607":75364,"_31098":75158,"_21528":128686,"_5":14794,"_28279":128145,"_3062":128687},[],"`insecure_skip_verify` (con el valor negado)",{"_3607":75365,"_31098":75158,"_21528":128689,"_5":14794,"_28279":128145,"_3062":59839},[],{"_3607":75366,"_31098":75158,"_21528":128691,"_5":14794,"_28279":128145,"_3062":59842},[],{"_3607":75367,"_31098":75158,"_21528":128693,"_5":14794,"_28279":128145,"_3062":59845},[],{"_3607":75368,"_31098":75158,"_21528":128695,"_5":14794,"_28279":128145,"_3062":59848},[],{"_3607":75369,"_31098":75158,"_21528":128697,"_5":14794,"_28279":128145,"_3062":59851},[],{"_3607":75370,"_31098":75158,"_21528":128699,"_5":14794,"_28279":128145,"_3062":59854},[],{"_3607":75371,"_31098":75158,"_21528":128701,"_5":14794,"_28279":128145,"_3062":128702},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3607":75372,"_31098":75158,"_21528":128704,"_5":14794,"_28279":128145,"_3062":128705},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3607":75373,"_31098":75158,"_21528":128707,"_5":14794,"_28279":128145,"_3062":128708},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3607":75374,"_31098":75158,"_21528":128710,"_5":14794,"_28279":128149,"_3062":128711},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3607":75375,"_31098":75158,"_21528":128713,"_5":14794,"_28279":128149,"_3062":128714},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3607":75376,"_31098":75158,"_21528":128716,"_5":14794,"_28279":128149,"_3062":128717},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3607":75377,"_31098":75158,"_21528":128719,"_5":14794,"_28279":128153,"_3062":128720},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3607":75378,"_31098":75158,"_21528":128722,"_5":14794,"_28279":128157,"_3062":128723},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3607":75379,"_31098":75158,"_21528":128725,"_5":14794,"_28279":128161,"_3062":128726},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3607":75380,"_31098":75158,"_21528":128728,"_5":14794,"_28279":128165,"_3062":128729},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3607":75381,"_31098":75158,"_21528":128731,"_5":14794,"_28279":128165,"_3062":128732},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3607":75382,"_31098":75158,"_21528":128734,"_5":14794,"_28279":128165,"_3062":128735},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3607":75383,"_31098":75158,"_21528":128737,"_5":14794,"_28279":128165,"_3062":128738},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3607":75384,"_31098":75158,"_21528":128740,"_5":14794,"_28279":128169,"_3062":128741},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3607":75385,"_31098":75158,"_21528":128743,"_5":14794,"_28279":128173,"_3062":128744},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3607":75386,"_31098":75158,"_21528":128746,"_5":14794,"_28279":128173,"_3062":128747},[],"Ruta",{"_3607":75387,"_31098":75158,"_21528":128749,"_5":14794,"_28279":128173,"_3062":121101},[],{"_3607":75388,"_31098":75158,"_21528":128751,"_5":14794,"_28279":128173,"_3062":59907},[],{"_3607":75389,"_31098":75158,"_21528":128753,"_5":14794,"_28279":128173,"_3062":128754},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3607":75390,"_31098":75158,"_21528":128756,"_5":14794,"_28279":128173,"_3062":59913},[],{"_3607":75391,"_31098":75158,"_21528":128758,"_5":14794,"_28279":128173,"_3062":128759},[],"Lee los ajustes de una CA.",{"_3607":75392,"_31098":75158,"_21528":128761,"_5":14794,"_28279":128173,"_3062":59919},[],{"_3607":75393,"_31098":75158,"_21528":128763,"_5":14794,"_28279":128173,"_3062":128764},[],"Sustituye los `crl_options`.",{"_3607":75394,"_31098":75158,"_21528":128766,"_5":14794,"_28279":128173,"_3062":59925},[],{"_3607":75395,"_31098":75158,"_21528":128768,"_5":14794,"_28279":128173,"_3062":128769},[],"Elimina los ajustes archivados de una CA.",{"_3607":75396,"_31098":75158,"_21528":128771,"_5":14794,"_28279":128173,"_3062":128772},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3607":75397,"_31098":75158,"_21528":128774,"_5":14794,"_28279":128173,"_3062":128775},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3607":75398,"_31098":75158,"_21528":128777,"_5":14794,"_28279":128173,"_3062":128778},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3607":75399,"_31098":75158,"_21528":128780,"_5":14794,"_28279":128173,"_3062":128781},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3607":75400,"_31098":75158,"_21528":128783,"_5":14794,"_28279":128173,"_3062":128784},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3607":75401,"_31098":75158,"_21528":128786,"_5":14794,"_28279":128173,"_3062":128787},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3607":75402,"_31098":75158,"_21528":128789,"_5":14794,"_28279":128173,"_3062":128790},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3607":75403,"_31098":75158,"_21528":128792,"_5":14794,"_28279":128173,"_3062":128793},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3607":75404,"_31098":75158,"_21528":128795,"_5":14794,"_28279":128173,"_3062":128796},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3607":75405,"_31098":75158,"_21528":128798,"_5":14794,"_28279":128173,"_3062":128799},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3607":75406,"_31098":75158,"_21528":128801,"_5":14794,"_28279":128173,"_3062":128802},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3607":75407,"_31098":75158,"_21528":128804,"_5":14794,"_28279":128177,"_3062":128805},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3607":75408,"_31098":75158,"_21528":128807,"_5":14794,"_28279":128181,"_3062":128808},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3607":75409,"_31098":75158,"_21528":128810,"_5":14794,"_28279":128185,"_3062":128811},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3607":75410,"_31098":75158,"_21528":128813,"_5":14794,"_28279":128185,"_3062":128814},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3607":75411,"_31098":75158,"_21528":128816,"_5":14794,"_28279":128189,"_3062":128817},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3607":75412,"_31098":75158,"_21528":128819,"_5":14794,"_28279":128193,"_3062":128820},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3607":75413,"_31098":75158,"_21528":128822,"_5":14794,"_28279":128197,"_3062":128823},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3607":75414,"_31098":75158,"_21528":128825,"_5":14794,"_28279":128197,"_3062":128826},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3607":75415,"_31098":75158,"_21528":128828,"_5":14794,"_28279":128197,"_3062":128829},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3607":75416,"_31098":75158,"_21528":128831,"_5":14794,"_28279":128197,"_3062":128832},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3607":75417,"_31098":75158,"_21528":128834,"_5":14794,"_28279":128197,"_3062":128835},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3607":75418,"_31098":75158,"_21528":128837,"_5":14794,"_28279":128197,"_3062":128838},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3607":75419,"_31098":75158,"_21528":128840,"_5":14794,"_28279":128201,"_3062":128841},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3607":75420,"_31098":75158,"_21528":128843,"_5":14794,"_28279":128201,"_3062":128844},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3607":75421,"_31098":75158,"_21528":128846,"_5":14794,"_28279":128201,"_3062":128847},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3607":75422,"_31098":75158,"_21528":128849,"_5":14794,"_28279":128201,"_3062":128850},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3607":75423,"_31098":75158,"_21528":128852,"_5":14794,"_28279":128201,"_3062":128853},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3607":75424,"_31098":75158,"_21528":128855,"_5":14794,"_28279":128205,"_3062":128856},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3607":75425,"_31098":75158,"_21528":128858,"_5":14794,"_28279":128205,"_3062":128859},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3607":75426,"_31098":75158,"_21528":128861,"_5":14794,"_28279":128205,"_3062":128862},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3607":75427,"_31098":75158,"_21528":128864,"_5":14794,"_28279":128205,"_3062":60024},[],{"_3607":75428,"_31098":75158,"_21528":128866,"_5":14794,"_28279":128205,"_3062":128867},[],"Claves de datos obligatorias",{"_3607":75429,"_31098":75158,"_21528":128869,"_5":14794,"_28279":128205,"_3062":128870},[],"Cuándo",{"_3607":75430,"_31098":75158,"_21528":128872,"_5":14794,"_28279":128205,"_3062":128873},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3607":75431,"_31098":75158,"_21528":128875,"_5":14794,"_28279":128205,"_3062":60036},[],{"_3607":75432,"_31098":75158,"_21528":128877,"_5":14794,"_28279":128205,"_3062":128878},[],"Siempre",{"_3607":75433,"_31098":75158,"_21528":128880,"_5":14794,"_28279":128205,"_3062":128881},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3607":75434,"_31098":75158,"_21528":128883,"_5":14794,"_28279":128205,"_3062":60036},[],{"_3607":75435,"_31098":75158,"_21528":128885,"_5":14794,"_28279":128205,"_3062":128878},[],{"_3607":75436,"_31098":75158,"_21528":128887,"_5":14794,"_28279":128205,"_3062":60049},[],{"_3607":75437,"_31098":75158,"_21528":128889,"_5":14794,"_28279":128205,"_3062":60036},[],{"_3607":75438,"_31098":75158,"_21528":128891,"_5":14794,"_28279":128205,"_3062":128892},[],"Solo cuando hay autenticación SMTP",{"_3607":75439,"_31098":75158,"_21528":128894,"_5":14794,"_28279":128205,"_3062":128895},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3607":75440,"_31098":75158,"_21528":128897,"_5":14794,"_28279":128205,"_3062":128898},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3607":75441,"_31098":75158,"_21528":128900,"_5":14794,"_28279":128205,"_3062":128901},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3607":75442,"_31098":75158,"_21528":128903,"_5":14794,"_28279":128205,"_3062":128904},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3607":75443,"_31098":75158,"_21528":128906,"_5":14794,"_28279":128205,"_3062":128907},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3607":75444,"_31098":75158,"_21528":128909,"_5":14794,"_28279":128205,"_3062":128910},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3607":75445,"_31098":75158,"_21528":128912,"_5":14794,"_28279":128205,"_3062":128913},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3607":75446,"_31098":75158,"_21528":128915,"_5":14794,"_28279":128205,"_3062":128916},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3607":75447,"_31098":75158,"_21528":128918,"_5":14794,"_28279":128205,"_3062":128919},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3607":75448,"_31098":75158,"_21528":128921,"_5":14794,"_28279":128205,"_3062":128922},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3607":75449,"_31098":75158,"_21528":128924,"_5":14794,"_28279":128205,"_3062":128925},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3607":75450,"_31098":75158,"_21528":128927,"_5":14794,"_28279":128205,"_3062":128928},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3607":75451,"_31098":75158,"_21528":128930,"_5":14794,"_28279":128205,"_3062":128931},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3607":75452,"_31098":75158,"_21528":128933,"_5":14794,"_28279":128205,"_3062":128934},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3607":75453,"_31098":75158,"_21528":128936,"_5":14794,"_28279":128205,"_3062":128937},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3607":75454,"_31098":75158,"_21528":128939,"_5":14794,"_28279":128209,"_3062":128940},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3607":75455,"_31098":75158,"_21528":128942,"_5":14794,"_28279":128209,"_3062":128943},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3607":75456,"_31098":75158,"_21528":128945,"_5":14794,"_28279":128213,"_3062":128946},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3607":75457,"_31098":75158,"_21528":128948,"_5":14794,"_28279":128213,"_3062":128949},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3607":75458,"_31098":75158,"_21528":128951,"_5":14794,"_28279":128213,"_3062":128952},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3607":75459,"_31098":75158,"_21528":128954,"_5":14794,"_28279":128213,"_3062":128955},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3607":75460,"_31098":75158,"_21528":128957,"_5":14794,"_28279":128213,"_3062":128958},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3607":75461,"_31098":75158,"_21528":128960,"_5":14794,"_28279":128213,"_3062":128961},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3607":75462,"_31098":75158,"_21528":128963,"_5":14794,"_28279":128213,"_3062":128964},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3607":75463,"_31098":75158,"_21528":128966,"_5":14794,"_28279":128213,"_3062":128967},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3607":75464,"_31098":75158,"_21528":128969,"_5":14794,"_28279":128213,"_3062":128970},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3607":75465,"_31098":75158,"_21528":128972,"_5":14794,"_28279":128213,"_3062":128973},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3607":75466,"_31098":75158,"_21528":128975,"_5":14794,"_28279":128213,"_3062":128976},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3607":75467,"_31098":75158,"_21528":128978,"_5":14794,"_28279":128217,"_3062":128979},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3607":75468,"_31098":75158,"_21528":128981,"_5":14794,"_28279":128217,"_3062":128982},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3607":75469,"_31098":75158,"_21528":128984,"_5":14794,"_28279":128221,"_3062":128985},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3607":75470,"_31098":75158,"_21528":128987,"_5":14794,"_28279":128221,"_3062":128988},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3607":75471,"_31098":75158,"_21528":128990,"_5":14794,"_28279":128221,"_3062":128991},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3607":75472,"_31098":75158,"_21528":128993,"_5":14794,"_28279":128221,"_3062":128994},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3607":75473,"_31098":75158,"_21528":128996,"_5":14794,"_28279":128221,"_3062":128997},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3607":75474,"_31098":75158,"_21528":128999,"_5":14794,"_28279":128221,"_3062":129000},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3607":75475,"_31098":75158,"_21528":129002,"_5":14794,"_28279":128221,"_3062":129003},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3607":75476,"_31098":75158,"_21528":129005,"_5":14794,"_28279":128221,"_3062":129006},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3607":75477,"_31098":75158,"_21528":129008,"_5":14794,"_28279":128225,"_3062":129009},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3607":75478,"_31098":75158,"_21528":129011,"_5":14794,"_28279":128225,"_3062":129012},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3607":75479,"_31098":75158,"_21528":129014,"_5":14794,"_28279":128225,"_3062":129015},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3607":75480,"_31098":75158,"_21528":129017,"_5":14794,"_28279":128225,"_3062":129018},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3607":75481,"_31098":75158,"_21528":129020,"_5":14794,"_28279":128225,"_3062":129021},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3607":75482,"_31098":75158,"_21528":129023,"_5":14794,"_28279":128225,"_3062":129024},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3607":75483,"_31098":75158,"_21528":129026,"_5":14794,"_28279":128225,"_3062":129027},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3607":75484,"_31098":75158,"_21528":129029,"_5":14794,"_28279":128225,"_3062":129030},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3607":75485,"_31098":75158,"_21528":129032,"_5":14794,"_28279":128225,"_3062":129033},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3607":75486,"_31098":75158,"_21528":129035,"_5":14794,"_28279":128225,"_3062":129036},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3607":75487,"_31098":75158,"_21528":129038,"_5":14794,"_28279":128225,"_3062":129039},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3607":75488,"_31098":75158,"_21528":129041,"_5":14794,"_28279":128228,"_3062":129042},[],"Tras la actualización, comprueba en este orden:",{"_3607":75489,"_31098":75158,"_21528":129044,"_5":14794,"_28279":128228,"_3062":129045},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3607":75490,"_31098":75158,"_21528":129047,"_5":14794,"_28279":128228,"_3062":129048},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3607":75491,"_31098":75158,"_21528":129050,"_5":14794,"_28279":128228,"_3062":129051},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3607":75492,"_31098":75158,"_21528":129053,"_5":14794,"_28279":128228,"_3062":129054},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3607":75493,"_31098":75158,"_21528":129056,"_5":14794,"_28279":128228,"_3062":129057},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3607":75494,"_31098":75158,"_21528":129059,"_5":14794,"_28279":128228,"_3062":129060},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3607":75495,"_31098":75158,"_21528":129062,"_5":14794,"_28279":128228,"_3062":129063},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3607":75496,"_31098":75158,"_21528":129065,"_5":14794,"_28279":128228,"_3062":129066},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3607":75497,"_31098":75158,"_21528":129068,"_5":14794,"_28279":128228,"_3062":129069},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3607":75498,"_31098":75158,"_21528":129071,"_5":14794,"_28279":128228,"_3062":129072},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3607":75499,"_31098":75158,"_21528":129074,"_5":14794,"_28279":128228,"_3062":129075},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3607":75500,"_31098":75158,"_21528":129077,"_5":14794,"_28279":128228,"_3062":129078},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3607":75501,"_31098":75158,"_21528":129080,"_5":14794,"_28279":128228,"_3062":129081},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3607":75502,"_31098":75158,"_21528":129083,"_5":14794,"_28279":128228,"_3062":129084},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3607":75503,"_31098":75158,"_21528":129086,"_5":14794,"_28279":128228,"_3062":129087},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3607":75504,"_31098":75158,"_21528":129089,"_5":14794,"_28279":128232,"_3062":129090},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3607":75505,"_31098":75158,"_21528":129092,"_5":14794,"_28279":128232,"_3062":129093},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3607":75506,"_31098":75158,"_21528":129095,"_5":14794,"_28279":128232,"_3062":129096},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3607":75507,"_31098":75158,"_21528":129098,"_5":14794,"_28279":128232,"_3062":129099},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3607":75508,"_31098":75158,"_21528":129101,"_5":14794,"_28279":128232,"_3062":129102},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60267":129104,"_60269":129105,"_60271":129106,"_60273":129107,"_18653":3097,"_72460":3097},"spanish",[3062,31098,5,28279],{"_3062":25703,"_31098":25703,"_5":25703,"_28279":25703},{"_3062":129108,"_31098":132153,"_5":135198,"_28279":138243},{"_4805":129109,"_60277":129110,"_5":25703},{"_14875":7197,"_15254":7743,"_15273":7174,"_30097":5032,"_15260":4191,"_20435":3354,"_14896":5342,"_14903":19403,"_30039":7939,"_30453":4214,"_30474":25288,"_30073":3840,"_35498":5130,"_30176":20921,"_30518":10169,"_35505":5426,"_35508":4125,"_35511":7630,"_35514":3352,"_30920":13827,"_35519":4883,"_35521":26099,"_30955":11949,"_15269":19032,"_35525":7772,"_35528":10777,"_35530":6217,"_30502":6207,"_30940":4014,"_30968":3149,"_35535":6043,"_35537":12690,"_35539":3799,"_30193":12679,"_35542":3457,"_35544":7179,"_35546":3442,"_35548":7945,"_35550":3465,"_30110":3504,"_35553":3422,"_35555":6031,"_30104":7943,"_30539":10710,"_35559":27871,"_35561":14584,"_35564":4549,"_30150":4703,"_35568":8441,"_30030":6178,"_35571":7917,"_30078":26710,"_35574":5123,"_35576":4557,"_35579":11666,"_15263":19088,"_35582":9347,"_35584":7271,"_35587":7912,"_35589":6852,"_35591":7941,"_35593":13378,"_35595":3172,"_20438":3456,"_35598":10804,"_35600":3817,"_30051":17081,"_30496":6191,"_35604":10471,"_35606":4295,"_35608":7624,"_30985":3464,"_35611":3775,"_35613":7167,"_31163":6705,"_31078":3689,"_30555":13301,"_35618":3126,"_35620":3372,"_30088":9775,"_35623":7173,"_35625":14676,"_35627":3787,"_31001":12052,"_30170":6035,"_29550":21706,"_35632":7561,"_35634":26827,"_35636":4944,"_30219":18655,"_35640":23173,"_30490":19719,"_35644":12243,"_35646":3514,"_35648":3