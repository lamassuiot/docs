703":60455,"_41705":60458,"_41707":60461,"_41709":60464,"_41711":60467,"_41713":60470,"_41715":60473,"_41717":60476,"_41719":60479,"_41721":60482,"_41723":60485,"_41725":60488,"_41727":60491,"_41729":60494,"_41731":60497,"_41733":60500,"_41735":60503,"_41737":60506,"_41739":60509,"_41741":60512,"_41743":60515,"_41745":60518,"_41747":60521,"_41750":60524,"_41752":60527,"_41754":60530,"_41756":60533},{"_3626":15,"_31224":15,"_5":15239,"_3078":51009,"_31582":51010,"_21623":51014,"_28405":15},"Deploy from AWS Marketplace",[51011,51012,51013],"Docs","Deployment","Other models",[],{"_3626":16,"_31224":15,"_21623":51016,"_5":14874,"_28405":15,"_3078":51017},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3626":17,"_31224":15,"_5":31579,"_21623":51019,"_28405":51020,"_3078":51021},[],"/docs/pr-preview/pr-76/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3626":18,"_31224":15,"_5":31579,"_21623":51023,"_28405":51024,"_3078":51025},[],"/docs/pr-preview/pr-76/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3626":19,"_31224":15,"_5":31579,"_21623":51027,"_28405":51028,"_3078":51029},[],"/docs/pr-preview/pr-76/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3626":20,"_31224":15,"_5":31579,"_21623":51031,"_28405":51032,"_3078":51033},[],"/docs/pr-preview/pr-76/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3626":21,"_31224":15,"_5":31579,"_21623":51035,"_28405":51036,"_3078":51037},[],"/docs/pr-preview/pr-76/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3626":22,"_31224":15,"_5":31579,"_21623":51039,"_28405":51040,"_3078":51041},[],"/docs/pr-preview/pr-76/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3626":23,"_31224":15,"_5":31579,"_21623":51043,"_28405":51044,"_3078":51045},[],"/docs/pr-preview/pr-76/deployment/aws-marketplace#next-step","Next step",{"_3626":24,"_31224":15,"_21623":51047,"_5":14874,"_28405":15,"_3078":51048},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3626":25,"_31224":15,"_21623":51050,"_5":14874,"_28405":51020,"_3078":51051},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3626":26,"_31224":15,"_21623":51053,"_5":14874,"_28405":51020,"_3078":51054},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3626":27,"_31224":15,"_21623":51056,"_5":14874,"_28405":51020,"_3078":51057},[],"A security group allowing the necessary endpoints.",{"_3626":28,"_31224":15,"_21623":51059,"_5":14874,"_28405":51024,"_3078":51060},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3626":29,"_31224":15,"_21623":51062,"_5":14874,"_28405":51024,"_3078":51063},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3626":30,"_31224":15,"_21623":51065,"_5":14874,"_28405":51024,"_3078":51066},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3626":31,"_31224":15,"_21623":51068,"_5":14874,"_28405":51028,"_3078":51069},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3626":32,"_31224":15,"_21623":51071,"_5":14874,"_28405":51032,"_3078":51072},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3626":33,"_31224":15,"_21623":51074,"_5":14874,"_28405":51036,"_3078":51075},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3626":34,"_31224":15,"_21623":51077,"_5":14874,"_28405":51040,"_3078":51078},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3626":35,"_31224":15,"_21623":51080,"_5":14874,"_28405":51044,"_3078":51081},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3626":36,"_31224":36,"_5":15239,"_3078":51083,"_31582":51084,"_21623":51085,"_28405":36},"Deploy Lamassu",[51011,51012],[],{"_3626":37,"_31224":36,"_21623":51087,"_5":14874,"_28405":36,"_3078":51088},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3626":38,"_31224":36,"_5":31579,"_21623":51090,"_28405":51091,"_3078":51092},[],"/docs/pr-preview/pr-76/deployment/overview#choose-a-model","Choose a model",{"_3626":39,"_31224":36,"_5":31579,"_21623":51094,"_28405":51095,"_3078":51096},[],"/docs/pr-preview/pr-76/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3626":40,"_31224":36,"_5":31579,"_21623":51098,"_28405":51099,"_3078":51100},[],"/docs/pr-preview/pr-76/deployment/overview#after-deployment","After deployment",{"_3626":41,"_31224":36,"_21623":51102,"_5":14874,"_28405":36,"_3078":51103},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3626":42,"_31224":36,"_21623":51105,"_5":14874,"_28405":51091,"_3078":51106},[],"Model",{"_3626":43,"_31224":36,"_21623":51108,"_5":14874,"_28405":51091,"_3078":51109},[],"Recommended for",{"_3626":44,"_31224":36,"_21623":51111,"_5":14874,"_28405":51091,"_3078":51112},[],"Who operates the infrastructure",{"_3626":45,"_31224":36,"_21623":51114,"_5":14874,"_28405":51091,"_3078":51115},[],"Starting point",{"_3626":46,"_31224":36,"_21623":51117,"_5":14874,"_28405":51091,"_3078":51118},[],"Kubernetes self-managed",{"_3626":47,"_31224":36,"_21623":51120,"_5":14874,"_28405":51091,"_3078":51121},[],"Production, regulated environments and custom deployments",{"_3626":48,"_31224":36,"_21623":51123,"_5":14874,"_28405":51091,"_3078":51124},[],"Your team",{"_3626":49,"_31224":36,"_21623":51126,"_5":14874,"_28405":51091,"_3078":51127},[],"Helm or Fastlane",{"_3626":50,"_31224":36,"_21623":51129,"_5":14874,"_28405":51091,"_3078":51130},[],"AWS Marketplace",{"_3626":51,"_31224":36,"_21623":51132,"_5":14874,"_28405":51091,"_3078":51133},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3626":52,"_31224":36,"_21623":51135,"_5":14874,"_28405":51091,"_3078":51124},[],{"_3626":53,"_31224":36,"_21623":51137,"_5":14874,"_28405":51091,"_3078":51138},[],"Preconfigured image on EC2",{"_3626":54,"_31224":36,"_21623":51140,"_5":14874,"_28405":51091,"_3078":51141},[],"SaaS",{"_3626":55,"_31224":36,"_21623":51143,"_5":14874,"_28405":51091,"_3078":51144},[],"Teams that want to use the platform without operating it",{"_3626":56,"_31224":36,"_21623":51146,"_5":14874,"_28405":51091,"_3078":51147},[],"Lamassu",{"_3626":57,"_31224":36,"_21623":51149,"_5":14874,"_28405":51091,"_3078":51150},[],"Managed subscription",{"_3626":58,"_31224":36,"_21623":51152,"_5":14874,"_28405":51091,"_3078":51153},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3626":59,"_31224":36,"_21623":51155,"_5":14874,"_28405":51091,"_3078":51156},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3626":60,"_31224":36,"_21623":51158,"_5":14874,"_28405":51091,"_3078":51159},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3626":61,"_31224":36,"_21623":51161,"_5":14874,"_28405":51095,"_3078":51162},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3626":62,"_31224":36,"_21623":51164,"_5":14874,"_28405":51099,"_3078":51165},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3626":63,"_31224":63,"_5":15239,"_3078":51167,"_31582":51168,"_21623":51169,"_28405":63},"Use Lamassu as SaaS",[51011,51012,51013],[],{"_3626":64,"_31224":63,"_21623":51171,"_5":14874,"_28405":63,"_3078":51172},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3626":65,"_31224":63,"_5":31579,"_21623":51174,"_28405":51175,"_3078":51176},[],"/docs/pr-preview/pr-76/deployment/saas#what-the-service-manages","What the service manages",{"_3626":66,"_31224":63,"_5":31579,"_21623":51178,"_28405":51179,"_3078":51180},[],"/docs/pr-preview/pr-76/deployment/saas#plans","Plans",{"_3626":67,"_31224":63,"_5":31579,"_21623":51182,"_28405":51183,"_3078":51184},[],"/docs/pr-preview/pr-76/deployment/saas#request-access","Request access",{"_3626":68,"_31224":63,"_21623":51186,"_5":14874,"_28405":63,"_3078":51187},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3626":69,"_31224":63,"_21623":51189,"_5":14874,"_28405":51175,"_3078":51190},[],"Platform availability and maintenance.",{"_3626":70,"_31224":63,"_21623":51192,"_5":14874,"_28405":51175,"_3078":51193},[],"Automatic backups.",{"_3626":71,"_31224":63,"_21623":51195,"_5":14874,"_28405":51175,"_3078":51196},[],"Version upgrades.",{"_3626":72,"_31224":63,"_21623":51198,"_5":14874,"_28405":51175,"_3078":51199},[],"Technical support and SLA according to your plan.",{"_3626":73,"_31224":63,"_21623":51201,"_5":14874,"_28405":51179,"_3078":51202},[],"Plan",{"_3626":74,"_31224":63,"_21623":51204,"_5":14874,"_28405":51179,"_3078":51205},[],"Devices",{"_3626":75,"_31224":63,"_21623":51207,"_5":14874,"_28405":51179,"_3078":51208},[],"Support",{"_3626":76,"_31224":63,"_21623":51210,"_5":14874,"_28405":51179,"_3078":51211},[],"SLA",{"_3626":77,"_31224":63,"_21623":51213,"_5":14874,"_28405":51179,"_3078":51214},[],"Starter",{"_3626":78,"_31224":63,"_21623":51216,"_5":14874,"_28405":51179,"_3078":51217},[],"Up to 1,000",{"_3626":79,"_31224":63,"_21623":51219,"_5":14874,"_28405":51179,"_3078":51220},[],"Email",{"_3626":80,"_31224":63,"_21623":51222,"_5":14874,"_28405":51179,"_3078":51223},[],"99.5 %",{"_3626":81,"_31224":63,"_21623":51225,"_5":14874,"_28405":51179,"_3078":51226},[],"Professional",{"_3626":82,"_31224":63,"_21623":51228,"_5":14874,"_28405":51179,"_3078":51229},[],"Up to 10,000",{"_3626":83,"_31224":63,"_21623":51231,"_5":14874,"_28405":51179,"_3078":51232},[],"Email and chat",{"_3626":84,"_31224":63,"_21623":51234,"_5":14874,"_28405":51179,"_3078":51235},[],"99.9 %",{"_3626":85,"_31224":63,"_21623":51237,"_5":14874,"_28405":51179,"_3078":51238},[],"Enterprise",{"_3626":86,"_31224":63,"_21623":51240,"_5":14874,"_28405":51179,"_3078":51241},[],"Unlimited",{"_3626":87,"_31224":63,"_21623":51243,"_5":14874,"_28405":51179,"_3078":51244},[],"Dedicated",{"_3626":88,"_31224":63,"_21623":51246,"_5":14874,"_28405":51179,"_3078":51247},[],"99.99 %",{"_3626":89,"_31224":63,"_21623":51249,"_5":14874,"_28405":51183,"_3078":51250},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3626":90,"_31224":63,"_21623":51252,"_5":14874,"_28405":51183,"_3078":51253},[],"When you receive your instance's credentials, continue with Get started.",{"_3626":91,"_31224":91,"_5":15239,"_3078":51255,"_31582":51256,"_21623":51257,"_28405":91},"Fastlane",[51011,51012,51118],[],{"_3626":92,"_31224":91,"_21623":51259,"_5":14874,"_28405":91,"_3078":51260},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3626":93,"_31224":91,"_5":31579,"_21623":51262,"_28405":51263,"_3078":51264},[],"/docs/pr-preview/pr-76/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3626":94,"_31224":91,"_5":31579,"_21623":51266,"_28405":51267,"_3078":51268},[],"/docs/pr-preview/pr-76/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3626":95,"_31224":91,"_5":31579,"_21623":51270,"_28405":51271,"_3078":51021},[],"/docs/pr-preview/pr-76/deployment/self-hosted/fastlane#before-you-begin",{"_3626":96,"_31224":91,"_5":31579,"_21623":51273,"_28405":51274,"_3078":51275},[],"/docs/pr-preview/pr-76/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3626":97,"_31224":91,"_5":31579,"_21623":51277,"_28405":51278,"_3078":51279},[],"/docs/pr-preview/pr-76/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3626":98,"_31224":91,"_5":31579,"_21623":51281,"_28405":51282,"_3078":51283},[],"/docs/pr-preview/pr-76/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3626":99,"_31224":91,"_5":31579,"_21623":51285,"_28405":51286,"_3078":51287},[],"/docs/pr-preview/pr-76/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3626":100,"_31224":91,"_5":31579,"_21623":51289,"_28405":51290,"_3078":51291},[],"/docs/pr-preview/pr-76/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3626":101,"_31224":91,"_5":31579,"_21623":51293,"_28405":51294,"_3078":51295},[],"/docs/pr-preview/pr-76/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3626":102,"_31224":91,"_5":31579,"_21623":51297,"_28405":51298,"_3078":51299},[],"/docs/pr-preview/pr-76/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3626":103,"_31224":91,"_5":31579,"_21623":51301,"_28405":51302,"_3078":51303},[],"/docs/pr-preview/pr-76/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3626":104,"_31224":91,"_21623":51305,"_5":14874,"_28405":51263,"_3078":51306},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3626":105,"_31224":91,"_21623":51308,"_5":14874,"_28405":51263,"_3078":51309},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3626":106,"_31224":91,"_21623":51311,"_5":14874,"_28405":51267,"_3078":51312},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3626":107,"_31224":91,"_21623":51314,"_5":14874,"_28405":51267,"_3078":51315},[],"Fastlane installs or configures",{"_3626":108,"_31224":91,"_21623":51317,"_5":14874,"_28405":51267,"_3078":51318},[],"You still provide",{"_3626":109,"_31224":91,"_21623":51320,"_5":14874,"_28405":51267,"_3078":51321},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3626":110,"_31224":91,"_21623":51323,"_5":14874,"_28405":51267,"_3078":51324},[],"The Kubernetes cluster, nodes and persistent storage",{"_3626":111,"_31224":91,"_21623":51326,"_5":14874,"_28405":51267,"_3078":51327},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3626":112,"_31224":91,"_21623":51329,"_5":14874,"_28405":51267,"_3078":51330},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3626":113,"_31224":91,"_21623":51332,"_5":14874,"_28405":51267,"_3078":51333},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3626":114,"_31224":91,"_21623":51335,"_5":14874,"_28405":51267,"_3078":51336},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3626":115,"_31224":91,"_21623":51338,"_5":14874,"_28405":51267,"_3078":51339},[],"Optional observability and lab HSM components",{"_3626":116,"_31224":91,"_21623":51341,"_5":14874,"_28405":51267,"_3078":51342},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3626":117,"_31224":91,"_21623":51344,"_5":14874,"_28405":51267,"_3078":51345},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3626":118,"_31224":91,"_21623":51347,"_5":14874,"_28405":51271,"_3078":51348},[],"You need:",{"_3626":119,"_31224":91,"_21623":51350,"_5":14874,"_28405":51271,"_3078":51351},[],"an existing Kubernetes cluster",{"_3626":120,"_31224":91,"_21623":51353,"_5":14874,"_28405":51271,"_3078":51354},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3626":121,"_31224":91,"_21623":51356,"_5":14874,"_28405":51271,"_3078":51357},[],"`yq`",{"_3626":122,"_31224":91,"_21623":51359,"_5":14874,"_28405":51271,"_3078":24440},[],{"_3626":123,"_31224":91,"_21623":51361,"_5":14874,"_28405":51271,"_3078":51362},[],"`jq` only when using `--sample-data` or `--development`",{"_3626":124,"_31224":91,"_21623":51364,"_5":14874,"_28405":51271,"_3078":51365},[],"`ssh-keygen` only when using `--with-hsm`",{"_3626":125,"_31224":91,"_21623":51367,"_5":14874,"_28405":51271,"_3078":51368},[],"free external ports 80 and 443 on a single-node K3s host",{"_3626":126,"_31224":91,"_21623":51370,"_5":14874,"_28405":51271,"_3078":51371},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3626":127,"_31224":91,"_21623":51373,"_5":14874,"_28405":51271,"_3078":51374},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3626":128,"_31224":91,"_21623":51376,"_5":14874,"_28405":51274,"_3078":51377},[],"Run the script from a clone of the Helm repository:",{"_3626":129,"_31224":91,"_21623":51379,"_5":14874,"_28405":51274,"_3078":51380},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3626":130,"_31224":91,"_21623":51382,"_5":14874,"_28405":51278,"_3078":51383},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3626":131,"_31224":91,"_21623":51385,"_5":14874,"_28405":51278,"_3078":51386},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3626":132,"_31224":91,"_21623":51388,"_5":14874,"_28405":51278,"_3078":51389},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3626":133,"_31224":91,"_21623":51391,"_5":14874,"_28405":51278,"_3078":51392},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3626":134,"_31224":91,"_21623":51394,"_5":14874,"_28405":51282,"_3078":51395},[],"Option",{"_3626":135,"_31224":91,"_21623":51397,"_5":14874,"_28405":51282,"_3078":51398},[],"Default",{"_3626":136,"_31224":91,"_21623":51400,"_5":14874,"_28405":51282,"_3078":51401},[],"Purpose",{"_3626":137,"_31224":91,"_21623":51403,"_5":14874,"_28405":51282,"_3078":51404},[],"`-h`, `--help`",{"_3626":138,"_31224":91,"_21623":51406,"_5":14874,"_28405":51282,"_3078":51407},[],"—",{"_3626":139,"_31224":91,"_21623":51409,"_5":14874,"_28405":51282,"_3078":51410},[],"Show help",{"_3626":140,"_31224":91,"_21623":51412,"_5":14874,"_28405":51282,"_3078":51413},[],"`-c`, `--context`",{"_3626":141,"_31224":91,"_21623":51415,"_5":14874,"_28405":51282,"_3078":51416},[],"current context",{"_3626":142,"_31224":91,"_21623":51418,"_5":14874,"_28405":51282,"_3078":51419},[],"Select the kubeconfig context for kubectl and Helm",{"_3626":143,"_31224":91,"_21623":51421,"_5":14874,"_28405":51282,"_3078":51422},[],"`-n`, `--non-interactive`",{"_3626":144,"_31224":91,"_21623":51424,"_5":14874,"_28405":51282,"_3078":6794},[],{"_3626":145,"_31224":91,"_21623":51426,"_5":14874,"_28405":51282,"_3078":51427},[],"Skip prompts and generate dependency credentials",{"_3626":146,"_31224":91,"_21623":51429,"_5":14874,"_28405":51282,"_3078":51430},[],"`-ns`, `--namespace`",{"_3626":147,"_31224":91,"_21623":51432,"_5":14874,"_28405":51282,"_3078":51433},[],"`lamassu-dev`",{"_3626":148,"_31224":91,"_21623":51435,"_5":14874,"_28405":51282,"_3078":51436},[],"Namespace for the installation",{"_3626":149,"_31224":91,"_21623":51438,"_5":14874,"_28405":51282,"_3078":51439},[],"`-d`, `--domain`",{"_3626":150,"_31224":91,"_21623":51441,"_5":14874,"_28405":51282,"_3078":51442},[],"`dev.lamassu.io`",{"_3626":151,"_31224":91,"_21623":51444,"_5":14874,"_28405":51282,"_3078":51445},[],"Domain used by the UI, OIDC and certificate",{"_3626":152,"_31224":91,"_21623":51447,"_5":14874,"_28405":51282,"_3078":51448},[],"`-v`, `--version`",{"_3626":153,"_31224":91,"_21623":51450,"_5":14874,"_28405":51282,"_3078":15591},[],{"_3626":154,"_31224":91,"_21623":51452,"_5":14874,"_28405":51282,"_3078":51453},[],"Lamassu chart version",{"_3626":155,"_31224":91,"_21623":51455,"_5":14874,"_28405":51282,"_3078":51456},[],"`--https-port`",{"_3626":156,"_31224":91,"_21623":51458,"_5":14874,"_28405":51282,"_3078":51459},[],"`443`",{"_3626":157,"_31224":91,"_21623":51461,"_5":14874,"_28405":51282,"_3078":51462},[],"Gateway HTTPS listener port",{"_3626":158,"_31224":91,"_21623":51464,"_5":14874,"_28405":51282,"_3078":51465},[],"`--http-port`",{"_3626":159,"_31224":91,"_21623":51467,"_5":14874,"_28405":51282,"_3078":51468},[],"`80`",{"_3626":160,"_31224":91,"_21623":51470,"_5":14874,"_28405":51282,"_3078":51471},[],"Gateway HTTP listener port",{"_3626":161,"_31224":91,"_21623":51473,"_5":14874,"_28405":51282,"_3078":51474},[],"`--tls-crt`",{"_3626":162,"_31224":91,"_21623":51476,"_5":14874,"_28405":51282,"_3078":51407},[],{"_3626":163,"_31224":91,"_21623":51478,"_5":14874,"_28405":51282,"_3078":51479},[],"PEM certificate for downstream TLS",{"_3626":164,"_31224":91,"_21623":51481,"_5":14874,"_28405":51282,"_3078":51482},[],"`--tls-key`",{"_3626":165,"_31224":91,"_21623":51484,"_5":14874,"_28405":51282,"_3078":51407},[],{"_3626":166,"_31224":91,"_21623":51486,"_5":14874,"_28405":51282,"_3078":51487},[],"PEM private key for downstream TLS",{"_3626":167,"_31224":91,"_21623":51489,"_5":14874,"_28405":51282,"_3078":51490},[],"`-l`, `--local-chart-path`",{"_3626":168,"_31224":91,"_21623":51492,"_5":14874,"_28405":51282,"_3078":51493},[],"repository chart",{"_3626":169,"_31224":91,"_21623":51495,"_5":14874,"_28405":51282,"_3078":51496},[],"Use an unpacked local Lamassu chart",{"_3626":170,"_31224":91,"_21623":51498,"_5":14874,"_28405":51282,"_3078":51499},[],"`-ip`, `--gateway-ip`",{"_3626":171,"_31224":91,"_21623":51501,"_5":14874,"_28405":51282,"_3078":9083},[],{"_3626":172,"_31224":91,"_21623":51503,"_5":14874,"_28405":51282,"_3078":51504},[],"Override the address written to `gateway.addresses`",{"_3626":173,"_31224":91,"_21623":51506,"_5":14874,"_28405":51282,"_3078":51507},[],"`--otel`",{"_3626":174,"_31224":91,"_21623":51509,"_5":14874,"_28405":51282,"_3078":6794},[],{"_3626":175,"_31224":91,"_21623":51511,"_5":14874,"_28405":51282,"_3078":51512},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3626":176,"_31224":91,"_21623":51514,"_5":14874,"_28405":51282,"_3078":51515},[],"`--development`",{"_3626":177,"_31224":91,"_21623":51517,"_5":14874,"_28405":51282,"_3078":6794},[],{"_3626":178,"_31224":91,"_21623":51519,"_5":14874,"_28405":51282,"_3078":51520},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3626":179,"_31224":91,"_21623":51522,"_5":14874,"_28405":51282,"_3078":51523},[],"`--sample-data`",{"_3626":180,"_31224":91,"_21623":51525,"_5":14874,"_28405":51282,"_3078":6794},[],{"_3626":181,"_31224":91,"_21623":51527,"_5":14874,"_28405":51282,"_3078":51528},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3626":182,"_31224":91,"_21623":51530,"_5":14874,"_28405":51282,"_3078":51531},[],"`--with-hsm`",{"_3626":183,"_31224":91,"_21623":51533,"_5":14874,"_28405":51282,"_3078":6794},[],{"_3626":184,"_31224":91,"_21623":51535,"_5":14874,"_28405":51282,"_3078":51536},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3626":185,"_31224":91,"_21623":51538,"_5":14874,"_28405":51282,"_3078":51539},[],"`--softhsm-chart-path`",{"_3626":186,"_31224":91,"_21623":51541,"_5":14874,"_28405":51282,"_3078":51542},[],"`./charts/softhsm`",{"_3626":187,"_31224":91,"_21623":51544,"_5":14874,"_28405":51282,"_3078":51545},[],"Use a different local SoftHSM chart",{"_3626":188,"_31224":91,"_21623":51547,"_5":14874,"_28405":51282,"_3078":51548},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3626":189,"_31224":91,"_21623":51550,"_5":14874,"_28405":51286,"_3078":51551},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3626":190,"_31224":91,"_21623":51553,"_5":14874,"_28405":51286,"_3078":51554},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3626":191,"_31224":91,"_21623":51556,"_5":14874,"_28405":51286,"_3078":51557},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3626":192,"_31224":91,"_21623":51559,"_5":14874,"_28405":51286,"_3078":51560},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3626":193,"_31224":91,"_21623":51562,"_5":14874,"_28405":51286,"_3078":51563},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3626":194,"_31224":91,"_21623":51565,"_5":14874,"_28405":51286,"_3078":51566},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3626":195,"_31224":91,"_21623":51568,"_5":14874,"_28405":51290,"_3078":51569},[],"Fastlane:",{"_3626":196,"_31224":91,"_21623":51571,"_5":14874,"_28405":51290,"_3078":51572},[],"validates local tools and the selected cluster",{"_3626":197,"_31224":91,"_21623":51574,"_5":14874,"_28405":51290,"_3078":51575},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3626":198,"_31224":91,"_21623":51577,"_5":14874,"_28405":51290,"_3078":51578},[],"creates the namespace",{"_3626":199,"_31224":91,"_21623":51580,"_5":14874,"_28405":51290,"_3078":51581},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3626":200,"_31224":91,"_21623":51583,"_5":14874,"_28405":51290,"_3078":51584},[],"installs PostgreSQL and creates the required databases",{"_3626":201,"_31224":91,"_21623":51586,"_5":14874,"_28405":51290,"_3078":51587},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3626":202,"_31224":91,"_21623":51589,"_5":14874,"_28405":51290,"_3078":51590},[],"installs RabbitMQ",{"_3626":203,"_31224":91,"_21623":51592,"_5":14874,"_28405":51290,"_3078":51593},[],"optionally installs observability and lab HSM components",{"_3626":204,"_31224":91,"_21623":51595,"_5":14874,"_28405":51290,"_3078":51596},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3626":205,"_31224":91,"_21623":51598,"_5":14874,"_28405":51290,"_3078":51599},[],"optionally loads sample data",{"_3626":206,"_31224":91,"_21623":51601,"_5":14874,"_28405":51290,"_3078":51602},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3626":207,"_31224":91,"_21623":51604,"_5":14874,"_28405":51294,"_3078":51605},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3626":208,"_31224":91,"_21623":51607,"_5":14874,"_28405":51294,"_3078":51608},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3626":209,"_31224":91,"_21623":51610,"_5":14874,"_28405":51298,"_3078":51611},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3626":210,"_31224":91,"_21623":51613,"_5":14874,"_28405":51298,"_3078":51614},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3626":211,"_31224":91,"_21623":51616,"_5":14874,"_28405":51298,"_3078":51617},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3626":212,"_31224":91,"_21623":51619,"_5":14874,"_28405":51298,"_3078":51620},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3626":213,"_31224":91,"_21623":51622,"_5":14874,"_28405":51302,"_3078":51623},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3626":214,"_31224":214,"_5":15239,"_3078":51625,"_31582":51626,"_21623":51627,"_28405":214},"Install with Helm",[51011,51012,51118],[],{"_3626":215,"_31224":214,"_21623":51629,"_5":14874,"_28405":214,"_3078":51630},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3626":216,"_31224":214,"_5":31579,"_21623":51632,"_28405":51633,"_3078":51634},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3626":217,"_31224":214,"_5":31579,"_21623":51636,"_28405":51637,"_3078":51021},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#before-you-begin",{"_3626":218,"_31224":214,"_5":31579,"_21623":51639,"_28405":51640,"_3078":51641},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3626":219,"_31224":214,"_5":31579,"_21623":51643,"_28405":51644,"_3078":51645},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3626":220,"_31224":214,"_5":31579,"_21623":51647,"_28405":51648,"_3078":51649},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3626":221,"_31224":214,"_5":31579,"_21623":51651,"_28405":51652,"_3078":51653},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3626":222,"_31224":214,"_5":31579,"_21623":51655,"_28405":51656,"_3078":51657},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3626":223,"_31224":214,"_5":31579,"_21623":51659,"_28405":51660,"_3078":51661},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3626":224,"_31224":214,"_5":31579,"_21623":51663,"_28405":51664,"_3078":51665},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3626":225,"_31224":214,"_5":31579,"_21623":51667,"_28405":51668,"_3078":51669},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3626":226,"_31224":214,"_5":31579,"_21623":51671,"_28405":51672,"_3078":51673},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3626":227,"_31224":214,"_5":31579,"_21623":51675,"_28405":51676,"_3078":51677},[],"/docs/pr-preview/pr-76/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3626":228,"_31224":214,"_21623":51679,"_5":14874,"_28405":51633,"_3078":51680},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3626":229,"_31224":214,"_21623":51682,"_5":14874,"_28405":51637,"_3078":51683},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3626":230,"_31224":214,"_21623":51685,"_5":14874,"_28405":51637,"_3078":51686},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3626":231,"_31224":214,"_21623":51688,"_5":14874,"_28405":51637,"_3078":51689},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3626":232,"_31224":214,"_21623":51691,"_5":14874,"_28405":51637,"_3078":51692},[],"a reachable RabbitMQ broker and credentials",{"_3626":233,"_31224":214,"_21623":51694,"_5":14874,"_28405":51637,"_3078":51695},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3626":234,"_31224":214,"_21623":51697,"_5":14874,"_28405":51637,"_3078":51698},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3626":235,"_31224":214,"_21623":51700,"_5":14874,"_28405":51637,"_3078":51701},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3626":236,"_31224":214,"_21623":51703,"_5":14874,"_28405":51637,"_3078":51704},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3626":237,"_31224":214,"_21623":51706,"_5":14874,"_28405":51637,"_3078":51707},[],"a StorageClass and an external traffic design",{"_3626":238,"_31224":214,"_21623":51709,"_5":14874,"_28405":51637,"_3078":51710},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3626":239,"_31224":214,"_21623":51712,"_5":14874,"_28405":51637,"_3078":51713},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3626":240,"_31224":214,"_21623":51715,"_5":14874,"_28405":51637,"_3078":51716},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3626":241,"_31224":214,"_21623":51718,"_5":14874,"_28405":51640,"_3078":51719},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3626":242,"_31224":214,"_21623":51721,"_5":14874,"_28405":51640,"_3078":51722},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3626":243,"_31224":214,"_21623":51724,"_5":14874,"_28405":51640,"_3078":51725},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3626":244,"_31224":214,"_21623":51727,"_5":14874,"_28405":51644,"_3078":51728},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3626":245,"_31224":214,"_21623":51730,"_5":14874,"_28405":51644,"_3078":51731},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3626":246,"_31224":214,"_21623":51733,"_5":14874,"_28405":51644,"_3078":51734},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3626":247,"_31224":214,"_21623":51736,"_5":14874,"_28405":51644,"_3078":51737},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3626":248,"_31224":214,"_21623":51739,"_5":14874,"_28405":51648,"_3078":51740},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3626":249,"_31224":214,"_21623":51742,"_5":14874,"_28405":51648,"_3078":51743},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3626":250,"_31224":214,"_21623":51745,"_5":14874,"_28405":51648,"_3078":51746},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3626":251,"_31224":214,"_21623":51748,"_5":14874,"_28405":51648,"_3078":51749},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3626":252,"_31224":214,"_21623":51751,"_5":14874,"_28405":51648,"_3078":51752},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3626":253,"_31224":214,"_21623":51754,"_5":14874,"_28405":51648,"_3078":51755},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3626":254,"_31224":214,"_21623":51757,"_5":14874,"_28405":51648,"_3078":51758},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3626":255,"_31224":214,"_21623":51760,"_5":14874,"_28405":51648,"_3078":51761},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3626":256,"_31224":214,"_21623":51763,"_5":14874,"_28405":51652,"_3078":51764},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3626":257,"_31224":214,"_21623":51766,"_5":14874,"_28405":51656,"_3078":51767},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3626":258,"_31224":214,"_21623":51769,"_5":14874,"_28405":51656,"_3078":51770},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3626":259,"_31224":214,"_21623":51772,"_5":14874,"_28405":51656,"_3078":51773},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3626":260,"_31224":214,"_21623":51775,"_5":14874,"_28405":51656,"_3078":51776},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3626":261,"_31224":214,"_21623":51778,"_5":14874,"_28405":51656,"_3078":51779},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3626":262,"_31224":214,"_21623":51781,"_5":14874,"_28405":51656,"_3078":51782},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3626":263,"_31224":214,"_21623":51784,"_5":14874,"_28405":51656,"_3078":51785},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3626":264,"_31224":214,"_21623":51787,"_5":14874,"_28405":51660,"_3078":51788},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3626":265,"_31224":214,"_21623":51790,"_5":14874,"_28405":51660,"_3078":51791},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3626":266,"_31224":214,"_21623":51793,"_5":14874,"_28405":51660,"_3078":51794},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3626":267,"_31224":214,"_21623":51796,"_5":14874,"_28405":51660,"_3078":51797},[],"See Access control for the principal and policy model.",{"_3626":268,"_31224":214,"_21623":51799,"_5":14874,"_28405":51664,"_3078":51800},[],"To install a local checkout instead:",{"_3626":269,"_31224":214,"_21623":51802,"_5":14874,"_28405":51668,"_3078":51803},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3626":270,"_31224":214,"_21623":51805,"_5":14874,"_28405":51668,"_3078":51806},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3626":271,"_31224":214,"_21623":51808,"_5":14874,"_28405":51672,"_3078":51809},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3626":272,"_31224":214,"_21623":51811,"_5":14874,"_28405":51672,"_3078":51812},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3626":273,"_31224":214,"_21623":51814,"_5":14874,"_28405":51672,"_3078":51815},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3626":274,"_31224":214,"_21623":51817,"_5":14874,"_28405":51672,"_3078":51818},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3626":275,"_31224":214,"_21623":51820,"_5":14874,"_28405":51672,"_3078":51821},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3626":276,"_31224":214,"_21623":51823,"_5":14874,"_28405":51676,"_3078":51824},[],"Before going live, review:",{"_3626":277,"_31224":214,"_21623":51826,"_5":14874,"_28405":51676,"_3078":51827},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3626":278,"_31224":214,"_21623":51829,"_5":14874,"_28405":51676,"_3078":51830},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3626":279,"_31224":214,"_21623":51832,"_5":14874,"_28405":51676,"_3078":51833},[],"shared VA storage before increasing VA replicas",{"_3626":280,"_31224":214,"_21623":51835,"_5":14874,"_28405":51676,"_3078":51836},[],"managed OIDC roles and removal of evaluation credentials",{"_3626":281,"_31224":214,"_21623":51838,"_5":14874,"_28405":51676,"_3078":51839},[],"a trusted TLS issuer or externally managed certificate",{"_3626":282,"_31224":214,"_21623":51841,"_5":14874,"_28405":51676,"_3078":51842},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3626":283,"_31224":214,"_21623":51844,"_5":14874,"_28405":51676,"_3078":51845},[],"SMTP, observability and alert delivery",{"_3626":284,"_31224":214,"_21623":51847,"_5":14874,"_28405":51676,"_3078":51848},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3626":285,"_31224":214,"_21623":51850,"_5":14874,"_28405":51676,"_3078":51851},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3626":286,"_31224":286,"_5":15239,"_3078":51853,"_31582":51854,"_21623":51855,"_28405":286},"Expose the Gateway",[51011,51012,51118],[],{"_3626":287,"_31224":286,"_21623":51857,"_5":14874,"_28405":286,"_3078":51858},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3626":288,"_31224":286,"_5":31579,"_21623":51860,"_28405":51861,"_3078":51862},[],"/docs/pr-preview/pr-76/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3626":289,"_31224":286,"_5":31579,"_21623":51864,"_28405":51865,"_3078":51866},[],"/docs/pr-preview/pr-76/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3626":290,"_31224":286,"_5":31579,"_21623":51868,"_28405":51869,"_3078":51870},[],"/docs/pr-preview/pr-76/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3626":291,"_31224":286,"_5":31579,"_21623":51872,"_28405":51873,"_3078":51874},[],"/docs/pr-preview/pr-76/deployment/self-hosted/networking#k3s","K3s",{"_3626":292,"_31224":286,"_5":31579,"_21623":51876,"_28405":51877,"_3078":51878},[],"/docs/pr-preview/pr-76/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3626":293,"_31224":286,"_5":31579,"_21623":51880,"_28405":51881,"_3078":51882},[],"/docs/pr-preview/pr-76/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3626":294,"_31224":286,"_5":31579,"_21623":51884,"_28405":51885,"_3078":51886},[],"/docs/pr-preview/pr-76/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3626":295,"_31224":286,"_5":31579,"_21623":51888,"_28405":51889,"_3078":51890},[],"/docs/pr-preview/pr-76/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3626":296,"_31224":286,"_5":31579,"_21623":51892,"_28405":51893,"_3078":51894},[],"/docs/pr-preview/pr-76/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3626":297,"_31224":286,"_5":31579,"_21623":51896,"_28405":51897,"_3078":51898},[],"/docs/pr-preview/pr-76/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3626":298,"_31224":286,"_5":31579,"_21623":51900,"_28405":51901,"_3078":51902},[],"/docs/pr-preview/pr-76/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3626":299,"_31224":286,"_21623":51904,"_5":14874,"_28405":51861,"_3078":51905},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3626":300,"_31224":286,"_21623":51907,"_5":14874,"_28405":51861,"_3078":51908},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3626":301,"_31224":286,"_21623":51910,"_5":14874,"_28405":51865,"_3078":51911},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3626":302,"_31224":286,"_21623":51913,"_5":14874,"_28405":51865,"_3078":51914},[],"Set it only when:",{"_3626":303,"_31224":286,"_21623":51916,"_5":14874,"_28405":51865,"_3078":51917},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3626":304,"_31224":286,"_21623":51919,"_5":14874,"_28405":51865,"_3078":51920},[],"that address is allocated to this Gateway",{"_3626":305,"_31224":286,"_21623":51922,"_5":14874,"_28405":51865,"_3078":51923},[],"the surrounding network already routes traffic for it to the cluster",{"_3626":306,"_31224":286,"_21623":51925,"_5":14874,"_28405":51865,"_3078":51926},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3626":307,"_31224":286,"_21623":51928,"_5":14874,"_28405":51865,"_3078":51929},[],"Keep these two settings separate:",{"_3626":308,"_31224":286,"_21623":51931,"_5":14874,"_28405":51865,"_3078":51932},[],"`gateway.addresses` requests an address for the Gateway.",{"_3626":309,"_31224":286,"_21623":51934,"_5":14874,"_28405":51865,"_3078":51935},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3626":310,"_31224":286,"_21623":51937,"_5":14874,"_28405":51865,"_3078":51938},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3626":311,"_31224":286,"_21623":51940,"_5":14874,"_28405":51869,"_3078":51941},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3626":312,"_31224":286,"_21623":51943,"_5":14874,"_28405":51869,"_3078":51944},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3626":313,"_31224":286,"_21623":51946,"_5":14874,"_28405":51873,"_3078":51947},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3626":314,"_31224":286,"_21623":51949,"_5":14874,"_28405":51873,"_3078":51950},[],"For the recommended design:",{"_3626":315,"_31224":286,"_21623":51952,"_5":14874,"_28405":51873,"_3078":51953},[],"Use only one externally exposed Lamassu Gateway.",{"_3626":316,"_31224":286,"_21623":51955,"_5":14874,"_28405":51873,"_3078":51956},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3626":317,"_31224":286,"_21623":51958,"_5":14874,"_28405":51873,"_3078":51959},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3626":318,"_31224":286,"_21623":51961,"_5":14874,"_28405":51873,"_3078":51962},[],"Point DNS at the VM's reachable address.",{"_3626":319,"_31224":286,"_21623":51964,"_5":14874,"_28405":51873,"_3078":51965},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3626":320,"_31224":286,"_21623":51967,"_5":14874,"_28405":51877,"_3078":51968},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3626":321,"_31224":286,"_21623":51970,"_5":14874,"_28405":51881,"_3078":51971},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3626":322,"_31224":286,"_21623":51973,"_5":14874,"_28405":51881,"_3078":51974},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3626":323,"_31224":286,"_21623":51976,"_5":14874,"_28405":51885,"_3078":51977},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3626":324,"_31224":286,"_21623":51979,"_5":14874,"_28405":51885,"_3078":51980},[],"Requirement",{"_3626":325,"_31224":286,"_21623":51982,"_5":14874,"_28405":51885,"_3078":51983},[],"Recommended design",{"_3626":326,"_31224":286,"_21623":51985,"_5":14874,"_28405":51885,"_3078":51986},[],"Consequence",{"_3626":327,"_31224":286,"_21623":51988,"_5":14874,"_28405":51885,"_3078":51989},[],"Several Lamassu URLs or services",{"_3626":328,"_31224":286,"_21623":51991,"_5":14874,"_28405":51885,"_3078":51992},[],"One Gateway with multiple routes",{"_3626":329,"_31224":286,"_21623":51994,"_5":14874,"_28405":51885,"_3078":51995},[],"One IP and one proxy fleet; this is the chart default",{"_3626":330,"_31224":286,"_21623":51997,"_5":14874,"_28405":51885,"_3078":51998},[],"Independent Gateways and separate external IPs",{"_3626":331,"_31224":286,"_21623":52000,"_5":14874,"_28405":51885,"_3078":52001},[],"One VIP per Gateway",{"_3626":332,"_31224":286,"_21623":52003,"_5":14874,"_28405":51885,"_3078":52004},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3626":333,"_31224":286,"_21623":52006,"_5":14874,"_28405":51885,"_3078":52007},[],"Independent Gateways on one node and one IP",{"_3626":334,"_31224":286,"_21623":52009,"_5":14874,"_28405":51885,"_3078":52010},[],"Use different external ports",{"_3626":335,"_31224":286,"_21623":52012,"_5":14874,"_28405":51885,"_3078":52013},[],"Clients must include non-standard ports",{"_3626":336,"_31224":286,"_21623":52015,"_5":14874,"_28405":51885,"_3078":52016},[],"Separate TLS/mTLS termination behind one IP",{"_3626":337,"_31224":286,"_21623":52018,"_5":14874,"_28405":51885,"_3078":52019},[],"Front-door SNI routing to internal Gateways",{"_3626":338,"_31224":286,"_21623":52021,"_5":14874,"_28405":51885,"_3078":52022},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3626":339,"_31224":286,"_21623":52024,"_5":14874,"_28405":51885,"_3078":52025},[],"Separate Gateway resources but shared proxy infrastructure",{"_3626":340,"_31224":286,"_21623":52027,"_5":14874,"_28405":51885,"_3078":52028},[],"Envoy merged-Gateway mode",{"_3626":341,"_31224":286,"_21623":52030,"_5":14874,"_28405":51885,"_3078":52031},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3626":342,"_31224":286,"_21623":52033,"_5":14874,"_28405":51885,"_3078":52034},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3626":343,"_31224":286,"_21623":52036,"_5":14874,"_28405":51885,"_3078":52037},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3626":344,"_31224":286,"_21623":52039,"_5":14874,"_28405":51885,"_3078":52040},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3626":345,"_31224":286,"_21623":52042,"_5":14874,"_28405":51885,"_3078":52043},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3626":346,"_31224":286,"_21623":52045,"_5":14874,"_28405":51889,"_3078":52046},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3626":347,"_31224":286,"_21623":52048,"_5":14874,"_28405":51893,"_3078":52049},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3626":348,"_31224":286,"_21623":52051,"_5":14874,"_28405":51893,"_3078":52052},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3626":349,"_31224":286,"_21623":52054,"_5":14874,"_28405":51893,"_3078":52055},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3626":350,"_31224":286,"_21623":52057,"_5":14874,"_28405":51893,"_3078":52058},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3626":351,"_31224":286,"_21623":52060,"_5":14874,"_28405":51893,"_3078":52061},[],"If none of those are possible, use different external ports or change the external network design.",{"_3626":352,"_31224":286,"_21623":52063,"_5":14874,"_28405":51897,"_3078":52064},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3626":353,"_31224":286,"_21623":52066,"_5":14874,"_28405":51897,"_3078":52067},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3626":354,"_31224":286,"_21623":52069,"_5":14874,"_28405":51901,"_3078":52070},[],"Check, in order:",{"_3626":355,"_31224":286,"_21623":52072,"_5":14874,"_28405":51901,"_3078":52073},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3626":356,"_31224":286,"_21623":52075,"_5":14874,"_28405":51901,"_3078":52076},[],"Its status contains the expected address.",{"_3626":357,"_31224":286,"_21623":52078,"_5":14874,"_28405":51901,"_3078":52079},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3626":358,"_31224":286,"_21623":52081,"_5":14874,"_28405":51901,"_3078":52082},[],"Port 443 reaches that address from the client network.",{"_3626":359,"_31224":286,"_21623":52084,"_5":14874,"_28405":51901,"_3078":52085},[],"DNS resolves to the externally reachable endpoint.",{"_3626":360,"_31224":286,"_21623":52087,"_5":14874,"_28405":51901,"_3078":52088},[],"The certificate contains the DNS name or IP used by the client.",{"_3626":361,"_31224":286,"_21623":52090,"_5":14874,"_28405":51901,"_3078":52091},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3626":362,"_31224":362,"_5":15239,"_3078":51118,"_31582":52093,"_21623":52094,"_28405":362},[51011,51012,51118],[],{"_3626":363,"_31224":362,"_21623":52096,"_5":14874,"_28405":362,"_3078":52097},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3626":364,"_31224":362,"_5":31579,"_21623":52099,"_28405":52100,"_3078":52101},[],"/docs/pr-preview/pr-76/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3626":365,"_31224":362,"_5":31579,"_21623":52103,"_28405":52104,"_3078":52105},[],"/docs/pr-preview/pr-76/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3626":366,"_31224":362,"_5":31579,"_21623":52107,"_28405":52108,"_3078":52109},[],"/docs/pr-preview/pr-76/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3626":367,"_31224":362,"_5":31579,"_21623":52111,"_28405":52112,"_3078":52113},[],"/docs/pr-preview/pr-76/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3626":368,"_31224":362,"_5":31579,"_21623":52115,"_28405":52116,"_3078":52117},[],"/docs/pr-preview/pr-76/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3626":369,"_31224":362,"_5":31579,"_21623":52119,"_28405":52120,"_3078":52121},[],"/docs/pr-preview/pr-76/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3626":370,"_31224":362,"_21623":52123,"_5":14874,"_28405":52100,"_3078":52124},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3626":371,"_31224":362,"_21623":52126,"_5":14874,"_28405":52104,"_3078":52127},[],"Workflow",{"_3626":372,"_31224":362,"_21623":52129,"_5":14874,"_28405":52104,"_3078":52130},[],"Use it for",{"_3626":373,"_31224":362,"_21623":52132,"_5":14874,"_28405":52104,"_3078":52133},[],"What it installs",{"_3626":374,"_31224":362,"_21623":52135,"_5":14874,"_28405":52104,"_3078":52136},[],"Helm",{"_3626":375,"_31224":362,"_21623":52138,"_5":14874,"_28405":52104,"_3078":52139},[],"Production and controlled environments",{"_3626":376,"_31224":362,"_21623":52141,"_5":14874,"_28405":52104,"_3078":52142},[],"Lamassu services and Gateway API resources",{"_3626":377,"_31224":362,"_21623":52144,"_5":14874,"_28405":52104,"_3078":51255},[],{"_3626":378,"_31224":362,"_21623":52146,"_5":14874,"_28405":52104,"_3078":52147},[],"Evaluation, demos, CI and small lab clusters",{"_3626":379,"_31224":362,"_21623":52149,"_5":14874,"_28405":52104,"_3078":52150},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3626":380,"_31224":362,"_21623":52152,"_5":14874,"_28405":52108,"_3078":52153},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3626":381,"_31224":362,"_21623":52155,"_5":14874,"_28405":52108,"_3078":52156},[],"Area",{"_3626":382,"_31224":362,"_21623":52158,"_5":14874,"_28405":52108,"_3078":52159},[],"The Lamassu chart provides",{"_3626":383,"_31224":362,"_21623":52161,"_5":14874,"_28405":52108,"_3078":52162},[],"You provide",{"_3626":384,"_31224":362,"_21623":52164,"_5":14874,"_28405":52108,"_3078":52165},[],"Lamassu applications",{"_3626":385,"_31224":362,"_21623":52167,"_5":14874,"_28405":52108,"_3078":52168},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3626":386,"_31224":362,"_21623":52170,"_5":14874,"_28405":52108,"_3078":52171},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3626":387,"_31224":362,"_21623":52173,"_5":14874,"_28405":52108,"_3078":52174},[],"PostgreSQL data",{"_3626":388,"_31224":362,"_21623":52176,"_5":14874,"_28405":52108,"_3078":52177},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3626":389,"_31224":362,"_21623":52179,"_5":14874,"_28405":52108,"_3078":52180},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3626":390,"_31224":362,"_21623":52182,"_5":14874,"_28405":52108,"_3078":52183},[],"Messaging",{"_3626":391,"_31224":362,"_21623":52185,"_5":14874,"_28405":52108,"_3078":52186},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3626":392,"_31224":362,"_21623":52188,"_5":14874,"_28405":52108,"_3078":52189},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3626":393,"_31224":362,"_21623":52191,"_5":14874,"_28405":52108,"_3078":52192},[],"Identity",{"_3626":394,"_31224":362,"_21623":52194,"_5":14874,"_28405":52108,"_3078":52195},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3626":395,"_31224":362,"_21623":52197,"_5":14874,"_28405":52108,"_3078":52198},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3626":396,"_31224":362,"_21623":52200,"_5":14874,"_28405":52108,"_3078":52201},[],"External routing",{"_3626":397,"_31224":362,"_21623":52203,"_5":14874,"_28405":52108,"_3078":52204},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3626":398,"_31224":362,"_21623":52206,"_5":14874,"_28405":52108,"_3078":52207},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3626":399,"_31224":362,"_21623":52209,"_5":14874,"_28405":52108,"_3078":52210},[],"TLS",{"_3626":400,"_31224":362,"_21623":52212,"_5":14874,"_28405":52108,"_3078":52213},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3626":401,"_31224":362,"_21623":52215,"_5":14874,"_28405":52108,"_3078":52216},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3626":402,"_31224":362,"_21623":52218,"_5":14874,"_28405":52108,"_3078":52219},[],"Persistent application data",{"_3626":403,"_31224":362,"_21623":52221,"_5":14874,"_28405":52108,"_3078":52222},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3626":404,"_31224":362,"_21623":52224,"_5":14874,"_28405":52108,"_3078":52225},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3626":405,"_31224":362,"_21623":52227,"_5":14874,"_28405":52108,"_3078":52228},[],"Optional integrations",{"_3626":406,"_31224":362,"_21623":52230,"_5":14874,"_28405":52108,"_3078":52231},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3626":407,"_31224":362,"_21623":52233,"_5":14874,"_28405":52108,"_3078":52234},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3626":408,"_31224":362,"_21623":52236,"_5":14874,"_28405":52108,"_3078":52237},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3626":409,"_31224":362,"_21623":52239,"_5":14874,"_28405":52108,"_3078":52240},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3626":410,"_31224":362,"_21623":52242,"_5":14874,"_28405":52112,"_3078":52243},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3626":411,"_31224":362,"_21623":52245,"_5":14874,"_28405":52112,"_3078":52246},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3626":412,"_31224":362,"_21623":52248,"_5":14874,"_28405":52116,"_3078":52249},[],"Kubernetes 1.24 or newer",{"_3626":413,"_31224":362,"_21623":52251,"_5":14874,"_28405":52116,"_3078":52252},[],"Helm 3.2 or newer",{"_3626":414,"_31224":362,"_21623":52254,"_5":14874,"_28405":52116,"_3078":52255},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3626":415,"_31224":362,"_21623":52257,"_5":14874,"_28405":52116,"_3078":52258},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3626":416,"_31224":362,"_21623":52260,"_5":14874,"_28405":52116,"_3078":52261},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3626":417,"_31224":362,"_21623":52263,"_5":14874,"_28405":52116,"_3078":52264},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3626":418,"_31224":362,"_21623":52266,"_5":14874,"_28405":52116,"_3078":52267},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3626":419,"_31224":362,"_21623":52269,"_5":14874,"_28405":52120,"_3078":52270},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3626":420,"_31224":362,"_21623":52272,"_5":14874,"_28405":52120,"_3078":52273},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3626":421,"_31224":362,"_21623":52275,"_5":14874,"_28405":52120,"_3078":52276},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3626":422,"_31224":362,"_21623":52278,"_5":14874,"_28405":52120,"_3078":52279},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3626":423,"_31224":423,"_5":15239,"_3078":52281,"_31582":52282,"_21623":52284,"_28405":423},"Deployment troubleshooting",[51011,51012,52283],"Operations",[],{"_3626":424,"_31224":423,"_21623":52286,"_5":14874,"_28405":423,"_3078":52287},[],"Diagnose access, service health and infrastructure dependencies.",{"_3626":425,"_31224":423,"_5":31579,"_21623":52289,"_28405":52290,"_3078":52291},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3626":426,"_31224":423,"_5":31579,"_21623":52293,"_28405":52294,"_3078":52295},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3626":427,"_31224":423,"_5":31579,"_21623":52297,"_28405":52298,"_3078":52299},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3626":428,"_31224":423,"_5":31579,"_21623":52301,"_28405":52302,"_3078":52303},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3626":429,"_31224":423,"_5":31579,"_21623":52305,"_28405":52306,"_3078":52307},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3626":430,"_31224":423,"_5":31579,"_21623":52309,"_28405":52310,"_3078":52311},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3626":431,"_31224":423,"_5":31579,"_21623":52313,"_28405":52314,"_3078":52315},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3626":432,"_31224":423,"_5":31579,"_21623":52317,"_28405":52318,"_3078":52319},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3626":433,"_31224":423,"_5":31579,"_21623":52321,"_28405":52322,"_3078":52323},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3626":434,"_31224":423,"_5":31579,"_21623":52325,"_28405":52326,"_3078":52327},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3626":435,"_31224":423,"_5":31579,"_21623":52329,"_28405":52330,"_3078":52331},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3626":436,"_31224":423,"_5":31579,"_21623":52333,"_28405":52334,"_3078":52335},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3626":437,"_31224":423,"_5":31579,"_21623":52337,"_28405":52338,"_3078":52339},[],"/docs/pr-preview/pr-76/deployment/troubleshooting#observability","Observability",{"_3626":438,"_31224":423,"_21623":52341,"_5":14874,"_28405":423,"_3078":52342},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3626":439,"_31224":423,"_21623":52344,"_5":14874,"_28405":52294,"_3078":52345},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3626":440,"_31224":423,"_21623":52347,"_5":14874,"_28405":52298,"_3078":52348},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3626":441,"_31224":423,"_21623":52350,"_5":14874,"_28405":52302,"_3078":52351},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3626":442,"_31224":423,"_21623":52353,"_5":14874,"_28405":52306,"_3078":52354},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3626":443,"_31224":423,"_21623":52356,"_5":14874,"_28405":52310,"_3078":52357},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3626":444,"_31224":423,"_21623":52359,"_5":14874,"_28405":52314,"_3078":52360},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3626":445,"_31224":423,"_21623":52362,"_5":14874,"_28405":52314,"_3078":52363},[],"Also run the chart's connectivity test:",{"_3626":446,"_31224":423,"_21623":52365,"_5":14874,"_28405":52314,"_3078":52366},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3626":447,"_31224":423,"_21623":52368,"_5":14874,"_28405":52314,"_3078":52369},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3626":448,"_31224":423,"_21623":52371,"_5":14874,"_28405":52318,"_3078":52372},[],"If you receive a 401:",{"_3626":449,"_31224":423,"_21623":52374,"_5":14874,"_28405":52318,"_3078":52375},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3626":450,"_31224":423,"_21623":52377,"_5":14874,"_28405":52318,"_3078":52378},[],"verify issuer, audience and expiration of the token;",{"_3626":451,"_31224":423,"_21623":52380,"_5":14874,"_28405":52318,"_3078":52381},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3626":452,"_31224":423,"_21623":52383,"_5":14874,"_28405":52318,"_3078":52384},[],"check that the provider's public and internal routes point to the same realm.",{"_3626":453,"_31224":423,"_21623":52386,"_5":14874,"_28405":52318,"_3078":52387},[],"If login succeeds but the APIs return 403:",{"_3626":454,"_31224":423,"_21623":52389,"_5":14874,"_28405":52318,"_3078":52390},[],"inspect the token's real claims;",{"_3626":455,"_31224":423,"_21623":52392,"_5":14874,"_28405":52318,"_3078":52393},[],"confirm they match an active principal;",{"_3626":456,"_31224":423,"_21623":52395,"_5":14874,"_28405":52318,"_3078":52396},[],"review the policies granted to that principal;",{"_3626":457,"_31224":423,"_21623":52398,"_5":14874,"_28405":52318,"_3078":52399},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3626":458,"_31224":423,"_21623":52401,"_5":14874,"_28405":52318,"_3078":52402},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3626":459,"_31224":423,"_21623":52404,"_5":14874,"_28405":52322,"_3078":52405},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3626":460,"_31224":423,"_21623":52407,"_5":14874,"_28405":52322,"_3078":52408},[],"Locate the authz pod and Service.",{"_3626":461,"_31224":423,"_21623":52410,"_5":14874,"_28405":52322,"_3078":52411},[],"Check /health, logs and its database connection.",{"_3626":462,"_31224":423,"_21623":52413,"_5":14874,"_28405":52322,"_3078":52414},[],"Verify the DNS and port configured in externalAuthorization.",{"_3626":463,"_31224":423,"_21623":52416,"_5":14874,"_28405":52322,"_3078":52417},[],"Check the check route is /v1/ext\\_authz/check.",{"_3626":464,"_31224":423,"_21623":52419,"_5":14874,"_28405":52322,"_3078":52420},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3626":465,"_31224":423,"_21623":52422,"_5":14874,"_28405":52326,"_3078":52423},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3626":466,"_31224":423,"_21623":52425,"_5":14874,"_28405":52330,"_3078":52426},[],"Review kubectl describe pod first. Common causes are:",{"_3626":467,"_31224":423,"_21623":52428,"_5":14874,"_28405":52330,"_3078":52429},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3626":468,"_31224":423,"_21623":52431,"_5":14874,"_28405":52330,"_3078":52432},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3626":469,"_31224":423,"_21623":52434,"_5":14874,"_28405":52330,"_3078":52435},[],"unbound persistent volume;",{"_3626":470,"_31224":423,"_21623":52437,"_5":14874,"_28405":52330,"_3078":52438},[],"inaccessible image or incorrect pull policy;",{"_3626":471,"_31224":423,"_21623":52440,"_5":14874,"_28405":52330,"_3078":52441},[],"invalid cryptographic engine configuration;",{"_3626":472,"_31224":423,"_21623":52443,"_5":14874,"_28405":52330,"_3078":52444},[],"CPU or memory limits set too low;",{"_3626":473,"_31224":423,"_21623":52446,"_5":14874,"_28405":52330,"_3078":52447},[],"an incomplete prior migration.",{"_3626":474,"_31224":423,"_21623":52449,"_5":14874,"_28405":52330,"_3078":52450},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3626":475,"_31224":423,"_21623":52452,"_5":14874,"_28405":52330,"_3078":52453},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3626":476,"_31224":423,"_21623":52455,"_5":14874,"_28405":52330,"_3078":52456},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3626":477,"_31224":423,"_21623":52458,"_5":14874,"_28405":52334,"_3078":52459},[],"Domain and audit events depend on the bus publisher:",{"_3626":478,"_31224":423,"_21623":52461,"_5":14874,"_28405":52334,"_3078":52462},[],"verify it is enabled in the emitting service;",{"_3626":479,"_31224":423,"_21623":52464,"_5":14874,"_28405":52334,"_3078":52465},[],"check AMQP connectivity and credentials;",{"_3626":480,"_31224":423,"_21623":52467,"_5":14874,"_28405":52334,"_3078":52468},[],"review exchange, routing key, queues and consumers;",{"_3626":481,"_31224":423,"_21623":52470,"_5":14874,"_28405":52334,"_3078":52471},[],"inspect dead-letter queues;",{"_3626":482,"_31224":423,"_21623":52473,"_5":14874,"_28405":52334,"_3078":52474},[],"alert on orphan durable queues and backlog growth.",{"_3626":483,"_31224":423,"_21623":52476,"_5":14874,"_28405":52334,"_3078":52477},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3626":484,"_31224":423,"_21623":52479,"_5":14874,"_28405":52334,"_3078":52480},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3626":485,"_31224":423,"_21623":52482,"_5":14874,"_28405":52334,"_3078":52483},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3626":486,"_31224":423,"_21623":52485,"_5":14874,"_28405":52334,"_3078":52486},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3626":487,"_31224":423,"_21623":52488,"_5":14874,"_28405":52334,"_3078":52489},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3626":488,"_31224":423,"_21623":52491,"_5":14874,"_28405":52334,"_3078":52492},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3626":489,"_31224":423,"_21623":52494,"_5":14874,"_28405":52334,"_3078":52495},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3626":490,"_31224":423,"_21623":52497,"_5":14874,"_28405":52338,"_3078":52498},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3626":491,"_31224":423,"_21623":52500,"_5":14874,"_28405":52338,"_3078":52501},[],"Before closing an incident, record:",{"_3626":492,"_31224":423,"_21623":52503,"_5":14874,"_28405":52338,"_3078":52504},[],"the confirmed cause;",{"_3626":493,"_31224":423,"_21623":52506,"_5":14874,"_28405":52338,"_3078":52507},[],"the time scope and affected resources;",{"_3626":494,"_31224":423,"_21623":52509,"_5":14874,"_28405":52338,"_3078":52510},[],"the commands or queries used;",{"_3626":495,"_31224":423,"_21623":52512,"_5":14874,"_28405":52338,"_3078":52513},[],"the applied change and how to revert it;",{"_3626":496,"_31224":423,"_21623":52515,"_5":14874,"_28405":52338,"_3078":52516},[],"validation from a consumer;",{"_3626":497,"_31224":423,"_21623":52518,"_5":14874,"_28405":52338,"_3078":52519},[],"the preventive action and its owner.",{"_3626":498,"_31224":498,"_5":15239,"_3078":52521,"_31582":52522,"_21623":52526,"_28405":498},"Data model",[51011,52523,52524,52525],"Platform","Administration","Access control",[],{"_3626":499,"_31224":498,"_21623":52528,"_5":14874,"_28405":498,"_3078":52529},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3626":500,"_31224":498,"_5":31579,"_21623":52531,"_28405":52532,"_3078":52533},[],"/docs/pr-preview/pr-76/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3626":501,"_31224":498,"_5":31579,"_21623":52535,"_28405":52536,"_3078":52537},[],"/docs/pr-preview/pr-76/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3626":502,"_31224":498,"_21623":52539,"_5":14874,"_28405":498,"_3078":52540},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3626":503,"_31224":498,"_21623":52542,"_5":14874,"_28405":52532,"_3078":52543},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3626":504,"_31224":498,"_21623":52545,"_5":14874,"_28405":52532,"_3078":52546},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3626":505,"_31224":498,"_21623":52548,"_5":14874,"_28405":52532,"_3078":52549},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3626":506,"_31224":498,"_21623":52551,"_5":14874,"_28405":52536,"_3078":52552},[],"Entity (`schema_name.entity_type`)",{"_3626":507,"_31224":498,"_21623":52554,"_5":14874,"_28405":52536,"_3078":52555},[],"Table (`table_name`)",{"_3626":508,"_31224":498,"_21623":52557,"_5":14874,"_28405":52536,"_3078":52558},[],"Key (`primary_key`)",{"_3626":509,"_31224":498,"_21623":52560,"_5":14874,"_28405":52536,"_3078":52561},[],"`alerts.event`",{"_3626":510,"_31224":498,"_21623":52563,"_5":14874,"_28405":52536,"_3078":52564},[],"`events`",{"_3626":511,"_31224":498,"_21623":52566,"_5":14874,"_28405":52536,"_3078":52567},[],"`event_type`",{"_3626":512,"_31224":498,"_21623":52569,"_5":14874,"_28405":52536,"_3078":52570},[],"`alerts.subscription`",{"_3626":513,"_31224":498,"_21623":52572,"_5":14874,"_28405":52536,"_3078":52573},[],"`subscriptions`",{"_3626":514,"_31224":498,"_21623":52575,"_5":14874,"_28405":52536,"_3078":52576},[],"`id`",{"_3626":515,"_31224":498,"_21623":52578,"_5":14874,"_28405":52536,"_3078":52579},[],"`ca.ca_certificate`",{"_3626":516,"_31224":498,"_21623":52581,"_5":14874,"_28405":52536,"_3078":52582},[],"`ca_certificates`",{"_3626":517,"_31224":498,"_21623":52584,"_5":14874,"_28405":52536,"_3078":52576},[],{"_3626":518,"_31224":498,"_21623":52586,"_5":14874,"_28405":52536,"_3078":52587},[],"`ca.certificate`",{"_3626":519,"_31224":498,"_21623":52589,"_5":14874,"_28405":52536,"_3078":52590},[],"`certificates`",{"_3626":520,"_31224":498,"_21623":52592,"_5":14874,"_28405":52536,"_3078":52593},[],"`serial_number`",{"_3626":521,"_31224":498,"_21623":52595,"_5":14874,"_28405":52536,"_3078":52596},[],"`ca.issuance_profile`",{"_3626":522,"_31224":498,"_21623":52598,"_5":14874,"_28405":52536,"_3078":52599},[],"`issuance_profiles`",{"_3626":523,"_31224":498,"_21623":52601,"_5":14874,"_28405":52536,"_3078":52576},[],{"_3626":524,"_31224":498,"_21623":52603,"_5":14874,"_28405":52536,"_3078":52604},[],"`devicemanager.device_group`",{"_3626":525,"_31224":498,"_21623":52606,"_5":14874,"_28405":52536,"_3078":52607},[],"`device_groups`",{"_3626":526,"_31224":498,"_21623":52609,"_5":14874,"_28405":52536,"_3078":52576},[],{"_3626":527,"_31224":498,"_21623":52611,"_5":14874,"_28405":52536,"_3078":52612},[],"`devicemanager.device`",{"_3626":528,"_31224":498,"_21623":52614,"_5":14874,"_28405":52536,"_3078":52615},[],"`devices`",{"_3626":529,"_31224":498,"_21623":52617,"_5":14874,"_28405":52536,"_3078":52576},[],{"_3626":530,"_31224":498,"_21623":52619,"_5":14874,"_28405":52536,"_3078":52620},[],"`dmsmanager.dms`",{"_3626":531,"_31224":498,"_21623":52622,"_5":14874,"_28405":52536,"_3078":52623},[],"`dms`",{"_3626":532,"_31224":498,"_21623":52625,"_5":14874,"_28405":52536,"_3078":52576},[],{"_3626":533,"_31224":498,"_21623":52627,"_5":14874,"_28405":52536,"_3078":52628},[],"`kms.kms_key`",{"_3626":534,"_31224":498,"_21623":52630,"_5":14874,"_28405":52536,"_3078":52631},[],"`kms_keys`",{"_3626":535,"_31224":498,"_21623":52633,"_5":14874,"_28405":52536,"_3078":52634},[],"`key_id`, `engine_id`",{"_3626":536,"_31224":498,"_21623":52636,"_5":14874,"_28405":52536,"_3078":52637},[],"`va.crl_settings`",{"_3626":537,"_31224":498,"_21623":52639,"_5":14874,"_28405":52536,"_3078":52640},[],"`crl_settings`",{"_3626":538,"_31224":498,"_21623":52642,"_5":14874,"_28405":52536,"_3078":52643},[],"`ca_id`",{"_3626":539,"_31224":498,"_21623":52645,"_5":14874,"_28405":52536,"_3078":52646},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3626":540,"_31224":498,"_21623":52648,"_5":14874,"_28405":52536,"_3078":52649},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3626":541,"_31224":498,"_21623":52651,"_5":14874,"_28405":52536,"_3078":52652},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3626":542,"_31224":542,"_5":15239,"_3078":52654,"_31582":52655,"_21623":52656,"_28405":542},"Access control overview",[51011,52523,52524,52525],[],{"_3626":543,"_31224":542,"_21623":52658,"_5":14874,"_28405":542,"_3078":52659},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3626":544,"_31224":542,"_5":31579,"_21623":52661,"_28405":52662,"_3078":52663},[],"/docs/pr-preview/pr-76/platform/administration/access-control#essential-concepts","Essential concepts",{"_3626":545,"_31224":542,"_5":31579,"_21623":52665,"_28405":52666,"_3078":52667},[],"/docs/pr-preview/pr-76/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3626":546,"_31224":542,"_5":31579,"_21623":52669,"_28405":52670,"_3078":52671},[],"/docs/pr-preview/pr-76/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3626":547,"_31224":542,"_5":31579,"_21623":52673,"_28405":52674,"_3078":52675},[],"/docs/pr-preview/pr-76/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3626":548,"_31224":542,"_5":31579,"_21623":52677,"_28405":52678,"_3078":52679},[],"/docs/pr-preview/pr-76/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3626":549,"_31224":542,"_5":31579,"_21623":52681,"_28405":52682,"_3078":52683},[],"/docs/pr-preview/pr-76/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3626":550,"_31224":542,"_5":31579,"_21623":52685,"_28405":52686,"_3078":52687},[],"/docs/pr-preview/pr-76/platform/administration/access-control#oidc-principals","OIDC principals",{"_3626":551,"_31224":542,"_5":31579,"_21623":52689,"_28405":52690,"_3078":52691},[],"/docs/pr-preview/pr-76/platform/administration/access-control#x509-principals","X.509 principals",{"_3626":552,"_31224":542,"_5":31579,"_21623":52693,"_28405":52694,"_3078":52695},[],"/docs/pr-preview/pr-76/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3626":553,"_31224":542,"_5":31579,"_21623":52697,"_28405":52698,"_3078":52699},[],"/docs/pr-preview/pr-76/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3626":554,"_31224":542,"_5":31579,"_21623":52701,"_28405":52702,"_3078":52703},[],"/docs/pr-preview/pr-76/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3626":555,"_31224":542,"_5":31579,"_21623":52705,"_28405":52706,"_3078":52707},[],"/docs/pr-preview/pr-76/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3626":556,"_31224":542,"_5":31579,"_21623":52709,"_28405":52710,"_3078":52711},[],"/docs/pr-preview/pr-76/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3626":557,"_31224":542,"_5":31579,"_21623":52713,"_28405":52714,"_3078":52715},[],"/docs/pr-preview/pr-76/platform/administration/access-control#http-rules","HTTP rules",{"_3626":558,"_31224":542,"_5":31579,"_21623":52717,"_28405":52718,"_3078":52719},[],"/docs/pr-preview/pr-76/platform/administration/access-control#included-policies","Included policies",{"_3626":559,"_31224":542,"_5":31579,"_21623":52721,"_28405":52722,"_3078":51661},[],"/docs/pr-preview/pr-76/platform/administration/access-control#provision-the-first-administrator",{"_3626":560,"_31224":542,"_5":31579,"_21623":52724,"_28405":52725,"_3078":52726},[],"/docs/pr-preview/pr-76/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3626":561,"_31224":542,"_5":31579,"_21623":52728,"_28405":52729,"_3078":52730},[],"/docs/pr-preview/pr-76/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3626":562,"_31224":542,"_5":31579,"_21623":52732,"_28405":52733,"_3078":52734},[],"/docs/pr-preview/pr-76/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3626":563,"_31224":542,"_5":31579,"_21623":52736,"_28405":52737,"_3078":52738},[],"/docs/pr-preview/pr-76/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3626":564,"_31224":542,"_5":31579,"_21623":52740,"_28405":52741,"_3078":52742},[],"/docs/pr-preview/pr-76/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3626":565,"_31224":542,"_5":31579,"_21623":52744,"_28405":52745,"_3078":52746},[],"/docs/pr-preview/pr-76/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3626":566,"_31224":542,"_5":31579,"_21623":52748,"_28405":52749,"_3078":52750},[],"/docs/pr-preview/pr-76/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3626":567,"_31224":542,"_5":31579,"_21623":52752,"_28405":52753,"_3078":52754},[],"/docs/pr-preview/pr-76/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3626":568,"_31224":542,"_5":31579,"_21623":52756,"_28405":52757,"_3078":52758},[],"/docs/pr-preview/pr-76/platform/administration/access-control#operational-checklist","Operational checklist",{"_3626":569,"_31224":542,"_5":31579,"_21623":52760,"_28405":52761,"_3078":52762},[],"/docs/pr-preview/pr-76/platform/administration/access-control#diagnostics","Diagnostics",{"_3626":570,"_31224":542,"_5":31579,"_21623":52764,"_28405":52765,"_3078":52766},[],"/docs/pr-preview/pr-76/platform/administration/access-control#the-response-is-401","The response is 401",{"_3626":571,"_31224":542,"_5":31579,"_21623":52768,"_28405":52769,"_3078":52770},[],"/docs/pr-preview/pr-76/platform/administration/access-control#the-response-is-403","The response is 403",{"_3626":572,"_31224":542,"_5":31579,"_21623":52772,"_28405":52773,"_3078":52774},[],"/docs/pr-preview/pr-76/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3626":573,"_31224":542,"_5":31579,"_21623":52776,"_28405":52777,"_3078":52778},[],"/docs/pr-preview/pr-76/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3626":574,"_31224":542,"_5":31579,"_21623":52780,"_28405":52781,"_3078":52782},[],"/docs/pr-preview/pr-76/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3626":575,"_31224":542,"_21623":52784,"_5":14874,"_28405":542,"_3078":52785},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3626":576,"_31224":542,"_21623":52787,"_5":14874,"_28405":542,"_3078":52788},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3626":577,"_31224":542,"_21623":52790,"_5":14874,"_28405":542,"_3078":52791},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3626":578,"_31224":542,"_21623":52793,"_5":14874,"_28405":52662,"_3078":52794},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3626":579,"_31224":542,"_21623":52796,"_5":14874,"_28405":52662,"_3078":52797},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3626":580,"_31224":542,"_21623":52799,"_5":14874,"_28405":52662,"_3078":52800},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3626":581,"_31224":542,"_21623":52802,"_5":14874,"_28405":52662,"_3078":52803},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3626":582,"_31224":542,"_21623":52805,"_5":14874,"_28405":52662,"_3078":52806},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3626":583,"_31224":542,"_21623":52808,"_5":14874,"_28405":52662,"_3078":52809},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3626":584,"_31224":542,"_21623":52811,"_5":14874,"_28405":52666,"_3078":52812},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3626":585,"_31224":542,"_21623":52814,"_5":14874,"_28405":52666,"_3078":52815},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3626":586,"_31224":542,"_21623":52817,"_5":14874,"_28405":52670,"_3078":52818},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3626":587,"_31224":542,"_21623":52820,"_5":14874,"_28405":52670,"_3078":52821},[],"The decision is made **before forwarding the request to the service**:",{"_3626":588,"_31224":542,"_21623":52823,"_5":14874,"_28405":52670,"_3078":52824},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3626":589,"_31224":542,"_21623":52826,"_5":14874,"_28405":52670,"_3078":52827},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3626":590,"_31224":542,"_21623":52829,"_5":14874,"_28405":52670,"_3078":52830},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3626":591,"_31224":542,"_21623":52832,"_5":14874,"_28405":52670,"_3078":52833},[],"It separately loads the policies granted to each principal.",{"_3626":592,"_31224":542,"_21623":52835,"_5":14874,"_28405":52670,"_3078":52836},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3626":593,"_31224":542,"_21623":52838,"_5":14874,"_28405":52670,"_3078":52839},[],"`authz` looks for an HTTP rule granting that action.",{"_3626":594,"_31224":542,"_21623":52841,"_5":14874,"_28405":52670,"_3078":52842},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3626":595,"_31224":542,"_21623":52844,"_5":14874,"_28405":52670,"_3078":52845},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3626":596,"_31224":542,"_21623":52847,"_5":14874,"_28405":52670,"_3078":52848},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3626":597,"_31224":542,"_21623":52850,"_5":14874,"_28405":52670,"_3078":52851},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3626":598,"_31224":542,"_21623":52853,"_5":14874,"_28405":52674,"_3078":52854},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3626":599,"_31224":542,"_21623":52856,"_5":14874,"_28405":52674,"_3078":52857},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3626":600,"_31224":542,"_21623":52859,"_5":14874,"_28405":52674,"_3078":52860},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3626":601,"_31224":542,"_21623":52862,"_5":14874,"_28405":52674,"_3078":52863},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3626":602,"_31224":542,"_21623":52865,"_5":14874,"_28405":52674,"_3078":52866},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3626":603,"_31224":542,"_21623":52868,"_5":14874,"_28405":52674,"_3078":52869},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3626":604,"_31224":542,"_21623":52871,"_5":14874,"_28405":52674,"_3078":52872},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3626":605,"_31224":542,"_21623":52874,"_5":14874,"_28405":52674,"_3078":52875},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3626":606,"_31224":542,"_21623":52877,"_5":14874,"_28405":52674,"_3078":52878},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3626":607,"_31224":542,"_21623":52880,"_5":14874,"_28405":52674,"_3078":52881},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3626":608,"_31224":542,"_21623":52883,"_5":14874,"_28405":52678,"_3078":52884},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3626":609,"_31224":542,"_21623":52886,"_5":14874,"_28405":52678,"_3078":52887},[],"The decision is made with the domain operation context:",{"_3626":610,"_31224":542,"_21623":52889,"_5":14874,"_28405":52678,"_3078":52890},[],"The middleware extracts the credential and resolves the matching principals.",{"_3626":611,"_31224":542,"_21623":52892,"_5":14874,"_28405":52678,"_3078":52893},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3626":612,"_31224":542,"_21623":52895,"_5":14874,"_28405":52678,"_3078":52896},[],"`authz` gathers the entity rules of the granted policies.",{"_3626":613,"_31224":542,"_21623":52898,"_5":14874,"_28405":52678,"_3078":52899},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3626":614,"_31224":542,"_21623":52901,"_5":14874,"_28405":52678,"_3078":52902},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3626":615,"_31224":542,"_21623":52904,"_5":14874,"_28405":52678,"_3078":52905},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3626":616,"_31224":542,"_21623":52907,"_5":14874,"_28405":52678,"_3078":52908},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3626":617,"_31224":542,"_21623":52910,"_5":14874,"_28405":52678,"_3078":52911},[],"Actions fall into two groups:",{"_3626":618,"_31224":542,"_21623":52913,"_5":14874,"_28405":52678,"_3078":52914},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3626":619,"_31224":542,"_21623":52916,"_5":14874,"_28405":52678,"_3078":52917},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3626":620,"_31224":542,"_21623":52919,"_5":14874,"_28405":52678,"_3078":52920},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3626":621,"_31224":542,"_21623":52922,"_5":14874,"_28405":52682,"_3078":52923},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3626":622,"_31224":542,"_21623":52925,"_5":14874,"_28405":52682,"_3078":52926},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3626":623,"_31224":542,"_21623":52928,"_5":14874,"_28405":52682,"_3078":52929},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3626":624,"_31224":542,"_21623":52931,"_5":14874,"_28405":52686,"_3078":52932},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3626":625,"_31224":542,"_21623":52934,"_5":14874,"_28405":52686,"_3078":52935},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3626":626,"_31224":542,"_21623":52937,"_5":14874,"_28405":52686,"_3078":52938},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3626":627,"_31224":542,"_21623":52940,"_5":14874,"_28405":52686,"_3078":52941},[],"The implemented operators are:",{"_3626":628,"_31224":542,"_21623":52943,"_5":14874,"_28405":52686,"_3078":52944},[],"`equals`, for exact equality;",{"_3626":629,"_31224":542,"_21623":52946,"_5":14874,"_28405":52686,"_3078":52947},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3626":630,"_31224":542,"_21623":52949,"_5":14874,"_28405":52686,"_3078":52950},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3626":631,"_31224":542,"_21623":52952,"_5":14874,"_28405":52686,"_3078":52953},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3626":632,"_31224":542,"_21623":52955,"_5":14874,"_28405":52690,"_3078":52956},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3626":633,"_31224":542,"_21623":52958,"_5":14874,"_28405":52690,"_3078":52959},[],"The available modes are:",{"_3626":634,"_31224":542,"_21623":52961,"_5":14874,"_28405":52690,"_3078":52962},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3626":635,"_31224":542,"_21623":52964,"_5":14874,"_28405":52690,"_3078":52965},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3626":636,"_31224":542,"_21623":52967,"_5":14874,"_28405":52690,"_3078":52968},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3626":637,"_31224":542,"_21623":52970,"_5":14874,"_28405":52690,"_3078":52971},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3626":638,"_31224":542,"_21623":52973,"_5":14874,"_28405":52690,"_3078":52974},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3626":639,"_31224":542,"_21623":52976,"_5":14874,"_28405":52690,"_3078":52977},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3626":640,"_31224":542,"_21623":52979,"_5":14874,"_28405":52694,"_3078":52980},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3626":641,"_31224":542,"_21623":52982,"_5":14874,"_28405":52694,"_3078":52983},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3626":642,"_31224":542,"_21623":52985,"_5":14874,"_28405":52694,"_3078":52986},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3626":643,"_31224":542,"_21623":52988,"_5":14874,"_28405":52694,"_3078":52989},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3626":644,"_31224":542,"_21623":52991,"_5":14874,"_28405":52702,"_3078":52992},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3626":645,"_31224":542,"_21623":52994,"_5":14874,"_28405":52702,"_3078":52995},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3626":646,"_31224":542,"_21623":52997,"_5":14874,"_28405":52706,"_3078":52998},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3626":647,"_31224":542,"_21623":53000,"_5":14874,"_28405":52706,"_3078":53001},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3626":648,"_31224":542,"_21623":53003,"_5":14874,"_28405":52706,"_3078":53004},[],"The data model shows how the resources used in entity rules are connected.",{"_3626":649,"_31224":542,"_21623":53006,"_5":14874,"_28405":52706,"_3078":53007},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3626":650,"_31224":542,"_21623":53009,"_5":14874,"_28405":52706,"_3078":53010},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3626":651,"_31224":542,"_21623":53012,"_5":14874,"_28405":52710,"_3078":53013},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3626":652,"_31224":542,"_21623":53015,"_5":14874,"_28405":52710,"_3078":53016},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3626":653,"_31224":542,"_21623":53018,"_5":14874,"_28405":52710,"_3078":53019},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3626":654,"_31224":542,"_21623":53021,"_5":14874,"_28405":52714,"_3078":53022},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3626":655,"_31224":542,"_21623":53024,"_5":14874,"_28405":52714,"_3078":53025},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3626":656,"_31224":542,"_21623":53027,"_5":14874,"_28405":52714,"_3078":53028},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3626":657,"_31224":542,"_21623":53030,"_5":14874,"_28405":52714,"_3078":53031},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3626":658,"_31224":542,"_21623":53033,"_5":14874,"_28405":52714,"_3078":53034},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3626":659,"_31224":542,"_21623":53036,"_5":14874,"_28405":52714,"_3078":53037},[],"Note that:",{"_3626":660,"_31224":542,"_21623":53039,"_5":14874,"_28405":52714,"_3078":53040},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3626":661,"_31224":542,"_21623":53042,"_5":14874,"_28405":52714,"_3078":53043},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3626":662,"_31224":542,"_21623":53045,"_5":14874,"_28405":52714,"_3078":53046},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3626":663,"_31224":542,"_21623":53048,"_5":14874,"_28405":52718,"_3078":53049},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3626":664,"_31224":542,"_21623":53051,"_5":14874,"_28405":52718,"_3078":53052},[],"full and read-only access to certificates and authorities;",{"_3626":665,"_31224":542,"_21623":53054,"_5":14874,"_28405":52718,"_3078":53055},[],"full and read-only access to the KMS;",{"_3626":666,"_31224":542,"_21623":53057,"_5":14874,"_28405":52718,"_3078":53058},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3626":667,"_31224":542,"_21623":53060,"_5":14874,"_28405":52718,"_3078":53061},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3626":668,"_31224":542,"_21623":53063,"_5":14874,"_28405":52718,"_3078":53064},[],"console access;",{"_3626":669,"_31224":542,"_21623":53066,"_5":14874,"_28405":52718,"_3078":53067},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3626":670,"_31224":542,"_21623":53069,"_5":14874,"_28405":52718,"_3078":53070},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3626":671,"_31224":542,"_21623":53072,"_5":14874,"_28405":52718,"_3078":53073},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3626":672,"_31224":542,"_21623":53075,"_5":14874,"_28405":52718,"_3078":53076},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3626":673,"_31224":542,"_21623":53078,"_5":14874,"_28405":52718,"_3078":53079},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3626":674,"_31224":542,"_21623":53081,"_5":14874,"_28405":52722,"_3078":53082},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3626":675,"_31224":542,"_21623":53084,"_5":14874,"_28405":52722,"_3078":53085},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3626":676,"_31224":542,"_21623":53087,"_5":14874,"_28405":52722,"_3078":53088},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3626":677,"_31224":542,"_21623":53090,"_5":14874,"_28405":52725,"_3078":53091},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3626":678,"_31224":542,"_21623":53093,"_5":14874,"_28405":52729,"_3078":53094},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3626":679,"_31224":542,"_21623":53096,"_5":14874,"_28405":52729,"_3078":53097},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3626":680,"_31224":542,"_21623":53099,"_5":14874,"_28405":52733,"_3078":53100},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3626":681,"_31224":542,"_21623":53102,"_5":14874,"_28405":52737,"_3078":53103},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3626":682,"_31224":542,"_21623":53105,"_5":14874,"_28405":52741,"_3078":53106},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3626":683,"_31224":542,"_21623":53108,"_5":14874,"_28405":52745,"_3078":53109},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3626":684,"_31224":542,"_21623":53111,"_5":14874,"_28405":52745,"_3078":53112},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3626":685,"_31224":542,"_21623":53114,"_5":14874,"_28405":52749,"_3078":53115},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3626":686,"_31224":542,"_21623":53117,"_5":14874,"_28405":52749,"_3078":53118},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3626":687,"_31224":542,"_21623":53120,"_5":14874,"_28405":52749,"_3078":53121},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3626":688,"_31224":542,"_21623":53123,"_5":14874,"_28405":52749,"_3078":53124},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3626":689,"_31224":542,"_21623":53126,"_5":14874,"_28405":52749,"_3078":53127},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3626":690,"_31224":542,"_21623":53129,"_5":14874,"_28405":52749,"_3078":53130},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3626":691,"_31224":542,"_21623":53132,"_5":14874,"_28405":52749,"_3078":53133},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3626":692,"_31224":542,"_21623":53135,"_5":14874,"_28405":52749,"_3078":53136},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3626":693,"_31224":542,"_21623":53138,"_5":14874,"_28405":52753,"_3078":53139},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3626":694,"_31224":542,"_21623":53141,"_5":14874,"_28405":52753,"_3078":53142},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3626":695,"_31224":542,"_21623":53144,"_5":14874,"_28405":52753,"_3078":53145},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3626":696,"_31224":542,"_21623":53147,"_5":14874,"_28405":52757,"_3078":53148},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3626":697,"_31224":542,"_21623":53150,"_5":14874,"_28405":52757,"_3078":53151},[],"Use groups or stable roles for people and independent identities for automations.",{"_3626":698,"_31224":542,"_21623":53153,"_5":14874,"_28405":52757,"_3078":53154},[],"Keep at least two recovery administrators and test their access periodically.",{"_3626":699,"_31224":542,"_21623":53156,"_5":14874,"_28405":52757,"_3078":53157},[],"Review active principals, their matches and their grants after IdP changes.",{"_3626":700,"_31224":542,"_21623":53159,"_5":14874,"_28405":52757,"_3078":53160},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3626":701,"_31224":542,"_21623":53162,"_5":14874,"_28405":52757,"_3078":53163},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3626":702,"_31224":542,"_21623":53165,"_5":14874,"_28405":52757,"_3078":53166},[],"Always test one allowed and one denied operation for each role.",{"_3626":703,"_31224":542,"_21623":53168,"_5":14874,"_28405":52757,"_3078":53169},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3626":704,"_31224":542,"_21623":53171,"_5":14874,"_28405":52765,"_3078":53172},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3626":705,"_31224":542,"_21623":53174,"_5":14874,"_28405":52769,"_3078":53175},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3626":706,"_31224":542,"_21623":53177,"_5":14874,"_28405":52769,"_3078":53178},[],"that an active principal of the correct type exists;",{"_3626":707,"_31224":542,"_21623":53180,"_5":14874,"_28405":52769,"_3078":53181},[],"that the claim paths and values match the real token exactly;",{"_3626":708,"_31224":542,"_21623":53183,"_5":14874,"_28405":52769,"_3078":53184},[],"that all of the principal's conditions hold;",{"_3626":709,"_31224":542,"_21623":53186,"_5":14874,"_28405":52769,"_3078":53187},[],"that the principal has the expected policy granted;",{"_3626":710,"_31224":542,"_21623":53189,"_5":14874,"_28405":52769,"_3078":53190},[],"that the policy includes the action and the requested resource type or route;",{"_3626":711,"_31224":542,"_21623":53192,"_5":14874,"_28405":52769,"_3078":53193},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3626":712,"_31224":542,"_21623":53195,"_5":14874,"_28405":52769,"_3078":53196},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3626":713,"_31224":542,"_21623":53198,"_5":14874,"_28405":52769,"_3078":53199},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3626":714,"_31224":542,"_21623":53201,"_5":14874,"_28405":52773,"_3078":53202},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3626":715,"_31224":542,"_21623":53204,"_5":14874,"_28405":52777,"_3078":53205},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3626":716,"_31224":542,"_21623":53207,"_5":14874,"_28405":52781,"_3078":53208},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3626":717,"_31224":542,"_21623":53210,"_5":14874,"_28405":52781,"_3078":53211},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3626":718,"_31224":718,"_5":15239,"_3078":53213,"_31582":53214,"_21623":53215,"_28405":718},"Alerts and subscriptions",[51011,52523,52524],[],{"_3626":719,"_31224":718,"_21623":53217,"_5":14874,"_28405":718,"_3078":53218},[],"Send PKI events to people and external systems.",{"_3626":720,"_31224":718,"_5":31579,"_21623":53220,"_28405":53221,"_3078":53222},[],"/docs/pr-preview/pr-76/platform/administration/alerts#how-it-works","How it works",{"_3626":721,"_31224":718,"_5":31579,"_21623":53224,"_28405":53225,"_3078":53226},[],"/docs/pr-preview/pr-76/platform/administration/alerts#available-channels","Available channels",{"_3626":722,"_31224":718,"_5":31579,"_21623":53228,"_28405":53229,"_3078":53230},[],"/docs/pr-preview/pr-76/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3626":723,"_31224":718,"_5":31579,"_21623":53232,"_28405":53233,"_3078":53234},[],"/docs/pr-preview/pr-76/platform/administration/alerts#choose-the-event","Choose the event",{"_3626":724,"_31224":718,"_5":31579,"_21623":53236,"_28405":53237,"_3078":53238},[],"/docs/pr-preview/pr-76/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3626":725,"_31224":718,"_5":31579,"_21623":53240,"_28405":53241,"_3078":53242},[],"/docs/pr-preview/pr-76/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3626":726,"_31224":718,"_5":31579,"_21623":53244,"_28405":53245,"_3078":53246},[],"/docs/pr-preview/pr-76/platform/administration/alerts#review-and-activate","Review and activate",{"_3626":727,"_31224":718,"_5":31579,"_21623":53248,"_28405":53249,"_3078":53250},[],"/docs/pr-preview/pr-76/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3626":728,"_31224":718,"_5":31579,"_21623":53252,"_28405":53253,"_3078":53254},[],"/docs/pr-preview/pr-76/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3626":729,"_31224":718,"_5":31579,"_21623":53256,"_28405":53257,"_3078":53258},[],"/docs/pr-preview/pr-76/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3626":730,"_31224":718,"_5":31579,"_21623":53260,"_28405":53261,"_3078":53262},[],"/docs/pr-preview/pr-76/platform/administration/alerts#event-families","Event families",{"_3626":731,"_31224":718,"_21623":53264,"_5":14874,"_28405":718,"_3078":53265},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3626":732,"_31224":718,"_21623":53267,"_5":14874,"_28405":53221,"_3078":53268},[],"A service publishes a domain event.",{"_3626":733,"_31224":718,"_21623":53270,"_5":14874,"_28405":53221,"_3078":53271},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3626":734,"_31224":718,"_21623":53273,"_5":14874,"_28405":53221,"_3078":53274},[],"Each subscription's filter decides whether it should be notified.",{"_3626":735,"_31224":718,"_21623":53276,"_5":14874,"_28405":53221,"_3078":53277},[],"Lamassu delivers the event to the configured channel.",{"_3626":736,"_31224":718,"_21623":53279,"_5":14874,"_28405":53221,"_3078":53280},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3626":737,"_31224":718,"_21623":53282,"_5":14874,"_28405":53225,"_3078":53283},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3626":738,"_31224":718,"_21623":53285,"_5":14874,"_28405":53225,"_3078":53286},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3626":739,"_31224":718,"_21623":53288,"_5":14874,"_28405":53225,"_3078":53289},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3626":740,"_31224":718,"_21623":53291,"_5":14874,"_28405":53225,"_3078":53292},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3626":741,"_31224":718,"_21623":53294,"_5":14874,"_28405":53225,"_3078":53295},[],"`apikey_options` requires `header` and `key`.",{"_3626":742,"_31224":718,"_21623":53297,"_5":14874,"_28405":53225,"_3078":53298},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3626":743,"_31224":718,"_21623":53300,"_5":14874,"_28405":53225,"_3078":53301},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3626":744,"_31224":718,"_21623":53303,"_5":14874,"_28405":53225,"_3078":53304},[],"The alerts API reference documents the full `http_client` schema.",{"_3626":745,"_31224":718,"_21623":53306,"_5":14874,"_28405":53233,"_3078":53307},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3626":746,"_31224":718,"_21623":53309,"_5":14874,"_28405":53237,"_3078":53310},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3626":747,"_31224":718,"_21623":53312,"_5":14874,"_28405":53241,"_3078":53313},[],"Add a filter if you don't want to receive every instance of the event.",{"_3626":748,"_31224":718,"_21623":53315,"_5":14874,"_28405":53241,"_3078":53316},[],"**None** notifies all instances of the event.",{"_3626":749,"_31224":718,"_21623":53318,"_5":14874,"_28405":53241,"_3078":53319},[],"**JSON Path** evaluates one or more specific fields.",{"_3626":750,"_31224":718,"_21623":53321,"_5":14874,"_28405":53241,"_3078":53322},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3626":751,"_31224":718,"_21623":53324,"_5":14874,"_28405":53241,"_3078":53325},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3626":752,"_31224":718,"_21623":53327,"_5":14874,"_28405":53241,"_3078":53328},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3626":753,"_31224":718,"_21623":53330,"_5":14874,"_28405":53241,"_3078":53331},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3626":754,"_31224":718,"_21623":53333,"_5":14874,"_28405":53245,"_3078":53334},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3626":755,"_31224":718,"_21623":53336,"_5":14874,"_28405":53249,"_3078":53337},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3626":756,"_31224":718,"_21623":53339,"_5":14874,"_28405":53249,"_3078":53340},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3626":757,"_31224":718,"_21623":53342,"_5":14874,"_28405":53249,"_3078":53343},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3626":758,"_31224":718,"_21623":53345,"_5":14874,"_28405":53249,"_3078":53346},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3626":759,"_31224":718,"_21623":53348,"_5":14874,"_28405":53249,"_3078":53349},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3626":760,"_31224":718,"_21623":53351,"_5":14874,"_28405":53249,"_3078":53352},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3626":761,"_31224":718,"_21623":53354,"_5":14874,"_28405":53249,"_3078":53355},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3626":762,"_31224":718,"_21623":53357,"_5":14874,"_28405":53249,"_3078":53358},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3626":763,"_31224":718,"_21623":53360,"_5":14874,"_28405":53253,"_3078":53361},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3626":764,"_31224":718,"_21623":53363,"_5":14874,"_28405":53253,"_3078":53364},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3626":765,"_31224":718,"_21623":53366,"_5":14874,"_28405":53253,"_3078":53367},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3626":766,"_31224":718,"_21623":53369,"_5":14874,"_28405":53253,"_3078":53370},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3626":767,"_31224":718,"_21623":53372,"_5":14874,"_28405":53253,"_3078":53373},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3626":768,"_31224":718,"_21623":53375,"_5":14874,"_28405":53253,"_3078":53376},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3626":769,"_31224":718,"_21623":53378,"_5":14874,"_28405":53253,"_3078":53379},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3626":770,"_31224":718,"_21623":53381,"_5":14874,"_28405":53253,"_3078":53382},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3626":771,"_31224":718,"_21623":53384,"_5":14874,"_28405":53257,"_3078":53385},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3626":772,"_31224":718,"_21623":53387,"_5":14874,"_28405":53257,"_3078":53388},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3626":773,"_31224":718,"_21623":53390,"_5":14874,"_28405":53261,"_3078":53391},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3626":774,"_31224":718,"_21623":53393,"_5":14874,"_28405":53261,"_3078":53394},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3626":775,"_31224":718,"_21623":53396,"_5":14874,"_28405":53261,"_3078":53397},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3626":776,"_31224":718,"_21623":53399,"_5":14874,"_28405":53261,"_3078":53400},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3626":777,"_31224":718,"_21623":53402,"_5":14874,"_28405":53261,"_3078":53403},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3626":778,"_31224":718,"_21623":53405,"_5":14874,"_28405":53261,"_3078":53406},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3626":779,"_31224":718,"_21623":53408,"_5":14874,"_28405":53261,"_3078":53409},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3626":780,"_31224":718,"_21623":53411,"_5":14874,"_28405":53261,"_3078":53412},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3626":781,"_31224":718,"_21623":53414,"_5":14874,"_28405":53261,"_3078":53415},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3626":782,"_31224":718,"_21623":53417,"_5":14874,"_28405":53261,"_3078":53418},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3626":783,"_31224":783,"_5":15239,"_3078":53420,"_31582":53421,"_21623":53422,"_28405":783},"Audit logs",[51011,52523,52524],[],{"_3626":784,"_31224":783,"_21623":53424,"_5":14874,"_28405":783,"_3078":53425},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3626":785,"_31224":783,"_5":31579,"_21623":53427,"_28405":53428,"_3078":53429},[],"/docs/pr-preview/pr-76/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3626":786,"_31224":783,"_5":31579,"_21623":53431,"_28405":53432,"_3078":53433},[],"/docs/pr-preview/pr-76/platform/administration/audit-logs#coverage","Coverage",{"_3626":787,"_31224":783,"_5":31579,"_21623":53435,"_28405":53436,"_3078":53437},[],"/docs/pr-preview/pr-76/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3626":788,"_31224":783,"_5":31579,"_21623":53439,"_28405":53440,"_3078":53441},[],"/docs/pr-preview/pr-76/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3626":789,"_31224":783,"_5":31579,"_21623":53443,"_28405":53444,"_3078":53445},[],"/docs/pr-preview/pr-76/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3626":790,"_31224":783,"_5":31579,"_21623":53447,"_28405":53448,"_3078":53449},[],"/docs/pr-preview/pr-76/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3626":791,"_31224":783,"_5":31579,"_21623":53451,"_28405":53452,"_3078":53453},[],"/docs/pr-preview/pr-76/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3626":792,"_31224":783,"_5":31579,"_21623":53455,"_28405":53456,"_3078":53457},[],"/docs/pr-preview/pr-76/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3626":793,"_31224":783,"_5":31579,"_21623":53459,"_28405":53460,"_3078":53461},[],"/docs/pr-preview/pr-76/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3626":794,"_31224":783,"_5":31579,"_21623":53463,"_28405":53464,"_3078":53465},[],"/docs/pr-preview/pr-76/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3626":795,"_31224":783,"_5":31579,"_21623":53467,"_28405":53468,"_3078":53469},[],"/docs/pr-preview/pr-76/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3626":796,"_31224":783,"_21623":53471,"_5":14874,"_28405":783,"_3078":53472},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3626":797,"_31224":783,"_21623":53474,"_5":14874,"_28405":53428,"_3078":53475},[],"The audit body includes:",{"_3626":798,"_31224":783,"_21623":53477,"_5":14874,"_28405":53428,"_3078":53478},[],"input: data received by the operation;",{"_3626":799,"_31224":783,"_21623":53480,"_5":14874,"_28405":53428,"_3078":53481},[],"has\\_error: whether the service returned an error;",{"_3626":800,"_31224":783,"_21623":53483,"_5":14874,"_28405":53428,"_3078":53484},[],"output: produced result or error message;",{"_3626":801,"_31224":783,"_21623":53486,"_5":14874,"_28405":53428,"_3078":53487},[],"principals: identifiers of the principals that matched the request.",{"_3626":802,"_31224":783,"_21623":53489,"_5":14874,"_28405":53428,"_3078":53490},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3626":803,"_31224":783,"_21623":53492,"_5":14874,"_28405":53428,"_3078":53493},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3626":804,"_31224":783,"_21623":53495,"_5":14874,"_28405":53432,"_3078":53496},[],"The backend applies auditing to mutations of:",{"_3626":805,"_31224":783,"_21623":53498,"_5":14874,"_28405":53432,"_3078":53499},[],"authorities, certificates and issuance profiles;",{"_3626":806,"_31224":783,"_21623":53501,"_5":14874,"_28405":53432,"_3078":53502},[],"keys and KMS engines;",{"_3626":807,"_31224":783,"_21623":53504,"_5":14874,"_28405":53432,"_3078":53505},[],"devices and identities;",{"_3626":808,"_31224":783,"_21623":53507,"_5":14874,"_28405":53432,"_3078":53508},[],"DMSs and enrollment operations;",{"_3626":809,"_31224":783,"_21623":53510,"_5":14874,"_28405":53432,"_3078":53511},[],"validation functions and CRL;",{"_3626":810,"_31224":783,"_21623":53513,"_5":14874,"_28405":53432,"_3078":53514},[],"principals, policies and authorization grants.",{"_3626":811,"_31224":783,"_21623":53516,"_5":14874,"_28405":53432,"_3078":53517},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3626":812,"_31224":783,"_21623":53519,"_5":14874,"_28405":53436,"_3078":53520},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3626":813,"_31224":783,"_21623":53522,"_5":14874,"_28405":53436,"_3078":53523},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3626":814,"_31224":783,"_21623":53525,"_5":14874,"_28405":53436,"_3078":53526},[],"Design the consumer to:",{"_3626":815,"_31224":783,"_21623":53528,"_5":14874,"_28405":53436,"_3078":53529},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3626":816,"_31224":783,"_21623":53531,"_5":14874,"_28405":53436,"_3078":53532},[],"keep the complete CloudEvent unmodified;",{"_3626":817,"_31224":783,"_21623":53534,"_5":14874,"_28405":53436,"_3078":53535},[],"record the ingestion time and detect duplicates by ID;",{"_3626":818,"_31224":783,"_21623":53537,"_5":14874,"_28405":53436,"_3078":53538},[],"encrypt in transit and at rest;",{"_3626":819,"_31224":783,"_21623":53540,"_5":14874,"_28405":53436,"_3078":53541},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3626":820,"_31224":783,"_21623":53543,"_5":14874,"_28405":53436,"_3078":53544},[],"apply an explicit retention and legal hold policy;",{"_3626":821,"_31224":783,"_21623":53546,"_5":14874,"_28405":53436,"_3078":53547},[],"alert if it stops consuming or the pending queue grows.",{"_3626":822,"_31224":783,"_21623":53549,"_5":14874,"_28405":53440,"_3078":53550},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3626":823,"_31224":783,"_21623":53552,"_5":14874,"_28405":53440,"_3078":53553},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3626":824,"_31224":783,"_21623":53555,"_5":14874,"_28405":53448,"_3078":53556},[],"Start from the reported time and normalize every source to UTC.",{"_3626":825,"_31224":783,"_21623":53558,"_5":14874,"_28405":53452,"_3078":53559},[],"Filter by event type, service source and resource identifier.",{"_3626":826,"_31224":783,"_21623":53561,"_5":14874,"_28405":53456,"_3078":53562},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3626":827,"_31224":783,"_21623":53564,"_5":14874,"_28405":53460,"_3078":53565},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3626":828,"_31224":783,"_21623":53567,"_5":14874,"_28405":53464,"_3078":53568},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3626":829,"_31224":783,"_21623":53570,"_5":14874,"_28405":53468,"_3078":53571},[],"Generate a controlled mutation in a test environment and check that:",{"_3626":830,"_31224":783,"_21623":53573,"_5":14874,"_28405":53468,"_3078":53574},[],"a successful audit event appears;",{"_3626":831,"_31224":783,"_21623":53576,"_5":14874,"_28405":53468,"_3078":53577},[],"the principal matches the identity used;",{"_3626":832,"_31224":783,"_21623":53579,"_5":14874,"_28405":53468,"_3078":53580},[],"the consumer persists it exactly once;",{"_3626":833,"_31224":783,"_21623":53582,"_5":14874,"_28405":53468,"_3078":53583},[],"it can be retrieved by resource, actor and period;",{"_3626":834,"_31224":783,"_21623":53585,"_5":14874,"_28405":53468,"_3078":53586},[],"a consumer outage raises an alert.",{"_3626":835,"_31224":783,"_21623":53588,"_5":14874,"_28405":53468,"_3078":53589},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3626":836,"_31224":836,"_5":15239,"_3078":53591,"_31582":53592,"_21623":53593,"_28405":836},"Platform architecture",[51011,52523],[],{"_3626":837,"_31224":836,"_21623":53595,"_5":14874,"_28405":836,"_3078":53596},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3626":838,"_31224":836,"_5":31579,"_21623":53598,"_28405":53599,"_3078":53600},[],"/docs/pr-preview/pr-76/platform/concepts/architecture#control-plane","Control plane",{"_3626":839,"_31224":836,"_5":31579,"_21623":53602,"_28405":53603,"_3078":53604},[],"/docs/pr-preview/pr-76/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3626":840,"_31224":836,"_5":31579,"_21623":53606,"_28405":53607,"_3078":53608},[],"/docs/pr-preview/pr-76/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3626":841,"_31224":836,"_5":31579,"_21623":53610,"_28405":53611,"_3078":53612},[],"/docs/pr-preview/pr-76/platform/concepts/architecture#status-and-validation","Status and validation",{"_3626":842,"_31224":836,"_5":31579,"_21623":53614,"_28405":53615,"_3078":53616},[],"/docs/pr-preview/pr-76/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3626":843,"_31224":836,"_21623":53618,"_5":14874,"_28405":836,"_3078":53619},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3626":844,"_31224":836,"_21623":53621,"_5":14874,"_28405":836,"_3078":53622},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3626":845,"_31224":836,"_21623":53624,"_5":14874,"_28405":53599,"_3078":53625},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3626":846,"_31224":836,"_21623":53627,"_5":14874,"_28405":53603,"_3078":53628},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3626":847,"_31224":836,"_21623":53630,"_5":14874,"_28405":53607,"_3078":53631},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3626":848,"_31224":836,"_21623":53633,"_5":14874,"_28405":53611,"_3078":53634},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3626":849,"_31224":836,"_21623":53636,"_5":14874,"_28405":53615,"_3078":53637},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3626":850,"_31224":850,"_5":15239,"_3078":53639,"_31582":53640,"_21623":53641,"_28405":850},"How Lamassu works",[51011,52523],[],{"_3626":851,"_31224":850,"_21623":53643,"_5":14874,"_28405":850,"_3078":53644},[],"The mental model of trust, keys, certificates and devices.",{"_3626":852,"_31224":850,"_5":31579,"_21623":53646,"_28405":53647,"_3078":53648},[],"/docs/pr-preview/pr-76/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3626":853,"_31224":850,"_5":31579,"_21623":53650,"_28405":53651,"_3078":53652},[],"/docs/pr-preview/pr-76/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3626":854,"_31224":850,"_21623":53654,"_5":14874,"_28405":850,"_3078":53655},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3626":855,"_31224":850,"_21623":53657,"_5":14874,"_28405":53647,"_3078":53658},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3626":856,"_31224":850,"_21623":53660,"_5":14874,"_28405":53647,"_3078":53661},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3626":857,"_31224":850,"_21623":53663,"_5":14874,"_28405":53647,"_3078":53664},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3626":858,"_31224":850,"_21623":53666,"_5":14874,"_28405":53647,"_3078":53667},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3626":859,"_31224":850,"_21623":53669,"_5":14874,"_28405":53647,"_3078":53670},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3626":860,"_31224":850,"_21623":53672,"_5":14874,"_28405":53651,"_3078":53673},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3626":861,"_31224":850,"_21623":53675,"_5":14874,"_28405":53651,"_3078":53676},[],"A DMS relates that CA to an enrollment policy.",{"_3626":862,"_31224":850,"_21623":53678,"_5":14874,"_28405":53651,"_3078":53679},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3626":863,"_31224":850,"_21623":53681,"_5":14874,"_28405":53651,"_3078":53682},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3626":864,"_31224":850,"_21623":53684,"_5":14874,"_28405":53651,"_3078":53685},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3626":865,"_31224":850,"_21623":53687,"_5":14874,"_28405":53651,"_3078":53688},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3626":866,"_31224":850,"_21623":53690,"_5":14874,"_28405":53651,"_3078":53691},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3626":867,"_31224":867,"_5":15239,"_3078":53693,"_31582":53694,"_21623":53696,"_28405":867},"Devices and identities",[51011,52523,53695,53693],"IoT Fleets",[],{"_3626":868,"_31224":867,"_21623":53698,"_5":14874,"_28405":867,"_3078":53699},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3626":869,"_31224":867,"_5":31579,"_21623":53701,"_28405":53702,"_3078":53703},[],"/docs/pr-preview/pr-76/platform/iot-fleets/device-management#device-states","Device states",{"_3626":870,"_31224":867,"_5":31579,"_21623":53705,"_28405":53706,"_3078":53707},[],"/docs/pr-preview/pr-76/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3626":871,"_31224":867,"_5":31579,"_21623":53709,"_28405":53710,"_3078":53711},[],"/docs/pr-preview/pr-76/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3626":872,"_31224":867,"_5":31579,"_21623":53713,"_28405":53714,"_3078":53715},[],"/docs/pr-preview/pr-76/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3626":873,"_31224":867,"_5":31579,"_21623":53717,"_28405":53718,"_3078":53719},[],"/docs/pr-preview/pr-76/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3626":874,"_31224":867,"_5":31579,"_21623":53721,"_28405":53722,"_3078":53723},[],"/docs/pr-preview/pr-76/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3626":875,"_31224":867,"_5":31579,"_21623":53725,"_28405":53726,"_3078":53727},[],"/docs/pr-preview/pr-76/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3626":876,"_31224":867,"_5":31579,"_21623":53729,"_28405":53730,"_3078":53731},[],"/docs/pr-preview/pr-76/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3626":877,"_31224":867,"_5":31579,"_21623":53733,"_28405":53734,"_3078":53735},[],"/docs/pr-preview/pr-76/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3626":878,"_31224":867,"_5":31579,"_21623":53737,"_28405":53738,"_3078":53739},[],"/docs/pr-preview/pr-76/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3626":879,"_31224":867,"_5":31579,"_21623":53741,"_28405":53742,"_3078":53743},[],"/docs/pr-preview/pr-76/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3626":880,"_31224":867,"_21623":53745,"_5":14874,"_28405":867,"_3078":53746},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3626":881,"_31224":867,"_21623":53748,"_5":14874,"_28405":867,"_3078":53749},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3626":882,"_31224":867,"_21623":53751,"_5":14874,"_28405":53702,"_3078":53752},[],"Operational view",{"_3626":883,"_31224":867,"_21623":53754,"_5":14874,"_28405":53702,"_3078":53755},[],"Meaning",{"_3626":884,"_31224":867,"_21623":53757,"_5":14874,"_28405":53702,"_3078":53758},[],"**No Identity**",{"_3626":885,"_31224":867,"_21623":53760,"_5":14874,"_28405":53702,"_3078":53761},[],"A record exists without an associated identity.",{"_3626":886,"_31224":867,"_21623":53763,"_5":14874,"_28405":53702,"_3078":53764},[],"**Active**",{"_3626":887,"_31224":867,"_21623":53766,"_5":14874,"_28405":53702,"_3078":53767},[],"The slot is active; also check certificate dates, status and usages.",{"_3626":888,"_31224":867,"_21623":53769,"_5":14874,"_28405":53702,"_3078":53770},[],"**Renewal Pending**",{"_3626":889,"_31224":867,"_21623":53772,"_5":14874,"_28405":53702,"_3078":53773},[],"The identity is in the operational renewal window.",{"_3626":890,"_31224":867,"_21623":53775,"_5":14874,"_28405":53702,"_3078":53776},[],"**Expiring Soon**",{"_3626":891,"_31224":867,"_21623":53778,"_5":14874,"_28405":53702,"_3078":53779},[],"Expiration is approaching according to configured thresholds.",{"_3626":892,"_31224":867,"_21623":53781,"_5":14874,"_28405":53702,"_3078":53782},[],"**Expired**",{"_3626":893,"_31224":867,"_21623":53784,"_5":14874,"_28405":53702,"_3078":53785},[],"The identity has expired.",{"_3626":894,"_31224":867,"_21623":53787,"_5":14874,"_28405":53702,"_3078":53788},[],"**Revoked**",{"_3626":895,"_31224":867,"_21623":53790,"_5":14874,"_28405":53702,"_3078":53791},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3626":896,"_31224":867,"_21623":53793,"_5":14874,"_28405":53702,"_3078":53794},[],"**Decommissioned**",{"_3626":897,"_31224":867,"_21623":53796,"_5":14874,"_28405":53702,"_3078":53797},[],"The record is retired and ordinary updates do not restore operation.",{"_3626":898,"_31224":867,"_21623":53799,"_5":14874,"_28405":53702,"_3078":53800},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3626":899,"_31224":867,"_21623":53802,"_5":14874,"_28405":53706,"_3078":53803},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3626":900,"_31224":867,"_21623":53805,"_5":14874,"_28405":53706,"_3078":53806},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3626":901,"_31224":867,"_21623":53808,"_5":14874,"_28405":53706,"_3078":53809},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3626":902,"_31224":867,"_21623":53811,"_5":14874,"_28405":53706,"_3078":53812},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3626":903,"_31224":867,"_21623":53814,"_5":14874,"_28405":53710,"_3078":53815},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3626":904,"_31224":867,"_21623":53817,"_5":14874,"_28405":53714,"_3078":53818},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3626":905,"_31224":867,"_21623":53820,"_5":14874,"_28405":53718,"_3078":53821},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3626":906,"_31224":867,"_21623":53823,"_5":14874,"_28405":53722,"_3078":53824},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3626":907,"_31224":867,"_21623":53826,"_5":14874,"_28405":53726,"_3078":53827},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3626":908,"_31224":867,"_21623":53829,"_5":14874,"_28405":53726,"_3078":53830},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3626":909,"_31224":867,"_21623":53832,"_5":14874,"_28405":53730,"_3078":53833},[],"From **No Identity**, use **Assign Identity**:",{"_3626":910,"_31224":867,"_21623":53835,"_5":14874,"_28405":53730,"_3078":53836},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3626":911,"_31224":867,"_21623":53838,"_5":14874,"_28405":53730,"_3078":53839},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3626":912,"_31224":867,"_21623":53841,"_5":14874,"_28405":53730,"_3078":53842},[],"Confirm and read the serial, active version and history again.",{"_3626":913,"_31224":867,"_21623":53844,"_5":14874,"_28405":53730,"_3078":53845},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3626":914,"_31224":867,"_21623":53847,"_5":14874,"_28405":53730,"_3078":53848},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3626":915,"_31224":867,"_21623":53850,"_5":14874,"_28405":53734,"_3078":53851},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3626":916,"_31224":867,"_21623":53853,"_5":14874,"_28405":53734,"_3078":53854},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3626":917,"_31224":867,"_21623":53856,"_5":14874,"_28405":53734,"_3078":53857},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3626":918,"_31224":867,"_21623":53859,"_5":14874,"_28405":53738,"_3078":53860},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3626":919,"_31224":867,"_21623":53862,"_5":14874,"_28405":53738,"_3078":53863},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3626":920,"_31224":867,"_21623":53865,"_5":14874,"_28405":53738,"_3078":53866},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3626":921,"_31224":867,"_21623":53868,"_5":14874,"_28405":53738,"_3078":53869},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3626":922,"_31224":867,"_21623":53871,"_5":14874,"_28405":53742,"_3078":53872},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3626":923,"_31224":867,"_21623":53874,"_5":14874,"_28405":53742,"_3078":53875},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3626":924,"_31224":924,"_5":15239,"_3078":53877,"_31582":53878,"_21623":53880,"_28405":924},"Bootstrap identity and authentication",[51011,52523,53695,53693,53879],"Enrollment with PKI",[],{"_3626":925,"_31224":924,"_21623":53882,"_5":14874,"_28405":924,"_3078":53883},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3626":926,"_31224":924,"_5":31579,"_21623":53885,"_28405":53886,"_3078":53887},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3626":927,"_31224":924,"_5":31579,"_21623":53889,"_28405":53890,"_3078":53891},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3626":928,"_31224":924,"_5":31579,"_21623":53893,"_28405":53894,"_3078":53895},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3626":929,"_31224":924,"_5":31579,"_21623":53897,"_28405":53898,"_3078":53899},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3626":930,"_31224":924,"_5":31579,"_21623":53901,"_28405":53902,"_3078":53903},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3626":931,"_31224":924,"_21623":53905,"_5":14874,"_28405":924,"_3078":53906},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3626":932,"_31224":924,"_21623":53908,"_5":14874,"_28405":53886,"_3078":53909},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3626":933,"_31224":924,"_21623":53911,"_5":14874,"_28405":53886,"_3078":53912},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3626":934,"_31224":924,"_21623":53914,"_5":14874,"_28405":53890,"_3078":53915},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3626":935,"_31224":924,"_21623":53917,"_5":14874,"_28405":53890,"_3078":53918},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3626":936,"_31224":924,"_21623":53920,"_5":14874,"_28405":53890,"_3078":53921},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3626":937,"_31224":924,"_21623":53923,"_5":14874,"_28405":53894,"_3078":53924},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3626":938,"_31224":924,"_21623":53926,"_5":14874,"_28405":53894,"_3078":53927},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3626":939,"_31224":924,"_21623":53929,"_5":14874,"_28405":53898,"_3078":53930},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3626":940,"_31224":924,"_21623":53932,"_5":14874,"_28405":53898,"_3078":53933},[],"Example body:",{"_3626":941,"_31224":924,"_21623":53935,"_5":14874,"_28405":53898,"_3078":53936},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3626":942,"_31224":924,"_21623":53938,"_5":14874,"_28405":53898,"_3078":53939},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3626":943,"_31224":924,"_21623":53941,"_5":14874,"_28405":53898,"_3078":53942},[],"Continuation requires a successful HTTP response and JSON:",{"_3626":944,"_31224":924,"_21623":53944,"_5":14874,"_28405":53898,"_3078":53945},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3626":945,"_31224":924,"_21623":53947,"_5":14874,"_28405":53902,"_3078":53948},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3626":946,"_31224":924,"_21623":53950,"_5":14874,"_28405":53902,"_3078":53951},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh — `thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old — and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3626":947,"_31224":924,"_21623":53953,"_5":14874,"_28405":53902,"_3078":53954},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3626":948,"_31224":924,"_21623":53956,"_5":14874,"_28405":53902,"_3078":53957},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3626":949,"_31224":949,"_5":15239,"_3078":53959,"_31582":53960,"_21623":53961,"_28405":949},"Configure and operate the DMS",[51011,52523,53695,53693,53879],[],{"_3626":950,"_31224":949,"_21623":53963,"_5":14874,"_28405":949,"_3078":53964},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3626":951,"_31224":949,"_5":31579,"_21623":53966,"_28405":53967,"_3078":51021},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3626":952,"_31224":949,"_5":31579,"_21623":53969,"_28405":53970,"_3078":53971},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3626":953,"_31224":949,"_5":31579,"_21623":53973,"_28405":53974,"_3078":53975},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3626":954,"_31224":949,"_5":31579,"_21623":53977,"_28405":53978,"_3078":53979},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3626":955,"_31224":949,"_5":31579,"_21623":53981,"_28405":53982,"_3078":53983},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3626":956,"_31224":949,"_5":31579,"_21623":53985,"_28405":53986,"_3078":53987},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3626":957,"_31224":949,"_5":31579,"_21623":53989,"_28405":53990,"_3078":53991},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3626":958,"_31224":949,"_5":31579,"_21623":53993,"_28405":53994,"_3078":53995},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3626":959,"_31224":949,"_5":31579,"_21623":53997,"_28405":53998,"_3078":53999},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3626":960,"_31224":949,"_5":31579,"_21623":54001,"_28405":54002,"_3078":54003},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3626":961,"_31224":949,"_5":31579,"_21623":54005,"_28405":54006,"_3078":54007},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3626":962,"_31224":949,"_5":31579,"_21623":54009,"_28405":54010,"_3078":54011},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3626":963,"_31224":949,"_5":31579,"_21623":54013,"_28405":54014,"_3078":54015},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3626":964,"_31224":949,"_5":31579,"_21623":54017,"_28405":54018,"_3078":54019},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3626":965,"_31224":949,"_5":31579,"_21623":54021,"_28405":54022,"_3078":54023},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3626":966,"_31224":949,"_5":31579,"_21623":54025,"_28405":54026,"_3078":54027},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3626":967,"_31224":949,"_5":31579,"_21623":54029,"_28405":54030,"_3078":54031},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3626":968,"_31224":949,"_5":31579,"_21623":54033,"_28405":54034,"_3078":54035},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3626":969,"_31224":949,"_21623":54037,"_5":14874,"_28405":949,"_3078":54038},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3626":970,"_31224":949,"_21623":54040,"_5":14874,"_28405":53967,"_3078":54041},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3626":971,"_31224":949,"_21623":54043,"_5":14874,"_28405":53967,"_3078":54044},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3626":972,"_31224":949,"_21623":54046,"_5":14874,"_28405":53974,"_3078":54047},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3626":973,"_31224":949,"_21623":54049,"_5":14874,"_28405":53978,"_3078":54050},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3626":974,"_31224":949,"_21623":54052,"_5":14874,"_28405":53982,"_3078":54053},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3626":975,"_31224":949,"_21623":54055,"_5":14874,"_28405":53986,"_3078":54056},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3626":976,"_31224":949,"_21623":54058,"_5":14874,"_28405":53990,"_3078":54059},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3626":977,"_31224":949,"_21623":54061,"_5":14874,"_28405":53998,"_3078":54062},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3626":978,"_31224":949,"_21623":54064,"_5":14874,"_28405":53998,"_3078":54065},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3626":979,"_31224":949,"_21623":54067,"_5":14874,"_28405":54002,"_3078":54068},[],"`settings.enrollment_settings` field",{"_3626":980,"_31224":949,"_21623":54070,"_5":14874,"_28405":54002,"_3078":54071},[],"Decision",{"_3626":981,"_31224":949,"_21623":54073,"_5":14874,"_28405":54002,"_3078":54074},[],"`protocol`",{"_3626":982,"_31224":949,"_21623":54076,"_5":14874,"_28405":54002,"_3078":54077},[],"`EST_RFC7030` for these operations.",{"_3626":983,"_31224":949,"_21623":54079,"_5":14874,"_28405":54002,"_3078":54080},[],"`enrollment_ca`",{"_3626":984,"_31224":949,"_21623":54082,"_5":14874,"_28405":54002,"_3078":54083},[],"ID of the signing CA.",{"_3626":985,"_31224":949,"_21623":54085,"_5":14874,"_28405":54002,"_3078":54086},[],"`verify_csr_signature`",{"_3626":986,"_31224":949,"_21623":54088,"_5":14874,"_28405":54002,"_3078":54089},[],"Keep `true` to verify CSR key possession.",{"_3626":987,"_31224":949,"_21623":54091,"_5":14874,"_28405":54002,"_3078":54092},[],"`enable_replaceable_enrollment`",{"_3626":988,"_31224":949,"_21623":54094,"_5":14874,"_28405":54002,"_3078":54095},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3626":989,"_31224":949,"_21623":54097,"_5":14874,"_28405":54002,"_3078":54098},[],"`est_rfc7030_settings.auth_mode`",{"_3626":990,"_31224":949,"_21623":54100,"_5":14874,"_28405":54002,"_3078":54101},[],"One of the four authentication modes.",{"_3626":991,"_31224":949,"_21623":54103,"_5":14874,"_28405":54002,"_3078":54104},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3626":992,"_31224":949,"_21623":54106,"_5":14874,"_28405":54006,"_3078":54107},[],"The blocks are independent:",{"_3626":993,"_31224":949,"_21623":54109,"_5":14874,"_28405":54006,"_3078":54110},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3626":994,"_31224":949,"_21623":54112,"_5":14874,"_28405":54006,"_3078":54113},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3626":995,"_31224":949,"_21623":54115,"_5":14874,"_28405":54006,"_3078":54116},[],"`auth_mode`",{"_3626":996,"_31224":949,"_21623":54118,"_5":14874,"_28405":54006,"_3078":54119},[],"Control applied in the configured operation",{"_3626":997,"_31224":949,"_21623":54121,"_5":14874,"_28405":54006,"_3078":54122},[],"`CLIENT_CERTIFICATE`",{"_3626":998,"_31224":949,"_21623":54124,"_5":14874,"_28405":54006,"_3078":54125},[],"Presented certificate validation.",{"_3626":999,"_31224":949,"_21623":54127,"_5":14874,"_28405":54006,"_3078":54128},[],"`EXTERNAL_WEBHOOK`",{"_3626":1000,"_31224":949,"_21623":54130,"_5":14874,"_28405":54006,"_3078":54131},[],"Configured webhook authorization.",{"_3626":1001,"_31224":949,"_21623":54133,"_5":14874,"_28405":54006,"_3078":54134},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3626":1002,"_31224":949,"_21623":54136,"_5":14874,"_28405":54006,"_3078":54137},[],"Certificate validation followed by webhook approval.",{"_3626":1003,"_31224":949,"_21623":54139,"_5":14874,"_28405":54006,"_3078":54140},[],"`NO_AUTH`",{"_3626":1004,"_31224":949,"_21623":54142,"_5":14874,"_28405":54006,"_3078":54143},[],"No DMS requester authentication.",{"_3626":1005,"_31224":949,"_21623":54145,"_5":14874,"_28405":54006,"_3078":54146},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3626":1006,"_31224":949,"_21623":54148,"_5":14874,"_28405":54006,"_3078":54149},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `chain_level_validation` and `allow_unverifiable_revocation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3626":1007,"_31224":949,"_21623":54151,"_5":14874,"_28405":54006,"_3078":54152},[],"Revocation is checked for every presented certificate. In initial enrollment the client certificate **and** every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. A validation CA that is revoked in Lamassu rejects the operation: the first validation CA that validates the certificate is used, and a revoked one is not replaced by the remaining validation CAs. Certificates issued and managed by Lamassu are checked against their stored status. External certificates are checked through their OCSP and CRL endpoints, and the operation fails closed when revocation cannot be verified: only `allow_unverifiable_revocation` — `false` by default in both blocks — relaxes the case of an external certificate that lists no endpoint at all. Endpoints that exist but are unreachable, return stale or invalid evidence, or report an inconclusive status are always rejected, whatever the option says. The details and the evidence the endpoints must present are in Revocation and checks.",{"_3626":1008,"_31224":949,"_21623":54154,"_5":14874,"_28405":54006,"_3078":54155},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`. Re-enrollment checks revocation of the client certificate only; that check is governed by the re-enrollment block's own `allow_unverifiable_revocation`.",{"_3626":1009,"_31224":949,"_21623":54157,"_5":14874,"_28405":54006,"_3078":54158},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3626":1010,"_31224":949,"_21623":54160,"_5":14874,"_28405":54010,"_3078":54161},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3626":1011,"_31224":949,"_21623":54163,"_5":14874,"_28405":54010,"_3078":54164},[],"`external_webhook_settings` field",{"_3626":1012,"_31224":949,"_21623":54166,"_5":14874,"_28405":54010,"_3078":54071},[],{"_3626":1013,"_31224":949,"_21623":54168,"_5":14874,"_28405":54010,"_3078":54169},[],"`url`",{"_3626":1014,"_31224":949,"_21623":54171,"_5":14874,"_28405":54010,"_3078":54172},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3626":1015,"_31224":949,"_21623":54174,"_5":14874,"_28405":54010,"_3078":54175},[],"`method`",{"_3626":1016,"_31224":949,"_21623":54177,"_5":14874,"_28405":54010,"_3078":54178},[],"`POST` or `PUT`; `POST` by default.",{"_3626":1017,"_31224":949,"_21623":54180,"_5":14874,"_28405":54010,"_3078":54181},[],"`name`",{"_3626":1018,"_31224":949,"_21623":54183,"_5":14874,"_28405":54010,"_3078":54184},[],"Label used in service logs.",{"_3626":1019,"_31224":949,"_21623":54186,"_5":14874,"_28405":54010,"_3078":54187},[],"`config.auth_mode`",{"_3626":1020,"_31224":949,"_21623":54189,"_5":14874,"_28405":54010,"_3078":54190},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3626":1021,"_31224":949,"_21623":54192,"_5":14874,"_28405":54010,"_3078":54193},[],"`config.log_level`",{"_3626":1022,"_31224":949,"_21623":54195,"_5":14874,"_28405":54010,"_3078":54196},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3626":1023,"_31224":949,"_21623":54198,"_5":14874,"_28405":54010,"_3078":54199},[],"`config.apikey_options`",{"_3626":1024,"_31224":949,"_21623":54201,"_5":14874,"_28405":54010,"_3078":54202},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3626":1025,"_31224":949,"_21623":54204,"_5":14874,"_28405":54010,"_3078":54205},[],"`config.jwt_options`",{"_3626":1026,"_31224":949,"_21623":54207,"_5":14874,"_28405":54010,"_3078":54208},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3626":1027,"_31224":949,"_21623":54210,"_5":14874,"_28405":54010,"_3078":54211},[],"`config.mtls_options`",{"_3626":1028,"_31224":949,"_21623":54213,"_5":14874,"_28405":54010,"_3078":54214},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3626":1029,"_31224":949,"_21623":54216,"_5":14874,"_28405":54010,"_3078":54217},[],"`config.insecure_skip_verify`",{"_3626":1030,"_31224":949,"_21623":54219,"_5":14874,"_28405":54010,"_3078":54220},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3626":1031,"_31224":949,"_21623":54222,"_5":14874,"_28405":54010,"_3078":54223},[],"`config.call_timeout`",{"_3626":1032,"_31224":949,"_21623":54225,"_5":14874,"_28405":54010,"_3078":54226},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3626":1033,"_31224":949,"_21623":54228,"_5":14874,"_28405":54010,"_3078":54229},[],"Rules for that configuration:",{"_3626":1034,"_31224":949,"_21623":54231,"_5":14874,"_28405":54010,"_3078":54232},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3626":1035,"_31224":949,"_21623":54234,"_5":14874,"_28405":54010,"_3078":54235},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3626":1036,"_31224":949,"_21623":54237,"_5":14874,"_28405":54010,"_3078":54238},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3626":1037,"_31224":949,"_21623":54240,"_5":14874,"_28405":54010,"_3078":54241},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3626":1038,"_31224":949,"_21623":54243,"_5":14874,"_28405":54010,"_3078":54244},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3626":1039,"_31224":949,"_21623":54246,"_5":14874,"_28405":54010,"_3078":54247},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3626":1040,"_31224":949,"_21623":54249,"_5":14874,"_28405":54010,"_3078":54250},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3626":1041,"_31224":949,"_21623":54252,"_5":14874,"_28405":54010,"_3078":54253},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3626":1042,"_31224":949,"_21623":54255,"_5":14874,"_28405":54010,"_3078":54256},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3626":1043,"_31224":949,"_21623":54258,"_5":14874,"_28405":54014,"_3078":54259},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3626":1044,"_31224":949,"_21623":54261,"_5":14874,"_28405":54018,"_3078":54262},[],"`settings.reenrollment_settings` field",{"_3626":1045,"_31224":949,"_21623":54264,"_5":14874,"_28405":54018,"_3078":51401},[],{"_3626":1046,"_31224":949,"_21623":54266,"_5":14874,"_28405":54018,"_3078":54267},[],"`reenrollment_delta`",{"_3626":1047,"_31224":949,"_21623":54269,"_5":14874,"_28405":54018,"_3078":54270},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3626":1048,"_31224":949,"_21623":54272,"_5":14874,"_28405":54018,"_3078":54273},[],"`preventive_delta`",{"_3626":1049,"_31224":949,"_21623":54275,"_5":14874,"_28405":54018,"_3078":54276},[],"Preventive operational monitoring threshold.",{"_3626":1050,"_31224":949,"_21623":54278,"_5":14874,"_28405":54018,"_3078":54279},[],"`critical_delta`",{"_3626":1051,"_31224":949,"_21623":54281,"_5":14874,"_28405":54018,"_3078":54282},[],"Critical operational monitoring threshold.",{"_3626":1052,"_31224":949,"_21623":54284,"_5":14874,"_28405":54018,"_3078":54285},[],"`enable_expired_renewal`",{"_3626":1053,"_31224":949,"_21623":54287,"_5":14874,"_28405":54018,"_3078":54288},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3626":1054,"_31224":949,"_21623":54290,"_5":14874,"_28405":54018,"_3078":54291},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3626":1055,"_31224":949,"_21623":54293,"_5":14874,"_28405":54018,"_3078":54294},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3626":1056,"_31224":949,"_21623":54296,"_5":14874,"_28405":54018,"_3078":54297},[],"`revoke_on_reenrollment`",{"_3626":1057,"_31224":949,"_21623":54299,"_5":14874,"_28405":54018,"_3078":54300},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3626":1058,"_31224":949,"_21623":54302,"_5":14874,"_28405":54018,"_3078":54303},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3626":1059,"_31224":949,"_21623":54305,"_5":14874,"_28405":54022,"_3078":54306},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3626":1060,"_31224":949,"_21623":54308,"_5":14874,"_28405":54026,"_3078":51395},[],{"_3626":1061,"_31224":949,"_21623":54310,"_5":14874,"_28405":54026,"_3078":54311},[],"Published material",{"_3626":1062,"_31224":949,"_21623":54313,"_5":14874,"_28405":54026,"_3078":54314},[],"**Include Lamassu System CA**",{"_3626":1063,"_31224":949,"_21623":54316,"_5":14874,"_28405":54026,"_3078":54317},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3626":1064,"_31224":949,"_21623":54319,"_5":14874,"_28405":54026,"_3078":54320},[],"**Include Enrollment CA**",{"_3626":1065,"_31224":949,"_21623":54322,"_5":14874,"_28405":54026,"_3078":54323},[],"Selected issuing CA certificate.",{"_3626":1066,"_31224":949,"_21623":54325,"_5":14874,"_28405":54026,"_3078":54326},[],"**Managed CAs**",{"_3626":1067,"_31224":949,"_21623":54328,"_5":14874,"_28405":54026,"_3078":54329},[],"Explicitly selected CA certificates.",{"_3626":1068,"_31224":949,"_21623":54331,"_5":14874,"_28405":54026,"_3078":54332},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3626":1069,"_31224":949,"_21623":54334,"_5":14874,"_28405":54030,"_3078":54335},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3626":1070,"_31224":949,"_21623":54337,"_5":14874,"_28405":54030,"_3078":54338},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3626":1071,"_31224":949,"_21623":54340,"_5":14874,"_28405":54030,"_3078":54341},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3626":1072,"_31224":949,"_21623":54343,"_5":14874,"_28405":54034,"_3078":54344},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3626":1073,"_31224":1073,"_5":15239,"_3078":54346,"_31582":54347,"_21623":54348,"_28405":1073},"Integrate the EST client",[51011,52523,53695,53693,53879],[],{"_3626":1074,"_31224":1073,"_21623":54350,"_5":14874,"_28405":1073,"_3078":54351},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3626":1075,"_31224":1073,"_5":31579,"_21623":54353,"_28405":54354,"_3078":51021},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3626":1076,"_31224":1073,"_5":31579,"_21623":54356,"_28405":54357,"_3078":54358},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3626":1077,"_31224":1073,"_5":31579,"_21623":54360,"_28405":54361,"_3078":54362},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3626":1078,"_31224":1073,"_5":31579,"_21623":54364,"_28405":54365,"_3078":54366},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3626":1079,"_31224":1073,"_5":31579,"_21623":54368,"_28405":54369,"_3078":54370},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3626":1080,"_31224":1073,"_5":31579,"_21623":54372,"_28405":54373,"_3078":54374},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3626":1081,"_31224":1073,"_21623":54376,"_5":14874,"_28405":1073,"_3078":54377},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3626":1082,"_31224":1073,"_21623":54379,"_5":14874,"_28405":54354,"_3078":54380},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3626":1083,"_31224":1073,"_21623":54382,"_5":14874,"_28405":54354,"_3078":54383},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3626":1084,"_31224":1073,"_21623":54385,"_5":14874,"_28405":54354,"_3078":54386},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3626":1085,"_31224":1073,"_21623":54388,"_5":14874,"_28405":54357,"_3078":54389},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3626":1086,"_31224":1073,"_21623":54391,"_5":14874,"_28405":54357,"_3078":54392},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3626":1087,"_31224":1073,"_21623":54394,"_5":14874,"_28405":54361,"_3078":54395},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3626":1088,"_31224":1073,"_21623":54397,"_5":14874,"_28405":54361,"_3078":54398},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3626":1089,"_31224":1073,"_21623":54400,"_5":14874,"_28405":54365,"_3078":54401},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3626":1090,"_31224":1073,"_21623":54403,"_5":14874,"_28405":54365,"_3078":54404},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3626":1091,"_31224":1073,"_21623":54406,"_5":14874,"_28405":54369,"_3078":54407},[],"For a root that issues directly:",{"_3626":1092,"_31224":1073,"_21623":54409,"_5":14874,"_28405":54369,"_3078":54410},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3626":1093,"_31224":1073,"_21623":54412,"_5":14874,"_28405":54369,"_3078":54413},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3626":1094,"_31224":1073,"_21623":54415,"_5":14874,"_28405":54373,"_3078":54416},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3626":1095,"_31224":1095,"_5":15239,"_3078":54418,"_31582":54419,"_21623":54420,"_28405":1095},"EST reference",[51011,52523,53695,53693,53879],[],{"_3626":1096,"_31224":1095,"_21623":54422,"_5":14874,"_28405":1095,"_3078":54423},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3626":1097,"_31224":1095,"_5":31579,"_21623":54425,"_28405":54426,"_3078":54427},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3626":1098,"_31224":1095,"_5":31579,"_21623":54429,"_28405":54430,"_3078":23430},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3626":1099,"_31224":1095,"_5":31579,"_21623":54432,"_28405":54433,"_3078":26945},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3626":1100,"_31224":1095,"_5":31579,"_21623":54435,"_28405":54436,"_3078":26952},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3626":1101,"_31224":1095,"_5":31579,"_21623":54438,"_28405":54439,"_3078":26214},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3626":1102,"_31224":1095,"_5":31579,"_21623":54441,"_28405":54442,"_3078":54443},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3626":1103,"_31224":1095,"_5":31579,"_21623":54445,"_28405":54446,"_3078":54447},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3626":1104,"_31224":1095,"_5":31579,"_21623":54449,"_28405":54450,"_3078":54451},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3626":1105,"_31224":1095,"_21623":54453,"_5":14874,"_28405":1095,"_3078":54454},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3626":1106,"_31224":1095,"_21623":54456,"_5":14874,"_28405":54426,"_3078":54457},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3626":1107,"_31224":1095,"_21623":54459,"_5":14874,"_28405":54426,"_3078":54460},[],"Operation",{"_3626":1108,"_31224":1095,"_21623":54462,"_5":14874,"_28405":54426,"_3078":54463},[],"Method",{"_3626":1109,"_31224":1095,"_21623":54465,"_5":14874,"_28405":54426,"_3078":54466},[],"Authentication and condition",{"_3626":1110,"_31224":1095,"_21623":54468,"_5":14874,"_28405":54426,"_3078":54469},[],"`/cacerts`",{"_3626":1111,"_31224":1095,"_21623":54471,"_5":14874,"_28405":54426,"_3078":54472},[],"GET",{"_3626":1112,"_31224":1095,"_21623":54474,"_5":14874,"_28405":54426,"_3078":54475},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3626":1113,"_31224":1095,"_21623":54477,"_5":14874,"_28405":54426,"_3078":54478},[],"`/simpleenroll`",{"_3626":1114,"_31224":1095,"_21623":54480,"_5":14874,"_28405":54426,"_3078":54481},[],"POST",{"_3626":1115,"_31224":1095,"_21623":54483,"_5":14874,"_28405":54426,"_3078":54484},[],"Initial authentication and DMS registration/replacement policy.",{"_3626":1116,"_31224":1095,"_21623":54486,"_5":14874,"_28405":54426,"_3078":54487},[],"`/simplereenroll`",{"_3626":1117,"_31224":1095,"_21623":54489,"_5":14874,"_28405":54426,"_3078":54481},[],{"_3626":1118,"_31224":1095,"_21623":54491,"_5":14874,"_28405":54426,"_3078":54492},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3626":1119,"_31224":1095,"_21623":54494,"_5":14874,"_28405":54426,"_3078":54495},[],"`/serverkeygen`",{"_3626":1120,"_31224":1095,"_21623":54497,"_5":14874,"_28405":54426,"_3078":54481},[],{"_3626":1121,"_31224":1095,"_21623":54499,"_5":14874,"_28405":54426,"_3078":54500},[],"Initial authentication and admission; server generation enabled.",{"_3626":1122,"_31224":1095,"_21623":54502,"_5":14874,"_28405":54426,"_3078":54503},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3626":1123,"_31224":1095,"_21623":54505,"_5":14874,"_28405":54430,"_3078":54506},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3626":1124,"_31224":1095,"_21623":54508,"_5":14874,"_28405":54430,"_3078":54509},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3626":1125,"_31224":1095,"_21623":54511,"_5":14874,"_28405":54433,"_3078":54512},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3626":1126,"_31224":1095,"_21623":54514,"_5":14874,"_28405":54433,"_3078":54515},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3626":1127,"_31224":1095,"_21623":54517,"_5":14874,"_28405":54436,"_3078":54518},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3626":1128,"_31224":1095,"_21623":54520,"_5":14874,"_28405":54436,"_3078":54521},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. With default settings, a client certificate whose revocation cannot be verified is also rejected; the DMS guide describes `allow_unverifiable_revocation`. See Renewal for installation and recovery.",{"_3626":1129,"_31224":1095,"_21623":54523,"_5":14874,"_28405":54439,"_3078":54524},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3626":1130,"_31224":1095,"_21623":54526,"_5":14874,"_28405":54439,"_3078":54527},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3626":1131,"_31224":1095,"_21623":54529,"_5":14874,"_28405":54442,"_3078":54530},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3626":1132,"_31224":1095,"_21623":54532,"_5":14874,"_28405":54442,"_3078":54533},[],"Part",{"_3626":1133,"_31224":1095,"_21623":54535,"_5":14874,"_28405":54442,"_3078":54536},[],"Content after decoding its Base64",{"_3626":1134,"_31224":1095,"_21623":54538,"_5":14874,"_28405":54442,"_3078":54539},[],"`application/pkcs8`",{"_3626":1135,"_31224":1095,"_21623":54541,"_5":14874,"_28405":54442,"_3078":54542},[],"Unencrypted DER PKCS#8 private key.",{"_3626":1136,"_31224":1095,"_21623":54544,"_5":14874,"_28405":54442,"_3078":54545},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3626":1137,"_31224":1095,"_21623":54547,"_5":14874,"_28405":54442,"_3078":54548},[],"DER PKCS#7 containing the issued certificate.",{"_3626":1138,"_31224":1095,"_21623":54550,"_5":14874,"_28405":54442,"_3078":54551},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3626":1139,"_31224":1095,"_21623":54553,"_5":14874,"_28405":54446,"_3078":54554},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3626":1140,"_31224":1095,"_21623":54556,"_5":14874,"_28405":54446,"_3078":54557},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3626":1141,"_31224":1095,"_21623":54559,"_5":14874,"_28405":54446,"_3078":54560},[],"Convert and check the result:",{"_3626":1142,"_31224":1095,"_21623":54562,"_5":14874,"_28405":54446,"_3078":54563},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3626":1143,"_31224":1095,"_21623":54565,"_5":14874,"_28405":54450,"_3078":54566},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3626":1144,"_31224":1095,"_21623":54568,"_5":14874,"_28405":54450,"_3078":54569},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3626":1145,"_31224":1145,"_5":15239,"_3078":53879,"_31582":54571,"_21623":54572,"_28405":1145},[51011,52523,53695,53693,53879],[],{"_3626":1146,"_31224":1145,"_21623":54574,"_5":14874,"_28405":1145,"_3078":54575},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3626":1147,"_31224":1145,"_5":31579,"_21623":54577,"_28405":54578,"_3078":54579},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3626":1148,"_31224":1145,"_5":31579,"_21623":54581,"_28405":54582,"_3078":54583},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3626":1149,"_31224":1145,"_5":31579,"_21623":54585,"_28405":54586,"_3078":54587},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3626":1150,"_31224":1145,"_5":31579,"_21623":54589,"_28405":54590,"_3078":54591},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3626":1151,"_31224":1145,"_21623":54593,"_5":14874,"_28405":1145,"_3078":54594},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3626":1152,"_31224":1145,"_21623":54596,"_5":14874,"_28405":54578,"_3078":54597},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3626":1153,"_31224":1145,"_21623":54599,"_5":14874,"_28405":54578,"_3078":54600},[],"The integrator installs initial EST server trust and an admission credential.",{"_3626":1154,"_31224":1145,"_21623":54602,"_5":14874,"_28405":54578,"_3078":54603},[],"The client requests an identity for its `Device ID` through EST.",{"_3626":1155,"_31224":1145,"_21623":54605,"_5":14874,"_28405":54578,"_3078":54606},[],"Certificate, device binding and key/certificate installation are checked.",{"_3626":1156,"_31224":1145,"_21623":54608,"_5":14874,"_28405":54578,"_3078":54609},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3626":1157,"_31224":1145,"_21623":54611,"_5":14874,"_28405":54578,"_3078":54612},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3626":1158,"_31224":1145,"_21623":54614,"_5":14874,"_28405":54582,"_3078":54615},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3626":1159,"_31224":1145,"_21623":54617,"_5":14874,"_28405":54582,"_3078":54618},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3626":1160,"_31224":1145,"_21623":54620,"_5":14874,"_28405":54582,"_3078":54621},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3626":1161,"_31224":1145,"_21623":54623,"_5":14874,"_28405":54582,"_3078":54624},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3626":1162,"_31224":1145,"_21623":54626,"_5":14874,"_28405":54586,"_3078":54627},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3626":1163,"_31224":1145,"_21623":54629,"_5":14874,"_28405":54586,"_3078":54630},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3626":1164,"_31224":1145,"_21623":54632,"_5":14874,"_28405":54586,"_3078":54633},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3626":1165,"_31224":1145,"_21623":54635,"_5":14874,"_28405":54586,"_3078":54636},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3626":1166,"_31224":1145,"_21623":54638,"_5":14874,"_28405":54590,"_3078":54639},[],"This block describes `main` code inspected at commit `03aa2f1be273a05cb06d85d8dfb2560d6d677ca4`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3626":1167,"_31224":1145,"_21623":54641,"_5":14874,"_28405":54590,"_3078":54642},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3626":1168,"_31224":1168,"_5":15239,"_3078":54644,"_31582":54645,"_21623":54646,"_28405":1168},"Provisioning strategies",[51011,52523,53695,53693,53879],[],{"_3626":1169,"_31224":1168,"_21623":54648,"_5":14874,"_28405":1168,"_3078":54649},[],"Choose device registration, identity authorization and key generation.",{"_3626":1170,"_31224":1168,"_5":31579,"_21623":54651,"_28405":54652,"_3078":54653},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3626":1171,"_31224":1168,"_5":31579,"_21623":54655,"_28405":54656,"_3078":54657},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3626":1172,"_31224":1168,"_5":31579,"_21623":54659,"_28405":54660,"_3078":54661},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3626":1173,"_31224":1168,"_5":31579,"_21623":54663,"_28405":54664,"_3078":54665},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3626":1174,"_31224":1168,"_5":31579,"_21623":54667,"_28405":54668,"_3078":54669},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3626":1175,"_31224":1168,"_21623":54671,"_5":14874,"_28405":1168,"_3078":54672},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3626":1176,"_31224":1168,"_21623":54674,"_5":14874,"_28405":54652,"_3078":54675},[],"Path",{"_3626":1177,"_31224":1168,"_21623":54677,"_5":14874,"_28405":54652,"_3078":54678},[],"When the device exists",{"_3626":1178,"_31224":1168,"_21623":54680,"_5":14874,"_28405":54652,"_3078":54681},[],"What to check",{"_3626":1179,"_31224":1168,"_21623":54683,"_5":14874,"_28405":54652,"_3078":54684},[],"Manual assignment",{"_3626":1180,"_31224":1168,"_21623":54686,"_5":14874,"_28405":54652,"_3078":54687},[],"An operator creates it before associating a certificate.",{"_3626":1181,"_31224":1168,"_21623":54689,"_5":14874,"_28405":54652,"_3078":54690},[],"ID, owning DMS, certificate CN and bound serial.",{"_3626":1182,"_31224":1168,"_21623":54692,"_5":14874,"_28405":54652,"_3078":54693},[],"EST with `JITP`",{"_3626":1183,"_31224":1168,"_21623":54695,"_5":14874,"_28405":54652,"_3078":54696},[],"Created for an unknown CN during `/simpleenroll`.",{"_3626":1184,"_31224":1168,"_21623":54698,"_5":14874,"_28405":54652,"_3078":54699},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3626":1185,"_31224":1168,"_21623":54701,"_5":14874,"_28405":54652,"_3078":54702},[],"EST with `PRE_REGISTRATION`",{"_3626":1186,"_31224":1168,"_21623":54704,"_5":14874,"_28405":54652,"_3078":54705},[],"Must exist before `/simpleenroll`.",{"_3626":1187,"_31224":1168,"_21623":54707,"_5":14874,"_28405":54652,"_3078":54708},[],"Approved record, same DMS and replacement conditions for your version.",{"_3626":1188,"_31224":1168,"_21623":54710,"_5":14874,"_28405":54652,"_3078":54711},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3626":1189,"_31224":1168,"_21623":54713,"_5":14874,"_28405":54652,"_3078":54714},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3626":1190,"_31224":1168,"_21623":54716,"_5":14874,"_28405":54656,"_3078":54717},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3626":1191,"_31224":1168,"_21623":54719,"_5":14874,"_28405":54656,"_3078":54720},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3626":1192,"_31224":1168,"_21623":54722,"_5":14874,"_28405":54656,"_3078":54723},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3626":1193,"_31224":1168,"_21623":54725,"_5":14874,"_28405":54660,"_3078":54726},[],"Decide initial enrollment and re-enrollment separately:",{"_3626":1194,"_31224":1168,"_21623":54728,"_5":14874,"_28405":54660,"_3078":54729},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3626":1195,"_31224":1168,"_21623":54731,"_5":14874,"_28405":54660,"_3078":54732},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3626":1196,"_31224":1168,"_21623":54734,"_5":14874,"_28405":54660,"_3078":54735},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3626":1197,"_31224":1168,"_21623":54737,"_5":14874,"_28405":54660,"_3078":54738},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3626":1198,"_31224":1168,"_21623":54740,"_5":14874,"_28405":54660,"_3078":54741},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3626":1199,"_31224":1168,"_21623":54743,"_5":14874,"_28405":54664,"_3078":51395},[],{"_3626":1200,"_31224":1168,"_21623":54745,"_5":14874,"_28405":54664,"_3078":54746},[],"Material crossing EST",{"_3626":1201,"_31224":1168,"_21623":54748,"_5":14874,"_28405":54664,"_3078":54749},[],"Device-generated key",{"_3626":1202,"_31224":1168,"_21623":54751,"_5":14874,"_28405":54664,"_3078":54752},[],"Public CSR and certificate; the key stays on the client.",{"_3626":1203,"_31224":1168,"_21623":54754,"_5":14874,"_28405":54664,"_3078":54755},[],"Existing device key",{"_3626":1204,"_31224":1168,"_21623":54757,"_5":14874,"_28405":54664,"_3078":54758},[],"CSR signed with that key and a new certificate.",{"_3626":1205,"_31224":1168,"_21623":54760,"_5":14874,"_28405":54664,"_3078":54023},[],{"_3626":1206,"_31224":1168,"_21623":54762,"_5":14874,"_28405":54664,"_3078":54763},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3626":1207,"_31224":1168,"_21623":54765,"_5":14874,"_28405":54664,"_3078":54766},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3626":1208,"_31224":1168,"_21623":54768,"_5":14874,"_28405":54668,"_3078":54769},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3626":1209,"_31224":1209,"_5":15239,"_3078":54771,"_31582":54772,"_21623":54773,"_28405":1209},"Renewal and recovery",[51011,52523,53695,53693,53879],[],{"_3626":1210,"_31224":1209,"_21623":54775,"_5":14874,"_28405":1209,"_3078":54776},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3626":1211,"_31224":1209,"_5":31579,"_21623":54778,"_28405":54779,"_3078":54780},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3626":1212,"_31224":1209,"_5":31579,"_21623":54782,"_28405":54783,"_3078":54784},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3626":1213,"_31224":1209,"_5":31579,"_21623":54786,"_28405":54787,"_3078":54788},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3626":1214,"_31224":1209,"_5":31579,"_21623":54790,"_28405":54791,"_3078":54792},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3626":1215,"_31224":1209,"_5":31579,"_21623":54794,"_28405":54795,"_3078":54796},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3626":1216,"_31224":1209,"_21623":54798,"_5":14874,"_28405":1209,"_3078":54799},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3626":1217,"_31224":1209,"_21623":54801,"_5":14874,"_28405":54779,"_3078":54802},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3626":1218,"_31224":1209,"_21623":54804,"_5":14874,"_28405":54779,"_3078":54805},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3626":1219,"_31224":1209,"_21623":54807,"_5":14874,"_28405":54779,"_3078":54808},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3626":1220,"_31224":1209,"_21623":54810,"_5":14874,"_28405":54779,"_3078":54811},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3626":1221,"_31224":1209,"_21623":54813,"_5":14874,"_28405":54783,"_3078":54814},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3626":1222,"_31224":1209,"_21623":54816,"_5":14874,"_28405":54783,"_3078":54817},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3626":1223,"_31224":1209,"_21623":54819,"_5":14874,"_28405":54787,"_3078":54820},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3626":1224,"_31224":1209,"_21623":54822,"_5":14874,"_28405":54787,"_3078":54823},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3626":1225,"_31224":1209,"_21623":54825,"_5":14874,"_28405":54787,"_3078":54826},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3626":1226,"_31224":1209,"_21623":54828,"_5":14874,"_28405":54791,"_3078":54829},[],"Situation",{"_3626":1227,"_31224":1209,"_21623":54831,"_5":14874,"_28405":54791,"_3078":54832},[],"Procedure",{"_3626":1228,"_31224":1209,"_21623":54834,"_5":14874,"_28405":54791,"_3078":54835},[],"Valid certificate, outside the window",{"_3626":1229,"_31224":1209,"_21623":54837,"_5":14874,"_28405":54791,"_3078":54838},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3626":1230,"_31224":1209,"_21623":54840,"_5":14874,"_28405":54791,"_3078":54841},[],"Expired certificate, key available",{"_3626":1231,"_31224":1209,"_21623":54843,"_5":14874,"_28405":54791,"_3078":54844},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3626":1232,"_31224":1209,"_21623":54846,"_5":14874,"_28405":54791,"_3078":54847},[],"Renewal through webhook or `NO_AUTH`",{"_3626":1233,"_31224":1209,"_21623":54849,"_5":14874,"_28405":54791,"_3078":54850},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3626":1234,"_31224":1209,"_21623":54852,"_5":14874,"_28405":54791,"_3078":54853},[],"Lost or inaccessible key",{"_3626":1235,"_31224":1209,"_21623":54855,"_5":14874,"_28405":54791,"_3078":54856},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3626":1236,"_31224":1209,"_21623":54858,"_5":14874,"_28405":54791,"_3078":54859},[],"Current identity revoked",{"_3626":1237,"_31224":1209,"_21623":54861,"_5":14874,"_28405":54791,"_3078":54862},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3626":1238,"_31224":1209,"_21623":54864,"_5":14874,"_28405":54791,"_3078":54865},[],"Device without an identity",{"_3626":1239,"_31224":1209,"_21623":54867,"_5":14874,"_28405":54791,"_3078":54868},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3626":1240,"_31224":1209,"_21623":54870,"_5":14874,"_28405":54791,"_3078":54871},[],"Retired device",{"_3626":1241,"_31224":1209,"_21623":54873,"_5":14874,"_28405":54791,"_3078":54874},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3626":1242,"_31224":1209,"_21623":54876,"_5":14874,"_28405":54791,"_3078":54877},[],"Timeout, HTTP 500 or installation failure",{"_3626":1243,"_31224":1209,"_21623":54879,"_5":14874,"_28405":54791,"_3078":54880},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3626":1244,"_31224":1209,"_21623":54882,"_5":14874,"_28405":54795,"_3078":54883},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3626":1245,"_31224":1209,"_21623":54885,"_5":14874,"_28405":54795,"_3078":54886},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3626":1246,"_31224":1246,"_5":15239,"_3078":54888,"_31582":54889,"_21623":54890,"_28405":1246},"Enrollment troubleshooting",[51011,52523,53695,53693,53879],[],{"_3626":1247,"_31224":1246,"_21623":54892,"_5":14874,"_28405":1246,"_3078":54893},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3626":1248,"_31224":1246,"_5":31579,"_21623":54895,"_28405":54896,"_3078":54897},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3626":1249,"_31224":1246,"_5":31579,"_21623":54899,"_28405":54900,"_3078":54901},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3626":1250,"_31224":1246,"_5":31579,"_21623":54903,"_28405":54904,"_3078":54451},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3626":1251,"_31224":1246,"_5":31579,"_21623":54906,"_28405":54907,"_3078":54908},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3626":1252,"_31224":1246,"_21623":54910,"_5":14874,"_28405":1246,"_3078":54911},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3626":1253,"_31224":1246,"_21623":54913,"_5":14874,"_28405":54900,"_3078":54914},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3626":1254,"_31224":1246,"_21623":54916,"_5":14874,"_28405":54900,"_3078":54917},[],"Symptom or message",{"_3626":1255,"_31224":1246,"_21623":54919,"_5":14874,"_28405":54900,"_3078":54681},[],{"_3626":1256,"_31224":1246,"_21623":54921,"_5":14874,"_28405":54900,"_3078":54922},[],"curl rejects TLS, name or issuer",{"_3626":1257,"_31224":1246,"_21623":54924,"_5":14874,"_28405":54900,"_3078":54925},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3626":1258,"_31224":1246,"_21623":54927,"_5":14874,"_28405":54900,"_3078":54928},[],"404 or missing APS",{"_3626":1259,"_31224":1246,"_21623":54930,"_5":14874,"_28405":54900,"_3078":54931},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3626":1260,"_31224":1246,"_21623":54933,"_5":14874,"_28405":54900,"_3078":54934},[],"400, CSR or format error",{"_3626":1261,"_31224":1246,"_21623":54936,"_5":14874,"_28405":54900,"_3078":54937},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3626":1262,"_31224":1246,"_21623":54939,"_5":14874,"_28405":54900,"_3078":54940},[],"Missing credential or invalid certificate",{"_3626":1263,"_31224":1246,"_21623":54942,"_5":14874,"_28405":54900,"_3078":54943},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3626":1264,"_31224":1246,"_21623":54945,"_5":14874,"_28405":54900,"_3078":54946},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3626":1265,"_31224":1246,"_21623":54948,"_5":14874,"_28405":54900,"_3078":54949},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3626":1266,"_31224":1246,"_21623":54951,"_5":14874,"_28405":54900,"_3078":54952},[],"Webhook denies, times out or responds without authorization",{"_3626":1267,"_31224":1246,"_21623":54954,"_5":14874,"_28405":54900,"_3078":54955},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3626":1268,"_31224":1246,"_21623":54957,"_5":14874,"_28405":54900,"_3078":54958},[],"`unexpected status code: <n>: redirects are not followed`",{"_3626":1269,"_31224":1246,"_21623":54960,"_5":14874,"_28405":54900,"_3078":54961},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3626":1270,"_31224":1246,"_21623":54963,"_5":14874,"_28405":54900,"_3078":54964},[],"`webhook response exceeds 1048576 bytes`",{"_3626":1271,"_31224":1246,"_21623":54966,"_5":14874,"_28405":54900,"_3078":54967},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3626":1272,"_31224":1246,"_21623":54969,"_5":14874,"_28405":54900,"_3078":54970},[],"`webhook config must not reference files`",{"_3626":1273,"_31224":1246,"_21623":54972,"_5":14874,"_28405":54900,"_3078":54973},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3626":1274,"_31224":1246,"_21623":54975,"_5":14874,"_28405":54900,"_3078":54976},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3626":1275,"_31224":1246,"_21623":54978,"_5":14874,"_28405":54900,"_3078":54979},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3626":1276,"_31224":1246,"_21623":54981,"_5":14874,"_28405":54900,"_3078":54982},[],"`webhook mTLS certificate and key are invalid: …`",{"_3626":1277,"_31224":1246,"_21623":54984,"_5":14874,"_28405":54900,"_3078":54985},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3626":1278,"_31224":1246,"_21623":54987,"_5":14874,"_28405":54900,"_3078":54988},[],"400 `struct validation error` creating or updating a DMS",{"_3626":1279,"_31224":1246,"_21623":54990,"_5":14874,"_28405":54900,"_3078":54991},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3626":1280,"_31224":1246,"_21623":54993,"_5":14874,"_28405":54900,"_3078":54994},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3626":1281,"_31224":1246,"_21623":54996,"_5":14874,"_28405":54900,"_3078":54997},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3626":1282,"_31224":1246,"_21623":54999,"_5":14874,"_28405":54900,"_3078":55000},[],"`device not preregistered`",{"_3626":1283,"_31224":1246,"_21623":55002,"_5":14874,"_28405":54900,"_3078":55003},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3626":1284,"_31224":1246,"_21623":55005,"_5":14874,"_28405":54900,"_3078":55006},[],"`forbiddenNewEnrollment`",{"_3626":1285,"_31224":1246,"_21623":55008,"_5":14874,"_28405":54900,"_3078":55009},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3626":1286,"_31224":1246,"_21623":55011,"_5":14874,"_28405":54900,"_3078":55012},[],"Different owning DMS",{"_3626":1287,"_31224":1246,"_21623":55014,"_5":14874,"_28405":54900,"_3078":55015},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3626":1288,"_31224":1246,"_21623":55017,"_5":14874,"_28405":54900,"_3078":55018},[],"`invalid RawSubject bytes`",{"_3626":1289,"_31224":1246,"_21623":55020,"_5":14874,"_28405":54900,"_3078":55021},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3626":1290,"_31224":1246,"_21623":55023,"_5":14874,"_28405":54900,"_3078":55024},[],"`invalid reenroll window`",{"_3626":1291,"_31224":1246,"_21623":55026,"_5":14874,"_28405":54900,"_3078":55027},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3626":1292,"_31224":1246,"_21623":55029,"_5":14874,"_28405":54900,"_3078":55030},[],"Current certificate revoked",{"_3626":1293,"_31224":1246,"_21623":55032,"_5":14874,"_28405":54900,"_3078":55033},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3626":1294,"_31224":1246,"_21623":55035,"_5":14874,"_28405":54900,"_3078":55036},[],"CA, profile or signing error",{"_3626":1295,"_31224":1246,"_21623":55038,"_5":14874,"_28405":54900,"_3078":55039},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3626":1296,"_31224":1246,"_21623":55041,"_5":14874,"_28405":54900,"_3078":55042},[],"HTTP 200 without a device connection",{"_3626":1297,"_31224":1246,"_21623":55044,"_5":14874,"_28405":54900,"_3078":55045},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3626":1298,"_31224":1246,"_21623":55047,"_5":14874,"_28405":54900,"_3078":55048},[],"Timeout or error after issuance",{"_3626":1299,"_31224":1246,"_21623":55050,"_5":14874,"_28405":54900,"_3078":55051},[],"New certificates, current slot and previous identity's state before retrying.",{"_3626":1300,"_31224":1246,"_21623":55053,"_5":14874,"_28405":54904,"_3078":55054},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3626":1301,"_31224":1246,"_21623":55056,"_5":14874,"_28405":54904,"_3078":55057},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3626":1302,"_31224":1246,"_21623":55059,"_5":14874,"_28405":54907,"_3078":55060},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3626":1303,"_31224":1246,"_21623":55062,"_5":14874,"_28405":54907,"_3078":55063},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3626":1304,"_31224":1246,"_21623":55065,"_5":14874,"_28405":54907,"_3078":55066},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3626":1305,"_31224":1246,"_21623":55068,"_5":14874,"_28405":54907,"_3078":55069},[],"Make one request, save headers/body and query the device and certificates.",{"_3626":1306,"_31224":1246,"_21623":55071,"_5":14874,"_28405":54907,"_3078":55072},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3626":1307,"_31224":1246,"_21623":55074,"_5":14874,"_28405":54907,"_3078":55075},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified — including an OCSP Unknown status — is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3626":1308,"_31224":1246,"_21623":55077,"_5":14874,"_28405":54907,"_3078":55078},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3626":1309,"_31224":1309,"_5":15239,"_3078":55080,"_31582":55081,"_21623":55082,"_28405":1309},"Trust distribution and updates",[51011,52523,53695,53693,53879],[],{"_3626":1310,"_31224":1309,"_21623":55084,"_5":14874,"_28405":1309,"_3078":55085},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3626":1311,"_31224":1309,"_5":31579,"_21623":55087,"_28405":55088,"_3078":55089},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3626":1312,"_31224":1309,"_5":31579,"_21623":55091,"_28405":55092,"_3078":55093},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3626":1313,"_31224":1309,"_5":31579,"_21623":55095,"_28405":55096,"_3078":55097},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3626":1314,"_31224":1309,"_5":31579,"_21623":55099,"_28405":55100,"_3078":55101},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3626":1315,"_31224":1309,"_5":31579,"_21623":55103,"_28405":55104,"_3078":55105},[],"/docs/pr-preview/pr-76/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3626":1316,"_31224":1309,"_21623":55107,"_5":14874,"_28405":1309,"_3078":55108},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3626":1317,"_31224":1309,"_21623":55110,"_5":14874,"_28405":55088,"_3078":55111},[],"Relationship",{"_3626":1318,"_31224":1309,"_21623":55113,"_5":14874,"_28405":55088,"_3078":55114},[],"Material prepared by its owner",{"_3626":1319,"_31224":1309,"_21623":55116,"_5":14874,"_28405":55088,"_3078":55117},[],"Device → EST server",{"_3626":1320,"_31224":1309,"_21623":55119,"_5":14874,"_28405":55088,"_3078":55120},[],"Previously verified server root, chain or pin and TLS name.",{"_3626":1321,"_31224":1309,"_21623":55122,"_5":14874,"_28405":55088,"_3078":55123},[],"DMS → requester",{"_3626":1322,"_31224":1309,"_21623":55125,"_5":14874,"_28405":55088,"_3078":55126},[],"CAs and rules authorizing initial or renewal credentials.",{"_3626":1323,"_31224":1309,"_21623":55128,"_5":14874,"_28405":55088,"_3078":55129},[],"Consumer → device",{"_3626":1324,"_31224":1309,"_21623":55131,"_5":14874,"_28405":55088,"_3078":55132},[],"Operational identity roots, intermediates, validation and permissions.",{"_3626":1325,"_31224":1309,"_21623":55134,"_5":14874,"_28405":55088,"_3078":55135},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3626":1326,"_31224":1309,"_21623":55137,"_5":14874,"_28405":55092,"_3078":55138},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3626":1327,"_31224":1309,"_21623":55140,"_5":14874,"_28405":55092,"_3078":55141},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3626":1328,"_31224":1309,"_21623":55143,"_5":14874,"_28405":55096,"_3078":55144},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3626":1329,"_31224":1309,"_21623":55146,"_5":14874,"_28405":55096,"_3078":55147},[],"Select policy-approved roots as anchors.",{"_3626":1330,"_31224":1309,"_21623":55149,"_5":14874,"_28405":55096,"_3078":55150},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3626":1331,"_31224":1309,"_21623":55152,"_5":14874,"_28405":55096,"_3078":55153},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3626":1332,"_31224":1309,"_21623":55155,"_5":14874,"_28405":55096,"_3078":55156},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3626":1333,"_31224":1309,"_21623":55158,"_5":14874,"_28405":55096,"_3078":55159},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3626":1334,"_31224":1309,"_21623":55161,"_5":14874,"_28405":55100,"_3078":55162},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3626":1335,"_31224":1309,"_21623":55164,"_5":14874,"_28405":55100,"_3078":55165},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3626":1336,"_31224":1309,"_21623":55167,"_5":14874,"_28405":55100,"_3078":55168},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3626":1337,"_31224":1309,"_21623":55170,"_5":14874,"_28405":55104,"_3078":55171},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3626":1338,"_31224":1338,"_5":15239,"_3078":55173,"_31582":55174,"_21623":55176,"_28405":1338},"AWS IoT Core",[51011,52523,53695,53693,55175],"Integrations",[],{"_3626":1339,"_31224":1338,"_21623":55178,"_5":14874,"_28405":1338,"_3078":55179},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3626":1340,"_31224":1338,"_5":31579,"_21623":55181,"_28405":55182,"_3078":55183},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3626":1341,"_31224":1338,"_5":31579,"_21623":55185,"_28405":55186,"_3078":55187},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3626":1342,"_31224":1338,"_5":31579,"_21623":55189,"_28405":55190,"_3078":55191},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3626":1343,"_31224":1338,"_5":31579,"_21623":55193,"_28405":55194,"_3078":55195},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3626":1344,"_31224":1338,"_5":31579,"_21623":55197,"_28405":55198,"_3078":55199},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3626":1345,"_31224":1338,"_5":31579,"_21623":55201,"_28405":55202,"_3078":55203},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3626":1346,"_31224":1338,"_5":31579,"_21623":55205,"_28405":55206,"_3078":55207},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3626":1347,"_31224":1338,"_5":31579,"_21623":55209,"_28405":55210,"_3078":55211},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3626":1348,"_31224":1338,"_5":31579,"_21623":55213,"_28405":55214,"_3078":55215},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3626":1349,"_31224":1338,"_5":31579,"_21623":55217,"_28405":55218,"_3078":55219},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3626":1350,"_31224":1338,"_5":31579,"_21623":55221,"_28405":55222,"_3078":55223},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3626":1351,"_31224":1338,"_5":31579,"_21623":55225,"_28405":55226,"_3078":55227},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3626":1352,"_31224":1338,"_5":31579,"_21623":55229,"_28405":55230,"_3078":55231},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3626":1353,"_31224":1338,"_5":31579,"_21623":55233,"_28405":55234,"_3078":55235},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3626":1354,"_31224":1338,"_5":31579,"_21623":55237,"_28405":55238,"_3078":55239},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3626":1355,"_31224":1338,"_5":31579,"_21623":55241,"_28405":55242,"_3078":55243},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3626":1356,"_31224":1338,"_5":31579,"_21623":55245,"_28405":55246,"_3078":55247},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3626":1357,"_31224":1338,"_5":31579,"_21623":55249,"_28405":55250,"_3078":55251},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3626":1358,"_31224":1338,"_5":31579,"_21623":55253,"_28405":55254,"_3078":55255},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3626":1359,"_31224":1338,"_5":31579,"_21623":55257,"_28405":55258,"_3078":55259},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3626":1360,"_31224":1338,"_5":31579,"_21623":55261,"_28405":55262,"_3078":55263},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3626":1361,"_31224":1338,"_5":31579,"_21623":55265,"_28405":55266,"_3078":55267},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3626":1362,"_31224":1338,"_5":31579,"_21623":55269,"_28405":55270,"_3078":55271},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3626":1363,"_31224":1338,"_5":31579,"_21623":55273,"_28405":55274,"_3078":55275},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3626":1364,"_31224":1338,"_5":31579,"_21623":55277,"_28405":55278,"_3078":55279},[],"/docs/pr-preview/pr-76/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3626":1365,"_31224":1338,"_21623":55281,"_5":14874,"_28405":1338,"_3078":55282},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3626":1366,"_31224":1338,"_21623":55284,"_5":14874,"_28405":1338,"_3078":55285},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3626":1367,"_31224":1338,"_21623":55287,"_5":14874,"_28405":1338,"_3078":55288},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3626":1368,"_31224":1338,"_21623":55290,"_5":14874,"_28405":55182,"_3078":55291},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3626":1369,"_31224":1338,"_21623":55293,"_5":14874,"_28405":55182,"_3078":55294},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3626":1370,"_31224":1338,"_21623":55296,"_5":14874,"_28405":55182,"_3078":55297},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3626":1371,"_31224":1338,"_21623":55299,"_5":14874,"_28405":55182,"_3078":55300},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3626":1372,"_31224":1338,"_21623":55302,"_5":14874,"_28405":55186,"_3078":55303},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3626":1373,"_31224":1338,"_21623":55305,"_5":14874,"_28405":55190,"_3078":55306},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3626":1374,"_31224":1338,"_21623":55308,"_5":14874,"_28405":55190,"_3078":55309},[],"IAM action",{"_3626":1375,"_31224":1338,"_21623":55311,"_5":14874,"_28405":55190,"_3078":51401},[],{"_3626":1376,"_31224":1338,"_21623":55313,"_5":14874,"_28405":55190,"_3078":55314},[],"`iot:GetRegistrationCode`",{"_3626":1377,"_31224":1338,"_21623":55316,"_5":14874,"_28405":55190,"_3078":55317},[],"Obtain the verification code for CA registration in the Primary Account",{"_3626":1378,"_31224":1338,"_21623":55319,"_5":14874,"_28405":55190,"_3078":55320},[],"`iot:RegisterCACertificate`",{"_3626":1379,"_31224":1338,"_21623":55322,"_5":14874,"_28405":55190,"_3078":55323},[],"Register the CA in AWS IoT",{"_3626":1380,"_31224":1338,"_21623":55325,"_5":14874,"_28405":55190,"_3078":55326},[],"`iot:DescribeCACertificate`",{"_3626":1381,"_31224":1338,"_21623":55328,"_5":14874,"_28405":55190,"_3078":55329},[],"Check the CA registration status",{"_3626":1382,"_31224":1338,"_21623":55331,"_5":14874,"_28405":55190,"_3078":55332},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3626":1383,"_31224":1338,"_21623":55334,"_5":14874,"_28405":55190,"_3078":55335},[],"Create or update Things in IoT Core",{"_3626":1384,"_31224":1338,"_21623":55337,"_5":14874,"_28405":55190,"_3078":55338},[],"`iot:RegisterThing`",{"_3626":1385,"_31224":1338,"_21623":55340,"_5":14874,"_28405":55190,"_3078":55341},[],"Provision Things through a template",{"_3626":1386,"_31224":1338,"_21623":55343,"_5":14874,"_28405":55190,"_3078":55344},[],"`iot:RegisterCertificate`",{"_3626":1387,"_31224":1338,"_21623":55346,"_5":14874,"_28405":55190,"_3078":55347},[],"Register device certificates",{"_3626":1388,"_31224":1338,"_21623":55349,"_5":14874,"_28405":55190,"_3078":55350},[],"`iot:UpdateCertificate`",{"_3626":1389,"_31224":1338,"_21623":55352,"_5":14874,"_28405":55190,"_3078":55353},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3626":1390,"_31224":1338,"_21623":55355,"_5":14874,"_28405":55190,"_3078":55356},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3626":1391,"_31224":1338,"_21623":55358,"_5":14874,"_28405":55190,"_3078":55359},[],"Create and attach IoT policies",{"_3626":1392,"_31224":1338,"_21623":55361,"_5":14874,"_28405":55190,"_3078":55362},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3626":1393,"_31224":1338,"_21623":55364,"_5":14874,"_28405":55190,"_3078":55365},[],"Manage Thing groups",{"_3626":1394,"_31224":1338,"_21623":55367,"_5":14874,"_28405":55190,"_3078":55368},[],"`iot:CreateProvisioningTemplate`",{"_3626":1395,"_31224":1338,"_21623":55370,"_5":14874,"_28405":55190,"_3078":55371},[],"Create JITP templates",{"_3626":1396,"_31224":1338,"_21623":55373,"_5":14874,"_28405":55190,"_3078":55374},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3626":1397,"_31224":1338,"_21623":55376,"_5":14874,"_28405":55190,"_3078":55377},[],"Read and write the Device Shadow",{"_3626":1398,"_31224":1338,"_21623":55379,"_5":14874,"_28405":55190,"_3078":55380},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3626":1399,"_31224":1338,"_21623":55382,"_5":14874,"_28405":55194,"_3078":55383},[],"Parameter",{"_3626":1400,"_31224":1338,"_21623":55385,"_5":14874,"_28405":55194,"_3078":55386},[],"Type",{"_3626":1401,"_31224":1338,"_21623":55388,"_5":14874,"_28405":55194,"_3078":55389},[],"Required",{"_3626":1402,"_31224":1338,"_21623":55391,"_5":14874,"_28405":55194,"_3078":55392},[],"Description",{"_3626":1403,"_31224":1338,"_21623":55394,"_5":14874,"_28405":55194,"_3078":55395},[],"`connector_id`",{"_3626":1404,"_31224":1338,"_21623":55397,"_5":14874,"_28405":55194,"_3078":25814},[],{"_3626":1405,"_31224":1338,"_21623":55399,"_5":14874,"_28405":55194,"_3078":55400},[],"Yes",{"_3626":1406,"_31224":1338,"_21623":55402,"_5":14874,"_28405":55194,"_3078":55403},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3626":1407,"_31224":1338,"_21623":55405,"_5":14874,"_28405":55194,"_3078":55406},[],"`aws_config.region`",{"_3626":1408,"_31224":1338,"_21623":55408,"_5":14874,"_28405":55194,"_3078":25814},[],{"_3626":1409,"_31224":1338,"_21623":55410,"_5":14874,"_28405":55194,"_3078":55400},[],{"_3626":1410,"_31224":1338,"_21623":55412,"_5":14874,"_28405":55194,"_3078":55413},[],"AWS region where the connector operates.",{"_3626":1411,"_31224":1338,"_21623":55415,"_5":14874,"_28405":55194,"_3078":55416},[],"`aws_config.auth_method`",{"_3626":1412,"_31224":1338,"_21623":55418,"_5":14874,"_28405":55194,"_3078":25814},[],{"_3626":1413,"_31224":1338,"_21623":55420,"_5":14874,"_28405":55194,"_3078":55400},[],{"_3626":1414,"_31224":1338,"_21623":55422,"_5":14874,"_28405":55194,"_3078":55423},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3626":1415,"_31224":1338,"_21623":55425,"_5":14874,"_28405":55194,"_3078":55426},[],"`aws_config.access_key_id`",{"_3626":1416,"_31224":1338,"_21623":55428,"_5":14874,"_28405":55194,"_3078":25814},[],{"_3626":1417,"_31224":1338,"_21623":55430,"_5":14874,"_28405":55194,"_3078":55431},[],"Only with `auth_method=static`",{"_3626":1418,"_31224":1338,"_21623":55433,"_5":14874,"_28405":55194,"_3078":55434},[],"AWS access key.",{"_3626":1419,"_31224":1338,"_21623":55436,"_5":14874,"_28405":55194,"_3078":55437},[],"`aws_config.secret_access_key`",{"_3626":1420,"_31224":1338,"_21623":55439,"_5":14874,"_28405":55194,"_3078":25814},[],{"_3626":1421,"_31224":1338,"_21623":55441,"_5":14874,"_28405":55194,"_3078":55431},[],{"_3626":1422,"_31224":1338,"_21623":55443,"_5":14874,"_28405":55194,"_3078":55444},[],"AWS secret key.",{"_3626":1423,"_31224":1338,"_21623":55446,"_5":14874,"_28405":55194,"_3078":55447},[],"`aws_config.session_token`",{"_3626":1424,"_31224":1338,"_21623":55449,"_5":14874,"_28405":55194,"_3078":25814},[],{"_3626":1425,"_31224":1338,"_21623":55451,"_5":14874,"_28405":55194,"_3078":55452},[],"No",{"_3626":1426,"_31224":1338,"_21623":55454,"_5":14874,"_28405":55194,"_3078":55455},[],"Session token (with `auth_method=static`).",{"_3626":1427,"_31224":1338,"_21623":55457,"_5":14874,"_28405":55194,"_3078":55458},[],"`aws_config.role_arn`",{"_3626":1428,"_31224":1338,"_21623":55460,"_5":14874,"_28405":55194,"_3078":25814},[],{"_3626":1429,"_31224":1338,"_21623":55462,"_5":14874,"_28405":55194,"_3078":55463},[],"Only with `auth_method=role`",{"_3626":1430,"_31224":1338,"_21623":55465,"_5":14874,"_28405":55194,"_3078":55466},[],"ARN of the role to assume.",{"_3626":1431,"_31224":1338,"_21623":55468,"_5":14874,"_28405":55194,"_3078":55469},[],"`aws_config.endpoint_url`",{"_3626":1432,"_31224":1338,"_21623":55471,"_5":14874,"_28405":55194,"_3078":25814},[],{"_3626":1433,"_31224":1338,"_21623":55473,"_5":14874,"_28405":55194,"_3078":55452},[],{"_3626":1434,"_31224":1338,"_21623":55475,"_5":14874,"_28405":55194,"_3078":55476},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3626":1435,"_31224":1338,"_21623":55478,"_5":14874,"_28405":55194,"_3078":55479},[],"`subscriber_event_bus`",{"_3626":1436,"_31224":1338,"_21623":55481,"_5":14874,"_28405":55194,"_3078":18231},[],{"_3626":1437,"_31224":1338,"_21623":55483,"_5":14874,"_28405":55194,"_3078":55400},[],{"_3626":1438,"_31224":1338,"_21623":55485,"_5":14874,"_28405":55194,"_3078":55486},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3626":1439,"_31224":1338,"_21623":55488,"_5":14874,"_28405":55194,"_3078":55489},[],"`dms_manager_client`",{"_3626":1440,"_31224":1338,"_21623":55491,"_5":14874,"_28405":55194,"_3078":25814},[],{"_3626":1441,"_31224":1338,"_21623":55493,"_5":14874,"_28405":55194,"_3078":55400},[],{"_3626":1442,"_31224":1338,"_21623":55495,"_5":14874,"_28405":55194,"_3078":55496},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3626":1443,"_31224":1338,"_21623":55498,"_5":14874,"_28405":55194,"_3078":55499},[],"`device_manager_client`",{"_3626":1444,"_31224":1338,"_21623":55501,"_5":14874,"_28405":55194,"_3078":25814},[],{"_3626":1445,"_31224":1338,"_21623":55503,"_5":14874,"_28405":55194,"_3078":55400},[],{"_3626":1446,"_31224":1338,"_21623":55505,"_5":14874,"_28405":55194,"_3078":55506},[],"HTTP URL of Lamassu's Device Manager.",{"_3626":1447,"_31224":1338,"_21623":55508,"_5":14874,"_28405":55194,"_3078":55509},[],"`ca_client`",{"_3626":1448,"_31224":1338,"_21623":55511,"_5":14874,"_28405":55194,"_3078":25814},[],{"_3626":1449,"_31224":1338,"_21623":55513,"_5":14874,"_28405":55194,"_3078":55400},[],{"_3626":1450,"_31224":1338,"_21623":55515,"_5":14874,"_28405":55194,"_3078":55516},[],"HTTP URL of Lamassu's CA service.",{"_3626":1451,"_31224":1338,"_21623":55518,"_5":14874,"_28405":55198,"_3078":55519},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3626":1452,"_31224":1338,"_21623":55521,"_5":14874,"_28405":55198,"_3078":55522},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3626":1453,"_31224":1338,"_21623":55524,"_5":14874,"_28405":55198,"_3078":55525},[],"CloudEvent type",{"_3626":1454,"_31224":1338,"_21623":55527,"_5":14874,"_28405":55198,"_3078":55528},[],"Lamassu resource",{"_3626":1455,"_31224":1338,"_21623":55530,"_5":14874,"_28405":55198,"_3078":55531},[],"AWS Resource",{"_3626":1456,"_31224":1338,"_21623":55533,"_5":14874,"_28405":55198,"_3078":55534},[],"IAM actions",{"_3626":1457,"_31224":1338,"_21623":55536,"_5":14874,"_28405":55198,"_3078":55537},[],"AWS calls and effect",{"_3626":1458,"_31224":1338,"_21623":55539,"_5":14874,"_28405":55198,"_3078":55540},[],"Where in this page",{"_3626":1459,"_31224":1338,"_21623":55542,"_5":14874,"_28405":55198,"_3078":55543},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3626":1460,"_31224":1338,"_21623":55545,"_5":14874,"_28405":55198,"_3078":55546},[],"CA",{"_3626":1461,"_31224":1338,"_21623":55548,"_5":14874,"_28405":55198,"_3078":55549},[],"`IoTCore/CACertificate`",{"_3626":1462,"_31224":1338,"_21623":55551,"_5":14874,"_28405":55198,"_3078":55552},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3626":1463,"_31224":1338,"_21623":55554,"_5":14874,"_28405":55198,"_3078":55555},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3626":1464,"_31224":1338,"_21623":55557,"_5":14874,"_28405":55198,"_3078":55211},[],{"_3626":1465,"_31224":1338,"_21623":55559,"_5":14874,"_28405":55198,"_3078":55560},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3626":1466,"_31224":1338,"_21623":55562,"_5":14874,"_28405":55198,"_3078":55563},[],"DMS",{"_3626":1467,"_31224":1338,"_21623":55565,"_5":14874,"_28405":55198,"_3078":55566},[],"`IoTCore/ProvisioningTemplate`",{"_3626":1468,"_31224":1338,"_21623":55568,"_5":14874,"_28405":55198,"_3078":55569},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3626":1469,"_31224":1338,"_21623":55571,"_5":14874,"_28405":55198,"_3078":55572},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3626":1470,"_31224":1338,"_21623":55574,"_5":14874,"_28405":55198,"_3078":55239},[],{"_3626":1471,"_31224":1338,"_21623":55576,"_5":14874,"_28405":55198,"_3078":55577},[],"`EventBindDeviceIdentityKey`",{"_3626":1472,"_31224":1338,"_21623":55579,"_5":14874,"_28405":55198,"_3078":55580},[],"Device",{"_3626":1473,"_31224":1338,"_21623":55582,"_5":14874,"_28405":55198,"_3078":55583},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3626":1474,"_31224":1338,"_21623":55585,"_5":14874,"_28405":55198,"_3078":55586},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3626":1475,"_31224":1338,"_21623":55588,"_5":14874,"_28405":55198,"_3078":55589},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3626":1476,"_31224":1338,"_21623":55591,"_5":14874,"_28405":55198,"_3078":55247},[],{"_3626":1477,"_31224":1338,"_21623":55593,"_5":14874,"_28405":55198,"_3078":55594},[],"`EventUpdateCertificateStatusKey`",{"_3626":1478,"_31224":1338,"_21623":55596,"_5":14874,"_28405":55198,"_3078":55597},[],"Certificate",{"_3626":1479,"_31224":1338,"_21623":55599,"_5":14874,"_28405":55198,"_3078":55600},[],"`IoTCore/Certificate`",{"_3626":1480,"_31224":1338,"_21623":55602,"_5":14874,"_28405":55198,"_3078":55603},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3626":1481,"_31224":1338,"_21623":55605,"_5":14874,"_28405":55198,"_3078":55606},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3626":1482,"_31224":1338,"_21623":55608,"_5":14874,"_28405":55198,"_3078":55259},[],{"_3626":1483,"_31224":1338,"_21623":55610,"_5":14874,"_28405":55198,"_3078":55611},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3626":1484,"_31224":1338,"_21623":55613,"_5":14874,"_28405":55198,"_3078":55614},[],"Certificate / Device",{"_3626":1485,"_31224":1338,"_21623":55616,"_5":14874,"_28405":55198,"_3078":55617},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3626":1486,"_31224":1338,"_21623":55619,"_5":14874,"_28405":55198,"_3078":51407},[],{"_3626":1487,"_31224":1338,"_21623":55621,"_5":14874,"_28405":55198,"_3078":55622},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3626":1488,"_31224":1338,"_21623":55624,"_5":14874,"_28405":55198,"_3078":55267},[],{"_3626":1489,"_31224":1338,"_21623":55626,"_5":14874,"_28405":55202,"_3078":55627},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3626":1490,"_31224":1338,"_21623":55629,"_5":14874,"_28405":55206,"_3078":55630},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3626":1491,"_31224":1338,"_21623":55632,"_5":14874,"_28405":55206,"_3078":55633},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3626":1492,"_31224":1338,"_21623":55635,"_5":14874,"_28405":55210,"_3078":55636},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3626":1493,"_31224":1338,"_21623":55638,"_5":14874,"_28405":55210,"_3078":55639},[],"Transition",{"_3626":1494,"_31224":1338,"_21623":55641,"_5":14874,"_28405":55210,"_3078":55642},[],"AWS calls",{"_3626":1495,"_31224":1338,"_21623":55644,"_5":14874,"_28405":55210,"_3078":55645},[],"`NotRegistered` → `Requested`",{"_3626":1496,"_31224":1338,"_21623":55647,"_5":14874,"_28405":55210,"_3078":55648},[],"none (metadata write only)",{"_3626":1497,"_31224":1338,"_21623":55650,"_5":14874,"_28405":55210,"_3078":55651},[],"`Requested` → `Registering`",{"_3626":1498,"_31224":1338,"_21623":55653,"_5":14874,"_28405":55210,"_3078":55654},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3626":1499,"_31224":1338,"_21623":55656,"_5":14874,"_28405":55210,"_3078":55657},[],"`Registering` → `Succeeded`",{"_3626":1500,"_31224":1338,"_21623":55659,"_5":14874,"_28405":55210,"_3078":55660},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3626":1501,"_31224":1338,"_21623":55662,"_5":14874,"_28405":55210,"_3078":55663},[],"`Registering` → `Failed`",{"_3626":1502,"_31224":1338,"_21623":55665,"_5":14874,"_28405":55210,"_3078":55666},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3626":1503,"_31224":1338,"_21623":55668,"_5":14874,"_28405":55210,"_3078":55669},[],"`Failed` / `Succeeded` → `Requested`",{"_3626":1504,"_31224":1338,"_21623":55671,"_5":14874,"_28405":55210,"_3078":55672},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3626":1505,"_31224":1338,"_21623":55674,"_5":14874,"_28405":55214,"_3078":55675},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3626":1506,"_31224":1338,"_21623":55677,"_5":14874,"_28405":55214,"_3078":55678},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3626":1507,"_31224":1338,"_21623":55680,"_5":14874,"_28405":55214,"_3078":55681},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3626":1508,"_31224":1338,"_21623":55683,"_5":14874,"_28405":55214,"_3078":55684},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3626":1509,"_31224":1338,"_21623":55686,"_5":14874,"_28405":55214,"_3078":55687},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3626":1510,"_31224":1338,"_21623":55689,"_5":14874,"_28405":55214,"_3078":55690},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3626":1511,"_31224":1338,"_21623":55692,"_5":14874,"_28405":55218,"_3078":55693},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3626":1512,"_31224":1338,"_21623":55695,"_5":14874,"_28405":55222,"_3078":55696},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3626":1513,"_31224":1338,"_21623":55698,"_5":14874,"_28405":55222,"_3078":55699},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3626":1514,"_31224":1338,"_21623":55701,"_5":14874,"_28405":55226,"_3078":55702},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3626":1515,"_31224":1338,"_21623":55704,"_5":14874,"_28405":55230,"_3078":55705},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3626":1516,"_31224":1338,"_21623":55707,"_5":14874,"_28405":55230,"_3078":55708},[],"Creates or updates the IoT policies configured in the DMS.",{"_3626":1517,"_31224":1338,"_21623":55710,"_5":14874,"_28405":55230,"_3078":55711},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3626":1518,"_31224":1338,"_21623":55713,"_5":14874,"_28405":55230,"_3078":55714},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3626":1519,"_31224":1338,"_21623":55716,"_5":14874,"_28405":55230,"_3078":55717},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3626":1520,"_31224":1338,"_21623":55719,"_5":14874,"_28405":55230,"_3078":55720},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3626":1521,"_31224":1338,"_21623":55722,"_5":14874,"_28405":55230,"_3078":55723},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3626":1522,"_31224":1338,"_21623":55725,"_5":14874,"_28405":55234,"_3078":55726},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3626":1523,"_31224":1338,"_21623":55728,"_5":14874,"_28405":55234,"_3078":55729},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3626":1524,"_31224":1338,"_21623":55731,"_5":14874,"_28405":55234,"_3078":55732},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3626":1525,"_31224":1338,"_21623":55734,"_5":14874,"_28405":55234,"_3078":55735},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3626":1526,"_31224":1338,"_21623":55737,"_5":14874,"_28405":55234,"_3078":55738},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3626":1527,"_31224":1338,"_21623":55740,"_5":14874,"_28405":55238,"_3078":55741},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3626":1528,"_31224":1338,"_21623":55743,"_5":14874,"_28405":55238,"_3078":55639},[],{"_3626":1529,"_31224":1338,"_21623":55745,"_5":14874,"_28405":55238,"_3078":55642},[],{"_3626":1530,"_31224":1338,"_21623":55747,"_5":14874,"_28405":55238,"_3078":55748},[],"`Unconfigured` → `None` / `Auto`",{"_3626":1531,"_31224":1338,"_21623":55750,"_5":14874,"_28405":55238,"_3078":55751},[],"none (configuration only)",{"_3626":1532,"_31224":1338,"_21623":55753,"_5":14874,"_28405":55238,"_3078":55754},[],"`None` ↔ `Auto`",{"_3626":1533,"_31224":1338,"_21623":55756,"_5":14874,"_28405":55238,"_3078":55751},[],{"_3626":1534,"_31224":1338,"_21623":55758,"_5":14874,"_28405":55238,"_3078":55759},[],"Any → `Jitp`",{"_3626":1535,"_31224":1338,"_21623":55761,"_5":14874,"_28405":55238,"_3078":55762},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3626":1536,"_31224":1338,"_21623":55764,"_5":14874,"_28405":55238,"_3078":55765},[],"`Jitp` → `None` / `Auto`",{"_3626":1537,"_31224":1338,"_21623":55767,"_5":14874,"_28405":55238,"_3078":55768},[],"none (the template stays in the AWS account)",{"_3626":1538,"_31224":1338,"_21623":55770,"_5":14874,"_28405":55242,"_3078":55771},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3626":1539,"_31224":1338,"_21623":55773,"_5":14874,"_28405":55242,"_3078":55774},[],"The full flow from the device's perspective is:",{"_3626":1540,"_31224":1338,"_21623":55776,"_5":14874,"_28405":55242,"_3078":55777},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3626":1541,"_31224":1338,"_21623":55779,"_5":14874,"_28405":55246,"_3078":55780},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3626":1542,"_31224":1338,"_21623":55782,"_5":14874,"_28405":55246,"_3078":55639},[],{"_3626":1543,"_31224":1338,"_21623":55784,"_5":14874,"_28405":55246,"_3078":55642},[],{"_3626":1544,"_31224":1338,"_21623":55786,"_5":14874,"_28405":55246,"_3078":55787},[],"`Absent` → `Provisioned`",{"_3626":1545,"_31224":1338,"_21623":55789,"_5":14874,"_28405":55246,"_3078":55790},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3626":1546,"_31224":1338,"_21623":55792,"_5":14874,"_28405":55246,"_3078":55793},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3626":1547,"_31224":1338,"_21623":55795,"_5":14874,"_28405":55246,"_3078":55796},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3626":1548,"_31224":1338,"_21623":55798,"_5":14874,"_28405":55246,"_3078":55799},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3626":1549,"_31224":1338,"_21623":55801,"_5":14874,"_28405":55250,"_3078":55802},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3626":1550,"_31224":1338,"_21623":55804,"_5":14874,"_28405":55250,"_3078":55805},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3626":1551,"_31224":1338,"_21623":55807,"_5":14874,"_28405":55250,"_3078":55808},[],"For the JITP flow to work correctly:",{"_3626":1552,"_31224":1338,"_21623":55810,"_5":14874,"_28405":55250,"_3078":55811},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3626":1553,"_31224":1338,"_21623":55813,"_5":14874,"_28405":55250,"_3078":55814},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3626":1554,"_31224":1338,"_21623":55816,"_5":14874,"_28405":55250,"_3078":55817},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3626":1555,"_31224":1338,"_21623":55819,"_5":14874,"_28405":55250,"_3078":55820},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3626":1556,"_31224":1338,"_21623":55822,"_5":14874,"_28405":55254,"_3078":55823},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3626":1557,"_31224":1338,"_21623":55825,"_5":14874,"_28405":55254,"_3078":55826},[],"Status in Lamassu",{"_3626":1558,"_31224":1338,"_21623":55828,"_5":14874,"_28405":55254,"_3078":55829},[],"Revocation reason",{"_3626":1559,"_31224":1338,"_21623":55831,"_5":14874,"_28405":55254,"_3078":55832},[],"Status in AWS IoT Core",{"_3626":1560,"_31224":1338,"_21623":55834,"_5":14874,"_28405":55254,"_3078":55835},[],"`Active`",{"_3626":1561,"_31224":1338,"_21623":55837,"_5":14874,"_28405":55254,"_3078":55838},[],"None",{"_3626":1562,"_31224":1338,"_21623":55840,"_5":14874,"_28405":55254,"_3078":55841},[],"`ACTIVE`",{"_3626":1563,"_31224":1338,"_21623":55843,"_5":14874,"_28405":55254,"_3078":55844},[],"`Revoked`",{"_3626":1564,"_31224":1338,"_21623":55846,"_5":14874,"_28405":55254,"_3078":55847},[],"`certificateHold`",{"_3626":1565,"_31224":1338,"_21623":55849,"_5":14874,"_28405":55254,"_3078":55850},[],"`INACTIVE`",{"_3626":1566,"_31224":1338,"_21623":55852,"_5":14874,"_28405":55254,"_3078":55844},[],{"_3626":1567,"_31224":1338,"_21623":55854,"_5":14874,"_28405":55254,"_3078":55855},[],"Any other reason",{"_3626":1568,"_31224":1338,"_21623":55857,"_5":14874,"_28405":55254,"_3078":55858},[],"`REVOKED`",{"_3626":1569,"_31224":1338,"_21623":55860,"_5":14874,"_28405":55254,"_3078":55861},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3626":1570,"_31224":1338,"_21623":55863,"_5":14874,"_28405":55258,"_3078":55864},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3626":1571,"_31224":1338,"_21623":55866,"_5":14874,"_28405":55258,"_3078":55639},[],{"_3626":1572,"_31224":1338,"_21623":55868,"_5":14874,"_28405":55258,"_3078":55642},[],{"_3626":1573,"_31224":1338,"_21623":55870,"_5":14874,"_28405":55258,"_3078":55871},[],"`NotSynced` → `Active`",{"_3626":1574,"_31224":1338,"_21623":55873,"_5":14874,"_28405":55258,"_3078":55350},[],{"_3626":1575,"_31224":1338,"_21623":55875,"_5":14874,"_28405":55258,"_3078":55876},[],"`Active` → `Inactive`",{"_3626":1576,"_31224":1338,"_21623":55878,"_5":14874,"_28405":55258,"_3078":55879},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3626":1577,"_31224":1338,"_21623":55881,"_5":14874,"_28405":55258,"_3078":55882},[],"`Active` → `Revoked`",{"_3626":1578,"_31224":1338,"_21623":55884,"_5":14874,"_28405":55258,"_3078":55879},[],{"_3626":1579,"_31224":1338,"_21623":55886,"_5":14874,"_28405":55258,"_3078":55887},[],"`Inactive` / `Revoked` → `Active`",{"_3626":1580,"_31224":1338,"_21623":55889,"_5":14874,"_28405":55258,"_3078":55350},[],{"_3626":1581,"_31224":1338,"_21623":55891,"_5":14874,"_28405":55258,"_3078":55892},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3626":1582,"_31224":1338,"_21623":55894,"_5":14874,"_28405":55258,"_3078":55895},[],"none (these states are not synced to AWS)",{"_3626":1583,"_31224":1338,"_21623":55897,"_5":14874,"_28405":55262,"_3078":55898},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3626":1584,"_31224":1338,"_21623":55900,"_5":14874,"_28405":55262,"_3078":55901},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3626":1585,"_31224":1338,"_21623":55903,"_5":14874,"_28405":55262,"_3078":55904},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3626":1586,"_31224":1338,"_21623":55906,"_5":14874,"_28405":55266,"_3078":55907},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3626":1587,"_31224":1338,"_21623":55909,"_5":14874,"_28405":55266,"_3078":55910},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3626":1588,"_31224":1338,"_21623":55912,"_5":14874,"_28405":55270,"_3078":55913},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3626":1589,"_31224":1338,"_21623":55915,"_5":14874,"_28405":55270,"_3078":55916},[],"There are two action types:",{"_3626":1590,"_31224":1338,"_21623":55918,"_5":14874,"_28405":55270,"_3078":55919},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3626":1591,"_31224":1338,"_21623":55921,"_5":14874,"_28405":55270,"_3078":55922},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3626":1592,"_31224":1338,"_21623":55924,"_5":14874,"_28405":55270,"_3078":55925},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3626":1593,"_31224":1338,"_21623":55927,"_5":14874,"_28405":55274,"_3078":55928},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3626":1594,"_31224":1338,"_21623":55930,"_5":14874,"_28405":55274,"_3078":55931},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3626":1595,"_31224":1338,"_21623":55933,"_5":14874,"_28405":55274,"_3078":55934},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3626":1596,"_31224":1338,"_21623":55936,"_5":14874,"_28405":55278,"_3078":55937},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3626":1597,"_31224":1338,"_21623":55939,"_5":14874,"_28405":55278,"_3078":55940},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3626":1598,"_31224":1338,"_21623":55942,"_5":14874,"_28405":55278,"_3078":55943},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3626":1599,"_31224":1338,"_21623":55945,"_5":14874,"_28405":55278,"_3078":55946},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3626":1600,"_31224":1338,"_21623":55948,"_5":14874,"_28405":55278,"_3078":55949},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3626":1601,"_31224":1338,"_21623":55951,"_5":14874,"_28405":55278,"_3078":55952},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3626":1602,"_31224":1338,"_21623":55954,"_5":14874,"_28405":55278,"_3078":55955},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3626":1603,"_31224":1338,"_21623":55957,"_5":14874,"_28405":55278,"_3078":55958},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3626":1604,"_31224":1338,"_21623":55960,"_5":14874,"_28405":55278,"_3078":55961},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3626":1605,"_31224":1338,"_21623":55963,"_5":14874,"_28405":55278,"_3078":55964},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3626":1606,"_31224":1338,"_21623":55966,"_5":14874,"_28405":55278,"_3078":55967},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3626":1607,"_31224":1338,"_21623":55969,"_5":14874,"_28405":55278,"_3078":55970},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3626":1608,"_31224":1338,"_21623":55972,"_5":14874,"_28405":55278,"_3078":55973},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3626":1609,"_31224":1338,"_21623":55975,"_5":14874,"_28405":55278,"_3078":55976},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3626":1610,"_31224":1338,"_21623":55978,"_5":14874,"_28405":55278,"_3078":55979},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3626":1611,"_31224":1338,"_21623":55981,"_5":14874,"_28405":55278,"_3078":55982},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3626":1612,"_31224":1338,"_21623":55984,"_5":14874,"_28405":55278,"_3078":55985},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3626":1613,"_31224":1338,"_21623":55987,"_5":14874,"_28405":55278,"_3078":55988},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3626":1614,"_31224":1338,"_21623":55990,"_5":14874,"_28405":55278,"_3078":55991},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3626":1615,"_31224":1338,"_21623":55993,"_5":14874,"_28405":55278,"_3078":55994},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3626":1616,"_31224":1338,"_21623":55996,"_5":14874,"_28405":55278,"_3078":55997},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3626":1617,"_31224":1338,"_21623":55999,"_5":14874,"_28405":55278,"_3078":56000},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3626":1618,"_31224":1338,"_21623":56002,"_5":14874,"_28405":55278,"_3078":56003},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3626":1619,"_31224":1338,"_21623":56005,"_5":14874,"_28405":55278,"_3078":56006},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3626":1620,"_31224":1620,"_5":15239,"_3078":53695,"_31582":56008,"_21623":56009,"_28405":1620},[51011,52523,53695],[],{"_3626":1621,"_31224":1620,"_21623":56011,"_5":14874,"_28405":1620,"_3078":56012},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3626":1622,"_31224":1620,"_5":31579,"_21623":56014,"_28405":56015,"_3078":56016},[],"/docs/pr-preview/pr-76/platform/iot-fleets/overview#start-here","Start here",{"_3626":1623,"_31224":1620,"_5":31579,"_21623":56018,"_28405":56019,"_3078":53693},[],"/docs/pr-preview/pr-76/platform/iot-fleets/overview#devices-and-identities",{"_3626":1624,"_31224":1620,"_5":31579,"_21623":56021,"_28405":56022,"_3078":53879},[],"/docs/pr-preview/pr-76/platform/iot-fleets/overview#enrollment-with-pki",{"_3626":1625,"_31224":1620,"_5":31579,"_21623":56024,"_28405":56025,"_3078":55175},[],"/docs/pr-preview/pr-76/platform/iot-fleets/overview#integrations",{"_3626":1626,"_31224":1620,"_5":31579,"_21623":56027,"_28405":56028,"_3078":56029},[],"/docs/pr-preview/pr-76/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3626":1627,"_31224":1620,"_21623":56031,"_5":14874,"_28405":1620,"_3078":56032},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3626":1628,"_31224":1620,"_21623":56034,"_5":14874,"_28405":56015,"_3078":56035},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3626":1629,"_31224":1620,"_21623":56037,"_5":14874,"_28405":56015,"_3078":56038},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3626":1630,"_31224":1620,"_21623":56040,"_5":14874,"_28405":56019,"_3078":56041},[],"Resource",{"_3626":1631,"_31224":1620,"_21623":56043,"_5":14874,"_28405":56019,"_3078":56044},[],"What it represents",{"_3626":1632,"_31224":1620,"_21623":56046,"_5":14874,"_28405":56019,"_3078":56047},[],"**Device**",{"_3626":1633,"_31224":1620,"_21623":56049,"_5":14874,"_28405":56019,"_3078":56050},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3626":1634,"_31224":1620,"_21623":56052,"_5":14874,"_28405":56019,"_3078":56053},[],"**Identity**",{"_3626":1635,"_31224":1620,"_21623":56055,"_5":14874,"_28405":56019,"_3078":56056},[],"The device's association with its certificates: an active version and a history.",{"_3626":1636,"_31224":1620,"_21623":56058,"_5":14874,"_28405":56019,"_3078":56059},[],"**DMS**",{"_3626":1637,"_31224":1620,"_21623":56061,"_5":14874,"_28405":56019,"_3078":56062},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3626":1638,"_31224":1620,"_21623":56064,"_5":14874,"_28405":56019,"_3078":56065},[],"**Fleet**",{"_3626":1639,"_31224":1620,"_21623":56067,"_5":14874,"_28405":56019,"_3078":56068},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3626":1640,"_31224":1620,"_21623":56070,"_5":14874,"_28405":56019,"_3078":56071},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3626":1641,"_31224":1620,"_21623":56073,"_5":14874,"_28405":56019,"_3078":56074},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3626":1642,"_31224":1620,"_21623":56076,"_5":14874,"_28405":56022,"_3078":56077},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3626":1643,"_31224":1620,"_21623":56079,"_5":14874,"_28405":56022,"_3078":56080},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3626":1644,"_31224":1620,"_21623":56082,"_5":14874,"_28405":56022,"_3078":56083},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3626":1645,"_31224":1620,"_21623":56085,"_5":14874,"_28405":56022,"_3078":56086},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3626":1646,"_31224":1620,"_21623":56088,"_5":14874,"_28405":56022,"_3078":56089},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3626":1647,"_31224":1620,"_21623":56091,"_5":14874,"_28405":56022,"_3078":56092},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3626":1648,"_31224":1620,"_21623":56094,"_5":14874,"_28405":56022,"_3078":56095},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3626":1649,"_31224":1620,"_21623":56097,"_5":14874,"_28405":56022,"_3078":56098},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3626":1650,"_31224":1620,"_21623":56100,"_5":14874,"_28405":56025,"_3078":56101},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3626":1651,"_31224":1620,"_21623":56103,"_5":14874,"_28405":56025,"_3078":56104},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3626":1652,"_31224":1620,"_21623":56106,"_5":14874,"_28405":56028,"_3078":56107},[],"Participant",{"_3626":1653,"_31224":1620,"_21623":56109,"_5":14874,"_28405":56028,"_3078":56110},[],"Responsibility",{"_3626":1654,"_31224":1620,"_21623":56112,"_5":14874,"_28405":56028,"_3078":56113},[],"PKI administrator",{"_3626":1655,"_31224":1620,"_21623":56115,"_5":14874,"_28405":56028,"_3078":56116},[],"CA, issuance profile, chain and revocation publication.",{"_3626":1656,"_31224":1620,"_21623":56118,"_5":14874,"_28405":56028,"_3078":56119},[],"Provisioning administrator",{"_3626":1657,"_31224":1620,"_21623":56121,"_5":14874,"_28405":56028,"_3078":56122},[],"DMS, admission, authentication per operation and inventory.",{"_3626":1658,"_31224":1620,"_21623":56124,"_5":14874,"_28405":56028,"_3078":56125},[],"Device integrator",{"_3626":1659,"_31224":1620,"_21623":56127,"_5":14874,"_28405":56028,"_3078":56128},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3626":1660,"_31224":1620,"_21623":56130,"_5":14874,"_28405":56028,"_3078":56131},[],"Consumer integrator",{"_3626":1661,"_31224":1620,"_21623":56133,"_5":14874,"_28405":56028,"_3078":56134},[],"Trusted issuers, validation and device permissions in the destination.",{"_3626":1662,"_31224":1620,"_21623":56136,"_5":14874,"_28405":56028,"_3078":56137},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3626":1663,"_31224":1663,"_5":15239,"_3078":56139,"_31582":56140,"_21623":56142,"_28405":1663},"Enroll and connect your first device",[51011,52523,53695,56141],"Getting started",[],{"_3626":1664,"_31224":1663,"_21623":56144,"_5":14874,"_28405":1663,"_3078":56145},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3626":1665,"_31224":1663,"_5":31579,"_21623":56147,"_28405":56148,"_3078":51021},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3626":1666,"_31224":1663,"_5":31579,"_21623":56150,"_28405":56151,"_3078":56152},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3626":1667,"_31224":1663,"_5":31579,"_21623":56154,"_28405":56155,"_3078":56156},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3626":1668,"_31224":1663,"_5":31579,"_21623":56158,"_28405":56159,"_3078":56160},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3626":1669,"_31224":1663,"_5":31579,"_21623":56162,"_28405":56163,"_3078":56164},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3626":1670,"_31224":1663,"_5":31579,"_21623":56166,"_28405":56167,"_3078":56168},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3626":1671,"_31224":1663,"_5":31579,"_21623":56170,"_28405":56171,"_3078":56172},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3626":1672,"_31224":1663,"_5":31579,"_21623":56174,"_28405":56175,"_3078":56176},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3626":1673,"_31224":1663,"_21623":56178,"_5":14874,"_28405":1663,"_3078":56179},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3626":1674,"_31224":1663,"_21623":56181,"_5":14874,"_28405":56148,"_3078":56182},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3626":1675,"_31224":1663,"_21623":56184,"_5":14874,"_28405":56148,"_3078":56185},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3626":1676,"_31224":1663,"_21623":56187,"_5":14874,"_28405":56148,"_3078":56188},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3626":1677,"_31224":1663,"_21623":56190,"_5":14874,"_28405":56148,"_3078":56191},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3626":1678,"_31224":1663,"_21623":56193,"_5":14874,"_28405":56148,"_3078":56194},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3626":1679,"_31224":1663,"_21623":56196,"_5":14874,"_28405":56151,"_3078":56197},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3626":1680,"_31224":1663,"_21623":56199,"_5":14874,"_28405":56151,"_3078":56200},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3626":1681,"_31224":1663,"_21623":56202,"_5":14874,"_28405":56155,"_3078":56203},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3626":1682,"_31224":1663,"_21623":56205,"_5":14874,"_28405":56155,"_3078":56206},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3626":1683,"_31224":1663,"_21623":56208,"_5":14874,"_28405":56155,"_3078":56209},[],"Setting",{"_3626":1684,"_31224":1663,"_21623":56211,"_5":14874,"_28405":56155,"_3078":56212},[],"Evaluation value",{"_3626":1685,"_31224":1663,"_21623":56214,"_5":14874,"_28405":56155,"_3078":56215},[],"Enrollment CA",{"_3626":1686,"_31224":1663,"_21623":56217,"_5":14874,"_28405":56155,"_3078":56218},[],"Issuing root from `device-root.pem`.",{"_3626":1687,"_31224":1663,"_21623":56220,"_5":14874,"_28405":56155,"_3078":54015},[],{"_3626":1688,"_31224":1663,"_21623":56222,"_5":14874,"_28405":56155,"_3078":56223},[],"The 1-hour leaf profile you just prepared.",{"_3626":1689,"_31224":1663,"_21623":56225,"_5":14874,"_28405":56155,"_3078":56226},[],"Protocol / Registration Mode",{"_3626":1690,"_31224":1663,"_21623":56228,"_5":14874,"_28405":56155,"_3078":56229},[],"`EST_RFC7030` / `JITP`.",{"_3626":1691,"_31224":1663,"_21623":56231,"_5":14874,"_28405":56155,"_3078":56232},[],"Verify CSR Signature",{"_3626":1692,"_31224":1663,"_21623":56234,"_5":14874,"_28405":56155,"_3078":56235},[],"Enabled.",{"_3626":1693,"_31224":1663,"_21623":56237,"_5":14874,"_28405":56155,"_3078":56238},[],"Enable Replaceable Enrollment",{"_3626":1694,"_31224":1663,"_21623":56240,"_5":14874,"_28405":56155,"_3078":56241},[],"Disabled; the ID must be new.",{"_3626":1695,"_31224":1663,"_21623":56243,"_5":14874,"_28405":56155,"_3078":56244},[],"Initial authentication",{"_3626":1696,"_31224":1663,"_21623":56246,"_5":14874,"_28405":56155,"_3078":56247},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3626":1697,"_31224":1663,"_21623":56249,"_5":14874,"_28405":56155,"_3078":56250},[],"Renewal authentication",{"_3626":1698,"_31224":1663,"_21623":56252,"_5":14874,"_28405":56155,"_3078":56253},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3626":1699,"_31224":1663,"_21623":56255,"_5":14874,"_28405":56155,"_3078":56256},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3626":1700,"_31224":1663,"_21623":56258,"_5":14874,"_28405":56155,"_3078":56259},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3626":1701,"_31224":1663,"_21623":56261,"_5":14874,"_28405":56155,"_3078":56262},[],"Re-enrollment Delta",{"_3626":1702,"_31224":1663,"_21623":56264,"_5":14874,"_28405":56155,"_3078":56265},[],"1 hour.",{"_3626":1703,"_31224":1663,"_21623":56267,"_5":14874,"_28405":56155,"_3078":56268},[],"Preventive / Critical Delta",{"_3626":1704,"_31224":1663,"_21623":56270,"_5":14874,"_28405":56155,"_3078":56271},[],"30 minutes / 10 minutes.",{"_3626":1705,"_31224":1663,"_21623":56273,"_5":14874,"_28405":56155,"_3078":56274},[],"Revoke on Re-enrollment",{"_3626":1706,"_31224":1663,"_21623":56276,"_5":14874,"_28405":56155,"_3078":56277},[],"Disabled to test the successor before retiring the previous identity.",{"_3626":1707,"_31224":1663,"_21623":56279,"_5":14874,"_28405":56155,"_3078":54023},[],{"_3626":1708,"_31224":1663,"_21623":56281,"_5":14874,"_28405":56155,"_3078":56282},[],"Disabled; the operational key is generated in the client.",{"_3626":1709,"_31224":1663,"_21623":56284,"_5":14874,"_28405":56155,"_3078":56285},[],"CA Distribution",{"_3626":1710,"_31224":1663,"_21623":56287,"_5":14874,"_28405":56155,"_3078":56288},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3626":1711,"_31224":1663,"_21623":56290,"_5":14874,"_28405":56155,"_3078":56291},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3626":1712,"_31224":1663,"_21623":56293,"_5":14874,"_28405":56159,"_3078":56294},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3626":1713,"_31224":1663,"_21623":56296,"_5":14874,"_28405":56159,"_3078":56297},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3626":1714,"_31224":1663,"_21623":56299,"_5":14874,"_28405":56163,"_3078":56300},[],"Generate a new key and CSR with the selected identifier:",{"_3626":1715,"_31224":1663,"_21623":56302,"_5":14874,"_28405":56163,"_3078":56303},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3626":1716,"_31224":1663,"_21623":56305,"_5":14874,"_28405":56163,"_3078":56306},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3626":1717,"_31224":1663,"_21623":56308,"_5":14874,"_28405":56167,"_3078":56309},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3626":1718,"_31224":1663,"_21623":56311,"_5":14874,"_28405":56167,"_3078":56312},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3626":1719,"_31224":1663,"_21623":56314,"_5":14874,"_28405":56171,"_3078":56315},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3626":1720,"_31224":1663,"_21623":56317,"_5":14874,"_28405":56171,"_3078":56318},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3626":1721,"_31224":1663,"_21623":56320,"_5":14874,"_28405":56171,"_3078":56321},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3626":1722,"_31224":1663,"_21623":56323,"_5":14874,"_28405":56171,"_3078":56324},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3626":1723,"_31224":1663,"_21623":56326,"_5":14874,"_28405":56171,"_3078":56327},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3626":1724,"_31224":1663,"_21623":56329,"_5":14874,"_28405":56175,"_3078":56330},[],"Check",{"_3626":1725,"_31224":1663,"_21623":56332,"_5":14874,"_28405":56175,"_3078":56333},[],"Expected result",{"_3626":1726,"_31224":1663,"_21623":56335,"_5":14874,"_28405":56175,"_3078":56336},[],"Registration",{"_3626":1727,"_31224":1663,"_21623":56338,"_5":14874,"_28405":56175,"_3078":56339},[],"ID created automatically and correct DMS.",{"_3626":1728,"_31224":1663,"_21623":56341,"_5":14874,"_28405":56175,"_3078":55597},[],{"_3626":1729,"_31224":1663,"_21623":56343,"_5":14874,"_28405":56175,"_3078":56344},[],"CN, profile, serial and key verified.",{"_3626":1730,"_31224":1663,"_21623":56346,"_5":14874,"_28405":56175,"_3078":56347},[],"Inventory",{"_3626":1731,"_31224":1663,"_21623":56349,"_5":14874,"_28405":56175,"_3078":56350},[],"Received serial visible as the current identity and in history.",{"_3626":1732,"_31224":1663,"_21623":56352,"_5":14874,"_28405":56175,"_3078":56353},[],"Consumer",{"_3626":1733,"_31224":1663,"_21623":56355,"_5":14874,"_28405":56175,"_3078":56356},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3626":1734,"_31224":1663,"_21623":56358,"_5":14874,"_28405":56175,"_3078":56359},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3626":1735,"_31224":1663,"_21623":56361,"_5":14874,"_28405":56175,"_3078":56362},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3626":1736,"_31224":1736,"_5":15239,"_3078":53711,"_31582":56364,"_21623":56365,"_28405":1736},[51011,52523,53695,56141],[],{"_3626":1737,"_31224":1736,"_21623":56367,"_5":14874,"_28405":1736,"_3078":56368},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3626":1738,"_31224":1736,"_5":31579,"_21623":56370,"_28405":56371,"_3078":51021},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3626":1739,"_31224":1736,"_5":31579,"_21623":56373,"_28405":56374,"_3078":56375},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3626":1740,"_31224":1736,"_5":31579,"_21623":56377,"_28405":56378,"_3078":56379},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3626":1741,"_31224":1736,"_5":31579,"_21623":56381,"_28405":56382,"_3078":56383},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3626":1742,"_31224":1736,"_5":31579,"_21623":56385,"_28405":56386,"_3078":56387},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3626":1743,"_31224":1736,"_5":31579,"_21623":56389,"_28405":56390,"_3078":56391},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3626":1744,"_31224":1736,"_5":31579,"_21623":56393,"_28405":56394,"_3078":56333},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3626":1745,"_31224":1736,"_5":31579,"_21623":56396,"_28405":56397,"_3078":56398},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3626":1746,"_31224":1736,"_5":31579,"_21623":56400,"_28405":56401,"_3078":56402},[],"/docs/pr-preview/pr-76/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3626":1747,"_31224":1736,"_21623":56404,"_5":14874,"_28405":1736,"_3078":56405},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3626":1748,"_31224":1736,"_21623":56407,"_5":14874,"_28405":1736,"_3078":56408},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3626":1749,"_31224":1736,"_21623":56410,"_5":14874,"_28405":56371,"_3078":56411},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3626":1750,"_31224":1736,"_21623":56413,"_5":14874,"_28405":56371,"_3078":56414},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3626":1751,"_31224":1736,"_21623":56416,"_5":14874,"_28405":56371,"_3078":56417},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3626":1752,"_31224":1736,"_21623":56419,"_5":14874,"_28405":56371,"_3078":56420},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3626":1753,"_31224":1736,"_21623":56422,"_5":14874,"_28405":56374,"_3078":56423},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3626":1754,"_31224":1736,"_21623":56425,"_5":14874,"_28405":56374,"_3078":56426},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3626":1755,"_31224":1736,"_21623":56428,"_5":14874,"_28405":56374,"_3078":56429},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3626":1756,"_31224":1736,"_21623":56431,"_5":14874,"_28405":56374,"_3078":56432},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3626":1757,"_31224":1736,"_21623":56434,"_5":14874,"_28405":56374,"_3078":56435},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3626":1758,"_31224":1736,"_21623":56437,"_5":14874,"_28405":56374,"_3078":56438},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3626":1759,"_31224":1736,"_21623":56440,"_5":14874,"_28405":56374,"_3078":56441},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3626":1760,"_31224":1736,"_21623":56443,"_5":14874,"_28405":56374,"_3078":56444},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3626":1761,"_31224":1736,"_21623":56446,"_5":14874,"_28405":56378,"_3078":56447},[],"Open **Managed Devices** and the registration action. Complete:",{"_3626":1762,"_31224":1736,"_21623":56449,"_5":14874,"_28405":56378,"_3078":56450},[],"**Device ID**: `device-001`.",{"_3626":1763,"_31224":1736,"_21623":56452,"_5":14874,"_28405":56378,"_3078":56453},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3626":1764,"_31224":1736,"_21623":56455,"_5":14874,"_28405":56378,"_3078":56456},[],"**Icon** and **Tags**: optional classification.",{"_3626":1765,"_31224":1736,"_21623":56458,"_5":14874,"_28405":56378,"_3078":56459},[],"Confirm registration.",{"_3626":1766,"_31224":1736,"_21623":56461,"_5":14874,"_28405":56382,"_3078":56462},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3626":1767,"_31224":1736,"_21623":56464,"_5":14874,"_28405":56382,"_3078":56465},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3626":1768,"_31224":1736,"_21623":56467,"_5":14874,"_28405":56386,"_3078":56468},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3626":1769,"_31224":1736,"_21623":56470,"_5":14874,"_28405":56386,"_3078":56471},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3626":1770,"_31224":1736,"_21623":56473,"_5":14874,"_28405":56390,"_3078":56474},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3626":1771,"_31224":1736,"_21623":56476,"_5":14874,"_28405":56390,"_3078":56477},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3626":1772,"_31224":1736,"_21623":56479,"_5":14874,"_28405":56394,"_3078":56330},[],{"_3626":1773,"_31224":1736,"_21623":56481,"_5":14874,"_28405":56394,"_3078":56482},[],"Result",{"_3626":1774,"_31224":1736,"_21623":56484,"_5":14874,"_28405":56394,"_3078":55580},[],{"_3626":1775,"_31224":1736,"_21623":56486,"_5":14874,"_28405":56394,"_3078":56487},[],"`device-001` appears in inventory with the expected DMS.",{"_3626":1776,"_31224":1736,"_21623":56489,"_5":14874,"_28405":56394,"_3078":56490},[],"Current identity",{"_3626":1777,"_31224":1736,"_21623":56492,"_5":14874,"_28405":56394,"_3078":56493},[],"The associated certificate matches the one you verified in PKI.",{"_3626":1778,"_31224":1736,"_21623":56495,"_5":14874,"_28405":56394,"_3078":56496},[],"History",{"_3626":1779,"_31224":1736,"_21623":56498,"_5":14874,"_28405":56394,"_3078":56499},[],"The associated issuance appears with its serial number and dates.",{"_3626":1780,"_31224":1736,"_21623":56501,"_5":14874,"_28405":56394,"_3078":56502},[],"Key and certificate",{"_3626":1781,"_31224":1736,"_21623":56504,"_5":14874,"_28405":56394,"_3078":56505},[],"You have the verified pair ready to install on the device.",{"_3626":1782,"_31224":1736,"_21623":56507,"_5":14874,"_28405":56397,"_3078":56508},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3626":1783,"_31224":1736,"_21623":56510,"_5":14874,"_28405":56397,"_3078":56511},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3626":1784,"_31224":1736,"_21623":56513,"_5":14874,"_28405":56397,"_3078":56514},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3626":1785,"_31224":1736,"_21623":56516,"_5":14874,"_28405":56397,"_3078":56517},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3626":1786,"_31224":1736,"_21623":56519,"_5":14874,"_28405":56401,"_3078":56520},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3626":1787,"_31224":1736,"_21623":56522,"_5":14874,"_28405":56401,"_3078":56523},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3626":1788,"_31224":1736,"_21623":56525,"_5":14874,"_28405":56401,"_3078":56526},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3626":1789,"_31224":1789,"_5":15239,"_3078":56528,"_31582":56529,"_21623":56530,"_28405":1789},"Lamassu IoT Platform",[51011,52523],[],{"_3626":1790,"_31224":1789,"_21623":56532,"_5":14874,"_28405":1789,"_3078":56533},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3626":1791,"_31224":1789,"_5":31579,"_21623":56535,"_28405":56536,"_3078":56016},[],"/docs/pr-preview/pr-76/platform/overview#start-here",{"_3626":1792,"_31224":1789,"_5":31579,"_21623":56538,"_28405":56539,"_3078":56540},[],"/docs/pr-preview/pr-76/platform/overview#choose-your-path","Choose your path",{"_3626":1793,"_31224":1789,"_5":31579,"_21623":56542,"_28405":56543,"_3078":56544},[],"/docs/pr-preview/pr-76/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3626":1794,"_31224":1789,"_5":31579,"_21623":56546,"_28405":56547,"_3078":56548},[],"/docs/pr-preview/pr-76/platform/overview#core-capabilities","Core capabilities",{"_3626":1795,"_31224":1789,"_5":31579,"_21623":56550,"_28405":56551,"_3078":56552},[],"/docs/pr-preview/pr-76/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3626":1796,"_31224":1789,"_5":31579,"_21623":56554,"_28405":56555,"_3078":56556},[],"/docs/pr-preview/pr-76/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3626":1797,"_31224":1789,"_5":31579,"_21623":56558,"_28405":56559,"_3078":56560},[],"/docs/pr-preview/pr-76/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3626":1798,"_31224":1789,"_5":31579,"_21623":56562,"_28405":56563,"_3078":56564},[],"/docs/pr-preview/pr-76/platform/overview#automate-device-identities","Automate device identities",{"_3626":1799,"_31224":1789,"_5":31579,"_21623":56566,"_28405":56567,"_3078":56568},[],"/docs/pr-preview/pr-76/platform/overview#publish-validation-status","Publish validation status",{"_3626":1800,"_31224":1789,"_5":31579,"_21623":56570,"_28405":56571,"_3078":56572},[],"/docs/pr-preview/pr-76/platform/overview#react-to-events","React to events",{"_3626":1801,"_31224":1789,"_5":31579,"_21623":56574,"_28405":56575,"_3078":56576},[],"/docs/pr-preview/pr-76/platform/overview#operational-reference","Operational reference",{"_3626":1802,"_31224":1789,"_21623":56578,"_5":14874,"_28405":1789,"_3078":56579},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3626":1803,"_31224":1789,"_21623":56581,"_5":14874,"_28405":56536,"_3078":56582},[],"Choose the result you need:",{"_3626":1804,"_31224":1789,"_21623":56584,"_5":14874,"_28405":56536,"_3078":56585},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3626":1805,"_31224":1789,"_21623":56587,"_5":14874,"_28405":56536,"_3078":56588},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3626":1806,"_31224":1789,"_21623":56590,"_5":14874,"_28405":56536,"_3078":56591},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3626":1807,"_31224":1789,"_21623":56593,"_5":14874,"_28405":56539,"_3078":56594},[],"Section",{"_3626":1808,"_31224":1789,"_21623":56596,"_5":14874,"_28405":56539,"_3078":56597},[],"What you manage",{"_3626":1809,"_31224":1789,"_21623":56599,"_5":14874,"_28405":56539,"_3078":56600},[],"Entry point",{"_3626":1810,"_31224":1789,"_21623":56602,"_5":14874,"_28405":56539,"_3078":56603},[],"**PKI**",{"_3626":1811,"_31224":1789,"_21623":56605,"_5":14874,"_28405":56539,"_3078":56606},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3626":1812,"_31224":1789,"_21623":56608,"_5":14874,"_28405":56539,"_3078":56609},[],"PKI overview",{"_3626":1813,"_31224":1789,"_21623":56611,"_5":14874,"_28405":56539,"_3078":56612},[],"**IoT Fleets**",{"_3626":1814,"_31224":1789,"_21623":56614,"_5":14874,"_28405":56539,"_3078":56615},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3626":1815,"_31224":1789,"_21623":56617,"_5":14874,"_28405":56539,"_3078":56618},[],"IoT Fleets overview",{"_3626":1816,"_31224":1789,"_21623":56620,"_5":14874,"_28405":56539,"_3078":56621},[],"**Administration**",{"_3626":1817,"_31224":1789,"_21623":56623,"_5":14874,"_28405":56539,"_3078":56624},[],"Operator permissions, audit and event subscriptions.",{"_3626":1818,"_31224":1789,"_21623":56626,"_5":14874,"_28405":56539,"_3078":52525},[],{"_3626":1819,"_31224":1789,"_21623":56628,"_5":14874,"_28405":56539,"_3078":56629},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3626":1820,"_31224":1789,"_21623":56631,"_5":14874,"_28405":56543,"_3078":56632},[],"An identity's journey connects four responsibilities:",{"_3626":1821,"_31224":1789,"_21623":56634,"_5":14874,"_28405":56543,"_3078":56635},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3626":1822,"_31224":1789,"_21623":56637,"_5":14874,"_28405":56543,"_3078":56638},[],"The provisioning administrator configures the DMS and initial trust.",{"_3626":1823,"_31224":1789,"_21623":56640,"_5":14874,"_28405":56543,"_3078":56641},[],"The device client requests a certificate and installs it with the matching key.",{"_3626":1824,"_31224":1789,"_21623":56643,"_5":14874,"_28405":56543,"_3078":56644},[],"The consumer validates the identity and applies its access permissions.",{"_3626":1825,"_31224":1789,"_21623":56646,"_5":14874,"_28405":56543,"_3078":56647},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3626":1826,"_31224":1789,"_21623":56649,"_5":14874,"_28405":56551,"_3078":56650},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3626":1827,"_31224":1789,"_21623":56652,"_5":14874,"_28405":56555,"_3078":56653},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3626":1828,"_31224":1789,"_21623":56655,"_5":14874,"_28405":56559,"_3078":56656},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3626":1829,"_31224":1789,"_21623":56658,"_5":14874,"_28405":56563,"_3078":56659},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3626":1830,"_31224":1789,"_21623":56661,"_5":14874,"_28405":56567,"_3078":56662},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3626":1831,"_31224":1789,"_21623":56664,"_5":14874,"_28405":56571,"_3078":56665},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3626":1832,"_31224":1789,"_21623":56667,"_5":14874,"_28405":56575,"_3078":56110},[],{"_3626":1833,"_31224":1789,"_21623":56669,"_5":14874,"_28405":56575,"_3078":56670},[],"What it prepares or checks",{"_3626":1834,"_31224":1789,"_21623":56672,"_5":14874,"_28405":56575,"_3078":56113},[],{"_3626":1835,"_31224":1789,"_21623":56674,"_5":14874,"_28405":56575,"_3078":56675},[],"Key custody, CA hierarchy, profiles and validation.",{"_3626":1836,"_31224":1789,"_21623":56677,"_5":14874,"_28405":56575,"_3078":56678},[],"Fleet administrator",{"_3626":1837,"_31224":1789,"_21623":56680,"_5":14874,"_28405":56575,"_3078":56681},[],"DMS, device admission, renewal policy and inventory.",{"_3626":1838,"_31224":1789,"_21623":56683,"_5":14874,"_28405":56575,"_3078":56125},[],{"_3626":1839,"_31224":1789,"_21623":56685,"_5":14874,"_28405":56575,"_3078":56686},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3626":1840,"_31224":1789,"_21623":56688,"_5":14874,"_28405":56575,"_3078":56131},[],{"_3626":1841,"_31224":1789,"_21623":56690,"_5":14874,"_28405":56575,"_3078":56691},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3626":1842,"_31224":1789,"_21623":56693,"_5":14874,"_28405":56575,"_3078":56694},[],"Infrastructure operator",{"_3626":1843,"_31224":1789,"_21623":56696,"_5":14874,"_28405":56575,"_3078":56697},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3626":1844,"_31224":1789,"_21623":56699,"_5":14874,"_28405":56575,"_3078":56700},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3626":1845,"_31224":1845,"_5":15239,"_3078":56702,"_31582":56703,"_21623":56706,"_28405":1845},"CA hierarchy and rotation",[51011,52523,56704,56705],"PKI","Keys, authorities and certificates",[],{"_3626":1846,"_31224":1845,"_21623":56708,"_5":14874,"_28405":1845,"_3078":56709},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3626":1847,"_31224":1845,"_5":31579,"_21623":56711,"_28405":56712,"_3078":56713},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3626":1848,"_31224":1845,"_5":31579,"_21623":56715,"_28405":56716,"_3078":56717},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3626":1849,"_31224":1845,"_5":31579,"_21623":56719,"_28405":56720,"_3078":56721},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3626":1850,"_31224":1845,"_5":31579,"_21623":56723,"_28405":56724,"_3078":56725},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3626":1851,"_31224":1845,"_5":31579,"_21623":56727,"_28405":56728,"_3078":56729},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3626":1852,"_31224":1845,"_5":31579,"_21623":56731,"_28405":56732,"_3078":56733},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3626":1853,"_31224":1845,"_5":31579,"_21623":56735,"_28405":56736,"_3078":56737},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3626":1854,"_31224":1845,"_5":31579,"_21623":56739,"_28405":56740,"_3078":56741},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3626":1855,"_31224":1845,"_5":31579,"_21623":56743,"_28405":56744,"_3078":56745},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3626":1856,"_31224":1845,"_5":31579,"_21623":56747,"_28405":56748,"_3078":56749},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3626":1857,"_31224":1845,"_5":31579,"_21623":56751,"_28405":56752,"_3078":56753},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3626":1858,"_31224":1845,"_5":31579,"_21623":56755,"_28405":56756,"_3078":56757},[],"/docs/pr-preview/pr-76/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3626":1859,"_31224":1845,"_21623":56759,"_5":14874,"_28405":1845,"_3078":56760},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3626":1860,"_31224":1845,"_21623":56762,"_5":14874,"_28405":1845,"_3078":56763},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3626":1861,"_31224":1845,"_21623":56765,"_5":14874,"_28405":56712,"_3078":56766},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3626":1862,"_31224":1845,"_21623":56768,"_5":14874,"_28405":56712,"_3078":56769},[],"environment, such as production and preproduction;",{"_3626":1863,"_31224":1845,"_21623":56771,"_5":14874,"_28405":56712,"_3078":56772},[],"owner or operating team;",{"_3626":1864,"_31224":1845,"_21623":56774,"_5":14874,"_28405":56712,"_3078":56775},[],"device family or manufacturing process;",{"_3626":1865,"_31224":1845,"_21623":56777,"_5":14874,"_28405":56712,"_3078":56778},[],"region or regulatory requirement;",{"_3626":1866,"_31224":1845,"_21623":56780,"_5":14874,"_28405":56712,"_3078":56781},[],"cryptographic engine or key policy;",{"_3626":1867,"_31224":1845,"_21623":56783,"_5":14874,"_28405":56712,"_3078":56784},[],"maintenance window and renewal cadence.",{"_3626":1868,"_31224":1845,"_21623":56786,"_5":14874,"_28405":56712,"_3078":56787},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3626":1869,"_31224":1845,"_21623":56789,"_5":14874,"_28405":56712,"_3078":56790},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3626":1870,"_31224":1845,"_21623":56792,"_5":14874,"_28405":56716,"_3078":56793},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3626":1871,"_31224":1845,"_21623":56795,"_5":14874,"_28405":56716,"_3078":56796},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3626":1872,"_31224":1845,"_21623":56798,"_5":14874,"_28405":56716,"_3078":56799},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3626":1873,"_31224":1845,"_21623":56801,"_5":14874,"_28405":56716,"_3078":56802},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3626":1874,"_31224":1845,"_21623":56804,"_5":14874,"_28405":56720,"_3078":56805},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3626":1875,"_31224":1845,"_21623":56807,"_5":14874,"_28405":56720,"_3078":56808},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3626":1876,"_31224":1845,"_21623":56810,"_5":14874,"_28405":56720,"_3078":56811},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3626":1877,"_31224":1845,"_21623":56813,"_5":14874,"_28405":56720,"_3078":56814},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3626":1878,"_31224":1845,"_21623":56816,"_5":14874,"_28405":56728,"_3078":56817},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3626":1879,"_31224":1845,"_21623":56819,"_5":14874,"_28405":56732,"_3078":56820},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3626":1880,"_31224":1845,"_21623":56822,"_5":14874,"_28405":56736,"_3078":56823},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3626":1881,"_31224":1845,"_21623":56825,"_5":14874,"_28405":56740,"_3078":56826},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3626":1882,"_31224":1845,"_21623":56828,"_5":14874,"_28405":56744,"_3078":56829},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3626":1883,"_31224":1845,"_21623":56831,"_5":14874,"_28405":56748,"_3078":56832},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3626":1884,"_31224":1845,"_21623":56834,"_5":14874,"_28405":56752,"_3078":56835},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3626":1885,"_31224":1845,"_21623":56837,"_5":14874,"_28405":56752,"_3078":56838},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3626":1886,"_31224":1845,"_21623":56840,"_5":14874,"_28405":56752,"_3078":56841},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3626":1887,"_31224":1845,"_21623":56843,"_5":14874,"_28405":56752,"_3078":56844},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3626":1888,"_31224":1845,"_21623":56846,"_5":14874,"_28405":56756,"_3078":56847},[],"The new chain ends in an anchor installed by the consumer.",{"_3626":1889,"_31224":1845,"_21623":56849,"_5":14874,"_28405":56756,"_3078":56850},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3626":1890,"_31224":1845,"_21623":56852,"_5":14874,"_28405":56756,"_3078":56853},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3626":1891,"_31224":1845,"_21623":56855,"_5":14874,"_28405":56756,"_3078":56856},[],"Re-enrollment accepts the old identity during the planned period.",{"_3626":1892,"_31224":1845,"_21623":56858,"_5":14874,"_28405":56756,"_3078":56859},[],"OCSP and CRL respond for the authorities that remain active.",{"_3626":1893,"_31224":1845,"_21623":56861,"_5":14874,"_28405":56756,"_3078":56862},[],"No DMS is left accidentally issuing from the old CA.",{"_3626":1894,"_31224":1845,"_21623":56864,"_5":14874,"_28405":56756,"_3078":56865},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3626":1895,"_31224":1895,"_5":15239,"_3078":56867,"_31582":56868,"_21623":56869,"_28405":1895},"Certification authorities",[51011,52523,56704,56705],[],{"_3626":1896,"_31224":1895,"_21623":56871,"_5":14874,"_28405":1895,"_3078":56872},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3626":1897,"_31224":1895,"_5":31579,"_21623":56874,"_28405":56875,"_3078":56876},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3626":1898,"_31224":1895,"_5":31579,"_21623":56878,"_28405":56879,"_3078":56880},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3626":1899,"_31224":1895,"_5":31579,"_21623":56882,"_28405":56883,"_3078":51021},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#before-you-begin",{"_3626":1900,"_31224":1895,"_5":31579,"_21623":56885,"_28405":56886,"_3078":56887},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3626":1901,"_31224":1895,"_5":31579,"_21623":56889,"_28405":56890,"_3078":56891},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3626":1902,"_31224":1895,"_5":31579,"_21623":56893,"_28405":56894,"_3078":56895},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3626":1903,"_31224":1895,"_5":31579,"_21623":56897,"_28405":56898,"_3078":56899},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3626":1904,"_31224":1895,"_5":31579,"_21623":56901,"_28405":56902,"_3078":56903},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3626":1905,"_31224":1895,"_5":31579,"_21623":56905,"_28405":56906,"_3078":56907},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3626":1906,"_31224":1895,"_5":31579,"_21623":56909,"_28405":56910,"_3078":56911},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3626":1907,"_31224":1895,"_5":31579,"_21623":56913,"_28405":56914,"_3078":56915},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3626":1908,"_31224":1895,"_5":31579,"_21623":56917,"_28405":56918,"_3078":56919},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3626":1909,"_31224":1895,"_5":31579,"_21623":56921,"_28405":56922,"_3078":56923},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3626":1910,"_31224":1895,"_5":31579,"_21623":56925,"_28405":56926,"_3078":56927},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3626":1911,"_31224":1895,"_5":31579,"_21623":56929,"_28405":56930,"_3078":56931},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3626":1912,"_31224":1895,"_5":31579,"_21623":56933,"_28405":56934,"_3078":56935},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3626":1913,"_31224":1895,"_5":31579,"_21623":56937,"_28405":56938,"_3078":56939},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3626":1914,"_31224":1895,"_5":31579,"_21623":56941,"_28405":56942,"_3078":56943},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3626":1915,"_31224":1895,"_5":31579,"_21623":56945,"_28405":56946,"_3078":56947},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3626":1916,"_31224":1895,"_5":31579,"_21623":56949,"_28405":56950,"_3078":56951},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3626":1917,"_31224":1895,"_5":31579,"_21623":56953,"_28405":56954,"_3078":56955},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3626":1918,"_31224":1895,"_5":31579,"_21623":56957,"_28405":56958,"_3078":56959},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3626":1919,"_31224":1895,"_5":31579,"_21623":56961,"_28405":56962,"_3078":56963},[],"/docs/pr-preview/pr-76/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3626":1920,"_31224":1895,"_21623":56965,"_5":14874,"_28405":1895,"_3078":56966},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3626":1921,"_31224":1895,"_21623":56968,"_5":14874,"_28405":1895,"_3078":56969},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3626":1922,"_31224":1895,"_21623":56971,"_5":14874,"_28405":1895,"_3078":56972},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3626":1923,"_31224":1895,"_21623":56974,"_5":14874,"_28405":56875,"_3078":56975},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3626":1924,"_31224":1895,"_21623":56977,"_5":14874,"_28405":56875,"_3078":56978},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3626":1925,"_31224":1895,"_21623":56980,"_5":14874,"_28405":56875,"_3078":56981},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3626":1926,"_31224":1895,"_21623":56983,"_5":14874,"_28405":56875,"_3078":56984},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3626":1927,"_31224":1895,"_21623":56986,"_5":14874,"_28405":56875,"_3078":56987},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3626":1928,"_31224":1895,"_21623":56989,"_5":14874,"_28405":56883,"_3078":56990},[],"Decide whether the CA will be a root or an intermediate.",{"_3626":1929,"_31224":1895,"_21623":56992,"_5":14874,"_28405":56883,"_3078":56993},[],"Choose the engine that will keep the key.",{"_3626":1930,"_31224":1895,"_21623":56995,"_5":14874,"_28405":56883,"_3078":56996},[],"Define a validity longer than that of the certificates it will issue.",{"_3626":1931,"_31224":1895,"_21623":56998,"_5":14874,"_28405":56883,"_3078":56999},[],"For an intermediate CA, make sure the parent CA is active.",{"_3626":1932,"_31224":1895,"_21623":57001,"_5":14874,"_28405":56886,"_3078":57002},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3626":1933,"_31224":1895,"_21623":57004,"_5":14874,"_28405":56890,"_3078":57005},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3626":1934,"_31224":1895,"_21623":57007,"_5":14874,"_28405":56890,"_3078":57008},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3626":1935,"_31224":1895,"_21623":57010,"_5":14874,"_28405":56894,"_3078":57011},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3626":1936,"_31224":1895,"_21623":57013,"_5":14874,"_28405":56898,"_3078":57014},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3626":1937,"_31224":1895,"_21623":57016,"_5":14874,"_28405":56898,"_3078":57017},[],"`C`: two-letter ISO 3166-1 country code.",{"_3626":1938,"_31224":1895,"_21623":57019,"_5":14874,"_28405":56898,"_3078":57020},[],"`ST`: state or province.",{"_3626":1939,"_31224":1895,"_21623":57022,"_5":14874,"_28405":56898,"_3078":57023},[],"`L`: locality.",{"_3626":1940,"_31224":1895,"_21623":57025,"_5":14874,"_28405":56898,"_3078":57026},[],"`O`: organization.",{"_3626":1941,"_31224":1895,"_21623":57028,"_5":14874,"_28405":56898,"_3078":57029},[],"`OU`: organizational unit.",{"_3626":1942,"_31224":1895,"_21623":57031,"_5":14874,"_28405":56898,"_3078":57032},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3626":1943,"_31224":1895,"_21623":57034,"_5":14874,"_28405":56902,"_3078":57035},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3626":1944,"_31224":1895,"_21623":57037,"_5":14874,"_28405":56902,"_3078":57038},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3626":1945,"_31224":1895,"_21623":57040,"_5":14874,"_28405":56906,"_3078":57041},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3626":1946,"_31224":1895,"_21623":57043,"_5":14874,"_28405":56906,"_3078":57044},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3626":1947,"_31224":1895,"_21623":57046,"_5":14874,"_28405":56910,"_3078":57047},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3626":1948,"_31224":1895,"_21623":57049,"_5":14874,"_28405":56910,"_3078":57050},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3626":1949,"_31224":1895,"_21623":57052,"_5":14874,"_28405":56914,"_3078":57053},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3626":1950,"_31224":1895,"_21623":57055,"_5":14874,"_28405":56914,"_3078":57056},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3626":1951,"_31224":1895,"_21623":57058,"_5":14874,"_28405":56914,"_3078":57059},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3626":1952,"_31224":1895,"_21623":57061,"_5":14874,"_28405":56918,"_3078":57062},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3626":1953,"_31224":1895,"_21623":57064,"_5":14874,"_28405":56922,"_3078":57065},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3626":1954,"_31224":1895,"_21623":57067,"_5":14874,"_28405":56922,"_3078":57068},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3626":1955,"_31224":1895,"_21623":57070,"_5":14874,"_28405":56926,"_3078":57071},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3626":1956,"_31224":1895,"_21623":57073,"_5":14874,"_28405":56930,"_3078":57074},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3626":1957,"_31224":1895,"_21623":57076,"_5":14874,"_28405":56930,"_3078":57077},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3626":1958,"_31224":1895,"_21623":57079,"_5":14874,"_28405":56930,"_3078":57080},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3626":1959,"_31224":1895,"_21623":57082,"_5":14874,"_28405":56934,"_3078":57083},[],"Open a CA from the inventory to review:",{"_3626":1960,"_31224":1895,"_21623":57085,"_5":14874,"_28405":56934,"_3078":57086},[],"Status and validity period.",{"_3626":1961,"_31224":1895,"_21623":57088,"_5":14874,"_28405":56934,"_3078":57089},[],"Certificate and chain in PEM format.",{"_3626":1962,"_31224":1895,"_21623":57091,"_5":14874,"_28405":56934,"_3078":57092},[],"Number of active, expired and revoked certificates.",{"_3626":1963,"_31224":1895,"_21623":57094,"_5":14874,"_28405":56934,"_3078":57095},[],"Certificates issued in **Issued Certificates**.",{"_3626":1964,"_31224":1895,"_21623":57097,"_5":14874,"_28405":56934,"_3078":57098},[],"The CRL linked to the authority.",{"_3626":1965,"_31224":1895,"_21623":57100,"_5":14874,"_28405":56934,"_3078":57101},[],"Metadata and the associated cryptographic engine.",{"_3626":1966,"_31224":1895,"_21623":57103,"_5":14874,"_28405":56934,"_3078":57104},[],"You can filter the inventory by name, status and CA type.",{"_3626":1967,"_31224":1895,"_21623":57106,"_5":14874,"_28405":56938,"_3078":57107},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3626":1968,"_31224":1895,"_21623":57109,"_5":14874,"_28405":56938,"_3078":57110},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3626":1969,"_31224":1895,"_21623":57112,"_5":14874,"_28405":56938,"_3078":57113},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3626":1970,"_31224":1895,"_21623":57115,"_5":14874,"_28405":56938,"_3078":57116},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3626":1971,"_31224":1895,"_21623":57118,"_5":14874,"_28405":56938,"_3078":57119},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3626":1972,"_31224":1895,"_21623":57121,"_5":14874,"_28405":56938,"_3078":57122},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3626":1973,"_31224":1895,"_21623":57124,"_5":14874,"_28405":56942,"_3078":57125},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3626":1974,"_31224":1895,"_21623":57127,"_5":14874,"_28405":56946,"_3078":57128},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3626":1975,"_31224":1895,"_21623":57130,"_5":14874,"_28405":56950,"_3078":57131},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3626":1976,"_31224":1895,"_21623":57133,"_5":14874,"_28405":56954,"_3078":57134},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3626":1977,"_31224":1895,"_21623":57136,"_5":14874,"_28405":56958,"_3078":57137},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3626":1978,"_31224":1895,"_21623":57139,"_5":14874,"_28405":56962,"_3078":57140},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3626":1979,"_31224":1895,"_21623":57142,"_5":14874,"_28405":56962,"_3078":57143},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3626":1980,"_31224":1895,"_21623":57145,"_5":14874,"_28405":56962,"_3078":57146},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3626":1981,"_31224":1895,"_21623":57148,"_5":14874,"_28405":56962,"_3078":57149},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3626":1982,"_31224":1982,"_5":15239,"_3078":57151,"_31582":57152,"_21623":57153,"_28405":1982},"Certificate profiles",[51011,52523,56704,56705],[],{"_3626":1983,"_31224":1982,"_21623":57155,"_5":14874,"_28405":1982,"_3078":57156},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3626":1984,"_31224":1982,"_5":31579,"_21623":57158,"_28405":57159,"_3078":57160},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3626":1985,"_31224":1982,"_5":31579,"_21623":57162,"_28405":57163,"_3078":57164},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#validity","Validity",{"_3626":1986,"_31224":1982,"_5":31579,"_21623":57166,"_28405":57167,"_3078":57168},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3626":1987,"_31224":1982,"_5":31579,"_21623":57170,"_28405":57171,"_3078":57172},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3626":1988,"_31224":1982,"_5":31579,"_21623":57174,"_28405":57175,"_3078":57176},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#subject","Subject",{"_3626":1989,"_31224":1982,"_5":31579,"_21623":57178,"_28405":57179,"_3078":57180},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3626":1990,"_31224":1982,"_5":31579,"_21623":57182,"_28405":57183,"_3078":57184},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3626":1991,"_31224":1982,"_5":31579,"_21623":57186,"_28405":57187,"_3078":57188},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3626":1992,"_31224":1982,"_5":31579,"_21623":57190,"_28405":57191,"_3078":57192},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3626":1993,"_31224":1982,"_5":31579,"_21623":57194,"_28405":57195,"_3078":57196},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3626":1994,"_31224":1982,"_5":31579,"_21623":57198,"_28405":57199,"_3078":57200},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3626":1995,"_31224":1982,"_5":31579,"_21623":57202,"_28405":57203,"_3078":57204},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3626":1996,"_31224":1982,"_5":31579,"_21623":57206,"_28405":57207,"_3078":57208},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3626":1997,"_31224":1982,"_5":31579,"_21623":57210,"_28405":57211,"_3078":57212},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3626":1998,"_31224":1982,"_5":31579,"_21623":57214,"_28405":57215,"_3078":57216},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#design-examples","Design examples",{"_3626":1999,"_31224":1982,"_5":31579,"_21623":57218,"_28405":57219,"_3078":57220},[],"/docs/pr-preview/pr-76/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3626":2000,"_31224":1982,"_21623":57222,"_5":14874,"_28405":1982,"_3078":57223},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3626":2001,"_31224":1982,"_21623":57225,"_5":14874,"_28405":1982,"_3078":57226},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3626":2002,"_31224":1982,"_21623":57228,"_5":14874,"_28405":57163,"_3078":57229},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3626":2003,"_31224":1982,"_21623":57231,"_5":14874,"_28405":57163,"_3078":57232},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3626":2004,"_31224":1982,"_21623":57234,"_5":14874,"_28405":57167,"_3078":57235},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3626":2005,"_31224":1982,"_21623":57237,"_5":14874,"_28405":57171,"_3078":57238},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3626":2006,"_31224":1982,"_21623":57240,"_5":14874,"_28405":57171,"_3078":57241},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3626":2007,"_31224":1982,"_21623":57243,"_5":14874,"_28405":57171,"_3078":57244},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3626":2008,"_31224":1982,"_21623":57246,"_5":14874,"_28405":57175,"_3078":57247},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3626":2009,"_31224":1982,"_21623":57249,"_5":14874,"_28405":57179,"_3078":57250},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3626":2010,"_31224":1982,"_21623":57252,"_5":14874,"_28405":57179,"_3078":57253},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3626":2011,"_31224":1982,"_21623":57255,"_5":14874,"_28405":57183,"_3078":57256},[],"The cryptographic enforcement can:",{"_3626":2012,"_31224":1982,"_21623":57258,"_5":14874,"_28405":57183,"_3078":57259},[],"allow or block RSA keys;",{"_3626":2013,"_31224":1982,"_21623":57261,"_5":14874,"_28405":57183,"_3078":57262},[],"limit the supported RSA sizes;",{"_3626":2014,"_31224":1982,"_21623":57264,"_5":14874,"_28405":57183,"_3078":57265},[],"allow or block ECDSA keys;",{"_3626":2015,"_31224":1982,"_21623":57267,"_5":14874,"_28405":57183,"_3078":57268},[],"limit the supported ECDSA sizes or curves.",{"_3626":2016,"_31224":1982,"_21623":57270,"_5":14874,"_28405":57183,"_3078":57271},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3626":2017,"_31224":1982,"_21623":57273,"_5":14874,"_28405":57187,"_3078":57274},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3626":2018,"_31224":1982,"_21623":57276,"_5":14874,"_28405":57187,"_3078":54460},[],{"_3626":2019,"_31224":1982,"_21623":57278,"_5":14874,"_28405":57187,"_3078":57279},[],"First choice",{"_3626":2020,"_31224":1982,"_21623":57281,"_5":14874,"_28405":57187,"_3078":57282},[],"Second choice",{"_3626":2021,"_31224":1982,"_21623":57284,"_5":14874,"_28405":57187,"_3078":57285},[],"If neither is supplied",{"_3626":2022,"_31224":1982,"_21623":57287,"_5":14874,"_28405":57187,"_3078":57288},[],"Direct signing with a CA",{"_3626":2023,"_31224":1982,"_21623":57290,"_5":14874,"_28405":57187,"_3078":57291},[],"`issuance_profile` embedded in the request",{"_3626":2024,"_31224":1982,"_21623":57293,"_5":14874,"_28405":57187,"_3078":57294},[],"Request `issuance_profile_id`",{"_3626":2025,"_31224":1982,"_21623":57296,"_5":14874,"_28405":57187,"_3078":57297},[],"CA default profile (`profile_id`).",{"_3626":2026,"_31224":1982,"_21623":57299,"_5":14874,"_28405":57187,"_3078":57300},[],"Issuance through a DMS",{"_3626":2027,"_31224":1982,"_21623":57302,"_5":14874,"_28405":57187,"_3078":57303},[],"`settings.issuance_profile_id`",{"_3626":2028,"_31224":1982,"_21623":57305,"_5":14874,"_28405":57187,"_3078":57306},[],"`settings.issuance_profile` embedded in the DMS",{"_3626":2029,"_31224":1982,"_21623":57308,"_5":14874,"_28405":57187,"_3078":57309},[],"Enrollment CA default profile.",{"_3626":2030,"_31224":1982,"_21623":57311,"_5":14874,"_28405":57187,"_3078":57312},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3626":2031,"_31224":1982,"_21623":57314,"_5":14874,"_28405":57187,"_3078":57315},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3626":2032,"_31224":1982,"_21623":57317,"_5":14874,"_28405":57195,"_3078":57318},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3626":2033,"_31224":1982,"_21623":57320,"_5":14874,"_28405":57199,"_3078":57321},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3626":2034,"_31224":1982,"_21623":57323,"_5":14874,"_28405":57203,"_3078":57324},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3626":2035,"_31224":1982,"_21623":57326,"_5":14874,"_28405":57207,"_3078":57327},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3626":2036,"_31224":1982,"_21623":57329,"_5":14874,"_28405":57211,"_3078":57330},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3626":2037,"_31224":1982,"_21623":57332,"_5":14874,"_28405":57211,"_3078":57333},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3626":2038,"_31224":1982,"_21623":57335,"_5":14874,"_28405":57215,"_3078":57336},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3626":2039,"_31224":1982,"_21623":57338,"_5":14874,"_28405":57215,"_3078":57339},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3626":2040,"_31224":1982,"_21623":57341,"_5":14874,"_28405":57215,"_3078":57342},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3626":2041,"_31224":1982,"_21623":57344,"_5":14874,"_28405":57215,"_3078":57345},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3626":2042,"_31224":1982,"_21623":57347,"_5":14874,"_28405":57219,"_3078":57348},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3626":2043,"_31224":1982,"_21623":57350,"_5":14874,"_28405":57219,"_3078":57351},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3626":2044,"_31224":2044,"_5":15239,"_3078":57353,"_31582":57354,"_21623":57356,"_28405":2044},"Certificate validation",[51011,52523,56704,57355],"Validation",[],{"_3626":2045,"_31224":2044,"_21623":57358,"_5":14874,"_28405":2044,"_3078":57359},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3626":2046,"_31224":2044,"_5":31579,"_21623":57361,"_28405":57362,"_3078":57363},[],"/docs/pr-preview/pr-76/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3626":2047,"_31224":2044,"_5":31579,"_21623":57365,"_28405":57366,"_3078":57367},[],"/docs/pr-preview/pr-76/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3626":2048,"_31224":2044,"_5":31579,"_21623":57369,"_28405":57370,"_3078":57371},[],"/docs/pr-preview/pr-76/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3626":2049,"_31224":2044,"_21623":57373,"_5":14874,"_28405":2044,"_3078":57374},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3626":2050,"_31224":2044,"_21623":57376,"_5":14874,"_28405":57362,"_3078":57377},[],"Verify these criteria together:",{"_3626":2051,"_31224":2044,"_21623":57379,"_5":14874,"_28405":57362,"_3078":56330},[],{"_3626":2052,"_31224":2044,"_21623":57381,"_5":14874,"_28405":57362,"_3078":57382},[],"Required result",{"_3626":2053,"_31224":2044,"_21623":57384,"_5":14874,"_28405":57362,"_3078":57385},[],"Chain and signature",{"_3626":2054,"_31224":2044,"_21623":57387,"_5":14874,"_28405":57362,"_3078":57388},[],"Valid chain to a root deliberately installed in the consumer.",{"_3626":2055,"_31224":2044,"_21623":57390,"_5":14874,"_28405":57362,"_3078":57391},[],"Dates",{"_3626":2056,"_31224":2044,"_21623":57393,"_5":14874,"_28405":57362,"_3078":57394},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3626":2057,"_31224":2044,"_21623":57396,"_5":14874,"_28405":57362,"_3078":52192},[],{"_3626":2058,"_31224":2044,"_21623":57398,"_5":14874,"_28405":57362,"_3078":57399},[],"Name, SAN or identifier matches the expected peer.",{"_3626":2059,"_31224":2044,"_21623":57401,"_5":14874,"_28405":57362,"_3078":51401},[],{"_3626":2060,"_31224":2044,"_21623":57403,"_5":14874,"_28405":57362,"_3078":57404},[],"KU, EKU and constraints permit the specific operation.",{"_3626":2061,"_31224":2044,"_21623":57406,"_5":14874,"_28405":57362,"_3078":57407},[],"Revocation",{"_3626":2062,"_31224":2044,"_21623":57409,"_5":14874,"_28405":57362,"_3078":57410},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3626":2063,"_31224":2044,"_21623":57412,"_5":14874,"_28405":57362,"_3078":57413},[],"Authorization",{"_3626":2064,"_31224":2044,"_21623":57415,"_5":14874,"_28405":57362,"_3078":57416},[],"The application permits that identity to perform the action.",{"_3626":2065,"_31224":2044,"_21623":57418,"_5":14874,"_28405":57362,"_3078":57419},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3626":2066,"_31224":2044,"_21623":57421,"_5":14874,"_28405":57366,"_3078":57422},[],"Mechanism",{"_3626":2067,"_31224":2044,"_21623":57424,"_5":14874,"_28405":57366,"_3078":57425},[],"When to use it",{"_3626":2068,"_31224":2044,"_21623":57427,"_5":14874,"_28405":57366,"_3078":57428},[],"What you must maintain",{"_3626":2069,"_31224":2044,"_21623":57430,"_5":14874,"_28405":57366,"_3078":57431},[],"OCSP",{"_3626":2070,"_31224":2044,"_21623":57433,"_5":14874,"_28405":57366,"_3078":57434},[],"Status query for a specific certificate.",{"_3626":2071,"_31224":2044,"_21623":57436,"_5":14874,"_28405":57366,"_3078":57437},[],"Responder access, signature verification and cache/freshness policy.",{"_3626":2072,"_31224":2044,"_21623":57439,"_5":14874,"_28405":57366,"_3078":57440},[],"CRL",{"_3626":2073,"_31224":2044,"_21623":57442,"_5":14874,"_28405":57366,"_3078":57443},[],"Local checks for many certificates or offline operation.",{"_3626":2074,"_31224":2044,"_21623":57445,"_5":14874,"_28405":57366,"_3078":57446},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3626":2075,"_31224":2044,"_21623":57448,"_5":14874,"_28405":57366,"_3078":57449},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3626":2076,"_31224":2044,"_21623":57451,"_5":14874,"_28405":57366,"_3078":57452},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3626":2077,"_31224":2044,"_21623":57454,"_5":14874,"_28405":57370,"_3078":57455},[],"Accept a current, authorized certificate with a known chain.",{"_3626":2078,"_31224":2044,"_21623":57457,"_5":14874,"_28405":57370,"_3078":57458},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3626":2079,"_31224":2044,"_21623":57460,"_5":14874,"_28405":57370,"_3078":57461},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3626":2080,"_31224":2044,"_21623":57463,"_5":14874,"_28405":57370,"_3078":57464},[],"Check that a new connection with that identity is rejected.",{"_3626":2081,"_31224":2044,"_21623":57466,"_5":14874,"_28405":57370,"_3078":57467},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3626":2082,"_31224":2044,"_21623":57469,"_5":14874,"_28405":57370,"_3078":57470},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3626":2083,"_31224":2044,"_21623":57472,"_5":14874,"_28405":57370,"_3078":57473},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3626":2084,"_31224":2044,"_21623":57475,"_5":14874,"_28405":57370,"_3078":57476},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3626":2085,"_31224":2044,"_21623":57478,"_5":14874,"_28405":57370,"_3078":57479},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3626":2086,"_31224":2086,"_5":15239,"_3078":57481,"_31582":57482,"_21623":57483,"_28405":2086},"Certificates",[51011,52523,56704,56705],[],{"_3626":2087,"_31224":2086,"_21623":57485,"_5":14874,"_28405":2086,"_3078":57486},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3626":2088,"_31224":2086,"_5":31579,"_21623":57488,"_28405":57489,"_3078":57490},[],"/docs/pr-preview/pr-76/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3626":2089,"_31224":2086,"_5":31579,"_21623":57492,"_28405":57493,"_3078":57494},[],"/docs/pr-preview/pr-76/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3626":2090,"_31224":2086,"_5":31579,"_21623":57496,"_28405":57497,"_3078":57498},[],"/docs/pr-preview/pr-76/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3626":2091,"_31224":2086,"_5":31579,"_21623":57500,"_28405":57501,"_3078":57502},[],"/docs/pr-preview/pr-76/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3626":2092,"_31224":2086,"_5":31579,"_21623":57504,"_28405":57505,"_3078":57506},[],"/docs/pr-preview/pr-76/platform/pki/certificates#open-the-action","Open the action",{"_3626":2093,"_31224":2086,"_5":31579,"_21623":57508,"_28405":57509,"_3078":57510},[],"/docs/pr-preview/pr-76/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3626":2094,"_31224":2086,"_5":31579,"_21623":57512,"_28405":57513,"_3078":57514},[],"/docs/pr-preview/pr-76/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3626":2095,"_31224":2086,"_5":31579,"_21623":57516,"_28405":57517,"_3078":57518},[],"/docs/pr-preview/pr-76/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3626":2096,"_31224":2086,"_5":31579,"_21623":57520,"_28405":57521,"_3078":57522},[],"/docs/pr-preview/pr-76/platform/pki/certificates#continue","Continue",{"_3626":2097,"_31224":2086,"_21623":57524,"_5":14874,"_28405":2086,"_3078":57525},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3626":2098,"_31224":2086,"_21623":57527,"_5":14874,"_28405":57489,"_3078":57528},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3626":2099,"_31224":2086,"_21623":57530,"_5":14874,"_28405":57489,"_3078":57531},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3626":2100,"_31224":2086,"_21623":57533,"_5":14874,"_28405":57489,"_3078":57534},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3626":2101,"_31224":2086,"_21623":57536,"_5":14874,"_28405":57489,"_3078":57537},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3626":2102,"_31224":2086,"_21623":57539,"_5":14874,"_28405":57489,"_3078":57540},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3626":2103,"_31224":2086,"_21623":57542,"_5":14874,"_28405":57489,"_3078":57543},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3626":2104,"_31224":2086,"_21623":57545,"_5":14874,"_28405":57489,"_3078":57546},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3626":2105,"_31224":2086,"_21623":57548,"_5":14874,"_28405":57493,"_3078":57549},[],"Download the PEM and inspect it:",{"_3626":2106,"_31224":2086,"_21623":57551,"_5":14874,"_28405":57493,"_3078":57552},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3626":2107,"_31224":2086,"_21623":57554,"_5":14874,"_28405":57497,"_3078":57555},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3626":2108,"_31224":2086,"_21623":57557,"_5":14874,"_28405":57497,"_3078":57558},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3626":2109,"_31224":2086,"_21623":57560,"_5":14874,"_28405":57497,"_3078":57561},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3626":2110,"_31224":2086,"_21623":57563,"_5":14874,"_28405":57497,"_3078":57564},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3626":2111,"_31224":2086,"_21623":57566,"_5":14874,"_28405":57497,"_3078":57567},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3626":2112,"_31224":2086,"_21623":57569,"_5":14874,"_28405":57497,"_3078":57570},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3626":2113,"_31224":2086,"_21623":57572,"_5":14874,"_28405":57497,"_3078":57573},[],"For browser key generation, follow Issue your first certificate.",{"_3626":2114,"_31224":2086,"_21623":57575,"_5":14874,"_28405":57501,"_3078":57576},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3626":2115,"_31224":2086,"_21623":57578,"_5":14874,"_28405":57505,"_3078":57579},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3626":2116,"_31224":2086,"_21623":57581,"_5":14874,"_28405":57509,"_3078":57582},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3626":2117,"_31224":2086,"_21623":57584,"_5":14874,"_28405":57513,"_3078":57585},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3626":2118,"_31224":2086,"_21623":57587,"_5":14874,"_28405":57513,"_3078":57588},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3626":2119,"_31224":2086,"_21623":57590,"_5":14874,"_28405":57513,"_3078":57591},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3626":2120,"_31224":2086,"_21623":57593,"_5":14874,"_28405":57517,"_3078":57594},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3626":2121,"_31224":2086,"_21623":57596,"_5":14874,"_28405":57517,"_3078":57597},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3626":2122,"_31224":2086,"_21623":57599,"_5":14874,"_28405":57517,"_3078":57600},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3626":2123,"_31224":2086,"_21623":57602,"_5":14874,"_28405":57521,"_3078":57603},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3626":2124,"_31224":2086,"_21623":57605,"_5":14874,"_28405":57521,"_3078":57606},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3626":2125,"_31224":2125,"_5":15239,"_3078":57608,"_31582":57609,"_21623":57611,"_28405":2125},"Certificate lifecycle",[51011,52523,56704,57610],"Concepts",[],{"_3626":2126,"_31224":2125,"_21623":57613,"_5":14874,"_28405":2125,"_3078":57614},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3626":2127,"_31224":2125,"_5":31579,"_21623":57616,"_28405":57617,"_3078":57618},[],"/docs/pr-preview/pr-76/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3626":2128,"_31224":2125,"_5":31579,"_21623":57620,"_28405":57621,"_3078":57622},[],"/docs/pr-preview/pr-76/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3626":2129,"_31224":2125,"_5":31579,"_21623":57624,"_28405":57625,"_3078":57626},[],"/docs/pr-preview/pr-76/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3626":2130,"_31224":2125,"_5":31579,"_21623":57628,"_28405":57629,"_3078":57630},[],"/docs/pr-preview/pr-76/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3626":2131,"_31224":2125,"_5":31579,"_21623":57632,"_28405":57633,"_3078":57634},[],"/docs/pr-preview/pr-76/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3626":2132,"_31224":2125,"_5":31579,"_21623":57636,"_28405":57637,"_3078":57638},[],"/docs/pr-preview/pr-76/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3626":2133,"_31224":2125,"_5":31579,"_21623":57640,"_28405":57641,"_3078":57642},[],"/docs/pr-preview/pr-76/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3626":2134,"_31224":2125,"_5":31579,"_21623":57644,"_28405":57645,"_3078":57646},[],"/docs/pr-preview/pr-76/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3626":2135,"_31224":2125,"_5":31579,"_21623":57648,"_28405":57649,"_3078":57650},[],"/docs/pr-preview/pr-76/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3626":2136,"_31224":2125,"_5":31579,"_21623":57652,"_28405":57653,"_3078":57654},[],"/docs/pr-preview/pr-76/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3626":2137,"_31224":2125,"_21623":57656,"_5":14874,"_28405":2125,"_3078":57657},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3626":2138,"_31224":2125,"_21623":57659,"_5":14874,"_28405":57621,"_3078":57660},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3626":2139,"_31224":2125,"_21623":57662,"_5":14874,"_28405":57625,"_3078":57663},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3626":2140,"_31224":2125,"_21623":57665,"_5":14874,"_28405":57629,"_3078":57666},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3626":2141,"_31224":2125,"_21623":57668,"_5":14874,"_28405":57633,"_3078":57669},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3626":2142,"_31224":2125,"_21623":57671,"_5":14874,"_28405":57637,"_3078":57672},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3626":2143,"_31224":2125,"_21623":57674,"_5":14874,"_28405":57641,"_3078":57675},[],"Lamassu persists four X.509 states:",{"_3626":2144,"_31224":2125,"_21623":57677,"_5":14874,"_28405":57641,"_3078":57678},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3626":2145,"_31224":2125,"_21623":57680,"_5":14874,"_28405":57641,"_3078":57681},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3626":2146,"_31224":2125,"_21623":57683,"_5":14874,"_28405":57641,"_3078":57684},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3626":2147,"_31224":2125,"_21623":57686,"_5":14874,"_28405":57641,"_3078":57687},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3626":2148,"_31224":2125,"_21623":57689,"_5":14874,"_28405":57641,"_3078":57690},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3626":2149,"_31224":2125,"_21623":57692,"_5":14874,"_28405":57645,"_3078":57693},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3626":2150,"_31224":2125,"_21623":57695,"_5":14874,"_28405":57645,"_3078":57696},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3626":2151,"_31224":2125,"_21623":57698,"_5":14874,"_28405":57645,"_3078":57699},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3626":2152,"_31224":2125,"_21623":57701,"_5":14874,"_28405":57649,"_3078":57702},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3626":2153,"_31224":2125,"_21623":57704,"_5":14874,"_28405":57649,"_3078":57705},[],"Before confirming:",{"_3626":2154,"_31224":2125,"_21623":57707,"_5":14874,"_28405":57649,"_3078":57708},[],"Identify DMSs, devices and services that trust that chain.",{"_3626":2155,"_31224":2125,"_21623":57710,"_5":14874,"_28405":57649,"_3078":57711},[],"Distribute the new chain of trust.",{"_3626":2156,"_31224":2125,"_21623":57713,"_5":14874,"_28405":57649,"_3078":57714},[],"Reissue the necessary identities.",{"_3626":2157,"_31224":2125,"_21623":57716,"_5":14874,"_28405":57649,"_3078":57717},[],"Check OCSP and CRL from a real consumer.",{"_3626":2158,"_31224":2125,"_21623":57719,"_5":14874,"_28405":57649,"_3078":57720},[],"Revoke the old CA once no legitimate traffic remains.",{"_3626":2159,"_31224":2125,"_21623":57722,"_5":14874,"_28405":57649,"_3078":57723},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3626":2160,"_31224":2125,"_21623":57725,"_5":14874,"_28405":57653,"_3078":57726},[],"Certificates entering the preventive or critical renewal window.",{"_3626":2161,"_31224":2125,"_21623":57728,"_5":14874,"_28405":57653,"_3078":57729},[],"Repeated enrollment or re-enrollment failures.",{"_3626":2162,"_31224":2125,"_21623":57731,"_5":14874,"_28405":57653,"_3078":57732},[],"Status changes and revocation reasons.",{"_3626":2163,"_31224":2125,"_21623":57734,"_5":14874,"_28405":57653,"_3078":57735},[],"OCSP and CRL publication and validity.",{"_3626":2164,"_31224":2125,"_21623":57737,"_5":14874,"_28405":57653,"_3078":57738},[],"Dependencies still presenting a replaced certificate.",{"_3626":2165,"_31224":2125,"_21623":57740,"_5":14874,"_28405":57653,"_3078":57741},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3626":2166,"_31224":2166,"_5":15239,"_3078":57743,"_31582":57744,"_21623":57745,"_28405":2166},"Trust model",[51011,52523,56704,57610],[],{"_3626":2167,"_31224":2166,"_21623":57747,"_5":14874,"_28405":2166,"_3078":57748},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3626":2168,"_31224":2166,"_5":31579,"_21623":57750,"_28405":57751,"_3078":57752},[],"/docs/pr-preview/pr-76/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3626":2169,"_31224":2166,"_5":31579,"_21623":57754,"_28405":57755,"_3078":57756},[],"/docs/pr-preview/pr-76/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3626":2170,"_31224":2166,"_5":31579,"_21623":57758,"_28405":57759,"_3078":57760},[],"/docs/pr-preview/pr-76/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3626":2171,"_31224":2166,"_5":31579,"_21623":57762,"_28405":57763,"_3078":57764},[],"/docs/pr-preview/pr-76/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3626":2172,"_31224":2166,"_5":31579,"_21623":57766,"_28405":57767,"_3078":57768},[],"/docs/pr-preview/pr-76/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3626":2173,"_31224":2166,"_5":31579,"_21623":57770,"_28405":57771,"_3078":57772},[],"/docs/pr-preview/pr-76/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3626":2174,"_31224":2166,"_5":31579,"_21623":57774,"_28405":57775,"_3078":57776},[],"/docs/pr-preview/pr-76/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3626":2175,"_31224":2166,"_5":31579,"_21623":57778,"_28405":57779,"_3078":57780},[],"/docs/pr-preview/pr-76/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3626":2176,"_31224":2166,"_5":31579,"_21623":57782,"_28405":57783,"_3078":57784},[],"/docs/pr-preview/pr-76/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3626":2177,"_31224":2166,"_5":31579,"_21623":57786,"_28405":57787,"_3078":57788},[],"/docs/pr-preview/pr-76/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3626":2178,"_31224":2166,"_21623":57790,"_5":14874,"_28405":2166,"_3078":57791},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3626":2179,"_31224":2166,"_21623":57793,"_5":14874,"_28405":57755,"_3078":57794},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3626":2180,"_31224":2166,"_21623":57796,"_5":14874,"_28405":57759,"_3078":57797},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3626":2181,"_31224":2166,"_21623":57799,"_5":14874,"_28405":57763,"_3078":57800},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3626":2182,"_31224":2166,"_21623":57802,"_5":14874,"_28405":57767,"_3078":57803},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3626":2183,"_31224":2166,"_21623":57805,"_5":14874,"_28405":57771,"_3078":57806},[],"The device proves it can enroll according to the DMS policy.",{"_3626":2184,"_31224":2166,"_21623":57808,"_5":14874,"_28405":57771,"_3078":57809},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3626":2185,"_31224":2166,"_21623":57811,"_5":14874,"_28405":57771,"_3078":57812},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3626":2186,"_31224":2166,"_21623":57814,"_5":14874,"_28405":57771,"_3078":57815},[],"The device installs the certificate and the chain it needs.",{"_3626":2187,"_31224":2166,"_21623":57817,"_5":14874,"_28405":57771,"_3078":57818},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3626":2188,"_31224":2166,"_21623":57820,"_5":14874,"_28405":57771,"_3078":57821},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3626":2189,"_31224":2166,"_21623":57823,"_5":14874,"_28405":57775,"_3078":57824},[],"A DMS relates three sets that are worth designing separately:",{"_3626":2190,"_31224":2166,"_21623":57826,"_5":14874,"_28405":57775,"_3078":57827},[],"**Enrollment CA:** signs the new identities.",{"_3626":2191,"_31224":2166,"_21623":57829,"_5":14874,"_28405":57775,"_3078":57830},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3626":2192,"_31224":2166,"_21623":57832,"_5":14874,"_28405":57775,"_3078":57833},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3626":2193,"_31224":2166,"_21623":57835,"_5":14874,"_28405":57775,"_3078":57836},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3626":2194,"_31224":2166,"_21623":57838,"_5":14874,"_28405":57779,"_3078":57839},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3626":2195,"_31224":2166,"_21623":57841,"_5":14874,"_28405":57779,"_3078":57842},[],"that the current date is between `Not Before` and `Not After`;",{"_3626":2196,"_31224":2166,"_21623":57844,"_5":14874,"_28405":57779,"_3078":57845},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3626":2197,"_31224":2166,"_21623":57847,"_5":14874,"_28405":57779,"_3078":57848},[],"that names, SANs and subject match the expected identity;",{"_3626":2198,"_31224":2166,"_21623":57850,"_5":14874,"_28405":57779,"_3078":57851},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3626":2199,"_31224":2166,"_21623":57853,"_5":14874,"_28405":57779,"_3078":57854},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3626":2200,"_31224":2166,"_21623":57856,"_5":14874,"_28405":57779,"_3078":57857},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3626":2201,"_31224":2166,"_21623":57859,"_5":14874,"_28405":57783,"_3078":57860},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3626":2202,"_31224":2166,"_21623":57862,"_5":14874,"_28405":57787,"_3078":57863},[],"Keep the root out of daily operations, or with very restricted access.",{"_3626":2203,"_31224":2166,"_21623":57865,"_5":14874,"_28405":57787,"_3078":57866},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3626":2204,"_31224":2166,"_21623":57868,"_5":14874,"_28405":57787,"_3078":57869},[],"Assign explicit profiles to every use case.",{"_3626":2205,"_31224":2166,"_21623":57871,"_5":14874,"_28405":57787,"_3078":57872},[],"Distribute the new trust before starting a rotation.",{"_3626":2206,"_31224":2166,"_21623":57874,"_5":14874,"_28405":57787,"_3078":57875},[],"Keep enough overlap to renew a disconnected fleet.",{"_3626":2207,"_31224":2166,"_21623":57877,"_5":14874,"_28405":57787,"_3078":57878},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3626":2208,"_31224":2166,"_21623":57880,"_5":14874,"_28405":57787,"_3078":57881},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3626":2209,"_31224":2209,"_5":15239,"_3078":57883,"_31582":57884,"_21623":57885,"_28405":2209},"Revocation lists (CRL)",[51011,52523,56704,57355],[],{"_3626":2210,"_31224":2209,"_21623":57887,"_5":14874,"_28405":2209,"_3078":57888},[],"Generate and distribute signed lists to validate certificates offline.",{"_3626":2211,"_31224":2209,"_5":31579,"_21623":57890,"_28405":57891,"_3078":57892},[],"/docs/pr-preview/pr-76/platform/pki/crl#crl-settings","CRL settings",{"_3626":2212,"_31224":2209,"_5":31579,"_21623":57894,"_28405":57895,"_3078":57896},[],"/docs/pr-preview/pr-76/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3626":2213,"_31224":2209,"_5":31579,"_21623":57898,"_28405":57899,"_3078":57900},[],"/docs/pr-preview/pr-76/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3626":2214,"_31224":2209,"_5":31579,"_21623":57902,"_28405":57903,"_3078":57904},[],"/docs/pr-preview/pr-76/platform/pki/crl#crl-contents","CRL contents",{"_3626":2215,"_31224":2209,"_5":31579,"_21623":57906,"_28405":57907,"_3078":57908},[],"/docs/pr-preview/pr-76/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3626":2216,"_31224":2209,"_5":31579,"_21623":57910,"_28405":57911,"_3078":57912},[],"/docs/pr-preview/pr-76/platform/pki/crl#crl-settings-api","CRL settings API",{"_3626":2217,"_31224":2209,"_5":31579,"_21623":57914,"_28405":57915,"_3078":57916},[],"/docs/pr-preview/pr-76/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3626":2218,"_31224":2209,"_5":31579,"_21623":57918,"_28405":57919,"_3078":57920},[],"/docs/pr-preview/pr-76/platform/pki/crl#references","References",{"_3626":2219,"_31224":2209,"_21623":57922,"_5":14874,"_28405":2209,"_3078":57923},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3626":2220,"_31224":2209,"_21623":57925,"_5":14874,"_28405":57891,"_3078":57926},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3626":2221,"_31224":2209,"_21623":57928,"_5":14874,"_28405":57891,"_3078":57929},[],"Field",{"_3626":2222,"_31224":2209,"_21623":57931,"_5":14874,"_28405":57891,"_3078":51401},[],{"_3626":2223,"_31224":2209,"_21623":57933,"_5":14874,"_28405":57891,"_3078":52643},[],{"_3626":2224,"_31224":2209,"_21623":57935,"_5":14874,"_28405":57891,"_3078":57936},[],"ID of the CA the settings belong to.",{"_3626":2225,"_31224":2209,"_21623":57938,"_5":14874,"_28405":57891,"_3078":57939},[],"`status`",{"_3626":2226,"_31224":2209,"_21623":57941,"_5":14874,"_28405":57891,"_3078":57942},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3626":2227,"_31224":2209,"_21623":57944,"_5":14874,"_28405":57891,"_3078":57945},[],"`legacy_ski`",{"_3626":2228,"_31224":2209,"_21623":57947,"_5":14874,"_28405":57891,"_3078":57948},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3626":2229,"_31224":2209,"_21623":57950,"_5":14874,"_28405":57891,"_3078":57951},[],"`latest_crl`",{"_3626":2230,"_31224":2209,"_21623":57953,"_5":14874,"_28405":57891,"_3078":57954},[],"Version, validity start and end of the last published list. Read-only.",{"_3626":2231,"_31224":2209,"_21623":57956,"_5":14874,"_28405":57891,"_3078":57957},[],"`crl_options` field",{"_3626":2232,"_31224":2209,"_21623":57959,"_5":14874,"_28405":57891,"_3078":51401},[],{"_3626":2233,"_31224":2209,"_21623":57961,"_5":14874,"_28405":57891,"_3078":57962},[],"Initial value",{"_3626":2234,"_31224":2209,"_21623":57964,"_5":14874,"_28405":57891,"_3078":57965},[],"`validity`",{"_3626":2235,"_31224":2209,"_21623":57967,"_5":14874,"_28405":57891,"_3078":57968},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3626":2236,"_31224":2209,"_21623":57970,"_5":14874,"_28405":57891,"_3078":57971},[],"7 days.",{"_3626":2237,"_31224":2209,"_21623":57973,"_5":14874,"_28405":57891,"_3078":57974},[],"`refresh_interval`",{"_3626":2238,"_31224":2209,"_21623":57976,"_5":14874,"_28405":57891,"_3078":57977},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3626":2239,"_31224":2209,"_21623":57979,"_5":14874,"_28405":57891,"_3078":57980},[],"6 days and 23 hours.",{"_3626":2240,"_31224":2209,"_21623":57982,"_5":14874,"_28405":57891,"_3078":57983},[],"`regenerate_on_revoke`",{"_3626":2241,"_31224":2209,"_21623":57985,"_5":14874,"_28405":57891,"_3078":57986},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3626":2242,"_31224":2209,"_21623":57988,"_5":14874,"_28405":57891,"_3078":57989},[],"`true`.",{"_3626":2243,"_31224":2209,"_21623":57991,"_5":14874,"_28405":57891,"_3078":57992},[],"`signer_serial_number`",{"_3626":2244,"_31224":2209,"_21623":57994,"_5":14874,"_28405":57891,"_3078":57995},[],"Serial number of the existing certificate that signs the CRL.",{"_3626":2245,"_31224":2209,"_21623":57997,"_5":14874,"_28405":57891,"_3078":57998},[],"Serial number of the CA’s current certificate.",{"_3626":2246,"_31224":2209,"_21623":58000,"_5":14874,"_28405":57891,"_3078":58001},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3626":2247,"_31224":2209,"_21623":58003,"_5":14874,"_28405":57891,"_3078":58004},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3626":2248,"_31224":2209,"_21623":58006,"_5":14874,"_28405":57891,"_3078":58007},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3626":2249,"_31224":2209,"_21623":58009,"_5":14874,"_28405":57891,"_3078":58010},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3626":2250,"_31224":2209,"_21623":58012,"_5":14874,"_28405":57891,"_3078":58013},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3626":2251,"_31224":2209,"_21623":58015,"_5":14874,"_28405":57891,"_3078":58016},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3626":2252,"_31224":2209,"_21623":58018,"_5":14874,"_28405":57891,"_3078":58019},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3626":2253,"_31224":2209,"_21623":58021,"_5":14874,"_28405":57891,"_3078":58022},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3626":2254,"_31224":2209,"_21623":58024,"_5":14874,"_28405":57891,"_3078":58025},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3626":2255,"_31224":2209,"_21623":58027,"_5":14874,"_28405":57891,"_3078":58028},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3626":2256,"_31224":2209,"_21623":58030,"_5":14874,"_28405":57891,"_3078":58031},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3626":2257,"_31224":2209,"_21623":58033,"_5":14874,"_28405":57895,"_3078":58034},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3626":2258,"_31224":2209,"_21623":58036,"_5":14874,"_28405":57895,"_3078":58037},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3626":2259,"_31224":2209,"_21623":58039,"_5":14874,"_28405":57895,"_3078":58040},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3626":2260,"_31224":2209,"_21623":58042,"_5":14874,"_28405":57895,"_3078":58043},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3626":2261,"_31224":2209,"_21623":58045,"_5":14874,"_28405":57899,"_3078":58046},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3626":2262,"_31224":2209,"_21623":58048,"_5":14874,"_28405":57899,"_3078":58049},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3626":2263,"_31224":2209,"_21623":58051,"_5":14874,"_28405":57899,"_3078":58052},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3626":2264,"_31224":2209,"_21623":58054,"_5":14874,"_28405":57899,"_3078":58055},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3626":2265,"_31224":2209,"_21623":58057,"_5":14874,"_28405":57899,"_3078":58058},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3626":2266,"_31224":2209,"_21623":58060,"_5":14874,"_28405":57899,"_3078":58061},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3626":2267,"_31224":2209,"_21623":58063,"_5":14874,"_28405":57899,"_3078":58064},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3626":2268,"_31224":2209,"_21623":58066,"_5":14874,"_28405":57899,"_3078":58067},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3626":2269,"_31224":2209,"_21623":58069,"_5":14874,"_28405":57899,"_3078":58070},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3626":2270,"_31224":2209,"_21623":58072,"_5":14874,"_28405":57903,"_3078":58073},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3626":2271,"_31224":2209,"_21623":58075,"_5":14874,"_28405":57903,"_3078":58076},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3626":2272,"_31224":2209,"_21623":58078,"_5":14874,"_28405":57907,"_3078":58079},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3626":2273,"_31224":2209,"_21623":58081,"_5":14874,"_28405":57907,"_3078":58082},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3626":2274,"_31224":2209,"_21623":58084,"_5":14874,"_28405":57907,"_3078":58085},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3626":2275,"_31224":2209,"_21623":58087,"_5":14874,"_28405":57907,"_3078":58088},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3626":2276,"_31224":2209,"_21623":58090,"_5":14874,"_28405":57907,"_3078":58091},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3626":2277,"_31224":2209,"_21623":58093,"_5":14874,"_28405":57911,"_3078":58094},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3626":2278,"_31224":2209,"_21623":58096,"_5":14874,"_28405":57911,"_3078":54463},[],{"_3626":2279,"_31224":2209,"_21623":58098,"_5":14874,"_28405":57911,"_3078":58099},[],"Relative path",{"_3626":2280,"_31224":2209,"_21623":58101,"_5":14874,"_28405":57911,"_3078":54460},[],{"_3626":2281,"_31224":2209,"_21623":58103,"_5":14874,"_28405":57911,"_3078":58104},[],"`GET`",{"_3626":2282,"_31224":2209,"_21623":58106,"_5":14874,"_28405":57911,"_3078":58107},[],"`/v1/crl-settings`",{"_3626":2283,"_31224":2209,"_21623":58109,"_5":14874,"_28405":57911,"_3078":58110},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3626":2284,"_31224":2209,"_21623":58112,"_5":14874,"_28405":57911,"_3078":58104},[],{"_3626":2285,"_31224":2209,"_21623":58114,"_5":14874,"_28405":57911,"_3078":58115},[],"`/v1/crl-settings/{ca-id}`",{"_3626":2286,"_31224":2209,"_21623":58117,"_5":14874,"_28405":57911,"_3078":58118},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3626":2287,"_31224":2209,"_21623":58120,"_5":14874,"_28405":57911,"_3078":58121},[],"`PUT`",{"_3626":2288,"_31224":2209,"_21623":58123,"_5":14874,"_28405":57911,"_3078":58115},[],{"_3626":2289,"_31224":2209,"_21623":58125,"_5":14874,"_28405":57911,"_3078":58126},[],"Replace the CRL configuration of a CA.",{"_3626":2290,"_31224":2209,"_21623":58128,"_5":14874,"_28405":57911,"_3078":58129},[],"`DELETE`",{"_3626":2291,"_31224":2209,"_21623":58131,"_5":14874,"_28405":57911,"_3078":58115},[],{"_3626":2292,"_31224":2209,"_21623":58133,"_5":14874,"_28405":57911,"_3078":58134},[],"Remove the archived CRL settings of a CA.",{"_3626":2293,"_31224":2209,"_21623":58136,"_5":14874,"_28405":57911,"_3078":58137},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3626":2294,"_31224":2209,"_21623":58139,"_5":14874,"_28405":57911,"_3078":58140},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3626":2295,"_31224":2209,"_21623":58142,"_5":14874,"_28405":57911,"_3078":58143},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3626":2296,"_31224":2209,"_21623":58145,"_5":14874,"_28405":57915,"_3078":58146},[],"Symptom",{"_3626":2297,"_31224":2209,"_21623":58148,"_5":14874,"_28405":57915,"_3078":58149},[],"Cause",{"_3626":2298,"_31224":2209,"_21623":58151,"_5":14874,"_28405":57915,"_3078":58152},[],"Action",{"_3626":2299,"_31224":2209,"_21623":58154,"_5":14874,"_28405":57915,"_3078":58155},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3626":2300,"_31224":2209,"_21623":58157,"_5":14874,"_28405":57915,"_3078":58158},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3626":2301,"_31224":2209,"_21623":58160,"_5":14874,"_28405":57915,"_3078":58161},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3626":2302,"_31224":2209,"_21623":58163,"_5":14874,"_28405":57915,"_3078":58164},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3626":2303,"_31224":2209,"_21623":58166,"_5":14874,"_28405":57915,"_3078":58167},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3626":2304,"_31224":2209,"_21623":58169,"_5":14874,"_28405":57915,"_3078":58170},[],"Delete the CA first; deleting it archives its settings.",{"_3626":2305,"_31224":2209,"_21623":58172,"_5":14874,"_28405":57915,"_3078":58173},[],"`PUT` returns 400.",{"_3626":2306,"_31224":2209,"_21623":58175,"_5":14874,"_28405":57915,"_3078":58176},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3626":2307,"_31224":2209,"_21623":58178,"_5":14874,"_28405":57915,"_3078":58179},[],"Set the serial number of a valid certificate of that CA.",{"_3626":2308,"_31224":2209,"_21623":58181,"_5":14874,"_28405":57915,"_3078":58182},[],"`PUT` returns 404.",{"_3626":2309,"_31224":2209,"_21623":58184,"_5":14874,"_28405":57915,"_3078":58185},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3626":2310,"_31224":2209,"_21623":58187,"_5":14874,"_28405":57915,"_3078":58188},[],"Check the CA ID and the signer serial number.",{"_3626":2311,"_31224":2209,"_21623":58190,"_5":14874,"_28405":57915,"_3078":58191},[],"`PUT` returns 400 from a 3.x client.",{"_3626":2312,"_31224":2209,"_21623":58193,"_5":14874,"_28405":57915,"_3078":58194},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3626":2313,"_31224":2209,"_21623":58196,"_5":14874,"_28405":57915,"_3078":58197},[],"Update the client to send the new field.",{"_3626":2314,"_31224":2209,"_21623":58199,"_5":14874,"_28405":57915,"_3078":58200},[],"The CRL does not change after revoking a certificate.",{"_3626":2315,"_31224":2209,"_21623":58202,"_5":14874,"_28405":57915,"_3078":58203},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3626":2316,"_31224":2209,"_21623":58205,"_5":14874,"_28405":57915,"_3078":58206},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3626":2317,"_31224":2209,"_21623":58208,"_5":14874,"_28405":57915,"_3078":58209},[],"A verifier rejects the CRL because of the issuer.",{"_3626":2318,"_31224":2209,"_21623":58211,"_5":14874,"_28405":57915,"_3078":58212},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3626":2319,"_31224":2209,"_21623":58214,"_5":14874,"_28405":57915,"_3078":58215},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3626":2320,"_31224":2209,"_21623":58217,"_5":14874,"_28405":57919,"_3078":58218},[],"RFC 5280: X.509 and CRL profile.",{"_3626":2321,"_31224":2209,"_21623":58220,"_5":14874,"_28405":57919,"_3078":58221},[],"OpenSSL: openssl-crl.",{"_3626":2322,"_31224":2209,"_21623":58223,"_5":14874,"_28405":57919,"_3078":58224},[],"OpenSSL: openssl-verify.",{"_3626":2323,"_31224":2209,"_21623":58226,"_5":14874,"_28405":57919,"_3078":58227},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3626":2324,"_31224":2209,"_21623":58229,"_5":14874,"_28405":57919,"_3078":58230},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3626":2325,"_31224":2325,"_5":15239,"_3078":58232,"_31582":58233,"_21623":58234,"_28405":2325},"Keys and cryptographic engines",[51011,52523,56704,56705],[],{"_3626":2326,"_31224":2325,"_21623":58236,"_5":14874,"_28405":2325,"_3078":58237},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3626":2327,"_31224":2325,"_5":31579,"_21623":58239,"_28405":58240,"_3078":58241},[],"/docs/pr-preview/pr-76/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3626":2328,"_31224":2325,"_5":31579,"_21623":58243,"_28405":58244,"_3078":58245},[],"/docs/pr-preview/pr-76/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3626":2329,"_31224":2325,"_5":31579,"_21623":58247,"_28405":58248,"_3078":58249},[],"/docs/pr-preview/pr-76/platform/pki/key-management#file-system","File System",{"_3626":2330,"_31224":2325,"_5":31579,"_21623":58251,"_28405":58252,"_3078":58253},[],"/docs/pr-preview/pr-76/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3626":2331,"_31224":2325,"_5":31579,"_21623":58255,"_28405":58256,"_3078":58257},[],"/docs/pr-preview/pr-76/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3626":2332,"_31224":2325,"_5":31579,"_21623":58259,"_28405":58260,"_3078":58261},[],"/docs/pr-preview/pr-76/platform/pki/key-management#aws-kms","AWS KMS",{"_3626":2333,"_31224":2325,"_5":31579,"_21623":58263,"_28405":58264,"_3078":58265},[],"/docs/pr-preview/pr-76/platform/pki/key-management#pkcs11","PKCS#11",{"_3626":2334,"_31224":2325,"_5":31579,"_21623":58267,"_28405":58268,"_3078":58269},[],"/docs/pr-preview/pr-76/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3626":2335,"_31224":2325,"_5":31579,"_21623":58271,"_28405":58272,"_3078":58273},[],"/docs/pr-preview/pr-76/platform/pki/key-management#key-inventory","Key inventory",{"_3626":2336,"_31224":2325,"_5":31579,"_21623":58275,"_28405":58276,"_3078":58277},[],"/docs/pr-preview/pr-76/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3626":2337,"_31224":2325,"_5":31579,"_21623":58279,"_28405":58280,"_3078":58281},[],"/docs/pr-preview/pr-76/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3626":2338,"_31224":2325,"_5":31579,"_21623":58283,"_28405":58284,"_3078":58285},[],"/docs/pr-preview/pr-76/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3626":2339,"_31224":2325,"_5":31579,"_21623":58287,"_28405":58288,"_3078":58289},[],"/docs/pr-preview/pr-76/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3626":2340,"_31224":2325,"_5":31579,"_21623":58291,"_28405":58292,"_3078":58293},[],"/docs/pr-preview/pr-76/platform/pki/key-management#view-details","View details",{"_3626":2341,"_31224":2325,"_5":31579,"_21623":58295,"_28405":58296,"_3078":58297},[],"/docs/pr-preview/pr-76/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3626":2342,"_31224":2325,"_5":31579,"_21623":58299,"_28405":58300,"_3078":58301},[],"/docs/pr-preview/pr-76/platform/pki/key-management#sign","Sign",{"_3626":2343,"_31224":2325,"_5":31579,"_21623":58303,"_28405":58304,"_3078":58305},[],"/docs/pr-preview/pr-76/platform/pki/key-management#verify","Verify",{"_3626":2344,"_31224":2325,"_5":31579,"_21623":58307,"_28405":58308,"_3078":58309},[],"/docs/pr-preview/pr-76/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3626":2345,"_31224":2325,"_5":31579,"_21623":58311,"_28405":58312,"_3078":58313},[],"/docs/pr-preview/pr-76/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3626":2346,"_31224":2325,"_5":31579,"_21623":58315,"_28405":58316,"_3078":58317},[],"/docs/pr-preview/pr-76/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3626":2347,"_31224":2325,"_21623":58319,"_5":14874,"_28405":2325,"_3078":58320},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3626":2348,"_31224":2325,"_21623":58322,"_5":14874,"_28405":2325,"_3078":58323},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3626":2349,"_31224":2325,"_21623":58325,"_5":14874,"_28405":58240,"_3078":58326},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3626":2350,"_31224":2325,"_21623":58328,"_5":14874,"_28405":58240,"_3078":58329},[],"In practice, it lets you:",{"_3626":2351,"_31224":2325,"_21623":58331,"_5":14874,"_28405":58240,"_3078":58332},[],"Generate new key pairs from Lamassu IoT.",{"_3626":2352,"_31224":2325,"_21623":58334,"_5":14874,"_28405":58240,"_3078":58335},[],"Import keys created externally.",{"_3626":2353,"_31224":2325,"_21623":58337,"_5":14874,"_28405":58240,"_3078":58338},[],"Delegate custody and cryptographic operations to external engines.",{"_3626":2354,"_31224":2325,"_21623":58340,"_5":14874,"_28405":58240,"_3078":58341},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3626":2355,"_31224":2325,"_21623":58343,"_5":14874,"_28405":58244,"_3078":58344},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3626":2356,"_31224":2325,"_21623":58346,"_5":14874,"_28405":58244,"_3078":58347},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3626":2357,"_31224":2325,"_21623":58349,"_5":14874,"_28405":58244,"_3078":58350},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3626":2358,"_31224":2325,"_21623":58352,"_5":14874,"_28405":58248,"_3078":58353},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3626":2359,"_31224":2325,"_21623":58355,"_5":14874,"_28405":58252,"_3078":58356},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3626":2360,"_31224":2325,"_21623":58358,"_5":14874,"_28405":58252,"_3078":58359},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3626":2361,"_31224":2325,"_21623":58361,"_5":14874,"_28405":58256,"_3078":58362},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3626":2362,"_31224":2325,"_21623":58364,"_5":14874,"_28405":58260,"_3078":58365},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3626":2363,"_31224":2325,"_21623":58367,"_5":14874,"_28405":58264,"_3078":58368},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3626":2364,"_31224":2325,"_21623":58370,"_5":14874,"_28405":58268,"_3078":58371},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3626":2365,"_31224":2325,"_21623":58373,"_5":14874,"_28405":58268,"_3078":58374},[],"Lamassu shows the enabled engines in the console.",{"_3626":2366,"_31224":2325,"_21623":58376,"_5":14874,"_28405":58268,"_3078":58377},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3626":2367,"_31224":2325,"_21623":58379,"_5":14874,"_28405":58268,"_3078":58380},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3626":2368,"_31224":2325,"_21623":58382,"_5":14874,"_28405":58272,"_3078":58383},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3626":2369,"_31224":2325,"_21623":58385,"_5":14874,"_28405":58272,"_3078":58386},[],"The table includes the following fields:",{"_3626":2370,"_31224":2325,"_21623":58388,"_5":14874,"_28405":58272,"_3078":58389},[],"**Name**: descriptive name of the key.",{"_3626":2371,"_31224":2325,"_21623":58391,"_5":14874,"_28405":58272,"_3078":58392},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3626":2372,"_31224":2325,"_21623":58394,"_5":14874,"_28405":58272,"_3078":58395},[],"**Strength**: visual indicator of cryptographic strength.",{"_3626":2373,"_31224":2325,"_21623":58397,"_5":14874,"_28405":58272,"_3078":58398},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3626":2374,"_31224":2325,"_21623":58400,"_5":14874,"_28405":58272,"_3078":58401},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3626":2375,"_31224":2325,"_21623":58403,"_5":14874,"_28405":58272,"_3078":58404},[],"**Aliases**: alternative names associated with the key.",{"_3626":2376,"_31224":2325,"_21623":58406,"_5":14874,"_28405":58272,"_3078":58407},[],"**Tags**: labels for classification and search.",{"_3626":2377,"_31224":2325,"_21623":58409,"_5":14874,"_28405":58272,"_3078":58410},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3626":2378,"_31224":2325,"_21623":58412,"_5":14874,"_28405":58272,"_3078":58413},[],"From this view you also reach the most common actions:",{"_3626":2379,"_31224":2325,"_21623":58415,"_5":14874,"_28405":58272,"_3078":58416},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3626":2380,"_31224":2325,"_21623":58418,"_5":14874,"_28405":58272,"_3078":58419},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3626":2381,"_31224":2325,"_21623":58421,"_5":14874,"_28405":58272,"_3078":58422},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3626":2382,"_31224":2325,"_21623":58424,"_5":14874,"_28405":58272,"_3078":58425},[],"**Delete Key** to remove the key from the system.",{"_3626":2383,"_31224":2325,"_21623":58427,"_5":14874,"_28405":58276,"_3078":58428},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3626":2384,"_31224":2325,"_21623":58430,"_5":14874,"_28405":58280,"_3078":58431},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3626":2385,"_31224":2325,"_21623":58433,"_5":14874,"_28405":58280,"_3078":58434},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3626":2386,"_31224":2325,"_21623":58436,"_5":14874,"_28405":58280,"_3078":58437},[],"**Key Name**: unique and descriptive name.",{"_3626":2387,"_31224":2325,"_21623":58439,"_5":14874,"_28405":58280,"_3078":58440},[],"**Crypto Engine**: engine that will keep the key.",{"_3626":2388,"_31224":2325,"_21623":58442,"_5":14874,"_28405":58280,"_3078":58443},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3626":2389,"_31224":2325,"_21623":58445,"_5":14874,"_28405":58280,"_3078":58446},[],"**Tags**: metadata to classify the key.",{"_3626":2390,"_31224":2325,"_21623":58448,"_5":14874,"_28405":58280,"_3078":58449},[],"**Metadata**: additional information for advanced uses.",{"_3626":2391,"_31224":2325,"_21623":58451,"_5":14874,"_28405":58284,"_3078":58452},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3626":2392,"_31224":2325,"_21623":58454,"_5":14874,"_28405":58284,"_3078":58455},[],"When you have an exportable private key and the destination engine supports import.",{"_3626":2393,"_31224":2325,"_21623":58457,"_5":14874,"_28405":58284,"_3078":58458},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3626":2394,"_31224":2325,"_21623":58460,"_5":14874,"_28405":58284,"_3078":58461},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3626":2395,"_31224":2325,"_21623":58463,"_5":14874,"_28405":58284,"_3078":58464},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3626":2396,"_31224":2325,"_21623":58466,"_5":14874,"_28405":58284,"_3078":58467},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3626":2397,"_31224":2325,"_21623":58469,"_5":14874,"_28405":58284,"_3078":58470},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3626":2398,"_31224":2325,"_21623":58472,"_5":14874,"_28405":58284,"_3078":58473},[],"**Tags**: labels for organization and search.",{"_3626":2399,"_31224":2325,"_21623":58475,"_5":14874,"_28405":58284,"_3078":58476},[],"**Metadata**: additional optional information.",{"_3626":2400,"_31224":2325,"_21623":58478,"_5":14874,"_28405":58284,"_3078":58479},[],"**Private Key (PEM)**: private key in PEM format.",{"_3626":2401,"_31224":2325,"_21623":58481,"_5":14874,"_28405":58284,"_3078":58482},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3626":2402,"_31224":2325,"_21623":58484,"_5":14874,"_28405":58288,"_3078":58485},[],"Each registered key has a detail view and several operational actions.",{"_3626":2403,"_31224":2325,"_21623":58487,"_5":14874,"_28405":58292,"_3078":58488},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3626":2404,"_31224":2325,"_21623":58490,"_5":14874,"_28405":58292,"_3078":58491},[],"The **Overview** tab shows, among others, these fields:",{"_3626":2405,"_31224":2325,"_21623":58493,"_5":14874,"_28405":58292,"_3078":58494},[],"**Key Name**: descriptive name.",{"_3626":2406,"_31224":2325,"_21623":58496,"_5":14874,"_28405":58292,"_3078":58497},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3626":2407,"_31224":2325,"_21623":58499,"_5":14874,"_28405":58292,"_3078":58500},[],"**Tags**: associated labels.",{"_3626":2408,"_31224":2325,"_21623":58502,"_5":14874,"_28405":58292,"_3078":58503},[],"**Aliases**: alternative names.",{"_3626":2409,"_31224":2325,"_21623":58505,"_5":14874,"_28405":58292,"_3078":58506},[],"**Crypto Engine**: engine where the key resides.",{"_3626":2410,"_31224":2325,"_21623":58508,"_5":14874,"_28405":58292,"_3078":58509},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3626":2411,"_31224":2325,"_21623":58511,"_5":14874,"_28405":58292,"_3078":58512},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3626":2412,"_31224":2325,"_21623":58514,"_5":14874,"_28405":58292,"_3078":58515},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3626":2413,"_31224":2325,"_21623":58517,"_5":14874,"_28405":58296,"_3078":58518},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3626":2414,"_31224":2325,"_21623":58520,"_5":14874,"_28405":58296,"_3078":58521},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3626":2415,"_31224":2325,"_21623":58523,"_5":14874,"_28405":58296,"_3078":58524},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3626":2416,"_31224":2325,"_21623":58526,"_5":14874,"_28405":58300,"_3078":58527},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3626":2417,"_31224":2325,"_21623":58529,"_5":14874,"_28405":58300,"_3078":58530},[],"Main fields:",{"_3626":2418,"_31224":2325,"_21623":58532,"_5":14874,"_28405":58300,"_3078":58533},[],"**Algorithm**: signing algorithm available for the key type.",{"_3626":2419,"_31224":2325,"_21623":58535,"_5":14874,"_28405":58300,"_3078":58536},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3626":2420,"_31224":2325,"_21623":58538,"_5":14874,"_28405":58300,"_3078":58539},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3626":2421,"_31224":2325,"_21623":58541,"_5":14874,"_28405":58300,"_3078":58542},[],"**Message**: content to sign.",{"_3626":2422,"_31224":2325,"_21623":58544,"_5":14874,"_28405":58300,"_3078":58545},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3626":2423,"_31224":2325,"_21623":58547,"_5":14874,"_28405":58304,"_3078":58548},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3626":2424,"_31224":2325,"_21623":58550,"_5":14874,"_28405":58304,"_3078":58530},[],{"_3626":2425,"_31224":2325,"_21623":58552,"_5":14874,"_28405":58304,"_3078":58553},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3626":2426,"_31224":2325,"_21623":58555,"_5":14874,"_28405":58304,"_3078":58556},[],"**Message Type**: `Raw` or `Digest`.",{"_3626":2427,"_31224":2325,"_21623":58558,"_5":14874,"_28405":58304,"_3078":58559},[],"**Payload Encoding**: encoding of the message.",{"_3626":2428,"_31224":2325,"_21623":58561,"_5":14874,"_28405":58304,"_3078":58562},[],"**Message**: original message or hash.",{"_3626":2429,"_31224":2325,"_21623":58564,"_5":14874,"_28405":58304,"_3078":58565},[],"**Signature**: signature to check.",{"_3626":2430,"_31224":2325,"_21623":58567,"_5":14874,"_28405":58304,"_3078":58568},[],"**Result**: indicator of the validation result.",{"_3626":2431,"_31224":2325,"_21623":58570,"_5":14874,"_28405":58308,"_3078":58571},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3626":2432,"_31224":2325,"_21623":58573,"_5":14874,"_28405":58308,"_3078":58574},[],"This flow is useful for:",{"_3626":2433,"_31224":2325,"_21623":58576,"_5":14874,"_28405":58308,"_3078":58577},[],"Requesting certificates from an external CA.",{"_3626":2434,"_31224":2325,"_21623":58579,"_5":14874,"_28405":58308,"_3078":58580},[],"Renewing an identity while keeping the same key.",{"_3626":2435,"_31224":2325,"_21623":58582,"_5":14874,"_28405":58308,"_3078":58583},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3626":2436,"_31224":2325,"_21623":58585,"_5":14874,"_28405":58308,"_3078":58586},[],"**Common Name (CN)**: main name of the identity.",{"_3626":2437,"_31224":2325,"_21623":58588,"_5":14874,"_28405":58308,"_3078":58589},[],"**Organization (O)**: organization or company.",{"_3626":2438,"_31224":2325,"_21623":58591,"_5":14874,"_28405":58308,"_3078":58592},[],"**Organizational Unit (OU)**: department or unit.",{"_3626":2439,"_31224":2325,"_21623":58594,"_5":14874,"_28405":58308,"_3078":58595},[],"**Country (C)**: two-letter country code.",{"_3626":2440,"_31224":2325,"_21623":58597,"_5":14874,"_28405":58308,"_3078":58598},[],"**State / Province (ST)**: state or province.",{"_3626":2441,"_31224":2325,"_21623":58600,"_5":14874,"_28405":58308,"_3078":58601},[],"**Locality (L)**: city or locality.",{"_3626":2442,"_31224":2325,"_21623":58603,"_5":14874,"_28405":58308,"_3078":58604},[],"**Email Address**: contact email.",{"_3626":2443,"_31224":2325,"_21623":58606,"_5":14874,"_28405":58308,"_3078":58607},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3626":2444,"_31224":2325,"_21623":58609,"_5":14874,"_28405":58308,"_3078":58610},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3626":2445,"_31224":2325,"_21623":58612,"_5":14874,"_28405":58312,"_3078":58613},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3626":2446,"_31224":2325,"_21623":58615,"_5":14874,"_28405":58312,"_3078":58616},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3626":2447,"_31224":2325,"_21623":58618,"_5":14874,"_28405":58316,"_3078":58619},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3626":2448,"_31224":2325,"_21623":58621,"_5":14874,"_28405":58316,"_3078":58622},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3626":2449,"_31224":2449,"_5":15239,"_3078":58624,"_31582":58625,"_21623":58626,"_28405":2449},"Online validation with OCSP",[51011,52523,56704,57355],[],{"_3626":2450,"_31224":2449,"_21623":58628,"_5":14874,"_28405":2449,"_3078":58629},[],"Query signed status and verify the responder’s response.",{"_3626":2451,"_31224":2449,"_5":31579,"_21623":58631,"_28405":58632,"_3078":58633},[],"/docs/pr-preview/pr-76/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3626":2452,"_31224":2449,"_5":31579,"_21623":58635,"_28405":58636,"_3078":58637},[],"/docs/pr-preview/pr-76/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3626":2453,"_31224":2449,"_5":31579,"_21623":58639,"_28405":58640,"_3078":58641},[],"/docs/pr-preview/pr-76/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3626":2454,"_31224":2449,"_5":31579,"_21623":58643,"_28405":58644,"_3078":58645},[],"/docs/pr-preview/pr-76/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3626":2455,"_31224":2449,"_5":31579,"_21623":58647,"_28405":58648,"_3078":58649},[],"/docs/pr-preview/pr-76/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3626":2456,"_31224":2449,"_5":31579,"_21623":58651,"_28405":58652,"_3078":57920},[],"/docs/pr-preview/pr-76/platform/pki/ocsp#references",{"_3626":2457,"_31224":2449,"_21623":58654,"_5":14874,"_28405":2449,"_3078":58655},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3626":2458,"_31224":2449,"_21623":58657,"_5":14874,"_28405":58632,"_3078":58658},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3626":2459,"_31224":2449,"_21623":58660,"_5":14874,"_28405":58632,"_3078":58661},[],"Record status",{"_3626":2460,"_31224":2449,"_21623":58663,"_5":14874,"_28405":58632,"_3078":58664},[],"Signed response",{"_3626":2461,"_31224":2449,"_21623":58666,"_5":14874,"_28405":58632,"_3078":55841},[],{"_3626":2462,"_31224":2449,"_21623":58668,"_5":14874,"_28405":58632,"_3078":58669},[],"`Good`.",{"_3626":2463,"_31224":2449,"_21623":58671,"_5":14874,"_28405":58632,"_3078":55858},[],{"_3626":2464,"_31224":2449,"_21623":58673,"_5":14874,"_28405":58632,"_3078":58674},[],"`Revoked`, with revocation reason and timestamp.",{"_3626":2465,"_31224":2449,"_21623":58676,"_5":14874,"_28405":58632,"_3078":58677},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3626":2466,"_31224":2449,"_21623":58679,"_5":14874,"_28405":58632,"_3078":58680},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3626":2467,"_31224":2449,"_21623":58682,"_5":14874,"_28405":58632,"_3078":58683},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3626":2468,"_31224":2449,"_21623":58685,"_5":14874,"_28405":58632,"_3078":58686},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3626":2469,"_31224":2449,"_21623":58688,"_5":14874,"_28405":58632,"_3078":58689},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3626":2470,"_31224":2449,"_21623":58691,"_5":14874,"_28405":58636,"_3078":58692},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3626":2471,"_31224":2449,"_21623":58694,"_5":14874,"_28405":58636,"_3078":58695},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3626":2472,"_31224":2449,"_21623":58697,"_5":14874,"_28405":58640,"_3078":58698},[],"The service accepts:",{"_3626":2473,"_31224":2449,"_21623":58700,"_5":14874,"_28405":58640,"_3078":54463},[],{"_3626":2474,"_31224":2449,"_21623":58702,"_5":14874,"_28405":58640,"_3078":58703},[],"VA service path",{"_3626":2475,"_31224":2449,"_21623":58705,"_5":14874,"_28405":58640,"_3078":58706},[],"Format",{"_3626":2476,"_31224":2449,"_21623":58708,"_5":14874,"_28405":58640,"_3078":58709},[],"`POST`",{"_3626":2477,"_31224":2449,"_21623":58711,"_5":14874,"_28405":58640,"_3078":58712},[],"`/ocsp`",{"_3626":2478,"_31224":2449,"_21623":58714,"_5":14874,"_28405":58640,"_3078":58715},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3626":2479,"_31224":2449,"_21623":58717,"_5":14874,"_28405":58640,"_3078":58104},[],{"_3626":2480,"_31224":2449,"_21623":58719,"_5":14874,"_28405":58640,"_3078":58720},[],"`/ocsp/{ocsp_request}`",{"_3626":2481,"_31224":2449,"_21623":58722,"_5":14874,"_28405":58640,"_3078":58723},[],"DER request encoded using padded URL Base64.",{"_3626":2482,"_31224":2449,"_21623":58725,"_5":14874,"_28405":58640,"_3078":58726},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3626":2483,"_31224":2449,"_21623":58728,"_5":14874,"_28405":58644,"_3078":58729},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3626":2484,"_31224":2449,"_21623":58731,"_5":14874,"_28405":58644,"_3078":58732},[],"Generate the request:",{"_3626":2485,"_31224":2449,"_21623":58734,"_5":14874,"_28405":58644,"_3078":58735},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3626":2486,"_31224":2449,"_21623":58737,"_5":14874,"_28405":58644,"_3078":58738},[],"Replace the example URL with the inspected endpoint:",{"_3626":2487,"_31224":2449,"_21623":58740,"_5":14874,"_28405":58644,"_3078":58741},[],"Verify the returned DER:",{"_3626":2488,"_31224":2449,"_21623":58743,"_5":14874,"_28405":58644,"_3078":58744},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3626":2489,"_31224":2449,"_21623":58746,"_5":14874,"_28405":58648,"_3078":58747},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3626":2490,"_31224":2449,"_21623":58749,"_5":14874,"_28405":58648,"_3078":58750},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3626":2491,"_31224":2449,"_21623":58752,"_5":14874,"_28405":58652,"_3078":58753},[],"RFC 6960: OCSP.",{"_3626":2492,"_31224":2449,"_21623":58755,"_5":14874,"_28405":58652,"_3078":58756},[],"OpenSSL: openssl-ocsp.",{"_3626":2493,"_31224":2449,"_21623":58758,"_5":14874,"_28405":58652,"_3078":58759},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3626":2494,"_31224":2449,"_21623":58761,"_5":14874,"_28405":58652,"_3078":58230},[],{"_3626":2495,"_31224":2495,"_5":15239,"_3078":56704,"_31582":58763,"_21623":58764,"_28405":2495},[51011,52523,56704],[],{"_3626":2496,"_31224":2495,"_21623":58766,"_5":14874,"_28405":2495,"_3078":58767},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3626":2497,"_31224":2495,"_5":31579,"_21623":58769,"_28405":58770,"_3078":56016},[],"/docs/pr-preview/pr-76/platform/pki/overview#start-here",{"_3626":2498,"_31224":2495,"_5":31579,"_21623":58772,"_28405":58773,"_3078":58774},[],"/docs/pr-preview/pr-76/platform/pki/overview#what-you-need","What you need",{"_3626":2499,"_31224":2495,"_5":31579,"_21623":58776,"_28405":58777,"_3078":56548},[],"/docs/pr-preview/pr-76/platform/pki/overview#core-capabilities",{"_3626":2500,"_31224":2495,"_5":31579,"_21623":58779,"_28405":58780,"_3078":56552},[],"/docs/pr-preview/pr-76/platform/pki/overview#build-your-trust-hierarchy",{"_3626":2501,"_31224":2495,"_5":31579,"_21623":58782,"_28405":58783,"_3078":56556},[],"/docs/pr-preview/pr-76/platform/pki/overview#protect-cryptographic-keys",{"_3626":2502,"_31224":2495,"_5":31579,"_21623":58785,"_28405":58786,"_3078":56560},[],"/docs/pr-preview/pr-76/platform/pki/overview#issue-and-control-certificates",{"_3626":2503,"_31224":2495,"_5":31579,"_21623":58788,"_28405":58789,"_3078":56568},[],"/docs/pr-preview/pr-76/platform/pki/overview#publish-validation-status",{"_3626":2504,"_31224":2495,"_5":31579,"_21623":58791,"_28405":58792,"_3078":58793},[],"/docs/pr-preview/pr-76/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3626":2505,"_31224":2495,"_5":31579,"_21623":58795,"_28405":58796,"_3078":57522},[],"/docs/pr-preview/pr-76/platform/pki/overview#continue",{"_3626":2506,"_31224":2495,"_21623":58798,"_5":14874,"_28405":2495,"_3078":58799},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3626":2507,"_31224":2495,"_21623":58801,"_5":14874,"_28405":58770,"_3078":58802},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3626":2508,"_31224":2495,"_21623":58804,"_5":14874,"_28405":58770,"_3078":58805},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3626":2509,"_31224":2495,"_21623":58807,"_5":14874,"_28405":58773,"_3078":58808},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3626":2510,"_31224":2495,"_21623":58810,"_5":14874,"_28405":58773,"_3078":58811},[],"An available cryptographic engine to keep the authority's key.",{"_3626":2511,"_31224":2495,"_21623":58813,"_5":14874,"_28405":58773,"_3078":58814},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3626":2512,"_31224":2495,"_21623":58816,"_5":14874,"_28405":58773,"_3078":58817},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3626":2513,"_31224":2495,"_21623":58819,"_5":14874,"_28405":58773,"_3078":58820},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3626":2514,"_31224":2495,"_21623":58822,"_5":14874,"_28405":58780,"_3078":58823},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3626":2515,"_31224":2495,"_21623":58825,"_5":14874,"_28405":58783,"_3078":58826},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3626":2516,"_31224":2495,"_21623":58828,"_5":14874,"_28405":58786,"_3078":58829},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3626":2517,"_31224":2495,"_21623":58831,"_5":14874,"_28405":58789,"_3078":58832},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3626":2518,"_31224":2495,"_21623":58834,"_5":14874,"_28405":58792,"_3078":58835},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3626":2519,"_31224":2495,"_21623":58837,"_5":14874,"_28405":58792,"_3078":58838},[],"its subject and extensions identify the expected client;",{"_3626":2520,"_31224":2495,"_21623":58840,"_5":14874,"_28405":58792,"_3078":58841},[],"its public key matches the client's private key;",{"_3626":2521,"_31224":2495,"_21623":58843,"_5":14874,"_28405":58792,"_3078":58844},[],"its chain reaches a root trusted by the consumer;",{"_3626":2522,"_31224":2495,"_21623":58846,"_5":14874,"_28405":58792,"_3078":58847},[],"its dates and usages allow the operation;",{"_3626":2523,"_31224":2495,"_21623":58849,"_5":14874,"_28405":58792,"_3078":58850},[],"the consumer applies revocation checks and authorization.",{"_3626":2524,"_31224":2495,"_21623":58852,"_5":14874,"_28405":58792,"_3078":58853},[],"The issuance path includes the first independent checks.",{"_3626":2525,"_31224":2495,"_21623":58855,"_5":14874,"_28405":58796,"_3078":58856},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3626":2526,"_31224":2495,"_21623":58858,"_5":14874,"_28405":58796,"_3078":58859},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3626":2527,"_31224":2495,"_21623":58861,"_5":14874,"_28405":58796,"_3078":58862},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3626":2528,"_31224":2528,"_5":15239,"_3078":58864,"_31582":58865,"_21623":58866,"_28405":2528},"Create your first CA",[51011,52523,56704,56141],[],{"_3626":2529,"_31224":2528,"_21623":58868,"_5":14874,"_28405":2528,"_3078":58869},[],"Create an evaluation root and check its certificate before issuing.",{"_3626":2530,"_31224":2528,"_5":31579,"_21623":58871,"_28405":58872,"_3078":51021},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3626":2531,"_31224":2528,"_5":31579,"_21623":58874,"_28405":58875,"_3078":58876},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3626":2532,"_31224":2528,"_5":31579,"_21623":58878,"_28405":58879,"_3078":58880},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3626":2533,"_31224":2528,"_5":31579,"_21623":58882,"_28405":58883,"_3078":58884},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3626":2534,"_31224":2528,"_5":31579,"_21623":58886,"_28405":58887,"_3078":58888},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3626":2535,"_31224":2528,"_5":31579,"_21623":58890,"_28405":58891,"_3078":58892},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3626":2536,"_31224":2528,"_5":31579,"_21623":58894,"_28405":58895,"_3078":58896},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3626":2537,"_31224":2528,"_5":31579,"_21623":58898,"_28405":58899,"_3078":56398},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3626":2538,"_31224":2528,"_5":31579,"_21623":58901,"_28405":58902,"_3078":51045},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3626":2539,"_31224":2528,"_21623":58904,"_5":14874,"_28405":2528,"_3078":58905},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3626":2540,"_31224":2528,"_21623":58907,"_5":14874,"_28405":58872,"_3078":58908},[],"Console access and permission to create keys and authorities.",{"_3626":2541,"_31224":2528,"_21623":58910,"_5":14874,"_28405":58872,"_3078":58911},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3626":2542,"_31224":2528,"_21623":58913,"_5":14874,"_28405":58872,"_3078":58914},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3626":2543,"_31224":2528,"_21623":58916,"_5":14874,"_28405":58872,"_3078":58917},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3626":2544,"_31224":2528,"_21623":58919,"_5":14874,"_28405":58875,"_3078":58920},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3626":2545,"_31224":2528,"_21623":58922,"_5":14874,"_28405":58875,"_3078":58923},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3626":2546,"_31224":2528,"_21623":58925,"_5":14874,"_28405":58879,"_3078":58926},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3626":2547,"_31224":2528,"_21623":58928,"_5":14874,"_28405":58879,"_3078":58929},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3626":2548,"_31224":2528,"_21623":58931,"_5":14874,"_28405":58883,"_3078":58932},[],"Select **Root CA** and complete:",{"_3626":2549,"_31224":2528,"_21623":58934,"_5":14874,"_28405":58883,"_3078":58935},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3626":2550,"_31224":2528,"_21623":58937,"_5":14874,"_28405":58883,"_3078":58938},[],"**Subject**: organization and country details for your evaluation.",{"_3626":2551,"_31224":2528,"_21623":58940,"_5":14874,"_28405":58883,"_3078":58941},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3626":2552,"_31224":2528,"_21623":58943,"_5":14874,"_28405":58883,"_3078":58944},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3626":2553,"_31224":2528,"_21623":58946,"_5":14874,"_28405":58883,"_3078":58947},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3626":2554,"_31224":2528,"_21623":58949,"_5":14874,"_28405":58887,"_3078":58950},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3626":2555,"_31224":2528,"_21623":58952,"_5":14874,"_28405":58891,"_3078":58953},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3626":2556,"_31224":2528,"_21623":58955,"_5":14874,"_28405":58891,"_3078":58956},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3626":2557,"_31224":2528,"_21623":58958,"_5":14874,"_28405":58895,"_3078":58959},[],"Run from the directory where you saved `ca.pem`:",{"_3626":2558,"_31224":2528,"_21623":58961,"_5":14874,"_28405":58895,"_3078":58962},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3626":2559,"_31224":2528,"_21623":58964,"_5":14874,"_28405":58895,"_3078":58965},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3626":2560,"_31224":2528,"_21623":58967,"_5":14874,"_28405":58899,"_3078":58968},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3626":2561,"_31224":2528,"_21623":58970,"_5":14874,"_28405":58899,"_3078":58971},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3626":2562,"_31224":2528,"_21623":58973,"_5":14874,"_28405":58899,"_3078":58974},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3626":2563,"_31224":2528,"_21623":58976,"_5":14874,"_28405":58899,"_3078":58977},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3626":2564,"_31224":2528,"_21623":58979,"_5":14874,"_28405":58902,"_3078":58980},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3626":2565,"_31224":2565,"_5":15239,"_3078":58982,"_31582":58983,"_21623":58984,"_28405":2565},"Issue and verify a certificate",[51011,52523,56704,56141],[],{"_3626":2566,"_31224":2565,"_21623":58986,"_5":14874,"_28405":2565,"_3078":58987},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3626":2567,"_31224":2565,"_5":31579,"_21623":58989,"_28405":58990,"_3078":51021},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3626":2568,"_31224":2565,"_5":31579,"_21623":58992,"_28405":58993,"_3078":58994},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3626":2569,"_31224":2565,"_5":31579,"_21623":58996,"_28405":58997,"_3078":58998},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3626":2570,"_31224":2565,"_5":31579,"_21623":59000,"_28405":59001,"_3078":59002},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3626":2571,"_31224":2565,"_5":31579,"_21623":59004,"_28405":59005,"_3078":59006},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3626":2572,"_31224":2565,"_5":31579,"_21623":59008,"_28405":59009,"_3078":59010},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3626":2573,"_31224":2565,"_5":31579,"_21623":59012,"_28405":59013,"_3078":59014},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3626":2574,"_31224":2565,"_5":31579,"_21623":59016,"_28405":59017,"_3078":59018},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3626":2575,"_31224":2565,"_5":31579,"_21623":59020,"_28405":59021,"_3078":59022},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3626":2576,"_31224":2565,"_5":31579,"_21623":59024,"_28405":59025,"_3078":59026},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3626":2577,"_31224":2565,"_5":31579,"_21623":59028,"_28405":59029,"_3078":56398},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3626":2578,"_31224":2565,"_5":31579,"_21623":59031,"_28405":59032,"_3078":51045},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/issue-certificate#next-step",{"_3626":2579,"_31224":2565,"_21623":59034,"_5":14874,"_28405":2565,"_3078":59035},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3626":2580,"_31224":2565,"_21623":59037,"_5":14874,"_28405":58990,"_3078":59038},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3626":2581,"_31224":2565,"_21623":59040,"_5":14874,"_28405":58990,"_3078":59041},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3626":2582,"_31224":2565,"_21623":59043,"_5":14874,"_28405":58990,"_3078":59044},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3626":2583,"_31224":2565,"_21623":59046,"_5":14874,"_28405":58990,"_3078":59047},[],"A client identifier: here we use `device-001`.",{"_3626":2584,"_31224":2565,"_21623":59049,"_5":14874,"_28405":58990,"_3078":59050},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3626":2585,"_31224":2565,"_21623":59052,"_5":14874,"_28405":58993,"_3078":59053},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3626":2586,"_31224":2565,"_21623":59055,"_5":14874,"_28405":58997,"_3078":59056},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3626":2587,"_31224":2565,"_21623":59058,"_5":14874,"_28405":58997,"_3078":59059},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3626":2588,"_31224":2565,"_21623":59061,"_5":14874,"_28405":59001,"_3078":59062},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3626":2589,"_31224":2565,"_21623":59064,"_5":14874,"_28405":59001,"_3078":59065},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3626":2590,"_31224":2565,"_21623":59067,"_5":14874,"_28405":59005,"_3078":59068},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3626":2591,"_31224":2565,"_21623":59070,"_5":14874,"_28405":59005,"_3078":59071},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3626":2592,"_31224":2565,"_21623":59073,"_5":14874,"_28405":59009,"_3078":59074},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3626":2593,"_31224":2565,"_21623":59076,"_5":14874,"_28405":59013,"_3078":59077},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3626":2594,"_31224":2565,"_21623":59079,"_5":14874,"_28405":59017,"_3078":59080},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3626":2595,"_31224":2565,"_21623":59082,"_5":14874,"_28405":59021,"_3078":59083},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3626":2596,"_31224":2565,"_21623":59085,"_5":14874,"_28405":59021,"_3078":59086},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3626":2597,"_31224":2565,"_21623":59088,"_5":14874,"_28405":59021,"_3078":59089},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3626":2598,"_31224":2565,"_21623":59091,"_5":14874,"_28405":59025,"_3078":59092},[],"In Bash, compare the two public-key digests:",{"_3626":2599,"_31224":2565,"_21623":59094,"_5":14874,"_28405":59025,"_3078":59095},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3626":2600,"_31224":2565,"_21623":59097,"_5":14874,"_28405":59025,"_3078":59098},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3626":2601,"_31224":2565,"_21623":59100,"_5":14874,"_28405":59029,"_3078":56482},[],{"_3626":2602,"_31224":2565,"_21623":59102,"_5":14874,"_28405":59029,"_3078":59103},[],"What to review",{"_3626":2603,"_31224":2565,"_21623":59105,"_5":14874,"_28405":59029,"_3078":59106},[],"The CA rejects issuance",{"_3626":2604,"_31224":2565,"_21623":59108,"_5":14874,"_28405":59029,"_3078":59109},[],"Permissions, CA state and key, algorithm and profile.",{"_3626":2605,"_31224":2565,"_21623":59111,"_5":14874,"_28405":59029,"_3078":59112},[],"Different subject or usages",{"_3626":2606,"_31224":2565,"_21623":59114,"_5":14874,"_28405":59029,"_3078":59115},[],"Applied profile and requested values.",{"_3626":2607,"_31224":2565,"_21623":59117,"_5":14874,"_28405":59029,"_3078":59118},[],"Issuer cannot be found",{"_3626":2608,"_31224":2565,"_21623":59120,"_5":14874,"_28405":59029,"_3078":59121},[],"Downloaded CA and required intermediate chain.",{"_3626":2609,"_31224":2565,"_21623":59123,"_5":14874,"_28405":59029,"_3078":59124},[],"Validity fails",{"_3626":2610,"_31224":2565,"_21623":59126,"_5":14874,"_28405":59029,"_3078":59127},[],"Certificate and CA dates, and the computer's clock.",{"_3626":2611,"_31224":2565,"_21623":59129,"_5":14874,"_28405":59029,"_3078":59130},[],"Public-key digests differ",{"_3626":2612,"_31224":2565,"_21623":59132,"_5":14874,"_28405":59029,"_3078":59133},[],"Certificate and key files from the same issuance.",{"_3626":2613,"_31224":2565,"_21623":59135,"_5":14874,"_28405":59029,"_3078":59136},[],"See PKI diagnostics to narrow an issuance failure.",{"_3626":2614,"_31224":2565,"_21623":59138,"_5":14874,"_28405":59032,"_3078":59139},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3626":2615,"_31224":2565,"_21623":59141,"_5":14874,"_28405":59032,"_3078":59142},[],"Manage certificates for inspection, status and revocation.",{"_3626":2616,"_31224":2565,"_21623":59144,"_5":14874,"_28405":59032,"_3078":59145},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3626":2617,"_31224":2565,"_21623":59147,"_5":14874,"_28405":59032,"_3078":59148},[],"Prepare EST for the device to request its next identities.",{"_3626":2618,"_31224":2565,"_21623":59150,"_5":14874,"_28405":59032,"_3078":59151},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3626":2619,"_31224":2619,"_5":15239,"_3078":59153,"_31582":59154,"_21623":59155,"_28405":2619},"PKI getting started",[51011,52523,56704,56141],[],{"_3626":2620,"_31224":2619,"_21623":59157,"_5":14874,"_28405":2619,"_3078":59158},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3626":2621,"_31224":2619,"_5":31579,"_21623":59160,"_28405":59161,"_3078":51021},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/overview#before-you-begin",{"_3626":2622,"_31224":2619,"_5":31579,"_21623":59163,"_28405":59164,"_3078":59165},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3626":2623,"_31224":2619,"_5":31579,"_21623":59167,"_28405":59168,"_3078":56333},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/overview#expected-result",{"_3626":2624,"_31224":2619,"_5":31579,"_21623":59170,"_28405":59171,"_3078":59172},[],"/docs/pr-preview/pr-76/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3626":2625,"_31224":2619,"_21623":59174,"_5":14874,"_28405":2619,"_3078":59175},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3626":2626,"_31224":2619,"_21623":59177,"_5":14874,"_28405":59161,"_3078":59178},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3626":2627,"_31224":2619,"_21623":59180,"_5":14874,"_28405":59161,"_3078":59181},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3626":2628,"_31224":2619,"_21623":59183,"_5":14874,"_28405":59161,"_3078":59184},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3626":2629,"_31224":2619,"_21623":59186,"_5":14874,"_28405":59161,"_3078":59187},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3626":2630,"_31224":2619,"_21623":59189,"_5":14874,"_28405":59161,"_3078":59190},[],"A working directory with restricted access for the downloaded key.",{"_3626":2631,"_31224":2619,"_21623":59192,"_5":14874,"_28405":59164,"_3078":59193},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3626":2632,"_31224":2619,"_21623":59195,"_5":14874,"_28405":59164,"_3078":59196},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3626":2633,"_31224":2619,"_21623":59198,"_5":14874,"_28405":59164,"_3078":59199},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3626":2634,"_31224":2619,"_21623":59201,"_5":14874,"_28405":59164,"_3078":59202},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3626":2635,"_31224":2619,"_21623":59204,"_5":14874,"_28405":59168,"_3078":59205},[],"File or resource",{"_3626":2636,"_31224":2619,"_21623":59207,"_5":14874,"_28405":59168,"_3078":56330},[],{"_3626":2637,"_31224":2619,"_21623":59209,"_5":14874,"_28405":59168,"_3078":59210},[],"Active root CA and `ca.pem`",{"_3626":2638,"_31224":2619,"_21623":59212,"_5":14874,"_28405":59168,"_3078":59213},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3626":2639,"_31224":2619,"_21623":59215,"_5":14874,"_28405":59168,"_3078":59216},[],"End-entity certificate and `device.crt`",{"_3626":2640,"_31224":2619,"_21623":59218,"_5":14874,"_28405":59168,"_3078":59219},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3626":2641,"_31224":2619,"_21623":59221,"_5":14874,"_28405":59168,"_3078":59222},[],"Private key `device.key`",{"_3626":2642,"_31224":2619,"_21623":59224,"_5":14874,"_28405":59168,"_3078":59225},[],"Its public key matches the one included in `device.crt`.",{"_3626":2643,"_31224":2619,"_21623":59227,"_5":14874,"_28405":59168,"_3078":59228},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3626":2644,"_31224":2619,"_21623":59230,"_5":14874,"_28405":59171,"_3078":59231},[],"To operate certificates, continue with Certificates and Validation.",{"_3626":2645,"_31224":2619,"_21623":59233,"_5":14874,"_28405":59171,"_3078":59234},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3626":2646,"_31224":2619,"_21623":59236,"_5":14874,"_28405":59171,"_3078":59237},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3626":2647,"_31224":2647,"_5":15239,"_3078":59239,"_31582":59240,"_21623":59241,"_28405":2647},"PKI troubleshooting",[51011,52523,56704,55279],[],{"_3626":2648,"_31224":2647,"_21623":59243,"_5":14874,"_28405":2647,"_3078":59244},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3626":2649,"_31224":2647,"_5":31579,"_21623":59246,"_28405":59247,"_3078":59248},[],"/docs/pr-preview/pr-76/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3626":2650,"_31224":2647,"_5":31579,"_21623":59250,"_28405":59251,"_3078":59252},[],"/docs/pr-preview/pr-76/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3626":2651,"_31224":2647,"_5":31579,"_21623":59254,"_28405":59255,"_3078":59256},[],"/docs/pr-preview/pr-76/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3626":2652,"_31224":2647,"_21623":59258,"_5":14874,"_28405":2647,"_3078":59259},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3626":2653,"_31224":2647,"_21623":59261,"_5":14874,"_28405":2647,"_3078":59262},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3626":2654,"_31224":2647,"_21623":59264,"_5":14874,"_28405":59247,"_3078":56330},[],{"_3626":2655,"_31224":2647,"_21623":59266,"_5":14874,"_28405":59247,"_3078":59267},[],"What to inspect",{"_3626":2656,"_31224":2647,"_21623":59269,"_5":14874,"_28405":59247,"_3078":51045},[],{"_3626":2657,"_31224":2647,"_21623":59271,"_5":14874,"_28405":59247,"_3078":55546},[],{"_3626":2658,"_31224":2647,"_21623":59273,"_5":14874,"_28405":59247,"_3078":59274},[],"Exists, is active and has usable dates.",{"_3626":2659,"_31224":2647,"_21623":59276,"_5":14874,"_28405":59247,"_3078":59277},[],"Authorities.",{"_3626":2660,"_31224":2647,"_21623":59279,"_5":14874,"_28405":59247,"_3078":59280},[],"Key",{"_3626":2661,"_31224":2647,"_21623":59282,"_5":14874,"_28405":59247,"_3078":59283},[],"The record has a usable private key and the engine can sign.",{"_3626":2662,"_31224":2647,"_21623":59285,"_5":14874,"_28405":59247,"_3078":59286},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3626":2663,"_31224":2647,"_21623":59288,"_5":14874,"_28405":59247,"_3078":59289},[],"CSR",{"_3626":2664,"_31224":2647,"_21623":59291,"_5":14874,"_28405":59247,"_3078":59292},[],"Correct PEM and verifiable signature.",{"_3626":2665,"_31224":2647,"_21623":59294,"_5":14874,"_28405":59247,"_3078":59295},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3626":2666,"_31224":2647,"_21623":59297,"_5":14874,"_28405":59247,"_3078":59298},[],"Profile",{"_3626":2667,"_31224":2647,"_21623":59300,"_5":14874,"_28405":59247,"_3078":59301},[],"Selected source, existing ID, allowed algorithm and size.",{"_3626":2668,"_31224":2647,"_21623":59303,"_5":14874,"_28405":59247,"_3078":59304},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3626":2669,"_31224":2647,"_21623":59306,"_5":14874,"_28405":59247,"_3078":56482},[],{"_3626":2670,"_31224":2647,"_21623":59308,"_5":14874,"_28405":59247,"_3078":59309},[],"Appropriate subject, SAN, usages and dates.",{"_3626":2671,"_31224":2647,"_21623":59311,"_5":14874,"_28405":59247,"_3078":59312},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3626":2672,"_31224":2647,"_21623":59314,"_5":14874,"_28405":59247,"_3078":59315},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3626":2673,"_31224":2647,"_21623":59317,"_5":14874,"_28405":59247,"_3078":59318},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3626":2674,"_31224":2647,"_21623":59320,"_5":14874,"_28405":59247,"_3078":59321},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3626":2675,"_31224":2647,"_21623":59323,"_5":14874,"_28405":59251,"_3078":59324},[],"Check each boundary independently:",{"_3626":2676,"_31224":2647,"_21623":59326,"_5":14874,"_28405":59251,"_3078":59327},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3626":2677,"_31224":2647,"_21623":59329,"_5":14874,"_28405":59251,"_3078":59330},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3626":2678,"_31224":2647,"_21623":59332,"_5":14874,"_28405":59251,"_3078":59333},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3626":2679,"_31224":2647,"_21623":59335,"_5":14874,"_28405":59251,"_3078":59336},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3626":2680,"_31224":2647,"_21623":59338,"_5":14874,"_28405":59251,"_3078":59339},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3626":2681,"_31224":2647,"_21623":59341,"_5":14874,"_28405":59251,"_3078":59342},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3626":2682,"_31224":2647,"_21623":59344,"_5":14874,"_28405":59255,"_3078":59345},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3626":2683,"_31224":2647,"_21623":59347,"_5":14874,"_28405":59255,"_3078":59348},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3626":2684,"_31224":2684,"_5":15239,"_3078":59350,"_31582":59351,"_21623":59352,"_28405":2684},"Security",[51011],[],{"_3626":2685,"_31224":2684,"_21623":59354,"_5":14874,"_28405":2684,"_3078":59355},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3626":2686,"_31224":2684,"_5":31579,"_21623":59357,"_28405":59358,"_3078":59359},[],"/docs/pr-preview/pr-76/security#report-a-vulnerability","Report a vulnerability",{"_3626":2687,"_31224":2684,"_5":31579,"_21623":59361,"_28405":59362,"_3078":59363},[],"/docs/pr-preview/pr-76/security#what-to-include-in-a-report","What to include in a report",{"_3626":2688,"_31224":2684,"_5":31579,"_21623":59365,"_28405":59366,"_3078":59367},[],"/docs/pr-preview/pr-76/security#supported-versions","Supported versions",{"_3626":2689,"_31224":2684,"_5":31579,"_21623":59369,"_28405":59370,"_3078":59371},[],"/docs/pr-preview/pr-76/security#responsible-disclosure","Responsible disclosure",{"_3626":2690,"_31224":2684,"_21623":59373,"_5":14874,"_28405":2684,"_3078":59374},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3626":2691,"_31224":2684,"_21623":59376,"_5":14874,"_28405":59358,"_3078":59377},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3626":2692,"_31224":2684,"_21623":59379,"_5":14874,"_28405":59358,"_3078":59380},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3626":2693,"_31224":2684,"_21623":59382,"_5":14874,"_28405":59358,"_3078":15518},[],{"_3626":2694,"_31224":2684,"_21623":59384,"_5":14874,"_28405":59358,"_3078":15447},[],{"_3626":2695,"_31224":2684,"_21623":59386,"_5":14874,"_28405":59358,"_3078":15505},[],{"_3626":2696,"_31224":2684,"_21623":59388,"_5":14874,"_28405":59358,"_3078":59389},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3626":2697,"_31224":2684,"_21623":59391,"_5":14874,"_28405":59358,"_3078":59392},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3626":2698,"_31224":2684,"_21623":59394,"_5":14874,"_28405":59362,"_3078":59395},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3626":2699,"_31224":2684,"_21623":59397,"_5":14874,"_28405":59362,"_3078":59398},[],"Do not include in the report:",{"_3626":2700,"_31224":2684,"_21623":59400,"_5":14874,"_28405":59362,"_3078":59401},[],"Credentials, tokens, or private keys",{"_3626":2701,"_31224":2684,"_21623":59403,"_5":14874,"_28405":59362,"_3078":59404},[],"Customer data or customer-identifiable information",{"_3626":2702,"_31224":2684,"_21623":59406,"_5":14874,"_28405":59362,"_3078":59407},[],"Confidential architecture or internal infrastructure details",{"_3626":2703,"_31224":2684,"_21623":59409,"_5":14874,"_28405":59366,"_3078":59410},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3626":2704,"_31224":2684,"_21623":59412,"_5":14874,"_28405":59366,"_3078":59413},[],"For upgrade guidance, see Upgrades.",{"_3626":2705,"_31224":2684,"_21623":59415,"_5":14874,"_28405":59370,"_3078":59416},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3626":2706,"_31224":2684,"_21623":59418,"_5":14874,"_28405":59370,"_3078":59419},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3626":2707,"_31224":2684,"_21623":59421,"_5":14874,"_28405":59370,"_3078":59422},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3626":2708,"_31224":2684,"_21623":59424,"_5":14874,"_28405":59370,"_3078":59425},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3626":2709,"_31224":2684,"_21623":59427,"_5":14874,"_28405":59370,"_3078":59428},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3626":2710,"_31224":2710,"_5":15239,"_3078":59430,"_31582":59431,"_21623":59433,"_28405":2710},"3.8.0 to 4.0.0",[51011,59432],"Upgrades",[],{"_3626":2711,"_31224":2710,"_21623":59435,"_5":14874,"_28405":2710,"_3078":59436},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3626":2712,"_31224":2710,"_5":31579,"_21623":59438,"_28405":59439,"_3078":59440},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3626":2713,"_31224":2710,"_5":31579,"_21623":59442,"_28405":59443,"_3078":59444},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3626":2714,"_31224":2710,"_5":31579,"_21623":59446,"_28405":59447,"_3078":59448},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3626":2715,"_31224":2710,"_5":31579,"_21623":59450,"_28405":59451,"_3078":59452},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3626":2716,"_31224":2710,"_5":31579,"_21623":59454,"_28405":59455,"_3078":59456},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3626":2717,"_31224":2710,"_5":31579,"_21623":59458,"_28405":59459,"_3078":59460},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3626":2718,"_31224":2710,"_5":31579,"_21623":59462,"_28405":59463,"_3078":59464},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3626":2719,"_31224":2710,"_5":31579,"_21623":59466,"_28405":59467,"_3078":59468},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3626":2720,"_31224":2710,"_5":31579,"_21623":59470,"_28405":59471,"_3078":59472},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3626":2721,"_31224":2710,"_5":31579,"_21623":59474,"_28405":59475,"_3078":59476},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3626":2722,"_31224":2710,"_5":31579,"_21623":59478,"_28405":59479,"_3078":51649},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3626":2723,"_31224":2710,"_5":31579,"_21623":59481,"_28405":59482,"_3078":59483},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3626":2724,"_31224":2710,"_5":31579,"_21623":59485,"_28405":59486,"_3078":59487},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3626":2725,"_31224":2710,"_5":31579,"_21623":59489,"_28405":59490,"_3078":59491},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3626":2726,"_31224":2710,"_5":31579,"_21623":59493,"_28405":59494,"_3078":59495},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3626":2727,"_31224":2710,"_5":31579,"_21623":59497,"_28405":59498,"_3078":59499},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3626":2728,"_31224":2710,"_5":31579,"_21623":59501,"_28405":59502,"_3078":59503},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3626":2729,"_31224":2710,"_5":31579,"_21623":59505,"_28405":59506,"_3078":59507},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3626":2730,"_31224":2710,"_5":31579,"_21623":59509,"_28405":59510,"_3078":59511},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3626":2731,"_31224":2710,"_5":31579,"_21623":59513,"_28405":59514,"_3078":59515},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3626":2732,"_31224":2710,"_5":31579,"_21623":59517,"_28405":59518,"_3078":59519},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3626":2733,"_31224":2710,"_5":31579,"_21623":59521,"_28405":59522,"_3078":59523},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3626":2734,"_31224":2710,"_5":31579,"_21623":59525,"_28405":59526,"_3078":59527},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3626":2735,"_31224":2710,"_5":31579,"_21623":59529,"_28405":59530,"_3078":59531},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3626":2736,"_31224":2710,"_5":31579,"_21623":59533,"_28405":59534,"_3078":59535},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3626":2737,"_31224":2710,"_5":31579,"_21623":59537,"_28405":59538,"_3078":59539},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3626":2738,"_31224":2710,"_5":31579,"_21623":59541,"_28405":59542,"_3078":59543},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3626":2739,"_31224":2710,"_5":31579,"_21623":59545,"_28405":59546,"_3078":59547},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3626":2740,"_31224":2710,"_5":31579,"_21623":59549,"_28405":59550,"_3078":59551},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3626":2741,"_31224":2710,"_5":31579,"_21623":59553,"_28405":59554,"_3078":59555},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3626":2742,"_31224":2710,"_5":31579,"_21623":59557,"_28405":59558,"_3078":59559},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3626":2743,"_31224":2710,"_5":31579,"_21623":59561,"_28405":59562,"_3078":59563},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3626":2744,"_31224":2710,"_5":31579,"_21623":59565,"_28405":59566,"_3078":59567},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3626":2745,"_31224":2710,"_5":31579,"_21623":59569,"_28405":59570,"_3078":59571},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3626":2746,"_31224":2710,"_5":31579,"_21623":59573,"_28405":59574,"_3078":59567},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3626":2747,"_31224":2710,"_5":31579,"_21623":59576,"_28405":59577,"_3078":59578},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3626":2748,"_31224":2710,"_5":31579,"_21623":59580,"_28405":59581,"_3078":59582},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3626":2749,"_31224":2710,"_5":31579,"_21623":59584,"_28405":59585,"_3078":59586},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3626":2750,"_31224":2710,"_5":31579,"_21623":59588,"_28405":59589,"_3078":59590},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3626":2751,"_31224":2710,"_5":31579,"_21623":59592,"_28405":59593,"_3078":59594},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3626":2752,"_31224":2710,"_5":31579,"_21623":59596,"_28405":59597,"_3078":59598},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3626":2753,"_31224":2710,"_5":31579,"_21623":59600,"_28405":59601,"_3078":59602},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3626":2754,"_31224":2710,"_5":31579,"_21623":59604,"_28405":59605,"_3078":59606},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3626":2755,"_31224":2710,"_5":31579,"_21623":59608,"_28405":59609,"_3078":59610},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3626":2756,"_31224":2710,"_5":31579,"_21623":59612,"_28405":59613,"_3078":55279},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3626":2757,"_31224":2710,"_5":31579,"_21623":59615,"_28405":59616,"_3078":59617},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3626":2758,"_31224":2710,"_5":31579,"_21623":59619,"_28405":59620,"_3078":59621},[],"/docs/pr-preview/pr-76/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3626":2759,"_31224":2710,"_21623":59623,"_5":14874,"_28405":2710,"_3078":59624},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3626":2760,"_31224":2710,"_21623":59626,"_5":14874,"_28405":2710,"_3078":59627},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3626":2761,"_31224":2710,"_21623":59629,"_5":14874,"_28405":2710,"_3078":59630},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3626":2762,"_31224":2710,"_21623":59632,"_5":14874,"_28405":2710,"_3078":59633},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3626":2763,"_31224":2710,"_21623":59635,"_5":14874,"_28405":2710,"_3078":59636},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3626":2764,"_31224":2710,"_21623":59638,"_5":14874,"_28405":2710,"_3078":59639},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3626":2765,"_31224":2710,"_21623":59641,"_5":14874,"_28405":2710,"_3078":59642},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3626":2766,"_31224":2710,"_21623":59644,"_5":14874,"_28405":59443,"_3078":59645},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3626":2767,"_31224":2710,"_21623":59647,"_5":14874,"_28405":59443,"_3078":59648},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3626":2768,"_31224":2710,"_21623":59650,"_5":14874,"_28405":59447,"_3078":59651},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3626":2769,"_31224":2710,"_21623":59653,"_5":14874,"_28405":59447,"_3078":59654},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3626":2770,"_31224":2710,"_21623":59656,"_5":14874,"_28405":59451,"_3078":59657},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3626":2771,"_31224":2710,"_21623":59659,"_5":14874,"_28405":59455,"_3078":59660},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3626":2772,"_31224":2710,"_21623":59662,"_5":14874,"_28405":59455,"_3078":59663},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3626":2773,"_31224":2710,"_21623":59665,"_5":14874,"_28405":59455,"_3078":59666},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3626":2774,"_31224":2710,"_21623":59668,"_5":14874,"_28405":59455,"_3078":59669},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3626":2775,"_31224":2710,"_21623":59671,"_5":14874,"_28405":59455,"_3078":59672},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3626":2776,"_31224":2710,"_21623":59674,"_5":14874,"_28405":59459,"_3078":59675},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3626":2777,"_31224":2710,"_21623":59677,"_5":14874,"_28405":59459,"_3078":59678},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3626":2778,"_31224":2710,"_21623":59680,"_5":14874,"_28405":59459,"_3078":59681},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3626":2779,"_31224":2710,"_21623":59683,"_5":14874,"_28405":59459,"_3078":59684},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3626":2780,"_31224":2710,"_21623":59686,"_5":14874,"_28405":59459,"_3078":59687},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3626":2781,"_31224":2710,"_21623":59689,"_5":14874,"_28405":59459,"_3078":59690},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3626":2782,"_31224":2710,"_21623":59692,"_5":14874,"_28405":59463,"_3078":59693},[],"Change",{"_3626":2783,"_31224":2710,"_21623":59695,"_5":14874,"_28405":59463,"_3078":59696},[],"Who is affected",{"_3626":2784,"_31224":2710,"_21623":59698,"_5":14874,"_28405":59463,"_3078":59699},[],"Severity",{"_3626":2785,"_31224":2710,"_21623":59701,"_5":14874,"_28405":59463,"_3078":58152},[],{"_3626":2786,"_31224":2710,"_21623":59703,"_5":14874,"_28405":59463,"_3078":59472},[],{"_3626":2787,"_31224":2710,"_21623":59705,"_5":14874,"_28405":59463,"_3078":59706},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3626":2788,"_31224":2710,"_21623":59708,"_5":14874,"_28405":59463,"_3078":59709},[],"High: KMS and VA start on empty volumes",{"_3626":2789,"_31224":2710,"_21623":59711,"_5":14874,"_28405":59463,"_3078":59712},[],"Copy the data into the new volumes",{"_3626":2790,"_31224":2710,"_21623":59714,"_5":14874,"_28405":59463,"_3078":59476},[],{"_3626":2791,"_31224":2710,"_21623":59716,"_5":14874,"_28405":59463,"_3078":59717},[],"Every Helm release",{"_3626":2792,"_31224":2710,"_21623":59719,"_5":14874,"_28405":59463,"_3078":59720},[],"High: `helm upgrade` fails",{"_3626":2793,"_31224":2710,"_21623":59722,"_5":14874,"_28405":59463,"_3078":59723},[],"Remove or rename legacy keys",{"_3626":2794,"_31224":2710,"_21623":59725,"_5":14874,"_28405":59463,"_3078":51649},[],{"_3626":2795,"_31224":2710,"_21623":59727,"_5":14874,"_28405":59463,"_3078":59717},[],{"_3626":2796,"_31224":2710,"_21623":59729,"_5":14874,"_28405":59463,"_3078":59730},[],"High: `helm upgrade` fails on inline credentials",{"_3626":2797,"_31224":2710,"_21623":59732,"_5":14874,"_28405":59463,"_3078":59733},[],"Create the Secrets first; see Step 2",{"_3626":2798,"_31224":2710,"_21623":59735,"_5":14874,"_28405":59463,"_3078":59483},[],{"_3626":2799,"_31224":2710,"_21623":59737,"_5":14874,"_28405":59463,"_3078":59738},[],"Every deployment",{"_3626":2800,"_31224":2710,"_21623":59740,"_5":14874,"_28405":59463,"_3078":59741},[],"High: without a bootstrap principal there is no administrator",{"_3626":2801,"_31224":2710,"_21623":59743,"_5":14874,"_28405":59463,"_3078":59744},[],"Configure `services.authz`",{"_3626":2802,"_31224":2710,"_21623":59746,"_5":14874,"_28405":59463,"_3078":59487},[],{"_3626":2803,"_31224":2710,"_21623":59748,"_5":14874,"_28405":59463,"_3078":59717},[],{"_3626":2804,"_31224":2710,"_21623":59750,"_5":14874,"_28405":59463,"_3078":59751},[],"High: `helm upgrade` fails on the old keys",{"_3626":2805,"_31224":2710,"_21623":59753,"_5":14874,"_28405":59463,"_3078":59754},[],"Move JWKS and roles into `services.authz`",{"_3626":2806,"_31224":2710,"_21623":59756,"_5":14874,"_28405":59463,"_3078":59507},[],{"_3626":2807,"_31224":2710,"_21623":59758,"_5":14874,"_28405":59463,"_3078":59759},[],"3.8.0 deployments with per-service databases",{"_3626":2808,"_31224":2710,"_21623":59761,"_5":14874,"_28405":59463,"_3078":59762},[],"High: services find no data, or a migration aborts",{"_3626":2809,"_31224":2710,"_21623":59764,"_5":14874,"_28405":59463,"_3078":59765},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3626":2810,"_31224":2710,"_21623":59767,"_5":14874,"_28405":59463,"_3078":59511},[],{"_3626":2811,"_31224":2710,"_21623":59769,"_5":14874,"_28405":59463,"_3078":59770},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3626":2812,"_31224":2710,"_21623":59772,"_5":14874,"_28405":59463,"_3078":59773},[],"High: the backend no longer starts with them",{"_3626":2813,"_31224":2710,"_21623":59775,"_5":14874,"_28405":59463,"_3078":59776},[],"Move to PostgreSQL before upgrading",{"_3626":2814,"_31224":2710,"_21623":59778,"_5":14874,"_28405":59463,"_3078":59559},[],{"_3626":2815,"_31224":2710,"_21623":59780,"_5":14874,"_28405":59463,"_3078":59781},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3626":2816,"_31224":2710,"_21623":59783,"_5":14874,"_28405":59463,"_3078":59784},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3626":2817,"_31224":2710,"_21623":59786,"_5":14874,"_28405":59463,"_3078":59787},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3626":2818,"_31224":2710,"_21623":59789,"_5":14874,"_28405":59463,"_3078":59790},[],"Webhooks with file references",{"_3626":2819,"_31224":2710,"_21623":59792,"_5":14874,"_28405":59463,"_3078":59793},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3626":2820,"_31224":2710,"_21623":59795,"_5":14874,"_28405":59463,"_3078":59796},[],"High: enrollments calling the webhook fail",{"_3626":2821,"_31224":2710,"_21623":59798,"_5":14874,"_28405":59463,"_3078":59799},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3626":2822,"_31224":2710,"_21623":59801,"_5":14874,"_28405":59463,"_3078":59491},[],{"_3626":2823,"_31224":2710,"_21623":59803,"_5":14874,"_28405":59463,"_3078":59804},[],"Releases with per-service identity overrides or mounted key material",{"_3626":2824,"_31224":2710,"_21623":59806,"_5":14874,"_28405":59463,"_3078":59807},[],"Medium: services cannot read their files",{"_3626":2825,"_31224":2710,"_21623":59809,"_5":14874,"_28405":59463,"_3078":59810},[],"Remove the overrides and fix volume ownership",{"_3626":2826,"_31224":2710,"_21623":59812,"_5":14874,"_28405":59463,"_3078":59495},[],{"_3626":2827,"_31224":2710,"_21623":59814,"_5":14874,"_28405":59463,"_3078":59815},[],"Releases that set `amqp.tls`",{"_3626":2828,"_31224":2710,"_21623":59817,"_5":14874,"_28405":59463,"_3078":59818},[],"Medium: clients connect to the wrong port",{"_3626":2829,"_31224":2710,"_21623":59820,"_5":14874,"_28405":59463,"_3078":59821},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3626":2830,"_31224":2710,"_21623":59823,"_5":14874,"_28405":59463,"_3078":59515},[],{"_3626":2831,"_31224":2710,"_21623":59825,"_5":14874,"_28405":59463,"_3078":59826},[],"Installations whose CA keys predate the KMS",{"_3626":2832,"_31224":2710,"_21623":59828,"_5":14874,"_28405":59463,"_3078":59829},[],"Medium: CA keys stay unmanaged",{"_3626":2833,"_31224":2710,"_21623":59831,"_5":14874,"_28405":59463,"_3078":59832},[],"Run the CA-to-KMS migration",{"_3626":2834,"_31224":2710,"_21623":59834,"_5":14874,"_28405":59463,"_3078":59835},[],"Receiver certificate verification",{"_3626":2835,"_31224":2710,"_21623":59837,"_5":14874,"_28405":59463,"_3078":59838},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3626":2836,"_31224":2710,"_21623":59840,"_5":14874,"_28405":59463,"_3078":59841},[],"Medium: credentials go to an unverified receiver",{"_3626":2837,"_31224":2710,"_21623":59843,"_5":14874,"_28405":59463,"_3078":59844},[],"Set `insecure_skip_verify` to `false`",{"_3626":2838,"_31224":2710,"_21623":59846,"_5":14874,"_28405":59463,"_3078":59531},[],{"_3626":2839,"_31224":2710,"_21623":59848,"_5":14874,"_28405":59463,"_3078":59849},[],"Scripts and consoles that edit DMSs through the API",{"_3626":2840,"_31224":2710,"_21623":59851,"_5":14874,"_28405":59463,"_3078":59852},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3626":2841,"_31224":2710,"_21623":59854,"_5":14874,"_28405":59463,"_3078":59855},[],"Read the DMS before editing and use the new field",{"_3626":2842,"_31224":2710,"_21623":59857,"_5":14874,"_28405":59463,"_3078":59535},[],{"_3626":2843,"_31224":2710,"_21623":59859,"_5":14874,"_28405":59463,"_3078":59860},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3626":2844,"_31224":2710,"_21623":59862,"_5":14874,"_28405":59463,"_3078":59863},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3626":2845,"_31224":2710,"_21623":59865,"_5":14874,"_28405":59463,"_3078":59866},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3626":2846,"_31224":2710,"_21623":59868,"_5":14874,"_28405":59463,"_3078":59555},[],{"_3626":2847,"_31224":2710,"_21623":59870,"_5":14874,"_28405":59463,"_3078":59871},[],"Clients that create or update CRL settings through the API",{"_3626":2848,"_31224":2710,"_21623":59873,"_5":14874,"_28405":59463,"_3078":59874},[],"Medium: requests with the old field return an error",{"_3626":2849,"_31224":2710,"_21623":59876,"_5":14874,"_28405":59463,"_3078":59877},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3626":2850,"_31224":2710,"_21623":59879,"_5":14874,"_28405":59463,"_3078":59563},[],{"_3626":2851,"_31224":2710,"_21623":59881,"_5":14874,"_28405":59463,"_3078":59882},[],"Alert subscriptions and consumers of the VA events",{"_3626":2852,"_31224":2710,"_21623":59884,"_5":14874,"_28405":59463,"_3078":59885},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3626":2853,"_31224":2710,"_21623":59887,"_5":14874,"_28405":59463,"_3078":59888},[],"Review conditions filtering on the old event payload or subject",{"_3626":2854,"_31224":2710,"_21623":59890,"_5":14874,"_28405":59463,"_3078":59567},[],{"_3626":2855,"_31224":2710,"_21623":59892,"_5":14874,"_28405":59463,"_3078":59893},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3626":2856,"_31224":2710,"_21623":59895,"_5":14874,"_28405":59463,"_3078":59896},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3626":2857,"_31224":2710,"_21623":59898,"_5":14874,"_28405":59463,"_3078":59899},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3626":2858,"_31224":2710,"_21623":59901,"_5":14874,"_28405":59463,"_3078":59551},[],{"_3626":2859,"_31224":2710,"_21623":59903,"_5":14874,"_28405":59463,"_3078":59904},[],"Consumers that read the device `events` field",{"_3626":2860,"_31224":2710,"_21623":59906,"_5":14874,"_28405":59463,"_3078":59907},[],"Medium: the field disappears",{"_3626":2861,"_31224":2710,"_21623":59909,"_5":14874,"_28405":59463,"_3078":59910},[],"Use the new event endpoints",{"_3626":2862,"_31224":2710,"_21623":59912,"_5":14874,"_28405":59463,"_3078":59578},[],{"_3626":2863,"_31224":2710,"_21623":59914,"_5":14874,"_28405":59463,"_3078":59915},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3626":2864,"_31224":2710,"_21623":59917,"_5":14874,"_28405":59463,"_3078":59918},[],"Medium: the VA migration aborts",{"_3626":2865,"_31224":2710,"_21623":59920,"_5":14874,"_28405":59463,"_3078":59921},[],"Fix the affected roles before upgrading",{"_3626":2866,"_31224":2710,"_21623":59923,"_5":14874,"_28405":59463,"_3078":59499},[],{"_3626":2867,"_31224":2710,"_21623":59925,"_5":14874,"_28405":59463,"_3078":59926},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3626":2868,"_31224":2710,"_21623":59928,"_5":14874,"_28405":59463,"_3078":59929},[],"Low to medium: validation errors or changed defaults",{"_3626":2869,"_31224":2710,"_21623":59931,"_5":14874,"_28405":59463,"_3078":59932},[],"Update the values file",{"_3626":2870,"_31224":2710,"_21623":59934,"_5":14874,"_28405":59463,"_3078":59543},[],{"_3626":2871,"_31224":2710,"_21623":59936,"_5":14874,"_28405":59463,"_3078":59937},[],"Clients that send the DMS ID in the update body",{"_3626":2872,"_31224":2710,"_21623":59939,"_5":14874,"_28405":59463,"_3078":59940},[],"Low: the ID in the URL wins",{"_3626":2873,"_31224":2710,"_21623":59942,"_5":14874,"_28405":59463,"_3078":59943},[],"Send the ID in the URL",{"_3626":2874,"_31224":2710,"_21623":59945,"_5":14874,"_28405":59463,"_3078":59571},[],{"_3626":2875,"_31224":2710,"_21623":59947,"_5":14874,"_28405":59463,"_3078":59948},[],"Clients that send an `id` when creating or importing CAs",{"_3626":2876,"_31224":2710,"_21623":59950,"_5":14874,"_28405":59463,"_3078":59951},[],"Low: the ID in the body is ignored, and the field is removed",{"_3626":2877,"_31224":2710,"_21623":59953,"_5":14874,"_28405":59463,"_3078":59954},[],"Let the backend assign the ID and use the returned one",{"_3626":2878,"_31224":2710,"_21623":59956,"_5":14874,"_28405":59463,"_3078":59567},[],{"_3626":2879,"_31224":2710,"_21623":59958,"_5":14874,"_28405":59463,"_3078":59959},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3626":2880,"_31224":2710,"_21623":59961,"_5":14874,"_28405":59463,"_3078":59962},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3626":2881,"_31224":2710,"_21623":59964,"_5":14874,"_28405":59463,"_3078":59965},[],"Use the KMS `sign` and `verify` operations",{"_3626":2882,"_31224":2710,"_21623":59967,"_5":14874,"_28405":59463,"_3078":59547},[],{"_3626":2883,"_31224":2710,"_21623":59969,"_5":14874,"_28405":59463,"_3078":59970},[],"Consumers that match on certificate `type`",{"_3626":2884,"_31224":2710,"_21623":59972,"_5":14874,"_28405":59463,"_3078":59973},[],"Low: two values are renamed",{"_3626":2885,"_31224":2710,"_21623":59975,"_5":14874,"_28405":59463,"_3078":59976},[],"Adapt consumers",{"_3626":2886,"_31224":2710,"_21623":59978,"_5":14874,"_28405":59463,"_3078":59539},[],{"_3626":2887,"_31224":2710,"_21623":59980,"_5":14874,"_28405":59463,"_3078":59981},[],"Any DMS",{"_3626":2888,"_31224":2710,"_21623":59983,"_5":14874,"_28405":59463,"_3078":59984},[],"Low: informational",{"_3626":2889,"_31224":2710,"_21623":59986,"_5":14874,"_28405":59463,"_3078":59987},[],"Read both blocks before editing",{"_3626":2890,"_31224":2710,"_21623":59989,"_5":14874,"_28405":59471,"_3078":59990},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3626":2891,"_31224":2710,"_21623":59992,"_5":14874,"_28405":59471,"_3078":59993},[],"Step 4 of the migration guide copies the data.",{"_3626":2892,"_31224":2710,"_21623":59995,"_5":14874,"_28405":59475,"_3078":59996},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3626":2893,"_31224":2710,"_21623":59998,"_5":14874,"_28405":59479,"_3078":59999},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3626":2894,"_31224":2710,"_21623":60001,"_5":14874,"_28405":59479,"_3078":60002},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3626":2895,"_31224":2710,"_21623":60004,"_5":14874,"_28405":59482,"_3078":60005},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3626":2896,"_31224":2710,"_21623":60007,"_5":14874,"_28405":59486,"_3078":60008},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3626":2897,"_31224":2710,"_21623":60010,"_5":14874,"_28405":59490,"_3078":60011},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3626":2898,"_31224":2710,"_21623":60013,"_5":14874,"_28405":59490,"_3078":60014},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3626":2899,"_31224":2710,"_21623":60016,"_5":14874,"_28405":59490,"_3078":60017},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3626":2900,"_31224":2710,"_21623":60019,"_5":14874,"_28405":59494,"_3078":60020},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3626":2901,"_31224":2710,"_21623":60022,"_5":14874,"_28405":59498,"_3078":60023},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3626":2902,"_31224":2710,"_21623":60025,"_5":14874,"_28405":59498,"_3078":60026},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3626":2903,"_31224":2710,"_21623":60028,"_5":14874,"_28405":59498,"_3078":60029},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3626":2904,"_31224":2710,"_21623":60031,"_5":14874,"_28405":59498,"_3078":60032},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3626":2905,"_31224":2710,"_21623":60034,"_5":14874,"_28405":59498,"_3078":60035},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3626":2906,"_31224":2710,"_21623":60037,"_5":14874,"_28405":59498,"_3078":60038},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3626":2907,"_31224":2710,"_21623":60040,"_5":14874,"_28405":59506,"_3078":60041},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3626":2908,"_31224":2710,"_21623":60043,"_5":14874,"_28405":59506,"_3078":60044},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3626":2909,"_31224":2710,"_21623":60046,"_5":14874,"_28405":59506,"_3078":60047},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3626":2910,"_31224":2710,"_21623":60049,"_5":14874,"_28405":59506,"_3078":60050},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3626":2911,"_31224":2710,"_21623":60052,"_5":14874,"_28405":59506,"_3078":60053},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3626":2912,"_31224":2710,"_21623":60055,"_5":14874,"_28405":59510,"_3078":60056},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3626":2913,"_31224":2710,"_21623":60058,"_5":14874,"_28405":59514,"_3078":60059},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3626":2914,"_31224":2710,"_21623":60061,"_5":14874,"_28405":59514,"_3078":60062},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3626":2915,"_31224":2710,"_21623":60064,"_5":14874,"_28405":59514,"_3078":60065},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3626":2916,"_31224":2710,"_21623":60067,"_5":14874,"_28405":59514,"_3078":60068},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3626":2917,"_31224":2710,"_21623":60070,"_5":14874,"_28405":59514,"_3078":60071},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3626":2918,"_31224":2710,"_21623":60073,"_5":14874,"_28405":59514,"_3078":60074},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3626":2919,"_31224":2710,"_21623":60076,"_5":14874,"_28405":59514,"_3078":60077},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3626":2920,"_31224":2710,"_21623":60079,"_5":14874,"_28405":59514,"_3078":60080},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3626":2921,"_31224":2710,"_21623":60082,"_5":14874,"_28405":59518,"_3078":60083},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3626":2922,"_31224":2710,"_21623":60085,"_5":14874,"_28405":59526,"_3078":60086},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3626":2923,"_31224":2710,"_21623":60088,"_5":14874,"_28405":59526,"_3078":60089},[],"Field in 3.8.0",{"_3626":2924,"_31224":2710,"_21623":60091,"_5":14874,"_28405":59526,"_3078":60092},[],"Field in 4.0.0",{"_3626":2925,"_31224":2710,"_21623":60094,"_5":14874,"_28405":59526,"_3078":60095},[],"`validate_server_cert`",{"_3626":2926,"_31224":2710,"_21623":60097,"_5":14874,"_28405":59526,"_3078":60098},[],"`insecure_skip_verify` (value negated)",{"_3626":2927,"_31224":2710,"_21623":60100,"_5":14874,"_28405":59526,"_3078":60101},[],"`oidc`",{"_3626":2928,"_31224":2710,"_21623":60103,"_5":14874,"_28405":59526,"_3078":60104},[],"`jwt_options`",{"_3626":2929,"_31224":2710,"_21623":60106,"_5":14874,"_28405":59526,"_3078":60107},[],"`apikey`",{"_3626":2930,"_31224":2710,"_21623":60109,"_5":14874,"_28405":59526,"_3078":60110},[],"`apikey_options`",{"_3626":2931,"_31224":2710,"_21623":60112,"_5":14874,"_28405":59526,"_3078":60113},[],"`mtls`",{"_3626":2932,"_31224":2710,"_21623":60115,"_5":14874,"_28405":59526,"_3078":60116},[],"`mtls_options`",{"_3626":2933,"_31224":2710,"_21623":60118,"_5":14874,"_28405":59526,"_3078":60119},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3626":2934,"_31224":2710,"_21623":60121,"_5":14874,"_28405":59526,"_3078":60122},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3626":2935,"_31224":2710,"_21623":60124,"_5":14874,"_28405":59526,"_3078":60125},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3626":2936,"_31224":2710,"_21623":60127,"_5":14874,"_28405":59530,"_3078":60128},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3626":2937,"_31224":2710,"_21623":60130,"_5":14874,"_28405":59530,"_3078":60131},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3626":2938,"_31224":2710,"_21623":60133,"_5":14874,"_28405":59530,"_3078":60134},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3626":2939,"_31224":2710,"_21623":60136,"_5":14874,"_28405":59534,"_3078":60137},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3626":2940,"_31224":2710,"_21623":60139,"_5":14874,"_28405":59534,"_3078":60140},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3626":2941,"_31224":2710,"_21623":60142,"_5":14874,"_28405":59538,"_3078":60143},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3626":2942,"_31224":2710,"_21623":60145,"_5":14874,"_28405":59542,"_3078":60146},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3626":2943,"_31224":2710,"_21623":60148,"_5":14874,"_28405":59546,"_3078":60149},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3626":2944,"_31224":2710,"_21623":60151,"_5":14874,"_28405":59550,"_3078":60152},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3626":2945,"_31224":2710,"_21623":60154,"_5":14874,"_28405":59550,"_3078":60155},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3626":2946,"_31224":2710,"_21623":60157,"_5":14874,"_28405":59550,"_3078":60158},[],"`POST /v1/devices/:id/events` creates an event.",{"_3626":2947,"_31224":2710,"_21623":60160,"_5":14874,"_28405":59550,"_3078":60161},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3626":2948,"_31224":2710,"_21623":60163,"_5":14874,"_28405":59554,"_3078":60164},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3626":2949,"_31224":2710,"_21623":60166,"_5":14874,"_28405":59558,"_3078":60167},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3626":2950,"_31224":2710,"_21623":60169,"_5":14874,"_28405":59558,"_3078":60170},[],"Route",{"_3626":2951,"_31224":2710,"_21623":60172,"_5":14874,"_28405":59558,"_3078":54460},[],{"_3626":2952,"_31224":2710,"_21623":60174,"_5":14874,"_28405":59558,"_3078":60175},[],"`GET /v1/crl-settings`",{"_3626":2953,"_31224":2710,"_21623":60177,"_5":14874,"_28405":59558,"_3078":60178},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3626":2954,"_31224":2710,"_21623":60180,"_5":14874,"_28405":59558,"_3078":60181},[],"`GET /v1/crl-settings/{ca-id}`",{"_3626":2955,"_31224":2710,"_21623":60183,"_5":14874,"_28405":59558,"_3078":60184},[],"Reads the settings of a CA.",{"_3626":2956,"_31224":2710,"_21623":60186,"_5":14874,"_28405":59558,"_3078":60187},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3626":2957,"_31224":2710,"_21623":60189,"_5":14874,"_28405":59558,"_3078":60190},[],"Replaces `crl_options`.",{"_3626":2958,"_31224":2710,"_21623":60192,"_5":14874,"_28405":59558,"_3078":60193},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3626":2959,"_31224":2710,"_21623":60195,"_5":14874,"_28405":59558,"_3078":60196},[],"Removes the archived settings of a CA.",{"_3626":2960,"_31224":2710,"_21623":60198,"_5":14874,"_28405":59558,"_3078":60199},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3626":2961,"_31224":2710,"_21623":60201,"_5":14874,"_28405":59558,"_3078":60202},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3626":2962,"_31224":2710,"_21623":60204,"_5":14874,"_28405":59558,"_3078":60205},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3626":2963,"_31224":2710,"_21623":60207,"_5":14874,"_28405":59558,"_3078":60208},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3626":2964,"_31224":2710,"_21623":60210,"_5":14874,"_28405":59558,"_3078":60211},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3626":2965,"_31224":2710,"_21623":60213,"_5":14874,"_28405":59558,"_3078":60214},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3626":2966,"_31224":2710,"_21623":60216,"_5":14874,"_28405":59558,"_3078":60217},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3626":2967,"_31224":2710,"_21623":60219,"_5":14874,"_28405":59558,"_3078":60220},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3626":2968,"_31224":2710,"_21623":60222,"_5":14874,"_28405":59558,"_3078":60223},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3626":2969,"_31224":2710,"_21623":60225,"_5":14874,"_28405":59558,"_3078":60226},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3626":2970,"_31224":2710,"_21623":60228,"_5":14874,"_28405":59558,"_3078":60229},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3626":2971,"_31224":2710,"_21623":60231,"_5":14874,"_28405":59562,"_3078":60232},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3626":2972,"_31224":2710,"_21623":60234,"_5":14874,"_28405":59566,"_3078":60235},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3626":2973,"_31224":2710,"_21623":60237,"_5":14874,"_28405":59570,"_3078":60238},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3626":2974,"_31224":2710,"_21623":60240,"_5":14874,"_28405":59574,"_3078":60241},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3626":2975,"_31224":2710,"_21623":60243,"_5":14874,"_28405":59574,"_3078":60244},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3626":2976,"_31224":2710,"_21623":60246,"_5":14874,"_28405":59577,"_3078":60247},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3626":2977,"_31224":2710,"_21623":60249,"_5":14874,"_28405":59581,"_3078":60250},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3626":2978,"_31224":2710,"_21623":60252,"_5":14874,"_28405":59585,"_3078":60253},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3626":2979,"_31224":2710,"_21623":60255,"_5":14874,"_28405":59585,"_3078":60256},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3626":2980,"_31224":2710,"_21623":60258,"_5":14874,"_28405":59585,"_3078":60259},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3626":2981,"_31224":2710,"_21623":60261,"_5":14874,"_28405":59585,"_3078":60262},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3626":2982,"_31224":2710,"_21623":60264,"_5":14874,"_28405":59585,"_3078":60265},[],"Record the names of your local-storage PVCs:",{"_3626":2983,"_31224":2710,"_21623":60267,"_5":14874,"_28405":59585,"_3078":60268},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3626":2984,"_31224":2710,"_21623":60270,"_5":14874,"_28405":59589,"_3078":60271},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3626":2985,"_31224":2710,"_21623":60273,"_5":14874,"_28405":59589,"_3078":60274},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3626":2986,"_31224":2710,"_21623":60276,"_5":14874,"_28405":59589,"_3078":60277},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3626":2987,"_31224":2710,"_21623":60279,"_5":14874,"_28405":59589,"_3078":60280},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3626":2988,"_31224":2710,"_21623":60282,"_5":14874,"_28405":59589,"_3078":60283},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3626":2989,"_31224":2710,"_21623":60285,"_5":14874,"_28405":59593,"_3078":60286},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3626":2990,"_31224":2710,"_21623":60288,"_5":14874,"_28405":59593,"_3078":60289},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3626":2991,"_31224":2710,"_21623":60291,"_5":14874,"_28405":59593,"_3078":60292},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3626":2992,"_31224":2710,"_21623":60294,"_5":14874,"_28405":59593,"_3078":60295},[],"Secret (`existingSecret`)",{"_3626":2993,"_31224":2710,"_21623":60297,"_5":14874,"_28405":59593,"_3078":60298},[],"Required data keys",{"_3626":2994,"_31224":2710,"_21623":60300,"_5":14874,"_28405":59593,"_3078":60301},[],"When",{"_3626":2995,"_31224":2710,"_21623":60303,"_5":14874,"_28405":59593,"_3078":60304},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3626":2996,"_31224":2710,"_21623":60306,"_5":14874,"_28405":59593,"_3078":60307},[],"`username`, `password`",{"_3626":2997,"_31224":2710,"_21623":60309,"_5":14874,"_28405":59593,"_3078":60310},[],"Always",{"_3626":2998,"_31224":2710,"_21623":60312,"_5":14874,"_28405":59593,"_3078":60313},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3626":2999,"_31224":2710,"_21623":60315,"_5":14874,"_28405":59593,"_3078":60307},[],{"_3626":3000,"_31224":2710,"_21623":60317,"_5":14874,"_28405":59593,"_3078":60310},[],{"_3626":3001,"_31224":2710,"_21623":60319,"_5":14874,"_28405":59593,"_3078":60320},[],"`services.alerts.smtp_server.existingSecret`",{"_3626":3002,"_31224":2710,"_21623":60322,"_5":14874,"_28405":59593,"_3078":60307},[],{"_3626":3003,"_31224":2710,"_21623":60324,"_5":14874,"_28405":59593,"_3078":60325},[],"Only when SMTP authentication is enabled",{"_3626":3004,"_31224":2710,"_21623":60327,"_5":14874,"_28405":59593,"_3078":60328},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3626":3005,"_31224":2710,"_21623":60330,"_5":14874,"_28405":59593,"_3078":60331},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3626":3006,"_31224":2710,"_21623":60333,"_5":14874,"_28405":59593,"_3078":60334},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3626":3007,"_31224":2710,"_21623":60336,"_5":14874,"_28405":59593,"_3078":60337},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3626":3008,"_31224":2710,"_21623":60339,"_5":14874,"_28405":59593,"_3078":60340},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3626":3009,"_31224":2710,"_21623":60342,"_5":14874,"_28405":59593,"_3078":60343},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3626":3010,"_31224":2710,"_21623":60345,"_5":14874,"_28405":59593,"_3078":60346},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3626":3011,"_31224":2710,"_21623":60348,"_5":14874,"_28405":59593,"_3078":60349},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3626":3012,"_31224":2710,"_21623":60351,"_5":14874,"_28405":59593,"_3078":60352},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3626":3013,"_31224":2710,"_21623":60354,"_5":14874,"_28405":59593,"_3078":60355},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3626":3014,"_31224":2710,"_21623":60357,"_5":14874,"_28405":59593,"_3078":60358},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3626":3015,"_31224":2710,"_21623":60360,"_5":14874,"_28405":59593,"_3078":60361},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3626":3016,"_31224":2710,"_21623":60363,"_5":14874,"_28405":59593,"_3078":60364},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3626":3017,"_31224":2710,"_21623":60366,"_5":14874,"_28405":59593,"_3078":60367},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3626":3018,"_31224":2710,"_21623":60369,"_5":14874,"_28405":59593,"_3078":60370},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3626":3019,"_31224":2710,"_21623":60372,"_5":14874,"_28405":59597,"_3078":60373},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3626":3020,"_31224":2710,"_21623":60375,"_5":14874,"_28405":59597,"_3078":60376},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3626":3021,"_31224":2710,"_21623":60378,"_5":14874,"_28405":59601,"_3078":60379},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3626":3022,"_31224":2710,"_21623":60381,"_5":14874,"_28405":59601,"_3078":60382},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3626":3023,"_31224":2710,"_21623":60384,"_5":14874,"_28405":59601,"_3078":60385},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3626":3024,"_31224":2710,"_21623":60387,"_5":14874,"_28405":59601,"_3078":60388},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3626":3025,"_31224":2710,"_21623":60390,"_5":14874,"_28405":59601,"_3078":60391},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3626":3026,"_31224":2710,"_21623":60393,"_5":14874,"_28405":59601,"_3078":60394},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3626":3027,"_31224":2710,"_21623":60396,"_5":14874,"_28405":59601,"_3078":60397},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3626":3028,"_31224":2710,"_21623":60399,"_5":14874,"_28405":59601,"_3078":60400},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3626":3029,"_31224":2710,"_21623":60402,"_5":14874,"_28405":59601,"_3078":60403},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3626":3030,"_31224":2710,"_21623":60405,"_5":14874,"_28405":59601,"_3078":60406},[],"**Remove the helper and restore the recorded replica counts:**",{"_3626":3031,"_31224":2710,"_21623":60408,"_5":14874,"_28405":59601,"_3078":60409},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3626":3032,"_31224":2710,"_21623":60411,"_5":14874,"_28405":59605,"_3078":60412},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3626":3033,"_31224":2710,"_21623":60414,"_5":14874,"_28405":59605,"_3078":60415},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3626":3034,"_31224":2710,"_21623":60417,"_5":14874,"_28405":59609,"_3078":60418},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3626":3035,"_31224":2710,"_21623":60420,"_5":14874,"_28405":59609,"_3078":60421},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3626":3036,"_31224":2710,"_21623":60423,"_5":14874,"_28405":59609,"_3078":60424},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3626":3037,"_31224":2710,"_21623":60426,"_5":14874,"_28405":59609,"_3078":60427},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3626":3038,"_31224":2710,"_21623":60429,"_5":14874,"_28405":59609,"_3078":60430},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3626":3039,"_31224":2710,"_21623":60432,"_5":14874,"_28405":59609,"_3078":60433},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3626":3040,"_31224":2710,"_21623":60435,"_5":14874,"_28405":59609,"_3078":60436},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3626":3041,"_31224":2710,"_21623":60438,"_5":14874,"_28405":59609,"_3078":60439},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3626":3042,"_31224":2710,"_21623":60441,"_5":14874,"_28405":59613,"_3078":60442},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3626":3043,"_31224":2710,"_21623":60444,"_5":14874,"_28405":59613,"_3078":60445},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3626":3044,"_31224":2710,"_21623":60447,"_5":14874,"_28405":59613,"_3078":60448},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3626":3045,"_31224":2710,"_21623":60450,"_5":14874,"_28405":59613,"_3078":60451},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3626":3046,"_31224":2710,"_21623":60453,"_5":14874,"_28405":59613,"_3078":60454},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3626":3047,"_31224":2710,"_21623":60456,"_5":14874,"_28405":59613,"_3078":60457},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3626":3048,"_31224":2710,"_21623":60459,"_5":14874,"_28405":59613,"_3078":60460},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3626":3049,"_31224":2710,"_21623":60462,"_5":14874,"_28405":59613,"_3078":60463},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3626":3050,"_31224":2710,"_21623":60465,"_5":14874,"_28405":59613,"_3078":60466},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3626":3051,"_31224":2710,"_21623":60468,"_5":14874,"_28405":59613,"_3078":60469},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3626":3052,"_31224":2710,"_21623":60471,"_5":14874,"_28405":59613,"_3078":60472},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3626":3053,"_31224":2710,"_21623":60474,"_5":14874,"_28405":59616,"_3078":60475},[],"After the upgrade, check in this order:",{"_3626":3054,"_31224":2710,"_21623":60477,"_5":14874,"_28405":59616,"_3078":60478},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3626":3055,"_31224":2710,"_21623":60480,"_5":14874,"_28405":59616,"_3078":60481},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3626":3056,"_31224":2710,"_21623":60483,"_5":14874,"_28405":59616,"_3078":60484},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3626":3057,"_31224":2710,"_21623":60486,"_5":14874,"_28405":59616,"_3078":60487},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3626":3058,"_31224":2710,"_21623":60489,"_5":14874,"_28405":59616,"_3078":60490},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3626":3059,"_31224":2710,"_21623":60492,"_5":14874,"_28405":59616,"_3078":60493},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3626":3060,"_31224":2710,"_21623":60495,"_5":14874,"_28405":59616,"_3078":60496},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3626":3061,"_31224":2710,"_21623":60498,"_5":14874,"_28405":59616,"_3078":60499},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3626":3062,"_31224":2710,"_21623":60501,"_5":14874,"_28405":59616,"_3078":60502},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3626":3063,"_31224":2710,"_21623":60504,"_5":14874,"_28405":59616,"_3078":60505},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3626":3064,"_31224":2710,"_21623":60507,"_5":14874,"_28405":59616,"_3078":60508},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3626":3065,"_31224":2710,"_21623":60510,"_5":14874,"_28405":59616,"_3078":60511},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3626":3066,"_31224":2710,"_21623":60513,"_5":14874,"_28405":59616,"_3078":60514},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3626":3067,"_31224":2710,"_21623":60516,"_5":14874,"_28405":59616,"_3078":60517},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3626":3068,"_31224":2710,"_21623":60519,"_5":14874,"_28405":59616,"_3078":60520},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3626":3069,"_31224":2710,"_21623":60522,"_5":14874,"_28405":59620,"_3078":60523},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3626":3070,"_31224":2710,"_21623":60525,"_5":14874,"_28405":59620,"_3078":60526},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3626":3071,"_31224":2710,"_21623":60528,"_5":14874,"_28405":59620,"_3078":60529},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3626":3072,"_31224":2710,"_21623":60531,"_5":14874,"_28405":59620,"_3078":60532},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3626":3073,"_31224":2710,"_21623":60534,"_5":14874,"_28405":59620,"_3078":60535},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60538":60539,"_60540":60541,"_60542":60543,"_60544":60545,"_18755":3113,"_72795":3113},"language","english","sortableProperties",[3078,31224,5,28405],"sortablePropertiesWithTypes",{"_3078":25814,"_31224":25814,"_5":25814,"_28405":25814},"sorts",{"_3078":60546,"_31224":63609,"_5":66671,"_28405":69733},{"_4829":60547,"_60548":60549,"_5":25814},{"_14955":7235,"_15339":7157,"_15358":3551,"_30218":3459,"_15345":13752,"_20535":6203,"_14976":4236,"_14983":5366,"_30160":20839,"_30568":6984,"_30595":4933,"_30194":4986,"_35639":4370,"_30297":7814,"_30639":5125,"_35646":30816,"_35649":6213,"_35652":17165,"_35655":4486,"_31047":7797,"_35660":24633,"_35662":7882,"_31082":13511,"_15354":4324,"_35666":3687,"_35669":4542,"_35671":6438,"_30623":5959,"_31067":7941,"_31095":5183,"_35676":13859,"_35678":3481,"_35680":4939,"_30308":3179,"_35683":3421,"_35685":20833,"_35687":5340,"_35689":3807,"_35691":23821,"_30231":7950,"_35694":10831,"_35696":3483,"_30225":7917,"_30660":7484,"_35700":4380,"_35702":7771,"_35705":5155,"_30271":6980,"_35709":5179,"_30151":5004,"_35712":4966,"_30199":7259,"_35715":6062,"_35717":14498,"_35720":4464,"_15348":10455,"_35723":7314,"_35725":4035,"_35728":24374,"_35730":4792,"_35732":6303,"_35734":11361,"_35736":21801,"_20538":16119,"_35739":4163,"_35741":4381,"_30172":698