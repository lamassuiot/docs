663":129528,"_41665":129531,"_41667":129534,"_41669":129537,"_41671":129540,"_41673":129543,"_41675":129546,"_41677":129549,"_41679":129552,"_41682":129555,"_41684":129558,"_41686":129561},{"_3624":72713,"_31170":72713,"_5":15217,"_3076":120284,"_31528":120285,"_21595":120288,"_28362":72713},"Despliega desde AWS Marketplace",[50937,120286,120287],"Despliegue","Otros modelos",[],{"_3624":72714,"_31170":72713,"_21595":120290,"_5":14857,"_28362":72713,"_3076":120291},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3624":72715,"_31170":72713,"_5":31525,"_21595":120293,"_28362":120294,"_3076":120295},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3624":72716,"_31170":72713,"_5":31525,"_21595":120297,"_28362":120298,"_3076":120299},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3624":72717,"_31170":72713,"_5":31525,"_21595":120301,"_28362":120302,"_3076":120303},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3624":72718,"_31170":72713,"_5":31525,"_21595":120305,"_28362":120306,"_3076":120307},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3624":72719,"_31170":72713,"_5":31525,"_21595":120309,"_28362":120310,"_3076":120311},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3624":72720,"_31170":72713,"_5":31525,"_21595":120313,"_28362":120314,"_3076":120315},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3624":72721,"_31170":72713,"_5":31525,"_21595":120317,"_28362":120318,"_3076":120319},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3624":72722,"_31170":72713,"_21595":120321,"_5":14857,"_28362":72713,"_3076":120322},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3624":72723,"_31170":72713,"_21595":120324,"_5":14857,"_28362":120294,"_3076":120325},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3624":72724,"_31170":72713,"_21595":120327,"_5":14857,"_28362":120294,"_3076":120328},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3624":72725,"_31170":72713,"_21595":120330,"_5":14857,"_28362":120294,"_3076":120331},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3624":72726,"_31170":72713,"_21595":120333,"_5":14857,"_28362":120298,"_3076":120334},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3624":72727,"_31170":72713,"_21595":120336,"_5":14857,"_28362":120298,"_3076":120337},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3624":72728,"_31170":72713,"_21595":120339,"_5":14857,"_28362":120298,"_3076":120340},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3624":72729,"_31170":72713,"_21595":120342,"_5":14857,"_28362":120302,"_3076":120343},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3624":72730,"_31170":72713,"_21595":120345,"_5":14857,"_28362":120306,"_3076":120346},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3624":72731,"_31170":72713,"_21595":120348,"_5":14857,"_28362":120310,"_3076":120349},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3624":72732,"_31170":72713,"_21595":120351,"_5":14857,"_28362":120314,"_3076":120352},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3624":72733,"_31170":72713,"_21595":120354,"_5":14857,"_28362":120318,"_3076":120355},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3624":72734,"_31170":72734,"_5":15217,"_3076":120357,"_31528":120358,"_21595":120359,"_28362":72734},"Despliega Lamassu",[50937,120286],[],{"_3624":72735,"_31170":72734,"_21595":120361,"_5":14857,"_28362":72734,"_3076":120362},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3624":72736,"_31170":72734,"_5":31525,"_21595":120364,"_28362":120365,"_3076":120366},[],"/docs/pr-preview/pr-76/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3624":72737,"_31170":72734,"_5":31525,"_21595":120368,"_28362":120369,"_3076":120370},[],"/docs/pr-preview/pr-76/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3624":72738,"_31170":72734,"_5":31525,"_21595":120372,"_28362":120373,"_3076":120374},[],"/docs/pr-preview/pr-76/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3624":72739,"_31170":72734,"_21595":120376,"_5":14857,"_28362":72734,"_3076":120377},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3624":72740,"_31170":72734,"_21595":120379,"_5":14857,"_28362":120365,"_3076":120380},[],"Modelo",{"_3624":72741,"_31170":72734,"_21595":120382,"_5":14857,"_28362":120365,"_3076":120383},[],"Recomendado para",{"_3624":72742,"_31170":72734,"_21595":120385,"_5":14857,"_28362":120365,"_3076":120386},[],"Quién opera la infraestructura",{"_3624":72743,"_31170":72734,"_21595":120388,"_5":14857,"_28362":120365,"_3076":120389},[],"Punto de partida",{"_3624":72744,"_31170":72734,"_21595":120391,"_5":14857,"_28362":120365,"_3076":51044},[],{"_3624":72745,"_31170":72734,"_21595":120393,"_5":14857,"_28362":120365,"_3076":120394},[],"Producción, entornos regulados y despliegues personalizados",{"_3624":72746,"_31170":72734,"_21595":120396,"_5":14857,"_28362":120365,"_3076":120397},[],"Tu equipo",{"_3624":72747,"_31170":72734,"_21595":120399,"_5":14857,"_28362":120365,"_3076":120400},[],"Helm o Fastlane",{"_3624":72748,"_31170":72734,"_21595":120402,"_5":14857,"_28362":120365,"_3076":51056},[],{"_3624":72749,"_31170":72734,"_21595":120404,"_5":14857,"_28362":120365,"_3076":120405},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3624":72750,"_31170":72734,"_21595":120407,"_5":14857,"_28362":120365,"_3076":120397},[],{"_3624":72751,"_31170":72734,"_21595":120409,"_5":14857,"_28362":120365,"_3076":120410},[],"Imagen preconfigurada en EC2",{"_3624":72752,"_31170":72734,"_21595":120412,"_5":14857,"_28362":120365,"_3076":51067},[],{"_3624":72753,"_31170":72734,"_21595":120414,"_5":14857,"_28362":120365,"_3076":120415},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3624":72754,"_31170":72734,"_21595":120417,"_5":14857,"_28362":120365,"_3076":51073},[],{"_3624":72755,"_31170":72734,"_21595":120419,"_5":14857,"_28362":120365,"_3076":120420},[],"Suscripción gestionada",{"_3624":72756,"_31170":72734,"_21595":120422,"_5":14857,"_28362":120365,"_3076":120423},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3624":72757,"_31170":72734,"_21595":120425,"_5":14857,"_28362":120365,"_3076":120426},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3624":72758,"_31170":72734,"_21595":120428,"_5":14857,"_28362":120365,"_3076":120429},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3624":72759,"_31170":72734,"_21595":120431,"_5":14857,"_28362":120369,"_3076":120432},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3624":72760,"_31170":72734,"_21595":120434,"_5":14857,"_28362":120373,"_3076":120435},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3624":72761,"_31170":72761,"_5":15217,"_3076":120437,"_31528":120438,"_21595":120439,"_28362":72761},"Utiliza Lamassu como SaaS",[50937,120286,120287],[],{"_3624":72762,"_31170":72761,"_21595":120441,"_5":14857,"_28362":72761,"_3076":120442},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3624":72763,"_31170":72761,"_5":31525,"_21595":120444,"_28362":120445,"_3076":120446},[],"/docs/pr-preview/pr-76/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3624":72764,"_31170":72761,"_5":31525,"_21595":120448,"_28362":120449,"_3076":120450},[],"/docs/pr-preview/pr-76/es/deployment/saas#planes","Planes",{"_3624":72765,"_31170":72761,"_5":31525,"_21595":120452,"_28362":120453,"_3076":120454},[],"/docs/pr-preview/pr-76/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3624":72766,"_31170":72761,"_21595":120456,"_5":14857,"_28362":72761,"_3076":120457},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3624":72767,"_31170":72761,"_21595":120459,"_5":14857,"_28362":120445,"_3076":120460},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3624":72768,"_31170":72761,"_21595":120462,"_5":14857,"_28362":120445,"_3076":120463},[],"Copias de seguridad automáticas.",{"_3624":72769,"_31170":72761,"_21595":120465,"_5":14857,"_28362":120445,"_3076":120466},[],"Actualizaciones de versión.",{"_3624":72770,"_31170":72761,"_21595":120468,"_5":14857,"_28362":120445,"_3076":120469},[],"Soporte técnico y SLA según el plan contratado.",{"_3624":72771,"_31170":72761,"_21595":120471,"_5":14857,"_28362":120449,"_3076":51128},[],{"_3624":72772,"_31170":72761,"_21595":120473,"_5":14857,"_28362":120449,"_3076":120474},[],"Dispositivos",{"_3624":72773,"_31170":72761,"_21595":120476,"_5":14857,"_28362":120449,"_3076":120477},[],"Soporte",{"_3624":72774,"_31170":72761,"_21595":120479,"_5":14857,"_28362":120449,"_3076":51137},[],{"_3624":72775,"_31170":72761,"_21595":120481,"_5":14857,"_28362":120449,"_3076":51140},[],{"_3624":72776,"_31170":72761,"_21595":120483,"_5":14857,"_28362":120449,"_3076":120484},[],"Hasta 1.000",{"_3624":72777,"_31170":72761,"_21595":120486,"_5":14857,"_28362":120449,"_3076":51146},[],{"_3624":72778,"_31170":72761,"_21595":120488,"_5":14857,"_28362":120449,"_3076":120489},[],"99,5 %",{"_3624":72779,"_31170":72761,"_21595":120491,"_5":14857,"_28362":120449,"_3076":51152},[],{"_3624":72780,"_31170":72761,"_21595":120493,"_5":14857,"_28362":120449,"_3076":120494},[],"Hasta 10.000",{"_3624":72781,"_31170":72761,"_21595":120496,"_5":14857,"_28362":120449,"_3076":120497},[],"Email y chat",{"_3624":72782,"_31170":72761,"_21595":120499,"_5":14857,"_28362":120449,"_3076":120500},[],"99,9 %",{"_3624":72783,"_31170":72761,"_21595":120502,"_5":14857,"_28362":120449,"_3076":51164},[],{"_3624":72784,"_31170":72761,"_21595":120504,"_5":14857,"_28362":120449,"_3076":120505},[],"Ilimitados",{"_3624":72785,"_31170":72761,"_21595":120507,"_5":14857,"_28362":120449,"_3076":120508},[],"Dedicado",{"_3624":72786,"_31170":72761,"_21595":120510,"_5":14857,"_28362":120449,"_3076":120511},[],"99,99 %",{"_3624":72787,"_31170":72761,"_21595":120513,"_5":14857,"_28362":120453,"_3076":120514},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3624":72788,"_31170":72761,"_21595":120516,"_5":14857,"_28362":120453,"_3076":120517},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3624":72789,"_31170":72789,"_5":15217,"_3076":51181,"_31528":120519,"_21595":120521,"_28362":72789},[50937,120286,120520],"Kubernetes autogestionado",[],{"_3624":72790,"_31170":72789,"_21595":120523,"_5":14857,"_28362":72789,"_3076":120524},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3624":72791,"_31170":72789,"_5":31525,"_21595":120526,"_28362":120527,"_3076":120528},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3624":72792,"_31170":72789,"_5":31525,"_21595":120530,"_28362":120531,"_3076":120532},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3624":72793,"_31170":72789,"_5":31525,"_21595":120534,"_28362":120535,"_3076":120536},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3624":72794,"_31170":72789,"_5":31525,"_21595":120538,"_28362":120539,"_3076":120540},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3624":72795,"_31170":72789,"_5":31525,"_21595":120542,"_28362":120543,"_3076":120544},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3624":72796,"_31170":72789,"_5":31525,"_21595":120546,"_28362":120547,"_3076":120548},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3624":72797,"_31170":72789,"_5":31525,"_21595":120550,"_28362":120551,"_3076":120552},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3624":72798,"_31170":72789,"_5":31525,"_21595":120554,"_28362":120555,"_3076":120556},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3624":72799,"_31170":72789,"_5":31525,"_21595":120558,"_28362":120559,"_3076":120560},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3624":72800,"_31170":72789,"_5":31525,"_21595":120562,"_28362":120563,"_3076":120564},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3624":72801,"_31170":72789,"_5":31525,"_21595":120566,"_28362":120567,"_3076":120568},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3624":72802,"_31170":72789,"_21595":120570,"_5":14857,"_28362":120527,"_3076":120571},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3624":72803,"_31170":72789,"_21595":120573,"_5":14857,"_28362":120527,"_3076":120574},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3624":72804,"_31170":72789,"_21595":120576,"_5":14857,"_28362":120531,"_3076":120577},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3624":72805,"_31170":72789,"_21595":120579,"_5":14857,"_28362":120531,"_3076":120580},[],"Fastlane instala o configura",{"_3624":72806,"_31170":72789,"_21595":120582,"_5":14857,"_28362":120531,"_3076":120583},[],"Tú sigues proporcionando",{"_3624":72807,"_31170":72789,"_21595":120585,"_5":14857,"_28362":120531,"_3076":120586},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3624":72808,"_31170":72789,"_21595":120588,"_5":14857,"_28362":120531,"_3076":120589},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3624":72809,"_31170":72789,"_21595":120591,"_5":14857,"_28362":120531,"_3076":120592},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3624":72810,"_31170":72789,"_21595":120594,"_5":14857,"_28362":120531,"_3076":120595},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3624":72811,"_31170":72789,"_21595":120597,"_5":14857,"_28362":120531,"_3076":120598},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3624":72812,"_31170":72789,"_21595":120600,"_5":14857,"_28362":120531,"_3076":120601},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3624":72813,"_31170":72789,"_21595":120603,"_5":14857,"_28362":120531,"_3076":120604},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3624":72814,"_31170":72789,"_21595":120606,"_5":14857,"_28362":120531,"_3076":120607},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3624":72815,"_31170":72789,"_21595":120609,"_5":14857,"_28362":120531,"_3076":120610},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3624":72816,"_31170":72789,"_21595":120612,"_5":14857,"_28362":120535,"_3076":120613},[],"Necesitas:",{"_3624":72817,"_31170":72789,"_21595":120615,"_5":14857,"_28362":120535,"_3076":120616},[],"un clúster Kubernetes existente",{"_3624":72818,"_31170":72789,"_21595":120618,"_5":14857,"_28362":120535,"_3076":120619},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3624":72819,"_31170":72789,"_21595":120621,"_5":14857,"_28362":120535,"_3076":51283},[],{"_3624":72820,"_31170":72789,"_21595":120623,"_5":14857,"_28362":120535,"_3076":24407},[],{"_3624":72821,"_31170":72789,"_21595":120625,"_5":14857,"_28362":120535,"_3076":120626},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3624":72822,"_31170":72789,"_21595":120628,"_5":14857,"_28362":120535,"_3076":120629},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3624":72823,"_31170":72789,"_21595":120631,"_5":14857,"_28362":120535,"_3076":120632},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3624":72824,"_31170":72789,"_21595":120634,"_5":14857,"_28362":120535,"_3076":120635},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3624":72825,"_31170":72789,"_21595":120637,"_5":14857,"_28362":120535,"_3076":120638},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3624":72826,"_31170":72789,"_21595":120640,"_5":14857,"_28362":120539,"_3076":120641},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3624":72827,"_31170":72789,"_21595":120643,"_5":14857,"_28362":120539,"_3076":120644},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3624":72828,"_31170":72789,"_21595":120646,"_5":14857,"_28362":120543,"_3076":120647},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3624":72829,"_31170":72789,"_21595":120649,"_5":14857,"_28362":120543,"_3076":120650},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3624":72830,"_31170":72789,"_21595":120652,"_5":14857,"_28362":120543,"_3076":120653},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3624":72831,"_31170":72789,"_21595":120655,"_5":14857,"_28362":120543,"_3076":120656},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3624":72832,"_31170":72789,"_21595":120658,"_5":14857,"_28362":120547,"_3076":120659},[],"Opción",{"_3624":72833,"_31170":72789,"_21595":120661,"_5":14857,"_28362":120547,"_3076":120662},[],"Valor predeterminado",{"_3624":72834,"_31170":72789,"_21595":120664,"_5":14857,"_28362":120547,"_3076":120665},[],"Propósito",{"_3624":72835,"_31170":72789,"_21595":120667,"_5":14857,"_28362":120547,"_3076":51330},[],{"_3624":72836,"_31170":72789,"_21595":120669,"_5":14857,"_28362":120547,"_3076":51333},[],{"_3624":72837,"_31170":72789,"_21595":120671,"_5":14857,"_28362":120547,"_3076":120672},[],"Muestra la ayuda",{"_3624":72838,"_31170":72789,"_21595":120674,"_5":14857,"_28362":120547,"_3076":51339},[],{"_3624":72839,"_31170":72789,"_21595":120676,"_5":14857,"_28362":120547,"_3076":120677},[],"contexto actual",{"_3624":72840,"_31170":72789,"_21595":120679,"_5":14857,"_28362":120547,"_3076":120680},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3624":72841,"_31170":72789,"_21595":120682,"_5":14857,"_28362":120547,"_3076":51348},[],{"_3624":72842,"_31170":72789,"_21595":120684,"_5":14857,"_28362":120547,"_3076":6790},[],{"_3624":72843,"_31170":72789,"_21595":120686,"_5":14857,"_28362":120547,"_3076":120687},[],"Omite prompts y genera credenciales para las dependencias",{"_3624":72844,"_31170":72789,"_21595":120689,"_5":14857,"_28362":120547,"_3076":51356},[],{"_3624":72845,"_31170":72789,"_21595":120691,"_5":14857,"_28362":120547,"_3076":51359},[],{"_3624":72846,"_31170":72789,"_21595":120693,"_5":14857,"_28362":120547,"_3076":120694},[],"Namespace de la instalación",{"_3624":72847,"_31170":72789,"_21595":120696,"_5":14857,"_28362":120547,"_3076":51365},[],{"_3624":72848,"_31170":72789,"_21595":120698,"_5":14857,"_28362":120547,"_3076":51368},[],{"_3624":72849,"_31170":72789,"_21595":120700,"_5":14857,"_28362":120547,"_3076":120701},[],"Dominio usado por la UI, OIDC y el certificado",{"_3624":72850,"_31170":72789,"_21595":120703,"_5":14857,"_28362":120547,"_3076":51374},[],{"_3624":72851,"_31170":72789,"_21595":120705,"_5":14857,"_28362":120547,"_3076":15569},[],{"_3624":72852,"_31170":72789,"_21595":120707,"_5":14857,"_28362":120547,"_3076":120708},[],"Versión del chart de Lamassu",{"_3624":72853,"_31170":72789,"_21595":120710,"_5":14857,"_28362":120547,"_3076":51382},[],{"_3624":72854,"_31170":72789,"_21595":120712,"_5":14857,"_28362":120547,"_3076":51385},[],{"_3624":72855,"_31170":72789,"_21595":120714,"_5":14857,"_28362":120547,"_3076":120715},[],"Puerto del listener HTTPS",{"_3624":72856,"_31170":72789,"_21595":120717,"_5":14857,"_28362":120547,"_3076":51391},[],{"_3624":72857,"_31170":72789,"_21595":120719,"_5":14857,"_28362":120547,"_3076":51394},[],{"_3624":72858,"_31170":72789,"_21595":120721,"_5":14857,"_28362":120547,"_3076":120722},[],"Puerto del listener HTTP",{"_3624":72859,"_31170":72789,"_21595":120724,"_5":14857,"_28362":120547,"_3076":51400},[],{"_3624":72860,"_31170":72789,"_21595":120726,"_5":14857,"_28362":120547,"_3076":51333},[],{"_3624":72861,"_31170":72789,"_21595":120728,"_5":14857,"_28362":120547,"_3076":120729},[],"Certificado PEM para TLS downstream",{"_3624":72862,"_31170":72789,"_21595":120731,"_5":14857,"_28362":120547,"_3076":51408},[],{"_3624":72863,"_31170":72789,"_21595":120733,"_5":14857,"_28362":120547,"_3076":51333},[],{"_3624":72864,"_31170":72789,"_21595":120735,"_5":14857,"_28362":120547,"_3076":120736},[],"Clave privada PEM para TLS downstream",{"_3624":72865,"_31170":72789,"_21595":120738,"_5":14857,"_28362":120547,"_3076":51416},[],{"_3624":72866,"_31170":72789,"_21595":120740,"_5":14857,"_28362":120547,"_3076":120741},[],"chart del repositorio",{"_3624":72867,"_31170":72789,"_21595":120743,"_5":14857,"_28362":120547,"_3076":120744},[],"Usa un chart local de Lamassu sin empaquetar",{"_3624":72868,"_31170":72789,"_21595":120746,"_5":14857,"_28362":120547,"_3076":51425},[],{"_3624":72869,"_31170":72789,"_21595":120748,"_5":14857,"_28362":120547,"_3076":120749},[],"detección automática",{"_3624":72870,"_31170":72789,"_21595":120751,"_5":14857,"_28362":120547,"_3076":120752},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3624":72871,"_31170":72789,"_21595":120754,"_5":14857,"_28362":120547,"_3076":51433},[],{"_3624":72872,"_31170":72789,"_21595":120756,"_5":14857,"_28362":120547,"_3076":6790},[],{"_3624":72873,"_31170":72789,"_21595":120758,"_5":14857,"_28362":120547,"_3076":120759},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3624":72874,"_31170":72789,"_21595":120761,"_5":14857,"_28362":120547,"_3076":51441},[],{"_3624":72875,"_31170":72789,"_21595":120763,"_5":14857,"_28362":120547,"_3076":6790},[],{"_3624":72876,"_31170":72789,"_21595":120765,"_5":14857,"_28362":120547,"_3076":120766},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3624":72877,"_31170":72789,"_21595":120768,"_5":14857,"_28362":120547,"_3076":51449},[],{"_3624":72878,"_31170":72789,"_21595":120770,"_5":14857,"_28362":120547,"_3076":6790},[],{"_3624":72879,"_31170":72789,"_21595":120772,"_5":14857,"_28362":120547,"_3076":120773},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3624":72880,"_31170":72789,"_21595":120775,"_5":14857,"_28362":120547,"_3076":51457},[],{"_3624":72881,"_31170":72789,"_21595":120777,"_5":14857,"_28362":120547,"_3076":6790},[],{"_3624":72882,"_31170":72789,"_21595":120779,"_5":14857,"_28362":120547,"_3076":120780},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3624":72883,"_31170":72789,"_21595":120782,"_5":14857,"_28362":120547,"_3076":51465},[],{"_3624":72884,"_31170":72789,"_21595":120784,"_5":14857,"_28362":120547,"_3076":51468},[],{"_3624":72885,"_31170":72789,"_21595":120786,"_5":14857,"_28362":120547,"_3076":120787},[],"Usa otro chart local de SoftHSM",{"_3624":72886,"_31170":72789,"_21595":120789,"_5":14857,"_28362":120547,"_3076":120790},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3624":72887,"_31170":72789,"_21595":120792,"_5":14857,"_28362":120551,"_3076":120793},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3624":72888,"_31170":72789,"_21595":120795,"_5":14857,"_28362":120551,"_3076":120796},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3624":72889,"_31170":72789,"_21595":120798,"_5":14857,"_28362":120551,"_3076":120799},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3624":72890,"_31170":72789,"_21595":120801,"_5":14857,"_28362":120551,"_3076":120802},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3624":72891,"_31170":72789,"_21595":120804,"_5":14857,"_28362":120551,"_3076":120805},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3624":72892,"_31170":72789,"_21595":120807,"_5":14857,"_28362":120551,"_3076":120808},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3624":72893,"_31170":72789,"_21595":120810,"_5":14857,"_28362":120555,"_3076":51495},[],{"_3624":72894,"_31170":72789,"_21595":120812,"_5":14857,"_28362":120555,"_3076":120813},[],"valida las herramientas locales y el clúster seleccionado",{"_3624":72895,"_31170":72789,"_21595":120815,"_5":14857,"_28362":120555,"_3076":120816},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3624":72896,"_31170":72789,"_21595":120818,"_5":14857,"_28362":120555,"_3076":120819},[],"crea el namespace",{"_3624":72897,"_31170":72789,"_21595":120821,"_5":14857,"_28362":120555,"_3076":120822},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3624":72898,"_31170":72789,"_21595":120824,"_5":14857,"_28362":120555,"_3076":120825},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3624":72899,"_31170":72789,"_21595":120827,"_5":14857,"_28362":120555,"_3076":120828},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3624":72900,"_31170":72789,"_21595":120830,"_5":14857,"_28362":120555,"_3076":120831},[],"instala RabbitMQ",{"_3624":72901,"_31170":72789,"_21595":120833,"_5":14857,"_28362":120555,"_3076":120834},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3624":72902,"_31170":72789,"_21595":120836,"_5":14857,"_28362":120555,"_3076":120837},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3624":72903,"_31170":72789,"_21595":120839,"_5":14857,"_28362":120555,"_3076":120840},[],"carga datos de ejemplo opcionalmente",{"_3624":72904,"_31170":72789,"_21595":120842,"_5":14857,"_28362":120555,"_3076":120843},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3624":72905,"_31170":72789,"_21595":120845,"_5":14857,"_28362":120559,"_3076":120846},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3624":72906,"_31170":72789,"_21595":120848,"_5":14857,"_28362":120559,"_3076":120849},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3624":72907,"_31170":72789,"_21595":120851,"_5":14857,"_28362":120563,"_3076":120852},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3624":72908,"_31170":72789,"_21595":120854,"_5":14857,"_28362":120563,"_3076":120855},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3624":72909,"_31170":72789,"_21595":120857,"_5":14857,"_28362":120563,"_3076":120858},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3624":72910,"_31170":72789,"_21595":120860,"_5":14857,"_28362":120563,"_3076":120861},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3624":72911,"_31170":72789,"_21595":120863,"_5":14857,"_28362":120567,"_3076":120864},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3624":72912,"_31170":72912,"_5":15217,"_3076":120866,"_31528":120867,"_21595":120868,"_28362":72912},"Instala con Helm",[50937,120286,120520],[],{"_3624":72913,"_31170":72912,"_21595":120870,"_5":14857,"_28362":72912,"_3076":120871},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3624":72914,"_31170":72912,"_5":31525,"_21595":120873,"_28362":120874,"_3076":120875},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3624":72915,"_31170":72912,"_5":31525,"_21595":120877,"_28362":120878,"_3076":120536},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3624":72916,"_31170":72912,"_5":31525,"_21595":120880,"_28362":120881,"_3076":120882},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3624":72917,"_31170":72912,"_5":31525,"_21595":120884,"_28362":120885,"_3076":120886},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3624":72918,"_31170":72912,"_5":31525,"_21595":120888,"_28362":120889,"_3076":120890},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3624":72919,"_31170":72912,"_5":31525,"_21595":120892,"_28362":120893,"_3076":120894},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3624":72920,"_31170":72912,"_5":31525,"_21595":120896,"_28362":120897,"_3076":120898},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3624":72921,"_31170":72912,"_5":31525,"_21595":120900,"_28362":120901,"_3076":120902},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3624":72922,"_31170":72912,"_5":31525,"_21595":120904,"_28362":120905,"_3076":120906},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3624":72923,"_31170":72912,"_5":31525,"_21595":120908,"_28362":120909,"_3076":120910},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3624":72924,"_31170":72912,"_5":31525,"_21595":120912,"_28362":120913,"_3076":120914},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3624":72925,"_31170":72912,"_5":31525,"_21595":120916,"_28362":120917,"_3076":120918},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3624":72926,"_31170":72912,"_21595":120920,"_5":14857,"_28362":120874,"_3076":120921},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3624":72927,"_31170":72912,"_21595":120923,"_5":14857,"_28362":120878,"_3076":120924},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3624":72928,"_31170":72912,"_21595":120926,"_5":14857,"_28362":120878,"_3076":120927},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3624":72929,"_31170":72912,"_21595":120929,"_5":14857,"_28362":120878,"_3076":120930},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3624":72930,"_31170":72912,"_21595":120932,"_5":14857,"_28362":120878,"_3076":120933},[],"un broker RabbitMQ accesible y sus credenciales",{"_3624":72931,"_31170":72912,"_21595":120935,"_5":14857,"_28362":120878,"_3076":120936},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3624":72932,"_31170":72912,"_21595":120938,"_5":14857,"_28362":120878,"_3076":120939},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3624":72933,"_31170":72912,"_21595":120941,"_5":14857,"_28362":120878,"_3076":120942},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3624":72934,"_31170":72912,"_21595":120944,"_5":14857,"_28362":120878,"_3076":120945},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3624":72935,"_31170":72912,"_21595":120947,"_5":14857,"_28362":120878,"_3076":120948},[],"una StorageClass y un diseño de tráfico externo",{"_3624":72936,"_31170":72912,"_21595":120950,"_5":14857,"_28362":120878,"_3076":120951},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3624":72937,"_31170":72912,"_21595":120953,"_5":14857,"_28362":120878,"_3076":120954},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3624":72938,"_31170":72912,"_21595":120956,"_5":14857,"_28362":120878,"_3076":120957},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3624":72939,"_31170":72912,"_21595":120959,"_5":14857,"_28362":120881,"_3076":120960},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3624":72940,"_31170":72912,"_21595":120962,"_5":14857,"_28362":120881,"_3076":120963},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3624":72941,"_31170":72912,"_21595":120965,"_5":14857,"_28362":120881,"_3076":120966},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3624":72942,"_31170":72912,"_21595":120968,"_5":14857,"_28362":120885,"_3076":120969},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3624":72943,"_31170":72912,"_21595":120971,"_5":14857,"_28362":120885,"_3076":120972},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3624":72944,"_31170":72912,"_21595":120974,"_5":14857,"_28362":120885,"_3076":120975},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3624":72945,"_31170":72912,"_21595":120977,"_5":14857,"_28362":120885,"_3076":120978},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3624":72946,"_31170":72912,"_21595":120980,"_5":14857,"_28362":120889,"_3076":120981},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3624":72947,"_31170":72912,"_21595":120983,"_5":14857,"_28362":120889,"_3076":120984},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3624":72948,"_31170":72912,"_21595":120986,"_5":14857,"_28362":120889,"_3076":120987},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3624":72949,"_31170":72912,"_21595":120989,"_5":14857,"_28362":120889,"_3076":120990},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3624":72950,"_31170":72912,"_21595":120992,"_5":14857,"_28362":120889,"_3076":120993},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3624":72951,"_31170":72912,"_21595":120995,"_5":14857,"_28362":120889,"_3076":120996},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3624":72952,"_31170":72912,"_21595":120998,"_5":14857,"_28362":120889,"_3076":120999},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3624":72953,"_31170":72912,"_21595":121001,"_5":14857,"_28362":120889,"_3076":121002},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3624":72954,"_31170":72912,"_21595":121004,"_5":14857,"_28362":120893,"_3076":121005},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3624":72955,"_31170":72912,"_21595":121007,"_5":14857,"_28362":120897,"_3076":121008},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3624":72956,"_31170":72912,"_21595":121010,"_5":14857,"_28362":120897,"_3076":121011},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3624":72957,"_31170":72912,"_21595":121013,"_5":14857,"_28362":120897,"_3076":121014},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3624":72958,"_31170":72912,"_21595":121016,"_5":14857,"_28362":120897,"_3076":121017},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3624":72959,"_31170":72912,"_21595":121019,"_5":14857,"_28362":120897,"_3076":121020},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3624":72960,"_31170":72912,"_21595":121022,"_5":14857,"_28362":120897,"_3076":121023},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3624":72961,"_31170":72912,"_21595":121025,"_5":14857,"_28362":120897,"_3076":121026},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3624":72962,"_31170":72912,"_21595":121028,"_5":14857,"_28362":120901,"_3076":121029},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3624":72963,"_31170":72912,"_21595":121031,"_5":14857,"_28362":120901,"_3076":121032},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3624":72964,"_31170":72912,"_21595":121034,"_5":14857,"_28362":120901,"_3076":121035},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3624":72965,"_31170":72912,"_21595":121037,"_5":14857,"_28362":120901,"_3076":121038},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3624":72966,"_31170":72912,"_21595":121040,"_5":14857,"_28362":120905,"_3076":121041},[],"Para instalar un checkout local:",{"_3624":72967,"_31170":72912,"_21595":121043,"_5":14857,"_28362":120909,"_3076":121044},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3624":72968,"_31170":72912,"_21595":121046,"_5":14857,"_28362":120909,"_3076":121047},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3624":72969,"_31170":72912,"_21595":121049,"_5":14857,"_28362":120913,"_3076":121050},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3624":72970,"_31170":72912,"_21595":121052,"_5":14857,"_28362":120913,"_3076":121053},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3624":72971,"_31170":72912,"_21595":121055,"_5":14857,"_28362":120913,"_3076":121056},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3624":72972,"_31170":72912,"_21595":121058,"_5":14857,"_28362":120913,"_3076":121059},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3624":72973,"_31170":72912,"_21595":121061,"_5":14857,"_28362":120913,"_3076":121062},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3624":72974,"_31170":72912,"_21595":121064,"_5":14857,"_28362":120917,"_3076":121065},[],"Antes de pasar a producción, revisa:",{"_3624":72975,"_31170":72912,"_21595":121067,"_5":14857,"_28362":120917,"_3076":121068},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3624":72976,"_31170":72912,"_21595":121070,"_5":14857,"_28362":120917,"_3076":121071},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3624":72977,"_31170":72912,"_21595":121073,"_5":14857,"_28362":120917,"_3076":121074},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3624":72978,"_31170":72912,"_21595":121076,"_5":14857,"_28362":120917,"_3076":121077},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3624":72979,"_31170":72912,"_21595":121079,"_5":14857,"_28362":120917,"_3076":121080},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3624":72980,"_31170":72912,"_21595":121082,"_5":14857,"_28362":120917,"_3076":121083},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3624":72981,"_31170":72912,"_21595":121085,"_5":14857,"_28362":120917,"_3076":121086},[],"SMTP, observabilidad y entrega de alertas",{"_3624":72982,"_31170":72912,"_21595":121088,"_5":14857,"_28362":120917,"_3076":121089},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3624":72983,"_31170":72912,"_21595":121091,"_5":14857,"_28362":120917,"_3076":121092},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3624":72984,"_31170":72984,"_5":15217,"_3076":121094,"_31528":121095,"_21595":121096,"_28362":72984},"Expón el Gateway",[50937,120286,120520],[],{"_3624":72985,"_31170":72984,"_21595":121098,"_5":14857,"_28362":72984,"_3076":121099},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3624":72986,"_31170":72984,"_5":31525,"_21595":121101,"_28362":121102,"_3076":121103},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3624":72987,"_31170":72984,"_5":31525,"_21595":121105,"_28362":121106,"_3076":121107},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3624":72988,"_31170":72984,"_5":31525,"_21595":121109,"_28362":121110,"_3076":121111},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3624":72989,"_31170":72984,"_5":31525,"_21595":121113,"_28362":121114,"_3076":51800},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#k3s",{"_3624":72990,"_31170":72984,"_5":31525,"_21595":121116,"_28362":121117,"_3076":121118},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3624":72991,"_31170":72984,"_5":31525,"_21595":121120,"_28362":121121,"_3076":121122},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3624":72992,"_31170":72984,"_5":31525,"_21595":121124,"_28362":121125,"_3076":121126},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3624":72993,"_31170":72984,"_5":31525,"_21595":121128,"_28362":121129,"_3076":121130},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3624":72994,"_31170":72984,"_5":31525,"_21595":121132,"_28362":121133,"_3076":121134},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3624":72995,"_31170":72984,"_5":31525,"_21595":121136,"_28362":121137,"_3076":121138},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3624":72996,"_31170":72984,"_5":31525,"_21595":121140,"_28362":121141,"_3076":121142},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3624":72997,"_31170":72984,"_21595":121144,"_5":14857,"_28362":121102,"_3076":121145},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3624":72998,"_31170":72984,"_21595":121147,"_5":14857,"_28362":121102,"_3076":121148},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3624":72999,"_31170":72984,"_21595":121150,"_5":14857,"_28362":121106,"_3076":121151},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3624":73000,"_31170":72984,"_21595":121153,"_5":14857,"_28362":121106,"_3076":121154},[],"Defínelo únicamente cuando:",{"_3624":73001,"_31170":72984,"_21595":121156,"_5":14857,"_28362":121106,"_3076":121157},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3624":73002,"_31170":72984,"_21595":121159,"_5":14857,"_28362":121106,"_3076":121160},[],"esa dirección está asignada a este Gateway",{"_3624":73003,"_31170":72984,"_21595":121162,"_5":14857,"_28362":121106,"_3076":121163},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3624":73004,"_31170":72984,"_21595":121165,"_5":14857,"_28362":121106,"_3076":121166},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3624":73005,"_31170":72984,"_21595":121168,"_5":14857,"_28362":121106,"_3076":121169},[],"No confundas estos valores:",{"_3624":73006,"_31170":72984,"_21595":121171,"_5":14857,"_28362":121106,"_3076":121172},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3624":73007,"_31170":72984,"_21595":121174,"_5":14857,"_28362":121106,"_3076":121175},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3624":73008,"_31170":72984,"_21595":121177,"_5":14857,"_28362":121106,"_3076":121178},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3624":73009,"_31170":72984,"_21595":121180,"_5":14857,"_28362":121110,"_3076":121181},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3624":73010,"_31170":72984,"_21595":121183,"_5":14857,"_28362":121110,"_3076":121184},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3624":73011,"_31170":72984,"_21595":121186,"_5":14857,"_28362":121114,"_3076":121187},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3624":73012,"_31170":72984,"_21595":121189,"_5":14857,"_28362":121114,"_3076":121190},[],"Para el diseño recomendado:",{"_3624":73013,"_31170":72984,"_21595":121192,"_5":14857,"_28362":121114,"_3076":121193},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3624":73014,"_31170":72984,"_21595":121195,"_5":14857,"_28362":121114,"_3076":121196},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3624":73015,"_31170":72984,"_21595":121198,"_5":14857,"_28362":121114,"_3076":121199},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3624":73016,"_31170":72984,"_21595":121201,"_5":14857,"_28362":121114,"_3076":121202},[],"Apunta DNS a la dirección accesible de la VM.",{"_3624":73017,"_31170":72984,"_21595":121204,"_5":14857,"_28362":121114,"_3076":121205},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3624":73018,"_31170":72984,"_21595":121207,"_5":14857,"_28362":121117,"_3076":121208},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3624":73019,"_31170":72984,"_21595":121210,"_5":14857,"_28362":121121,"_3076":121211},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3624":73020,"_31170":72984,"_21595":121213,"_5":14857,"_28362":121121,"_3076":121214},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3624":73021,"_31170":72984,"_21595":121216,"_5":14857,"_28362":121125,"_3076":121217},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3624":73022,"_31170":72984,"_21595":121219,"_5":14857,"_28362":121125,"_3076":121220},[],"Requisito",{"_3624":73023,"_31170":72984,"_21595":121222,"_5":14857,"_28362":121125,"_3076":121223},[],"Diseño recomendado",{"_3624":73024,"_31170":72984,"_21595":121225,"_5":14857,"_28362":121125,"_3076":121226},[],"Consecuencia",{"_3624":73025,"_31170":72984,"_21595":121228,"_5":14857,"_28362":121125,"_3076":121229},[],"Varias URL o servicios de Lamassu",{"_3624":73026,"_31170":72984,"_21595":121231,"_5":14857,"_28362":121125,"_3076":121232},[],"Un Gateway con varias rutas",{"_3624":73027,"_31170":72984,"_21595":121234,"_5":14857,"_28362":121125,"_3076":121235},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3624":73028,"_31170":72984,"_21595":121237,"_5":14857,"_28362":121125,"_3076":121238},[],"Gateways independientes e IP externas distintas",{"_3624":73029,"_31170":72984,"_21595":121240,"_5":14857,"_28362":121125,"_3076":121241},[],"Una VIP por Gateway",{"_3624":73030,"_31170":72984,"_21595":121243,"_5":14857,"_28362":121125,"_3076":121244},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3624":73031,"_31170":72984,"_21595":121246,"_5":14857,"_28362":121125,"_3076":121247},[],"Gateways independientes, un nodo y una IP",{"_3624":73032,"_31170":72984,"_21595":121249,"_5":14857,"_28362":121125,"_3076":121250},[],"Puertos externos diferentes",{"_3624":73033,"_31170":72984,"_21595":121252,"_5":14857,"_28362":121125,"_3076":121253},[],"Los clientes deben indicar puertos no estándar",{"_3624":73034,"_31170":72984,"_21595":121255,"_5":14857,"_28362":121125,"_3076":121256},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3624":73035,"_31170":72984,"_21595":121258,"_5":14857,"_28362":121125,"_3076":121259},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3624":73036,"_31170":72984,"_21595":121261,"_5":14857,"_28362":121125,"_3076":121262},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3624":73037,"_31170":72984,"_21595":121264,"_5":14857,"_28362":121125,"_3076":121265},[],"Recursos Gateway separados pero proxy compartido",{"_3624":73038,"_31170":72984,"_21595":121267,"_5":14857,"_28362":121125,"_3076":121268},[],"Modo merged Gateway de Envoy",{"_3624":73039,"_31170":72984,"_21595":121270,"_5":14857,"_28362":121125,"_3076":121271},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3624":73040,"_31170":72984,"_21595":121273,"_5":14857,"_28362":121125,"_3076":121274},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3624":73041,"_31170":72984,"_21595":121276,"_5":14857,"_28362":121125,"_3076":121277},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3624":73042,"_31170":72984,"_21595":121279,"_5":14857,"_28362":121125,"_3076":121280},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3624":73043,"_31170":72984,"_21595":121282,"_5":14857,"_28362":121125,"_3076":121283},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3624":73044,"_31170":72984,"_21595":121285,"_5":14857,"_28362":121129,"_3076":121286},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3624":73045,"_31170":72984,"_21595":121288,"_5":14857,"_28362":121133,"_3076":121289},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3624":73046,"_31170":72984,"_21595":121291,"_5":14857,"_28362":121133,"_3076":121292},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3624":73047,"_31170":72984,"_21595":121294,"_5":14857,"_28362":121133,"_3076":121295},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3624":73048,"_31170":72984,"_21595":121297,"_5":14857,"_28362":121133,"_3076":121298},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3624":73049,"_31170":72984,"_21595":121300,"_5":14857,"_28362":121133,"_3076":121301},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3624":73050,"_31170":72984,"_21595":121303,"_5":14857,"_28362":121137,"_3076":121304},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3624":73051,"_31170":72984,"_21595":121306,"_5":14857,"_28362":121137,"_3076":121307},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3624":73052,"_31170":72984,"_21595":121309,"_5":14857,"_28362":121141,"_3076":121310},[],"Comprueba, en orden:",{"_3624":73053,"_31170":72984,"_21595":121312,"_5":14857,"_28362":121141,"_3076":121313},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3624":73054,"_31170":72984,"_21595":121315,"_5":14857,"_28362":121141,"_3076":121316},[],"Su estado contiene la dirección esperada.",{"_3624":73055,"_31170":72984,"_21595":121318,"_5":14857,"_28362":121141,"_3076":121319},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3624":73056,"_31170":72984,"_21595":121321,"_5":14857,"_28362":121141,"_3076":121322},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3624":73057,"_31170":72984,"_21595":121324,"_5":14857,"_28362":121141,"_3076":121325},[],"DNS resuelve al endpoint accesible externamente.",{"_3624":73058,"_31170":72984,"_21595":121327,"_5":14857,"_28362":121141,"_3076":121328},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3624":73059,"_31170":72984,"_21595":121330,"_5":14857,"_28362":121141,"_3076":121331},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3624":73060,"_31170":73060,"_5":15217,"_3076":51044,"_31528":121333,"_21595":121334,"_28362":73060},[50937,120286,120520],[],{"_3624":73061,"_31170":73060,"_21595":121336,"_5":14857,"_28362":73060,"_3076":121337},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3624":73062,"_31170":73060,"_5":31525,"_21595":121339,"_28362":121340,"_3076":121341},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3624":73063,"_31170":73060,"_5":31525,"_21595":121343,"_28362":121344,"_3076":121345},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3624":73064,"_31170":73060,"_5":31525,"_21595":121347,"_28362":121348,"_3076":121349},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3624":73065,"_31170":73060,"_5":31525,"_21595":121351,"_28362":121352,"_3076":121353},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3624":73066,"_31170":73060,"_5":31525,"_21595":121355,"_28362":121356,"_3076":121357},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3624":73067,"_31170":73060,"_5":31525,"_21595":121359,"_28362":121360,"_3076":121361},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3624":73068,"_31170":73060,"_21595":121363,"_5":14857,"_28362":121340,"_3076":121364},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3624":73069,"_31170":73060,"_21595":121366,"_5":14857,"_28362":121344,"_3076":121367},[],"Flujo",{"_3624":73070,"_31170":73060,"_21595":121369,"_5":14857,"_28362":121344,"_3076":121370},[],"Úsalo para",{"_3624":73071,"_31170":73060,"_21595":121372,"_5":14857,"_28362":121344,"_3076":121373},[],"Qué instala",{"_3624":73072,"_31170":73060,"_21595":121375,"_5":14857,"_28362":121344,"_3076":52062},[],{"_3624":73073,"_31170":73060,"_21595":121377,"_5":14857,"_28362":121344,"_3076":121378},[],"Producción y entornos controlados",{"_3624":73074,"_31170":73060,"_21595":121380,"_5":14857,"_28362":121344,"_3076":121381},[],"Servicios de Lamassu y recursos de Gateway API",{"_3624":73075,"_31170":73060,"_21595":121383,"_5":14857,"_28362":121344,"_3076":51181},[],{"_3624":73076,"_31170":73060,"_21595":121385,"_5":14857,"_28362":121344,"_3076":121386},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3624":73077,"_31170":73060,"_21595":121388,"_5":14857,"_28362":121344,"_3076":121389},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3624":73078,"_31170":73060,"_21595":121391,"_5":14857,"_28362":121348,"_3076":121392},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3624":73079,"_31170":73060,"_21595":121394,"_5":14857,"_28362":121348,"_3076":121395},[],"Área",{"_3624":73080,"_31170":73060,"_21595":121397,"_5":14857,"_28362":121348,"_3076":121398},[],"El chart de Lamassu proporciona",{"_3624":73081,"_31170":73060,"_21595":121400,"_5":14857,"_28362":121348,"_3076":121401},[],"Tú proporcionas",{"_3624":73082,"_31170":73060,"_21595":121403,"_5":14857,"_28362":121348,"_3076":121404},[],"Aplicaciones Lamassu",{"_3624":73083,"_31170":73060,"_21595":121406,"_5":14857,"_28362":121348,"_3076":121407},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3624":73084,"_31170":73060,"_21595":121409,"_5":14857,"_28362":121348,"_3076":121410},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3624":73085,"_31170":73060,"_21595":121412,"_5":14857,"_28362":121348,"_3076":121413},[],"Datos PostgreSQL",{"_3624":73086,"_31170":73060,"_21595":121415,"_5":14857,"_28362":121348,"_3076":121416},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3624":73087,"_31170":73060,"_21595":121418,"_5":14857,"_28362":121348,"_3076":121419},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3624":73088,"_31170":73060,"_21595":121421,"_5":14857,"_28362":121348,"_3076":121422},[],"Mensajería",{"_3624":73089,"_31170":73060,"_21595":121424,"_5":14857,"_28362":121348,"_3076":121425},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3624":73090,"_31170":73060,"_21595":121427,"_5":14857,"_28362":121348,"_3076":121428},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3624":73091,"_31170":73060,"_21595":121430,"_5":14857,"_28362":121348,"_3076":121431},[],"Identidad",{"_3624":73092,"_31170":73060,"_21595":121433,"_5":14857,"_28362":121348,"_3076":121434},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3624":73093,"_31170":73060,"_21595":121436,"_5":14857,"_28362":121348,"_3076":121437},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3624":73094,"_31170":73060,"_21595":121439,"_5":14857,"_28362":121348,"_3076":121440},[],"Enrutamiento externo",{"_3624":73095,"_31170":73060,"_21595":121442,"_5":14857,"_28362":121348,"_3076":121443},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3624":73096,"_31170":73060,"_21595":121445,"_5":14857,"_28362":121348,"_3076":121446},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3624":73097,"_31170":73060,"_21595":121448,"_5":14857,"_28362":121348,"_3076":52136},[],{"_3624":73098,"_31170":73060,"_21595":121450,"_5":14857,"_28362":121348,"_3076":121451},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3624":73099,"_31170":73060,"_21595":121453,"_5":14857,"_28362":121348,"_3076":121454},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3624":73100,"_31170":73060,"_21595":121456,"_5":14857,"_28362":121348,"_3076":121457},[],"Datos persistentes de la aplicación",{"_3624":73101,"_31170":73060,"_21595":121459,"_5":14857,"_28362":121348,"_3076":121460},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3624":73102,"_31170":73060,"_21595":121462,"_5":14857,"_28362":121348,"_3076":121463},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3624":73103,"_31170":73060,"_21595":121465,"_5":14857,"_28362":121348,"_3076":121466},[],"Integraciones opcionales",{"_3624":73104,"_31170":73060,"_21595":121468,"_5":14857,"_28362":121348,"_3076":121469},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3624":73105,"_31170":73060,"_21595":121471,"_5":14857,"_28362":121348,"_3076":121472},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3624":73106,"_31170":73060,"_21595":121474,"_5":14857,"_28362":121348,"_3076":121475},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3624":73107,"_31170":73060,"_21595":121477,"_5":14857,"_28362":121348,"_3076":121478},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3624":73108,"_31170":73060,"_21595":121480,"_5":14857,"_28362":121352,"_3076":121481},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3624":73109,"_31170":73060,"_21595":121483,"_5":14857,"_28362":121352,"_3076":121484},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3624":73110,"_31170":73060,"_21595":121486,"_5":14857,"_28362":121356,"_3076":121487},[],"Kubernetes 1.24 o posterior",{"_3624":73111,"_31170":73060,"_21595":121489,"_5":14857,"_28362":121356,"_3076":121490},[],"Helm 3.2 o posterior",{"_3624":73112,"_31170":73060,"_21595":121492,"_5":14857,"_28362":121356,"_3076":121493},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3624":73113,"_31170":73060,"_21595":121495,"_5":14857,"_28362":121356,"_3076":121496},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3624":73114,"_31170":73060,"_21595":121498,"_5":14857,"_28362":121356,"_3076":121499},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3624":73115,"_31170":73060,"_21595":121501,"_5":14857,"_28362":121356,"_3076":121502},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3624":73116,"_31170":73060,"_21595":121504,"_5":14857,"_28362":121356,"_3076":121505},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3624":73117,"_31170":73060,"_21595":121507,"_5":14857,"_28362":121360,"_3076":121508},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3624":73118,"_31170":73060,"_21595":121510,"_5":14857,"_28362":121360,"_3076":121511},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3624":73119,"_31170":73060,"_21595":121513,"_5":14857,"_28362":121360,"_3076":121514},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3624":73120,"_31170":73060,"_21595":121516,"_5":14857,"_28362":121360,"_3076":121517},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3624":73121,"_31170":73121,"_5":15217,"_3076":121519,"_31528":121520,"_21595":121522,"_28362":73121},"Resolución de problemas de despliegue",[50937,120286,121521],"Operación",[],{"_3624":73122,"_31170":73121,"_21595":121524,"_5":14857,"_28362":73121,"_3076":121525},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3624":73123,"_31170":73121,"_5":31525,"_21595":121527,"_28362":121528,"_3076":121529},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3624":73124,"_31170":73121,"_5":31525,"_21595":121531,"_28362":121532,"_3076":121533},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3624":73125,"_31170":73121,"_5":31525,"_21595":121535,"_28362":121536,"_3076":121537},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3624":73126,"_31170":73121,"_5":31525,"_21595":121539,"_28362":121540,"_3076":121541},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3624":73127,"_31170":73121,"_5":31525,"_21595":121543,"_28362":121544,"_3076":121545},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3624":73128,"_31170":73121,"_5":31525,"_21595":121547,"_28362":121548,"_3076":121549},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3624":73129,"_31170":73121,"_5":31525,"_21595":121551,"_28362":121552,"_3076":121553},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3624":73130,"_31170":73121,"_5":31525,"_21595":121555,"_28362":121556,"_3076":121557},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3624":73131,"_31170":73121,"_5":31525,"_21595":121559,"_28362":121560,"_3076":121561},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3624":73132,"_31170":73121,"_5":31525,"_21595":121563,"_28362":121564,"_3076":121565},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3624":73133,"_31170":73121,"_5":31525,"_21595":121567,"_28362":121568,"_3076":121569},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3624":73134,"_31170":73121,"_5":31525,"_21595":121571,"_28362":121572,"_3076":121573},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3624":73135,"_31170":73121,"_5":31525,"_21595":121575,"_28362":121576,"_3076":121577},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3624":73136,"_31170":73121,"_21595":121579,"_5":14857,"_28362":73121,"_3076":121580},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3624":73137,"_31170":73121,"_21595":121582,"_5":14857,"_28362":121532,"_3076":121583},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3624":73138,"_31170":73121,"_21595":121585,"_5":14857,"_28362":121536,"_3076":121586},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3624":73139,"_31170":73121,"_21595":121588,"_5":14857,"_28362":121540,"_3076":121589},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3624":73140,"_31170":73121,"_21595":121591,"_5":14857,"_28362":121544,"_3076":121592},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3624":73141,"_31170":73121,"_21595":121594,"_5":14857,"_28362":121548,"_3076":121595},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3624":73142,"_31170":73121,"_21595":121597,"_5":14857,"_28362":121552,"_3076":121598},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3624":73143,"_31170":73121,"_21595":121600,"_5":14857,"_28362":121552,"_3076":121601},[],"Ejecuta también la prueba de conectividad del chart:",{"_3624":73144,"_31170":73121,"_21595":121603,"_5":14857,"_28362":121552,"_3076":121604},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3624":73145,"_31170":73121,"_21595":121606,"_5":14857,"_28362":121552,"_3076":121607},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3624":73146,"_31170":73121,"_21595":121609,"_5":14857,"_28362":121556,"_3076":121610},[],"Si recibes un 401:",{"_3624":73147,"_31170":73121,"_21595":121612,"_5":14857,"_28362":121556,"_3076":121613},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3624":73148,"_31170":73121,"_21595":121615,"_5":14857,"_28362":121556,"_3076":121616},[],"verifica emisor, audiencia y expiración del token;",{"_3624":73149,"_31170":73121,"_21595":121618,"_5":14857,"_28362":121556,"_3076":121619},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3624":73150,"_31170":73121,"_21595":121621,"_5":14857,"_28362":121556,"_3076":121622},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3624":73151,"_31170":73121,"_21595":121624,"_5":14857,"_28362":121556,"_3076":121625},[],"Si el login termina pero las APIs devuelven 403:",{"_3624":73152,"_31170":73121,"_21595":121627,"_5":14857,"_28362":121556,"_3076":121628},[],"inspecciona los claims reales del token;",{"_3624":73153,"_31170":73121,"_21595":121630,"_5":14857,"_28362":121556,"_3076":121631},[],"confirma que coinciden con un principal activo;",{"_3624":73154,"_31170":73121,"_21595":121633,"_5":14857,"_28362":121556,"_3076":121634},[],"revisa las políticas concedidas al principal;",{"_3624":73155,"_31170":73121,"_21595":121636,"_5":14857,"_28362":121556,"_3076":121637},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3624":73156,"_31170":73121,"_21595":121639,"_5":14857,"_28362":121556,"_3076":121640},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3624":73157,"_31170":73121,"_21595":121642,"_5":14857,"_28362":121560,"_3076":121643},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3624":73158,"_31170":73121,"_21595":121645,"_5":14857,"_28362":121560,"_3076":121646},[],"Localiza el pod y Service de authz.",{"_3624":73159,"_31170":73121,"_21595":121648,"_5":14857,"_28362":121560,"_3076":121649},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3624":73160,"_31170":73121,"_21595":121651,"_5":14857,"_28362":121560,"_3076":121652},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3624":73161,"_31170":73121,"_21595":121654,"_5":14857,"_28362":121560,"_3076":121655},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3624":73162,"_31170":73121,"_21595":121657,"_5":14857,"_28362":121560,"_3076":121658},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3624":73163,"_31170":73121,"_21595":121660,"_5":14857,"_28362":121564,"_3076":121661},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3624":73164,"_31170":73121,"_21595":121663,"_5":14857,"_28362":121568,"_3076":121664},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3624":73165,"_31170":73121,"_21595":121666,"_5":14857,"_28362":121568,"_3076":121667},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3624":73166,"_31170":73121,"_21595":121669,"_5":14857,"_28362":121568,"_3076":121670},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3624":73167,"_31170":73121,"_21595":121672,"_5":14857,"_28362":121568,"_3076":121673},[],"volumen persistente sin enlazar;",{"_3624":73168,"_31170":73121,"_21595":121675,"_5":14857,"_28362":121568,"_3076":121676},[],"imagen inaccesible o política de pull incorrecta;",{"_3624":73169,"_31170":73121,"_21595":121678,"_5":14857,"_28362":121568,"_3076":121679},[],"configuración inválida del motor criptográfico;",{"_3624":73170,"_31170":73121,"_21595":121681,"_5":14857,"_28362":121568,"_3076":121682},[],"límites de CPU o memoria demasiado bajos;",{"_3624":73171,"_31170":73121,"_21595":121684,"_5":14857,"_28362":121568,"_3076":121685},[],"migración previa incompleta.",{"_3624":73172,"_31170":73121,"_21595":121687,"_5":14857,"_28362":121568,"_3076":121688},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3624":73173,"_31170":73121,"_21595":121690,"_5":14857,"_28362":121568,"_3076":121691},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3624":73174,"_31170":73121,"_21595":121693,"_5":14857,"_28362":121568,"_3076":121694},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3624":73175,"_31170":73121,"_21595":121696,"_5":14857,"_28362":121572,"_3076":121697},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3624":73176,"_31170":73121,"_21595":121699,"_5":14857,"_28362":121572,"_3076":121700},[],"verifica que esté habilitado en el servicio emisor;",{"_3624":73177,"_31170":73121,"_21595":121702,"_5":14857,"_28362":121572,"_3076":121703},[],"comprueba conectividad y credenciales AMQP;",{"_3624":73178,"_31170":73121,"_21595":121705,"_5":14857,"_28362":121572,"_3076":121706},[],"revisa exchange, routing key, colas y consumidores;",{"_3624":73179,"_31170":73121,"_21595":121708,"_5":14857,"_28362":121572,"_3076":121709},[],"inspecciona dead-letter queues;",{"_3624":73180,"_31170":73121,"_21595":121711,"_5":14857,"_28362":121572,"_3076":121712},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3624":73181,"_31170":73121,"_21595":121714,"_5":14857,"_28362":121572,"_3076":121715},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3624":73182,"_31170":73121,"_21595":121717,"_5":14857,"_28362":121572,"_3076":121718},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3624":73183,"_31170":73121,"_21595":121720,"_5":14857,"_28362":121572,"_3076":121721},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3624":73184,"_31170":73121,"_21595":121723,"_5":14857,"_28362":121572,"_3076":121724},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3624":73185,"_31170":73121,"_21595":121726,"_5":14857,"_28362":121572,"_3076":121727},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3624":73186,"_31170":73121,"_21595":121729,"_5":14857,"_28362":121572,"_3076":121730},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3624":73187,"_31170":73121,"_21595":121732,"_5":14857,"_28362":121572,"_3076":121733},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3624":73188,"_31170":73121,"_21595":121735,"_5":14857,"_28362":121576,"_3076":121736},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3624":73189,"_31170":73121,"_21595":121738,"_5":14857,"_28362":121576,"_3076":121739},[],"Antes de cerrar una incidencia, guarda:",{"_3624":73190,"_31170":73121,"_21595":121741,"_5":14857,"_28362":121576,"_3076":121742},[],"causa confirmada;",{"_3624":73191,"_31170":73121,"_21595":121744,"_5":14857,"_28362":121576,"_3076":121745},[],"alcance temporal y recursos afectados;",{"_3624":73192,"_31170":73121,"_21595":121747,"_5":14857,"_28362":121576,"_3076":121748},[],"comandos o consultas utilizados;",{"_3624":73193,"_31170":73121,"_21595":121750,"_5":14857,"_28362":121576,"_3076":121751},[],"cambio aplicado y forma de revertirlo;",{"_3624":73194,"_31170":73121,"_21595":121753,"_5":14857,"_28362":121576,"_3076":121754},[],"validación desde un consumidor;",{"_3624":73195,"_31170":73121,"_21595":121756,"_5":14857,"_28362":121576,"_3076":121757},[],"acción preventiva y propietario.",{"_3624":73196,"_31170":73196,"_5":15217,"_3076":121759,"_31528":121760,"_21595":121764,"_28362":73196},"Modelo de datos",[50937,121761,121762,121763],"Plataforma","Administración","Control de acceso",[],{"_3624":73197,"_31170":73196,"_21595":121766,"_5":14857,"_28362":73196,"_3076":121767},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3624":73198,"_31170":73196,"_5":31525,"_21595":121769,"_28362":121770,"_3076":121771},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3624":73199,"_31170":73196,"_5":31525,"_21595":121773,"_28362":121774,"_3076":121775},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3624":73200,"_31170":73196,"_21595":121777,"_5":14857,"_28362":73196,"_3076":121778},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3624":73201,"_31170":73196,"_21595":121780,"_5":14857,"_28362":121770,"_3076":121781},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3624":73202,"_31170":73196,"_21595":121783,"_5":14857,"_28362":121770,"_3076":121784},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3624":73203,"_31170":73196,"_21595":121786,"_5":14857,"_28362":121770,"_3076":121787},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3624":73204,"_31170":73196,"_21595":121789,"_5":14857,"_28362":121774,"_3076":121790},[],"Entidad (`schema_name.entity_type`)",{"_3624":73205,"_31170":73196,"_21595":121792,"_5":14857,"_28362":121774,"_3076":121793},[],"Tabla (`table_name`)",{"_3624":73206,"_31170":73196,"_21595":121795,"_5":14857,"_28362":121774,"_3076":121796},[],"Clave (`primary_key`)",{"_3624":73207,"_31170":73196,"_21595":121798,"_5":14857,"_28362":121774,"_3076":52487},[],{"_3624":73208,"_31170":73196,"_21595":121800,"_5":14857,"_28362":121774,"_3076":52490},[],{"_3624":73209,"_31170":73196,"_21595":121802,"_5":14857,"_28362":121774,"_3076":52493},[],{"_3624":73210,"_31170":73196,"_21595":121804,"_5":14857,"_28362":121774,"_3076":52496},[],{"_3624":73211,"_31170":73196,"_21595":121806,"_5":14857,"_28362":121774,"_3076":52499},[],{"_3624":73212,"_31170":73196,"_21595":121808,"_5":14857,"_28362":121774,"_3076":52502},[],{"_3624":73213,"_31170":73196,"_21595":121810,"_5":14857,"_28362":121774,"_3076":52505},[],{"_3624":73214,"_31170":73196,"_21595":121812,"_5":14857,"_28362":121774,"_3076":52508},[],{"_3624":73215,"_31170":73196,"_21595":121814,"_5":14857,"_28362":121774,"_3076":52502},[],{"_3624":73216,"_31170":73196,"_21595":121816,"_5":14857,"_28362":121774,"_3076":52513},[],{"_3624":73217,"_31170":73196,"_21595":121818,"_5":14857,"_28362":121774,"_3076":52516},[],{"_3624":73218,"_31170":73196,"_21595":121820,"_5":14857,"_28362":121774,"_3076":52519},[],{"_3624":73219,"_31170":73196,"_21595":121822,"_5":14857,"_28362":121774,"_3076":52522},[],{"_3624":73220,"_31170":73196,"_21595":121824,"_5":14857,"_28362":121774,"_3076":52525},[],{"_3624":73221,"_31170":73196,"_21595":121826,"_5":14857,"_28362":121774,"_3076":52502},[],{"_3624":73222,"_31170":73196,"_21595":121828,"_5":14857,"_28362":121774,"_3076":52530},[],{"_3624":73223,"_31170":73196,"_21595":121830,"_5":14857,"_28362":121774,"_3076":52533},[],{"_3624":73224,"_31170":73196,"_21595":121832,"_5":14857,"_28362":121774,"_3076":52502},[],{"_3624":73225,"_31170":73196,"_21595":121834,"_5":14857,"_28362":121774,"_3076":52538},[],{"_3624":73226,"_31170":73196,"_21595":121836,"_5":14857,"_28362":121774,"_3076":52541},[],{"_3624":73227,"_31170":73196,"_21595":121838,"_5":14857,"_28362":121774,"_3076":52502},[],{"_3624":73228,"_31170":73196,"_21595":121840,"_5":14857,"_28362":121774,"_3076":52546},[],{"_3624":73229,"_31170":73196,"_21595":121842,"_5":14857,"_28362":121774,"_3076":52549},[],{"_3624":73230,"_31170":73196,"_21595":121844,"_5":14857,"_28362":121774,"_3076":52502},[],{"_3624":73231,"_31170":73196,"_21595":121846,"_5":14857,"_28362":121774,"_3076":52554},[],{"_3624":73232,"_31170":73196,"_21595":121848,"_5":14857,"_28362":121774,"_3076":52557},[],{"_3624":73233,"_31170":73196,"_21595":121850,"_5":14857,"_28362":121774,"_3076":52560},[],{"_3624":73234,"_31170":73196,"_21595":121852,"_5":14857,"_28362":121774,"_3076":52563},[],{"_3624":73235,"_31170":73196,"_21595":121854,"_5":14857,"_28362":121774,"_3076":52566},[],{"_3624":73236,"_31170":73196,"_21595":121856,"_5":14857,"_28362":121774,"_3076":52569},[],{"_3624":73237,"_31170":73196,"_21595":121858,"_5":14857,"_28362":121774,"_3076":121859},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3624":73238,"_31170":73196,"_21595":121861,"_5":14857,"_28362":121774,"_3076":121862},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3624":73239,"_31170":73196,"_21595":121864,"_5":14857,"_28362":121774,"_3076":121865},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3624":73240,"_31170":73240,"_5":15217,"_3076":121867,"_31528":121868,"_21595":121869,"_28362":73240},"Visión general del control de acceso",[50937,121761,121762,121763],[],{"_3624":73241,"_31170":73240,"_21595":121871,"_5":14857,"_28362":73240,"_3076":121872},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3624":73242,"_31170":73240,"_5":31525,"_21595":121874,"_28362":121875,"_3076":121876},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3624":73243,"_31170":73240,"_5":31525,"_21595":121878,"_28362":121879,"_3076":121880},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3624":73244,"_31170":73240,"_5":31525,"_21595":121882,"_28362":121883,"_3076":121884},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3624":73245,"_31170":73240,"_5":31525,"_21595":121886,"_28362":121887,"_3076":121888},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3624":73246,"_31170":73240,"_5":31525,"_21595":121890,"_28362":121891,"_3076":121892},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3624":73247,"_31170":73240,"_5":31525,"_21595":121894,"_28362":121895,"_3076":121896},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3624":73248,"_31170":73240,"_5":31525,"_21595":121898,"_28362":121899,"_3076":121900},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3624":73249,"_31170":73240,"_5":31525,"_21595":121902,"_28362":121903,"_3076":121904},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3624":73250,"_31170":73240,"_5":31525,"_21595":121906,"_28362":121907,"_3076":121908},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3624":73251,"_31170":73240,"_5":31525,"_21595":121910,"_28362":121911,"_3076":121912},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3624":73252,"_31170":73240,"_5":31525,"_21595":121914,"_28362":121915,"_3076":121916},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3624":73253,"_31170":73240,"_5":31525,"_21595":121918,"_28362":121919,"_3076":121920},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3624":73254,"_31170":73240,"_5":31525,"_21595":121922,"_28362":121923,"_3076":121924},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3624":73255,"_31170":73240,"_5":31525,"_21595":121926,"_28362":121927,"_3076":121928},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3624":73256,"_31170":73240,"_5":31525,"_21595":121930,"_28362":121931,"_3076":121932},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3624":73257,"_31170":73240,"_5":31525,"_21595":121934,"_28362":121935,"_3076":120902},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3624":73258,"_31170":73240,"_5":31525,"_21595":121937,"_28362":121938,"_3076":121939},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3624":73259,"_31170":73240,"_5":31525,"_21595":121941,"_28362":121942,"_3076":121943},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3624":73260,"_31170":73240,"_5":31525,"_21595":121945,"_28362":121946,"_3076":121947},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3624":73261,"_31170":73240,"_5":31525,"_21595":121949,"_28362":121950,"_3076":121951},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3624":73262,"_31170":73240,"_5":31525,"_21595":121953,"_28362":121954,"_3076":121955},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3624":73263,"_31170":73240,"_5":31525,"_21595":121957,"_28362":121958,"_3076":121959},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3624":73264,"_31170":73240,"_5":31525,"_21595":121961,"_28362":121962,"_3076":121963},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3624":73265,"_31170":73240,"_5":31525,"_21595":121965,"_28362":121966,"_3076":121967},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3624":73266,"_31170":73240,"_5":31525,"_21595":121969,"_28362":121970,"_3076":121971},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3624":73267,"_31170":73240,"_5":31525,"_21595":121973,"_28362":121974,"_3076":121975},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3624":73268,"_31170":73240,"_5":31525,"_21595":121977,"_28362":121978,"_3076":121979},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3624":73269,"_31170":73240,"_5":31525,"_21595":121981,"_28362":121982,"_3076":121983},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3624":73270,"_31170":73240,"_5":31525,"_21595":121985,"_28362":121986,"_3076":121987},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3624":73271,"_31170":73240,"_5":31525,"_21595":121989,"_28362":121990,"_3076":121991},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3624":73272,"_31170":73240,"_5":31525,"_21595":121993,"_28362":121994,"_3076":121995},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3624":73273,"_31170":73240,"_21595":121997,"_5":14857,"_28362":73240,"_3076":121998},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3624":73274,"_31170":73240,"_21595":122000,"_5":14857,"_28362":73240,"_3076":122001},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3624":73275,"_31170":73240,"_21595":122003,"_5":14857,"_28362":73240,"_3076":122004},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3624":73276,"_31170":73240,"_21595":122006,"_5":14857,"_28362":121875,"_3076":122007},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3624":73277,"_31170":73240,"_21595":122009,"_5":14857,"_28362":121875,"_3076":122010},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3624":73278,"_31170":73240,"_21595":122012,"_5":14857,"_28362":121875,"_3076":122013},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3624":73279,"_31170":73240,"_21595":122015,"_5":14857,"_28362":121875,"_3076":122016},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3624":73280,"_31170":73240,"_21595":122018,"_5":14857,"_28362":121875,"_3076":122019},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3624":73281,"_31170":73240,"_21595":122021,"_5":14857,"_28362":121875,"_3076":122022},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3624":73282,"_31170":73240,"_21595":122024,"_5":14857,"_28362":121879,"_3076":122025},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3624":73283,"_31170":73240,"_21595":122027,"_5":14857,"_28362":121879,"_3076":122028},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3624":73284,"_31170":73240,"_21595":122030,"_5":14857,"_28362":121883,"_3076":122031},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3624":73285,"_31170":73240,"_21595":122033,"_5":14857,"_28362":121883,"_3076":122034},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3624":73286,"_31170":73240,"_21595":122036,"_5":14857,"_28362":121883,"_3076":122037},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3624":73287,"_31170":73240,"_21595":122039,"_5":14857,"_28362":121883,"_3076":122040},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3624":73288,"_31170":73240,"_21595":122042,"_5":14857,"_28362":121883,"_3076":122043},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3624":73289,"_31170":73240,"_21595":122045,"_5":14857,"_28362":121883,"_3076":122046},[],"Carga por separado las políticas concedidas a cada principal.",{"_3624":73290,"_31170":73240,"_21595":122048,"_5":14857,"_28362":121883,"_3076":122049},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3624":73291,"_31170":73240,"_21595":122051,"_5":14857,"_28362":121883,"_3076":122052},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3624":73292,"_31170":73240,"_21595":122054,"_5":14857,"_28362":121883,"_3076":122055},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3624":73293,"_31170":73240,"_21595":122057,"_5":14857,"_28362":121883,"_3076":122058},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3624":73294,"_31170":73240,"_21595":122060,"_5":14857,"_28362":121883,"_3076":122061},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3624":73295,"_31170":73240,"_21595":122063,"_5":14857,"_28362":121883,"_3076":122064},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3624":73296,"_31170":73240,"_21595":122066,"_5":14857,"_28362":121887,"_3076":122067},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3624":73297,"_31170":73240,"_21595":122069,"_5":14857,"_28362":121887,"_3076":122070},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3624":73298,"_31170":73240,"_21595":122072,"_5":14857,"_28362":121887,"_3076":122073},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3624":73299,"_31170":73240,"_21595":122075,"_5":14857,"_28362":121887,"_3076":122076},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3624":73300,"_31170":73240,"_21595":122078,"_5":14857,"_28362":121887,"_3076":122079},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3624":73301,"_31170":73240,"_21595":122081,"_5":14857,"_28362":121887,"_3076":122082},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3624":73302,"_31170":73240,"_21595":122084,"_5":14857,"_28362":121887,"_3076":122085},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3624":73303,"_31170":73240,"_21595":122087,"_5":14857,"_28362":121887,"_3076":122088},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3624":73304,"_31170":73240,"_21595":122090,"_5":14857,"_28362":121887,"_3076":122091},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3624":73305,"_31170":73240,"_21595":122093,"_5":14857,"_28362":121887,"_3076":122094},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3624":73306,"_31170":73240,"_21595":122096,"_5":14857,"_28362":121891,"_3076":122097},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3624":73307,"_31170":73240,"_21595":122099,"_5":14857,"_28362":121891,"_3076":122100},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3624":73308,"_31170":73240,"_21595":122102,"_5":14857,"_28362":121891,"_3076":122103},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3624":73309,"_31170":73240,"_21595":122105,"_5":14857,"_28362":121891,"_3076":122106},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3624":73310,"_31170":73240,"_21595":122108,"_5":14857,"_28362":121891,"_3076":122109},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3624":73311,"_31170":73240,"_21595":122111,"_5":14857,"_28362":121891,"_3076":122112},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3624":73312,"_31170":73240,"_21595":122114,"_5":14857,"_28362":121891,"_3076":122115},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3624":73313,"_31170":73240,"_21595":122117,"_5":14857,"_28362":121891,"_3076":122118},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3624":73314,"_31170":73240,"_21595":122120,"_5":14857,"_28362":121891,"_3076":122121},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3624":73315,"_31170":73240,"_21595":122123,"_5":14857,"_28362":121891,"_3076":122124},[],"Las acciones se dividen en dos grupos:",{"_3624":73316,"_31170":73240,"_21595":122126,"_5":14857,"_28362":121891,"_3076":122127},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3624":73317,"_31170":73240,"_21595":122129,"_5":14857,"_28362":121891,"_3076":122130},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3624":73318,"_31170":73240,"_21595":122132,"_5":14857,"_28362":121891,"_3076":122133},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3624":73319,"_31170":73240,"_21595":122135,"_5":14857,"_28362":121895,"_3076":122136},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3624":73320,"_31170":73240,"_21595":122138,"_5":14857,"_28362":121895,"_3076":122139},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3624":73321,"_31170":73240,"_21595":122141,"_5":14857,"_28362":121895,"_3076":122142},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3624":73322,"_31170":73240,"_21595":122144,"_5":14857,"_28362":121899,"_3076":122145},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3624":73323,"_31170":73240,"_21595":122147,"_5":14857,"_28362":121899,"_3076":122148},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3624":73324,"_31170":73240,"_21595":122150,"_5":14857,"_28362":121899,"_3076":122151},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3624":73325,"_31170":73240,"_21595":122153,"_5":14857,"_28362":121899,"_3076":122154},[],"Los operadores implementados son:",{"_3624":73326,"_31170":73240,"_21595":122156,"_5":14857,"_28362":121899,"_3076":122157},[],"`equals`, para igualdad exacta;",{"_3624":73327,"_31170":73240,"_21595":122159,"_5":14857,"_28362":121899,"_3076":122160},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3624":73328,"_31170":73240,"_21595":122162,"_5":14857,"_28362":121899,"_3076":122163},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3624":73329,"_31170":73240,"_21595":122165,"_5":14857,"_28362":121899,"_3076":122166},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3624":73330,"_31170":73240,"_21595":122168,"_5":14857,"_28362":121903,"_3076":122169},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3624":73331,"_31170":73240,"_21595":122171,"_5":14857,"_28362":121903,"_3076":122172},[],"Los modos disponibles son:",{"_3624":73332,"_31170":73240,"_21595":122174,"_5":14857,"_28362":121903,"_3076":122175},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3624":73333,"_31170":73240,"_21595":122177,"_5":14857,"_28362":121903,"_3076":122178},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3624":73334,"_31170":73240,"_21595":122180,"_5":14857,"_28362":121903,"_3076":122181},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3624":73335,"_31170":73240,"_21595":122183,"_5":14857,"_28362":121903,"_3076":122184},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3624":73336,"_31170":73240,"_21595":122186,"_5":14857,"_28362":121903,"_3076":122187},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3624":73337,"_31170":73240,"_21595":122189,"_5":14857,"_28362":121903,"_3076":122190},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3624":73338,"_31170":73240,"_21595":122192,"_5":14857,"_28362":121907,"_3076":122193},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3624":73339,"_31170":73240,"_21595":122195,"_5":14857,"_28362":121907,"_3076":122196},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3624":73340,"_31170":73240,"_21595":122198,"_5":14857,"_28362":121907,"_3076":122199},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3624":73341,"_31170":73240,"_21595":122201,"_5":14857,"_28362":121907,"_3076":122202},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3624":73342,"_31170":73240,"_21595":122204,"_5":14857,"_28362":121915,"_3076":122205},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3624":73343,"_31170":73240,"_21595":122207,"_5":14857,"_28362":121915,"_3076":122208},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3624":73344,"_31170":73240,"_21595":122210,"_5":14857,"_28362":121919,"_3076":122211},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3624":73345,"_31170":73240,"_21595":122213,"_5":14857,"_28362":121919,"_3076":122214},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3624":73346,"_31170":73240,"_21595":122216,"_5":14857,"_28362":121919,"_3076":122217},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3624":73347,"_31170":73240,"_21595":122219,"_5":14857,"_28362":121919,"_3076":122220},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3624":73348,"_31170":73240,"_21595":122222,"_5":14857,"_28362":121919,"_3076":122223},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3624":73349,"_31170":73240,"_21595":122225,"_5":14857,"_28362":121923,"_3076":122226},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3624":73350,"_31170":73240,"_21595":122228,"_5":14857,"_28362":121923,"_3076":122229},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3624":73351,"_31170":73240,"_21595":122231,"_5":14857,"_28362":121923,"_3076":122232},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3624":73352,"_31170":73240,"_21595":122234,"_5":14857,"_28362":121927,"_3076":122235},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3624":73353,"_31170":73240,"_21595":122237,"_5":14857,"_28362":121927,"_3076":122238},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3624":73354,"_31170":73240,"_21595":122240,"_5":14857,"_28362":121927,"_3076":122241},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3624":73355,"_31170":73240,"_21595":122243,"_5":14857,"_28362":121927,"_3076":122244},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3624":73356,"_31170":73240,"_21595":122246,"_5":14857,"_28362":121927,"_3076":122247},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3624":73357,"_31170":73240,"_21595":122249,"_5":14857,"_28362":121927,"_3076":122250},[],"Ten en cuenta que:",{"_3624":73358,"_31170":73240,"_21595":122252,"_5":14857,"_28362":121927,"_3076":122253},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3624":73359,"_31170":73240,"_21595":122255,"_5":14857,"_28362":121927,"_3076":122256},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3624":73360,"_31170":73240,"_21595":122258,"_5":14857,"_28362":121927,"_3076":122259},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3624":73361,"_31170":73240,"_21595":122261,"_5":14857,"_28362":121931,"_3076":122262},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3624":73362,"_31170":73240,"_21595":122264,"_5":14857,"_28362":121931,"_3076":122265},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3624":73363,"_31170":73240,"_21595":122267,"_5":14857,"_28362":121931,"_3076":122268},[],"acceso completo y de solo lectura a KMS;",{"_3624":73364,"_31170":73240,"_21595":122270,"_5":14857,"_28362":121931,"_3076":122271},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3624":73365,"_31170":73240,"_21595":122273,"_5":14857,"_28362":121931,"_3076":122274},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3624":73366,"_31170":73240,"_21595":122276,"_5":14857,"_28362":121931,"_3076":122277},[],"acceso a la interfaz;",{"_3624":73367,"_31170":73240,"_21595":122279,"_5":14857,"_28362":121931,"_3076":122280},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3624":73368,"_31170":73240,"_21595":122282,"_5":14857,"_28362":121931,"_3076":122283},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3624":73369,"_31170":73240,"_21595":122285,"_5":14857,"_28362":121931,"_3076":122286},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3624":73370,"_31170":73240,"_21595":122288,"_5":14857,"_28362":121931,"_3076":122289},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3624":73371,"_31170":73240,"_21595":122291,"_5":14857,"_28362":121931,"_3076":122292},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3624":73372,"_31170":73240,"_21595":122294,"_5":14857,"_28362":121935,"_3076":122295},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3624":73373,"_31170":73240,"_21595":122297,"_5":14857,"_28362":121935,"_3076":122298},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3624":73374,"_31170":73240,"_21595":122300,"_5":14857,"_28362":121935,"_3076":122301},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3624":73375,"_31170":73240,"_21595":122303,"_5":14857,"_28362":121938,"_3076":122304},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3624":73376,"_31170":73240,"_21595":122306,"_5":14857,"_28362":121942,"_3076":122307},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3624":73377,"_31170":73240,"_21595":122309,"_5":14857,"_28362":121942,"_3076":122310},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3624":73378,"_31170":73240,"_21595":122312,"_5":14857,"_28362":121946,"_3076":122313},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3624":73379,"_31170":73240,"_21595":122315,"_5":14857,"_28362":121950,"_3076":122316},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3624":73380,"_31170":73240,"_21595":122318,"_5":14857,"_28362":121954,"_3076":122319},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3624":73381,"_31170":73240,"_21595":122321,"_5":14857,"_28362":121958,"_3076":122322},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3624":73382,"_31170":73240,"_21595":122324,"_5":14857,"_28362":121958,"_3076":122325},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3624":73383,"_31170":73240,"_21595":122327,"_5":14857,"_28362":121962,"_3076":122328},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3624":73384,"_31170":73240,"_21595":122330,"_5":14857,"_28362":121962,"_3076":122331},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3624":73385,"_31170":73240,"_21595":122333,"_5":14857,"_28362":121962,"_3076":122334},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3624":73386,"_31170":73240,"_21595":122336,"_5":14857,"_28362":121962,"_3076":122337},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3624":73387,"_31170":73240,"_21595":122339,"_5":14857,"_28362":121962,"_3076":122340},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3624":73388,"_31170":73240,"_21595":122342,"_5":14857,"_28362":121962,"_3076":122343},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3624":73389,"_31170":73240,"_21595":122345,"_5":14857,"_28362":121962,"_3076":122346},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3624":73390,"_31170":73240,"_21595":122348,"_5":14857,"_28362":121962,"_3076":122349},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3624":73391,"_31170":73240,"_21595":122351,"_5":14857,"_28362":121966,"_3076":122352},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3624":73392,"_31170":73240,"_21595":122354,"_5":14857,"_28362":121966,"_3076":122355},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3624":73393,"_31170":73240,"_21595":122357,"_5":14857,"_28362":121966,"_3076":122358},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3624":73394,"_31170":73240,"_21595":122360,"_5":14857,"_28362":121970,"_3076":122361},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3624":73395,"_31170":73240,"_21595":122363,"_5":14857,"_28362":121970,"_3076":122364},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3624":73396,"_31170":73240,"_21595":122366,"_5":14857,"_28362":121970,"_3076":122367},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3624":73397,"_31170":73240,"_21595":122369,"_5":14857,"_28362":121970,"_3076":122370},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3624":73398,"_31170":73240,"_21595":122372,"_5":14857,"_28362":121970,"_3076":122373},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3624":73399,"_31170":73240,"_21595":122375,"_5":14857,"_28362":121970,"_3076":122376},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3624":73400,"_31170":73240,"_21595":122378,"_5":14857,"_28362":121970,"_3076":122379},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3624":73401,"_31170":73240,"_21595":122381,"_5":14857,"_28362":121970,"_3076":122382},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3624":73402,"_31170":73240,"_21595":122384,"_5":14857,"_28362":121978,"_3076":122385},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3624":73403,"_31170":73240,"_21595":122387,"_5":14857,"_28362":121982,"_3076":122388},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3624":73404,"_31170":73240,"_21595":122390,"_5":14857,"_28362":121982,"_3076":122391},[],"que exista un principal activo del tipo correcto;",{"_3624":73405,"_31170":73240,"_21595":122393,"_5":14857,"_28362":121982,"_3076":122394},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3624":73406,"_31170":73240,"_21595":122396,"_5":14857,"_28362":121982,"_3076":122397},[],"que todas las condiciones del principal se cumplan;",{"_3624":73407,"_31170":73240,"_21595":122399,"_5":14857,"_28362":121982,"_3076":122400},[],"que el principal tenga concedida la política esperada;",{"_3624":73408,"_31170":73240,"_21595":122402,"_5":14857,"_28362":121982,"_3076":122403},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3624":73409,"_31170":73240,"_21595":122405,"_5":14857,"_28362":121982,"_3076":122406},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3624":73410,"_31170":73240,"_21595":122408,"_5":14857,"_28362":121982,"_3076":122409},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3624":73411,"_31170":73240,"_21595":122411,"_5":14857,"_28362":121982,"_3076":122412},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3624":73412,"_31170":73240,"_21595":122414,"_5":14857,"_28362":121986,"_3076":122415},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3624":73413,"_31170":73240,"_21595":122417,"_5":14857,"_28362":121990,"_3076":122418},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3624":73414,"_31170":73240,"_21595":122420,"_5":14857,"_28362":121994,"_3076":122421},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3624":73415,"_31170":73240,"_21595":122423,"_5":14857,"_28362":121994,"_3076":122424},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3624":73416,"_31170":73416,"_5":15217,"_3076":122426,"_31528":122427,"_21595":122428,"_28362":73416},"Alertas y suscripciones",[50937,121761,121762],[],{"_3624":73417,"_31170":73416,"_21595":122430,"_5":14857,"_28362":73416,"_3076":122431},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3624":73418,"_31170":73416,"_5":31525,"_21595":122433,"_28362":122434,"_3076":122435},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3624":73419,"_31170":73416,"_5":31525,"_21595":122437,"_28362":122438,"_3076":122439},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3624":73420,"_31170":73416,"_5":31525,"_21595":122441,"_28362":122442,"_3076":122443},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3624":73421,"_31170":73416,"_5":31525,"_21595":122445,"_28362":122446,"_3076":122447},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3624":73422,"_31170":73416,"_5":31525,"_21595":122449,"_28362":122450,"_3076":122451},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3624":73423,"_31170":73416,"_5":31525,"_21595":122453,"_28362":122454,"_3076":122455},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3624":73424,"_31170":73416,"_5":31525,"_21595":122457,"_28362":122458,"_3076":122459},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3624":73425,"_31170":73416,"_5":31525,"_21595":122461,"_28362":122462,"_3076":122463},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3624":73426,"_31170":73416,"_5":31525,"_21595":122465,"_28362":122466,"_3076":122467},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3624":73427,"_31170":73416,"_5":31525,"_21595":122469,"_28362":122470,"_3076":122471},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3624":73428,"_31170":73416,"_5":31525,"_21595":122473,"_28362":122474,"_3076":122475},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3624":73429,"_31170":73416,"_21595":122477,"_5":14857,"_28362":73416,"_3076":122478},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3624":73430,"_31170":73416,"_21595":122480,"_5":14857,"_28362":122434,"_3076":122481},[],"Un servicio publica un evento de dominio.",{"_3624":73431,"_31170":73416,"_21595":122483,"_5":14857,"_28362":122434,"_3076":122484},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3624":73432,"_31170":73416,"_21595":122486,"_5":14857,"_28362":122434,"_3076":122487},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3624":73433,"_31170":73416,"_21595":122489,"_5":14857,"_28362":122434,"_3076":122490},[],"Lamassu entrega el evento al canal configurado.",{"_3624":73434,"_31170":73416,"_21595":122492,"_5":14857,"_28362":122434,"_3076":122493},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3624":73435,"_31170":73416,"_21595":122495,"_5":14857,"_28362":122438,"_3076":122496},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3624":73436,"_31170":73416,"_21595":122498,"_5":14857,"_28362":122438,"_3076":122499},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3624":73437,"_31170":73416,"_21595":122501,"_5":14857,"_28362":122438,"_3076":122502},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3624":73438,"_31170":73416,"_21595":122504,"_5":14857,"_28362":122438,"_3076":122505},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3624":73439,"_31170":73416,"_21595":122507,"_5":14857,"_28362":122438,"_3076":122508},[],"`apikey_options` necesita `header` y `key`.",{"_3624":73440,"_31170":73416,"_21595":122510,"_5":14857,"_28362":122438,"_3076":122511},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3624":73441,"_31170":73416,"_21595":122513,"_5":14857,"_28362":122438,"_3076":122514},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3624":73442,"_31170":73416,"_21595":122516,"_5":14857,"_28362":122438,"_3076":122517},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3624":73443,"_31170":73416,"_21595":122519,"_5":14857,"_28362":122446,"_3076":122520},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3624":73444,"_31170":73416,"_21595":122522,"_5":14857,"_28362":122450,"_3076":122523},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3624":73445,"_31170":73416,"_21595":122525,"_5":14857,"_28362":122454,"_3076":122526},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3624":73446,"_31170":73416,"_21595":122528,"_5":14857,"_28362":122454,"_3076":122529},[],"**None** notifica todas las instancias del evento.",{"_3624":73447,"_31170":73416,"_21595":122531,"_5":14857,"_28362":122454,"_3076":122532},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3624":73448,"_31170":73416,"_21595":122534,"_5":14857,"_28362":122454,"_3076":122535},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3624":73449,"_31170":73416,"_21595":122537,"_5":14857,"_28362":122454,"_3076":122538},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3624":73450,"_31170":73416,"_21595":122540,"_5":14857,"_28362":122454,"_3076":122541},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3624":73451,"_31170":73416,"_21595":122543,"_5":14857,"_28362":122454,"_3076":122544},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3624":73452,"_31170":73416,"_21595":122546,"_5":14857,"_28362":122458,"_3076":122547},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3624":73453,"_31170":73416,"_21595":122549,"_5":14857,"_28362":122462,"_3076":122550},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3624":73454,"_31170":73416,"_21595":122552,"_5":14857,"_28362":122462,"_3076":122553},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3624":73455,"_31170":73416,"_21595":122555,"_5":14857,"_28362":122462,"_3076":122556},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3624":73456,"_31170":73416,"_21595":122558,"_5":14857,"_28362":122462,"_3076":122559},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3624":73457,"_31170":73416,"_21595":122561,"_5":14857,"_28362":122462,"_3076":122562},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3624":73458,"_31170":73416,"_21595":122564,"_5":14857,"_28362":122462,"_3076":122565},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3624":73459,"_31170":73416,"_21595":122567,"_5":14857,"_28362":122462,"_3076":122568},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3624":73460,"_31170":73416,"_21595":122570,"_5":14857,"_28362":122462,"_3076":122571},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3624":73461,"_31170":73416,"_21595":122573,"_5":14857,"_28362":122466,"_3076":122574},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3624":73462,"_31170":73416,"_21595":122576,"_5":14857,"_28362":122466,"_3076":122577},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3624":73463,"_31170":73416,"_21595":122579,"_5":14857,"_28362":122466,"_3076":122580},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3624":73464,"_31170":73416,"_21595":122582,"_5":14857,"_28362":122466,"_3076":122583},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3624":73465,"_31170":73416,"_21595":122585,"_5":14857,"_28362":122466,"_3076":122586},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3624":73466,"_31170":73416,"_21595":122588,"_5":14857,"_28362":122466,"_3076":122589},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3624":73467,"_31170":73416,"_21595":122591,"_5":14857,"_28362":122466,"_3076":122592},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3624":73468,"_31170":73416,"_21595":122594,"_5":14857,"_28362":122466,"_3076":122595},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3624":73469,"_31170":73416,"_21595":122597,"_5":14857,"_28362":122470,"_3076":122598},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3624":73470,"_31170":73416,"_21595":122600,"_5":14857,"_28362":122470,"_3076":122601},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3624":73471,"_31170":73416,"_21595":122603,"_5":14857,"_28362":122474,"_3076":122604},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3624":73472,"_31170":73416,"_21595":122606,"_5":14857,"_28362":122474,"_3076":122607},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3624":73473,"_31170":73416,"_21595":122609,"_5":14857,"_28362":122474,"_3076":122610},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3624":73474,"_31170":73416,"_21595":122612,"_5":14857,"_28362":122474,"_3076":122613},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3624":73475,"_31170":73416,"_21595":122615,"_5":14857,"_28362":122474,"_3076":122616},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3624":73476,"_31170":73416,"_21595":122618,"_5":14857,"_28362":122474,"_3076":122619},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3624":73477,"_31170":73416,"_21595":122621,"_5":14857,"_28362":122474,"_3076":122622},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3624":73478,"_31170":73416,"_21595":122624,"_5":14857,"_28362":122474,"_3076":122625},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3624":73479,"_31170":73416,"_21595":122627,"_5":14857,"_28362":122474,"_3076":122628},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3624":73480,"_31170":73416,"_21595":122630,"_5":14857,"_28362":122474,"_3076":122631},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3624":73481,"_31170":73481,"_5":15217,"_3076":122633,"_31528":122634,"_21595":122635,"_28362":73481},"Registros de auditoría",[50937,121761,121762],[],{"_3624":73482,"_31170":73481,"_21595":122637,"_5":14857,"_28362":73481,"_3076":122638},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3624":73483,"_31170":73481,"_5":31525,"_21595":122640,"_28362":122641,"_3076":122642},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3624":73484,"_31170":73481,"_5":31525,"_21595":122644,"_28362":122645,"_3076":122646},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3624":73485,"_31170":73481,"_5":31525,"_21595":122648,"_28362":122649,"_3076":122650},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3624":73486,"_31170":73481,"_5":31525,"_21595":122652,"_28362":122653,"_3076":122654},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3624":73487,"_31170":73481,"_5":31525,"_21595":122656,"_28362":122657,"_3076":122658},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3624":73488,"_31170":73481,"_5":31525,"_21595":122660,"_28362":122661,"_3076":122662},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3624":73489,"_31170":73481,"_5":31525,"_21595":122664,"_28362":122665,"_3076":122666},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3624":73490,"_31170":73481,"_5":31525,"_21595":122668,"_28362":122669,"_3076":122670},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3624":73491,"_31170":73481,"_5":31525,"_21595":122672,"_28362":122673,"_3076":122674},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3624":73492,"_31170":73481,"_5":31525,"_21595":122676,"_28362":122677,"_3076":122678},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3624":73493,"_31170":73481,"_5":31525,"_21595":122680,"_28362":122681,"_3076":122682},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3624":73494,"_31170":73481,"_21595":122684,"_5":14857,"_28362":73481,"_3076":122685},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3624":73495,"_31170":73481,"_21595":122687,"_5":14857,"_28362":122641,"_3076":122688},[],"El cuerpo de auditoría incluye:",{"_3624":73496,"_31170":73481,"_21595":122690,"_5":14857,"_28362":122641,"_3076":122691},[],"input: datos recibidos por la operación;",{"_3624":73497,"_31170":73481,"_21595":122693,"_5":14857,"_28362":122641,"_3076":122694},[],"has\\_error: indica si el servicio devolvió un error;",{"_3624":73498,"_31170":73481,"_21595":122696,"_5":14857,"_28362":122641,"_3076":122697},[],"output: resultado producido o mensaje de error;",{"_3624":73499,"_31170":73481,"_21595":122699,"_5":14857,"_28362":122641,"_3076":122700},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3624":73500,"_31170":73481,"_21595":122702,"_5":14857,"_28362":122641,"_3076":122703},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3624":73501,"_31170":73481,"_21595":122705,"_5":14857,"_28362":122641,"_3076":122706},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3624":73502,"_31170":73481,"_21595":122708,"_5":14857,"_28362":122645,"_3076":122709},[],"El backend aplica auditoría a mutaciones de:",{"_3624":73503,"_31170":73481,"_21595":122711,"_5":14857,"_28362":122645,"_3076":122712},[],"autoridades, certificados y perfiles de emisión;",{"_3624":73504,"_31170":73481,"_21595":122714,"_5":14857,"_28362":122645,"_3076":122715},[],"claves y motores KMS;",{"_3624":73505,"_31170":73481,"_21595":122717,"_5":14857,"_28362":122645,"_3076":122718},[],"dispositivos e identidades;",{"_3624":73506,"_31170":73481,"_21595":122720,"_5":14857,"_28362":122645,"_3076":122721},[],"DMS y operaciones de enrolamiento;",{"_3624":73507,"_31170":73481,"_21595":122723,"_5":14857,"_28362":122645,"_3076":122724},[],"funciones de validación y CRL;",{"_3624":73508,"_31170":73481,"_21595":122726,"_5":14857,"_28362":122645,"_3076":122727},[],"principales, políticas y concesiones de autorización.",{"_3624":73509,"_31170":73481,"_21595":122729,"_5":14857,"_28362":122645,"_3076":122730},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3624":73510,"_31170":73481,"_21595":122732,"_5":14857,"_28362":122649,"_3076":122733},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3624":73511,"_31170":73481,"_21595":122735,"_5":14857,"_28362":122649,"_3076":122736},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3624":73512,"_31170":73481,"_21595":122738,"_5":14857,"_28362":122649,"_3076":122739},[],"Diseña el consumidor para:",{"_3624":73513,"_31170":73481,"_21595":122741,"_5":14857,"_28362":122649,"_3076":122742},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3624":73514,"_31170":73481,"_21595":122744,"_5":14857,"_28362":122649,"_3076":122745},[],"conservar el CloudEvent completo sin modificar;",{"_3624":73515,"_31170":73481,"_21595":122747,"_5":14857,"_28362":122649,"_3076":122748},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3624":73516,"_31170":73481,"_21595":122750,"_5":14857,"_28362":122649,"_3076":122751},[],"cifrar en tránsito y en reposo;",{"_3624":73517,"_31170":73481,"_21595":122753,"_5":14857,"_28362":122649,"_3076":122754},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3624":73518,"_31170":73481,"_21595":122756,"_5":14857,"_28362":122649,"_3076":122757},[],"aplicar una política explícita de retención y legal hold;",{"_3624":73519,"_31170":73481,"_21595":122759,"_5":14857,"_28362":122649,"_3076":122760},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3624":73520,"_31170":73481,"_21595":122762,"_5":14857,"_28362":122653,"_3076":122763},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3624":73521,"_31170":73481,"_21595":122765,"_5":14857,"_28362":122653,"_3076":122766},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3624":73522,"_31170":73481,"_21595":122768,"_5":14857,"_28362":122661,"_3076":122769},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3624":73523,"_31170":73481,"_21595":122771,"_5":14857,"_28362":122665,"_3076":122772},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3624":73524,"_31170":73481,"_21595":122774,"_5":14857,"_28362":122669,"_3076":122775},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3624":73525,"_31170":73481,"_21595":122777,"_5":14857,"_28362":122673,"_3076":122778},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3624":73526,"_31170":73481,"_21595":122780,"_5":14857,"_28362":122677,"_3076":122781},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3624":73527,"_31170":73481,"_21595":122783,"_5":14857,"_28362":122681,"_3076":122784},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3624":73528,"_31170":73481,"_21595":122786,"_5":14857,"_28362":122681,"_3076":122787},[],"aparece un evento de auditoría correcto;",{"_3624":73529,"_31170":73481,"_21595":122789,"_5":14857,"_28362":122681,"_3076":122790},[],"el principal coincide con la identidad utilizada;",{"_3624":73530,"_31170":73481,"_21595":122792,"_5":14857,"_28362":122681,"_3076":122793},[],"el consumidor lo persiste una sola vez;",{"_3624":73531,"_31170":73481,"_21595":122795,"_5":14857,"_28362":122681,"_3076":122796},[],"puede recuperarse por recurso, actor y periodo;",{"_3624":73532,"_31170":73481,"_21595":122798,"_5":14857,"_28362":122681,"_3076":122799},[],"una interrupción del consumidor produce una alerta.",{"_3624":73533,"_31170":73481,"_21595":122801,"_5":14857,"_28362":122681,"_3076":122802},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3624":73534,"_31170":73534,"_5":15217,"_3076":122804,"_31528":122805,"_21595":122806,"_28362":73534},"Arquitectura de la plataforma",[50937,121761],[],{"_3624":73535,"_31170":73534,"_21595":122808,"_5":14857,"_28362":73534,"_3076":122809},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3624":73536,"_31170":73534,"_5":31525,"_21595":122811,"_28362":122812,"_3076":122813},[],"/docs/pr-preview/pr-76/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3624":73537,"_31170":73534,"_5":31525,"_21595":122815,"_28362":122816,"_3076":122817},[],"/docs/pr-preview/pr-76/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3624":73538,"_31170":73534,"_5":31525,"_21595":122819,"_28362":122820,"_3076":122821},[],"/docs/pr-preview/pr-76/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3624":73539,"_31170":73534,"_5":31525,"_21595":122823,"_28362":122824,"_3076":122825},[],"/docs/pr-preview/pr-76/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3624":73540,"_31170":73534,"_5":31525,"_21595":122827,"_28362":122828,"_3076":122829},[],"/docs/pr-preview/pr-76/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3624":73541,"_31170":73534,"_21595":122831,"_5":14857,"_28362":73534,"_3076":122832},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3624":73542,"_31170":73534,"_21595":122834,"_5":14857,"_28362":73534,"_3076":122835},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3624":73543,"_31170":73534,"_21595":122837,"_5":14857,"_28362":122812,"_3076":122838},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3624":73544,"_31170":73534,"_21595":122840,"_5":14857,"_28362":122816,"_3076":122841},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3624":73545,"_31170":73534,"_21595":122843,"_5":14857,"_28362":122820,"_3076":122844},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3624":73546,"_31170":73534,"_21595":122846,"_5":14857,"_28362":122824,"_3076":122847},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3624":73547,"_31170":73534,"_21595":122849,"_5":14857,"_28362":122828,"_3076":122850},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3624":73548,"_31170":73548,"_5":15217,"_3076":122852,"_31528":122853,"_21595":122854,"_28362":73548},"Cómo funciona Lamassu",[50937,121761],[],{"_3624":73549,"_31170":73548,"_21595":122856,"_5":14857,"_28362":73548,"_3076":122857},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3624":73550,"_31170":73548,"_5":31525,"_21595":122859,"_28362":122860,"_3076":122861},[],"/docs/pr-preview/pr-76/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3624":73551,"_31170":73548,"_5":31525,"_21595":122863,"_28362":122864,"_3076":122865},[],"/docs/pr-preview/pr-76/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3624":73552,"_31170":73548,"_21595":122867,"_5":14857,"_28362":73548,"_3076":122868},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3624":73553,"_31170":73548,"_21595":122870,"_5":14857,"_28362":122860,"_3076":122871},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3624":73554,"_31170":73548,"_21595":122873,"_5":14857,"_28362":122860,"_3076":122874},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3624":73555,"_31170":73548,"_21595":122876,"_5":14857,"_28362":122860,"_3076":122877},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3624":73556,"_31170":73548,"_21595":122879,"_5":14857,"_28362":122860,"_3076":122880},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3624":73557,"_31170":73548,"_21595":122882,"_5":14857,"_28362":122860,"_3076":122883},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3624":73558,"_31170":73548,"_21595":122885,"_5":14857,"_28362":122864,"_3076":122886},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3624":73559,"_31170":73548,"_21595":122888,"_5":14857,"_28362":122864,"_3076":122889},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3624":73560,"_31170":73548,"_21595":122891,"_5":14857,"_28362":122864,"_3076":122892},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3624":73561,"_31170":73548,"_21595":122894,"_5":14857,"_28362":122864,"_3076":122895},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3624":73562,"_31170":73548,"_21595":122897,"_5":14857,"_28362":122864,"_3076":122898},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3624":73563,"_31170":73548,"_21595":122900,"_5":14857,"_28362":122864,"_3076":122901},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3624":73564,"_31170":73548,"_21595":122903,"_5":14857,"_28362":122864,"_3076":122904},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3624":73565,"_31170":73565,"_5":15217,"_3076":122906,"_31528":122907,"_21595":122908,"_28362":73565},"Dispositivos e identidades",[50937,121761,53621,122906],[],{"_3624":73566,"_31170":73565,"_21595":122910,"_5":14857,"_28362":73565,"_3076":122911},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3624":73567,"_31170":73565,"_5":31525,"_21595":122913,"_28362":122914,"_3076":122915},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3624":73568,"_31170":73565,"_5":31525,"_21595":122917,"_28362":122918,"_3076":122919},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3624":73569,"_31170":73565,"_5":31525,"_21595":122921,"_28362":122922,"_3076":122923},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3624":73570,"_31170":73565,"_5":31525,"_21595":122925,"_28362":122926,"_3076":122927},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3624":73571,"_31170":73565,"_5":31525,"_21595":122929,"_28362":122930,"_3076":122931},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3624":73572,"_31170":73565,"_5":31525,"_21595":122933,"_28362":122934,"_3076":122935},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3624":73573,"_31170":73565,"_5":31525,"_21595":122937,"_28362":122938,"_3076":122939},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3624":73574,"_31170":73565,"_5":31525,"_21595":122941,"_28362":122942,"_3076":122943},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3624":73575,"_31170":73565,"_5":31525,"_21595":122945,"_28362":122946,"_3076":122947},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3624":73576,"_31170":73565,"_5":31525,"_21595":122949,"_28362":122950,"_3076":122951},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3624":73577,"_31170":73565,"_5":31525,"_21595":122953,"_28362":122954,"_3076":122955},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3624":73578,"_31170":73565,"_21595":122957,"_5":14857,"_28362":73565,"_3076":122958},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3624":73579,"_31170":73565,"_21595":122960,"_5":14857,"_28362":73565,"_3076":122961},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3624":73580,"_31170":73565,"_21595":122963,"_5":14857,"_28362":122914,"_3076":122964},[],"Vista operativa",{"_3624":73581,"_31170":73565,"_21595":122966,"_5":14857,"_28362":122914,"_3076":122967},[],"Interpretación",{"_3624":73582,"_31170":73565,"_21595":122969,"_5":14857,"_28362":122914,"_3076":53684},[],{"_3624":73583,"_31170":73565,"_21595":122971,"_5":14857,"_28362":122914,"_3076":122972},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3624":73584,"_31170":73565,"_21595":122974,"_5":14857,"_28362":122914,"_3076":53690},[],{"_3624":73585,"_31170":73565,"_21595":122976,"_5":14857,"_28362":122914,"_3076":122977},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3624":73586,"_31170":73565,"_21595":122979,"_5":14857,"_28362":122914,"_3076":53696},[],{"_3624":73587,"_31170":73565,"_21595":122981,"_5":14857,"_28362":122914,"_3076":122982},[],"La identidad está en la ventana operativa de renovación.",{"_3624":73588,"_31170":73565,"_21595":122984,"_5":14857,"_28362":122914,"_3076":53702},[],{"_3624":73589,"_31170":73565,"_21595":122986,"_5":14857,"_28362":122914,"_3076":122987},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3624":73590,"_31170":73565,"_21595":122989,"_5":14857,"_28362":122914,"_3076":53708},[],{"_3624":73591,"_31170":73565,"_21595":122991,"_5":14857,"_28362":122914,"_3076":122992},[],"La identidad ha vencido.",{"_3624":73592,"_31170":73565,"_21595":122994,"_5":14857,"_28362":122914,"_3076":53714},[],{"_3624":73593,"_31170":73565,"_21595":122996,"_5":14857,"_28362":122914,"_3076":122997},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3624":73594,"_31170":73565,"_21595":122999,"_5":14857,"_28362":122914,"_3076":53720},[],{"_3624":73595,"_31170":73565,"_21595":123001,"_5":14857,"_28362":122914,"_3076":123002},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3624":73596,"_31170":73565,"_21595":123004,"_5":14857,"_28362":122914,"_3076":123005},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3624":73597,"_31170":73565,"_21595":123007,"_5":14857,"_28362":122918,"_3076":123008},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3624":73598,"_31170":73565,"_21595":123010,"_5":14857,"_28362":122918,"_3076":123011},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3624":73599,"_31170":73565,"_21595":123013,"_5":14857,"_28362":122918,"_3076":123014},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3624":73600,"_31170":73565,"_21595":123016,"_5":14857,"_28362":122918,"_3076":123017},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3624":73601,"_31170":73565,"_21595":123019,"_5":14857,"_28362":122922,"_3076":123020},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3624":73602,"_31170":73565,"_21595":123022,"_5":14857,"_28362":122926,"_3076":123023},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3624":73603,"_31170":73565,"_21595":123025,"_5":14857,"_28362":122930,"_3076":123026},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3624":73604,"_31170":73565,"_21595":123028,"_5":14857,"_28362":122934,"_3076":123029},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3624":73605,"_31170":73565,"_21595":123031,"_5":14857,"_28362":122938,"_3076":123032},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3624":73606,"_31170":73565,"_21595":123034,"_5":14857,"_28362":122938,"_3076":123035},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3624":73607,"_31170":73565,"_21595":123037,"_5":14857,"_28362":122942,"_3076":123038},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3624":73608,"_31170":73565,"_21595":123040,"_5":14857,"_28362":122942,"_3076":123041},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3624":73609,"_31170":73565,"_21595":123043,"_5":14857,"_28362":122942,"_3076":123044},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3624":73610,"_31170":73565,"_21595":123046,"_5":14857,"_28362":122942,"_3076":123047},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3624":73611,"_31170":73565,"_21595":123049,"_5":14857,"_28362":122942,"_3076":123050},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3624":73612,"_31170":73565,"_21595":123052,"_5":14857,"_28362":122942,"_3076":123053},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3624":73613,"_31170":73565,"_21595":123055,"_5":14857,"_28362":122946,"_3076":123056},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3624":73614,"_31170":73565,"_21595":123058,"_5":14857,"_28362":122946,"_3076":123059},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3624":73615,"_31170":73565,"_21595":123061,"_5":14857,"_28362":122946,"_3076":123062},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3624":73616,"_31170":73565,"_21595":123064,"_5":14857,"_28362":122950,"_3076":123065},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3624":73617,"_31170":73565,"_21595":123067,"_5":14857,"_28362":122950,"_3076":123068},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3624":73618,"_31170":73565,"_21595":123070,"_5":14857,"_28362":122950,"_3076":123071},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3624":73619,"_31170":73565,"_21595":123073,"_5":14857,"_28362":122950,"_3076":123074},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3624":73620,"_31170":73565,"_21595":123076,"_5":14857,"_28362":122954,"_3076":123077},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3624":73621,"_31170":73565,"_21595":123079,"_5":14857,"_28362":122954,"_3076":123080},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3624":73622,"_31170":73622,"_5":15217,"_3076":123082,"_31528":123083,"_21595":123085,"_28362":73622},"Identidad inicial y autenticación",[50937,121761,53621,122906,123084],"Enrolamiento con PKI",[],{"_3624":73623,"_31170":73622,"_21595":123087,"_5":14857,"_28362":73622,"_3076":123088},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3624":73624,"_31170":73622,"_5":31525,"_21595":123090,"_28362":123091,"_3076":123092},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3624":73625,"_31170":73622,"_5":31525,"_21595":123094,"_28362":123095,"_3076":123096},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3624":73626,"_31170":73622,"_5":31525,"_21595":123098,"_28362":123099,"_3076":123100},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3624":73627,"_31170":73622,"_5":31525,"_21595":123102,"_28362":123103,"_3076":123104},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3624":73628,"_31170":73622,"_5":31525,"_21595":123106,"_28362":123107,"_3076":123108},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3624":73629,"_31170":73622,"_21595":123110,"_5":14857,"_28362":73622,"_3076":123111},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3624":73630,"_31170":73622,"_21595":123113,"_5":14857,"_28362":123091,"_3076":123114},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3624":73631,"_31170":73622,"_21595":123116,"_5":14857,"_28362":123091,"_3076":123117},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3624":73632,"_31170":73622,"_21595":123119,"_5":14857,"_28362":123095,"_3076":123120},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3624":73633,"_31170":73622,"_21595":123122,"_5":14857,"_28362":123095,"_3076":123123},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3624":73634,"_31170":73622,"_21595":123125,"_5":14857,"_28362":123095,"_3076":123126},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3624":73635,"_31170":73622,"_21595":123128,"_5":14857,"_28362":123099,"_3076":123129},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3624":73636,"_31170":73622,"_21595":123131,"_5":14857,"_28362":123099,"_3076":123132},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3624":73637,"_31170":73622,"_21595":123134,"_5":14857,"_28362":123103,"_3076":123135},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3624":73638,"_31170":73622,"_21595":123137,"_5":14857,"_28362":123103,"_3076":123138},[],"Ejemplo de cuerpo:",{"_3624":73639,"_31170":73622,"_21595":123140,"_5":14857,"_28362":123103,"_3076":123141},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3624":73640,"_31170":73622,"_21595":123143,"_5":14857,"_28362":123103,"_3076":123144},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3624":73641,"_31170":73622,"_21595":123146,"_5":14857,"_28362":123103,"_3076":123147},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3624":73642,"_31170":73622,"_21595":123149,"_5":14857,"_28362":123103,"_3076":123150},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3624":73643,"_31170":73622,"_21595":123152,"_5":14857,"_28362":123107,"_3076":123153},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3624":73644,"_31170":73622,"_21595":123155,"_5":14857,"_28362":123107,"_3076":123156},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3624":73645,"_31170":73622,"_21595":123158,"_5":14857,"_28362":123107,"_3076":123159},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3624":73646,"_31170":73622,"_21595":123161,"_5":14857,"_28362":123107,"_3076":123162},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3624":73647,"_31170":73647,"_5":15217,"_3076":123164,"_31528":123165,"_21595":123166,"_28362":73647},"Configura y opera el DMS",[50937,121761,53621,122906,123084],[],{"_3624":73648,"_31170":73647,"_21595":123168,"_5":14857,"_28362":73647,"_3076":123169},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3624":73649,"_31170":73647,"_5":31525,"_21595":123171,"_28362":123172,"_3076":120295},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3624":73650,"_31170":73647,"_5":31525,"_21595":123174,"_28362":123175,"_3076":123176},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3624":73651,"_31170":73647,"_5":31525,"_21595":123178,"_28362":123179,"_3076":123180},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3624":73652,"_31170":73647,"_5":31525,"_21595":123182,"_28362":123183,"_3076":123184},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3624":73653,"_31170":73647,"_5":31525,"_21595":123186,"_28362":123187,"_3076":123188},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3624":73654,"_31170":73647,"_5":31525,"_21595":123190,"_28362":123191,"_3076":123192},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3624":73655,"_31170":73647,"_5":31525,"_21595":123194,"_28362":123195,"_3076":123196},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3624":73656,"_31170":73647,"_5":31525,"_21595":123198,"_28362":123199,"_3076":123200},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3624":73657,"_31170":73647,"_5":31525,"_21595":123202,"_28362":123203,"_3076":53925},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3624":73658,"_31170":73647,"_5":31525,"_21595":123205,"_28362":123206,"_3076":53929},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3624":73659,"_31170":73647,"_5":31525,"_21595":123208,"_28362":123209,"_3076":123210},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3624":73660,"_31170":73647,"_5":31525,"_21595":123212,"_28362":123213,"_3076":123214},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3624":73661,"_31170":73647,"_5":31525,"_21595":123216,"_28362":123217,"_3076":123218},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3624":73662,"_31170":73647,"_5":31525,"_21595":123220,"_28362":123221,"_3076":123222},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3624":73663,"_31170":73647,"_5":31525,"_21595":123224,"_28362":123225,"_3076":53949},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3624":73664,"_31170":73647,"_5":31525,"_21595":123227,"_28362":123228,"_3076":123229},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3624":73665,"_31170":73647,"_5":31525,"_21595":123231,"_28362":123232,"_3076":123233},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3624":73666,"_31170":73647,"_5":31525,"_21595":123235,"_28362":123236,"_3076":123237},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3624":73667,"_31170":73647,"_21595":123239,"_5":14857,"_28362":73647,"_3076":123240},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3624":73668,"_31170":73647,"_21595":123242,"_5":14857,"_28362":123172,"_3076":123243},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3624":73669,"_31170":73647,"_21595":123245,"_5":14857,"_28362":123172,"_3076":123246},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3624":73670,"_31170":73647,"_21595":123248,"_5":14857,"_28362":123179,"_3076":123249},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3624":73671,"_31170":73647,"_21595":123251,"_5":14857,"_28362":123183,"_3076":123252},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3624":73672,"_31170":73647,"_21595":123254,"_5":14857,"_28362":123187,"_3076":123255},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3624":73673,"_31170":73647,"_21595":123257,"_5":14857,"_28362":123191,"_3076":123258},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3624":73674,"_31170":73647,"_21595":123260,"_5":14857,"_28362":123195,"_3076":123261},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3624":73675,"_31170":73647,"_21595":123263,"_5":14857,"_28362":123203,"_3076":123264},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3624":73676,"_31170":73647,"_21595":123266,"_5":14857,"_28362":123203,"_3076":123267},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3624":73677,"_31170":73647,"_21595":123269,"_5":14857,"_28362":123206,"_3076":123270},[],"Campo de `settings.enrollment_settings`",{"_3624":73678,"_31170":73647,"_21595":123272,"_5":14857,"_28362":123206,"_3076":123273},[],"Decisión",{"_3624":73679,"_31170":73647,"_21595":123275,"_5":14857,"_28362":123206,"_3076":54000},[],{"_3624":73680,"_31170":73647,"_21595":123277,"_5":14857,"_28362":123206,"_3076":123278},[],"`EST_RFC7030` para estas operaciones.",{"_3624":73681,"_31170":73647,"_21595":123280,"_5":14857,"_28362":123206,"_3076":54006},[],{"_3624":73682,"_31170":73647,"_21595":123282,"_5":14857,"_28362":123206,"_3076":123283},[],"ID de la CA que firmará.",{"_3624":73683,"_31170":73647,"_21595":123285,"_5":14857,"_28362":123206,"_3076":54012},[],{"_3624":73684,"_31170":73647,"_21595":123287,"_5":14857,"_28362":123206,"_3076":123288},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3624":73685,"_31170":73647,"_21595":123290,"_5":14857,"_28362":123206,"_3076":54018},[],{"_3624":73686,"_31170":73647,"_21595":123292,"_5":14857,"_28362":123206,"_3076":123293},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3624":73687,"_31170":73647,"_21595":123295,"_5":14857,"_28362":123206,"_3076":54024},[],{"_3624":73688,"_31170":73647,"_21595":123297,"_5":14857,"_28362":123206,"_3076":123298},[],"Uno de los cuatro modos de autenticación.",{"_3624":73689,"_31170":73647,"_21595":123300,"_5":14857,"_28362":123206,"_3076":123301},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3624":73690,"_31170":73647,"_21595":123303,"_5":14857,"_28362":123209,"_3076":123304},[],"Los bloques son independientes:",{"_3624":73691,"_31170":73647,"_21595":123306,"_5":14857,"_28362":123209,"_3076":123307},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3624":73692,"_31170":73647,"_21595":123309,"_5":14857,"_28362":123209,"_3076":123310},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3624":73693,"_31170":73647,"_21595":123312,"_5":14857,"_28362":123209,"_3076":54042},[],{"_3624":73694,"_31170":73647,"_21595":123314,"_5":14857,"_28362":123209,"_3076":123315},[],"Control aplicado en la operación configurada",{"_3624":73695,"_31170":73647,"_21595":123317,"_5":14857,"_28362":123209,"_3076":54048},[],{"_3624":73696,"_31170":73647,"_21595":123319,"_5":14857,"_28362":123209,"_3076":123320},[],"Validación del certificado presentado.",{"_3624":73697,"_31170":73647,"_21595":123322,"_5":14857,"_28362":123209,"_3076":54054},[],{"_3624":73698,"_31170":73647,"_21595":123324,"_5":14857,"_28362":123209,"_3076":123325},[],"Autorización del webhook configurado.",{"_3624":73699,"_31170":73647,"_21595":123327,"_5":14857,"_28362":123209,"_3076":54060},[],{"_3624":73700,"_31170":73647,"_21595":123329,"_5":14857,"_28362":123209,"_3076":123330},[],"Validación del certificado y, después, aprobación del webhook.",{"_3624":73701,"_31170":73647,"_21595":123332,"_5":14857,"_28362":123209,"_3076":54066},[],{"_3624":73702,"_31170":73647,"_21595":123334,"_5":14857,"_28362":123209,"_3076":123335},[],"Sin autenticación del solicitante por el DMS.",{"_3624":73703,"_31170":73647,"_21595":123337,"_5":14857,"_28362":123209,"_3076":123338},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3624":73704,"_31170":73647,"_21595":123340,"_5":14857,"_28362":123209,"_3076":123341},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3624":73705,"_31170":73647,"_21595":123343,"_5":14857,"_28362":123209,"_3076":123344},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3624":73706,"_31170":73647,"_21595":123346,"_5":14857,"_28362":123209,"_3076":123347},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3624":73707,"_31170":73647,"_21595":123349,"_5":14857,"_28362":123209,"_3076":123350},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3624":73708,"_31170":73647,"_21595":123352,"_5":14857,"_28362":123213,"_3076":123353},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3624":73709,"_31170":73647,"_21595":123355,"_5":14857,"_28362":123213,"_3076":123356},[],"Campo de `external_webhook_settings`",{"_3624":73710,"_31170":73647,"_21595":123358,"_5":14857,"_28362":123213,"_3076":123273},[],{"_3624":73711,"_31170":73647,"_21595":123360,"_5":14857,"_28362":123213,"_3076":54095},[],{"_3624":73712,"_31170":73647,"_21595":123362,"_5":14857,"_28362":123213,"_3076":123363},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3624":73713,"_31170":73647,"_21595":123365,"_5":14857,"_28362":123213,"_3076":54101},[],{"_3624":73714,"_31170":73647,"_21595":123367,"_5":14857,"_28362":123213,"_3076":123368},[],"`POST` o `PUT`; `POST` por defecto.",{"_3624":73715,"_31170":73647,"_21595":123370,"_5":14857,"_28362":123213,"_3076":54107},[],{"_3624":73716,"_31170":73647,"_21595":123372,"_5":14857,"_28362":123213,"_3076":123373},[],"Etiqueta usada en los logs del servicio.",{"_3624":73717,"_31170":73647,"_21595":123375,"_5":14857,"_28362":123213,"_3076":54113},[],{"_3624":73718,"_31170":73647,"_21595":123377,"_5":14857,"_28362":123213,"_3076":123378},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3624":73719,"_31170":73647,"_21595":123380,"_5":14857,"_28362":123213,"_3076":54119},[],{"_3624":73720,"_31170":73647,"_21595":123382,"_5":14857,"_28362":123213,"_3076":123383},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3624":73721,"_31170":73647,"_21595":123385,"_5":14857,"_28362":123213,"_3076":54125},[],{"_3624":73722,"_31170":73647,"_21595":123387,"_5":14857,"_28362":123213,"_3076":123388},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3624":73723,"_31170":73647,"_21595":123390,"_5":14857,"_28362":123213,"_3076":54131},[],{"_3624":73724,"_31170":73647,"_21595":123392,"_5":14857,"_28362":123213,"_3076":123393},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3624":73725,"_31170":73647,"_21595":123395,"_5":14857,"_28362":123213,"_3076":54137},[],{"_3624":73726,"_31170":73647,"_21595":123397,"_5":14857,"_28362":123213,"_3076":123398},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3624":73727,"_31170":73647,"_21595":123400,"_5":14857,"_28362":123213,"_3076":54143},[],{"_3624":73728,"_31170":73647,"_21595":123402,"_5":14857,"_28362":123213,"_3076":123403},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3624":73729,"_31170":73647,"_21595":123405,"_5":14857,"_28362":123213,"_3076":54149},[],{"_3624":73730,"_31170":73647,"_21595":123407,"_5":14857,"_28362":123213,"_3076":123408},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3624":73731,"_31170":73647,"_21595":123410,"_5":14857,"_28362":123213,"_3076":123411},[],"Reglas de esa configuración:",{"_3624":73732,"_31170":73647,"_21595":123413,"_5":14857,"_28362":123213,"_3076":123414},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3624":73733,"_31170":73647,"_21595":123416,"_5":14857,"_28362":123213,"_3076":123417},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3624":73734,"_31170":73647,"_21595":123419,"_5":14857,"_28362":123213,"_3076":123420},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3624":73735,"_31170":73647,"_21595":123422,"_5":14857,"_28362":123213,"_3076":123423},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3624":73736,"_31170":73647,"_21595":123425,"_5":14857,"_28362":123213,"_3076":123426},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3624":73737,"_31170":73647,"_21595":123428,"_5":14857,"_28362":123213,"_3076":123429},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3624":73738,"_31170":73647,"_21595":123431,"_5":14857,"_28362":123213,"_3076":123432},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3624":73739,"_31170":73647,"_21595":123434,"_5":14857,"_28362":123213,"_3076":123435},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3624":73740,"_31170":73647,"_21595":123437,"_5":14857,"_28362":123213,"_3076":123438},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3624":73741,"_31170":73647,"_21595":123440,"_5":14857,"_28362":123217,"_3076":123441},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3624":73742,"_31170":73647,"_21595":123443,"_5":14857,"_28362":123221,"_3076":123444},[],"Campo de `settings.reenrollment_settings`",{"_3624":73743,"_31170":73647,"_21595":123446,"_5":14857,"_28362":123221,"_3076":123447},[],"Función",{"_3624":73744,"_31170":73647,"_21595":123449,"_5":14857,"_28362":123221,"_3076":54193},[],{"_3624":73745,"_31170":73647,"_21595":123451,"_5":14857,"_28362":123221,"_3076":123452},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3624":73746,"_31170":73647,"_21595":123454,"_5":14857,"_28362":123221,"_3076":54199},[],{"_3624":73747,"_31170":73647,"_21595":123456,"_5":14857,"_28362":123221,"_3076":123457},[],"Umbral operativo preventivo de monitorización.",{"_3624":73748,"_31170":73647,"_21595":123459,"_5":14857,"_28362":123221,"_3076":54205},[],{"_3624":73749,"_31170":73647,"_21595":123461,"_5":14857,"_28362":123221,"_3076":123462},[],"Umbral operativo crítico de monitorización.",{"_3624":73750,"_31170":73647,"_21595":123464,"_5":14857,"_28362":123221,"_3076":54211},[],{"_3624":73751,"_31170":73647,"_21595":123466,"_5":14857,"_28362":123221,"_3076":123467},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3624":73752,"_31170":73647,"_21595":123469,"_5":14857,"_28362":123221,"_3076":54217},[],{"_3624":73753,"_31170":73647,"_21595":123471,"_5":14857,"_28362":123221,"_3076":123472},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3624":73754,"_31170":73647,"_21595":123474,"_5":14857,"_28362":123221,"_3076":54223},[],{"_3624":73755,"_31170":73647,"_21595":123476,"_5":14857,"_28362":123221,"_3076":123477},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3624":73756,"_31170":73647,"_21595":123479,"_5":14857,"_28362":123221,"_3076":123480},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3624":73757,"_31170":73647,"_21595":123482,"_5":14857,"_28362":123225,"_3076":123483},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3624":73758,"_31170":73647,"_21595":123485,"_5":14857,"_28362":123228,"_3076":120659},[],{"_3624":73759,"_31170":73647,"_21595":123487,"_5":14857,"_28362":123228,"_3076":123488},[],"Qué publica",{"_3624":73760,"_31170":73647,"_21595":123490,"_5":14857,"_28362":123228,"_3076":54240},[],{"_3624":73761,"_31170":73647,"_21595":123492,"_5":14857,"_28362":123228,"_3076":123493},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3624":73762,"_31170":73647,"_21595":123495,"_5":14857,"_28362":123228,"_3076":54246},[],{"_3624":73763,"_31170":73647,"_21595":123497,"_5":14857,"_28362":123228,"_3076":123498},[],"Certificado de la CA emisora seleccionada.",{"_3624":73764,"_31170":73647,"_21595":123500,"_5":14857,"_28362":123228,"_3076":54252},[],{"_3624":73765,"_31170":73647,"_21595":123502,"_5":14857,"_28362":123228,"_3076":123503},[],"Certificados de las CAs elegidas explícitamente.",{"_3624":73766,"_31170":73647,"_21595":123505,"_5":14857,"_28362":123228,"_3076":123506},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3624":73767,"_31170":73647,"_21595":123508,"_5":14857,"_28362":123232,"_3076":123509},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3624":73768,"_31170":73647,"_21595":123511,"_5":14857,"_28362":123232,"_3076":123512},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3624":73769,"_31170":73647,"_21595":123514,"_5":14857,"_28362":123232,"_3076":123515},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3624":73770,"_31170":73647,"_21595":123517,"_5":14857,"_28362":123236,"_3076":123518},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3624":73771,"_31170":73771,"_5":15217,"_3076":123520,"_31528":123521,"_21595":123522,"_28362":73771},"Integra el cliente EST",[50937,121761,53621,122906,123084],[],{"_3624":73772,"_31170":73771,"_21595":123524,"_5":14857,"_28362":73771,"_3076":123525},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3624":73773,"_31170":73771,"_5":31525,"_21595":123527,"_28362":123528,"_3076":120295},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3624":73774,"_31170":73771,"_5":31525,"_21595":123530,"_28362":123531,"_3076":123532},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3624":73775,"_31170":73771,"_5":31525,"_21595":123534,"_28362":123535,"_3076":123536},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3624":73776,"_31170":73771,"_5":31525,"_21595":123538,"_28362":123539,"_3076":123540},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3624":73777,"_31170":73771,"_5":31525,"_21595":123542,"_28362":123543,"_3076":123544},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3624":73778,"_31170":73771,"_5":31525,"_21595":123546,"_28362":123547,"_3076":123548},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3624":73779,"_31170":73771,"_21595":123550,"_5":14857,"_28362":73771,"_3076":123551},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3624":73780,"_31170":73771,"_21595":123553,"_5":14857,"_28362":123528,"_3076":123554},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3624":73781,"_31170":73771,"_21595":123556,"_5":14857,"_28362":123528,"_3076":123557},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3624":73782,"_31170":73771,"_21595":123559,"_5":14857,"_28362":123528,"_3076":123560},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3624":73783,"_31170":73771,"_21595":123562,"_5":14857,"_28362":123531,"_3076":123563},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3624":73784,"_31170":73771,"_21595":123565,"_5":14857,"_28362":123531,"_3076":123566},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3624":73785,"_31170":73771,"_21595":123568,"_5":14857,"_28362":123535,"_3076":123569},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3624":73786,"_31170":73771,"_21595":123571,"_5":14857,"_28362":123535,"_3076":123572},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3624":73787,"_31170":73771,"_21595":123574,"_5":14857,"_28362":123539,"_3076":123575},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3624":73788,"_31170":73771,"_21595":123577,"_5":14857,"_28362":123539,"_3076":123578},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3624":73789,"_31170":73771,"_21595":123580,"_5":14857,"_28362":123543,"_3076":123581},[],"Para el caso de una raíz que emite directamente:",{"_3624":73790,"_31170":73771,"_21595":123583,"_5":14857,"_28362":123543,"_3076":123584},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3624":73791,"_31170":73771,"_21595":123586,"_5":14857,"_28362":123543,"_3076":123587},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3624":73792,"_31170":73771,"_21595":123589,"_5":14857,"_28362":123547,"_3076":123590},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3624":73793,"_31170":73793,"_5":15217,"_3076":123592,"_31528":123593,"_21595":123594,"_28362":73793},"Referencia EST",[50937,121761,53621,122906,123084],[],{"_3624":73794,"_31170":73793,"_21595":123596,"_5":14857,"_28362":73793,"_3076":123597},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3624":73795,"_31170":73793,"_5":31525,"_21595":123599,"_28362":123600,"_3076":123601},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3624":73796,"_31170":73793,"_5":31525,"_21595":123603,"_28362":123604,"_3076":23397},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3624":73797,"_31170":73793,"_5":31525,"_21595":123606,"_28362":123607,"_3076":26912},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3624":73798,"_31170":73793,"_5":31525,"_21595":123609,"_28362":123610,"_3076":26919},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3624":73799,"_31170":73793,"_5":31525,"_21595":123612,"_28362":123613,"_3076":26181},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3624":73800,"_31170":73793,"_5":31525,"_21595":123615,"_28362":123616,"_3076":123617},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3624":73801,"_31170":73793,"_5":31525,"_21595":123619,"_28362":123620,"_3076":123621},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3624":73802,"_31170":73793,"_5":31525,"_21595":123623,"_28362":123624,"_3076":123625},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3624":73803,"_31170":73793,"_21595":123627,"_5":14857,"_28362":73793,"_3076":123628},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3624":73804,"_31170":73793,"_21595":123630,"_5":14857,"_28362":123600,"_3076":123631},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3624":73805,"_31170":73793,"_21595":123633,"_5":14857,"_28362":123600,"_3076":121521},[],{"_3624":73806,"_31170":73793,"_21595":123635,"_5":14857,"_28362":123600,"_3076":123636},[],"Método",{"_3624":73807,"_31170":73793,"_21595":123638,"_5":14857,"_28362":123600,"_3076":123639},[],"Autenticación y condición",{"_3624":73808,"_31170":73793,"_21595":123641,"_5":14857,"_28362":123600,"_3076":54395},[],{"_3624":73809,"_31170":73793,"_21595":123643,"_5":14857,"_28362":123600,"_3076":54398},[],{"_3624":73810,"_31170":73793,"_21595":123645,"_5":14857,"_28362":123600,"_3076":123646},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3624":73811,"_31170":73793,"_21595":123648,"_5":14857,"_28362":123600,"_3076":54404},[],{"_3624":73812,"_31170":73793,"_21595":123650,"_5":14857,"_28362":123600,"_3076":54407},[],{"_3624":73813,"_31170":73793,"_21595":123652,"_5":14857,"_28362":123600,"_3076":123653},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3624":73814,"_31170":73793,"_21595":123655,"_5":14857,"_28362":123600,"_3076":54413},[],{"_3624":73815,"_31170":73793,"_21595":123657,"_5":14857,"_28362":123600,"_3076":54407},[],{"_3624":73816,"_31170":73793,"_21595":123659,"_5":14857,"_28362":123600,"_3076":123660},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3624":73817,"_31170":73793,"_21595":123662,"_5":14857,"_28362":123600,"_3076":54421},[],{"_3624":73818,"_31170":73793,"_21595":123664,"_5":14857,"_28362":123600,"_3076":54407},[],{"_3624":73819,"_31170":73793,"_21595":123666,"_5":14857,"_28362":123600,"_3076":123667},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3624":73820,"_31170":73793,"_21595":123669,"_5":14857,"_28362":123600,"_3076":123670},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3624":73821,"_31170":73793,"_21595":123672,"_5":14857,"_28362":123604,"_3076":123673},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3624":73822,"_31170":73793,"_21595":123675,"_5":14857,"_28362":123604,"_3076":123676},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3624":73823,"_31170":73793,"_21595":123678,"_5":14857,"_28362":123607,"_3076":123679},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3624":73824,"_31170":73793,"_21595":123681,"_5":14857,"_28362":123607,"_3076":123682},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3624":73825,"_31170":73793,"_21595":123684,"_5":14857,"_28362":123610,"_3076":123685},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3624":73826,"_31170":73793,"_21595":123687,"_5":14857,"_28362":123610,"_3076":123688},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3624":73827,"_31170":73793,"_21595":123690,"_5":14857,"_28362":123613,"_3076":123691},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3624":73828,"_31170":73793,"_21595":123693,"_5":14857,"_28362":123613,"_3076":123694},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3624":73829,"_31170":73793,"_21595":123696,"_5":14857,"_28362":123616,"_3076":123697},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3624":73830,"_31170":73793,"_21595":123699,"_5":14857,"_28362":123616,"_3076":123700},[],"Parte",{"_3624":73831,"_31170":73793,"_21595":123702,"_5":14857,"_28362":123616,"_3076":123703},[],"Contenido tras decodificar su Base64",{"_3624":73832,"_31170":73793,"_21595":123705,"_5":14857,"_28362":123616,"_3076":54465},[],{"_3624":73833,"_31170":73793,"_21595":123707,"_5":14857,"_28362":123616,"_3076":123708},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3624":73834,"_31170":73793,"_21595":123710,"_5":14857,"_28362":123616,"_3076":54471},[],{"_3624":73835,"_31170":73793,"_21595":123712,"_5":14857,"_28362":123616,"_3076":123713},[],"PKCS#7 DER con el certificado emitido.",{"_3624":73836,"_31170":73793,"_21595":123715,"_5":14857,"_28362":123616,"_3076":123716},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3624":73837,"_31170":73793,"_21595":123718,"_5":14857,"_28362":123620,"_3076":123719},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3624":73838,"_31170":73793,"_21595":123721,"_5":14857,"_28362":123620,"_3076":123722},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3624":73839,"_31170":73793,"_21595":123724,"_5":14857,"_28362":123620,"_3076":123725},[],"Convierte y comprueba el resultado:",{"_3624":73840,"_31170":73793,"_21595":123727,"_5":14857,"_28362":123620,"_3076":123728},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3624":73841,"_31170":73793,"_21595":123730,"_5":14857,"_28362":123624,"_3076":123731},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3624":73842,"_31170":73793,"_21595":123733,"_5":14857,"_28362":123624,"_3076":123734},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3624":73843,"_31170":73843,"_5":15217,"_3076":123084,"_31528":123736,"_21595":123737,"_28362":73843},[50937,121761,53621,122906,123084],[],{"_3624":73844,"_31170":73843,"_21595":123739,"_5":14857,"_28362":73843,"_3076":123740},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3624":73845,"_31170":73843,"_5":31525,"_21595":123742,"_28362":123743,"_3076":123744},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3624":73846,"_31170":73843,"_5":31525,"_21595":123746,"_28362":123747,"_3076":123748},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3624":73847,"_31170":73843,"_5":31525,"_21595":123750,"_28362":123751,"_3076":123752},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3624":73848,"_31170":73843,"_21595":123754,"_5":14857,"_28362":73843,"_3076":123755},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3624":73849,"_31170":73843,"_21595":123757,"_5":14857,"_28362":123743,"_3076":123758},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3624":73850,"_31170":73843,"_21595":123760,"_5":14857,"_28362":123743,"_3076":123761},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3624":73851,"_31170":73843,"_21595":123763,"_5":14857,"_28362":123743,"_3076":123764},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3624":73852,"_31170":73843,"_21595":123766,"_5":14857,"_28362":123743,"_3076":123767},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3624":73853,"_31170":73843,"_21595":123769,"_5":14857,"_28362":123743,"_3076":123770},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3624":73854,"_31170":73843,"_21595":123772,"_5":14857,"_28362":123743,"_3076":123773},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3624":73855,"_31170":73843,"_21595":123775,"_5":14857,"_28362":123747,"_3076":123776},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3624":73856,"_31170":73843,"_21595":123778,"_5":14857,"_28362":123747,"_3076":123779},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":73857,"_31170":73843,"_21595":123781,"_5":14857,"_28362":123747,"_3076":123782},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3624":73858,"_31170":73843,"_21595":123784,"_5":14857,"_28362":123747,"_3076":123785},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3624":73859,"_31170":73843,"_21595":123787,"_5":14857,"_28362":123751,"_3076":123788},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3624":73860,"_31170":73843,"_21595":123790,"_5":14857,"_28362":123751,"_3076":123791},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3624":73861,"_31170":73843,"_21595":123793,"_5":14857,"_28362":123751,"_3076":123794},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3624":73862,"_31170":73843,"_21595":123796,"_5":14857,"_28362":123751,"_3076":123797},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3624":73863,"_31170":73843,"_21595":123799,"_5":14857,"_28362":123751,"_3076":123800},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3624":73864,"_31170":73864,"_5":15217,"_3076":123802,"_31528":123803,"_21595":123804,"_28362":73864},"Estrategias de aprovisionamiento",[50937,121761,53621,122906,123084],[],{"_3624":73865,"_31170":73864,"_21595":123806,"_5":14857,"_28362":73864,"_3076":123807},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3624":73866,"_31170":73864,"_5":31525,"_21595":123809,"_28362":123810,"_3076":123811},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3624":73867,"_31170":73864,"_5":31525,"_21595":123813,"_28362":123814,"_3076":123815},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3624":73868,"_31170":73864,"_5":31525,"_21595":123817,"_28362":123818,"_3076":123819},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3624":73869,"_31170":73864,"_5":31525,"_21595":123821,"_28362":123822,"_3076":123823},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3624":73870,"_31170":73864,"_5":31525,"_21595":123825,"_28362":123826,"_3076":123827},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3624":73871,"_31170":73864,"_21595":123829,"_5":14857,"_28362":73864,"_3076":123830},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3624":73872,"_31170":73864,"_21595":123832,"_5":14857,"_28362":123810,"_3076":123833},[],"Recorrido",{"_3624":73873,"_31170":73864,"_21595":123835,"_5":14857,"_28362":123810,"_3076":123836},[],"Cuándo existe el dispositivo",{"_3624":73874,"_31170":73864,"_21595":123838,"_5":14857,"_28362":123810,"_3076":123839},[],"Qué compruebas",{"_3624":73875,"_31170":73864,"_21595":123841,"_5":14857,"_28362":123810,"_3076":123842},[],"Asignación manual",{"_3624":73876,"_31170":73864,"_21595":123844,"_5":14857,"_28362":123810,"_3076":123845},[],"El operador lo crea antes de asociar un certificado.",{"_3624":73877,"_31170":73864,"_21595":123847,"_5":14857,"_28362":123810,"_3076":123848},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3624":73878,"_31170":73864,"_21595":123850,"_5":14857,"_28362":123810,"_3076":123851},[],"EST con `JITP`",{"_3624":73879,"_31170":73864,"_21595":123853,"_5":14857,"_28362":123810,"_3076":123854},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3624":73880,"_31170":73864,"_21595":123856,"_5":14857,"_28362":123810,"_3076":123857},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3624":73881,"_31170":73864,"_21595":123859,"_5":14857,"_28362":123810,"_3076":123860},[],"EST con `PRE_REGISTRATION`",{"_3624":73882,"_31170":73864,"_21595":123862,"_5":14857,"_28362":123810,"_3076":123863},[],"Debe existir antes de `/simpleenroll`.",{"_3624":73883,"_31170":73864,"_21595":123865,"_5":14857,"_28362":123810,"_3076":123866},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3624":73884,"_31170":73864,"_21595":123868,"_5":14857,"_28362":123810,"_3076":123869},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3624":73885,"_31170":73864,"_21595":123871,"_5":14857,"_28362":123810,"_3076":123872},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3624":73886,"_31170":73864,"_21595":123874,"_5":14857,"_28362":123814,"_3076":123875},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3624":73887,"_31170":73864,"_21595":123877,"_5":14857,"_28362":123814,"_3076":123878},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3624":73888,"_31170":73864,"_21595":123880,"_5":14857,"_28362":123814,"_3076":123881},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3624":73889,"_31170":73864,"_21595":123883,"_5":14857,"_28362":123818,"_3076":123884},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3624":73890,"_31170":73864,"_21595":123886,"_5":14857,"_28362":123818,"_3076":123887},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3624":73891,"_31170":73864,"_21595":123889,"_5":14857,"_28362":123818,"_3076":123890},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3624":73892,"_31170":73864,"_21595":123892,"_5":14857,"_28362":123818,"_3076":123893},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3624":73893,"_31170":73864,"_21595":123895,"_5":14857,"_28362":123818,"_3076":123896},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3624":73894,"_31170":73864,"_21595":123898,"_5":14857,"_28362":123818,"_3076":123899},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3624":73895,"_31170":73864,"_21595":123901,"_5":14857,"_28362":123822,"_3076":120659},[],{"_3624":73896,"_31170":73864,"_21595":123903,"_5":14857,"_28362":123822,"_3076":123904},[],"Material que atraviesa EST",{"_3624":73897,"_31170":73864,"_21595":123906,"_5":14857,"_28362":123822,"_3076":123907},[],"Clave generada por el dispositivo",{"_3624":73898,"_31170":73864,"_21595":123909,"_5":14857,"_28362":123822,"_3076":123910},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3624":73899,"_31170":73864,"_21595":123912,"_5":14857,"_28362":123822,"_3076":123913},[],"Clave ya disponible en el dispositivo",{"_3624":73900,"_31170":73864,"_21595":123915,"_5":14857,"_28362":123822,"_3076":123916},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3624":73901,"_31170":73864,"_21595":123918,"_5":14857,"_28362":123822,"_3076":53949},[],{"_3624":73902,"_31170":73864,"_21595":123920,"_5":14857,"_28362":123822,"_3076":123921},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3624":73903,"_31170":73864,"_21595":123923,"_5":14857,"_28362":123822,"_3076":123924},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3624":73904,"_31170":73864,"_21595":123926,"_5":14857,"_28362":123826,"_3076":123927},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3624":73905,"_31170":73905,"_5":15217,"_3076":123929,"_31528":123930,"_21595":123931,"_28362":73905},"Renovación y recuperación",[50937,121761,53621,122906,123084],[],{"_3624":73906,"_31170":73905,"_21595":123933,"_5":14857,"_28362":73905,"_3076":123934},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3624":73907,"_31170":73905,"_5":31525,"_21595":123936,"_28362":123937,"_3076":123938},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3624":73908,"_31170":73905,"_5":31525,"_21595":123940,"_28362":123941,"_3076":123942},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3624":73909,"_31170":73905,"_5":31525,"_21595":123944,"_28362":123945,"_3076":123946},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3624":73910,"_31170":73905,"_5":31525,"_21595":123948,"_28362":123949,"_3076":123950},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3624":73911,"_31170":73905,"_5":31525,"_21595":123952,"_28362":123953,"_3076":123954},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3624":73912,"_31170":73905,"_21595":123956,"_5":14857,"_28362":73905,"_3076":123957},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3624":73913,"_31170":73905,"_21595":123959,"_5":14857,"_28362":123937,"_3076":123960},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3624":73914,"_31170":73905,"_21595":123962,"_5":14857,"_28362":123937,"_3076":123963},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3624":73915,"_31170":73905,"_21595":123965,"_5":14857,"_28362":123937,"_3076":123966},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3624":73916,"_31170":73905,"_21595":123968,"_5":14857,"_28362":123937,"_3076":123969},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3624":73917,"_31170":73905,"_21595":123971,"_5":14857,"_28362":123941,"_3076":123972},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3624":73918,"_31170":73905,"_21595":123974,"_5":14857,"_28362":123941,"_3076":123975},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3624":73919,"_31170":73905,"_21595":123977,"_5":14857,"_28362":123945,"_3076":123978},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3624":73920,"_31170":73905,"_21595":123980,"_5":14857,"_28362":123945,"_3076":123981},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3624":73921,"_31170":73905,"_21595":123983,"_5":14857,"_28362":123945,"_3076":123984},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3624":73922,"_31170":73905,"_21595":123986,"_5":14857,"_28362":123949,"_3076":123987},[],"Situación",{"_3624":73923,"_31170":73905,"_21595":123989,"_5":14857,"_28362":123949,"_3076":123990},[],"Procedimiento",{"_3624":73924,"_31170":73905,"_21595":123992,"_5":14857,"_28362":123949,"_3076":123993},[],"Certificado vigente, fuera de ventana",{"_3624":73925,"_31170":73905,"_21595":123995,"_5":14857,"_28362":123949,"_3076":123996},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3624":73926,"_31170":73905,"_21595":123998,"_5":14857,"_28362":123949,"_3076":123999},[],"Certificado vencido, clave disponible",{"_3624":73927,"_31170":73905,"_21595":124001,"_5":14857,"_28362":123949,"_3076":124002},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3624":73928,"_31170":73905,"_21595":124004,"_5":14857,"_28362":123949,"_3076":124005},[],"Renovación por webhook o `NO_AUTH`",{"_3624":73929,"_31170":73905,"_21595":124007,"_5":14857,"_28362":123949,"_3076":124008},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3624":73930,"_31170":73905,"_21595":124010,"_5":14857,"_28362":123949,"_3076":124011},[],"Clave perdida o inaccesible",{"_3624":73931,"_31170":73905,"_21595":124013,"_5":14857,"_28362":123949,"_3076":124014},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3624":73932,"_31170":73905,"_21595":124016,"_5":14857,"_28362":123949,"_3076":124017},[],"Identidad actual revocada",{"_3624":73933,"_31170":73905,"_21595":124019,"_5":14857,"_28362":123949,"_3076":124020},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3624":73934,"_31170":73905,"_21595":124022,"_5":14857,"_28362":123949,"_3076":124023},[],"Dispositivo sin identidad",{"_3624":73935,"_31170":73905,"_21595":124025,"_5":14857,"_28362":123949,"_3076":124026},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3624":73936,"_31170":73905,"_21595":124028,"_5":14857,"_28362":123949,"_3076":124029},[],"Dispositivo retirado",{"_3624":73937,"_31170":73905,"_21595":124031,"_5":14857,"_28362":123949,"_3076":124032},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3624":73938,"_31170":73905,"_21595":124034,"_5":14857,"_28362":123949,"_3076":124035},[],"Timeout, HTTP 500 o fallo de instalación",{"_3624":73939,"_31170":73905,"_21595":124037,"_5":14857,"_28362":123949,"_3076":124038},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3624":73940,"_31170":73905,"_21595":124040,"_5":14857,"_28362":123953,"_3076":124041},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3624":73941,"_31170":73905,"_21595":124043,"_5":14857,"_28362":123953,"_3076":124044},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3624":73942,"_31170":73942,"_5":15217,"_3076":124046,"_31528":124047,"_21595":124048,"_28362":73942},"Diagnóstico de enrolamiento",[50937,121761,53621,122906,123084],[],{"_3624":73943,"_31170":73942,"_21595":124050,"_5":14857,"_28362":73942,"_3076":124051},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3624":73944,"_31170":73942,"_5":31525,"_21595":124053,"_28362":124054,"_3076":124055},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3624":73945,"_31170":73942,"_5":31525,"_21595":124057,"_28362":124058,"_3076":124059},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3624":73946,"_31170":73942,"_5":31525,"_21595":124061,"_28362":124062,"_3076":123625},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3624":73947,"_31170":73942,"_5":31525,"_21595":124064,"_28362":124065,"_3076":124066},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3624":73948,"_31170":73942,"_21595":124068,"_5":14857,"_28362":73942,"_3076":124069},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3624":73949,"_31170":73942,"_21595":124071,"_5":14857,"_28362":124058,"_3076":124072},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3624":73950,"_31170":73942,"_21595":124074,"_5":14857,"_28362":124058,"_3076":124075},[],"Síntoma o mensaje",{"_3624":73951,"_31170":73942,"_21595":124077,"_5":14857,"_28362":124058,"_3076":124078},[],"Qué revisar",{"_3624":73952,"_31170":73942,"_21595":124080,"_5":14857,"_28362":124058,"_3076":124081},[],"curl rechaza TLS, nombre o emisor",{"_3624":73953,"_31170":73942,"_21595":124083,"_5":14857,"_28362":124058,"_3076":124084},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3624":73954,"_31170":73942,"_21595":124086,"_5":14857,"_28362":124058,"_3076":124087},[],"404 o APS ausente",{"_3624":73955,"_31170":73942,"_21595":124089,"_5":14857,"_28362":124058,"_3076":124090},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3624":73956,"_31170":73942,"_21595":124092,"_5":14857,"_28362":124058,"_3076":124093},[],"400, error de CSR o formato",{"_3624":73957,"_31170":73942,"_21595":124095,"_5":14857,"_28362":124058,"_3076":124096},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3624":73958,"_31170":73942,"_21595":124098,"_5":14857,"_28362":124058,"_3076":124099},[],"Credencial ausente o certificado no válido",{"_3624":73959,"_31170":73942,"_21595":124101,"_5":14857,"_28362":124058,"_3076":124102},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3624":73960,"_31170":73942,"_21595":124104,"_5":14857,"_28362":124058,"_3076":124105},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3624":73961,"_31170":73942,"_21595":124107,"_5":14857,"_28362":124058,"_3076":124108},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3624":73962,"_31170":73942,"_21595":124110,"_5":14857,"_28362":124058,"_3076":124111},[],"Webhook deniega, expira o responde sin autorización",{"_3624":73963,"_31170":73942,"_21595":124113,"_5":14857,"_28362":124058,"_3076":124114},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3624":73964,"_31170":73942,"_21595":124116,"_5":14857,"_28362":124058,"_3076":54877},[],{"_3624":73965,"_31170":73942,"_21595":124118,"_5":14857,"_28362":124058,"_3076":124119},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3624":73966,"_31170":73942,"_21595":124121,"_5":14857,"_28362":124058,"_3076":54883},[],{"_3624":73967,"_31170":73942,"_21595":124123,"_5":14857,"_28362":124058,"_3076":124124},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3624":73968,"_31170":73942,"_21595":124126,"_5":14857,"_28362":124058,"_3076":54889},[],{"_3624":73969,"_31170":73942,"_21595":124128,"_5":14857,"_28362":124058,"_3076":124129},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3624":73970,"_31170":73942,"_21595":124131,"_5":14857,"_28362":124058,"_3076":54895},[],{"_3624":73971,"_31170":73942,"_21595":124133,"_5":14857,"_28362":124058,"_3076":124134},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3624":73972,"_31170":73942,"_21595":124136,"_5":14857,"_28362":124058,"_3076":54901},[],{"_3624":73973,"_31170":73942,"_21595":124138,"_5":14857,"_28362":124058,"_3076":124139},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3624":73974,"_31170":73942,"_21595":124141,"_5":14857,"_28362":124058,"_3076":124142},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3624":73975,"_31170":73942,"_21595":124144,"_5":14857,"_28362":124058,"_3076":124145},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3624":73976,"_31170":73942,"_21595":124147,"_5":14857,"_28362":124058,"_3076":124148},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3624":73977,"_31170":73942,"_21595":124150,"_5":14857,"_28362":124058,"_3076":124151},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3624":73978,"_31170":73942,"_21595":124153,"_5":14857,"_28362":124058,"_3076":54919},[],{"_3624":73979,"_31170":73942,"_21595":124155,"_5":14857,"_28362":124058,"_3076":124156},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3624":73980,"_31170":73942,"_21595":124158,"_5":14857,"_28362":124058,"_3076":54925},[],{"_3624":73981,"_31170":73942,"_21595":124160,"_5":14857,"_28362":124058,"_3076":124161},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3624":73982,"_31170":73942,"_21595":124163,"_5":14857,"_28362":124058,"_3076":124164},[],"DMS propietario distinto",{"_3624":73983,"_31170":73942,"_21595":124166,"_5":14857,"_28362":124058,"_3076":124167},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3624":73984,"_31170":73942,"_21595":124169,"_5":14857,"_28362":124058,"_3076":54937},[],{"_3624":73985,"_31170":73942,"_21595":124171,"_5":14857,"_28362":124058,"_3076":124172},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3624":73986,"_31170":73942,"_21595":124174,"_5":14857,"_28362":124058,"_3076":54943},[],{"_3624":73987,"_31170":73942,"_21595":124176,"_5":14857,"_28362":124058,"_3076":124177},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3624":73988,"_31170":73942,"_21595":124179,"_5":14857,"_28362":124058,"_3076":124180},[],"Certificado actual revocado",{"_3624":73989,"_31170":73942,"_21595":124182,"_5":14857,"_28362":124058,"_3076":124183},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3624":73990,"_31170":73942,"_21595":124185,"_5":14857,"_28362":124058,"_3076":124186},[],"Error de CA, perfil o firma",{"_3624":73991,"_31170":73942,"_21595":124188,"_5":14857,"_28362":124058,"_3076":124189},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3624":73992,"_31170":73942,"_21595":124191,"_5":14857,"_28362":124058,"_3076":124192},[],"HTTP 200 sin conexión del dispositivo",{"_3624":73993,"_31170":73942,"_21595":124194,"_5":14857,"_28362":124058,"_3076":124195},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3624":73994,"_31170":73942,"_21595":124197,"_5":14857,"_28362":124058,"_3076":124198},[],"Timeout o error después de emitir",{"_3624":73995,"_31170":73942,"_21595":124200,"_5":14857,"_28362":124058,"_3076":124201},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3624":73996,"_31170":73942,"_21595":124203,"_5":14857,"_28362":124062,"_3076":124204},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3624":73997,"_31170":73942,"_21595":124206,"_5":14857,"_28362":124062,"_3076":124207},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3624":73998,"_31170":73942,"_21595":124209,"_5":14857,"_28362":124065,"_3076":124210},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3624":73999,"_31170":73942,"_21595":124212,"_5":14857,"_28362":124065,"_3076":124213},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3624":74000,"_31170":73942,"_21595":124215,"_5":14857,"_28362":124065,"_3076":124216},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3624":74001,"_31170":73942,"_21595":124218,"_5":14857,"_28362":124065,"_3076":124219},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3624":74002,"_31170":73942,"_21595":124221,"_5":14857,"_28362":124065,"_3076":124222},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3624":74003,"_31170":73942,"_21595":124224,"_5":14857,"_28362":124065,"_3076":124225},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3624":74004,"_31170":73942,"_21595":124227,"_5":14857,"_28362":124065,"_3076":124228},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3624":74005,"_31170":74005,"_5":15217,"_3076":124230,"_31528":124231,"_21595":124232,"_28362":74005},"Distribución y actualización de confianza",[50937,121761,53621,122906,123084],[],{"_3624":74006,"_31170":74005,"_21595":124234,"_5":14857,"_28362":74005,"_3076":124235},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3624":74007,"_31170":74005,"_5":31525,"_21595":124237,"_28362":124238,"_3076":124239},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3624":74008,"_31170":74005,"_5":31525,"_21595":124241,"_28362":124242,"_3076":124243},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3624":74009,"_31170":74005,"_5":31525,"_21595":124245,"_28362":124246,"_3076":124247},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3624":74010,"_31170":74005,"_5":31525,"_21595":124249,"_28362":124250,"_3076":124251},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3624":74011,"_31170":74005,"_5":31525,"_21595":124253,"_28362":124254,"_3076":124255},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3624":74012,"_31170":74005,"_21595":124257,"_5":14857,"_28362":74005,"_3076":124258},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3624":74013,"_31170":74005,"_21595":124260,"_5":14857,"_28362":124238,"_3076":124261},[],"Relación",{"_3624":74014,"_31170":74005,"_21595":124263,"_5":14857,"_28362":124238,"_3076":124264},[],"Material que prepara el responsable",{"_3624":74015,"_31170":74005,"_21595":124266,"_5":14857,"_28362":124238,"_3076":124267},[],"Dispositivo → servidor EST",{"_3624":74016,"_31170":74005,"_21595":124269,"_5":14857,"_28362":124238,"_3076":124270},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3624":74017,"_31170":74005,"_21595":124272,"_5":14857,"_28362":124238,"_3076":124273},[],"DMS → solicitante",{"_3624":74018,"_31170":74005,"_21595":124275,"_5":14857,"_28362":124238,"_3076":124276},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3624":74019,"_31170":74005,"_21595":124278,"_5":14857,"_28362":124238,"_3076":124279},[],"Consumidor → dispositivo",{"_3624":74020,"_31170":74005,"_21595":124281,"_5":14857,"_28362":124238,"_3076":124282},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3624":74021,"_31170":74005,"_21595":124284,"_5":14857,"_28362":124238,"_3076":124285},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3624":74022,"_31170":74005,"_21595":124287,"_5":14857,"_28362":124242,"_3076":124288},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3624":74023,"_31170":74005,"_21595":124290,"_5":14857,"_28362":124242,"_3076":124291},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3624":74024,"_31170":74005,"_21595":124293,"_5":14857,"_28362":124246,"_3076":124294},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3624":74025,"_31170":74005,"_21595":124296,"_5":14857,"_28362":124246,"_3076":124297},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3624":74026,"_31170":74005,"_21595":124299,"_5":14857,"_28362":124246,"_3076":124300},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3624":74027,"_31170":74005,"_21595":124302,"_5":14857,"_28362":124246,"_3076":124303},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3624":74028,"_31170":74005,"_21595":124305,"_5":14857,"_28362":124246,"_3076":124306},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3624":74029,"_31170":74005,"_21595":124308,"_5":14857,"_28362":124246,"_3076":124309},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3624":74030,"_31170":74005,"_21595":124311,"_5":14857,"_28362":124250,"_3076":124312},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3624":74031,"_31170":74005,"_21595":124314,"_5":14857,"_28362":124250,"_3076":124315},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3624":74032,"_31170":74005,"_21595":124317,"_5":14857,"_28362":124250,"_3076":124318},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3624":74033,"_31170":74005,"_21595":124320,"_5":14857,"_28362":124254,"_3076":124321},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3624":74034,"_31170":74034,"_5":15217,"_3076":55092,"_31528":124323,"_21595":124325,"_28362":74034},[50937,121761,53621,122906,124324],"Integraciones",[],{"_3624":74035,"_31170":74034,"_21595":124327,"_5":14857,"_28362":74034,"_3076":124328},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3624":74036,"_31170":74034,"_5":31525,"_21595":124330,"_28362":124331,"_3076":124332},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3624":74037,"_31170":74034,"_5":31525,"_21595":124334,"_28362":124335,"_3076":124336},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3624":74038,"_31170":74034,"_5":31525,"_21595":124338,"_28362":124339,"_3076":124340},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3624":74039,"_31170":74034,"_5":31525,"_21595":124342,"_28362":124343,"_3076":124344},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3624":74040,"_31170":74034,"_5":31525,"_21595":124346,"_28362":124347,"_3076":124348},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3624":74041,"_31170":74034,"_5":31525,"_21595":124350,"_28362":124351,"_3076":124352},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3624":74042,"_31170":74034,"_5":31525,"_21595":124354,"_28362":124355,"_3076":124356},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3624":74043,"_31170":74034,"_5":31525,"_21595":124358,"_28362":124359,"_3076":124360},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3624":74044,"_31170":74034,"_5":31525,"_21595":124362,"_28362":124363,"_3076":55134},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3624":74045,"_31170":74034,"_5":31525,"_21595":124365,"_28362":124366,"_3076":55138},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3624":74046,"_31170":74034,"_5":31525,"_21595":124368,"_28362":124369,"_3076":124370},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3624":74047,"_31170":74034,"_5":31525,"_21595":124372,"_28362":124373,"_3076":124374},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3624":74048,"_31170":74034,"_5":31525,"_21595":124376,"_28362":124377,"_3076":124378},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3624":74049,"_31170":74034,"_5":31525,"_21595":124380,"_28362":124381,"_3076":124382},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3624":74050,"_31170":74034,"_5":31525,"_21595":124384,"_28362":124385,"_3076":124386},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3624":74051,"_31170":74034,"_5":31525,"_21595":124388,"_28362":124389,"_3076":124390},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3624":74052,"_31170":74034,"_5":31525,"_21595":124392,"_28362":124393,"_3076":124394},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3624":74053,"_31170":74034,"_5":31525,"_21595":124396,"_28362":124397,"_3076":124398},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3624":74054,"_31170":74034,"_5":31525,"_21595":124400,"_28362":124401,"_3076":124402},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3624":74055,"_31170":74034,"_5":31525,"_21595":124404,"_28362":124405,"_3076":124406},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3624":74056,"_31170":74034,"_5":31525,"_21595":124408,"_28362":124409,"_3076":124410},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3624":74057,"_31170":74034,"_5":31525,"_21595":124412,"_28362":124413,"_3076":124414},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3624":74058,"_31170":74034,"_5":31525,"_21595":124416,"_28362":124417,"_3076":124418},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3624":74059,"_31170":74034,"_5":31525,"_21595":124420,"_28362":124421,"_3076":124422},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3624":74060,"_31170":74034,"_5":31525,"_21595":124424,"_28362":124425,"_3076":124426},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3624":74061,"_31170":74034,"_21595":124428,"_5":14857,"_28362":74034,"_3076":124429},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3624":74062,"_31170":74034,"_21595":124431,"_5":14857,"_28362":74034,"_3076":124432},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3624":74063,"_31170":74034,"_21595":124434,"_5":14857,"_28362":74034,"_3076":124435},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3624":74064,"_31170":74034,"_21595":124437,"_5":14857,"_28362":124331,"_3076":124438},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3624":74065,"_31170":74034,"_21595":124440,"_5":14857,"_28362":124331,"_3076":124441},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3624":74066,"_31170":74034,"_21595":124443,"_5":14857,"_28362":124331,"_3076":124444},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3624":74067,"_31170":74034,"_21595":124446,"_5":14857,"_28362":124331,"_3076":124447},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3624":74068,"_31170":74034,"_21595":124449,"_5":14857,"_28362":124335,"_3076":124450},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3624":74069,"_31170":74034,"_21595":124452,"_5":14857,"_28362":124339,"_3076":124453},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3624":74070,"_31170":74034,"_21595":124455,"_5":14857,"_28362":124339,"_3076":124456},[],"Acción IAM",{"_3624":74071,"_31170":74034,"_21595":124458,"_5":14857,"_28362":124339,"_3076":120665},[],{"_3624":74072,"_31170":74034,"_21595":124460,"_5":14857,"_28362":124339,"_3076":55233},[],{"_3624":74073,"_31170":74034,"_21595":124462,"_5":14857,"_28362":124339,"_3076":124463},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3624":74074,"_31170":74034,"_21595":124465,"_5":14857,"_28362":124339,"_3076":55239},[],{"_3624":74075,"_31170":74034,"_21595":124467,"_5":14857,"_28362":124339,"_3076":124468},[],"Registrar la CA en AWS IoT",{"_3624":74076,"_31170":74034,"_21595":124470,"_5":14857,"_28362":124339,"_3076":55245},[],{"_3624":74077,"_31170":74034,"_21595":124472,"_5":14857,"_28362":124339,"_3076":124473},[],"Consultar el estado del registro de la CA",{"_3624":74078,"_31170":74034,"_21595":124475,"_5":14857,"_28362":124339,"_3076":55251},[],{"_3624":74079,"_31170":74034,"_21595":124477,"_5":14857,"_28362":124339,"_3076":124478},[],"Crear o actualizar Things en IoT Core",{"_3624":74080,"_31170":74034,"_21595":124480,"_5":14857,"_28362":124339,"_3076":55257},[],{"_3624":74081,"_31170":74034,"_21595":124482,"_5":14857,"_28362":124339,"_3076":124483},[],"Aprovisionar Things mediante plantilla",{"_3624":74082,"_31170":74034,"_21595":124485,"_5":14857,"_28362":124339,"_3076":55263},[],{"_3624":74083,"_31170":74034,"_21595":124487,"_5":14857,"_28362":124339,"_3076":124488},[],"Registrar certificados de dispositivo",{"_3624":74084,"_31170":74034,"_21595":124490,"_5":14857,"_28362":124339,"_3076":55269},[],{"_3624":74085,"_31170":74034,"_21595":124492,"_5":14857,"_28362":124339,"_3076":124493},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3624":74086,"_31170":74034,"_21595":124495,"_5":14857,"_28362":124339,"_3076":55275},[],{"_3624":74087,"_31170":74034,"_21595":124497,"_5":14857,"_28362":124339,"_3076":124498},[],"Crear y adjuntar políticas IoT",{"_3624":74088,"_31170":74034,"_21595":124500,"_5":14857,"_28362":124339,"_3076":55281},[],{"_3624":74089,"_31170":74034,"_21595":124502,"_5":14857,"_28362":124339,"_3076":124503},[],"Gestionar grupos de Things",{"_3624":74090,"_31170":74034,"_21595":124505,"_5":14857,"_28362":124339,"_3076":55287},[],{"_3624":74091,"_31170":74034,"_21595":124507,"_5":14857,"_28362":124339,"_3076":124508},[],"Crear plantillas JITP",{"_3624":74092,"_31170":74034,"_21595":124510,"_5":14857,"_28362":124339,"_3076":55293},[],{"_3624":74093,"_31170":74034,"_21595":124512,"_5":14857,"_28362":124339,"_3076":124513},[],"Leer y escribir el Device Shadow",{"_3624":74094,"_31170":74034,"_21595":124515,"_5":14857,"_28362":124339,"_3076":124516},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3624":74095,"_31170":74034,"_21595":124518,"_5":14857,"_28362":124343,"_3076":124519},[],"Parámetro",{"_3624":74096,"_31170":74034,"_21595":124521,"_5":14857,"_28362":124343,"_3076":124522},[],"Tipo",{"_3624":74097,"_31170":74034,"_21595":124524,"_5":14857,"_28362":124343,"_3076":124525},[],"Requerido",{"_3624":74098,"_31170":74034,"_21595":124527,"_5":14857,"_28362":124343,"_3076":124528},[],"Descripción",{"_3624":74099,"_31170":74034,"_21595":124530,"_5":14857,"_28362":124343,"_3076":55314},[],{"_3624":74100,"_31170":74034,"_21595":124532,"_5":14857,"_28362":124343,"_3076":25781},[],{"_3624":74101,"_31170":74034,"_21595":124534,"_5":14857,"_28362":124343,"_3076":124535},[],"Sí",{"_3624":74102,"_31170":74034,"_21595":124537,"_5":14857,"_28362":124343,"_3076":124538},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3624":74103,"_31170":74034,"_21595":124540,"_5":14857,"_28362":124343,"_3076":55325},[],{"_3624":74104,"_31170":74034,"_21595":124542,"_5":14857,"_28362":124343,"_3076":25781},[],{"_3624":74105,"_31170":74034,"_21595":124544,"_5":14857,"_28362":124343,"_3076":124535},[],{"_3624":74106,"_31170":74034,"_21595":124546,"_5":14857,"_28362":124343,"_3076":124547},[],"Región AWS donde opera el conector.",{"_3624":74107,"_31170":74034,"_21595":124549,"_5":14857,"_28362":124343,"_3076":55335},[],{"_3624":74108,"_31170":74034,"_21595":124551,"_5":14857,"_28362":124343,"_3076":25781},[],{"_3624":74109,"_31170":74034,"_21595":124553,"_5":14857,"_28362":124343,"_3076":124535},[],{"_3624":74110,"_31170":74034,"_21595":124555,"_5":14857,"_28362":124343,"_3076":124556},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3624":74111,"_31170":74034,"_21595":124558,"_5":14857,"_28362":124343,"_3076":55345},[],{"_3624":74112,"_31170":74034,"_21595":124560,"_5":14857,"_28362":124343,"_3076":25781},[],{"_3624":74113,"_31170":74034,"_21595":124562,"_5":14857,"_28362":124343,"_3076":124563},[],"Solo con `auth_method=static`",{"_3624":74114,"_31170":74034,"_21595":124565,"_5":14857,"_28362":124343,"_3076":124566},[],"Clave de acceso AWS.",{"_3624":74115,"_31170":74034,"_21595":124568,"_5":14857,"_28362":124343,"_3076":55356},[],{"_3624":74116,"_31170":74034,"_21595":124570,"_5":14857,"_28362":124343,"_3076":25781},[],{"_3624":74117,"_31170":74034,"_21595":124572,"_5":14857,"_28362":124343,"_3076":124563},[],{"_3624":74118,"_31170":74034,"_21595":124574,"_5":14857,"_28362":124343,"_3076":124575},[],"Clave secreta AWS.",{"_3624":74119,"_31170":74034,"_21595":124577,"_5":14857,"_28362":124343,"_3076":55366},[],{"_3624":74120,"_31170":74034,"_21595":124579,"_5":14857,"_28362":124343,"_3076":25781},[],{"_3624":74121,"_31170":74034,"_21595":124581,"_5":14857,"_28362":124343,"_3076":55371},[],{"_3624":74122,"_31170":74034,"_21595":124583,"_5":14857,"_28362":124343,"_3076":124584},[],"Token de sesión (con `auth_method=static`).",{"_3624":74123,"_31170":74034,"_21595":124586,"_5":14857,"_28362":124343,"_3076":55377},[],{"_3624":74124,"_31170":74034,"_21595":124588,"_5":14857,"_28362":124343,"_3076":25781},[],{"_3624":74125,"_31170":74034,"_21595":124590,"_5":14857,"_28362":124343,"_3076":124591},[],"Solo con `auth_method=role`",{"_3624":74126,"_31170":74034,"_21595":124593,"_5":14857,"_28362":124343,"_3076":124594},[],"ARN del rol a asumir.",{"_3624":74127,"_31170":74034,"_21595":124596,"_5":14857,"_28362":124343,"_3076":55388},[],{"_3624":74128,"_31170":74034,"_21595":124598,"_5":14857,"_28362":124343,"_3076":25781},[],{"_3624":74129,"_31170":74034,"_21595":124600,"_5":14857,"_28362":124343,"_3076":55371},[],{"_3624":74130,"_31170":74034,"_21595":124602,"_5":14857,"_28362":124343,"_3076":124603},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3624":74131,"_31170":74034,"_21595":124605,"_5":14857,"_28362":124343,"_3076":55398},[],{"_3624":74132,"_31170":74034,"_21595":124607,"_5":14857,"_28362":124343,"_3076":92864},[],{"_3624":74133,"_31170":74034,"_21595":124609,"_5":14857,"_28362":124343,"_3076":124535},[],{"_3624":74134,"_31170":74034,"_21595":124611,"_5":14857,"_28362":124343,"_3076":124612},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3624":74135,"_31170":74034,"_21595":124614,"_5":14857,"_28362":124343,"_3076":55408},[],{"_3624":74136,"_31170":74034,"_21595":124616,"_5":14857,"_28362":124343,"_3076":25781},[],{"_3624":74137,"_31170":74034,"_21595":124618,"_5":14857,"_28362":124343,"_3076":124535},[],{"_3624":74138,"_31170":74034,"_21595":124620,"_5":14857,"_28362":124343,"_3076":124621},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3624":74139,"_31170":74034,"_21595":124623,"_5":14857,"_28362":124343,"_3076":55418},[],{"_3624":74140,"_31170":74034,"_21595":124625,"_5":14857,"_28362":124343,"_3076":25781},[],{"_3624":74141,"_31170":74034,"_21595":124627,"_5":14857,"_28362":124343,"_3076":124535},[],{"_3624":74142,"_31170":74034,"_21595":124629,"_5":14857,"_28362":124343,"_3076":124630},[],"URL HTTP del Device Manager de Lamassu.",{"_3624":74143,"_31170":74034,"_21595":124632,"_5":14857,"_28362":124343,"_3076":55428},[],{"_3624":74144,"_31170":74034,"_21595":124634,"_5":14857,"_28362":124343,"_3076":25781},[],{"_3624":74145,"_31170":74034,"_21595":124636,"_5":14857,"_28362":124343,"_3076":124535},[],{"_3624":74146,"_31170":74034,"_21595":124638,"_5":14857,"_28362":124343,"_3076":124639},[],"URL HTTP del servicio de CA de Lamassu.",{"_3624":74147,"_31170":74034,"_21595":124641,"_5":14857,"_28362":124347,"_3076":124642},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3624":74148,"_31170":74034,"_21595":124644,"_5":14857,"_28362":124347,"_3076":124645},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3624":74149,"_31170":74034,"_21595":124647,"_5":14857,"_28362":124347,"_3076":124648},[],"Tipo de CloudEvent",{"_3624":74150,"_31170":74034,"_21595":124650,"_5":14857,"_28362":124347,"_3076":124651},[],"Recurso en Lamassu",{"_3624":74151,"_31170":74034,"_21595":124653,"_5":14857,"_28362":124347,"_3076":124654},[],"Recurso AWS",{"_3624":74152,"_31170":74034,"_21595":124656,"_5":14857,"_28362":124347,"_3076":124657},[],"Acciones IAM",{"_3624":74153,"_31170":74034,"_21595":124659,"_5":14857,"_28362":124347,"_3076":124660},[],"Llamadas AWS y efecto",{"_3624":74154,"_31170":74034,"_21595":124662,"_5":14857,"_28362":124347,"_3076":124663},[],"Dónde en esta página",{"_3624":74155,"_31170":74034,"_21595":124665,"_5":14857,"_28362":124347,"_3076":55462},[],{"_3624":74156,"_31170":74034,"_21595":124667,"_5":14857,"_28362":124347,"_3076":55465},[],{"_3624":74157,"_31170":74034,"_21595":124669,"_5":14857,"_28362":124347,"_3076":55468},[],{"_3624":74158,"_31170":74034,"_21595":124671,"_5":14857,"_28362":124347,"_3076":55471},[],{"_3624":74159,"_31170":74034,"_21595":124673,"_5":14857,"_28362":124347,"_3076":124674},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3624":74160,"_31170":74034,"_21595":124676,"_5":14857,"_28362":124347,"_3076":124360},[],{"_3624":74161,"_31170":74034,"_21595":124678,"_5":14857,"_28362":124347,"_3076":55479},[],{"_3624":74162,"_31170":74034,"_21595":124680,"_5":14857,"_28362":124347,"_3076":55482},[],{"_3624":74163,"_31170":74034,"_21595":124682,"_5":14857,"_28362":124347,"_3076":55485},[],{"_3624":74164,"_31170":74034,"_21595":124684,"_5":14857,"_28362":124347,"_3076":55488},[],{"_3624":74165,"_31170":74034,"_21595":124686,"_5":14857,"_28362":124347,"_3076":124687},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3624":74166,"_31170":74034,"_21595":124689,"_5":14857,"_28362":124347,"_3076":124386},[],{"_3624":74167,"_31170":74034,"_21595":124691,"_5":14857,"_28362":124347,"_3076":55496},[],{"_3624":74168,"_31170":74034,"_21595":124693,"_5":14857,"_28362":124347,"_3076":124694},[],"Dispositivo",{"_3624":74169,"_31170":74034,"_21595":124696,"_5":14857,"_28362":124347,"_3076":55502},[],{"_3624":74170,"_31170":74034,"_21595":124698,"_5":14857,"_28362":124347,"_3076":55505},[],{"_3624":74171,"_31170":74034,"_21595":124700,"_5":14857,"_28362":124347,"_3076":124701},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3624":74172,"_31170":74034,"_21595":124703,"_5":14857,"_28362":124347,"_3076":124394},[],{"_3624":74173,"_31170":74034,"_21595":124705,"_5":14857,"_28362":124347,"_3076":55513},[],{"_3624":74174,"_31170":74034,"_21595":124707,"_5":14857,"_28362":124347,"_3076":124708},[],"Certificado",{"_3624":74175,"_31170":74034,"_21595":124710,"_5":14857,"_28362":124347,"_3076":55519},[],{"_3624":74176,"_31170":74034,"_21595":124712,"_5":14857,"_28362":124347,"_3076":124713},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3624":74177,"_31170":74034,"_21595":124715,"_5":14857,"_28362":124347,"_3076":124716},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3624":74178,"_31170":74034,"_21595":124718,"_5":14857,"_28362":124347,"_3076":124406},[],{"_3624":74179,"_31170":74034,"_21595":124720,"_5":14857,"_28362":124347,"_3076":55530},[],{"_3624":74180,"_31170":74034,"_21595":124722,"_5":14857,"_28362":124347,"_3076":124723},[],"Certificado / Dispositivo",{"_3624":74181,"_31170":74034,"_21595":124725,"_5":14857,"_28362":124347,"_3076":55536},[],{"_3624":74182,"_31170":74034,"_21595":124727,"_5":14857,"_28362":124347,"_3076":51333},[],{"_3624":74183,"_31170":74034,"_21595":124729,"_5":14857,"_28362":124347,"_3076":124730},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3624":74184,"_31170":74034,"_21595":124732,"_5":14857,"_28362":124347,"_3076":124414},[],{"_3624":74185,"_31170":74034,"_21595":124734,"_5":14857,"_28362":124351,"_3076":124735},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3624":74186,"_31170":74034,"_21595":124737,"_5":14857,"_28362":124355,"_3076":124738},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3624":74187,"_31170":74034,"_21595":124740,"_5":14857,"_28362":124355,"_3076":124741},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3624":74188,"_31170":74034,"_21595":124743,"_5":14857,"_28362":124359,"_3076":124744},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3624":74189,"_31170":74034,"_21595":124746,"_5":14857,"_28362":124359,"_3076":124747},[],"Transición",{"_3624":74190,"_31170":74034,"_21595":124749,"_5":14857,"_28362":124359,"_3076":124750},[],"Llamadas AWS",{"_3624":74191,"_31170":74034,"_21595":124752,"_5":14857,"_28362":124359,"_3076":124753},[],"`NoRegistrada` → `Solicitada`",{"_3624":74192,"_31170":74034,"_21595":124755,"_5":14857,"_28362":124359,"_3076":124756},[],"ninguna (solo escritura de metadatos)",{"_3624":74193,"_31170":74034,"_21595":124758,"_5":14857,"_28362":124359,"_3076":124759},[],"`Solicitada` → `Registrando`",{"_3624":74194,"_31170":74034,"_21595":124761,"_5":14857,"_28362":124359,"_3076":124762},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3624":74195,"_31170":74034,"_21595":124764,"_5":14857,"_28362":124359,"_3076":124765},[],"`Registrando` → `Completada`",{"_3624":74196,"_31170":74034,"_21595":124767,"_5":14857,"_28362":124359,"_3076":124768},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3624":74197,"_31170":74034,"_21595":124770,"_5":14857,"_28362":124359,"_3076":124771},[],"`Registrando` → `Fallida`",{"_3624":74198,"_31170":74034,"_21595":124773,"_5":14857,"_28362":124359,"_3076":124774},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3624":74199,"_31170":74034,"_21595":124776,"_5":14857,"_28362":124359,"_3076":124777},[],"`Fallida` / `Completada` → `Solicitada`",{"_3624":74200,"_31170":74034,"_21595":124779,"_5":14857,"_28362":124359,"_3076":124780},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3624":74201,"_31170":74034,"_21595":124782,"_5":14857,"_28362":124363,"_3076":124783},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3624":74202,"_31170":74034,"_21595":124785,"_5":14857,"_28362":124363,"_3076":124786},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3624":74203,"_31170":74034,"_21595":124788,"_5":14857,"_28362":124363,"_3076":124789},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3624":74204,"_31170":74034,"_21595":124791,"_5":14857,"_28362":124363,"_3076":124792},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3624":74205,"_31170":74034,"_21595":124794,"_5":14857,"_28362":124363,"_3076":124795},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3624":74206,"_31170":74034,"_21595":124797,"_5":14857,"_28362":124363,"_3076":124798},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3624":74207,"_31170":74034,"_21595":124800,"_5":14857,"_28362":124366,"_3076":124801},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3624":74208,"_31170":74034,"_21595":124803,"_5":14857,"_28362":124369,"_3076":124804},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3624":74209,"_31170":74034,"_21595":124806,"_5":14857,"_28362":124369,"_3076":124807},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3624":74210,"_31170":74034,"_21595":124809,"_5":14857,"_28362":124373,"_3076":124810},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3624":74211,"_31170":74034,"_21595":124812,"_5":14857,"_28362":124377,"_3076":124813},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3624":74212,"_31170":74034,"_21595":124815,"_5":14857,"_28362":124377,"_3076":124816},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3624":74213,"_31170":74034,"_21595":124818,"_5":14857,"_28362":124377,"_3076":124819},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3624":74214,"_31170":74034,"_21595":124821,"_5":14857,"_28362":124377,"_3076":124822},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3624":74215,"_31170":74034,"_21595":124824,"_5":14857,"_28362":124377,"_3076":124825},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3624":74216,"_31170":74034,"_21595":124827,"_5":14857,"_28362":124377,"_3076":124828},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3624":74217,"_31170":74034,"_21595":124830,"_5":14857,"_28362":124381,"_3076":124831},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3624":74218,"_31170":74034,"_21595":124833,"_5":14857,"_28362":124381,"_3076":124834},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3624":74219,"_31170":74034,"_21595":124836,"_5":14857,"_28362":124381,"_3076":124837},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3624":74220,"_31170":74034,"_21595":124839,"_5":14857,"_28362":124381,"_3076":124840},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3624":74221,"_31170":74034,"_21595":124842,"_5":14857,"_28362":124381,"_3076":124843},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3624":74222,"_31170":74034,"_21595":124845,"_5":14857,"_28362":124385,"_3076":124846},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3624":74223,"_31170":74034,"_21595":124848,"_5":14857,"_28362":124385,"_3076":124747},[],{"_3624":74224,"_31170":74034,"_21595":124850,"_5":14857,"_28362":124385,"_3076":124750},[],{"_3624":74225,"_31170":74034,"_21595":124852,"_5":14857,"_28362":124385,"_3076":124853},[],"`SinConfigurar` → `None` / `Auto`",{"_3624":74226,"_31170":74034,"_21595":124855,"_5":14857,"_28362":124385,"_3076":124856},[],"ninguna (solo configuración)",{"_3624":74227,"_31170":74034,"_21595":124858,"_5":14857,"_28362":124385,"_3076":55673},[],{"_3624":74228,"_31170":74034,"_21595":124860,"_5":14857,"_28362":124385,"_3076":124856},[],{"_3624":74229,"_31170":74034,"_21595":124862,"_5":14857,"_28362":124385,"_3076":124863},[],"Cualquiera → `Jitp`",{"_3624":74230,"_31170":74034,"_21595":124865,"_5":14857,"_28362":124385,"_3076":124866},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3624":74231,"_31170":74034,"_21595":124868,"_5":14857,"_28362":124385,"_3076":55684},[],{"_3624":74232,"_31170":74034,"_21595":124870,"_5":14857,"_28362":124385,"_3076":124871},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3624":74233,"_31170":74034,"_21595":124873,"_5":14857,"_28362":124389,"_3076":124874},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3624":74234,"_31170":74034,"_21595":124876,"_5":14857,"_28362":124389,"_3076":124877},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3624":74235,"_31170":74034,"_21595":124879,"_5":14857,"_28362":124389,"_3076":124880},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3624":74236,"_31170":74034,"_21595":124882,"_5":14857,"_28362":124393,"_3076":124883},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3624":74237,"_31170":74034,"_21595":124885,"_5":14857,"_28362":124393,"_3076":124747},[],{"_3624":74238,"_31170":74034,"_21595":124887,"_5":14857,"_28362":124393,"_3076":124750},[],{"_3624":74239,"_31170":74034,"_21595":124889,"_5":14857,"_28362":124393,"_3076":124890},[],"`Ausente` → `Aprovisionado`",{"_3624":74240,"_31170":74034,"_21595":124892,"_5":14857,"_28362":124393,"_3076":124893},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3624":74241,"_31170":74034,"_21595":124895,"_5":14857,"_28362":124393,"_3076":124896},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3624":74242,"_31170":74034,"_21595":124898,"_5":14857,"_28362":124393,"_3076":124899},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3624":74243,"_31170":74034,"_21595":124901,"_5":14857,"_28362":124393,"_3076":124902},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3624":74244,"_31170":74034,"_21595":124904,"_5":14857,"_28362":124397,"_3076":124905},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3624":74245,"_31170":74034,"_21595":124907,"_5":14857,"_28362":124397,"_3076":124908},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3624":74246,"_31170":74034,"_21595":124910,"_5":14857,"_28362":124397,"_3076":124911},[],"Para que el flujo JITP funcione correctamente:",{"_3624":74247,"_31170":74034,"_21595":124913,"_5":14857,"_28362":124397,"_3076":124914},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3624":74248,"_31170":74034,"_21595":124916,"_5":14857,"_28362":124397,"_3076":124917},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3624":74249,"_31170":74034,"_21595":124919,"_5":14857,"_28362":124397,"_3076":124920},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3624":74250,"_31170":74034,"_21595":124922,"_5":14857,"_28362":124397,"_3076":124923},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3624":74251,"_31170":74034,"_21595":124925,"_5":14857,"_28362":124401,"_3076":124926},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3624":74252,"_31170":74034,"_21595":124928,"_5":14857,"_28362":124401,"_3076":124929},[],"Estado en Lamassu",{"_3624":74253,"_31170":74034,"_21595":124931,"_5":14857,"_28362":124401,"_3076":124932},[],"Razón de revocación",{"_3624":74254,"_31170":74034,"_21595":124934,"_5":14857,"_28362":124401,"_3076":124935},[],"Estado en AWS IoT Core",{"_3624":74255,"_31170":74034,"_21595":124937,"_5":14857,"_28362":124401,"_3076":55754},[],{"_3624":74256,"_31170":74034,"_21595":124939,"_5":14857,"_28362":124401,"_3076":124940},[],"Ninguna",{"_3624":74257,"_31170":74034,"_21595":124942,"_5":14857,"_28362":124401,"_3076":55760},[],{"_3624":74258,"_31170":74034,"_21595":124944,"_5":14857,"_28362":124401,"_3076":55763},[],{"_3624":74259,"_31170":74034,"_21595":124946,"_5":14857,"_28362":124401,"_3076":55766},[],{"_3624":74260,"_31170":74034,"_21595":124948,"_5":14857,"_28362":124401,"_3076":55769},[],{"_3624":74261,"_31170":74034,"_21595":124950,"_5":14857,"_28362":124401,"_3076":55763},[],{"_3624":74262,"_31170":74034,"_21595":124952,"_5":14857,"_28362":124401,"_3076":124953},[],"Cualquier otra razón",{"_3624":74263,"_31170":74034,"_21595":124955,"_5":14857,"_28362":124401,"_3076":55777},[],{"_3624":74264,"_31170":74034,"_21595":124957,"_5":14857,"_28362":124401,"_3076":124958},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3624":74265,"_31170":74034,"_21595":124960,"_5":14857,"_28362":124405,"_3076":124961},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3624":74266,"_31170":74034,"_21595":124963,"_5":14857,"_28362":124405,"_3076":124747},[],{"_3624":74267,"_31170":74034,"_21595":124965,"_5":14857,"_28362":124405,"_3076":124750},[],{"_3624":74268,"_31170":74034,"_21595":124967,"_5":14857,"_28362":124405,"_3076":124968},[],"`NoSincronizado` → `Active`",{"_3624":74269,"_31170":74034,"_21595":124970,"_5":14857,"_28362":124405,"_3076":55269},[],{"_3624":74270,"_31170":74034,"_21595":124972,"_5":14857,"_28362":124405,"_3076":55795},[],{"_3624":74271,"_31170":74034,"_21595":124974,"_5":14857,"_28362":124405,"_3076":124975},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3624":74272,"_31170":74034,"_21595":124977,"_5":14857,"_28362":124405,"_3076":55801},[],{"_3624":74273,"_31170":74034,"_21595":124979,"_5":14857,"_28362":124405,"_3076":124975},[],{"_3624":74274,"_31170":74034,"_21595":124981,"_5":14857,"_28362":124405,"_3076":55806},[],{"_3624":74275,"_31170":74034,"_21595":124983,"_5":14857,"_28362":124405,"_3076":55269},[],{"_3624":74276,"_31170":74034,"_21595":124985,"_5":14857,"_28362":124405,"_3076":55811},[],{"_3624":74277,"_31170":74034,"_21595":124987,"_5":14857,"_28362":124405,"_3076":124988},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3624":74278,"_31170":74034,"_21595":124990,"_5":14857,"_28362":124409,"_3076":124991},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3624":74279,"_31170":74034,"_21595":124993,"_5":14857,"_28362":124409,"_3076":124994},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3624":74280,"_31170":74034,"_21595":124996,"_5":14857,"_28362":124409,"_3076":124997},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3624":74281,"_31170":74034,"_21595":124999,"_5":14857,"_28362":124413,"_3076":125000},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3624":74282,"_31170":74034,"_21595":125002,"_5":14857,"_28362":124413,"_3076":125003},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3624":74283,"_31170":74034,"_21595":125005,"_5":14857,"_28362":124417,"_3076":125006},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3624":74284,"_31170":74034,"_21595":125008,"_5":14857,"_28362":124417,"_3076":125009},[],"Existen dos tipos de acciones:",{"_3624":74285,"_31170":74034,"_21595":125011,"_5":14857,"_28362":124417,"_3076":125012},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3624":74286,"_31170":74034,"_21595":125014,"_5":14857,"_28362":124417,"_3076":125015},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3624":74287,"_31170":74034,"_21595":125017,"_5":14857,"_28362":124417,"_3076":125018},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3624":74288,"_31170":74034,"_21595":125020,"_5":14857,"_28362":124421,"_3076":125021},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3624":74289,"_31170":74034,"_21595":125023,"_5":14857,"_28362":124421,"_3076":125024},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3624":74290,"_31170":74034,"_21595":125026,"_5":14857,"_28362":124421,"_3076":125027},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3624":74291,"_31170":74034,"_21595":125029,"_5":14857,"_28362":124425,"_3076":125030},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3624":74292,"_31170":74034,"_21595":125032,"_5":14857,"_28362":124425,"_3076":125033},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3624":74293,"_31170":74034,"_21595":125035,"_5":14857,"_28362":124425,"_3076":125036},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3624":74294,"_31170":74034,"_21595":125038,"_5":14857,"_28362":124425,"_3076":125039},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3624":74295,"_31170":74034,"_21595":125041,"_5":14857,"_28362":124425,"_3076":125042},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3624":74296,"_31170":74034,"_21595":125044,"_5":14857,"_28362":124425,"_3076":125045},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3624":74297,"_31170":74034,"_21595":125047,"_5":14857,"_28362":124425,"_3076":125048},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3624":74298,"_31170":74034,"_21595":125050,"_5":14857,"_28362":124425,"_3076":125051},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3624":74299,"_31170":74034,"_21595":125053,"_5":14857,"_28362":124425,"_3076":125054},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3624":74300,"_31170":74034,"_21595":125056,"_5":14857,"_28362":124425,"_3076":125057},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3624":74301,"_31170":74034,"_21595":125059,"_5":14857,"_28362":124425,"_3076":125060},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3624":74302,"_31170":74034,"_21595":125062,"_5":14857,"_28362":124425,"_3076":125063},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3624":74303,"_31170":74034,"_21595":125065,"_5":14857,"_28362":124425,"_3076":125066},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3624":74304,"_31170":74034,"_21595":125068,"_5":14857,"_28362":124425,"_3076":125069},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3624":74305,"_31170":74034,"_21595":125071,"_5":14857,"_28362":124425,"_3076":125072},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3624":74306,"_31170":74034,"_21595":125074,"_5":14857,"_28362":124425,"_3076":125075},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3624":74307,"_31170":74034,"_21595":125077,"_5":14857,"_28362":124425,"_3076":125078},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3624":74308,"_31170":74034,"_21595":125080,"_5":14857,"_28362":124425,"_3076":125081},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3624":74309,"_31170":74034,"_21595":125083,"_5":14857,"_28362":124425,"_3076":125084},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3624":74310,"_31170":74034,"_21595":125086,"_5":14857,"_28362":124425,"_3076":125087},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3624":74311,"_31170":74034,"_21595":125089,"_5":14857,"_28362":124425,"_3076":125090},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3624":74312,"_31170":74034,"_21595":125092,"_5":14857,"_28362":124425,"_3076":125093},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":74313,"_31170":74034,"_21595":125095,"_5":14857,"_28362":124425,"_3076":125096},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3624":74314,"_31170":74034,"_21595":125098,"_5":14857,"_28362":124425,"_3076":125099},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3624":74315,"_31170":74315,"_5":15217,"_3076":53621,"_31528":125101,"_21595":125102,"_28362":74315},[50937,121761,53621],[],{"_3624":74316,"_31170":74315,"_21595":125104,"_5":14857,"_28362":74315,"_3076":125105},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3624":74317,"_31170":74315,"_5":31525,"_21595":125107,"_28362":125108,"_3076":125109},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3624":74318,"_31170":74315,"_5":31525,"_21595":125111,"_28362":125112,"_3076":122906},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3624":74319,"_31170":74315,"_5":31525,"_21595":125114,"_28362":125115,"_3076":123084},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3624":74320,"_31170":74315,"_5":31525,"_21595":125117,"_28362":125118,"_3076":124324},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/overview#integraciones",{"_3624":74321,"_31170":74315,"_5":31525,"_21595":125120,"_28362":125121,"_3076":125122},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3624":74322,"_31170":74315,"_21595":125124,"_5":14857,"_28362":74315,"_3076":125125},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3624":74323,"_31170":74315,"_21595":125127,"_5":14857,"_28362":125108,"_3076":125128},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3624":74324,"_31170":74315,"_21595":125130,"_5":14857,"_28362":125108,"_3076":125131},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3624":74325,"_31170":74315,"_21595":125133,"_5":14857,"_28362":125112,"_3076":125134},[],"Recurso",{"_3624":74326,"_31170":74315,"_21595":125136,"_5":14857,"_28362":125112,"_3076":125137},[],"Qué representa",{"_3624":74327,"_31170":74315,"_21595":125139,"_5":14857,"_28362":125112,"_3076":125140},[],"**Dispositivo**",{"_3624":74328,"_31170":74315,"_21595":125142,"_5":14857,"_28362":125112,"_3076":125143},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3624":74329,"_31170":74315,"_21595":125145,"_5":14857,"_28362":125112,"_3076":125146},[],"**Identidad**",{"_3624":74330,"_31170":74315,"_21595":125148,"_5":14857,"_28362":125112,"_3076":125149},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3624":74331,"_31170":74315,"_21595":125151,"_5":14857,"_28362":125112,"_3076":55978},[],{"_3624":74332,"_31170":74315,"_21595":125153,"_5":14857,"_28362":125112,"_3076":125154},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3624":74333,"_31170":74315,"_21595":125156,"_5":14857,"_28362":125112,"_3076":125157},[],"**Flota**",{"_3624":74334,"_31170":74315,"_21595":125159,"_5":14857,"_28362":125112,"_3076":125160},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3624":74335,"_31170":74315,"_21595":125162,"_5":14857,"_28362":125112,"_3076":125163},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3624":74336,"_31170":74315,"_21595":125165,"_5":14857,"_28362":125112,"_3076":125166},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3624":74337,"_31170":74315,"_21595":125168,"_5":14857,"_28362":125115,"_3076":125169},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3624":74338,"_31170":74315,"_21595":125171,"_5":14857,"_28362":125115,"_3076":125172},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3624":74339,"_31170":74315,"_21595":125174,"_5":14857,"_28362":125115,"_3076":125175},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3624":74340,"_31170":74315,"_21595":125177,"_5":14857,"_28362":125115,"_3076":125178},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3624":74341,"_31170":74315,"_21595":125180,"_5":14857,"_28362":125115,"_3076":125181},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3624":74342,"_31170":74315,"_21595":125183,"_5":14857,"_28362":125115,"_3076":125184},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3624":74343,"_31170":74315,"_21595":125186,"_5":14857,"_28362":125115,"_3076":125187},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":74344,"_31170":74315,"_21595":125189,"_5":14857,"_28362":125115,"_3076":125190},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3624":74345,"_31170":74315,"_21595":125192,"_5":14857,"_28362":125118,"_3076":125193},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3624":74346,"_31170":74315,"_21595":125195,"_5":14857,"_28362":125118,"_3076":125196},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3624":74347,"_31170":74315,"_21595":125198,"_5":14857,"_28362":125121,"_3076":125199},[],"Participante",{"_3624":74348,"_31170":74315,"_21595":125201,"_5":14857,"_28362":125121,"_3076":125202},[],"Responsabilidad",{"_3624":74349,"_31170":74315,"_21595":125204,"_5":14857,"_28362":125121,"_3076":125205},[],"Administrador PKI",{"_3624":74350,"_31170":74315,"_21595":125207,"_5":14857,"_28362":125121,"_3076":125208},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3624":74351,"_31170":74315,"_21595":125210,"_5":14857,"_28362":125121,"_3076":125211},[],"Administrador del aprovisionamiento",{"_3624":74352,"_31170":74315,"_21595":125213,"_5":14857,"_28362":125121,"_3076":125214},[],"DMS, admisión, autenticación por operación e inventario.",{"_3624":74353,"_31170":74315,"_21595":125216,"_5":14857,"_28362":125121,"_3076":125217},[],"Integrador del dispositivo",{"_3624":74354,"_31170":74315,"_21595":125219,"_5":14857,"_28362":125121,"_3076":125220},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3624":74355,"_31170":74315,"_21595":125222,"_5":14857,"_28362":125121,"_3076":125223},[],"Integrador del consumidor",{"_3624":74356,"_31170":74315,"_21595":125225,"_5":14857,"_28362":125121,"_3076":125226},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3624":74357,"_31170":74315,"_21595":125228,"_5":14857,"_28362":125121,"_3076":125229},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3624":74358,"_31170":74358,"_5":15217,"_3076":125231,"_31528":125232,"_21595":125234,"_28362":74358},"Enrola y conecta tu primer dispositivo",[50937,121761,53621,125233],"Primeros pasos",[],{"_3624":74359,"_31170":74358,"_21595":125236,"_5":14857,"_28362":74358,"_3076":125237},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3624":74360,"_31170":74358,"_5":31525,"_21595":125239,"_28362":125240,"_3076":120295},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3624":74361,"_31170":74358,"_5":31525,"_21595":125242,"_28362":125243,"_3076":125244},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3624":74362,"_31170":74358,"_5":31525,"_21595":125246,"_28362":125247,"_3076":125248},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3624":74363,"_31170":74358,"_5":31525,"_21595":125250,"_28362":125251,"_3076":125252},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3624":74364,"_31170":74358,"_5":31525,"_21595":125254,"_28362":125255,"_3076":125256},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3624":74365,"_31170":74358,"_5":31525,"_21595":125258,"_28362":125259,"_3076":125260},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3624":74366,"_31170":74358,"_5":31525,"_21595":125262,"_28362":125263,"_3076":125264},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3624":74367,"_31170":74358,"_5":31525,"_21595":125266,"_28362":125267,"_3076":125268},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3624":74368,"_31170":74358,"_21595":125270,"_5":14857,"_28362":74358,"_3076":125271},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3624":74369,"_31170":74358,"_21595":125273,"_5":14857,"_28362":125240,"_3076":125274},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3624":74370,"_31170":74358,"_21595":125276,"_5":14857,"_28362":125240,"_3076":125277},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3624":74371,"_31170":74358,"_21595":125279,"_5":14857,"_28362":125240,"_3076":125280},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3624":74372,"_31170":74358,"_21595":125282,"_5":14857,"_28362":125240,"_3076":125283},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3624":74373,"_31170":74358,"_21595":125285,"_5":14857,"_28362":125240,"_3076":125286},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3624":74374,"_31170":74358,"_21595":125288,"_5":14857,"_28362":125243,"_3076":125289},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3624":74375,"_31170":74358,"_21595":125291,"_5":14857,"_28362":125243,"_3076":125292},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3624":74376,"_31170":74358,"_21595":125294,"_5":14857,"_28362":125247,"_3076":125295},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3624":74377,"_31170":74358,"_21595":125297,"_5":14857,"_28362":125247,"_3076":125298},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3624":74378,"_31170":74358,"_21595":125300,"_5":14857,"_28362":125247,"_3076":125301},[],"Ajuste",{"_3624":74379,"_31170":74358,"_21595":125303,"_5":14857,"_28362":125247,"_3076":125304},[],"Valor de evaluación",{"_3624":74380,"_31170":74358,"_21595":125306,"_5":14857,"_28362":125247,"_3076":56134},[],{"_3624":74381,"_31170":74358,"_21595":125308,"_5":14857,"_28362":125247,"_3076":125309},[],"Raíz emisora de `device-root.pem`.",{"_3624":74382,"_31170":74358,"_21595":125311,"_5":14857,"_28362":125247,"_3076":123218},[],{"_3624":74383,"_31170":74358,"_21595":125313,"_5":14857,"_28362":125247,"_3076":125314},[],"Perfil final de 1 hora que acabas de preparar.",{"_3624":74384,"_31170":74358,"_21595":125316,"_5":14857,"_28362":125247,"_3076":56145},[],{"_3624":74385,"_31170":74358,"_21595":125318,"_5":14857,"_28362":125247,"_3076":56148},[],{"_3624":74386,"_31170":74358,"_21595":125320,"_5":14857,"_28362":125247,"_3076":56151},[],{"_3624":74387,"_31170":74358,"_21595":125322,"_5":14857,"_28362":125247,"_3076":125323},[],"Habilitado.",{"_3624":74388,"_31170":74358,"_21595":125325,"_5":14857,"_28362":125247,"_3076":56157},[],{"_3624":74389,"_31170":74358,"_21595":125327,"_5":14857,"_28362":125247,"_3076":125328},[],"Deshabilitado; el ID debe ser nuevo.",{"_3624":74390,"_31170":74358,"_21595":125330,"_5":14857,"_28362":125247,"_3076":125331},[],"Autenticación inicial",{"_3624":74391,"_31170":74358,"_21595":125333,"_5":14857,"_28362":125247,"_3076":125334},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3624":74392,"_31170":74358,"_21595":125336,"_5":14857,"_28362":125247,"_3076":125337},[],"Autenticación de renovación",{"_3624":74393,"_31170":74358,"_21595":125339,"_5":14857,"_28362":125247,"_3076":125340},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3624":74394,"_31170":74358,"_21595":125342,"_5":14857,"_28362":125247,"_3076":56175},[],{"_3624":74395,"_31170":74358,"_21595":125344,"_5":14857,"_28362":125247,"_3076":125345},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3624":74396,"_31170":74358,"_21595":125347,"_5":14857,"_28362":125247,"_3076":56181},[],{"_3624":74397,"_31170":74358,"_21595":125349,"_5":14857,"_28362":125247,"_3076":125350},[],"1 hora.",{"_3624":74398,"_31170":74358,"_21595":125352,"_5":14857,"_28362":125247,"_3076":56187},[],{"_3624":74399,"_31170":74358,"_21595":125354,"_5":14857,"_28362":125247,"_3076":125355},[],"30 minutos / 10 minutos.",{"_3624":74400,"_31170":74358,"_21595":125357,"_5":14857,"_28362":125247,"_3076":56193},[],{"_3624":74401,"_31170":74358,"_21595":125359,"_5":14857,"_28362":125247,"_3076":125360},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3624":74402,"_31170":74358,"_21595":125362,"_5":14857,"_28362":125247,"_3076":53949},[],{"_3624":74403,"_31170":74358,"_21595":125364,"_5":14857,"_28362":125247,"_3076":125365},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3624":74404,"_31170":74358,"_21595":125367,"_5":14857,"_28362":125247,"_3076":56204},[],{"_3624":74405,"_31170":74358,"_21595":125369,"_5":14857,"_28362":125247,"_3076":125370},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3624":74406,"_31170":74358,"_21595":125372,"_5":14857,"_28362":125247,"_3076":125373},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3624":74407,"_31170":74358,"_21595":125375,"_5":14857,"_28362":125251,"_3076":125376},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3624":74408,"_31170":74358,"_21595":125378,"_5":14857,"_28362":125251,"_3076":125379},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3624":74409,"_31170":74358,"_21595":125381,"_5":14857,"_28362":125255,"_3076":125382},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3624":74410,"_31170":74358,"_21595":125384,"_5":14857,"_28362":125255,"_3076":125385},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3624":74411,"_31170":74358,"_21595":125387,"_5":14857,"_28362":125255,"_3076":125388},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3624":74412,"_31170":74358,"_21595":125390,"_5":14857,"_28362":125259,"_3076":125391},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3624":74413,"_31170":74358,"_21595":125393,"_5":14857,"_28362":125259,"_3076":125394},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3624":74414,"_31170":74358,"_21595":125396,"_5":14857,"_28362":125263,"_3076":125397},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3624":74415,"_31170":74358,"_21595":125399,"_5":14857,"_28362":125263,"_3076":125400},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3624":74416,"_31170":74358,"_21595":125402,"_5":14857,"_28362":125263,"_3076":125403},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3624":74417,"_31170":74358,"_21595":125405,"_5":14857,"_28362":125263,"_3076":125406},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3624":74418,"_31170":74358,"_21595":125408,"_5":14857,"_28362":125263,"_3076":125409},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3624":74419,"_31170":74358,"_21595":125411,"_5":14857,"_28362":125267,"_3076":125412},[],"Comprobación",{"_3624":74420,"_31170":74358,"_21595":125414,"_5":14857,"_28362":125267,"_3076":125415},[],"Resultado esperado",{"_3624":74421,"_31170":74358,"_21595":125417,"_5":14857,"_28362":125267,"_3076":125418},[],"Registro",{"_3624":74422,"_31170":74358,"_21595":125420,"_5":14857,"_28362":125267,"_3076":125421},[],"ID creado automáticamente y DMS correcto.",{"_3624":74423,"_31170":74358,"_21595":125423,"_5":14857,"_28362":125267,"_3076":124708},[],{"_3624":74424,"_31170":74358,"_21595":125425,"_5":14857,"_28362":125267,"_3076":125426},[],"CN, perfil, serie y clave verificados.",{"_3624":74425,"_31170":74358,"_21595":125428,"_5":14857,"_28362":125267,"_3076":125429},[],"Inventario",{"_3624":74426,"_31170":74358,"_21595":125431,"_5":14857,"_28362":125267,"_3076":125432},[],"Serie recibida visible como identidad actual y en el historial.",{"_3624":74427,"_31170":74358,"_21595":125434,"_5":14857,"_28362":125267,"_3076":125435},[],"Consumidor",{"_3624":74428,"_31170":74358,"_21595":125437,"_5":14857,"_28362":125267,"_3076":125438},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3624":74429,"_31170":74358,"_21595":125440,"_5":14857,"_28362":125267,"_3076":125441},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3624":74430,"_31170":74358,"_21595":125443,"_5":14857,"_28362":125267,"_3076":125444},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3624":74431,"_31170":74431,"_5":15217,"_3076":122923,"_31528":125446,"_21595":125447,"_28362":74431},[50937,121761,53621,125233],[],{"_3624":74432,"_31170":74431,"_21595":125449,"_5":14857,"_28362":74431,"_3076":125450},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3624":74433,"_31170":74431,"_5":31525,"_21595":125452,"_28362":125453,"_3076":120295},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3624":74434,"_31170":74431,"_5":31525,"_21595":125455,"_28362":125456,"_3076":125457},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3624":74435,"_31170":74431,"_5":31525,"_21595":125459,"_28362":125460,"_3076":125461},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3624":74436,"_31170":74431,"_5":31525,"_21595":125463,"_28362":125464,"_3076":125465},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3624":74437,"_31170":74431,"_5":31525,"_21595":125467,"_28362":125468,"_3076":125469},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3624":74438,"_31170":74431,"_5":31525,"_21595":125471,"_28362":125472,"_3076":125473},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3624":74439,"_31170":74431,"_5":31525,"_21595":125475,"_28362":125476,"_3076":125415},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3624":74440,"_31170":74431,"_5":31525,"_21595":125478,"_28362":125479,"_3076":125480},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3624":74441,"_31170":74431,"_5":31525,"_21595":125482,"_28362":125483,"_3076":125484},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3624":74442,"_31170":74431,"_21595":125486,"_5":14857,"_28362":74431,"_3076":125487},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3624":74443,"_31170":74431,"_21595":125489,"_5":14857,"_28362":74431,"_3076":125490},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3624":74444,"_31170":74431,"_21595":125492,"_5":14857,"_28362":125453,"_3076":125493},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3624":74445,"_31170":74431,"_21595":125495,"_5":14857,"_28362":125453,"_3076":125496},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3624":74446,"_31170":74431,"_21595":125498,"_5":14857,"_28362":125453,"_3076":125499},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3624":74447,"_31170":74431,"_21595":125501,"_5":14857,"_28362":125453,"_3076":125502},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3624":74448,"_31170":74431,"_21595":125504,"_5":14857,"_28362":125456,"_3076":125505},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3624":74449,"_31170":74431,"_21595":125507,"_5":14857,"_28362":125456,"_3076":125508},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3624":74450,"_31170":74431,"_21595":125510,"_5":14857,"_28362":125456,"_3076":125511},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3624":74451,"_31170":74431,"_21595":125513,"_5":14857,"_28362":125456,"_3076":125514},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3624":74452,"_31170":74431,"_21595":125516,"_5":14857,"_28362":125456,"_3076":125517},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3624":74453,"_31170":74431,"_21595":125519,"_5":14857,"_28362":125456,"_3076":125520},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3624":74454,"_31170":74431,"_21595":125522,"_5":14857,"_28362":125456,"_3076":125523},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3624":74455,"_31170":74431,"_21595":125525,"_5":14857,"_28362":125456,"_3076":125526},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3624":74456,"_31170":74431,"_21595":125528,"_5":14857,"_28362":125460,"_3076":125529},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3624":74457,"_31170":74431,"_21595":125531,"_5":14857,"_28362":125460,"_3076":56369},[],{"_3624":74458,"_31170":74431,"_21595":125533,"_5":14857,"_28362":125460,"_3076":125534},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3624":74459,"_31170":74431,"_21595":125536,"_5":14857,"_28362":125460,"_3076":125537},[],"**Icon** y **Tags**: clasificación opcional.",{"_3624":74460,"_31170":74431,"_21595":125539,"_5":14857,"_28362":125460,"_3076":125540},[],"Confirma el registro.",{"_3624":74461,"_31170":74431,"_21595":125542,"_5":14857,"_28362":125464,"_3076":125543},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3624":74462,"_31170":74431,"_21595":125545,"_5":14857,"_28362":125464,"_3076":125546},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3624":74463,"_31170":74431,"_21595":125548,"_5":14857,"_28362":125468,"_3076":125549},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3624":74464,"_31170":74431,"_21595":125551,"_5":14857,"_28362":125468,"_3076":125552},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3624":74465,"_31170":74431,"_21595":125554,"_5":14857,"_28362":125472,"_3076":125555},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3624":74466,"_31170":74431,"_21595":125557,"_5":14857,"_28362":125472,"_3076":125558},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3624":74467,"_31170":74431,"_21595":125560,"_5":14857,"_28362":125476,"_3076":125412},[],{"_3624":74468,"_31170":74431,"_21595":125562,"_5":14857,"_28362":125476,"_3076":125563},[],"Resultado",{"_3624":74469,"_31170":74431,"_21595":125565,"_5":14857,"_28362":125476,"_3076":124694},[],{"_3624":74470,"_31170":74431,"_21595":125567,"_5":14857,"_28362":125476,"_3076":125568},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3624":74471,"_31170":74431,"_21595":125570,"_5":14857,"_28362":125476,"_3076":125571},[],"Identidad actual",{"_3624":74472,"_31170":74431,"_21595":125573,"_5":14857,"_28362":125476,"_3076":125574},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3624":74473,"_31170":74431,"_21595":125576,"_5":14857,"_28362":125476,"_3076":125577},[],"Historial",{"_3624":74474,"_31170":74431,"_21595":125579,"_5":14857,"_28362":125476,"_3076":125580},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3624":74475,"_31170":74431,"_21595":125582,"_5":14857,"_28362":125476,"_3076":125583},[],"Clave y certificado",{"_3624":74476,"_31170":74431,"_21595":125585,"_5":14857,"_28362":125476,"_3076":125586},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3624":74477,"_31170":74431,"_21595":125588,"_5":14857,"_28362":125479,"_3076":125589},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3624":74478,"_31170":74431,"_21595":125591,"_5":14857,"_28362":125479,"_3076":125592},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3624":74479,"_31170":74431,"_21595":125594,"_5":14857,"_28362":125479,"_3076":125595},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3624":74480,"_31170":74431,"_21595":125597,"_5":14857,"_28362":125479,"_3076":125598},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3624":74481,"_31170":74431,"_21595":125600,"_5":14857,"_28362":125483,"_3076":125601},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3624":74482,"_31170":74431,"_21595":125603,"_5":14857,"_28362":125483,"_3076":125604},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3624":74483,"_31170":74431,"_21595":125606,"_5":14857,"_28362":125483,"_3076":125607},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3624":74484,"_31170":74484,"_5":15217,"_3076":125609,"_31528":125610,"_21595":125611,"_28362":74484},"Plataforma Lamassu IoT",[50937,121761],[],{"_3624":74485,"_31170":74484,"_21595":125613,"_5":14857,"_28362":74484,"_3076":125614},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3624":74486,"_31170":74484,"_5":31525,"_21595":125616,"_28362":125617,"_3076":125109},[],"/docs/pr-preview/pr-76/es/platform/overview#empieza-aquí",{"_3624":74487,"_31170":74484,"_5":31525,"_21595":125619,"_28362":125620,"_3076":125621},[],"/docs/pr-preview/pr-76/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3624":74488,"_31170":74484,"_5":31525,"_21595":125623,"_28362":125624,"_3076":125625},[],"/docs/pr-preview/pr-76/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3624":74489,"_31170":74484,"_5":31525,"_21595":125627,"_28362":125628,"_3076":125629},[],"/docs/pr-preview/pr-76/es/platform/overview#capacidades-principales","Capacidades principales",{"_3624":74490,"_31170":74484,"_5":31525,"_21595":125631,"_28362":125632,"_3076":125633},[],"/docs/pr-preview/pr-76/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3624":74491,"_31170":74484,"_5":31525,"_21595":125635,"_28362":125636,"_3076":125637},[],"/docs/pr-preview/pr-76/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3624":74492,"_31170":74484,"_5":31525,"_21595":125639,"_28362":125640,"_3076":125641},[],"/docs/pr-preview/pr-76/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3624":74493,"_31170":74484,"_5":31525,"_21595":125643,"_28362":125644,"_3076":125645},[],"/docs/pr-preview/pr-76/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3624":74494,"_31170":74484,"_5":31525,"_21595":125647,"_28362":125648,"_3076":125649},[],"/docs/pr-preview/pr-76/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3624":74495,"_31170":74484,"_5":31525,"_21595":125651,"_28362":125652,"_3076":125653},[],"/docs/pr-preview/pr-76/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3624":74496,"_31170":74484,"_5":31525,"_21595":125655,"_28362":125656,"_3076":125657},[],"/docs/pr-preview/pr-76/es/platform/overview#referencia-operativa","Referencia operativa",{"_3624":74497,"_31170":74484,"_21595":125659,"_5":14857,"_28362":74484,"_3076":125660},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3624":74498,"_31170":74484,"_21595":125662,"_5":14857,"_28362":125617,"_3076":125663},[],"Elige el resultado que necesitas obtener:",{"_3624":74499,"_31170":74484,"_21595":125665,"_5":14857,"_28362":125617,"_3076":125666},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3624":74500,"_31170":74484,"_21595":125668,"_5":14857,"_28362":125617,"_3076":125669},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3624":74501,"_31170":74484,"_21595":125671,"_5":14857,"_28362":125617,"_3076":125672},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3624":74502,"_31170":74484,"_21595":125674,"_5":14857,"_28362":125620,"_3076":125675},[],"Bloque",{"_3624":74503,"_31170":74484,"_21595":125677,"_5":14857,"_28362":125620,"_3076":125678},[],"Qué gestionas",{"_3624":74504,"_31170":74484,"_21595":125680,"_5":14857,"_28362":125620,"_3076":125681},[],"Punto de entrada",{"_3624":74505,"_31170":74484,"_21595":125683,"_5":14857,"_28362":125620,"_3076":56522},[],{"_3624":74506,"_31170":74484,"_21595":125685,"_5":14857,"_28362":125620,"_3076":125686},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3624":74507,"_31170":74484,"_21595":125688,"_5":14857,"_28362":125620,"_3076":125689},[],"Visión general de PKI",{"_3624":74508,"_31170":74484,"_21595":125691,"_5":14857,"_28362":125620,"_3076":56531},[],{"_3624":74509,"_31170":74484,"_21595":125693,"_5":14857,"_28362":125620,"_3076":125694},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3624":74510,"_31170":74484,"_21595":125696,"_5":14857,"_28362":125620,"_3076":125697},[],"Visión general de IoT Fleets",{"_3624":74511,"_31170":74484,"_21595":125699,"_5":14857,"_28362":125620,"_3076":125700},[],"**Administración**",{"_3624":74512,"_31170":74484,"_21595":125702,"_5":14857,"_28362":125620,"_3076":125703},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3624":74513,"_31170":74484,"_21595":125705,"_5":14857,"_28362":125620,"_3076":121763},[],{"_3624":74514,"_31170":74484,"_21595":125707,"_5":14857,"_28362":125620,"_3076":125708},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3624":74515,"_31170":74484,"_21595":125710,"_5":14857,"_28362":125624,"_3076":125711},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3624":74516,"_31170":74484,"_21595":125713,"_5":14857,"_28362":125624,"_3076":125714},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3624":74517,"_31170":74484,"_21595":125716,"_5":14857,"_28362":125624,"_3076":125717},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3624":74518,"_31170":74484,"_21595":125719,"_5":14857,"_28362":125624,"_3076":125720},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3624":74519,"_31170":74484,"_21595":125722,"_5":14857,"_28362":125624,"_3076":125723},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3624":74520,"_31170":74484,"_21595":125725,"_5":14857,"_28362":125624,"_3076":125726},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3624":74521,"_31170":74484,"_21595":125728,"_5":14857,"_28362":125632,"_3076":125729},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3624":74522,"_31170":74484,"_21595":125731,"_5":14857,"_28362":125636,"_3076":125732},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3624":74523,"_31170":74484,"_21595":125734,"_5":14857,"_28362":125640,"_3076":125735},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3624":74524,"_31170":74484,"_21595":125737,"_5":14857,"_28362":125644,"_3076":125738},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3624":74525,"_31170":74484,"_21595":125740,"_5":14857,"_28362":125648,"_3076":125741},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3624":74526,"_31170":74484,"_21595":125743,"_5":14857,"_28362":125652,"_3076":125744},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3624":74527,"_31170":74484,"_21595":125746,"_5":14857,"_28362":125656,"_3076":125202},[],{"_3624":74528,"_31170":74484,"_21595":125748,"_5":14857,"_28362":125656,"_3076":125749},[],"Qué prepara o comprueba",{"_3624":74529,"_31170":74484,"_21595":125751,"_5":14857,"_28362":125656,"_3076":125205},[],{"_3624":74530,"_31170":74484,"_21595":125753,"_5":14857,"_28362":125656,"_3076":125754},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3624":74531,"_31170":74484,"_21595":125756,"_5":14857,"_28362":125656,"_3076":125757},[],"Administrador de la flota",{"_3624":74532,"_31170":74484,"_21595":125759,"_5":14857,"_28362":125656,"_3076":125760},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3624":74533,"_31170":74484,"_21595":125762,"_5":14857,"_28362":125656,"_3076":125217},[],{"_3624":74534,"_31170":74484,"_21595":125764,"_5":14857,"_28362":125656,"_3076":125765},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3624":74535,"_31170":74484,"_21595":125767,"_5":14857,"_28362":125656,"_3076":125223},[],{"_3624":74536,"_31170":74484,"_21595":125769,"_5":14857,"_28362":125656,"_3076":125770},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3624":74537,"_31170":74484,"_21595":125772,"_5":14857,"_28362":125656,"_3076":125773},[],"Operador de infraestructura",{"_3624":74538,"_31170":74484,"_21595":125775,"_5":14857,"_28362":125656,"_3076":125776},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3624":74539,"_31170":74484,"_21595":125778,"_5":14857,"_28362":125656,"_3076":125779},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3624":74540,"_31170":74540,"_5":15217,"_3076":125781,"_31528":125782,"_21595":125784,"_28362":74540},"Jerarquía y rotación de CAs",[50937,121761,56623,125783],"Claves, autoridades y certificados",[],{"_3624":74541,"_31170":74540,"_21595":125786,"_5":14857,"_28362":74540,"_3076":125787},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3624":74542,"_31170":74540,"_5":31525,"_21595":125789,"_28362":125790,"_3076":125791},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3624":74543,"_31170":74540,"_5":31525,"_21595":125793,"_28362":125794,"_3076":125795},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3624":74544,"_31170":74540,"_5":31525,"_21595":125797,"_28362":125798,"_3076":125799},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3624":74545,"_31170":74540,"_5":31525,"_21595":125801,"_28362":125802,"_3076":125803},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3624":74546,"_31170":74540,"_5":31525,"_21595":125805,"_28362":125806,"_3076":125807},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3624":74547,"_31170":74540,"_5":31525,"_21595":125809,"_28362":125810,"_3076":125811},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3624":74548,"_31170":74540,"_5":31525,"_21595":125813,"_28362":125814,"_3076":125815},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3624":74549,"_31170":74540,"_5":31525,"_21595":125817,"_28362":125818,"_3076":125819},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3624":74550,"_31170":74540,"_5":31525,"_21595":125821,"_28362":125822,"_3076":125823},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3624":74551,"_31170":74540,"_5":31525,"_21595":125825,"_28362":125826,"_3076":125827},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3624":74552,"_31170":74540,"_5":31525,"_21595":125829,"_28362":125830,"_3076":125831},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3624":74553,"_31170":74540,"_5":31525,"_21595":125833,"_28362":125834,"_3076":125835},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3624":74554,"_31170":74540,"_21595":125837,"_5":14857,"_28362":74540,"_3076":125838},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3624":74555,"_31170":74540,"_21595":125840,"_5":14857,"_28362":74540,"_3076":125841},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3624":74556,"_31170":74540,"_21595":125843,"_5":14857,"_28362":125790,"_3076":125844},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3624":74557,"_31170":74540,"_21595":125846,"_5":14857,"_28362":125790,"_3076":125847},[],"entorno, como producción y preproducción;",{"_3624":74558,"_31170":74540,"_21595":125849,"_5":14857,"_28362":125790,"_3076":125850},[],"propietario o equipo operador;",{"_3624":74559,"_31170":74540,"_21595":125852,"_5":14857,"_28362":125790,"_3076":125853},[],"familia de dispositivos o proceso de fabricación;",{"_3624":74560,"_31170":74540,"_21595":125855,"_5":14857,"_28362":125790,"_3076":125856},[],"región o requisito regulatorio;",{"_3624":74561,"_31170":74540,"_21595":125858,"_5":14857,"_28362":125790,"_3076":125859},[],"motor criptográfico o política de clave;",{"_3624":74562,"_31170":74540,"_21595":125861,"_5":14857,"_28362":125790,"_3076":125862},[],"ventana de mantenimiento y ritmo de renovación.",{"_3624":74563,"_31170":74540,"_21595":125864,"_5":14857,"_28362":125790,"_3076":125865},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3624":74564,"_31170":74540,"_21595":125867,"_5":14857,"_28362":125790,"_3076":125868},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3624":74565,"_31170":74540,"_21595":125870,"_5":14857,"_28362":125794,"_3076":125871},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3624":74566,"_31170":74540,"_21595":125873,"_5":14857,"_28362":125794,"_3076":125874},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3624":74567,"_31170":74540,"_21595":125876,"_5":14857,"_28362":125794,"_3076":125877},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3624":74568,"_31170":74540,"_21595":125879,"_5":14857,"_28362":125794,"_3076":125880},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3624":74569,"_31170":74540,"_21595":125882,"_5":14857,"_28362":125798,"_3076":125883},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3624":74570,"_31170":74540,"_21595":125885,"_5":14857,"_28362":125798,"_3076":125886},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3624":74571,"_31170":74540,"_21595":125888,"_5":14857,"_28362":125798,"_3076":125889},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3624":74572,"_31170":74540,"_21595":125891,"_5":14857,"_28362":125798,"_3076":125892},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3624":74573,"_31170":74540,"_21595":125894,"_5":14857,"_28362":125806,"_3076":125895},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3624":74574,"_31170":74540,"_21595":125897,"_5":14857,"_28362":125810,"_3076":125898},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3624":74575,"_31170":74540,"_21595":125900,"_5":14857,"_28362":125814,"_3076":125901},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3624":74576,"_31170":74540,"_21595":125903,"_5":14857,"_28362":125818,"_3076":125904},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3624":74577,"_31170":74540,"_21595":125906,"_5":14857,"_28362":125822,"_3076":125907},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3624":74578,"_31170":74540,"_21595":125909,"_5":14857,"_28362":125826,"_3076":125910},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3624":74579,"_31170":74540,"_21595":125912,"_5":14857,"_28362":125830,"_3076":125913},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3624":74580,"_31170":74540,"_21595":125915,"_5":14857,"_28362":125830,"_3076":125916},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3624":74581,"_31170":74540,"_21595":125918,"_5":14857,"_28362":125830,"_3076":125919},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3624":74582,"_31170":74540,"_21595":125921,"_5":14857,"_28362":125830,"_3076":125922},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3624":74583,"_31170":74540,"_21595":125924,"_5":14857,"_28362":125834,"_3076":125925},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3624":74584,"_31170":74540,"_21595":125927,"_5":14857,"_28362":125834,"_3076":125928},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3624":74585,"_31170":74540,"_21595":125930,"_5":14857,"_28362":125834,"_3076":125931},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3624":74586,"_31170":74540,"_21595":125933,"_5":14857,"_28362":125834,"_3076":125934},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3624":74587,"_31170":74540,"_21595":125936,"_5":14857,"_28362":125834,"_3076":125937},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3624":74588,"_31170":74540,"_21595":125939,"_5":14857,"_28362":125834,"_3076":125940},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3624":74589,"_31170":74540,"_21595":125942,"_5":14857,"_28362":125834,"_3076":125943},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3624":74590,"_31170":74590,"_5":15217,"_3076":125945,"_31528":125946,"_21595":125947,"_28362":74590},"Autoridades de certificación",[50937,121761,56623,125783],[],{"_3624":74591,"_31170":74590,"_21595":125949,"_5":14857,"_28362":74590,"_3076":125950},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3624":74592,"_31170":74590,"_5":31525,"_21595":125952,"_28362":125953,"_3076":125954},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3624":74593,"_31170":74590,"_5":31525,"_21595":125956,"_28362":125957,"_3076":125958},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3624":74594,"_31170":74590,"_5":31525,"_21595":125960,"_28362":125961,"_3076":120295},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3624":74595,"_31170":74590,"_5":31525,"_21595":125963,"_28362":125964,"_3076":125965},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3624":74596,"_31170":74590,"_5":31525,"_21595":125967,"_28362":125968,"_3076":125969},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3624":74597,"_31170":74590,"_5":31525,"_21595":125971,"_28362":125972,"_3076":125973},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3624":74598,"_31170":74590,"_5":31525,"_21595":125975,"_28362":125976,"_3076":125977},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3624":74599,"_31170":74590,"_5":31525,"_21595":125979,"_28362":125980,"_3076":125981},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3624":74600,"_31170":74590,"_5":31525,"_21595":125983,"_28362":125984,"_3076":125985},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3624":74601,"_31170":74590,"_5":31525,"_21595":125987,"_28362":125988,"_3076":125989},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3624":74602,"_31170":74590,"_5":31525,"_21595":125991,"_28362":125992,"_3076":125993},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3624":74603,"_31170":74590,"_5":31525,"_21595":125995,"_28362":125996,"_3076":125997},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3624":74604,"_31170":74590,"_5":31525,"_21595":125999,"_28362":126000,"_3076":126001},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3624":74605,"_31170":74590,"_5":31525,"_21595":126003,"_28362":126004,"_3076":126005},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3624":74606,"_31170":74590,"_5":31525,"_21595":126007,"_28362":126008,"_3076":126009},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3624":74607,"_31170":74590,"_5":31525,"_21595":126011,"_28362":126012,"_3076":126013},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3624":74608,"_31170":74590,"_5":31525,"_21595":126015,"_28362":126016,"_3076":126017},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3624":74609,"_31170":74590,"_5":31525,"_21595":126019,"_28362":126020,"_3076":126021},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3624":74610,"_31170":74590,"_5":31525,"_21595":126023,"_28362":126024,"_3076":126025},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3624":74611,"_31170":74590,"_5":31525,"_21595":126027,"_28362":126028,"_3076":126029},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3624":74612,"_31170":74590,"_5":31525,"_21595":126031,"_28362":126032,"_3076":126033},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3624":74613,"_31170":74590,"_5":31525,"_21595":126035,"_28362":126036,"_3076":126037},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3624":74614,"_31170":74590,"_5":31525,"_21595":126039,"_28362":126040,"_3076":126041},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3624":74615,"_31170":74590,"_21595":126043,"_5":14857,"_28362":74590,"_3076":126044},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3624":74616,"_31170":74590,"_21595":126046,"_5":14857,"_28362":74590,"_3076":126047},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3624":74617,"_31170":74590,"_21595":126049,"_5":14857,"_28362":74590,"_3076":126050},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3624":74618,"_31170":74590,"_21595":126052,"_5":14857,"_28362":125953,"_3076":126053},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3624":74619,"_31170":74590,"_21595":126055,"_5":14857,"_28362":125953,"_3076":126056},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3624":74620,"_31170":74590,"_21595":126058,"_5":14857,"_28362":125953,"_3076":126059},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3624":74621,"_31170":74590,"_21595":126061,"_5":14857,"_28362":125953,"_3076":126062},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3624":74622,"_31170":74590,"_21595":126064,"_5":14857,"_28362":125953,"_3076":126065},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3624":74623,"_31170":74590,"_21595":126067,"_5":14857,"_28362":125961,"_3076":126068},[],"Decide si la CA será raíz o intermedia.",{"_3624":74624,"_31170":74590,"_21595":126070,"_5":14857,"_28362":125961,"_3076":126071},[],"Elige el motor que custodiará la clave.",{"_3624":74625,"_31170":74590,"_21595":126073,"_5":14857,"_28362":125961,"_3076":126074},[],"Define una validez superior a la de los certificados que emitirá.",{"_3624":74626,"_31170":74590,"_21595":126076,"_5":14857,"_28362":125961,"_3076":126077},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3624":74627,"_31170":74590,"_21595":126079,"_5":14857,"_28362":125964,"_3076":126080},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3624":74628,"_31170":74590,"_21595":126082,"_5":14857,"_28362":125968,"_3076":126083},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3624":74629,"_31170":74590,"_21595":126085,"_5":14857,"_28362":125968,"_3076":126086},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3624":74630,"_31170":74590,"_21595":126088,"_5":14857,"_28362":125972,"_3076":126089},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3624":74631,"_31170":74590,"_21595":126091,"_5":14857,"_28362":125976,"_3076":126092},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3624":74632,"_31170":74590,"_21595":126094,"_5":14857,"_28362":125976,"_3076":126095},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3624":74633,"_31170":74590,"_21595":126097,"_5":14857,"_28362":125976,"_3076":126098},[],"`ST`: estado o provincia.",{"_3624":74634,"_31170":74590,"_21595":126100,"_5":14857,"_28362":125976,"_3076":126101},[],"`L`: localidad.",{"_3624":74635,"_31170":74590,"_21595":126103,"_5":14857,"_28362":125976,"_3076":126104},[],"`O`: organización.",{"_3624":74636,"_31170":74590,"_21595":126106,"_5":14857,"_28362":125976,"_3076":126107},[],"`OU`: unidad organizativa.",{"_3624":74637,"_31170":74590,"_21595":126109,"_5":14857,"_28362":125976,"_3076":126110},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3624":74638,"_31170":74590,"_21595":126112,"_5":14857,"_28362":125980,"_3076":126113},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3624":74639,"_31170":74590,"_21595":126115,"_5":14857,"_28362":125980,"_3076":126116},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3624":74640,"_31170":74590,"_21595":126118,"_5":14857,"_28362":125984,"_3076":126119},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3624":74641,"_31170":74590,"_21595":126121,"_5":14857,"_28362":125984,"_3076":126122},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3624":74642,"_31170":74590,"_21595":126124,"_5":14857,"_28362":125988,"_3076":126125},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3624":74643,"_31170":74590,"_21595":126127,"_5":14857,"_28362":125988,"_3076":126128},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3624":74644,"_31170":74590,"_21595":126130,"_5":14857,"_28362":125992,"_3076":126131},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3624":74645,"_31170":74590,"_21595":126133,"_5":14857,"_28362":125992,"_3076":126134},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3624":74646,"_31170":74590,"_21595":126136,"_5":14857,"_28362":125992,"_3076":126137},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3624":74647,"_31170":74590,"_21595":126139,"_5":14857,"_28362":125996,"_3076":126140},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3624":74648,"_31170":74590,"_21595":126142,"_5":14857,"_28362":126000,"_3076":126143},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3624":74649,"_31170":74590,"_21595":126145,"_5":14857,"_28362":126000,"_3076":126146},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3624":74650,"_31170":74590,"_21595":126148,"_5":14857,"_28362":126004,"_3076":126149},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3624":74651,"_31170":74590,"_21595":126151,"_5":14857,"_28362":126008,"_3076":126152},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3624":74652,"_31170":74590,"_21595":126154,"_5":14857,"_28362":126008,"_3076":126155},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3624":74653,"_31170":74590,"_21595":126157,"_5":14857,"_28362":126008,"_3076":126158},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3624":74654,"_31170":74590,"_21595":126160,"_5":14857,"_28362":126012,"_3076":126161},[],"Abre una CA desde el inventario para consultar:",{"_3624":74655,"_31170":74590,"_21595":126163,"_5":14857,"_28362":126012,"_3076":126164},[],"Estado y periodo de validez.",{"_3624":74656,"_31170":74590,"_21595":126166,"_5":14857,"_28362":126012,"_3076":126167},[],"Certificado y cadena en formato PEM.",{"_3624":74657,"_31170":74590,"_21595":126169,"_5":14857,"_28362":126012,"_3076":126170},[],"Número de certificados activos, expirados y revocados.",{"_3624":74658,"_31170":74590,"_21595":126172,"_5":14857,"_28362":126012,"_3076":126173},[],"Certificados emitidos en **Issued Certificates**.",{"_3624":74659,"_31170":74590,"_21595":126175,"_5":14857,"_28362":126012,"_3076":126176},[],"CRL vinculada a la autoridad.",{"_3624":74660,"_31170":74590,"_21595":126178,"_5":14857,"_28362":126012,"_3076":126179},[],"Metadatos y motor criptográfico asociado.",{"_3624":74661,"_31170":74590,"_21595":126181,"_5":14857,"_28362":126012,"_3076":126182},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3624":74662,"_31170":74590,"_21595":126184,"_5":14857,"_28362":126016,"_3076":126185},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3624":74663,"_31170":74590,"_21595":126187,"_5":14857,"_28362":126016,"_3076":126188},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3624":74664,"_31170":74590,"_21595":126190,"_5":14857,"_28362":126016,"_3076":126191},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3624":74665,"_31170":74590,"_21595":126193,"_5":14857,"_28362":126016,"_3076":126194},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3624":74666,"_31170":74590,"_21595":126196,"_5":14857,"_28362":126016,"_3076":126197},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3624":74667,"_31170":74590,"_21595":126199,"_5":14857,"_28362":126016,"_3076":126200},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3624":74668,"_31170":74590,"_21595":126202,"_5":14857,"_28362":126020,"_3076":126203},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3624":74669,"_31170":74590,"_21595":126205,"_5":14857,"_28362":126024,"_3076":126206},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3624":74670,"_31170":74590,"_21595":126208,"_5":14857,"_28362":126028,"_3076":126209},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3624":74671,"_31170":74590,"_21595":126211,"_5":14857,"_28362":126032,"_3076":126212},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3624":74672,"_31170":74590,"_21595":126214,"_5":14857,"_28362":126036,"_3076":126215},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3624":74673,"_31170":74590,"_21595":126217,"_5":14857,"_28362":126040,"_3076":126218},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3624":74674,"_31170":74590,"_21595":126220,"_5":14857,"_28362":126040,"_3076":126221},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3624":74675,"_31170":74590,"_21595":126223,"_5":14857,"_28362":126040,"_3076":126224},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3624":74676,"_31170":74590,"_21595":126226,"_5":14857,"_28362":126040,"_3076":126227},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3624":74677,"_31170":74677,"_5":15217,"_3076":126229,"_31528":126230,"_21595":126231,"_28362":74677},"Perfiles de certificado",[50937,121761,56623,125783],[],{"_3624":74678,"_31170":74677,"_21595":126233,"_5":14857,"_28362":74677,"_3076":126234},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3624":74679,"_31170":74677,"_5":31525,"_21595":126236,"_28362":126237,"_3076":126238},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3624":74680,"_31170":74677,"_5":31525,"_21595":126240,"_28362":126241,"_3076":126242},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#validez","Validez",{"_3624":74681,"_31170":74677,"_5":31525,"_21595":126244,"_28362":126245,"_3076":126246},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3624":74682,"_31170":74677,"_5":31525,"_21595":126248,"_28362":126249,"_3076":126250},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3624":74683,"_31170":74677,"_5":31525,"_21595":126252,"_28362":126253,"_3076":126254},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3624":74684,"_31170":74677,"_5":31525,"_21595":126256,"_28362":126257,"_3076":126258},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3624":74685,"_31170":74677,"_5":31525,"_21595":126260,"_28362":126261,"_3076":126262},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3624":74686,"_31170":74677,"_5":31525,"_21595":126264,"_28362":126265,"_3076":126266},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3624":74687,"_31170":74677,"_5":31525,"_21595":126268,"_28362":126269,"_3076":126270},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3624":74688,"_31170":74677,"_5":31525,"_21595":126272,"_28362":126273,"_3076":126274},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3624":74689,"_31170":74677,"_5":31525,"_21595":126276,"_28362":126277,"_3076":126278},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3624":74690,"_31170":74677,"_5":31525,"_21595":126280,"_28362":126281,"_3076":126282},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3624":74691,"_31170":74677,"_5":31525,"_21595":126284,"_28362":126285,"_3076":126286},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3624":74692,"_31170":74677,"_5":31525,"_21595":126288,"_28362":126289,"_3076":126290},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3624":74693,"_31170":74677,"_5":31525,"_21595":126292,"_28362":126293,"_3076":126294},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3624":74694,"_31170":74677,"_5":31525,"_21595":126296,"_28362":126297,"_3076":126298},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3624":74695,"_31170":74677,"_21595":126300,"_5":14857,"_28362":74677,"_3076":126301},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3624":74696,"_31170":74677,"_21595":126303,"_5":14857,"_28362":74677,"_3076":126304},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3624":74697,"_31170":74677,"_21595":126306,"_5":14857,"_28362":126241,"_3076":126307},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3624":74698,"_31170":74677,"_21595":126309,"_5":14857,"_28362":126241,"_3076":126310},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3624":74699,"_31170":74677,"_21595":126312,"_5":14857,"_28362":126245,"_3076":126313},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3624":74700,"_31170":74677,"_21595":126315,"_5":14857,"_28362":126249,"_3076":126316},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3624":74701,"_31170":74677,"_21595":126318,"_5":14857,"_28362":126249,"_3076":126319},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3624":74702,"_31170":74677,"_21595":126321,"_5":14857,"_28362":126249,"_3076":126322},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3624":74703,"_31170":74677,"_21595":126324,"_5":14857,"_28362":126253,"_3076":126325},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3624":74704,"_31170":74677,"_21595":126327,"_5":14857,"_28362":126257,"_3076":126328},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3624":74705,"_31170":74677,"_21595":126330,"_5":14857,"_28362":126257,"_3076":126331},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3624":74706,"_31170":74677,"_21595":126333,"_5":14857,"_28362":126261,"_3076":126334},[],"La aplicación criptográfica puede:",{"_3624":74707,"_31170":74677,"_21595":126336,"_5":14857,"_28362":126261,"_3076":126337},[],"permitir o bloquear claves RSA;",{"_3624":74708,"_31170":74677,"_21595":126339,"_5":14857,"_28362":126261,"_3076":126340},[],"limitar los tamaños RSA admitidos;",{"_3624":74709,"_31170":74677,"_21595":126342,"_5":14857,"_28362":126261,"_3076":126343},[],"permitir o bloquear claves ECDSA;",{"_3624":74710,"_31170":74677,"_21595":126345,"_5":14857,"_28362":126261,"_3076":126346},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3624":74711,"_31170":74677,"_21595":126348,"_5":14857,"_28362":126261,"_3076":126349},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3624":74712,"_31170":74677,"_21595":126351,"_5":14857,"_28362":126265,"_3076":126352},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3624":74713,"_31170":74677,"_21595":126354,"_5":14857,"_28362":126265,"_3076":121521},[],{"_3624":74714,"_31170":74677,"_21595":126356,"_5":14857,"_28362":126265,"_3076":126357},[],"Primera opción",{"_3624":74715,"_31170":74677,"_21595":126359,"_5":14857,"_28362":126265,"_3076":126360},[],"Segunda opción",{"_3624":74716,"_31170":74677,"_21595":126362,"_5":14857,"_28362":126265,"_3076":126363},[],"Si no hay ninguna",{"_3624":74717,"_31170":74677,"_21595":126365,"_5":14857,"_28362":126265,"_3076":126366},[],"Firma directa con una CA",{"_3624":74718,"_31170":74677,"_21595":126368,"_5":14857,"_28362":126265,"_3076":126369},[],"`issuance_profile` incluido en la solicitud",{"_3624":74719,"_31170":74677,"_21595":126371,"_5":14857,"_28362":126265,"_3076":126372},[],"`issuance_profile_id` de la solicitud",{"_3624":74720,"_31170":74677,"_21595":126374,"_5":14857,"_28362":126265,"_3076":126375},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3624":74721,"_31170":74677,"_21595":126377,"_5":14857,"_28362":126265,"_3076":126378},[],"Emisión mediante DMS",{"_3624":74722,"_31170":74677,"_21595":126380,"_5":14857,"_28362":126265,"_3076":57222},[],{"_3624":74723,"_31170":74677,"_21595":126382,"_5":14857,"_28362":126265,"_3076":126383},[],"`settings.issuance_profile` incluido en el DMS",{"_3624":74724,"_31170":74677,"_21595":126385,"_5":14857,"_28362":126265,"_3076":126386},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3624":74725,"_31170":74677,"_21595":126388,"_5":14857,"_28362":126265,"_3076":126389},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3624":74726,"_31170":74677,"_21595":126391,"_5":14857,"_28362":126265,"_3076":126392},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3624":74727,"_31170":74677,"_21595":126394,"_5":14857,"_28362":126273,"_3076":126395},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3624":74728,"_31170":74677,"_21595":126397,"_5":14857,"_28362":126277,"_3076":126398},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3624":74729,"_31170":74677,"_21595":126400,"_5":14857,"_28362":126281,"_3076":126401},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3624":74730,"_31170":74677,"_21595":126403,"_5":14857,"_28362":126285,"_3076":126404},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3624":74731,"_31170":74677,"_21595":126406,"_5":14857,"_28362":126289,"_3076":126407},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3624":74732,"_31170":74677,"_21595":126409,"_5":14857,"_28362":126289,"_3076":126410},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3624":74733,"_31170":74677,"_21595":126412,"_5":14857,"_28362":126293,"_3076":126413},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3624":74734,"_31170":74677,"_21595":126415,"_5":14857,"_28362":126293,"_3076":126416},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3624":74735,"_31170":74677,"_21595":126418,"_5":14857,"_28362":126293,"_3076":126419},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3624":74736,"_31170":74677,"_21595":126421,"_5":14857,"_28362":126293,"_3076":126422},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3624":74737,"_31170":74677,"_21595":126424,"_5":14857,"_28362":126297,"_3076":126425},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3624":74738,"_31170":74677,"_21595":126427,"_5":14857,"_28362":126297,"_3076":126428},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3624":74739,"_31170":74739,"_5":15217,"_3076":126430,"_31528":126431,"_21595":126433,"_28362":74739},"Validación de certificados",[50937,121761,56623,126432],"Validación",[],{"_3624":74740,"_31170":74739,"_21595":126435,"_5":14857,"_28362":74739,"_3076":126436},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3624":74741,"_31170":74739,"_5":31525,"_21595":126438,"_28362":126439,"_3076":126440},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3624":74742,"_31170":74739,"_5":31525,"_21595":126442,"_28362":126443,"_3076":126444},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3624":74743,"_31170":74739,"_5":31525,"_21595":126446,"_28362":126447,"_3076":126448},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3624":74744,"_31170":74739,"_21595":126450,"_5":14857,"_28362":74739,"_3076":126451},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3624":74745,"_31170":74739,"_21595":126453,"_5":14857,"_28362":126439,"_3076":126454},[],"Verifica estos criterios juntos:",{"_3624":74746,"_31170":74739,"_21595":126456,"_5":14857,"_28362":126439,"_3076":125412},[],{"_3624":74747,"_31170":74739,"_21595":126458,"_5":14857,"_28362":126439,"_3076":126459},[],"Resultado necesario",{"_3624":74748,"_31170":74739,"_21595":126461,"_5":14857,"_28362":126439,"_3076":126462},[],"Cadena y firma",{"_3624":74749,"_31170":74739,"_21595":126464,"_5":14857,"_28362":126439,"_3076":126465},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3624":74750,"_31170":74739,"_21595":126467,"_5":14857,"_28362":126439,"_3076":126468},[],"Fechas",{"_3624":74751,"_31170":74739,"_21595":126470,"_5":14857,"_28362":126439,"_3076":126471},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3624":74752,"_31170":74739,"_21595":126473,"_5":14857,"_28362":126439,"_3076":121431},[],{"_3624":74753,"_31170":74739,"_21595":126475,"_5":14857,"_28362":126439,"_3076":126476},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3624":74754,"_31170":74739,"_21595":126478,"_5":14857,"_28362":126439,"_3076":126479},[],"Uso",{"_3624":74755,"_31170":74739,"_21595":126481,"_5":14857,"_28362":126439,"_3076":126482},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3624":74756,"_31170":74739,"_21595":126484,"_5":14857,"_28362":126439,"_3076":126485},[],"Revocación",{"_3624":74757,"_31170":74739,"_21595":126487,"_5":14857,"_28362":126439,"_3076":126488},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3624":74758,"_31170":74739,"_21595":126490,"_5":14857,"_28362":126439,"_3076":126491},[],"Autorización",{"_3624":74759,"_31170":74739,"_21595":126493,"_5":14857,"_28362":126439,"_3076":126494},[],"La aplicación permite la acción a esa identidad.",{"_3624":74760,"_31170":74739,"_21595":126496,"_5":14857,"_28362":126439,"_3076":126497},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3624":74761,"_31170":74739,"_21595":126499,"_5":14857,"_28362":126443,"_3076":126500},[],"Mecanismo",{"_3624":74762,"_31170":74739,"_21595":126502,"_5":14857,"_28362":126443,"_3076":126503},[],"Cuándo utilizarlo",{"_3624":74763,"_31170":74739,"_21595":126505,"_5":14857,"_28362":126443,"_3076":126506},[],"Qué debes mantener",{"_3624":74764,"_31170":74739,"_21595":126508,"_5":14857,"_28362":126443,"_3076":57350},[],{"_3624":74765,"_31170":74739,"_21595":126510,"_5":14857,"_28362":126443,"_3076":126511},[],"Consulta del estado de un certificado concreto.",{"_3624":74766,"_31170":74739,"_21595":126513,"_5":14857,"_28362":126443,"_3076":126514},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3624":74767,"_31170":74739,"_21595":126516,"_5":14857,"_28362":126443,"_3076":57359},[],{"_3624":74768,"_31170":74739,"_21595":126518,"_5":14857,"_28362":126443,"_3076":126519},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3624":74769,"_31170":74739,"_21595":126521,"_5":14857,"_28362":126443,"_3076":126522},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3624":74770,"_31170":74739,"_21595":126524,"_5":14857,"_28362":126443,"_3076":126525},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3624":74771,"_31170":74739,"_21595":126527,"_5":14857,"_28362":126443,"_3076":126528},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3624":74772,"_31170":74739,"_21595":126530,"_5":14857,"_28362":126447,"_3076":126531},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3624":74773,"_31170":74739,"_21595":126533,"_5":14857,"_28362":126447,"_3076":126534},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3624":74774,"_31170":74739,"_21595":126536,"_5":14857,"_28362":126447,"_3076":126537},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3624":74775,"_31170":74739,"_21595":126539,"_5":14857,"_28362":126447,"_3076":126540},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3624":74776,"_31170":74739,"_21595":126542,"_5":14857,"_28362":126447,"_3076":126543},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3624":74777,"_31170":74739,"_21595":126545,"_5":14857,"_28362":126447,"_3076":126546},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3624":74778,"_31170":74739,"_21595":126548,"_5":14857,"_28362":126447,"_3076":126549},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3624":74779,"_31170":74739,"_21595":126551,"_5":14857,"_28362":126447,"_3076":126552},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":74780,"_31170":74739,"_21595":126554,"_5":14857,"_28362":126447,"_3076":126555},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3624":74781,"_31170":74781,"_5":15217,"_3076":126557,"_31528":126558,"_21595":126559,"_28362":74781},"Certificados",[50937,121761,56623,125783],[],{"_3624":74782,"_31170":74781,"_21595":126561,"_5":14857,"_28362":74781,"_3076":126562},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3624":74783,"_31170":74781,"_5":31525,"_21595":126564,"_28362":126565,"_3076":126566},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3624":74784,"_31170":74781,"_5":31525,"_21595":126568,"_28362":126569,"_3076":126570},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3624":74785,"_31170":74781,"_5":31525,"_21595":126572,"_28362":126573,"_3076":126574},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3624":74786,"_31170":74781,"_5":31525,"_21595":126576,"_28362":126577,"_3076":126578},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3624":74787,"_31170":74781,"_5":31525,"_21595":126580,"_28362":126581,"_3076":126582},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3624":74788,"_31170":74781,"_5":31525,"_21595":126584,"_28362":126585,"_3076":126586},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3624":74789,"_31170":74781,"_5":31525,"_21595":126588,"_28362":126589,"_3076":126590},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3624":74790,"_31170":74781,"_5":31525,"_21595":126592,"_28362":126593,"_3076":126594},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3624":74791,"_31170":74781,"_5":31525,"_21595":126596,"_28362":126597,"_3076":126598},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#continúa","Continúa",{"_3624":74792,"_31170":74781,"_21595":126600,"_5":14857,"_28362":74781,"_3076":126601},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3624":74793,"_31170":74781,"_21595":126603,"_5":14857,"_28362":126565,"_3076":126604},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3624":74794,"_31170":74781,"_21595":126606,"_5":14857,"_28362":126565,"_3076":126607},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3624":74795,"_31170":74781,"_21595":126609,"_5":14857,"_28362":126565,"_3076":126610},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3624":74796,"_31170":74781,"_21595":126612,"_5":14857,"_28362":126565,"_3076":126613},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3624":74797,"_31170":74781,"_21595":126615,"_5":14857,"_28362":126565,"_3076":126616},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3624":74798,"_31170":74781,"_21595":126618,"_5":14857,"_28362":126565,"_3076":126619},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3624":74799,"_31170":74781,"_21595":126621,"_5":14857,"_28362":126565,"_3076":126622},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3624":74800,"_31170":74781,"_21595":126624,"_5":14857,"_28362":126569,"_3076":126625},[],"Descarga el PEM e inspecciónalo:",{"_3624":74801,"_31170":74781,"_21595":126627,"_5":14857,"_28362":126569,"_3076":126628},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3624":74802,"_31170":74781,"_21595":126630,"_5":14857,"_28362":126573,"_3076":126631},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3624":74803,"_31170":74781,"_21595":126633,"_5":14857,"_28362":126573,"_3076":126634},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3624":74804,"_31170":74781,"_21595":126636,"_5":14857,"_28362":126573,"_3076":126637},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3624":74805,"_31170":74781,"_21595":126639,"_5":14857,"_28362":126573,"_3076":126640},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3624":74806,"_31170":74781,"_21595":126642,"_5":14857,"_28362":126573,"_3076":126643},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3624":74807,"_31170":74781,"_21595":126645,"_5":14857,"_28362":126573,"_3076":126646},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3624":74808,"_31170":74781,"_21595":126648,"_5":14857,"_28362":126573,"_3076":126649},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3624":74809,"_31170":74781,"_21595":126651,"_5":14857,"_28362":126577,"_3076":126652},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3624":74810,"_31170":74781,"_21595":126654,"_5":14857,"_28362":126581,"_3076":126655},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3624":74811,"_31170":74781,"_21595":126657,"_5":14857,"_28362":126585,"_3076":126658},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3624":74812,"_31170":74781,"_21595":126660,"_5":14857,"_28362":126589,"_3076":126661},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3624":74813,"_31170":74781,"_21595":126663,"_5":14857,"_28362":126589,"_3076":126664},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3624":74814,"_31170":74781,"_21595":126666,"_5":14857,"_28362":126589,"_3076":126667},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3624":74815,"_31170":74781,"_21595":126669,"_5":14857,"_28362":126593,"_3076":126670},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3624":74816,"_31170":74781,"_21595":126672,"_5":14857,"_28362":126593,"_3076":126673},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3624":74817,"_31170":74781,"_21595":126675,"_5":14857,"_28362":126593,"_3076":126676},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3624":74818,"_31170":74781,"_21595":126678,"_5":14857,"_28362":126597,"_3076":126679},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":74819,"_31170":74781,"_21595":126681,"_5":14857,"_28362":126597,"_3076":126682},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3624":74820,"_31170":74820,"_5":15217,"_3076":126684,"_31528":126685,"_21595":126687,"_28362":74820},"Ciclo de vida de un certificado",[50937,121761,56623,126686],"Conceptos",[],{"_3624":74821,"_31170":74820,"_21595":126689,"_5":14857,"_28362":74820,"_3076":126690},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3624":74822,"_31170":74820,"_5":31525,"_21595":126692,"_28362":126693,"_3076":126694},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3624":74823,"_31170":74820,"_5":31525,"_21595":126696,"_28362":126697,"_3076":126698},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3624":74824,"_31170":74820,"_5":31525,"_21595":126700,"_28362":126701,"_3076":126702},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3624":74825,"_31170":74820,"_5":31525,"_21595":126704,"_28362":126705,"_3076":126706},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3624":74826,"_31170":74820,"_5":31525,"_21595":126708,"_28362":126709,"_3076":126710},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3624":74827,"_31170":74820,"_5":31525,"_21595":126712,"_28362":126713,"_3076":126714},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3624":74828,"_31170":74820,"_5":31525,"_21595":126716,"_28362":126717,"_3076":124406},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3624":74829,"_31170":74820,"_5":31525,"_21595":126719,"_28362":126720,"_3076":126721},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3624":74830,"_31170":74820,"_5":31525,"_21595":126723,"_28362":126724,"_3076":126725},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3624":74831,"_31170":74820,"_5":31525,"_21595":126727,"_28362":126728,"_3076":126729},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3624":74832,"_31170":74820,"_21595":126731,"_5":14857,"_28362":74820,"_3076":126732},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3624":74833,"_31170":74820,"_21595":126734,"_5":14857,"_28362":126697,"_3076":126735},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3624":74834,"_31170":74820,"_21595":126737,"_5":14857,"_28362":126701,"_3076":126738},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3624":74835,"_31170":74820,"_21595":126740,"_5":14857,"_28362":126705,"_3076":126741},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3624":74836,"_31170":74820,"_21595":126743,"_5":14857,"_28362":126709,"_3076":126744},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3624":74837,"_31170":74820,"_21595":126746,"_5":14857,"_28362":126713,"_3076":126747},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3624":74838,"_31170":74820,"_21595":126749,"_5":14857,"_28362":126717,"_3076":126750},[],"Lamassu persiste cuatro estados X.509:",{"_3624":74839,"_31170":74820,"_21595":126752,"_5":14857,"_28362":126717,"_3076":126753},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3624":74840,"_31170":74820,"_21595":126755,"_5":14857,"_28362":126717,"_3076":126756},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3624":74841,"_31170":74820,"_21595":126758,"_5":14857,"_28362":126717,"_3076":126759},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3624":74842,"_31170":74820,"_21595":126761,"_5":14857,"_28362":126717,"_3076":126762},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3624":74843,"_31170":74820,"_21595":126764,"_5":14857,"_28362":126717,"_3076":126765},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3624":74844,"_31170":74820,"_21595":126767,"_5":14857,"_28362":126720,"_3076":126768},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3624":74845,"_31170":74820,"_21595":126770,"_5":14857,"_28362":126720,"_3076":126771},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3624":74846,"_31170":74820,"_21595":126773,"_5":14857,"_28362":126720,"_3076":126774},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3624":74847,"_31170":74820,"_21595":126776,"_5":14857,"_28362":126724,"_3076":126777},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3624":74848,"_31170":74820,"_21595":126779,"_5":14857,"_28362":126724,"_3076":126780},[],"Antes de confirmar:",{"_3624":74849,"_31170":74820,"_21595":126782,"_5":14857,"_28362":126724,"_3076":126783},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3624":74850,"_31170":74820,"_21595":126785,"_5":14857,"_28362":126724,"_3076":126786},[],"Distribuye la nueva cadena de confianza.",{"_3624":74851,"_31170":74820,"_21595":126788,"_5":14857,"_28362":126724,"_3076":126789},[],"Reemite las identidades necesarias.",{"_3624":74852,"_31170":74820,"_21595":126791,"_5":14857,"_28362":126724,"_3076":126792},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3624":74853,"_31170":74820,"_21595":126794,"_5":14857,"_28362":126724,"_3076":126795},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3624":74854,"_31170":74820,"_21595":126797,"_5":14857,"_28362":126724,"_3076":126798},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3624":74855,"_31170":74820,"_21595":126800,"_5":14857,"_28362":126728,"_3076":126801},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3624":74856,"_31170":74820,"_21595":126803,"_5":14857,"_28362":126728,"_3076":126804},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3624":74857,"_31170":74820,"_21595":126806,"_5":14857,"_28362":126728,"_3076":126807},[],"Cambios de estado y razones de revocación.",{"_3624":74858,"_31170":74820,"_21595":126809,"_5":14857,"_28362":126728,"_3076":126810},[],"Publicación y vigencia de OCSP y CRLs.",{"_3624":74859,"_31170":74820,"_21595":126812,"_5":14857,"_28362":126728,"_3076":126813},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3624":74860,"_31170":74820,"_21595":126815,"_5":14857,"_28362":126728,"_3076":126816},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3624":74861,"_31170":74861,"_5":15217,"_3076":126818,"_31528":126819,"_21595":126820,"_28362":74861},"Modelo de confianza",[50937,121761,56623,126686],[],{"_3624":74862,"_31170":74861,"_21595":126822,"_5":14857,"_28362":74861,"_3076":126823},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3624":74863,"_31170":74861,"_5":31525,"_21595":126825,"_28362":126826,"_3076":126827},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3624":74864,"_31170":74861,"_5":31525,"_21595":126829,"_28362":126830,"_3076":126831},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3624":74865,"_31170":74861,"_5":31525,"_21595":126833,"_28362":126834,"_3076":126835},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3624":74866,"_31170":74861,"_5":31525,"_21595":126837,"_28362":126838,"_3076":126839},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3624":74867,"_31170":74861,"_5":31525,"_21595":126841,"_28362":126842,"_3076":126843},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3624":74868,"_31170":74861,"_5":31525,"_21595":126845,"_28362":126846,"_3076":126847},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3624":74869,"_31170":74861,"_5":31525,"_21595":126849,"_28362":126850,"_3076":126851},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3624":74870,"_31170":74861,"_5":31525,"_21595":126853,"_28362":126854,"_3076":126855},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3624":74871,"_31170":74861,"_5":31525,"_21595":126857,"_28362":126858,"_3076":126859},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3624":74872,"_31170":74861,"_5":31525,"_21595":126861,"_28362":126862,"_3076":126863},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3624":74873,"_31170":74861,"_21595":126865,"_5":14857,"_28362":74861,"_3076":126866},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3624":74874,"_31170":74861,"_21595":126868,"_5":14857,"_28362":126830,"_3076":126869},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3624":74875,"_31170":74861,"_21595":126871,"_5":14857,"_28362":126834,"_3076":126872},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3624":74876,"_31170":74861,"_21595":126874,"_5":14857,"_28362":126838,"_3076":126875},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3624":74877,"_31170":74861,"_21595":126877,"_5":14857,"_28362":126842,"_3076":126878},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3624":74878,"_31170":74861,"_21595":126880,"_5":14857,"_28362":126846,"_3076":126881},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3624":74879,"_31170":74861,"_21595":126883,"_5":14857,"_28362":126846,"_3076":126884},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3624":74880,"_31170":74861,"_21595":126886,"_5":14857,"_28362":126846,"_3076":126887},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3624":74881,"_31170":74861,"_21595":126889,"_5":14857,"_28362":126846,"_3076":126890},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3624":74882,"_31170":74861,"_21595":126892,"_5":14857,"_28362":126846,"_3076":126893},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3624":74883,"_31170":74861,"_21595":126895,"_5":14857,"_28362":126846,"_3076":126896},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3624":74884,"_31170":74861,"_21595":126898,"_5":14857,"_28362":126850,"_3076":126899},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3624":74885,"_31170":74861,"_21595":126901,"_5":14857,"_28362":126850,"_3076":126902},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3624":74886,"_31170":74861,"_21595":126904,"_5":14857,"_28362":126850,"_3076":126905},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3624":74887,"_31170":74861,"_21595":126907,"_5":14857,"_28362":126850,"_3076":126908},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3624":74888,"_31170":74861,"_21595":126910,"_5":14857,"_28362":126850,"_3076":126911},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3624":74889,"_31170":74861,"_21595":126913,"_5":14857,"_28362":126854,"_3076":126914},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3624":74890,"_31170":74861,"_21595":126916,"_5":14857,"_28362":126854,"_3076":126917},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3624":74891,"_31170":74861,"_21595":126919,"_5":14857,"_28362":126854,"_3076":126920},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3624":74892,"_31170":74861,"_21595":126922,"_5":14857,"_28362":126854,"_3076":126923},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3624":74893,"_31170":74861,"_21595":126925,"_5":14857,"_28362":126854,"_3076":126926},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3624":74894,"_31170":74861,"_21595":126928,"_5":14857,"_28362":126854,"_3076":126929},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3624":74895,"_31170":74861,"_21595":126931,"_5":14857,"_28362":126854,"_3076":126932},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3624":74896,"_31170":74861,"_21595":126934,"_5":14857,"_28362":126858,"_3076":126935},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3624":74897,"_31170":74861,"_21595":126937,"_5":14857,"_28362":126862,"_3076":126938},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3624":74898,"_31170":74861,"_21595":126940,"_5":14857,"_28362":126862,"_3076":126941},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3624":74899,"_31170":74861,"_21595":126943,"_5":14857,"_28362":126862,"_3076":126944},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3624":74900,"_31170":74861,"_21595":126946,"_5":14857,"_28362":126862,"_3076":126947},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3624":74901,"_31170":74861,"_21595":126949,"_5":14857,"_28362":126862,"_3076":126950},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3624":74902,"_31170":74861,"_21595":126952,"_5":14857,"_28362":126862,"_3076":126953},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3624":74903,"_31170":74861,"_21595":126955,"_5":14857,"_28362":126862,"_3076":126956},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3624":74904,"_31170":74904,"_5":15217,"_3076":126958,"_31528":126959,"_21595":126960,"_28362":74904},"Listas de revocación (CRL)",[50937,121761,56623,126432],[],{"_3624":74905,"_31170":74904,"_21595":126962,"_5":14857,"_28362":74904,"_3076":126963},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3624":74906,"_31170":74904,"_5":31525,"_21595":126965,"_28362":126966,"_3076":126967},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3624":74907,"_31170":74904,"_5":31525,"_21595":126969,"_28362":126970,"_3076":126971},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3624":74908,"_31170":74904,"_5":31525,"_21595":126973,"_28362":126974,"_3076":126975},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3624":74909,"_31170":74904,"_5":31525,"_21595":126977,"_28362":126978,"_3076":126979},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3624":74910,"_31170":74904,"_5":31525,"_21595":126981,"_28362":126982,"_3076":126983},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3624":74911,"_31170":74904,"_5":31525,"_21595":126985,"_28362":126986,"_3076":126987},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3624":74912,"_31170":74904,"_5":31525,"_21595":126989,"_28362":126990,"_3076":126991},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3624":74913,"_31170":74904,"_5":31525,"_21595":126993,"_28362":126994,"_3076":126995},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#referencias","Referencias",{"_3624":74914,"_31170":74904,"_21595":126997,"_5":14857,"_28362":74904,"_3076":126998},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3624":74915,"_31170":74904,"_21595":127000,"_5":14857,"_28362":126966,"_3076":127001},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3624":74916,"_31170":74904,"_21595":127003,"_5":14857,"_28362":126966,"_3076":127004},[],"Campo",{"_3624":74917,"_31170":74904,"_21595":127006,"_5":14857,"_28362":126966,"_3076":123447},[],{"_3624":74918,"_31170":74904,"_21595":127008,"_5":14857,"_28362":126966,"_3076":52569},[],{"_3624":74919,"_31170":74904,"_21595":127010,"_5":14857,"_28362":126966,"_3076":127011},[],"ID de la CA a la que pertenecen los ajustes.",{"_3624":74920,"_31170":74904,"_21595":127013,"_5":14857,"_28362":126966,"_3076":57858},[],{"_3624":74921,"_31170":74904,"_21595":127015,"_5":14857,"_28362":126966,"_3076":127016},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3624":74922,"_31170":74904,"_21595":127018,"_5":14857,"_28362":126966,"_3076":57864},[],{"_3624":74923,"_31170":74904,"_21595":127020,"_5":14857,"_28362":126966,"_3076":127021},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3624":74924,"_31170":74904,"_21595":127023,"_5":14857,"_28362":126966,"_3076":57870},[],{"_3624":74925,"_31170":74904,"_21595":127025,"_5":14857,"_28362":126966,"_3076":127026},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3624":74926,"_31170":74904,"_21595":127028,"_5":14857,"_28362":126966,"_3076":127029},[],"Campo de `crl_options`",{"_3624":74927,"_31170":74904,"_21595":127031,"_5":14857,"_28362":126966,"_3076":123447},[],{"_3624":74928,"_31170":74904,"_21595":127033,"_5":14857,"_28362":126966,"_3076":127034},[],"Valor inicial",{"_3624":74929,"_31170":74904,"_21595":127036,"_5":14857,"_28362":126966,"_3076":57884},[],{"_3624":74930,"_31170":74904,"_21595":127038,"_5":14857,"_28362":126966,"_3076":127039},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3624":74931,"_31170":74904,"_21595":127041,"_5":14857,"_28362":126966,"_3076":127042},[],"7 días.",{"_3624":74932,"_31170":74904,"_21595":127044,"_5":14857,"_28362":126966,"_3076":57893},[],{"_3624":74933,"_31170":74904,"_21595":127046,"_5":14857,"_28362":126966,"_3076":127047},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3624":74934,"_31170":74904,"_21595":127049,"_5":14857,"_28362":126966,"_3076":127050},[],"6 días y 23 horas.",{"_3624":74935,"_31170":74904,"_21595":127052,"_5":14857,"_28362":126966,"_3076":57902},[],{"_3624":74936,"_31170":74904,"_21595":127054,"_5":14857,"_28362":126966,"_3076":127055},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3624":74937,"_31170":74904,"_21595":127057,"_5":14857,"_28362":126966,"_3076":57908},[],{"_3624":74938,"_31170":74904,"_21595":127059,"_5":14857,"_28362":126966,"_3076":57911},[],{"_3624":74939,"_31170":74904,"_21595":127061,"_5":14857,"_28362":126966,"_3076":127062},[],"Número de serie del certificado existente que firma la CRL.",{"_3624":74940,"_31170":74904,"_21595":127064,"_5":14857,"_28362":126966,"_3076":127065},[],"Número de serie del certificado actual de la CA.",{"_3624":74941,"_31170":74904,"_21595":127067,"_5":14857,"_28362":126966,"_3076":127068},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3624":74942,"_31170":74904,"_21595":127070,"_5":14857,"_28362":126966,"_3076":127071},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3624":74943,"_31170":74904,"_21595":127073,"_5":14857,"_28362":126966,"_3076":127074},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3624":74944,"_31170":74904,"_21595":127076,"_5":14857,"_28362":126966,"_3076":127077},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3624":74945,"_31170":74904,"_21595":127079,"_5":14857,"_28362":126966,"_3076":127080},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3624":74946,"_31170":74904,"_21595":127082,"_5":14857,"_28362":126966,"_3076":127083},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3624":74947,"_31170":74904,"_21595":127085,"_5":14857,"_28362":126966,"_3076":127086},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3624":74948,"_31170":74904,"_21595":127088,"_5":14857,"_28362":126966,"_3076":127089},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3624":74949,"_31170":74904,"_21595":127091,"_5":14857,"_28362":126966,"_3076":127092},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3624":74950,"_31170":74904,"_21595":127094,"_5":14857,"_28362":126966,"_3076":127095},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3624":74951,"_31170":74904,"_21595":127097,"_5":14857,"_28362":126966,"_3076":127098},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3624":74952,"_31170":74904,"_21595":127100,"_5":14857,"_28362":126970,"_3076":127101},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3624":74953,"_31170":74904,"_21595":127103,"_5":14857,"_28362":126970,"_3076":127104},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3624":74954,"_31170":74904,"_21595":127106,"_5":14857,"_28362":126970,"_3076":127107},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3624":74955,"_31170":74904,"_21595":127109,"_5":14857,"_28362":126970,"_3076":127110},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3624":74956,"_31170":74904,"_21595":127112,"_5":14857,"_28362":126974,"_3076":127113},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3624":74957,"_31170":74904,"_21595":127115,"_5":14857,"_28362":126974,"_3076":127116},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3624":74958,"_31170":74904,"_21595":127118,"_5":14857,"_28362":126974,"_3076":127119},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3624":74959,"_31170":74904,"_21595":127121,"_5":14857,"_28362":126974,"_3076":127122},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3624":74960,"_31170":74904,"_21595":127124,"_5":14857,"_28362":126974,"_3076":127125},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3624":74961,"_31170":74904,"_21595":127127,"_5":14857,"_28362":126974,"_3076":127128},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3624":74962,"_31170":74904,"_21595":127130,"_5":14857,"_28362":126974,"_3076":127131},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3624":74963,"_31170":74904,"_21595":127133,"_5":14857,"_28362":126974,"_3076":127134},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3624":74964,"_31170":74904,"_21595":127136,"_5":14857,"_28362":126974,"_3076":127137},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3624":74965,"_31170":74904,"_21595":127139,"_5":14857,"_28362":126978,"_3076":127140},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3624":74966,"_31170":74904,"_21595":127142,"_5":14857,"_28362":126978,"_3076":127143},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3624":74967,"_31170":74904,"_21595":127145,"_5":14857,"_28362":126982,"_3076":127146},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3624":74968,"_31170":74904,"_21595":127148,"_5":14857,"_28362":126982,"_3076":127149},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3624":74969,"_31170":74904,"_21595":127151,"_5":14857,"_28362":126982,"_3076":127152},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3624":74970,"_31170":74904,"_21595":127154,"_5":14857,"_28362":126982,"_3076":127155},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3624":74971,"_31170":74904,"_21595":127157,"_5":14857,"_28362":126982,"_3076":127158},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3624":74972,"_31170":74904,"_21595":127160,"_5":14857,"_28362":126986,"_3076":127161},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3624":74973,"_31170":74904,"_21595":127163,"_5":14857,"_28362":126986,"_3076":123636},[],{"_3624":74974,"_31170":74904,"_21595":127165,"_5":14857,"_28362":126986,"_3076":127166},[],"Path relativo",{"_3624":74975,"_31170":74904,"_21595":127168,"_5":14857,"_28362":126986,"_3076":121521},[],{"_3624":74976,"_31170":74904,"_21595":127170,"_5":14857,"_28362":126986,"_3076":58023},[],{"_3624":74977,"_31170":74904,"_21595":127172,"_5":14857,"_28362":126986,"_3076":58026},[],{"_3624":74978,"_31170":74904,"_21595":127174,"_5":14857,"_28362":126986,"_3076":127175},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3624":74979,"_31170":74904,"_21595":127177,"_5":14857,"_28362":126986,"_3076":58023},[],{"_3624":74980,"_31170":74904,"_21595":127179,"_5":14857,"_28362":126986,"_3076":58034},[],{"_3624":74981,"_31170":74904,"_21595":127181,"_5":14857,"_28362":126986,"_3076":127182},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3624":74982,"_31170":74904,"_21595":127184,"_5":14857,"_28362":126986,"_3076":58040},[],{"_3624":74983,"_31170":74904,"_21595":127186,"_5":14857,"_28362":126986,"_3076":58034},[],{"_3624":74984,"_31170":74904,"_21595":127188,"_5":14857,"_28362":126986,"_3076":127189},[],"Sustituir la configuración de CRL de una CA.",{"_3624":74985,"_31170":74904,"_21595":127191,"_5":14857,"_28362":126986,"_3076":58048},[],{"_3624":74986,"_31170":74904,"_21595":127193,"_5":14857,"_28362":126986,"_3076":58034},[],{"_3624":74987,"_31170":74904,"_21595":127195,"_5":14857,"_28362":126986,"_3076":127196},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3624":74988,"_31170":74904,"_21595":127198,"_5":14857,"_28362":126986,"_3076":127199},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3624":74989,"_31170":74904,"_21595":127201,"_5":14857,"_28362":126986,"_3076":127202},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3624":74990,"_31170":74904,"_21595":127204,"_5":14857,"_28362":126986,"_3076":127205},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3624":74991,"_31170":74904,"_21595":127207,"_5":14857,"_28362":126990,"_3076":127208},[],"Síntoma",{"_3624":74992,"_31170":74904,"_21595":127210,"_5":14857,"_28362":126990,"_3076":127211},[],"Causa",{"_3624":74993,"_31170":74904,"_21595":127213,"_5":14857,"_28362":126990,"_3076":127214},[],"Acción",{"_3624":74994,"_31170":74904,"_21595":127216,"_5":14857,"_28362":126990,"_3076":127217},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3624":74995,"_31170":74904,"_21595":127219,"_5":14857,"_28362":126990,"_3076":127220},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3624":74996,"_31170":74904,"_21595":127222,"_5":14857,"_28362":126990,"_3076":127223},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3624":74997,"_31170":74904,"_21595":127225,"_5":14857,"_28362":126990,"_3076":127226},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3624":74998,"_31170":74904,"_21595":127228,"_5":14857,"_28362":126990,"_3076":127229},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3624":74999,"_31170":74904,"_21595":127231,"_5":14857,"_28362":126990,"_3076":127232},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3624":75000,"_31170":74904,"_21595":127234,"_5":14857,"_28362":126990,"_3076":127235},[],"`PUT` devuelve 400.",{"_3624":75001,"_31170":74904,"_21595":127237,"_5":14857,"_28362":126990,"_3076":127238},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3624":75002,"_31170":74904,"_21595":127240,"_5":14857,"_28362":126990,"_3076":127241},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3624":75003,"_31170":74904,"_21595":127243,"_5":14857,"_28362":126990,"_3076":127244},[],"`PUT` devuelve 404.",{"_3624":75004,"_31170":74904,"_21595":127246,"_5":14857,"_28362":126990,"_3076":127247},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3624":75005,"_31170":74904,"_21595":127249,"_5":14857,"_28362":126990,"_3076":127250},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3624":75006,"_31170":74904,"_21595":127252,"_5":14857,"_28362":126990,"_3076":127253},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3624":75007,"_31170":74904,"_21595":127255,"_5":14857,"_28362":126990,"_3076":127256},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3624":75008,"_31170":74904,"_21595":127258,"_5":14857,"_28362":126990,"_3076":127259},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3624":75009,"_31170":74904,"_21595":127261,"_5":14857,"_28362":126990,"_3076":127262},[],"La CRL no cambia tras revocar un certificado.",{"_3624":75010,"_31170":74904,"_21595":127264,"_5":14857,"_28362":126990,"_3076":127265},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3624":75011,"_31170":74904,"_21595":127267,"_5":14857,"_28362":126990,"_3076":127268},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3624":75012,"_31170":74904,"_21595":127270,"_5":14857,"_28362":126990,"_3076":127271},[],"Un verificador rechaza la CRL por el emisor.",{"_3624":75013,"_31170":74904,"_21595":127273,"_5":14857,"_28362":126990,"_3076":127274},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3624":75014,"_31170":74904,"_21595":127276,"_5":14857,"_28362":126990,"_3076":127277},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3624":75015,"_31170":74904,"_21595":127279,"_5":14857,"_28362":126994,"_3076":127280},[],"RFC 5280: perfil X.509 y CRL.",{"_3624":75016,"_31170":74904,"_21595":127282,"_5":14857,"_28362":126994,"_3076":58140},[],{"_3624":75017,"_31170":74904,"_21595":127284,"_5":14857,"_28362":126994,"_3076":58143},[],{"_3624":75018,"_31170":74904,"_21595":127286,"_5":14857,"_28362":126994,"_3076":127287},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":75019,"_31170":74904,"_21595":127289,"_5":14857,"_28362":126994,"_3076":127290},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3624":75020,"_31170":75020,"_5":15217,"_3076":127292,"_31528":127293,"_21595":127294,"_28362":75020},"Claves y motores criptográficos",[50937,121761,56623,125783],[],{"_3624":75021,"_31170":75020,"_21595":127296,"_5":14857,"_28362":75020,"_3076":127297},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3624":75022,"_31170":75020,"_5":31525,"_21595":127299,"_28362":127300,"_3076":127301},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3624":75023,"_31170":75020,"_5":31525,"_21595":127303,"_28362":127304,"_3076":127305},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3624":75024,"_31170":75020,"_5":31525,"_21595":127307,"_28362":127308,"_3076":58168},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#file-system",{"_3624":75025,"_31170":75020,"_5":31525,"_21595":127310,"_28362":127311,"_3076":58172},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#hashicorp-vault",{"_3624":75026,"_31170":75020,"_5":31525,"_21595":127313,"_28362":127314,"_3076":58176},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#aws-secrets-manager",{"_3624":75027,"_31170":75020,"_5":31525,"_21595":127316,"_28362":127317,"_3076":58180},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#aws-kms",{"_3624":75028,"_31170":75020,"_5":31525,"_21595":127319,"_28362":127320,"_3076":58184},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#pkcs11",{"_3624":75029,"_31170":75020,"_5":31525,"_21595":127322,"_28362":127323,"_3076":58188},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#azure-key-vault",{"_3624":75030,"_31170":75020,"_5":31525,"_21595":127325,"_28362":127326,"_3076":127327},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3624":75031,"_31170":75020,"_5":31525,"_21595":127329,"_28362":127330,"_3076":127331},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3624":75032,"_31170":75020,"_5":31525,"_21595":127333,"_28362":127334,"_3076":127335},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3624":75033,"_31170":75020,"_5":31525,"_21595":127337,"_28362":127338,"_3076":127339},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3624":75034,"_31170":75020,"_5":31525,"_21595":127341,"_28362":127342,"_3076":127343},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3624":75035,"_31170":75020,"_5":31525,"_21595":127345,"_28362":127346,"_3076":127347},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3624":75036,"_31170":75020,"_5":31525,"_21595":127349,"_28362":127350,"_3076":127351},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3624":75037,"_31170":75020,"_5":31525,"_21595":127353,"_28362":127354,"_3076":58220},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#sign",{"_3624":75038,"_31170":75020,"_5":31525,"_21595":127356,"_28362":127357,"_3076":58224},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#verify",{"_3624":75039,"_31170":75020,"_5":31525,"_21595":127359,"_28362":127360,"_3076":127361},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3624":75040,"_31170":75020,"_5":31525,"_21595":127363,"_28362":127364,"_3076":127365},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3624":75041,"_31170":75020,"_5":31525,"_21595":127367,"_28362":127368,"_3076":127369},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3624":75042,"_31170":75020,"_21595":127371,"_5":14857,"_28362":75020,"_3076":127372},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3624":75043,"_31170":75020,"_21595":127374,"_5":14857,"_28362":75020,"_3076":127375},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3624":75044,"_31170":75020,"_21595":127377,"_5":14857,"_28362":127300,"_3076":127378},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3624":75045,"_31170":75020,"_21595":127380,"_5":14857,"_28362":127300,"_3076":127381},[],"En la práctica, permite:",{"_3624":75046,"_31170":75020,"_21595":127383,"_5":14857,"_28362":127300,"_3076":127384},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3624":75047,"_31170":75020,"_21595":127386,"_5":14857,"_28362":127300,"_3076":127387},[],"Importar claves creadas externamente.",{"_3624":75048,"_31170":75020,"_21595":127389,"_5":14857,"_28362":127300,"_3076":127390},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3624":75049,"_31170":75020,"_21595":127392,"_5":14857,"_28362":127300,"_3076":127393},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3624":75050,"_31170":75020,"_21595":127395,"_5":14857,"_28362":127304,"_3076":127396},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3624":75051,"_31170":75020,"_21595":127398,"_5":14857,"_28362":127304,"_3076":127399},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3624":75052,"_31170":75020,"_21595":127401,"_5":14857,"_28362":127304,"_3076":127402},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3624":75053,"_31170":75020,"_21595":127404,"_5":14857,"_28362":127308,"_3076":127405},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3624":75054,"_31170":75020,"_21595":127407,"_5":14857,"_28362":127311,"_3076":127408},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3624":75055,"_31170":75020,"_21595":127410,"_5":14857,"_28362":127311,"_3076":127411},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3624":75056,"_31170":75020,"_21595":127413,"_5":14857,"_28362":127314,"_3076":127414},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3624":75057,"_31170":75020,"_21595":127416,"_5":14857,"_28362":127317,"_3076":127417},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3624":75058,"_31170":75020,"_21595":127419,"_5":14857,"_28362":127320,"_3076":127420},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3624":75059,"_31170":75020,"_21595":127422,"_5":14857,"_28362":127323,"_3076":127423},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3624":75060,"_31170":75020,"_21595":127425,"_5":14857,"_28362":127323,"_3076":127426},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3624":75061,"_31170":75020,"_21595":127428,"_5":14857,"_28362":127323,"_3076":127429},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3624":75062,"_31170":75020,"_21595":127431,"_5":14857,"_28362":127323,"_3076":127432},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3624":75063,"_31170":75020,"_21595":127434,"_5":14857,"_28362":127326,"_3076":127435},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3624":75064,"_31170":75020,"_21595":127437,"_5":14857,"_28362":127326,"_3076":127438},[],"La tabla incluye los siguientes campos:",{"_3624":75065,"_31170":75020,"_21595":127440,"_5":14857,"_28362":127326,"_3076":127441},[],"**Name**: nombre descriptivo de la clave.",{"_3624":75066,"_31170":75020,"_21595":127443,"_5":14857,"_28362":127326,"_3076":127444},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3624":75067,"_31170":75020,"_21595":127446,"_5":14857,"_28362":127326,"_3076":127447},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3624":75068,"_31170":75020,"_21595":127449,"_5":14857,"_28362":127326,"_3076":127450},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3624":75069,"_31170":75020,"_21595":127452,"_5":14857,"_28362":127326,"_3076":127453},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3624":75070,"_31170":75020,"_21595":127455,"_5":14857,"_28362":127326,"_3076":127456},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3624":75071,"_31170":75020,"_21595":127458,"_5":14857,"_28362":127326,"_3076":127459},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3624":75072,"_31170":75020,"_21595":127461,"_5":14857,"_28362":127326,"_3076":127462},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3624":75073,"_31170":75020,"_21595":127464,"_5":14857,"_28362":127326,"_3076":127465},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3624":75074,"_31170":75020,"_21595":127467,"_5":14857,"_28362":127326,"_3076":127468},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3624":75075,"_31170":75020,"_21595":127470,"_5":14857,"_28362":127326,"_3076":127471},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3624":75076,"_31170":75020,"_21595":127473,"_5":14857,"_28362":127326,"_3076":127474},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3624":75077,"_31170":75020,"_21595":127476,"_5":14857,"_28362":127326,"_3076":127477},[],"**Delete Key** para eliminar la clave del sistema.",{"_3624":75078,"_31170":75020,"_21595":127479,"_5":14857,"_28362":127330,"_3076":127480},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3624":75079,"_31170":75020,"_21595":127482,"_5":14857,"_28362":127334,"_3076":127483},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3624":75080,"_31170":75020,"_21595":127485,"_5":14857,"_28362":127334,"_3076":127486},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3624":75081,"_31170":75020,"_21595":127488,"_5":14857,"_28362":127334,"_3076":127489},[],"**Key Name**: nombre único y descriptivo.",{"_3624":75082,"_31170":75020,"_21595":127491,"_5":14857,"_28362":127334,"_3076":127492},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3624":75083,"_31170":75020,"_21595":127494,"_5":14857,"_28362":127334,"_3076":127495},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3624":75084,"_31170":75020,"_21595":127497,"_5":14857,"_28362":127334,"_3076":127498},[],"**Tags**: metadatos para clasificar la clave.",{"_3624":75085,"_31170":75020,"_21595":127500,"_5":14857,"_28362":127334,"_3076":127501},[],"**Metadata**: información adicional para usos avanzados.",{"_3624":75086,"_31170":75020,"_21595":127503,"_5":14857,"_28362":127338,"_3076":127504},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3624":75087,"_31170":75020,"_21595":127506,"_5":14857,"_28362":127338,"_3076":127507},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3624":75088,"_31170":75020,"_21595":127509,"_5":14857,"_28362":127338,"_3076":127510},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3624":75089,"_31170":75020,"_21595":127512,"_5":14857,"_28362":127338,"_3076":127513},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3624":75090,"_31170":75020,"_21595":127515,"_5":14857,"_28362":127338,"_3076":127516},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3624":75091,"_31170":75020,"_21595":127518,"_5":14857,"_28362":127338,"_3076":127519},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3624":75092,"_31170":75020,"_21595":127521,"_5":14857,"_28362":127338,"_3076":127522},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3624":75093,"_31170":75020,"_21595":127524,"_5":14857,"_28362":127338,"_3076":127525},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3624":75094,"_31170":75020,"_21595":127527,"_5":14857,"_28362":127338,"_3076":127528},[],"**Metadata**: información adicional opcional.",{"_3624":75095,"_31170":75020,"_21595":127530,"_5":14857,"_28362":127338,"_3076":127531},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3624":75096,"_31170":75020,"_21595":127533,"_5":14857,"_28362":127338,"_3076":127534},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3624":75097,"_31170":75020,"_21595":127536,"_5":14857,"_28362":127342,"_3076":127537},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3624":75098,"_31170":75020,"_21595":127539,"_5":14857,"_28362":127346,"_3076":127540},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3624":75099,"_31170":75020,"_21595":127542,"_5":14857,"_28362":127346,"_3076":127543},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3624":75100,"_31170":75020,"_21595":127545,"_5":14857,"_28362":127346,"_3076":127546},[],"**Key Name**: nombre descriptivo.",{"_3624":75101,"_31170":75020,"_21595":127548,"_5":14857,"_28362":127346,"_3076":127549},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3624":75102,"_31170":75020,"_21595":127551,"_5":14857,"_28362":127346,"_3076":127552},[],"**Tags**: etiquetas asociadas.",{"_3624":75103,"_31170":75020,"_21595":127554,"_5":14857,"_28362":127346,"_3076":127555},[],"**Aliases**: nombres alternativos.",{"_3624":75104,"_31170":75020,"_21595":127557,"_5":14857,"_28362":127346,"_3076":127558},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3624":75105,"_31170":75020,"_21595":127560,"_5":14857,"_28362":127346,"_3076":127561},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3624":75106,"_31170":75020,"_21595":127563,"_5":14857,"_28362":127346,"_3076":127564},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3624":75107,"_31170":75020,"_21595":127566,"_5":14857,"_28362":127346,"_3076":127567},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3624":75108,"_31170":75020,"_21595":127569,"_5":14857,"_28362":127350,"_3076":127570},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3624":75109,"_31170":75020,"_21595":127572,"_5":14857,"_28362":127350,"_3076":127573},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3624":75110,"_31170":75020,"_21595":127575,"_5":14857,"_28362":127350,"_3076":127576},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3624":75111,"_31170":75020,"_21595":127578,"_5":14857,"_28362":127354,"_3076":127579},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3624":75112,"_31170":75020,"_21595":127581,"_5":14857,"_28362":127354,"_3076":127582},[],"Campos principales:",{"_3624":75113,"_31170":75020,"_21595":127584,"_5":14857,"_28362":127354,"_3076":127585},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3624":75114,"_31170":75020,"_21595":127587,"_5":14857,"_28362":127354,"_3076":127588},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3624":75115,"_31170":75020,"_21595":127590,"_5":14857,"_28362":127354,"_3076":127591},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3624":75116,"_31170":75020,"_21595":127593,"_5":14857,"_28362":127354,"_3076":127594},[],"**Message**: contenido que se va a firmar.",{"_3624":75117,"_31170":75020,"_21595":127596,"_5":14857,"_28362":127354,"_3076":127597},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3624":75118,"_31170":75020,"_21595":127599,"_5":14857,"_28362":127357,"_3076":127600},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3624":75119,"_31170":75020,"_21595":127602,"_5":14857,"_28362":127357,"_3076":127582},[],{"_3624":75120,"_31170":75020,"_21595":127604,"_5":14857,"_28362":127357,"_3076":127605},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3624":75121,"_31170":75020,"_21595":127607,"_5":14857,"_28362":127357,"_3076":127608},[],"**Message Type**: `Raw` o `Digest`.",{"_3624":75122,"_31170":75020,"_21595":127610,"_5":14857,"_28362":127357,"_3076":127611},[],"**Payload Encoding**: codificación del mensaje.",{"_3624":75123,"_31170":75020,"_21595":127613,"_5":14857,"_28362":127357,"_3076":127614},[],"**Message**: mensaje original o hash.",{"_3624":75124,"_31170":75020,"_21595":127616,"_5":14857,"_28362":127357,"_3076":127617},[],"**Signature**: firma que se desea comprobar.",{"_3624":75125,"_31170":75020,"_21595":127619,"_5":14857,"_28362":127357,"_3076":127620},[],"**Result**: indicador del resultado de la validación.",{"_3624":75126,"_31170":75020,"_21595":127622,"_5":14857,"_28362":127360,"_3076":127623},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3624":75127,"_31170":75020,"_21595":127625,"_5":14857,"_28362":127360,"_3076":127626},[],"Este flujo es útil para:",{"_3624":75128,"_31170":75020,"_21595":127628,"_5":14857,"_28362":127360,"_3076":127629},[],"Solicitar certificados a una CA externa.",{"_3624":75129,"_31170":75020,"_21595":127631,"_5":14857,"_28362":127360,"_3076":127632},[],"Renovar una identidad manteniendo la misma clave.",{"_3624":75130,"_31170":75020,"_21595":127634,"_5":14857,"_28362":127360,"_3076":127635},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3624":75131,"_31170":75020,"_21595":127637,"_5":14857,"_28362":127360,"_3076":127638},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3624":75132,"_31170":75020,"_21595":127640,"_5":14857,"_28362":127360,"_3076":127641},[],"**Organization (O)**: organización o empresa.",{"_3624":75133,"_31170":75020,"_21595":127643,"_5":14857,"_28362":127360,"_3076":127644},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3624":75134,"_31170":75020,"_21595":127646,"_5":14857,"_28362":127360,"_3076":127647},[],"**Country (C)**: código de país de dos letras.",{"_3624":75135,"_31170":75020,"_21595":127649,"_5":14857,"_28362":127360,"_3076":127650},[],"**State / Province (ST)**: estado o provincia.",{"_3624":75136,"_31170":75020,"_21595":127652,"_5":14857,"_28362":127360,"_3076":127653},[],"**Locality (L)**: ciudad o localidad.",{"_3624":75137,"_31170":75020,"_21595":127655,"_5":14857,"_28362":127360,"_3076":127656},[],"**Email Address**: correo de contacto.",{"_3624":75138,"_31170":75020,"_21595":127658,"_5":14857,"_28362":127360,"_3076":127659},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3624":75139,"_31170":75020,"_21595":127661,"_5":14857,"_28362":127360,"_3076":127662},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3624":75140,"_31170":75020,"_21595":127664,"_5":14857,"_28362":127364,"_3076":127665},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3624":75141,"_31170":75020,"_21595":127667,"_5":14857,"_28362":127364,"_3076":127668},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3624":75142,"_31170":75020,"_21595":127670,"_5":14857,"_28362":127368,"_3076":127671},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3624":75143,"_31170":75020,"_21595":127673,"_5":14857,"_28362":127368,"_3076":127674},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3624":75144,"_31170":75144,"_5":15217,"_3076":127676,"_31528":127677,"_21595":127678,"_28362":75144},"Validación online con OCSP",[50937,121761,56623,126432],[],{"_3624":75145,"_31170":75144,"_21595":127680,"_5":14857,"_28362":75144,"_3076":127681},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3624":75146,"_31170":75144,"_5":31525,"_21595":127683,"_28362":127684,"_3076":127685},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3624":75147,"_31170":75144,"_5":31525,"_21595":127687,"_28362":127688,"_3076":127689},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3624":75148,"_31170":75144,"_5":31525,"_21595":127691,"_28362":127692,"_3076":127693},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3624":75149,"_31170":75144,"_5":31525,"_21595":127695,"_28362":127696,"_3076":127697},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3624":75150,"_31170":75144,"_5":31525,"_21595":127699,"_28362":127700,"_3076":127701},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3624":75151,"_31170":75144,"_5":31525,"_21595":127703,"_28362":127704,"_3076":126995},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#referencias",{"_3624":75152,"_31170":75144,"_21595":127706,"_5":14857,"_28362":75144,"_3076":127707},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3624":75153,"_31170":75144,"_21595":127709,"_5":14857,"_28362":127684,"_3076":127710},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3624":75154,"_31170":75144,"_21595":127712,"_5":14857,"_28362":127684,"_3076":127713},[],"Estado del registro",{"_3624":75155,"_31170":75144,"_21595":127715,"_5":14857,"_28362":127684,"_3076":127716},[],"Respuesta firmada",{"_3624":75156,"_31170":75144,"_21595":127718,"_5":14857,"_28362":127684,"_3076":55760},[],{"_3624":75157,"_31170":75144,"_21595":127720,"_5":14857,"_28362":127684,"_3076":58588},[],{"_3624":75158,"_31170":75144,"_21595":127722,"_5":14857,"_28362":127684,"_3076":55777},[],{"_3624":75159,"_31170":75144,"_21595":127724,"_5":14857,"_28362":127684,"_3076":127725},[],"`Revoked`, con razón y fecha de revocación.",{"_3624":75160,"_31170":75144,"_21595":127727,"_5":14857,"_28362":127684,"_3076":127728},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3624":75161,"_31170":75144,"_21595":127730,"_5":14857,"_28362":127684,"_3076":127731},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3624":75162,"_31170":75144,"_21595":127733,"_5":14857,"_28362":127684,"_3076":127734},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3624":75163,"_31170":75144,"_21595":127736,"_5":14857,"_28362":127684,"_3076":127737},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3624":75164,"_31170":75144,"_21595":127739,"_5":14857,"_28362":127684,"_3076":127740},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3624":75165,"_31170":75144,"_21595":127742,"_5":14857,"_28362":127688,"_3076":127743},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3624":75166,"_31170":75144,"_21595":127745,"_5":14857,"_28362":127688,"_3076":127746},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3624":75167,"_31170":75144,"_21595":127748,"_5":14857,"_28362":127692,"_3076":127749},[],"El servicio acepta:",{"_3624":75168,"_31170":75144,"_21595":127751,"_5":14857,"_28362":127692,"_3076":123636},[],{"_3624":75169,"_31170":75144,"_21595":127753,"_5":14857,"_28362":127692,"_3076":127754},[],"Ruta del servicio VA",{"_3624":75170,"_31170":75144,"_21595":127756,"_5":14857,"_28362":127692,"_3076":127757},[],"Formato",{"_3624":75171,"_31170":75144,"_21595":127759,"_5":14857,"_28362":127692,"_3076":58628},[],{"_3624":75172,"_31170":75144,"_21595":127761,"_5":14857,"_28362":127692,"_3076":58631},[],{"_3624":75173,"_31170":75144,"_21595":127763,"_5":14857,"_28362":127692,"_3076":127764},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3624":75174,"_31170":75144,"_21595":127766,"_5":14857,"_28362":127692,"_3076":58023},[],{"_3624":75175,"_31170":75144,"_21595":127768,"_5":14857,"_28362":127692,"_3076":58639},[],{"_3624":75176,"_31170":75144,"_21595":127770,"_5":14857,"_28362":127692,"_3076":127771},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3624":75177,"_31170":75144,"_21595":127773,"_5":14857,"_28362":127692,"_3076":127774},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3624":75178,"_31170":75144,"_21595":127776,"_5":14857,"_28362":127696,"_3076":127777},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3624":75179,"_31170":75144,"_21595":127779,"_5":14857,"_28362":127696,"_3076":127780},[],"Genera la solicitud:",{"_3624":75180,"_31170":75144,"_21595":127782,"_5":14857,"_28362":127696,"_3076":127783},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3624":75181,"_31170":75144,"_21595":127785,"_5":14857,"_28362":127696,"_3076":127786},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3624":75182,"_31170":75144,"_21595":127788,"_5":14857,"_28362":127696,"_3076":127789},[],"Verifica el DER recibido:",{"_3624":75183,"_31170":75144,"_21595":127791,"_5":14857,"_28362":127696,"_3076":127792},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3624":75184,"_31170":75144,"_21595":127794,"_5":14857,"_28362":127700,"_3076":127795},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3624":75185,"_31170":75144,"_21595":127797,"_5":14857,"_28362":127700,"_3076":127798},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3624":75186,"_31170":75144,"_21595":127800,"_5":14857,"_28362":127704,"_3076":58672},[],{"_3624":75187,"_31170":75144,"_21595":127802,"_5":14857,"_28362":127704,"_3076":58675},[],{"_3624":75188,"_31170":75144,"_21595":127804,"_5":14857,"_28362":127704,"_3076":127805},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3624":75189,"_31170":75144,"_21595":127807,"_5":14857,"_28362":127704,"_3076":127290},[],{"_3624":75190,"_31170":75190,"_5":15217,"_3076":56623,"_31528":127809,"_21595":127810,"_28362":75190},[50937,121761,56623],[],{"_3624":75191,"_31170":75190,"_21595":127812,"_5":14857,"_28362":75190,"_3076":127813},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3624":75192,"_31170":75190,"_5":31525,"_21595":127815,"_28362":127816,"_3076":125109},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#empieza-aquí",{"_3624":75193,"_31170":75190,"_5":31525,"_21595":127818,"_28362":127819,"_3076":127820},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3624":75194,"_31170":75190,"_5":31525,"_21595":127822,"_28362":127823,"_3076":125629},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#capacidades-principales",{"_3624":75195,"_31170":75190,"_5":31525,"_21595":127825,"_28362":127826,"_3076":125633},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3624":75196,"_31170":75190,"_5":31525,"_21595":127828,"_28362":127829,"_3076":125637},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3624":75197,"_31170":75190,"_5":31525,"_21595":127831,"_28362":127832,"_3076":125641},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#emite-y-controla-certificados",{"_3624":75198,"_31170":75190,"_5":31525,"_21595":127834,"_28362":127835,"_3076":125649},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#publica-el-estado-de-validación",{"_3624":75199,"_31170":75190,"_5":31525,"_21595":127837,"_28362":127838,"_3076":127839},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3624":75200,"_31170":75190,"_5":31525,"_21595":127841,"_28362":127842,"_3076":126598},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#continúa",{"_3624":75201,"_31170":75190,"_21595":127844,"_5":14857,"_28362":75190,"_3076":127845},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3624":75202,"_31170":75190,"_21595":127847,"_5":14857,"_28362":127816,"_3076":127848},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3624":75203,"_31170":75190,"_21595":127850,"_5":14857,"_28362":127816,"_3076":127851},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3624":75204,"_31170":75190,"_21595":127853,"_5":14857,"_28362":127819,"_3076":127854},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3624":75205,"_31170":75190,"_21595":127856,"_5":14857,"_28362":127819,"_3076":127857},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3624":75206,"_31170":75190,"_21595":127859,"_5":14857,"_28362":127819,"_3076":127860},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3624":75207,"_31170":75190,"_21595":127862,"_5":14857,"_28362":127819,"_3076":127863},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3624":75208,"_31170":75190,"_21595":127865,"_5":14857,"_28362":127819,"_3076":127866},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3624":75209,"_31170":75190,"_21595":127868,"_5":14857,"_28362":127826,"_3076":127869},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3624":75210,"_31170":75190,"_21595":127871,"_5":14857,"_28362":127829,"_3076":127872},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3624":75211,"_31170":75190,"_21595":127874,"_5":14857,"_28362":127832,"_3076":127875},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3624":75212,"_31170":75190,"_21595":127877,"_5":14857,"_28362":127835,"_3076":127878},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3624":75213,"_31170":75190,"_21595":127880,"_5":14857,"_28362":127838,"_3076":127881},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3624":75214,"_31170":75190,"_21595":127883,"_5":14857,"_28362":127838,"_3076":127884},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3624":75215,"_31170":75190,"_21595":127886,"_5":14857,"_28362":127838,"_3076":127887},[],"su clave pública corresponda a la clave privada del cliente;",{"_3624":75216,"_31170":75190,"_21595":127889,"_5":14857,"_28362":127838,"_3076":127890},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3624":75217,"_31170":75190,"_21595":127892,"_5":14857,"_28362":127838,"_3076":127893},[],"sus fechas y usos permitan la operación;",{"_3624":75218,"_31170":75190,"_21595":127895,"_5":14857,"_28362":127838,"_3076":127896},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3624":75219,"_31170":75190,"_21595":127898,"_5":14857,"_28362":127838,"_3076":127899},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3624":75220,"_31170":75190,"_21595":127901,"_5":14857,"_28362":127842,"_3076":127902},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3624":75221,"_31170":75190,"_21595":127904,"_5":14857,"_28362":127842,"_3076":127905},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3624":75222,"_31170":75190,"_21595":127907,"_5":14857,"_28362":127842,"_3076":127908},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3624":75223,"_31170":75223,"_5":15217,"_3076":127910,"_31528":127911,"_21595":127912,"_28362":75223},"Crea tu primera CA",[50937,121761,56623,125233],[],{"_3624":75224,"_31170":75223,"_21595":127914,"_5":14857,"_28362":75223,"_3076":127915},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3624":75225,"_31170":75223,"_5":31525,"_21595":127917,"_28362":127918,"_3076":120295},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3624":75226,"_31170":75223,"_5":31525,"_21595":127920,"_28362":127921,"_3076":127922},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3624":75227,"_31170":75223,"_5":31525,"_21595":127924,"_28362":127925,"_3076":127926},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3624":75228,"_31170":75223,"_5":31525,"_21595":127928,"_28362":127929,"_3076":127930},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3624":75229,"_31170":75223,"_5":31525,"_21595":127932,"_28362":127933,"_3076":127934},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3624":75230,"_31170":75223,"_5":31525,"_21595":127936,"_28362":127937,"_3076":127938},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3624":75231,"_31170":75223,"_5":31525,"_21595":127940,"_28362":127941,"_3076":127942},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3624":75232,"_31170":75223,"_5":31525,"_21595":127944,"_28362":127945,"_3076":125480},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3624":75233,"_31170":75223,"_5":31525,"_21595":127947,"_28362":127948,"_3076":120319},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3624":75234,"_31170":75223,"_21595":127950,"_5":14857,"_28362":75223,"_3076":127951},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3624":75235,"_31170":75223,"_21595":127953,"_5":14857,"_28362":127918,"_3076":127954},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3624":75236,"_31170":75223,"_21595":127956,"_5":14857,"_28362":127918,"_3076":127957},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3624":75237,"_31170":75223,"_21595":127959,"_5":14857,"_28362":127918,"_3076":127960},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3624":75238,"_31170":75223,"_21595":127962,"_5":14857,"_28362":127918,"_3076":127963},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3624":75239,"_31170":75223,"_21595":127965,"_5":14857,"_28362":127921,"_3076":127966},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3624":75240,"_31170":75223,"_21595":127968,"_5":14857,"_28362":127921,"_3076":127969},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3624":75241,"_31170":75223,"_21595":127971,"_5":14857,"_28362":127925,"_3076":127972},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3624":75242,"_31170":75223,"_21595":127974,"_5":14857,"_28362":127925,"_3076":127975},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3624":75243,"_31170":75223,"_21595":127977,"_5":14857,"_28362":127929,"_3076":127978},[],"Selecciona **Root CA** y completa:",{"_3624":75244,"_31170":75223,"_21595":127980,"_5":14857,"_28362":127929,"_3076":58854},[],{"_3624":75245,"_31170":75223,"_21595":127982,"_5":14857,"_28362":127929,"_3076":127983},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3624":75246,"_31170":75223,"_21595":127985,"_5":14857,"_28362":127929,"_3076":127986},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3624":75247,"_31170":75223,"_21595":127988,"_5":14857,"_28362":127929,"_3076":127989},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3624":75248,"_31170":75223,"_21595":127991,"_5":14857,"_28362":127929,"_3076":127992},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3624":75249,"_31170":75223,"_21595":127994,"_5":14857,"_28362":127933,"_3076":127995},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3624":75250,"_31170":75223,"_21595":127997,"_5":14857,"_28362":127937,"_3076":127998},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3624":75251,"_31170":75223,"_21595":128000,"_5":14857,"_28362":127937,"_3076":128001},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3624":75252,"_31170":75223,"_21595":128003,"_5":14857,"_28362":127941,"_3076":128004},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3624":75253,"_31170":75223,"_21595":128006,"_5":14857,"_28362":127941,"_3076":128007},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3624":75254,"_31170":75223,"_21595":128009,"_5":14857,"_28362":127941,"_3076":128010},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3624":75255,"_31170":75223,"_21595":128012,"_5":14857,"_28362":127945,"_3076":128013},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3624":75256,"_31170":75223,"_21595":128015,"_5":14857,"_28362":127945,"_3076":128016},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3624":75257,"_31170":75223,"_21595":128018,"_5":14857,"_28362":127945,"_3076":128019},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3624":75258,"_31170":75223,"_21595":128021,"_5":14857,"_28362":127945,"_3076":128022},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3624":75259,"_31170":75223,"_21595":128024,"_5":14857,"_28362":127948,"_3076":128025},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3624":75260,"_31170":75260,"_5":15217,"_3076":128027,"_31528":128028,"_21595":128029,"_28362":75260},"Emite y verifica un certificado",[50937,121761,56623,125233],[],{"_3624":75261,"_31170":75260,"_21595":128031,"_5":14857,"_28362":75260,"_3076":128032},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3624":75262,"_31170":75260,"_5":31525,"_21595":128034,"_28362":128035,"_3076":120295},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3624":75263,"_31170":75260,"_5":31525,"_21595":128037,"_28362":128038,"_3076":128039},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3624":75264,"_31170":75260,"_5":31525,"_21595":128041,"_28362":128042,"_3076":128043},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3624":75265,"_31170":75260,"_5":31525,"_21595":128045,"_28362":128046,"_3076":128047},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3624":75266,"_31170":75260,"_5":31525,"_21595":128049,"_28362":128050,"_3076":128051},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3624":75267,"_31170":75260,"_5":31525,"_21595":128053,"_28362":128054,"_3076":128055},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3624":75268,"_31170":75260,"_5":31525,"_21595":128057,"_28362":128058,"_3076":128059},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3624":75269,"_31170":75260,"_5":31525,"_21595":128061,"_28362":128062,"_3076":128063},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3624":75270,"_31170":75260,"_5":31525,"_21595":128065,"_28362":128066,"_3076":128067},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3624":75271,"_31170":75260,"_5":31525,"_21595":128069,"_28362":128070,"_3076":128071},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3624":75272,"_31170":75260,"_5":31525,"_21595":128073,"_28362":128074,"_3076":125480},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3624":75273,"_31170":75260,"_5":31525,"_21595":128076,"_28362":128077,"_3076":120319},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3624":75274,"_31170":75260,"_21595":128079,"_5":14857,"_28362":75260,"_3076":128080},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3624":75275,"_31170":75260,"_21595":128082,"_5":14857,"_28362":128035,"_3076":128083},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3624":75276,"_31170":75260,"_21595":128085,"_5":14857,"_28362":128035,"_3076":128086},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3624":75277,"_31170":75260,"_21595":128088,"_5":14857,"_28362":128035,"_3076":128089},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3624":75278,"_31170":75260,"_21595":128091,"_5":14857,"_28362":128035,"_3076":128092},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3624":75279,"_31170":75260,"_21595":128094,"_5":14857,"_28362":128035,"_3076":128095},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3624":75280,"_31170":75260,"_21595":128097,"_5":14857,"_28362":128038,"_3076":128098},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3624":75281,"_31170":75260,"_21595":128100,"_5":14857,"_28362":128042,"_3076":128101},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3624":75282,"_31170":75260,"_21595":128103,"_5":14857,"_28362":128042,"_3076":128104},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3624":75283,"_31170":75260,"_21595":128106,"_5":14857,"_28362":128046,"_3076":128107},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3624":75284,"_31170":75260,"_21595":128109,"_5":14857,"_28362":128046,"_3076":128110},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3624":75285,"_31170":75260,"_21595":128112,"_5":14857,"_28362":128050,"_3076":128113},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3624":75286,"_31170":75260,"_21595":128115,"_5":14857,"_28362":128050,"_3076":128116},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3624":75287,"_31170":75260,"_21595":128118,"_5":14857,"_28362":128054,"_3076":128119},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3624":75288,"_31170":75260,"_21595":128121,"_5":14857,"_28362":128058,"_3076":128122},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3624":75289,"_31170":75260,"_21595":128124,"_5":14857,"_28362":128062,"_3076":128125},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3624":75290,"_31170":75260,"_21595":128127,"_5":14857,"_28362":128066,"_3076":128128},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3624":75291,"_31170":75260,"_21595":128130,"_5":14857,"_28362":128066,"_3076":128131},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3624":75292,"_31170":75260,"_21595":128133,"_5":14857,"_28362":128066,"_3076":128134},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3624":75293,"_31170":75260,"_21595":128136,"_5":14857,"_28362":128070,"_3076":128137},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3624":75294,"_31170":75260,"_21595":128139,"_5":14857,"_28362":128070,"_3076":128140},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3624":75295,"_31170":75260,"_21595":128142,"_5":14857,"_28362":128070,"_3076":128143},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3624":75296,"_31170":75260,"_21595":128145,"_5":14857,"_28362":128074,"_3076":125563},[],{"_3624":75297,"_31170":75260,"_21595":128147,"_5":14857,"_28362":128074,"_3076":124078},[],{"_3624":75298,"_31170":75260,"_21595":128149,"_5":14857,"_28362":128074,"_3076":128150},[],"La CA rechaza la emisión",{"_3624":75299,"_31170":75260,"_21595":128152,"_5":14857,"_28362":128074,"_3076":128153},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3624":75300,"_31170":75260,"_21595":128155,"_5":14857,"_28362":128074,"_3076":128156},[],"Sujeto o usos diferentes",{"_3624":75301,"_31170":75260,"_21595":128158,"_5":14857,"_28362":128074,"_3076":128159},[],"Perfil aplicado y valores solicitados.",{"_3624":75302,"_31170":75260,"_21595":128161,"_5":14857,"_28362":128074,"_3076":128162},[],"No se encuentra el emisor",{"_3624":75303,"_31170":75260,"_21595":128164,"_5":14857,"_28362":128074,"_3076":128165},[],"CA descargada y cadena intermedia necesaria.",{"_3624":75304,"_31170":75260,"_21595":128167,"_5":14857,"_28362":128074,"_3076":128168},[],"Falla la vigencia",{"_3624":75305,"_31170":75260,"_21595":128170,"_5":14857,"_28362":128074,"_3076":128171},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3624":75306,"_31170":75260,"_21595":128173,"_5":14857,"_28362":128074,"_3076":128174},[],"Los resúmenes de clave difieren",{"_3624":75307,"_31170":75260,"_21595":128176,"_5":14857,"_28362":128074,"_3076":128177},[],"Archivos de certificado y clave de la misma emisión.",{"_3624":75308,"_31170":75260,"_21595":128179,"_5":14857,"_28362":128074,"_3076":128180},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3624":75309,"_31170":75260,"_21595":128182,"_5":14857,"_28362":128077,"_3076":128183},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3624":75310,"_31170":75260,"_21595":128185,"_5":14857,"_28362":128077,"_3076":128186},[],"Gestionar certificados para inspección, estado y revocación.",{"_3624":75311,"_31170":75260,"_21595":128188,"_5":14857,"_28362":128077,"_3076":128189},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3624":75312,"_31170":75260,"_21595":128191,"_5":14857,"_28362":128077,"_3076":128192},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3624":75313,"_31170":75260,"_21595":128194,"_5":14857,"_28362":128077,"_3076":128195},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3624":75314,"_31170":75314,"_5":15217,"_3076":128197,"_31528":128198,"_21595":128199,"_28362":75314},"Primeros pasos de PKI",[50937,121761,56623,125233],[],{"_3624":75315,"_31170":75314,"_21595":128201,"_5":14857,"_28362":75314,"_3076":128202},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3624":75316,"_31170":75314,"_5":31525,"_21595":128204,"_28362":128205,"_3076":120295},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3624":75317,"_31170":75314,"_5":31525,"_21595":128207,"_28362":128208,"_3076":128209},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3624":75318,"_31170":75314,"_5":31525,"_21595":128211,"_28362":128212,"_3076":125415},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3624":75319,"_31170":75314,"_5":31525,"_21595":128214,"_28362":128215,"_3076":128216},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3624":75320,"_31170":75314,"_21595":128218,"_5":14857,"_28362":75314,"_3076":128219},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3624":75321,"_31170":75314,"_21595":128221,"_5":14857,"_28362":128205,"_3076":128222},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3624":75322,"_31170":75314,"_21595":128224,"_5":14857,"_28362":128205,"_3076":128225},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3624":75323,"_31170":75314,"_21595":128227,"_5":14857,"_28362":128205,"_3076":128228},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3624":75324,"_31170":75314,"_21595":128230,"_5":14857,"_28362":128205,"_3076":128231},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3624":75325,"_31170":75314,"_21595":128233,"_5":14857,"_28362":128205,"_3076":128234},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3624":75326,"_31170":75314,"_21595":128236,"_5":14857,"_28362":128208,"_3076":128237},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3624":75327,"_31170":75314,"_21595":128239,"_5":14857,"_28362":128208,"_3076":128240},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3624":75328,"_31170":75314,"_21595":128242,"_5":14857,"_28362":128208,"_3076":128243},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3624":75329,"_31170":75314,"_21595":128245,"_5":14857,"_28362":128208,"_3076":128246},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3624":75330,"_31170":75314,"_21595":128248,"_5":14857,"_28362":128212,"_3076":128249},[],"Archivo o recurso",{"_3624":75331,"_31170":75314,"_21595":128251,"_5":14857,"_28362":128212,"_3076":125412},[],{"_3624":75332,"_31170":75314,"_21595":128253,"_5":14857,"_28362":128212,"_3076":128254},[],"CA raíz activa y `ca.pem`",{"_3624":75333,"_31170":75314,"_21595":128256,"_5":14857,"_28362":128212,"_3076":128257},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3624":75334,"_31170":75314,"_21595":128259,"_5":14857,"_28362":128212,"_3076":128260},[],"Certificado final y `device.crt`",{"_3624":75335,"_31170":75314,"_21595":128262,"_5":14857,"_28362":128212,"_3076":128263},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3624":75336,"_31170":75314,"_21595":128265,"_5":14857,"_28362":128212,"_3076":128266},[],"Clave privada `device.key`",{"_3624":75337,"_31170":75314,"_21595":128268,"_5":14857,"_28362":128212,"_3076":128269},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3624":75338,"_31170":75314,"_21595":128271,"_5":14857,"_28362":128212,"_3076":128272},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3624":75339,"_31170":75314,"_21595":128274,"_5":14857,"_28362":128215,"_3076":128275},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3624":75340,"_31170":75314,"_21595":128277,"_5":14857,"_28362":128215,"_3076":128278},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3624":75341,"_31170":75314,"_21595":128280,"_5":14857,"_28362":128215,"_3076":128281},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3624":75342,"_31170":75342,"_5":15217,"_3076":128283,"_31528":128284,"_21595":128286,"_28362":75342},"Resolución de problemas PKI",[50937,121761,56623,128285],"Resolución de problemas",[],{"_3624":75343,"_31170":75342,"_21595":128288,"_5":14857,"_28362":75342,"_3076":128289},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3624":75344,"_31170":75342,"_5":31525,"_21595":128291,"_28362":128292,"_3076":128293},[],"/docs/pr-preview/pr-76/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3624":75345,"_31170":75342,"_5":31525,"_21595":128295,"_28362":128296,"_3076":128297},[],"/docs/pr-preview/pr-76/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3624":75346,"_31170":75342,"_5":31525,"_21595":128299,"_28362":128300,"_3076":128301},[],"/docs/pr-preview/pr-76/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3624":75347,"_31170":75342,"_21595":128303,"_5":14857,"_28362":75342,"_3076":128304},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3624":75348,"_31170":75342,"_21595":128306,"_5":14857,"_28362":75342,"_3076":128307},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3624":75349,"_31170":75342,"_21595":128309,"_5":14857,"_28362":128292,"_3076":125412},[],{"_3624":75350,"_31170":75342,"_21595":128311,"_5":14857,"_28362":128292,"_3076":124078},[],{"_3624":75351,"_31170":75342,"_21595":128313,"_5":14857,"_28362":128292,"_3076":120319},[],{"_3624":75352,"_31170":75342,"_21595":128315,"_5":14857,"_28362":128292,"_3076":55465},[],{"_3624":75353,"_31170":75342,"_21595":128317,"_5":14857,"_28362":128292,"_3076":128318},[],"Existe, está activa y sus fechas son utilizables.",{"_3624":75354,"_31170":75342,"_21595":128320,"_5":14857,"_28362":128292,"_3076":128321},[],"Autoridades.",{"_3624":75355,"_31170":75342,"_21595":128323,"_5":14857,"_28362":128292,"_3076":128324},[],"Clave",{"_3624":75356,"_31170":75342,"_21595":128326,"_5":14857,"_28362":128292,"_3076":128327},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3624":75357,"_31170":75342,"_21595":128329,"_5":14857,"_28362":128292,"_3076":128330},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3624":75358,"_31170":75342,"_21595":128332,"_5":14857,"_28362":128292,"_3076":59208},[],{"_3624":75359,"_31170":75342,"_21595":128334,"_5":14857,"_28362":128292,"_3076":128335},[],"PEM correcto y firma verificable.",{"_3624":75360,"_31170":75342,"_21595":128337,"_5":14857,"_28362":128292,"_3076":59214},[],{"_3624":75361,"_31170":75342,"_21595":128339,"_5":14857,"_28362":128292,"_3076":128340},[],"Perfil",{"_3624":75362,"_31170":75342,"_21595":128342,"_5":14857,"_28362":128292,"_3076":128343},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3624":75363,"_31170":75342,"_21595":128345,"_5":14857,"_28362":128292,"_3076":128346},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3624":75364,"_31170":75342,"_21595":128348,"_5":14857,"_28362":128292,"_3076":125563},[],{"_3624":75365,"_31170":75342,"_21595":128350,"_5":14857,"_28362":128292,"_3076":128351},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3624":75366,"_31170":75342,"_21595":128353,"_5":14857,"_28362":128292,"_3076":128354},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3624":75367,"_31170":75342,"_21595":128356,"_5":14857,"_28362":128292,"_3076":128357},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3624":75368,"_31170":75342,"_21595":128359,"_5":14857,"_28362":128292,"_3076":128360},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3624":75369,"_31170":75342,"_21595":128362,"_5":14857,"_28362":128292,"_3076":128363},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3624":75370,"_31170":75342,"_21595":128365,"_5":14857,"_28362":128296,"_3076":128366},[],"Revisa cada frontera por separado:",{"_3624":75371,"_31170":75342,"_21595":128368,"_5":14857,"_28362":128296,"_3076":128369},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3624":75372,"_31170":75342,"_21595":128371,"_5":14857,"_28362":128296,"_3076":128372},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3624":75373,"_31170":75342,"_21595":128374,"_5":14857,"_28362":128296,"_3076":128375},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3624":75374,"_31170":75342,"_21595":128377,"_5":14857,"_28362":128296,"_3076":128378},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3624":75375,"_31170":75342,"_21595":128380,"_5":14857,"_28362":128296,"_3076":128381},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3624":75376,"_31170":75342,"_21595":128383,"_5":14857,"_28362":128296,"_3076":128384},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3624":75377,"_31170":75342,"_21595":128386,"_5":14857,"_28362":128300,"_3076":128387},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3624":75378,"_31170":75342,"_21595":128389,"_5":14857,"_28362":128300,"_3076":128390},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3624":75379,"_31170":75379,"_5":15217,"_3076":128392,"_31528":128393,"_21595":128394,"_28362":75379},"Seguridad",[50937],[],{"_3624":75380,"_31170":75379,"_21595":128396,"_5":14857,"_28362":75379,"_3076":128397},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3624":75381,"_31170":75379,"_5":31525,"_21595":128399,"_28362":128400,"_3076":128401},[],"/docs/pr-preview/pr-76/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3624":75382,"_31170":75379,"_5":31525,"_21595":128403,"_28362":128404,"_3076":128405},[],"/docs/pr-preview/pr-76/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3624":75383,"_31170":75379,"_5":31525,"_21595":128407,"_28362":128408,"_3076":128409},[],"/docs/pr-preview/pr-76/es/security#versiones-soportadas","Versiones soportadas",{"_3624":75384,"_31170":75379,"_5":31525,"_21595":128411,"_28362":128412,"_3076":128413},[],"/docs/pr-preview/pr-76/es/security#divulgación-responsable","Divulgación responsable",{"_3624":75385,"_31170":75379,"_21595":128415,"_5":14857,"_28362":75379,"_3076":128416},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3624":75386,"_31170":75379,"_21595":128418,"_5":14857,"_28362":128400,"_3076":128419},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3624":75387,"_31170":75379,"_21595":128421,"_5":14857,"_28362":128400,"_3076":128422},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3624":75388,"_31170":75379,"_21595":128424,"_5":14857,"_28362":128400,"_3076":15496},[],{"_3624":75389,"_31170":75379,"_21595":128426,"_5":14857,"_28362":128400,"_3076":15425},[],{"_3624":75390,"_31170":75379,"_21595":128428,"_5":14857,"_28362":128400,"_3076":15483},[],{"_3624":75391,"_31170":75379,"_21595":128430,"_5":14857,"_28362":128400,"_3076":128431},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3624":75392,"_31170":75379,"_21595":128433,"_5":14857,"_28362":128400,"_3076":128434},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3624":75393,"_31170":75379,"_21595":128436,"_5":14857,"_28362":128404,"_3076":128437},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3624":75394,"_31170":75379,"_21595":128439,"_5":14857,"_28362":128404,"_3076":128440},[],"No incluyas en el reporte:",{"_3624":75395,"_31170":75379,"_21595":128442,"_5":14857,"_28362":128404,"_3076":128443},[],"Credenciales, tokens o claves privadas",{"_3624":75396,"_31170":75379,"_21595":128445,"_5":14857,"_28362":128404,"_3076":128446},[],"Datos de clientes o información identificable de clientes",{"_3624":75397,"_31170":75379,"_21595":128448,"_5":14857,"_28362":128404,"_3076":128449},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3624":75398,"_31170":75379,"_21595":128451,"_5":14857,"_28362":128408,"_3076":128452},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3624":75399,"_31170":75379,"_21595":128454,"_5":14857,"_28362":128408,"_3076":128455},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3624":75400,"_31170":75379,"_21595":128457,"_5":14857,"_28362":128412,"_3076":128458},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3624":75401,"_31170":75379,"_21595":128460,"_5":14857,"_28362":128412,"_3076":128461},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3624":75402,"_31170":75379,"_21595":128463,"_5":14857,"_28362":128412,"_3076":128464},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3624":75403,"_31170":75379,"_21595":128466,"_5":14857,"_28362":128412,"_3076":128467},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3624":75404,"_31170":75379,"_21595":128469,"_5":14857,"_28362":128412,"_3076":128470},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3624":75405,"_31170":75405,"_5":15217,"_3076":128472,"_31528":128473,"_21595":128475,"_28362":75405},"3.8.0 a 4.0.0",[50937,128474],"Actualizaciones",[],{"_3624":75406,"_31170":75405,"_21595":128477,"_5":14857,"_28362":75405,"_3076":128478},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3624":75407,"_31170":75405,"_5":31525,"_21595":128480,"_28362":128481,"_3076":128482},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3624":75408,"_31170":75405,"_5":31525,"_21595":128484,"_28362":128485,"_3076":128486},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3624":75409,"_31170":75405,"_5":31525,"_21595":128488,"_28362":128489,"_3076":128490},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3624":75410,"_31170":75405,"_5":31525,"_21595":128492,"_28362":128493,"_3076":128494},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3624":75411,"_31170":75405,"_5":31525,"_21595":128496,"_28362":128497,"_3076":128498},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3624":75412,"_31170":75405,"_5":31525,"_21595":128500,"_28362":128501,"_3076":128502},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3624":75413,"_31170":75405,"_5":31525,"_21595":128504,"_28362":128505,"_3076":59383},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3624":75414,"_31170":75405,"_5":31525,"_21595":128507,"_28362":128508,"_3076":128509},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3624":75415,"_31170":75405,"_5":31525,"_21595":128511,"_28362":128512,"_3076":128513},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3624":75416,"_31170":75405,"_5":31525,"_21595":128515,"_28362":128516,"_3076":128517},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3624":75417,"_31170":75405,"_5":31525,"_21595":128519,"_28362":128520,"_3076":120890},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3624":75418,"_31170":75405,"_5":31525,"_21595":128522,"_28362":128523,"_3076":128524},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3624":75419,"_31170":75405,"_5":31525,"_21595":128526,"_28362":128527,"_3076":128528},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3624":75420,"_31170":75405,"_5":31525,"_21595":128530,"_28362":128531,"_3076":128532},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3624":75421,"_31170":75405,"_5":31525,"_21595":128534,"_28362":128535,"_3076":128536},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3624":75422,"_31170":75405,"_5":31525,"_21595":128538,"_28362":128539,"_3076":128540},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3624":75423,"_31170":75405,"_5":31525,"_21595":128542,"_28362":128543,"_3076":128544},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3624":75424,"_31170":75405,"_5":31525,"_21595":128546,"_28362":128547,"_3076":128548},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3624":75425,"_31170":75405,"_5":31525,"_21595":128550,"_28362":128551,"_3076":128552},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3624":75426,"_31170":75405,"_5":31525,"_21595":128554,"_28362":128555,"_3076":128556},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3624":75427,"_31170":75405,"_5":31525,"_21595":128558,"_28362":128559,"_3076":128560},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3624":75428,"_31170":75405,"_5":31525,"_21595":128562,"_28362":128563,"_3076":128564},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3624":75429,"_31170":75405,"_5":31525,"_21595":128566,"_28362":128567,"_3076":128568},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3624":75430,"_31170":75405,"_5":31525,"_21595":128570,"_28362":128571,"_3076":128572},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3624":75431,"_31170":75405,"_5":31525,"_21595":128574,"_28362":128575,"_3076":128576},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3624":75432,"_31170":75405,"_5":31525,"_21595":128578,"_28362":128579,"_3076":128580},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3624":75433,"_31170":75405,"_5":31525,"_21595":128582,"_28362":128583,"_3076":128584},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3624":75434,"_31170":75405,"_5":31525,"_21595":128586,"_28362":128587,"_3076":128588},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3624":75435,"_31170":75405,"_5":31525,"_21595":128590,"_28362":128591,"_3076":128592},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3624":75436,"_31170":75405,"_5":31525,"_21595":128594,"_28362":128595,"_3076":128596},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3624":75437,"_31170":75405,"_5":31525,"_21595":128598,"_28362":128599,"_3076":128600},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3624":75438,"_31170":75405,"_5":31525,"_21595":128602,"_28362":128603,"_3076":128604},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3624":75439,"_31170":75405,"_5":31525,"_21595":128606,"_28362":128607,"_3076":128608},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3624":75440,"_31170":75405,"_5":31525,"_21595":128610,"_28362":128611,"_3076":128612},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3624":75441,"_31170":75405,"_5":31525,"_21595":128614,"_28362":128615,"_3076":128616},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3624":75442,"_31170":75405,"_5":31525,"_21595":128618,"_28362":128619,"_3076":128620},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3624":75443,"_31170":75405,"_5":31525,"_21595":128622,"_28362":128623,"_3076":128624},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3624":75444,"_31170":75405,"_5":31525,"_21595":128626,"_28362":128627,"_3076":128628},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3624":75445,"_31170":75405,"_5":31525,"_21595":128630,"_28362":128631,"_3076":128632},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3624":75446,"_31170":75405,"_5":31525,"_21595":128634,"_28362":128635,"_3076":128636},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3624":75447,"_31170":75405,"_5":31525,"_21595":128638,"_28362":128639,"_3076":128640},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3624":75448,"_31170":75405,"_5":31525,"_21595":128642,"_28362":128643,"_3076":128644},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3624":75449,"_31170":75405,"_5":31525,"_21595":128646,"_28362":128647,"_3076":128648},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3624":75450,"_31170":75405,"_5":31525,"_21595":128650,"_28362":128651,"_3076":128652},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3624":75451,"_31170":75405,"_5":31525,"_21595":128654,"_28362":128655,"_3076":124426},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3624":75452,"_31170":75405,"_5":31525,"_21595":128657,"_28362":128658,"_3076":128659},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3624":75453,"_31170":75405,"_5":31525,"_21595":128661,"_28362":128662,"_3076":128663},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3624":75454,"_31170":75405,"_21595":128665,"_5":14857,"_28362":75405,"_3076":128666},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3624":75455,"_31170":75405,"_21595":128668,"_5":14857,"_28362":75405,"_3076":128669},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3624":75456,"_31170":75405,"_21595":128671,"_5":14857,"_28362":75405,"_3076":128672},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3624":75457,"_31170":75405,"_21595":128674,"_5":14857,"_28362":75405,"_3076":128675},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3624":75458,"_31170":75405,"_21595":128677,"_5":14857,"_28362":75405,"_3076":128678},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3624":75459,"_31170":75405,"_21595":128680,"_5":14857,"_28362":75405,"_3076":128681},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3624":75460,"_31170":75405,"_21595":128683,"_5":14857,"_28362":75405,"_3076":128684},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3624":75461,"_31170":75405,"_21595":128686,"_5":14857,"_28362":128485,"_3076":128687},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3624":75462,"_31170":75405,"_21595":128689,"_5":14857,"_28362":128485,"_3076":128690},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3624":75463,"_31170":75405,"_21595":128692,"_5":14857,"_28362":128489,"_3076":128693},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3624":75464,"_31170":75405,"_21595":128695,"_5":14857,"_28362":128489,"_3076":128696},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3624":75465,"_31170":75405,"_21595":128698,"_5":14857,"_28362":128493,"_3076":128699},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3624":75466,"_31170":75405,"_21595":128701,"_5":14857,"_28362":128497,"_3076":128702},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3624":75467,"_31170":75405,"_21595":128704,"_5":14857,"_28362":128497,"_3076":128705},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3624":75468,"_31170":75405,"_21595":128707,"_5":14857,"_28362":128497,"_3076":128708},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3624":75469,"_31170":75405,"_21595":128710,"_5":14857,"_28362":128497,"_3076":128711},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3624":75470,"_31170":75405,"_21595":128713,"_5":14857,"_28362":128497,"_3076":128714},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3624":75471,"_31170":75405,"_21595":128716,"_5":14857,"_28362":128501,"_3076":128717},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3624":75472,"_31170":75405,"_21595":128719,"_5":14857,"_28362":128501,"_3076":128720},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3624":75473,"_31170":75405,"_21595":128722,"_5":14857,"_28362":128501,"_3076":128723},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3624":75474,"_31170":75405,"_21595":128725,"_5":14857,"_28362":128501,"_3076":128726},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3624":75475,"_31170":75405,"_21595":128728,"_5":14857,"_28362":128501,"_3076":128729},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3624":75476,"_31170":75405,"_21595":128731,"_5":14857,"_28362":128501,"_3076":128732},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3624":75477,"_31170":75405,"_21595":128734,"_5":14857,"_28362":128505,"_3076":128735},[],"Cambio",{"_3624":75478,"_31170":75405,"_21595":128737,"_5":14857,"_28362":128505,"_3076":128738},[],"A quién afecta",{"_3624":75479,"_31170":75405,"_21595":128740,"_5":14857,"_28362":128505,"_3076":128741},[],"Gravedad",{"_3624":75480,"_31170":75405,"_21595":128743,"_5":14857,"_28362":128505,"_3076":127214},[],{"_3624":75481,"_31170":75405,"_21595":128745,"_5":14857,"_28362":128505,"_3076":128513},[],{"_3624":75482,"_31170":75405,"_21595":128747,"_5":14857,"_28362":128505,"_3076":128748},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3624":75483,"_31170":75405,"_21595":128750,"_5":14857,"_28362":128505,"_3076":128751},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3624":75484,"_31170":75405,"_21595":128753,"_5":14857,"_28362":128505,"_3076":128754},[],"Copiar los datos a los volúmenes nuevos",{"_3624":75485,"_31170":75405,"_21595":128756,"_5":14857,"_28362":128505,"_3076":128517},[],{"_3624":75486,"_31170":75405,"_21595":128758,"_5":14857,"_28362":128505,"_3076":128759},[],"Todas las releases de Helm",{"_3624":75487,"_31170":75405,"_21595":128761,"_5":14857,"_28362":128505,"_3076":128762},[],"Alta: `helm upgrade` falla",{"_3624":75488,"_31170":75405,"_21595":128764,"_5":14857,"_28362":128505,"_3076":128765},[],"Eliminar o renombrar las claves heredadas",{"_3624":75489,"_31170":75405,"_21595":128767,"_5":14857,"_28362":128505,"_3076":120890},[],{"_3624":75490,"_31170":75405,"_21595":128769,"_5":14857,"_28362":128505,"_3076":128759},[],{"_3624":75491,"_31170":75405,"_21595":128771,"_5":14857,"_28362":128505,"_3076":128772},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3624":75492,"_31170":75405,"_21595":128774,"_5":14857,"_28362":128505,"_3076":128775},[],"Crear primero los Secrets; consulta el paso 2",{"_3624":75493,"_31170":75405,"_21595":128777,"_5":14857,"_28362":128505,"_3076":128524},[],{"_3624":75494,"_31170":75405,"_21595":128779,"_5":14857,"_28362":128505,"_3076":128780},[],"Todos los despliegues",{"_3624":75495,"_31170":75405,"_21595":128782,"_5":14857,"_28362":128505,"_3076":128783},[],"Alta: sin principal de bootstrap no hay administrador",{"_3624":75496,"_31170":75405,"_21595":128785,"_5":14857,"_28362":128505,"_3076":128786},[],"Configurar `services.authz`",{"_3624":75497,"_31170":75405,"_21595":128788,"_5":14857,"_28362":128505,"_3076":128528},[],{"_3624":75498,"_31170":75405,"_21595":128790,"_5":14857,"_28362":128505,"_3076":128759},[],{"_3624":75499,"_31170":75405,"_21595":128792,"_5":14857,"_28362":128505,"_3076":128793},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3624":75500,"_31170":75405,"_21595":128795,"_5":14857,"_28362":128505,"_3076":128796},[],"Mover JWKS y roles a `services.authz`",{"_3624":75501,"_31170":75405,"_21595":128798,"_5":14857,"_28362":128505,"_3076":128548},[],{"_3624":75502,"_31170":75405,"_21595":128800,"_5":14857,"_28362":128505,"_3076":128801},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3624":75503,"_31170":75405,"_21595":128803,"_5":14857,"_28362":128505,"_3076":128804},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3624":75504,"_31170":75405,"_21595":128806,"_5":14857,"_28362":128505,"_3076":128807},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3624":75505,"_31170":75405,"_21595":128809,"_5":14857,"_28362":128505,"_3076":128552},[],{"_3624":75506,"_31170":75405,"_21595":128811,"_5":14857,"_28362":128505,"_3076":128812},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3624":75507,"_31170":75405,"_21595":128814,"_5":14857,"_28362":128505,"_3076":128815},[],"Alta: el backend ya no arranca con ellos",{"_3624":75508,"_31170":75405,"_21595":128817,"_5":14857,"_28362":128505,"_3076":128818},[],"Pasar a PostgreSQL antes de actualizar",{"_3624":75509,"_31170":75405,"_21595":128820,"_5":14857,"_28362":128505,"_3076":128600},[],{"_3624":75510,"_31170":75405,"_21595":128822,"_5":14857,"_28362":128505,"_3076":128823},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3624":75511,"_31170":75405,"_21595":128825,"_5":14857,"_28362":128505,"_3076":128826},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3624":75512,"_31170":75405,"_21595":128828,"_5":14857,"_28362":128505,"_3076":128829},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3624":75513,"_31170":75405,"_21595":128831,"_5":14857,"_28362":128505,"_3076":128832},[],"Webhooks con referencias a archivos",{"_3624":75514,"_31170":75405,"_21595":128834,"_5":14857,"_28362":128505,"_3076":128835},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3624":75515,"_31170":75405,"_21595":128837,"_5":14857,"_28362":128505,"_3076":128838},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3624":75516,"_31170":75405,"_21595":128840,"_5":14857,"_28362":128505,"_3076":128841},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3624":75517,"_31170":75405,"_21595":128843,"_5":14857,"_28362":128505,"_3076":128532},[],{"_3624":75518,"_31170":75405,"_21595":128845,"_5":14857,"_28362":128505,"_3076":128846},[],"Releases con identidades por servicio o material de claves montado",{"_3624":75519,"_31170":75405,"_21595":128848,"_5":14857,"_28362":128505,"_3076":128849},[],"Media: los servicios no pueden leer sus archivos",{"_3624":75520,"_31170":75405,"_21595":128851,"_5":14857,"_28362":128505,"_3076":128852},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3624":75521,"_31170":75405,"_21595":128854,"_5":14857,"_28362":128505,"_3076":128536},[],{"_3624":75522,"_31170":75405,"_21595":128856,"_5":14857,"_28362":128505,"_3076":128857},[],"Releases que definen `amqp.tls`",{"_3624":75523,"_31170":75405,"_21595":128859,"_5":14857,"_28362":128505,"_3076":128860},[],"Media: los clientes se conectan al puerto equivocado",{"_3624":75524,"_31170":75405,"_21595":128862,"_5":14857,"_28362":128505,"_3076":128863},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3624":75525,"_31170":75405,"_21595":128865,"_5":14857,"_28362":128505,"_3076":128556},[],{"_3624":75526,"_31170":75405,"_21595":128867,"_5":14857,"_28362":128505,"_3076":128868},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3624":75527,"_31170":75405,"_21595":128870,"_5":14857,"_28362":128505,"_3076":128871},[],"Media: las claves de CA quedan sin gestionar",{"_3624":75528,"_31170":75405,"_21595":128873,"_5":14857,"_28362":128505,"_3076":128874},[],"Ejecutar la migración de CA a KMS",{"_3624":75529,"_31170":75405,"_21595":128876,"_5":14857,"_28362":128505,"_3076":128877},[],"Verificación del certificado del receptor",{"_3624":75530,"_31170":75405,"_21595":128879,"_5":14857,"_28362":128505,"_3076":128880},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3624":75531,"_31170":75405,"_21595":128882,"_5":14857,"_28362":128505,"_3076":128883},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3624":75532,"_31170":75405,"_21595":128885,"_5":14857,"_28362":128505,"_3076":128886},[],"Poner `insecure_skip_verify` a `false`",{"_3624":75533,"_31170":75405,"_21595":128888,"_5":14857,"_28362":128505,"_3076":128572},[],{"_3624":75534,"_31170":75405,"_21595":128890,"_5":14857,"_28362":128505,"_3076":128891},[],"Scripts y consolas que editan DMS por API",{"_3624":75535,"_31170":75405,"_21595":128893,"_5":14857,"_28362":128505,"_3076":128894},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3624":75536,"_31170":75405,"_21595":128896,"_5":14857,"_28362":128505,"_3076":128897},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3624":75537,"_31170":75405,"_21595":128899,"_5":14857,"_28362":128505,"_3076":128576},[],{"_3624":75538,"_31170":75405,"_21595":128901,"_5":14857,"_28362":128505,"_3076":128902},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3624":75539,"_31170":75405,"_21595":128904,"_5":14857,"_28362":128505,"_3076":128905},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3624":75540,"_31170":75405,"_21595":128907,"_5":14857,"_28362":128505,"_3076":128908},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3624":75541,"_31170":75405,"_21595":128910,"_5":14857,"_28362":128505,"_3076":128596},[],{"_3624":75542,"_31170":75405,"_21595":128912,"_5":14857,"_28362":128505,"_3076":128913},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3624":75543,"_31170":75405,"_21595":128915,"_5":14857,"_28362":128505,"_3076":128916},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3624":75544,"_31170":75405,"_21595":128918,"_5":14857,"_28362":128505,"_3076":128919},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3624":75545,"_31170":75405,"_21595":128921,"_5":14857,"_28362":128505,"_3076":128604},[],{"_3624":75546,"_31170":75405,"_21595":128923,"_5":14857,"_28362":128505,"_3076":128924},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3624":75547,"_31170":75405,"_21595":128926,"_5":14857,"_28362":128505,"_3076":128927},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3624":75548,"_31170":75405,"_21595":128929,"_5":14857,"_28362":128505,"_3076":128930},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3624":75549,"_31170":75405,"_21595":128932,"_5":14857,"_28362":128505,"_3076":128608},[],{"_3624":75550,"_31170":75405,"_21595":128934,"_5":14857,"_28362":128505,"_3076":128935},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3624":75551,"_31170":75405,"_21595":128937,"_5":14857,"_28362":128505,"_3076":128938},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3624":75552,"_31170":75405,"_21595":128940,"_5":14857,"_28362":128505,"_3076":128941},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3624":75553,"_31170":75405,"_21595":128943,"_5":14857,"_28362":128505,"_3076":128592},[],{"_3624":75554,"_31170":75405,"_21595":128945,"_5":14857,"_28362":128505,"_3076":128946},[],"Consumidores que leen el campo `events` del dispositivo",{"_3624":75555,"_31170":75405,"_21595":128948,"_5":14857,"_28362":128505,"_3076":128949},[],"Media: el campo desaparece",{"_3624":75556,"_31170":75405,"_21595":128951,"_5":14857,"_28362":128505,"_3076":128952},[],"Usar los nuevos endpoints de eventos",{"_3624":75557,"_31170":75405,"_21595":128954,"_5":14857,"_28362":128505,"_3076":128620},[],{"_3624":75558,"_31170":75405,"_21595":128956,"_5":14857,"_28362":128505,"_3076":128957},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3624":75559,"_31170":75405,"_21595":128959,"_5":14857,"_28362":128505,"_3076":128960},[],"Media: la migración de la VA aborta",{"_3624":75560,"_31170":75405,"_21595":128962,"_5":14857,"_28362":128505,"_3076":128963},[],"Corregir los roles afectados antes de actualizar",{"_3624":75561,"_31170":75405,"_21595":128965,"_5":14857,"_28362":128505,"_3076":128540},[],{"_3624":75562,"_31170":75405,"_21595":128967,"_5":14857,"_28362":128505,"_3076":128968},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3624":75563,"_31170":75405,"_21595":128970,"_5":14857,"_28362":128505,"_3076":128971},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3624":75564,"_31170":75405,"_21595":128973,"_5":14857,"_28362":128505,"_3076":128974},[],"Actualizar el archivo de values",{"_3624":75565,"_31170":75405,"_21595":128976,"_5":14857,"_28362":128505,"_3076":128584},[],{"_3624":75566,"_31170":75405,"_21595":128978,"_5":14857,"_28362":128505,"_3076":128979},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3624":75567,"_31170":75405,"_21595":128981,"_5":14857,"_28362":128505,"_3076":128982},[],"Baja: prevalece el ID de la URL",{"_3624":75568,"_31170":75405,"_21595":128984,"_5":14857,"_28362":128505,"_3076":128985},[],"Enviar el ID en la URL",{"_3624":75569,"_31170":75405,"_21595":128987,"_5":14857,"_28362":128505,"_3076":128612},[],{"_3624":75570,"_31170":75405,"_21595":128989,"_5":14857,"_28362":128505,"_3076":128990},[],"Clientes que envían un `id` al crear o importar CAs",{"_3624":75571,"_31170":75405,"_21595":128992,"_5":14857,"_28362":128505,"_3076":128993},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3624":75572,"_31170":75405,"_21595":128995,"_5":14857,"_28362":128505,"_3076":128996},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3624":75573,"_31170":75405,"_21595":128998,"_5":14857,"_28362":128505,"_3076":128616},[],{"_3624":75574,"_31170":75405,"_21595":129000,"_5":14857,"_28362":128505,"_3076":129001},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3624":75575,"_31170":75405,"_21595":129003,"_5":14857,"_28362":128505,"_3076":129004},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3624":75576,"_31170":75405,"_21595":129006,"_5":14857,"_28362":128505,"_3076":129007},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3624":75577,"_31170":75405,"_21595":129009,"_5":14857,"_28362":128505,"_3076":128588},[],{"_3624":75578,"_31170":75405,"_21595":129011,"_5":14857,"_28362":128505,"_3076":129012},[],"Consumidores que comparan el `type` del certificado",{"_3624":75579,"_31170":75405,"_21595":129014,"_5":14857,"_28362":128505,"_3076":129015},[],"Baja: dos valores cambian de nombre",{"_3624":75580,"_31170":75405,"_21595":129017,"_5":14857,"_28362":128505,"_3076":129018},[],"Adaptar los consumidores",{"_3624":75581,"_31170":75405,"_21595":129020,"_5":14857,"_28362":128505,"_3076":128580},[],{"_3624":75582,"_31170":75405,"_21595":129022,"_5":14857,"_28362":128505,"_3076":129023},[],"Cualquier DMS",{"_3624":75583,"_31170":75405,"_21595":129025,"_5":14857,"_28362":128505,"_3076":129026},[],"Baja: solo informativo",{"_3624":75584,"_31170":75405,"_21595":129028,"_5":14857,"_28362":128505,"_3076":129029},[],"Revisar ambos bloques antes de editar",{"_3624":75585,"_31170":75405,"_21595":129031,"_5":14857,"_28362":128512,"_3076":129032},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3624":75586,"_31170":75405,"_21595":129034,"_5":14857,"_28362":128512,"_3076":129035},[],"El paso 4 de la guía de migración copia los datos.",{"_3624":75587,"_31170":75405,"_21595":129037,"_5":14857,"_28362":128516,"_3076":129038},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3624":75588,"_31170":75405,"_21595":129040,"_5":14857,"_28362":128520,"_3076":129041},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3624":75589,"_31170":75405,"_21595":129043,"_5":14857,"_28362":128520,"_3076":129044},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3624":75590,"_31170":75405,"_21595":129046,"_5":14857,"_28362":128523,"_3076":129047},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3624":75591,"_31170":75405,"_21595":129049,"_5":14857,"_28362":128527,"_3076":129050},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3624":75592,"_31170":75405,"_21595":129052,"_5":14857,"_28362":128531,"_3076":129053},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3624":75593,"_31170":75405,"_21595":129055,"_5":14857,"_28362":128531,"_3076":129056},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3624":75594,"_31170":75405,"_21595":129058,"_5":14857,"_28362":128531,"_3076":129059},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3624":75595,"_31170":75405,"_21595":129061,"_5":14857,"_28362":128535,"_3076":129062},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3624":75596,"_31170":75405,"_21595":129064,"_5":14857,"_28362":128539,"_3076":129065},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3624":75597,"_31170":75405,"_21595":129067,"_5":14857,"_28362":128539,"_3076":129068},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3624":75598,"_31170":75405,"_21595":129070,"_5":14857,"_28362":128539,"_3076":129071},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3624":75599,"_31170":75405,"_21595":129073,"_5":14857,"_28362":128539,"_3076":129074},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3624":75600,"_31170":75405,"_21595":129076,"_5":14857,"_28362":128539,"_3076":129077},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3624":75601,"_31170":75405,"_21595":129079,"_5":14857,"_28362":128539,"_3076":129080},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3624":75602,"_31170":75405,"_21595":129082,"_5":14857,"_28362":128547,"_3076":129083},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3624":75603,"_31170":75405,"_21595":129085,"_5":14857,"_28362":128547,"_3076":129086},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3624":75604,"_31170":75405,"_21595":129088,"_5":14857,"_28362":128547,"_3076":129089},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3624":75605,"_31170":75405,"_21595":129091,"_5":14857,"_28362":128547,"_3076":129092},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3624":75606,"_31170":75405,"_21595":129094,"_5":14857,"_28362":128547,"_3076":129095},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3624":75607,"_31170":75405,"_21595":129097,"_5":14857,"_28362":128551,"_3076":129098},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3624":75608,"_31170":75405,"_21595":129100,"_5":14857,"_28362":128555,"_3076":129101},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3624":75609,"_31170":75405,"_21595":129103,"_5":14857,"_28362":128555,"_3076":129104},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3624":75610,"_31170":75405,"_21595":129106,"_5":14857,"_28362":128555,"_3076":129107},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3624":75611,"_31170":75405,"_21595":129109,"_5":14857,"_28362":128555,"_3076":129110},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3624":75612,"_31170":75405,"_21595":129112,"_5":14857,"_28362":128555,"_3076":129113},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3624":75613,"_31170":75405,"_21595":129115,"_5":14857,"_28362":128555,"_3076":129116},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3624":75614,"_31170":75405,"_21595":129118,"_5":14857,"_28362":128555,"_3076":129119},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3624":75615,"_31170":75405,"_21595":129121,"_5":14857,"_28362":128555,"_3076":129122},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3624":75616,"_31170":75405,"_21595":129124,"_5":14857,"_28362":128559,"_3076":129125},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3624":75617,"_31170":75405,"_21595":129127,"_5":14857,"_28362":128567,"_3076":129128},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3624":75618,"_31170":75405,"_21595":129130,"_5":14857,"_28362":128567,"_3076":129131},[],"Campo en 3.8.0",{"_3624":75619,"_31170":75405,"_21595":129133,"_5":14857,"_28362":128567,"_3076":129134},[],"Campo en 4.0.0",{"_3624":75620,"_31170":75405,"_21595":129136,"_5":14857,"_28362":128567,"_3076":60014},[],{"_3624":75621,"_31170":75405,"_21595":129138,"_5":14857,"_28362":128567,"_3076":129139},[],"`insecure_skip_verify` (con el valor negado)",{"_3624":75622,"_31170":75405,"_21595":129141,"_5":14857,"_28362":128567,"_3076":60020},[],{"_3624":75623,"_31170":75405,"_21595":129143,"_5":14857,"_28362":128567,"_3076":60023},[],{"_3624":75624,"_31170":75405,"_21595":129145,"_5":14857,"_28362":128567,"_3076":60026},[],{"_3624":75625,"_31170":75405,"_21595":129147,"_5":14857,"_28362":128567,"_3076":60029},[],{"_3624":75626,"_31170":75405,"_21595":129149,"_5":14857,"_28362":128567,"_3076":60032},[],{"_3624":75627,"_31170":75405,"_21595":129151,"_5":14857,"_28362":128567,"_3076":60035},[],{"_3624":75628,"_31170":75405,"_21595":129153,"_5":14857,"_28362":128567,"_3076":129154},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3624":75629,"_31170":75405,"_21595":129156,"_5":14857,"_28362":128567,"_3076":129157},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3624":75630,"_31170":75405,"_21595":129159,"_5":14857,"_28362":128567,"_3076":129160},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3624":75631,"_31170":75405,"_21595":129162,"_5":14857,"_28362":128571,"_3076":129163},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3624":75632,"_31170":75405,"_21595":129165,"_5":14857,"_28362":128571,"_3076":129166},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3624":75633,"_31170":75405,"_21595":129168,"_5":14857,"_28362":128571,"_3076":129169},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3624":75634,"_31170":75405,"_21595":129171,"_5":14857,"_28362":128575,"_3076":129172},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3624":75635,"_31170":75405,"_21595":129174,"_5":14857,"_28362":128575,"_3076":129175},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3624":75636,"_31170":75405,"_21595":129177,"_5":14857,"_28362":128579,"_3076":129178},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3624":75637,"_31170":75405,"_21595":129180,"_5":14857,"_28362":128583,"_3076":129181},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3624":75638,"_31170":75405,"_21595":129183,"_5":14857,"_28362":128587,"_3076":129184},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3624":75639,"_31170":75405,"_21595":129186,"_5":14857,"_28362":128591,"_3076":129187},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3624":75640,"_31170":75405,"_21595":129189,"_5":14857,"_28362":128591,"_3076":129190},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3624":75641,"_31170":75405,"_21595":129192,"_5":14857,"_28362":128591,"_3076":129193},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3624":75642,"_31170":75405,"_21595":129195,"_5":14857,"_28362":128591,"_3076":129196},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3624":75643,"_31170":75405,"_21595":129198,"_5":14857,"_28362":128595,"_3076":129199},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3624":75644,"_31170":75405,"_21595":129201,"_5":14857,"_28362":128599,"_3076":129202},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3624":75645,"_31170":75405,"_21595":129204,"_5":14857,"_28362":128599,"_3076":129205},[],"Ruta",{"_3624":75646,"_31170":75405,"_21595":129207,"_5":14857,"_28362":128599,"_3076":121521},[],{"_3624":75647,"_31170":75405,"_21595":129209,"_5":14857,"_28362":128599,"_3076":60094},[],{"_3624":75648,"_31170":75405,"_21595":129211,"_5":14857,"_28362":128599,"_3076":129212},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3624":75649,"_31170":75405,"_21595":129214,"_5":14857,"_28362":128599,"_3076":60100},[],{"_3624":75650,"_31170":75405,"_21595":129216,"_5":14857,"_28362":128599,"_3076":129217},[],"Lee los ajustes de una CA.",{"_3624":75651,"_31170":75405,"_21595":129219,"_5":14857,"_28362":128599,"_3076":60106},[],{"_3624":75652,"_31170":75405,"_21595":129221,"_5":14857,"_28362":128599,"_3076":129222},[],"Sustituye los `crl_options`.",{"_3624":75653,"_31170":75405,"_21595":129224,"_5":14857,"_28362":128599,"_3076":60112},[],{"_3624":75654,"_31170":75405,"_21595":129226,"_5":14857,"_28362":128599,"_3076":129227},[],"Elimina los ajustes archivados de una CA.",{"_3624":75655,"_31170":75405,"_21595":129229,"_5":14857,"_28362":128599,"_3076":129230},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3624":75656,"_31170":75405,"_21595":129232,"_5":14857,"_28362":128599,"_3076":129233},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3624":75657,"_31170":75405,"_21595":129235,"_5":14857,"_28362":128599,"_3076":129236},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3624":75658,"_31170":75405,"_21595":129238,"_5":14857,"_28362":128599,"_3076":129239},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3624":75659,"_31170":75405,"_21595":129241,"_5":14857,"_28362":128599,"_3076":129242},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3624":75660,"_31170":75405,"_21595":129244,"_5":14857,"_28362":128599,"_3076":129245},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3624":75661,"_31170":75405,"_21595":129247,"_5":14857,"_28362":128599,"_3076":129248},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3624":75662,"_31170":75405,"_21595":129250,"_5":14857,"_28362":128599,"_3076":129251},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3624":75663,"_31170":75405,"_21595":129253,"_5":14857,"_28362":128599,"_3076":129254},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3624":75664,"_31170":75405,"_21595":129256,"_5":14857,"_28362":128599,"_3076":129257},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3624":75665,"_31170":75405,"_21595":129259,"_5":14857,"_28362":128599,"_3076":129260},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3624":75666,"_31170":75405,"_21595":129262,"_5":14857,"_28362":128603,"_3076":129263},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3624":75667,"_31170":75405,"_21595":129265,"_5":14857,"_28362":128607,"_3076":129266},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3624":75668,"_31170":75405,"_21595":129268,"_5":14857,"_28362":128611,"_3076":129269},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3624":75669,"_31170":75405,"_21595":129271,"_5":14857,"_28362":128615,"_3076":129272},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3624":75670,"_31170":75405,"_21595":129274,"_5":14857,"_28362":128615,"_3076":129275},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3624":75671,"_31170":75405,"_21595":129277,"_5":14857,"_28362":128619,"_3076":129278},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3624":75672,"_31170":75405,"_21595":129280,"_5":14857,"_28362":128623,"_3076":129281},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3624":75673,"_31170":75405,"_21595":129283,"_5":14857,"_28362":128627,"_3076":129284},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3624":75674,"_31170":75405,"_21595":129286,"_5":14857,"_28362":128627,"_3076":129287},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3624":75675,"_31170":75405,"_21595":129289,"_5":14857,"_28362":128627,"_3076":129290},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3624":75676,"_31170":75405,"_21595":129292,"_5":14857,"_28362":128627,"_3076":129293},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3624":75677,"_31170":75405,"_21595":129295,"_5":14857,"_28362":128627,"_3076":129296},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3624":75678,"_31170":75405,"_21595":129298,"_5":14857,"_28362":128627,"_3076":129299},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3624":75679,"_31170":75405,"_21595":129301,"_5":14857,"_28362":128631,"_3076":129302},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3624":75680,"_31170":75405,"_21595":129304,"_5":14857,"_28362":128631,"_3076":129305},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3624":75681,"_31170":75405,"_21595":129307,"_5":14857,"_28362":128631,"_3076":129308},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3624":75682,"_31170":75405,"_21595":129310,"_5":14857,"_28362":128631,"_3076":129311},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3624":75683,"_31170":75405,"_21595":129313,"_5":14857,"_28362":128631,"_3076":129314},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3624":75684,"_31170":75405,"_21595":129316,"_5":14857,"_28362":128635,"_3076":129317},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3624":75685,"_31170":75405,"_21595":129319,"_5":14857,"_28362":128635,"_3076":129320},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3624":75686,"_31170":75405,"_21595":129322,"_5":14857,"_28362":128635,"_3076":129323},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3624":75687,"_31170":75405,"_21595":129325,"_5":14857,"_28362":128635,"_3076":60214},[],{"_3624":75688,"_31170":75405,"_21595":129327,"_5":14857,"_28362":128635,"_3076":129328},[],"Claves de datos obligatorias",{"_3624":75689,"_31170":75405,"_21595":129330,"_5":14857,"_28362":128635,"_3076":129331},[],"Cuándo",{"_3624":75690,"_31170":75405,"_21595":129333,"_5":14857,"_28362":128635,"_3076":129334},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3624":75691,"_31170":75405,"_21595":129336,"_5":14857,"_28362":128635,"_3076":60226},[],{"_3624":75692,"_31170":75405,"_21595":129338,"_5":14857,"_28362":128635,"_3076":129339},[],"Siempre",{"_3624":75693,"_31170":75405,"_21595":129341,"_5":14857,"_28362":128635,"_3076":129342},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3624":75694,"_31170":75405,"_21595":129344,"_5":14857,"_28362":128635,"_3076":60226},[],{"_3624":75695,"_31170":75405,"_21595":129346,"_5":14857,"_28362":128635,"_3076":129339},[],{"_3624":75696,"_31170":75405,"_21595":129348,"_5":14857,"_28362":128635,"_3076":60239},[],{"_3624":75697,"_31170":75405,"_21595":129350,"_5":14857,"_28362":128635,"_3076":60226},[],{"_3624":75698,"_31170":75405,"_21595":129352,"_5":14857,"_28362":128635,"_3076":129353},[],"Solo cuando hay autenticación SMTP",{"_3624":75699,"_31170":75405,"_21595":129355,"_5":14857,"_28362":128635,"_3076":129356},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3624":75700,"_31170":75405,"_21595":129358,"_5":14857,"_28362":128635,"_3076":129359},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3624":75701,"_31170":75405,"_21595":129361,"_5":14857,"_28362":128635,"_3076":129362},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3624":75702,"_31170":75405,"_21595":129364,"_5":14857,"_28362":128635,"_3076":129365},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3624":75703,"_31170":75405,"_21595":129367,"_5":14857,"_28362":128635,"_3076":129368},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3624":75704,"_31170":75405,"_21595":129370,"_5":14857,"_28362":128635,"_3076":129371},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3624":75705,"_31170":75405,"_21595":129373,"_5":14857,"_28362":128635,"_3076":129374},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3624":75706,"_31170":75405,"_21595":129376,"_5":14857,"_28362":128635,"_3076":129377},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3624":75707,"_31170":75405,"_21595":129379,"_5":14857,"_28362":128635,"_3076":129380},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3624":75708,"_31170":75405,"_21595":129382,"_5":14857,"_28362":128635,"_3076":129383},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3624":75709,"_31170":75405,"_21595":129385,"_5":14857,"_28362":128635,"_3076":129386},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3624":75710,"_31170":75405,"_21595":129388,"_5":14857,"_28362":128635,"_3076":129389},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3624":75711,"_31170":75405,"_21595":129391,"_5":14857,"_28362":128635,"_3076":129392},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3624":75712,"_31170":75405,"_21595":129394,"_5":14857,"_28362":128635,"_3076":129395},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3624":75713,"_31170":75405,"_21595":129397,"_5":14857,"_28362":128635,"_3076":129398},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3624":75714,"_31170":75405,"_21595":129400,"_5":14857,"_28362":128639,"_3076":129401},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3624":75715,"_31170":75405,"_21595":129403,"_5":14857,"_28362":128639,"_3076":129404},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3624":75716,"_31170":75405,"_21595":129406,"_5":14857,"_28362":128643,"_3076":129407},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3624":75717,"_31170":75405,"_21595":129409,"_5":14857,"_28362":128643,"_3076":129410},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3624":75718,"_31170":75405,"_21595":129412,"_5":14857,"_28362":128643,"_3076":129413},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3624":75719,"_31170":75405,"_21595":129415,"_5":14857,"_28362":128643,"_3076":129416},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3624":75720,"_31170":75405,"_21595":129418,"_5":14857,"_28362":128643,"_3076":129419},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3624":75721,"_31170":75405,"_21595":129421,"_5":14857,"_28362":128643,"_3076":129422},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3624":75722,"_31170":75405,"_21595":129424,"_5":14857,"_28362":128643,"_3076":129425},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3624":75723,"_31170":75405,"_21595":129427,"_5":14857,"_28362":128643,"_3076":129428},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3624":75724,"_31170":75405,"_21595":129430,"_5":14857,"_28362":128643,"_3076":129431},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3624":75725,"_31170":75405,"_21595":129433,"_5":14857,"_28362":128643,"_3076":129434},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3624":75726,"_31170":75405,"_21595":129436,"_5":14857,"_28362":128643,"_3076":129437},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3624":75727,"_31170":75405,"_21595":129439,"_5":14857,"_28362":128647,"_3076":129440},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3624":75728,"_31170":75405,"_21595":129442,"_5":14857,"_28362":128647,"_3076":129443},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3624":75729,"_31170":75405,"_21595":129445,"_5":14857,"_28362":128651,"_3076":129446},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3624":75730,"_31170":75405,"_21595":129448,"_5":14857,"_28362":128651,"_3076":129449},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3624":75731,"_31170":75405,"_21595":129451,"_5":14857,"_28362":128651,"_3076":129452},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3624":75732,"_31170":75405,"_21595":129454,"_5":14857,"_28362":128651,"_3076":129455},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3624":75733,"_31170":75405,"_21595":129457,"_5":14857,"_28362":128651,"_3076":129458},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3624":75734,"_31170":75405,"_21595":129460,"_5":14857,"_28362":128651,"_3076":129461},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3624":75735,"_31170":75405,"_21595":129463,"_5":14857,"_28362":128651,"_3076":129464},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3624":75736,"_31170":75405,"_21595":129466,"_5":14857,"_28362":128651,"_3076":129467},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3624":75737,"_31170":75405,"_21595":129469,"_5":14857,"_28362":128655,"_3076":129470},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3624":75738,"_31170":75405,"_21595":129472,"_5":14857,"_28362":128655,"_3076":129473},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3624":75739,"_31170":75405,"_21595":129475,"_5":14857,"_28362":128655,"_3076":129476},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3624":75740,"_31170":75405,"_21595":129478,"_5":14857,"_28362":128655,"_3076":129479},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3624":75741,"_31170":75405,"_21595":129481,"_5":14857,"_28362":128655,"_3076":129482},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3624":75742,"_31170":75405,"_21595":129484,"_5":14857,"_28362":128655,"_3076":129485},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3624":75743,"_31170":75405,"_21595":129487,"_5":14857,"_28362":128655,"_3076":129488},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3624":75744,"_31170":75405,"_21595":129490,"_5":14857,"_28362":128655,"_3076":129491},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3624":75745,"_31170":75405,"_21595":129493,"_5":14857,"_28362":128655,"_3076":129494},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3624":75746,"_31170":75405,"_21595":129496,"_5":14857,"_28362":128655,"_3076":129497},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3624":75747,"_31170":75405,"_21595":129499,"_5":14857,"_28362":128655,"_3076":129500},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3624":75748,"_31170":75405,"_21595":129502,"_5":14857,"_28362":128658,"_3076":129503},[],"Tras la actualización, comprueba en este orden:",{"_3624":75749,"_31170":75405,"_21595":129505,"_5":14857,"_28362":128658,"_3076":129506},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3624":75750,"_31170":75405,"_21595":129508,"_5":14857,"_28362":128658,"_3076":129509},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3624":75751,"_31170":75405,"_21595":129511,"_5":14857,"_28362":128658,"_3076":129512},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3624":75752,"_31170":75405,"_21595":129514,"_5":14857,"_28362":128658,"_3076":129515},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3624":75753,"_31170":75405,"_21595":129517,"_5":14857,"_28362":128658,"_3076":129518},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3624":75754,"_31170":75405,"_21595":129520,"_5":14857,"_28362":128658,"_3076":129521},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3624":75755,"_31170":75405,"_21595":129523,"_5":14857,"_28362":128658,"_3076":129524},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3624":75756,"_31170":75405,"_21595":129526,"_5":14857,"_28362":128658,"_3076":129527},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3624":75757,"_31170":75405,"_21595":129529,"_5":14857,"_28362":128658,"_3076":129530},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3624":75758,"_31170":75405,"_21595":129532,"_5":14857,"_28362":128658,"_3076":129533},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3624":75759,"_31170":75405,"_21595":129535,"_5":14857,"_28362":128658,"_3076":129536},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3624":75760,"_31170":75405,"_21595":129538,"_5":14857,"_28362":128658,"_3076":129539},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3624":75761,"_31170":75405,"_21595":129541,"_5":14857,"_28362":128658,"_3076":129542},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3624":75762,"_31170":75405,"_21595":129544,"_5":14857,"_28362":128658,"_3076":129545},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3624":75763,"_31170":75405,"_21595":129547,"_5":14857,"_28362":128658,"_3076":129548},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3624":75764,"_31170":75405,"_21595":129550,"_5":14857,"_28362":128662,"_3076":129551},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3624":75765,"_31170":75405,"_21595":129553,"_5":14857,"_28362":128662,"_3076":129554},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3624":75766,"_31170":75405,"_21595":129556,"_5":14857,"_28362":128662,"_3076":129557},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3624":75767,"_31170":75405,"_21595":129559,"_5":14857,"_28362":128662,"_3076":129560},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3624":75768,"_31170":75405,"_21595":129562,"_5":14857,"_28362":128662,"_3076":129563},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60457":129565,"_60459":129566,"_60461":129567,"_60463":129568,"_18727":3111,"_72706":3111},"spanish",[3076,31170,5,28362],{"_3076":25781,"_31170":25781,"_5":25781,"_28362":25781},{"_3076":129569,"_31170":132628,"_5":135687,"_28362":138746},{"_4825":129570,"_60467":129571,"_5":25781},{"_14938":3388,"_15317":6343,"_15336":4664,"_30170":7963,"_15323":4213,"_20507":6725,"_14959":3494,"_14966":7925,"_30112":12141,"_30520":6220,"_30547":7277,"_30146":4568,"_35575":5174,"_30249":20993,"_30591":10209,"_35582":5449,"_35585":4214,"_35588":5829,"_35591":5642,"_30993":12406,"_35596":19797,"_35598":3965,"_31028":13823,"_15332":31186,"_35602":7807,"_35605":17782,"_35607":5139,"_30575":12761,"_31013":4242,"_31041":3296,"_35612":5300,"_35614":3263,"_35616":6307,"_30260":7983,"_3561