41418":129183,"_41420":129186,"_41422":129189,"_41424":129192,"_41427":129195,"_41429":129198,"_41431":129201,"_41433":129203,"_41435":129205,"_41437":129208,"_41439":129210,"_41441":129213,"_41443":129215,"_41445":129218,"_41447":129220,"_41449":129223,"_41451":129226,"_41453":129229,"_41456":129232,"_41459":129235,"_41461":129238,"_41463":129241,"_41465":129244,"_41467":129247,"_41469":129250,"_41471":129253,"_41473":129256,"_41476":129259,"_41478":129262,"_41480":129265,"_41482":129268,"_41484":129271,"_41486":129274,"_41488":129277,"_41490":129280,"_41492":129283,"_41494":129286,"_41496":129289,"_41498":129292,"_41500":129295,"_41502":129298,"_41504":129301,"_41506":129304,"_41508":129307,"_41510":129310,"_41512":129313,"_41514":129316,"_41516":129319,"_41518":129321,"_41520":129324,"_41522":129327,"_41524":129330,"_41526":129332,"_41528":129335,"_41530":129338,"_41532":129340,"_41534":129342,"_41536":129344,"_41538":129346,"_41540":129349,"_41542":129352,"_41544":129355,"_41546":129358,"_41548":129361,"_41550":129364,"_41552":129367,"_41554":129370,"_41556":129373,"_41558":129376,"_41560":129379,"_41562":129382,"_41564":129385,"_41566":129388,"_41568":129391,"_41570":129394,"_41572":129397,"_41574":129400,"_41576":129403,"_41578":129406,"_41580":129409,"_41583":129412,"_41585":129415,"_41587":129418,"_41589":129421,"_41591":129424,"_41593":129427,"_41595":129430,"_41597":129433,"_41599":129436,"_41601":129439,"_41603":129442,"_41605":129445,"_41607":129448,"_41609":129451,"_41612":129454,"_41614":129457,"_41616":129460,"_41618":129463,"_41620":129466,"_41622":129469,"_41624":129472,"_41626":129475,"_41628":129478,"_41630":129481,"_41632":129484,"_41634":129487,"_41636":129490,"_41638":129493,"_41640":129496,"_41642":129499,"_41644":129502,"_41646":129505,"_41648":129508,"_41650":129511,"_41652":129514,"_41654":129517,"_41656":129520,"_41658":129523,"_41660":129526,"_41662":129529,"_41664":129532,"_41666":129535,"_41668":129538,"_41670":129541,"_41672":129544,"_41674":129547,"_41677":129550,"_41679":129553,"_41681":129556},{"_3624":72708,"_31165":72708,"_5":15217,"_3076":120279,"_31523":120280,"_21590":120283,"_28357":72708},"Despliega desde AWS Marketplace",[50932,120281,120282],"Despliegue","Otros modelos",[],{"_3624":72709,"_31165":72708,"_21590":120285,"_5":14857,"_28357":72708,"_3076":120286},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3624":72710,"_31165":72708,"_5":31520,"_21590":120288,"_28357":120289,"_3076":120290},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3624":72711,"_31165":72708,"_5":31520,"_21590":120292,"_28357":120293,"_3076":120294},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3624":72712,"_31165":72708,"_5":31520,"_21590":120296,"_28357":120297,"_3076":120298},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3624":72713,"_31165":72708,"_5":31520,"_21590":120300,"_28357":120301,"_3076":120302},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3624":72714,"_31165":72708,"_5":31520,"_21590":120304,"_28357":120305,"_3076":120306},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3624":72715,"_31165":72708,"_5":31520,"_21590":120308,"_28357":120309,"_3076":120310},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3624":72716,"_31165":72708,"_5":31520,"_21590":120312,"_28357":120313,"_3076":120314},[],"/docs/pr-preview/pr-76/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3624":72717,"_31165":72708,"_21590":120316,"_5":14857,"_28357":72708,"_3076":120317},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3624":72718,"_31165":72708,"_21590":120319,"_5":14857,"_28357":120289,"_3076":120320},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3624":72719,"_31165":72708,"_21590":120322,"_5":14857,"_28357":120289,"_3076":120323},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3624":72720,"_31165":72708,"_21590":120325,"_5":14857,"_28357":120289,"_3076":120326},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3624":72721,"_31165":72708,"_21590":120328,"_5":14857,"_28357":120293,"_3076":120329},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3624":72722,"_31165":72708,"_21590":120331,"_5":14857,"_28357":120293,"_3076":120332},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3624":72723,"_31165":72708,"_21590":120334,"_5":14857,"_28357":120293,"_3076":120335},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3624":72724,"_31165":72708,"_21590":120337,"_5":14857,"_28357":120297,"_3076":120338},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3624":72725,"_31165":72708,"_21590":120340,"_5":14857,"_28357":120301,"_3076":120341},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3624":72726,"_31165":72708,"_21590":120343,"_5":14857,"_28357":120305,"_3076":120344},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3624":72727,"_31165":72708,"_21590":120346,"_5":14857,"_28357":120309,"_3076":120347},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3624":72728,"_31165":72708,"_21590":120349,"_5":14857,"_28357":120313,"_3076":120350},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3624":72729,"_31165":72729,"_5":15217,"_3076":120352,"_31523":120353,"_21590":120354,"_28357":72729},"Despliega Lamassu",[50932,120281],[],{"_3624":72730,"_31165":72729,"_21590":120356,"_5":14857,"_28357":72729,"_3076":120357},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3624":72731,"_31165":72729,"_5":31520,"_21590":120359,"_28357":120360,"_3076":120361},[],"/docs/pr-preview/pr-76/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3624":72732,"_31165":72729,"_5":31520,"_21590":120363,"_28357":120364,"_3076":120365},[],"/docs/pr-preview/pr-76/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3624":72733,"_31165":72729,"_5":31520,"_21590":120367,"_28357":120368,"_3076":120369},[],"/docs/pr-preview/pr-76/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3624":72734,"_31165":72729,"_21590":120371,"_5":14857,"_28357":72729,"_3076":120372},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3624":72735,"_31165":72729,"_21590":120374,"_5":14857,"_28357":120360,"_3076":120375},[],"Modelo",{"_3624":72736,"_31165":72729,"_21590":120377,"_5":14857,"_28357":120360,"_3076":120378},[],"Recomendado para",{"_3624":72737,"_31165":72729,"_21590":120380,"_5":14857,"_28357":120360,"_3076":120381},[],"Quién opera la infraestructura",{"_3624":72738,"_31165":72729,"_21590":120383,"_5":14857,"_28357":120360,"_3076":120384},[],"Punto de partida",{"_3624":72739,"_31165":72729,"_21590":120386,"_5":14857,"_28357":120360,"_3076":51039},[],{"_3624":72740,"_31165":72729,"_21590":120388,"_5":14857,"_28357":120360,"_3076":120389},[],"Producción, entornos regulados y despliegues personalizados",{"_3624":72741,"_31165":72729,"_21590":120391,"_5":14857,"_28357":120360,"_3076":120392},[],"Tu equipo",{"_3624":72742,"_31165":72729,"_21590":120394,"_5":14857,"_28357":120360,"_3076":120395},[],"Helm o Fastlane",{"_3624":72743,"_31165":72729,"_21590":120397,"_5":14857,"_28357":120360,"_3076":51051},[],{"_3624":72744,"_31165":72729,"_21590":120399,"_5":14857,"_28357":120360,"_3076":120400},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3624":72745,"_31165":72729,"_21590":120402,"_5":14857,"_28357":120360,"_3076":120392},[],{"_3624":72746,"_31165":72729,"_21590":120404,"_5":14857,"_28357":120360,"_3076":120405},[],"Imagen preconfigurada en EC2",{"_3624":72747,"_31165":72729,"_21590":120407,"_5":14857,"_28357":120360,"_3076":51062},[],{"_3624":72748,"_31165":72729,"_21590":120409,"_5":14857,"_28357":120360,"_3076":120410},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3624":72749,"_31165":72729,"_21590":120412,"_5":14857,"_28357":120360,"_3076":51068},[],{"_3624":72750,"_31165":72729,"_21590":120414,"_5":14857,"_28357":120360,"_3076":120415},[],"Suscripción gestionada",{"_3624":72751,"_31165":72729,"_21590":120417,"_5":14857,"_28357":120360,"_3076":120418},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3624":72752,"_31165":72729,"_21590":120420,"_5":14857,"_28357":120360,"_3076":120421},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3624":72753,"_31165":72729,"_21590":120423,"_5":14857,"_28357":120360,"_3076":120424},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3624":72754,"_31165":72729,"_21590":120426,"_5":14857,"_28357":120364,"_3076":120427},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3624":72755,"_31165":72729,"_21590":120429,"_5":14857,"_28357":120368,"_3076":120430},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3624":72756,"_31165":72756,"_5":15217,"_3076":120432,"_31523":120433,"_21590":120434,"_28357":72756},"Utiliza Lamassu como SaaS",[50932,120281,120282],[],{"_3624":72757,"_31165":72756,"_21590":120436,"_5":14857,"_28357":72756,"_3076":120437},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3624":72758,"_31165":72756,"_5":31520,"_21590":120439,"_28357":120440,"_3076":120441},[],"/docs/pr-preview/pr-76/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3624":72759,"_31165":72756,"_5":31520,"_21590":120443,"_28357":120444,"_3076":120445},[],"/docs/pr-preview/pr-76/es/deployment/saas#planes","Planes",{"_3624":72760,"_31165":72756,"_5":31520,"_21590":120447,"_28357":120448,"_3076":120449},[],"/docs/pr-preview/pr-76/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3624":72761,"_31165":72756,"_21590":120451,"_5":14857,"_28357":72756,"_3076":120452},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3624":72762,"_31165":72756,"_21590":120454,"_5":14857,"_28357":120440,"_3076":120455},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3624":72763,"_31165":72756,"_21590":120457,"_5":14857,"_28357":120440,"_3076":120458},[],"Copias de seguridad automáticas.",{"_3624":72764,"_31165":72756,"_21590":120460,"_5":14857,"_28357":120440,"_3076":120461},[],"Actualizaciones de versión.",{"_3624":72765,"_31165":72756,"_21590":120463,"_5":14857,"_28357":120440,"_3076":120464},[],"Soporte técnico y SLA según el plan contratado.",{"_3624":72766,"_31165":72756,"_21590":120466,"_5":14857,"_28357":120444,"_3076":51123},[],{"_3624":72767,"_31165":72756,"_21590":120468,"_5":14857,"_28357":120444,"_3076":120469},[],"Dispositivos",{"_3624":72768,"_31165":72756,"_21590":120471,"_5":14857,"_28357":120444,"_3076":120472},[],"Soporte",{"_3624":72769,"_31165":72756,"_21590":120474,"_5":14857,"_28357":120444,"_3076":51132},[],{"_3624":72770,"_31165":72756,"_21590":120476,"_5":14857,"_28357":120444,"_3076":51135},[],{"_3624":72771,"_31165":72756,"_21590":120478,"_5":14857,"_28357":120444,"_3076":120479},[],"Hasta 1.000",{"_3624":72772,"_31165":72756,"_21590":120481,"_5":14857,"_28357":120444,"_3076":51141},[],{"_3624":72773,"_31165":72756,"_21590":120483,"_5":14857,"_28357":120444,"_3076":120484},[],"99,5 %",{"_3624":72774,"_31165":72756,"_21590":120486,"_5":14857,"_28357":120444,"_3076":51147},[],{"_3624":72775,"_31165":72756,"_21590":120488,"_5":14857,"_28357":120444,"_3076":120489},[],"Hasta 10.000",{"_3624":72776,"_31165":72756,"_21590":120491,"_5":14857,"_28357":120444,"_3076":120492},[],"Email y chat",{"_3624":72777,"_31165":72756,"_21590":120494,"_5":14857,"_28357":120444,"_3076":120495},[],"99,9 %",{"_3624":72778,"_31165":72756,"_21590":120497,"_5":14857,"_28357":120444,"_3076":51159},[],{"_3624":72779,"_31165":72756,"_21590":120499,"_5":14857,"_28357":120444,"_3076":120500},[],"Ilimitados",{"_3624":72780,"_31165":72756,"_21590":120502,"_5":14857,"_28357":120444,"_3076":120503},[],"Dedicado",{"_3624":72781,"_31165":72756,"_21590":120505,"_5":14857,"_28357":120444,"_3076":120506},[],"99,99 %",{"_3624":72782,"_31165":72756,"_21590":120508,"_5":14857,"_28357":120448,"_3076":120509},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3624":72783,"_31165":72756,"_21590":120511,"_5":14857,"_28357":120448,"_3076":120512},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3624":72784,"_31165":72784,"_5":15217,"_3076":51176,"_31523":120514,"_21590":120516,"_28357":72784},[50932,120281,120515],"Kubernetes autogestionado",[],{"_3624":72785,"_31165":72784,"_21590":120518,"_5":14857,"_28357":72784,"_3076":120519},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3624":72786,"_31165":72784,"_5":31520,"_21590":120521,"_28357":120522,"_3076":120523},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3624":72787,"_31165":72784,"_5":31520,"_21590":120525,"_28357":120526,"_3076":120527},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3624":72788,"_31165":72784,"_5":31520,"_21590":120529,"_28357":120530,"_3076":120531},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3624":72789,"_31165":72784,"_5":31520,"_21590":120533,"_28357":120534,"_3076":120535},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3624":72790,"_31165":72784,"_5":31520,"_21590":120537,"_28357":120538,"_3076":120539},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3624":72791,"_31165":72784,"_5":31520,"_21590":120541,"_28357":120542,"_3076":120543},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3624":72792,"_31165":72784,"_5":31520,"_21590":120545,"_28357":120546,"_3076":120547},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3624":72793,"_31165":72784,"_5":31520,"_21590":120549,"_28357":120550,"_3076":120551},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3624":72794,"_31165":72784,"_5":31520,"_21590":120553,"_28357":120554,"_3076":120555},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3624":72795,"_31165":72784,"_5":31520,"_21590":120557,"_28357":120558,"_3076":120559},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3624":72796,"_31165":72784,"_5":31520,"_21590":120561,"_28357":120562,"_3076":120563},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3624":72797,"_31165":72784,"_21590":120565,"_5":14857,"_28357":120522,"_3076":120566},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3624":72798,"_31165":72784,"_21590":120568,"_5":14857,"_28357":120522,"_3076":120569},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3624":72799,"_31165":72784,"_21590":120571,"_5":14857,"_28357":120526,"_3076":120572},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3624":72800,"_31165":72784,"_21590":120574,"_5":14857,"_28357":120526,"_3076":120575},[],"Fastlane instala o configura",{"_3624":72801,"_31165":72784,"_21590":120577,"_5":14857,"_28357":120526,"_3076":120578},[],"Tú sigues proporcionando",{"_3624":72802,"_31165":72784,"_21590":120580,"_5":14857,"_28357":120526,"_3076":120581},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3624":72803,"_31165":72784,"_21590":120583,"_5":14857,"_28357":120526,"_3076":120584},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3624":72804,"_31165":72784,"_21590":120586,"_5":14857,"_28357":120526,"_3076":120587},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3624":72805,"_31165":72784,"_21590":120589,"_5":14857,"_28357":120526,"_3076":120590},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3624":72806,"_31165":72784,"_21590":120592,"_5":14857,"_28357":120526,"_3076":120593},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3624":72807,"_31165":72784,"_21590":120595,"_5":14857,"_28357":120526,"_3076":120596},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3624":72808,"_31165":72784,"_21590":120598,"_5":14857,"_28357":120526,"_3076":120599},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3624":72809,"_31165":72784,"_21590":120601,"_5":14857,"_28357":120526,"_3076":120602},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3624":72810,"_31165":72784,"_21590":120604,"_5":14857,"_28357":120526,"_3076":120605},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3624":72811,"_31165":72784,"_21590":120607,"_5":14857,"_28357":120530,"_3076":120608},[],"Necesitas:",{"_3624":72812,"_31165":72784,"_21590":120610,"_5":14857,"_28357":120530,"_3076":120611},[],"un clúster Kubernetes existente",{"_3624":72813,"_31165":72784,"_21590":120613,"_5":14857,"_28357":120530,"_3076":120614},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3624":72814,"_31165":72784,"_21590":120616,"_5":14857,"_28357":120530,"_3076":51278},[],{"_3624":72815,"_31165":72784,"_21590":120618,"_5":14857,"_28357":120530,"_3076":24402},[],{"_3624":72816,"_31165":72784,"_21590":120620,"_5":14857,"_28357":120530,"_3076":120621},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3624":72817,"_31165":72784,"_21590":120623,"_5":14857,"_28357":120530,"_3076":120624},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3624":72818,"_31165":72784,"_21590":120626,"_5":14857,"_28357":120530,"_3076":120627},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3624":72819,"_31165":72784,"_21590":120629,"_5":14857,"_28357":120530,"_3076":120630},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3624":72820,"_31165":72784,"_21590":120632,"_5":14857,"_28357":120530,"_3076":120633},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3624":72821,"_31165":72784,"_21590":120635,"_5":14857,"_28357":120534,"_3076":120636},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3624":72822,"_31165":72784,"_21590":120638,"_5":14857,"_28357":120534,"_3076":120639},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3624":72823,"_31165":72784,"_21590":120641,"_5":14857,"_28357":120538,"_3076":120642},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3624":72824,"_31165":72784,"_21590":120644,"_5":14857,"_28357":120538,"_3076":120645},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3624":72825,"_31165":72784,"_21590":120647,"_5":14857,"_28357":120538,"_3076":120648},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3624":72826,"_31165":72784,"_21590":120650,"_5":14857,"_28357":120538,"_3076":120651},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3624":72827,"_31165":72784,"_21590":120653,"_5":14857,"_28357":120542,"_3076":120654},[],"Opción",{"_3624":72828,"_31165":72784,"_21590":120656,"_5":14857,"_28357":120542,"_3076":120657},[],"Valor predeterminado",{"_3624":72829,"_31165":72784,"_21590":120659,"_5":14857,"_28357":120542,"_3076":120660},[],"Propósito",{"_3624":72830,"_31165":72784,"_21590":120662,"_5":14857,"_28357":120542,"_3076":51325},[],{"_3624":72831,"_31165":72784,"_21590":120664,"_5":14857,"_28357":120542,"_3076":51328},[],{"_3624":72832,"_31165":72784,"_21590":120666,"_5":14857,"_28357":120542,"_3076":120667},[],"Muestra la ayuda",{"_3624":72833,"_31165":72784,"_21590":120669,"_5":14857,"_28357":120542,"_3076":51334},[],{"_3624":72834,"_31165":72784,"_21590":120671,"_5":14857,"_28357":120542,"_3076":120672},[],"contexto actual",{"_3624":72835,"_31165":72784,"_21590":120674,"_5":14857,"_28357":120542,"_3076":120675},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3624":72836,"_31165":72784,"_21590":120677,"_5":14857,"_28357":120542,"_3076":51343},[],{"_3624":72837,"_31165":72784,"_21590":120679,"_5":14857,"_28357":120542,"_3076":6790},[],{"_3624":72838,"_31165":72784,"_21590":120681,"_5":14857,"_28357":120542,"_3076":120682},[],"Omite prompts y genera credenciales para las dependencias",{"_3624":72839,"_31165":72784,"_21590":120684,"_5":14857,"_28357":120542,"_3076":51351},[],{"_3624":72840,"_31165":72784,"_21590":120686,"_5":14857,"_28357":120542,"_3076":51354},[],{"_3624":72841,"_31165":72784,"_21590":120688,"_5":14857,"_28357":120542,"_3076":120689},[],"Namespace de la instalación",{"_3624":72842,"_31165":72784,"_21590":120691,"_5":14857,"_28357":120542,"_3076":51360},[],{"_3624":72843,"_31165":72784,"_21590":120693,"_5":14857,"_28357":120542,"_3076":51363},[],{"_3624":72844,"_31165":72784,"_21590":120695,"_5":14857,"_28357":120542,"_3076":120696},[],"Dominio usado por la UI, OIDC y el certificado",{"_3624":72845,"_31165":72784,"_21590":120698,"_5":14857,"_28357":120542,"_3076":51369},[],{"_3624":72846,"_31165":72784,"_21590":120700,"_5":14857,"_28357":120542,"_3076":15569},[],{"_3624":72847,"_31165":72784,"_21590":120702,"_5":14857,"_28357":120542,"_3076":120703},[],"Versión del chart de Lamassu",{"_3624":72848,"_31165":72784,"_21590":120705,"_5":14857,"_28357":120542,"_3076":51377},[],{"_3624":72849,"_31165":72784,"_21590":120707,"_5":14857,"_28357":120542,"_3076":51380},[],{"_3624":72850,"_31165":72784,"_21590":120709,"_5":14857,"_28357":120542,"_3076":120710},[],"Puerto del listener HTTPS",{"_3624":72851,"_31165":72784,"_21590":120712,"_5":14857,"_28357":120542,"_3076":51386},[],{"_3624":72852,"_31165":72784,"_21590":120714,"_5":14857,"_28357":120542,"_3076":51389},[],{"_3624":72853,"_31165":72784,"_21590":120716,"_5":14857,"_28357":120542,"_3076":120717},[],"Puerto del listener HTTP",{"_3624":72854,"_31165":72784,"_21590":120719,"_5":14857,"_28357":120542,"_3076":51395},[],{"_3624":72855,"_31165":72784,"_21590":120721,"_5":14857,"_28357":120542,"_3076":51328},[],{"_3624":72856,"_31165":72784,"_21590":120723,"_5":14857,"_28357":120542,"_3076":120724},[],"Certificado PEM para TLS downstream",{"_3624":72857,"_31165":72784,"_21590":120726,"_5":14857,"_28357":120542,"_3076":51403},[],{"_3624":72858,"_31165":72784,"_21590":120728,"_5":14857,"_28357":120542,"_3076":51328},[],{"_3624":72859,"_31165":72784,"_21590":120730,"_5":14857,"_28357":120542,"_3076":120731},[],"Clave privada PEM para TLS downstream",{"_3624":72860,"_31165":72784,"_21590":120733,"_5":14857,"_28357":120542,"_3076":51411},[],{"_3624":72861,"_31165":72784,"_21590":120735,"_5":14857,"_28357":120542,"_3076":120736},[],"chart del repositorio",{"_3624":72862,"_31165":72784,"_21590":120738,"_5":14857,"_28357":120542,"_3076":120739},[],"Usa un chart local de Lamassu sin empaquetar",{"_3624":72863,"_31165":72784,"_21590":120741,"_5":14857,"_28357":120542,"_3076":51420},[],{"_3624":72864,"_31165":72784,"_21590":120743,"_5":14857,"_28357":120542,"_3076":120744},[],"detección automática",{"_3624":72865,"_31165":72784,"_21590":120746,"_5":14857,"_28357":120542,"_3076":120747},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3624":72866,"_31165":72784,"_21590":120749,"_5":14857,"_28357":120542,"_3076":51428},[],{"_3624":72867,"_31165":72784,"_21590":120751,"_5":14857,"_28357":120542,"_3076":6790},[],{"_3624":72868,"_31165":72784,"_21590":120753,"_5":14857,"_28357":120542,"_3076":120754},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3624":72869,"_31165":72784,"_21590":120756,"_5":14857,"_28357":120542,"_3076":51436},[],{"_3624":72870,"_31165":72784,"_21590":120758,"_5":14857,"_28357":120542,"_3076":6790},[],{"_3624":72871,"_31165":72784,"_21590":120760,"_5":14857,"_28357":120542,"_3076":120761},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3624":72872,"_31165":72784,"_21590":120763,"_5":14857,"_28357":120542,"_3076":51444},[],{"_3624":72873,"_31165":72784,"_21590":120765,"_5":14857,"_28357":120542,"_3076":6790},[],{"_3624":72874,"_31165":72784,"_21590":120767,"_5":14857,"_28357":120542,"_3076":120768},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3624":72875,"_31165":72784,"_21590":120770,"_5":14857,"_28357":120542,"_3076":51452},[],{"_3624":72876,"_31165":72784,"_21590":120772,"_5":14857,"_28357":120542,"_3076":6790},[],{"_3624":72877,"_31165":72784,"_21590":120774,"_5":14857,"_28357":120542,"_3076":120775},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3624":72878,"_31165":72784,"_21590":120777,"_5":14857,"_28357":120542,"_3076":51460},[],{"_3624":72879,"_31165":72784,"_21590":120779,"_5":14857,"_28357":120542,"_3076":51463},[],{"_3624":72880,"_31165":72784,"_21590":120781,"_5":14857,"_28357":120542,"_3076":120782},[],"Usa otro chart local de SoftHSM",{"_3624":72881,"_31165":72784,"_21590":120784,"_5":14857,"_28357":120542,"_3076":120785},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3624":72882,"_31165":72784,"_21590":120787,"_5":14857,"_28357":120546,"_3076":120788},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3624":72883,"_31165":72784,"_21590":120790,"_5":14857,"_28357":120546,"_3076":120791},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3624":72884,"_31165":72784,"_21590":120793,"_5":14857,"_28357":120546,"_3076":120794},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3624":72885,"_31165":72784,"_21590":120796,"_5":14857,"_28357":120546,"_3076":120797},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3624":72886,"_31165":72784,"_21590":120799,"_5":14857,"_28357":120546,"_3076":120800},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3624":72887,"_31165":72784,"_21590":120802,"_5":14857,"_28357":120546,"_3076":120803},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3624":72888,"_31165":72784,"_21590":120805,"_5":14857,"_28357":120550,"_3076":51490},[],{"_3624":72889,"_31165":72784,"_21590":120807,"_5":14857,"_28357":120550,"_3076":120808},[],"valida las herramientas locales y el clúster seleccionado",{"_3624":72890,"_31165":72784,"_21590":120810,"_5":14857,"_28357":120550,"_3076":120811},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3624":72891,"_31165":72784,"_21590":120813,"_5":14857,"_28357":120550,"_3076":120814},[],"crea el namespace",{"_3624":72892,"_31165":72784,"_21590":120816,"_5":14857,"_28357":120550,"_3076":120817},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3624":72893,"_31165":72784,"_21590":120819,"_5":14857,"_28357":120550,"_3076":120820},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3624":72894,"_31165":72784,"_21590":120822,"_5":14857,"_28357":120550,"_3076":120823},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3624":72895,"_31165":72784,"_21590":120825,"_5":14857,"_28357":120550,"_3076":120826},[],"instala RabbitMQ",{"_3624":72896,"_31165":72784,"_21590":120828,"_5":14857,"_28357":120550,"_3076":120829},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3624":72897,"_31165":72784,"_21590":120831,"_5":14857,"_28357":120550,"_3076":120832},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3624":72898,"_31165":72784,"_21590":120834,"_5":14857,"_28357":120550,"_3076":120835},[],"carga datos de ejemplo opcionalmente",{"_3624":72899,"_31165":72784,"_21590":120837,"_5":14857,"_28357":120550,"_3076":120838},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3624":72900,"_31165":72784,"_21590":120840,"_5":14857,"_28357":120554,"_3076":120841},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3624":72901,"_31165":72784,"_21590":120843,"_5":14857,"_28357":120554,"_3076":120844},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3624":72902,"_31165":72784,"_21590":120846,"_5":14857,"_28357":120558,"_3076":120847},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3624":72903,"_31165":72784,"_21590":120849,"_5":14857,"_28357":120558,"_3076":120850},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3624":72904,"_31165":72784,"_21590":120852,"_5":14857,"_28357":120558,"_3076":120853},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3624":72905,"_31165":72784,"_21590":120855,"_5":14857,"_28357":120558,"_3076":120856},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3624":72906,"_31165":72784,"_21590":120858,"_5":14857,"_28357":120562,"_3076":120859},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3624":72907,"_31165":72907,"_5":15217,"_3076":120861,"_31523":120862,"_21590":120863,"_28357":72907},"Instala con Helm",[50932,120281,120515],[],{"_3624":72908,"_31165":72907,"_21590":120865,"_5":14857,"_28357":72907,"_3076":120866},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3624":72909,"_31165":72907,"_5":31520,"_21590":120868,"_28357":120869,"_3076":120870},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3624":72910,"_31165":72907,"_5":31520,"_21590":120872,"_28357":120873,"_3076":120531},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3624":72911,"_31165":72907,"_5":31520,"_21590":120875,"_28357":120876,"_3076":120877},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3624":72912,"_31165":72907,"_5":31520,"_21590":120879,"_28357":120880,"_3076":120881},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3624":72913,"_31165":72907,"_5":31520,"_21590":120883,"_28357":120884,"_3076":120885},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3624":72914,"_31165":72907,"_5":31520,"_21590":120887,"_28357":120888,"_3076":120889},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3624":72915,"_31165":72907,"_5":31520,"_21590":120891,"_28357":120892,"_3076":120893},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3624":72916,"_31165":72907,"_5":31520,"_21590":120895,"_28357":120896,"_3076":120897},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3624":72917,"_31165":72907,"_5":31520,"_21590":120899,"_28357":120900,"_3076":120901},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3624":72918,"_31165":72907,"_5":31520,"_21590":120903,"_28357":120904,"_3076":120905},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3624":72919,"_31165":72907,"_5":31520,"_21590":120907,"_28357":120908,"_3076":120909},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3624":72920,"_31165":72907,"_5":31520,"_21590":120911,"_28357":120912,"_3076":120913},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3624":72921,"_31165":72907,"_21590":120915,"_5":14857,"_28357":120869,"_3076":120916},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3624":72922,"_31165":72907,"_21590":120918,"_5":14857,"_28357":120873,"_3076":120919},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3624":72923,"_31165":72907,"_21590":120921,"_5":14857,"_28357":120873,"_3076":120922},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3624":72924,"_31165":72907,"_21590":120924,"_5":14857,"_28357":120873,"_3076":120925},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3624":72925,"_31165":72907,"_21590":120927,"_5":14857,"_28357":120873,"_3076":120928},[],"un broker RabbitMQ accesible y sus credenciales",{"_3624":72926,"_31165":72907,"_21590":120930,"_5":14857,"_28357":120873,"_3076":120931},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3624":72927,"_31165":72907,"_21590":120933,"_5":14857,"_28357":120873,"_3076":120934},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3624":72928,"_31165":72907,"_21590":120936,"_5":14857,"_28357":120873,"_3076":120937},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3624":72929,"_31165":72907,"_21590":120939,"_5":14857,"_28357":120873,"_3076":120940},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3624":72930,"_31165":72907,"_21590":120942,"_5":14857,"_28357":120873,"_3076":120943},[],"una StorageClass y un diseño de tráfico externo",{"_3624":72931,"_31165":72907,"_21590":120945,"_5":14857,"_28357":120873,"_3076":120946},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3624":72932,"_31165":72907,"_21590":120948,"_5":14857,"_28357":120873,"_3076":120949},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3624":72933,"_31165":72907,"_21590":120951,"_5":14857,"_28357":120873,"_3076":120952},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3624":72934,"_31165":72907,"_21590":120954,"_5":14857,"_28357":120876,"_3076":120955},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3624":72935,"_31165":72907,"_21590":120957,"_5":14857,"_28357":120876,"_3076":120958},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3624":72936,"_31165":72907,"_21590":120960,"_5":14857,"_28357":120876,"_3076":120961},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3624":72937,"_31165":72907,"_21590":120963,"_5":14857,"_28357":120880,"_3076":120964},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3624":72938,"_31165":72907,"_21590":120966,"_5":14857,"_28357":120880,"_3076":120967},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3624":72939,"_31165":72907,"_21590":120969,"_5":14857,"_28357":120880,"_3076":120970},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3624":72940,"_31165":72907,"_21590":120972,"_5":14857,"_28357":120880,"_3076":120973},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3624":72941,"_31165":72907,"_21590":120975,"_5":14857,"_28357":120884,"_3076":120976},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3624":72942,"_31165":72907,"_21590":120978,"_5":14857,"_28357":120884,"_3076":120979},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3624":72943,"_31165":72907,"_21590":120981,"_5":14857,"_28357":120884,"_3076":120982},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3624":72944,"_31165":72907,"_21590":120984,"_5":14857,"_28357":120884,"_3076":120985},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3624":72945,"_31165":72907,"_21590":120987,"_5":14857,"_28357":120884,"_3076":120988},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3624":72946,"_31165":72907,"_21590":120990,"_5":14857,"_28357":120884,"_3076":120991},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3624":72947,"_31165":72907,"_21590":120993,"_5":14857,"_28357":120884,"_3076":120994},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3624":72948,"_31165":72907,"_21590":120996,"_5":14857,"_28357":120884,"_3076":120997},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3624":72949,"_31165":72907,"_21590":120999,"_5":14857,"_28357":120888,"_3076":121000},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3624":72950,"_31165":72907,"_21590":121002,"_5":14857,"_28357":120892,"_3076":121003},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3624":72951,"_31165":72907,"_21590":121005,"_5":14857,"_28357":120892,"_3076":121006},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3624":72952,"_31165":72907,"_21590":121008,"_5":14857,"_28357":120892,"_3076":121009},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3624":72953,"_31165":72907,"_21590":121011,"_5":14857,"_28357":120892,"_3076":121012},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3624":72954,"_31165":72907,"_21590":121014,"_5":14857,"_28357":120892,"_3076":121015},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3624":72955,"_31165":72907,"_21590":121017,"_5":14857,"_28357":120892,"_3076":121018},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3624":72956,"_31165":72907,"_21590":121020,"_5":14857,"_28357":120892,"_3076":121021},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3624":72957,"_31165":72907,"_21590":121023,"_5":14857,"_28357":120896,"_3076":121024},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3624":72958,"_31165":72907,"_21590":121026,"_5":14857,"_28357":120896,"_3076":121027},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3624":72959,"_31165":72907,"_21590":121029,"_5":14857,"_28357":120896,"_3076":121030},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3624":72960,"_31165":72907,"_21590":121032,"_5":14857,"_28357":120896,"_3076":121033},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3624":72961,"_31165":72907,"_21590":121035,"_5":14857,"_28357":120900,"_3076":121036},[],"Para instalar un checkout local:",{"_3624":72962,"_31165":72907,"_21590":121038,"_5":14857,"_28357":120904,"_3076":121039},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3624":72963,"_31165":72907,"_21590":121041,"_5":14857,"_28357":120904,"_3076":121042},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3624":72964,"_31165":72907,"_21590":121044,"_5":14857,"_28357":120908,"_3076":121045},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3624":72965,"_31165":72907,"_21590":121047,"_5":14857,"_28357":120908,"_3076":121048},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3624":72966,"_31165":72907,"_21590":121050,"_5":14857,"_28357":120908,"_3076":121051},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3624":72967,"_31165":72907,"_21590":121053,"_5":14857,"_28357":120908,"_3076":121054},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3624":72968,"_31165":72907,"_21590":121056,"_5":14857,"_28357":120908,"_3076":121057},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3624":72969,"_31165":72907,"_21590":121059,"_5":14857,"_28357":120912,"_3076":121060},[],"Antes de pasar a producción, revisa:",{"_3624":72970,"_31165":72907,"_21590":121062,"_5":14857,"_28357":120912,"_3076":121063},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3624":72971,"_31165":72907,"_21590":121065,"_5":14857,"_28357":120912,"_3076":121066},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3624":72972,"_31165":72907,"_21590":121068,"_5":14857,"_28357":120912,"_3076":121069},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3624":72973,"_31165":72907,"_21590":121071,"_5":14857,"_28357":120912,"_3076":121072},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3624":72974,"_31165":72907,"_21590":121074,"_5":14857,"_28357":120912,"_3076":121075},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3624":72975,"_31165":72907,"_21590":121077,"_5":14857,"_28357":120912,"_3076":121078},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3624":72976,"_31165":72907,"_21590":121080,"_5":14857,"_28357":120912,"_3076":121081},[],"SMTP, observabilidad y entrega de alertas",{"_3624":72977,"_31165":72907,"_21590":121083,"_5":14857,"_28357":120912,"_3076":121084},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3624":72978,"_31165":72907,"_21590":121086,"_5":14857,"_28357":120912,"_3076":121087},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3624":72979,"_31165":72979,"_5":15217,"_3076":121089,"_31523":121090,"_21590":121091,"_28357":72979},"Expón el Gateway",[50932,120281,120515],[],{"_3624":72980,"_31165":72979,"_21590":121093,"_5":14857,"_28357":72979,"_3076":121094},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3624":72981,"_31165":72979,"_5":31520,"_21590":121096,"_28357":121097,"_3076":121098},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3624":72982,"_31165":72979,"_5":31520,"_21590":121100,"_28357":121101,"_3076":121102},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3624":72983,"_31165":72979,"_5":31520,"_21590":121104,"_28357":121105,"_3076":121106},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3624":72984,"_31165":72979,"_5":31520,"_21590":121108,"_28357":121109,"_3076":51795},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#k3s",{"_3624":72985,"_31165":72979,"_5":31520,"_21590":121111,"_28357":121112,"_3076":121113},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3624":72986,"_31165":72979,"_5":31520,"_21590":121115,"_28357":121116,"_3076":121117},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3624":72987,"_31165":72979,"_5":31520,"_21590":121119,"_28357":121120,"_3076":121121},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3624":72988,"_31165":72979,"_5":31520,"_21590":121123,"_28357":121124,"_3076":121125},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3624":72989,"_31165":72979,"_5":31520,"_21590":121127,"_28357":121128,"_3076":121129},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3624":72990,"_31165":72979,"_5":31520,"_21590":121131,"_28357":121132,"_3076":121133},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3624":72991,"_31165":72979,"_5":31520,"_21590":121135,"_28357":121136,"_3076":121137},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3624":72992,"_31165":72979,"_21590":121139,"_5":14857,"_28357":121097,"_3076":121140},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3624":72993,"_31165":72979,"_21590":121142,"_5":14857,"_28357":121097,"_3076":121143},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3624":72994,"_31165":72979,"_21590":121145,"_5":14857,"_28357":121101,"_3076":121146},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3624":72995,"_31165":72979,"_21590":121148,"_5":14857,"_28357":121101,"_3076":121149},[],"Defínelo únicamente cuando:",{"_3624":72996,"_31165":72979,"_21590":121151,"_5":14857,"_28357":121101,"_3076":121152},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3624":72997,"_31165":72979,"_21590":121154,"_5":14857,"_28357":121101,"_3076":121155},[],"esa dirección está asignada a este Gateway",{"_3624":72998,"_31165":72979,"_21590":121157,"_5":14857,"_28357":121101,"_3076":121158},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3624":72999,"_31165":72979,"_21590":121160,"_5":14857,"_28357":121101,"_3076":121161},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3624":73000,"_31165":72979,"_21590":121163,"_5":14857,"_28357":121101,"_3076":121164},[],"No confundas estos valores:",{"_3624":73001,"_31165":72979,"_21590":121166,"_5":14857,"_28357":121101,"_3076":121167},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3624":73002,"_31165":72979,"_21590":121169,"_5":14857,"_28357":121101,"_3076":121170},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3624":73003,"_31165":72979,"_21590":121172,"_5":14857,"_28357":121101,"_3076":121173},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3624":73004,"_31165":72979,"_21590":121175,"_5":14857,"_28357":121105,"_3076":121176},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3624":73005,"_31165":72979,"_21590":121178,"_5":14857,"_28357":121105,"_3076":121179},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3624":73006,"_31165":72979,"_21590":121181,"_5":14857,"_28357":121109,"_3076":121182},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3624":73007,"_31165":72979,"_21590":121184,"_5":14857,"_28357":121109,"_3076":121185},[],"Para el diseño recomendado:",{"_3624":73008,"_31165":72979,"_21590":121187,"_5":14857,"_28357":121109,"_3076":121188},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3624":73009,"_31165":72979,"_21590":121190,"_5":14857,"_28357":121109,"_3076":121191},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3624":73010,"_31165":72979,"_21590":121193,"_5":14857,"_28357":121109,"_3076":121194},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3624":73011,"_31165":72979,"_21590":121196,"_5":14857,"_28357":121109,"_3076":121197},[],"Apunta DNS a la dirección accesible de la VM.",{"_3624":73012,"_31165":72979,"_21590":121199,"_5":14857,"_28357":121109,"_3076":121200},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3624":73013,"_31165":72979,"_21590":121202,"_5":14857,"_28357":121112,"_3076":121203},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3624":73014,"_31165":72979,"_21590":121205,"_5":14857,"_28357":121116,"_3076":121206},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3624":73015,"_31165":72979,"_21590":121208,"_5":14857,"_28357":121116,"_3076":121209},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3624":73016,"_31165":72979,"_21590":121211,"_5":14857,"_28357":121120,"_3076":121212},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3624":73017,"_31165":72979,"_21590":121214,"_5":14857,"_28357":121120,"_3076":121215},[],"Requisito",{"_3624":73018,"_31165":72979,"_21590":121217,"_5":14857,"_28357":121120,"_3076":121218},[],"Diseño recomendado",{"_3624":73019,"_31165":72979,"_21590":121220,"_5":14857,"_28357":121120,"_3076":121221},[],"Consecuencia",{"_3624":73020,"_31165":72979,"_21590":121223,"_5":14857,"_28357":121120,"_3076":121224},[],"Varias URL o servicios de Lamassu",{"_3624":73021,"_31165":72979,"_21590":121226,"_5":14857,"_28357":121120,"_3076":121227},[],"Un Gateway con varias rutas",{"_3624":73022,"_31165":72979,"_21590":121229,"_5":14857,"_28357":121120,"_3076":121230},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3624":73023,"_31165":72979,"_21590":121232,"_5":14857,"_28357":121120,"_3076":121233},[],"Gateways independientes e IP externas distintas",{"_3624":73024,"_31165":72979,"_21590":121235,"_5":14857,"_28357":121120,"_3076":121236},[],"Una VIP por Gateway",{"_3624":73025,"_31165":72979,"_21590":121238,"_5":14857,"_28357":121120,"_3076":121239},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3624":73026,"_31165":72979,"_21590":121241,"_5":14857,"_28357":121120,"_3076":121242},[],"Gateways independientes, un nodo y una IP",{"_3624":73027,"_31165":72979,"_21590":121244,"_5":14857,"_28357":121120,"_3076":121245},[],"Puertos externos diferentes",{"_3624":73028,"_31165":72979,"_21590":121247,"_5":14857,"_28357":121120,"_3076":121248},[],"Los clientes deben indicar puertos no estándar",{"_3624":73029,"_31165":72979,"_21590":121250,"_5":14857,"_28357":121120,"_3076":121251},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3624":73030,"_31165":72979,"_21590":121253,"_5":14857,"_28357":121120,"_3076":121254},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3624":73031,"_31165":72979,"_21590":121256,"_5":14857,"_28357":121120,"_3076":121257},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3624":73032,"_31165":72979,"_21590":121259,"_5":14857,"_28357":121120,"_3076":121260},[],"Recursos Gateway separados pero proxy compartido",{"_3624":73033,"_31165":72979,"_21590":121262,"_5":14857,"_28357":121120,"_3076":121263},[],"Modo merged Gateway de Envoy",{"_3624":73034,"_31165":72979,"_21590":121265,"_5":14857,"_28357":121120,"_3076":121266},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3624":73035,"_31165":72979,"_21590":121268,"_5":14857,"_28357":121120,"_3076":121269},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3624":73036,"_31165":72979,"_21590":121271,"_5":14857,"_28357":121120,"_3076":121272},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3624":73037,"_31165":72979,"_21590":121274,"_5":14857,"_28357":121120,"_3076":121275},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3624":73038,"_31165":72979,"_21590":121277,"_5":14857,"_28357":121120,"_3076":121278},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3624":73039,"_31165":72979,"_21590":121280,"_5":14857,"_28357":121124,"_3076":121281},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3624":73040,"_31165":72979,"_21590":121283,"_5":14857,"_28357":121128,"_3076":121284},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3624":73041,"_31165":72979,"_21590":121286,"_5":14857,"_28357":121128,"_3076":121287},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3624":73042,"_31165":72979,"_21590":121289,"_5":14857,"_28357":121128,"_3076":121290},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3624":73043,"_31165":72979,"_21590":121292,"_5":14857,"_28357":121128,"_3076":121293},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3624":73044,"_31165":72979,"_21590":121295,"_5":14857,"_28357":121128,"_3076":121296},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3624":73045,"_31165":72979,"_21590":121298,"_5":14857,"_28357":121132,"_3076":121299},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3624":73046,"_31165":72979,"_21590":121301,"_5":14857,"_28357":121132,"_3076":121302},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3624":73047,"_31165":72979,"_21590":121304,"_5":14857,"_28357":121136,"_3076":121305},[],"Comprueba, en orden:",{"_3624":73048,"_31165":72979,"_21590":121307,"_5":14857,"_28357":121136,"_3076":121308},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3624":73049,"_31165":72979,"_21590":121310,"_5":14857,"_28357":121136,"_3076":121311},[],"Su estado contiene la dirección esperada.",{"_3624":73050,"_31165":72979,"_21590":121313,"_5":14857,"_28357":121136,"_3076":121314},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3624":73051,"_31165":72979,"_21590":121316,"_5":14857,"_28357":121136,"_3076":121317},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3624":73052,"_31165":72979,"_21590":121319,"_5":14857,"_28357":121136,"_3076":121320},[],"DNS resuelve al endpoint accesible externamente.",{"_3624":73053,"_31165":72979,"_21590":121322,"_5":14857,"_28357":121136,"_3076":121323},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3624":73054,"_31165":72979,"_21590":121325,"_5":14857,"_28357":121136,"_3076":121326},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3624":73055,"_31165":73055,"_5":15217,"_3076":51039,"_31523":121328,"_21590":121329,"_28357":73055},[50932,120281,120515],[],{"_3624":73056,"_31165":73055,"_21590":121331,"_5":14857,"_28357":73055,"_3076":121332},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3624":73057,"_31165":73055,"_5":31520,"_21590":121334,"_28357":121335,"_3076":121336},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3624":73058,"_31165":73055,"_5":31520,"_21590":121338,"_28357":121339,"_3076":121340},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3624":73059,"_31165":73055,"_5":31520,"_21590":121342,"_28357":121343,"_3076":121344},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3624":73060,"_31165":73055,"_5":31520,"_21590":121346,"_28357":121347,"_3076":121348},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3624":73061,"_31165":73055,"_5":31520,"_21590":121350,"_28357":121351,"_3076":121352},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3624":73062,"_31165":73055,"_5":31520,"_21590":121354,"_28357":121355,"_3076":121356},[],"/docs/pr-preview/pr-76/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3624":73063,"_31165":73055,"_21590":121358,"_5":14857,"_28357":121335,"_3076":121359},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3624":73064,"_31165":73055,"_21590":121361,"_5":14857,"_28357":121339,"_3076":121362},[],"Flujo",{"_3624":73065,"_31165":73055,"_21590":121364,"_5":14857,"_28357":121339,"_3076":121365},[],"Úsalo para",{"_3624":73066,"_31165":73055,"_21590":121367,"_5":14857,"_28357":121339,"_3076":121368},[],"Qué instala",{"_3624":73067,"_31165":73055,"_21590":121370,"_5":14857,"_28357":121339,"_3076":52057},[],{"_3624":73068,"_31165":73055,"_21590":121372,"_5":14857,"_28357":121339,"_3076":121373},[],"Producción y entornos controlados",{"_3624":73069,"_31165":73055,"_21590":121375,"_5":14857,"_28357":121339,"_3076":121376},[],"Servicios de Lamassu y recursos de Gateway API",{"_3624":73070,"_31165":73055,"_21590":121378,"_5":14857,"_28357":121339,"_3076":51176},[],{"_3624":73071,"_31165":73055,"_21590":121380,"_5":14857,"_28357":121339,"_3076":121381},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3624":73072,"_31165":73055,"_21590":121383,"_5":14857,"_28357":121339,"_3076":121384},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3624":73073,"_31165":73055,"_21590":121386,"_5":14857,"_28357":121343,"_3076":121387},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3624":73074,"_31165":73055,"_21590":121389,"_5":14857,"_28357":121343,"_3076":121390},[],"Área",{"_3624":73075,"_31165":73055,"_21590":121392,"_5":14857,"_28357":121343,"_3076":121393},[],"El chart de Lamassu proporciona",{"_3624":73076,"_31165":73055,"_21590":121395,"_5":14857,"_28357":121343,"_3076":121396},[],"Tú proporcionas",{"_3624":73077,"_31165":73055,"_21590":121398,"_5":14857,"_28357":121343,"_3076":121399},[],"Aplicaciones Lamassu",{"_3624":73078,"_31165":73055,"_21590":121401,"_5":14857,"_28357":121343,"_3076":121402},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3624":73079,"_31165":73055,"_21590":121404,"_5":14857,"_28357":121343,"_3076":121405},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3624":73080,"_31165":73055,"_21590":121407,"_5":14857,"_28357":121343,"_3076":121408},[],"Datos PostgreSQL",{"_3624":73081,"_31165":73055,"_21590":121410,"_5":14857,"_28357":121343,"_3076":121411},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3624":73082,"_31165":73055,"_21590":121413,"_5":14857,"_28357":121343,"_3076":121414},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3624":73083,"_31165":73055,"_21590":121416,"_5":14857,"_28357":121343,"_3076":121417},[],"Mensajería",{"_3624":73084,"_31165":73055,"_21590":121419,"_5":14857,"_28357":121343,"_3076":121420},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3624":73085,"_31165":73055,"_21590":121422,"_5":14857,"_28357":121343,"_3076":121423},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3624":73086,"_31165":73055,"_21590":121425,"_5":14857,"_28357":121343,"_3076":121426},[],"Identidad",{"_3624":73087,"_31165":73055,"_21590":121428,"_5":14857,"_28357":121343,"_3076":121429},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3624":73088,"_31165":73055,"_21590":121431,"_5":14857,"_28357":121343,"_3076":121432},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3624":73089,"_31165":73055,"_21590":121434,"_5":14857,"_28357":121343,"_3076":121435},[],"Enrutamiento externo",{"_3624":73090,"_31165":73055,"_21590":121437,"_5":14857,"_28357":121343,"_3076":121438},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3624":73091,"_31165":73055,"_21590":121440,"_5":14857,"_28357":121343,"_3076":121441},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3624":73092,"_31165":73055,"_21590":121443,"_5":14857,"_28357":121343,"_3076":52131},[],{"_3624":73093,"_31165":73055,"_21590":121445,"_5":14857,"_28357":121343,"_3076":121446},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3624":73094,"_31165":73055,"_21590":121448,"_5":14857,"_28357":121343,"_3076":121449},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3624":73095,"_31165":73055,"_21590":121451,"_5":14857,"_28357":121343,"_3076":121452},[],"Datos persistentes de la aplicación",{"_3624":73096,"_31165":73055,"_21590":121454,"_5":14857,"_28357":121343,"_3076":121455},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3624":73097,"_31165":73055,"_21590":121457,"_5":14857,"_28357":121343,"_3076":121458},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3624":73098,"_31165":73055,"_21590":121460,"_5":14857,"_28357":121343,"_3076":121461},[],"Integraciones opcionales",{"_3624":73099,"_31165":73055,"_21590":121463,"_5":14857,"_28357":121343,"_3076":121464},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3624":73100,"_31165":73055,"_21590":121466,"_5":14857,"_28357":121343,"_3076":121467},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3624":73101,"_31165":73055,"_21590":121469,"_5":14857,"_28357":121343,"_3076":121470},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3624":73102,"_31165":73055,"_21590":121472,"_5":14857,"_28357":121343,"_3076":121473},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3624":73103,"_31165":73055,"_21590":121475,"_5":14857,"_28357":121347,"_3076":121476},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3624":73104,"_31165":73055,"_21590":121478,"_5":14857,"_28357":121347,"_3076":121479},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3624":73105,"_31165":73055,"_21590":121481,"_5":14857,"_28357":121351,"_3076":121482},[],"Kubernetes 1.24 o posterior",{"_3624":73106,"_31165":73055,"_21590":121484,"_5":14857,"_28357":121351,"_3076":121485},[],"Helm 3.2 o posterior",{"_3624":73107,"_31165":73055,"_21590":121487,"_5":14857,"_28357":121351,"_3076":121488},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3624":73108,"_31165":73055,"_21590":121490,"_5":14857,"_28357":121351,"_3076":121491},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3624":73109,"_31165":73055,"_21590":121493,"_5":14857,"_28357":121351,"_3076":121494},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3624":73110,"_31165":73055,"_21590":121496,"_5":14857,"_28357":121351,"_3076":121497},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3624":73111,"_31165":73055,"_21590":121499,"_5":14857,"_28357":121351,"_3076":121500},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3624":73112,"_31165":73055,"_21590":121502,"_5":14857,"_28357":121355,"_3076":121503},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3624":73113,"_31165":73055,"_21590":121505,"_5":14857,"_28357":121355,"_3076":121506},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3624":73114,"_31165":73055,"_21590":121508,"_5":14857,"_28357":121355,"_3076":121509},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3624":73115,"_31165":73055,"_21590":121511,"_5":14857,"_28357":121355,"_3076":121512},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3624":73116,"_31165":73116,"_5":15217,"_3076":121514,"_31523":121515,"_21590":121517,"_28357":73116},"Resolución de problemas de despliegue",[50932,120281,121516],"Operación",[],{"_3624":73117,"_31165":73116,"_21590":121519,"_5":14857,"_28357":73116,"_3076":121520},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3624":73118,"_31165":73116,"_5":31520,"_21590":121522,"_28357":121523,"_3076":121524},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3624":73119,"_31165":73116,"_5":31520,"_21590":121526,"_28357":121527,"_3076":121528},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3624":73120,"_31165":73116,"_5":31520,"_21590":121530,"_28357":121531,"_3076":121532},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3624":73121,"_31165":73116,"_5":31520,"_21590":121534,"_28357":121535,"_3076":121536},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3624":73122,"_31165":73116,"_5":31520,"_21590":121538,"_28357":121539,"_3076":121540},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3624":73123,"_31165":73116,"_5":31520,"_21590":121542,"_28357":121543,"_3076":121544},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3624":73124,"_31165":73116,"_5":31520,"_21590":121546,"_28357":121547,"_3076":121548},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3624":73125,"_31165":73116,"_5":31520,"_21590":121550,"_28357":121551,"_3076":121552},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3624":73126,"_31165":73116,"_5":31520,"_21590":121554,"_28357":121555,"_3076":121556},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3624":73127,"_31165":73116,"_5":31520,"_21590":121558,"_28357":121559,"_3076":121560},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3624":73128,"_31165":73116,"_5":31520,"_21590":121562,"_28357":121563,"_3076":121564},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3624":73129,"_31165":73116,"_5":31520,"_21590":121566,"_28357":121567,"_3076":121568},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3624":73130,"_31165":73116,"_5":31520,"_21590":121570,"_28357":121571,"_3076":121572},[],"/docs/pr-preview/pr-76/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3624":73131,"_31165":73116,"_21590":121574,"_5":14857,"_28357":73116,"_3076":121575},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3624":73132,"_31165":73116,"_21590":121577,"_5":14857,"_28357":121527,"_3076":121578},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3624":73133,"_31165":73116,"_21590":121580,"_5":14857,"_28357":121531,"_3076":121581},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3624":73134,"_31165":73116,"_21590":121583,"_5":14857,"_28357":121535,"_3076":121584},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3624":73135,"_31165":73116,"_21590":121586,"_5":14857,"_28357":121539,"_3076":121587},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3624":73136,"_31165":73116,"_21590":121589,"_5":14857,"_28357":121543,"_3076":121590},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3624":73137,"_31165":73116,"_21590":121592,"_5":14857,"_28357":121547,"_3076":121593},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3624":73138,"_31165":73116,"_21590":121595,"_5":14857,"_28357":121547,"_3076":121596},[],"Ejecuta también la prueba de conectividad del chart:",{"_3624":73139,"_31165":73116,"_21590":121598,"_5":14857,"_28357":121547,"_3076":121599},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3624":73140,"_31165":73116,"_21590":121601,"_5":14857,"_28357":121547,"_3076":121602},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3624":73141,"_31165":73116,"_21590":121604,"_5":14857,"_28357":121551,"_3076":121605},[],"Si recibes un 401:",{"_3624":73142,"_31165":73116,"_21590":121607,"_5":14857,"_28357":121551,"_3076":121608},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3624":73143,"_31165":73116,"_21590":121610,"_5":14857,"_28357":121551,"_3076":121611},[],"verifica emisor, audiencia y expiración del token;",{"_3624":73144,"_31165":73116,"_21590":121613,"_5":14857,"_28357":121551,"_3076":121614},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3624":73145,"_31165":73116,"_21590":121616,"_5":14857,"_28357":121551,"_3076":121617},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3624":73146,"_31165":73116,"_21590":121619,"_5":14857,"_28357":121551,"_3076":121620},[],"Si el login termina pero las APIs devuelven 403:",{"_3624":73147,"_31165":73116,"_21590":121622,"_5":14857,"_28357":121551,"_3076":121623},[],"inspecciona los claims reales del token;",{"_3624":73148,"_31165":73116,"_21590":121625,"_5":14857,"_28357":121551,"_3076":121626},[],"confirma que coinciden con un principal activo;",{"_3624":73149,"_31165":73116,"_21590":121628,"_5":14857,"_28357":121551,"_3076":121629},[],"revisa las políticas concedidas al principal;",{"_3624":73150,"_31165":73116,"_21590":121631,"_5":14857,"_28357":121551,"_3076":121632},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3624":73151,"_31165":73116,"_21590":121634,"_5":14857,"_28357":121551,"_3076":121635},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3624":73152,"_31165":73116,"_21590":121637,"_5":14857,"_28357":121555,"_3076":121638},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3624":73153,"_31165":73116,"_21590":121640,"_5":14857,"_28357":121555,"_3076":121641},[],"Localiza el pod y Service de authz.",{"_3624":73154,"_31165":73116,"_21590":121643,"_5":14857,"_28357":121555,"_3076":121644},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3624":73155,"_31165":73116,"_21590":121646,"_5":14857,"_28357":121555,"_3076":121647},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3624":73156,"_31165":73116,"_21590":121649,"_5":14857,"_28357":121555,"_3076":121650},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3624":73157,"_31165":73116,"_21590":121652,"_5":14857,"_28357":121555,"_3076":121653},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3624":73158,"_31165":73116,"_21590":121655,"_5":14857,"_28357":121559,"_3076":121656},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3624":73159,"_31165":73116,"_21590":121658,"_5":14857,"_28357":121563,"_3076":121659},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3624":73160,"_31165":73116,"_21590":121661,"_5":14857,"_28357":121563,"_3076":121662},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3624":73161,"_31165":73116,"_21590":121664,"_5":14857,"_28357":121563,"_3076":121665},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3624":73162,"_31165":73116,"_21590":121667,"_5":14857,"_28357":121563,"_3076":121668},[],"volumen persistente sin enlazar;",{"_3624":73163,"_31165":73116,"_21590":121670,"_5":14857,"_28357":121563,"_3076":121671},[],"imagen inaccesible o política de pull incorrecta;",{"_3624":73164,"_31165":73116,"_21590":121673,"_5":14857,"_28357":121563,"_3076":121674},[],"configuración inválida del motor criptográfico;",{"_3624":73165,"_31165":73116,"_21590":121676,"_5":14857,"_28357":121563,"_3076":121677},[],"límites de CPU o memoria demasiado bajos;",{"_3624":73166,"_31165":73116,"_21590":121679,"_5":14857,"_28357":121563,"_3076":121680},[],"migración previa incompleta.",{"_3624":73167,"_31165":73116,"_21590":121682,"_5":14857,"_28357":121563,"_3076":121683},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3624":73168,"_31165":73116,"_21590":121685,"_5":14857,"_28357":121563,"_3076":121686},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3624":73169,"_31165":73116,"_21590":121688,"_5":14857,"_28357":121563,"_3076":121689},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3624":73170,"_31165":73116,"_21590":121691,"_5":14857,"_28357":121567,"_3076":121692},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3624":73171,"_31165":73116,"_21590":121694,"_5":14857,"_28357":121567,"_3076":121695},[],"verifica que esté habilitado en el servicio emisor;",{"_3624":73172,"_31165":73116,"_21590":121697,"_5":14857,"_28357":121567,"_3076":121698},[],"comprueba conectividad y credenciales AMQP;",{"_3624":73173,"_31165":73116,"_21590":121700,"_5":14857,"_28357":121567,"_3076":121701},[],"revisa exchange, routing key, colas y consumidores;",{"_3624":73174,"_31165":73116,"_21590":121703,"_5":14857,"_28357":121567,"_3076":121704},[],"inspecciona dead-letter queues;",{"_3624":73175,"_31165":73116,"_21590":121706,"_5":14857,"_28357":121567,"_3076":121707},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3624":73176,"_31165":73116,"_21590":121709,"_5":14857,"_28357":121567,"_3076":121710},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3624":73177,"_31165":73116,"_21590":121712,"_5":14857,"_28357":121567,"_3076":121713},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3624":73178,"_31165":73116,"_21590":121715,"_5":14857,"_28357":121567,"_3076":121716},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3624":73179,"_31165":73116,"_21590":121718,"_5":14857,"_28357":121567,"_3076":121719},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3624":73180,"_31165":73116,"_21590":121721,"_5":14857,"_28357":121567,"_3076":121722},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3624":73181,"_31165":73116,"_21590":121724,"_5":14857,"_28357":121567,"_3076":121725},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3624":73182,"_31165":73116,"_21590":121727,"_5":14857,"_28357":121567,"_3076":121728},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3624":73183,"_31165":73116,"_21590":121730,"_5":14857,"_28357":121571,"_3076":121731},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3624":73184,"_31165":73116,"_21590":121733,"_5":14857,"_28357":121571,"_3076":121734},[],"Antes de cerrar una incidencia, guarda:",{"_3624":73185,"_31165":73116,"_21590":121736,"_5":14857,"_28357":121571,"_3076":121737},[],"causa confirmada;",{"_3624":73186,"_31165":73116,"_21590":121739,"_5":14857,"_28357":121571,"_3076":121740},[],"alcance temporal y recursos afectados;",{"_3624":73187,"_31165":73116,"_21590":121742,"_5":14857,"_28357":121571,"_3076":121743},[],"comandos o consultas utilizados;",{"_3624":73188,"_31165":73116,"_21590":121745,"_5":14857,"_28357":121571,"_3076":121746},[],"cambio aplicado y forma de revertirlo;",{"_3624":73189,"_31165":73116,"_21590":121748,"_5":14857,"_28357":121571,"_3076":121749},[],"validación desde un consumidor;",{"_3624":73190,"_31165":73116,"_21590":121751,"_5":14857,"_28357":121571,"_3076":121752},[],"acción preventiva y propietario.",{"_3624":73191,"_31165":73191,"_5":15217,"_3076":121754,"_31523":121755,"_21590":121759,"_28357":73191},"Modelo de datos",[50932,121756,121757,121758],"Plataforma","Administración","Control de acceso",[],{"_3624":73192,"_31165":73191,"_21590":121761,"_5":14857,"_28357":73191,"_3076":121762},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3624":73193,"_31165":73191,"_5":31520,"_21590":121764,"_28357":121765,"_3076":121766},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3624":73194,"_31165":73191,"_5":31520,"_21590":121768,"_28357":121769,"_3076":121770},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3624":73195,"_31165":73191,"_21590":121772,"_5":14857,"_28357":73191,"_3076":121773},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3624":73196,"_31165":73191,"_21590":121775,"_5":14857,"_28357":121765,"_3076":121776},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3624":73197,"_31165":73191,"_21590":121778,"_5":14857,"_28357":121765,"_3076":121779},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3624":73198,"_31165":73191,"_21590":121781,"_5":14857,"_28357":121765,"_3076":121782},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3624":73199,"_31165":73191,"_21590":121784,"_5":14857,"_28357":121769,"_3076":121785},[],"Entidad (`schema_name.entity_type`)",{"_3624":73200,"_31165":73191,"_21590":121787,"_5":14857,"_28357":121769,"_3076":121788},[],"Tabla (`table_name`)",{"_3624":73201,"_31165":73191,"_21590":121790,"_5":14857,"_28357":121769,"_3076":121791},[],"Clave (`primary_key`)",{"_3624":73202,"_31165":73191,"_21590":121793,"_5":14857,"_28357":121769,"_3076":52482},[],{"_3624":73203,"_31165":73191,"_21590":121795,"_5":14857,"_28357":121769,"_3076":52485},[],{"_3624":73204,"_31165":73191,"_21590":121797,"_5":14857,"_28357":121769,"_3076":52488},[],{"_3624":73205,"_31165":73191,"_21590":121799,"_5":14857,"_28357":121769,"_3076":52491},[],{"_3624":73206,"_31165":73191,"_21590":121801,"_5":14857,"_28357":121769,"_3076":52494},[],{"_3624":73207,"_31165":73191,"_21590":121803,"_5":14857,"_28357":121769,"_3076":52497},[],{"_3624":73208,"_31165":73191,"_21590":121805,"_5":14857,"_28357":121769,"_3076":52500},[],{"_3624":73209,"_31165":73191,"_21590":121807,"_5":14857,"_28357":121769,"_3076":52503},[],{"_3624":73210,"_31165":73191,"_21590":121809,"_5":14857,"_28357":121769,"_3076":52497},[],{"_3624":73211,"_31165":73191,"_21590":121811,"_5":14857,"_28357":121769,"_3076":52508},[],{"_3624":73212,"_31165":73191,"_21590":121813,"_5":14857,"_28357":121769,"_3076":52511},[],{"_3624":73213,"_31165":73191,"_21590":121815,"_5":14857,"_28357":121769,"_3076":52514},[],{"_3624":73214,"_31165":73191,"_21590":121817,"_5":14857,"_28357":121769,"_3076":52517},[],{"_3624":73215,"_31165":73191,"_21590":121819,"_5":14857,"_28357":121769,"_3076":52520},[],{"_3624":73216,"_31165":73191,"_21590":121821,"_5":14857,"_28357":121769,"_3076":52497},[],{"_3624":73217,"_31165":73191,"_21590":121823,"_5":14857,"_28357":121769,"_3076":52525},[],{"_3624":73218,"_31165":73191,"_21590":121825,"_5":14857,"_28357":121769,"_3076":52528},[],{"_3624":73219,"_31165":73191,"_21590":121827,"_5":14857,"_28357":121769,"_3076":52497},[],{"_3624":73220,"_31165":73191,"_21590":121829,"_5":14857,"_28357":121769,"_3076":52533},[],{"_3624":73221,"_31165":73191,"_21590":121831,"_5":14857,"_28357":121769,"_3076":52536},[],{"_3624":73222,"_31165":73191,"_21590":121833,"_5":14857,"_28357":121769,"_3076":52497},[],{"_3624":73223,"_31165":73191,"_21590":121835,"_5":14857,"_28357":121769,"_3076":52541},[],{"_3624":73224,"_31165":73191,"_21590":121837,"_5":14857,"_28357":121769,"_3076":52544},[],{"_3624":73225,"_31165":73191,"_21590":121839,"_5":14857,"_28357":121769,"_3076":52497},[],{"_3624":73226,"_31165":73191,"_21590":121841,"_5":14857,"_28357":121769,"_3076":52549},[],{"_3624":73227,"_31165":73191,"_21590":121843,"_5":14857,"_28357":121769,"_3076":52552},[],{"_3624":73228,"_31165":73191,"_21590":121845,"_5":14857,"_28357":121769,"_3076":52555},[],{"_3624":73229,"_31165":73191,"_21590":121847,"_5":14857,"_28357":121769,"_3076":52558},[],{"_3624":73230,"_31165":73191,"_21590":121849,"_5":14857,"_28357":121769,"_3076":52561},[],{"_3624":73231,"_31165":73191,"_21590":121851,"_5":14857,"_28357":121769,"_3076":52564},[],{"_3624":73232,"_31165":73191,"_21590":121853,"_5":14857,"_28357":121769,"_3076":121854},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3624":73233,"_31165":73191,"_21590":121856,"_5":14857,"_28357":121769,"_3076":121857},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3624":73234,"_31165":73191,"_21590":121859,"_5":14857,"_28357":121769,"_3076":121860},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3624":73235,"_31165":73235,"_5":15217,"_3076":121862,"_31523":121863,"_21590":121864,"_28357":73235},"Visión general del control de acceso",[50932,121756,121757,121758],[],{"_3624":73236,"_31165":73235,"_21590":121866,"_5":14857,"_28357":73235,"_3076":121867},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3624":73237,"_31165":73235,"_5":31520,"_21590":121869,"_28357":121870,"_3076":121871},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3624":73238,"_31165":73235,"_5":31520,"_21590":121873,"_28357":121874,"_3076":121875},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3624":73239,"_31165":73235,"_5":31520,"_21590":121877,"_28357":121878,"_3076":121879},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3624":73240,"_31165":73235,"_5":31520,"_21590":121881,"_28357":121882,"_3076":121883},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3624":73241,"_31165":73235,"_5":31520,"_21590":121885,"_28357":121886,"_3076":121887},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3624":73242,"_31165":73235,"_5":31520,"_21590":121889,"_28357":121890,"_3076":121891},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3624":73243,"_31165":73235,"_5":31520,"_21590":121893,"_28357":121894,"_3076":121895},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3624":73244,"_31165":73235,"_5":31520,"_21590":121897,"_28357":121898,"_3076":121899},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3624":73245,"_31165":73235,"_5":31520,"_21590":121901,"_28357":121902,"_3076":121903},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3624":73246,"_31165":73235,"_5":31520,"_21590":121905,"_28357":121906,"_3076":121907},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3624":73247,"_31165":73235,"_5":31520,"_21590":121909,"_28357":121910,"_3076":121911},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3624":73248,"_31165":73235,"_5":31520,"_21590":121913,"_28357":121914,"_3076":121915},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3624":73249,"_31165":73235,"_5":31520,"_21590":121917,"_28357":121918,"_3076":121919},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3624":73250,"_31165":73235,"_5":31520,"_21590":121921,"_28357":121922,"_3076":121923},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3624":73251,"_31165":73235,"_5":31520,"_21590":121925,"_28357":121926,"_3076":121927},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3624":73252,"_31165":73235,"_5":31520,"_21590":121929,"_28357":121930,"_3076":120897},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3624":73253,"_31165":73235,"_5":31520,"_21590":121932,"_28357":121933,"_3076":121934},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3624":73254,"_31165":73235,"_5":31520,"_21590":121936,"_28357":121937,"_3076":121938},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3624":73255,"_31165":73235,"_5":31520,"_21590":121940,"_28357":121941,"_3076":121942},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3624":73256,"_31165":73235,"_5":31520,"_21590":121944,"_28357":121945,"_3076":121946},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3624":73257,"_31165":73235,"_5":31520,"_21590":121948,"_28357":121949,"_3076":121950},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3624":73258,"_31165":73235,"_5":31520,"_21590":121952,"_28357":121953,"_3076":121954},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3624":73259,"_31165":73235,"_5":31520,"_21590":121956,"_28357":121957,"_3076":121958},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3624":73260,"_31165":73235,"_5":31520,"_21590":121960,"_28357":121961,"_3076":121962},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3624":73261,"_31165":73235,"_5":31520,"_21590":121964,"_28357":121965,"_3076":121966},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3624":73262,"_31165":73235,"_5":31520,"_21590":121968,"_28357":121969,"_3076":121970},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3624":73263,"_31165":73235,"_5":31520,"_21590":121972,"_28357":121973,"_3076":121974},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3624":73264,"_31165":73235,"_5":31520,"_21590":121976,"_28357":121977,"_3076":121978},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3624":73265,"_31165":73235,"_5":31520,"_21590":121980,"_28357":121981,"_3076":121982},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3624":73266,"_31165":73235,"_5":31520,"_21590":121984,"_28357":121985,"_3076":121986},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3624":73267,"_31165":73235,"_5":31520,"_21590":121988,"_28357":121989,"_3076":121990},[],"/docs/pr-preview/pr-76/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3624":73268,"_31165":73235,"_21590":121992,"_5":14857,"_28357":73235,"_3076":121993},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3624":73269,"_31165":73235,"_21590":121995,"_5":14857,"_28357":73235,"_3076":121996},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3624":73270,"_31165":73235,"_21590":121998,"_5":14857,"_28357":73235,"_3076":121999},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3624":73271,"_31165":73235,"_21590":122001,"_5":14857,"_28357":121870,"_3076":122002},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3624":73272,"_31165":73235,"_21590":122004,"_5":14857,"_28357":121870,"_3076":122005},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3624":73273,"_31165":73235,"_21590":122007,"_5":14857,"_28357":121870,"_3076":122008},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3624":73274,"_31165":73235,"_21590":122010,"_5":14857,"_28357":121870,"_3076":122011},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3624":73275,"_31165":73235,"_21590":122013,"_5":14857,"_28357":121870,"_3076":122014},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3624":73276,"_31165":73235,"_21590":122016,"_5":14857,"_28357":121870,"_3076":122017},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3624":73277,"_31165":73235,"_21590":122019,"_5":14857,"_28357":121874,"_3076":122020},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3624":73278,"_31165":73235,"_21590":122022,"_5":14857,"_28357":121874,"_3076":122023},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3624":73279,"_31165":73235,"_21590":122025,"_5":14857,"_28357":121878,"_3076":122026},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3624":73280,"_31165":73235,"_21590":122028,"_5":14857,"_28357":121878,"_3076":122029},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3624":73281,"_31165":73235,"_21590":122031,"_5":14857,"_28357":121878,"_3076":122032},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3624":73282,"_31165":73235,"_21590":122034,"_5":14857,"_28357":121878,"_3076":122035},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3624":73283,"_31165":73235,"_21590":122037,"_5":14857,"_28357":121878,"_3076":122038},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3624":73284,"_31165":73235,"_21590":122040,"_5":14857,"_28357":121878,"_3076":122041},[],"Carga por separado las políticas concedidas a cada principal.",{"_3624":73285,"_31165":73235,"_21590":122043,"_5":14857,"_28357":121878,"_3076":122044},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3624":73286,"_31165":73235,"_21590":122046,"_5":14857,"_28357":121878,"_3076":122047},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3624":73287,"_31165":73235,"_21590":122049,"_5":14857,"_28357":121878,"_3076":122050},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3624":73288,"_31165":73235,"_21590":122052,"_5":14857,"_28357":121878,"_3076":122053},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3624":73289,"_31165":73235,"_21590":122055,"_5":14857,"_28357":121878,"_3076":122056},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3624":73290,"_31165":73235,"_21590":122058,"_5":14857,"_28357":121878,"_3076":122059},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3624":73291,"_31165":73235,"_21590":122061,"_5":14857,"_28357":121882,"_3076":122062},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3624":73292,"_31165":73235,"_21590":122064,"_5":14857,"_28357":121882,"_3076":122065},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3624":73293,"_31165":73235,"_21590":122067,"_5":14857,"_28357":121882,"_3076":122068},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3624":73294,"_31165":73235,"_21590":122070,"_5":14857,"_28357":121882,"_3076":122071},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3624":73295,"_31165":73235,"_21590":122073,"_5":14857,"_28357":121882,"_3076":122074},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3624":73296,"_31165":73235,"_21590":122076,"_5":14857,"_28357":121882,"_3076":122077},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3624":73297,"_31165":73235,"_21590":122079,"_5":14857,"_28357":121882,"_3076":122080},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3624":73298,"_31165":73235,"_21590":122082,"_5":14857,"_28357":121882,"_3076":122083},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3624":73299,"_31165":73235,"_21590":122085,"_5":14857,"_28357":121882,"_3076":122086},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3624":73300,"_31165":73235,"_21590":122088,"_5":14857,"_28357":121882,"_3076":122089},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3624":73301,"_31165":73235,"_21590":122091,"_5":14857,"_28357":121886,"_3076":122092},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3624":73302,"_31165":73235,"_21590":122094,"_5":14857,"_28357":121886,"_3076":122095},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3624":73303,"_31165":73235,"_21590":122097,"_5":14857,"_28357":121886,"_3076":122098},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3624":73304,"_31165":73235,"_21590":122100,"_5":14857,"_28357":121886,"_3076":122101},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3624":73305,"_31165":73235,"_21590":122103,"_5":14857,"_28357":121886,"_3076":122104},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3624":73306,"_31165":73235,"_21590":122106,"_5":14857,"_28357":121886,"_3076":122107},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3624":73307,"_31165":73235,"_21590":122109,"_5":14857,"_28357":121886,"_3076":122110},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3624":73308,"_31165":73235,"_21590":122112,"_5":14857,"_28357":121886,"_3076":122113},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3624":73309,"_31165":73235,"_21590":122115,"_5":14857,"_28357":121886,"_3076":122116},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3624":73310,"_31165":73235,"_21590":122118,"_5":14857,"_28357":121886,"_3076":122119},[],"Las acciones se dividen en dos grupos:",{"_3624":73311,"_31165":73235,"_21590":122121,"_5":14857,"_28357":121886,"_3076":122122},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3624":73312,"_31165":73235,"_21590":122124,"_5":14857,"_28357":121886,"_3076":122125},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3624":73313,"_31165":73235,"_21590":122127,"_5":14857,"_28357":121886,"_3076":122128},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3624":73314,"_31165":73235,"_21590":122130,"_5":14857,"_28357":121890,"_3076":122131},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3624":73315,"_31165":73235,"_21590":122133,"_5":14857,"_28357":121890,"_3076":122134},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3624":73316,"_31165":73235,"_21590":122136,"_5":14857,"_28357":121890,"_3076":122137},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3624":73317,"_31165":73235,"_21590":122139,"_5":14857,"_28357":121894,"_3076":122140},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3624":73318,"_31165":73235,"_21590":122142,"_5":14857,"_28357":121894,"_3076":122143},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3624":73319,"_31165":73235,"_21590":122145,"_5":14857,"_28357":121894,"_3076":122146},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3624":73320,"_31165":73235,"_21590":122148,"_5":14857,"_28357":121894,"_3076":122149},[],"Los operadores implementados son:",{"_3624":73321,"_31165":73235,"_21590":122151,"_5":14857,"_28357":121894,"_3076":122152},[],"`equals`, para igualdad exacta;",{"_3624":73322,"_31165":73235,"_21590":122154,"_5":14857,"_28357":121894,"_3076":122155},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3624":73323,"_31165":73235,"_21590":122157,"_5":14857,"_28357":121894,"_3076":122158},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3624":73324,"_31165":73235,"_21590":122160,"_5":14857,"_28357":121894,"_3076":122161},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3624":73325,"_31165":73235,"_21590":122163,"_5":14857,"_28357":121898,"_3076":122164},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3624":73326,"_31165":73235,"_21590":122166,"_5":14857,"_28357":121898,"_3076":122167},[],"Los modos disponibles son:",{"_3624":73327,"_31165":73235,"_21590":122169,"_5":14857,"_28357":121898,"_3076":122170},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3624":73328,"_31165":73235,"_21590":122172,"_5":14857,"_28357":121898,"_3076":122173},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3624":73329,"_31165":73235,"_21590":122175,"_5":14857,"_28357":121898,"_3076":122176},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3624":73330,"_31165":73235,"_21590":122178,"_5":14857,"_28357":121898,"_3076":122179},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3624":73331,"_31165":73235,"_21590":122181,"_5":14857,"_28357":121898,"_3076":122182},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3624":73332,"_31165":73235,"_21590":122184,"_5":14857,"_28357":121898,"_3076":122185},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3624":73333,"_31165":73235,"_21590":122187,"_5":14857,"_28357":121902,"_3076":122188},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3624":73334,"_31165":73235,"_21590":122190,"_5":14857,"_28357":121902,"_3076":122191},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3624":73335,"_31165":73235,"_21590":122193,"_5":14857,"_28357":121902,"_3076":122194},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3624":73336,"_31165":73235,"_21590":122196,"_5":14857,"_28357":121902,"_3076":122197},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3624":73337,"_31165":73235,"_21590":122199,"_5":14857,"_28357":121910,"_3076":122200},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3624":73338,"_31165":73235,"_21590":122202,"_5":14857,"_28357":121910,"_3076":122203},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3624":73339,"_31165":73235,"_21590":122205,"_5":14857,"_28357":121914,"_3076":122206},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3624":73340,"_31165":73235,"_21590":122208,"_5":14857,"_28357":121914,"_3076":122209},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3624":73341,"_31165":73235,"_21590":122211,"_5":14857,"_28357":121914,"_3076":122212},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3624":73342,"_31165":73235,"_21590":122214,"_5":14857,"_28357":121914,"_3076":122215},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3624":73343,"_31165":73235,"_21590":122217,"_5":14857,"_28357":121914,"_3076":122218},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3624":73344,"_31165":73235,"_21590":122220,"_5":14857,"_28357":121918,"_3076":122221},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3624":73345,"_31165":73235,"_21590":122223,"_5":14857,"_28357":121918,"_3076":122224},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3624":73346,"_31165":73235,"_21590":122226,"_5":14857,"_28357":121918,"_3076":122227},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3624":73347,"_31165":73235,"_21590":122229,"_5":14857,"_28357":121922,"_3076":122230},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3624":73348,"_31165":73235,"_21590":122232,"_5":14857,"_28357":121922,"_3076":122233},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3624":73349,"_31165":73235,"_21590":122235,"_5":14857,"_28357":121922,"_3076":122236},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3624":73350,"_31165":73235,"_21590":122238,"_5":14857,"_28357":121922,"_3076":122239},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3624":73351,"_31165":73235,"_21590":122241,"_5":14857,"_28357":121922,"_3076":122242},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3624":73352,"_31165":73235,"_21590":122244,"_5":14857,"_28357":121922,"_3076":122245},[],"Ten en cuenta que:",{"_3624":73353,"_31165":73235,"_21590":122247,"_5":14857,"_28357":121922,"_3076":122248},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3624":73354,"_31165":73235,"_21590":122250,"_5":14857,"_28357":121922,"_3076":122251},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3624":73355,"_31165":73235,"_21590":122253,"_5":14857,"_28357":121922,"_3076":122254},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3624":73356,"_31165":73235,"_21590":122256,"_5":14857,"_28357":121926,"_3076":122257},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3624":73357,"_31165":73235,"_21590":122259,"_5":14857,"_28357":121926,"_3076":122260},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3624":73358,"_31165":73235,"_21590":122262,"_5":14857,"_28357":121926,"_3076":122263},[],"acceso completo y de solo lectura a KMS;",{"_3624":73359,"_31165":73235,"_21590":122265,"_5":14857,"_28357":121926,"_3076":122266},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3624":73360,"_31165":73235,"_21590":122268,"_5":14857,"_28357":121926,"_3076":122269},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3624":73361,"_31165":73235,"_21590":122271,"_5":14857,"_28357":121926,"_3076":122272},[],"acceso a la interfaz;",{"_3624":73362,"_31165":73235,"_21590":122274,"_5":14857,"_28357":121926,"_3076":122275},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3624":73363,"_31165":73235,"_21590":122277,"_5":14857,"_28357":121926,"_3076":122278},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3624":73364,"_31165":73235,"_21590":122280,"_5":14857,"_28357":121926,"_3076":122281},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3624":73365,"_31165":73235,"_21590":122283,"_5":14857,"_28357":121926,"_3076":122284},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3624":73366,"_31165":73235,"_21590":122286,"_5":14857,"_28357":121926,"_3076":122287},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3624":73367,"_31165":73235,"_21590":122289,"_5":14857,"_28357":121930,"_3076":122290},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3624":73368,"_31165":73235,"_21590":122292,"_5":14857,"_28357":121930,"_3076":122293},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3624":73369,"_31165":73235,"_21590":122295,"_5":14857,"_28357":121930,"_3076":122296},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3624":73370,"_31165":73235,"_21590":122298,"_5":14857,"_28357":121933,"_3076":122299},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3624":73371,"_31165":73235,"_21590":122301,"_5":14857,"_28357":121937,"_3076":122302},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3624":73372,"_31165":73235,"_21590":122304,"_5":14857,"_28357":121937,"_3076":122305},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3624":73373,"_31165":73235,"_21590":122307,"_5":14857,"_28357":121941,"_3076":122308},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3624":73374,"_31165":73235,"_21590":122310,"_5":14857,"_28357":121945,"_3076":122311},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3624":73375,"_31165":73235,"_21590":122313,"_5":14857,"_28357":121949,"_3076":122314},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3624":73376,"_31165":73235,"_21590":122316,"_5":14857,"_28357":121953,"_3076":122317},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3624":73377,"_31165":73235,"_21590":122319,"_5":14857,"_28357":121953,"_3076":122320},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3624":73378,"_31165":73235,"_21590":122322,"_5":14857,"_28357":121957,"_3076":122323},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3624":73379,"_31165":73235,"_21590":122325,"_5":14857,"_28357":121957,"_3076":122326},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3624":73380,"_31165":73235,"_21590":122328,"_5":14857,"_28357":121957,"_3076":122329},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3624":73381,"_31165":73235,"_21590":122331,"_5":14857,"_28357":121957,"_3076":122332},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3624":73382,"_31165":73235,"_21590":122334,"_5":14857,"_28357":121957,"_3076":122335},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3624":73383,"_31165":73235,"_21590":122337,"_5":14857,"_28357":121957,"_3076":122338},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3624":73384,"_31165":73235,"_21590":122340,"_5":14857,"_28357":121957,"_3076":122341},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3624":73385,"_31165":73235,"_21590":122343,"_5":14857,"_28357":121957,"_3076":122344},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3624":73386,"_31165":73235,"_21590":122346,"_5":14857,"_28357":121961,"_3076":122347},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3624":73387,"_31165":73235,"_21590":122349,"_5":14857,"_28357":121961,"_3076":122350},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3624":73388,"_31165":73235,"_21590":122352,"_5":14857,"_28357":121961,"_3076":122353},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3624":73389,"_31165":73235,"_21590":122355,"_5":14857,"_28357":121965,"_3076":122356},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3624":73390,"_31165":73235,"_21590":122358,"_5":14857,"_28357":121965,"_3076":122359},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3624":73391,"_31165":73235,"_21590":122361,"_5":14857,"_28357":121965,"_3076":122362},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3624":73392,"_31165":73235,"_21590":122364,"_5":14857,"_28357":121965,"_3076":122365},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3624":73393,"_31165":73235,"_21590":122367,"_5":14857,"_28357":121965,"_3076":122368},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3624":73394,"_31165":73235,"_21590":122370,"_5":14857,"_28357":121965,"_3076":122371},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3624":73395,"_31165":73235,"_21590":122373,"_5":14857,"_28357":121965,"_3076":122374},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3624":73396,"_31165":73235,"_21590":122376,"_5":14857,"_28357":121965,"_3076":122377},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3624":73397,"_31165":73235,"_21590":122379,"_5":14857,"_28357":121973,"_3076":122380},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3624":73398,"_31165":73235,"_21590":122382,"_5":14857,"_28357":121977,"_3076":122383},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3624":73399,"_31165":73235,"_21590":122385,"_5":14857,"_28357":121977,"_3076":122386},[],"que exista un principal activo del tipo correcto;",{"_3624":73400,"_31165":73235,"_21590":122388,"_5":14857,"_28357":121977,"_3076":122389},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3624":73401,"_31165":73235,"_21590":122391,"_5":14857,"_28357":121977,"_3076":122392},[],"que todas las condiciones del principal se cumplan;",{"_3624":73402,"_31165":73235,"_21590":122394,"_5":14857,"_28357":121977,"_3076":122395},[],"que el principal tenga concedida la política esperada;",{"_3624":73403,"_31165":73235,"_21590":122397,"_5":14857,"_28357":121977,"_3076":122398},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3624":73404,"_31165":73235,"_21590":122400,"_5":14857,"_28357":121977,"_3076":122401},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3624":73405,"_31165":73235,"_21590":122403,"_5":14857,"_28357":121977,"_3076":122404},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3624":73406,"_31165":73235,"_21590":122406,"_5":14857,"_28357":121977,"_3076":122407},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3624":73407,"_31165":73235,"_21590":122409,"_5":14857,"_28357":121981,"_3076":122410},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3624":73408,"_31165":73235,"_21590":122412,"_5":14857,"_28357":121985,"_3076":122413},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3624":73409,"_31165":73235,"_21590":122415,"_5":14857,"_28357":121989,"_3076":122416},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3624":73410,"_31165":73235,"_21590":122418,"_5":14857,"_28357":121989,"_3076":122419},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3624":73411,"_31165":73411,"_5":15217,"_3076":122421,"_31523":122422,"_21590":122423,"_28357":73411},"Alertas y suscripciones",[50932,121756,121757],[],{"_3624":73412,"_31165":73411,"_21590":122425,"_5":14857,"_28357":73411,"_3076":122426},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3624":73413,"_31165":73411,"_5":31520,"_21590":122428,"_28357":122429,"_3076":122430},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3624":73414,"_31165":73411,"_5":31520,"_21590":122432,"_28357":122433,"_3076":122434},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3624":73415,"_31165":73411,"_5":31520,"_21590":122436,"_28357":122437,"_3076":122438},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3624":73416,"_31165":73411,"_5":31520,"_21590":122440,"_28357":122441,"_3076":122442},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3624":73417,"_31165":73411,"_5":31520,"_21590":122444,"_28357":122445,"_3076":122446},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3624":73418,"_31165":73411,"_5":31520,"_21590":122448,"_28357":122449,"_3076":122450},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3624":73419,"_31165":73411,"_5":31520,"_21590":122452,"_28357":122453,"_3076":122454},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3624":73420,"_31165":73411,"_5":31520,"_21590":122456,"_28357":122457,"_3076":122458},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3624":73421,"_31165":73411,"_5":31520,"_21590":122460,"_28357":122461,"_3076":122462},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3624":73422,"_31165":73411,"_5":31520,"_21590":122464,"_28357":122465,"_3076":122466},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3624":73423,"_31165":73411,"_5":31520,"_21590":122468,"_28357":122469,"_3076":122470},[],"/docs/pr-preview/pr-76/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3624":73424,"_31165":73411,"_21590":122472,"_5":14857,"_28357":73411,"_3076":122473},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3624":73425,"_31165":73411,"_21590":122475,"_5":14857,"_28357":122429,"_3076":122476},[],"Un servicio publica un evento de dominio.",{"_3624":73426,"_31165":73411,"_21590":122478,"_5":14857,"_28357":122429,"_3076":122479},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3624":73427,"_31165":73411,"_21590":122481,"_5":14857,"_28357":122429,"_3076":122482},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3624":73428,"_31165":73411,"_21590":122484,"_5":14857,"_28357":122429,"_3076":122485},[],"Lamassu entrega el evento al canal configurado.",{"_3624":73429,"_31165":73411,"_21590":122487,"_5":14857,"_28357":122429,"_3076":122488},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3624":73430,"_31165":73411,"_21590":122490,"_5":14857,"_28357":122433,"_3076":122491},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3624":73431,"_31165":73411,"_21590":122493,"_5":14857,"_28357":122433,"_3076":122494},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3624":73432,"_31165":73411,"_21590":122496,"_5":14857,"_28357":122433,"_3076":122497},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3624":73433,"_31165":73411,"_21590":122499,"_5":14857,"_28357":122433,"_3076":122500},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3624":73434,"_31165":73411,"_21590":122502,"_5":14857,"_28357":122433,"_3076":122503},[],"`apikey_options` necesita `header` y `key`.",{"_3624":73435,"_31165":73411,"_21590":122505,"_5":14857,"_28357":122433,"_3076":122506},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3624":73436,"_31165":73411,"_21590":122508,"_5":14857,"_28357":122433,"_3076":122509},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3624":73437,"_31165":73411,"_21590":122511,"_5":14857,"_28357":122433,"_3076":122512},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3624":73438,"_31165":73411,"_21590":122514,"_5":14857,"_28357":122441,"_3076":122515},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3624":73439,"_31165":73411,"_21590":122517,"_5":14857,"_28357":122445,"_3076":122518},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3624":73440,"_31165":73411,"_21590":122520,"_5":14857,"_28357":122449,"_3076":122521},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3624":73441,"_31165":73411,"_21590":122523,"_5":14857,"_28357":122449,"_3076":122524},[],"**None** notifica todas las instancias del evento.",{"_3624":73442,"_31165":73411,"_21590":122526,"_5":14857,"_28357":122449,"_3076":122527},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3624":73443,"_31165":73411,"_21590":122529,"_5":14857,"_28357":122449,"_3076":122530},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3624":73444,"_31165":73411,"_21590":122532,"_5":14857,"_28357":122449,"_3076":122533},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3624":73445,"_31165":73411,"_21590":122535,"_5":14857,"_28357":122449,"_3076":122536},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3624":73446,"_31165":73411,"_21590":122538,"_5":14857,"_28357":122449,"_3076":122539},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3624":73447,"_31165":73411,"_21590":122541,"_5":14857,"_28357":122453,"_3076":122542},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3624":73448,"_31165":73411,"_21590":122544,"_5":14857,"_28357":122457,"_3076":122545},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3624":73449,"_31165":73411,"_21590":122547,"_5":14857,"_28357":122457,"_3076":122548},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3624":73450,"_31165":73411,"_21590":122550,"_5":14857,"_28357":122457,"_3076":122551},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3624":73451,"_31165":73411,"_21590":122553,"_5":14857,"_28357":122457,"_3076":122554},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3624":73452,"_31165":73411,"_21590":122556,"_5":14857,"_28357":122457,"_3076":122557},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3624":73453,"_31165":73411,"_21590":122559,"_5":14857,"_28357":122457,"_3076":122560},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3624":73454,"_31165":73411,"_21590":122562,"_5":14857,"_28357":122457,"_3076":122563},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3624":73455,"_31165":73411,"_21590":122565,"_5":14857,"_28357":122457,"_3076":122566},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3624":73456,"_31165":73411,"_21590":122568,"_5":14857,"_28357":122461,"_3076":122569},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3624":73457,"_31165":73411,"_21590":122571,"_5":14857,"_28357":122461,"_3076":122572},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3624":73458,"_31165":73411,"_21590":122574,"_5":14857,"_28357":122461,"_3076":122575},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3624":73459,"_31165":73411,"_21590":122577,"_5":14857,"_28357":122461,"_3076":122578},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3624":73460,"_31165":73411,"_21590":122580,"_5":14857,"_28357":122461,"_3076":122581},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3624":73461,"_31165":73411,"_21590":122583,"_5":14857,"_28357":122461,"_3076":122584},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3624":73462,"_31165":73411,"_21590":122586,"_5":14857,"_28357":122461,"_3076":122587},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3624":73463,"_31165":73411,"_21590":122589,"_5":14857,"_28357":122461,"_3076":122590},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3624":73464,"_31165":73411,"_21590":122592,"_5":14857,"_28357":122465,"_3076":122593},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3624":73465,"_31165":73411,"_21590":122595,"_5":14857,"_28357":122465,"_3076":122596},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3624":73466,"_31165":73411,"_21590":122598,"_5":14857,"_28357":122469,"_3076":122599},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3624":73467,"_31165":73411,"_21590":122601,"_5":14857,"_28357":122469,"_3076":122602},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3624":73468,"_31165":73411,"_21590":122604,"_5":14857,"_28357":122469,"_3076":122605},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3624":73469,"_31165":73411,"_21590":122607,"_5":14857,"_28357":122469,"_3076":122608},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3624":73470,"_31165":73411,"_21590":122610,"_5":14857,"_28357":122469,"_3076":122611},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3624":73471,"_31165":73411,"_21590":122613,"_5":14857,"_28357":122469,"_3076":122614},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3624":73472,"_31165":73411,"_21590":122616,"_5":14857,"_28357":122469,"_3076":122617},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3624":73473,"_31165":73411,"_21590":122619,"_5":14857,"_28357":122469,"_3076":122620},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3624":73474,"_31165":73411,"_21590":122622,"_5":14857,"_28357":122469,"_3076":122623},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3624":73475,"_31165":73411,"_21590":122625,"_5":14857,"_28357":122469,"_3076":122626},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3624":73476,"_31165":73476,"_5":15217,"_3076":122628,"_31523":122629,"_21590":122630,"_28357":73476},"Registros de auditoría",[50932,121756,121757],[],{"_3624":73477,"_31165":73476,"_21590":122632,"_5":14857,"_28357":73476,"_3076":122633},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3624":73478,"_31165":73476,"_5":31520,"_21590":122635,"_28357":122636,"_3076":122637},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3624":73479,"_31165":73476,"_5":31520,"_21590":122639,"_28357":122640,"_3076":122641},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3624":73480,"_31165":73476,"_5":31520,"_21590":122643,"_28357":122644,"_3076":122645},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3624":73481,"_31165":73476,"_5":31520,"_21590":122647,"_28357":122648,"_3076":122649},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3624":73482,"_31165":73476,"_5":31520,"_21590":122651,"_28357":122652,"_3076":122653},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3624":73483,"_31165":73476,"_5":31520,"_21590":122655,"_28357":122656,"_3076":122657},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3624":73484,"_31165":73476,"_5":31520,"_21590":122659,"_28357":122660,"_3076":122661},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3624":73485,"_31165":73476,"_5":31520,"_21590":122663,"_28357":122664,"_3076":122665},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3624":73486,"_31165":73476,"_5":31520,"_21590":122667,"_28357":122668,"_3076":122669},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3624":73487,"_31165":73476,"_5":31520,"_21590":122671,"_28357":122672,"_3076":122673},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3624":73488,"_31165":73476,"_5":31520,"_21590":122675,"_28357":122676,"_3076":122677},[],"/docs/pr-preview/pr-76/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3624":73489,"_31165":73476,"_21590":122679,"_5":14857,"_28357":73476,"_3076":122680},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3624":73490,"_31165":73476,"_21590":122682,"_5":14857,"_28357":122636,"_3076":122683},[],"El cuerpo de auditoría incluye:",{"_3624":73491,"_31165":73476,"_21590":122685,"_5":14857,"_28357":122636,"_3076":122686},[],"input: datos recibidos por la operación;",{"_3624":73492,"_31165":73476,"_21590":122688,"_5":14857,"_28357":122636,"_3076":122689},[],"has\\_error: indica si el servicio devolvió un error;",{"_3624":73493,"_31165":73476,"_21590":122691,"_5":14857,"_28357":122636,"_3076":122692},[],"output: resultado producido o mensaje de error;",{"_3624":73494,"_31165":73476,"_21590":122694,"_5":14857,"_28357":122636,"_3076":122695},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3624":73495,"_31165":73476,"_21590":122697,"_5":14857,"_28357":122636,"_3076":122698},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3624":73496,"_31165":73476,"_21590":122700,"_5":14857,"_28357":122636,"_3076":122701},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3624":73497,"_31165":73476,"_21590":122703,"_5":14857,"_28357":122640,"_3076":122704},[],"El backend aplica auditoría a mutaciones de:",{"_3624":73498,"_31165":73476,"_21590":122706,"_5":14857,"_28357":122640,"_3076":122707},[],"autoridades, certificados y perfiles de emisión;",{"_3624":73499,"_31165":73476,"_21590":122709,"_5":14857,"_28357":122640,"_3076":122710},[],"claves y motores KMS;",{"_3624":73500,"_31165":73476,"_21590":122712,"_5":14857,"_28357":122640,"_3076":122713},[],"dispositivos e identidades;",{"_3624":73501,"_31165":73476,"_21590":122715,"_5":14857,"_28357":122640,"_3076":122716},[],"DMS y operaciones de enrolamiento;",{"_3624":73502,"_31165":73476,"_21590":122718,"_5":14857,"_28357":122640,"_3076":122719},[],"funciones de validación y CRL;",{"_3624":73503,"_31165":73476,"_21590":122721,"_5":14857,"_28357":122640,"_3076":122722},[],"principales, políticas y concesiones de autorización.",{"_3624":73504,"_31165":73476,"_21590":122724,"_5":14857,"_28357":122640,"_3076":122725},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3624":73505,"_31165":73476,"_21590":122727,"_5":14857,"_28357":122644,"_3076":122728},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3624":73506,"_31165":73476,"_21590":122730,"_5":14857,"_28357":122644,"_3076":122731},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3624":73507,"_31165":73476,"_21590":122733,"_5":14857,"_28357":122644,"_3076":122734},[],"Diseña el consumidor para:",{"_3624":73508,"_31165":73476,"_21590":122736,"_5":14857,"_28357":122644,"_3076":122737},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3624":73509,"_31165":73476,"_21590":122739,"_5":14857,"_28357":122644,"_3076":122740},[],"conservar el CloudEvent completo sin modificar;",{"_3624":73510,"_31165":73476,"_21590":122742,"_5":14857,"_28357":122644,"_3076":122743},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3624":73511,"_31165":73476,"_21590":122745,"_5":14857,"_28357":122644,"_3076":122746},[],"cifrar en tránsito y en reposo;",{"_3624":73512,"_31165":73476,"_21590":122748,"_5":14857,"_28357":122644,"_3076":122749},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3624":73513,"_31165":73476,"_21590":122751,"_5":14857,"_28357":122644,"_3076":122752},[],"aplicar una política explícita de retención y legal hold;",{"_3624":73514,"_31165":73476,"_21590":122754,"_5":14857,"_28357":122644,"_3076":122755},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3624":73515,"_31165":73476,"_21590":122757,"_5":14857,"_28357":122648,"_3076":122758},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3624":73516,"_31165":73476,"_21590":122760,"_5":14857,"_28357":122648,"_3076":122761},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3624":73517,"_31165":73476,"_21590":122763,"_5":14857,"_28357":122656,"_3076":122764},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3624":73518,"_31165":73476,"_21590":122766,"_5":14857,"_28357":122660,"_3076":122767},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3624":73519,"_31165":73476,"_21590":122769,"_5":14857,"_28357":122664,"_3076":122770},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3624":73520,"_31165":73476,"_21590":122772,"_5":14857,"_28357":122668,"_3076":122773},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3624":73521,"_31165":73476,"_21590":122775,"_5":14857,"_28357":122672,"_3076":122776},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3624":73522,"_31165":73476,"_21590":122778,"_5":14857,"_28357":122676,"_3076":122779},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3624":73523,"_31165":73476,"_21590":122781,"_5":14857,"_28357":122676,"_3076":122782},[],"aparece un evento de auditoría correcto;",{"_3624":73524,"_31165":73476,"_21590":122784,"_5":14857,"_28357":122676,"_3076":122785},[],"el principal coincide con la identidad utilizada;",{"_3624":73525,"_31165":73476,"_21590":122787,"_5":14857,"_28357":122676,"_3076":122788},[],"el consumidor lo persiste una sola vez;",{"_3624":73526,"_31165":73476,"_21590":122790,"_5":14857,"_28357":122676,"_3076":122791},[],"puede recuperarse por recurso, actor y periodo;",{"_3624":73527,"_31165":73476,"_21590":122793,"_5":14857,"_28357":122676,"_3076":122794},[],"una interrupción del consumidor produce una alerta.",{"_3624":73528,"_31165":73476,"_21590":122796,"_5":14857,"_28357":122676,"_3076":122797},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3624":73529,"_31165":73529,"_5":15217,"_3076":122799,"_31523":122800,"_21590":122801,"_28357":73529},"Arquitectura de la plataforma",[50932,121756],[],{"_3624":73530,"_31165":73529,"_21590":122803,"_5":14857,"_28357":73529,"_3076":122804},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3624":73531,"_31165":73529,"_5":31520,"_21590":122806,"_28357":122807,"_3076":122808},[],"/docs/pr-preview/pr-76/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3624":73532,"_31165":73529,"_5":31520,"_21590":122810,"_28357":122811,"_3076":122812},[],"/docs/pr-preview/pr-76/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3624":73533,"_31165":73529,"_5":31520,"_21590":122814,"_28357":122815,"_3076":122816},[],"/docs/pr-preview/pr-76/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3624":73534,"_31165":73529,"_5":31520,"_21590":122818,"_28357":122819,"_3076":122820},[],"/docs/pr-preview/pr-76/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3624":73535,"_31165":73529,"_5":31520,"_21590":122822,"_28357":122823,"_3076":122824},[],"/docs/pr-preview/pr-76/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3624":73536,"_31165":73529,"_21590":122826,"_5":14857,"_28357":73529,"_3076":122827},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3624":73537,"_31165":73529,"_21590":122829,"_5":14857,"_28357":73529,"_3076":122830},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3624":73538,"_31165":73529,"_21590":122832,"_5":14857,"_28357":122807,"_3076":122833},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3624":73539,"_31165":73529,"_21590":122835,"_5":14857,"_28357":122811,"_3076":122836},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3624":73540,"_31165":73529,"_21590":122838,"_5":14857,"_28357":122815,"_3076":122839},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3624":73541,"_31165":73529,"_21590":122841,"_5":14857,"_28357":122819,"_3076":122842},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3624":73542,"_31165":73529,"_21590":122844,"_5":14857,"_28357":122823,"_3076":122845},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3624":73543,"_31165":73543,"_5":15217,"_3076":122847,"_31523":122848,"_21590":122849,"_28357":73543},"Cómo funciona Lamassu",[50932,121756],[],{"_3624":73544,"_31165":73543,"_21590":122851,"_5":14857,"_28357":73543,"_3076":122852},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3624":73545,"_31165":73543,"_5":31520,"_21590":122854,"_28357":122855,"_3076":122856},[],"/docs/pr-preview/pr-76/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3624":73546,"_31165":73543,"_5":31520,"_21590":122858,"_28357":122859,"_3076":122860},[],"/docs/pr-preview/pr-76/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3624":73547,"_31165":73543,"_21590":122862,"_5":14857,"_28357":73543,"_3076":122863},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3624":73548,"_31165":73543,"_21590":122865,"_5":14857,"_28357":122855,"_3076":122866},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3624":73549,"_31165":73543,"_21590":122868,"_5":14857,"_28357":122855,"_3076":122869},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3624":73550,"_31165":73543,"_21590":122871,"_5":14857,"_28357":122855,"_3076":122872},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3624":73551,"_31165":73543,"_21590":122874,"_5":14857,"_28357":122855,"_3076":122875},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3624":73552,"_31165":73543,"_21590":122877,"_5":14857,"_28357":122855,"_3076":122878},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3624":73553,"_31165":73543,"_21590":122880,"_5":14857,"_28357":122859,"_3076":122881},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3624":73554,"_31165":73543,"_21590":122883,"_5":14857,"_28357":122859,"_3076":122884},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3624":73555,"_31165":73543,"_21590":122886,"_5":14857,"_28357":122859,"_3076":122887},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3624":73556,"_31165":73543,"_21590":122889,"_5":14857,"_28357":122859,"_3076":122890},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3624":73557,"_31165":73543,"_21590":122892,"_5":14857,"_28357":122859,"_3076":122893},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3624":73558,"_31165":73543,"_21590":122895,"_5":14857,"_28357":122859,"_3076":122896},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3624":73559,"_31165":73543,"_21590":122898,"_5":14857,"_28357":122859,"_3076":122899},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3624":73560,"_31165":73560,"_5":15217,"_3076":122901,"_31523":122902,"_21590":122903,"_28357":73560},"Dispositivos e identidades",[50932,121756,53616,122901],[],{"_3624":73561,"_31165":73560,"_21590":122905,"_5":14857,"_28357":73560,"_3076":122906},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3624":73562,"_31165":73560,"_5":31520,"_21590":122908,"_28357":122909,"_3076":122910},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3624":73563,"_31165":73560,"_5":31520,"_21590":122912,"_28357":122913,"_3076":122914},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3624":73564,"_31165":73560,"_5":31520,"_21590":122916,"_28357":122917,"_3076":122918},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3624":73565,"_31165":73560,"_5":31520,"_21590":122920,"_28357":122921,"_3076":122922},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3624":73566,"_31165":73560,"_5":31520,"_21590":122924,"_28357":122925,"_3076":122926},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3624":73567,"_31165":73560,"_5":31520,"_21590":122928,"_28357":122929,"_3076":122930},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3624":73568,"_31165":73560,"_5":31520,"_21590":122932,"_28357":122933,"_3076":122934},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3624":73569,"_31165":73560,"_5":31520,"_21590":122936,"_28357":122937,"_3076":122938},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3624":73570,"_31165":73560,"_5":31520,"_21590":122940,"_28357":122941,"_3076":122942},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3624":73571,"_31165":73560,"_5":31520,"_21590":122944,"_28357":122945,"_3076":122946},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3624":73572,"_31165":73560,"_5":31520,"_21590":122948,"_28357":122949,"_3076":122950},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3624":73573,"_31165":73560,"_21590":122952,"_5":14857,"_28357":73560,"_3076":122953},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3624":73574,"_31165":73560,"_21590":122955,"_5":14857,"_28357":73560,"_3076":122956},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3624":73575,"_31165":73560,"_21590":122958,"_5":14857,"_28357":122909,"_3076":122959},[],"Vista operativa",{"_3624":73576,"_31165":73560,"_21590":122961,"_5":14857,"_28357":122909,"_3076":122962},[],"Interpretación",{"_3624":73577,"_31165":73560,"_21590":122964,"_5":14857,"_28357":122909,"_3076":53679},[],{"_3624":73578,"_31165":73560,"_21590":122966,"_5":14857,"_28357":122909,"_3076":122967},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3624":73579,"_31165":73560,"_21590":122969,"_5":14857,"_28357":122909,"_3076":53685},[],{"_3624":73580,"_31165":73560,"_21590":122971,"_5":14857,"_28357":122909,"_3076":122972},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3624":73581,"_31165":73560,"_21590":122974,"_5":14857,"_28357":122909,"_3076":53691},[],{"_3624":73582,"_31165":73560,"_21590":122976,"_5":14857,"_28357":122909,"_3076":122977},[],"La identidad está en la ventana operativa de renovación.",{"_3624":73583,"_31165":73560,"_21590":122979,"_5":14857,"_28357":122909,"_3076":53697},[],{"_3624":73584,"_31165":73560,"_21590":122981,"_5":14857,"_28357":122909,"_3076":122982},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3624":73585,"_31165":73560,"_21590":122984,"_5":14857,"_28357":122909,"_3076":53703},[],{"_3624":73586,"_31165":73560,"_21590":122986,"_5":14857,"_28357":122909,"_3076":122987},[],"La identidad ha vencido.",{"_3624":73587,"_31165":73560,"_21590":122989,"_5":14857,"_28357":122909,"_3076":53709},[],{"_3624":73588,"_31165":73560,"_21590":122991,"_5":14857,"_28357":122909,"_3076":122992},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3624":73589,"_31165":73560,"_21590":122994,"_5":14857,"_28357":122909,"_3076":53715},[],{"_3624":73590,"_31165":73560,"_21590":122996,"_5":14857,"_28357":122909,"_3076":122997},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3624":73591,"_31165":73560,"_21590":122999,"_5":14857,"_28357":122909,"_3076":123000},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3624":73592,"_31165":73560,"_21590":123002,"_5":14857,"_28357":122913,"_3076":123003},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3624":73593,"_31165":73560,"_21590":123005,"_5":14857,"_28357":122913,"_3076":123006},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3624":73594,"_31165":73560,"_21590":123008,"_5":14857,"_28357":122913,"_3076":123009},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3624":73595,"_31165":73560,"_21590":123011,"_5":14857,"_28357":122913,"_3076":123012},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3624":73596,"_31165":73560,"_21590":123014,"_5":14857,"_28357":122917,"_3076":123015},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3624":73597,"_31165":73560,"_21590":123017,"_5":14857,"_28357":122921,"_3076":123018},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3624":73598,"_31165":73560,"_21590":123020,"_5":14857,"_28357":122925,"_3076":123021},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3624":73599,"_31165":73560,"_21590":123023,"_5":14857,"_28357":122929,"_3076":123024},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3624":73600,"_31165":73560,"_21590":123026,"_5":14857,"_28357":122933,"_3076":123027},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3624":73601,"_31165":73560,"_21590":123029,"_5":14857,"_28357":122933,"_3076":123030},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3624":73602,"_31165":73560,"_21590":123032,"_5":14857,"_28357":122937,"_3076":123033},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3624":73603,"_31165":73560,"_21590":123035,"_5":14857,"_28357":122937,"_3076":123036},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3624":73604,"_31165":73560,"_21590":123038,"_5":14857,"_28357":122937,"_3076":123039},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3624":73605,"_31165":73560,"_21590":123041,"_5":14857,"_28357":122937,"_3076":123042},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3624":73606,"_31165":73560,"_21590":123044,"_5":14857,"_28357":122937,"_3076":123045},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3624":73607,"_31165":73560,"_21590":123047,"_5":14857,"_28357":122937,"_3076":123048},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3624":73608,"_31165":73560,"_21590":123050,"_5":14857,"_28357":122941,"_3076":123051},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3624":73609,"_31165":73560,"_21590":123053,"_5":14857,"_28357":122941,"_3076":123054},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3624":73610,"_31165":73560,"_21590":123056,"_5":14857,"_28357":122941,"_3076":123057},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3624":73611,"_31165":73560,"_21590":123059,"_5":14857,"_28357":122945,"_3076":123060},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3624":73612,"_31165":73560,"_21590":123062,"_5":14857,"_28357":122945,"_3076":123063},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3624":73613,"_31165":73560,"_21590":123065,"_5":14857,"_28357":122945,"_3076":123066},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3624":73614,"_31165":73560,"_21590":123068,"_5":14857,"_28357":122945,"_3076":123069},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3624":73615,"_31165":73560,"_21590":123071,"_5":14857,"_28357":122949,"_3076":123072},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3624":73616,"_31165":73560,"_21590":123074,"_5":14857,"_28357":122949,"_3076":123075},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3624":73617,"_31165":73617,"_5":15217,"_3076":123077,"_31523":123078,"_21590":123080,"_28357":73617},"Identidad inicial y autenticación",[50932,121756,53616,122901,123079],"Enrolamiento con PKI",[],{"_3624":73618,"_31165":73617,"_21590":123082,"_5":14857,"_28357":73617,"_3076":123083},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3624":73619,"_31165":73617,"_5":31520,"_21590":123085,"_28357":123086,"_3076":123087},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3624":73620,"_31165":73617,"_5":31520,"_21590":123089,"_28357":123090,"_3076":123091},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3624":73621,"_31165":73617,"_5":31520,"_21590":123093,"_28357":123094,"_3076":123095},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3624":73622,"_31165":73617,"_5":31520,"_21590":123097,"_28357":123098,"_3076":123099},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3624":73623,"_31165":73617,"_5":31520,"_21590":123101,"_28357":123102,"_3076":123103},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3624":73624,"_31165":73617,"_21590":123105,"_5":14857,"_28357":73617,"_3076":123106},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3624":73625,"_31165":73617,"_21590":123108,"_5":14857,"_28357":123086,"_3076":123109},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3624":73626,"_31165":73617,"_21590":123111,"_5":14857,"_28357":123086,"_3076":123112},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3624":73627,"_31165":73617,"_21590":123114,"_5":14857,"_28357":123090,"_3076":123115},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3624":73628,"_31165":73617,"_21590":123117,"_5":14857,"_28357":123090,"_3076":123118},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3624":73629,"_31165":73617,"_21590":123120,"_5":14857,"_28357":123090,"_3076":123121},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3624":73630,"_31165":73617,"_21590":123123,"_5":14857,"_28357":123094,"_3076":123124},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3624":73631,"_31165":73617,"_21590":123126,"_5":14857,"_28357":123094,"_3076":123127},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3624":73632,"_31165":73617,"_21590":123129,"_5":14857,"_28357":123098,"_3076":123130},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3624":73633,"_31165":73617,"_21590":123132,"_5":14857,"_28357":123098,"_3076":123133},[],"Ejemplo de cuerpo:",{"_3624":73634,"_31165":73617,"_21590":123135,"_5":14857,"_28357":123098,"_3076":123136},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3624":73635,"_31165":73617,"_21590":123138,"_5":14857,"_28357":123098,"_3076":123139},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3624":73636,"_31165":73617,"_21590":123141,"_5":14857,"_28357":123098,"_3076":123142},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3624":73637,"_31165":73617,"_21590":123144,"_5":14857,"_28357":123098,"_3076":123145},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3624":73638,"_31165":73617,"_21590":123147,"_5":14857,"_28357":123102,"_3076":123148},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3624":73639,"_31165":73617,"_21590":123150,"_5":14857,"_28357":123102,"_3076":123151},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3624":73640,"_31165":73617,"_21590":123153,"_5":14857,"_28357":123102,"_3076":123154},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3624":73641,"_31165":73617,"_21590":123156,"_5":14857,"_28357":123102,"_3076":123157},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3624":73642,"_31165":73642,"_5":15217,"_3076":123159,"_31523":123160,"_21590":123161,"_28357":73642},"Configura y opera el DMS",[50932,121756,53616,122901,123079],[],{"_3624":73643,"_31165":73642,"_21590":123163,"_5":14857,"_28357":73642,"_3076":123164},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3624":73644,"_31165":73642,"_5":31520,"_21590":123166,"_28357":123167,"_3076":120290},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3624":73645,"_31165":73642,"_5":31520,"_21590":123169,"_28357":123170,"_3076":123171},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3624":73646,"_31165":73642,"_5":31520,"_21590":123173,"_28357":123174,"_3076":123175},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3624":73647,"_31165":73642,"_5":31520,"_21590":123177,"_28357":123178,"_3076":123179},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3624":73648,"_31165":73642,"_5":31520,"_21590":123181,"_28357":123182,"_3076":123183},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3624":73649,"_31165":73642,"_5":31520,"_21590":123185,"_28357":123186,"_3076":123187},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3624":73650,"_31165":73642,"_5":31520,"_21590":123189,"_28357":123190,"_3076":123191},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3624":73651,"_31165":73642,"_5":31520,"_21590":123193,"_28357":123194,"_3076":123195},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3624":73652,"_31165":73642,"_5":31520,"_21590":123197,"_28357":123198,"_3076":53920},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3624":73653,"_31165":73642,"_5":31520,"_21590":123200,"_28357":123201,"_3076":53924},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3624":73654,"_31165":73642,"_5":31520,"_21590":123203,"_28357":123204,"_3076":123205},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3624":73655,"_31165":73642,"_5":31520,"_21590":123207,"_28357":123208,"_3076":123209},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3624":73656,"_31165":73642,"_5":31520,"_21590":123211,"_28357":123212,"_3076":123213},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3624":73657,"_31165":73642,"_5":31520,"_21590":123215,"_28357":123216,"_3076":123217},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3624":73658,"_31165":73642,"_5":31520,"_21590":123219,"_28357":123220,"_3076":53944},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3624":73659,"_31165":73642,"_5":31520,"_21590":123222,"_28357":123223,"_3076":123224},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3624":73660,"_31165":73642,"_5":31520,"_21590":123226,"_28357":123227,"_3076":123228},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3624":73661,"_31165":73642,"_5":31520,"_21590":123230,"_28357":123231,"_3076":123232},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3624":73662,"_31165":73642,"_21590":123234,"_5":14857,"_28357":73642,"_3076":123235},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3624":73663,"_31165":73642,"_21590":123237,"_5":14857,"_28357":123167,"_3076":123238},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3624":73664,"_31165":73642,"_21590":123240,"_5":14857,"_28357":123167,"_3076":123241},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3624":73665,"_31165":73642,"_21590":123243,"_5":14857,"_28357":123174,"_3076":123244},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3624":73666,"_31165":73642,"_21590":123246,"_5":14857,"_28357":123178,"_3076":123247},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3624":73667,"_31165":73642,"_21590":123249,"_5":14857,"_28357":123182,"_3076":123250},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3624":73668,"_31165":73642,"_21590":123252,"_5":14857,"_28357":123186,"_3076":123253},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3624":73669,"_31165":73642,"_21590":123255,"_5":14857,"_28357":123190,"_3076":123256},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3624":73670,"_31165":73642,"_21590":123258,"_5":14857,"_28357":123198,"_3076":123259},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3624":73671,"_31165":73642,"_21590":123261,"_5":14857,"_28357":123198,"_3076":123262},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3624":73672,"_31165":73642,"_21590":123264,"_5":14857,"_28357":123201,"_3076":123265},[],"Campo de `settings.enrollment_settings`",{"_3624":73673,"_31165":73642,"_21590":123267,"_5":14857,"_28357":123201,"_3076":123268},[],"Decisión",{"_3624":73674,"_31165":73642,"_21590":123270,"_5":14857,"_28357":123201,"_3076":53995},[],{"_3624":73675,"_31165":73642,"_21590":123272,"_5":14857,"_28357":123201,"_3076":123273},[],"`EST_RFC7030` para estas operaciones.",{"_3624":73676,"_31165":73642,"_21590":123275,"_5":14857,"_28357":123201,"_3076":54001},[],{"_3624":73677,"_31165":73642,"_21590":123277,"_5":14857,"_28357":123201,"_3076":123278},[],"ID de la CA que firmará.",{"_3624":73678,"_31165":73642,"_21590":123280,"_5":14857,"_28357":123201,"_3076":54007},[],{"_3624":73679,"_31165":73642,"_21590":123282,"_5":14857,"_28357":123201,"_3076":123283},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3624":73680,"_31165":73642,"_21590":123285,"_5":14857,"_28357":123201,"_3076":54013},[],{"_3624":73681,"_31165":73642,"_21590":123287,"_5":14857,"_28357":123201,"_3076":123288},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3624":73682,"_31165":73642,"_21590":123290,"_5":14857,"_28357":123201,"_3076":54019},[],{"_3624":73683,"_31165":73642,"_21590":123292,"_5":14857,"_28357":123201,"_3076":123293},[],"Uno de los cuatro modos de autenticación.",{"_3624":73684,"_31165":73642,"_21590":123295,"_5":14857,"_28357":123201,"_3076":123296},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3624":73685,"_31165":73642,"_21590":123298,"_5":14857,"_28357":123204,"_3076":123299},[],"Los bloques son independientes:",{"_3624":73686,"_31165":73642,"_21590":123301,"_5":14857,"_28357":123204,"_3076":123302},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3624":73687,"_31165":73642,"_21590":123304,"_5":14857,"_28357":123204,"_3076":123305},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3624":73688,"_31165":73642,"_21590":123307,"_5":14857,"_28357":123204,"_3076":54037},[],{"_3624":73689,"_31165":73642,"_21590":123309,"_5":14857,"_28357":123204,"_3076":123310},[],"Control aplicado en la operación configurada",{"_3624":73690,"_31165":73642,"_21590":123312,"_5":14857,"_28357":123204,"_3076":54043},[],{"_3624":73691,"_31165":73642,"_21590":123314,"_5":14857,"_28357":123204,"_3076":123315},[],"Validación del certificado presentado.",{"_3624":73692,"_31165":73642,"_21590":123317,"_5":14857,"_28357":123204,"_3076":54049},[],{"_3624":73693,"_31165":73642,"_21590":123319,"_5":14857,"_28357":123204,"_3076":123320},[],"Autorización del webhook configurado.",{"_3624":73694,"_31165":73642,"_21590":123322,"_5":14857,"_28357":123204,"_3076":54055},[],{"_3624":73695,"_31165":73642,"_21590":123324,"_5":14857,"_28357":123204,"_3076":123325},[],"Validación del certificado y, después, aprobación del webhook.",{"_3624":73696,"_31165":73642,"_21590":123327,"_5":14857,"_28357":123204,"_3076":54061},[],{"_3624":73697,"_31165":73642,"_21590":123329,"_5":14857,"_28357":123204,"_3076":123330},[],"Sin autenticación del solicitante por el DMS.",{"_3624":73698,"_31165":73642,"_21590":123332,"_5":14857,"_28357":123204,"_3076":123333},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3624":73699,"_31165":73642,"_21590":123335,"_5":14857,"_28357":123204,"_3076":123336},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3624":73700,"_31165":73642,"_21590":123338,"_5":14857,"_28357":123204,"_3076":123339},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3624":73701,"_31165":73642,"_21590":123341,"_5":14857,"_28357":123204,"_3076":123342},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3624":73702,"_31165":73642,"_21590":123344,"_5":14857,"_28357":123204,"_3076":123345},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3624":73703,"_31165":73642,"_21590":123347,"_5":14857,"_28357":123208,"_3076":123348},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3624":73704,"_31165":73642,"_21590":123350,"_5":14857,"_28357":123208,"_3076":123351},[],"Campo de `external_webhook_settings`",{"_3624":73705,"_31165":73642,"_21590":123353,"_5":14857,"_28357":123208,"_3076":123268},[],{"_3624":73706,"_31165":73642,"_21590":123355,"_5":14857,"_28357":123208,"_3076":54090},[],{"_3624":73707,"_31165":73642,"_21590":123357,"_5":14857,"_28357":123208,"_3076":123358},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3624":73708,"_31165":73642,"_21590":123360,"_5":14857,"_28357":123208,"_3076":54096},[],{"_3624":73709,"_31165":73642,"_21590":123362,"_5":14857,"_28357":123208,"_3076":123363},[],"`POST` o `PUT`; `POST` por defecto.",{"_3624":73710,"_31165":73642,"_21590":123365,"_5":14857,"_28357":123208,"_3076":54102},[],{"_3624":73711,"_31165":73642,"_21590":123367,"_5":14857,"_28357":123208,"_3076":123368},[],"Etiqueta usada en los logs del servicio.",{"_3624":73712,"_31165":73642,"_21590":123370,"_5":14857,"_28357":123208,"_3076":54108},[],{"_3624":73713,"_31165":73642,"_21590":123372,"_5":14857,"_28357":123208,"_3076":123373},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3624":73714,"_31165":73642,"_21590":123375,"_5":14857,"_28357":123208,"_3076":54114},[],{"_3624":73715,"_31165":73642,"_21590":123377,"_5":14857,"_28357":123208,"_3076":123378},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3624":73716,"_31165":73642,"_21590":123380,"_5":14857,"_28357":123208,"_3076":54120},[],{"_3624":73717,"_31165":73642,"_21590":123382,"_5":14857,"_28357":123208,"_3076":123383},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3624":73718,"_31165":73642,"_21590":123385,"_5":14857,"_28357":123208,"_3076":54126},[],{"_3624":73719,"_31165":73642,"_21590":123387,"_5":14857,"_28357":123208,"_3076":123388},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3624":73720,"_31165":73642,"_21590":123390,"_5":14857,"_28357":123208,"_3076":54132},[],{"_3624":73721,"_31165":73642,"_21590":123392,"_5":14857,"_28357":123208,"_3076":123393},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3624":73722,"_31165":73642,"_21590":123395,"_5":14857,"_28357":123208,"_3076":54138},[],{"_3624":73723,"_31165":73642,"_21590":123397,"_5":14857,"_28357":123208,"_3076":123398},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3624":73724,"_31165":73642,"_21590":123400,"_5":14857,"_28357":123208,"_3076":54144},[],{"_3624":73725,"_31165":73642,"_21590":123402,"_5":14857,"_28357":123208,"_3076":123403},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3624":73726,"_31165":73642,"_21590":123405,"_5":14857,"_28357":123208,"_3076":123406},[],"Reglas de esa configuración:",{"_3624":73727,"_31165":73642,"_21590":123408,"_5":14857,"_28357":123208,"_3076":123409},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3624":73728,"_31165":73642,"_21590":123411,"_5":14857,"_28357":123208,"_3076":123412},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3624":73729,"_31165":73642,"_21590":123414,"_5":14857,"_28357":123208,"_3076":123415},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3624":73730,"_31165":73642,"_21590":123417,"_5":14857,"_28357":123208,"_3076":123418},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3624":73731,"_31165":73642,"_21590":123420,"_5":14857,"_28357":123208,"_3076":123421},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3624":73732,"_31165":73642,"_21590":123423,"_5":14857,"_28357":123208,"_3076":123424},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3624":73733,"_31165":73642,"_21590":123426,"_5":14857,"_28357":123208,"_3076":123427},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3624":73734,"_31165":73642,"_21590":123429,"_5":14857,"_28357":123208,"_3076":123430},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3624":73735,"_31165":73642,"_21590":123432,"_5":14857,"_28357":123208,"_3076":123433},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3624":73736,"_31165":73642,"_21590":123435,"_5":14857,"_28357":123212,"_3076":123436},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3624":73737,"_31165":73642,"_21590":123438,"_5":14857,"_28357":123216,"_3076":123439},[],"Campo de `settings.reenrollment_settings`",{"_3624":73738,"_31165":73642,"_21590":123441,"_5":14857,"_28357":123216,"_3076":123442},[],"Función",{"_3624":73739,"_31165":73642,"_21590":123444,"_5":14857,"_28357":123216,"_3076":54188},[],{"_3624":73740,"_31165":73642,"_21590":123446,"_5":14857,"_28357":123216,"_3076":123447},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3624":73741,"_31165":73642,"_21590":123449,"_5":14857,"_28357":123216,"_3076":54194},[],{"_3624":73742,"_31165":73642,"_21590":123451,"_5":14857,"_28357":123216,"_3076":123452},[],"Umbral operativo preventivo de monitorización.",{"_3624":73743,"_31165":73642,"_21590":123454,"_5":14857,"_28357":123216,"_3076":54200},[],{"_3624":73744,"_31165":73642,"_21590":123456,"_5":14857,"_28357":123216,"_3076":123457},[],"Umbral operativo crítico de monitorización.",{"_3624":73745,"_31165":73642,"_21590":123459,"_5":14857,"_28357":123216,"_3076":54206},[],{"_3624":73746,"_31165":73642,"_21590":123461,"_5":14857,"_28357":123216,"_3076":123462},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3624":73747,"_31165":73642,"_21590":123464,"_5":14857,"_28357":123216,"_3076":54212},[],{"_3624":73748,"_31165":73642,"_21590":123466,"_5":14857,"_28357":123216,"_3076":123467},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3624":73749,"_31165":73642,"_21590":123469,"_5":14857,"_28357":123216,"_3076":54218},[],{"_3624":73750,"_31165":73642,"_21590":123471,"_5":14857,"_28357":123216,"_3076":123472},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3624":73751,"_31165":73642,"_21590":123474,"_5":14857,"_28357":123216,"_3076":123475},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3624":73752,"_31165":73642,"_21590":123477,"_5":14857,"_28357":123220,"_3076":123478},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3624":73753,"_31165":73642,"_21590":123480,"_5":14857,"_28357":123223,"_3076":120654},[],{"_3624":73754,"_31165":73642,"_21590":123482,"_5":14857,"_28357":123223,"_3076":123483},[],"Qué publica",{"_3624":73755,"_31165":73642,"_21590":123485,"_5":14857,"_28357":123223,"_3076":54235},[],{"_3624":73756,"_31165":73642,"_21590":123487,"_5":14857,"_28357":123223,"_3076":123488},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3624":73757,"_31165":73642,"_21590":123490,"_5":14857,"_28357":123223,"_3076":54241},[],{"_3624":73758,"_31165":73642,"_21590":123492,"_5":14857,"_28357":123223,"_3076":123493},[],"Certificado de la CA emisora seleccionada.",{"_3624":73759,"_31165":73642,"_21590":123495,"_5":14857,"_28357":123223,"_3076":54247},[],{"_3624":73760,"_31165":73642,"_21590":123497,"_5":14857,"_28357":123223,"_3076":123498},[],"Certificados de las CAs elegidas explícitamente.",{"_3624":73761,"_31165":73642,"_21590":123500,"_5":14857,"_28357":123223,"_3076":123501},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3624":73762,"_31165":73642,"_21590":123503,"_5":14857,"_28357":123227,"_3076":123504},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3624":73763,"_31165":73642,"_21590":123506,"_5":14857,"_28357":123227,"_3076":123507},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3624":73764,"_31165":73642,"_21590":123509,"_5":14857,"_28357":123227,"_3076":123510},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3624":73765,"_31165":73642,"_21590":123512,"_5":14857,"_28357":123231,"_3076":123513},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3624":73766,"_31165":73766,"_5":15217,"_3076":123515,"_31523":123516,"_21590":123517,"_28357":73766},"Integra el cliente EST",[50932,121756,53616,122901,123079],[],{"_3624":73767,"_31165":73766,"_21590":123519,"_5":14857,"_28357":73766,"_3076":123520},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3624":73768,"_31165":73766,"_5":31520,"_21590":123522,"_28357":123523,"_3076":120290},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3624":73769,"_31165":73766,"_5":31520,"_21590":123525,"_28357":123526,"_3076":123527},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3624":73770,"_31165":73766,"_5":31520,"_21590":123529,"_28357":123530,"_3076":123531},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3624":73771,"_31165":73766,"_5":31520,"_21590":123533,"_28357":123534,"_3076":123535},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3624":73772,"_31165":73766,"_5":31520,"_21590":123537,"_28357":123538,"_3076":123539},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3624":73773,"_31165":73766,"_5":31520,"_21590":123541,"_28357":123542,"_3076":123543},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3624":73774,"_31165":73766,"_21590":123545,"_5":14857,"_28357":73766,"_3076":123546},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3624":73775,"_31165":73766,"_21590":123548,"_5":14857,"_28357":123523,"_3076":123549},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3624":73776,"_31165":73766,"_21590":123551,"_5":14857,"_28357":123523,"_3076":123552},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3624":73777,"_31165":73766,"_21590":123554,"_5":14857,"_28357":123523,"_3076":123555},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3624":73778,"_31165":73766,"_21590":123557,"_5":14857,"_28357":123526,"_3076":123558},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3624":73779,"_31165":73766,"_21590":123560,"_5":14857,"_28357":123526,"_3076":123561},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3624":73780,"_31165":73766,"_21590":123563,"_5":14857,"_28357":123530,"_3076":123564},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3624":73781,"_31165":73766,"_21590":123566,"_5":14857,"_28357":123530,"_3076":123567},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3624":73782,"_31165":73766,"_21590":123569,"_5":14857,"_28357":123534,"_3076":123570},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3624":73783,"_31165":73766,"_21590":123572,"_5":14857,"_28357":123534,"_3076":123573},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3624":73784,"_31165":73766,"_21590":123575,"_5":14857,"_28357":123538,"_3076":123576},[],"Para el caso de una raíz que emite directamente:",{"_3624":73785,"_31165":73766,"_21590":123578,"_5":14857,"_28357":123538,"_3076":123579},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3624":73786,"_31165":73766,"_21590":123581,"_5":14857,"_28357":123538,"_3076":123582},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3624":73787,"_31165":73766,"_21590":123584,"_5":14857,"_28357":123542,"_3076":123585},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3624":73788,"_31165":73788,"_5":15217,"_3076":123587,"_31523":123588,"_21590":123589,"_28357":73788},"Referencia EST",[50932,121756,53616,122901,123079],[],{"_3624":73789,"_31165":73788,"_21590":123591,"_5":14857,"_28357":73788,"_3076":123592},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3624":73790,"_31165":73788,"_5":31520,"_21590":123594,"_28357":123595,"_3076":123596},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3624":73791,"_31165":73788,"_5":31520,"_21590":123598,"_28357":123599,"_3076":23392},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3624":73792,"_31165":73788,"_5":31520,"_21590":123601,"_28357":123602,"_3076":26907},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3624":73793,"_31165":73788,"_5":31520,"_21590":123604,"_28357":123605,"_3076":26914},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3624":73794,"_31165":73788,"_5":31520,"_21590":123607,"_28357":123608,"_3076":26176},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3624":73795,"_31165":73788,"_5":31520,"_21590":123610,"_28357":123611,"_3076":123612},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3624":73796,"_31165":73788,"_5":31520,"_21590":123614,"_28357":123615,"_3076":123616},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3624":73797,"_31165":73788,"_5":31520,"_21590":123618,"_28357":123619,"_3076":123620},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3624":73798,"_31165":73788,"_21590":123622,"_5":14857,"_28357":73788,"_3076":123623},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3624":73799,"_31165":73788,"_21590":123625,"_5":14857,"_28357":123595,"_3076":123626},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3624":73800,"_31165":73788,"_21590":123628,"_5":14857,"_28357":123595,"_3076":121516},[],{"_3624":73801,"_31165":73788,"_21590":123630,"_5":14857,"_28357":123595,"_3076":123631},[],"Método",{"_3624":73802,"_31165":73788,"_21590":123633,"_5":14857,"_28357":123595,"_3076":123634},[],"Autenticación y condición",{"_3624":73803,"_31165":73788,"_21590":123636,"_5":14857,"_28357":123595,"_3076":54390},[],{"_3624":73804,"_31165":73788,"_21590":123638,"_5":14857,"_28357":123595,"_3076":54393},[],{"_3624":73805,"_31165":73788,"_21590":123640,"_5":14857,"_28357":123595,"_3076":123641},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3624":73806,"_31165":73788,"_21590":123643,"_5":14857,"_28357":123595,"_3076":54399},[],{"_3624":73807,"_31165":73788,"_21590":123645,"_5":14857,"_28357":123595,"_3076":54402},[],{"_3624":73808,"_31165":73788,"_21590":123647,"_5":14857,"_28357":123595,"_3076":123648},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3624":73809,"_31165":73788,"_21590":123650,"_5":14857,"_28357":123595,"_3076":54408},[],{"_3624":73810,"_31165":73788,"_21590":123652,"_5":14857,"_28357":123595,"_3076":54402},[],{"_3624":73811,"_31165":73788,"_21590":123654,"_5":14857,"_28357":123595,"_3076":123655},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3624":73812,"_31165":73788,"_21590":123657,"_5":14857,"_28357":123595,"_3076":54416},[],{"_3624":73813,"_31165":73788,"_21590":123659,"_5":14857,"_28357":123595,"_3076":54402},[],{"_3624":73814,"_31165":73788,"_21590":123661,"_5":14857,"_28357":123595,"_3076":123662},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3624":73815,"_31165":73788,"_21590":123664,"_5":14857,"_28357":123595,"_3076":123665},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3624":73816,"_31165":73788,"_21590":123667,"_5":14857,"_28357":123599,"_3076":123668},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3624":73817,"_31165":73788,"_21590":123670,"_5":14857,"_28357":123599,"_3076":123671},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3624":73818,"_31165":73788,"_21590":123673,"_5":14857,"_28357":123602,"_3076":123674},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3624":73819,"_31165":73788,"_21590":123676,"_5":14857,"_28357":123602,"_3076":123677},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3624":73820,"_31165":73788,"_21590":123679,"_5":14857,"_28357":123605,"_3076":123680},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3624":73821,"_31165":73788,"_21590":123682,"_5":14857,"_28357":123605,"_3076":123683},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3624":73822,"_31165":73788,"_21590":123685,"_5":14857,"_28357":123608,"_3076":123686},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3624":73823,"_31165":73788,"_21590":123688,"_5":14857,"_28357":123608,"_3076":123689},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3624":73824,"_31165":73788,"_21590":123691,"_5":14857,"_28357":123611,"_3076":123692},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3624":73825,"_31165":73788,"_21590":123694,"_5":14857,"_28357":123611,"_3076":123695},[],"Parte",{"_3624":73826,"_31165":73788,"_21590":123697,"_5":14857,"_28357":123611,"_3076":123698},[],"Contenido tras decodificar su Base64",{"_3624":73827,"_31165":73788,"_21590":123700,"_5":14857,"_28357":123611,"_3076":54460},[],{"_3624":73828,"_31165":73788,"_21590":123702,"_5":14857,"_28357":123611,"_3076":123703},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3624":73829,"_31165":73788,"_21590":123705,"_5":14857,"_28357":123611,"_3076":54466},[],{"_3624":73830,"_31165":73788,"_21590":123707,"_5":14857,"_28357":123611,"_3076":123708},[],"PKCS#7 DER con el certificado emitido.",{"_3624":73831,"_31165":73788,"_21590":123710,"_5":14857,"_28357":123611,"_3076":123711},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3624":73832,"_31165":73788,"_21590":123713,"_5":14857,"_28357":123615,"_3076":123714},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3624":73833,"_31165":73788,"_21590":123716,"_5":14857,"_28357":123615,"_3076":123717},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3624":73834,"_31165":73788,"_21590":123719,"_5":14857,"_28357":123615,"_3076":123720},[],"Convierte y comprueba el resultado:",{"_3624":73835,"_31165":73788,"_21590":123722,"_5":14857,"_28357":123615,"_3076":123723},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3624":73836,"_31165":73788,"_21590":123725,"_5":14857,"_28357":123619,"_3076":123726},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3624":73837,"_31165":73788,"_21590":123728,"_5":14857,"_28357":123619,"_3076":123729},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3624":73838,"_31165":73838,"_5":15217,"_3076":123079,"_31523":123731,"_21590":123732,"_28357":73838},[50932,121756,53616,122901,123079],[],{"_3624":73839,"_31165":73838,"_21590":123734,"_5":14857,"_28357":73838,"_3076":123735},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3624":73840,"_31165":73838,"_5":31520,"_21590":123737,"_28357":123738,"_3076":123739},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3624":73841,"_31165":73838,"_5":31520,"_21590":123741,"_28357":123742,"_3076":123743},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3624":73842,"_31165":73838,"_5":31520,"_21590":123745,"_28357":123746,"_3076":123747},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3624":73843,"_31165":73838,"_21590":123749,"_5":14857,"_28357":73838,"_3076":123750},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3624":73844,"_31165":73838,"_21590":123752,"_5":14857,"_28357":123738,"_3076":123753},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3624":73845,"_31165":73838,"_21590":123755,"_5":14857,"_28357":123738,"_3076":123756},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3624":73846,"_31165":73838,"_21590":123758,"_5":14857,"_28357":123738,"_3076":123759},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3624":73847,"_31165":73838,"_21590":123761,"_5":14857,"_28357":123738,"_3076":123762},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3624":73848,"_31165":73838,"_21590":123764,"_5":14857,"_28357":123738,"_3076":123765},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3624":73849,"_31165":73838,"_21590":123767,"_5":14857,"_28357":123738,"_3076":123768},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3624":73850,"_31165":73838,"_21590":123770,"_5":14857,"_28357":123742,"_3076":123771},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3624":73851,"_31165":73838,"_21590":123773,"_5":14857,"_28357":123742,"_3076":123774},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":73852,"_31165":73838,"_21590":123776,"_5":14857,"_28357":123742,"_3076":123777},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3624":73853,"_31165":73838,"_21590":123779,"_5":14857,"_28357":123742,"_3076":123780},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3624":73854,"_31165":73838,"_21590":123782,"_5":14857,"_28357":123746,"_3076":123783},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3624":73855,"_31165":73838,"_21590":123785,"_5":14857,"_28357":123746,"_3076":123786},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3624":73856,"_31165":73838,"_21590":123788,"_5":14857,"_28357":123746,"_3076":123789},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3624":73857,"_31165":73838,"_21590":123791,"_5":14857,"_28357":123746,"_3076":123792},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3624":73858,"_31165":73838,"_21590":123794,"_5":14857,"_28357":123746,"_3076":123795},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3624":73859,"_31165":73859,"_5":15217,"_3076":123797,"_31523":123798,"_21590":123799,"_28357":73859},"Estrategias de aprovisionamiento",[50932,121756,53616,122901,123079],[],{"_3624":73860,"_31165":73859,"_21590":123801,"_5":14857,"_28357":73859,"_3076":123802},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3624":73861,"_31165":73859,"_5":31520,"_21590":123804,"_28357":123805,"_3076":123806},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3624":73862,"_31165":73859,"_5":31520,"_21590":123808,"_28357":123809,"_3076":123810},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3624":73863,"_31165":73859,"_5":31520,"_21590":123812,"_28357":123813,"_3076":123814},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3624":73864,"_31165":73859,"_5":31520,"_21590":123816,"_28357":123817,"_3076":123818},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3624":73865,"_31165":73859,"_5":31520,"_21590":123820,"_28357":123821,"_3076":123822},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3624":73866,"_31165":73859,"_21590":123824,"_5":14857,"_28357":73859,"_3076":123825},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3624":73867,"_31165":73859,"_21590":123827,"_5":14857,"_28357":123805,"_3076":123828},[],"Recorrido",{"_3624":73868,"_31165":73859,"_21590":123830,"_5":14857,"_28357":123805,"_3076":123831},[],"Cuándo existe el dispositivo",{"_3624":73869,"_31165":73859,"_21590":123833,"_5":14857,"_28357":123805,"_3076":123834},[],"Qué compruebas",{"_3624":73870,"_31165":73859,"_21590":123836,"_5":14857,"_28357":123805,"_3076":123837},[],"Asignación manual",{"_3624":73871,"_31165":73859,"_21590":123839,"_5":14857,"_28357":123805,"_3076":123840},[],"El operador lo crea antes de asociar un certificado.",{"_3624":73872,"_31165":73859,"_21590":123842,"_5":14857,"_28357":123805,"_3076":123843},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3624":73873,"_31165":73859,"_21590":123845,"_5":14857,"_28357":123805,"_3076":123846},[],"EST con `JITP`",{"_3624":73874,"_31165":73859,"_21590":123848,"_5":14857,"_28357":123805,"_3076":123849},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3624":73875,"_31165":73859,"_21590":123851,"_5":14857,"_28357":123805,"_3076":123852},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3624":73876,"_31165":73859,"_21590":123854,"_5":14857,"_28357":123805,"_3076":123855},[],"EST con `PRE_REGISTRATION`",{"_3624":73877,"_31165":73859,"_21590":123857,"_5":14857,"_28357":123805,"_3076":123858},[],"Debe existir antes de `/simpleenroll`.",{"_3624":73878,"_31165":73859,"_21590":123860,"_5":14857,"_28357":123805,"_3076":123861},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3624":73879,"_31165":73859,"_21590":123863,"_5":14857,"_28357":123805,"_3076":123864},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3624":73880,"_31165":73859,"_21590":123866,"_5":14857,"_28357":123805,"_3076":123867},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3624":73881,"_31165":73859,"_21590":123869,"_5":14857,"_28357":123809,"_3076":123870},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3624":73882,"_31165":73859,"_21590":123872,"_5":14857,"_28357":123809,"_3076":123873},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3624":73883,"_31165":73859,"_21590":123875,"_5":14857,"_28357":123809,"_3076":123876},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3624":73884,"_31165":73859,"_21590":123878,"_5":14857,"_28357":123813,"_3076":123879},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3624":73885,"_31165":73859,"_21590":123881,"_5":14857,"_28357":123813,"_3076":123882},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3624":73886,"_31165":73859,"_21590":123884,"_5":14857,"_28357":123813,"_3076":123885},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3624":73887,"_31165":73859,"_21590":123887,"_5":14857,"_28357":123813,"_3076":123888},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3624":73888,"_31165":73859,"_21590":123890,"_5":14857,"_28357":123813,"_3076":123891},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3624":73889,"_31165":73859,"_21590":123893,"_5":14857,"_28357":123813,"_3076":123894},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3624":73890,"_31165":73859,"_21590":123896,"_5":14857,"_28357":123817,"_3076":120654},[],{"_3624":73891,"_31165":73859,"_21590":123898,"_5":14857,"_28357":123817,"_3076":123899},[],"Material que atraviesa EST",{"_3624":73892,"_31165":73859,"_21590":123901,"_5":14857,"_28357":123817,"_3076":123902},[],"Clave generada por el dispositivo",{"_3624":73893,"_31165":73859,"_21590":123904,"_5":14857,"_28357":123817,"_3076":123905},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3624":73894,"_31165":73859,"_21590":123907,"_5":14857,"_28357":123817,"_3076":123908},[],"Clave ya disponible en el dispositivo",{"_3624":73895,"_31165":73859,"_21590":123910,"_5":14857,"_28357":123817,"_3076":123911},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3624":73896,"_31165":73859,"_21590":123913,"_5":14857,"_28357":123817,"_3076":53944},[],{"_3624":73897,"_31165":73859,"_21590":123915,"_5":14857,"_28357":123817,"_3076":123916},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3624":73898,"_31165":73859,"_21590":123918,"_5":14857,"_28357":123817,"_3076":123919},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3624":73899,"_31165":73859,"_21590":123921,"_5":14857,"_28357":123821,"_3076":123922},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3624":73900,"_31165":73900,"_5":15217,"_3076":123924,"_31523":123925,"_21590":123926,"_28357":73900},"Renovación y recuperación",[50932,121756,53616,122901,123079],[],{"_3624":73901,"_31165":73900,"_21590":123928,"_5":14857,"_28357":73900,"_3076":123929},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3624":73902,"_31165":73900,"_5":31520,"_21590":123931,"_28357":123932,"_3076":123933},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3624":73903,"_31165":73900,"_5":31520,"_21590":123935,"_28357":123936,"_3076":123937},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3624":73904,"_31165":73900,"_5":31520,"_21590":123939,"_28357":123940,"_3076":123941},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3624":73905,"_31165":73900,"_5":31520,"_21590":123943,"_28357":123944,"_3076":123945},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3624":73906,"_31165":73900,"_5":31520,"_21590":123947,"_28357":123948,"_3076":123949},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3624":73907,"_31165":73900,"_21590":123951,"_5":14857,"_28357":73900,"_3076":123952},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3624":73908,"_31165":73900,"_21590":123954,"_5":14857,"_28357":123932,"_3076":123955},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3624":73909,"_31165":73900,"_21590":123957,"_5":14857,"_28357":123932,"_3076":123958},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3624":73910,"_31165":73900,"_21590":123960,"_5":14857,"_28357":123932,"_3076":123961},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3624":73911,"_31165":73900,"_21590":123963,"_5":14857,"_28357":123932,"_3076":123964},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3624":73912,"_31165":73900,"_21590":123966,"_5":14857,"_28357":123936,"_3076":123967},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3624":73913,"_31165":73900,"_21590":123969,"_5":14857,"_28357":123936,"_3076":123970},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3624":73914,"_31165":73900,"_21590":123972,"_5":14857,"_28357":123940,"_3076":123973},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3624":73915,"_31165":73900,"_21590":123975,"_5":14857,"_28357":123940,"_3076":123976},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3624":73916,"_31165":73900,"_21590":123978,"_5":14857,"_28357":123940,"_3076":123979},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3624":73917,"_31165":73900,"_21590":123981,"_5":14857,"_28357":123944,"_3076":123982},[],"Situación",{"_3624":73918,"_31165":73900,"_21590":123984,"_5":14857,"_28357":123944,"_3076":123985},[],"Procedimiento",{"_3624":73919,"_31165":73900,"_21590":123987,"_5":14857,"_28357":123944,"_3076":123988},[],"Certificado vigente, fuera de ventana",{"_3624":73920,"_31165":73900,"_21590":123990,"_5":14857,"_28357":123944,"_3076":123991},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3624":73921,"_31165":73900,"_21590":123993,"_5":14857,"_28357":123944,"_3076":123994},[],"Certificado vencido, clave disponible",{"_3624":73922,"_31165":73900,"_21590":123996,"_5":14857,"_28357":123944,"_3076":123997},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3624":73923,"_31165":73900,"_21590":123999,"_5":14857,"_28357":123944,"_3076":124000},[],"Renovación por webhook o `NO_AUTH`",{"_3624":73924,"_31165":73900,"_21590":124002,"_5":14857,"_28357":123944,"_3076":124003},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3624":73925,"_31165":73900,"_21590":124005,"_5":14857,"_28357":123944,"_3076":124006},[],"Clave perdida o inaccesible",{"_3624":73926,"_31165":73900,"_21590":124008,"_5":14857,"_28357":123944,"_3076":124009},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3624":73927,"_31165":73900,"_21590":124011,"_5":14857,"_28357":123944,"_3076":124012},[],"Identidad actual revocada",{"_3624":73928,"_31165":73900,"_21590":124014,"_5":14857,"_28357":123944,"_3076":124015},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3624":73929,"_31165":73900,"_21590":124017,"_5":14857,"_28357":123944,"_3076":124018},[],"Dispositivo sin identidad",{"_3624":73930,"_31165":73900,"_21590":124020,"_5":14857,"_28357":123944,"_3076":124021},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3624":73931,"_31165":73900,"_21590":124023,"_5":14857,"_28357":123944,"_3076":124024},[],"Dispositivo retirado",{"_3624":73932,"_31165":73900,"_21590":124026,"_5":14857,"_28357":123944,"_3076":124027},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3624":73933,"_31165":73900,"_21590":124029,"_5":14857,"_28357":123944,"_3076":124030},[],"Timeout, HTTP 500 o fallo de instalación",{"_3624":73934,"_31165":73900,"_21590":124032,"_5":14857,"_28357":123944,"_3076":124033},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3624":73935,"_31165":73900,"_21590":124035,"_5":14857,"_28357":123948,"_3076":124036},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3624":73936,"_31165":73900,"_21590":124038,"_5":14857,"_28357":123948,"_3076":124039},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3624":73937,"_31165":73937,"_5":15217,"_3076":124041,"_31523":124042,"_21590":124043,"_28357":73937},"Diagnóstico de enrolamiento",[50932,121756,53616,122901,123079],[],{"_3624":73938,"_31165":73937,"_21590":124045,"_5":14857,"_28357":73937,"_3076":124046},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3624":73939,"_31165":73937,"_5":31520,"_21590":124048,"_28357":124049,"_3076":124050},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3624":73940,"_31165":73937,"_5":31520,"_21590":124052,"_28357":124053,"_3076":124054},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3624":73941,"_31165":73937,"_5":31520,"_21590":124056,"_28357":124057,"_3076":123620},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3624":73942,"_31165":73937,"_5":31520,"_21590":124059,"_28357":124060,"_3076":124061},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3624":73943,"_31165":73937,"_21590":124063,"_5":14857,"_28357":73937,"_3076":124064},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3624":73944,"_31165":73937,"_21590":124066,"_5":14857,"_28357":124053,"_3076":124067},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3624":73945,"_31165":73937,"_21590":124069,"_5":14857,"_28357":124053,"_3076":124070},[],"Síntoma o mensaje",{"_3624":73946,"_31165":73937,"_21590":124072,"_5":14857,"_28357":124053,"_3076":124073},[],"Qué revisar",{"_3624":73947,"_31165":73937,"_21590":124075,"_5":14857,"_28357":124053,"_3076":124076},[],"curl rechaza TLS, nombre o emisor",{"_3624":73948,"_31165":73937,"_21590":124078,"_5":14857,"_28357":124053,"_3076":124079},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3624":73949,"_31165":73937,"_21590":124081,"_5":14857,"_28357":124053,"_3076":124082},[],"404 o APS ausente",{"_3624":73950,"_31165":73937,"_21590":124084,"_5":14857,"_28357":124053,"_3076":124085},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3624":73951,"_31165":73937,"_21590":124087,"_5":14857,"_28357":124053,"_3076":124088},[],"400, error de CSR o formato",{"_3624":73952,"_31165":73937,"_21590":124090,"_5":14857,"_28357":124053,"_3076":124091},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3624":73953,"_31165":73937,"_21590":124093,"_5":14857,"_28357":124053,"_3076":124094},[],"Credencial ausente o certificado no válido",{"_3624":73954,"_31165":73937,"_21590":124096,"_5":14857,"_28357":124053,"_3076":124097},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3624":73955,"_31165":73937,"_21590":124099,"_5":14857,"_28357":124053,"_3076":124100},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3624":73956,"_31165":73937,"_21590":124102,"_5":14857,"_28357":124053,"_3076":124103},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3624":73957,"_31165":73937,"_21590":124105,"_5":14857,"_28357":124053,"_3076":124106},[],"Webhook deniega, expira o responde sin autorización",{"_3624":73958,"_31165":73937,"_21590":124108,"_5":14857,"_28357":124053,"_3076":124109},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3624":73959,"_31165":73937,"_21590":124111,"_5":14857,"_28357":124053,"_3076":54872},[],{"_3624":73960,"_31165":73937,"_21590":124113,"_5":14857,"_28357":124053,"_3076":124114},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3624":73961,"_31165":73937,"_21590":124116,"_5":14857,"_28357":124053,"_3076":54878},[],{"_3624":73962,"_31165":73937,"_21590":124118,"_5":14857,"_28357":124053,"_3076":124119},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3624":73963,"_31165":73937,"_21590":124121,"_5":14857,"_28357":124053,"_3076":54884},[],{"_3624":73964,"_31165":73937,"_21590":124123,"_5":14857,"_28357":124053,"_3076":124124},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3624":73965,"_31165":73937,"_21590":124126,"_5":14857,"_28357":124053,"_3076":54890},[],{"_3624":73966,"_31165":73937,"_21590":124128,"_5":14857,"_28357":124053,"_3076":124129},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3624":73967,"_31165":73937,"_21590":124131,"_5":14857,"_28357":124053,"_3076":54896},[],{"_3624":73968,"_31165":73937,"_21590":124133,"_5":14857,"_28357":124053,"_3076":124134},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3624":73969,"_31165":73937,"_21590":124136,"_5":14857,"_28357":124053,"_3076":124137},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3624":73970,"_31165":73937,"_21590":124139,"_5":14857,"_28357":124053,"_3076":124140},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3624":73971,"_31165":73937,"_21590":124142,"_5":14857,"_28357":124053,"_3076":124143},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3624":73972,"_31165":73937,"_21590":124145,"_5":14857,"_28357":124053,"_3076":124146},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3624":73973,"_31165":73937,"_21590":124148,"_5":14857,"_28357":124053,"_3076":54914},[],{"_3624":73974,"_31165":73937,"_21590":124150,"_5":14857,"_28357":124053,"_3076":124151},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3624":73975,"_31165":73937,"_21590":124153,"_5":14857,"_28357":124053,"_3076":54920},[],{"_3624":73976,"_31165":73937,"_21590":124155,"_5":14857,"_28357":124053,"_3076":124156},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3624":73977,"_31165":73937,"_21590":124158,"_5":14857,"_28357":124053,"_3076":124159},[],"DMS propietario distinto",{"_3624":73978,"_31165":73937,"_21590":124161,"_5":14857,"_28357":124053,"_3076":124162},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3624":73979,"_31165":73937,"_21590":124164,"_5":14857,"_28357":124053,"_3076":54932},[],{"_3624":73980,"_31165":73937,"_21590":124166,"_5":14857,"_28357":124053,"_3076":124167},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3624":73981,"_31165":73937,"_21590":124169,"_5":14857,"_28357":124053,"_3076":54938},[],{"_3624":73982,"_31165":73937,"_21590":124171,"_5":14857,"_28357":124053,"_3076":124172},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3624":73983,"_31165":73937,"_21590":124174,"_5":14857,"_28357":124053,"_3076":124175},[],"Certificado actual revocado",{"_3624":73984,"_31165":73937,"_21590":124177,"_5":14857,"_28357":124053,"_3076":124178},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3624":73985,"_31165":73937,"_21590":124180,"_5":14857,"_28357":124053,"_3076":124181},[],"Error de CA, perfil o firma",{"_3624":73986,"_31165":73937,"_21590":124183,"_5":14857,"_28357":124053,"_3076":124184},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3624":73987,"_31165":73937,"_21590":124186,"_5":14857,"_28357":124053,"_3076":124187},[],"HTTP 200 sin conexión del dispositivo",{"_3624":73988,"_31165":73937,"_21590":124189,"_5":14857,"_28357":124053,"_3076":124190},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3624":73989,"_31165":73937,"_21590":124192,"_5":14857,"_28357":124053,"_3076":124193},[],"Timeout o error después de emitir",{"_3624":73990,"_31165":73937,"_21590":124195,"_5":14857,"_28357":124053,"_3076":124196},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3624":73991,"_31165":73937,"_21590":124198,"_5":14857,"_28357":124057,"_3076":124199},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3624":73992,"_31165":73937,"_21590":124201,"_5":14857,"_28357":124057,"_3076":124202},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3624":73993,"_31165":73937,"_21590":124204,"_5":14857,"_28357":124060,"_3076":124205},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3624":73994,"_31165":73937,"_21590":124207,"_5":14857,"_28357":124060,"_3076":124208},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3624":73995,"_31165":73937,"_21590":124210,"_5":14857,"_28357":124060,"_3076":124211},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3624":73996,"_31165":73937,"_21590":124213,"_5":14857,"_28357":124060,"_3076":124214},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3624":73997,"_31165":73937,"_21590":124216,"_5":14857,"_28357":124060,"_3076":124217},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3624":73998,"_31165":73937,"_21590":124219,"_5":14857,"_28357":124060,"_3076":124220},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3624":73999,"_31165":73937,"_21590":124222,"_5":14857,"_28357":124060,"_3076":124223},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3624":74000,"_31165":74000,"_5":15217,"_3076":124225,"_31523":124226,"_21590":124227,"_28357":74000},"Distribución y actualización de confianza",[50932,121756,53616,122901,123079],[],{"_3624":74001,"_31165":74000,"_21590":124229,"_5":14857,"_28357":74000,"_3076":124230},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3624":74002,"_31165":74000,"_5":31520,"_21590":124232,"_28357":124233,"_3076":124234},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3624":74003,"_31165":74000,"_5":31520,"_21590":124236,"_28357":124237,"_3076":124238},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3624":74004,"_31165":74000,"_5":31520,"_21590":124240,"_28357":124241,"_3076":124242},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3624":74005,"_31165":74000,"_5":31520,"_21590":124244,"_28357":124245,"_3076":124246},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3624":74006,"_31165":74000,"_5":31520,"_21590":124248,"_28357":124249,"_3076":124250},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3624":74007,"_31165":74000,"_21590":124252,"_5":14857,"_28357":74000,"_3076":124253},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3624":74008,"_31165":74000,"_21590":124255,"_5":14857,"_28357":124233,"_3076":124256},[],"Relación",{"_3624":74009,"_31165":74000,"_21590":124258,"_5":14857,"_28357":124233,"_3076":124259},[],"Material que prepara el responsable",{"_3624":74010,"_31165":74000,"_21590":124261,"_5":14857,"_28357":124233,"_3076":124262},[],"Dispositivo → servidor EST",{"_3624":74011,"_31165":74000,"_21590":124264,"_5":14857,"_28357":124233,"_3076":124265},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3624":74012,"_31165":74000,"_21590":124267,"_5":14857,"_28357":124233,"_3076":124268},[],"DMS → solicitante",{"_3624":74013,"_31165":74000,"_21590":124270,"_5":14857,"_28357":124233,"_3076":124271},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3624":74014,"_31165":74000,"_21590":124273,"_5":14857,"_28357":124233,"_3076":124274},[],"Consumidor → dispositivo",{"_3624":74015,"_31165":74000,"_21590":124276,"_5":14857,"_28357":124233,"_3076":124277},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3624":74016,"_31165":74000,"_21590":124279,"_5":14857,"_28357":124233,"_3076":124280},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3624":74017,"_31165":74000,"_21590":124282,"_5":14857,"_28357":124237,"_3076":124283},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3624":74018,"_31165":74000,"_21590":124285,"_5":14857,"_28357":124237,"_3076":124286},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3624":74019,"_31165":74000,"_21590":124288,"_5":14857,"_28357":124241,"_3076":124289},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3624":74020,"_31165":74000,"_21590":124291,"_5":14857,"_28357":124241,"_3076":124292},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3624":74021,"_31165":74000,"_21590":124294,"_5":14857,"_28357":124241,"_3076":124295},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3624":74022,"_31165":74000,"_21590":124297,"_5":14857,"_28357":124241,"_3076":124298},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3624":74023,"_31165":74000,"_21590":124300,"_5":14857,"_28357":124241,"_3076":124301},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3624":74024,"_31165":74000,"_21590":124303,"_5":14857,"_28357":124241,"_3076":124304},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3624":74025,"_31165":74000,"_21590":124306,"_5":14857,"_28357":124245,"_3076":124307},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3624":74026,"_31165":74000,"_21590":124309,"_5":14857,"_28357":124245,"_3076":124310},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3624":74027,"_31165":74000,"_21590":124312,"_5":14857,"_28357":124245,"_3076":124313},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3624":74028,"_31165":74000,"_21590":124315,"_5":14857,"_28357":124249,"_3076":124316},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3624":74029,"_31165":74029,"_5":15217,"_3076":55087,"_31523":124318,"_21590":124320,"_28357":74029},[50932,121756,53616,122901,124319],"Integraciones",[],{"_3624":74030,"_31165":74029,"_21590":124322,"_5":14857,"_28357":74029,"_3076":124323},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3624":74031,"_31165":74029,"_5":31520,"_21590":124325,"_28357":124326,"_3076":124327},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3624":74032,"_31165":74029,"_5":31520,"_21590":124329,"_28357":124330,"_3076":124331},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3624":74033,"_31165":74029,"_5":31520,"_21590":124333,"_28357":124334,"_3076":124335},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3624":74034,"_31165":74029,"_5":31520,"_21590":124337,"_28357":124338,"_3076":124339},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3624":74035,"_31165":74029,"_5":31520,"_21590":124341,"_28357":124342,"_3076":124343},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3624":74036,"_31165":74029,"_5":31520,"_21590":124345,"_28357":124346,"_3076":124347},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3624":74037,"_31165":74029,"_5":31520,"_21590":124349,"_28357":124350,"_3076":124351},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3624":74038,"_31165":74029,"_5":31520,"_21590":124353,"_28357":124354,"_3076":124355},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3624":74039,"_31165":74029,"_5":31520,"_21590":124357,"_28357":124358,"_3076":55129},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3624":74040,"_31165":74029,"_5":31520,"_21590":124360,"_28357":124361,"_3076":55133},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3624":74041,"_31165":74029,"_5":31520,"_21590":124363,"_28357":124364,"_3076":124365},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3624":74042,"_31165":74029,"_5":31520,"_21590":124367,"_28357":124368,"_3076":124369},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3624":74043,"_31165":74029,"_5":31520,"_21590":124371,"_28357":124372,"_3076":124373},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3624":74044,"_31165":74029,"_5":31520,"_21590":124375,"_28357":124376,"_3076":124377},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3624":74045,"_31165":74029,"_5":31520,"_21590":124379,"_28357":124380,"_3076":124381},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3624":74046,"_31165":74029,"_5":31520,"_21590":124383,"_28357":124384,"_3076":124385},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3624":74047,"_31165":74029,"_5":31520,"_21590":124387,"_28357":124388,"_3076":124389},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3624":74048,"_31165":74029,"_5":31520,"_21590":124391,"_28357":124392,"_3076":124393},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3624":74049,"_31165":74029,"_5":31520,"_21590":124395,"_28357":124396,"_3076":124397},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3624":74050,"_31165":74029,"_5":31520,"_21590":124399,"_28357":124400,"_3076":124401},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3624":74051,"_31165":74029,"_5":31520,"_21590":124403,"_28357":124404,"_3076":124405},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3624":74052,"_31165":74029,"_5":31520,"_21590":124407,"_28357":124408,"_3076":124409},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3624":74053,"_31165":74029,"_5":31520,"_21590":124411,"_28357":124412,"_3076":124413},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3624":74054,"_31165":74029,"_5":31520,"_21590":124415,"_28357":124416,"_3076":124417},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3624":74055,"_31165":74029,"_5":31520,"_21590":124419,"_28357":124420,"_3076":124421},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3624":74056,"_31165":74029,"_21590":124423,"_5":14857,"_28357":74029,"_3076":124424},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3624":74057,"_31165":74029,"_21590":124426,"_5":14857,"_28357":74029,"_3076":124427},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3624":74058,"_31165":74029,"_21590":124429,"_5":14857,"_28357":74029,"_3076":124430},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3624":74059,"_31165":74029,"_21590":124432,"_5":14857,"_28357":124326,"_3076":124433},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3624":74060,"_31165":74029,"_21590":124435,"_5":14857,"_28357":124326,"_3076":124436},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3624":74061,"_31165":74029,"_21590":124438,"_5":14857,"_28357":124326,"_3076":124439},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3624":74062,"_31165":74029,"_21590":124441,"_5":14857,"_28357":124326,"_3076":124442},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3624":74063,"_31165":74029,"_21590":124444,"_5":14857,"_28357":124330,"_3076":124445},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3624":74064,"_31165":74029,"_21590":124447,"_5":14857,"_28357":124334,"_3076":124448},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3624":74065,"_31165":74029,"_21590":124450,"_5":14857,"_28357":124334,"_3076":124451},[],"Acción IAM",{"_3624":74066,"_31165":74029,"_21590":124453,"_5":14857,"_28357":124334,"_3076":120660},[],{"_3624":74067,"_31165":74029,"_21590":124455,"_5":14857,"_28357":124334,"_3076":55228},[],{"_3624":74068,"_31165":74029,"_21590":124457,"_5":14857,"_28357":124334,"_3076":124458},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3624":74069,"_31165":74029,"_21590":124460,"_5":14857,"_28357":124334,"_3076":55234},[],{"_3624":74070,"_31165":74029,"_21590":124462,"_5":14857,"_28357":124334,"_3076":124463},[],"Registrar la CA en AWS IoT",{"_3624":74071,"_31165":74029,"_21590":124465,"_5":14857,"_28357":124334,"_3076":55240},[],{"_3624":74072,"_31165":74029,"_21590":124467,"_5":14857,"_28357":124334,"_3076":124468},[],"Consultar el estado del registro de la CA",{"_3624":74073,"_31165":74029,"_21590":124470,"_5":14857,"_28357":124334,"_3076":55246},[],{"_3624":74074,"_31165":74029,"_21590":124472,"_5":14857,"_28357":124334,"_3076":124473},[],"Crear o actualizar Things en IoT Core",{"_3624":74075,"_31165":74029,"_21590":124475,"_5":14857,"_28357":124334,"_3076":55252},[],{"_3624":74076,"_31165":74029,"_21590":124477,"_5":14857,"_28357":124334,"_3076":124478},[],"Aprovisionar Things mediante plantilla",{"_3624":74077,"_31165":74029,"_21590":124480,"_5":14857,"_28357":124334,"_3076":55258},[],{"_3624":74078,"_31165":74029,"_21590":124482,"_5":14857,"_28357":124334,"_3076":124483},[],"Registrar certificados de dispositivo",{"_3624":74079,"_31165":74029,"_21590":124485,"_5":14857,"_28357":124334,"_3076":55264},[],{"_3624":74080,"_31165":74029,"_21590":124487,"_5":14857,"_28357":124334,"_3076":124488},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3624":74081,"_31165":74029,"_21590":124490,"_5":14857,"_28357":124334,"_3076":55270},[],{"_3624":74082,"_31165":74029,"_21590":124492,"_5":14857,"_28357":124334,"_3076":124493},[],"Crear y adjuntar políticas IoT",{"_3624":74083,"_31165":74029,"_21590":124495,"_5":14857,"_28357":124334,"_3076":55276},[],{"_3624":74084,"_31165":74029,"_21590":124497,"_5":14857,"_28357":124334,"_3076":124498},[],"Gestionar grupos de Things",{"_3624":74085,"_31165":74029,"_21590":124500,"_5":14857,"_28357":124334,"_3076":55282},[],{"_3624":74086,"_31165":74029,"_21590":124502,"_5":14857,"_28357":124334,"_3076":124503},[],"Crear plantillas JITP",{"_3624":74087,"_31165":74029,"_21590":124505,"_5":14857,"_28357":124334,"_3076":55288},[],{"_3624":74088,"_31165":74029,"_21590":124507,"_5":14857,"_28357":124334,"_3076":124508},[],"Leer y escribir el Device Shadow",{"_3624":74089,"_31165":74029,"_21590":124510,"_5":14857,"_28357":124334,"_3076":124511},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3624":74090,"_31165":74029,"_21590":124513,"_5":14857,"_28357":124338,"_3076":124514},[],"Parámetro",{"_3624":74091,"_31165":74029,"_21590":124516,"_5":14857,"_28357":124338,"_3076":124517},[],"Tipo",{"_3624":74092,"_31165":74029,"_21590":124519,"_5":14857,"_28357":124338,"_3076":124520},[],"Requerido",{"_3624":74093,"_31165":74029,"_21590":124522,"_5":14857,"_28357":124338,"_3076":124523},[],"Descripción",{"_3624":74094,"_31165":74029,"_21590":124525,"_5":14857,"_28357":124338,"_3076":55309},[],{"_3624":74095,"_31165":74029,"_21590":124527,"_5":14857,"_28357":124338,"_3076":25776},[],{"_3624":74096,"_31165":74029,"_21590":124529,"_5":14857,"_28357":124338,"_3076":124530},[],"Sí",{"_3624":74097,"_31165":74029,"_21590":124532,"_5":14857,"_28357":124338,"_3076":124533},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3624":74098,"_31165":74029,"_21590":124535,"_5":14857,"_28357":124338,"_3076":55320},[],{"_3624":74099,"_31165":74029,"_21590":124537,"_5":14857,"_28357":124338,"_3076":25776},[],{"_3624":74100,"_31165":74029,"_21590":124539,"_5":14857,"_28357":124338,"_3076":124530},[],{"_3624":74101,"_31165":74029,"_21590":124541,"_5":14857,"_28357":124338,"_3076":124542},[],"Región AWS donde opera el conector.",{"_3624":74102,"_31165":74029,"_21590":124544,"_5":14857,"_28357":124338,"_3076":55330},[],{"_3624":74103,"_31165":74029,"_21590":124546,"_5":14857,"_28357":124338,"_3076":25776},[],{"_3624":74104,"_31165":74029,"_21590":124548,"_5":14857,"_28357":124338,"_3076":124530},[],{"_3624":74105,"_31165":74029,"_21590":124550,"_5":14857,"_28357":124338,"_3076":124551},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3624":74106,"_31165":74029,"_21590":124553,"_5":14857,"_28357":124338,"_3076":55340},[],{"_3624":74107,"_31165":74029,"_21590":124555,"_5":14857,"_28357":124338,"_3076":25776},[],{"_3624":74108,"_31165":74029,"_21590":124557,"_5":14857,"_28357":124338,"_3076":124558},[],"Solo con `auth_method=static`",{"_3624":74109,"_31165":74029,"_21590":124560,"_5":14857,"_28357":124338,"_3076":124561},[],"Clave de acceso AWS.",{"_3624":74110,"_31165":74029,"_21590":124563,"_5":14857,"_28357":124338,"_3076":55351},[],{"_3624":74111,"_31165":74029,"_21590":124565,"_5":14857,"_28357":124338,"_3076":25776},[],{"_3624":74112,"_31165":74029,"_21590":124567,"_5":14857,"_28357":124338,"_3076":124558},[],{"_3624":74113,"_31165":74029,"_21590":124569,"_5":14857,"_28357":124338,"_3076":124570},[],"Clave secreta AWS.",{"_3624":74114,"_31165":74029,"_21590":124572,"_5":14857,"_28357":124338,"_3076":55361},[],{"_3624":74115,"_31165":74029,"_21590":124574,"_5":14857,"_28357":124338,"_3076":25776},[],{"_3624":74116,"_31165":74029,"_21590":124576,"_5":14857,"_28357":124338,"_3076":55366},[],{"_3624":74117,"_31165":74029,"_21590":124578,"_5":14857,"_28357":124338,"_3076":124579},[],"Token de sesión (con `auth_method=static`).",{"_3624":74118,"_31165":74029,"_21590":124581,"_5":14857,"_28357":124338,"_3076":55372},[],{"_3624":74119,"_31165":74029,"_21590":124583,"_5":14857,"_28357":124338,"_3076":25776},[],{"_3624":74120,"_31165":74029,"_21590":124585,"_5":14857,"_28357":124338,"_3076":124586},[],"Solo con `auth_method=role`",{"_3624":74121,"_31165":74029,"_21590":124588,"_5":14857,"_28357":124338,"_3076":124589},[],"ARN del rol a asumir.",{"_3624":74122,"_31165":74029,"_21590":124591,"_5":14857,"_28357":124338,"_3076":55383},[],{"_3624":74123,"_31165":74029,"_21590":124593,"_5":14857,"_28357":124338,"_3076":25776},[],{"_3624":74124,"_31165":74029,"_21590":124595,"_5":14857,"_28357":124338,"_3076":55366},[],{"_3624":74125,"_31165":74029,"_21590":124597,"_5":14857,"_28357":124338,"_3076":124598},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3624":74126,"_31165":74029,"_21590":124600,"_5":14857,"_28357":124338,"_3076":55393},[],{"_3624":74127,"_31165":74029,"_21590":124602,"_5":14857,"_28357":124338,"_3076":92859},[],{"_3624":74128,"_31165":74029,"_21590":124604,"_5":14857,"_28357":124338,"_3076":124530},[],{"_3624":74129,"_31165":74029,"_21590":124606,"_5":14857,"_28357":124338,"_3076":124607},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3624":74130,"_31165":74029,"_21590":124609,"_5":14857,"_28357":124338,"_3076":55403},[],{"_3624":74131,"_31165":74029,"_21590":124611,"_5":14857,"_28357":124338,"_3076":25776},[],{"_3624":74132,"_31165":74029,"_21590":124613,"_5":14857,"_28357":124338,"_3076":124530},[],{"_3624":74133,"_31165":74029,"_21590":124615,"_5":14857,"_28357":124338,"_3076":124616},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3624":74134,"_31165":74029,"_21590":124618,"_5":14857,"_28357":124338,"_3076":55413},[],{"_3624":74135,"_31165":74029,"_21590":124620,"_5":14857,"_28357":124338,"_3076":25776},[],{"_3624":74136,"_31165":74029,"_21590":124622,"_5":14857,"_28357":124338,"_3076":124530},[],{"_3624":74137,"_31165":74029,"_21590":124624,"_5":14857,"_28357":124338,"_3076":124625},[],"URL HTTP del Device Manager de Lamassu.",{"_3624":74138,"_31165":74029,"_21590":124627,"_5":14857,"_28357":124338,"_3076":55423},[],{"_3624":74139,"_31165":74029,"_21590":124629,"_5":14857,"_28357":124338,"_3076":25776},[],{"_3624":74140,"_31165":74029,"_21590":124631,"_5":14857,"_28357":124338,"_3076":124530},[],{"_3624":74141,"_31165":74029,"_21590":124633,"_5":14857,"_28357":124338,"_3076":124634},[],"URL HTTP del servicio de CA de Lamassu.",{"_3624":74142,"_31165":74029,"_21590":124636,"_5":14857,"_28357":124342,"_3076":124637},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3624":74143,"_31165":74029,"_21590":124639,"_5":14857,"_28357":124342,"_3076":124640},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3624":74144,"_31165":74029,"_21590":124642,"_5":14857,"_28357":124342,"_3076":124643},[],"Tipo de CloudEvent",{"_3624":74145,"_31165":74029,"_21590":124645,"_5":14857,"_28357":124342,"_3076":124646},[],"Recurso en Lamassu",{"_3624":74146,"_31165":74029,"_21590":124648,"_5":14857,"_28357":124342,"_3076":124649},[],"Recurso AWS",{"_3624":74147,"_31165":74029,"_21590":124651,"_5":14857,"_28357":124342,"_3076":124652},[],"Acciones IAM",{"_3624":74148,"_31165":74029,"_21590":124654,"_5":14857,"_28357":124342,"_3076":124655},[],"Llamadas AWS y efecto",{"_3624":74149,"_31165":74029,"_21590":124657,"_5":14857,"_28357":124342,"_3076":124658},[],"Dónde en esta página",{"_3624":74150,"_31165":74029,"_21590":124660,"_5":14857,"_28357":124342,"_3076":55457},[],{"_3624":74151,"_31165":74029,"_21590":124662,"_5":14857,"_28357":124342,"_3076":55460},[],{"_3624":74152,"_31165":74029,"_21590":124664,"_5":14857,"_28357":124342,"_3076":55463},[],{"_3624":74153,"_31165":74029,"_21590":124666,"_5":14857,"_28357":124342,"_3076":55466},[],{"_3624":74154,"_31165":74029,"_21590":124668,"_5":14857,"_28357":124342,"_3076":124669},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3624":74155,"_31165":74029,"_21590":124671,"_5":14857,"_28357":124342,"_3076":124355},[],{"_3624":74156,"_31165":74029,"_21590":124673,"_5":14857,"_28357":124342,"_3076":55474},[],{"_3624":74157,"_31165":74029,"_21590":124675,"_5":14857,"_28357":124342,"_3076":55477},[],{"_3624":74158,"_31165":74029,"_21590":124677,"_5":14857,"_28357":124342,"_3076":55480},[],{"_3624":74159,"_31165":74029,"_21590":124679,"_5":14857,"_28357":124342,"_3076":55483},[],{"_3624":74160,"_31165":74029,"_21590":124681,"_5":14857,"_28357":124342,"_3076":124682},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3624":74161,"_31165":74029,"_21590":124684,"_5":14857,"_28357":124342,"_3076":124381},[],{"_3624":74162,"_31165":74029,"_21590":124686,"_5":14857,"_28357":124342,"_3076":55491},[],{"_3624":74163,"_31165":74029,"_21590":124688,"_5":14857,"_28357":124342,"_3076":124689},[],"Dispositivo",{"_3624":74164,"_31165":74029,"_21590":124691,"_5":14857,"_28357":124342,"_3076":55497},[],{"_3624":74165,"_31165":74029,"_21590":124693,"_5":14857,"_28357":124342,"_3076":55500},[],{"_3624":74166,"_31165":74029,"_21590":124695,"_5":14857,"_28357":124342,"_3076":124696},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3624":74167,"_31165":74029,"_21590":124698,"_5":14857,"_28357":124342,"_3076":124389},[],{"_3624":74168,"_31165":74029,"_21590":124700,"_5":14857,"_28357":124342,"_3076":55508},[],{"_3624":74169,"_31165":74029,"_21590":124702,"_5":14857,"_28357":124342,"_3076":124703},[],"Certificado",{"_3624":74170,"_31165":74029,"_21590":124705,"_5":14857,"_28357":124342,"_3076":55514},[],{"_3624":74171,"_31165":74029,"_21590":124707,"_5":14857,"_28357":124342,"_3076":124708},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3624":74172,"_31165":74029,"_21590":124710,"_5":14857,"_28357":124342,"_3076":124711},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3624":74173,"_31165":74029,"_21590":124713,"_5":14857,"_28357":124342,"_3076":124401},[],{"_3624":74174,"_31165":74029,"_21590":124715,"_5":14857,"_28357":124342,"_3076":55525},[],{"_3624":74175,"_31165":74029,"_21590":124717,"_5":14857,"_28357":124342,"_3076":124718},[],"Certificado / Dispositivo",{"_3624":74176,"_31165":74029,"_21590":124720,"_5":14857,"_28357":124342,"_3076":55531},[],{"_3624":74177,"_31165":74029,"_21590":124722,"_5":14857,"_28357":124342,"_3076":51328},[],{"_3624":74178,"_31165":74029,"_21590":124724,"_5":14857,"_28357":124342,"_3076":124725},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3624":74179,"_31165":74029,"_21590":124727,"_5":14857,"_28357":124342,"_3076":124409},[],{"_3624":74180,"_31165":74029,"_21590":124729,"_5":14857,"_28357":124346,"_3076":124730},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3624":74181,"_31165":74029,"_21590":124732,"_5":14857,"_28357":124350,"_3076":124733},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3624":74182,"_31165":74029,"_21590":124735,"_5":14857,"_28357":124350,"_3076":124736},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3624":74183,"_31165":74029,"_21590":124738,"_5":14857,"_28357":124354,"_3076":124739},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3624":74184,"_31165":74029,"_21590":124741,"_5":14857,"_28357":124354,"_3076":124742},[],"Transición",{"_3624":74185,"_31165":74029,"_21590":124744,"_5":14857,"_28357":124354,"_3076":124745},[],"Llamadas AWS",{"_3624":74186,"_31165":74029,"_21590":124747,"_5":14857,"_28357":124354,"_3076":124748},[],"`NoRegistrada` → `Solicitada`",{"_3624":74187,"_31165":74029,"_21590":124750,"_5":14857,"_28357":124354,"_3076":124751},[],"ninguna (solo escritura de metadatos)",{"_3624":74188,"_31165":74029,"_21590":124753,"_5":14857,"_28357":124354,"_3076":124754},[],"`Solicitada` → `Registrando`",{"_3624":74189,"_31165":74029,"_21590":124756,"_5":14857,"_28357":124354,"_3076":124757},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3624":74190,"_31165":74029,"_21590":124759,"_5":14857,"_28357":124354,"_3076":124760},[],"`Registrando` → `Completada`",{"_3624":74191,"_31165":74029,"_21590":124762,"_5":14857,"_28357":124354,"_3076":124763},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3624":74192,"_31165":74029,"_21590":124765,"_5":14857,"_28357":124354,"_3076":124766},[],"`Registrando` → `Fallida`",{"_3624":74193,"_31165":74029,"_21590":124768,"_5":14857,"_28357":124354,"_3076":124769},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3624":74194,"_31165":74029,"_21590":124771,"_5":14857,"_28357":124354,"_3076":124772},[],"`Fallida` / `Completada` → `Solicitada`",{"_3624":74195,"_31165":74029,"_21590":124774,"_5":14857,"_28357":124354,"_3076":124775},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3624":74196,"_31165":74029,"_21590":124777,"_5":14857,"_28357":124358,"_3076":124778},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3624":74197,"_31165":74029,"_21590":124780,"_5":14857,"_28357":124358,"_3076":124781},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3624":74198,"_31165":74029,"_21590":124783,"_5":14857,"_28357":124358,"_3076":124784},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3624":74199,"_31165":74029,"_21590":124786,"_5":14857,"_28357":124358,"_3076":124787},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3624":74200,"_31165":74029,"_21590":124789,"_5":14857,"_28357":124358,"_3076":124790},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3624":74201,"_31165":74029,"_21590":124792,"_5":14857,"_28357":124358,"_3076":124793},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3624":74202,"_31165":74029,"_21590":124795,"_5":14857,"_28357":124361,"_3076":124796},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3624":74203,"_31165":74029,"_21590":124798,"_5":14857,"_28357":124364,"_3076":124799},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3624":74204,"_31165":74029,"_21590":124801,"_5":14857,"_28357":124364,"_3076":124802},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3624":74205,"_31165":74029,"_21590":124804,"_5":14857,"_28357":124368,"_3076":124805},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3624":74206,"_31165":74029,"_21590":124807,"_5":14857,"_28357":124372,"_3076":124808},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3624":74207,"_31165":74029,"_21590":124810,"_5":14857,"_28357":124372,"_3076":124811},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3624":74208,"_31165":74029,"_21590":124813,"_5":14857,"_28357":124372,"_3076":124814},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3624":74209,"_31165":74029,"_21590":124816,"_5":14857,"_28357":124372,"_3076":124817},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3624":74210,"_31165":74029,"_21590":124819,"_5":14857,"_28357":124372,"_3076":124820},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3624":74211,"_31165":74029,"_21590":124822,"_5":14857,"_28357":124372,"_3076":124823},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3624":74212,"_31165":74029,"_21590":124825,"_5":14857,"_28357":124376,"_3076":124826},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3624":74213,"_31165":74029,"_21590":124828,"_5":14857,"_28357":124376,"_3076":124829},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3624":74214,"_31165":74029,"_21590":124831,"_5":14857,"_28357":124376,"_3076":124832},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3624":74215,"_31165":74029,"_21590":124834,"_5":14857,"_28357":124376,"_3076":124835},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3624":74216,"_31165":74029,"_21590":124837,"_5":14857,"_28357":124376,"_3076":124838},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3624":74217,"_31165":74029,"_21590":124840,"_5":14857,"_28357":124380,"_3076":124841},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3624":74218,"_31165":74029,"_21590":124843,"_5":14857,"_28357":124380,"_3076":124742},[],{"_3624":74219,"_31165":74029,"_21590":124845,"_5":14857,"_28357":124380,"_3076":124745},[],{"_3624":74220,"_31165":74029,"_21590":124847,"_5":14857,"_28357":124380,"_3076":124848},[],"`SinConfigurar` → `None` / `Auto`",{"_3624":74221,"_31165":74029,"_21590":124850,"_5":14857,"_28357":124380,"_3076":124851},[],"ninguna (solo configuración)",{"_3624":74222,"_31165":74029,"_21590":124853,"_5":14857,"_28357":124380,"_3076":55668},[],{"_3624":74223,"_31165":74029,"_21590":124855,"_5":14857,"_28357":124380,"_3076":124851},[],{"_3624":74224,"_31165":74029,"_21590":124857,"_5":14857,"_28357":124380,"_3076":124858},[],"Cualquiera → `Jitp`",{"_3624":74225,"_31165":74029,"_21590":124860,"_5":14857,"_28357":124380,"_3076":124861},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3624":74226,"_31165":74029,"_21590":124863,"_5":14857,"_28357":124380,"_3076":55679},[],{"_3624":74227,"_31165":74029,"_21590":124865,"_5":14857,"_28357":124380,"_3076":124866},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3624":74228,"_31165":74029,"_21590":124868,"_5":14857,"_28357":124384,"_3076":124869},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3624":74229,"_31165":74029,"_21590":124871,"_5":14857,"_28357":124384,"_3076":124872},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3624":74230,"_31165":74029,"_21590":124874,"_5":14857,"_28357":124384,"_3076":124875},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3624":74231,"_31165":74029,"_21590":124877,"_5":14857,"_28357":124388,"_3076":124878},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3624":74232,"_31165":74029,"_21590":124880,"_5":14857,"_28357":124388,"_3076":124742},[],{"_3624":74233,"_31165":74029,"_21590":124882,"_5":14857,"_28357":124388,"_3076":124745},[],{"_3624":74234,"_31165":74029,"_21590":124884,"_5":14857,"_28357":124388,"_3076":124885},[],"`Ausente` → `Aprovisionado`",{"_3624":74235,"_31165":74029,"_21590":124887,"_5":14857,"_28357":124388,"_3076":124888},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3624":74236,"_31165":74029,"_21590":124890,"_5":14857,"_28357":124388,"_3076":124891},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3624":74237,"_31165":74029,"_21590":124893,"_5":14857,"_28357":124388,"_3076":124894},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3624":74238,"_31165":74029,"_21590":124896,"_5":14857,"_28357":124388,"_3076":124897},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3624":74239,"_31165":74029,"_21590":124899,"_5":14857,"_28357":124392,"_3076":124900},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3624":74240,"_31165":74029,"_21590":124902,"_5":14857,"_28357":124392,"_3076":124903},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3624":74241,"_31165":74029,"_21590":124905,"_5":14857,"_28357":124392,"_3076":124906},[],"Para que el flujo JITP funcione correctamente:",{"_3624":74242,"_31165":74029,"_21590":124908,"_5":14857,"_28357":124392,"_3076":124909},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3624":74243,"_31165":74029,"_21590":124911,"_5":14857,"_28357":124392,"_3076":124912},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3624":74244,"_31165":74029,"_21590":124914,"_5":14857,"_28357":124392,"_3076":124915},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3624":74245,"_31165":74029,"_21590":124917,"_5":14857,"_28357":124392,"_3076":124918},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3624":74246,"_31165":74029,"_21590":124920,"_5":14857,"_28357":124396,"_3076":124921},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3624":74247,"_31165":74029,"_21590":124923,"_5":14857,"_28357":124396,"_3076":124924},[],"Estado en Lamassu",{"_3624":74248,"_31165":74029,"_21590":124926,"_5":14857,"_28357":124396,"_3076":124927},[],"Razón de revocación",{"_3624":74249,"_31165":74029,"_21590":124929,"_5":14857,"_28357":124396,"_3076":124930},[],"Estado en AWS IoT Core",{"_3624":74250,"_31165":74029,"_21590":124932,"_5":14857,"_28357":124396,"_3076":55749},[],{"_3624":74251,"_31165":74029,"_21590":124934,"_5":14857,"_28357":124396,"_3076":124935},[],"Ninguna",{"_3624":74252,"_31165":74029,"_21590":124937,"_5":14857,"_28357":124396,"_3076":55755},[],{"_3624":74253,"_31165":74029,"_21590":124939,"_5":14857,"_28357":124396,"_3076":55758},[],{"_3624":74254,"_31165":74029,"_21590":124941,"_5":14857,"_28357":124396,"_3076":55761},[],{"_3624":74255,"_31165":74029,"_21590":124943,"_5":14857,"_28357":124396,"_3076":55764},[],{"_3624":74256,"_31165":74029,"_21590":124945,"_5":14857,"_28357":124396,"_3076":55758},[],{"_3624":74257,"_31165":74029,"_21590":124947,"_5":14857,"_28357":124396,"_3076":124948},[],"Cualquier otra razón",{"_3624":74258,"_31165":74029,"_21590":124950,"_5":14857,"_28357":124396,"_3076":55772},[],{"_3624":74259,"_31165":74029,"_21590":124952,"_5":14857,"_28357":124396,"_3076":124953},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3624":74260,"_31165":74029,"_21590":124955,"_5":14857,"_28357":124400,"_3076":124956},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3624":74261,"_31165":74029,"_21590":124958,"_5":14857,"_28357":124400,"_3076":124742},[],{"_3624":74262,"_31165":74029,"_21590":124960,"_5":14857,"_28357":124400,"_3076":124745},[],{"_3624":74263,"_31165":74029,"_21590":124962,"_5":14857,"_28357":124400,"_3076":124963},[],"`NoSincronizado` → `Active`",{"_3624":74264,"_31165":74029,"_21590":124965,"_5":14857,"_28357":124400,"_3076":55264},[],{"_3624":74265,"_31165":74029,"_21590":124967,"_5":14857,"_28357":124400,"_3076":55790},[],{"_3624":74266,"_31165":74029,"_21590":124969,"_5":14857,"_28357":124400,"_3076":124970},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3624":74267,"_31165":74029,"_21590":124972,"_5":14857,"_28357":124400,"_3076":55796},[],{"_3624":74268,"_31165":74029,"_21590":124974,"_5":14857,"_28357":124400,"_3076":124970},[],{"_3624":74269,"_31165":74029,"_21590":124976,"_5":14857,"_28357":124400,"_3076":55801},[],{"_3624":74270,"_31165":74029,"_21590":124978,"_5":14857,"_28357":124400,"_3076":55264},[],{"_3624":74271,"_31165":74029,"_21590":124980,"_5":14857,"_28357":124400,"_3076":55806},[],{"_3624":74272,"_31165":74029,"_21590":124982,"_5":14857,"_28357":124400,"_3076":124983},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3624":74273,"_31165":74029,"_21590":124985,"_5":14857,"_28357":124404,"_3076":124986},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3624":74274,"_31165":74029,"_21590":124988,"_5":14857,"_28357":124404,"_3076":124989},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3624":74275,"_31165":74029,"_21590":124991,"_5":14857,"_28357":124404,"_3076":124992},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3624":74276,"_31165":74029,"_21590":124994,"_5":14857,"_28357":124408,"_3076":124995},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3624":74277,"_31165":74029,"_21590":124997,"_5":14857,"_28357":124408,"_3076":124998},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3624":74278,"_31165":74029,"_21590":125000,"_5":14857,"_28357":124412,"_3076":125001},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3624":74279,"_31165":74029,"_21590":125003,"_5":14857,"_28357":124412,"_3076":125004},[],"Existen dos tipos de acciones:",{"_3624":74280,"_31165":74029,"_21590":125006,"_5":14857,"_28357":124412,"_3076":125007},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3624":74281,"_31165":74029,"_21590":125009,"_5":14857,"_28357":124412,"_3076":125010},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3624":74282,"_31165":74029,"_21590":125012,"_5":14857,"_28357":124412,"_3076":125013},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3624":74283,"_31165":74029,"_21590":125015,"_5":14857,"_28357":124416,"_3076":125016},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3624":74284,"_31165":74029,"_21590":125018,"_5":14857,"_28357":124416,"_3076":125019},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3624":74285,"_31165":74029,"_21590":125021,"_5":14857,"_28357":124416,"_3076":125022},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3624":74286,"_31165":74029,"_21590":125024,"_5":14857,"_28357":124420,"_3076":125025},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3624":74287,"_31165":74029,"_21590":125027,"_5":14857,"_28357":124420,"_3076":125028},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3624":74288,"_31165":74029,"_21590":125030,"_5":14857,"_28357":124420,"_3076":125031},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3624":74289,"_31165":74029,"_21590":125033,"_5":14857,"_28357":124420,"_3076":125034},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3624":74290,"_31165":74029,"_21590":125036,"_5":14857,"_28357":124420,"_3076":125037},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3624":74291,"_31165":74029,"_21590":125039,"_5":14857,"_28357":124420,"_3076":125040},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3624":74292,"_31165":74029,"_21590":125042,"_5":14857,"_28357":124420,"_3076":125043},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3624":74293,"_31165":74029,"_21590":125045,"_5":14857,"_28357":124420,"_3076":125046},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3624":74294,"_31165":74029,"_21590":125048,"_5":14857,"_28357":124420,"_3076":125049},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3624":74295,"_31165":74029,"_21590":125051,"_5":14857,"_28357":124420,"_3076":125052},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3624":74296,"_31165":74029,"_21590":125054,"_5":14857,"_28357":124420,"_3076":125055},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3624":74297,"_31165":74029,"_21590":125057,"_5":14857,"_28357":124420,"_3076":125058},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3624":74298,"_31165":74029,"_21590":125060,"_5":14857,"_28357":124420,"_3076":125061},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3624":74299,"_31165":74029,"_21590":125063,"_5":14857,"_28357":124420,"_3076":125064},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3624":74300,"_31165":74029,"_21590":125066,"_5":14857,"_28357":124420,"_3076":125067},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3624":74301,"_31165":74029,"_21590":125069,"_5":14857,"_28357":124420,"_3076":125070},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3624":74302,"_31165":74029,"_21590":125072,"_5":14857,"_28357":124420,"_3076":125073},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3624":74303,"_31165":74029,"_21590":125075,"_5":14857,"_28357":124420,"_3076":125076},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3624":74304,"_31165":74029,"_21590":125078,"_5":14857,"_28357":124420,"_3076":125079},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3624":74305,"_31165":74029,"_21590":125081,"_5":14857,"_28357":124420,"_3076":125082},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3624":74306,"_31165":74029,"_21590":125084,"_5":14857,"_28357":124420,"_3076":125085},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3624":74307,"_31165":74029,"_21590":125087,"_5":14857,"_28357":124420,"_3076":125088},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":74308,"_31165":74029,"_21590":125090,"_5":14857,"_28357":124420,"_3076":125091},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3624":74309,"_31165":74029,"_21590":125093,"_5":14857,"_28357":124420,"_3076":125094},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3624":74310,"_31165":74310,"_5":15217,"_3076":53616,"_31523":125096,"_21590":125097,"_28357":74310},[50932,121756,53616],[],{"_3624":74311,"_31165":74310,"_21590":125099,"_5":14857,"_28357":74310,"_3076":125100},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3624":74312,"_31165":74310,"_5":31520,"_21590":125102,"_28357":125103,"_3076":125104},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3624":74313,"_31165":74310,"_5":31520,"_21590":125106,"_28357":125107,"_3076":122901},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3624":74314,"_31165":74310,"_5":31520,"_21590":125109,"_28357":125110,"_3076":123079},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3624":74315,"_31165":74310,"_5":31520,"_21590":125112,"_28357":125113,"_3076":124319},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/overview#integraciones",{"_3624":74316,"_31165":74310,"_5":31520,"_21590":125115,"_28357":125116,"_3076":125117},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3624":74317,"_31165":74310,"_21590":125119,"_5":14857,"_28357":74310,"_3076":125120},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3624":74318,"_31165":74310,"_21590":125122,"_5":14857,"_28357":125103,"_3076":125123},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3624":74319,"_31165":74310,"_21590":125125,"_5":14857,"_28357":125103,"_3076":125126},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3624":74320,"_31165":74310,"_21590":125128,"_5":14857,"_28357":125107,"_3076":125129},[],"Recurso",{"_3624":74321,"_31165":74310,"_21590":125131,"_5":14857,"_28357":125107,"_3076":125132},[],"Qué representa",{"_3624":74322,"_31165":74310,"_21590":125134,"_5":14857,"_28357":125107,"_3076":125135},[],"**Dispositivo**",{"_3624":74323,"_31165":74310,"_21590":125137,"_5":14857,"_28357":125107,"_3076":125138},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3624":74324,"_31165":74310,"_21590":125140,"_5":14857,"_28357":125107,"_3076":125141},[],"**Identidad**",{"_3624":74325,"_31165":74310,"_21590":125143,"_5":14857,"_28357":125107,"_3076":125144},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3624":74326,"_31165":74310,"_21590":125146,"_5":14857,"_28357":125107,"_3076":55973},[],{"_3624":74327,"_31165":74310,"_21590":125148,"_5":14857,"_28357":125107,"_3076":125149},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3624":74328,"_31165":74310,"_21590":125151,"_5":14857,"_28357":125107,"_3076":125152},[],"**Flota**",{"_3624":74329,"_31165":74310,"_21590":125154,"_5":14857,"_28357":125107,"_3076":125155},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3624":74330,"_31165":74310,"_21590":125157,"_5":14857,"_28357":125107,"_3076":125158},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3624":74331,"_31165":74310,"_21590":125160,"_5":14857,"_28357":125107,"_3076":125161},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3624":74332,"_31165":74310,"_21590":125163,"_5":14857,"_28357":125110,"_3076":125164},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3624":74333,"_31165":74310,"_21590":125166,"_5":14857,"_28357":125110,"_3076":125167},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3624":74334,"_31165":74310,"_21590":125169,"_5":14857,"_28357":125110,"_3076":125170},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3624":74335,"_31165":74310,"_21590":125172,"_5":14857,"_28357":125110,"_3076":125173},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3624":74336,"_31165":74310,"_21590":125175,"_5":14857,"_28357":125110,"_3076":125176},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3624":74337,"_31165":74310,"_21590":125178,"_5":14857,"_28357":125110,"_3076":125179},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3624":74338,"_31165":74310,"_21590":125181,"_5":14857,"_28357":125110,"_3076":125182},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":74339,"_31165":74310,"_21590":125184,"_5":14857,"_28357":125110,"_3076":125185},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3624":74340,"_31165":74310,"_21590":125187,"_5":14857,"_28357":125113,"_3076":125188},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3624":74341,"_31165":74310,"_21590":125190,"_5":14857,"_28357":125113,"_3076":125191},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3624":74342,"_31165":74310,"_21590":125193,"_5":14857,"_28357":125116,"_3076":125194},[],"Participante",{"_3624":74343,"_31165":74310,"_21590":125196,"_5":14857,"_28357":125116,"_3076":125197},[],"Responsabilidad",{"_3624":74344,"_31165":74310,"_21590":125199,"_5":14857,"_28357":125116,"_3076":125200},[],"Administrador PKI",{"_3624":74345,"_31165":74310,"_21590":125202,"_5":14857,"_28357":125116,"_3076":125203},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3624":74346,"_31165":74310,"_21590":125205,"_5":14857,"_28357":125116,"_3076":125206},[],"Administrador del aprovisionamiento",{"_3624":74347,"_31165":74310,"_21590":125208,"_5":14857,"_28357":125116,"_3076":125209},[],"DMS, admisión, autenticación por operación e inventario.",{"_3624":74348,"_31165":74310,"_21590":125211,"_5":14857,"_28357":125116,"_3076":125212},[],"Integrador del dispositivo",{"_3624":74349,"_31165":74310,"_21590":125214,"_5":14857,"_28357":125116,"_3076":125215},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3624":74350,"_31165":74310,"_21590":125217,"_5":14857,"_28357":125116,"_3076":125218},[],"Integrador del consumidor",{"_3624":74351,"_31165":74310,"_21590":125220,"_5":14857,"_28357":125116,"_3076":125221},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3624":74352,"_31165":74310,"_21590":125223,"_5":14857,"_28357":125116,"_3076":125224},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3624":74353,"_31165":74353,"_5":15217,"_3076":125226,"_31523":125227,"_21590":125229,"_28357":74353},"Enrola y conecta tu primer dispositivo",[50932,121756,53616,125228],"Primeros pasos",[],{"_3624":74354,"_31165":74353,"_21590":125231,"_5":14857,"_28357":74353,"_3076":125232},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3624":74355,"_31165":74353,"_5":31520,"_21590":125234,"_28357":125235,"_3076":120290},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3624":74356,"_31165":74353,"_5":31520,"_21590":125237,"_28357":125238,"_3076":125239},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3624":74357,"_31165":74353,"_5":31520,"_21590":125241,"_28357":125242,"_3076":125243},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3624":74358,"_31165":74353,"_5":31520,"_21590":125245,"_28357":125246,"_3076":125247},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3624":74359,"_31165":74353,"_5":31520,"_21590":125249,"_28357":125250,"_3076":125251},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3624":74360,"_31165":74353,"_5":31520,"_21590":125253,"_28357":125254,"_3076":125255},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3624":74361,"_31165":74353,"_5":31520,"_21590":125257,"_28357":125258,"_3076":125259},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3624":74362,"_31165":74353,"_5":31520,"_21590":125261,"_28357":125262,"_3076":125263},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3624":74363,"_31165":74353,"_21590":125265,"_5":14857,"_28357":74353,"_3076":125266},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3624":74364,"_31165":74353,"_21590":125268,"_5":14857,"_28357":125235,"_3076":125269},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3624":74365,"_31165":74353,"_21590":125271,"_5":14857,"_28357":125235,"_3076":125272},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3624":74366,"_31165":74353,"_21590":125274,"_5":14857,"_28357":125235,"_3076":125275},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3624":74367,"_31165":74353,"_21590":125277,"_5":14857,"_28357":125235,"_3076":125278},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3624":74368,"_31165":74353,"_21590":125280,"_5":14857,"_28357":125235,"_3076":125281},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3624":74369,"_31165":74353,"_21590":125283,"_5":14857,"_28357":125238,"_3076":125284},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3624":74370,"_31165":74353,"_21590":125286,"_5":14857,"_28357":125238,"_3076":125287},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3624":74371,"_31165":74353,"_21590":125289,"_5":14857,"_28357":125242,"_3076":125290},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3624":74372,"_31165":74353,"_21590":125292,"_5":14857,"_28357":125242,"_3076":125293},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3624":74373,"_31165":74353,"_21590":125295,"_5":14857,"_28357":125242,"_3076":125296},[],"Ajuste",{"_3624":74374,"_31165":74353,"_21590":125298,"_5":14857,"_28357":125242,"_3076":125299},[],"Valor de evaluación",{"_3624":74375,"_31165":74353,"_21590":125301,"_5":14857,"_28357":125242,"_3076":56129},[],{"_3624":74376,"_31165":74353,"_21590":125303,"_5":14857,"_28357":125242,"_3076":125304},[],"Raíz emisora de `device-root.pem`.",{"_3624":74377,"_31165":74353,"_21590":125306,"_5":14857,"_28357":125242,"_3076":123213},[],{"_3624":74378,"_31165":74353,"_21590":125308,"_5":14857,"_28357":125242,"_3076":125309},[],"Perfil final de 1 hora que acabas de preparar.",{"_3624":74379,"_31165":74353,"_21590":125311,"_5":14857,"_28357":125242,"_3076":56140},[],{"_3624":74380,"_31165":74353,"_21590":125313,"_5":14857,"_28357":125242,"_3076":56143},[],{"_3624":74381,"_31165":74353,"_21590":125315,"_5":14857,"_28357":125242,"_3076":56146},[],{"_3624":74382,"_31165":74353,"_21590":125317,"_5":14857,"_28357":125242,"_3076":125318},[],"Habilitado.",{"_3624":74383,"_31165":74353,"_21590":125320,"_5":14857,"_28357":125242,"_3076":56152},[],{"_3624":74384,"_31165":74353,"_21590":125322,"_5":14857,"_28357":125242,"_3076":125323},[],"Deshabilitado; el ID debe ser nuevo.",{"_3624":74385,"_31165":74353,"_21590":125325,"_5":14857,"_28357":125242,"_3076":125326},[],"Autenticación inicial",{"_3624":74386,"_31165":74353,"_21590":125328,"_5":14857,"_28357":125242,"_3076":125329},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3624":74387,"_31165":74353,"_21590":125331,"_5":14857,"_28357":125242,"_3076":125332},[],"Autenticación de renovación",{"_3624":74388,"_31165":74353,"_21590":125334,"_5":14857,"_28357":125242,"_3076":125335},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3624":74389,"_31165":74353,"_21590":125337,"_5":14857,"_28357":125242,"_3076":56170},[],{"_3624":74390,"_31165":74353,"_21590":125339,"_5":14857,"_28357":125242,"_3076":125340},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3624":74391,"_31165":74353,"_21590":125342,"_5":14857,"_28357":125242,"_3076":56176},[],{"_3624":74392,"_31165":74353,"_21590":125344,"_5":14857,"_28357":125242,"_3076":125345},[],"1 hora.",{"_3624":74393,"_31165":74353,"_21590":125347,"_5":14857,"_28357":125242,"_3076":56182},[],{"_3624":74394,"_31165":74353,"_21590":125349,"_5":14857,"_28357":125242,"_3076":125350},[],"30 minutos / 10 minutos.",{"_3624":74395,"_31165":74353,"_21590":125352,"_5":14857,"_28357":125242,"_3076":56188},[],{"_3624":74396,"_31165":74353,"_21590":125354,"_5":14857,"_28357":125242,"_3076":125355},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3624":74397,"_31165":74353,"_21590":125357,"_5":14857,"_28357":125242,"_3076":53944},[],{"_3624":74398,"_31165":74353,"_21590":125359,"_5":14857,"_28357":125242,"_3076":125360},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3624":74399,"_31165":74353,"_21590":125362,"_5":14857,"_28357":125242,"_3076":56199},[],{"_3624":74400,"_31165":74353,"_21590":125364,"_5":14857,"_28357":125242,"_3076":125365},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3624":74401,"_31165":74353,"_21590":125367,"_5":14857,"_28357":125242,"_3076":125368},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3624":74402,"_31165":74353,"_21590":125370,"_5":14857,"_28357":125246,"_3076":125371},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3624":74403,"_31165":74353,"_21590":125373,"_5":14857,"_28357":125246,"_3076":125374},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3624":74404,"_31165":74353,"_21590":125376,"_5":14857,"_28357":125250,"_3076":125377},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3624":74405,"_31165":74353,"_21590":125379,"_5":14857,"_28357":125250,"_3076":125380},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3624":74406,"_31165":74353,"_21590":125382,"_5":14857,"_28357":125250,"_3076":125383},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3624":74407,"_31165":74353,"_21590":125385,"_5":14857,"_28357":125254,"_3076":125386},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3624":74408,"_31165":74353,"_21590":125388,"_5":14857,"_28357":125254,"_3076":125389},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3624":74409,"_31165":74353,"_21590":125391,"_5":14857,"_28357":125258,"_3076":125392},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3624":74410,"_31165":74353,"_21590":125394,"_5":14857,"_28357":125258,"_3076":125395},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3624":74411,"_31165":74353,"_21590":125397,"_5":14857,"_28357":125258,"_3076":125398},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3624":74412,"_31165":74353,"_21590":125400,"_5":14857,"_28357":125258,"_3076":125401},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3624":74413,"_31165":74353,"_21590":125403,"_5":14857,"_28357":125258,"_3076":125404},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3624":74414,"_31165":74353,"_21590":125406,"_5":14857,"_28357":125262,"_3076":125407},[],"Comprobación",{"_3624":74415,"_31165":74353,"_21590":125409,"_5":14857,"_28357":125262,"_3076":125410},[],"Resultado esperado",{"_3624":74416,"_31165":74353,"_21590":125412,"_5":14857,"_28357":125262,"_3076":125413},[],"Registro",{"_3624":74417,"_31165":74353,"_21590":125415,"_5":14857,"_28357":125262,"_3076":125416},[],"ID creado automáticamente y DMS correcto.",{"_3624":74418,"_31165":74353,"_21590":125418,"_5":14857,"_28357":125262,"_3076":124703},[],{"_3624":74419,"_31165":74353,"_21590":125420,"_5":14857,"_28357":125262,"_3076":125421},[],"CN, perfil, serie y clave verificados.",{"_3624":74420,"_31165":74353,"_21590":125423,"_5":14857,"_28357":125262,"_3076":125424},[],"Inventario",{"_3624":74421,"_31165":74353,"_21590":125426,"_5":14857,"_28357":125262,"_3076":125427},[],"Serie recibida visible como identidad actual y en el historial.",{"_3624":74422,"_31165":74353,"_21590":125429,"_5":14857,"_28357":125262,"_3076":125430},[],"Consumidor",{"_3624":74423,"_31165":74353,"_21590":125432,"_5":14857,"_28357":125262,"_3076":125433},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3624":74424,"_31165":74353,"_21590":125435,"_5":14857,"_28357":125262,"_3076":125436},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3624":74425,"_31165":74353,"_21590":125438,"_5":14857,"_28357":125262,"_3076":125439},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3624":74426,"_31165":74426,"_5":15217,"_3076":122918,"_31523":125441,"_21590":125442,"_28357":74426},[50932,121756,53616,125228],[],{"_3624":74427,"_31165":74426,"_21590":125444,"_5":14857,"_28357":74426,"_3076":125445},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3624":74428,"_31165":74426,"_5":31520,"_21590":125447,"_28357":125448,"_3076":120290},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3624":74429,"_31165":74426,"_5":31520,"_21590":125450,"_28357":125451,"_3076":125452},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3624":74430,"_31165":74426,"_5":31520,"_21590":125454,"_28357":125455,"_3076":125456},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3624":74431,"_31165":74426,"_5":31520,"_21590":125458,"_28357":125459,"_3076":125460},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3624":74432,"_31165":74426,"_5":31520,"_21590":125462,"_28357":125463,"_3076":125464},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3624":74433,"_31165":74426,"_5":31520,"_21590":125466,"_28357":125467,"_3076":125468},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3624":74434,"_31165":74426,"_5":31520,"_21590":125470,"_28357":125471,"_3076":125410},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3624":74435,"_31165":74426,"_5":31520,"_21590":125473,"_28357":125474,"_3076":125475},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3624":74436,"_31165":74426,"_5":31520,"_21590":125477,"_28357":125478,"_3076":125479},[],"/docs/pr-preview/pr-76/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3624":74437,"_31165":74426,"_21590":125481,"_5":14857,"_28357":74426,"_3076":125482},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3624":74438,"_31165":74426,"_21590":125484,"_5":14857,"_28357":74426,"_3076":125485},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3624":74439,"_31165":74426,"_21590":125487,"_5":14857,"_28357":125448,"_3076":125488},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3624":74440,"_31165":74426,"_21590":125490,"_5":14857,"_28357":125448,"_3076":125491},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3624":74441,"_31165":74426,"_21590":125493,"_5":14857,"_28357":125448,"_3076":125494},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3624":74442,"_31165":74426,"_21590":125496,"_5":14857,"_28357":125448,"_3076":125497},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3624":74443,"_31165":74426,"_21590":125499,"_5":14857,"_28357":125451,"_3076":125500},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3624":74444,"_31165":74426,"_21590":125502,"_5":14857,"_28357":125451,"_3076":125503},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3624":74445,"_31165":74426,"_21590":125505,"_5":14857,"_28357":125451,"_3076":125506},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3624":74446,"_31165":74426,"_21590":125508,"_5":14857,"_28357":125451,"_3076":125509},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3624":74447,"_31165":74426,"_21590":125511,"_5":14857,"_28357":125451,"_3076":125512},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3624":74448,"_31165":74426,"_21590":125514,"_5":14857,"_28357":125451,"_3076":125515},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3624":74449,"_31165":74426,"_21590":125517,"_5":14857,"_28357":125451,"_3076":125518},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3624":74450,"_31165":74426,"_21590":125520,"_5":14857,"_28357":125451,"_3076":125521},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3624":74451,"_31165":74426,"_21590":125523,"_5":14857,"_28357":125455,"_3076":125524},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3624":74452,"_31165":74426,"_21590":125526,"_5":14857,"_28357":125455,"_3076":56364},[],{"_3624":74453,"_31165":74426,"_21590":125528,"_5":14857,"_28357":125455,"_3076":125529},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3624":74454,"_31165":74426,"_21590":125531,"_5":14857,"_28357":125455,"_3076":125532},[],"**Icon** y **Tags**: clasificación opcional.",{"_3624":74455,"_31165":74426,"_21590":125534,"_5":14857,"_28357":125455,"_3076":125535},[],"Confirma el registro.",{"_3624":74456,"_31165":74426,"_21590":125537,"_5":14857,"_28357":125459,"_3076":125538},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3624":74457,"_31165":74426,"_21590":125540,"_5":14857,"_28357":125459,"_3076":125541},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3624":74458,"_31165":74426,"_21590":125543,"_5":14857,"_28357":125463,"_3076":125544},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3624":74459,"_31165":74426,"_21590":125546,"_5":14857,"_28357":125463,"_3076":125547},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3624":74460,"_31165":74426,"_21590":125549,"_5":14857,"_28357":125467,"_3076":125550},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3624":74461,"_31165":74426,"_21590":125552,"_5":14857,"_28357":125467,"_3076":125553},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3624":74462,"_31165":74426,"_21590":125555,"_5":14857,"_28357":125471,"_3076":125407},[],{"_3624":74463,"_31165":74426,"_21590":125557,"_5":14857,"_28357":125471,"_3076":125558},[],"Resultado",{"_3624":74464,"_31165":74426,"_21590":125560,"_5":14857,"_28357":125471,"_3076":124689},[],{"_3624":74465,"_31165":74426,"_21590":125562,"_5":14857,"_28357":125471,"_3076":125563},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3624":74466,"_31165":74426,"_21590":125565,"_5":14857,"_28357":125471,"_3076":125566},[],"Identidad actual",{"_3624":74467,"_31165":74426,"_21590":125568,"_5":14857,"_28357":125471,"_3076":125569},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3624":74468,"_31165":74426,"_21590":125571,"_5":14857,"_28357":125471,"_3076":125572},[],"Historial",{"_3624":74469,"_31165":74426,"_21590":125574,"_5":14857,"_28357":125471,"_3076":125575},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3624":74470,"_31165":74426,"_21590":125577,"_5":14857,"_28357":125471,"_3076":125578},[],"Clave y certificado",{"_3624":74471,"_31165":74426,"_21590":125580,"_5":14857,"_28357":125471,"_3076":125581},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3624":74472,"_31165":74426,"_21590":125583,"_5":14857,"_28357":125474,"_3076":125584},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3624":74473,"_31165":74426,"_21590":125586,"_5":14857,"_28357":125474,"_3076":125587},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3624":74474,"_31165":74426,"_21590":125589,"_5":14857,"_28357":125474,"_3076":125590},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3624":74475,"_31165":74426,"_21590":125592,"_5":14857,"_28357":125474,"_3076":125593},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3624":74476,"_31165":74426,"_21590":125595,"_5":14857,"_28357":125478,"_3076":125596},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3624":74477,"_31165":74426,"_21590":125598,"_5":14857,"_28357":125478,"_3076":125599},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3624":74478,"_31165":74426,"_21590":125601,"_5":14857,"_28357":125478,"_3076":125602},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3624":74479,"_31165":74479,"_5":15217,"_3076":125604,"_31523":125605,"_21590":125606,"_28357":74479},"Plataforma Lamassu IoT",[50932,121756],[],{"_3624":74480,"_31165":74479,"_21590":125608,"_5":14857,"_28357":74479,"_3076":125609},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3624":74481,"_31165":74479,"_5":31520,"_21590":125611,"_28357":125612,"_3076":125104},[],"/docs/pr-preview/pr-76/es/platform/overview#empieza-aquí",{"_3624":74482,"_31165":74479,"_5":31520,"_21590":125614,"_28357":125615,"_3076":125616},[],"/docs/pr-preview/pr-76/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3624":74483,"_31165":74479,"_5":31520,"_21590":125618,"_28357":125619,"_3076":125620},[],"/docs/pr-preview/pr-76/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3624":74484,"_31165":74479,"_5":31520,"_21590":125622,"_28357":125623,"_3076":125624},[],"/docs/pr-preview/pr-76/es/platform/overview#capacidades-principales","Capacidades principales",{"_3624":74485,"_31165":74479,"_5":31520,"_21590":125626,"_28357":125627,"_3076":125628},[],"/docs/pr-preview/pr-76/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3624":74486,"_31165":74479,"_5":31520,"_21590":125630,"_28357":125631,"_3076":125632},[],"/docs/pr-preview/pr-76/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3624":74487,"_31165":74479,"_5":31520,"_21590":125634,"_28357":125635,"_3076":125636},[],"/docs/pr-preview/pr-76/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3624":74488,"_31165":74479,"_5":31520,"_21590":125638,"_28357":125639,"_3076":125640},[],"/docs/pr-preview/pr-76/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3624":74489,"_31165":74479,"_5":31520,"_21590":125642,"_28357":125643,"_3076":125644},[],"/docs/pr-preview/pr-76/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3624":74490,"_31165":74479,"_5":31520,"_21590":125646,"_28357":125647,"_3076":125648},[],"/docs/pr-preview/pr-76/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3624":74491,"_31165":74479,"_5":31520,"_21590":125650,"_28357":125651,"_3076":125652},[],"/docs/pr-preview/pr-76/es/platform/overview#referencia-operativa","Referencia operativa",{"_3624":74492,"_31165":74479,"_21590":125654,"_5":14857,"_28357":74479,"_3076":125655},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3624":74493,"_31165":74479,"_21590":125657,"_5":14857,"_28357":125612,"_3076":125658},[],"Elige el resultado que necesitas obtener:",{"_3624":74494,"_31165":74479,"_21590":125660,"_5":14857,"_28357":125612,"_3076":125661},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3624":74495,"_31165":74479,"_21590":125663,"_5":14857,"_28357":125612,"_3076":125664},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3624":74496,"_31165":74479,"_21590":125666,"_5":14857,"_28357":125612,"_3076":125667},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3624":74497,"_31165":74479,"_21590":125669,"_5":14857,"_28357":125615,"_3076":125670},[],"Bloque",{"_3624":74498,"_31165":74479,"_21590":125672,"_5":14857,"_28357":125615,"_3076":125673},[],"Qué gestionas",{"_3624":74499,"_31165":74479,"_21590":125675,"_5":14857,"_28357":125615,"_3076":125676},[],"Punto de entrada",{"_3624":74500,"_31165":74479,"_21590":125678,"_5":14857,"_28357":125615,"_3076":56517},[],{"_3624":74501,"_31165":74479,"_21590":125680,"_5":14857,"_28357":125615,"_3076":125681},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3624":74502,"_31165":74479,"_21590":125683,"_5":14857,"_28357":125615,"_3076":125684},[],"Visión general de PKI",{"_3624":74503,"_31165":74479,"_21590":125686,"_5":14857,"_28357":125615,"_3076":56526},[],{"_3624":74504,"_31165":74479,"_21590":125688,"_5":14857,"_28357":125615,"_3076":125689},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3624":74505,"_31165":74479,"_21590":125691,"_5":14857,"_28357":125615,"_3076":125692},[],"Visión general de IoT Fleets",{"_3624":74506,"_31165":74479,"_21590":125694,"_5":14857,"_28357":125615,"_3076":125695},[],"**Administración**",{"_3624":74507,"_31165":74479,"_21590":125697,"_5":14857,"_28357":125615,"_3076":125698},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3624":74508,"_31165":74479,"_21590":125700,"_5":14857,"_28357":125615,"_3076":121758},[],{"_3624":74509,"_31165":74479,"_21590":125702,"_5":14857,"_28357":125615,"_3076":125703},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3624":74510,"_31165":74479,"_21590":125705,"_5":14857,"_28357":125619,"_3076":125706},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3624":74511,"_31165":74479,"_21590":125708,"_5":14857,"_28357":125619,"_3076":125709},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3624":74512,"_31165":74479,"_21590":125711,"_5":14857,"_28357":125619,"_3076":125712},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3624":74513,"_31165":74479,"_21590":125714,"_5":14857,"_28357":125619,"_3076":125715},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3624":74514,"_31165":74479,"_21590":125717,"_5":14857,"_28357":125619,"_3076":125718},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3624":74515,"_31165":74479,"_21590":125720,"_5":14857,"_28357":125619,"_3076":125721},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3624":74516,"_31165":74479,"_21590":125723,"_5":14857,"_28357":125627,"_3076":125724},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3624":74517,"_31165":74479,"_21590":125726,"_5":14857,"_28357":125631,"_3076":125727},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3624":74518,"_31165":74479,"_21590":125729,"_5":14857,"_28357":125635,"_3076":125730},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3624":74519,"_31165":74479,"_21590":125732,"_5":14857,"_28357":125639,"_3076":125733},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3624":74520,"_31165":74479,"_21590":125735,"_5":14857,"_28357":125643,"_3076":125736},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3624":74521,"_31165":74479,"_21590":125738,"_5":14857,"_28357":125647,"_3076":125739},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3624":74522,"_31165":74479,"_21590":125741,"_5":14857,"_28357":125651,"_3076":125197},[],{"_3624":74523,"_31165":74479,"_21590":125743,"_5":14857,"_28357":125651,"_3076":125744},[],"Qué prepara o comprueba",{"_3624":74524,"_31165":74479,"_21590":125746,"_5":14857,"_28357":125651,"_3076":125200},[],{"_3624":74525,"_31165":74479,"_21590":125748,"_5":14857,"_28357":125651,"_3076":125749},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3624":74526,"_31165":74479,"_21590":125751,"_5":14857,"_28357":125651,"_3076":125752},[],"Administrador de la flota",{"_3624":74527,"_31165":74479,"_21590":125754,"_5":14857,"_28357":125651,"_3076":125755},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3624":74528,"_31165":74479,"_21590":125757,"_5":14857,"_28357":125651,"_3076":125212},[],{"_3624":74529,"_31165":74479,"_21590":125759,"_5":14857,"_28357":125651,"_3076":125760},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3624":74530,"_31165":74479,"_21590":125762,"_5":14857,"_28357":125651,"_3076":125218},[],{"_3624":74531,"_31165":74479,"_21590":125764,"_5":14857,"_28357":125651,"_3076":125765},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3624":74532,"_31165":74479,"_21590":125767,"_5":14857,"_28357":125651,"_3076":125768},[],"Operador de infraestructura",{"_3624":74533,"_31165":74479,"_21590":125770,"_5":14857,"_28357":125651,"_3076":125771},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3624":74534,"_31165":74479,"_21590":125773,"_5":14857,"_28357":125651,"_3076":125774},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3624":74535,"_31165":74535,"_5":15217,"_3076":125776,"_31523":125777,"_21590":125779,"_28357":74535},"Jerarquía y rotación de CAs",[50932,121756,56618,125778],"Claves, autoridades y certificados",[],{"_3624":74536,"_31165":74535,"_21590":125781,"_5":14857,"_28357":74535,"_3076":125782},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3624":74537,"_31165":74535,"_5":31520,"_21590":125784,"_28357":125785,"_3076":125786},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3624":74538,"_31165":74535,"_5":31520,"_21590":125788,"_28357":125789,"_3076":125790},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3624":74539,"_31165":74535,"_5":31520,"_21590":125792,"_28357":125793,"_3076":125794},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3624":74540,"_31165":74535,"_5":31520,"_21590":125796,"_28357":125797,"_3076":125798},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3624":74541,"_31165":74535,"_5":31520,"_21590":125800,"_28357":125801,"_3076":125802},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3624":74542,"_31165":74535,"_5":31520,"_21590":125804,"_28357":125805,"_3076":125806},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3624":74543,"_31165":74535,"_5":31520,"_21590":125808,"_28357":125809,"_3076":125810},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3624":74544,"_31165":74535,"_5":31520,"_21590":125812,"_28357":125813,"_3076":125814},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3624":74545,"_31165":74535,"_5":31520,"_21590":125816,"_28357":125817,"_3076":125818},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3624":74546,"_31165":74535,"_5":31520,"_21590":125820,"_28357":125821,"_3076":125822},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3624":74547,"_31165":74535,"_5":31520,"_21590":125824,"_28357":125825,"_3076":125826},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3624":74548,"_31165":74535,"_5":31520,"_21590":125828,"_28357":125829,"_3076":125830},[],"/docs/pr-preview/pr-76/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3624":74549,"_31165":74535,"_21590":125832,"_5":14857,"_28357":74535,"_3076":125833},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3624":74550,"_31165":74535,"_21590":125835,"_5":14857,"_28357":74535,"_3076":125836},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3624":74551,"_31165":74535,"_21590":125838,"_5":14857,"_28357":125785,"_3076":125839},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3624":74552,"_31165":74535,"_21590":125841,"_5":14857,"_28357":125785,"_3076":125842},[],"entorno, como producción y preproducción;",{"_3624":74553,"_31165":74535,"_21590":125844,"_5":14857,"_28357":125785,"_3076":125845},[],"propietario o equipo operador;",{"_3624":74554,"_31165":74535,"_21590":125847,"_5":14857,"_28357":125785,"_3076":125848},[],"familia de dispositivos o proceso de fabricación;",{"_3624":74555,"_31165":74535,"_21590":125850,"_5":14857,"_28357":125785,"_3076":125851},[],"región o requisito regulatorio;",{"_3624":74556,"_31165":74535,"_21590":125853,"_5":14857,"_28357":125785,"_3076":125854},[],"motor criptográfico o política de clave;",{"_3624":74557,"_31165":74535,"_21590":125856,"_5":14857,"_28357":125785,"_3076":125857},[],"ventana de mantenimiento y ritmo de renovación.",{"_3624":74558,"_31165":74535,"_21590":125859,"_5":14857,"_28357":125785,"_3076":125860},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3624":74559,"_31165":74535,"_21590":125862,"_5":14857,"_28357":125785,"_3076":125863},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3624":74560,"_31165":74535,"_21590":125865,"_5":14857,"_28357":125789,"_3076":125866},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3624":74561,"_31165":74535,"_21590":125868,"_5":14857,"_28357":125789,"_3076":125869},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3624":74562,"_31165":74535,"_21590":125871,"_5":14857,"_28357":125789,"_3076":125872},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3624":74563,"_31165":74535,"_21590":125874,"_5":14857,"_28357":125789,"_3076":125875},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3624":74564,"_31165":74535,"_21590":125877,"_5":14857,"_28357":125793,"_3076":125878},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3624":74565,"_31165":74535,"_21590":125880,"_5":14857,"_28357":125793,"_3076":125881},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3624":74566,"_31165":74535,"_21590":125883,"_5":14857,"_28357":125793,"_3076":125884},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3624":74567,"_31165":74535,"_21590":125886,"_5":14857,"_28357":125793,"_3076":125887},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3624":74568,"_31165":74535,"_21590":125889,"_5":14857,"_28357":125801,"_3076":125890},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3624":74569,"_31165":74535,"_21590":125892,"_5":14857,"_28357":125805,"_3076":125893},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3624":74570,"_31165":74535,"_21590":125895,"_5":14857,"_28357":125809,"_3076":125896},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3624":74571,"_31165":74535,"_21590":125898,"_5":14857,"_28357":125813,"_3076":125899},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3624":74572,"_31165":74535,"_21590":125901,"_5":14857,"_28357":125817,"_3076":125902},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3624":74573,"_31165":74535,"_21590":125904,"_5":14857,"_28357":125821,"_3076":125905},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3624":74574,"_31165":74535,"_21590":125907,"_5":14857,"_28357":125825,"_3076":125908},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3624":74575,"_31165":74535,"_21590":125910,"_5":14857,"_28357":125825,"_3076":125911},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3624":74576,"_31165":74535,"_21590":125913,"_5":14857,"_28357":125825,"_3076":125914},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3624":74577,"_31165":74535,"_21590":125916,"_5":14857,"_28357":125825,"_3076":125917},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3624":74578,"_31165":74535,"_21590":125919,"_5":14857,"_28357":125829,"_3076":125920},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3624":74579,"_31165":74535,"_21590":125922,"_5":14857,"_28357":125829,"_3076":125923},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3624":74580,"_31165":74535,"_21590":125925,"_5":14857,"_28357":125829,"_3076":125926},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3624":74581,"_31165":74535,"_21590":125928,"_5":14857,"_28357":125829,"_3076":125929},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3624":74582,"_31165":74535,"_21590":125931,"_5":14857,"_28357":125829,"_3076":125932},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3624":74583,"_31165":74535,"_21590":125934,"_5":14857,"_28357":125829,"_3076":125935},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3624":74584,"_31165":74535,"_21590":125937,"_5":14857,"_28357":125829,"_3076":125938},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3624":74585,"_31165":74585,"_5":15217,"_3076":125940,"_31523":125941,"_21590":125942,"_28357":74585},"Autoridades de certificación",[50932,121756,56618,125778],[],{"_3624":74586,"_31165":74585,"_21590":125944,"_5":14857,"_28357":74585,"_3076":125945},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3624":74587,"_31165":74585,"_5":31520,"_21590":125947,"_28357":125948,"_3076":125949},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3624":74588,"_31165":74585,"_5":31520,"_21590":125951,"_28357":125952,"_3076":125953},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3624":74589,"_31165":74585,"_5":31520,"_21590":125955,"_28357":125956,"_3076":120290},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3624":74590,"_31165":74585,"_5":31520,"_21590":125958,"_28357":125959,"_3076":125960},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3624":74591,"_31165":74585,"_5":31520,"_21590":125962,"_28357":125963,"_3076":125964},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3624":74592,"_31165":74585,"_5":31520,"_21590":125966,"_28357":125967,"_3076":125968},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3624":74593,"_31165":74585,"_5":31520,"_21590":125970,"_28357":125971,"_3076":125972},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3624":74594,"_31165":74585,"_5":31520,"_21590":125974,"_28357":125975,"_3076":125976},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3624":74595,"_31165":74585,"_5":31520,"_21590":125978,"_28357":125979,"_3076":125980},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3624":74596,"_31165":74585,"_5":31520,"_21590":125982,"_28357":125983,"_3076":125984},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3624":74597,"_31165":74585,"_5":31520,"_21590":125986,"_28357":125987,"_3076":125988},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3624":74598,"_31165":74585,"_5":31520,"_21590":125990,"_28357":125991,"_3076":125992},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3624":74599,"_31165":74585,"_5":31520,"_21590":125994,"_28357":125995,"_3076":125996},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3624":74600,"_31165":74585,"_5":31520,"_21590":125998,"_28357":125999,"_3076":126000},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3624":74601,"_31165":74585,"_5":31520,"_21590":126002,"_28357":126003,"_3076":126004},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3624":74602,"_31165":74585,"_5":31520,"_21590":126006,"_28357":126007,"_3076":126008},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3624":74603,"_31165":74585,"_5":31520,"_21590":126010,"_28357":126011,"_3076":126012},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3624":74604,"_31165":74585,"_5":31520,"_21590":126014,"_28357":126015,"_3076":126016},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3624":74605,"_31165":74585,"_5":31520,"_21590":126018,"_28357":126019,"_3076":126020},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3624":74606,"_31165":74585,"_5":31520,"_21590":126022,"_28357":126023,"_3076":126024},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3624":74607,"_31165":74585,"_5":31520,"_21590":126026,"_28357":126027,"_3076":126028},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3624":74608,"_31165":74585,"_5":31520,"_21590":126030,"_28357":126031,"_3076":126032},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3624":74609,"_31165":74585,"_5":31520,"_21590":126034,"_28357":126035,"_3076":126036},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3624":74610,"_31165":74585,"_21590":126038,"_5":14857,"_28357":74585,"_3076":126039},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3624":74611,"_31165":74585,"_21590":126041,"_5":14857,"_28357":74585,"_3076":126042},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3624":74612,"_31165":74585,"_21590":126044,"_5":14857,"_28357":74585,"_3076":126045},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3624":74613,"_31165":74585,"_21590":126047,"_5":14857,"_28357":125948,"_3076":126048},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3624":74614,"_31165":74585,"_21590":126050,"_5":14857,"_28357":125948,"_3076":126051},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3624":74615,"_31165":74585,"_21590":126053,"_5":14857,"_28357":125948,"_3076":126054},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3624":74616,"_31165":74585,"_21590":126056,"_5":14857,"_28357":125948,"_3076":126057},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3624":74617,"_31165":74585,"_21590":126059,"_5":14857,"_28357":125948,"_3076":126060},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3624":74618,"_31165":74585,"_21590":126062,"_5":14857,"_28357":125956,"_3076":126063},[],"Decide si la CA será raíz o intermedia.",{"_3624":74619,"_31165":74585,"_21590":126065,"_5":14857,"_28357":125956,"_3076":126066},[],"Elige el motor que custodiará la clave.",{"_3624":74620,"_31165":74585,"_21590":126068,"_5":14857,"_28357":125956,"_3076":126069},[],"Define una validez superior a la de los certificados que emitirá.",{"_3624":74621,"_31165":74585,"_21590":126071,"_5":14857,"_28357":125956,"_3076":126072},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3624":74622,"_31165":74585,"_21590":126074,"_5":14857,"_28357":125959,"_3076":126075},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3624":74623,"_31165":74585,"_21590":126077,"_5":14857,"_28357":125963,"_3076":126078},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3624":74624,"_31165":74585,"_21590":126080,"_5":14857,"_28357":125963,"_3076":126081},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3624":74625,"_31165":74585,"_21590":126083,"_5":14857,"_28357":125967,"_3076":126084},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3624":74626,"_31165":74585,"_21590":126086,"_5":14857,"_28357":125971,"_3076":126087},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3624":74627,"_31165":74585,"_21590":126089,"_5":14857,"_28357":125971,"_3076":126090},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3624":74628,"_31165":74585,"_21590":126092,"_5":14857,"_28357":125971,"_3076":126093},[],"`ST`: estado o provincia.",{"_3624":74629,"_31165":74585,"_21590":126095,"_5":14857,"_28357":125971,"_3076":126096},[],"`L`: localidad.",{"_3624":74630,"_31165":74585,"_21590":126098,"_5":14857,"_28357":125971,"_3076":126099},[],"`O`: organización.",{"_3624":74631,"_31165":74585,"_21590":126101,"_5":14857,"_28357":125971,"_3076":126102},[],"`OU`: unidad organizativa.",{"_3624":74632,"_31165":74585,"_21590":126104,"_5":14857,"_28357":125971,"_3076":126105},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3624":74633,"_31165":74585,"_21590":126107,"_5":14857,"_28357":125975,"_3076":126108},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3624":74634,"_31165":74585,"_21590":126110,"_5":14857,"_28357":125975,"_3076":126111},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3624":74635,"_31165":74585,"_21590":126113,"_5":14857,"_28357":125979,"_3076":126114},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3624":74636,"_31165":74585,"_21590":126116,"_5":14857,"_28357":125979,"_3076":126117},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3624":74637,"_31165":74585,"_21590":126119,"_5":14857,"_28357":125983,"_3076":126120},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3624":74638,"_31165":74585,"_21590":126122,"_5":14857,"_28357":125983,"_3076":126123},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3624":74639,"_31165":74585,"_21590":126125,"_5":14857,"_28357":125987,"_3076":126126},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3624":74640,"_31165":74585,"_21590":126128,"_5":14857,"_28357":125987,"_3076":126129},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3624":74641,"_31165":74585,"_21590":126131,"_5":14857,"_28357":125987,"_3076":126132},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3624":74642,"_31165":74585,"_21590":126134,"_5":14857,"_28357":125991,"_3076":126135},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3624":74643,"_31165":74585,"_21590":126137,"_5":14857,"_28357":125995,"_3076":126138},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3624":74644,"_31165":74585,"_21590":126140,"_5":14857,"_28357":125995,"_3076":126141},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3624":74645,"_31165":74585,"_21590":126143,"_5":14857,"_28357":125999,"_3076":126144},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3624":74646,"_31165":74585,"_21590":126146,"_5":14857,"_28357":126003,"_3076":126147},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3624":74647,"_31165":74585,"_21590":126149,"_5":14857,"_28357":126003,"_3076":126150},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3624":74648,"_31165":74585,"_21590":126152,"_5":14857,"_28357":126003,"_3076":126153},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3624":74649,"_31165":74585,"_21590":126155,"_5":14857,"_28357":126007,"_3076":126156},[],"Abre una CA desde el inventario para consultar:",{"_3624":74650,"_31165":74585,"_21590":126158,"_5":14857,"_28357":126007,"_3076":126159},[],"Estado y periodo de validez.",{"_3624":74651,"_31165":74585,"_21590":126161,"_5":14857,"_28357":126007,"_3076":126162},[],"Certificado y cadena en formato PEM.",{"_3624":74652,"_31165":74585,"_21590":126164,"_5":14857,"_28357":126007,"_3076":126165},[],"Número de certificados activos, expirados y revocados.",{"_3624":74653,"_31165":74585,"_21590":126167,"_5":14857,"_28357":126007,"_3076":126168},[],"Certificados emitidos en **Issued Certificates**.",{"_3624":74654,"_31165":74585,"_21590":126170,"_5":14857,"_28357":126007,"_3076":126171},[],"CRL vinculada a la autoridad.",{"_3624":74655,"_31165":74585,"_21590":126173,"_5":14857,"_28357":126007,"_3076":126174},[],"Metadatos y motor criptográfico asociado.",{"_3624":74656,"_31165":74585,"_21590":126176,"_5":14857,"_28357":126007,"_3076":126177},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3624":74657,"_31165":74585,"_21590":126179,"_5":14857,"_28357":126011,"_3076":126180},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3624":74658,"_31165":74585,"_21590":126182,"_5":14857,"_28357":126011,"_3076":126183},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3624":74659,"_31165":74585,"_21590":126185,"_5":14857,"_28357":126011,"_3076":126186},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3624":74660,"_31165":74585,"_21590":126188,"_5":14857,"_28357":126011,"_3076":126189},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3624":74661,"_31165":74585,"_21590":126191,"_5":14857,"_28357":126011,"_3076":126192},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3624":74662,"_31165":74585,"_21590":126194,"_5":14857,"_28357":126011,"_3076":126195},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3624":74663,"_31165":74585,"_21590":126197,"_5":14857,"_28357":126015,"_3076":126198},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3624":74664,"_31165":74585,"_21590":126200,"_5":14857,"_28357":126019,"_3076":126201},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3624":74665,"_31165":74585,"_21590":126203,"_5":14857,"_28357":126023,"_3076":126204},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3624":74666,"_31165":74585,"_21590":126206,"_5":14857,"_28357":126027,"_3076":126207},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3624":74667,"_31165":74585,"_21590":126209,"_5":14857,"_28357":126031,"_3076":126210},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3624":74668,"_31165":74585,"_21590":126212,"_5":14857,"_28357":126035,"_3076":126213},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3624":74669,"_31165":74585,"_21590":126215,"_5":14857,"_28357":126035,"_3076":126216},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3624":74670,"_31165":74585,"_21590":126218,"_5":14857,"_28357":126035,"_3076":126219},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3624":74671,"_31165":74585,"_21590":126221,"_5":14857,"_28357":126035,"_3076":126222},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3624":74672,"_31165":74672,"_5":15217,"_3076":126224,"_31523":126225,"_21590":126226,"_28357":74672},"Perfiles de certificado",[50932,121756,56618,125778],[],{"_3624":74673,"_31165":74672,"_21590":126228,"_5":14857,"_28357":74672,"_3076":126229},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3624":74674,"_31165":74672,"_5":31520,"_21590":126231,"_28357":126232,"_3076":126233},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3624":74675,"_31165":74672,"_5":31520,"_21590":126235,"_28357":126236,"_3076":126237},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#validez","Validez",{"_3624":74676,"_31165":74672,"_5":31520,"_21590":126239,"_28357":126240,"_3076":126241},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3624":74677,"_31165":74672,"_5":31520,"_21590":126243,"_28357":126244,"_3076":126245},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3624":74678,"_31165":74672,"_5":31520,"_21590":126247,"_28357":126248,"_3076":126249},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3624":74679,"_31165":74672,"_5":31520,"_21590":126251,"_28357":126252,"_3076":126253},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3624":74680,"_31165":74672,"_5":31520,"_21590":126255,"_28357":126256,"_3076":126257},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3624":74681,"_31165":74672,"_5":31520,"_21590":126259,"_28357":126260,"_3076":126261},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3624":74682,"_31165":74672,"_5":31520,"_21590":126263,"_28357":126264,"_3076":126265},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3624":74683,"_31165":74672,"_5":31520,"_21590":126267,"_28357":126268,"_3076":126269},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3624":74684,"_31165":74672,"_5":31520,"_21590":126271,"_28357":126272,"_3076":126273},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3624":74685,"_31165":74672,"_5":31520,"_21590":126275,"_28357":126276,"_3076":126277},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3624":74686,"_31165":74672,"_5":31520,"_21590":126279,"_28357":126280,"_3076":126281},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3624":74687,"_31165":74672,"_5":31520,"_21590":126283,"_28357":126284,"_3076":126285},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3624":74688,"_31165":74672,"_5":31520,"_21590":126287,"_28357":126288,"_3076":126289},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3624":74689,"_31165":74672,"_5":31520,"_21590":126291,"_28357":126292,"_3076":126293},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3624":74690,"_31165":74672,"_21590":126295,"_5":14857,"_28357":74672,"_3076":126296},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3624":74691,"_31165":74672,"_21590":126298,"_5":14857,"_28357":74672,"_3076":126299},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3624":74692,"_31165":74672,"_21590":126301,"_5":14857,"_28357":126236,"_3076":126302},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3624":74693,"_31165":74672,"_21590":126304,"_5":14857,"_28357":126236,"_3076":126305},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3624":74694,"_31165":74672,"_21590":126307,"_5":14857,"_28357":126240,"_3076":126308},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3624":74695,"_31165":74672,"_21590":126310,"_5":14857,"_28357":126244,"_3076":126311},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3624":74696,"_31165":74672,"_21590":126313,"_5":14857,"_28357":126244,"_3076":126314},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3624":74697,"_31165":74672,"_21590":126316,"_5":14857,"_28357":126244,"_3076":126317},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3624":74698,"_31165":74672,"_21590":126319,"_5":14857,"_28357":126248,"_3076":126320},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3624":74699,"_31165":74672,"_21590":126322,"_5":14857,"_28357":126252,"_3076":126323},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3624":74700,"_31165":74672,"_21590":126325,"_5":14857,"_28357":126252,"_3076":126326},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3624":74701,"_31165":74672,"_21590":126328,"_5":14857,"_28357":126256,"_3076":126329},[],"La aplicación criptográfica puede:",{"_3624":74702,"_31165":74672,"_21590":126331,"_5":14857,"_28357":126256,"_3076":126332},[],"permitir o bloquear claves RSA;",{"_3624":74703,"_31165":74672,"_21590":126334,"_5":14857,"_28357":126256,"_3076":126335},[],"limitar los tamaños RSA admitidos;",{"_3624":74704,"_31165":74672,"_21590":126337,"_5":14857,"_28357":126256,"_3076":126338},[],"permitir o bloquear claves ECDSA;",{"_3624":74705,"_31165":74672,"_21590":126340,"_5":14857,"_28357":126256,"_3076":126341},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3624":74706,"_31165":74672,"_21590":126343,"_5":14857,"_28357":126256,"_3076":126344},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3624":74707,"_31165":74672,"_21590":126346,"_5":14857,"_28357":126260,"_3076":126347},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3624":74708,"_31165":74672,"_21590":126349,"_5":14857,"_28357":126260,"_3076":121516},[],{"_3624":74709,"_31165":74672,"_21590":126351,"_5":14857,"_28357":126260,"_3076":126352},[],"Primera opción",{"_3624":74710,"_31165":74672,"_21590":126354,"_5":14857,"_28357":126260,"_3076":126355},[],"Segunda opción",{"_3624":74711,"_31165":74672,"_21590":126357,"_5":14857,"_28357":126260,"_3076":126358},[],"Si no hay ninguna",{"_3624":74712,"_31165":74672,"_21590":126360,"_5":14857,"_28357":126260,"_3076":126361},[],"Firma directa con una CA",{"_3624":74713,"_31165":74672,"_21590":126363,"_5":14857,"_28357":126260,"_3076":126364},[],"`issuance_profile` incluido en la solicitud",{"_3624":74714,"_31165":74672,"_21590":126366,"_5":14857,"_28357":126260,"_3076":126367},[],"`issuance_profile_id` de la solicitud",{"_3624":74715,"_31165":74672,"_21590":126369,"_5":14857,"_28357":126260,"_3076":126370},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3624":74716,"_31165":74672,"_21590":126372,"_5":14857,"_28357":126260,"_3076":126373},[],"Emisión mediante DMS",{"_3624":74717,"_31165":74672,"_21590":126375,"_5":14857,"_28357":126260,"_3076":57217},[],{"_3624":74718,"_31165":74672,"_21590":126377,"_5":14857,"_28357":126260,"_3076":126378},[],"`settings.issuance_profile` incluido en el DMS",{"_3624":74719,"_31165":74672,"_21590":126380,"_5":14857,"_28357":126260,"_3076":126381},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3624":74720,"_31165":74672,"_21590":126383,"_5":14857,"_28357":126260,"_3076":126384},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3624":74721,"_31165":74672,"_21590":126386,"_5":14857,"_28357":126260,"_3076":126387},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3624":74722,"_31165":74672,"_21590":126389,"_5":14857,"_28357":126268,"_3076":126390},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3624":74723,"_31165":74672,"_21590":126392,"_5":14857,"_28357":126272,"_3076":126393},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3624":74724,"_31165":74672,"_21590":126395,"_5":14857,"_28357":126276,"_3076":126396},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3624":74725,"_31165":74672,"_21590":126398,"_5":14857,"_28357":126280,"_3076":126399},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3624":74726,"_31165":74672,"_21590":126401,"_5":14857,"_28357":126284,"_3076":126402},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3624":74727,"_31165":74672,"_21590":126404,"_5":14857,"_28357":126284,"_3076":126405},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3624":74728,"_31165":74672,"_21590":126407,"_5":14857,"_28357":126288,"_3076":126408},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3624":74729,"_31165":74672,"_21590":126410,"_5":14857,"_28357":126288,"_3076":126411},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3624":74730,"_31165":74672,"_21590":126413,"_5":14857,"_28357":126288,"_3076":126414},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3624":74731,"_31165":74672,"_21590":126416,"_5":14857,"_28357":126288,"_3076":126417},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3624":74732,"_31165":74672,"_21590":126419,"_5":14857,"_28357":126292,"_3076":126420},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3624":74733,"_31165":74672,"_21590":126422,"_5":14857,"_28357":126292,"_3076":126423},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3624":74734,"_31165":74734,"_5":15217,"_3076":126425,"_31523":126426,"_21590":126428,"_28357":74734},"Validación de certificados",[50932,121756,56618,126427],"Validación",[],{"_3624":74735,"_31165":74734,"_21590":126430,"_5":14857,"_28357":74734,"_3076":126431},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3624":74736,"_31165":74734,"_5":31520,"_21590":126433,"_28357":126434,"_3076":126435},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3624":74737,"_31165":74734,"_5":31520,"_21590":126437,"_28357":126438,"_3076":126439},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3624":74738,"_31165":74734,"_5":31520,"_21590":126441,"_28357":126442,"_3076":126443},[],"/docs/pr-preview/pr-76/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3624":74739,"_31165":74734,"_21590":126445,"_5":14857,"_28357":74734,"_3076":126446},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3624":74740,"_31165":74734,"_21590":126448,"_5":14857,"_28357":126434,"_3076":126449},[],"Verifica estos criterios juntos:",{"_3624":74741,"_31165":74734,"_21590":126451,"_5":14857,"_28357":126434,"_3076":125407},[],{"_3624":74742,"_31165":74734,"_21590":126453,"_5":14857,"_28357":126434,"_3076":126454},[],"Resultado necesario",{"_3624":74743,"_31165":74734,"_21590":126456,"_5":14857,"_28357":126434,"_3076":126457},[],"Cadena y firma",{"_3624":74744,"_31165":74734,"_21590":126459,"_5":14857,"_28357":126434,"_3076":126460},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3624":74745,"_31165":74734,"_21590":126462,"_5":14857,"_28357":126434,"_3076":126463},[],"Fechas",{"_3624":74746,"_31165":74734,"_21590":126465,"_5":14857,"_28357":126434,"_3076":126466},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3624":74747,"_31165":74734,"_21590":126468,"_5":14857,"_28357":126434,"_3076":121426},[],{"_3624":74748,"_31165":74734,"_21590":126470,"_5":14857,"_28357":126434,"_3076":126471},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3624":74749,"_31165":74734,"_21590":126473,"_5":14857,"_28357":126434,"_3076":126474},[],"Uso",{"_3624":74750,"_31165":74734,"_21590":126476,"_5":14857,"_28357":126434,"_3076":126477},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3624":74751,"_31165":74734,"_21590":126479,"_5":14857,"_28357":126434,"_3076":126480},[],"Revocación",{"_3624":74752,"_31165":74734,"_21590":126482,"_5":14857,"_28357":126434,"_3076":126483},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3624":74753,"_31165":74734,"_21590":126485,"_5":14857,"_28357":126434,"_3076":126486},[],"Autorización",{"_3624":74754,"_31165":74734,"_21590":126488,"_5":14857,"_28357":126434,"_3076":126489},[],"La aplicación permite la acción a esa identidad.",{"_3624":74755,"_31165":74734,"_21590":126491,"_5":14857,"_28357":126434,"_3076":126492},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3624":74756,"_31165":74734,"_21590":126494,"_5":14857,"_28357":126438,"_3076":126495},[],"Mecanismo",{"_3624":74757,"_31165":74734,"_21590":126497,"_5":14857,"_28357":126438,"_3076":126498},[],"Cuándo utilizarlo",{"_3624":74758,"_31165":74734,"_21590":126500,"_5":14857,"_28357":126438,"_3076":126501},[],"Qué debes mantener",{"_3624":74759,"_31165":74734,"_21590":126503,"_5":14857,"_28357":126438,"_3076":57345},[],{"_3624":74760,"_31165":74734,"_21590":126505,"_5":14857,"_28357":126438,"_3076":126506},[],"Consulta del estado de un certificado concreto.",{"_3624":74761,"_31165":74734,"_21590":126508,"_5":14857,"_28357":126438,"_3076":126509},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3624":74762,"_31165":74734,"_21590":126511,"_5":14857,"_28357":126438,"_3076":57354},[],{"_3624":74763,"_31165":74734,"_21590":126513,"_5":14857,"_28357":126438,"_3076":126514},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3624":74764,"_31165":74734,"_21590":126516,"_5":14857,"_28357":126438,"_3076":126517},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3624":74765,"_31165":74734,"_21590":126519,"_5":14857,"_28357":126438,"_3076":126520},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3624":74766,"_31165":74734,"_21590":126522,"_5":14857,"_28357":126438,"_3076":126523},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3624":74767,"_31165":74734,"_21590":126525,"_5":14857,"_28357":126442,"_3076":126526},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3624":74768,"_31165":74734,"_21590":126528,"_5":14857,"_28357":126442,"_3076":126529},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3624":74769,"_31165":74734,"_21590":126531,"_5":14857,"_28357":126442,"_3076":126532},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3624":74770,"_31165":74734,"_21590":126534,"_5":14857,"_28357":126442,"_3076":126535},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3624":74771,"_31165":74734,"_21590":126537,"_5":14857,"_28357":126442,"_3076":126538},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3624":74772,"_31165":74734,"_21590":126540,"_5":14857,"_28357":126442,"_3076":126541},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3624":74773,"_31165":74734,"_21590":126543,"_5":14857,"_28357":126442,"_3076":126544},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3624":74774,"_31165":74734,"_21590":126546,"_5":14857,"_28357":126442,"_3076":126547},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":74775,"_31165":74734,"_21590":126549,"_5":14857,"_28357":126442,"_3076":126550},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3624":74776,"_31165":74776,"_5":15217,"_3076":126552,"_31523":126553,"_21590":126554,"_28357":74776},"Certificados",[50932,121756,56618,125778],[],{"_3624":74777,"_31165":74776,"_21590":126556,"_5":14857,"_28357":74776,"_3076":126557},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3624":74778,"_31165":74776,"_5":31520,"_21590":126559,"_28357":126560,"_3076":126561},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3624":74779,"_31165":74776,"_5":31520,"_21590":126563,"_28357":126564,"_3076":126565},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3624":74780,"_31165":74776,"_5":31520,"_21590":126567,"_28357":126568,"_3076":126569},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3624":74781,"_31165":74776,"_5":31520,"_21590":126571,"_28357":126572,"_3076":126573},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3624":74782,"_31165":74776,"_5":31520,"_21590":126575,"_28357":126576,"_3076":126577},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3624":74783,"_31165":74776,"_5":31520,"_21590":126579,"_28357":126580,"_3076":126581},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3624":74784,"_31165":74776,"_5":31520,"_21590":126583,"_28357":126584,"_3076":126585},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3624":74785,"_31165":74776,"_5":31520,"_21590":126587,"_28357":126588,"_3076":126589},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3624":74786,"_31165":74776,"_5":31520,"_21590":126591,"_28357":126592,"_3076":126593},[],"/docs/pr-preview/pr-76/es/platform/pki/certificates#continúa","Continúa",{"_3624":74787,"_31165":74776,"_21590":126595,"_5":14857,"_28357":74776,"_3076":126596},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3624":74788,"_31165":74776,"_21590":126598,"_5":14857,"_28357":126560,"_3076":126599},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3624":74789,"_31165":74776,"_21590":126601,"_5":14857,"_28357":126560,"_3076":126602},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3624":74790,"_31165":74776,"_21590":126604,"_5":14857,"_28357":126560,"_3076":126605},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3624":74791,"_31165":74776,"_21590":126607,"_5":14857,"_28357":126560,"_3076":126608},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3624":74792,"_31165":74776,"_21590":126610,"_5":14857,"_28357":126560,"_3076":126611},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3624":74793,"_31165":74776,"_21590":126613,"_5":14857,"_28357":126560,"_3076":126614},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3624":74794,"_31165":74776,"_21590":126616,"_5":14857,"_28357":126560,"_3076":126617},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3624":74795,"_31165":74776,"_21590":126619,"_5":14857,"_28357":126564,"_3076":126620},[],"Descarga el PEM e inspecciónalo:",{"_3624":74796,"_31165":74776,"_21590":126622,"_5":14857,"_28357":126564,"_3076":126623},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3624":74797,"_31165":74776,"_21590":126625,"_5":14857,"_28357":126568,"_3076":126626},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3624":74798,"_31165":74776,"_21590":126628,"_5":14857,"_28357":126568,"_3076":126629},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3624":74799,"_31165":74776,"_21590":126631,"_5":14857,"_28357":126568,"_3076":126632},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3624":74800,"_31165":74776,"_21590":126634,"_5":14857,"_28357":126568,"_3076":126635},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3624":74801,"_31165":74776,"_21590":126637,"_5":14857,"_28357":126568,"_3076":126638},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3624":74802,"_31165":74776,"_21590":126640,"_5":14857,"_28357":126568,"_3076":126641},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3624":74803,"_31165":74776,"_21590":126643,"_5":14857,"_28357":126568,"_3076":126644},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3624":74804,"_31165":74776,"_21590":126646,"_5":14857,"_28357":126572,"_3076":126647},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3624":74805,"_31165":74776,"_21590":126649,"_5":14857,"_28357":126576,"_3076":126650},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3624":74806,"_31165":74776,"_21590":126652,"_5":14857,"_28357":126580,"_3076":126653},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3624":74807,"_31165":74776,"_21590":126655,"_5":14857,"_28357":126584,"_3076":126656},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3624":74808,"_31165":74776,"_21590":126658,"_5":14857,"_28357":126584,"_3076":126659},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3624":74809,"_31165":74776,"_21590":126661,"_5":14857,"_28357":126584,"_3076":126662},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3624":74810,"_31165":74776,"_21590":126664,"_5":14857,"_28357":126588,"_3076":126665},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3624":74811,"_31165":74776,"_21590":126667,"_5":14857,"_28357":126588,"_3076":126668},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3624":74812,"_31165":74776,"_21590":126670,"_5":14857,"_28357":126588,"_3076":126671},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3624":74813,"_31165":74776,"_21590":126673,"_5":14857,"_28357":126592,"_3076":126674},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":74814,"_31165":74776,"_21590":126676,"_5":14857,"_28357":126592,"_3076":126677},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3624":74815,"_31165":74815,"_5":15217,"_3076":126679,"_31523":126680,"_21590":126682,"_28357":74815},"Ciclo de vida de un certificado",[50932,121756,56618,126681],"Conceptos",[],{"_3624":74816,"_31165":74815,"_21590":126684,"_5":14857,"_28357":74815,"_3076":126685},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3624":74817,"_31165":74815,"_5":31520,"_21590":126687,"_28357":126688,"_3076":126689},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3624":74818,"_31165":74815,"_5":31520,"_21590":126691,"_28357":126692,"_3076":126693},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3624":74819,"_31165":74815,"_5":31520,"_21590":126695,"_28357":126696,"_3076":126697},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3624":74820,"_31165":74815,"_5":31520,"_21590":126699,"_28357":126700,"_3076":126701},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3624":74821,"_31165":74815,"_5":31520,"_21590":126703,"_28357":126704,"_3076":126705},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3624":74822,"_31165":74815,"_5":31520,"_21590":126707,"_28357":126708,"_3076":126709},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3624":74823,"_31165":74815,"_5":31520,"_21590":126711,"_28357":126712,"_3076":124401},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3624":74824,"_31165":74815,"_5":31520,"_21590":126714,"_28357":126715,"_3076":126716},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3624":74825,"_31165":74815,"_5":31520,"_21590":126718,"_28357":126719,"_3076":126720},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3624":74826,"_31165":74815,"_5":31520,"_21590":126722,"_28357":126723,"_3076":126724},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3624":74827,"_31165":74815,"_21590":126726,"_5":14857,"_28357":74815,"_3076":126727},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3624":74828,"_31165":74815,"_21590":126729,"_5":14857,"_28357":126692,"_3076":126730},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3624":74829,"_31165":74815,"_21590":126732,"_5":14857,"_28357":126696,"_3076":126733},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3624":74830,"_31165":74815,"_21590":126735,"_5":14857,"_28357":126700,"_3076":126736},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3624":74831,"_31165":74815,"_21590":126738,"_5":14857,"_28357":126704,"_3076":126739},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3624":74832,"_31165":74815,"_21590":126741,"_5":14857,"_28357":126708,"_3076":126742},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3624":74833,"_31165":74815,"_21590":126744,"_5":14857,"_28357":126712,"_3076":126745},[],"Lamassu persiste cuatro estados X.509:",{"_3624":74834,"_31165":74815,"_21590":126747,"_5":14857,"_28357":126712,"_3076":126748},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3624":74835,"_31165":74815,"_21590":126750,"_5":14857,"_28357":126712,"_3076":126751},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3624":74836,"_31165":74815,"_21590":126753,"_5":14857,"_28357":126712,"_3076":126754},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3624":74837,"_31165":74815,"_21590":126756,"_5":14857,"_28357":126712,"_3076":126757},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3624":74838,"_31165":74815,"_21590":126759,"_5":14857,"_28357":126712,"_3076":126760},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3624":74839,"_31165":74815,"_21590":126762,"_5":14857,"_28357":126715,"_3076":126763},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3624":74840,"_31165":74815,"_21590":126765,"_5":14857,"_28357":126715,"_3076":126766},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3624":74841,"_31165":74815,"_21590":126768,"_5":14857,"_28357":126715,"_3076":126769},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3624":74842,"_31165":74815,"_21590":126771,"_5":14857,"_28357":126719,"_3076":126772},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3624":74843,"_31165":74815,"_21590":126774,"_5":14857,"_28357":126719,"_3076":126775},[],"Antes de confirmar:",{"_3624":74844,"_31165":74815,"_21590":126777,"_5":14857,"_28357":126719,"_3076":126778},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3624":74845,"_31165":74815,"_21590":126780,"_5":14857,"_28357":126719,"_3076":126781},[],"Distribuye la nueva cadena de confianza.",{"_3624":74846,"_31165":74815,"_21590":126783,"_5":14857,"_28357":126719,"_3076":126784},[],"Reemite las identidades necesarias.",{"_3624":74847,"_31165":74815,"_21590":126786,"_5":14857,"_28357":126719,"_3076":126787},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3624":74848,"_31165":74815,"_21590":126789,"_5":14857,"_28357":126719,"_3076":126790},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3624":74849,"_31165":74815,"_21590":126792,"_5":14857,"_28357":126719,"_3076":126793},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3624":74850,"_31165":74815,"_21590":126795,"_5":14857,"_28357":126723,"_3076":126796},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3624":74851,"_31165":74815,"_21590":126798,"_5":14857,"_28357":126723,"_3076":126799},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3624":74852,"_31165":74815,"_21590":126801,"_5":14857,"_28357":126723,"_3076":126802},[],"Cambios de estado y razones de revocación.",{"_3624":74853,"_31165":74815,"_21590":126804,"_5":14857,"_28357":126723,"_3076":126805},[],"Publicación y vigencia de OCSP y CRLs.",{"_3624":74854,"_31165":74815,"_21590":126807,"_5":14857,"_28357":126723,"_3076":126808},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3624":74855,"_31165":74815,"_21590":126810,"_5":14857,"_28357":126723,"_3076":126811},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3624":74856,"_31165":74856,"_5":15217,"_3076":126813,"_31523":126814,"_21590":126815,"_28357":74856},"Modelo de confianza",[50932,121756,56618,126681],[],{"_3624":74857,"_31165":74856,"_21590":126817,"_5":14857,"_28357":74856,"_3076":126818},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3624":74858,"_31165":74856,"_5":31520,"_21590":126820,"_28357":126821,"_3076":126822},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3624":74859,"_31165":74856,"_5":31520,"_21590":126824,"_28357":126825,"_3076":126826},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3624":74860,"_31165":74856,"_5":31520,"_21590":126828,"_28357":126829,"_3076":126830},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3624":74861,"_31165":74856,"_5":31520,"_21590":126832,"_28357":126833,"_3076":126834},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3624":74862,"_31165":74856,"_5":31520,"_21590":126836,"_28357":126837,"_3076":126838},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3624":74863,"_31165":74856,"_5":31520,"_21590":126840,"_28357":126841,"_3076":126842},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3624":74864,"_31165":74856,"_5":31520,"_21590":126844,"_28357":126845,"_3076":126846},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3624":74865,"_31165":74856,"_5":31520,"_21590":126848,"_28357":126849,"_3076":126850},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3624":74866,"_31165":74856,"_5":31520,"_21590":126852,"_28357":126853,"_3076":126854},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3624":74867,"_31165":74856,"_5":31520,"_21590":126856,"_28357":126857,"_3076":126858},[],"/docs/pr-preview/pr-76/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3624":74868,"_31165":74856,"_21590":126860,"_5":14857,"_28357":74856,"_3076":126861},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3624":74869,"_31165":74856,"_21590":126863,"_5":14857,"_28357":126825,"_3076":126864},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3624":74870,"_31165":74856,"_21590":126866,"_5":14857,"_28357":126829,"_3076":126867},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3624":74871,"_31165":74856,"_21590":126869,"_5":14857,"_28357":126833,"_3076":126870},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3624":74872,"_31165":74856,"_21590":126872,"_5":14857,"_28357":126837,"_3076":126873},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3624":74873,"_31165":74856,"_21590":126875,"_5":14857,"_28357":126841,"_3076":126876},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3624":74874,"_31165":74856,"_21590":126878,"_5":14857,"_28357":126841,"_3076":126879},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3624":74875,"_31165":74856,"_21590":126881,"_5":14857,"_28357":126841,"_3076":126882},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3624":74876,"_31165":74856,"_21590":126884,"_5":14857,"_28357":126841,"_3076":126885},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3624":74877,"_31165":74856,"_21590":126887,"_5":14857,"_28357":126841,"_3076":126888},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3624":74878,"_31165":74856,"_21590":126890,"_5":14857,"_28357":126841,"_3076":126891},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3624":74879,"_31165":74856,"_21590":126893,"_5":14857,"_28357":126845,"_3076":126894},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3624":74880,"_31165":74856,"_21590":126896,"_5":14857,"_28357":126845,"_3076":126897},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3624":74881,"_31165":74856,"_21590":126899,"_5":14857,"_28357":126845,"_3076":126900},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3624":74882,"_31165":74856,"_21590":126902,"_5":14857,"_28357":126845,"_3076":126903},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3624":74883,"_31165":74856,"_21590":126905,"_5":14857,"_28357":126845,"_3076":126906},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3624":74884,"_31165":74856,"_21590":126908,"_5":14857,"_28357":126849,"_3076":126909},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3624":74885,"_31165":74856,"_21590":126911,"_5":14857,"_28357":126849,"_3076":126912},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3624":74886,"_31165":74856,"_21590":126914,"_5":14857,"_28357":126849,"_3076":126915},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3624":74887,"_31165":74856,"_21590":126917,"_5":14857,"_28357":126849,"_3076":126918},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3624":74888,"_31165":74856,"_21590":126920,"_5":14857,"_28357":126849,"_3076":126921},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3624":74889,"_31165":74856,"_21590":126923,"_5":14857,"_28357":126849,"_3076":126924},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3624":74890,"_31165":74856,"_21590":126926,"_5":14857,"_28357":126849,"_3076":126927},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3624":74891,"_31165":74856,"_21590":126929,"_5":14857,"_28357":126853,"_3076":126930},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3624":74892,"_31165":74856,"_21590":126932,"_5":14857,"_28357":126857,"_3076":126933},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3624":74893,"_31165":74856,"_21590":126935,"_5":14857,"_28357":126857,"_3076":126936},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3624":74894,"_31165":74856,"_21590":126938,"_5":14857,"_28357":126857,"_3076":126939},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3624":74895,"_31165":74856,"_21590":126941,"_5":14857,"_28357":126857,"_3076":126942},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3624":74896,"_31165":74856,"_21590":126944,"_5":14857,"_28357":126857,"_3076":126945},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3624":74897,"_31165":74856,"_21590":126947,"_5":14857,"_28357":126857,"_3076":126948},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3624":74898,"_31165":74856,"_21590":126950,"_5":14857,"_28357":126857,"_3076":126951},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3624":74899,"_31165":74899,"_5":15217,"_3076":126953,"_31523":126954,"_21590":126955,"_28357":74899},"Listas de revocación (CRL)",[50932,121756,56618,126427],[],{"_3624":74900,"_31165":74899,"_21590":126957,"_5":14857,"_28357":74899,"_3076":126958},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3624":74901,"_31165":74899,"_5":31520,"_21590":126960,"_28357":126961,"_3076":126962},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3624":74902,"_31165":74899,"_5":31520,"_21590":126964,"_28357":126965,"_3076":126966},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3624":74903,"_31165":74899,"_5":31520,"_21590":126968,"_28357":126969,"_3076":126970},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3624":74904,"_31165":74899,"_5":31520,"_21590":126972,"_28357":126973,"_3076":126974},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3624":74905,"_31165":74899,"_5":31520,"_21590":126976,"_28357":126977,"_3076":126978},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3624":74906,"_31165":74899,"_5":31520,"_21590":126980,"_28357":126981,"_3076":126982},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3624":74907,"_31165":74899,"_5":31520,"_21590":126984,"_28357":126985,"_3076":126986},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3624":74908,"_31165":74899,"_5":31520,"_21590":126988,"_28357":126989,"_3076":126990},[],"/docs/pr-preview/pr-76/es/platform/pki/crl#referencias","Referencias",{"_3624":74909,"_31165":74899,"_21590":126992,"_5":14857,"_28357":74899,"_3076":126993},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3624":74910,"_31165":74899,"_21590":126995,"_5":14857,"_28357":126961,"_3076":126996},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3624":74911,"_31165":74899,"_21590":126998,"_5":14857,"_28357":126961,"_3076":126999},[],"Campo",{"_3624":74912,"_31165":74899,"_21590":127001,"_5":14857,"_28357":126961,"_3076":123442},[],{"_3624":74913,"_31165":74899,"_21590":127003,"_5":14857,"_28357":126961,"_3076":52564},[],{"_3624":74914,"_31165":74899,"_21590":127005,"_5":14857,"_28357":126961,"_3076":127006},[],"ID de la CA a la que pertenecen los ajustes.",{"_3624":74915,"_31165":74899,"_21590":127008,"_5":14857,"_28357":126961,"_3076":57853},[],{"_3624":74916,"_31165":74899,"_21590":127010,"_5":14857,"_28357":126961,"_3076":127011},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3624":74917,"_31165":74899,"_21590":127013,"_5":14857,"_28357":126961,"_3076":57859},[],{"_3624":74918,"_31165":74899,"_21590":127015,"_5":14857,"_28357":126961,"_3076":127016},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3624":74919,"_31165":74899,"_21590":127018,"_5":14857,"_28357":126961,"_3076":57865},[],{"_3624":74920,"_31165":74899,"_21590":127020,"_5":14857,"_28357":126961,"_3076":127021},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3624":74921,"_31165":74899,"_21590":127023,"_5":14857,"_28357":126961,"_3076":127024},[],"Campo de `crl_options`",{"_3624":74922,"_31165":74899,"_21590":127026,"_5":14857,"_28357":126961,"_3076":123442},[],{"_3624":74923,"_31165":74899,"_21590":127028,"_5":14857,"_28357":126961,"_3076":127029},[],"Valor inicial",{"_3624":74924,"_31165":74899,"_21590":127031,"_5":14857,"_28357":126961,"_3076":57879},[],{"_3624":74925,"_31165":74899,"_21590":127033,"_5":14857,"_28357":126961,"_3076":127034},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3624":74926,"_31165":74899,"_21590":127036,"_5":14857,"_28357":126961,"_3076":127037},[],"7 días.",{"_3624":74927,"_31165":74899,"_21590":127039,"_5":14857,"_28357":126961,"_3076":57888},[],{"_3624":74928,"_31165":74899,"_21590":127041,"_5":14857,"_28357":126961,"_3076":127042},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3624":74929,"_31165":74899,"_21590":127044,"_5":14857,"_28357":126961,"_3076":127045},[],"6 días y 23 horas.",{"_3624":74930,"_31165":74899,"_21590":127047,"_5":14857,"_28357":126961,"_3076":57897},[],{"_3624":74931,"_31165":74899,"_21590":127049,"_5":14857,"_28357":126961,"_3076":127050},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3624":74932,"_31165":74899,"_21590":127052,"_5":14857,"_28357":126961,"_3076":57903},[],{"_3624":74933,"_31165":74899,"_21590":127054,"_5":14857,"_28357":126961,"_3076":57906},[],{"_3624":74934,"_31165":74899,"_21590":127056,"_5":14857,"_28357":126961,"_3076":127057},[],"Número de serie del certificado existente que firma la CRL.",{"_3624":74935,"_31165":74899,"_21590":127059,"_5":14857,"_28357":126961,"_3076":127060},[],"Número de serie del certificado actual de la CA.",{"_3624":74936,"_31165":74899,"_21590":127062,"_5":14857,"_28357":126961,"_3076":127063},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3624":74937,"_31165":74899,"_21590":127065,"_5":14857,"_28357":126961,"_3076":127066},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3624":74938,"_31165":74899,"_21590":127068,"_5":14857,"_28357":126961,"_3076":127069},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3624":74939,"_31165":74899,"_21590":127071,"_5":14857,"_28357":126961,"_3076":127072},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3624":74940,"_31165":74899,"_21590":127074,"_5":14857,"_28357":126961,"_3076":127075},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3624":74941,"_31165":74899,"_21590":127077,"_5":14857,"_28357":126961,"_3076":127078},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3624":74942,"_31165":74899,"_21590":127080,"_5":14857,"_28357":126961,"_3076":127081},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3624":74943,"_31165":74899,"_21590":127083,"_5":14857,"_28357":126961,"_3076":127084},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3624":74944,"_31165":74899,"_21590":127086,"_5":14857,"_28357":126961,"_3076":127087},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3624":74945,"_31165":74899,"_21590":127089,"_5":14857,"_28357":126961,"_3076":127090},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3624":74946,"_31165":74899,"_21590":127092,"_5":14857,"_28357":126961,"_3076":127093},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3624":74947,"_31165":74899,"_21590":127095,"_5":14857,"_28357":126965,"_3076":127096},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3624":74948,"_31165":74899,"_21590":127098,"_5":14857,"_28357":126965,"_3076":127099},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3624":74949,"_31165":74899,"_21590":127101,"_5":14857,"_28357":126965,"_3076":127102},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3624":74950,"_31165":74899,"_21590":127104,"_5":14857,"_28357":126965,"_3076":127105},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3624":74951,"_31165":74899,"_21590":127107,"_5":14857,"_28357":126969,"_3076":127108},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3624":74952,"_31165":74899,"_21590":127110,"_5":14857,"_28357":126969,"_3076":127111},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3624":74953,"_31165":74899,"_21590":127113,"_5":14857,"_28357":126969,"_3076":127114},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3624":74954,"_31165":74899,"_21590":127116,"_5":14857,"_28357":126969,"_3076":127117},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3624":74955,"_31165":74899,"_21590":127119,"_5":14857,"_28357":126969,"_3076":127120},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3624":74956,"_31165":74899,"_21590":127122,"_5":14857,"_28357":126969,"_3076":127123},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3624":74957,"_31165":74899,"_21590":127125,"_5":14857,"_28357":126969,"_3076":127126},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3624":74958,"_31165":74899,"_21590":127128,"_5":14857,"_28357":126969,"_3076":127129},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3624":74959,"_31165":74899,"_21590":127131,"_5":14857,"_28357":126969,"_3076":127132},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3624":74960,"_31165":74899,"_21590":127134,"_5":14857,"_28357":126973,"_3076":127135},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3624":74961,"_31165":74899,"_21590":127137,"_5":14857,"_28357":126973,"_3076":127138},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3624":74962,"_31165":74899,"_21590":127140,"_5":14857,"_28357":126977,"_3076":127141},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3624":74963,"_31165":74899,"_21590":127143,"_5":14857,"_28357":126977,"_3076":127144},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3624":74964,"_31165":74899,"_21590":127146,"_5":14857,"_28357":126977,"_3076":127147},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3624":74965,"_31165":74899,"_21590":127149,"_5":14857,"_28357":126977,"_3076":127150},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3624":74966,"_31165":74899,"_21590":127152,"_5":14857,"_28357":126977,"_3076":127153},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3624":74967,"_31165":74899,"_21590":127155,"_5":14857,"_28357":126981,"_3076":127156},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3624":74968,"_31165":74899,"_21590":127158,"_5":14857,"_28357":126981,"_3076":123631},[],{"_3624":74969,"_31165":74899,"_21590":127160,"_5":14857,"_28357":126981,"_3076":127161},[],"Path relativo",{"_3624":74970,"_31165":74899,"_21590":127163,"_5":14857,"_28357":126981,"_3076":121516},[],{"_3624":74971,"_31165":74899,"_21590":127165,"_5":14857,"_28357":126981,"_3076":58018},[],{"_3624":74972,"_31165":74899,"_21590":127167,"_5":14857,"_28357":126981,"_3076":58021},[],{"_3624":74973,"_31165":74899,"_21590":127169,"_5":14857,"_28357":126981,"_3076":127170},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3624":74974,"_31165":74899,"_21590":127172,"_5":14857,"_28357":126981,"_3076":58018},[],{"_3624":74975,"_31165":74899,"_21590":127174,"_5":14857,"_28357":126981,"_3076":58029},[],{"_3624":74976,"_31165":74899,"_21590":127176,"_5":14857,"_28357":126981,"_3076":127177},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3624":74977,"_31165":74899,"_21590":127179,"_5":14857,"_28357":126981,"_3076":58035},[],{"_3624":74978,"_31165":74899,"_21590":127181,"_5":14857,"_28357":126981,"_3076":58029},[],{"_3624":74979,"_31165":74899,"_21590":127183,"_5":14857,"_28357":126981,"_3076":127184},[],"Sustituir la configuración de CRL de una CA.",{"_3624":74980,"_31165":74899,"_21590":127186,"_5":14857,"_28357":126981,"_3076":58043},[],{"_3624":74981,"_31165":74899,"_21590":127188,"_5":14857,"_28357":126981,"_3076":58029},[],{"_3624":74982,"_31165":74899,"_21590":127190,"_5":14857,"_28357":126981,"_3076":127191},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3624":74983,"_31165":74899,"_21590":127193,"_5":14857,"_28357":126981,"_3076":127194},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3624":74984,"_31165":74899,"_21590":127196,"_5":14857,"_28357":126981,"_3076":127197},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3624":74985,"_31165":74899,"_21590":127199,"_5":14857,"_28357":126981,"_3076":127200},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3624":74986,"_31165":74899,"_21590":127202,"_5":14857,"_28357":126985,"_3076":127203},[],"Síntoma",{"_3624":74987,"_31165":74899,"_21590":127205,"_5":14857,"_28357":126985,"_3076":127206},[],"Causa",{"_3624":74988,"_31165":74899,"_21590":127208,"_5":14857,"_28357":126985,"_3076":127209},[],"Acción",{"_3624":74989,"_31165":74899,"_21590":127211,"_5":14857,"_28357":126985,"_3076":127212},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3624":74990,"_31165":74899,"_21590":127214,"_5":14857,"_28357":126985,"_3076":127215},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3624":74991,"_31165":74899,"_21590":127217,"_5":14857,"_28357":126985,"_3076":127218},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3624":74992,"_31165":74899,"_21590":127220,"_5":14857,"_28357":126985,"_3076":127221},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3624":74993,"_31165":74899,"_21590":127223,"_5":14857,"_28357":126985,"_3076":127224},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3624":74994,"_31165":74899,"_21590":127226,"_5":14857,"_28357":126985,"_3076":127227},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3624":74995,"_31165":74899,"_21590":127229,"_5":14857,"_28357":126985,"_3076":127230},[],"`PUT` devuelve 400.",{"_3624":74996,"_31165":74899,"_21590":127232,"_5":14857,"_28357":126985,"_3076":127233},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3624":74997,"_31165":74899,"_21590":127235,"_5":14857,"_28357":126985,"_3076":127236},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3624":74998,"_31165":74899,"_21590":127238,"_5":14857,"_28357":126985,"_3076":127239},[],"`PUT` devuelve 404.",{"_3624":74999,"_31165":74899,"_21590":127241,"_5":14857,"_28357":126985,"_3076":127242},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3624":75000,"_31165":74899,"_21590":127244,"_5":14857,"_28357":126985,"_3076":127245},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3624":75001,"_31165":74899,"_21590":127247,"_5":14857,"_28357":126985,"_3076":127248},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3624":75002,"_31165":74899,"_21590":127250,"_5":14857,"_28357":126985,"_3076":127251},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3624":75003,"_31165":74899,"_21590":127253,"_5":14857,"_28357":126985,"_3076":127254},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3624":75004,"_31165":74899,"_21590":127256,"_5":14857,"_28357":126985,"_3076":127257},[],"La CRL no cambia tras revocar un certificado.",{"_3624":75005,"_31165":74899,"_21590":127259,"_5":14857,"_28357":126985,"_3076":127260},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3624":75006,"_31165":74899,"_21590":127262,"_5":14857,"_28357":126985,"_3076":127263},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3624":75007,"_31165":74899,"_21590":127265,"_5":14857,"_28357":126985,"_3076":127266},[],"Un verificador rechaza la CRL por el emisor.",{"_3624":75008,"_31165":74899,"_21590":127268,"_5":14857,"_28357":126985,"_3076":127269},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3624":75009,"_31165":74899,"_21590":127271,"_5":14857,"_28357":126985,"_3076":127272},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3624":75010,"_31165":74899,"_21590":127274,"_5":14857,"_28357":126989,"_3076":127275},[],"RFC 5280: perfil X.509 y CRL.",{"_3624":75011,"_31165":74899,"_21590":127277,"_5":14857,"_28357":126989,"_3076":58135},[],{"_3624":75012,"_31165":74899,"_21590":127279,"_5":14857,"_28357":126989,"_3076":58138},[],{"_3624":75013,"_31165":74899,"_21590":127281,"_5":14857,"_28357":126989,"_3076":127282},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":75014,"_31165":74899,"_21590":127284,"_5":14857,"_28357":126989,"_3076":127285},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3624":75015,"_31165":75015,"_5":15217,"_3076":127287,"_31523":127288,"_21590":127289,"_28357":75015},"Claves y motores criptográficos",[50932,121756,56618,125778],[],{"_3624":75016,"_31165":75015,"_21590":127291,"_5":14857,"_28357":75015,"_3076":127292},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3624":75017,"_31165":75015,"_5":31520,"_21590":127294,"_28357":127295,"_3076":127296},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3624":75018,"_31165":75015,"_5":31520,"_21590":127298,"_28357":127299,"_3076":127300},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3624":75019,"_31165":75015,"_5":31520,"_21590":127302,"_28357":127303,"_3076":58163},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#file-system",{"_3624":75020,"_31165":75015,"_5":31520,"_21590":127305,"_28357":127306,"_3076":58167},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#hashicorp-vault",{"_3624":75021,"_31165":75015,"_5":31520,"_21590":127308,"_28357":127309,"_3076":58171},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#aws-secrets-manager",{"_3624":75022,"_31165":75015,"_5":31520,"_21590":127311,"_28357":127312,"_3076":58175},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#aws-kms",{"_3624":75023,"_31165":75015,"_5":31520,"_21590":127314,"_28357":127315,"_3076":58179},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#pkcs11",{"_3624":75024,"_31165":75015,"_5":31520,"_21590":127317,"_28357":127318,"_3076":58183},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#azure-key-vault",{"_3624":75025,"_31165":75015,"_5":31520,"_21590":127320,"_28357":127321,"_3076":127322},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3624":75026,"_31165":75015,"_5":31520,"_21590":127324,"_28357":127325,"_3076":127326},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3624":75027,"_31165":75015,"_5":31520,"_21590":127328,"_28357":127329,"_3076":127330},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3624":75028,"_31165":75015,"_5":31520,"_21590":127332,"_28357":127333,"_3076":127334},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3624":75029,"_31165":75015,"_5":31520,"_21590":127336,"_28357":127337,"_3076":127338},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3624":75030,"_31165":75015,"_5":31520,"_21590":127340,"_28357":127341,"_3076":127342},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3624":75031,"_31165":75015,"_5":31520,"_21590":127344,"_28357":127345,"_3076":127346},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3624":75032,"_31165":75015,"_5":31520,"_21590":127348,"_28357":127349,"_3076":58215},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#sign",{"_3624":75033,"_31165":75015,"_5":31520,"_21590":127351,"_28357":127352,"_3076":58219},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#verify",{"_3624":75034,"_31165":75015,"_5":31520,"_21590":127354,"_28357":127355,"_3076":127356},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3624":75035,"_31165":75015,"_5":31520,"_21590":127358,"_28357":127359,"_3076":127360},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3624":75036,"_31165":75015,"_5":31520,"_21590":127362,"_28357":127363,"_3076":127364},[],"/docs/pr-preview/pr-76/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3624":75037,"_31165":75015,"_21590":127366,"_5":14857,"_28357":75015,"_3076":127367},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3624":75038,"_31165":75015,"_21590":127369,"_5":14857,"_28357":75015,"_3076":127370},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3624":75039,"_31165":75015,"_21590":127372,"_5":14857,"_28357":127295,"_3076":127373},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3624":75040,"_31165":75015,"_21590":127375,"_5":14857,"_28357":127295,"_3076":127376},[],"En la práctica, permite:",{"_3624":75041,"_31165":75015,"_21590":127378,"_5":14857,"_28357":127295,"_3076":127379},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3624":75042,"_31165":75015,"_21590":127381,"_5":14857,"_28357":127295,"_3076":127382},[],"Importar claves creadas externamente.",{"_3624":75043,"_31165":75015,"_21590":127384,"_5":14857,"_28357":127295,"_3076":127385},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3624":75044,"_31165":75015,"_21590":127387,"_5":14857,"_28357":127295,"_3076":127388},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3624":75045,"_31165":75015,"_21590":127390,"_5":14857,"_28357":127299,"_3076":127391},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3624":75046,"_31165":75015,"_21590":127393,"_5":14857,"_28357":127299,"_3076":127394},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3624":75047,"_31165":75015,"_21590":127396,"_5":14857,"_28357":127299,"_3076":127397},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3624":75048,"_31165":75015,"_21590":127399,"_5":14857,"_28357":127303,"_3076":127400},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3624":75049,"_31165":75015,"_21590":127402,"_5":14857,"_28357":127306,"_3076":127403},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3624":75050,"_31165":75015,"_21590":127405,"_5":14857,"_28357":127306,"_3076":127406},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3624":75051,"_31165":75015,"_21590":127408,"_5":14857,"_28357":127309,"_3076":127409},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3624":75052,"_31165":75015,"_21590":127411,"_5":14857,"_28357":127312,"_3076":127412},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3624":75053,"_31165":75015,"_21590":127414,"_5":14857,"_28357":127315,"_3076":127415},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3624":75054,"_31165":75015,"_21590":127417,"_5":14857,"_28357":127318,"_3076":127418},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3624":75055,"_31165":75015,"_21590":127420,"_5":14857,"_28357":127318,"_3076":127421},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3624":75056,"_31165":75015,"_21590":127423,"_5":14857,"_28357":127318,"_3076":127424},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3624":75057,"_31165":75015,"_21590":127426,"_5":14857,"_28357":127318,"_3076":127427},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3624":75058,"_31165":75015,"_21590":127429,"_5":14857,"_28357":127321,"_3076":127430},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3624":75059,"_31165":75015,"_21590":127432,"_5":14857,"_28357":127321,"_3076":127433},[],"La tabla incluye los siguientes campos:",{"_3624":75060,"_31165":75015,"_21590":127435,"_5":14857,"_28357":127321,"_3076":127436},[],"**Name**: nombre descriptivo de la clave.",{"_3624":75061,"_31165":75015,"_21590":127438,"_5":14857,"_28357":127321,"_3076":127439},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3624":75062,"_31165":75015,"_21590":127441,"_5":14857,"_28357":127321,"_3076":127442},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3624":75063,"_31165":75015,"_21590":127444,"_5":14857,"_28357":127321,"_3076":127445},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3624":75064,"_31165":75015,"_21590":127447,"_5":14857,"_28357":127321,"_3076":127448},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3624":75065,"_31165":75015,"_21590":127450,"_5":14857,"_28357":127321,"_3076":127451},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3624":75066,"_31165":75015,"_21590":127453,"_5":14857,"_28357":127321,"_3076":127454},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3624":75067,"_31165":75015,"_21590":127456,"_5":14857,"_28357":127321,"_3076":127457},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3624":75068,"_31165":75015,"_21590":127459,"_5":14857,"_28357":127321,"_3076":127460},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3624":75069,"_31165":75015,"_21590":127462,"_5":14857,"_28357":127321,"_3076":127463},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3624":75070,"_31165":75015,"_21590":127465,"_5":14857,"_28357":127321,"_3076":127466},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3624":75071,"_31165":75015,"_21590":127468,"_5":14857,"_28357":127321,"_3076":127469},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3624":75072,"_31165":75015,"_21590":127471,"_5":14857,"_28357":127321,"_3076":127472},[],"**Delete Key** para eliminar la clave del sistema.",{"_3624":75073,"_31165":75015,"_21590":127474,"_5":14857,"_28357":127325,"_3076":127475},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3624":75074,"_31165":75015,"_21590":127477,"_5":14857,"_28357":127329,"_3076":127478},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3624":75075,"_31165":75015,"_21590":127480,"_5":14857,"_28357":127329,"_3076":127481},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3624":75076,"_31165":75015,"_21590":127483,"_5":14857,"_28357":127329,"_3076":127484},[],"**Key Name**: nombre único y descriptivo.",{"_3624":75077,"_31165":75015,"_21590":127486,"_5":14857,"_28357":127329,"_3076":127487},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3624":75078,"_31165":75015,"_21590":127489,"_5":14857,"_28357":127329,"_3076":127490},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3624":75079,"_31165":75015,"_21590":127492,"_5":14857,"_28357":127329,"_3076":127493},[],"**Tags**: metadatos para clasificar la clave.",{"_3624":75080,"_31165":75015,"_21590":127495,"_5":14857,"_28357":127329,"_3076":127496},[],"**Metadata**: información adicional para usos avanzados.",{"_3624":75081,"_31165":75015,"_21590":127498,"_5":14857,"_28357":127333,"_3076":127499},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3624":75082,"_31165":75015,"_21590":127501,"_5":14857,"_28357":127333,"_3076":127502},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3624":75083,"_31165":75015,"_21590":127504,"_5":14857,"_28357":127333,"_3076":127505},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3624":75084,"_31165":75015,"_21590":127507,"_5":14857,"_28357":127333,"_3076":127508},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3624":75085,"_31165":75015,"_21590":127510,"_5":14857,"_28357":127333,"_3076":127511},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3624":75086,"_31165":75015,"_21590":127513,"_5":14857,"_28357":127333,"_3076":127514},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3624":75087,"_31165":75015,"_21590":127516,"_5":14857,"_28357":127333,"_3076":127517},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3624":75088,"_31165":75015,"_21590":127519,"_5":14857,"_28357":127333,"_3076":127520},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3624":75089,"_31165":75015,"_21590":127522,"_5":14857,"_28357":127333,"_3076":127523},[],"**Metadata**: información adicional opcional.",{"_3624":75090,"_31165":75015,"_21590":127525,"_5":14857,"_28357":127333,"_3076":127526},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3624":75091,"_31165":75015,"_21590":127528,"_5":14857,"_28357":127333,"_3076":127529},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3624":75092,"_31165":75015,"_21590":127531,"_5":14857,"_28357":127337,"_3076":127532},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3624":75093,"_31165":75015,"_21590":127534,"_5":14857,"_28357":127341,"_3076":127535},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3624":75094,"_31165":75015,"_21590":127537,"_5":14857,"_28357":127341,"_3076":127538},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3624":75095,"_31165":75015,"_21590":127540,"_5":14857,"_28357":127341,"_3076":127541},[],"**Key Name**: nombre descriptivo.",{"_3624":75096,"_31165":75015,"_21590":127543,"_5":14857,"_28357":127341,"_3076":127544},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3624":75097,"_31165":75015,"_21590":127546,"_5":14857,"_28357":127341,"_3076":127547},[],"**Tags**: etiquetas asociadas.",{"_3624":75098,"_31165":75015,"_21590":127549,"_5":14857,"_28357":127341,"_3076":127550},[],"**Aliases**: nombres alternativos.",{"_3624":75099,"_31165":75015,"_21590":127552,"_5":14857,"_28357":127341,"_3076":127553},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3624":75100,"_31165":75015,"_21590":127555,"_5":14857,"_28357":127341,"_3076":127556},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3624":75101,"_31165":75015,"_21590":127558,"_5":14857,"_28357":127341,"_3076":127559},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3624":75102,"_31165":75015,"_21590":127561,"_5":14857,"_28357":127341,"_3076":127562},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3624":75103,"_31165":75015,"_21590":127564,"_5":14857,"_28357":127345,"_3076":127565},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3624":75104,"_31165":75015,"_21590":127567,"_5":14857,"_28357":127345,"_3076":127568},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3624":75105,"_31165":75015,"_21590":127570,"_5":14857,"_28357":127345,"_3076":127571},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3624":75106,"_31165":75015,"_21590":127573,"_5":14857,"_28357":127349,"_3076":127574},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3624":75107,"_31165":75015,"_21590":127576,"_5":14857,"_28357":127349,"_3076":127577},[],"Campos principales:",{"_3624":75108,"_31165":75015,"_21590":127579,"_5":14857,"_28357":127349,"_3076":127580},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3624":75109,"_31165":75015,"_21590":127582,"_5":14857,"_28357":127349,"_3076":127583},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3624":75110,"_31165":75015,"_21590":127585,"_5":14857,"_28357":127349,"_3076":127586},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3624":75111,"_31165":75015,"_21590":127588,"_5":14857,"_28357":127349,"_3076":127589},[],"**Message**: contenido que se va a firmar.",{"_3624":75112,"_31165":75015,"_21590":127591,"_5":14857,"_28357":127349,"_3076":127592},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3624":75113,"_31165":75015,"_21590":127594,"_5":14857,"_28357":127352,"_3076":127595},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3624":75114,"_31165":75015,"_21590":127597,"_5":14857,"_28357":127352,"_3076":127577},[],{"_3624":75115,"_31165":75015,"_21590":127599,"_5":14857,"_28357":127352,"_3076":127600},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3624":75116,"_31165":75015,"_21590":127602,"_5":14857,"_28357":127352,"_3076":127603},[],"**Message Type**: `Raw` o `Digest`.",{"_3624":75117,"_31165":75015,"_21590":127605,"_5":14857,"_28357":127352,"_3076":127606},[],"**Payload Encoding**: codificación del mensaje.",{"_3624":75118,"_31165":75015,"_21590":127608,"_5":14857,"_28357":127352,"_3076":127609},[],"**Message**: mensaje original o hash.",{"_3624":75119,"_31165":75015,"_21590":127611,"_5":14857,"_28357":127352,"_3076":127612},[],"**Signature**: firma que se desea comprobar.",{"_3624":75120,"_31165":75015,"_21590":127614,"_5":14857,"_28357":127352,"_3076":127615},[],"**Result**: indicador del resultado de la validación.",{"_3624":75121,"_31165":75015,"_21590":127617,"_5":14857,"_28357":127355,"_3076":127618},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3624":75122,"_31165":75015,"_21590":127620,"_5":14857,"_28357":127355,"_3076":127621},[],"Este flujo es útil para:",{"_3624":75123,"_31165":75015,"_21590":127623,"_5":14857,"_28357":127355,"_3076":127624},[],"Solicitar certificados a una CA externa.",{"_3624":75124,"_31165":75015,"_21590":127626,"_5":14857,"_28357":127355,"_3076":127627},[],"Renovar una identidad manteniendo la misma clave.",{"_3624":75125,"_31165":75015,"_21590":127629,"_5":14857,"_28357":127355,"_3076":127630},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3624":75126,"_31165":75015,"_21590":127632,"_5":14857,"_28357":127355,"_3076":127633},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3624":75127,"_31165":75015,"_21590":127635,"_5":14857,"_28357":127355,"_3076":127636},[],"**Organization (O)**: organización o empresa.",{"_3624":75128,"_31165":75015,"_21590":127638,"_5":14857,"_28357":127355,"_3076":127639},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3624":75129,"_31165":75015,"_21590":127641,"_5":14857,"_28357":127355,"_3076":127642},[],"**Country (C)**: código de país de dos letras.",{"_3624":75130,"_31165":75015,"_21590":127644,"_5":14857,"_28357":127355,"_3076":127645},[],"**State / Province (ST)**: estado o provincia.",{"_3624":75131,"_31165":75015,"_21590":127647,"_5":14857,"_28357":127355,"_3076":127648},[],"**Locality (L)**: ciudad o localidad.",{"_3624":75132,"_31165":75015,"_21590":127650,"_5":14857,"_28357":127355,"_3076":127651},[],"**Email Address**: correo de contacto.",{"_3624":75133,"_31165":75015,"_21590":127653,"_5":14857,"_28357":127355,"_3076":127654},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3624":75134,"_31165":75015,"_21590":127656,"_5":14857,"_28357":127355,"_3076":127657},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3624":75135,"_31165":75015,"_21590":127659,"_5":14857,"_28357":127359,"_3076":127660},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3624":75136,"_31165":75015,"_21590":127662,"_5":14857,"_28357":127359,"_3076":127663},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3624":75137,"_31165":75015,"_21590":127665,"_5":14857,"_28357":127363,"_3076":127666},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3624":75138,"_31165":75015,"_21590":127668,"_5":14857,"_28357":127363,"_3076":127669},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3624":75139,"_31165":75139,"_5":15217,"_3076":127671,"_31523":127672,"_21590":127673,"_28357":75139},"Validación online con OCSP",[50932,121756,56618,126427],[],{"_3624":75140,"_31165":75139,"_21590":127675,"_5":14857,"_28357":75139,"_3076":127676},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3624":75141,"_31165":75139,"_5":31520,"_21590":127678,"_28357":127679,"_3076":127680},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3624":75142,"_31165":75139,"_5":31520,"_21590":127682,"_28357":127683,"_3076":127684},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3624":75143,"_31165":75139,"_5":31520,"_21590":127686,"_28357":127687,"_3076":127688},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3624":75144,"_31165":75139,"_5":31520,"_21590":127690,"_28357":127691,"_3076":127692},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3624":75145,"_31165":75139,"_5":31520,"_21590":127694,"_28357":127695,"_3076":127696},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3624":75146,"_31165":75139,"_5":31520,"_21590":127698,"_28357":127699,"_3076":126990},[],"/docs/pr-preview/pr-76/es/platform/pki/ocsp#referencias",{"_3624":75147,"_31165":75139,"_21590":127701,"_5":14857,"_28357":75139,"_3076":127702},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3624":75148,"_31165":75139,"_21590":127704,"_5":14857,"_28357":127679,"_3076":127705},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3624":75149,"_31165":75139,"_21590":127707,"_5":14857,"_28357":127679,"_3076":127708},[],"Estado del registro",{"_3624":75150,"_31165":75139,"_21590":127710,"_5":14857,"_28357":127679,"_3076":127711},[],"Respuesta firmada",{"_3624":75151,"_31165":75139,"_21590":127713,"_5":14857,"_28357":127679,"_3076":55755},[],{"_3624":75152,"_31165":75139,"_21590":127715,"_5":14857,"_28357":127679,"_3076":58583},[],{"_3624":75153,"_31165":75139,"_21590":127717,"_5":14857,"_28357":127679,"_3076":55772},[],{"_3624":75154,"_31165":75139,"_21590":127719,"_5":14857,"_28357":127679,"_3076":127720},[],"`Revoked`, con razón y fecha de revocación.",{"_3624":75155,"_31165":75139,"_21590":127722,"_5":14857,"_28357":127679,"_3076":127723},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3624":75156,"_31165":75139,"_21590":127725,"_5":14857,"_28357":127679,"_3076":127726},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3624":75157,"_31165":75139,"_21590":127728,"_5":14857,"_28357":127679,"_3076":127729},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3624":75158,"_31165":75139,"_21590":127731,"_5":14857,"_28357":127679,"_3076":127732},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3624":75159,"_31165":75139,"_21590":127734,"_5":14857,"_28357":127679,"_3076":127735},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3624":75160,"_31165":75139,"_21590":127737,"_5":14857,"_28357":127683,"_3076":127738},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3624":75161,"_31165":75139,"_21590":127740,"_5":14857,"_28357":127683,"_3076":127741},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3624":75162,"_31165":75139,"_21590":127743,"_5":14857,"_28357":127687,"_3076":127744},[],"El servicio acepta:",{"_3624":75163,"_31165":75139,"_21590":127746,"_5":14857,"_28357":127687,"_3076":123631},[],{"_3624":75164,"_31165":75139,"_21590":127748,"_5":14857,"_28357":127687,"_3076":127749},[],"Ruta del servicio VA",{"_3624":75165,"_31165":75139,"_21590":127751,"_5":14857,"_28357":127687,"_3076":127752},[],"Formato",{"_3624":75166,"_31165":75139,"_21590":127754,"_5":14857,"_28357":127687,"_3076":58623},[],{"_3624":75167,"_31165":75139,"_21590":127756,"_5":14857,"_28357":127687,"_3076":58626},[],{"_3624":75168,"_31165":75139,"_21590":127758,"_5":14857,"_28357":127687,"_3076":127759},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3624":75169,"_31165":75139,"_21590":127761,"_5":14857,"_28357":127687,"_3076":58018},[],{"_3624":75170,"_31165":75139,"_21590":127763,"_5":14857,"_28357":127687,"_3076":58634},[],{"_3624":75171,"_31165":75139,"_21590":127765,"_5":14857,"_28357":127687,"_3076":127766},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3624":75172,"_31165":75139,"_21590":127768,"_5":14857,"_28357":127687,"_3076":127769},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3624":75173,"_31165":75139,"_21590":127771,"_5":14857,"_28357":127691,"_3076":127772},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3624":75174,"_31165":75139,"_21590":127774,"_5":14857,"_28357":127691,"_3076":127775},[],"Genera la solicitud:",{"_3624":75175,"_31165":75139,"_21590":127777,"_5":14857,"_28357":127691,"_3076":127778},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3624":75176,"_31165":75139,"_21590":127780,"_5":14857,"_28357":127691,"_3076":127781},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3624":75177,"_31165":75139,"_21590":127783,"_5":14857,"_28357":127691,"_3076":127784},[],"Verifica el DER recibido:",{"_3624":75178,"_31165":75139,"_21590":127786,"_5":14857,"_28357":127691,"_3076":127787},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3624":75179,"_31165":75139,"_21590":127789,"_5":14857,"_28357":127695,"_3076":127790},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3624":75180,"_31165":75139,"_21590":127792,"_5":14857,"_28357":127695,"_3076":127793},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3624":75181,"_31165":75139,"_21590":127795,"_5":14857,"_28357":127699,"_3076":58667},[],{"_3624":75182,"_31165":75139,"_21590":127797,"_5":14857,"_28357":127699,"_3076":58670},[],{"_3624":75183,"_31165":75139,"_21590":127799,"_5":14857,"_28357":127699,"_3076":127800},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3624":75184,"_31165":75139,"_21590":127802,"_5":14857,"_28357":127699,"_3076":127285},[],{"_3624":75185,"_31165":75185,"_5":15217,"_3076":56618,"_31523":127804,"_21590":127805,"_28357":75185},[50932,121756,56618],[],{"_3624":75186,"_31165":75185,"_21590":127807,"_5":14857,"_28357":75185,"_3076":127808},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3624":75187,"_31165":75185,"_5":31520,"_21590":127810,"_28357":127811,"_3076":125104},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#empieza-aquí",{"_3624":75188,"_31165":75185,"_5":31520,"_21590":127813,"_28357":127814,"_3076":127815},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3624":75189,"_31165":75185,"_5":31520,"_21590":127817,"_28357":127818,"_3076":125624},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#capacidades-principales",{"_3624":75190,"_31165":75185,"_5":31520,"_21590":127820,"_28357":127821,"_3076":125628},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3624":75191,"_31165":75185,"_5":31520,"_21590":127823,"_28357":127824,"_3076":125632},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3624":75192,"_31165":75185,"_5":31520,"_21590":127826,"_28357":127827,"_3076":125636},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#emite-y-controla-certificados",{"_3624":75193,"_31165":75185,"_5":31520,"_21590":127829,"_28357":127830,"_3076":125644},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#publica-el-estado-de-validación",{"_3624":75194,"_31165":75185,"_5":31520,"_21590":127832,"_28357":127833,"_3076":127834},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3624":75195,"_31165":75185,"_5":31520,"_21590":127836,"_28357":127837,"_3076":126593},[],"/docs/pr-preview/pr-76/es/platform/pki/overview#continúa",{"_3624":75196,"_31165":75185,"_21590":127839,"_5":14857,"_28357":75185,"_3076":127840},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3624":75197,"_31165":75185,"_21590":127842,"_5":14857,"_28357":127811,"_3076":127843},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3624":75198,"_31165":75185,"_21590":127845,"_5":14857,"_28357":127811,"_3076":127846},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3624":75199,"_31165":75185,"_21590":127848,"_5":14857,"_28357":127814,"_3076":127849},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3624":75200,"_31165":75185,"_21590":127851,"_5":14857,"_28357":127814,"_3076":127852},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3624":75201,"_31165":75185,"_21590":127854,"_5":14857,"_28357":127814,"_3076":127855},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3624":75202,"_31165":75185,"_21590":127857,"_5":14857,"_28357":127814,"_3076":127858},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3624":75203,"_31165":75185,"_21590":127860,"_5":14857,"_28357":127814,"_3076":127861},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3624":75204,"_31165":75185,"_21590":127863,"_5":14857,"_28357":127821,"_3076":127864},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3624":75205,"_31165":75185,"_21590":127866,"_5":14857,"_28357":127824,"_3076":127867},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3624":75206,"_31165":75185,"_21590":127869,"_5":14857,"_28357":127827,"_3076":127870},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3624":75207,"_31165":75185,"_21590":127872,"_5":14857,"_28357":127830,"_3076":127873},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3624":75208,"_31165":75185,"_21590":127875,"_5":14857,"_28357":127833,"_3076":127876},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3624":75209,"_31165":75185,"_21590":127878,"_5":14857,"_28357":127833,"_3076":127879},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3624":75210,"_31165":75185,"_21590":127881,"_5":14857,"_28357":127833,"_3076":127882},[],"su clave pública corresponda a la clave privada del cliente;",{"_3624":75211,"_31165":75185,"_21590":127884,"_5":14857,"_28357":127833,"_3076":127885},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3624":75212,"_31165":75185,"_21590":127887,"_5":14857,"_28357":127833,"_3076":127888},[],"sus fechas y usos permitan la operación;",{"_3624":75213,"_31165":75185,"_21590":127890,"_5":14857,"_28357":127833,"_3076":127891},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3624":75214,"_31165":75185,"_21590":127893,"_5":14857,"_28357":127833,"_3076":127894},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3624":75215,"_31165":75185,"_21590":127896,"_5":14857,"_28357":127837,"_3076":127897},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3624":75216,"_31165":75185,"_21590":127899,"_5":14857,"_28357":127837,"_3076":127900},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3624":75217,"_31165":75185,"_21590":127902,"_5":14857,"_28357":127837,"_3076":127903},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3624":75218,"_31165":75218,"_5":15217,"_3076":127905,"_31523":127906,"_21590":127907,"_28357":75218},"Crea tu primera CA",[50932,121756,56618,125228],[],{"_3624":75219,"_31165":75218,"_21590":127909,"_5":14857,"_28357":75218,"_3076":127910},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3624":75220,"_31165":75218,"_5":31520,"_21590":127912,"_28357":127913,"_3076":120290},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3624":75221,"_31165":75218,"_5":31520,"_21590":127915,"_28357":127916,"_3076":127917},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3624":75222,"_31165":75218,"_5":31520,"_21590":127919,"_28357":127920,"_3076":127921},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3624":75223,"_31165":75218,"_5":31520,"_21590":127923,"_28357":127924,"_3076":127925},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3624":75224,"_31165":75218,"_5":31520,"_21590":127927,"_28357":127928,"_3076":127929},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3624":75225,"_31165":75218,"_5":31520,"_21590":127931,"_28357":127932,"_3076":127933},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3624":75226,"_31165":75218,"_5":31520,"_21590":127935,"_28357":127936,"_3076":127937},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3624":75227,"_31165":75218,"_5":31520,"_21590":127939,"_28357":127940,"_3076":125475},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3624":75228,"_31165":75218,"_5":31520,"_21590":127942,"_28357":127943,"_3076":120314},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3624":75229,"_31165":75218,"_21590":127945,"_5":14857,"_28357":75218,"_3076":127946},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3624":75230,"_31165":75218,"_21590":127948,"_5":14857,"_28357":127913,"_3076":127949},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3624":75231,"_31165":75218,"_21590":127951,"_5":14857,"_28357":127913,"_3076":127952},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3624":75232,"_31165":75218,"_21590":127954,"_5":14857,"_28357":127913,"_3076":127955},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3624":75233,"_31165":75218,"_21590":127957,"_5":14857,"_28357":127913,"_3076":127958},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3624":75234,"_31165":75218,"_21590":127960,"_5":14857,"_28357":127916,"_3076":127961},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3624":75235,"_31165":75218,"_21590":127963,"_5":14857,"_28357":127916,"_3076":127964},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3624":75236,"_31165":75218,"_21590":127966,"_5":14857,"_28357":127920,"_3076":127967},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3624":75237,"_31165":75218,"_21590":127969,"_5":14857,"_28357":127920,"_3076":127970},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3624":75238,"_31165":75218,"_21590":127972,"_5":14857,"_28357":127924,"_3076":127973},[],"Selecciona **Root CA** y completa:",{"_3624":75239,"_31165":75218,"_21590":127975,"_5":14857,"_28357":127924,"_3076":58849},[],{"_3624":75240,"_31165":75218,"_21590":127977,"_5":14857,"_28357":127924,"_3076":127978},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3624":75241,"_31165":75218,"_21590":127980,"_5":14857,"_28357":127924,"_3076":127981},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3624":75242,"_31165":75218,"_21590":127983,"_5":14857,"_28357":127924,"_3076":127984},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3624":75243,"_31165":75218,"_21590":127986,"_5":14857,"_28357":127924,"_3076":127987},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3624":75244,"_31165":75218,"_21590":127989,"_5":14857,"_28357":127928,"_3076":127990},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3624":75245,"_31165":75218,"_21590":127992,"_5":14857,"_28357":127932,"_3076":127993},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3624":75246,"_31165":75218,"_21590":127995,"_5":14857,"_28357":127932,"_3076":127996},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3624":75247,"_31165":75218,"_21590":127998,"_5":14857,"_28357":127936,"_3076":127999},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3624":75248,"_31165":75218,"_21590":128001,"_5":14857,"_28357":127936,"_3076":128002},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3624":75249,"_31165":75218,"_21590":128004,"_5":14857,"_28357":127936,"_3076":128005},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3624":75250,"_31165":75218,"_21590":128007,"_5":14857,"_28357":127940,"_3076":128008},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3624":75251,"_31165":75218,"_21590":128010,"_5":14857,"_28357":127940,"_3076":128011},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3624":75252,"_31165":75218,"_21590":128013,"_5":14857,"_28357":127940,"_3076":128014},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3624":75253,"_31165":75218,"_21590":128016,"_5":14857,"_28357":127940,"_3076":128017},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3624":75254,"_31165":75218,"_21590":128019,"_5":14857,"_28357":127943,"_3076":128020},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3624":75255,"_31165":75255,"_5":15217,"_3076":128022,"_31523":128023,"_21590":128024,"_28357":75255},"Emite y verifica un certificado",[50932,121756,56618,125228],[],{"_3624":75256,"_31165":75255,"_21590":128026,"_5":14857,"_28357":75255,"_3076":128027},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3624":75257,"_31165":75255,"_5":31520,"_21590":128029,"_28357":128030,"_3076":120290},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3624":75258,"_31165":75255,"_5":31520,"_21590":128032,"_28357":128033,"_3076":128034},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3624":75259,"_31165":75255,"_5":31520,"_21590":128036,"_28357":128037,"_3076":128038},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3624":75260,"_31165":75255,"_5":31520,"_21590":128040,"_28357":128041,"_3076":128042},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3624":75261,"_31165":75255,"_5":31520,"_21590":128044,"_28357":128045,"_3076":128046},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3624":75262,"_31165":75255,"_5":31520,"_21590":128048,"_28357":128049,"_3076":128050},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3624":75263,"_31165":75255,"_5":31520,"_21590":128052,"_28357":128053,"_3076":128054},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3624":75264,"_31165":75255,"_5":31520,"_21590":128056,"_28357":128057,"_3076":128058},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3624":75265,"_31165":75255,"_5":31520,"_21590":128060,"_28357":128061,"_3076":128062},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3624":75266,"_31165":75255,"_5":31520,"_21590":128064,"_28357":128065,"_3076":128066},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3624":75267,"_31165":75255,"_5":31520,"_21590":128068,"_28357":128069,"_3076":125475},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3624":75268,"_31165":75255,"_5":31520,"_21590":128071,"_28357":128072,"_3076":120314},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3624":75269,"_31165":75255,"_21590":128074,"_5":14857,"_28357":75255,"_3076":128075},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3624":75270,"_31165":75255,"_21590":128077,"_5":14857,"_28357":128030,"_3076":128078},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3624":75271,"_31165":75255,"_21590":128080,"_5":14857,"_28357":128030,"_3076":128081},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3624":75272,"_31165":75255,"_21590":128083,"_5":14857,"_28357":128030,"_3076":128084},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3624":75273,"_31165":75255,"_21590":128086,"_5":14857,"_28357":128030,"_3076":128087},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3624":75274,"_31165":75255,"_21590":128089,"_5":14857,"_28357":128030,"_3076":128090},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3624":75275,"_31165":75255,"_21590":128092,"_5":14857,"_28357":128033,"_3076":128093},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3624":75276,"_31165":75255,"_21590":128095,"_5":14857,"_28357":128037,"_3076":128096},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3624":75277,"_31165":75255,"_21590":128098,"_5":14857,"_28357":128037,"_3076":128099},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3624":75278,"_31165":75255,"_21590":128101,"_5":14857,"_28357":128041,"_3076":128102},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3624":75279,"_31165":75255,"_21590":128104,"_5":14857,"_28357":128041,"_3076":128105},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3624":75280,"_31165":75255,"_21590":128107,"_5":14857,"_28357":128045,"_3076":128108},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3624":75281,"_31165":75255,"_21590":128110,"_5":14857,"_28357":128045,"_3076":128111},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3624":75282,"_31165":75255,"_21590":128113,"_5":14857,"_28357":128049,"_3076":128114},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3624":75283,"_31165":75255,"_21590":128116,"_5":14857,"_28357":128053,"_3076":128117},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3624":75284,"_31165":75255,"_21590":128119,"_5":14857,"_28357":128057,"_3076":128120},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3624":75285,"_31165":75255,"_21590":128122,"_5":14857,"_28357":128061,"_3076":128123},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3624":75286,"_31165":75255,"_21590":128125,"_5":14857,"_28357":128061,"_3076":128126},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3624":75287,"_31165":75255,"_21590":128128,"_5":14857,"_28357":128061,"_3076":128129},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3624":75288,"_31165":75255,"_21590":128131,"_5":14857,"_28357":128065,"_3076":128132},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3624":75289,"_31165":75255,"_21590":128134,"_5":14857,"_28357":128065,"_3076":128135},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3624":75290,"_31165":75255,"_21590":128137,"_5":14857,"_28357":128065,"_3076":128138},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3624":75291,"_31165":75255,"_21590":128140,"_5":14857,"_28357":128069,"_3076":125558},[],{"_3624":75292,"_31165":75255,"_21590":128142,"_5":14857,"_28357":128069,"_3076":124073},[],{"_3624":75293,"_31165":75255,"_21590":128144,"_5":14857,"_28357":128069,"_3076":128145},[],"La CA rechaza la emisión",{"_3624":75294,"_31165":75255,"_21590":128147,"_5":14857,"_28357":128069,"_3076":128148},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3624":75295,"_31165":75255,"_21590":128150,"_5":14857,"_28357":128069,"_3076":128151},[],"Sujeto o usos diferentes",{"_3624":75296,"_31165":75255,"_21590":128153,"_5":14857,"_28357":128069,"_3076":128154},[],"Perfil aplicado y valores solicitados.",{"_3624":75297,"_31165":75255,"_21590":128156,"_5":14857,"_28357":128069,"_3076":128157},[],"No se encuentra el emisor",{"_3624":75298,"_31165":75255,"_21590":128159,"_5":14857,"_28357":128069,"_3076":128160},[],"CA descargada y cadena intermedia necesaria.",{"_3624":75299,"_31165":75255,"_21590":128162,"_5":14857,"_28357":128069,"_3076":128163},[],"Falla la vigencia",{"_3624":75300,"_31165":75255,"_21590":128165,"_5":14857,"_28357":128069,"_3076":128166},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3624":75301,"_31165":75255,"_21590":128168,"_5":14857,"_28357":128069,"_3076":128169},[],"Los resúmenes de clave difieren",{"_3624":75302,"_31165":75255,"_21590":128171,"_5":14857,"_28357":128069,"_3076":128172},[],"Archivos de certificado y clave de la misma emisión.",{"_3624":75303,"_31165":75255,"_21590":128174,"_5":14857,"_28357":128069,"_3076":128175},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3624":75304,"_31165":75255,"_21590":128177,"_5":14857,"_28357":128072,"_3076":128178},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3624":75305,"_31165":75255,"_21590":128180,"_5":14857,"_28357":128072,"_3076":128181},[],"Gestionar certificados para inspección, estado y revocación.",{"_3624":75306,"_31165":75255,"_21590":128183,"_5":14857,"_28357":128072,"_3076":128184},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3624":75307,"_31165":75255,"_21590":128186,"_5":14857,"_28357":128072,"_3076":128187},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3624":75308,"_31165":75255,"_21590":128189,"_5":14857,"_28357":128072,"_3076":128190},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3624":75309,"_31165":75309,"_5":15217,"_3076":128192,"_31523":128193,"_21590":128194,"_28357":75309},"Primeros pasos de PKI",[50932,121756,56618,125228],[],{"_3624":75310,"_31165":75309,"_21590":128196,"_5":14857,"_28357":75309,"_3076":128197},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3624":75311,"_31165":75309,"_5":31520,"_21590":128199,"_28357":128200,"_3076":120290},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3624":75312,"_31165":75309,"_5":31520,"_21590":128202,"_28357":128203,"_3076":128204},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3624":75313,"_31165":75309,"_5":31520,"_21590":128206,"_28357":128207,"_3076":125410},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3624":75314,"_31165":75309,"_5":31520,"_21590":128209,"_28357":128210,"_3076":128211},[],"/docs/pr-preview/pr-76/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3624":75315,"_31165":75309,"_21590":128213,"_5":14857,"_28357":75309,"_3076":128214},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3624":75316,"_31165":75309,"_21590":128216,"_5":14857,"_28357":128200,"_3076":128217},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3624":75317,"_31165":75309,"_21590":128219,"_5":14857,"_28357":128200,"_3076":128220},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3624":75318,"_31165":75309,"_21590":128222,"_5":14857,"_28357":128200,"_3076":128223},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3624":75319,"_31165":75309,"_21590":128225,"_5":14857,"_28357":128200,"_3076":128226},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3624":75320,"_31165":75309,"_21590":128228,"_5":14857,"_28357":128200,"_3076":128229},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3624":75321,"_31165":75309,"_21590":128231,"_5":14857,"_28357":128203,"_3076":128232},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3624":75322,"_31165":75309,"_21590":128234,"_5":14857,"_28357":128203,"_3076":128235},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3624":75323,"_31165":75309,"_21590":128237,"_5":14857,"_28357":128203,"_3076":128238},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3624":75324,"_31165":75309,"_21590":128240,"_5":14857,"_28357":128203,"_3076":128241},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3624":75325,"_31165":75309,"_21590":128243,"_5":14857,"_28357":128207,"_3076":128244},[],"Archivo o recurso",{"_3624":75326,"_31165":75309,"_21590":128246,"_5":14857,"_28357":128207,"_3076":125407},[],{"_3624":75327,"_31165":75309,"_21590":128248,"_5":14857,"_28357":128207,"_3076":128249},[],"CA raíz activa y `ca.pem`",{"_3624":75328,"_31165":75309,"_21590":128251,"_5":14857,"_28357":128207,"_3076":128252},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3624":75329,"_31165":75309,"_21590":128254,"_5":14857,"_28357":128207,"_3076":128255},[],"Certificado final y `device.crt`",{"_3624":75330,"_31165":75309,"_21590":128257,"_5":14857,"_28357":128207,"_3076":128258},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3624":75331,"_31165":75309,"_21590":128260,"_5":14857,"_28357":128207,"_3076":128261},[],"Clave privada `device.key`",{"_3624":75332,"_31165":75309,"_21590":128263,"_5":14857,"_28357":128207,"_3076":128264},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3624":75333,"_31165":75309,"_21590":128266,"_5":14857,"_28357":128207,"_3076":128267},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3624":75334,"_31165":75309,"_21590":128269,"_5":14857,"_28357":128210,"_3076":128270},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3624":75335,"_31165":75309,"_21590":128272,"_5":14857,"_28357":128210,"_3076":128273},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3624":75336,"_31165":75309,"_21590":128275,"_5":14857,"_28357":128210,"_3076":128276},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3624":75337,"_31165":75337,"_5":15217,"_3076":128278,"_31523":128279,"_21590":128281,"_28357":75337},"Resolución de problemas PKI",[50932,121756,56618,128280],"Resolución de problemas",[],{"_3624":75338,"_31165":75337,"_21590":128283,"_5":14857,"_28357":75337,"_3076":128284},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3624":75339,"_31165":75337,"_5":31520,"_21590":128286,"_28357":128287,"_3076":128288},[],"/docs/pr-preview/pr-76/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3624":75340,"_31165":75337,"_5":31520,"_21590":128290,"_28357":128291,"_3076":128292},[],"/docs/pr-preview/pr-76/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3624":75341,"_31165":75337,"_5":31520,"_21590":128294,"_28357":128295,"_3076":128296},[],"/docs/pr-preview/pr-76/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3624":75342,"_31165":75337,"_21590":128298,"_5":14857,"_28357":75337,"_3076":128299},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3624":75343,"_31165":75337,"_21590":128301,"_5":14857,"_28357":75337,"_3076":128302},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3624":75344,"_31165":75337,"_21590":128304,"_5":14857,"_28357":128287,"_3076":125407},[],{"_3624":75345,"_31165":75337,"_21590":128306,"_5":14857,"_28357":128287,"_3076":124073},[],{"_3624":75346,"_31165":75337,"_21590":128308,"_5":14857,"_28357":128287,"_3076":120314},[],{"_3624":75347,"_31165":75337,"_21590":128310,"_5":14857,"_28357":128287,"_3076":55460},[],{"_3624":75348,"_31165":75337,"_21590":128312,"_5":14857,"_28357":128287,"_3076":128313},[],"Existe, está activa y sus fechas son utilizables.",{"_3624":75349,"_31165":75337,"_21590":128315,"_5":14857,"_28357":128287,"_3076":128316},[],"Autoridades.",{"_3624":75350,"_31165":75337,"_21590":128318,"_5":14857,"_28357":128287,"_3076":128319},[],"Clave",{"_3624":75351,"_31165":75337,"_21590":128321,"_5":14857,"_28357":128287,"_3076":128322},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3624":75352,"_31165":75337,"_21590":128324,"_5":14857,"_28357":128287,"_3076":128325},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3624":75353,"_31165":75337,"_21590":128327,"_5":14857,"_28357":128287,"_3076":59203},[],{"_3624":75354,"_31165":75337,"_21590":128329,"_5":14857,"_28357":128287,"_3076":128330},[],"PEM correcto y firma verificable.",{"_3624":75355,"_31165":75337,"_21590":128332,"_5":14857,"_28357":128287,"_3076":59209},[],{"_3624":75356,"_31165":75337,"_21590":128334,"_5":14857,"_28357":128287,"_3076":128335},[],"Perfil",{"_3624":75357,"_31165":75337,"_21590":128337,"_5":14857,"_28357":128287,"_3076":128338},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3624":75358,"_31165":75337,"_21590":128340,"_5":14857,"_28357":128287,"_3076":128341},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3624":75359,"_31165":75337,"_21590":128343,"_5":14857,"_28357":128287,"_3076":125558},[],{"_3624":75360,"_31165":75337,"_21590":128345,"_5":14857,"_28357":128287,"_3076":128346},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3624":75361,"_31165":75337,"_21590":128348,"_5":14857,"_28357":128287,"_3076":128349},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3624":75362,"_31165":75337,"_21590":128351,"_5":14857,"_28357":128287,"_3076":128352},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3624":75363,"_31165":75337,"_21590":128354,"_5":14857,"_28357":128287,"_3076":128355},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3624":75364,"_31165":75337,"_21590":128357,"_5":14857,"_28357":128287,"_3076":128358},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3624":75365,"_31165":75337,"_21590":128360,"_5":14857,"_28357":128291,"_3076":128361},[],"Revisa cada frontera por separado:",{"_3624":75366,"_31165":75337,"_21590":128363,"_5":14857,"_28357":128291,"_3076":128364},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3624":75367,"_31165":75337,"_21590":128366,"_5":14857,"_28357":128291,"_3076":128367},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3624":75368,"_31165":75337,"_21590":128369,"_5":14857,"_28357":128291,"_3076":128370},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3624":75369,"_31165":75337,"_21590":128372,"_5":14857,"_28357":128291,"_3076":128373},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3624":75370,"_31165":75337,"_21590":128375,"_5":14857,"_28357":128291,"_3076":128376},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3624":75371,"_31165":75337,"_21590":128378,"_5":14857,"_28357":128291,"_3076":128379},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3624":75372,"_31165":75337,"_21590":128381,"_5":14857,"_28357":128295,"_3076":128382},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3624":75373,"_31165":75337,"_21590":128384,"_5":14857,"_28357":128295,"_3076":128385},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3624":75374,"_31165":75374,"_5":15217,"_3076":128387,"_31523":128388,"_21590":128389,"_28357":75374},"Seguridad",[50932],[],{"_3624":75375,"_31165":75374,"_21590":128391,"_5":14857,"_28357":75374,"_3076":128392},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3624":75376,"_31165":75374,"_5":31520,"_21590":128394,"_28357":128395,"_3076":128396},[],"/docs/pr-preview/pr-76/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3624":75377,"_31165":75374,"_5":31520,"_21590":128398,"_28357":128399,"_3076":128400},[],"/docs/pr-preview/pr-76/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3624":75378,"_31165":75374,"_5":31520,"_21590":128402,"_28357":128403,"_3076":128404},[],"/docs/pr-preview/pr-76/es/security#versiones-soportadas","Versiones soportadas",{"_3624":75379,"_31165":75374,"_5":31520,"_21590":128406,"_28357":128407,"_3076":128408},[],"/docs/pr-preview/pr-76/es/security#divulgación-responsable","Divulgación responsable",{"_3624":75380,"_31165":75374,"_21590":128410,"_5":14857,"_28357":75374,"_3076":128411},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3624":75381,"_31165":75374,"_21590":128413,"_5":14857,"_28357":128395,"_3076":128414},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3624":75382,"_31165":75374,"_21590":128416,"_5":14857,"_28357":128395,"_3076":128417},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3624":75383,"_31165":75374,"_21590":128419,"_5":14857,"_28357":128395,"_3076":15496},[],{"_3624":75384,"_31165":75374,"_21590":128421,"_5":14857,"_28357":128395,"_3076":15425},[],{"_3624":75385,"_31165":75374,"_21590":128423,"_5":14857,"_28357":128395,"_3076":15483},[],{"_3624":75386,"_31165":75374,"_21590":128425,"_5":14857,"_28357":128395,"_3076":128426},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3624":75387,"_31165":75374,"_21590":128428,"_5":14857,"_28357":128395,"_3076":128429},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3624":75388,"_31165":75374,"_21590":128431,"_5":14857,"_28357":128399,"_3076":128432},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3624":75389,"_31165":75374,"_21590":128434,"_5":14857,"_28357":128399,"_3076":128435},[],"No incluyas en el reporte:",{"_3624":75390,"_31165":75374,"_21590":128437,"_5":14857,"_28357":128399,"_3076":128438},[],"Credenciales, tokens o claves privadas",{"_3624":75391,"_31165":75374,"_21590":128440,"_5":14857,"_28357":128399,"_3076":128441},[],"Datos de clientes o información identificable de clientes",{"_3624":75392,"_31165":75374,"_21590":128443,"_5":14857,"_28357":128399,"_3076":128444},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3624":75393,"_31165":75374,"_21590":128446,"_5":14857,"_28357":128403,"_3076":128447},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3624":75394,"_31165":75374,"_21590":128449,"_5":14857,"_28357":128403,"_3076":128450},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3624":75395,"_31165":75374,"_21590":128452,"_5":14857,"_28357":128407,"_3076":128453},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3624":75396,"_31165":75374,"_21590":128455,"_5":14857,"_28357":128407,"_3076":128456},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3624":75397,"_31165":75374,"_21590":128458,"_5":14857,"_28357":128407,"_3076":128459},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3624":75398,"_31165":75374,"_21590":128461,"_5":14857,"_28357":128407,"_3076":128462},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3624":75399,"_31165":75374,"_21590":128464,"_5":14857,"_28357":128407,"_3076":128465},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3624":75400,"_31165":75400,"_5":15217,"_3076":128467,"_31523":128468,"_21590":128470,"_28357":75400},"3.8.0 a 4.0.0",[50932,128469],"Actualizaciones",[],{"_3624":75401,"_31165":75400,"_21590":128472,"_5":14857,"_28357":75400,"_3076":128473},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3624":75402,"_31165":75400,"_5":31520,"_21590":128475,"_28357":128476,"_3076":128477},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3624":75403,"_31165":75400,"_5":31520,"_21590":128479,"_28357":128480,"_3076":128481},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3624":75404,"_31165":75400,"_5":31520,"_21590":128483,"_28357":128484,"_3076":128485},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3624":75405,"_31165":75400,"_5":31520,"_21590":128487,"_28357":128488,"_3076":128489},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3624":75406,"_31165":75400,"_5":31520,"_21590":128491,"_28357":128492,"_3076":128493},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3624":75407,"_31165":75400,"_5":31520,"_21590":128495,"_28357":128496,"_3076":128497},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3624":75408,"_31165":75400,"_5":31520,"_21590":128499,"_28357":128500,"_3076":59378},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3624":75409,"_31165":75400,"_5":31520,"_21590":128502,"_28357":128503,"_3076":128504},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3624":75410,"_31165":75400,"_5":31520,"_21590":128506,"_28357":128507,"_3076":128508},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3624":75411,"_31165":75400,"_5":31520,"_21590":128510,"_28357":128511,"_3076":128512},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3624":75412,"_31165":75400,"_5":31520,"_21590":128514,"_28357":128515,"_3076":120885},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3624":75413,"_31165":75400,"_5":31520,"_21590":128517,"_28357":128518,"_3076":128519},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3624":75414,"_31165":75400,"_5":31520,"_21590":128521,"_28357":128522,"_3076":128523},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3624":75415,"_31165":75400,"_5":31520,"_21590":128525,"_28357":128526,"_3076":128527},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3624":75416,"_31165":75400,"_5":31520,"_21590":128529,"_28357":128530,"_3076":128531},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3624":75417,"_31165":75400,"_5":31520,"_21590":128533,"_28357":128534,"_3076":128535},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3624":75418,"_31165":75400,"_5":31520,"_21590":128537,"_28357":128538,"_3076":128539},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3624":75419,"_31165":75400,"_5":31520,"_21590":128541,"_28357":128542,"_3076":128543},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3624":75420,"_31165":75400,"_5":31520,"_21590":128545,"_28357":128546,"_3076":128547},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3624":75421,"_31165":75400,"_5":31520,"_21590":128549,"_28357":128550,"_3076":128551},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3624":75422,"_31165":75400,"_5":31520,"_21590":128553,"_28357":128554,"_3076":128555},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3624":75423,"_31165":75400,"_5":31520,"_21590":128557,"_28357":128558,"_3076":128559},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3624":75424,"_31165":75400,"_5":31520,"_21590":128561,"_28357":128562,"_3076":128563},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3624":75425,"_31165":75400,"_5":31520,"_21590":128565,"_28357":128566,"_3076":128567},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3624":75426,"_31165":75400,"_5":31520,"_21590":128569,"_28357":128570,"_3076":128571},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3624":75427,"_31165":75400,"_5":31520,"_21590":128573,"_28357":128574,"_3076":128575},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3624":75428,"_31165":75400,"_5":31520,"_21590":128577,"_28357":128578,"_3076":128579},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3624":75429,"_31165":75400,"_5":31520,"_21590":128581,"_28357":128582,"_3076":128583},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3624":75430,"_31165":75400,"_5":31520,"_21590":128585,"_28357":128586,"_3076":128587},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3624":75431,"_31165":75400,"_5":31520,"_21590":128589,"_28357":128590,"_3076":128591},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3624":75432,"_31165":75400,"_5":31520,"_21590":128593,"_28357":128594,"_3076":128595},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3624":75433,"_31165":75400,"_5":31520,"_21590":128597,"_28357":128598,"_3076":128599},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3624":75434,"_31165":75400,"_5":31520,"_21590":128601,"_28357":128602,"_3076":128603},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3624":75435,"_31165":75400,"_5":31520,"_21590":128605,"_28357":128606,"_3076":128607},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3624":75436,"_31165":75400,"_5":31520,"_21590":128609,"_28357":128610,"_3076":128611},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3624":75437,"_31165":75400,"_5":31520,"_21590":128613,"_28357":128614,"_3076":128615},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3624":75438,"_31165":75400,"_5":31520,"_21590":128617,"_28357":128618,"_3076":128619},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3624":75439,"_31165":75400,"_5":31520,"_21590":128621,"_28357":128622,"_3076":128623},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3624":75440,"_31165":75400,"_5":31520,"_21590":128625,"_28357":128626,"_3076":128627},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3624":75441,"_31165":75400,"_5":31520,"_21590":128629,"_28357":128630,"_3076":128631},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3624":75442,"_31165":75400,"_5":31520,"_21590":128633,"_28357":128634,"_3076":128635},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3624":75443,"_31165":75400,"_5":31520,"_21590":128637,"_28357":128638,"_3076":128639},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3624":75444,"_31165":75400,"_5":31520,"_21590":128641,"_28357":128642,"_3076":128643},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3624":75445,"_31165":75400,"_5":31520,"_21590":128645,"_28357":128646,"_3076":128647},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3624":75446,"_31165":75400,"_5":31520,"_21590":128649,"_28357":128650,"_3076":124421},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3624":75447,"_31165":75400,"_5":31520,"_21590":128652,"_28357":128653,"_3076":128654},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3624":75448,"_31165":75400,"_5":31520,"_21590":128656,"_28357":128657,"_3076":128658},[],"/docs/pr-preview/pr-76/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3624":75449,"_31165":75400,"_21590":128660,"_5":14857,"_28357":75400,"_3076":128661},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3624":75450,"_31165":75400,"_21590":128663,"_5":14857,"_28357":75400,"_3076":128664},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3624":75451,"_31165":75400,"_21590":128666,"_5":14857,"_28357":75400,"_3076":128667},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3624":75452,"_31165":75400,"_21590":128669,"_5":14857,"_28357":75400,"_3076":128670},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3624":75453,"_31165":75400,"_21590":128672,"_5":14857,"_28357":75400,"_3076":128673},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3624":75454,"_31165":75400,"_21590":128675,"_5":14857,"_28357":75400,"_3076":128676},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3624":75455,"_31165":75400,"_21590":128678,"_5":14857,"_28357":75400,"_3076":128679},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3624":75456,"_31165":75400,"_21590":128681,"_5":14857,"_28357":128480,"_3076":128682},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3624":75457,"_31165":75400,"_21590":128684,"_5":14857,"_28357":128480,"_3076":128685},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3624":75458,"_31165":75400,"_21590":128687,"_5":14857,"_28357":128484,"_3076":128688},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3624":75459,"_31165":75400,"_21590":128690,"_5":14857,"_28357":128484,"_3076":128691},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3624":75460,"_31165":75400,"_21590":128693,"_5":14857,"_28357":128488,"_3076":128694},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3624":75461,"_31165":75400,"_21590":128696,"_5":14857,"_28357":128492,"_3076":128697},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3624":75462,"_31165":75400,"_21590":128699,"_5":14857,"_28357":128492,"_3076":128700},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3624":75463,"_31165":75400,"_21590":128702,"_5":14857,"_28357":128492,"_3076":128703},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3624":75464,"_31165":75400,"_21590":128705,"_5":14857,"_28357":128492,"_3076":128706},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3624":75465,"_31165":75400,"_21590":128708,"_5":14857,"_28357":128492,"_3076":128709},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3624":75466,"_31165":75400,"_21590":128711,"_5":14857,"_28357":128496,"_3076":128712},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3624":75467,"_31165":75400,"_21590":128714,"_5":14857,"_28357":128496,"_3076":128715},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3624":75468,"_31165":75400,"_21590":128717,"_5":14857,"_28357":128496,"_3076":128718},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3624":75469,"_31165":75400,"_21590":128720,"_5":14857,"_28357":128496,"_3076":128721},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3624":75470,"_31165":75400,"_21590":128723,"_5":14857,"_28357":128496,"_3076":128724},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3624":75471,"_31165":75400,"_21590":128726,"_5":14857,"_28357":128496,"_3076":128727},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3624":75472,"_31165":75400,"_21590":128729,"_5":14857,"_28357":128500,"_3076":128730},[],"Cambio",{"_3624":75473,"_31165":75400,"_21590":128732,"_5":14857,"_28357":128500,"_3076":128733},[],"A quién afecta",{"_3624":75474,"_31165":75400,"_21590":128735,"_5":14857,"_28357":128500,"_3076":128736},[],"Gravedad",{"_3624":75475,"_31165":75400,"_21590":128738,"_5":14857,"_28357":128500,"_3076":127209},[],{"_3624":75476,"_31165":75400,"_21590":128740,"_5":14857,"_28357":128500,"_3076":128508},[],{"_3624":75477,"_31165":75400,"_21590":128742,"_5":14857,"_28357":128500,"_3076":128743},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3624":75478,"_31165":75400,"_21590":128745,"_5":14857,"_28357":128500,"_3076":128746},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3624":75479,"_31165":75400,"_21590":128748,"_5":14857,"_28357":128500,"_3076":128749},[],"Copiar los datos a los volúmenes nuevos",{"_3624":75480,"_31165":75400,"_21590":128751,"_5":14857,"_28357":128500,"_3076":128512},[],{"_3624":75481,"_31165":75400,"_21590":128753,"_5":14857,"_28357":128500,"_3076":128754},[],"Todas las releases de Helm",{"_3624":75482,"_31165":75400,"_21590":128756,"_5":14857,"_28357":128500,"_3076":128757},[],"Alta: `helm upgrade` falla",{"_3624":75483,"_31165":75400,"_21590":128759,"_5":14857,"_28357":128500,"_3076":128760},[],"Eliminar o renombrar las claves heredadas",{"_3624":75484,"_31165":75400,"_21590":128762,"_5":14857,"_28357":128500,"_3076":120885},[],{"_3624":75485,"_31165":75400,"_21590":128764,"_5":14857,"_28357":128500,"_3076":128754},[],{"_3624":75486,"_31165":75400,"_21590":128766,"_5":14857,"_28357":128500,"_3076":128767},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3624":75487,"_31165":75400,"_21590":128769,"_5":14857,"_28357":128500,"_3076":128770},[],"Crear primero los Secrets; consulta el paso 2",{"_3624":75488,"_31165":75400,"_21590":128772,"_5":14857,"_28357":128500,"_3076":128519},[],{"_3624":75489,"_31165":75400,"_21590":128774,"_5":14857,"_28357":128500,"_3076":128775},[],"Todos los despliegues",{"_3624":75490,"_31165":75400,"_21590":128777,"_5":14857,"_28357":128500,"_3076":128778},[],"Alta: sin principal de bootstrap no hay administrador",{"_3624":75491,"_31165":75400,"_21590":128780,"_5":14857,"_28357":128500,"_3076":128781},[],"Configurar `services.authz`",{"_3624":75492,"_31165":75400,"_21590":128783,"_5":14857,"_28357":128500,"_3076":128523},[],{"_3624":75493,"_31165":75400,"_21590":128785,"_5":14857,"_28357":128500,"_3076":128754},[],{"_3624":75494,"_31165":75400,"_21590":128787,"_5":14857,"_28357":128500,"_3076":128788},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3624":75495,"_31165":75400,"_21590":128790,"_5":14857,"_28357":128500,"_3076":128791},[],"Mover JWKS y roles a `services.authz`",{"_3624":75496,"_31165":75400,"_21590":128793,"_5":14857,"_28357":128500,"_3076":128543},[],{"_3624":75497,"_31165":75400,"_21590":128795,"_5":14857,"_28357":128500,"_3076":128796},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3624":75498,"_31165":75400,"_21590":128798,"_5":14857,"_28357":128500,"_3076":128799},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3624":75499,"_31165":75400,"_21590":128801,"_5":14857,"_28357":128500,"_3076":128802},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3624":75500,"_31165":75400,"_21590":128804,"_5":14857,"_28357":128500,"_3076":128547},[],{"_3624":75501,"_31165":75400,"_21590":128806,"_5":14857,"_28357":128500,"_3076":128807},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3624":75502,"_31165":75400,"_21590":128809,"_5":14857,"_28357":128500,"_3076":128810},[],"Alta: el backend ya no arranca con ellos",{"_3624":75503,"_31165":75400,"_21590":128812,"_5":14857,"_28357":128500,"_3076":128813},[],"Pasar a PostgreSQL antes de actualizar",{"_3624":75504,"_31165":75400,"_21590":128815,"_5":14857,"_28357":128500,"_3076":128595},[],{"_3624":75505,"_31165":75400,"_21590":128817,"_5":14857,"_28357":128500,"_3076":128818},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3624":75506,"_31165":75400,"_21590":128820,"_5":14857,"_28357":128500,"_3076":128821},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3624":75507,"_31165":75400,"_21590":128823,"_5":14857,"_28357":128500,"_3076":128824},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3624":75508,"_31165":75400,"_21590":128826,"_5":14857,"_28357":128500,"_3076":128827},[],"Webhooks con referencias a archivos",{"_3624":75509,"_31165":75400,"_21590":128829,"_5":14857,"_28357":128500,"_3076":128830},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3624":75510,"_31165":75400,"_21590":128832,"_5":14857,"_28357":128500,"_3076":128833},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3624":75511,"_31165":75400,"_21590":128835,"_5":14857,"_28357":128500,"_3076":128836},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3624":75512,"_31165":75400,"_21590":128838,"_5":14857,"_28357":128500,"_3076":128527},[],{"_3624":75513,"_31165":75400,"_21590":128840,"_5":14857,"_28357":128500,"_3076":128841},[],"Releases con identidades por servicio o material de claves montado",{"_3624":75514,"_31165":75400,"_21590":128843,"_5":14857,"_28357":128500,"_3076":128844},[],"Media: los servicios no pueden leer sus archivos",{"_3624":75515,"_31165":75400,"_21590":128846,"_5":14857,"_28357":128500,"_3076":128847},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3624":75516,"_31165":75400,"_21590":128849,"_5":14857,"_28357":128500,"_3076":128531},[],{"_3624":75517,"_31165":75400,"_21590":128851,"_5":14857,"_28357":128500,"_3076":128852},[],"Releases que definen `amqp.tls`",{"_3624":75518,"_31165":75400,"_21590":128854,"_5":14857,"_28357":128500,"_3076":128855},[],"Media: los clientes se conectan al puerto equivocado",{"_3624":75519,"_31165":75400,"_21590":128857,"_5":14857,"_28357":128500,"_3076":128858},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3624":75520,"_31165":75400,"_21590":128860,"_5":14857,"_28357":128500,"_3076":128551},[],{"_3624":75521,"_31165":75400,"_21590":128862,"_5":14857,"_28357":128500,"_3076":128863},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3624":75522,"_31165":75400,"_21590":128865,"_5":14857,"_28357":128500,"_3076":128866},[],"Media: las claves de CA quedan sin gestionar",{"_3624":75523,"_31165":75400,"_21590":128868,"_5":14857,"_28357":128500,"_3076":128869},[],"Ejecutar la migración de CA a KMS",{"_3624":75524,"_31165":75400,"_21590":128871,"_5":14857,"_28357":128500,"_3076":128872},[],"Verificación del certificado del receptor",{"_3624":75525,"_31165":75400,"_21590":128874,"_5":14857,"_28357":128500,"_3076":128875},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3624":75526,"_31165":75400,"_21590":128877,"_5":14857,"_28357":128500,"_3076":128878},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3624":75527,"_31165":75400,"_21590":128880,"_5":14857,"_28357":128500,"_3076":128881},[],"Poner `insecure_skip_verify` a `false`",{"_3624":75528,"_31165":75400,"_21590":128883,"_5":14857,"_28357":128500,"_3076":128567},[],{"_3624":75529,"_31165":75400,"_21590":128885,"_5":14857,"_28357":128500,"_3076":128886},[],"Scripts y consolas que editan DMS por API",{"_3624":75530,"_31165":75400,"_21590":128888,"_5":14857,"_28357":128500,"_3076":128889},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3624":75531,"_31165":75400,"_21590":128891,"_5":14857,"_28357":128500,"_3076":128892},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3624":75532,"_31165":75400,"_21590":128894,"_5":14857,"_28357":128500,"_3076":128571},[],{"_3624":75533,"_31165":75400,"_21590":128896,"_5":14857,"_28357":128500,"_3076":128897},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3624":75534,"_31165":75400,"_21590":128899,"_5":14857,"_28357":128500,"_3076":128900},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3624":75535,"_31165":75400,"_21590":128902,"_5":14857,"_28357":128500,"_3076":128903},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3624":75536,"_31165":75400,"_21590":128905,"_5":14857,"_28357":128500,"_3076":128591},[],{"_3624":75537,"_31165":75400,"_21590":128907,"_5":14857,"_28357":128500,"_3076":128908},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3624":75538,"_31165":75400,"_21590":128910,"_5":14857,"_28357":128500,"_3076":128911},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3624":75539,"_31165":75400,"_21590":128913,"_5":14857,"_28357":128500,"_3076":128914},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3624":75540,"_31165":75400,"_21590":128916,"_5":14857,"_28357":128500,"_3076":128599},[],{"_3624":75541,"_31165":75400,"_21590":128918,"_5":14857,"_28357":128500,"_3076":128919},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3624":75542,"_31165":75400,"_21590":128921,"_5":14857,"_28357":128500,"_3076":128922},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3624":75543,"_31165":75400,"_21590":128924,"_5":14857,"_28357":128500,"_3076":128925},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3624":75544,"_31165":75400,"_21590":128927,"_5":14857,"_28357":128500,"_3076":128603},[],{"_3624":75545,"_31165":75400,"_21590":128929,"_5":14857,"_28357":128500,"_3076":128930},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3624":75546,"_31165":75400,"_21590":128932,"_5":14857,"_28357":128500,"_3076":128933},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3624":75547,"_31165":75400,"_21590":128935,"_5":14857,"_28357":128500,"_3076":128936},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3624":75548,"_31165":75400,"_21590":128938,"_5":14857,"_28357":128500,"_3076":128587},[],{"_3624":75549,"_31165":75400,"_21590":128940,"_5":14857,"_28357":128500,"_3076":128941},[],"Consumidores que leen el campo `events` del dispositivo",{"_3624":75550,"_31165":75400,"_21590":128943,"_5":14857,"_28357":128500,"_3076":128944},[],"Media: el campo desaparece",{"_3624":75551,"_31165":75400,"_21590":128946,"_5":14857,"_28357":128500,"_3076":128947},[],"Usar los nuevos endpoints de eventos",{"_3624":75552,"_31165":75400,"_21590":128949,"_5":14857,"_28357":128500,"_3076":128615},[],{"_3624":75553,"_31165":75400,"_21590":128951,"_5":14857,"_28357":128500,"_3076":128952},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3624":75554,"_31165":75400,"_21590":128954,"_5":14857,"_28357":128500,"_3076":128955},[],"Media: la migración de la VA aborta",{"_3624":75555,"_31165":75400,"_21590":128957,"_5":14857,"_28357":128500,"_3076":128958},[],"Corregir los roles afectados antes de actualizar",{"_3624":75556,"_31165":75400,"_21590":128960,"_5":14857,"_28357":128500,"_3076":128535},[],{"_3624":75557,"_31165":75400,"_21590":128962,"_5":14857,"_28357":128500,"_3076":128963},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3624":75558,"_31165":75400,"_21590":128965,"_5":14857,"_28357":128500,"_3076":128966},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3624":75559,"_31165":75400,"_21590":128968,"_5":14857,"_28357":128500,"_3076":128969},[],"Actualizar el archivo de values",{"_3624":75560,"_31165":75400,"_21590":128971,"_5":14857,"_28357":128500,"_3076":128579},[],{"_3624":75561,"_31165":75400,"_21590":128973,"_5":14857,"_28357":128500,"_3076":128974},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3624":75562,"_31165":75400,"_21590":128976,"_5":14857,"_28357":128500,"_3076":128977},[],"Baja: prevalece el ID de la URL",{"_3624":75563,"_31165":75400,"_21590":128979,"_5":14857,"_28357":128500,"_3076":128980},[],"Enviar el ID en la URL",{"_3624":75564,"_31165":75400,"_21590":128982,"_5":14857,"_28357":128500,"_3076":128607},[],{"_3624":75565,"_31165":75400,"_21590":128984,"_5":14857,"_28357":128500,"_3076":128985},[],"Clientes que envían un `id` al crear o importar CAs",{"_3624":75566,"_31165":75400,"_21590":128987,"_5":14857,"_28357":128500,"_3076":128988},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3624":75567,"_31165":75400,"_21590":128990,"_5":14857,"_28357":128500,"_3076":128991},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3624":75568,"_31165":75400,"_21590":128993,"_5":14857,"_28357":128500,"_3076":128611},[],{"_3624":75569,"_31165":75400,"_21590":128995,"_5":14857,"_28357":128500,"_3076":128996},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3624":75570,"_31165":75400,"_21590":128998,"_5":14857,"_28357":128500,"_3076":128999},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3624":75571,"_31165":75400,"_21590":129001,"_5":14857,"_28357":128500,"_3076":129002},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3624":75572,"_31165":75400,"_21590":129004,"_5":14857,"_28357":128500,"_3076":128583},[],{"_3624":75573,"_31165":75400,"_21590":129006,"_5":14857,"_28357":128500,"_3076":129007},[],"Consumidores que comparan el `type` del certificado",{"_3624":75574,"_31165":75400,"_21590":129009,"_5":14857,"_28357":128500,"_3076":129010},[],"Baja: dos valores cambian de nombre",{"_3624":75575,"_31165":75400,"_21590":129012,"_5":14857,"_28357":128500,"_3076":129013},[],"Adaptar los consumidores",{"_3624":75576,"_31165":75400,"_21590":129015,"_5":14857,"_28357":128500,"_3076":128575},[],{"_3624":75577,"_31165":75400,"_21590":129017,"_5":14857,"_28357":128500,"_3076":129018},[],"Cualquier DMS",{"_3624":75578,"_31165":75400,"_21590":129020,"_5":14857,"_28357":128500,"_3076":129021},[],"Baja: solo informativo",{"_3624":75579,"_31165":75400,"_21590":129023,"_5":14857,"_28357":128500,"_3076":129024},[],"Revisar ambos bloques antes de editar",{"_3624":75580,"_31165":75400,"_21590":129026,"_5":14857,"_28357":128507,"_3076":129027},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3624":75581,"_31165":75400,"_21590":129029,"_5":14857,"_28357":128507,"_3076":129030},[],"El paso 4 de la guía de migración copia los datos.",{"_3624":75582,"_31165":75400,"_21590":129032,"_5":14857,"_28357":128511,"_3076":129033},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3624":75583,"_31165":75400,"_21590":129035,"_5":14857,"_28357":128515,"_3076":129036},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3624":75584,"_31165":75400,"_21590":129038,"_5":14857,"_28357":128515,"_3076":129039},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3624":75585,"_31165":75400,"_21590":129041,"_5":14857,"_28357":128518,"_3076":129042},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3624":75586,"_31165":75400,"_21590":129044,"_5":14857,"_28357":128522,"_3076":129045},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3624":75587,"_31165":75400,"_21590":129047,"_5":14857,"_28357":128526,"_3076":129048},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3624":75588,"_31165":75400,"_21590":129050,"_5":14857,"_28357":128526,"_3076":129051},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3624":75589,"_31165":75400,"_21590":129053,"_5":14857,"_28357":128526,"_3076":129054},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3624":75590,"_31165":75400,"_21590":129056,"_5":14857,"_28357":128530,"_3076":129057},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3624":75591,"_31165":75400,"_21590":129059,"_5":14857,"_28357":128534,"_3076":129060},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3624":75592,"_31165":75400,"_21590":129062,"_5":14857,"_28357":128534,"_3076":129063},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3624":75593,"_31165":75400,"_21590":129065,"_5":14857,"_28357":128534,"_3076":129066},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3624":75594,"_31165":75400,"_21590":129068,"_5":14857,"_28357":128534,"_3076":129069},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3624":75595,"_31165":75400,"_21590":129071,"_5":14857,"_28357":128534,"_3076":129072},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3624":75596,"_31165":75400,"_21590":129074,"_5":14857,"_28357":128534,"_3076":129075},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3624":75597,"_31165":75400,"_21590":129077,"_5":14857,"_28357":128542,"_3076":129078},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3624":75598,"_31165":75400,"_21590":129080,"_5":14857,"_28357":128542,"_3076":129081},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3624":75599,"_31165":75400,"_21590":129083,"_5":14857,"_28357":128542,"_3076":129084},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3624":75600,"_31165":75400,"_21590":129086,"_5":14857,"_28357":128542,"_3076":129087},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3624":75601,"_31165":75400,"_21590":129089,"_5":14857,"_28357":128542,"_3076":129090},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3624":75602,"_31165":75400,"_21590":129092,"_5":14857,"_28357":128546,"_3076":129093},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3624":75603,"_31165":75400,"_21590":129095,"_5":14857,"_28357":128550,"_3076":129096},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3624":75604,"_31165":75400,"_21590":129098,"_5":14857,"_28357":128550,"_3076":129099},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3624":75605,"_31165":75400,"_21590":129101,"_5":14857,"_28357":128550,"_3076":129102},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3624":75606,"_31165":75400,"_21590":129104,"_5":14857,"_28357":128550,"_3076":129105},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3624":75607,"_31165":75400,"_21590":129107,"_5":14857,"_28357":128550,"_3076":129108},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3624":75608,"_31165":75400,"_21590":129110,"_5":14857,"_28357":128550,"_3076":129111},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3624":75609,"_31165":75400,"_21590":129113,"_5":14857,"_28357":128550,"_3076":129114},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3624":75610,"_31165":75400,"_21590":129116,"_5":14857,"_28357":128550,"_3076":129117},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3624":75611,"_31165":75400,"_21590":129119,"_5":14857,"_28357":128554,"_3076":129120},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3624":75612,"_31165":75400,"_21590":129122,"_5":14857,"_28357":128562,"_3076":129123},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3624":75613,"_31165":75400,"_21590":129125,"_5":14857,"_28357":128562,"_3076":129126},[],"Campo en 3.8.0",{"_3624":75614,"_31165":75400,"_21590":129128,"_5":14857,"_28357":128562,"_3076":129129},[],"Campo en 4.0.0",{"_3624":75615,"_31165":75400,"_21590":129131,"_5":14857,"_28357":128562,"_3076":60009},[],{"_3624":75616,"_31165":75400,"_21590":129133,"_5":14857,"_28357":128562,"_3076":129134},[],"`insecure_skip_verify` (con el valor negado)",{"_3624":75617,"_31165":75400,"_21590":129136,"_5":14857,"_28357":128562,"_3076":60015},[],{"_3624":75618,"_31165":75400,"_21590":129138,"_5":14857,"_28357":128562,"_3076":60018},[],{"_3624":75619,"_31165":75400,"_21590":129140,"_5":14857,"_28357":128562,"_3076":60021},[],{"_3624":75620,"_31165":75400,"_21590":129142,"_5":14857,"_28357":128562,"_3076":60024},[],{"_3624":75621,"_31165":75400,"_21590":129144,"_5":14857,"_28357":128562,"_3076":60027},[],{"_3624":75622,"_31165":75400,"_21590":129146,"_5":14857,"_28357":128562,"_3076":60030},[],{"_3624":75623,"_31165":75400,"_21590":129148,"_5":14857,"_28357":128562,"_3076":129149},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3624":75624,"_31165":75400,"_21590":129151,"_5":14857,"_28357":128562,"_3076":129152},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3624":75625,"_31165":75400,"_21590":129154,"_5":14857,"_28357":128562,"_3076":129155},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3624":75626,"_31165":75400,"_21590":129157,"_5":14857,"_28357":128566,"_3076":129158},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3624":75627,"_31165":75400,"_21590":129160,"_5":14857,"_28357":128566,"_3076":129161},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3624":75628,"_31165":75400,"_21590":129163,"_5":14857,"_28357":128566,"_3076":129164},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3624":75629,"_31165":75400,"_21590":129166,"_5":14857,"_28357":128570,"_3076":129167},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3624":75630,"_31165":75400,"_21590":129169,"_5":14857,"_28357":128570,"_3076":129170},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3624":75631,"_31165":75400,"_21590":129172,"_5":14857,"_28357":128574,"_3076":129173},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3624":75632,"_31165":75400,"_21590":129175,"_5":14857,"_28357":128578,"_3076":129176},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3624":75633,"_31165":75400,"_21590":129178,"_5":14857,"_28357":128582,"_3076":129179},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3624":75634,"_31165":75400,"_21590":129181,"_5":14857,"_28357":128586,"_3076":129182},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3624":75635,"_31165":75400,"_21590":129184,"_5":14857,"_28357":128586,"_3076":129185},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3624":75636,"_31165":75400,"_21590":129187,"_5":14857,"_28357":128586,"_3076":129188},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3624":75637,"_31165":75400,"_21590":129190,"_5":14857,"_28357":128586,"_3076":129191},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3624":75638,"_31165":75400,"_21590":129193,"_5":14857,"_28357":128590,"_3076":129194},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3624":75639,"_31165":75400,"_21590":129196,"_5":14857,"_28357":128594,"_3076":129197},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3624":75640,"_31165":75400,"_21590":129199,"_5":14857,"_28357":128594,"_3076":129200},[],"Ruta",{"_3624":75641,"_31165":75400,"_21590":129202,"_5":14857,"_28357":128594,"_3076":121516},[],{"_3624":75642,"_31165":75400,"_21590":129204,"_5":14857,"_28357":128594,"_3076":60089},[],{"_3624":75643,"_31165":75400,"_21590":129206,"_5":14857,"_28357":128594,"_3076":129207},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3624":75644,"_31165":75400,"_21590":129209,"_5":14857,"_28357":128594,"_3076":60095},[],{"_3624":75645,"_31165":75400,"_21590":129211,"_5":14857,"_28357":128594,"_3076":129212},[],"Lee los ajustes de una CA.",{"_3624":75646,"_31165":75400,"_21590":129214,"_5":14857,"_28357":128594,"_3076":60101},[],{"_3624":75647,"_31165":75400,"_21590":129216,"_5":14857,"_28357":128594,"_3076":129217},[],"Sustituye los `crl_options`.",{"_3624":75648,"_31165":75400,"_21590":129219,"_5":14857,"_28357":128594,"_3076":60107},[],{"_3624":75649,"_31165":75400,"_21590":129221,"_5":14857,"_28357":128594,"_3076":129222},[],"Elimina los ajustes archivados de una CA.",{"_3624":75650,"_31165":75400,"_21590":129224,"_5":14857,"_28357":128594,"_3076":129225},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3624":75651,"_31165":75400,"_21590":129227,"_5":14857,"_28357":128594,"_3076":129228},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3624":75652,"_31165":75400,"_21590":129230,"_5":14857,"_28357":128594,"_3076":129231},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3624":75653,"_31165":75400,"_21590":129233,"_5":14857,"_28357":128594,"_3076":129234},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3624":75654,"_31165":75400,"_21590":129236,"_5":14857,"_28357":128594,"_3076":129237},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3624":75655,"_31165":75400,"_21590":129239,"_5":14857,"_28357":128594,"_3076":129240},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3624":75656,"_31165":75400,"_21590":129242,"_5":14857,"_28357":128594,"_3076":129243},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3624":75657,"_31165":75400,"_21590":129245,"_5":14857,"_28357":128594,"_3076":129246},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3624":75658,"_31165":75400,"_21590":129248,"_5":14857,"_28357":128594,"_3076":129249},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3624":75659,"_31165":75400,"_21590":129251,"_5":14857,"_28357":128594,"_3076":129252},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3624":75660,"_31165":75400,"_21590":129254,"_5":14857,"_28357":128594,"_3076":129255},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3624":75661,"_31165":75400,"_21590":129257,"_5":14857,"_28357":128598,"_3076":129258},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3624":75662,"_31165":75400,"_21590":129260,"_5":14857,"_28357":128602,"_3076":129261},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3624":75663,"_31165":75400,"_21590":129263,"_5":14857,"_28357":128606,"_3076":129264},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3624":75664,"_31165":75400,"_21590":129266,"_5":14857,"_28357":128610,"_3076":129267},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3624":75665,"_31165":75400,"_21590":129269,"_5":14857,"_28357":128610,"_3076":129270},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3624":75666,"_31165":75400,"_21590":129272,"_5":14857,"_28357":128614,"_3076":129273},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3624":75667,"_31165":75400,"_21590":129275,"_5":14857,"_28357":128618,"_3076":129276},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3624":75668,"_31165":75400,"_21590":129278,"_5":14857,"_28357":128622,"_3076":129279},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3624":75669,"_31165":75400,"_21590":129281,"_5":14857,"_28357":128622,"_3076":129282},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3624":75670,"_31165":75400,"_21590":129284,"_5":14857,"_28357":128622,"_3076":129285},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3624":75671,"_31165":75400,"_21590":129287,"_5":14857,"_28357":128622,"_3076":129288},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3624":75672,"_31165":75400,"_21590":129290,"_5":14857,"_28357":128622,"_3076":129291},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3624":75673,"_31165":75400,"_21590":129293,"_5":14857,"_28357":128622,"_3076":129294},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3624":75674,"_31165":75400,"_21590":129296,"_5":14857,"_28357":128626,"_3076":129297},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3624":75675,"_31165":75400,"_21590":129299,"_5":14857,"_28357":128626,"_3076":129300},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3624":75676,"_31165":75400,"_21590":129302,"_5":14857,"_28357":128626,"_3076":129303},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3624":75677,"_31165":75400,"_21590":129305,"_5":14857,"_28357":128626,"_3076":129306},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3624":75678,"_31165":75400,"_21590":129308,"_5":14857,"_28357":128626,"_3076":129309},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3624":75679,"_31165":75400,"_21590":129311,"_5":14857,"_28357":128630,"_3076":129312},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3624":75680,"_31165":75400,"_21590":129314,"_5":14857,"_28357":128630,"_3076":129315},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3624":75681,"_31165":75400,"_21590":129317,"_5":14857,"_28357":128630,"_3076":129318},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3624":75682,"_31165":75400,"_21590":129320,"_5":14857,"_28357":128630,"_3076":60209},[],{"_3624":75683,"_31165":75400,"_21590":129322,"_5":14857,"_28357":128630,"_3076":129323},[],"Claves de datos obligatorias",{"_3624":75684,"_31165":75400,"_21590":129325,"_5":14857,"_28357":128630,"_3076":129326},[],"Cuándo",{"_3624":75685,"_31165":75400,"_21590":129328,"_5":14857,"_28357":128630,"_3076":129329},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3624":75686,"_31165":75400,"_21590":129331,"_5":14857,"_28357":128630,"_3076":60221},[],{"_3624":75687,"_31165":75400,"_21590":129333,"_5":14857,"_28357":128630,"_3076":129334},[],"Siempre",{"_3624":75688,"_31165":75400,"_21590":129336,"_5":14857,"_28357":128630,"_3076":129337},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3624":75689,"_31165":75400,"_21590":129339,"_5":14857,"_28357":128630,"_3076":60221},[],{"_3624":75690,"_31165":75400,"_21590":129341,"_5":14857,"_28357":128630,"_3076":129334},[],{"_3624":75691,"_31165":75400,"_21590":129343,"_5":14857,"_28357":128630,"_3076":60234},[],{"_3624":75692,"_31165":75400,"_21590":129345,"_5":14857,"_28357":128630,"_3076":60221},[],{"_3624":75693,"_31165":75400,"_21590":129347,"_5":14857,"_28357":128630,"_3076":129348},[],"Solo cuando hay autenticación SMTP",{"_3624":75694,"_31165":75400,"_21590":129350,"_5":14857,"_28357":128630,"_3076":129351},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3624":75695,"_31165":75400,"_21590":129353,"_5":14857,"_28357":128630,"_3076":129354},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3624":75696,"_31165":75400,"_21590":129356,"_5":14857,"_28357":128630,"_3076":129357},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3624":75697,"_31165":75400,"_21590":129359,"_5":14857,"_28357":128630,"_3076":129360},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3624":75698,"_31165":75400,"_21590":129362,"_5":14857,"_28357":128630,"_3076":129363},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3624":75699,"_31165":75400,"_21590":129365,"_5":14857,"_28357":128630,"_3076":129366},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3624":75700,"_31165":75400,"_21590":129368,"_5":14857,"_28357":128630,"_3076":129369},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3624":75701,"_31165":75400,"_21590":129371,"_5":14857,"_28357":128630,"_3076":129372},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3624":75702,"_31165":75400,"_21590":129374,"_5":14857,"_28357":128630,"_3076":129375},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3624":75703,"_31165":75400,"_21590":129377,"_5":14857,"_28357":128630,"_3076":129378},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3624":75704,"_31165":75400,"_21590":129380,"_5":14857,"_28357":128630,"_3076":129381},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3624":75705,"_31165":75400,"_21590":129383,"_5":14857,"_28357":128630,"_3076":129384},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3624":75706,"_31165":75400,"_21590":129386,"_5":14857,"_28357":128630,"_3076":129387},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3624":75707,"_31165":75400,"_21590":129389,"_5":14857,"_28357":128630,"_3076":129390},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3624":75708,"_31165":75400,"_21590":129392,"_5":14857,"_28357":128630,"_3076":129393},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3624":75709,"_31165":75400,"_21590":129395,"_5":14857,"_28357":128634,"_3076":129396},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3624":75710,"_31165":75400,"_21590":129398,"_5":14857,"_28357":128634,"_3076":129399},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3624":75711,"_31165":75400,"_21590":129401,"_5":14857,"_28357":128638,"_3076":129402},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3624":75712,"_31165":75400,"_21590":129404,"_5":14857,"_28357":128638,"_3076":129405},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3624":75713,"_31165":75400,"_21590":129407,"_5":14857,"_28357":128638,"_3076":129408},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3624":75714,"_31165":75400,"_21590":129410,"_5":14857,"_28357":128638,"_3076":129411},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3624":75715,"_31165":75400,"_21590":129413,"_5":14857,"_28357":128638,"_3076":129414},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3624":75716,"_31165":75400,"_21590":129416,"_5":14857,"_28357":128638,"_3076":129417},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3624":75717,"_31165":75400,"_21590":129419,"_5":14857,"_28357":128638,"_3076":129420},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3624":75718,"_31165":75400,"_21590":129422,"_5":14857,"_28357":128638,"_3076":129423},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3624":75719,"_31165":75400,"_21590":129425,"_5":14857,"_28357":128638,"_3076":129426},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3624":75720,"_31165":75400,"_21590":129428,"_5":14857,"_28357":128638,"_3076":129429},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3624":75721,"_31165":75400,"_21590":129431,"_5":14857,"_28357":128638,"_3076":129432},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3624":75722,"_31165":75400,"_21590":129434,"_5":14857,"_28357":128642,"_3076":129435},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3624":75723,"_31165":75400,"_21590":129437,"_5":14857,"_28357":128642,"_3076":129438},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3624":75724,"_31165":75400,"_21590":129440,"_5":14857,"_28357":128646,"_3076":129441},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3624":75725,"_31165":75400,"_21590":129443,"_5":14857,"_28357":128646,"_3076":129444},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3624":75726,"_31165":75400,"_21590":129446,"_5":14857,"_28357":128646,"_3076":129447},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3624":75727,"_31165":75400,"_21590":129449,"_5":14857,"_28357":128646,"_3076":129450},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3624":75728,"_31165":75400,"_21590":129452,"_5":14857,"_28357":128646,"_3076":129453},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3624":75729,"_31165":75400,"_21590":129455,"_5":14857,"_28357":128646,"_3076":129456},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3624":75730,"_31165":75400,"_21590":129458,"_5":14857,"_28357":128646,"_3076":129459},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3624":75731,"_31165":75400,"_21590":129461,"_5":14857,"_28357":128646,"_3076":129462},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3624":75732,"_31165":75400,"_21590":129464,"_5":14857,"_28357":128650,"_3076":129465},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3624":75733,"_31165":75400,"_21590":129467,"_5":14857,"_28357":128650,"_3076":129468},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3624":75734,"_31165":75400,"_21590":129470,"_5":14857,"_28357":128650,"_3076":129471},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3624":75735,"_31165":75400,"_21590":129473,"_5":14857,"_28357":128650,"_3076":129474},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3624":75736,"_31165":75400,"_21590":129476,"_5":14857,"_28357":128650,"_3076":129477},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3624":75737,"_31165":75400,"_21590":129479,"_5":14857,"_28357":128650,"_3076":129480},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3624":75738,"_31165":75400,"_21590":129482,"_5":14857,"_28357":128650,"_3076":129483},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3624":75739,"_31165":75400,"_21590":129485,"_5":14857,"_28357":128650,"_3076":129486},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3624":75740,"_31165":75400,"_21590":129488,"_5":14857,"_28357":128650,"_3076":129489},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3624":75741,"_31165":75400,"_21590":129491,"_5":14857,"_28357":128650,"_3076":129492},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3624":75742,"_31165":75400,"_21590":129494,"_5":14857,"_28357":128650,"_3076":129495},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3624":75743,"_31165":75400,"_21590":129497,"_5":14857,"_28357":128653,"_3076":129498},[],"Tras la actualización, comprueba en este orden:",{"_3624":75744,"_31165":75400,"_21590":129500,"_5":14857,"_28357":128653,"_3076":129501},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3624":75745,"_31165":75400,"_21590":129503,"_5":14857,"_28357":128653,"_3076":129504},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3624":75746,"_31165":75400,"_21590":129506,"_5":14857,"_28357":128653,"_3076":129507},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3624":75747,"_31165":75400,"_21590":129509,"_5":14857,"_28357":128653,"_3076":129510},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3624":75748,"_31165":75400,"_21590":129512,"_5":14857,"_28357":128653,"_3076":129513},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3624":75749,"_31165":75400,"_21590":129515,"_5":14857,"_28357":128653,"_3076":129516},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3624":75750,"_31165":75400,"_21590":129518,"_5":14857,"_28357":128653,"_3076":129519},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3624":75751,"_31165":75400,"_21590":129521,"_5":14857,"_28357":128653,"_3076":129522},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3624":75752,"_31165":75400,"_21590":129524,"_5":14857,"_28357":128653,"_3076":129525},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3624":75753,"_31165":75400,"_21590":129527,"_5":14857,"_28357":128653,"_3076":129528},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3624":75754,"_31165":75400,"_21590":129530,"_5":14857,"_28357":128653,"_3076":129531},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3624":75755,"_31165":75400,"_21590":129533,"_5":14857,"_28357":128653,"_3076":129534},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3624":75756,"_31165":75400,"_21590":129536,"_5":14857,"_28357":128653,"_3076":129537},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3624":75757,"_31165":75400,"_21590":129539,"_5":14857,"_28357":128653,"_3076":129540},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3624":75758,"_31165":75400,"_21590":129542,"_5":14857,"_28357":128653,"_3076":129543},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3624":75759,"_31165":75400,"_21590":129545,"_5":14857,"_28357":128657,"_3076":129546},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3624":75760,"_31165":75400,"_21590":129548,"_5":14857,"_28357":128657,"_3076":129549},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3624":75761,"_31165":75400,"_21590":129551,"_5":14857,"_28357":128657,"_3076":129552},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3624":75762,"_31165":75400,"_21590":129554,"_5":14857,"_28357":128657,"_3076":129555},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3624":75763,"_31165":75400,"_21590":129557,"_5":14857,"_28357":128657,"_3076":129558},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60452":129560,"_60454":129561,"_60456":129562,"_60458":129563,"_18727":3111,"_72701":3111},"spanish",[3076,31165,5,28357],{"_3076":25776,"_31165":25776,"_5":25776,"_28357":25776},{"_3076":129564,"_31165":132623,"_5":135682,"_28357":138741},{"_4825":129565,"_60462":129566,"_5":25776},{"_14938":3388,"_15317":6343,"_15336":4664,"_30165":7963,"_15323":4213,"_20502":6725,"_14959":3494,"_14966":7925,"_30107":12141,"_30515":6220,"_30542":7277,"_30141":4568,"_35570":5174,"_30244":20988,"_30586":10209,"_35577":5449,"_35580":4214,"_35583":5829,"_35586":5642,"_30988":12406,"_35591":19792,"_35593":3965,"_31023":13823,"_15332":31181,"_35597":7807,"_35600":17782,"_35602":5139,"_30570":12761,"_31008":4242,"_31036":3296,"_35607":5300,"_35609":3263,"_35611":6307,"_30255":7983,"_35614":8744,"_35616":6187,"_35618":5352,"_35620":3529,"_35622":25585,"_30178":6247,"_35625":3813,"_35627":3219,"_30172":3171,