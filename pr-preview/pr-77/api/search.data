_31548":50966,"_21615":50970,"_28382":15},"Deploy from AWS Marketplace",[50967,50968,50969],"Docs","Deployment","Other models",[],{"_3626":16,"_31190":15,"_21615":50972,"_5":14871,"_28382":15,"_3078":50973},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3626":17,"_31190":15,"_5":31545,"_21615":50975,"_28382":50976,"_3078":50977},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3626":18,"_31190":15,"_5":31545,"_21615":50979,"_28382":50980,"_3078":50981},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3626":19,"_31190":15,"_5":31545,"_21615":50983,"_28382":50984,"_3078":50985},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3626":20,"_31190":15,"_5":31545,"_21615":50987,"_28382":50988,"_3078":50989},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3626":21,"_31190":15,"_5":31545,"_21615":50991,"_28382":50992,"_3078":50993},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3626":22,"_31190":15,"_5":31545,"_21615":50995,"_28382":50996,"_3078":50997},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3626":23,"_31190":15,"_5":31545,"_21615":50999,"_28382":51000,"_3078":51001},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#next-step","Next step",{"_3626":24,"_31190":15,"_21615":51003,"_5":14871,"_28382":15,"_3078":51004},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3626":25,"_31190":15,"_21615":51006,"_5":14871,"_28382":50976,"_3078":51007},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3626":26,"_31190":15,"_21615":51009,"_5":14871,"_28382":50976,"_3078":51010},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3626":27,"_31190":15,"_21615":51012,"_5":14871,"_28382":50976,"_3078":51013},[],"A security group allowing the necessary endpoints.",{"_3626":28,"_31190":15,"_21615":51015,"_5":14871,"_28382":50980,"_3078":51016},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3626":29,"_31190":15,"_21615":51018,"_5":14871,"_28382":50980,"_3078":51019},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3626":30,"_31190":15,"_21615":51021,"_5":14871,"_28382":50980,"_3078":51022},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3626":31,"_31190":15,"_21615":51024,"_5":14871,"_28382":50984,"_3078":51025},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3626":32,"_31190":15,"_21615":51027,"_5":14871,"_28382":50988,"_3078":51028},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3626":33,"_31190":15,"_21615":51030,"_5":14871,"_28382":50992,"_3078":51031},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3626":34,"_31190":15,"_21615":51033,"_5":14871,"_28382":50996,"_3078":51034},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3626":35,"_31190":15,"_21615":51036,"_5":14871,"_28382":51000,"_3078":51037},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3626":36,"_31190":36,"_5":15231,"_3078":51039,"_31548":51040,"_21615":51041,"_28382":36},"Deploy Lamassu",[50967,50968],[],{"_3626":37,"_31190":36,"_21615":51043,"_5":14871,"_28382":36,"_3078":51044},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3626":38,"_31190":36,"_5":31545,"_21615":51046,"_28382":51047,"_3078":51048},[],"/docs/pr-preview/pr-77/deployment/overview#choose-a-model","Choose a model",{"_3626":39,"_31190":36,"_5":31545,"_21615":51050,"_28382":51051,"_3078":51052},[],"/docs/pr-preview/pr-77/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3626":40,"_31190":36,"_5":31545,"_21615":51054,"_28382":51055,"_3078":51056},[],"/docs/pr-preview/pr-77/deployment/overview#after-deployment","After deployment",{"_3626":41,"_31190":36,"_21615":51058,"_5":14871,"_28382":36,"_3078":51059},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3626":42,"_31190":36,"_21615":51061,"_5":14871,"_28382":51047,"_3078":51062},[],"Model",{"_3626":43,"_31190":36,"_21615":51064,"_5":14871,"_28382":51047,"_3078":51065},[],"Recommended for",{"_3626":44,"_31190":36,"_21615":51067,"_5":14871,"_28382":51047,"_3078":51068},[],"Who operates the infrastructure",{"_3626":45,"_31190":36,"_21615":51070,"_5":14871,"_28382":51047,"_3078":51071},[],"Starting point",{"_3626":46,"_31190":36,"_21615":51073,"_5":14871,"_28382":51047,"_3078":51074},[],"Kubernetes self-managed",{"_3626":47,"_31190":36,"_21615":51076,"_5":14871,"_28382":51047,"_3078":51077},[],"Production, regulated environments and custom deployments",{"_3626":48,"_31190":36,"_21615":51079,"_5":14871,"_28382":51047,"_3078":51080},[],"Your team",{"_3626":49,"_31190":36,"_21615":51082,"_5":14871,"_28382":51047,"_3078":51083},[],"Helm or Fastlane",{"_3626":50,"_31190":36,"_21615":51085,"_5":14871,"_28382":51047,"_3078":51086},[],"AWS Marketplace",{"_3626":51,"_31190":36,"_21615":51088,"_5":14871,"_28382":51047,"_3078":51089},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3626":52,"_31190":36,"_21615":51091,"_5":14871,"_28382":51047,"_3078":51080},[],{"_3626":53,"_31190":36,"_21615":51093,"_5":14871,"_28382":51047,"_3078":51094},[],"Preconfigured image on EC2",{"_3626":54,"_31190":36,"_21615":51096,"_5":14871,"_28382":51047,"_3078":51097},[],"SaaS",{"_3626":55,"_31190":36,"_21615":51099,"_5":14871,"_28382":51047,"_3078":51100},[],"Teams that want to use the platform without operating it",{"_3626":56,"_31190":36,"_21615":51102,"_5":14871,"_28382":51047,"_3078":51103},[],"Lamassu",{"_3626":57,"_31190":36,"_21615":51105,"_5":14871,"_28382":51047,"_3078":51106},[],"Managed subscription",{"_3626":58,"_31190":36,"_21615":51108,"_5":14871,"_28382":51047,"_3078":51109},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3626":59,"_31190":36,"_21615":51111,"_5":14871,"_28382":51047,"_3078":51112},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3626":60,"_31190":36,"_21615":51114,"_5":14871,"_28382":51047,"_3078":51115},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3626":61,"_31190":36,"_21615":51117,"_5":14871,"_28382":51051,"_3078":51118},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3626":62,"_31190":36,"_21615":51120,"_5":14871,"_28382":51055,"_3078":51121},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3626":63,"_31190":63,"_5":15231,"_3078":51123,"_31548":51124,"_21615":51125,"_28382":63},"Use Lamassu as SaaS",[50967,50968,50969],[],{"_3626":64,"_31190":63,"_21615":51127,"_5":14871,"_28382":63,"_3078":51128},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3626":65,"_31190":63,"_5":31545,"_21615":51130,"_28382":51131,"_3078":51132},[],"/docs/pr-preview/pr-77/deployment/saas#what-the-service-manages","What the service manages",{"_3626":66,"_31190":63,"_5":31545,"_21615":51134,"_28382":51135,"_3078":51136},[],"/docs/pr-preview/pr-77/deployment/saas#plans","Plans",{"_3626":67,"_31190":63,"_5":31545,"_21615":51138,"_28382":51139,"_3078":51140},[],"/docs/pr-preview/pr-77/deployment/saas#request-access","Request access",{"_3626":68,"_31190":63,"_21615":51142,"_5":14871,"_28382":63,"_3078":51143},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3626":69,"_31190":63,"_21615":51145,"_5":14871,"_28382":51131,"_3078":51146},[],"Platform availability and maintenance.",{"_3626":70,"_31190":63,"_21615":51148,"_5":14871,"_28382":51131,"_3078":51149},[],"Automatic backups.",{"_3626":71,"_31190":63,"_21615":51151,"_5":14871,"_28382":51131,"_3078":51152},[],"Version upgrades.",{"_3626":72,"_31190":63,"_21615":51154,"_5":14871,"_28382":51131,"_3078":51155},[],"Technical support and SLA according to your plan.",{"_3626":73,"_31190":63,"_21615":51157,"_5":14871,"_28382":51135,"_3078":51158},[],"Plan",{"_3626":74,"_31190":63,"_21615":51160,"_5":14871,"_28382":51135,"_3078":51161},[],"Devices",{"_3626":75,"_31190":63,"_21615":51163,"_5":14871,"_28382":51135,"_3078":51164},[],"Support",{"_3626":76,"_31190":63,"_21615":51166,"_5":14871,"_28382":51135,"_3078":51167},[],"SLA",{"_3626":77,"_31190":63,"_21615":51169,"_5":14871,"_28382":51135,"_3078":51170},[],"Starter",{"_3626":78,"_31190":63,"_21615":51172,"_5":14871,"_28382":51135,"_3078":51173},[],"Up to 1,000",{"_3626":79,"_31190":63,"_21615":51175,"_5":14871,"_28382":51135,"_3078":51176},[],"Email",{"_3626":80,"_31190":63,"_21615":51178,"_5":14871,"_28382":51135,"_3078":51179},[],"99.5 %",{"_3626":81,"_31190":63,"_21615":51181,"_5":14871,"_28382":51135,"_3078":51182},[],"Professional",{"_3626":82,"_31190":63,"_21615":51184,"_5":14871,"_28382":51135,"_3078":51185},[],"Up to 10,000",{"_3626":83,"_31190":63,"_21615":51187,"_5":14871,"_28382":51135,"_3078":51188},[],"Email and chat",{"_3626":84,"_31190":63,"_21615":51190,"_5":14871,"_28382":51135,"_3078":51191},[],"99.9 %",{"_3626":85,"_31190":63,"_21615":51193,"_5":14871,"_28382":51135,"_3078":51194},[],"Enterprise",{"_3626":86,"_31190":63,"_21615":51196,"_5":14871,"_28382":51135,"_3078":51197},[],"Unlimited",{"_3626":87,"_31190":63,"_21615":51199,"_5":14871,"_28382":51135,"_3078":51200},[],"Dedicated",{"_3626":88,"_31190":63,"_21615":51202,"_5":14871,"_28382":51135,"_3078":51203},[],"99.99 %",{"_3626":89,"_31190":63,"_21615":51205,"_5":14871,"_28382":51139,"_3078":51206},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3626":90,"_31190":63,"_21615":51208,"_5":14871,"_28382":51139,"_3078":51209},[],"When you receive your instance's credentials, continue with Get started.",{"_3626":91,"_31190":91,"_5":15231,"_3078":51211,"_31548":51212,"_21615":51213,"_28382":91},"Fastlane",[50967,50968,51074],[],{"_3626":92,"_31190":91,"_21615":51215,"_5":14871,"_28382":91,"_3078":51216},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3626":93,"_31190":91,"_5":31545,"_21615":51218,"_28382":51219,"_3078":51220},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3626":94,"_31190":91,"_5":31545,"_21615":51222,"_28382":51223,"_3078":51224},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3626":95,"_31190":91,"_5":31545,"_21615":51226,"_28382":51227,"_3078":50977},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#before-you-begin",{"_3626":96,"_31190":91,"_5":31545,"_21615":51229,"_28382":51230,"_3078":51231},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3626":97,"_31190":91,"_5":31545,"_21615":51233,"_28382":51234,"_3078":51235},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3626":98,"_31190":91,"_5":31545,"_21615":51237,"_28382":51238,"_3078":51239},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3626":99,"_31190":91,"_5":31545,"_21615":51241,"_28382":51242,"_3078":51243},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3626":100,"_31190":91,"_5":31545,"_21615":51245,"_28382":51246,"_3078":51247},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3626":101,"_31190":91,"_5":31545,"_21615":51249,"_28382":51250,"_3078":51251},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3626":102,"_31190":91,"_5":31545,"_21615":51253,"_28382":51254,"_3078":51255},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3626":103,"_31190":91,"_5":31545,"_21615":51257,"_28382":51258,"_3078":51259},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3626":104,"_31190":91,"_21615":51261,"_5":14871,"_28382":51219,"_3078":51262},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3626":105,"_31190":91,"_21615":51264,"_5":14871,"_28382":51219,"_3078":51265},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3626":106,"_31190":91,"_21615":51267,"_5":14871,"_28382":51223,"_3078":51268},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3626":107,"_31190":91,"_21615":51270,"_5":14871,"_28382":51223,"_3078":51271},[],"Fastlane installs or configures",{"_3626":108,"_31190":91,"_21615":51273,"_5":14871,"_28382":51223,"_3078":51274},[],"You still provide",{"_3626":109,"_31190":91,"_21615":51276,"_5":14871,"_28382":51223,"_3078":51277},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3626":110,"_31190":91,"_21615":51279,"_5":14871,"_28382":51223,"_3078":51280},[],"The Kubernetes cluster, nodes and persistent storage",{"_3626":111,"_31190":91,"_21615":51282,"_5":14871,"_28382":51223,"_3078":51283},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3626":112,"_31190":91,"_21615":51285,"_5":14871,"_28382":51223,"_3078":51286},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3626":113,"_31190":91,"_21615":51288,"_5":14871,"_28382":51223,"_3078":51289},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3626":114,"_31190":91,"_21615":51291,"_5":14871,"_28382":51223,"_3078":51292},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3626":115,"_31190":91,"_21615":51294,"_5":14871,"_28382":51223,"_3078":51295},[],"Optional observability and lab HSM components",{"_3626":116,"_31190":91,"_21615":51297,"_5":14871,"_28382":51223,"_3078":51298},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3626":117,"_31190":91,"_21615":51300,"_5":14871,"_28382":51223,"_3078":51301},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3626":118,"_31190":91,"_21615":51303,"_5":14871,"_28382":51227,"_3078":51304},[],"You need:",{"_3626":119,"_31190":91,"_21615":51306,"_5":14871,"_28382":51227,"_3078":51307},[],"an existing Kubernetes cluster",{"_3626":120,"_31190":91,"_21615":51309,"_5":14871,"_28382":51227,"_3078":51310},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3626":121,"_31190":91,"_21615":51312,"_5":14871,"_28382":51227,"_3078":51313},[],"`yq`",{"_3626":122,"_31190":91,"_21615":51315,"_5":14871,"_28382":51227,"_3078":24427},[],{"_3626":123,"_31190":91,"_21615":51317,"_5":14871,"_28382":51227,"_3078":51318},[],"`jq` only when using `--sample-data` or `--development`",{"_3626":124,"_31190":91,"_21615":51320,"_5":14871,"_28382":51227,"_3078":51321},[],"`ssh-keygen` only when using `--with-hsm`",{"_3626":125,"_31190":91,"_21615":51323,"_5":14871,"_28382":51227,"_3078":51324},[],"free external ports 80 and 443 on a single-node K3s host",{"_3626":126,"_31190":91,"_21615":51326,"_5":14871,"_28382":51227,"_3078":51327},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3626":127,"_31190":91,"_21615":51329,"_5":14871,"_28382":51227,"_3078":51330},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3626":128,"_31190":91,"_21615":51332,"_5":14871,"_28382":51230,"_3078":51333},[],"Run the script from a clone of the Helm repository:",{"_3626":129,"_31190":91,"_21615":51335,"_5":14871,"_28382":51230,"_3078":51336},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3626":130,"_31190":91,"_21615":51338,"_5":14871,"_28382":51234,"_3078":51339},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3626":131,"_31190":91,"_21615":51341,"_5":14871,"_28382":51234,"_3078":51342},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3626":132,"_31190":91,"_21615":51344,"_5":14871,"_28382":51234,"_3078":51345},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3626":133,"_31190":91,"_21615":51347,"_5":14871,"_28382":51234,"_3078":51348},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3626":134,"_31190":91,"_21615":51350,"_5":14871,"_28382":51238,"_3078":51351},[],"Option",{"_3626":135,"_31190":91,"_21615":51353,"_5":14871,"_28382":51238,"_3078":51354},[],"Default",{"_3626":136,"_31190":91,"_21615":51356,"_5":14871,"_28382":51238,"_3078":51357},[],"Purpose",{"_3626":137,"_31190":91,"_21615":51359,"_5":14871,"_28382":51238,"_3078":51360},[],"`-h`, `--help`",{"_3626":138,"_31190":91,"_21615":51362,"_5":14871,"_28382":51238,"_3078":51363},[],"—",{"_3626":139,"_31190":91,"_21615":51365,"_5":14871,"_28382":51238,"_3078":51366},[],"Show help",{"_3626":140,"_31190":91,"_21615":51368,"_5":14871,"_28382":51238,"_3078":51369},[],"`-c`, `--context`",{"_3626":141,"_31190":91,"_21615":51371,"_5":14871,"_28382":51238,"_3078":51372},[],"current context",{"_3626":142,"_31190":91,"_21615":51374,"_5":14871,"_28382":51238,"_3078":51375},[],"Select the kubeconfig context for kubectl and Helm",{"_3626":143,"_31190":91,"_21615":51377,"_5":14871,"_28382":51238,"_3078":51378},[],"`-n`, `--non-interactive`",{"_3626":144,"_31190":91,"_21615":51380,"_5":14871,"_28382":51238,"_3078":6794},[],{"_3626":145,"_31190":91,"_21615":51382,"_5":14871,"_28382":51238,"_3078":51383},[],"Skip prompts and generate dependency credentials",{"_3626":146,"_31190":91,"_21615":51385,"_5":14871,"_28382":51238,"_3078":51386},[],"`-ns`, `--namespace`",{"_3626":147,"_31190":91,"_21615":51388,"_5":14871,"_28382":51238,"_3078":51389},[],"`lamassu-dev`",{"_3626":148,"_31190":91,"_21615":51391,"_5":14871,"_28382":51238,"_3078":51392},[],"Namespace for the installation",{"_3626":149,"_31190":91,"_21615":51394,"_5":14871,"_28382":51238,"_3078":51395},[],"`-d`, `--domain`",{"_3626":150,"_31190":91,"_21615":51397,"_5":14871,"_28382":51238,"_3078":51398},[],"`dev.lamassu.io`",{"_3626":151,"_31190":91,"_21615":51400,"_5":14871,"_28382":51238,"_3078":51401},[],"Domain used by the UI, OIDC and certificate",{"_3626":152,"_31190":91,"_21615":51403,"_5":14871,"_28382":51238,"_3078":51404},[],"`-v`, `--version`",{"_3626":153,"_31190":91,"_21615":51406,"_5":14871,"_28382":51238,"_3078":15583},[],{"_3626":154,"_31190":91,"_21615":51408,"_5":14871,"_28382":51238,"_3078":51409},[],"Lamassu chart version",{"_3626":155,"_31190":91,"_21615":51411,"_5":14871,"_28382":51238,"_3078":51412},[],"`--https-port`",{"_3626":156,"_31190":91,"_21615":51414,"_5":14871,"_28382":51238,"_3078":51415},[],"`443`",{"_3626":157,"_31190":91,"_21615":51417,"_5":14871,"_28382":51238,"_3078":51418},[],"Gateway HTTPS listener port",{"_3626":158,"_31190":91,"_21615":51420,"_5":14871,"_28382":51238,"_3078":51421},[],"`--http-port`",{"_3626":159,"_31190":91,"_21615":51423,"_5":14871,"_28382":51238,"_3078":51424},[],"`80`",{"_3626":160,"_31190":91,"_21615":51426,"_5":14871,"_28382":51238,"_3078":51427},[],"Gateway HTTP listener port",{"_3626":161,"_31190":91,"_21615":51429,"_5":14871,"_28382":51238,"_3078":51430},[],"`--tls-crt`",{"_3626":162,"_31190":91,"_21615":51432,"_5":14871,"_28382":51238,"_3078":51363},[],{"_3626":163,"_31190":91,"_21615":51434,"_5":14871,"_28382":51238,"_3078":51435},[],"PEM certificate for downstream TLS",{"_3626":164,"_31190":91,"_21615":51437,"_5":14871,"_28382":51238,"_3078":51438},[],"`--tls-key`",{"_3626":165,"_31190":91,"_21615":51440,"_5":14871,"_28382":51238,"_3078":51363},[],{"_3626":166,"_31190":91,"_21615":51442,"_5":14871,"_28382":51238,"_3078":51443},[],"PEM private key for downstream TLS",{"_3626":167,"_31190":91,"_21615":51445,"_5":14871,"_28382":51238,"_3078":51446},[],"`-l`, `--local-chart-path`",{"_3626":168,"_31190":91,"_21615":51448,"_5":14871,"_28382":51238,"_3078":51449},[],"repository chart",{"_3626":169,"_31190":91,"_21615":51451,"_5":14871,"_28382":51238,"_3078":51452},[],"Use an unpacked local Lamassu chart",{"_3626":170,"_31190":91,"_21615":51454,"_5":14871,"_28382":51238,"_3078":51455},[],"`-ip`, `--gateway-ip`",{"_3626":171,"_31190":91,"_21615":51457,"_5":14871,"_28382":51238,"_3078":9089},[],{"_3626":172,"_31190":91,"_21615":51459,"_5":14871,"_28382":51238,"_3078":51460},[],"Override the address written to `gateway.addresses`",{"_3626":173,"_31190":91,"_21615":51462,"_5":14871,"_28382":51238,"_3078":51463},[],"`--otel`",{"_3626":174,"_31190":91,"_21615":51465,"_5":14871,"_28382":51238,"_3078":6794},[],{"_3626":175,"_31190":91,"_21615":51467,"_5":14871,"_28382":51238,"_3078":51468},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3626":176,"_31190":91,"_21615":51470,"_5":14871,"_28382":51238,"_3078":51471},[],"`--development`",{"_3626":177,"_31190":91,"_21615":51473,"_5":14871,"_28382":51238,"_3078":6794},[],{"_3626":178,"_31190":91,"_21615":51475,"_5":14871,"_28382":51238,"_3078":51476},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3626":179,"_31190":91,"_21615":51478,"_5":14871,"_28382":51238,"_3078":51479},[],"`--sample-data`",{"_3626":180,"_31190":91,"_21615":51481,"_5":14871,"_28382":51238,"_3078":6794},[],{"_3626":181,"_31190":91,"_21615":51483,"_5":14871,"_28382":51238,"_3078":51484},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3626":182,"_31190":91,"_21615":51486,"_5":14871,"_28382":51238,"_3078":51487},[],"`--with-hsm`",{"_3626":183,"_31190":91,"_21615":51489,"_5":14871,"_28382":51238,"_3078":6794},[],{"_3626":184,"_31190":91,"_21615":51491,"_5":14871,"_28382":51238,"_3078":51492},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3626":185,"_31190":91,"_21615":51494,"_5":14871,"_28382":51238,"_3078":51495},[],"`--softhsm-chart-path`",{"_3626":186,"_31190":91,"_21615":51497,"_5":14871,"_28382":51238,"_3078":51498},[],"`./charts/softhsm`",{"_3626":187,"_31190":91,"_21615":51500,"_5":14871,"_28382":51238,"_3078":51501},[],"Use a different local SoftHSM chart",{"_3626":188,"_31190":91,"_21615":51503,"_5":14871,"_28382":51238,"_3078":51504},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3626":189,"_31190":91,"_21615":51506,"_5":14871,"_28382":51242,"_3078":51507},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3626":190,"_31190":91,"_21615":51509,"_5":14871,"_28382":51242,"_3078":51510},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3626":191,"_31190":91,"_21615":51512,"_5":14871,"_28382":51242,"_3078":51513},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3626":192,"_31190":91,"_21615":51515,"_5":14871,"_28382":51242,"_3078":51516},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3626":193,"_31190":91,"_21615":51518,"_5":14871,"_28382":51242,"_3078":51519},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3626":194,"_31190":91,"_21615":51521,"_5":14871,"_28382":51242,"_3078":51522},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3626":195,"_31190":91,"_21615":51524,"_5":14871,"_28382":51246,"_3078":51525},[],"Fastlane:",{"_3626":196,"_31190":91,"_21615":51527,"_5":14871,"_28382":51246,"_3078":51528},[],"validates local tools and the selected cluster",{"_3626":197,"_31190":91,"_21615":51530,"_5":14871,"_28382":51246,"_3078":51531},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3626":198,"_31190":91,"_21615":51533,"_5":14871,"_28382":51246,"_3078":51534},[],"creates the namespace",{"_3626":199,"_31190":91,"_21615":51536,"_5":14871,"_28382":51246,"_3078":51537},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3626":200,"_31190":91,"_21615":51539,"_5":14871,"_28382":51246,"_3078":51540},[],"installs PostgreSQL and creates the required databases",{"_3626":201,"_31190":91,"_21615":51542,"_5":14871,"_28382":51246,"_3078":51543},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3626":202,"_31190":91,"_21615":51545,"_5":14871,"_28382":51246,"_3078":51546},[],"installs RabbitMQ",{"_3626":203,"_31190":91,"_21615":51548,"_5":14871,"_28382":51246,"_3078":51549},[],"optionally installs observability and lab HSM components",{"_3626":204,"_31190":91,"_21615":51551,"_5":14871,"_28382":51246,"_3078":51552},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3626":205,"_31190":91,"_21615":51554,"_5":14871,"_28382":51246,"_3078":51555},[],"optionally loads sample data",{"_3626":206,"_31190":91,"_21615":51557,"_5":14871,"_28382":51246,"_3078":51558},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3626":207,"_31190":91,"_21615":51560,"_5":14871,"_28382":51250,"_3078":51561},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3626":208,"_31190":91,"_21615":51563,"_5":14871,"_28382":51250,"_3078":51564},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3626":209,"_31190":91,"_21615":51566,"_5":14871,"_28382":51254,"_3078":51567},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3626":210,"_31190":91,"_21615":51569,"_5":14871,"_28382":51254,"_3078":51570},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3626":211,"_31190":91,"_21615":51572,"_5":14871,"_28382":51254,"_3078":51573},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3626":212,"_31190":91,"_21615":51575,"_5":14871,"_28382":51254,"_3078":51576},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3626":213,"_31190":91,"_21615":51578,"_5":14871,"_28382":51258,"_3078":51579},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3626":214,"_31190":214,"_5":15231,"_3078":51581,"_31548":51582,"_21615":51583,"_28382":214},"Install with Helm",[50967,50968,51074],[],{"_3626":215,"_31190":214,"_21615":51585,"_5":14871,"_28382":214,"_3078":51586},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3626":216,"_31190":214,"_5":31545,"_21615":51588,"_28382":51589,"_3078":51590},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3626":217,"_31190":214,"_5":31545,"_21615":51592,"_28382":51593,"_3078":50977},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#before-you-begin",{"_3626":218,"_31190":214,"_5":31545,"_21615":51595,"_28382":51596,"_3078":51597},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3626":219,"_31190":214,"_5":31545,"_21615":51599,"_28382":51600,"_3078":51601},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3626":220,"_31190":214,"_5":31545,"_21615":51603,"_28382":51604,"_3078":51605},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3626":221,"_31190":214,"_5":31545,"_21615":51607,"_28382":51608,"_3078":51609},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3626":222,"_31190":214,"_5":31545,"_21615":51611,"_28382":51612,"_3078":51613},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3626":223,"_31190":214,"_5":31545,"_21615":51615,"_28382":51616,"_3078":51617},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3626":224,"_31190":214,"_5":31545,"_21615":51619,"_28382":51620,"_3078":51621},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3626":225,"_31190":214,"_5":31545,"_21615":51623,"_28382":51624,"_3078":51625},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3626":226,"_31190":214,"_5":31545,"_21615":51627,"_28382":51628,"_3078":51629},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3626":227,"_31190":214,"_5":31545,"_21615":51631,"_28382":51632,"_3078":51633},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3626":228,"_31190":214,"_21615":51635,"_5":14871,"_28382":51589,"_3078":51636},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3626":229,"_31190":214,"_21615":51638,"_5":14871,"_28382":51593,"_3078":51639},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3626":230,"_31190":214,"_21615":51641,"_5":14871,"_28382":51593,"_3078":51642},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3626":231,"_31190":214,"_21615":51644,"_5":14871,"_28382":51593,"_3078":51645},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3626":232,"_31190":214,"_21615":51647,"_5":14871,"_28382":51593,"_3078":51648},[],"a reachable RabbitMQ broker and credentials",{"_3626":233,"_31190":214,"_21615":51650,"_5":14871,"_28382":51593,"_3078":51651},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3626":234,"_31190":214,"_21615":51653,"_5":14871,"_28382":51593,"_3078":51654},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3626":235,"_31190":214,"_21615":51656,"_5":14871,"_28382":51593,"_3078":51657},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3626":236,"_31190":214,"_21615":51659,"_5":14871,"_28382":51593,"_3078":51660},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3626":237,"_31190":214,"_21615":51662,"_5":14871,"_28382":51593,"_3078":51663},[],"a StorageClass and an external traffic design",{"_3626":238,"_31190":214,"_21615":51665,"_5":14871,"_28382":51593,"_3078":51666},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3626":239,"_31190":214,"_21615":51668,"_5":14871,"_28382":51593,"_3078":51669},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3626":240,"_31190":214,"_21615":51671,"_5":14871,"_28382":51593,"_3078":51672},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3626":241,"_31190":214,"_21615":51674,"_5":14871,"_28382":51596,"_3078":51675},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3626":242,"_31190":214,"_21615":51677,"_5":14871,"_28382":51596,"_3078":51678},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3626":243,"_31190":214,"_21615":51680,"_5":14871,"_28382":51596,"_3078":51681},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3626":244,"_31190":214,"_21615":51683,"_5":14871,"_28382":51600,"_3078":51684},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3626":245,"_31190":214,"_21615":51686,"_5":14871,"_28382":51600,"_3078":51687},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3626":246,"_31190":214,"_21615":51689,"_5":14871,"_28382":51600,"_3078":51690},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3626":247,"_31190":214,"_21615":51692,"_5":14871,"_28382":51600,"_3078":51693},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3626":248,"_31190":214,"_21615":51695,"_5":14871,"_28382":51604,"_3078":51696},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3626":249,"_31190":214,"_21615":51698,"_5":14871,"_28382":51604,"_3078":51699},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3626":250,"_31190":214,"_21615":51701,"_5":14871,"_28382":51604,"_3078":51702},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3626":251,"_31190":214,"_21615":51704,"_5":14871,"_28382":51604,"_3078":51705},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3626":252,"_31190":214,"_21615":51707,"_5":14871,"_28382":51604,"_3078":51708},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3626":253,"_31190":214,"_21615":51710,"_5":14871,"_28382":51604,"_3078":51711},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3626":254,"_31190":214,"_21615":51713,"_5":14871,"_28382":51604,"_3078":51714},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3626":255,"_31190":214,"_21615":51716,"_5":14871,"_28382":51604,"_3078":51717},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3626":256,"_31190":214,"_21615":51719,"_5":14871,"_28382":51608,"_3078":51720},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3626":257,"_31190":214,"_21615":51722,"_5":14871,"_28382":51612,"_3078":51723},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3626":258,"_31190":214,"_21615":51725,"_5":14871,"_28382":51612,"_3078":51726},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3626":259,"_31190":214,"_21615":51728,"_5":14871,"_28382":51612,"_3078":51729},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3626":260,"_31190":214,"_21615":51731,"_5":14871,"_28382":51612,"_3078":51732},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3626":261,"_31190":214,"_21615":51734,"_5":14871,"_28382":51612,"_3078":51735},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3626":262,"_31190":214,"_21615":51737,"_5":14871,"_28382":51612,"_3078":51738},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3626":263,"_31190":214,"_21615":51740,"_5":14871,"_28382":51612,"_3078":51741},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3626":264,"_31190":214,"_21615":51743,"_5":14871,"_28382":51616,"_3078":51744},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3626":265,"_31190":214,"_21615":51746,"_5":14871,"_28382":51616,"_3078":51747},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3626":266,"_31190":214,"_21615":51749,"_5":14871,"_28382":51616,"_3078":51750},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3626":267,"_31190":214,"_21615":51752,"_5":14871,"_28382":51616,"_3078":51753},[],"See Access control for the principal and policy model.",{"_3626":268,"_31190":214,"_21615":51755,"_5":14871,"_28382":51620,"_3078":51756},[],"To install a local checkout instead:",{"_3626":269,"_31190":214,"_21615":51758,"_5":14871,"_28382":51624,"_3078":51759},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3626":270,"_31190":214,"_21615":51761,"_5":14871,"_28382":51624,"_3078":51762},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3626":271,"_31190":214,"_21615":51764,"_5":14871,"_28382":51628,"_3078":51765},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3626":272,"_31190":214,"_21615":51767,"_5":14871,"_28382":51628,"_3078":51768},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3626":273,"_31190":214,"_21615":51770,"_5":14871,"_28382":51628,"_3078":51771},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3626":274,"_31190":214,"_21615":51773,"_5":14871,"_28382":51628,"_3078":51774},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3626":275,"_31190":214,"_21615":51776,"_5":14871,"_28382":51628,"_3078":51777},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3626":276,"_31190":214,"_21615":51779,"_5":14871,"_28382":51632,"_3078":51780},[],"Before going live, review:",{"_3626":277,"_31190":214,"_21615":51782,"_5":14871,"_28382":51632,"_3078":51783},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3626":278,"_31190":214,"_21615":51785,"_5":14871,"_28382":51632,"_3078":51786},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3626":279,"_31190":214,"_21615":51788,"_5":14871,"_28382":51632,"_3078":51789},[],"shared VA storage before increasing VA replicas",{"_3626":280,"_31190":214,"_21615":51791,"_5":14871,"_28382":51632,"_3078":51792},[],"managed OIDC roles and removal of evaluation credentials",{"_3626":281,"_31190":214,"_21615":51794,"_5":14871,"_28382":51632,"_3078":51795},[],"a trusted TLS issuer or externally managed certificate",{"_3626":282,"_31190":214,"_21615":51797,"_5":14871,"_28382":51632,"_3078":51798},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3626":283,"_31190":214,"_21615":51800,"_5":14871,"_28382":51632,"_3078":51801},[],"SMTP, observability and alert delivery",{"_3626":284,"_31190":214,"_21615":51803,"_5":14871,"_28382":51632,"_3078":51804},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3626":285,"_31190":214,"_21615":51806,"_5":14871,"_28382":51632,"_3078":51807},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3626":286,"_31190":286,"_5":15231,"_3078":51809,"_31548":51810,"_21615":51811,"_28382":286},"Expose the Gateway",[50967,50968,51074],[],{"_3626":287,"_31190":286,"_21615":51813,"_5":14871,"_28382":286,"_3078":51814},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3626":288,"_31190":286,"_5":31545,"_21615":51816,"_28382":51817,"_3078":51818},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3626":289,"_31190":286,"_5":31545,"_21615":51820,"_28382":51821,"_3078":51822},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3626":290,"_31190":286,"_5":31545,"_21615":51824,"_28382":51825,"_3078":51826},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3626":291,"_31190":286,"_5":31545,"_21615":51828,"_28382":51829,"_3078":51830},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#k3s","K3s",{"_3626":292,"_31190":286,"_5":31545,"_21615":51832,"_28382":51833,"_3078":51834},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3626":293,"_31190":286,"_5":31545,"_21615":51836,"_28382":51837,"_3078":51838},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3626":294,"_31190":286,"_5":31545,"_21615":51840,"_28382":51841,"_3078":51842},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3626":295,"_31190":286,"_5":31545,"_21615":51844,"_28382":51845,"_3078":51846},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3626":296,"_31190":286,"_5":31545,"_21615":51848,"_28382":51849,"_3078":51850},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3626":297,"_31190":286,"_5":31545,"_21615":51852,"_28382":51853,"_3078":51854},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3626":298,"_31190":286,"_5":31545,"_21615":51856,"_28382":51857,"_3078":51858},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3626":299,"_31190":286,"_21615":51860,"_5":14871,"_28382":51817,"_3078":51861},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3626":300,"_31190":286,"_21615":51863,"_5":14871,"_28382":51817,"_3078":51864},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3626":301,"_31190":286,"_21615":51866,"_5":14871,"_28382":51821,"_3078":51867},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3626":302,"_31190":286,"_21615":51869,"_5":14871,"_28382":51821,"_3078":51870},[],"Set it only when:",{"_3626":303,"_31190":286,"_21615":51872,"_5":14871,"_28382":51821,"_3078":51873},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3626":304,"_31190":286,"_21615":51875,"_5":14871,"_28382":51821,"_3078":51876},[],"that address is allocated to this Gateway",{"_3626":305,"_31190":286,"_21615":51878,"_5":14871,"_28382":51821,"_3078":51879},[],"the surrounding network already routes traffic for it to the cluster",{"_3626":306,"_31190":286,"_21615":51881,"_5":14871,"_28382":51821,"_3078":51882},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3626":307,"_31190":286,"_21615":51884,"_5":14871,"_28382":51821,"_3078":51885},[],"Keep these two settings separate:",{"_3626":308,"_31190":286,"_21615":51887,"_5":14871,"_28382":51821,"_3078":51888},[],"`gateway.addresses` requests an address for the Gateway.",{"_3626":309,"_31190":286,"_21615":51890,"_5":14871,"_28382":51821,"_3078":51891},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3626":310,"_31190":286,"_21615":51893,"_5":14871,"_28382":51821,"_3078":51894},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3626":311,"_31190":286,"_21615":51896,"_5":14871,"_28382":51825,"_3078":51897},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3626":312,"_31190":286,"_21615":51899,"_5":14871,"_28382":51825,"_3078":51900},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3626":313,"_31190":286,"_21615":51902,"_5":14871,"_28382":51829,"_3078":51903},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3626":314,"_31190":286,"_21615":51905,"_5":14871,"_28382":51829,"_3078":51906},[],"For the recommended design:",{"_3626":315,"_31190":286,"_21615":51908,"_5":14871,"_28382":51829,"_3078":51909},[],"Use only one externally exposed Lamassu Gateway.",{"_3626":316,"_31190":286,"_21615":51911,"_5":14871,"_28382":51829,"_3078":51912},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3626":317,"_31190":286,"_21615":51914,"_5":14871,"_28382":51829,"_3078":51915},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3626":318,"_31190":286,"_21615":51917,"_5":14871,"_28382":51829,"_3078":51918},[],"Point DNS at the VM's reachable address.",{"_3626":319,"_31190":286,"_21615":51920,"_5":14871,"_28382":51829,"_3078":51921},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3626":320,"_31190":286,"_21615":51923,"_5":14871,"_28382":51833,"_3078":51924},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3626":321,"_31190":286,"_21615":51926,"_5":14871,"_28382":51837,"_3078":51927},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3626":322,"_31190":286,"_21615":51929,"_5":14871,"_28382":51837,"_3078":51930},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3626":323,"_31190":286,"_21615":51932,"_5":14871,"_28382":51841,"_3078":51933},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3626":324,"_31190":286,"_21615":51935,"_5":14871,"_28382":51841,"_3078":51936},[],"Requirement",{"_3626":325,"_31190":286,"_21615":51938,"_5":14871,"_28382":51841,"_3078":51939},[],"Recommended design",{"_3626":326,"_31190":286,"_21615":51941,"_5":14871,"_28382":51841,"_3078":51942},[],"Consequence",{"_3626":327,"_31190":286,"_21615":51944,"_5":14871,"_28382":51841,"_3078":51945},[],"Several Lamassu URLs or services",{"_3626":328,"_31190":286,"_21615":51947,"_5":14871,"_28382":51841,"_3078":51948},[],"One Gateway with multiple routes",{"_3626":329,"_31190":286,"_21615":51950,"_5":14871,"_28382":51841,"_3078":51951},[],"One IP and one proxy fleet; this is the chart default",{"_3626":330,"_31190":286,"_21615":51953,"_5":14871,"_28382":51841,"_3078":51954},[],"Independent Gateways and separate external IPs",{"_3626":331,"_31190":286,"_21615":51956,"_5":14871,"_28382":51841,"_3078":51957},[],"One VIP per Gateway",{"_3626":332,"_31190":286,"_21615":51959,"_5":14871,"_28382":51841,"_3078":51960},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3626":333,"_31190":286,"_21615":51962,"_5":14871,"_28382":51841,"_3078":51963},[],"Independent Gateways on one node and one IP",{"_3626":334,"_31190":286,"_21615":51965,"_5":14871,"_28382":51841,"_3078":51966},[],"Use different external ports",{"_3626":335,"_31190":286,"_21615":51968,"_5":14871,"_28382":51841,"_3078":51969},[],"Clients must include non-standard ports",{"_3626":336,"_31190":286,"_21615":51971,"_5":14871,"_28382":51841,"_3078":51972},[],"Separate TLS/mTLS termination behind one IP",{"_3626":337,"_31190":286,"_21615":51974,"_5":14871,"_28382":51841,"_3078":51975},[],"Front-door SNI routing to internal Gateways",{"_3626":338,"_31190":286,"_21615":51977,"_5":14871,"_28382":51841,"_3078":51978},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3626":339,"_31190":286,"_21615":51980,"_5":14871,"_28382":51841,"_3078":51981},[],"Separate Gateway resources but shared proxy infrastructure",{"_3626":340,"_31190":286,"_21615":51983,"_5":14871,"_28382":51841,"_3078":51984},[],"Envoy merged-Gateway mode",{"_3626":341,"_31190":286,"_21615":51986,"_5":14871,"_28382":51841,"_3078":51987},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3626":342,"_31190":286,"_21615":51989,"_5":14871,"_28382":51841,"_3078":51990},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3626":343,"_31190":286,"_21615":51992,"_5":14871,"_28382":51841,"_3078":51993},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3626":344,"_31190":286,"_21615":51995,"_5":14871,"_28382":51841,"_3078":51996},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3626":345,"_31190":286,"_21615":51998,"_5":14871,"_28382":51841,"_3078":51999},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3626":346,"_31190":286,"_21615":52001,"_5":14871,"_28382":51845,"_3078":52002},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3626":347,"_31190":286,"_21615":52004,"_5":14871,"_28382":51849,"_3078":52005},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3626":348,"_31190":286,"_21615":52007,"_5":14871,"_28382":51849,"_3078":52008},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3626":349,"_31190":286,"_21615":52010,"_5":14871,"_28382":51849,"_3078":52011},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3626":350,"_31190":286,"_21615":52013,"_5":14871,"_28382":51849,"_3078":52014},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3626":351,"_31190":286,"_21615":52016,"_5":14871,"_28382":51849,"_3078":52017},[],"If none of those are possible, use different external ports or change the external network design.",{"_3626":352,"_31190":286,"_21615":52019,"_5":14871,"_28382":51853,"_3078":52020},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3626":353,"_31190":286,"_21615":52022,"_5":14871,"_28382":51853,"_3078":52023},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3626":354,"_31190":286,"_21615":52025,"_5":14871,"_28382":51857,"_3078":52026},[],"Check, in order:",{"_3626":355,"_31190":286,"_21615":52028,"_5":14871,"_28382":51857,"_3078":52029},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3626":356,"_31190":286,"_21615":52031,"_5":14871,"_28382":51857,"_3078":52032},[],"Its status contains the expected address.",{"_3626":357,"_31190":286,"_21615":52034,"_5":14871,"_28382":51857,"_3078":52035},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3626":358,"_31190":286,"_21615":52037,"_5":14871,"_28382":51857,"_3078":52038},[],"Port 443 reaches that address from the client network.",{"_3626":359,"_31190":286,"_21615":52040,"_5":14871,"_28382":51857,"_3078":52041},[],"DNS resolves to the externally reachable endpoint.",{"_3626":360,"_31190":286,"_21615":52043,"_5":14871,"_28382":51857,"_3078":52044},[],"The certificate contains the DNS name or IP used by the client.",{"_3626":361,"_31190":286,"_21615":52046,"_5":14871,"_28382":51857,"_3078":52047},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3626":362,"_31190":362,"_5":15231,"_3078":51074,"_31548":52049,"_21615":52050,"_28382":362},[50967,50968,51074],[],{"_3626":363,"_31190":362,"_21615":52052,"_5":14871,"_28382":362,"_3078":52053},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3626":364,"_31190":362,"_5":31545,"_21615":52055,"_28382":52056,"_3078":52057},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3626":365,"_31190":362,"_5":31545,"_21615":52059,"_28382":52060,"_3078":52061},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3626":366,"_31190":362,"_5":31545,"_21615":52063,"_28382":52064,"_3078":52065},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3626":367,"_31190":362,"_5":31545,"_21615":52067,"_28382":52068,"_3078":52069},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3626":368,"_31190":362,"_5":31545,"_21615":52071,"_28382":52072,"_3078":52073},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3626":369,"_31190":362,"_5":31545,"_21615":52075,"_28382":52076,"_3078":52077},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3626":370,"_31190":362,"_21615":52079,"_5":14871,"_28382":52056,"_3078":52080},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3626":371,"_31190":362,"_21615":52082,"_5":14871,"_28382":52060,"_3078":52083},[],"Workflow",{"_3626":372,"_31190":362,"_21615":52085,"_5":14871,"_28382":52060,"_3078":52086},[],"Use it for",{"_3626":373,"_31190":362,"_21615":52088,"_5":14871,"_28382":52060,"_3078":52089},[],"What it installs",{"_3626":374,"_31190":362,"_21615":52091,"_5":14871,"_28382":52060,"_3078":52092},[],"Helm",{"_3626":375,"_31190":362,"_21615":52094,"_5":14871,"_28382":52060,"_3078":52095},[],"Production and controlled environments",{"_3626":376,"_31190":362,"_21615":52097,"_5":14871,"_28382":52060,"_3078":52098},[],"Lamassu services and Gateway API resources",{"_3626":377,"_31190":362,"_21615":52100,"_5":14871,"_28382":52060,"_3078":51211},[],{"_3626":378,"_31190":362,"_21615":52102,"_5":14871,"_28382":52060,"_3078":52103},[],"Evaluation, demos, CI and small lab clusters",{"_3626":379,"_31190":362,"_21615":52105,"_5":14871,"_28382":52060,"_3078":52106},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3626":380,"_31190":362,"_21615":52108,"_5":14871,"_28382":52064,"_3078":52109},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3626":381,"_31190":362,"_21615":52111,"_5":14871,"_28382":52064,"_3078":52112},[],"Area",{"_3626":382,"_31190":362,"_21615":52114,"_5":14871,"_28382":52064,"_3078":52115},[],"The Lamassu chart provides",{"_3626":383,"_31190":362,"_21615":52117,"_5":14871,"_28382":52064,"_3078":52118},[],"You provide",{"_3626":384,"_31190":362,"_21615":52120,"_5":14871,"_28382":52064,"_3078":52121},[],"Lamassu applications",{"_3626":385,"_31190":362,"_21615":52123,"_5":14871,"_28382":52064,"_3078":52124},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3626":386,"_31190":362,"_21615":52126,"_5":14871,"_28382":52064,"_3078":52127},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3626":387,"_31190":362,"_21615":52129,"_5":14871,"_28382":52064,"_3078":52130},[],"PostgreSQL data",{"_3626":388,"_31190":362,"_21615":52132,"_5":14871,"_28382":52064,"_3078":52133},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3626":389,"_31190":362,"_21615":52135,"_5":14871,"_28382":52064,"_3078":52136},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3626":390,"_31190":362,"_21615":52138,"_5":14871,"_28382":52064,"_3078":52139},[],"Messaging",{"_3626":391,"_31190":362,"_21615":52141,"_5":14871,"_28382":52064,"_3078":52142},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3626":392,"_31190":362,"_21615":52144,"_5":14871,"_28382":52064,"_3078":52145},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3626":393,"_31190":362,"_21615":52147,"_5":14871,"_28382":52064,"_3078":52148},[],"Identity",{"_3626":394,"_31190":362,"_21615":52150,"_5":14871,"_28382":52064,"_3078":52151},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3626":395,"_31190":362,"_21615":52153,"_5":14871,"_28382":52064,"_3078":52154},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3626":396,"_31190":362,"_21615":52156,"_5":14871,"_28382":52064,"_3078":52157},[],"External routing",{"_3626":397,"_31190":362,"_21615":52159,"_5":14871,"_28382":52064,"_3078":52160},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3626":398,"_31190":362,"_21615":52162,"_5":14871,"_28382":52064,"_3078":52163},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3626":399,"_31190":362,"_21615":52165,"_5":14871,"_28382":52064,"_3078":52166},[],"TLS",{"_3626":400,"_31190":362,"_21615":52168,"_5":14871,"_28382":52064,"_3078":52169},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3626":401,"_31190":362,"_21615":52171,"_5":14871,"_28382":52064,"_3078":52172},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3626":402,"_31190":362,"_21615":52174,"_5":14871,"_28382":52064,"_3078":52175},[],"Persistent application data",{"_3626":403,"_31190":362,"_21615":52177,"_5":14871,"_28382":52064,"_3078":52178},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3626":404,"_31190":362,"_21615":52180,"_5":14871,"_28382":52064,"_3078":52181},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3626":405,"_31190":362,"_21615":52183,"_5":14871,"_28382":52064,"_3078":52184},[],"Optional integrations",{"_3626":406,"_31190":362,"_21615":52186,"_5":14871,"_28382":52064,"_3078":52187},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3626":407,"_31190":362,"_21615":52189,"_5":14871,"_28382":52064,"_3078":52190},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3626":408,"_31190":362,"_21615":52192,"_5":14871,"_28382":52064,"_3078":52193},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3626":409,"_31190":362,"_21615":52195,"_5":14871,"_28382":52064,"_3078":52196},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3626":410,"_31190":362,"_21615":52198,"_5":14871,"_28382":52068,"_3078":52199},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3626":411,"_31190":362,"_21615":52201,"_5":14871,"_28382":52068,"_3078":52202},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3626":412,"_31190":362,"_21615":52204,"_5":14871,"_28382":52072,"_3078":52205},[],"Kubernetes 1.24 or newer",{"_3626":413,"_31190":362,"_21615":52207,"_5":14871,"_28382":52072,"_3078":52208},[],"Helm 3.2 or newer",{"_3626":414,"_31190":362,"_21615":52210,"_5":14871,"_28382":52072,"_3078":52211},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3626":415,"_31190":362,"_21615":52213,"_5":14871,"_28382":52072,"_3078":52214},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3626":416,"_31190":362,"_21615":52216,"_5":14871,"_28382":52072,"_3078":52217},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3626":417,"_31190":362,"_21615":52219,"_5":14871,"_28382":52072,"_3078":52220},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3626":418,"_31190":362,"_21615":52222,"_5":14871,"_28382":52072,"_3078":52223},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3626":419,"_31190":362,"_21615":52225,"_5":14871,"_28382":52076,"_3078":52226},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3626":420,"_31190":362,"_21615":52228,"_5":14871,"_28382":52076,"_3078":52229},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3626":421,"_31190":362,"_21615":52231,"_5":14871,"_28382":52076,"_3078":52232},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3626":422,"_31190":362,"_21615":52234,"_5":14871,"_28382":52076,"_3078":52235},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3626":423,"_31190":423,"_5":15231,"_3078":52237,"_31548":52238,"_21615":52240,"_28382":423},"Deployment troubleshooting",[50967,50968,52239],"Operations",[],{"_3626":424,"_31190":423,"_21615":52242,"_5":14871,"_28382":423,"_3078":52243},[],"Diagnose access, service health and infrastructure dependencies.",{"_3626":425,"_31190":423,"_5":31545,"_21615":52245,"_28382":52246,"_3078":52247},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3626":426,"_31190":423,"_5":31545,"_21615":52249,"_28382":52250,"_3078":52251},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3626":427,"_31190":423,"_5":31545,"_21615":52253,"_28382":52254,"_3078":52255},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3626":428,"_31190":423,"_5":31545,"_21615":52257,"_28382":52258,"_3078":52259},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3626":429,"_31190":423,"_5":31545,"_21615":52261,"_28382":52262,"_3078":52263},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3626":430,"_31190":423,"_5":31545,"_21615":52265,"_28382":52266,"_3078":52267},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3626":431,"_31190":423,"_5":31545,"_21615":52269,"_28382":52270,"_3078":52271},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3626":432,"_31190":423,"_5":31545,"_21615":52273,"_28382":52274,"_3078":52275},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3626":433,"_31190":423,"_5":31545,"_21615":52277,"_28382":52278,"_3078":52279},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3626":434,"_31190":423,"_5":31545,"_21615":52281,"_28382":52282,"_3078":52283},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3626":435,"_31190":423,"_5":31545,"_21615":52285,"_28382":52286,"_3078":52287},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3626":436,"_31190":423,"_5":31545,"_21615":52289,"_28382":52290,"_3078":52291},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3626":437,"_31190":423,"_5":31545,"_21615":52293,"_28382":52294,"_3078":52295},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#observability","Observability",{"_3626":438,"_31190":423,"_21615":52297,"_5":14871,"_28382":423,"_3078":52298},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3626":439,"_31190":423,"_21615":52300,"_5":14871,"_28382":52250,"_3078":52301},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3626":440,"_31190":423,"_21615":52303,"_5":14871,"_28382":52254,"_3078":52304},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3626":441,"_31190":423,"_21615":52306,"_5":14871,"_28382":52258,"_3078":52307},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3626":442,"_31190":423,"_21615":52309,"_5":14871,"_28382":52262,"_3078":52310},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3626":443,"_31190":423,"_21615":52312,"_5":14871,"_28382":52266,"_3078":52313},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3626":444,"_31190":423,"_21615":52315,"_5":14871,"_28382":52270,"_3078":52316},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3626":445,"_31190":423,"_21615":52318,"_5":14871,"_28382":52270,"_3078":52319},[],"Also run the chart's connectivity test:",{"_3626":446,"_31190":423,"_21615":52321,"_5":14871,"_28382":52270,"_3078":52322},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3626":447,"_31190":423,"_21615":52324,"_5":14871,"_28382":52270,"_3078":52325},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3626":448,"_31190":423,"_21615":52327,"_5":14871,"_28382":52274,"_3078":52328},[],"If you receive a 401:",{"_3626":449,"_31190":423,"_21615":52330,"_5":14871,"_28382":52274,"_3078":52331},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3626":450,"_31190":423,"_21615":52333,"_5":14871,"_28382":52274,"_3078":52334},[],"verify issuer, audience and expiration of the token;",{"_3626":451,"_31190":423,"_21615":52336,"_5":14871,"_28382":52274,"_3078":52337},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3626":452,"_31190":423,"_21615":52339,"_5":14871,"_28382":52274,"_3078":52340},[],"check that the provider's public and internal routes point to the same realm.",{"_3626":453,"_31190":423,"_21615":52342,"_5":14871,"_28382":52274,"_3078":52343},[],"If login succeeds but the APIs return 403:",{"_3626":454,"_31190":423,"_21615":52345,"_5":14871,"_28382":52274,"_3078":52346},[],"inspect the token's real claims;",{"_3626":455,"_31190":423,"_21615":52348,"_5":14871,"_28382":52274,"_3078":52349},[],"confirm they match an active principal;",{"_3626":456,"_31190":423,"_21615":52351,"_5":14871,"_28382":52274,"_3078":52352},[],"review the policies granted to that principal;",{"_3626":457,"_31190":423,"_21615":52354,"_5":14871,"_28382":52274,"_3078":52355},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3626":458,"_31190":423,"_21615":52357,"_5":14871,"_28382":52274,"_3078":52358},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3626":459,"_31190":423,"_21615":52360,"_5":14871,"_28382":52278,"_3078":52361},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3626":460,"_31190":423,"_21615":52363,"_5":14871,"_28382":52278,"_3078":52364},[],"Locate the authz pod and Service.",{"_3626":461,"_31190":423,"_21615":52366,"_5":14871,"_28382":52278,"_3078":52367},[],"Check /health, logs and its database connection.",{"_3626":462,"_31190":423,"_21615":52369,"_5":14871,"_28382":52278,"_3078":52370},[],"Verify the DNS and port configured in externalAuthorization.",{"_3626":463,"_31190":423,"_21615":52372,"_5":14871,"_28382":52278,"_3078":52373},[],"Check the check route is /v1/ext\\_authz/check.",{"_3626":464,"_31190":423,"_21615":52375,"_5":14871,"_28382":52278,"_3078":52376},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3626":465,"_31190":423,"_21615":52378,"_5":14871,"_28382":52282,"_3078":52379},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3626":466,"_31190":423,"_21615":52381,"_5":14871,"_28382":52286,"_3078":52382},[],"Review kubectl describe pod first. Common causes are:",{"_3626":467,"_31190":423,"_21615":52384,"_5":14871,"_28382":52286,"_3078":52385},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3626":468,"_31190":423,"_21615":52387,"_5":14871,"_28382":52286,"_3078":52388},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3626":469,"_31190":423,"_21615":52390,"_5":14871,"_28382":52286,"_3078":52391},[],"unbound persistent volume;",{"_3626":470,"_31190":423,"_21615":52393,"_5":14871,"_28382":52286,"_3078":52394},[],"inaccessible image or incorrect pull policy;",{"_3626":471,"_31190":423,"_21615":52396,"_5":14871,"_28382":52286,"_3078":52397},[],"invalid cryptographic engine configuration;",{"_3626":472,"_31190":423,"_21615":52399,"_5":14871,"_28382":52286,"_3078":52400},[],"CPU or memory limits set too low;",{"_3626":473,"_31190":423,"_21615":52402,"_5":14871,"_28382":52286,"_3078":52403},[],"an incomplete prior migration.",{"_3626":474,"_31190":423,"_21615":52405,"_5":14871,"_28382":52286,"_3078":52406},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3626":475,"_31190":423,"_21615":52408,"_5":14871,"_28382":52286,"_3078":52409},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3626":476,"_31190":423,"_21615":52411,"_5":14871,"_28382":52286,"_3078":52412},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3626":477,"_31190":423,"_21615":52414,"_5":14871,"_28382":52290,"_3078":52415},[],"Domain and audit events depend on the bus publisher:",{"_3626":478,"_31190":423,"_21615":52417,"_5":14871,"_28382":52290,"_3078":52418},[],"verify it is enabled in the emitting service;",{"_3626":479,"_31190":423,"_21615":52420,"_5":14871,"_28382":52290,"_3078":52421},[],"check AMQP connectivity and credentials;",{"_3626":480,"_31190":423,"_21615":52423,"_5":14871,"_28382":52290,"_3078":52424},[],"review exchange, routing key, queues and consumers;",{"_3626":481,"_31190":423,"_21615":52426,"_5":14871,"_28382":52290,"_3078":52427},[],"inspect dead-letter queues;",{"_3626":482,"_31190":423,"_21615":52429,"_5":14871,"_28382":52290,"_3078":52430},[],"alert on orphan durable queues and backlog growth.",{"_3626":483,"_31190":423,"_21615":52432,"_5":14871,"_28382":52290,"_3078":52433},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3626":484,"_31190":423,"_21615":52435,"_5":14871,"_28382":52290,"_3078":52436},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3626":485,"_31190":423,"_21615":52438,"_5":14871,"_28382":52290,"_3078":52439},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3626":486,"_31190":423,"_21615":52441,"_5":14871,"_28382":52290,"_3078":52442},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3626":487,"_31190":423,"_21615":52444,"_5":14871,"_28382":52290,"_3078":52445},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3626":488,"_31190":423,"_21615":52447,"_5":14871,"_28382":52290,"_3078":52448},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3626":489,"_31190":423,"_21615":52450,"_5":14871,"_28382":52290,"_3078":52451},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3626":490,"_31190":423,"_21615":52453,"_5":14871,"_28382":52294,"_3078":52454},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3626":491,"_31190":423,"_21615":52456,"_5":14871,"_28382":52294,"_3078":52457},[],"Before closing an incident, record:",{"_3626":492,"_31190":423,"_21615":52459,"_5":14871,"_28382":52294,"_3078":52460},[],"the confirmed cause;",{"_3626":493,"_31190":423,"_21615":52462,"_5":14871,"_28382":52294,"_3078":52463},[],"the time scope and affected resources;",{"_3626":494,"_31190":423,"_21615":52465,"_5":14871,"_28382":52294,"_3078":52466},[],"the commands or queries used;",{"_3626":495,"_31190":423,"_21615":52468,"_5":14871,"_28382":52294,"_3078":52469},[],"the applied change and how to revert it;",{"_3626":496,"_31190":423,"_21615":52471,"_5":14871,"_28382":52294,"_3078":52472},[],"validation from a consumer;",{"_3626":497,"_31190":423,"_21615":52474,"_5":14871,"_28382":52294,"_3078":52475},[],"the preventive action and its owner.",{"_3626":498,"_31190":498,"_5":15231,"_3078":52477,"_31548":52478,"_21615":52482,"_28382":498},"Data model",[50967,52479,52480,52481],"Platform","Administration","Access control",[],{"_3626":499,"_31190":498,"_21615":52484,"_5":14871,"_28382":498,"_3078":52485},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3626":500,"_31190":498,"_5":31545,"_21615":52487,"_28382":52488,"_3078":52489},[],"/docs/pr-preview/pr-77/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3626":501,"_31190":498,"_5":31545,"_21615":52491,"_28382":52492,"_3078":52493},[],"/docs/pr-preview/pr-77/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3626":502,"_31190":498,"_21615":52495,"_5":14871,"_28382":498,"_3078":52496},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3626":503,"_31190":498,"_21615":52498,"_5":14871,"_28382":52488,"_3078":52499},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3626":504,"_31190":498,"_21615":52501,"_5":14871,"_28382":52488,"_3078":52502},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3626":505,"_31190":498,"_21615":52504,"_5":14871,"_28382":52488,"_3078":52505},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3626":506,"_31190":498,"_21615":52507,"_5":14871,"_28382":52492,"_3078":52508},[],"Entity (`schema_name.entity_type`)",{"_3626":507,"_31190":498,"_21615":52510,"_5":14871,"_28382":52492,"_3078":52511},[],"Table (`table_name`)",{"_3626":508,"_31190":498,"_21615":52513,"_5":14871,"_28382":52492,"_3078":52514},[],"Key (`primary_key`)",{"_3626":509,"_31190":498,"_21615":52516,"_5":14871,"_28382":52492,"_3078":52517},[],"`alerts.event`",{"_3626":510,"_31190":498,"_21615":52519,"_5":14871,"_28382":52492,"_3078":52520},[],"`events`",{"_3626":511,"_31190":498,"_21615":52522,"_5":14871,"_28382":52492,"_3078":52523},[],"`event_type`",{"_3626":512,"_31190":498,"_21615":52525,"_5":14871,"_28382":52492,"_3078":52526},[],"`alerts.subscription`",{"_3626":513,"_31190":498,"_21615":52528,"_5":14871,"_28382":52492,"_3078":52529},[],"`subscriptions`",{"_3626":514,"_31190":498,"_21615":52531,"_5":14871,"_28382":52492,"_3078":52532},[],"`id`",{"_3626":515,"_31190":498,"_21615":52534,"_5":14871,"_28382":52492,"_3078":52535},[],"`ca.ca_certificate`",{"_3626":516,"_31190":498,"_21615":52537,"_5":14871,"_28382":52492,"_3078":52538},[],"`ca_certificates`",{"_3626":517,"_31190":498,"_21615":52540,"_5":14871,"_28382":52492,"_3078":52532},[],{"_3626":518,"_31190":498,"_21615":52542,"_5":14871,"_28382":52492,"_3078":52543},[],"`ca.certificate`",{"_3626":519,"_31190":498,"_21615":52545,"_5":14871,"_28382":52492,"_3078":52546},[],"`certificates`",{"_3626":520,"_31190":498,"_21615":52548,"_5":14871,"_28382":52492,"_3078":52549},[],"`serial_number`",{"_3626":521,"_31190":498,"_21615":52551,"_5":14871,"_28382":52492,"_3078":52552},[],"`ca.issuance_profile`",{"_3626":522,"_31190":498,"_21615":52554,"_5":14871,"_28382":52492,"_3078":52555},[],"`issuance_profiles`",{"_3626":523,"_31190":498,"_21615":52557,"_5":14871,"_28382":52492,"_3078":52532},[],{"_3626":524,"_31190":498,"_21615":52559,"_5":14871,"_28382":52492,"_3078":52560},[],"`devicemanager.device_group`",{"_3626":525,"_31190":498,"_21615":52562,"_5":14871,"_28382":52492,"_3078":52563},[],"`device_groups`",{"_3626":526,"_31190":498,"_21615":52565,"_5":14871,"_28382":52492,"_3078":52532},[],{"_3626":527,"_31190":498,"_21615":52567,"_5":14871,"_28382":52492,"_3078":52568},[],"`devicemanager.device`",{"_3626":528,"_31190":498,"_21615":52570,"_5":14871,"_28382":52492,"_3078":52571},[],"`devices`",{"_3626":529,"_31190":498,"_21615":52573,"_5":14871,"_28382":52492,"_3078":52532},[],{"_3626":530,"_31190":498,"_21615":52575,"_5":14871,"_28382":52492,"_3078":52576},[],"`dmsmanager.dms`",{"_3626":531,"_31190":498,"_21615":52578,"_5":14871,"_28382":52492,"_3078":52579},[],"`dms`",{"_3626":532,"_31190":498,"_21615":52581,"_5":14871,"_28382":52492,"_3078":52532},[],{"_3626":533,"_31190":498,"_21615":52583,"_5":14871,"_28382":52492,"_3078":52584},[],"`kms.kms_key`",{"_3626":534,"_31190":498,"_21615":52586,"_5":14871,"_28382":52492,"_3078":52587},[],"`kms_keys`",{"_3626":535,"_31190":498,"_21615":52589,"_5":14871,"_28382":52492,"_3078":52590},[],"`key_id`, `engine_id`",{"_3626":536,"_31190":498,"_21615":52592,"_5":14871,"_28382":52492,"_3078":52593},[],"`va.crl_settings`",{"_3626":537,"_31190":498,"_21615":52595,"_5":14871,"_28382":52492,"_3078":52596},[],"`crl_settings`",{"_3626":538,"_31190":498,"_21615":52598,"_5":14871,"_28382":52492,"_3078":52599},[],"`ca_id`",{"_3626":539,"_31190":498,"_21615":52601,"_5":14871,"_28382":52492,"_3078":52602},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3626":540,"_31190":498,"_21615":52604,"_5":14871,"_28382":52492,"_3078":52605},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3626":541,"_31190":498,"_21615":52607,"_5":14871,"_28382":52492,"_3078":52608},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3626":542,"_31190":542,"_5":15231,"_3078":52610,"_31548":52611,"_21615":52612,"_28382":542},"Access control overview",[50967,52479,52480,52481],[],{"_3626":543,"_31190":542,"_21615":52614,"_5":14871,"_28382":542,"_3078":52615},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3626":544,"_31190":542,"_5":31545,"_21615":52617,"_28382":52618,"_3078":52619},[],"/docs/pr-preview/pr-77/platform/administration/access-control#essential-concepts","Essential concepts",{"_3626":545,"_31190":542,"_5":31545,"_21615":52621,"_28382":52622,"_3078":52623},[],"/docs/pr-preview/pr-77/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3626":546,"_31190":542,"_5":31545,"_21615":52625,"_28382":52626,"_3078":52627},[],"/docs/pr-preview/pr-77/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3626":547,"_31190":542,"_5":31545,"_21615":52629,"_28382":52630,"_3078":52631},[],"/docs/pr-preview/pr-77/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3626":548,"_31190":542,"_5":31545,"_21615":52633,"_28382":52634,"_3078":52635},[],"/docs/pr-preview/pr-77/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3626":549,"_31190":542,"_5":31545,"_21615":52637,"_28382":52638,"_3078":52639},[],"/docs/pr-preview/pr-77/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3626":550,"_31190":542,"_5":31545,"_21615":52641,"_28382":52642,"_3078":52643},[],"/docs/pr-preview/pr-77/platform/administration/access-control#oidc-principals","OIDC principals",{"_3626":551,"_31190":542,"_5":31545,"_21615":52645,"_28382":52646,"_3078":52647},[],"/docs/pr-preview/pr-77/platform/administration/access-control#x509-principals","X.509 principals",{"_3626":552,"_31190":542,"_5":31545,"_21615":52649,"_28382":52650,"_3078":52651},[],"/docs/pr-preview/pr-77/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3626":553,"_31190":542,"_5":31545,"_21615":52653,"_28382":52654,"_3078":52655},[],"/docs/pr-preview/pr-77/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3626":554,"_31190":542,"_5":31545,"_21615":52657,"_28382":52658,"_3078":52659},[],"/docs/pr-preview/pr-77/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3626":555,"_31190":542,"_5":31545,"_21615":52661,"_28382":52662,"_3078":52663},[],"/docs/pr-preview/pr-77/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3626":556,"_31190":542,"_5":31545,"_21615":52665,"_28382":52666,"_3078":52667},[],"/docs/pr-preview/pr-77/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3626":557,"_31190":542,"_5":31545,"_21615":52669,"_28382":52670,"_3078":52671},[],"/docs/pr-preview/pr-77/platform/administration/access-control#http-rules","HTTP rules",{"_3626":558,"_31190":542,"_5":31545,"_21615":52673,"_28382":52674,"_3078":52675},[],"/docs/pr-preview/pr-77/platform/administration/access-control#included-policies","Included policies",{"_3626":559,"_31190":542,"_5":31545,"_21615":52677,"_28382":52678,"_3078":51617},[],"/docs/pr-preview/pr-77/platform/administration/access-control#provision-the-first-administrator",{"_3626":560,"_31190":542,"_5":31545,"_21615":52680,"_28382":52681,"_3078":52682},[],"/docs/pr-preview/pr-77/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3626":561,"_31190":542,"_5":31545,"_21615":52684,"_28382":52685,"_3078":52686},[],"/docs/pr-preview/pr-77/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3626":562,"_31190":542,"_5":31545,"_21615":52688,"_28382":52689,"_3078":52690},[],"/docs/pr-preview/pr-77/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3626":563,"_31190":542,"_5":31545,"_21615":52692,"_28382":52693,"_3078":52694},[],"/docs/pr-preview/pr-77/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3626":564,"_31190":542,"_5":31545,"_21615":52696,"_28382":52697,"_3078":52698},[],"/docs/pr-preview/pr-77/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3626":565,"_31190":542,"_5":31545,"_21615":52700,"_28382":52701,"_3078":52702},[],"/docs/pr-preview/pr-77/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3626":566,"_31190":542,"_5":31545,"_21615":52704,"_28382":52705,"_3078":52706},[],"/docs/pr-preview/pr-77/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3626":567,"_31190":542,"_5":31545,"_21615":52708,"_28382":52709,"_3078":52710},[],"/docs/pr-preview/pr-77/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3626":568,"_31190":542,"_5":31545,"_21615":52712,"_28382":52713,"_3078":52714},[],"/docs/pr-preview/pr-77/platform/administration/access-control#operational-checklist","Operational checklist",{"_3626":569,"_31190":542,"_5":31545,"_21615":52716,"_28382":52717,"_3078":52718},[],"/docs/pr-preview/pr-77/platform/administration/access-control#diagnostics","Diagnostics",{"_3626":570,"_31190":542,"_5":31545,"_21615":52720,"_28382":52721,"_3078":52722},[],"/docs/pr-preview/pr-77/platform/administration/access-control#the-response-is-401","The response is 401",{"_3626":571,"_31190":542,"_5":31545,"_21615":52724,"_28382":52725,"_3078":52726},[],"/docs/pr-preview/pr-77/platform/administration/access-control#the-response-is-403","The response is 403",{"_3626":572,"_31190":542,"_5":31545,"_21615":52728,"_28382":52729,"_3078":52730},[],"/docs/pr-preview/pr-77/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3626":573,"_31190":542,"_5":31545,"_21615":52732,"_28382":52733,"_3078":52734},[],"/docs/pr-preview/pr-77/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3626":574,"_31190":542,"_5":31545,"_21615":52736,"_28382":52737,"_3078":52738},[],"/docs/pr-preview/pr-77/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3626":575,"_31190":542,"_21615":52740,"_5":14871,"_28382":542,"_3078":52741},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3626":576,"_31190":542,"_21615":52743,"_5":14871,"_28382":542,"_3078":52744},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3626":577,"_31190":542,"_21615":52746,"_5":14871,"_28382":542,"_3078":52747},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3626":578,"_31190":542,"_21615":52749,"_5":14871,"_28382":52618,"_3078":52750},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3626":579,"_31190":542,"_21615":52752,"_5":14871,"_28382":52618,"_3078":52753},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3626":580,"_31190":542,"_21615":52755,"_5":14871,"_28382":52618,"_3078":52756},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3626":581,"_31190":542,"_21615":52758,"_5":14871,"_28382":52618,"_3078":52759},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3626":582,"_31190":542,"_21615":52761,"_5":14871,"_28382":52618,"_3078":52762},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3626":583,"_31190":542,"_21615":52764,"_5":14871,"_28382":52618,"_3078":52765},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3626":584,"_31190":542,"_21615":52767,"_5":14871,"_28382":52622,"_3078":52768},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3626":585,"_31190":542,"_21615":52770,"_5":14871,"_28382":52622,"_3078":52771},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3626":586,"_31190":542,"_21615":52773,"_5":14871,"_28382":52626,"_3078":52774},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3626":587,"_31190":542,"_21615":52776,"_5":14871,"_28382":52626,"_3078":52777},[],"The decision is made **before forwarding the request to the service**:",{"_3626":588,"_31190":542,"_21615":52779,"_5":14871,"_28382":52626,"_3078":52780},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3626":589,"_31190":542,"_21615":52782,"_5":14871,"_28382":52626,"_3078":52783},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3626":590,"_31190":542,"_21615":52785,"_5":14871,"_28382":52626,"_3078":52786},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3626":591,"_31190":542,"_21615":52788,"_5":14871,"_28382":52626,"_3078":52789},[],"It separately loads the policies granted to each principal.",{"_3626":592,"_31190":542,"_21615":52791,"_5":14871,"_28382":52626,"_3078":52792},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3626":593,"_31190":542,"_21615":52794,"_5":14871,"_28382":52626,"_3078":52795},[],"`authz` looks for an HTTP rule granting that action.",{"_3626":594,"_31190":542,"_21615":52797,"_5":14871,"_28382":52626,"_3078":52798},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3626":595,"_31190":542,"_21615":52800,"_5":14871,"_28382":52626,"_3078":52801},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3626":596,"_31190":542,"_21615":52803,"_5":14871,"_28382":52626,"_3078":52804},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3626":597,"_31190":542,"_21615":52806,"_5":14871,"_28382":52626,"_3078":52807},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3626":598,"_31190":542,"_21615":52809,"_5":14871,"_28382":52630,"_3078":52810},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3626":599,"_31190":542,"_21615":52812,"_5":14871,"_28382":52630,"_3078":52813},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3626":600,"_31190":542,"_21615":52815,"_5":14871,"_28382":52630,"_3078":52816},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3626":601,"_31190":542,"_21615":52818,"_5":14871,"_28382":52630,"_3078":52819},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3626":602,"_31190":542,"_21615":52821,"_5":14871,"_28382":52630,"_3078":52822},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3626":603,"_31190":542,"_21615":52824,"_5":14871,"_28382":52630,"_3078":52825},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3626":604,"_31190":542,"_21615":52827,"_5":14871,"_28382":52630,"_3078":52828},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3626":605,"_31190":542,"_21615":52830,"_5":14871,"_28382":52630,"_3078":52831},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3626":606,"_31190":542,"_21615":52833,"_5":14871,"_28382":52630,"_3078":52834},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3626":607,"_31190":542,"_21615":52836,"_5":14871,"_28382":52630,"_3078":52837},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3626":608,"_31190":542,"_21615":52839,"_5":14871,"_28382":52634,"_3078":52840},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3626":609,"_31190":542,"_21615":52842,"_5":14871,"_28382":52634,"_3078":52843},[],"The decision is made with the domain operation context:",{"_3626":610,"_31190":542,"_21615":52845,"_5":14871,"_28382":52634,"_3078":52846},[],"The middleware extracts the credential and resolves the matching principals.",{"_3626":611,"_31190":542,"_21615":52848,"_5":14871,"_28382":52634,"_3078":52849},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3626":612,"_31190":542,"_21615":52851,"_5":14871,"_28382":52634,"_3078":52852},[],"`authz` gathers the entity rules of the granted policies.",{"_3626":613,"_31190":542,"_21615":52854,"_5":14871,"_28382":52634,"_3078":52855},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3626":614,"_31190":542,"_21615":52857,"_5":14871,"_28382":52634,"_3078":52858},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3626":615,"_31190":542,"_21615":52860,"_5":14871,"_28382":52634,"_3078":52861},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3626":616,"_31190":542,"_21615":52863,"_5":14871,"_28382":52634,"_3078":52864},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3626":617,"_31190":542,"_21615":52866,"_5":14871,"_28382":52634,"_3078":52867},[],"Actions fall into two groups:",{"_3626":618,"_31190":542,"_21615":52869,"_5":14871,"_28382":52634,"_3078":52870},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3626":619,"_31190":542,"_21615":52872,"_5":14871,"_28382":52634,"_3078":52873},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3626":620,"_31190":542,"_21615":52875,"_5":14871,"_28382":52634,"_3078":52876},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3626":621,"_31190":542,"_21615":52878,"_5":14871,"_28382":52638,"_3078":52879},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3626":622,"_31190":542,"_21615":52881,"_5":14871,"_28382":52638,"_3078":52882},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3626":623,"_31190":542,"_21615":52884,"_5":14871,"_28382":52638,"_3078":52885},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3626":624,"_31190":542,"_21615":52887,"_5":14871,"_28382":52642,"_3078":52888},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3626":625,"_31190":542,"_21615":52890,"_5":14871,"_28382":52642,"_3078":52891},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3626":626,"_31190":542,"_21615":52893,"_5":14871,"_28382":52642,"_3078":52894},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3626":627,"_31190":542,"_21615":52896,"_5":14871,"_28382":52642,"_3078":52897},[],"The implemented operators are:",{"_3626":628,"_31190":542,"_21615":52899,"_5":14871,"_28382":52642,"_3078":52900},[],"`equals`, for exact equality;",{"_3626":629,"_31190":542,"_21615":52902,"_5":14871,"_28382":52642,"_3078":52903},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3626":630,"_31190":542,"_21615":52905,"_5":14871,"_28382":52642,"_3078":52906},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3626":631,"_31190":542,"_21615":52908,"_5":14871,"_28382":52642,"_3078":52909},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3626":632,"_31190":542,"_21615":52911,"_5":14871,"_28382":52646,"_3078":52912},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3626":633,"_31190":542,"_21615":52914,"_5":14871,"_28382":52646,"_3078":52915},[],"The available modes are:",{"_3626":634,"_31190":542,"_21615":52917,"_5":14871,"_28382":52646,"_3078":52918},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3626":635,"_31190":542,"_21615":52920,"_5":14871,"_28382":52646,"_3078":52921},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3626":636,"_31190":542,"_21615":52923,"_5":14871,"_28382":52646,"_3078":52924},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3626":637,"_31190":542,"_21615":52926,"_5":14871,"_28382":52646,"_3078":52927},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3626":638,"_31190":542,"_21615":52929,"_5":14871,"_28382":52646,"_3078":52930},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3626":639,"_31190":542,"_21615":52932,"_5":14871,"_28382":52646,"_3078":52933},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3626":640,"_31190":542,"_21615":52935,"_5":14871,"_28382":52650,"_3078":52936},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3626":641,"_31190":542,"_21615":52938,"_5":14871,"_28382":52650,"_3078":52939},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3626":642,"_31190":542,"_21615":52941,"_5":14871,"_28382":52650,"_3078":52942},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3626":643,"_31190":542,"_21615":52944,"_5":14871,"_28382":52650,"_3078":52945},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3626":644,"_31190":542,"_21615":52947,"_5":14871,"_28382":52658,"_3078":52948},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3626":645,"_31190":542,"_21615":52950,"_5":14871,"_28382":52658,"_3078":52951},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3626":646,"_31190":542,"_21615":52953,"_5":14871,"_28382":52662,"_3078":52954},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3626":647,"_31190":542,"_21615":52956,"_5":14871,"_28382":52662,"_3078":52957},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3626":648,"_31190":542,"_21615":52959,"_5":14871,"_28382":52662,"_3078":52960},[],"The data model shows how the resources used in entity rules are connected.",{"_3626":649,"_31190":542,"_21615":52962,"_5":14871,"_28382":52662,"_3078":52963},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3626":650,"_31190":542,"_21615":52965,"_5":14871,"_28382":52662,"_3078":52966},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3626":651,"_31190":542,"_21615":52968,"_5":14871,"_28382":52666,"_3078":52969},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3626":652,"_31190":542,"_21615":52971,"_5":14871,"_28382":52666,"_3078":52972},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3626":653,"_31190":542,"_21615":52974,"_5":14871,"_28382":52666,"_3078":52975},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3626":654,"_31190":542,"_21615":52977,"_5":14871,"_28382":52670,"_3078":52978},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3626":655,"_31190":542,"_21615":52980,"_5":14871,"_28382":52670,"_3078":52981},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3626":656,"_31190":542,"_21615":52983,"_5":14871,"_28382":52670,"_3078":52984},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3626":657,"_31190":542,"_21615":52986,"_5":14871,"_28382":52670,"_3078":52987},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3626":658,"_31190":542,"_21615":52989,"_5":14871,"_28382":52670,"_3078":52990},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3626":659,"_31190":542,"_21615":52992,"_5":14871,"_28382":52670,"_3078":52993},[],"Note that:",{"_3626":660,"_31190":542,"_21615":52995,"_5":14871,"_28382":52670,"_3078":52996},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3626":661,"_31190":542,"_21615":52998,"_5":14871,"_28382":52670,"_3078":52999},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3626":662,"_31190":542,"_21615":53001,"_5":14871,"_28382":52670,"_3078":53002},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3626":663,"_31190":542,"_21615":53004,"_5":14871,"_28382":52674,"_3078":53005},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3626":664,"_31190":542,"_21615":53007,"_5":14871,"_28382":52674,"_3078":53008},[],"full and read-only access to certificates and authorities;",{"_3626":665,"_31190":542,"_21615":53010,"_5":14871,"_28382":52674,"_3078":53011},[],"full and read-only access to the KMS;",{"_3626":666,"_31190":542,"_21615":53013,"_5":14871,"_28382":52674,"_3078":53014},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3626":667,"_31190":542,"_21615":53016,"_5":14871,"_28382":52674,"_3078":53017},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3626":668,"_31190":542,"_21615":53019,"_5":14871,"_28382":52674,"_3078":53020},[],"console access;",{"_3626":669,"_31190":542,"_21615":53022,"_5":14871,"_28382":52674,"_3078":53023},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3626":670,"_31190":542,"_21615":53025,"_5":14871,"_28382":52674,"_3078":53026},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3626":671,"_31190":542,"_21615":53028,"_5":14871,"_28382":52674,"_3078":53029},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3626":672,"_31190":542,"_21615":53031,"_5":14871,"_28382":52674,"_3078":53032},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3626":673,"_31190":542,"_21615":53034,"_5":14871,"_28382":52674,"_3078":53035},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3626":674,"_31190":542,"_21615":53037,"_5":14871,"_28382":52678,"_3078":53038},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3626":675,"_31190":542,"_21615":53040,"_5":14871,"_28382":52678,"_3078":53041},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3626":676,"_31190":542,"_21615":53043,"_5":14871,"_28382":52678,"_3078":53044},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3626":677,"_31190":542,"_21615":53046,"_5":14871,"_28382":52681,"_3078":53047},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3626":678,"_31190":542,"_21615":53049,"_5":14871,"_28382":52685,"_3078":53050},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3626":679,"_31190":542,"_21615":53052,"_5":14871,"_28382":52685,"_3078":53053},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3626":680,"_31190":542,"_21615":53055,"_5":14871,"_28382":52689,"_3078":53056},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3626":681,"_31190":542,"_21615":53058,"_5":14871,"_28382":52693,"_3078":53059},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3626":682,"_31190":542,"_21615":53061,"_5":14871,"_28382":52697,"_3078":53062},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3626":683,"_31190":542,"_21615":53064,"_5":14871,"_28382":52701,"_3078":53065},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3626":684,"_31190":542,"_21615":53067,"_5":14871,"_28382":52701,"_3078":53068},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3626":685,"_31190":542,"_21615":53070,"_5":14871,"_28382":52705,"_3078":53071},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3626":686,"_31190":542,"_21615":53073,"_5":14871,"_28382":52705,"_3078":53074},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3626":687,"_31190":542,"_21615":53076,"_5":14871,"_28382":52705,"_3078":53077},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3626":688,"_31190":542,"_21615":53079,"_5":14871,"_28382":52705,"_3078":53080},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3626":689,"_31190":542,"_21615":53082,"_5":14871,"_28382":52705,"_3078":53083},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3626":690,"_31190":542,"_21615":53085,"_5":14871,"_28382":52705,"_3078":53086},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3626":691,"_31190":542,"_21615":53088,"_5":14871,"_28382":52705,"_3078":53089},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3626":692,"_31190":542,"_21615":53091,"_5":14871,"_28382":52705,"_3078":53092},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3626":693,"_31190":542,"_21615":53094,"_5":14871,"_28382":52709,"_3078":53095},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3626":694,"_31190":542,"_21615":53097,"_5":14871,"_28382":52709,"_3078":53098},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3626":695,"_31190":542,"_21615":53100,"_5":14871,"_28382":52709,"_3078":53101},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3626":696,"_31190":542,"_21615":53103,"_5":14871,"_28382":52713,"_3078":53104},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3626":697,"_31190":542,"_21615":53106,"_5":14871,"_28382":52713,"_3078":53107},[],"Use groups or stable roles for people and independent identities for automations.",{"_3626":698,"_31190":542,"_21615":53109,"_5":14871,"_28382":52713,"_3078":53110},[],"Keep at least two recovery administrators and test their access periodically.",{"_3626":699,"_31190":542,"_21615":53112,"_5":14871,"_28382":52713,"_3078":53113},[],"Review active principals, their matches and their grants after IdP changes.",{"_3626":700,"_31190":542,"_21615":53115,"_5":14871,"_28382":52713,"_3078":53116},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3626":701,"_31190":542,"_21615":53118,"_5":14871,"_28382":52713,"_3078":53119},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3626":702,"_31190":542,"_21615":53121,"_5":14871,"_28382":52713,"_3078":53122},[],"Always test one allowed and one denied operation for each role.",{"_3626":703,"_31190":542,"_21615":53124,"_5":14871,"_28382":52713,"_3078":53125},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3626":704,"_31190":542,"_21615":53127,"_5":14871,"_28382":52721,"_3078":53128},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3626":705,"_31190":542,"_21615":53130,"_5":14871,"_28382":52725,"_3078":53131},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3626":706,"_31190":542,"_21615":53133,"_5":14871,"_28382":52725,"_3078":53134},[],"that an active principal of the correct type exists;",{"_3626":707,"_31190":542,"_21615":53136,"_5":14871,"_28382":52725,"_3078":53137},[],"that the claim paths and values match the real token exactly;",{"_3626":708,"_31190":542,"_21615":53139,"_5":14871,"_28382":52725,"_3078":53140},[],"that all of the principal's conditions hold;",{"_3626":709,"_31190":542,"_21615":53142,"_5":14871,"_28382":52725,"_3078":53143},[],"that the principal has the expected policy granted;",{"_3626":710,"_31190":542,"_21615":53145,"_5":14871,"_28382":52725,"_3078":53146},[],"that the policy includes the action and the requested resource type or route;",{"_3626":711,"_31190":542,"_21615":53148,"_5":14871,"_28382":52725,"_3078":53149},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3626":712,"_31190":542,"_21615":53151,"_5":14871,"_28382":52725,"_3078":53152},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3626":713,"_31190":542,"_21615":53154,"_5":14871,"_28382":52725,"_3078":53155},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3626":714,"_31190":542,"_21615":53157,"_5":14871,"_28382":52729,"_3078":53158},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3626":715,"_31190":542,"_21615":53160,"_5":14871,"_28382":52733,"_3078":53161},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3626":716,"_31190":542,"_21615":53163,"_5":14871,"_28382":52737,"_3078":53164},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3626":717,"_31190":542,"_21615":53166,"_5":14871,"_28382":52737,"_3078":53167},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3626":718,"_31190":718,"_5":15231,"_3078":53169,"_31548":53170,"_21615":53171,"_28382":718},"Alerts and subscriptions",[50967,52479,52480],[],{"_3626":719,"_31190":718,"_21615":53173,"_5":14871,"_28382":718,"_3078":53174},[],"Send PKI events to people and external systems.",{"_3626":720,"_31190":718,"_5":31545,"_21615":53176,"_28382":53177,"_3078":53178},[],"/docs/pr-preview/pr-77/platform/administration/alerts#how-it-works","How it works",{"_3626":721,"_31190":718,"_5":31545,"_21615":53180,"_28382":53181,"_3078":53182},[],"/docs/pr-preview/pr-77/platform/administration/alerts#available-channels","Available channels",{"_3626":722,"_31190":718,"_5":31545,"_21615":53184,"_28382":53185,"_3078":53186},[],"/docs/pr-preview/pr-77/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3626":723,"_31190":718,"_5":31545,"_21615":53188,"_28382":53189,"_3078":53190},[],"/docs/pr-preview/pr-77/platform/administration/alerts#choose-the-event","Choose the event",{"_3626":724,"_31190":718,"_5":31545,"_21615":53192,"_28382":53193,"_3078":53194},[],"/docs/pr-preview/pr-77/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3626":725,"_31190":718,"_5":31545,"_21615":53196,"_28382":53197,"_3078":53198},[],"/docs/pr-preview/pr-77/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3626":726,"_31190":718,"_5":31545,"_21615":53200,"_28382":53201,"_3078":53202},[],"/docs/pr-preview/pr-77/platform/administration/alerts#review-and-activate","Review and activate",{"_3626":727,"_31190":718,"_5":31545,"_21615":53204,"_28382":53205,"_3078":53206},[],"/docs/pr-preview/pr-77/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3626":728,"_31190":718,"_5":31545,"_21615":53208,"_28382":53209,"_3078":53210},[],"/docs/pr-preview/pr-77/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3626":729,"_31190":718,"_5":31545,"_21615":53212,"_28382":53213,"_3078":53214},[],"/docs/pr-preview/pr-77/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3626":730,"_31190":718,"_5":31545,"_21615":53216,"_28382":53217,"_3078":53218},[],"/docs/pr-preview/pr-77/platform/administration/alerts#event-families","Event families",{"_3626":731,"_31190":718,"_21615":53220,"_5":14871,"_28382":718,"_3078":53221},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3626":732,"_31190":718,"_21615":53223,"_5":14871,"_28382":53177,"_3078":53224},[],"A service publishes a domain event.",{"_3626":733,"_31190":718,"_21615":53226,"_5":14871,"_28382":53177,"_3078":53227},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3626":734,"_31190":718,"_21615":53229,"_5":14871,"_28382":53177,"_3078":53230},[],"Each subscription's filter decides whether it should be notified.",{"_3626":735,"_31190":718,"_21615":53232,"_5":14871,"_28382":53177,"_3078":53233},[],"Lamassu delivers the event to the configured channel.",{"_3626":736,"_31190":718,"_21615":53235,"_5":14871,"_28382":53177,"_3078":53236},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3626":737,"_31190":718,"_21615":53238,"_5":14871,"_28382":53181,"_3078":53239},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3626":738,"_31190":718,"_21615":53241,"_5":14871,"_28382":53181,"_3078":53242},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3626":739,"_31190":718,"_21615":53244,"_5":14871,"_28382":53181,"_3078":53245},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3626":740,"_31190":718,"_21615":53247,"_5":14871,"_28382":53181,"_3078":53248},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3626":741,"_31190":718,"_21615":53250,"_5":14871,"_28382":53181,"_3078":53251},[],"`apikey_options` requires `header` and `key`.",{"_3626":742,"_31190":718,"_21615":53253,"_5":14871,"_28382":53181,"_3078":53254},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3626":743,"_31190":718,"_21615":53256,"_5":14871,"_28382":53181,"_3078":53257},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3626":744,"_31190":718,"_21615":53259,"_5":14871,"_28382":53181,"_3078":53260},[],"The alerts API reference documents the full `http_client` schema.",{"_3626":745,"_31190":718,"_21615":53262,"_5":14871,"_28382":53189,"_3078":53263},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3626":746,"_31190":718,"_21615":53265,"_5":14871,"_28382":53193,"_3078":53266},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3626":747,"_31190":718,"_21615":53268,"_5":14871,"_28382":53197,"_3078":53269},[],"Add a filter if you don't want to receive every instance of the event.",{"_3626":748,"_31190":718,"_21615":53271,"_5":14871,"_28382":53197,"_3078":53272},[],"**None** notifies all instances of the event.",{"_3626":749,"_31190":718,"_21615":53274,"_5":14871,"_28382":53197,"_3078":53275},[],"**JSON Path** evaluates one or more specific fields.",{"_3626":750,"_31190":718,"_21615":53277,"_5":14871,"_28382":53197,"_3078":53278},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3626":751,"_31190":718,"_21615":53280,"_5":14871,"_28382":53197,"_3078":53281},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3626":752,"_31190":718,"_21615":53283,"_5":14871,"_28382":53197,"_3078":53284},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3626":753,"_31190":718,"_21615":53286,"_5":14871,"_28382":53197,"_3078":53287},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3626":754,"_31190":718,"_21615":53289,"_5":14871,"_28382":53201,"_3078":53290},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3626":755,"_31190":718,"_21615":53292,"_5":14871,"_28382":53205,"_3078":53293},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3626":756,"_31190":718,"_21615":53295,"_5":14871,"_28382":53205,"_3078":53296},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3626":757,"_31190":718,"_21615":53298,"_5":14871,"_28382":53205,"_3078":53299},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3626":758,"_31190":718,"_21615":53301,"_5":14871,"_28382":53205,"_3078":53302},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3626":759,"_31190":718,"_21615":53304,"_5":14871,"_28382":53205,"_3078":53305},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3626":760,"_31190":718,"_21615":53307,"_5":14871,"_28382":53205,"_3078":53308},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3626":761,"_31190":718,"_21615":53310,"_5":14871,"_28382":53205,"_3078":53311},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3626":762,"_31190":718,"_21615":53313,"_5":14871,"_28382":53205,"_3078":53314},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3626":763,"_31190":718,"_21615":53316,"_5":14871,"_28382":53209,"_3078":53317},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3626":764,"_31190":718,"_21615":53319,"_5":14871,"_28382":53209,"_3078":53320},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3626":765,"_31190":718,"_21615":53322,"_5":14871,"_28382":53209,"_3078":53323},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3626":766,"_31190":718,"_21615":53325,"_5":14871,"_28382":53209,"_3078":53326},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3626":767,"_31190":718,"_21615":53328,"_5":14871,"_28382":53209,"_3078":53329},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3626":768,"_31190":718,"_21615":53331,"_5":14871,"_28382":53209,"_3078":53332},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3626":769,"_31190":718,"_21615":53334,"_5":14871,"_28382":53209,"_3078":53335},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3626":770,"_31190":718,"_21615":53337,"_5":14871,"_28382":53209,"_3078":53338},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3626":771,"_31190":718,"_21615":53340,"_5":14871,"_28382":53213,"_3078":53341},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3626":772,"_31190":718,"_21615":53343,"_5":14871,"_28382":53213,"_3078":53344},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3626":773,"_31190":718,"_21615":53346,"_5":14871,"_28382":53217,"_3078":53347},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3626":774,"_31190":718,"_21615":53349,"_5":14871,"_28382":53217,"_3078":53350},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3626":775,"_31190":718,"_21615":53352,"_5":14871,"_28382":53217,"_3078":53353},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3626":776,"_31190":718,"_21615":53355,"_5":14871,"_28382":53217,"_3078":53356},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3626":777,"_31190":718,"_21615":53358,"_5":14871,"_28382":53217,"_3078":53359},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3626":778,"_31190":718,"_21615":53361,"_5":14871,"_28382":53217,"_3078":53362},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3626":779,"_31190":718,"_21615":53364,"_5":14871,"_28382":53217,"_3078":53365},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3626":780,"_31190":718,"_21615":53367,"_5":14871,"_28382":53217,"_3078":53368},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3626":781,"_31190":718,"_21615":53370,"_5":14871,"_28382":53217,"_3078":53371},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3626":782,"_31190":718,"_21615":53373,"_5":14871,"_28382":53217,"_3078":53374},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3626":783,"_31190":783,"_5":15231,"_3078":53376,"_31548":53377,"_21615":53378,"_28382":783},"Audit logs",[50967,52479,52480],[],{"_3626":784,"_31190":783,"_21615":53380,"_5":14871,"_28382":783,"_3078":53381},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3626":785,"_31190":783,"_5":31545,"_21615":53383,"_28382":53384,"_3078":53385},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3626":786,"_31190":783,"_5":31545,"_21615":53387,"_28382":53388,"_3078":53389},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#coverage","Coverage",{"_3626":787,"_31190":783,"_5":31545,"_21615":53391,"_28382":53392,"_3078":53393},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3626":788,"_31190":783,"_5":31545,"_21615":53395,"_28382":53396,"_3078":53397},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3626":789,"_31190":783,"_5":31545,"_21615":53399,"_28382":53400,"_3078":53401},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3626":790,"_31190":783,"_5":31545,"_21615":53403,"_28382":53404,"_3078":53405},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3626":791,"_31190":783,"_5":31545,"_21615":53407,"_28382":53408,"_3078":53409},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3626":792,"_31190":783,"_5":31545,"_21615":53411,"_28382":53412,"_3078":53413},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3626":793,"_31190":783,"_5":31545,"_21615":53415,"_28382":53416,"_3078":53417},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3626":794,"_31190":783,"_5":31545,"_21615":53419,"_28382":53420,"_3078":53421},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3626":795,"_31190":783,"_5":31545,"_21615":53423,"_28382":53424,"_3078":53425},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3626":796,"_31190":783,"_21615":53427,"_5":14871,"_28382":783,"_3078":53428},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3626":797,"_31190":783,"_21615":53430,"_5":14871,"_28382":53384,"_3078":53431},[],"The audit body includes:",{"_3626":798,"_31190":783,"_21615":53433,"_5":14871,"_28382":53384,"_3078":53434},[],"input: data received by the operation;",{"_3626":799,"_31190":783,"_21615":53436,"_5":14871,"_28382":53384,"_3078":53437},[],"has\\_error: whether the service returned an error;",{"_3626":800,"_31190":783,"_21615":53439,"_5":14871,"_28382":53384,"_3078":53440},[],"output: produced result or error message;",{"_3626":801,"_31190":783,"_21615":53442,"_5":14871,"_28382":53384,"_3078":53443},[],"principals: identifiers of the principals that matched the request.",{"_3626":802,"_31190":783,"_21615":53445,"_5":14871,"_28382":53384,"_3078":53446},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3626":803,"_31190":783,"_21615":53448,"_5":14871,"_28382":53384,"_3078":53449},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3626":804,"_31190":783,"_21615":53451,"_5":14871,"_28382":53388,"_3078":53452},[],"The backend applies auditing to mutations of:",{"_3626":805,"_31190":783,"_21615":53454,"_5":14871,"_28382":53388,"_3078":53455},[],"authorities, certificates and issuance profiles;",{"_3626":806,"_31190":783,"_21615":53457,"_5":14871,"_28382":53388,"_3078":53458},[],"keys and KMS engines;",{"_3626":807,"_31190":783,"_21615":53460,"_5":14871,"_28382":53388,"_3078":53461},[],"devices and identities;",{"_3626":808,"_31190":783,"_21615":53463,"_5":14871,"_28382":53388,"_3078":53464},[],"DMSs and enrollment operations;",{"_3626":809,"_31190":783,"_21615":53466,"_5":14871,"_28382":53388,"_3078":53467},[],"validation functions and CRL;",{"_3626":810,"_31190":783,"_21615":53469,"_5":14871,"_28382":53388,"_3078":53470},[],"principals, policies and authorization grants.",{"_3626":811,"_31190":783,"_21615":53472,"_5":14871,"_28382":53388,"_3078":53473},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3626":812,"_31190":783,"_21615":53475,"_5":14871,"_28382":53392,"_3078":53476},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3626":813,"_31190":783,"_21615":53478,"_5":14871,"_28382":53392,"_3078":53479},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3626":814,"_31190":783,"_21615":53481,"_5":14871,"_28382":53392,"_3078":53482},[],"Design the consumer to:",{"_3626":815,"_31190":783,"_21615":53484,"_5":14871,"_28382":53392,"_3078":53485},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3626":816,"_31190":783,"_21615":53487,"_5":14871,"_28382":53392,"_3078":53488},[],"keep the complete CloudEvent unmodified;",{"_3626":817,"_31190":783,"_21615":53490,"_5":14871,"_28382":53392,"_3078":53491},[],"record the ingestion time and detect duplicates by ID;",{"_3626":818,"_31190":783,"_21615":53493,"_5":14871,"_28382":53392,"_3078":53494},[],"encrypt in transit and at rest;",{"_3626":819,"_31190":783,"_21615":53496,"_5":14871,"_28382":53392,"_3078":53497},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3626":820,"_31190":783,"_21615":53499,"_5":14871,"_28382":53392,"_3078":53500},[],"apply an explicit retention and legal hold policy;",{"_3626":821,"_31190":783,"_21615":53502,"_5":14871,"_28382":53392,"_3078":53503},[],"alert if it stops consuming or the pending queue grows.",{"_3626":822,"_31190":783,"_21615":53505,"_5":14871,"_28382":53396,"_3078":53506},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3626":823,"_31190":783,"_21615":53508,"_5":14871,"_28382":53396,"_3078":53509},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3626":824,"_31190":783,"_21615":53511,"_5":14871,"_28382":53404,"_3078":53512},[],"Start from the reported time and normalize every source to UTC.",{"_3626":825,"_31190":783,"_21615":53514,"_5":14871,"_28382":53408,"_3078":53515},[],"Filter by event type, service source and resource identifier.",{"_3626":826,"_31190":783,"_21615":53517,"_5":14871,"_28382":53412,"_3078":53518},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3626":827,"_31190":783,"_21615":53520,"_5":14871,"_28382":53416,"_3078":53521},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3626":828,"_31190":783,"_21615":53523,"_5":14871,"_28382":53420,"_3078":53524},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3626":829,"_31190":783,"_21615":53526,"_5":14871,"_28382":53424,"_3078":53527},[],"Generate a controlled mutation in a test environment and check that:",{"_3626":830,"_31190":783,"_21615":53529,"_5":14871,"_28382":53424,"_3078":53530},[],"a successful audit event appears;",{"_3626":831,"_31190":783,"_21615":53532,"_5":14871,"_28382":53424,"_3078":53533},[],"the principal matches the identity used;",{"_3626":832,"_31190":783,"_21615":53535,"_5":14871,"_28382":53424,"_3078":53536},[],"the consumer persists it exactly once;",{"_3626":833,"_31190":783,"_21615":53538,"_5":14871,"_28382":53424,"_3078":53539},[],"it can be retrieved by resource, actor and period;",{"_3626":834,"_31190":783,"_21615":53541,"_5":14871,"_28382":53424,"_3078":53542},[],"a consumer outage raises an alert.",{"_3626":835,"_31190":783,"_21615":53544,"_5":14871,"_28382":53424,"_3078":53545},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3626":836,"_31190":836,"_5":15231,"_3078":53547,"_31548":53548,"_21615":53549,"_28382":836},"Platform architecture",[50967,52479],[],{"_3626":837,"_31190":836,"_21615":53551,"_5":14871,"_28382":836,"_3078":53552},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3626":838,"_31190":836,"_5":31545,"_21615":53554,"_28382":53555,"_3078":53556},[],"/docs/pr-preview/pr-77/platform/concepts/architecture#control-plane","Control plane",{"_3626":839,"_31190":836,"_5":31545,"_21615":53558,"_28382":53559,"_3078":53560},[],"/docs/pr-preview/pr-77/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3626":840,"_31190":836,"_5":31545,"_21615":53562,"_28382":53563,"_3078":53564},[],"/docs/pr-preview/pr-77/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3626":841,"_31190":836,"_5":31545,"_21615":53566,"_28382":53567,"_3078":53568},[],"/docs/pr-preview/pr-77/platform/concepts/architecture#status-and-validation","Status and validation",{"_3626":842,"_31190":836,"_5":31545,"_21615":53570,"_28382":53571,"_3078":53572},[],"/docs/pr-preview/pr-77/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3626":843,"_31190":836,"_21615":53574,"_5":14871,"_28382":836,"_3078":53575},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3626":844,"_31190":836,"_21615":53577,"_5":14871,"_28382":836,"_3078":53578},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3626":845,"_31190":836,"_21615":53580,"_5":14871,"_28382":53555,"_3078":53581},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3626":846,"_31190":836,"_21615":53583,"_5":14871,"_28382":53559,"_3078":53584},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3626":847,"_31190":836,"_21615":53586,"_5":14871,"_28382":53563,"_3078":53587},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3626":848,"_31190":836,"_21615":53589,"_5":14871,"_28382":53567,"_3078":53590},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3626":849,"_31190":836,"_21615":53592,"_5":14871,"_28382":53571,"_3078":53593},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3626":850,"_31190":850,"_5":15231,"_3078":53595,"_31548":53596,"_21615":53597,"_28382":850},"How Lamassu works",[50967,52479],[],{"_3626":851,"_31190":850,"_21615":53599,"_5":14871,"_28382":850,"_3078":53600},[],"The mental model of trust, keys, certificates and devices.",{"_3626":852,"_31190":850,"_5":31545,"_21615":53602,"_28382":53603,"_3078":53604},[],"/docs/pr-preview/pr-77/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3626":853,"_31190":850,"_5":31545,"_21615":53606,"_28382":53607,"_3078":53608},[],"/docs/pr-preview/pr-77/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3626":854,"_31190":850,"_21615":53610,"_5":14871,"_28382":850,"_3078":53611},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3626":855,"_31190":850,"_21615":53613,"_5":14871,"_28382":53603,"_3078":53614},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3626":856,"_31190":850,"_21615":53616,"_5":14871,"_28382":53603,"_3078":53617},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3626":857,"_31190":850,"_21615":53619,"_5":14871,"_28382":53603,"_3078":53620},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3626":858,"_31190":850,"_21615":53622,"_5":14871,"_28382":53603,"_3078":53623},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3626":859,"_31190":850,"_21615":53625,"_5":14871,"_28382":53603,"_3078":53626},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3626":860,"_31190":850,"_21615":53628,"_5":14871,"_28382":53607,"_3078":53629},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3626":861,"_31190":850,"_21615":53631,"_5":14871,"_28382":53607,"_3078":53632},[],"A DMS relates that CA to an enrollment policy.",{"_3626":862,"_31190":850,"_21615":53634,"_5":14871,"_28382":53607,"_3078":53635},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3626":863,"_31190":850,"_21615":53637,"_5":14871,"_28382":53607,"_3078":53638},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3626":864,"_31190":850,"_21615":53640,"_5":14871,"_28382":53607,"_3078":53641},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3626":865,"_31190":850,"_21615":53643,"_5":14871,"_28382":53607,"_3078":53644},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3626":866,"_31190":850,"_21615":53646,"_5":14871,"_28382":53607,"_3078":53647},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3626":867,"_31190":867,"_5":15231,"_3078":53649,"_31548":53650,"_21615":53652,"_28382":867},"Devices and identities",[50967,52479,53651,53649],"IoT Fleets",[],{"_3626":868,"_31190":867,"_21615":53654,"_5":14871,"_28382":867,"_3078":53655},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3626":869,"_31190":867,"_5":31545,"_21615":53657,"_28382":53658,"_3078":53659},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#device-states","Device states",{"_3626":870,"_31190":867,"_5":31545,"_21615":53661,"_28382":53662,"_3078":53663},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3626":871,"_31190":867,"_5":31545,"_21615":53665,"_28382":53666,"_3078":53667},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3626":872,"_31190":867,"_5":31545,"_21615":53669,"_28382":53670,"_3078":53671},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3626":873,"_31190":867,"_5":31545,"_21615":53673,"_28382":53674,"_3078":53675},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3626":874,"_31190":867,"_5":31545,"_21615":53677,"_28382":53678,"_3078":53679},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3626":875,"_31190":867,"_5":31545,"_21615":53681,"_28382":53682,"_3078":53683},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3626":876,"_31190":867,"_5":31545,"_21615":53685,"_28382":53686,"_3078":53687},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3626":877,"_31190":867,"_5":31545,"_21615":53689,"_28382":53690,"_3078":53691},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3626":878,"_31190":867,"_5":31545,"_21615":53693,"_28382":53694,"_3078":53695},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3626":879,"_31190":867,"_5":31545,"_21615":53697,"_28382":53698,"_3078":53699},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3626":880,"_31190":867,"_21615":53701,"_5":14871,"_28382":867,"_3078":53702},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3626":881,"_31190":867,"_21615":53704,"_5":14871,"_28382":867,"_3078":53705},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3626":882,"_31190":867,"_21615":53707,"_5":14871,"_28382":53658,"_3078":53708},[],"Operational view",{"_3626":883,"_31190":867,"_21615":53710,"_5":14871,"_28382":53658,"_3078":53711},[],"Meaning",{"_3626":884,"_31190":867,"_21615":53713,"_5":14871,"_28382":53658,"_3078":53714},[],"**No Identity**",{"_3626":885,"_31190":867,"_21615":53716,"_5":14871,"_28382":53658,"_3078":53717},[],"A record exists without an associated identity.",{"_3626":886,"_31190":867,"_21615":53719,"_5":14871,"_28382":53658,"_3078":53720},[],"**Active**",{"_3626":887,"_31190":867,"_21615":53722,"_5":14871,"_28382":53658,"_3078":53723},[],"The slot is active; also check certificate dates, status and usages.",{"_3626":888,"_31190":867,"_21615":53725,"_5":14871,"_28382":53658,"_3078":53726},[],"**Renewal Pending**",{"_3626":889,"_31190":867,"_21615":53728,"_5":14871,"_28382":53658,"_3078":53729},[],"The identity is in the operational renewal window.",{"_3626":890,"_31190":867,"_21615":53731,"_5":14871,"_28382":53658,"_3078":53732},[],"**Expiring Soon**",{"_3626":891,"_31190":867,"_21615":53734,"_5":14871,"_28382":53658,"_3078":53735},[],"Expiration is approaching according to configured thresholds.",{"_3626":892,"_31190":867,"_21615":53737,"_5":14871,"_28382":53658,"_3078":53738},[],"**Expired**",{"_3626":893,"_31190":867,"_21615":53740,"_5":14871,"_28382":53658,"_3078":53741},[],"The identity has expired.",{"_3626":894,"_31190":867,"_21615":53743,"_5":14871,"_28382":53658,"_3078":53744},[],"**Revoked**",{"_3626":895,"_31190":867,"_21615":53746,"_5":14871,"_28382":53658,"_3078":53747},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3626":896,"_31190":867,"_21615":53749,"_5":14871,"_28382":53658,"_3078":53750},[],"**Decommissioned**",{"_3626":897,"_31190":867,"_21615":53752,"_5":14871,"_28382":53658,"_3078":53753},[],"The record is retired and ordinary updates do not restore operation.",{"_3626":898,"_31190":867,"_21615":53755,"_5":14871,"_28382":53658,"_3078":53756},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3626":899,"_31190":867,"_21615":53758,"_5":14871,"_28382":53662,"_3078":53759},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3626":900,"_31190":867,"_21615":53761,"_5":14871,"_28382":53662,"_3078":53762},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3626":901,"_31190":867,"_21615":53764,"_5":14871,"_28382":53662,"_3078":53765},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3626":902,"_31190":867,"_21615":53767,"_5":14871,"_28382":53662,"_3078":53768},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3626":903,"_31190":867,"_21615":53770,"_5":14871,"_28382":53666,"_3078":53771},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3626":904,"_31190":867,"_21615":53773,"_5":14871,"_28382":53670,"_3078":53774},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3626":905,"_31190":867,"_21615":53776,"_5":14871,"_28382":53674,"_3078":53777},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3626":906,"_31190":867,"_21615":53779,"_5":14871,"_28382":53678,"_3078":53780},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3626":907,"_31190":867,"_21615":53782,"_5":14871,"_28382":53682,"_3078":53783},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3626":908,"_31190":867,"_21615":53785,"_5":14871,"_28382":53682,"_3078":53786},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3626":909,"_31190":867,"_21615":53788,"_5":14871,"_28382":53686,"_3078":53789},[],"From **No Identity**, use **Assign Identity**:",{"_3626":910,"_31190":867,"_21615":53791,"_5":14871,"_28382":53686,"_3078":53792},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3626":911,"_31190":867,"_21615":53794,"_5":14871,"_28382":53686,"_3078":53795},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3626":912,"_31190":867,"_21615":53797,"_5":14871,"_28382":53686,"_3078":53798},[],"Confirm and read the serial, active version and history again.",{"_3626":913,"_31190":867,"_21615":53800,"_5":14871,"_28382":53686,"_3078":53801},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3626":914,"_31190":867,"_21615":53803,"_5":14871,"_28382":53686,"_3078":53804},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3626":915,"_31190":867,"_21615":53806,"_5":14871,"_28382":53690,"_3078":53807},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3626":916,"_31190":867,"_21615":53809,"_5":14871,"_28382":53690,"_3078":53810},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3626":917,"_31190":867,"_21615":53812,"_5":14871,"_28382":53690,"_3078":53813},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3626":918,"_31190":867,"_21615":53815,"_5":14871,"_28382":53694,"_3078":53816},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3626":919,"_31190":867,"_21615":53818,"_5":14871,"_28382":53694,"_3078":53819},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3626":920,"_31190":867,"_21615":53821,"_5":14871,"_28382":53694,"_3078":53822},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3626":921,"_31190":867,"_21615":53824,"_5":14871,"_28382":53694,"_3078":53825},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3626":922,"_31190":867,"_21615":53827,"_5":14871,"_28382":53698,"_3078":53828},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3626":923,"_31190":867,"_21615":53830,"_5":14871,"_28382":53698,"_3078":53831},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3626":924,"_31190":924,"_5":15231,"_3078":53833,"_31548":53834,"_21615":53836,"_28382":924},"Bootstrap identity and authentication",[50967,52479,53651,53649,53835],"Enrollment with PKI",[],{"_3626":925,"_31190":924,"_21615":53838,"_5":14871,"_28382":924,"_3078":53839},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3626":926,"_31190":924,"_5":31545,"_21615":53841,"_28382":53842,"_3078":53843},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3626":927,"_31190":924,"_5":31545,"_21615":53845,"_28382":53846,"_3078":53847},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3626":928,"_31190":924,"_5":31545,"_21615":53849,"_28382":53850,"_3078":53851},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3626":929,"_31190":924,"_5":31545,"_21615":53853,"_28382":53854,"_3078":53855},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3626":930,"_31190":924,"_5":31545,"_21615":53857,"_28382":53858,"_3078":53859},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3626":931,"_31190":924,"_21615":53861,"_5":14871,"_28382":924,"_3078":53862},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3626":932,"_31190":924,"_21615":53864,"_5":14871,"_28382":53842,"_3078":53865},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3626":933,"_31190":924,"_21615":53867,"_5":14871,"_28382":53842,"_3078":53868},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3626":934,"_31190":924,"_21615":53870,"_5":14871,"_28382":53846,"_3078":53871},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3626":935,"_31190":924,"_21615":53873,"_5":14871,"_28382":53846,"_3078":53874},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3626":936,"_31190":924,"_21615":53876,"_5":14871,"_28382":53846,"_3078":53877},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3626":937,"_31190":924,"_21615":53879,"_5":14871,"_28382":53850,"_3078":53880},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3626":938,"_31190":924,"_21615":53882,"_5":14871,"_28382":53850,"_3078":53883},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3626":939,"_31190":924,"_21615":53885,"_5":14871,"_28382":53854,"_3078":53886},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3626":940,"_31190":924,"_21615":53888,"_5":14871,"_28382":53854,"_3078":53889},[],"Example body:",{"_3626":941,"_31190":924,"_21615":53891,"_5":14871,"_28382":53854,"_3078":53892},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3626":942,"_31190":924,"_21615":53894,"_5":14871,"_28382":53854,"_3078":53895},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3626":943,"_31190":924,"_21615":53897,"_5":14871,"_28382":53854,"_3078":53898},[],"Continuation requires a successful HTTP response and JSON:",{"_3626":944,"_31190":924,"_21615":53900,"_5":14871,"_28382":53854,"_3078":53901},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3626":945,"_31190":924,"_21615":53903,"_5":14871,"_28382":53858,"_3078":53904},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3626":946,"_31190":924,"_21615":53906,"_5":14871,"_28382":53858,"_3078":53907},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh — `thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old — and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3626":947,"_31190":924,"_21615":53909,"_5":14871,"_28382":53858,"_3078":53910},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3626":948,"_31190":924,"_21615":53912,"_5":14871,"_28382":53858,"_3078":53913},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3626":949,"_31190":949,"_5":15231,"_3078":53915,"_31548":53916,"_21615":53917,"_28382":949},"Configure and operate the DMS",[50967,52479,53651,53649,53835],[],{"_3626":950,"_31190":949,"_21615":53919,"_5":14871,"_28382":949,"_3078":53920},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3626":951,"_31190":949,"_5":31545,"_21615":53922,"_28382":53923,"_3078":50977},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3626":952,"_31190":949,"_5":31545,"_21615":53925,"_28382":53926,"_3078":53927},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3626":953,"_31190":949,"_5":31545,"_21615":53929,"_28382":53930,"_3078":53931},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3626":954,"_31190":949,"_5":31545,"_21615":53933,"_28382":53934,"_3078":53935},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3626":955,"_31190":949,"_5":31545,"_21615":53937,"_28382":53938,"_3078":53939},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3626":956,"_31190":949,"_5":31545,"_21615":53941,"_28382":53942,"_3078":53943},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3626":957,"_31190":949,"_5":31545,"_21615":53945,"_28382":53946,"_3078":53947},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3626":958,"_31190":949,"_5":31545,"_21615":53949,"_28382":53950,"_3078":53951},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3626":959,"_31190":949,"_5":31545,"_21615":53953,"_28382":53954,"_3078":53955},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3626":960,"_31190":949,"_5":31545,"_21615":53957,"_28382":53958,"_3078":53959},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3626":961,"_31190":949,"_5":31545,"_21615":53961,"_28382":53962,"_3078":53963},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3626":962,"_31190":949,"_5":31545,"_21615":53965,"_28382":53966,"_3078":53967},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3626":963,"_31190":949,"_5":31545,"_21615":53969,"_28382":53970,"_3078":53971},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3626":964,"_31190":949,"_5":31545,"_21615":53973,"_28382":53974,"_3078":53975},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3626":965,"_31190":949,"_5":31545,"_21615":53977,"_28382":53978,"_3078":53979},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3626":966,"_31190":949,"_5":31545,"_21615":53981,"_28382":53982,"_3078":53983},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3626":967,"_31190":949,"_5":31545,"_21615":53985,"_28382":53986,"_3078":53987},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3626":968,"_31190":949,"_5":31545,"_21615":53989,"_28382":53990,"_3078":53991},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3626":969,"_31190":949,"_21615":53993,"_5":14871,"_28382":949,"_3078":53994},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3626":970,"_31190":949,"_21615":53996,"_5":14871,"_28382":53923,"_3078":53997},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3626":971,"_31190":949,"_21615":53999,"_5":14871,"_28382":53923,"_3078":54000},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3626":972,"_31190":949,"_21615":54002,"_5":14871,"_28382":53930,"_3078":54003},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3626":973,"_31190":949,"_21615":54005,"_5":14871,"_28382":53934,"_3078":54006},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3626":974,"_31190":949,"_21615":54008,"_5":14871,"_28382":53938,"_3078":54009},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3626":975,"_31190":949,"_21615":54011,"_5":14871,"_28382":53942,"_3078":54012},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3626":976,"_31190":949,"_21615":54014,"_5":14871,"_28382":53946,"_3078":54015},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3626":977,"_31190":949,"_21615":54017,"_5":14871,"_28382":53954,"_3078":54018},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3626":978,"_31190":949,"_21615":54020,"_5":14871,"_28382":53954,"_3078":54021},[],"PRE\\_REGISTRATION requires an existing ID. An existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3626":979,"_31190":949,"_21615":54023,"_5":14871,"_28382":53958,"_3078":54024},[],"`settings.enrollment_settings` field",{"_3626":980,"_31190":949,"_21615":54026,"_5":14871,"_28382":53958,"_3078":54027},[],"Decision",{"_3626":981,"_31190":949,"_21615":54029,"_5":14871,"_28382":53958,"_3078":54030},[],"`protocol`",{"_3626":982,"_31190":949,"_21615":54032,"_5":14871,"_28382":53958,"_3078":54033},[],"`EST_RFC7030` for these operations.",{"_3626":983,"_31190":949,"_21615":54035,"_5":14871,"_28382":53958,"_3078":54036},[],"`enrollment_ca`",{"_3626":984,"_31190":949,"_21615":54038,"_5":14871,"_28382":53958,"_3078":54039},[],"ID of the signing CA.",{"_3626":985,"_31190":949,"_21615":54041,"_5":14871,"_28382":53958,"_3078":54042},[],"`verify_csr_signature`",{"_3626":986,"_31190":949,"_21615":54044,"_5":14871,"_28382":53958,"_3078":54045},[],"Keep `true` to verify CSR key possession.",{"_3626":987,"_31190":949,"_21615":54047,"_5":14871,"_28382":53958,"_3078":54048},[],"`enable_replaceable_enrollment`",{"_3626":988,"_31190":949,"_21615":54050,"_5":14871,"_28382":53958,"_3078":54051},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3626":989,"_31190":949,"_21615":54053,"_5":14871,"_28382":53958,"_3078":54054},[],"`est_rfc7030_settings.auth_mode`",{"_3626":990,"_31190":949,"_21615":54056,"_5":14871,"_28382":53958,"_3078":54057},[],"One of the four authentication modes.",{"_3626":991,"_31190":949,"_21615":54059,"_5":14871,"_28382":53958,"_3078":54060},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3626":992,"_31190":949,"_21615":54062,"_5":14871,"_28382":53962,"_3078":54063},[],"The blocks are independent:",{"_3626":993,"_31190":949,"_21615":54065,"_5":14871,"_28382":53962,"_3078":54066},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3626":994,"_31190":949,"_21615":54068,"_5":14871,"_28382":53962,"_3078":54069},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3626":995,"_31190":949,"_21615":54071,"_5":14871,"_28382":53962,"_3078":54072},[],"`auth_mode`",{"_3626":996,"_31190":949,"_21615":54074,"_5":14871,"_28382":53962,"_3078":54075},[],"Control applied in the configured operation",{"_3626":997,"_31190":949,"_21615":54077,"_5":14871,"_28382":53962,"_3078":54078},[],"`CLIENT_CERTIFICATE`",{"_3626":998,"_31190":949,"_21615":54080,"_5":14871,"_28382":53962,"_3078":54081},[],"Presented certificate validation.",{"_3626":999,"_31190":949,"_21615":54083,"_5":14871,"_28382":53962,"_3078":54084},[],"`EXTERNAL_WEBHOOK`",{"_3626":1000,"_31190":949,"_21615":54086,"_5":14871,"_28382":53962,"_3078":54087},[],"Configured webhook authorization.",{"_3626":1001,"_31190":949,"_21615":54089,"_5":14871,"_28382":53962,"_3078":54090},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3626":1002,"_31190":949,"_21615":54092,"_5":14871,"_28382":53962,"_3078":54093},[],"Certificate validation followed by webhook approval.",{"_3626":1003,"_31190":949,"_21615":54095,"_5":14871,"_28382":53962,"_3078":54096},[],"`NO_AUTH`",{"_3626":1004,"_31190":949,"_21615":54098,"_5":14871,"_28382":53962,"_3078":54099},[],"No DMS requester authentication.",{"_3626":1005,"_31190":949,"_21615":54101,"_5":14871,"_28382":53962,"_3078":54102},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3626":1006,"_31190":949,"_21615":54104,"_5":14871,"_28382":53962,"_3078":54105},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `chain_level_validation` and `allow_unverifiable_revocation`. The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3626":1007,"_31190":949,"_21615":54107,"_5":14871,"_28382":53962,"_3078":54108},[],"The authentication editor offers an **Allow certificates without revocation information** switch (`allow_unverifiable_revocation`, off by default). When it is on, certificates — and intermediate CAs of the chain — that Lamassu does not manage and that list no OCSP or CRL endpoint are accepted; unreachable, stale or inconclusive revocation answers are always rejected. While the switch is on, the console shows an amber warning: **Revocation will not be verified** — a revoked certificate with no OCSP or CRL endpoint, and not managed by Lamassu, will be accepted, and this also applies to the intermediate CAs of the chain.",{"_3626":1008,"_31190":949,"_21615":54110,"_5":14871,"_28382":53962,"_3078":54111},[],"The same switch is offered in both the enrollment and re-enrollment authentication editors and is stored per block inside `est_rfc7030_settings.client_certificate_settings`; a DMS stored before this field existed loads with the switch off. The console also shows an amber warning alert whenever an authentication option is in its insecure state — **Allow expired certificates** on, **Allow expired renewal** on or **Verify CSR signature** off — and the No authentication note is presented as a warning alert too.",{"_3626":1009,"_31190":949,"_21615":54113,"_5":14871,"_28382":53962,"_3078":54114},[],"Revocation is checked for every presented certificate. In initial enrollment the client certificate **and** every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. A validation CA that is revoked in Lamassu rejects the operation: the first validation CA that validates the certificate is used, and a revoked one is not replaced by the remaining validation CAs. Certificates issued and managed by Lamassu are checked against their stored status. External certificates are checked through their OCSP and CRL endpoints, and the operation fails closed when revocation cannot be verified: only `allow_unverifiable_revocation` — `false` by default in both blocks — relaxes the case of an external certificate that lists no endpoint at all. Endpoints that exist but are unreachable, return stale or invalid evidence, or report an inconclusive status are always rejected, whatever the option says. The details and the evidence the endpoints must present are in Revocation and checks.",{"_3626":1010,"_31190":949,"_21615":54116,"_5":14871,"_28382":53962,"_3078":54117},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`. Re-enrollment checks revocation of the client certificate only; that check is governed by the re-enrollment block's own `allow_unverifiable_revocation`.",{"_3626":1011,"_31190":949,"_21615":54119,"_5":14871,"_28382":53962,"_3078":54120},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3626":1012,"_31190":949,"_21615":54122,"_5":14871,"_28382":53966,"_3078":54123},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3626":1013,"_31190":949,"_21615":54125,"_5":14871,"_28382":53966,"_3078":54126},[],"`external_webhook_settings` field",{"_3626":1014,"_31190":949,"_21615":54128,"_5":14871,"_28382":53966,"_3078":54027},[],{"_3626":1015,"_31190":949,"_21615":54130,"_5":14871,"_28382":53966,"_3078":54131},[],"`url`",{"_3626":1016,"_31190":949,"_21615":54133,"_5":14871,"_28382":53966,"_3078":54134},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3626":1017,"_31190":949,"_21615":54136,"_5":14871,"_28382":53966,"_3078":54137},[],"`method`",{"_3626":1018,"_31190":949,"_21615":54139,"_5":14871,"_28382":53966,"_3078":54140},[],"`POST` or `PUT`; `POST` by default.",{"_3626":1019,"_31190":949,"_21615":54142,"_5":14871,"_28382":53966,"_3078":54143},[],"`name`",{"_3626":1020,"_31190":949,"_21615":54145,"_5":14871,"_28382":53966,"_3078":54146},[],"Label used in service logs.",{"_3626":1021,"_31190":949,"_21615":54148,"_5":14871,"_28382":53966,"_3078":54149},[],"`config.auth_mode`",{"_3626":1022,"_31190":949,"_21615":54151,"_5":14871,"_28382":53966,"_3078":54152},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3626":1023,"_31190":949,"_21615":54154,"_5":14871,"_28382":53966,"_3078":54155},[],"`config.log_level`",{"_3626":1024,"_31190":949,"_21615":54157,"_5":14871,"_28382":53966,"_3078":54158},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3626":1025,"_31190":949,"_21615":54160,"_5":14871,"_28382":53966,"_3078":54161},[],"`config.apikey_options`",{"_3626":1026,"_31190":949,"_21615":54163,"_5":14871,"_28382":53966,"_3078":54164},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3626":1027,"_31190":949,"_21615":54166,"_5":14871,"_28382":53966,"_3078":54167},[],"`config.jwt_options`",{"_3626":1028,"_31190":949,"_21615":54169,"_5":14871,"_28382":53966,"_3078":54170},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3626":1029,"_31190":949,"_21615":54172,"_5":14871,"_28382":53966,"_3078":54173},[],"`config.mtls_options`",{"_3626":1030,"_31190":949,"_21615":54175,"_5":14871,"_28382":53966,"_3078":54176},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3626":1031,"_31190":949,"_21615":54178,"_5":14871,"_28382":53966,"_3078":54179},[],"`config.insecure_skip_verify`",{"_3626":1032,"_31190":949,"_21615":54181,"_5":14871,"_28382":53966,"_3078":54182},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3626":1033,"_31190":949,"_21615":54184,"_5":14871,"_28382":53966,"_3078":54185},[],"`config.call_timeout`",{"_3626":1034,"_31190":949,"_21615":54187,"_5":14871,"_28382":53966,"_3078":54188},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3626":1035,"_31190":949,"_21615":54190,"_5":14871,"_28382":53966,"_3078":54191},[],"Rules for that configuration:",{"_3626":1036,"_31190":949,"_21615":54193,"_5":14871,"_28382":53966,"_3078":54194},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3626":1037,"_31190":949,"_21615":54196,"_5":14871,"_28382":53966,"_3078":54197},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3626":1038,"_31190":949,"_21615":54199,"_5":14871,"_28382":53966,"_3078":54200},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3626":1039,"_31190":949,"_21615":54202,"_5":14871,"_28382":53966,"_3078":54203},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3626":1040,"_31190":949,"_21615":54205,"_5":14871,"_28382":53966,"_3078":54206},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3626":1041,"_31190":949,"_21615":54208,"_5":14871,"_28382":53966,"_3078":54209},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3626":1042,"_31190":949,"_21615":54211,"_5":14871,"_28382":53966,"_3078":54212},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3626":1043,"_31190":949,"_21615":54214,"_5":14871,"_28382":53966,"_3078":54215},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3626":1044,"_31190":949,"_21615":54217,"_5":14871,"_28382":53966,"_3078":54218},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3626":1045,"_31190":949,"_21615":54220,"_5":14871,"_28382":53970,"_3078":54221},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3626":1046,"_31190":949,"_21615":54223,"_5":14871,"_28382":53974,"_3078":54224},[],"`settings.reenrollment_settings` field",{"_3626":1047,"_31190":949,"_21615":54226,"_5":14871,"_28382":53974,"_3078":51357},[],{"_3626":1048,"_31190":949,"_21615":54228,"_5":14871,"_28382":53974,"_3078":54229},[],"`reenrollment_delta`",{"_3626":1049,"_31190":949,"_21615":54231,"_5":14871,"_28382":53974,"_3078":54232},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3626":1050,"_31190":949,"_21615":54234,"_5":14871,"_28382":53974,"_3078":54235},[],"`preventive_delta`",{"_3626":1051,"_31190":949,"_21615":54237,"_5":14871,"_28382":53974,"_3078":54238},[],"Preventive operational monitoring threshold.",{"_3626":1052,"_31190":949,"_21615":54240,"_5":14871,"_28382":53974,"_3078":54241},[],"`critical_delta`",{"_3626":1053,"_31190":949,"_21615":54243,"_5":14871,"_28382":53974,"_3078":54244},[],"Critical operational monitoring threshold.",{"_3626":1054,"_31190":949,"_21615":54246,"_5":14871,"_28382":53974,"_3078":54247},[],"`enable_expired_renewal`",{"_3626":1055,"_31190":949,"_21615":54249,"_5":14871,"_28382":53974,"_3078":54250},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3626":1056,"_31190":949,"_21615":54252,"_5":14871,"_28382":53974,"_3078":54253},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3626":1057,"_31190":949,"_21615":54255,"_5":14871,"_28382":53974,"_3078":54256},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3626":1058,"_31190":949,"_21615":54258,"_5":14871,"_28382":53974,"_3078":54259},[],"`revoke_on_reenrollment`",{"_3626":1059,"_31190":949,"_21615":54261,"_5":14871,"_28382":53974,"_3078":54262},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3626":1060,"_31190":949,"_21615":54264,"_5":14871,"_28382":53974,"_3078":54265},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3626":1061,"_31190":949,"_21615":54267,"_5":14871,"_28382":53978,"_3078":54268},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3626":1062,"_31190":949,"_21615":54270,"_5":14871,"_28382":53982,"_3078":51351},[],{"_3626":1063,"_31190":949,"_21615":54272,"_5":14871,"_28382":53982,"_3078":54273},[],"Published material",{"_3626":1064,"_31190":949,"_21615":54275,"_5":14871,"_28382":53982,"_3078":54276},[],"**Include Lamassu System CA**",{"_3626":1065,"_31190":949,"_21615":54278,"_5":14871,"_28382":53982,"_3078":54279},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3626":1066,"_31190":949,"_21615":54281,"_5":14871,"_28382":53982,"_3078":54282},[],"**Include Enrollment CA**",{"_3626":1067,"_31190":949,"_21615":54284,"_5":14871,"_28382":53982,"_3078":54285},[],"Selected issuing CA certificate.",{"_3626":1068,"_31190":949,"_21615":54287,"_5":14871,"_28382":53982,"_3078":54288},[],"**Managed CAs**",{"_3626":1069,"_31190":949,"_21615":54290,"_5":14871,"_28382":53982,"_3078":54291},[],"Explicitly selected CA certificates.",{"_3626":1070,"_31190":949,"_21615":54293,"_5":14871,"_28382":53982,"_3078":54294},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3626":1071,"_31190":949,"_21615":54296,"_5":14871,"_28382":53986,"_3078":54297},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3626":1072,"_31190":949,"_21615":54299,"_5":14871,"_28382":53986,"_3078":54300},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3626":1073,"_31190":949,"_21615":54302,"_5":14871,"_28382":53986,"_3078":54303},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3626":1074,"_31190":949,"_21615":54305,"_5":14871,"_28382":53990,"_3078":54306},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3626":1075,"_31190":1075,"_5":15231,"_3078":54308,"_31548":54309,"_21615":54310,"_28382":1075},"Integrate the EST client",[50967,52479,53651,53649,53835],[],{"_3626":1076,"_31190":1075,"_21615":54312,"_5":14871,"_28382":1075,"_3078":54313},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3626":1077,"_31190":1075,"_5":31545,"_21615":54315,"_28382":54316,"_3078":50977},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3626":1078,"_31190":1075,"_5":31545,"_21615":54318,"_28382":54319,"_3078":54320},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3626":1079,"_31190":1075,"_5":31545,"_21615":54322,"_28382":54323,"_3078":54324},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3626":1080,"_31190":1075,"_5":31545,"_21615":54326,"_28382":54327,"_3078":54328},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3626":1081,"_31190":1075,"_5":31545,"_21615":54330,"_28382":54331,"_3078":54332},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3626":1082,"_31190":1075,"_5":31545,"_21615":54334,"_28382":54335,"_3078":54336},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3626":1083,"_31190":1075,"_21615":54338,"_5":14871,"_28382":1075,"_3078":54339},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3626":1084,"_31190":1075,"_21615":54341,"_5":14871,"_28382":54316,"_3078":54342},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3626":1085,"_31190":1075,"_21615":54344,"_5":14871,"_28382":54316,"_3078":54345},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3626":1086,"_31190":1075,"_21615":54347,"_5":14871,"_28382":54316,"_3078":54348},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3626":1087,"_31190":1075,"_21615":54350,"_5":14871,"_28382":54319,"_3078":54351},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3626":1088,"_31190":1075,"_21615":54353,"_5":14871,"_28382":54319,"_3078":54354},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3626":1089,"_31190":1075,"_21615":54356,"_5":14871,"_28382":54323,"_3078":54357},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3626":1090,"_31190":1075,"_21615":54359,"_5":14871,"_28382":54323,"_3078":54360},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3626":1091,"_31190":1075,"_21615":54362,"_5":14871,"_28382":54327,"_3078":54363},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3626":1092,"_31190":1075,"_21615":54365,"_5":14871,"_28382":54327,"_3078":54366},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3626":1093,"_31190":1075,"_21615":54368,"_5":14871,"_28382":54331,"_3078":54369},[],"For a root that issues directly:",{"_3626":1094,"_31190":1075,"_21615":54371,"_5":14871,"_28382":54331,"_3078":54372},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3626":1095,"_31190":1075,"_21615":54374,"_5":14871,"_28382":54331,"_3078":54375},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3626":1096,"_31190":1075,"_21615":54377,"_5":14871,"_28382":54335,"_3078":54378},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3626":1097,"_31190":1097,"_5":15231,"_3078":54380,"_31548":54381,"_21615":54382,"_28382":1097},"EST reference",[50967,52479,53651,53649,53835],[],{"_3626":1098,"_31190":1097,"_21615":54384,"_5":14871,"_28382":1097,"_3078":54385},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3626":1099,"_31190":1097,"_5":31545,"_21615":54387,"_28382":54388,"_3078":54389},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3626":1100,"_31190":1097,"_5":31545,"_21615":54391,"_28382":54392,"_3078":23417},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3626":1101,"_31190":1097,"_5":31545,"_21615":54394,"_28382":54395,"_3078":26932},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3626":1102,"_31190":1097,"_5":31545,"_21615":54397,"_28382":54398,"_3078":26939},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3626":1103,"_31190":1097,"_5":31545,"_21615":54400,"_28382":54401,"_3078":26201},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3626":1104,"_31190":1097,"_5":31545,"_21615":54403,"_28382":54404,"_3078":54405},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3626":1105,"_31190":1097,"_5":31545,"_21615":54407,"_28382":54408,"_3078":54409},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3626":1106,"_31190":1097,"_5":31545,"_21615":54411,"_28382":54412,"_3078":54413},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3626":1107,"_31190":1097,"_21615":54415,"_5":14871,"_28382":1097,"_3078":54416},[],"Reference for the Lamassu EST service, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3626":1108,"_31190":1097,"_21615":54418,"_5":14871,"_28382":54388,"_3078":54419},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3626":1109,"_31190":1097,"_21615":54421,"_5":14871,"_28382":54388,"_3078":54422},[],"Operation",{"_3626":1110,"_31190":1097,"_21615":54424,"_5":14871,"_28382":54388,"_3078":54425},[],"Method",{"_3626":1111,"_31190":1097,"_21615":54427,"_5":14871,"_28382":54388,"_3078":54428},[],"Authentication and condition",{"_3626":1112,"_31190":1097,"_21615":54430,"_5":14871,"_28382":54388,"_3078":54431},[],"`/cacerts`",{"_3626":1113,"_31190":1097,"_21615":54433,"_5":14871,"_28382":54388,"_3078":54434},[],"GET",{"_3626":1114,"_31190":1097,"_21615":54436,"_5":14871,"_28382":54388,"_3078":54437},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3626":1115,"_31190":1097,"_21615":54439,"_5":14871,"_28382":54388,"_3078":54440},[],"`/simpleenroll`",{"_3626":1116,"_31190":1097,"_21615":54442,"_5":14871,"_28382":54388,"_3078":54443},[],"POST",{"_3626":1117,"_31190":1097,"_21615":54445,"_5":14871,"_28382":54388,"_3078":54446},[],"Initial authentication and DMS registration/replacement policy.",{"_3626":1118,"_31190":1097,"_21615":54448,"_5":14871,"_28382":54388,"_3078":54449},[],"`/simplereenroll`",{"_3626":1119,"_31190":1097,"_21615":54451,"_5":14871,"_28382":54388,"_3078":54443},[],{"_3626":1120,"_31190":1097,"_21615":54453,"_5":14871,"_28382":54388,"_3078":54454},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3626":1121,"_31190":1097,"_21615":54456,"_5":14871,"_28382":54388,"_3078":54457},[],"`/serverkeygen`",{"_3626":1122,"_31190":1097,"_21615":54459,"_5":14871,"_28382":54388,"_3078":54443},[],{"_3626":1123,"_31190":1097,"_21615":54461,"_5":14871,"_28382":54388,"_3078":54462},[],"Initial authentication and admission; server generation enabled.",{"_3626":1124,"_31190":1097,"_21615":54464,"_5":14871,"_28382":54388,"_3078":54465},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3626":1125,"_31190":1097,"_21615":54467,"_5":14871,"_28382":54392,"_3078":54468},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3626":1126,"_31190":1097,"_21615":54470,"_5":14871,"_28382":54392,"_3078":54471},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3626":1127,"_31190":1097,"_21615":54473,"_5":14871,"_28382":54395,"_3078":54474},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3626":1128,"_31190":1097,"_21615":54476,"_5":14871,"_28382":54395,"_3078":54477},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3626":1129,"_31190":1097,"_21615":54479,"_5":14871,"_28382":54398,"_3078":54480},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3626":1130,"_31190":1097,"_21615":54482,"_5":14871,"_28382":54398,"_3078":54483},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. With default settings, a client certificate whose revocation cannot be verified is also rejected; the DMS guide describes `allow_unverifiable_revocation`. See Renewal for installation and recovery.",{"_3626":1131,"_31190":1097,"_21615":54485,"_5":14871,"_28382":54401,"_3078":54486},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3626":1132,"_31190":1097,"_21615":54488,"_5":14871,"_28382":54401,"_3078":54489},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3626":1133,"_31190":1097,"_21615":54491,"_5":14871,"_28382":54404,"_3078":54492},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3626":1134,"_31190":1097,"_21615":54494,"_5":14871,"_28382":54404,"_3078":54495},[],"Part",{"_3626":1135,"_31190":1097,"_21615":54497,"_5":14871,"_28382":54404,"_3078":54498},[],"Content after decoding its Base64",{"_3626":1136,"_31190":1097,"_21615":54500,"_5":14871,"_28382":54404,"_3078":54501},[],"`application/pkcs8`",{"_3626":1137,"_31190":1097,"_21615":54503,"_5":14871,"_28382":54404,"_3078":54504},[],"Unencrypted DER PKCS#8 private key.",{"_3626":1138,"_31190":1097,"_21615":54506,"_5":14871,"_28382":54404,"_3078":54507},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3626":1139,"_31190":1097,"_21615":54509,"_5":14871,"_28382":54404,"_3078":54510},[],"DER PKCS#7 containing the issued certificate.",{"_3626":1140,"_31190":1097,"_21615":54512,"_5":14871,"_28382":54404,"_3078":54513},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3626":1141,"_31190":1097,"_21615":54515,"_5":14871,"_28382":54408,"_3078":54516},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3626":1142,"_31190":1097,"_21615":54518,"_5":14871,"_28382":54408,"_3078":54519},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3626":1143,"_31190":1097,"_21615":54521,"_5":14871,"_28382":54408,"_3078":54522},[],"Convert and check the result:",{"_3626":1144,"_31190":1097,"_21615":54524,"_5":14871,"_28382":54408,"_3078":54525},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3626":1145,"_31190":1097,"_21615":54527,"_5":14871,"_28382":54412,"_3078":54528},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3626":1146,"_31190":1097,"_21615":54530,"_5":14871,"_28382":54412,"_3078":54531},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3626":1147,"_31190":1147,"_5":15231,"_3078":53835,"_31548":54533,"_21615":54534,"_28382":1147},[50967,52479,53651,53649,53835],[],{"_3626":1148,"_31190":1147,"_21615":54536,"_5":14871,"_28382":1147,"_3078":54537},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3626":1149,"_31190":1147,"_5":31545,"_21615":54539,"_28382":54540,"_3078":54541},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3626":1150,"_31190":1147,"_5":31545,"_21615":54543,"_28382":54544,"_3078":54545},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3626":1151,"_31190":1147,"_5":31545,"_21615":54547,"_28382":54548,"_3078":54549},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3626":1152,"_31190":1147,"_21615":54551,"_5":14871,"_28382":1147,"_3078":54552},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3626":1153,"_31190":1147,"_21615":54554,"_5":14871,"_28382":54540,"_3078":54555},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3626":1154,"_31190":1147,"_21615":54557,"_5":14871,"_28382":54540,"_3078":54558},[],"The integrator installs initial EST server trust and an admission credential.",{"_3626":1155,"_31190":1147,"_21615":54560,"_5":14871,"_28382":54540,"_3078":54561},[],"The client requests an identity for its `Device ID` through EST.",{"_3626":1156,"_31190":1147,"_21615":54563,"_5":14871,"_28382":54540,"_3078":54564},[],"Certificate, device binding and key/certificate installation are checked.",{"_3626":1157,"_31190":1147,"_21615":54566,"_5":14871,"_28382":54540,"_3078":54567},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3626":1158,"_31190":1147,"_21615":54569,"_5":14871,"_28382":54540,"_3078":54570},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3626":1159,"_31190":1147,"_21615":54572,"_5":14871,"_28382":54544,"_3078":54573},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3626":1160,"_31190":1147,"_21615":54575,"_5":14871,"_28382":54544,"_3078":54576},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3626":1161,"_31190":1147,"_21615":54578,"_5":14871,"_28382":54544,"_3078":54579},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3626":1162,"_31190":1147,"_21615":54581,"_5":14871,"_28382":54544,"_3078":54582},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3626":1163,"_31190":1147,"_21615":54584,"_5":14871,"_28382":54548,"_3078":54585},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3626":1164,"_31190":1147,"_21615":54587,"_5":14871,"_28382":54548,"_3078":54588},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3626":1165,"_31190":1147,"_21615":54590,"_5":14871,"_28382":54548,"_3078":54591},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3626":1166,"_31190":1147,"_21615":54593,"_5":14871,"_28382":54548,"_3078":54594},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3626":1167,"_31190":1147,"_21615":54596,"_5":14871,"_28382":54548,"_3078":54597},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3626":1168,"_31190":1168,"_5":15231,"_3078":54599,"_31548":54600,"_21615":54601,"_28382":1168},"Provisioning strategies",[50967,52479,53651,53649,53835],[],{"_3626":1169,"_31190":1168,"_21615":54603,"_5":14871,"_28382":1168,"_3078":54604},[],"Choose device registration, identity authorization and key generation.",{"_3626":1170,"_31190":1168,"_5":31545,"_21615":54606,"_28382":54607,"_3078":54608},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3626":1171,"_31190":1168,"_5":31545,"_21615":54610,"_28382":54611,"_3078":54612},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3626":1172,"_31190":1168,"_5":31545,"_21615":54614,"_28382":54615,"_3078":54616},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3626":1173,"_31190":1168,"_5":31545,"_21615":54618,"_28382":54619,"_3078":54620},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3626":1174,"_31190":1168,"_5":31545,"_21615":54622,"_28382":54623,"_3078":54624},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3626":1175,"_31190":1168,"_21615":54626,"_5":14871,"_28382":1168,"_3078":54627},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3626":1176,"_31190":1168,"_21615":54629,"_5":14871,"_28382":54607,"_3078":54630},[],"Path",{"_3626":1177,"_31190":1168,"_21615":54632,"_5":14871,"_28382":54607,"_3078":54633},[],"When the device exists",{"_3626":1178,"_31190":1168,"_21615":54635,"_5":14871,"_28382":54607,"_3078":54636},[],"What to check",{"_3626":1179,"_31190":1168,"_21615":54638,"_5":14871,"_28382":54607,"_3078":54639},[],"Manual assignment",{"_3626":1180,"_31190":1168,"_21615":54641,"_5":14871,"_28382":54607,"_3078":54642},[],"An operator creates it before associating a certificate.",{"_3626":1181,"_31190":1168,"_21615":54644,"_5":14871,"_28382":54607,"_3078":54645},[],"ID, owning DMS, certificate CN and bound serial.",{"_3626":1182,"_31190":1168,"_21615":54647,"_5":14871,"_28382":54607,"_3078":54648},[],"EST with `JITP`",{"_3626":1183,"_31190":1168,"_21615":54650,"_5":14871,"_28382":54607,"_3078":54651},[],"Created for an unknown CN during `/simpleenroll`.",{"_3626":1184,"_31190":1168,"_21615":54653,"_5":14871,"_28382":54607,"_3078":54654},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3626":1185,"_31190":1168,"_21615":54656,"_5":14871,"_28382":54607,"_3078":54657},[],"EST with `PRE_REGISTRATION`",{"_3626":1186,"_31190":1168,"_21615":54659,"_5":14871,"_28382":54607,"_3078":54660},[],"Must exist before `/simpleenroll`.",{"_3626":1187,"_31190":1168,"_21615":54662,"_5":14871,"_28382":54607,"_3078":54663},[],"Approved record, same DMS and replacement conditions for your version.",{"_3626":1188,"_31190":1168,"_21615":54665,"_5":14871,"_28382":54607,"_3078":54666},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3626":1189,"_31190":1168,"_21615":54668,"_5":14871,"_28382":54607,"_3078":54669},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3626":1190,"_31190":1168,"_21615":54671,"_5":14871,"_28382":54611,"_3078":54672},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3626":1191,"_31190":1168,"_21615":54674,"_5":14871,"_28382":54611,"_3078":54675},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3626":1192,"_31190":1168,"_21615":54677,"_5":14871,"_28382":54611,"_3078":54678},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3626":1193,"_31190":1168,"_21615":54680,"_5":14871,"_28382":54615,"_3078":54681},[],"Decide initial enrollment and re-enrollment separately:",{"_3626":1194,"_31190":1168,"_21615":54683,"_5":14871,"_28382":54615,"_3078":54684},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3626":1195,"_31190":1168,"_21615":54686,"_5":14871,"_28382":54615,"_3078":54687},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3626":1196,"_31190":1168,"_21615":54689,"_5":14871,"_28382":54615,"_3078":54690},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3626":1197,"_31190":1168,"_21615":54692,"_5":14871,"_28382":54615,"_3078":54693},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3626":1198,"_31190":1168,"_21615":54695,"_5":14871,"_28382":54615,"_3078":54696},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3626":1199,"_31190":1168,"_21615":54698,"_5":14871,"_28382":54619,"_3078":51351},[],{"_3626":1200,"_31190":1168,"_21615":54700,"_5":14871,"_28382":54619,"_3078":54701},[],"Material crossing EST",{"_3626":1201,"_31190":1168,"_21615":54703,"_5":14871,"_28382":54619,"_3078":54704},[],"Device-generated key",{"_3626":1202,"_31190":1168,"_21615":54706,"_5":14871,"_28382":54619,"_3078":54707},[],"Public CSR and certificate; the key stays on the client.",{"_3626":1203,"_31190":1168,"_21615":54709,"_5":14871,"_28382":54619,"_3078":54710},[],"Existing device key",{"_3626":1204,"_31190":1168,"_21615":54712,"_5":14871,"_28382":54619,"_3078":54713},[],"CSR signed with that key and a new certificate.",{"_3626":1205,"_31190":1168,"_21615":54715,"_5":14871,"_28382":54619,"_3078":53979},[],{"_3626":1206,"_31190":1168,"_21615":54717,"_5":14871,"_28382":54619,"_3078":54718},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3626":1207,"_31190":1168,"_21615":54720,"_5":14871,"_28382":54619,"_3078":54721},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3626":1208,"_31190":1168,"_21615":54723,"_5":14871,"_28382":54623,"_3078":54724},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3626":1209,"_31190":1209,"_5":15231,"_3078":54726,"_31548":54727,"_21615":54728,"_28382":1209},"Renewal and recovery",[50967,52479,53651,53649,53835],[],{"_3626":1210,"_31190":1209,"_21615":54730,"_5":14871,"_28382":1209,"_3078":54731},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3626":1211,"_31190":1209,"_5":31545,"_21615":54733,"_28382":54734,"_3078":54735},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3626":1212,"_31190":1209,"_5":31545,"_21615":54737,"_28382":54738,"_3078":54739},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3626":1213,"_31190":1209,"_5":31545,"_21615":54741,"_28382":54742,"_3078":54743},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3626":1214,"_31190":1209,"_5":31545,"_21615":54745,"_28382":54746,"_3078":54747},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3626":1215,"_31190":1209,"_5":31545,"_21615":54749,"_28382":54750,"_3078":54751},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3626":1216,"_31190":1209,"_21615":54753,"_5":14871,"_28382":1209,"_3078":54754},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3626":1217,"_31190":1209,"_21615":54756,"_5":14871,"_28382":54734,"_3078":54757},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3626":1218,"_31190":1209,"_21615":54759,"_5":14871,"_28382":54734,"_3078":54760},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3626":1219,"_31190":1209,"_21615":54762,"_5":14871,"_28382":54734,"_3078":54763},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3626":1220,"_31190":1209,"_21615":54765,"_5":14871,"_28382":54734,"_3078":54766},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3626":1221,"_31190":1209,"_21615":54768,"_5":14871,"_28382":54738,"_3078":54769},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3626":1222,"_31190":1209,"_21615":54771,"_5":14871,"_28382":54738,"_3078":54772},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3626":1223,"_31190":1209,"_21615":54774,"_5":14871,"_28382":54742,"_3078":54775},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3626":1224,"_31190":1209,"_21615":54777,"_5":14871,"_28382":54742,"_3078":54778},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3626":1225,"_31190":1209,"_21615":54780,"_5":14871,"_28382":54742,"_3078":54781},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3626":1226,"_31190":1209,"_21615":54783,"_5":14871,"_28382":54746,"_3078":54784},[],"Situation",{"_3626":1227,"_31190":1209,"_21615":54786,"_5":14871,"_28382":54746,"_3078":54787},[],"Procedure",{"_3626":1228,"_31190":1209,"_21615":54789,"_5":14871,"_28382":54746,"_3078":54790},[],"Valid certificate, outside the window",{"_3626":1229,"_31190":1209,"_21615":54792,"_5":14871,"_28382":54746,"_3078":54793},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3626":1230,"_31190":1209,"_21615":54795,"_5":14871,"_28382":54746,"_3078":54796},[],"Expired certificate, key available",{"_3626":1231,"_31190":1209,"_21615":54798,"_5":14871,"_28382":54746,"_3078":54799},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3626":1232,"_31190":1209,"_21615":54801,"_5":14871,"_28382":54746,"_3078":54802},[],"Renewal through webhook or `NO_AUTH`",{"_3626":1233,"_31190":1209,"_21615":54804,"_5":14871,"_28382":54746,"_3078":54805},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3626":1234,"_31190":1209,"_21615":54807,"_5":14871,"_28382":54746,"_3078":54808},[],"Lost or inaccessible key",{"_3626":1235,"_31190":1209,"_21615":54810,"_5":14871,"_28382":54746,"_3078":54811},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3626":1236,"_31190":1209,"_21615":54813,"_5":14871,"_28382":54746,"_3078":54814},[],"Current identity revoked",{"_3626":1237,"_31190":1209,"_21615":54816,"_5":14871,"_28382":54746,"_3078":54817},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3626":1238,"_31190":1209,"_21615":54819,"_5":14871,"_28382":54746,"_3078":54820},[],"Device without an identity",{"_3626":1239,"_31190":1209,"_21615":54822,"_5":14871,"_28382":54746,"_3078":54823},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3626":1240,"_31190":1209,"_21615":54825,"_5":14871,"_28382":54746,"_3078":54826},[],"Retired device",{"_3626":1241,"_31190":1209,"_21615":54828,"_5":14871,"_28382":54746,"_3078":54829},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3626":1242,"_31190":1209,"_21615":54831,"_5":14871,"_28382":54746,"_3078":54832},[],"Timeout, HTTP 500 or installation failure",{"_3626":1243,"_31190":1209,"_21615":54834,"_5":14871,"_28382":54746,"_3078":54835},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3626":1244,"_31190":1209,"_21615":54837,"_5":14871,"_28382":54750,"_3078":54838},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3626":1245,"_31190":1209,"_21615":54840,"_5":14871,"_28382":54750,"_3078":54841},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3626":1246,"_31190":1246,"_5":15231,"_3078":54843,"_31548":54844,"_21615":54845,"_28382":1246},"Enrollment troubleshooting",[50967,52479,53651,53649,53835],[],{"_3626":1247,"_31190":1246,"_21615":54847,"_5":14871,"_28382":1246,"_3078":54848},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3626":1248,"_31190":1246,"_5":31545,"_21615":54850,"_28382":54851,"_3078":54852},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3626":1249,"_31190":1246,"_5":31545,"_21615":54854,"_28382":54855,"_3078":54856},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3626":1250,"_31190":1246,"_5":31545,"_21615":54858,"_28382":54859,"_3078":54413},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3626":1251,"_31190":1246,"_5":31545,"_21615":54861,"_28382":54862,"_3078":54863},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3626":1252,"_31190":1246,"_21615":54865,"_5":14871,"_28382":1246,"_3078":54866},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3626":1253,"_31190":1246,"_21615":54868,"_5":14871,"_28382":54855,"_3078":54869},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3626":1254,"_31190":1246,"_21615":54871,"_5":14871,"_28382":54855,"_3078":54872},[],"Symptom or message",{"_3626":1255,"_31190":1246,"_21615":54874,"_5":14871,"_28382":54855,"_3078":54636},[],{"_3626":1256,"_31190":1246,"_21615":54876,"_5":14871,"_28382":54855,"_3078":54877},[],"curl rejects TLS, name or issuer",{"_3626":1257,"_31190":1246,"_21615":54879,"_5":14871,"_28382":54855,"_3078":54880},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3626":1258,"_31190":1246,"_21615":54882,"_5":14871,"_28382":54855,"_3078":54883},[],"404 or missing APS",{"_3626":1259,"_31190":1246,"_21615":54885,"_5":14871,"_28382":54855,"_3078":54886},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3626":1260,"_31190":1246,"_21615":54888,"_5":14871,"_28382":54855,"_3078":54889},[],"400, CSR or format error",{"_3626":1261,"_31190":1246,"_21615":54891,"_5":14871,"_28382":54855,"_3078":54892},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3626":1262,"_31190":1246,"_21615":54894,"_5":14871,"_28382":54855,"_3078":54895},[],"Missing credential or invalid certificate",{"_3626":1263,"_31190":1246,"_21615":54897,"_5":14871,"_28382":54855,"_3078":54898},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3626":1264,"_31190":1246,"_21615":54900,"_5":14871,"_28382":54855,"_3078":54901},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3626":1265,"_31190":1246,"_21615":54903,"_5":14871,"_28382":54855,"_3078":54904},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3626":1266,"_31190":1246,"_21615":54906,"_5":14871,"_28382":54855,"_3078":54907},[],"Webhook denies, times out or responds without authorization",{"_3626":1267,"_31190":1246,"_21615":54909,"_5":14871,"_28382":54855,"_3078":54910},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3626":1268,"_31190":1246,"_21615":54912,"_5":14871,"_28382":54855,"_3078":54913},[],"`unexpected status code: <n>: redirects are not followed`",{"_3626":1269,"_31190":1246,"_21615":54915,"_5":14871,"_28382":54855,"_3078":54916},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3626":1270,"_31190":1246,"_21615":54918,"_5":14871,"_28382":54855,"_3078":54919},[],"`webhook response exceeds 1048576 bytes`",{"_3626":1271,"_31190":1246,"_21615":54921,"_5":14871,"_28382":54855,"_3078":54922},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3626":1272,"_31190":1246,"_21615":54924,"_5":14871,"_28382":54855,"_3078":54925},[],"`webhook config must not reference files`",{"_3626":1273,"_31190":1246,"_21615":54927,"_5":14871,"_28382":54855,"_3078":54928},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3626":1274,"_31190":1246,"_21615":54930,"_5":14871,"_28382":54855,"_3078":54931},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3626":1275,"_31190":1246,"_21615":54933,"_5":14871,"_28382":54855,"_3078":54934},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3626":1276,"_31190":1246,"_21615":54936,"_5":14871,"_28382":54855,"_3078":54937},[],"`webhook mTLS certificate and key are invalid: …`",{"_3626":1277,"_31190":1246,"_21615":54939,"_5":14871,"_28382":54855,"_3078":54940},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3626":1278,"_31190":1246,"_21615":54942,"_5":14871,"_28382":54855,"_3078":54943},[],"400 `struct validation error` creating or updating a DMS",{"_3626":1279,"_31190":1246,"_21615":54945,"_5":14871,"_28382":54855,"_3078":54946},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3626":1280,"_31190":1246,"_21615":54948,"_5":14871,"_28382":54855,"_3078":54949},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3626":1281,"_31190":1246,"_21615":54951,"_5":14871,"_28382":54855,"_3078":54952},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3626":1282,"_31190":1246,"_21615":54954,"_5":14871,"_28382":54855,"_3078":54955},[],"`device not preregistered`",{"_3626":1283,"_31190":1246,"_21615":54957,"_5":14871,"_28382":54855,"_3078":54958},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3626":1284,"_31190":1246,"_21615":54960,"_5":14871,"_28382":54855,"_3078":54961},[],"`forbiddenNewEnrollment`",{"_3626":1285,"_31190":1246,"_21615":54963,"_5":14871,"_28382":54855,"_3078":54964},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3626":1286,"_31190":1246,"_21615":54966,"_5":14871,"_28382":54855,"_3078":54967},[],"Different owning DMS",{"_3626":1287,"_31190":1246,"_21615":54969,"_5":14871,"_28382":54855,"_3078":54970},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3626":1288,"_31190":1246,"_21615":54972,"_5":14871,"_28382":54855,"_3078":54973},[],"`invalid RawSubject bytes`",{"_3626":1289,"_31190":1246,"_21615":54975,"_5":14871,"_28382":54855,"_3078":54976},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3626":1290,"_31190":1246,"_21615":54978,"_5":14871,"_28382":54855,"_3078":54979},[],"`invalid reenroll window`",{"_3626":1291,"_31190":1246,"_21615":54981,"_5":14871,"_28382":54855,"_3078":54982},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3626":1292,"_31190":1246,"_21615":54984,"_5":14871,"_28382":54855,"_3078":54985},[],"Current certificate revoked",{"_3626":1293,"_31190":1246,"_21615":54987,"_5":14871,"_28382":54855,"_3078":54988},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3626":1294,"_31190":1246,"_21615":54990,"_5":14871,"_28382":54855,"_3078":54991},[],"CA, profile or signing error",{"_3626":1295,"_31190":1246,"_21615":54993,"_5":14871,"_28382":54855,"_3078":54994},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3626":1296,"_31190":1246,"_21615":54996,"_5":14871,"_28382":54855,"_3078":54997},[],"HTTP 200 without a device connection",{"_3626":1297,"_31190":1246,"_21615":54999,"_5":14871,"_28382":54855,"_3078":55000},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3626":1298,"_31190":1246,"_21615":55002,"_5":14871,"_28382":54855,"_3078":55003},[],"Timeout or error after issuance",{"_3626":1299,"_31190":1246,"_21615":55005,"_5":14871,"_28382":54855,"_3078":55006},[],"New certificates, current slot and previous identity's state before retrying.",{"_3626":1300,"_31190":1246,"_21615":55008,"_5":14871,"_28382":54859,"_3078":55009},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3626":1301,"_31190":1246,"_21615":55011,"_5":14871,"_28382":54859,"_3078":55012},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3626":1302,"_31190":1246,"_21615":55014,"_5":14871,"_28382":54862,"_3078":55015},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3626":1303,"_31190":1246,"_21615":55017,"_5":14871,"_28382":54862,"_3078":55018},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3626":1304,"_31190":1246,"_21615":55020,"_5":14871,"_28382":54862,"_3078":55021},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3626":1305,"_31190":1246,"_21615":55023,"_5":14871,"_28382":54862,"_3078":55024},[],"Make one request, save headers/body and query the device and certificates.",{"_3626":1306,"_31190":1246,"_21615":55026,"_5":14871,"_28382":54862,"_3078":55027},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3626":1307,"_31190":1246,"_21615":55029,"_5":14871,"_28382":54862,"_3078":55030},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified — including an OCSP Unknown status — is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3626":1308,"_31190":1246,"_21615":55032,"_5":14871,"_28382":54862,"_3078":55033},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3626":1309,"_31190":1309,"_5":15231,"_3078":55035,"_31548":55036,"_21615":55037,"_28382":1309},"Trust distribution and updates",[50967,52479,53651,53649,53835],[],{"_3626":1310,"_31190":1309,"_21615":55039,"_5":14871,"_28382":1309,"_3078":55040},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3626":1311,"_31190":1309,"_5":31545,"_21615":55042,"_28382":55043,"_3078":55044},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3626":1312,"_31190":1309,"_5":31545,"_21615":55046,"_28382":55047,"_3078":55048},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3626":1313,"_31190":1309,"_5":31545,"_21615":55050,"_28382":55051,"_3078":55052},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3626":1314,"_31190":1309,"_5":31545,"_21615":55054,"_28382":55055,"_3078":55056},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3626":1315,"_31190":1309,"_5":31545,"_21615":55058,"_28382":55059,"_3078":55060},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3626":1316,"_31190":1309,"_21615":55062,"_5":14871,"_28382":1309,"_3078":55063},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3626":1317,"_31190":1309,"_21615":55065,"_5":14871,"_28382":55043,"_3078":55066},[],"Relationship",{"_3626":1318,"_31190":1309,"_21615":55068,"_5":14871,"_28382":55043,"_3078":55069},[],"Material prepared by its owner",{"_3626":1319,"_31190":1309,"_21615":55071,"_5":14871,"_28382":55043,"_3078":55072},[],"Device → EST server",{"_3626":1320,"_31190":1309,"_21615":55074,"_5":14871,"_28382":55043,"_3078":55075},[],"Previously verified server root, chain or pin and TLS name.",{"_3626":1321,"_31190":1309,"_21615":55077,"_5":14871,"_28382":55043,"_3078":55078},[],"DMS → requester",{"_3626":1322,"_31190":1309,"_21615":55080,"_5":14871,"_28382":55043,"_3078":55081},[],"CAs and rules authorizing initial or renewal credentials.",{"_3626":1323,"_31190":1309,"_21615":55083,"_5":14871,"_28382":55043,"_3078":55084},[],"Consumer → device",{"_3626":1324,"_31190":1309,"_21615":55086,"_5":14871,"_28382":55043,"_3078":55087},[],"Operational identity roots, intermediates, validation and permissions.",{"_3626":1325,"_31190":1309,"_21615":55089,"_5":14871,"_28382":55043,"_3078":55090},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3626":1326,"_31190":1309,"_21615":55092,"_5":14871,"_28382":55047,"_3078":55093},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3626":1327,"_31190":1309,"_21615":55095,"_5":14871,"_28382":55047,"_3078":55096},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3626":1328,"_31190":1309,"_21615":55098,"_5":14871,"_28382":55051,"_3078":55099},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3626":1329,"_31190":1309,"_21615":55101,"_5":14871,"_28382":55051,"_3078":55102},[],"Select policy-approved roots as anchors.",{"_3626":1330,"_31190":1309,"_21615":55104,"_5":14871,"_28382":55051,"_3078":55105},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3626":1331,"_31190":1309,"_21615":55107,"_5":14871,"_28382":55051,"_3078":55108},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3626":1332,"_31190":1309,"_21615":55110,"_5":14871,"_28382":55051,"_3078":55111},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3626":1333,"_31190":1309,"_21615":55113,"_5":14871,"_28382":55051,"_3078":55114},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3626":1334,"_31190":1309,"_21615":55116,"_5":14871,"_28382":55055,"_3078":55117},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3626":1335,"_31190":1309,"_21615":55119,"_5":14871,"_28382":55055,"_3078":55120},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3626":1336,"_31190":1309,"_21615":55122,"_5":14871,"_28382":55055,"_3078":55123},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3626":1337,"_31190":1309,"_21615":55125,"_5":14871,"_28382":55059,"_3078":55126},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3626":1338,"_31190":1338,"_5":15231,"_3078":55128,"_31548":55129,"_21615":55131,"_28382":1338},"AWS IoT Core",[50967,52479,53651,53649,55130],"Integrations",[],{"_3626":1339,"_31190":1338,"_21615":55133,"_5":14871,"_28382":1338,"_3078":55134},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3626":1340,"_31190":1338,"_5":31545,"_21615":55136,"_28382":55137,"_3078":55138},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3626":1341,"_31190":1338,"_5":31545,"_21615":55140,"_28382":55141,"_3078":55142},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3626":1342,"_31190":1338,"_5":31545,"_21615":55144,"_28382":55145,"_3078":55146},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3626":1343,"_31190":1338,"_5":31545,"_21615":55148,"_28382":55149,"_3078":55150},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3626":1344,"_31190":1338,"_5":31545,"_21615":55152,"_28382":55153,"_3078":55154},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3626":1345,"_31190":1338,"_5":31545,"_21615":55156,"_28382":55157,"_3078":55158},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3626":1346,"_31190":1338,"_5":31545,"_21615":55160,"_28382":55161,"_3078":55162},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3626":1347,"_31190":1338,"_5":31545,"_21615":55164,"_28382":55165,"_3078":55166},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3626":1348,"_31190":1338,"_5":31545,"_21615":55168,"_28382":55169,"_3078":55170},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3626":1349,"_31190":1338,"_5":31545,"_21615":55172,"_28382":55173,"_3078":55174},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3626":1350,"_31190":1338,"_5":31545,"_21615":55176,"_28382":55177,"_3078":55178},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3626":1351,"_31190":1338,"_5":31545,"_21615":55180,"_28382":55181,"_3078":55182},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3626":1352,"_31190":1338,"_5":31545,"_21615":55184,"_28382":55185,"_3078":55186},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3626":1353,"_31190":1338,"_5":31545,"_21615":55188,"_28382":55189,"_3078":55190},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3626":1354,"_31190":1338,"_5":31545,"_21615":55192,"_28382":55193,"_3078":55194},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3626":1355,"_31190":1338,"_5":31545,"_21615":55196,"_28382":55197,"_3078":55198},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3626":1356,"_31190":1338,"_5":31545,"_21615":55200,"_28382":55201,"_3078":55202},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3626":1357,"_31190":1338,"_5":31545,"_21615":55204,"_28382":55205,"_3078":55206},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3626":1358,"_31190":1338,"_5":31545,"_21615":55208,"_28382":55209,"_3078":55210},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3626":1359,"_31190":1338,"_5":31545,"_21615":55212,"_28382":55213,"_3078":55214},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3626":1360,"_31190":1338,"_5":31545,"_21615":55216,"_28382":55217,"_3078":55218},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3626":1361,"_31190":1338,"_5":31545,"_21615":55220,"_28382":55221,"_3078":55222},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3626":1362,"_31190":1338,"_5":31545,"_21615":55224,"_28382":55225,"_3078":55226},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3626":1363,"_31190":1338,"_5":31545,"_21615":55228,"_28382":55229,"_3078":55230},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3626":1364,"_31190":1338,"_5":31545,"_21615":55232,"_28382":55233,"_3078":55234},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3626":1365,"_31190":1338,"_21615":55236,"_5":14871,"_28382":1338,"_3078":55237},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3626":1366,"_31190":1338,"_21615":55239,"_5":14871,"_28382":1338,"_3078":55240},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3626":1367,"_31190":1338,"_21615":55242,"_5":14871,"_28382":1338,"_3078":55243},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3626":1368,"_31190":1338,"_21615":55245,"_5":14871,"_28382":55137,"_3078":55246},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3626":1369,"_31190":1338,"_21615":55248,"_5":14871,"_28382":55137,"_3078":55249},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3626":1370,"_31190":1338,"_21615":55251,"_5":14871,"_28382":55137,"_3078":55252},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3626":1371,"_31190":1338,"_21615":55254,"_5":14871,"_28382":55137,"_3078":55255},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3626":1372,"_31190":1338,"_21615":55257,"_5":14871,"_28382":55141,"_3078":55258},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3626":1373,"_31190":1338,"_21615":55260,"_5":14871,"_28382":55145,"_3078":55261},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3626":1374,"_31190":1338,"_21615":55263,"_5":14871,"_28382":55145,"_3078":55264},[],"IAM action",{"_3626":1375,"_31190":1338,"_21615":55266,"_5":14871,"_28382":55145,"_3078":51357},[],{"_3626":1376,"_31190":1338,"_21615":55268,"_5":14871,"_28382":55145,"_3078":55269},[],"`iot:GetRegistrationCode`",{"_3626":1377,"_31190":1338,"_21615":55271,"_5":14871,"_28382":55145,"_3078":55272},[],"Obtain the verification code for CA registration in the Primary Account",{"_3626":1378,"_31190":1338,"_21615":55274,"_5":14871,"_28382":55145,"_3078":55275},[],"`iot:RegisterCACertificate`",{"_3626":1379,"_31190":1338,"_21615":55277,"_5":14871,"_28382":55145,"_3078":55278},[],"Register the CA in AWS IoT",{"_3626":1380,"_31190":1338,"_21615":55280,"_5":14871,"_28382":55145,"_3078":55281},[],"`iot:DescribeCACertificate`",{"_3626":1381,"_31190":1338,"_21615":55283,"_5":14871,"_28382":55145,"_3078":55284},[],"Check the CA registration status",{"_3626":1382,"_31190":1338,"_21615":55286,"_5":14871,"_28382":55145,"_3078":55287},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3626":1383,"_31190":1338,"_21615":55289,"_5":14871,"_28382":55145,"_3078":55290},[],"Create or update Things in IoT Core",{"_3626":1384,"_31190":1338,"_21615":55292,"_5":14871,"_28382":55145,"_3078":55293},[],"`iot:RegisterThing`",{"_3626":1385,"_31190":1338,"_21615":55295,"_5":14871,"_28382":55145,"_3078":55296},[],"Provision Things through a template",{"_3626":1386,"_31190":1338,"_21615":55298,"_5":14871,"_28382":55145,"_3078":55299},[],"`iot:RegisterCertificate`",{"_3626":1387,"_31190":1338,"_21615":55301,"_5":14871,"_28382":55145,"_3078":55302},[],"Register device certificates",{"_3626":1388,"_31190":1338,"_21615":55304,"_5":14871,"_28382":55145,"_3078":55305},[],"`iot:UpdateCertificate`",{"_3626":1389,"_31190":1338,"_21615":55307,"_5":14871,"_28382":55145,"_3078":55308},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3626":1390,"_31190":1338,"_21615":55310,"_5":14871,"_28382":55145,"_3078":55311},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3626":1391,"_31190":1338,"_21615":55313,"_5":14871,"_28382":55145,"_3078":55314},[],"Create and attach IoT policies",{"_3626":1392,"_31190":1338,"_21615":55316,"_5":14871,"_28382":55145,"_3078":55317},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3626":1393,"_31190":1338,"_21615":55319,"_5":14871,"_28382":55145,"_3078":55320},[],"Manage Thing groups",{"_3626":1394,"_31190":1338,"_21615":55322,"_5":14871,"_28382":55145,"_3078":55323},[],"`iot:CreateProvisioningTemplate`",{"_3626":1395,"_31190":1338,"_21615":55325,"_5":14871,"_28382":55145,"_3078":55326},[],"Create JITP templates",{"_3626":1396,"_31190":1338,"_21615":55328,"_5":14871,"_28382":55145,"_3078":55329},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3626":1397,"_31190":1338,"_21615":55331,"_5":14871,"_28382":55145,"_3078":55332},[],"Read and write the Device Shadow",{"_3626":1398,"_31190":1338,"_21615":55334,"_5":14871,"_28382":55145,"_3078":55335},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3626":1399,"_31190":1338,"_21615":55337,"_5":14871,"_28382":55149,"_3078":55338},[],"Parameter",{"_3626":1400,"_31190":1338,"_21615":55340,"_5":14871,"_28382":55149,"_3078":55341},[],"Type",{"_3626":1401,"_31190":1338,"_21615":55343,"_5":14871,"_28382":55149,"_3078":55344},[],"Required",{"_3626":1402,"_31190":1338,"_21615":55346,"_5":14871,"_28382":55149,"_3078":55347},[],"Description",{"_3626":1403,"_31190":1338,"_21615":55349,"_5":14871,"_28382":55149,"_3078":55350},[],"`connector_id`",{"_3626":1404,"_31190":1338,"_21615":55352,"_5":14871,"_28382":55149,"_3078":25801},[],{"_3626":1405,"_31190":1338,"_21615":55354,"_5":14871,"_28382":55149,"_3078":55355},[],"Yes",{"_3626":1406,"_31190":1338,"_21615":55357,"_5":14871,"_28382":55149,"_3078":55358},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3626":1407,"_31190":1338,"_21615":55360,"_5":14871,"_28382":55149,"_3078":55361},[],"`aws_config.region`",{"_3626":1408,"_31190":1338,"_21615":55363,"_5":14871,"_28382":55149,"_3078":25801},[],{"_3626":1409,"_31190":1338,"_21615":55365,"_5":14871,"_28382":55149,"_3078":55355},[],{"_3626":1410,"_31190":1338,"_21615":55367,"_5":14871,"_28382":55149,"_3078":55368},[],"AWS region where the connector operates.",{"_3626":1411,"_31190":1338,"_21615":55370,"_5":14871,"_28382":55149,"_3078":55371},[],"`aws_config.auth_method`",{"_3626":1412,"_31190":1338,"_21615":55373,"_5":14871,"_28382":55149,"_3078":25801},[],{"_3626":1413,"_31190":1338,"_21615":55375,"_5":14871,"_28382":55149,"_3078":55355},[],{"_3626":1414,"_31190":1338,"_21615":55377,"_5":14871,"_28382":55149,"_3078":55378},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3626":1415,"_31190":1338,"_21615":55380,"_5":14871,"_28382":55149,"_3078":55381},[],"`aws_config.access_key_id`",{"_3626":1416,"_31190":1338,"_21615":55383,"_5":14871,"_28382":55149,"_3078":25801},[],{"_3626":1417,"_31190":1338,"_21615":55385,"_5":14871,"_28382":55149,"_3078":55386},[],"Only with `auth_method=static`",{"_3626":1418,"_31190":1338,"_21615":55388,"_5":14871,"_28382":55149,"_3078":55389},[],"AWS access key.",{"_3626":1419,"_31190":1338,"_21615":55391,"_5":14871,"_28382":55149,"_3078":55392},[],"`aws_config.secret_access_key`",{"_3626":1420,"_31190":1338,"_21615":55394,"_5":14871,"_28382":55149,"_3078":25801},[],{"_3626":1421,"_31190":1338,"_21615":55396,"_5":14871,"_28382":55149,"_3078":55386},[],{"_3626":1422,"_31190":1338,"_21615":55398,"_5":14871,"_28382":55149,"_3078":55399},[],"AWS secret key.",{"_3626":1423,"_31190":1338,"_21615":55401,"_5":14871,"_28382":55149,"_3078":55402},[],"`aws_config.session_token`",{"_3626":1424,"_31190":1338,"_21615":55404,"_5":14871,"_28382":55149,"_3078":25801},[],{"_3626":1425,"_31190":1338,"_21615":55406,"_5":14871,"_28382":55149,"_3078":55407},[],"No",{"_3626":1426,"_31190":1338,"_21615":55409,"_5":14871,"_28382":55149,"_3078":55410},[],"Session token (with `auth_method=static`).",{"_3626":1427,"_31190":1338,"_21615":55412,"_5":14871,"_28382":55149,"_3078":55413},[],"`aws_config.role_arn`",{"_3626":1428,"_31190":1338,"_21615":55415,"_5":14871,"_28382":55149,"_3078":25801},[],{"_3626":1429,"_31190":1338,"_21615":55417,"_5":14871,"_28382":55149,"_3078":55418},[],"Only with `auth_method=role`",{"_3626":1430,"_31190":1338,"_21615":55420,"_5":14871,"_28382":55149,"_3078":55421},[],"ARN of the role to assume.",{"_3626":1431,"_31190":1338,"_21615":55423,"_5":14871,"_28382":55149,"_3078":55424},[],"`aws_config.endpoint_url`",{"_3626":1432,"_31190":1338,"_21615":55426,"_5":14871,"_28382":55149,"_3078":25801},[],{"_3626":1433,"_31190":1338,"_21615":55428,"_5":14871,"_28382":55149,"_3078":55407},[],{"_3626":1434,"_31190":1338,"_21615":55430,"_5":14871,"_28382":55149,"_3078":55431},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3626":1435,"_31190":1338,"_21615":55433,"_5":14871,"_28382":55149,"_3078":55434},[],"`subscriber_event_bus`",{"_3626":1436,"_31190":1338,"_21615":55436,"_5":14871,"_28382":55149,"_3078":18228},[],{"_3626":1437,"_31190":1338,"_21615":55438,"_5":14871,"_28382":55149,"_3078":55355},[],{"_3626":1438,"_31190":1338,"_21615":55440,"_5":14871,"_28382":55149,"_3078":55441},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3626":1439,"_31190":1338,"_21615":55443,"_5":14871,"_28382":55149,"_3078":55444},[],"`dms_manager_client`",{"_3626":1440,"_31190":1338,"_21615":55446,"_5":14871,"_28382":55149,"_3078":25801},[],{"_3626":1441,"_31190":1338,"_21615":55448,"_5":14871,"_28382":55149,"_3078":55355},[],{"_3626":1442,"_31190":1338,"_21615":55450,"_5":14871,"_28382":55149,"_3078":55451},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3626":1443,"_31190":1338,"_21615":55453,"_5":14871,"_28382":55149,"_3078":55454},[],"`device_manager_client`",{"_3626":1444,"_31190":1338,"_21615":55456,"_5":14871,"_28382":55149,"_3078":25801},[],{"_3626":1445,"_31190":1338,"_21615":55458,"_5":14871,"_28382":55149,"_3078":55355},[],{"_3626":1446,"_31190":1338,"_21615":55460,"_5":14871,"_28382":55149,"_3078":55461},[],"HTTP URL of Lamassu's Device Manager.",{"_3626":1447,"_31190":1338,"_21615":55463,"_5":14871,"_28382":55149,"_3078":55464},[],"`ca_client`",{"_3626":1448,"_31190":1338,"_21615":55466,"_5":14871,"_28382":55149,"_3078":25801},[],{"_3626":1449,"_31190":1338,"_21615":55468,"_5":14871,"_28382":55149,"_3078":55355},[],{"_3626":1450,"_31190":1338,"_21615":55470,"_5":14871,"_28382":55149,"_3078":55471},[],"HTTP URL of Lamassu's CA service.",{"_3626":1451,"_31190":1338,"_21615":55473,"_5":14871,"_28382":55153,"_3078":55474},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3626":1452,"_31190":1338,"_21615":55476,"_5":14871,"_28382":55153,"_3078":55477},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3626":1453,"_31190":1338,"_21615":55479,"_5":14871,"_28382":55153,"_3078":55480},[],"CloudEvent type",{"_3626":1454,"_31190":1338,"_21615":55482,"_5":14871,"_28382":55153,"_3078":55483},[],"Lamassu resource",{"_3626":1455,"_31190":1338,"_21615":55485,"_5":14871,"_28382":55153,"_3078":55486},[],"AWS Resource",{"_3626":1456,"_31190":1338,"_21615":55488,"_5":14871,"_28382":55153,"_3078":55489},[],"IAM actions",{"_3626":1457,"_31190":1338,"_21615":55491,"_5":14871,"_28382":55153,"_3078":55492},[],"AWS calls and effect",{"_3626":1458,"_31190":1338,"_21615":55494,"_5":14871,"_28382":55153,"_3078":55495},[],"Where in this page",{"_3626":1459,"_31190":1338,"_21615":55497,"_5":14871,"_28382":55153,"_3078":55498},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3626":1460,"_31190":1338,"_21615":55500,"_5":14871,"_28382":55153,"_3078":55501},[],"CA",{"_3626":1461,"_31190":1338,"_21615":55503,"_5":14871,"_28382":55153,"_3078":55504},[],"`IoTCore/CACertificate`",{"_3626":1462,"_31190":1338,"_21615":55506,"_5":14871,"_28382":55153,"_3078":55507},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3626":1463,"_31190":1338,"_21615":55509,"_5":14871,"_28382":55153,"_3078":55510},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3626":1464,"_31190":1338,"_21615":55512,"_5":14871,"_28382":55153,"_3078":55166},[],{"_3626":1465,"_31190":1338,"_21615":55514,"_5":14871,"_28382":55153,"_3078":55515},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3626":1466,"_31190":1338,"_21615":55517,"_5":14871,"_28382":55153,"_3078":55518},[],"DMS",{"_3626":1467,"_31190":1338,"_21615":55520,"_5":14871,"_28382":55153,"_3078":55521},[],"`IoTCore/ProvisioningTemplate`",{"_3626":1468,"_31190":1338,"_21615":55523,"_5":14871,"_28382":55153,"_3078":55524},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3626":1469,"_31190":1338,"_21615":55526,"_5":14871,"_28382":55153,"_3078":55527},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3626":1470,"_31190":1338,"_21615":55529,"_5":14871,"_28382":55153,"_3078":55194},[],{"_3626":1471,"_31190":1338,"_21615":55531,"_5":14871,"_28382":55153,"_3078":55532},[],"`EventBindDeviceIdentityKey`",{"_3626":1472,"_31190":1338,"_21615":55534,"_5":14871,"_28382":55153,"_3078":55535},[],"Device",{"_3626":1473,"_31190":1338,"_21615":55537,"_5":14871,"_28382":55153,"_3078":55538},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3626":1474,"_31190":1338,"_21615":55540,"_5":14871,"_28382":55153,"_3078":55541},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3626":1475,"_31190":1338,"_21615":55543,"_5":14871,"_28382":55153,"_3078":55544},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3626":1476,"_31190":1338,"_21615":55546,"_5":14871,"_28382":55153,"_3078":55202},[],{"_3626":1477,"_31190":1338,"_21615":55548,"_5":14871,"_28382":55153,"_3078":55549},[],"`EventUpdateCertificateStatusKey`",{"_3626":1478,"_31190":1338,"_21615":55551,"_5":14871,"_28382":55153,"_3078":55552},[],"Certificate",{"_3626":1479,"_31190":1338,"_21615":55554,"_5":14871,"_28382":55153,"_3078":55555},[],"`IoTCore/Certificate`",{"_3626":1480,"_31190":1338,"_21615":55557,"_5":14871,"_28382":55153,"_3078":55558},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3626":1481,"_31190":1338,"_21615":55560,"_5":14871,"_28382":55153,"_3078":55561},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3626":1482,"_31190":1338,"_21615":55563,"_5":14871,"_28382":55153,"_3078":55214},[],{"_3626":1483,"_31190":1338,"_21615":55565,"_5":14871,"_28382":55153,"_3078":55566},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3626":1484,"_31190":1338,"_21615":55568,"_5":14871,"_28382":55153,"_3078":55569},[],"Certificate / Device",{"_3626":1485,"_31190":1338,"_21615":55571,"_5":14871,"_28382":55153,"_3078":55572},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3626":1486,"_31190":1338,"_21615":55574,"_5":14871,"_28382":55153,"_3078":51363},[],{"_3626":1487,"_31190":1338,"_21615":55576,"_5":14871,"_28382":55153,"_3078":55577},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3626":1488,"_31190":1338,"_21615":55579,"_5":14871,"_28382":55153,"_3078":55222},[],{"_3626":1489,"_31190":1338,"_21615":55581,"_5":14871,"_28382":55157,"_3078":55582},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3626":1490,"_31190":1338,"_21615":55584,"_5":14871,"_28382":55161,"_3078":55585},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3626":1491,"_31190":1338,"_21615":55587,"_5":14871,"_28382":55161,"_3078":55588},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3626":1492,"_31190":1338,"_21615":55590,"_5":14871,"_28382":55165,"_3078":55591},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3626":1493,"_31190":1338,"_21615":55593,"_5":14871,"_28382":55165,"_3078":55594},[],"Transition",{"_3626":1494,"_31190":1338,"_21615":55596,"_5":14871,"_28382":55165,"_3078":55597},[],"AWS calls",{"_3626":1495,"_31190":1338,"_21615":55599,"_5":14871,"_28382":55165,"_3078":55600},[],"`NotRegistered` → `Requested`",{"_3626":1496,"_31190":1338,"_21615":55602,"_5":14871,"_28382":55165,"_3078":55603},[],"none (metadata write only)",{"_3626":1497,"_31190":1338,"_21615":55605,"_5":14871,"_28382":55165,"_3078":55606},[],"`Requested` → `Registering`",{"_3626":1498,"_31190":1338,"_21615":55608,"_5":14871,"_28382":55165,"_3078":55609},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3626":1499,"_31190":1338,"_21615":55611,"_5":14871,"_28382":55165,"_3078":55612},[],"`Registering` → `Succeeded`",{"_3626":1500,"_31190":1338,"_21615":55614,"_5":14871,"_28382":55165,"_3078":55615},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3626":1501,"_31190":1338,"_21615":55617,"_5":14871,"_28382":55165,"_3078":55618},[],"`Registering` → `Failed`",{"_3626":1502,"_31190":1338,"_21615":55620,"_5":14871,"_28382":55165,"_3078":55621},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3626":1503,"_31190":1338,"_21615":55623,"_5":14871,"_28382":55165,"_3078":55624},[],"`Failed` / `Succeeded` → `Requested`",{"_3626":1504,"_31190":1338,"_21615":55626,"_5":14871,"_28382":55165,"_3078":55627},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3626":1505,"_31190":1338,"_21615":55629,"_5":14871,"_28382":55169,"_3078":55630},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3626":1506,"_31190":1338,"_21615":55632,"_5":14871,"_28382":55169,"_3078":55633},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3626":1507,"_31190":1338,"_21615":55635,"_5":14871,"_28382":55169,"_3078":55636},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3626":1508,"_31190":1338,"_21615":55638,"_5":14871,"_28382":55169,"_3078":55639},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3626":1509,"_31190":1338,"_21615":55641,"_5":14871,"_28382":55169,"_3078":55642},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3626":1510,"_31190":1338,"_21615":55644,"_5":14871,"_28382":55169,"_3078":55645},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3626":1511,"_31190":1338,"_21615":55647,"_5":14871,"_28382":55173,"_3078":55648},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3626":1512,"_31190":1338,"_21615":55650,"_5":14871,"_28382":55177,"_3078":55651},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3626":1513,"_31190":1338,"_21615":55653,"_5":14871,"_28382":55177,"_3078":55654},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3626":1514,"_31190":1338,"_21615":55656,"_5":14871,"_28382":55181,"_3078":55657},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3626":1515,"_31190":1338,"_21615":55659,"_5":14871,"_28382":55185,"_3078":55660},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3626":1516,"_31190":1338,"_21615":55662,"_5":14871,"_28382":55185,"_3078":55663},[],"Creates or updates the IoT policies configured in the DMS.",{"_3626":1517,"_31190":1338,"_21615":55665,"_5":14871,"_28382":55185,"_3078":55666},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3626":1518,"_31190":1338,"_21615":55668,"_5":14871,"_28382":55185,"_3078":55669},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3626":1519,"_31190":1338,"_21615":55671,"_5":14871,"_28382":55185,"_3078":55672},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3626":1520,"_31190":1338,"_21615":55674,"_5":14871,"_28382":55185,"_3078":55675},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3626":1521,"_31190":1338,"_21615":55677,"_5":14871,"_28382":55185,"_3078":55678},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3626":1522,"_31190":1338,"_21615":55680,"_5":14871,"_28382":55189,"_3078":55681},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3626":1523,"_31190":1338,"_21615":55683,"_5":14871,"_28382":55189,"_3078":55684},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3626":1524,"_31190":1338,"_21615":55686,"_5":14871,"_28382":55189,"_3078":55687},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3626":1525,"_31190":1338,"_21615":55689,"_5":14871,"_28382":55189,"_3078":55690},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3626":1526,"_31190":1338,"_21615":55692,"_5":14871,"_28382":55189,"_3078":55693},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3626":1527,"_31190":1338,"_21615":55695,"_5":14871,"_28382":55193,"_3078":55696},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3626":1528,"_31190":1338,"_21615":55698,"_5":14871,"_28382":55193,"_3078":55594},[],{"_3626":1529,"_31190":1338,"_21615":55700,"_5":14871,"_28382":55193,"_3078":55597},[],{"_3626":1530,"_31190":1338,"_21615":55702,"_5":14871,"_28382":55193,"_3078":55703},[],"`Unconfigured` → `None` / `Auto`",{"_3626":1531,"_31190":1338,"_21615":55705,"_5":14871,"_28382":55193,"_3078":55706},[],"none (configuration only)",{"_3626":1532,"_31190":1338,"_21615":55708,"_5":14871,"_28382":55193,"_3078":55709},[],"`None` ↔ `Auto`",{"_3626":1533,"_31190":1338,"_21615":55711,"_5":14871,"_28382":55193,"_3078":55706},[],{"_3626":1534,"_31190":1338,"_21615":55713,"_5":14871,"_28382":55193,"_3078":55714},[],"Any → `Jitp`",{"_3626":1535,"_31190":1338,"_21615":55716,"_5":14871,"_28382":55193,"_3078":55717},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3626":1536,"_31190":1338,"_21615":55719,"_5":14871,"_28382":55193,"_3078":55720},[],"`Jitp` → `None` / `Auto`",{"_3626":1537,"_31190":1338,"_21615":55722,"_5":14871,"_28382":55193,"_3078":55723},[],"none (the template stays in the AWS account)",{"_3626":1538,"_31190":1338,"_21615":55725,"_5":14871,"_28382":55197,"_3078":55726},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3626":1539,"_31190":1338,"_21615":55728,"_5":14871,"_28382":55197,"_3078":55729},[],"The full flow from the device's perspective is:",{"_3626":1540,"_31190":1338,"_21615":55731,"_5":14871,"_28382":55197,"_3078":55732},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3626":1541,"_31190":1338,"_21615":55734,"_5":14871,"_28382":55201,"_3078":55735},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3626":1542,"_31190":1338,"_21615":55737,"_5":14871,"_28382":55201,"_3078":55594},[],{"_3626":1543,"_31190":1338,"_21615":55739,"_5":14871,"_28382":55201,"_3078":55597},[],{"_3626":1544,"_31190":1338,"_21615":55741,"_5":14871,"_28382":55201,"_3078":55742},[],"`Absent` → `Provisioned`",{"_3626":1545,"_31190":1338,"_21615":55744,"_5":14871,"_28382":55201,"_3078":55745},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3626":1546,"_31190":1338,"_21615":55747,"_5":14871,"_28382":55201,"_3078":55748},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3626":1547,"_31190":1338,"_21615":55750,"_5":14871,"_28382":55201,"_3078":55751},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3626":1548,"_31190":1338,"_21615":55753,"_5":14871,"_28382":55201,"_3078":55754},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3626":1549,"_31190":1338,"_21615":55756,"_5":14871,"_28382":55205,"_3078":55757},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3626":1550,"_31190":1338,"_21615":55759,"_5":14871,"_28382":55205,"_3078":55760},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3626":1551,"_31190":1338,"_21615":55762,"_5":14871,"_28382":55205,"_3078":55763},[],"For the JITP flow to work correctly:",{"_3626":1552,"_31190":1338,"_21615":55765,"_5":14871,"_28382":55205,"_3078":55766},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3626":1553,"_31190":1338,"_21615":55768,"_5":14871,"_28382":55205,"_3078":55769},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3626":1554,"_31190":1338,"_21615":55771,"_5":14871,"_28382":55205,"_3078":55772},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3626":1555,"_31190":1338,"_21615":55774,"_5":14871,"_28382":55205,"_3078":55775},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3626":1556,"_31190":1338,"_21615":55777,"_5":14871,"_28382":55209,"_3078":55778},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3626":1557,"_31190":1338,"_21615":55780,"_5":14871,"_28382":55209,"_3078":55781},[],"Status in Lamassu",{"_3626":1558,"_31190":1338,"_21615":55783,"_5":14871,"_28382":55209,"_3078":55784},[],"Revocation reason",{"_3626":1559,"_31190":1338,"_21615":55786,"_5":14871,"_28382":55209,"_3078":55787},[],"Status in AWS IoT Core",{"_3626":1560,"_31190":1338,"_21615":55789,"_5":14871,"_28382":55209,"_3078":55790},[],"`Active`",{"_3626":1561,"_31190":1338,"_21615":55792,"_5":14871,"_28382":55209,"_3078":55793},[],"None",{"_3626":1562,"_31190":1338,"_21615":55795,"_5":14871,"_28382":55209,"_3078":55796},[],"`ACTIVE`",{"_3626":1563,"_31190":1338,"_21615":55798,"_5":14871,"_28382":55209,"_3078":55799},[],"`Revoked`",{"_3626":1564,"_31190":1338,"_21615":55801,"_5":14871,"_28382":55209,"_3078":55802},[],"`certificateHold`",{"_3626":1565,"_31190":1338,"_21615":55804,"_5":14871,"_28382":55209,"_3078":55805},[],"`INACTIVE`",{"_3626":1566,"_31190":1338,"_21615":55807,"_5":14871,"_28382":55209,"_3078":55799},[],{"_3626":1567,"_31190":1338,"_21615":55809,"_5":14871,"_28382":55209,"_3078":55810},[],"Any other reason",{"_3626":1568,"_31190":1338,"_21615":55812,"_5":14871,"_28382":55209,"_3078":55813},[],"`REVOKED`",{"_3626":1569,"_31190":1338,"_21615":55815,"_5":14871,"_28382":55209,"_3078":55816},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3626":1570,"_31190":1338,"_21615":55818,"_5":14871,"_28382":55213,"_3078":55819},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3626":1571,"_31190":1338,"_21615":55821,"_5":14871,"_28382":55213,"_3078":55594},[],{"_3626":1572,"_31190":1338,"_21615":55823,"_5":14871,"_28382":55213,"_3078":55597},[],{"_3626":1573,"_31190":1338,"_21615":55825,"_5":14871,"_28382":55213,"_3078":55826},[],"`NotSynced` → `Active`",{"_3626":1574,"_31190":1338,"_21615":55828,"_5":14871,"_28382":55213,"_3078":55305},[],{"_3626":1575,"_31190":1338,"_21615":55830,"_5":14871,"_28382":55213,"_3078":55831},[],"`Active` → `Inactive`",{"_3626":1576,"_31190":1338,"_21615":55833,"_5":14871,"_28382":55213,"_3078":55834},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3626":1577,"_31190":1338,"_21615":55836,"_5":14871,"_28382":55213,"_3078":55837},[],"`Active` → `Revoked`",{"_3626":1578,"_31190":1338,"_21615":55839,"_5":14871,"_28382":55213,"_3078":55834},[],{"_3626":1579,"_31190":1338,"_21615":55841,"_5":14871,"_28382":55213,"_3078":55842},[],"`Inactive` / `Revoked` → `Active`",{"_3626":1580,"_31190":1338,"_21615":55844,"_5":14871,"_28382":55213,"_3078":55305},[],{"_3626":1581,"_31190":1338,"_21615":55846,"_5":14871,"_28382":55213,"_3078":55847},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3626":1582,"_31190":1338,"_21615":55849,"_5":14871,"_28382":55213,"_3078":55850},[],"none (these states are not synced to AWS)",{"_3626":1583,"_31190":1338,"_21615":55852,"_5":14871,"_28382":55217,"_3078":55853},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3626":1584,"_31190":1338,"_21615":55855,"_5":14871,"_28382":55217,"_3078":55856},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3626":1585,"_31190":1338,"_21615":55858,"_5":14871,"_28382":55217,"_3078":55859},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3626":1586,"_31190":1338,"_21615":55861,"_5":14871,"_28382":55221,"_3078":55862},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3626":1587,"_31190":1338,"_21615":55864,"_5":14871,"_28382":55221,"_3078":55865},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3626":1588,"_31190":1338,"_21615":55867,"_5":14871,"_28382":55225,"_3078":55868},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3626":1589,"_31190":1338,"_21615":55870,"_5":14871,"_28382":55225,"_3078":55871},[],"There are two action types:",{"_3626":1590,"_31190":1338,"_21615":55873,"_5":14871,"_28382":55225,"_3078":55874},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3626":1591,"_31190":1338,"_21615":55876,"_5":14871,"_28382":55225,"_3078":55877},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3626":1592,"_31190":1338,"_21615":55879,"_5":14871,"_28382":55225,"_3078":55880},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3626":1593,"_31190":1338,"_21615":55882,"_5":14871,"_28382":55229,"_3078":55883},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3626":1594,"_31190":1338,"_21615":55885,"_5":14871,"_28382":55229,"_3078":55886},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3626":1595,"_31190":1338,"_21615":55888,"_5":14871,"_28382":55229,"_3078":55889},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3626":1596,"_31190":1338,"_21615":55891,"_5":14871,"_28382":55233,"_3078":55892},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3626":1597,"_31190":1338,"_21615":55894,"_5":14871,"_28382":55233,"_3078":55895},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3626":1598,"_31190":1338,"_21615":55897,"_5":14871,"_28382":55233,"_3078":55898},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3626":1599,"_31190":1338,"_21615":55900,"_5":14871,"_28382":55233,"_3078":55901},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3626":1600,"_31190":1338,"_21615":55903,"_5":14871,"_28382":55233,"_3078":55904},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3626":1601,"_31190":1338,"_21615":55906,"_5":14871,"_28382":55233,"_3078":55907},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3626":1602,"_31190":1338,"_21615":55909,"_5":14871,"_28382":55233,"_3078":55910},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3626":1603,"_31190":1338,"_21615":55912,"_5":14871,"_28382":55233,"_3078":55913},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3626":1604,"_31190":1338,"_21615":55915,"_5":14871,"_28382":55233,"_3078":55916},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3626":1605,"_31190":1338,"_21615":55918,"_5":14871,"_28382":55233,"_3078":55919},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3626":1606,"_31190":1338,"_21615":55921,"_5":14871,"_28382":55233,"_3078":55922},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3626":1607,"_31190":1338,"_21615":55924,"_5":14871,"_28382":55233,"_3078":55925},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3626":1608,"_31190":1338,"_21615":55927,"_5":14871,"_28382":55233,"_3078":55928},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3626":1609,"_31190":1338,"_21615":55930,"_5":14871,"_28382":55233,"_3078":55931},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3626":1610,"_31190":1338,"_21615":55933,"_5":14871,"_28382":55233,"_3078":55934},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3626":1611,"_31190":1338,"_21615":55936,"_5":14871,"_28382":55233,"_3078":55937},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3626":1612,"_31190":1338,"_21615":55939,"_5":14871,"_28382":55233,"_3078":55940},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3626":1613,"_31190":1338,"_21615":55942,"_5":14871,"_28382":55233,"_3078":55943},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3626":1614,"_31190":1338,"_21615":55945,"_5":14871,"_28382":55233,"_3078":55946},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3626":1615,"_31190":1338,"_21615":55948,"_5":14871,"_28382":55233,"_3078":55949},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3626":1616,"_31190":1338,"_21615":55951,"_5":14871,"_28382":55233,"_3078":55952},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3626":1617,"_31190":1338,"_21615":55954,"_5":14871,"_28382":55233,"_3078":55955},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3626":1618,"_31190":1338,"_21615":55957,"_5":14871,"_28382":55233,"_3078":55958},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3626":1619,"_31190":1338,"_21615":55960,"_5":14871,"_28382":55233,"_3078":55961},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3626":1620,"_31190":1620,"_5":15231,"_3078":53651,"_31548":55963,"_21615":55964,"_28382":1620},[50967,52479,53651],[],{"_3626":1621,"_31190":1620,"_21615":55966,"_5":14871,"_28382":1620,"_3078":55967},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3626":1622,"_31190":1620,"_5":31545,"_21615":55969,"_28382":55970,"_3078":55971},[],"/docs/pr-preview/pr-77/platform/iot-fleets/overview#start-here","Start here",{"_3626":1623,"_31190":1620,"_5":31545,"_21615":55973,"_28382":55974,"_3078":53649},[],"/docs/pr-preview/pr-77/platform/iot-fleets/overview#devices-and-identities",{"_3626":1624,"_31190":1620,"_5":31545,"_21615":55976,"_28382":55977,"_3078":53835},[],"/docs/pr-preview/pr-77/platform/iot-fleets/overview#enrollment-with-pki",{"_3626":1625,"_31190":1620,"_5":31545,"_21615":55979,"_28382":55980,"_3078":55130},[],"/docs/pr-preview/pr-77/platform/iot-fleets/overview#integrations",{"_3626":1626,"_31190":1620,"_5":31545,"_21615":55982,"_28382":55983,"_3078":55984},[],"/docs/pr-preview/pr-77/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3626":1627,"_31190":1620,"_21615":55986,"_5":14871,"_28382":1620,"_3078":55987},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3626":1628,"_31190":1620,"_21615":55989,"_5":14871,"_28382":55970,"_3078":55990},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3626":1629,"_31190":1620,"_21615":55992,"_5":14871,"_28382":55970,"_3078":55993},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3626":1630,"_31190":1620,"_21615":55995,"_5":14871,"_28382":55974,"_3078":55996},[],"Resource",{"_3626":1631,"_31190":1620,"_21615":55998,"_5":14871,"_28382":55974,"_3078":55999},[],"What it represents",{"_3626":1632,"_31190":1620,"_21615":56001,"_5":14871,"_28382":55974,"_3078":56002},[],"**Device**",{"_3626":1633,"_31190":1620,"_21615":56004,"_5":14871,"_28382":55974,"_3078":56005},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3626":1634,"_31190":1620,"_21615":56007,"_5":14871,"_28382":55974,"_3078":56008},[],"**Identity**",{"_3626":1635,"_31190":1620,"_21615":56010,"_5":14871,"_28382":55974,"_3078":56011},[],"The device's association with its certificates: an active version and a history.",{"_3626":1636,"_31190":1620,"_21615":56013,"_5":14871,"_28382":55974,"_3078":56014},[],"**DMS**",{"_3626":1637,"_31190":1620,"_21615":56016,"_5":14871,"_28382":55974,"_3078":56017},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3626":1638,"_31190":1620,"_21615":56019,"_5":14871,"_28382":55974,"_3078":56020},[],"**Fleet**",{"_3626":1639,"_31190":1620,"_21615":56022,"_5":14871,"_28382":55974,"_3078":56023},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3626":1640,"_31190":1620,"_21615":56025,"_5":14871,"_28382":55974,"_3078":56026},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3626":1641,"_31190":1620,"_21615":56028,"_5":14871,"_28382":55974,"_3078":56029},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3626":1642,"_31190":1620,"_21615":56031,"_5":14871,"_28382":55977,"_3078":56032},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3626":1643,"_31190":1620,"_21615":56034,"_5":14871,"_28382":55977,"_3078":56035},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3626":1644,"_31190":1620,"_21615":56037,"_5":14871,"_28382":55977,"_3078":56038},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3626":1645,"_31190":1620,"_21615":56040,"_5":14871,"_28382":55977,"_3078":56041},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3626":1646,"_31190":1620,"_21615":56043,"_5":14871,"_28382":55977,"_3078":56044},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3626":1647,"_31190":1620,"_21615":56046,"_5":14871,"_28382":55977,"_3078":56047},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3626":1648,"_31190":1620,"_21615":56049,"_5":14871,"_28382":55977,"_3078":56050},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3626":1649,"_31190":1620,"_21615":56052,"_5":14871,"_28382":55977,"_3078":56053},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3626":1650,"_31190":1620,"_21615":56055,"_5":14871,"_28382":55980,"_3078":56056},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3626":1651,"_31190":1620,"_21615":56058,"_5":14871,"_28382":55980,"_3078":56059},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3626":1652,"_31190":1620,"_21615":56061,"_5":14871,"_28382":55983,"_3078":56062},[],"Participant",{"_3626":1653,"_31190":1620,"_21615":56064,"_5":14871,"_28382":55983,"_3078":56065},[],"Responsibility",{"_3626":1654,"_31190":1620,"_21615":56067,"_5":14871,"_28382":55983,"_3078":56068},[],"PKI administrator",{"_3626":1655,"_31190":1620,"_21615":56070,"_5":14871,"_28382":55983,"_3078":56071},[],"CA, issuance profile, chain and revocation publication.",{"_3626":1656,"_31190":1620,"_21615":56073,"_5":14871,"_28382":55983,"_3078":56074},[],"Provisioning administrator",{"_3626":1657,"_31190":1620,"_21615":56076,"_5":14871,"_28382":55983,"_3078":56077},[],"DMS, admission, authentication per operation and inventory.",{"_3626":1658,"_31190":1620,"_21615":56079,"_5":14871,"_28382":55983,"_3078":56080},[],"Device integrator",{"_3626":1659,"_31190":1620,"_21615":56082,"_5":14871,"_28382":55983,"_3078":56083},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3626":1660,"_31190":1620,"_21615":56085,"_5":14871,"_28382":55983,"_3078":56086},[],"Consumer integrator",{"_3626":1661,"_31190":1620,"_21615":56088,"_5":14871,"_28382":55983,"_3078":56089},[],"Trusted issuers, validation and device permissions in the destination.",{"_3626":1662,"_31190":1620,"_21615":56091,"_5":14871,"_28382":55983,"_3078":56092},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3626":1663,"_31190":1663,"_5":15231,"_3078":56094,"_31548":56095,"_21615":56097,"_28382":1663},"Enroll and connect your first device",[50967,52479,53651,56096],"Getting started",[],{"_3626":1664,"_31190":1663,"_21615":56099,"_5":14871,"_28382":1663,"_3078":56100},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3626":1665,"_31190":1663,"_5":31545,"_21615":56102,"_28382":56103,"_3078":50977},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3626":1666,"_31190":1663,"_5":31545,"_21615":56105,"_28382":56106,"_3078":56107},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3626":1667,"_31190":1663,"_5":31545,"_21615":56109,"_28382":56110,"_3078":56111},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3626":1668,"_31190":1663,"_5":31545,"_21615":56113,"_28382":56114,"_3078":56115},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3626":1669,"_31190":1663,"_5":31545,"_21615":56117,"_28382":56118,"_3078":56119},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3626":1670,"_31190":1663,"_5":31545,"_21615":56121,"_28382":56122,"_3078":56123},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3626":1671,"_31190":1663,"_5":31545,"_21615":56125,"_28382":56126,"_3078":56127},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3626":1672,"_31190":1663,"_5":31545,"_21615":56129,"_28382":56130,"_3078":56131},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3626":1673,"_31190":1663,"_21615":56133,"_5":14871,"_28382":1663,"_3078":56134},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3626":1674,"_31190":1663,"_21615":56136,"_5":14871,"_28382":56103,"_3078":56137},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3626":1675,"_31190":1663,"_21615":56139,"_5":14871,"_28382":56103,"_3078":56140},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3626":1676,"_31190":1663,"_21615":56142,"_5":14871,"_28382":56103,"_3078":56143},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3626":1677,"_31190":1663,"_21615":56145,"_5":14871,"_28382":56103,"_3078":56146},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3626":1678,"_31190":1663,"_21615":56148,"_5":14871,"_28382":56103,"_3078":56149},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3626":1679,"_31190":1663,"_21615":56151,"_5":14871,"_28382":56106,"_3078":56152},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3626":1680,"_31190":1663,"_21615":56154,"_5":14871,"_28382":56106,"_3078":56155},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3626":1681,"_31190":1663,"_21615":56157,"_5":14871,"_28382":56110,"_3078":56158},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3626":1682,"_31190":1663,"_21615":56160,"_5":14871,"_28382":56110,"_3078":56161},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3626":1683,"_31190":1663,"_21615":56163,"_5":14871,"_28382":56110,"_3078":56164},[],"Setting",{"_3626":1684,"_31190":1663,"_21615":56166,"_5":14871,"_28382":56110,"_3078":56167},[],"Evaluation value",{"_3626":1685,"_31190":1663,"_21615":56169,"_5":14871,"_28382":56110,"_3078":56170},[],"Enrollment CA",{"_3626":1686,"_31190":1663,"_21615":56172,"_5":14871,"_28382":56110,"_3078":56173},[],"Issuing root from `device-root.pem`.",{"_3626":1687,"_31190":1663,"_21615":56175,"_5":14871,"_28382":56110,"_3078":53971},[],{"_3626":1688,"_31190":1663,"_21615":56177,"_5":14871,"_28382":56110,"_3078":56178},[],"The 1-hour leaf profile you just prepared.",{"_3626":1689,"_31190":1663,"_21615":56180,"_5":14871,"_28382":56110,"_3078":56181},[],"Protocol / Registration Mode",{"_3626":1690,"_31190":1663,"_21615":56183,"_5":14871,"_28382":56110,"_3078":56184},[],"`EST_RFC7030` / `JITP`.",{"_3626":1691,"_31190":1663,"_21615":56186,"_5":14871,"_28382":56110,"_3078":56187},[],"Verify CSR Signature",{"_3626":1692,"_31190":1663,"_21615":56189,"_5":14871,"_28382":56110,"_3078":56190},[],"Enabled.",{"_3626":1693,"_31190":1663,"_21615":56192,"_5":14871,"_28382":56110,"_3078":56193},[],"Enable Replaceable Enrollment",{"_3626":1694,"_31190":1663,"_21615":56195,"_5":14871,"_28382":56110,"_3078":56196},[],"Disabled; the ID must be new.",{"_3626":1695,"_31190":1663,"_21615":56198,"_5":14871,"_28382":56110,"_3078":56199},[],"Initial authentication",{"_3626":1696,"_31190":1663,"_21615":56201,"_5":14871,"_28382":56110,"_3078":56202},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3626":1697,"_31190":1663,"_21615":56204,"_5":14871,"_28382":56110,"_3078":56205},[],"Renewal authentication",{"_3626":1698,"_31190":1663,"_21615":56207,"_5":14871,"_28382":56110,"_3078":56208},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3626":1699,"_31190":1663,"_21615":56210,"_5":14871,"_28382":56110,"_3078":56211},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3626":1700,"_31190":1663,"_21615":56213,"_5":14871,"_28382":56110,"_3078":56214},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3626":1701,"_31190":1663,"_21615":56216,"_5":14871,"_28382":56110,"_3078":56217},[],"Re-enrollment Delta",{"_3626":1702,"_31190":1663,"_21615":56219,"_5":14871,"_28382":56110,"_3078":56220},[],"1 hour.",{"_3626":1703,"_31190":1663,"_21615":56222,"_5":14871,"_28382":56110,"_3078":56223},[],"Preventive / Critical Delta",{"_3626":1704,"_31190":1663,"_21615":56225,"_5":14871,"_28382":56110,"_3078":56226},[],"30 minutes / 10 minutes.",{"_3626":1705,"_31190":1663,"_21615":56228,"_5":14871,"_28382":56110,"_3078":56229},[],"Revoke on Re-enrollment",{"_3626":1706,"_31190":1663,"_21615":56231,"_5":14871,"_28382":56110,"_3078":56232},[],"Disabled to test the successor before retiring the previous identity.",{"_3626":1707,"_31190":1663,"_21615":56234,"_5":14871,"_28382":56110,"_3078":53979},[],{"_3626":1708,"_31190":1663,"_21615":56236,"_5":14871,"_28382":56110,"_3078":56237},[],"Disabled; the operational key is generated in the client.",{"_3626":1709,"_31190":1663,"_21615":56239,"_5":14871,"_28382":56110,"_3078":56240},[],"CA Distribution",{"_3626":1710,"_31190":1663,"_21615":56242,"_5":14871,"_28382":56110,"_3078":56243},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3626":1711,"_31190":1663,"_21615":56245,"_5":14871,"_28382":56110,"_3078":56246},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3626":1712,"_31190":1663,"_21615":56248,"_5":14871,"_28382":56114,"_3078":56249},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3626":1713,"_31190":1663,"_21615":56251,"_5":14871,"_28382":56114,"_3078":56252},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3626":1714,"_31190":1663,"_21615":56254,"_5":14871,"_28382":56118,"_3078":56255},[],"Generate a new key and CSR with the selected identifier:",{"_3626":1715,"_31190":1663,"_21615":56257,"_5":14871,"_28382":56118,"_3078":56258},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3626":1716,"_31190":1663,"_21615":56260,"_5":14871,"_28382":56118,"_3078":56261},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3626":1717,"_31190":1663,"_21615":56263,"_5":14871,"_28382":56122,"_3078":56264},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3626":1718,"_31190":1663,"_21615":56266,"_5":14871,"_28382":56122,"_3078":56267},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3626":1719,"_31190":1663,"_21615":56269,"_5":14871,"_28382":56126,"_3078":56270},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3626":1720,"_31190":1663,"_21615":56272,"_5":14871,"_28382":56126,"_3078":56273},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3626":1721,"_31190":1663,"_21615":56275,"_5":14871,"_28382":56126,"_3078":56276},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3626":1722,"_31190":1663,"_21615":56278,"_5":14871,"_28382":56126,"_3078":56279},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3626":1723,"_31190":1663,"_21615":56281,"_5":14871,"_28382":56126,"_3078":56282},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3626":1724,"_31190":1663,"_21615":56284,"_5":14871,"_28382":56130,"_3078":56285},[],"Check",{"_3626":1725,"_31190":1663,"_21615":56287,"_5":14871,"_28382":56130,"_3078":56288},[],"Expected result",{"_3626":1726,"_31190":1663,"_21615":56290,"_5":14871,"_28382":56130,"_3078":56291},[],"Registration",{"_3626":1727,"_31190":1663,"_21615":56293,"_5":14871,"_28382":56130,"_3078":56294},[],"ID created automatically and correct DMS.",{"_3626":1728,"_31190":1663,"_21615":56296,"_5":14871,"_28382":56130,"_3078":55552},[],{"_3626":1729,"_31190":1663,"_21615":56298,"_5":14871,"_28382":56130,"_3078":56299},[],"CN, profile, serial and key verified.",{"_3626":1730,"_31190":1663,"_21615":56301,"_5":14871,"_28382":56130,"_3078":56302},[],"Inventory",{"_3626":1731,"_31190":1663,"_21615":56304,"_5":14871,"_28382":56130,"_3078":56305},[],"Received serial visible as the current identity and in history.",{"_3626":1732,"_31190":1663,"_21615":56307,"_5":14871,"_28382":56130,"_3078":56308},[],"Consumer",{"_3626":1733,"_31190":1663,"_21615":56310,"_5":14871,"_28382":56130,"_3078":56311},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3626":1734,"_31190":1663,"_21615":56313,"_5":14871,"_28382":56130,"_3078":56314},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3626":1735,"_31190":1663,"_21615":56316,"_5":14871,"_28382":56130,"_3078":56317},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3626":1736,"_31190":1736,"_5":15231,"_3078":53667,"_31548":56319,"_21615":56320,"_28382":1736},[50967,52479,53651,56096],[],{"_3626":1737,"_31190":1736,"_21615":56322,"_5":14871,"_28382":1736,"_3078":56323},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3626":1738,"_31190":1736,"_5":31545,"_21615":56325,"_28382":56326,"_3078":50977},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3626":1739,"_31190":1736,"_5":31545,"_21615":56328,"_28382":56329,"_3078":56330},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3626":1740,"_31190":1736,"_5":31545,"_21615":56332,"_28382":56333,"_3078":56334},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3626":1741,"_31190":1736,"_5":31545,"_21615":56336,"_28382":56337,"_3078":56338},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3626":1742,"_31190":1736,"_5":31545,"_21615":56340,"_28382":56341,"_3078":56342},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3626":1743,"_31190":1736,"_5":31545,"_21615":56344,"_28382":56345,"_3078":56346},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3626":1744,"_31190":1736,"_5":31545,"_21615":56348,"_28382":56349,"_3078":56288},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3626":1745,"_31190":1736,"_5":31545,"_21615":56351,"_28382":56352,"_3078":56353},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3626":1746,"_31190":1736,"_5":31545,"_21615":56355,"_28382":56356,"_3078":56357},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3626":1747,"_31190":1736,"_21615":56359,"_5":14871,"_28382":1736,"_3078":56360},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3626":1748,"_31190":1736,"_21615":56362,"_5":14871,"_28382":1736,"_3078":56363},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3626":1749,"_31190":1736,"_21615":56365,"_5":14871,"_28382":56326,"_3078":56366},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3626":1750,"_31190":1736,"_21615":56368,"_5":14871,"_28382":56326,"_3078":56369},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3626":1751,"_31190":1736,"_21615":56371,"_5":14871,"_28382":56326,"_3078":56372},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3626":1752,"_31190":1736,"_21615":56374,"_5":14871,"_28382":56326,"_3078":56375},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3626":1753,"_31190":1736,"_21615":56377,"_5":14871,"_28382":56329,"_3078":56378},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3626":1754,"_31190":1736,"_21615":56380,"_5":14871,"_28382":56329,"_3078":56381},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3626":1755,"_31190":1736,"_21615":56383,"_5":14871,"_28382":56329,"_3078":56384},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3626":1756,"_31190":1736,"_21615":56386,"_5":14871,"_28382":56329,"_3078":56387},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3626":1757,"_31190":1736,"_21615":56389,"_5":14871,"_28382":56329,"_3078":56390},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3626":1758,"_31190":1736,"_21615":56392,"_5":14871,"_28382":56329,"_3078":56393},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3626":1759,"_31190":1736,"_21615":56395,"_5":14871,"_28382":56329,"_3078":56396},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3626":1760,"_31190":1736,"_21615":56398,"_5":14871,"_28382":56329,"_3078":56399},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3626":1761,"_31190":1736,"_21615":56401,"_5":14871,"_28382":56333,"_3078":56402},[],"Open **Managed Devices** and the registration action. Complete:",{"_3626":1762,"_31190":1736,"_21615":56404,"_5":14871,"_28382":56333,"_3078":56405},[],"**Device ID**: `device-001`.",{"_3626":1763,"_31190":1736,"_21615":56407,"_5":14871,"_28382":56333,"_3078":56408},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3626":1764,"_31190":1736,"_21615":56410,"_5":14871,"_28382":56333,"_3078":56411},[],"**Icon** and **Tags**: optional classification.",{"_3626":1765,"_31190":1736,"_21615":56413,"_5":14871,"_28382":56333,"_3078":56414},[],"Confirm registration.",{"_3626":1766,"_31190":1736,"_21615":56416,"_5":14871,"_28382":56337,"_3078":56417},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3626":1767,"_31190":1736,"_21615":56419,"_5":14871,"_28382":56337,"_3078":56420},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3626":1768,"_31190":1736,"_21615":56422,"_5":14871,"_28382":56341,"_3078":56423},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3626":1769,"_31190":1736,"_21615":56425,"_5":14871,"_28382":56341,"_3078":56426},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3626":1770,"_31190":1736,"_21615":56428,"_5":14871,"_28382":56345,"_3078":56429},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3626":1771,"_31190":1736,"_21615":56431,"_5":14871,"_28382":56345,"_3078":56432},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3626":1772,"_31190":1736,"_21615":56434,"_5":14871,"_28382":56349,"_3078":56285},[],{"_3626":1773,"_31190":1736,"_21615":56436,"_5":14871,"_28382":56349,"_3078":56437},[],"Result",{"_3626":1774,"_31190":1736,"_21615":56439,"_5":14871,"_28382":56349,"_3078":55535},[],{"_3626":1775,"_31190":1736,"_21615":56441,"_5":14871,"_28382":56349,"_3078":56442},[],"`device-001` appears in inventory with the expected DMS.",{"_3626":1776,"_31190":1736,"_21615":56444,"_5":14871,"_28382":56349,"_3078":56445},[],"Current identity",{"_3626":1777,"_31190":1736,"_21615":56447,"_5":14871,"_28382":56349,"_3078":56448},[],"The associated certificate matches the one you verified in PKI.",{"_3626":1778,"_31190":1736,"_21615":56450,"_5":14871,"_28382":56349,"_3078":56451},[],"History",{"_3626":1779,"_31190":1736,"_21615":56453,"_5":14871,"_28382":56349,"_3078":56454},[],"The associated issuance appears with its serial number and dates.",{"_3626":1780,"_31190":1736,"_21615":56456,"_5":14871,"_28382":56349,"_3078":56457},[],"Key and certificate",{"_3626":1781,"_31190":1736,"_21615":56459,"_5":14871,"_28382":56349,"_3078":56460},[],"You have the verified pair ready to install on the device.",{"_3626":1782,"_31190":1736,"_21615":56462,"_5":14871,"_28382":56352,"_3078":56463},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3626":1783,"_31190":1736,"_21615":56465,"_5":14871,"_28382":56352,"_3078":56466},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3626":1784,"_31190":1736,"_21615":56468,"_5":14871,"_28382":56352,"_3078":56469},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3626":1785,"_31190":1736,"_21615":56471,"_5":14871,"_28382":56352,"_3078":56472},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3626":1786,"_31190":1736,"_21615":56474,"_5":14871,"_28382":56356,"_3078":56475},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3626":1787,"_31190":1736,"_21615":56477,"_5":14871,"_28382":56356,"_3078":56478},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3626":1788,"_31190":1736,"_21615":56480,"_5":14871,"_28382":56356,"_3078":56481},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3626":1789,"_31190":1789,"_5":15231,"_3078":56483,"_31548":56484,"_21615":56485,"_28382":1789},"Lamassu IoT Platform",[50967,52479],[],{"_3626":1790,"_31190":1789,"_21615":56487,"_5":14871,"_28382":1789,"_3078":56488},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3626":1791,"_31190":1789,"_5":31545,"_21615":56490,"_28382":56491,"_3078":55971},[],"/docs/pr-preview/pr-77/platform/overview#start-here",{"_3626":1792,"_31190":1789,"_5":31545,"_21615":56493,"_28382":56494,"_3078":56495},[],"/docs/pr-preview/pr-77/platform/overview#choose-your-path","Choose your path",{"_3626":1793,"_31190":1789,"_5":31545,"_21615":56497,"_28382":56498,"_3078":56499},[],"/docs/pr-preview/pr-77/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3626":1794,"_31190":1789,"_5":31545,"_21615":56501,"_28382":56502,"_3078":56503},[],"/docs/pr-preview/pr-77/platform/overview#core-capabilities","Core capabilities",{"_3626":1795,"_31190":1789,"_5":31545,"_21615":56505,"_28382":56506,"_3078":56507},[],"/docs/pr-preview/pr-77/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3626":1796,"_31190":1789,"_5":31545,"_21615":56509,"_28382":56510,"_3078":56511},[],"/docs/pr-preview/pr-77/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3626":1797,"_31190":1789,"_5":31545,"_21615":56513,"_28382":56514,"_3078":56515},[],"/docs/pr-preview/pr-77/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3626":1798,"_31190":1789,"_5":31545,"_21615":56517,"_28382":56518,"_3078":56519},[],"/docs/pr-preview/pr-77/platform/overview#automate-device-identities","Automate device identities",{"_3626":1799,"_31190":1789,"_5":31545,"_21615":56521,"_28382":56522,"_3078":56523},[],"/docs/pr-preview/pr-77/platform/overview#publish-validation-status","Publish validation status",{"_3626":1800,"_31190":1789,"_5":31545,"_21615":56525,"_28382":56526,"_3078":56527},[],"/docs/pr-preview/pr-77/platform/overview#react-to-events","React to events",{"_3626":1801,"_31190":1789,"_5":31545,"_21615":56529,"_28382":56530,"_3078":56531},[],"/docs/pr-preview/pr-77/platform/overview#operational-reference","Operational reference",{"_3626":1802,"_31190":1789,"_21615":56533,"_5":14871,"_28382":1789,"_3078":56534},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3626":1803,"_31190":1789,"_21615":56536,"_5":14871,"_28382":56491,"_3078":56537},[],"Choose the result you need:",{"_3626":1804,"_31190":1789,"_21615":56539,"_5":14871,"_28382":56491,"_3078":56540},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3626":1805,"_31190":1789,"_21615":56542,"_5":14871,"_28382":56491,"_3078":56543},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3626":1806,"_31190":1789,"_21615":56545,"_5":14871,"_28382":56491,"_3078":56546},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3626":1807,"_31190":1789,"_21615":56548,"_5":14871,"_28382":56494,"_3078":56549},[],"Section",{"_3626":1808,"_31190":1789,"_21615":56551,"_5":14871,"_28382":56494,"_3078":56552},[],"What you manage",{"_3626":1809,"_31190":1789,"_21615":56554,"_5":14871,"_28382":56494,"_3078":56555},[],"Entry point",{"_3626":1810,"_31190":1789,"_21615":56557,"_5":14871,"_28382":56494,"_3078":56558},[],"**PKI**",{"_3626":1811,"_31190":1789,"_21615":56560,"_5":14871,"_28382":56494,"_3078":56561},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3626":1812,"_31190":1789,"_21615":56563,"_5":14871,"_28382":56494,"_3078":56564},[],"PKI overview",{"_3626":1813,"_31190":1789,"_21615":56566,"_5":14871,"_28382":56494,"_3078":56567},[],"**IoT Fleets**",{"_3626":1814,"_31190":1789,"_21615":56569,"_5":14871,"_28382":56494,"_3078":56570},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3626":1815,"_31190":1789,"_21615":56572,"_5":14871,"_28382":56494,"_3078":56573},[],"IoT Fleets overview",{"_3626":1816,"_31190":1789,"_21615":56575,"_5":14871,"_28382":56494,"_3078":56576},[],"**Administration**",{"_3626":1817,"_31190":1789,"_21615":56578,"_5":14871,"_28382":56494,"_3078":56579},[],"Operator permissions, audit and event subscriptions.",{"_3626":1818,"_31190":1789,"_21615":56581,"_5":14871,"_28382":56494,"_3078":52481},[],{"_3626":1819,"_31190":1789,"_21615":56583,"_5":14871,"_28382":56494,"_3078":56584},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3626":1820,"_31190":1789,"_21615":56586,"_5":14871,"_28382":56498,"_3078":56587},[],"An identity's journey connects four responsibilities:",{"_3626":1821,"_31190":1789,"_21615":56589,"_5":14871,"_28382":56498,"_3078":56590},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3626":1822,"_31190":1789,"_21615":56592,"_5":14871,"_28382":56498,"_3078":56593},[],"The provisioning administrator configures the DMS and initial trust.",{"_3626":1823,"_31190":1789,"_21615":56595,"_5":14871,"_28382":56498,"_3078":56596},[],"The device client requests a certificate and installs it with the matching key.",{"_3626":1824,"_31190":1789,"_21615":56598,"_5":14871,"_28382":56498,"_3078":56599},[],"The consumer validates the identity and applies its access permissions.",{"_3626":1825,"_31190":1789,"_21615":56601,"_5":14871,"_28382":56498,"_3078":56602},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3626":1826,"_31190":1789,"_21615":56604,"_5":14871,"_28382":56506,"_3078":56605},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3626":1827,"_31190":1789,"_21615":56607,"_5":14871,"_28382":56510,"_3078":56608},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3626":1828,"_31190":1789,"_21615":56610,"_5":14871,"_28382":56514,"_3078":56611},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3626":1829,"_31190":1789,"_21615":56613,"_5":14871,"_28382":56518,"_3078":56614},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3626":1830,"_31190":1789,"_21615":56616,"_5":14871,"_28382":56522,"_3078":56617},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3626":1831,"_31190":1789,"_21615":56619,"_5":14871,"_28382":56526,"_3078":56620},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3626":1832,"_31190":1789,"_21615":56622,"_5":14871,"_28382":56530,"_3078":56065},[],{"_3626":1833,"_31190":1789,"_21615":56624,"_5":14871,"_28382":56530,"_3078":56625},[],"What it prepares or checks",{"_3626":1834,"_31190":1789,"_21615":56627,"_5":14871,"_28382":56530,"_3078":56068},[],{"_3626":1835,"_31190":1789,"_21615":56629,"_5":14871,"_28382":56530,"_3078":56630},[],"Key custody, CA hierarchy, profiles and validation.",{"_3626":1836,"_31190":1789,"_21615":56632,"_5":14871,"_28382":56530,"_3078":56633},[],"Fleet administrator",{"_3626":1837,"_31190":1789,"_21615":56635,"_5":14871,"_28382":56530,"_3078":56636},[],"DMS, device admission, renewal policy and inventory.",{"_3626":1838,"_31190":1789,"_21615":56638,"_5":14871,"_28382":56530,"_3078":56080},[],{"_3626":1839,"_31190":1789,"_21615":56640,"_5":14871,"_28382":56530,"_3078":56641},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3626":1840,"_31190":1789,"_21615":56643,"_5":14871,"_28382":56530,"_3078":56086},[],{"_3626":1841,"_31190":1789,"_21615":56645,"_5":14871,"_28382":56530,"_3078":56646},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3626":1842,"_31190":1789,"_21615":56648,"_5":14871,"_28382":56530,"_3078":56649},[],"Infrastructure operator",{"_3626":1843,"_31190":1789,"_21615":56651,"_5":14871,"_28382":56530,"_3078":56652},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3626":1844,"_31190":1789,"_21615":56654,"_5":14871,"_28382":56530,"_3078":56655},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3626":1845,"_31190":1845,"_5":15231,"_3078":56657,"_31548":56658,"_21615":56661,"_28382":1845},"CA hierarchy and rotation",[50967,52479,56659,56660],"PKI","Keys, authorities and certificates",[],{"_3626":1846,"_31190":1845,"_21615":56663,"_5":14871,"_28382":1845,"_3078":56664},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3626":1847,"_31190":1845,"_5":31545,"_21615":56666,"_28382":56667,"_3078":56668},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3626":1848,"_31190":1845,"_5":31545,"_21615":56670,"_28382":56671,"_3078":56672},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3626":1849,"_31190":1845,"_5":31545,"_21615":56674,"_28382":56675,"_3078":56676},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3626":1850,"_31190":1845,"_5":31545,"_21615":56678,"_28382":56679,"_3078":56680},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3626":1851,"_31190":1845,"_5":31545,"_21615":56682,"_28382":56683,"_3078":56684},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3626":1852,"_31190":1845,"_5":31545,"_21615":56686,"_28382":56687,"_3078":56688},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3626":1853,"_31190":1845,"_5":31545,"_21615":56690,"_28382":56691,"_3078":56692},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3626":1854,"_31190":1845,"_5":31545,"_21615":56694,"_28382":56695,"_3078":56696},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3626":1855,"_31190":1845,"_5":31545,"_21615":56698,"_28382":56699,"_3078":56700},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3626":1856,"_31190":1845,"_5":31545,"_21615":56702,"_28382":56703,"_3078":56704},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3626":1857,"_31190":1845,"_5":31545,"_21615":56706,"_28382":56707,"_3078":56708},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3626":1858,"_31190":1845,"_5":31545,"_21615":56710,"_28382":56711,"_3078":56712},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3626":1859,"_31190":1845,"_21615":56714,"_5":14871,"_28382":1845,"_3078":56715},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3626":1860,"_31190":1845,"_21615":56717,"_5":14871,"_28382":1845,"_3078":56718},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3626":1861,"_31190":1845,"_21615":56720,"_5":14871,"_28382":56667,"_3078":56721},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3626":1862,"_31190":1845,"_21615":56723,"_5":14871,"_28382":56667,"_3078":56724},[],"environment, such as production and preproduction;",{"_3626":1863,"_31190":1845,"_21615":56726,"_5":14871,"_28382":56667,"_3078":56727},[],"owner or operating team;",{"_3626":1864,"_31190":1845,"_21615":56729,"_5":14871,"_28382":56667,"_3078":56730},[],"device family or manufacturing process;",{"_3626":1865,"_31190":1845,"_21615":56732,"_5":14871,"_28382":56667,"_3078":56733},[],"region or regulatory requirement;",{"_3626":1866,"_31190":1845,"_21615":56735,"_5":14871,"_28382":56667,"_3078":56736},[],"cryptographic engine or key policy;",{"_3626":1867,"_31190":1845,"_21615":56738,"_5":14871,"_28382":56667,"_3078":56739},[],"maintenance window and renewal cadence.",{"_3626":1868,"_31190":1845,"_21615":56741,"_5":14871,"_28382":56667,"_3078":56742},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3626":1869,"_31190":1845,"_21615":56744,"_5":14871,"_28382":56667,"_3078":56745},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3626":1870,"_31190":1845,"_21615":56747,"_5":14871,"_28382":56671,"_3078":56748},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3626":1871,"_31190":1845,"_21615":56750,"_5":14871,"_28382":56671,"_3078":56751},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3626":1872,"_31190":1845,"_21615":56753,"_5":14871,"_28382":56671,"_3078":56754},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3626":1873,"_31190":1845,"_21615":56756,"_5":14871,"_28382":56671,"_3078":56757},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3626":1874,"_31190":1845,"_21615":56759,"_5":14871,"_28382":56675,"_3078":56760},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3626":1875,"_31190":1845,"_21615":56762,"_5":14871,"_28382":56675,"_3078":56763},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3626":1876,"_31190":1845,"_21615":56765,"_5":14871,"_28382":56675,"_3078":56766},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3626":1877,"_31190":1845,"_21615":56768,"_5":14871,"_28382":56675,"_3078":56769},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3626":1878,"_31190":1845,"_21615":56771,"_5":14871,"_28382":56683,"_3078":56772},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3626":1879,"_31190":1845,"_21615":56774,"_5":14871,"_28382":56687,"_3078":56775},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3626":1880,"_31190":1845,"_21615":56777,"_5":14871,"_28382":56691,"_3078":56778},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3626":1881,"_31190":1845,"_21615":56780,"_5":14871,"_28382":56695,"_3078":56781},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3626":1882,"_31190":1845,"_21615":56783,"_5":14871,"_28382":56699,"_3078":56784},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3626":1883,"_31190":1845,"_21615":56786,"_5":14871,"_28382":56703,"_3078":56787},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3626":1884,"_31190":1845,"_21615":56789,"_5":14871,"_28382":56707,"_3078":56790},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3626":1885,"_31190":1845,"_21615":56792,"_5":14871,"_28382":56707,"_3078":56793},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3626":1886,"_31190":1845,"_21615":56795,"_5":14871,"_28382":56707,"_3078":56796},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3626":1887,"_31190":1845,"_21615":56798,"_5":14871,"_28382":56707,"_3078":56799},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3626":1888,"_31190":1845,"_21615":56801,"_5":14871,"_28382":56711,"_3078":56802},[],"The new chain ends in an anchor installed by the consumer.",{"_3626":1889,"_31190":1845,"_21615":56804,"_5":14871,"_28382":56711,"_3078":56805},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3626":1890,"_31190":1845,"_21615":56807,"_5":14871,"_28382":56711,"_3078":56808},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3626":1891,"_31190":1845,"_21615":56810,"_5":14871,"_28382":56711,"_3078":56811},[],"Re-enrollment accepts the old identity during the planned period.",{"_3626":1892,"_31190":1845,"_21615":56813,"_5":14871,"_28382":56711,"_3078":56814},[],"OCSP and CRL respond for the authorities that remain active.",{"_3626":1893,"_31190":1845,"_21615":56816,"_5":14871,"_28382":56711,"_3078":56817},[],"No DMS is left accidentally issuing from the old CA.",{"_3626":1894,"_31190":1845,"_21615":56819,"_5":14871,"_28382":56711,"_3078":56820},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3626":1895,"_31190":1895,"_5":15231,"_3078":56822,"_31548":56823,"_21615":56824,"_28382":1895},"Certification authorities",[50967,52479,56659,56660],[],{"_3626":1896,"_31190":1895,"_21615":56826,"_5":14871,"_28382":1895,"_3078":56827},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3626":1897,"_31190":1895,"_5":31545,"_21615":56829,"_28382":56830,"_3078":56831},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3626":1898,"_31190":1895,"_5":31545,"_21615":56833,"_28382":56834,"_3078":56835},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3626":1899,"_31190":1895,"_5":31545,"_21615":56837,"_28382":56838,"_3078":50977},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#before-you-begin",{"_3626":1900,"_31190":1895,"_5":31545,"_21615":56840,"_28382":56841,"_3078":56842},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3626":1901,"_31190":1895,"_5":31545,"_21615":56844,"_28382":56845,"_3078":56846},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3626":1902,"_31190":1895,"_5":31545,"_21615":56848,"_28382":56849,"_3078":56850},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3626":1903,"_31190":1895,"_5":31545,"_21615":56852,"_28382":56853,"_3078":56854},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3626":1904,"_31190":1895,"_5":31545,"_21615":56856,"_28382":56857,"_3078":56858},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3626":1905,"_31190":1895,"_5":31545,"_21615":56860,"_28382":56861,"_3078":56862},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3626":1906,"_31190":1895,"_5":31545,"_21615":56864,"_28382":56865,"_3078":56866},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3626":1907,"_31190":1895,"_5":31545,"_21615":56868,"_28382":56869,"_3078":56870},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3626":1908,"_31190":1895,"_5":31545,"_21615":56872,"_28382":56873,"_3078":56874},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3626":1909,"_31190":1895,"_5":31545,"_21615":56876,"_28382":56877,"_3078":56878},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3626":1910,"_31190":1895,"_5":31545,"_21615":56880,"_28382":56881,"_3078":56882},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3626":1911,"_31190":1895,"_5":31545,"_21615":56884,"_28382":56885,"_3078":56886},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3626":1912,"_31190":1895,"_5":31545,"_21615":56888,"_28382":56889,"_3078":56890},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3626":1913,"_31190":1895,"_5":31545,"_21615":56892,"_28382":56893,"_3078":56894},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3626":1914,"_31190":1895,"_5":31545,"_21615":56896,"_28382":56897,"_3078":56898},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3626":1915,"_31190":1895,"_5":31545,"_21615":56900,"_28382":56901,"_3078":56902},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3626":1916,"_31190":1895,"_5":31545,"_21615":56904,"_28382":56905,"_3078":56906},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3626":1917,"_31190":1895,"_5":31545,"_21615":56908,"_28382":56909,"_3078":56910},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3626":1918,"_31190":1895,"_5":31545,"_21615":56912,"_28382":56913,"_3078":56914},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3626":1919,"_31190":1895,"_5":31545,"_21615":56916,"_28382":56917,"_3078":56918},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3626":1920,"_31190":1895,"_21615":56920,"_5":14871,"_28382":1895,"_3078":56921},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3626":1921,"_31190":1895,"_21615":56923,"_5":14871,"_28382":1895,"_3078":56924},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3626":1922,"_31190":1895,"_21615":56926,"_5":14871,"_28382":1895,"_3078":56927},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3626":1923,"_31190":1895,"_21615":56929,"_5":14871,"_28382":56830,"_3078":56930},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3626":1924,"_31190":1895,"_21615":56932,"_5":14871,"_28382":56830,"_3078":56933},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3626":1925,"_31190":1895,"_21615":56935,"_5":14871,"_28382":56830,"_3078":56936},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3626":1926,"_31190":1895,"_21615":56938,"_5":14871,"_28382":56830,"_3078":56939},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3626":1927,"_31190":1895,"_21615":56941,"_5":14871,"_28382":56830,"_3078":56942},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3626":1928,"_31190":1895,"_21615":56944,"_5":14871,"_28382":56838,"_3078":56945},[],"Decide whether the CA will be a root or an intermediate.",{"_3626":1929,"_31190":1895,"_21615":56947,"_5":14871,"_28382":56838,"_3078":56948},[],"Choose the engine that will keep the key.",{"_3626":1930,"_31190":1895,"_21615":56950,"_5":14871,"_28382":56838,"_3078":56951},[],"Define a validity longer than that of the certificates it will issue.",{"_3626":1931,"_31190":1895,"_21615":56953,"_5":14871,"_28382":56838,"_3078":56954},[],"For an intermediate CA, make sure the parent CA is active.",{"_3626":1932,"_31190":1895,"_21615":56956,"_5":14871,"_28382":56841,"_3078":56957},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3626":1933,"_31190":1895,"_21615":56959,"_5":14871,"_28382":56845,"_3078":56960},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3626":1934,"_31190":1895,"_21615":56962,"_5":14871,"_28382":56845,"_3078":56963},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3626":1935,"_31190":1895,"_21615":56965,"_5":14871,"_28382":56849,"_3078":56966},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3626":1936,"_31190":1895,"_21615":56968,"_5":14871,"_28382":56853,"_3078":56969},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3626":1937,"_31190":1895,"_21615":56971,"_5":14871,"_28382":56853,"_3078":56972},[],"`C`: two-letter ISO 3166-1 country code.",{"_3626":1938,"_31190":1895,"_21615":56974,"_5":14871,"_28382":56853,"_3078":56975},[],"`ST`: state or province.",{"_3626":1939,"_31190":1895,"_21615":56977,"_5":14871,"_28382":56853,"_3078":56978},[],"`L`: locality.",{"_3626":1940,"_31190":1895,"_21615":56980,"_5":14871,"_28382":56853,"_3078":56981},[],"`O`: organization.",{"_3626":1941,"_31190":1895,"_21615":56983,"_5":14871,"_28382":56853,"_3078":56984},[],"`OU`: organizational unit.",{"_3626":1942,"_31190":1895,"_21615":56986,"_5":14871,"_28382":56853,"_3078":56987},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3626":1943,"_31190":1895,"_21615":56989,"_5":14871,"_28382":56857,"_3078":56990},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3626":1944,"_31190":1895,"_21615":56992,"_5":14871,"_28382":56857,"_3078":56993},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3626":1945,"_31190":1895,"_21615":56995,"_5":14871,"_28382":56861,"_3078":56996},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3626":1946,"_31190":1895,"_21615":56998,"_5":14871,"_28382":56861,"_3078":56999},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3626":1947,"_31190":1895,"_21615":57001,"_5":14871,"_28382":56865,"_3078":57002},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3626":1948,"_31190":1895,"_21615":57004,"_5":14871,"_28382":56865,"_3078":57005},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3626":1949,"_31190":1895,"_21615":57007,"_5":14871,"_28382":56869,"_3078":57008},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3626":1950,"_31190":1895,"_21615":57010,"_5":14871,"_28382":56869,"_3078":57011},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3626":1951,"_31190":1895,"_21615":57013,"_5":14871,"_28382":56869,"_3078":57014},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3626":1952,"_31190":1895,"_21615":57016,"_5":14871,"_28382":56873,"_3078":57017},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3626":1953,"_31190":1895,"_21615":57019,"_5":14871,"_28382":56877,"_3078":57020},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3626":1954,"_31190":1895,"_21615":57022,"_5":14871,"_28382":56877,"_3078":57023},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3626":1955,"_31190":1895,"_21615":57025,"_5":14871,"_28382":56881,"_3078":57026},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3626":1956,"_31190":1895,"_21615":57028,"_5":14871,"_28382":56885,"_3078":57029},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3626":1957,"_31190":1895,"_21615":57031,"_5":14871,"_28382":56885,"_3078":57032},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3626":1958,"_31190":1895,"_21615":57034,"_5":14871,"_28382":56885,"_3078":57035},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3626":1959,"_31190":1895,"_21615":57037,"_5":14871,"_28382":56889,"_3078":57038},[],"Open a CA from the inventory to review:",{"_3626":1960,"_31190":1895,"_21615":57040,"_5":14871,"_28382":56889,"_3078":57041},[],"Status and validity period.",{"_3626":1961,"_31190":1895,"_21615":57043,"_5":14871,"_28382":56889,"_3078":57044},[],"Certificate and chain in PEM format.",{"_3626":1962,"_31190":1895,"_21615":57046,"_5":14871,"_28382":56889,"_3078":57047},[],"Number of active, expired and revoked certificates.",{"_3626":1963,"_31190":1895,"_21615":57049,"_5":14871,"_28382":56889,"_3078":57050},[],"Certificates issued in **Issued Certificates**.",{"_3626":1964,"_31190":1895,"_21615":57052,"_5":14871,"_28382":56889,"_3078":57053},[],"The CRL linked to the authority.",{"_3626":1965,"_31190":1895,"_21615":57055,"_5":14871,"_28382":56889,"_3078":57056},[],"Metadata and the associated cryptographic engine.",{"_3626":1966,"_31190":1895,"_21615":57058,"_5":14871,"_28382":56889,"_3078":57059},[],"You can filter the inventory by name, status and CA type.",{"_3626":1967,"_31190":1895,"_21615":57061,"_5":14871,"_28382":56893,"_3078":57062},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3626":1968,"_31190":1895,"_21615":57064,"_5":14871,"_28382":56893,"_3078":57065},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3626":1969,"_31190":1895,"_21615":57067,"_5":14871,"_28382":56893,"_3078":57068},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3626":1970,"_31190":1895,"_21615":57070,"_5":14871,"_28382":56893,"_3078":57071},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3626":1971,"_31190":1895,"_21615":57073,"_5":14871,"_28382":56893,"_3078":57074},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3626":1972,"_31190":1895,"_21615":57076,"_5":14871,"_28382":56893,"_3078":57077},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3626":1973,"_31190":1895,"_21615":57079,"_5":14871,"_28382":56897,"_3078":57080},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3626":1974,"_31190":1895,"_21615":57082,"_5":14871,"_28382":56901,"_3078":57083},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3626":1975,"_31190":1895,"_21615":57085,"_5":14871,"_28382":56905,"_3078":57086},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3626":1976,"_31190":1895,"_21615":57088,"_5":14871,"_28382":56909,"_3078":57089},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3626":1977,"_31190":1895,"_21615":57091,"_5":14871,"_28382":56913,"_3078":57092},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3626":1978,"_31190":1895,"_21615":57094,"_5":14871,"_28382":56917,"_3078":57095},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3626":1979,"_31190":1895,"_21615":57097,"_5":14871,"_28382":56917,"_3078":57098},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3626":1980,"_31190":1895,"_21615":57100,"_5":14871,"_28382":56917,"_3078":57101},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3626":1981,"_31190":1895,"_21615":57103,"_5":14871,"_28382":56917,"_3078":57104},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3626":1982,"_31190":1982,"_5":15231,"_3078":57106,"_31548":57107,"_21615":57108,"_28382":1982},"Certificate profiles",[50967,52479,56659,56660],[],{"_3626":1983,"_31190":1982,"_21615":57110,"_5":14871,"_28382":1982,"_3078":57111},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3626":1984,"_31190":1982,"_5":31545,"_21615":57113,"_28382":57114,"_3078":57115},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3626":1985,"_31190":1982,"_5":31545,"_21615":57117,"_28382":57118,"_3078":57119},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#validity","Validity",{"_3626":1986,"_31190":1982,"_5":31545,"_21615":57121,"_28382":57122,"_3078":57123},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3626":1987,"_31190":1982,"_5":31545,"_21615":57125,"_28382":57126,"_3078":57127},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3626":1988,"_31190":1982,"_5":31545,"_21615":57129,"_28382":57130,"_3078":57131},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#subject","Subject",{"_3626":1989,"_31190":1982,"_5":31545,"_21615":57133,"_28382":57134,"_3078":57135},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3626":1990,"_31190":1982,"_5":31545,"_21615":57137,"_28382":57138,"_3078":57139},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3626":1991,"_31190":1982,"_5":31545,"_21615":57141,"_28382":57142,"_3078":57143},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3626":1992,"_31190":1982,"_5":31545,"_21615":57145,"_28382":57146,"_3078":57147},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3626":1993,"_31190":1982,"_5":31545,"_21615":57149,"_28382":57150,"_3078":57151},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3626":1994,"_31190":1982,"_5":31545,"_21615":57153,"_28382":57154,"_3078":57155},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3626":1995,"_31190":1982,"_5":31545,"_21615":57157,"_28382":57158,"_3078":57159},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3626":1996,"_31190":1982,"_5":31545,"_21615":57161,"_28382":57162,"_3078":57163},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3626":1997,"_31190":1982,"_5":31545,"_21615":57165,"_28382":57166,"_3078":57167},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3626":1998,"_31190":1982,"_5":31545,"_21615":57169,"_28382":57170,"_3078":57171},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#design-examples","Design examples",{"_3626":1999,"_31190":1982,"_5":31545,"_21615":57173,"_28382":57174,"_3078":57175},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3626":2000,"_31190":1982,"_21615":57177,"_5":14871,"_28382":1982,"_3078":57178},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3626":2001,"_31190":1982,"_21615":57180,"_5":14871,"_28382":1982,"_3078":57181},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3626":2002,"_31190":1982,"_21615":57183,"_5":14871,"_28382":57118,"_3078":57184},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3626":2003,"_31190":1982,"_21615":57186,"_5":14871,"_28382":57118,"_3078":57187},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3626":2004,"_31190":1982,"_21615":57189,"_5":14871,"_28382":57122,"_3078":57190},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3626":2005,"_31190":1982,"_21615":57192,"_5":14871,"_28382":57126,"_3078":57193},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3626":2006,"_31190":1982,"_21615":57195,"_5":14871,"_28382":57126,"_3078":57196},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3626":2007,"_31190":1982,"_21615":57198,"_5":14871,"_28382":57126,"_3078":57199},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3626":2008,"_31190":1982,"_21615":57201,"_5":14871,"_28382":57130,"_3078":57202},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3626":2009,"_31190":1982,"_21615":57204,"_5":14871,"_28382":57134,"_3078":57205},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3626":2010,"_31190":1982,"_21615":57207,"_5":14871,"_28382":57134,"_3078":57208},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3626":2011,"_31190":1982,"_21615":57210,"_5":14871,"_28382":57138,"_3078":57211},[],"The cryptographic enforcement can:",{"_3626":2012,"_31190":1982,"_21615":57213,"_5":14871,"_28382":57138,"_3078":57214},[],"allow or block RSA keys;",{"_3626":2013,"_31190":1982,"_21615":57216,"_5":14871,"_28382":57138,"_3078":57217},[],"limit the supported RSA sizes;",{"_3626":2014,"_31190":1982,"_21615":57219,"_5":14871,"_28382":57138,"_3078":57220},[],"allow or block ECDSA keys;",{"_3626":2015,"_31190":1982,"_21615":57222,"_5":14871,"_28382":57138,"_3078":57223},[],"limit the supported ECDSA sizes or curves.",{"_3626":2016,"_31190":1982,"_21615":57225,"_5":14871,"_28382":57138,"_3078":57226},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3626":2017,"_31190":1982,"_21615":57228,"_5":14871,"_28382":57142,"_3078":57229},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3626":2018,"_31190":1982,"_21615":57231,"_5":14871,"_28382":57142,"_3078":54422},[],{"_3626":2019,"_31190":1982,"_21615":57233,"_5":14871,"_28382":57142,"_3078":57234},[],"First choice",{"_3626":2020,"_31190":1982,"_21615":57236,"_5":14871,"_28382":57142,"_3078":57237},[],"Second choice",{"_3626":2021,"_31190":1982,"_21615":57239,"_5":14871,"_28382":57142,"_3078":57240},[],"If neither is supplied",{"_3626":2022,"_31190":1982,"_21615":57242,"_5":14871,"_28382":57142,"_3078":57243},[],"Direct signing with a CA",{"_3626":2023,"_31190":1982,"_21615":57245,"_5":14871,"_28382":57142,"_3078":57246},[],"`issuance_profile` embedded in the request",{"_3626":2024,"_31190":1982,"_21615":57248,"_5":14871,"_28382":57142,"_3078":57249},[],"Request `issuance_profile_id`",{"_3626":2025,"_31190":1982,"_21615":57251,"_5":14871,"_28382":57142,"_3078":57252},[],"CA default profile (`profile_id`).",{"_3626":2026,"_31190":1982,"_21615":57254,"_5":14871,"_28382":57142,"_3078":57255},[],"Issuance through a DMS",{"_3626":2027,"_31190":1982,"_21615":57257,"_5":14871,"_28382":57142,"_3078":57258},[],"`settings.issuance_profile_id`",{"_3626":2028,"_31190":1982,"_21615":57260,"_5":14871,"_28382":57142,"_3078":57261},[],"`settings.issuance_profile` embedded in the DMS",{"_3626":2029,"_31190":1982,"_21615":57263,"_5":14871,"_28382":57142,"_3078":57264},[],"Enrollment CA default profile.",{"_3626":2030,"_31190":1982,"_21615":57266,"_5":14871,"_28382":57142,"_3078":57267},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3626":2031,"_31190":1982,"_21615":57269,"_5":14871,"_28382":57142,"_3078":57270},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3626":2032,"_31190":1982,"_21615":57272,"_5":14871,"_28382":57150,"_3078":57273},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3626":2033,"_31190":1982,"_21615":57275,"_5":14871,"_28382":57154,"_3078":57276},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3626":2034,"_31190":1982,"_21615":57278,"_5":14871,"_28382":57158,"_3078":57279},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3626":2035,"_31190":1982,"_21615":57281,"_5":14871,"_28382":57162,"_3078":57282},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3626":2036,"_31190":1982,"_21615":57284,"_5":14871,"_28382":57166,"_3078":57285},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3626":2037,"_31190":1982,"_21615":57287,"_5":14871,"_28382":57166,"_3078":57288},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3626":2038,"_31190":1982,"_21615":57290,"_5":14871,"_28382":57170,"_3078":57291},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3626":2039,"_31190":1982,"_21615":57293,"_5":14871,"_28382":57170,"_3078":57294},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3626":2040,"_31190":1982,"_21615":57296,"_5":14871,"_28382":57170,"_3078":57297},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3626":2041,"_31190":1982,"_21615":57299,"_5":14871,"_28382":57170,"_3078":57300},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3626":2042,"_31190":1982,"_21615":57302,"_5":14871,"_28382":57174,"_3078":57303},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3626":2043,"_31190":1982,"_21615":57305,"_5":14871,"_28382":57174,"_3078":57306},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3626":2044,"_31190":2044,"_5":15231,"_3078":57308,"_31548":57309,"_21615":57311,"_28382":2044},"Certificate validation",[50967,52479,56659,57310],"Validation",[],{"_3626":2045,"_31190":2044,"_21615":57313,"_5":14871,"_28382":2044,"_3078":57314},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3626":2046,"_31190":2044,"_5":31545,"_21615":57316,"_28382":57317,"_3078":57318},[],"/docs/pr-preview/pr-77/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3626":2047,"_31190":2044,"_5":31545,"_21615":57320,"_28382":57321,"_3078":57322},[],"/docs/pr-preview/pr-77/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3626":2048,"_31190":2044,"_5":31545,"_21615":57324,"_28382":57325,"_3078":57326},[],"/docs/pr-preview/pr-77/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3626":2049,"_31190":2044,"_21615":57328,"_5":14871,"_28382":2044,"_3078":57329},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3626":2050,"_31190":2044,"_21615":57331,"_5":14871,"_28382":57317,"_3078":57332},[],"Verify these criteria together:",{"_3626":2051,"_31190":2044,"_21615":57334,"_5":14871,"_28382":57317,"_3078":56285},[],{"_3626":2052,"_31190":2044,"_21615":57336,"_5":14871,"_28382":57317,"_3078":57337},[],"Required result",{"_3626":2053,"_31190":2044,"_21615":57339,"_5":14871,"_28382":57317,"_3078":57340},[],"Chain and signature",{"_3626":2054,"_31190":2044,"_21615":57342,"_5":14871,"_28382":57317,"_3078":57343},[],"Valid chain to a root deliberately installed in the consumer.",{"_3626":2055,"_31190":2044,"_21615":57345,"_5":14871,"_28382":57317,"_3078":57346},[],"Dates",{"_3626":2056,"_31190":2044,"_21615":57348,"_5":14871,"_28382":57317,"_3078":57349},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3626":2057,"_31190":2044,"_21615":57351,"_5":14871,"_28382":57317,"_3078":52148},[],{"_3626":2058,"_31190":2044,"_21615":57353,"_5":14871,"_28382":57317,"_3078":57354},[],"Name, SAN or identifier matches the expected peer.",{"_3626":2059,"_31190":2044,"_21615":57356,"_5":14871,"_28382":57317,"_3078":51357},[],{"_3626":2060,"_31190":2044,"_21615":57358,"_5":14871,"_28382":57317,"_3078":57359},[],"KU, EKU and constraints permit the specific operation.",{"_3626":2061,"_31190":2044,"_21615":57361,"_5":14871,"_28382":57317,"_3078":57362},[],"Revocation",{"_3626":2062,"_31190":2044,"_21615":57364,"_5":14871,"_28382":57317,"_3078":57365},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3626":2063,"_31190":2044,"_21615":57367,"_5":14871,"_28382":57317,"_3078":57368},[],"Authorization",{"_3626":2064,"_31190":2044,"_21615":57370,"_5":14871,"_28382":57317,"_3078":57371},[],"The application permits that identity to perform the action.",{"_3626":2065,"_31190":2044,"_21615":57373,"_5":14871,"_28382":57317,"_3078":57374},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3626":2066,"_31190":2044,"_21615":57376,"_5":14871,"_28382":57321,"_3078":57377},[],"Mechanism",{"_3626":2067,"_31190":2044,"_21615":57379,"_5":14871,"_28382":57321,"_3078":57380},[],"When to use it",{"_3626":2068,"_31190":2044,"_21615":57382,"_5":14871,"_28382":57321,"_3078":57383},[],"What you must maintain",{"_3626":2069,"_31190":2044,"_21615":57385,"_5":14871,"_28382":57321,"_3078":57386},[],"OCSP",{"_3626":2070,"_31190":2044,"_21615":57388,"_5":14871,"_28382":57321,"_3078":57389},[],"Status query for a specific certificate.",{"_3626":2071,"_31190":2044,"_21615":57391,"_5":14871,"_28382":57321,"_3078":57392},[],"Responder access, signature verification and cache/freshness policy.",{"_3626":2072,"_31190":2044,"_21615":57394,"_5":14871,"_28382":57321,"_3078":57395},[],"CRL",{"_3626":2073,"_31190":2044,"_21615":57397,"_5":14871,"_28382":57321,"_3078":57398},[],"Local checks for many certificates or offline operation.",{"_3626":2074,"_31190":2044,"_21615":57400,"_5":14871,"_28382":57321,"_3078":57401},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3626":2075,"_31190":2044,"_21615":57403,"_5":14871,"_28382":57321,"_3078":57404},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3626":2076,"_31190":2044,"_21615":57406,"_5":14871,"_28382":57321,"_3078":57407},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3626":2077,"_31190":2044,"_21615":57409,"_5":14871,"_28382":57325,"_3078":57410},[],"Accept a current, authorized certificate with a known chain.",{"_3626":2078,"_31190":2044,"_21615":57412,"_5":14871,"_28382":57325,"_3078":57413},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3626":2079,"_31190":2044,"_21615":57415,"_5":14871,"_28382":57325,"_3078":57416},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3626":2080,"_31190":2044,"_21615":57418,"_5":14871,"_28382":57325,"_3078":57419},[],"Check that a new connection with that identity is rejected.",{"_3626":2081,"_31190":2044,"_21615":57421,"_5":14871,"_28382":57325,"_3078":57422},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3626":2082,"_31190":2044,"_21615":57424,"_5":14871,"_28382":57325,"_3078":57425},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3626":2083,"_31190":2044,"_21615":57427,"_5":14871,"_28382":57325,"_3078":57428},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3626":2084,"_31190":2044,"_21615":57430,"_5":14871,"_28382":57325,"_3078":57431},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3626":2085,"_31190":2044,"_21615":57433,"_5":14871,"_28382":57325,"_3078":57434},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3626":2086,"_31190":2086,"_5":15231,"_3078":57436,"_31548":57437,"_21615":57438,"_28382":2086},"Certificates",[50967,52479,56659,56660],[],{"_3626":2087,"_31190":2086,"_21615":57440,"_5":14871,"_28382":2086,"_3078":57441},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3626":2088,"_31190":2086,"_5":31545,"_21615":57443,"_28382":57444,"_3078":57445},[],"/docs/pr-preview/pr-77/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3626":2089,"_31190":2086,"_5":31545,"_21615":57447,"_28382":57448,"_3078":57449},[],"/docs/pr-preview/pr-77/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3626":2090,"_31190":2086,"_5":31545,"_21615":57451,"_28382":57452,"_3078":57453},[],"/docs/pr-preview/pr-77/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3626":2091,"_31190":2086,"_5":31545,"_21615":57455,"_28382":57456,"_3078":57457},[],"/docs/pr-preview/pr-77/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3626":2092,"_31190":2086,"_5":31545,"_21615":57459,"_28382":57460,"_3078":57461},[],"/docs/pr-preview/pr-77/platform/pki/certificates#open-the-action","Open the action",{"_3626":2093,"_31190":2086,"_5":31545,"_21615":57463,"_28382":57464,"_3078":57465},[],"/docs/pr-preview/pr-77/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3626":2094,"_31190":2086,"_5":31545,"_21615":57467,"_28382":57468,"_3078":57469},[],"/docs/pr-preview/pr-77/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3626":2095,"_31190":2086,"_5":31545,"_21615":57471,"_28382":57472,"_3078":57473},[],"/docs/pr-preview/pr-77/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3626":2096,"_31190":2086,"_5":31545,"_21615":57475,"_28382":57476,"_3078":57477},[],"/docs/pr-preview/pr-77/platform/pki/certificates#continue","Continue",{"_3626":2097,"_31190":2086,"_21615":57479,"_5":14871,"_28382":2086,"_3078":57480},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3626":2098,"_31190":2086,"_21615":57482,"_5":14871,"_28382":57444,"_3078":57483},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3626":2099,"_31190":2086,"_21615":57485,"_5":14871,"_28382":57444,"_3078":57486},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3626":2100,"_31190":2086,"_21615":57488,"_5":14871,"_28382":57444,"_3078":57489},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3626":2101,"_31190":2086,"_21615":57491,"_5":14871,"_28382":57444,"_3078":57492},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3626":2102,"_31190":2086,"_21615":57494,"_5":14871,"_28382":57444,"_3078":57495},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3626":2103,"_31190":2086,"_21615":57497,"_5":14871,"_28382":57444,"_3078":57498},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3626":2104,"_31190":2086,"_21615":57500,"_5":14871,"_28382":57444,"_3078":57501},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3626":2105,"_31190":2086,"_21615":57503,"_5":14871,"_28382":57448,"_3078":57504},[],"Download the PEM and inspect it:",{"_3626":2106,"_31190":2086,"_21615":57506,"_5":14871,"_28382":57448,"_3078":57507},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3626":2107,"_31190":2086,"_21615":57509,"_5":14871,"_28382":57452,"_3078":57510},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3626":2108,"_31190":2086,"_21615":57512,"_5":14871,"_28382":57452,"_3078":57513},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3626":2109,"_31190":2086,"_21615":57515,"_5":14871,"_28382":57452,"_3078":57516},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3626":2110,"_31190":2086,"_21615":57518,"_5":14871,"_28382":57452,"_3078":57519},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3626":2111,"_31190":2086,"_21615":57521,"_5":14871,"_28382":57452,"_3078":57522},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3626":2112,"_31190":2086,"_21615":57524,"_5":14871,"_28382":57452,"_3078":57525},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3626":2113,"_31190":2086,"_21615":57527,"_5":14871,"_28382":57452,"_3078":57528},[],"For browser key generation, follow Issue your first certificate.",{"_3626":2114,"_31190":2086,"_21615":57530,"_5":14871,"_28382":57456,"_3078":57531},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3626":2115,"_31190":2086,"_21615":57533,"_5":14871,"_28382":57460,"_3078":57534},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3626":2116,"_31190":2086,"_21615":57536,"_5":14871,"_28382":57464,"_3078":57537},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3626":2117,"_31190":2086,"_21615":57539,"_5":14871,"_28382":57468,"_3078":57540},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3626":2118,"_31190":2086,"_21615":57542,"_5":14871,"_28382":57468,"_3078":57543},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3626":2119,"_31190":2086,"_21615":57545,"_5":14871,"_28382":57468,"_3078":57546},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3626":2120,"_31190":2086,"_21615":57548,"_5":14871,"_28382":57472,"_3078":57549},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3626":2121,"_31190":2086,"_21615":57551,"_5":14871,"_28382":57472,"_3078":57552},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3626":2122,"_31190":2086,"_21615":57554,"_5":14871,"_28382":57472,"_3078":57555},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3626":2123,"_31190":2086,"_21615":57557,"_5":14871,"_28382":57476,"_3078":57558},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3626":2124,"_31190":2086,"_21615":57560,"_5":14871,"_28382":57476,"_3078":57561},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3626":2125,"_31190":2125,"_5":15231,"_3078":57563,"_31548":57564,"_21615":57566,"_28382":2125},"Certificate lifecycle",[50967,52479,56659,57565],"Concepts",[],{"_3626":2126,"_31190":2125,"_21615":57568,"_5":14871,"_28382":2125,"_3078":57569},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3626":2127,"_31190":2125,"_5":31545,"_21615":57571,"_28382":57572,"_3078":57573},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3626":2128,"_31190":2125,"_5":31545,"_21615":57575,"_28382":57576,"_3078":57577},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3626":2129,"_31190":2125,"_5":31545,"_21615":57579,"_28382":57580,"_3078":57581},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3626":2130,"_31190":2125,"_5":31545,"_21615":57583,"_28382":57584,"_3078":57585},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3626":2131,"_31190":2125,"_5":31545,"_21615":57587,"_28382":57588,"_3078":57589},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3626":2132,"_31190":2125,"_5":31545,"_21615":57591,"_28382":57592,"_3078":57593},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3626":2133,"_31190":2125,"_5":31545,"_21615":57595,"_28382":57596,"_3078":57597},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3626":2134,"_31190":2125,"_5":31545,"_21615":57599,"_28382":57600,"_3078":57601},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3626":2135,"_31190":2125,"_5":31545,"_21615":57603,"_28382":57604,"_3078":57605},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3626":2136,"_31190":2125,"_5":31545,"_21615":57607,"_28382":57608,"_3078":57609},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3626":2137,"_31190":2125,"_21615":57611,"_5":14871,"_28382":2125,"_3078":57612},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3626":2138,"_31190":2125,"_21615":57614,"_5":14871,"_28382":57576,"_3078":57615},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3626":2139,"_31190":2125,"_21615":57617,"_5":14871,"_28382":57580,"_3078":57618},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3626":2140,"_31190":2125,"_21615":57620,"_5":14871,"_28382":57584,"_3078":57621},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3626":2141,"_31190":2125,"_21615":57623,"_5":14871,"_28382":57588,"_3078":57624},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3626":2142,"_31190":2125,"_21615":57626,"_5":14871,"_28382":57592,"_3078":57627},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3626":2143,"_31190":2125,"_21615":57629,"_5":14871,"_28382":57596,"_3078":57630},[],"Lamassu persists four X.509 states:",{"_3626":2144,"_31190":2125,"_21615":57632,"_5":14871,"_28382":57596,"_3078":57633},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3626":2145,"_31190":2125,"_21615":57635,"_5":14871,"_28382":57596,"_3078":57636},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3626":2146,"_31190":2125,"_21615":57638,"_5":14871,"_28382":57596,"_3078":57639},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3626":2147,"_31190":2125,"_21615":57641,"_5":14871,"_28382":57596,"_3078":57642},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3626":2148,"_31190":2125,"_21615":57644,"_5":14871,"_28382":57596,"_3078":57645},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3626":2149,"_31190":2125,"_21615":57647,"_5":14871,"_28382":57600,"_3078":57648},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3626":2150,"_31190":2125,"_21615":57650,"_5":14871,"_28382":57600,"_3078":57651},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3626":2151,"_31190":2125,"_21615":57653,"_5":14871,"_28382":57600,"_3078":57654},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3626":2152,"_31190":2125,"_21615":57656,"_5":14871,"_28382":57604,"_3078":57657},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3626":2153,"_31190":2125,"_21615":57659,"_5":14871,"_28382":57604,"_3078":57660},[],"Before confirming:",{"_3626":2154,"_31190":2125,"_21615":57662,"_5":14871,"_28382":57604,"_3078":57663},[],"Identify DMSs, devices and services that trust that chain.",{"_3626":2155,"_31190":2125,"_21615":57665,"_5":14871,"_28382":57604,"_3078":57666},[],"Distribute the new chain of trust.",{"_3626":2156,"_31190":2125,"_21615":57668,"_5":14871,"_28382":57604,"_3078":57669},[],"Reissue the necessary identities.",{"_3626":2157,"_31190":2125,"_21615":57671,"_5":14871,"_28382":57604,"_3078":57672},[],"Check OCSP and CRL from a real consumer.",{"_3626":2158,"_31190":2125,"_21615":57674,"_5":14871,"_28382":57604,"_3078":57675},[],"Revoke the old CA once no legitimate traffic remains.",{"_3626":2159,"_31190":2125,"_21615":57677,"_5":14871,"_28382":57604,"_3078":57678},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3626":2160,"_31190":2125,"_21615":57680,"_5":14871,"_28382":57608,"_3078":57681},[],"Certificates entering the preventive or critical renewal window.",{"_3626":2161,"_31190":2125,"_21615":57683,"_5":14871,"_28382":57608,"_3078":57684},[],"Repeated enrollment or re-enrollment failures.",{"_3626":2162,"_31190":2125,"_21615":57686,"_5":14871,"_28382":57608,"_3078":57687},[],"Status changes and revocation reasons.",{"_3626":2163,"_31190":2125,"_21615":57689,"_5":14871,"_28382":57608,"_3078":57690},[],"OCSP and CRL publication and validity.",{"_3626":2164,"_31190":2125,"_21615":57692,"_5":14871,"_28382":57608,"_3078":57693},[],"Dependencies still presenting a replaced certificate.",{"_3626":2165,"_31190":2125,"_21615":57695,"_5":14871,"_28382":57608,"_3078":57696},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3626":2166,"_31190":2166,"_5":15231,"_3078":57698,"_31548":57699,"_21615":57700,"_28382":2166},"Trust model",[50967,52479,56659,57565],[],{"_3626":2167,"_31190":2166,"_21615":57702,"_5":14871,"_28382":2166,"_3078":57703},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3626":2168,"_31190":2166,"_5":31545,"_21615":57705,"_28382":57706,"_3078":57707},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3626":2169,"_31190":2166,"_5":31545,"_21615":57709,"_28382":57710,"_3078":57711},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3626":2170,"_31190":2166,"_5":31545,"_21615":57713,"_28382":57714,"_3078":57715},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3626":2171,"_31190":2166,"_5":31545,"_21615":57717,"_28382":57718,"_3078":57719},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3626":2172,"_31190":2166,"_5":31545,"_21615":57721,"_28382":57722,"_3078":57723},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3626":2173,"_31190":2166,"_5":31545,"_21615":57725,"_28382":57726,"_3078":57727},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3626":2174,"_31190":2166,"_5":31545,"_21615":57729,"_28382":57730,"_3078":57731},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3626":2175,"_31190":2166,"_5":31545,"_21615":57733,"_28382":57734,"_3078":57735},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3626":2176,"_31190":2166,"_5":31545,"_21615":57737,"_28382":57738,"_3078":57739},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3626":2177,"_31190":2166,"_5":31545,"_21615":57741,"_28382":57742,"_3078":57743},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3626":2178,"_31190":2166,"_21615":57745,"_5":14871,"_28382":2166,"_3078":57746},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3626":2179,"_31190":2166,"_21615":57748,"_5":14871,"_28382":57710,"_3078":57749},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3626":2180,"_31190":2166,"_21615":57751,"_5":14871,"_28382":57714,"_3078":57752},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3626":2181,"_31190":2166,"_21615":57754,"_5":14871,"_28382":57718,"_3078":57755},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3626":2182,"_31190":2166,"_21615":57757,"_5":14871,"_28382":57722,"_3078":57758},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3626":2183,"_31190":2166,"_21615":57760,"_5":14871,"_28382":57726,"_3078":57761},[],"The device proves it can enroll according to the DMS policy.",{"_3626":2184,"_31190":2166,"_21615":57763,"_5":14871,"_28382":57726,"_3078":57764},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3626":2185,"_31190":2166,"_21615":57766,"_5":14871,"_28382":57726,"_3078":57767},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3626":2186,"_31190":2166,"_21615":57769,"_5":14871,"_28382":57726,"_3078":57770},[],"The device installs the certificate and the chain it needs.",{"_3626":2187,"_31190":2166,"_21615":57772,"_5":14871,"_28382":57726,"_3078":57773},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3626":2188,"_31190":2166,"_21615":57775,"_5":14871,"_28382":57726,"_3078":57776},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3626":2189,"_31190":2166,"_21615":57778,"_5":14871,"_28382":57730,"_3078":57779},[],"A DMS relates three sets that are worth designing separately:",{"_3626":2190,"_31190":2166,"_21615":57781,"_5":14871,"_28382":57730,"_3078":57782},[],"**Enrollment CA:** signs the new identities.",{"_3626":2191,"_31190":2166,"_21615":57784,"_5":14871,"_28382":57730,"_3078":57785},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3626":2192,"_31190":2166,"_21615":57787,"_5":14871,"_28382":57730,"_3078":57788},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3626":2193,"_31190":2166,"_21615":57790,"_5":14871,"_28382":57730,"_3078":57791},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3626":2194,"_31190":2166,"_21615":57793,"_5":14871,"_28382":57734,"_3078":57794},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3626":2195,"_31190":2166,"_21615":57796,"_5":14871,"_28382":57734,"_3078":57797},[],"that the current date is between `Not Before` and `Not After`;",{"_3626":2196,"_31190":2166,"_21615":57799,"_5":14871,"_28382":57734,"_3078":57800},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3626":2197,"_31190":2166,"_21615":57802,"_5":14871,"_28382":57734,"_3078":57803},[],"that names, SANs and subject match the expected identity;",{"_3626":2198,"_31190":2166,"_21615":57805,"_5":14871,"_28382":57734,"_3078":57806},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3626":2199,"_31190":2166,"_21615":57808,"_5":14871,"_28382":57734,"_3078":57809},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3626":2200,"_31190":2166,"_21615":57811,"_5":14871,"_28382":57734,"_3078":57812},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3626":2201,"_31190":2166,"_21615":57814,"_5":14871,"_28382":57738,"_3078":57815},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3626":2202,"_31190":2166,"_21615":57817,"_5":14871,"_28382":57742,"_3078":57818},[],"Keep the root out of daily operations, or with very restricted access.",{"_3626":2203,"_31190":2166,"_21615":57820,"_5":14871,"_28382":57742,"_3078":57821},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3626":2204,"_31190":2166,"_21615":57823,"_5":14871,"_28382":57742,"_3078":57824},[],"Assign explicit profiles to every use case.",{"_3626":2205,"_31190":2166,"_21615":57826,"_5":14871,"_28382":57742,"_3078":57827},[],"Distribute the new trust before starting a rotation.",{"_3626":2206,"_31190":2166,"_21615":57829,"_5":14871,"_28382":57742,"_3078":57830},[],"Keep enough overlap to renew a disconnected fleet.",{"_3626":2207,"_31190":2166,"_21615":57832,"_5":14871,"_28382":57742,"_3078":57833},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3626":2208,"_31190":2166,"_21615":57835,"_5":14871,"_28382":57742,"_3078":57836},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3626":2209,"_31190":2209,"_5":15231,"_3078":57838,"_31548":57839,"_21615":57840,"_28382":2209},"Revocation lists (CRL)",[50967,52479,56659,57310],[],{"_3626":2210,"_31190":2209,"_21615":57842,"_5":14871,"_28382":2209,"_3078":57843},[],"Generate and distribute signed lists to validate certificates offline.",{"_3626":2211,"_31190":2209,"_5":31545,"_21615":57845,"_28382":57846,"_3078":57847},[],"/docs/pr-preview/pr-77/platform/pki/crl#crl-settings","CRL settings",{"_3626":2212,"_31190":2209,"_5":31545,"_21615":57849,"_28382":57850,"_3078":57851},[],"/docs/pr-preview/pr-77/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3626":2213,"_31190":2209,"_5":31545,"_21615":57853,"_28382":57854,"_3078":57855},[],"/docs/pr-preview/pr-77/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3626":2214,"_31190":2209,"_5":31545,"_21615":57857,"_28382":57858,"_3078":57859},[],"/docs/pr-preview/pr-77/platform/pki/crl#crl-contents","CRL contents",{"_3626":2215,"_31190":2209,"_5":31545,"_21615":57861,"_28382":57862,"_3078":57863},[],"/docs/pr-preview/pr-77/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3626":2216,"_31190":2209,"_5":31545,"_21615":57865,"_28382":57866,"_3078":57867},[],"/docs/pr-preview/pr-77/platform/pki/crl#crl-settings-api","CRL settings API",{"_3626":2217,"_31190":2209,"_5":31545,"_21615":57869,"_28382":57870,"_3078":57871},[],"/docs/pr-preview/pr-77/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3626":2218,"_31190":2209,"_5":31545,"_21615":57873,"_28382":57874,"_3078":57875},[],"/docs/pr-preview/pr-77/platform/pki/crl#references","References",{"_3626":2219,"_31190":2209,"_21615":57877,"_5":14871,"_28382":2209,"_3078":57878},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3626":2220,"_31190":2209,"_21615":57880,"_5":14871,"_28382":57846,"_3078":57881},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3626":2221,"_31190":2209,"_21615":57883,"_5":14871,"_28382":57846,"_3078":57884},[],"Field",{"_3626":2222,"_31190":2209,"_21615":57886,"_5":14871,"_28382":57846,"_3078":51357},[],{"_3626":2223,"_31190":2209,"_21615":57888,"_5":14871,"_28382":57846,"_3078":52599},[],{"_3626":2224,"_31190":2209,"_21615":57890,"_5":14871,"_28382":57846,"_3078":57891},[],"ID of the CA the settings belong to.",{"_3626":2225,"_31190":2209,"_21615":57893,"_5":14871,"_28382":57846,"_3078":57894},[],"`status`",{"_3626":2226,"_31190":2209,"_21615":57896,"_5":14871,"_28382":57846,"_3078":57897},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3626":2227,"_31190":2209,"_21615":57899,"_5":14871,"_28382":57846,"_3078":57900},[],"`legacy_ski`",{"_3626":2228,"_31190":2209,"_21615":57902,"_5":14871,"_28382":57846,"_3078":57903},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3626":2229,"_31190":2209,"_21615":57905,"_5":14871,"_28382":57846,"_3078":57906},[],"`latest_crl`",{"_3626":2230,"_31190":2209,"_21615":57908,"_5":14871,"_28382":57846,"_3078":57909},[],"Version, validity start and end of the last published list. Read-only.",{"_3626":2231,"_31190":2209,"_21615":57911,"_5":14871,"_28382":57846,"_3078":57912},[],"`crl_options` field",{"_3626":2232,"_31190":2209,"_21615":57914,"_5":14871,"_28382":57846,"_3078":51357},[],{"_3626":2233,"_31190":2209,"_21615":57916,"_5":14871,"_28382":57846,"_3078":57917},[],"Initial value",{"_3626":2234,"_31190":2209,"_21615":57919,"_5":14871,"_28382":57846,"_3078":57920},[],"`validity`",{"_3626":2235,"_31190":2209,"_21615":57922,"_5":14871,"_28382":57846,"_3078":57923},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3626":2236,"_31190":2209,"_21615":57925,"_5":14871,"_28382":57846,"_3078":57926},[],"7 days.",{"_3626":2237,"_31190":2209,"_21615":57928,"_5":14871,"_28382":57846,"_3078":57929},[],"`refresh_interval`",{"_3626":2238,"_31190":2209,"_21615":57931,"_5":14871,"_28382":57846,"_3078":57932},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3626":2239,"_31190":2209,"_21615":57934,"_5":14871,"_28382":57846,"_3078":57935},[],"6 days and 23 hours.",{"_3626":2240,"_31190":2209,"_21615":57937,"_5":14871,"_28382":57846,"_3078":57938},[],"`regenerate_on_revoke`",{"_3626":2241,"_31190":2209,"_21615":57940,"_5":14871,"_28382":57846,"_3078":57941},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3626":2242,"_31190":2209,"_21615":57943,"_5":14871,"_28382":57846,"_3078":57944},[],"`true`.",{"_3626":2243,"_31190":2209,"_21615":57946,"_5":14871,"_28382":57846,"_3078":57947},[],"`signer_serial_number`",{"_3626":2244,"_31190":2209,"_21615":57949,"_5":14871,"_28382":57846,"_3078":57950},[],"Serial number of the existing certificate that signs the CRL.",{"_3626":2245,"_31190":2209,"_21615":57952,"_5":14871,"_28382":57846,"_3078":57953},[],"Serial number of the CA’s current certificate.",{"_3626":2246,"_31190":2209,"_21615":57955,"_5":14871,"_28382":57846,"_3078":57956},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3626":2247,"_31190":2209,"_21615":57958,"_5":14871,"_28382":57846,"_3078":57959},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3626":2248,"_31190":2209,"_21615":57961,"_5":14871,"_28382":57846,"_3078":57962},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3626":2249,"_31190":2209,"_21615":57964,"_5":14871,"_28382":57846,"_3078":57965},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3626":2250,"_31190":2209,"_21615":57967,"_5":14871,"_28382":57846,"_3078":57968},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3626":2251,"_31190":2209,"_21615":57970,"_5":14871,"_28382":57846,"_3078":57971},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3626":2252,"_31190":2209,"_21615":57973,"_5":14871,"_28382":57846,"_3078":57974},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3626":2253,"_31190":2209,"_21615":57976,"_5":14871,"_28382":57846,"_3078":57977},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3626":2254,"_31190":2209,"_21615":57979,"_5":14871,"_28382":57846,"_3078":57980},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3626":2255,"_31190":2209,"_21615":57982,"_5":14871,"_28382":57846,"_3078":57983},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3626":2256,"_31190":2209,"_21615":57985,"_5":14871,"_28382":57846,"_3078":57986},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3626":2257,"_31190":2209,"_21615":57988,"_5":14871,"_28382":57850,"_3078":57989},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3626":2258,"_31190":2209,"_21615":57991,"_5":14871,"_28382":57850,"_3078":57992},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3626":2259,"_31190":2209,"_21615":57994,"_5":14871,"_28382":57850,"_3078":57995},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3626":2260,"_31190":2209,"_21615":57997,"_5":14871,"_28382":57850,"_3078":57998},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3626":2261,"_31190":2209,"_21615":58000,"_5":14871,"_28382":57854,"_3078":58001},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3626":2262,"_31190":2209,"_21615":58003,"_5":14871,"_28382":57854,"_3078":58004},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3626":2263,"_31190":2209,"_21615":58006,"_5":14871,"_28382":57854,"_3078":58007},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3626":2264,"_31190":2209,"_21615":58009,"_5":14871,"_28382":57854,"_3078":58010},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3626":2265,"_31190":2209,"_21615":58012,"_5":14871,"_28382":57854,"_3078":58013},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3626":2266,"_31190":2209,"_21615":58015,"_5":14871,"_28382":57854,"_3078":58016},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3626":2267,"_31190":2209,"_21615":58018,"_5":14871,"_28382":57854,"_3078":58019},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3626":2268,"_31190":2209,"_21615":58021,"_5":14871,"_28382":57854,"_3078":58022},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3626":2269,"_31190":2209,"_21615":58024,"_5":14871,"_28382":57854,"_3078":58025},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3626":2270,"_31190":2209,"_21615":58027,"_5":14871,"_28382":57858,"_3078":58028},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3626":2271,"_31190":2209,"_21615":58030,"_5":14871,"_28382":57858,"_3078":58031},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3626":2272,"_31190":2209,"_21615":58033,"_5":14871,"_28382":57862,"_3078":58034},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3626":2273,"_31190":2209,"_21615":58036,"_5":14871,"_28382":57862,"_3078":58037},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3626":2274,"_31190":2209,"_21615":58039,"_5":14871,"_28382":57862,"_3078":58040},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3626":2275,"_31190":2209,"_21615":58042,"_5":14871,"_28382":57862,"_3078":58043},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3626":2276,"_31190":2209,"_21615":58045,"_5":14871,"_28382":57862,"_3078":58046},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3626":2277,"_31190":2209,"_21615":58048,"_5":14871,"_28382":57866,"_3078":58049},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3626":2278,"_31190":2209,"_21615":58051,"_5":14871,"_28382":57866,"_3078":54425},[],{"_3626":2279,"_31190":2209,"_21615":58053,"_5":14871,"_28382":57866,"_3078":58054},[],"Relative path",{"_3626":2280,"_31190":2209,"_21615":58056,"_5":14871,"_28382":57866,"_3078":54422},[],{"_3626":2281,"_31190":2209,"_21615":58058,"_5":14871,"_28382":57866,"_3078":58059},[],"`GET`",{"_3626":2282,"_31190":2209,"_21615":58061,"_5":14871,"_28382":57866,"_3078":58062},[],"`/v1/crl-settings`",{"_3626":2283,"_31190":2209,"_21615":58064,"_5":14871,"_28382":57866,"_3078":58065},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3626":2284,"_31190":2209,"_21615":58067,"_5":14871,"_28382":57866,"_3078":58059},[],{"_3626":2285,"_31190":2209,"_21615":58069,"_5":14871,"_28382":57866,"_3078":58070},[],"`/v1/crl-settings/{ca-id}`",{"_3626":2286,"_31190":2209,"_21615":58072,"_5":14871,"_28382":57866,"_3078":58073},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3626":2287,"_31190":2209,"_21615":58075,"_5":14871,"_28382":57866,"_3078":58076},[],"`PUT`",{"_3626":2288,"_31190":2209,"_21615":58078,"_5":14871,"_28382":57866,"_3078":58070},[],{"_3626":2289,"_31190":2209,"_21615":58080,"_5":14871,"_28382":57866,"_3078":58081},[],"Replace the CRL configuration of a CA.",{"_3626":2290,"_31190":2209,"_21615":58083,"_5":14871,"_28382":57866,"_3078":58084},[],"`DELETE`",{"_3626":2291,"_31190":2209,"_21615":58086,"_5":14871,"_28382":57866,"_3078":58070},[],{"_3626":2292,"_31190":2209,"_21615":58088,"_5":14871,"_28382":57866,"_3078":58089},[],"Remove the archived CRL settings of a CA.",{"_3626":2293,"_31190":2209,"_21615":58091,"_5":14871,"_28382":57866,"_3078":58092},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3626":2294,"_31190":2209,"_21615":58094,"_5":14871,"_28382":57866,"_3078":58095},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3626":2295,"_31190":2209,"_21615":58097,"_5":14871,"_28382":57866,"_3078":58098},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3626":2296,"_31190":2209,"_21615":58100,"_5":14871,"_28382":57870,"_3078":58101},[],"Symptom",{"_3626":2297,"_31190":2209,"_21615":58103,"_5":14871,"_28382":57870,"_3078":58104},[],"Cause",{"_3626":2298,"_31190":2209,"_21615":58106,"_5":14871,"_28382":57870,"_3078":58107},[],"Action",{"_3626":2299,"_31190":2209,"_21615":58109,"_5":14871,"_28382":57870,"_3078":58110},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3626":2300,"_31190":2209,"_21615":58112,"_5":14871,"_28382":57870,"_3078":58113},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3626":2301,"_31190":2209,"_21615":58115,"_5":14871,"_28382":57870,"_3078":58116},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3626":2302,"_31190":2209,"_21615":58118,"_5":14871,"_28382":57870,"_3078":58119},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3626":2303,"_31190":2209,"_21615":58121,"_5":14871,"_28382":57870,"_3078":58122},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3626":2304,"_31190":2209,"_21615":58124,"_5":14871,"_28382":57870,"_3078":58125},[],"Delete the CA first; deleting it archives its settings.",{"_3626":2305,"_31190":2209,"_21615":58127,"_5":14871,"_28382":57870,"_3078":58128},[],"`PUT` returns 400.",{"_3626":2306,"_31190":2209,"_21615":58130,"_5":14871,"_28382":57870,"_3078":58131},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3626":2307,"_31190":2209,"_21615":58133,"_5":14871,"_28382":57870,"_3078":58134},[],"Set the serial number of a valid certificate of that CA.",{"_3626":2308,"_31190":2209,"_21615":58136,"_5":14871,"_28382":57870,"_3078":58137},[],"`PUT` returns 404.",{"_3626":2309,"_31190":2209,"_21615":58139,"_5":14871,"_28382":57870,"_3078":58140},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3626":2310,"_31190":2209,"_21615":58142,"_5":14871,"_28382":57870,"_3078":58143},[],"Check the CA ID and the signer serial number.",{"_3626":2311,"_31190":2209,"_21615":58145,"_5":14871,"_28382":57870,"_3078":58146},[],"`PUT` returns 400 from a 3.x client.",{"_3626":2312,"_31190":2209,"_21615":58148,"_5":14871,"_28382":57870,"_3078":58149},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3626":2313,"_31190":2209,"_21615":58151,"_5":14871,"_28382":57870,"_3078":58152},[],"Update the client to send the new field.",{"_3626":2314,"_31190":2209,"_21615":58154,"_5":14871,"_28382":57870,"_3078":58155},[],"The CRL does not change after revoking a certificate.",{"_3626":2315,"_31190":2209,"_21615":58157,"_5":14871,"_28382":57870,"_3078":58158},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3626":2316,"_31190":2209,"_21615":58160,"_5":14871,"_28382":57870,"_3078":58161},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3626":2317,"_31190":2209,"_21615":58163,"_5":14871,"_28382":57870,"_3078":58164},[],"A verifier rejects the CRL because of the issuer.",{"_3626":2318,"_31190":2209,"_21615":58166,"_5":14871,"_28382":57870,"_3078":58167},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3626":2319,"_31190":2209,"_21615":58169,"_5":14871,"_28382":57870,"_3078":58170},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3626":2320,"_31190":2209,"_21615":58172,"_5":14871,"_28382":57874,"_3078":58173},[],"RFC 5280: X.509 and CRL profile.",{"_3626":2321,"_31190":2209,"_21615":58175,"_5":14871,"_28382":57874,"_3078":58176},[],"OpenSSL: openssl-crl.",{"_3626":2322,"_31190":2209,"_21615":58178,"_5":14871,"_28382":57874,"_3078":58179},[],"OpenSSL: openssl-verify.",{"_3626":2323,"_31190":2209,"_21615":58181,"_5":14871,"_28382":57874,"_3078":58182},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3626":2324,"_31190":2209,"_21615":58184,"_5":14871,"_28382":57874,"_3078":58185},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3626":2325,"_31190":2325,"_5":15231,"_3078":58187,"_31548":58188,"_21615":58189,"_28382":2325},"Keys and cryptographic engines",[50967,52479,56659,56660],[],{"_3626":2326,"_31190":2325,"_21615":58191,"_5":14871,"_28382":2325,"_3078":58192},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3626":2327,"_31190":2325,"_5":31545,"_21615":58194,"_28382":58195,"_3078":58196},[],"/docs/pr-preview/pr-77/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3626":2328,"_31190":2325,"_5":31545,"_21615":58198,"_28382":58199,"_3078":58200},[],"/docs/pr-preview/pr-77/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3626":2329,"_31190":2325,"_5":31545,"_21615":58202,"_28382":58203,"_3078":58204},[],"/docs/pr-preview/pr-77/platform/pki/key-management#file-system","File System",{"_3626":2330,"_31190":2325,"_5":31545,"_21615":58206,"_28382":58207,"_3078":58208},[],"/docs/pr-preview/pr-77/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3626":2331,"_31190":2325,"_5":31545,"_21615":58210,"_28382":58211,"_3078":58212},[],"/docs/pr-preview/pr-77/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3626":2332,"_31190":2325,"_5":31545,"_21615":58214,"_28382":58215,"_3078":58216},[],"/docs/pr-preview/pr-77/platform/pki/key-management#aws-kms","AWS KMS",{"_3626":2333,"_31190":2325,"_5":31545,"_21615":58218,"_28382":58219,"_3078":58220},[],"/docs/pr-preview/pr-77/platform/pki/key-management#pkcs11","PKCS#11",{"_3626":2334,"_31190":2325,"_5":31545,"_21615":58222,"_28382":58223,"_3078":58224},[],"/docs/pr-preview/pr-77/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3626":2335,"_31190":2325,"_5":31545,"_21615":58226,"_28382":58227,"_3078":58228},[],"/docs/pr-preview/pr-77/platform/pki/key-management#key-inventory","Key inventory",{"_3626":2336,"_31190":2325,"_5":31545,"_21615":58230,"_28382":58231,"_3078":58232},[],"/docs/pr-preview/pr-77/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3626":2337,"_31190":2325,"_5":31545,"_21615":58234,"_28382":58235,"_3078":58236},[],"/docs/pr-preview/pr-77/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3626":2338,"_31190":2325,"_5":31545,"_21615":58238,"_28382":58239,"_3078":58240},[],"/docs/pr-preview/pr-77/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3626":2339,"_31190":2325,"_5":31545,"_21615":58242,"_28382":58243,"_3078":58244},[],"/docs/pr-preview/pr-77/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3626":2340,"_31190":2325,"_5":31545,"_21615":58246,"_28382":58247,"_3078":58248},[],"/docs/pr-preview/pr-77/platform/pki/key-management#view-details","View details",{"_3626":2341,"_31190":2325,"_5":31545,"_21615":58250,"_28382":58251,"_3078":58252},[],"/docs/pr-preview/pr-77/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3626":2342,"_31190":2325,"_5":31545,"_21615":58254,"_28382":58255,"_3078":58256},[],"/docs/pr-preview/pr-77/platform/pki/key-management#sign","Sign",{"_3626":2343,"_31190":2325,"_5":31545,"_21615":58258,"_28382":58259,"_3078":58260},[],"/docs/pr-preview/pr-77/platform/pki/key-management#verify","Verify",{"_3626":2344,"_31190":2325,"_5":31545,"_21615":58262,"_28382":58263,"_3078":58264},[],"/docs/pr-preview/pr-77/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3626":2345,"_31190":2325,"_5":31545,"_21615":58266,"_28382":58267,"_3078":58268},[],"/docs/pr-preview/pr-77/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3626":2346,"_31190":2325,"_5":31545,"_21615":58270,"_28382":58271,"_3078":58272},[],"/docs/pr-preview/pr-77/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3626":2347,"_31190":2325,"_21615":58274,"_5":14871,"_28382":2325,"_3078":58275},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3626":2348,"_31190":2325,"_21615":58277,"_5":14871,"_28382":2325,"_3078":58278},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3626":2349,"_31190":2325,"_21615":58280,"_5":14871,"_28382":58195,"_3078":58281},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3626":2350,"_31190":2325,"_21615":58283,"_5":14871,"_28382":58195,"_3078":58284},[],"In practice, it lets you:",{"_3626":2351,"_31190":2325,"_21615":58286,"_5":14871,"_28382":58195,"_3078":58287},[],"Generate new key pairs from Lamassu IoT.",{"_3626":2352,"_31190":2325,"_21615":58289,"_5":14871,"_28382":58195,"_3078":58290},[],"Import keys created externally.",{"_3626":2353,"_31190":2325,"_21615":58292,"_5":14871,"_28382":58195,"_3078":58293},[],"Delegate custody and cryptographic operations to external engines.",{"_3626":2354,"_31190":2325,"_21615":58295,"_5":14871,"_28382":58195,"_3078":58296},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3626":2355,"_31190":2325,"_21615":58298,"_5":14871,"_28382":58199,"_3078":58299},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3626":2356,"_31190":2325,"_21615":58301,"_5":14871,"_28382":58199,"_3078":58302},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3626":2357,"_31190":2325,"_21615":58304,"_5":14871,"_28382":58199,"_3078":58305},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3626":2358,"_31190":2325,"_21615":58307,"_5":14871,"_28382":58203,"_3078":58308},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3626":2359,"_31190":2325,"_21615":58310,"_5":14871,"_28382":58207,"_3078":58311},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3626":2360,"_31190":2325,"_21615":58313,"_5":14871,"_28382":58207,"_3078":58314},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3626":2361,"_31190":2325,"_21615":58316,"_5":14871,"_28382":58211,"_3078":58317},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3626":2362,"_31190":2325,"_21615":58319,"_5":14871,"_28382":58215,"_3078":58320},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3626":2363,"_31190":2325,"_21615":58322,"_5":14871,"_28382":58219,"_3078":58323},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3626":2364,"_31190":2325,"_21615":58325,"_5":14871,"_28382":58223,"_3078":58326},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3626":2365,"_31190":2325,"_21615":58328,"_5":14871,"_28382":58223,"_3078":58329},[],"Lamassu shows the enabled engines in the console.",{"_3626":2366,"_31190":2325,"_21615":58331,"_5":14871,"_28382":58223,"_3078":58332},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3626":2367,"_31190":2325,"_21615":58334,"_5":14871,"_28382":58223,"_3078":58335},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3626":2368,"_31190":2325,"_21615":58337,"_5":14871,"_28382":58227,"_3078":58338},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3626":2369,"_31190":2325,"_21615":58340,"_5":14871,"_28382":58227,"_3078":58341},[],"The table includes the following fields:",{"_3626":2370,"_31190":2325,"_21615":58343,"_5":14871,"_28382":58227,"_3078":58344},[],"**Name**: descriptive name of the key.",{"_3626":2371,"_31190":2325,"_21615":58346,"_5":14871,"_28382":58227,"_3078":58347},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3626":2372,"_31190":2325,"_21615":58349,"_5":14871,"_28382":58227,"_3078":58350},[],"**Strength**: visual indicator of cryptographic strength.",{"_3626":2373,"_31190":2325,"_21615":58352,"_5":14871,"_28382":58227,"_3078":58353},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3626":2374,"_31190":2325,"_21615":58355,"_5":14871,"_28382":58227,"_3078":58356},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3626":2375,"_31190":2325,"_21615":58358,"_5":14871,"_28382":58227,"_3078":58359},[],"**Aliases**: alternative names associated with the key.",{"_3626":2376,"_31190":2325,"_21615":58361,"_5":14871,"_28382":58227,"_3078":58362},[],"**Tags**: labels for classification and search.",{"_3626":2377,"_31190":2325,"_21615":58364,"_5":14871,"_28382":58227,"_3078":58365},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3626":2378,"_31190":2325,"_21615":58367,"_5":14871,"_28382":58227,"_3078":58368},[],"From this view you also reach the most common actions:",{"_3626":2379,"_31190":2325,"_21615":58370,"_5":14871,"_28382":58227,"_3078":58371},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3626":2380,"_31190":2325,"_21615":58373,"_5":14871,"_28382":58227,"_3078":58374},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3626":2381,"_31190":2325,"_21615":58376,"_5":14871,"_28382":58227,"_3078":58377},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3626":2382,"_31190":2325,"_21615":58379,"_5":14871,"_28382":58227,"_3078":58380},[],"**Delete Key** to remove the key from the system.",{"_3626":2383,"_31190":2325,"_21615":58382,"_5":14871,"_28382":58231,"_3078":58383},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3626":2384,"_31190":2325,"_21615":58385,"_5":14871,"_28382":58235,"_3078":58386},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3626":2385,"_31190":2325,"_21615":58388,"_5":14871,"_28382":58235,"_3078":58389},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3626":2386,"_31190":2325,"_21615":58391,"_5":14871,"_28382":58235,"_3078":58392},[],"**Key Name**: unique and descriptive name.",{"_3626":2387,"_31190":2325,"_21615":58394,"_5":14871,"_28382":58235,"_3078":58395},[],"**Crypto Engine**: engine that will keep the key.",{"_3626":2388,"_31190":2325,"_21615":58397,"_5":14871,"_28382":58235,"_3078":58398},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3626":2389,"_31190":2325,"_21615":58400,"_5":14871,"_28382":58235,"_3078":58401},[],"**Tags**: metadata to classify the key.",{"_3626":2390,"_31190":2325,"_21615":58403,"_5":14871,"_28382":58235,"_3078":58404},[],"**Metadata**: additional information for advanced uses.",{"_3626":2391,"_31190":2325,"_21615":58406,"_5":14871,"_28382":58239,"_3078":58407},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3626":2392,"_31190":2325,"_21615":58409,"_5":14871,"_28382":58239,"_3078":58410},[],"When you have an exportable private key and the destination engine supports import.",{"_3626":2393,"_31190":2325,"_21615":58412,"_5":14871,"_28382":58239,"_3078":58413},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3626":2394,"_31190":2325,"_21615":58415,"_5":14871,"_28382":58239,"_3078":58416},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3626":2395,"_31190":2325,"_21615":58418,"_5":14871,"_28382":58239,"_3078":58419},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3626":2396,"_31190":2325,"_21615":58421,"_5":14871,"_28382":58239,"_3078":58422},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3626":2397,"_31190":2325,"_21615":58424,"_5":14871,"_28382":58239,"_3078":58425},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3626":2398,"_31190":2325,"_21615":58427,"_5":14871,"_28382":58239,"_3078":58428},[],"**Tags**: labels for organization and search.",{"_3626":2399,"_31190":2325,"_21615":58430,"_5":14871,"_28382":58239,"_3078":58431},[],"**Metadata**: additional optional information.",{"_3626":2400,"_31190":2325,"_21615":58433,"_5":14871,"_28382":58239,"_3078":58434},[],"**Private Key (PEM)**: private key in PEM format.",{"_3626":2401,"_31190":2325,"_21615":58436,"_5":14871,"_28382":58239,"_3078":58437},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3626":2402,"_31190":2325,"_21615":58439,"_5":14871,"_28382":58243,"_3078":58440},[],"Each registered key has a detail view and several operational actions.",{"_3626":2403,"_31190":2325,"_21615":58442,"_5":14871,"_28382":58247,"_3078":58443},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3626":2404,"_31190":2325,"_21615":58445,"_5":14871,"_28382":58247,"_3078":58446},[],"The **Overview** tab shows, among others, these fields:",{"_3626":2405,"_31190":2325,"_21615":58448,"_5":14871,"_28382":58247,"_3078":58449},[],"**Key Name**: descriptive name.",{"_3626":2406,"_31190":2325,"_21615":58451,"_5":14871,"_28382":58247,"_3078":58452},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3626":2407,"_31190":2325,"_21615":58454,"_5":14871,"_28382":58247,"_3078":58455},[],"**Tags**: associated labels.",{"_3626":2408,"_31190":2325,"_21615":58457,"_5":14871,"_28382":58247,"_3078":58458},[],"**Aliases**: alternative names.",{"_3626":2409,"_31190":2325,"_21615":58460,"_5":14871,"_28382":58247,"_3078":58461},[],"**Crypto Engine**: engine where the key resides.",{"_3626":2410,"_31190":2325,"_21615":58463,"_5":14871,"_28382":58247,"_3078":58464},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3626":2411,"_31190":2325,"_21615":58466,"_5":14871,"_28382":58247,"_3078":58467},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3626":2412,"_31190":2325,"_21615":58469,"_5":14871,"_28382":58247,"_3078":58470},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3626":2413,"_31190":2325,"_21615":58472,"_5":14871,"_28382":58251,"_3078":58473},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3626":2414,"_31190":2325,"_21615":58475,"_5":14871,"_28382":58251,"_3078":58476},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3626":2415,"_31190":2325,"_21615":58478,"_5":14871,"_28382":58251,"_3078":58479},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3626":2416,"_31190":2325,"_21615":58481,"_5":14871,"_28382":58255,"_3078":58482},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3626":2417,"_31190":2325,"_21615":58484,"_5":14871,"_28382":58255,"_3078":58485},[],"Main fields:",{"_3626":2418,"_31190":2325,"_21615":58487,"_5":14871,"_28382":58255,"_3078":58488},[],"**Algorithm**: signing algorithm available for the key type.",{"_3626":2419,"_31190":2325,"_21615":58490,"_5":14871,"_28382":58255,"_3078":58491},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3626":2420,"_31190":2325,"_21615":58493,"_5":14871,"_28382":58255,"_3078":58494},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3626":2421,"_31190":2325,"_21615":58496,"_5":14871,"_28382":58255,"_3078":58497},[],"**Message**: content to sign.",{"_3626":2422,"_31190":2325,"_21615":58499,"_5":14871,"_28382":58255,"_3078":58500},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3626":2423,"_31190":2325,"_21615":58502,"_5":14871,"_28382":58259,"_3078":58503},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3626":2424,"_31190":2325,"_21615":58505,"_5":14871,"_28382":58259,"_3078":58485},[],{"_3626":2425,"_31190":2325,"_21615":58507,"_5":14871,"_28382":58259,"_3078":58508},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3626":2426,"_31190":2325,"_21615":58510,"_5":14871,"_28382":58259,"_3078":58511},[],"**Message Type**: `Raw` or `Digest`.",{"_3626":2427,"_31190":2325,"_21615":58513,"_5":14871,"_28382":58259,"_3078":58514},[],"**Payload Encoding**: encoding of the message.",{"_3626":2428,"_31190":2325,"_21615":58516,"_5":14871,"_28382":58259,"_3078":58517},[],"**Message**: original message or hash.",{"_3626":2429,"_31190":2325,"_21615":58519,"_5":14871,"_28382":58259,"_3078":58520},[],"**Signature**: signature to check.",{"_3626":2430,"_31190":2325,"_21615":58522,"_5":14871,"_28382":58259,"_3078":58523},[],"**Result**: indicator of the validation result.",{"_3626":2431,"_31190":2325,"_21615":58525,"_5":14871,"_28382":58263,"_3078":58526},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3626":2432,"_31190":2325,"_21615":58528,"_5":14871,"_28382":58263,"_3078":58529},[],"This flow is useful for:",{"_3626":2433,"_31190":2325,"_21615":58531,"_5":14871,"_28382":58263,"_3078":58532},[],"Requesting certificates from an external CA.",{"_3626":2434,"_31190":2325,"_21615":58534,"_5":14871,"_28382":58263,"_3078":58535},[],"Renewing an identity while keeping the same key.",{"_3626":2435,"_31190":2325,"_21615":58537,"_5":14871,"_28382":58263,"_3078":58538},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3626":2436,"_31190":2325,"_21615":58540,"_5":14871,"_28382":58263,"_3078":58541},[],"**Common Name (CN)**: main name of the identity.",{"_3626":2437,"_31190":2325,"_21615":58543,"_5":14871,"_28382":58263,"_3078":58544},[],"**Organization (O)**: organization or company.",{"_3626":2438,"_31190":2325,"_21615":58546,"_5":14871,"_28382":58263,"_3078":58547},[],"**Organizational Unit (OU)**: department or unit.",{"_3626":2439,"_31190":2325,"_21615":58549,"_5":14871,"_28382":58263,"_3078":58550},[],"**Country (C)**: two-letter country code.",{"_3626":2440,"_31190":2325,"_21615":58552,"_5":14871,"_28382":58263,"_3078":58553},[],"**State / Province (ST)**: state or province.",{"_3626":2441,"_31190":2325,"_21615":58555,"_5":14871,"_28382":58263,"_3078":58556},[],"**Locality (L)**: city or locality.",{"_3626":2442,"_31190":2325,"_21615":58558,"_5":14871,"_28382":58263,"_3078":58559},[],"**Email Address**: contact email.",{"_3626":2443,"_31190":2325,"_21615":58561,"_5":14871,"_28382":58263,"_3078":58562},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3626":2444,"_31190":2325,"_21615":58564,"_5":14871,"_28382":58263,"_3078":58565},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3626":2445,"_31190":2325,"_21615":58567,"_5":14871,"_28382":58267,"_3078":58568},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3626":2446,"_31190":2325,"_21615":58570,"_5":14871,"_28382":58267,"_3078":58571},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3626":2447,"_31190":2325,"_21615":58573,"_5":14871,"_28382":58271,"_3078":58574},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3626":2448,"_31190":2325,"_21615":58576,"_5":14871,"_28382":58271,"_3078":58577},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3626":2449,"_31190":2449,"_5":15231,"_3078":58579,"_31548":58580,"_21615":58581,"_28382":2449},"Online validation with OCSP",[50967,52479,56659,57310],[],{"_3626":2450,"_31190":2449,"_21615":58583,"_5":14871,"_28382":2449,"_3078":58584},[],"Query signed status and verify the responder’s response.",{"_3626":2451,"_31190":2449,"_5":31545,"_21615":58586,"_28382":58587,"_3078":58588},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3626":2452,"_31190":2449,"_5":31545,"_21615":58590,"_28382":58591,"_3078":58592},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3626":2453,"_31190":2449,"_5":31545,"_21615":58594,"_28382":58595,"_3078":58596},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3626":2454,"_31190":2449,"_5":31545,"_21615":58598,"_28382":58599,"_3078":58600},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3626":2455,"_31190":2449,"_5":31545,"_21615":58602,"_28382":58603,"_3078":58604},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3626":2456,"_31190":2449,"_5":31545,"_21615":58606,"_28382":58607,"_3078":57875},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#references",{"_3626":2457,"_31190":2449,"_21615":58609,"_5":14871,"_28382":2449,"_3078":58610},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3626":2458,"_31190":2449,"_21615":58612,"_5":14871,"_28382":58587,"_3078":58613},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3626":2459,"_31190":2449,"_21615":58615,"_5":14871,"_28382":58587,"_3078":58616},[],"Record status",{"_3626":2460,"_31190":2449,"_21615":58618,"_5":14871,"_28382":58587,"_3078":58619},[],"Signed response",{"_3626":2461,"_31190":2449,"_21615":58621,"_5":14871,"_28382":58587,"_3078":55796},[],{"_3626":2462,"_31190":2449,"_21615":58623,"_5":14871,"_28382":58587,"_3078":58624},[],"`Good`.",{"_3626":2463,"_31190":2449,"_21615":58626,"_5":14871,"_28382":58587,"_3078":55813},[],{"_3626":2464,"_31190":2449,"_21615":58628,"_5":14871,"_28382":58587,"_3078":58629},[],"`Revoked`, with revocation reason and timestamp.",{"_3626":2465,"_31190":2449,"_21615":58631,"_5":14871,"_28382":58587,"_3078":58632},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3626":2466,"_31190":2449,"_21615":58634,"_5":14871,"_28382":58587,"_3078":58635},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3626":2467,"_31190":2449,"_21615":58637,"_5":14871,"_28382":58587,"_3078":58638},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3626":2468,"_31190":2449,"_21615":58640,"_5":14871,"_28382":58587,"_3078":58641},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3626":2469,"_31190":2449,"_21615":58643,"_5":14871,"_28382":58587,"_3078":58644},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3626":2470,"_31190":2449,"_21615":58646,"_5":14871,"_28382":58591,"_3078":58647},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3626":2471,"_31190":2449,"_21615":58649,"_5":14871,"_28382":58591,"_3078":58650},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3626":2472,"_31190":2449,"_21615":58652,"_5":14871,"_28382":58595,"_3078":58653},[],"The service accepts:",{"_3626":2473,"_31190":2449,"_21615":58655,"_5":14871,"_28382":58595,"_3078":54425},[],{"_3626":2474,"_31190":2449,"_21615":58657,"_5":14871,"_28382":58595,"_3078":58658},[],"VA service path",{"_3626":2475,"_31190":2449,"_21615":58660,"_5":14871,"_28382":58595,"_3078":58661},[],"Format",{"_3626":2476,"_31190":2449,"_21615":58663,"_5":14871,"_28382":58595,"_3078":58664},[],"`POST`",{"_3626":2477,"_31190":2449,"_21615":58666,"_5":14871,"_28382":58595,"_3078":58667},[],"`/ocsp`",{"_3626":2478,"_31190":2449,"_21615":58669,"_5":14871,"_28382":58595,"_3078":58670},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3626":2479,"_31190":2449,"_21615":58672,"_5":14871,"_28382":58595,"_3078":58059},[],{"_3626":2480,"_31190":2449,"_21615":58674,"_5":14871,"_28382":58595,"_3078":58675},[],"`/ocsp/{ocsp_request}`",{"_3626":2481,"_31190":2449,"_21615":58677,"_5":14871,"_28382":58595,"_3078":58678},[],"DER request encoded using padded URL Base64.",{"_3626":2482,"_31190":2449,"_21615":58680,"_5":14871,"_28382":58595,"_3078":58681},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3626":2483,"_31190":2449,"_21615":58683,"_5":14871,"_28382":58599,"_3078":58684},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3626":2484,"_31190":2449,"_21615":58686,"_5":14871,"_28382":58599,"_3078":58687},[],"Generate the request:",{"_3626":2485,"_31190":2449,"_21615":58689,"_5":14871,"_28382":58599,"_3078":58690},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3626":2486,"_31190":2449,"_21615":58692,"_5":14871,"_28382":58599,"_3078":58693},[],"Replace the example URL with the inspected endpoint:",{"_3626":2487,"_31190":2449,"_21615":58695,"_5":14871,"_28382":58599,"_3078":58696},[],"Verify the returned DER:",{"_3626":2488,"_31190":2449,"_21615":58698,"_5":14871,"_28382":58599,"_3078":58699},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3626":2489,"_31190":2449,"_21615":58701,"_5":14871,"_28382":58603,"_3078":58702},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3626":2490,"_31190":2449,"_21615":58704,"_5":14871,"_28382":58603,"_3078":58705},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3626":2491,"_31190":2449,"_21615":58707,"_5":14871,"_28382":58607,"_3078":58708},[],"RFC 6960: OCSP.",{"_3626":2492,"_31190":2449,"_21615":58710,"_5":14871,"_28382":58607,"_3078":58711},[],"OpenSSL: openssl-ocsp.",{"_3626":2493,"_31190":2449,"_21615":58713,"_5":14871,"_28382":58607,"_3078":58714},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3626":2494,"_31190":2449,"_21615":58716,"_5":14871,"_28382":58607,"_3078":58185},[],{"_3626":2495,"_31190":2495,"_5":15231,"_3078":56659,"_31548":58718,"_21615":58719,"_28382":2495},[50967,52479,56659],[],{"_3626":2496,"_31190":2495,"_21615":58721,"_5":14871,"_28382":2495,"_3078":58722},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3626":2497,"_31190":2495,"_5":31545,"_21615":58724,"_28382":58725,"_3078":55971},[],"/docs/pr-preview/pr-77/platform/pki/overview#start-here",{"_3626":2498,"_31190":2495,"_5":31545,"_21615":58727,"_28382":58728,"_3078":58729},[],"/docs/pr-preview/pr-77/platform/pki/overview#what-you-need","What you need",{"_3626":2499,"_31190":2495,"_5":31545,"_21615":58731,"_28382":58732,"_3078":56503},[],"/docs/pr-preview/pr-77/platform/pki/overview#core-capabilities",{"_3626":2500,"_31190":2495,"_5":31545,"_21615":58734,"_28382":58735,"_3078":56507},[],"/docs/pr-preview/pr-77/platform/pki/overview#build-your-trust-hierarchy",{"_3626":2501,"_31190":2495,"_5":31545,"_21615":58737,"_28382":58738,"_3078":56511},[],"/docs/pr-preview/pr-77/platform/pki/overview#protect-cryptographic-keys",{"_3626":2502,"_31190":2495,"_5":31545,"_21615":58740,"_28382":58741,"_3078":56515},[],"/docs/pr-preview/pr-77/platform/pki/overview#issue-and-control-certificates",{"_3626":2503,"_31190":2495,"_5":31545,"_21615":58743,"_28382":58744,"_3078":56523},[],"/docs/pr-preview/pr-77/platform/pki/overview#publish-validation-status",{"_3626":2504,"_31190":2495,"_5":31545,"_21615":58746,"_28382":58747,"_3078":58748},[],"/docs/pr-preview/pr-77/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3626":2505,"_31190":2495,"_5":31545,"_21615":58750,"_28382":58751,"_3078":57477},[],"/docs/pr-preview/pr-77/platform/pki/overview#continue",{"_3626":2506,"_31190":2495,"_21615":58753,"_5":14871,"_28382":2495,"_3078":58754},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3626":2507,"_31190":2495,"_21615":58756,"_5":14871,"_28382":58725,"_3078":58757},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3626":2508,"_31190":2495,"_21615":58759,"_5":14871,"_28382":58725,"_3078":58760},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3626":2509,"_31190":2495,"_21615":58762,"_5":14871,"_28382":58728,"_3078":58763},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3626":2510,"_31190":2495,"_21615":58765,"_5":14871,"_28382":58728,"_3078":58766},[],"An available cryptographic engine to keep the authority's key.",{"_3626":2511,"_31190":2495,"_21615":58768,"_5":14871,"_28382":58728,"_3078":58769},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3626":2512,"_31190":2495,"_21615":58771,"_5":14871,"_28382":58728,"_3078":58772},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3626":2513,"_31190":2495,"_21615":58774,"_5":14871,"_28382":58728,"_3078":58775},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3626":2514,"_31190":2495,"_21615":58777,"_5":14871,"_28382":58735,"_3078":58778},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3626":2515,"_31190":2495,"_21615":58780,"_5":14871,"_28382":58738,"_3078":58781},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3626":2516,"_31190":2495,"_21615":58783,"_5":14871,"_28382":58741,"_3078":58784},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3626":2517,"_31190":2495,"_21615":58786,"_5":14871,"_28382":58744,"_3078":58787},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3626":2518,"_31190":2495,"_21615":58789,"_5":14871,"_28382":58747,"_3078":58790},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3626":2519,"_31190":2495,"_21615":58792,"_5":14871,"_28382":58747,"_3078":58793},[],"its subject and extensions identify the expected client;",{"_3626":2520,"_31190":2495,"_21615":58795,"_5":14871,"_28382":58747,"_3078":58796},[],"its public key matches the client's private key;",{"_3626":2521,"_31190":2495,"_21615":58798,"_5":14871,"_28382":58747,"_3078":58799},[],"its chain reaches a root trusted by the consumer;",{"_3626":2522,"_31190":2495,"_21615":58801,"_5":14871,"_28382":58747,"_3078":58802},[],"its dates and usages allow the operation;",{"_3626":2523,"_31190":2495,"_21615":58804,"_5":14871,"_28382":58747,"_3078":58805},[],"the consumer applies revocation checks and authorization.",{"_3626":2524,"_31190":2495,"_21615":58807,"_5":14871,"_28382":58747,"_3078":58808},[],"The issuance path includes the first independent checks.",{"_3626":2525,"_31190":2495,"_21615":58810,"_5":14871,"_28382":58751,"_3078":58811},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3626":2526,"_31190":2495,"_21615":58813,"_5":14871,"_28382":58751,"_3078":58814},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3626":2527,"_31190":2495,"_21615":58816,"_5":14871,"_28382":58751,"_3078":58817},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3626":2528,"_31190":2528,"_5":15231,"_3078":58819,"_31548":58820,"_21615":58821,"_28382":2528},"Create your first CA",[50967,52479,56659,56096],[],{"_3626":2529,"_31190":2528,"_21615":58823,"_5":14871,"_28382":2528,"_3078":58824},[],"Create an evaluation root and check its certificate before issuing.",{"_3626":2530,"_31190":2528,"_5":31545,"_21615":58826,"_28382":58827,"_3078":50977},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3626":2531,"_31190":2528,"_5":31545,"_21615":58829,"_28382":58830,"_3078":58831},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3626":2532,"_31190":2528,"_5":31545,"_21615":58833,"_28382":58834,"_3078":58835},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3626":2533,"_31190":2528,"_5":31545,"_21615":58837,"_28382":58838,"_3078":58839},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3626":2534,"_31190":2528,"_5":31545,"_21615":58841,"_28382":58842,"_3078":58843},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3626":2535,"_31190":2528,"_5":31545,"_21615":58845,"_28382":58846,"_3078":58847},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3626":2536,"_31190":2528,"_5":31545,"_21615":58849,"_28382":58850,"_3078":58851},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3626":2537,"_31190":2528,"_5":31545,"_21615":58853,"_28382":58854,"_3078":56353},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3626":2538,"_31190":2528,"_5":31545,"_21615":58856,"_28382":58857,"_3078":51001},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3626":2539,"_31190":2528,"_21615":58859,"_5":14871,"_28382":2528,"_3078":58860},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3626":2540,"_31190":2528,"_21615":58862,"_5":14871,"_28382":58827,"_3078":58863},[],"Console access and permission to create keys and authorities.",{"_3626":2541,"_31190":2528,"_21615":58865,"_5":14871,"_28382":58827,"_3078":58866},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3626":2542,"_31190":2528,"_21615":58868,"_5":14871,"_28382":58827,"_3078":58869},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3626":2543,"_31190":2528,"_21615":58871,"_5":14871,"_28382":58827,"_3078":58872},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3626":2544,"_31190":2528,"_21615":58874,"_5":14871,"_28382":58830,"_3078":58875},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3626":2545,"_31190":2528,"_21615":58877,"_5":14871,"_28382":58830,"_3078":58878},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3626":2546,"_31190":2528,"_21615":58880,"_5":14871,"_28382":58834,"_3078":58881},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3626":2547,"_31190":2528,"_21615":58883,"_5":14871,"_28382":58834,"_3078":58884},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3626":2548,"_31190":2528,"_21615":58886,"_5":14871,"_28382":58838,"_3078":58887},[],"Select **Root CA** and complete:",{"_3626":2549,"_31190":2528,"_21615":58889,"_5":14871,"_28382":58838,"_3078":58890},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3626":2550,"_31190":2528,"_21615":58892,"_5":14871,"_28382":58838,"_3078":58893},[],"**Subject**: organization and country details for your evaluation.",{"_3626":2551,"_31190":2528,"_21615":58895,"_5":14871,"_28382":58838,"_3078":58896},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3626":2552,"_31190":2528,"_21615":58898,"_5":14871,"_28382":58838,"_3078":58899},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3626":2553,"_31190":2528,"_21615":58901,"_5":14871,"_28382":58838,"_3078":58902},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3626":2554,"_31190":2528,"_21615":58904,"_5":14871,"_28382":58842,"_3078":58905},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3626":2555,"_31190":2528,"_21615":58907,"_5":14871,"_28382":58846,"_3078":58908},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3626":2556,"_31190":2528,"_21615":58910,"_5":14871,"_28382":58846,"_3078":58911},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3626":2557,"_31190":2528,"_21615":58913,"_5":14871,"_28382":58850,"_3078":58914},[],"Run from the directory where you saved `ca.pem`:",{"_3626":2558,"_31190":2528,"_21615":58916,"_5":14871,"_28382":58850,"_3078":58917},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3626":2559,"_31190":2528,"_21615":58919,"_5":14871,"_28382":58850,"_3078":58920},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3626":2560,"_31190":2528,"_21615":58922,"_5":14871,"_28382":58854,"_3078":58923},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3626":2561,"_31190":2528,"_21615":58925,"_5":14871,"_28382":58854,"_3078":58926},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3626":2562,"_31190":2528,"_21615":58928,"_5":14871,"_28382":58854,"_3078":58929},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3626":2563,"_31190":2528,"_21615":58931,"_5":14871,"_28382":58854,"_3078":58932},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3626":2564,"_31190":2528,"_21615":58934,"_5":14871,"_28382":58857,"_3078":58935},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3626":2565,"_31190":2565,"_5":15231,"_3078":58937,"_31548":58938,"_21615":58939,"_28382":2565},"Issue and verify a certificate",[50967,52479,56659,56096],[],{"_3626":2566,"_31190":2565,"_21615":58941,"_5":14871,"_28382":2565,"_3078":58942},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3626":2567,"_31190":2565,"_5":31545,"_21615":58944,"_28382":58945,"_3078":50977},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3626":2568,"_31190":2565,"_5":31545,"_21615":58947,"_28382":58948,"_3078":58949},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3626":2569,"_31190":2565,"_5":31545,"_21615":58951,"_28382":58952,"_3078":58953},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3626":2570,"_31190":2565,"_5":31545,"_21615":58955,"_28382":58956,"_3078":58957},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3626":2571,"_31190":2565,"_5":31545,"_21615":58959,"_28382":58960,"_3078":58961},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3626":2572,"_31190":2565,"_5":31545,"_21615":58963,"_28382":58964,"_3078":58965},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3626":2573,"_31190":2565,"_5":31545,"_21615":58967,"_28382":58968,"_3078":58969},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3626":2574,"_31190":2565,"_5":31545,"_21615":58971,"_28382":58972,"_3078":58973},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3626":2575,"_31190":2565,"_5":31545,"_21615":58975,"_28382":58976,"_3078":58977},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3626":2576,"_31190":2565,"_5":31545,"_21615":58979,"_28382":58980,"_3078":58981},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3626":2577,"_31190":2565,"_5":31545,"_21615":58983,"_28382":58984,"_3078":56353},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3626":2578,"_31190":2565,"_5":31545,"_21615":58986,"_28382":58987,"_3078":51001},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#next-step",{"_3626":2579,"_31190":2565,"_21615":58989,"_5":14871,"_28382":2565,"_3078":58990},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3626":2580,"_31190":2565,"_21615":58992,"_5":14871,"_28382":58945,"_3078":58993},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3626":2581,"_31190":2565,"_21615":58995,"_5":14871,"_28382":58945,"_3078":58996},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3626":2582,"_31190":2565,"_21615":58998,"_5":14871,"_28382":58945,"_3078":58999},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3626":2583,"_31190":2565,"_21615":59001,"_5":14871,"_28382":58945,"_3078":59002},[],"A client identifier: here we use `device-001`.",{"_3626":2584,"_31190":2565,"_21615":59004,"_5":14871,"_28382":58945,"_3078":59005},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3626":2585,"_31190":2565,"_21615":59007,"_5":14871,"_28382":58948,"_3078":59008},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3626":2586,"_31190":2565,"_21615":59010,"_5":14871,"_28382":58952,"_3078":59011},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3626":2587,"_31190":2565,"_21615":59013,"_5":14871,"_28382":58952,"_3078":59014},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3626":2588,"_31190":2565,"_21615":59016,"_5":14871,"_28382":58956,"_3078":59017},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3626":2589,"_31190":2565,"_21615":59019,"_5":14871,"_28382":58956,"_3078":59020},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3626":2590,"_31190":2565,"_21615":59022,"_5":14871,"_28382":58960,"_3078":59023},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3626":2591,"_31190":2565,"_21615":59025,"_5":14871,"_28382":58960,"_3078":59026},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3626":2592,"_31190":2565,"_21615":59028,"_5":14871,"_28382":58964,"_3078":59029},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3626":2593,"_31190":2565,"_21615":59031,"_5":14871,"_28382":58968,"_3078":59032},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3626":2594,"_31190":2565,"_21615":59034,"_5":14871,"_28382":58972,"_3078":59035},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3626":2595,"_31190":2565,"_21615":59037,"_5":14871,"_28382":58976,"_3078":59038},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3626":2596,"_31190":2565,"_21615":59040,"_5":14871,"_28382":58976,"_3078":59041},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3626":2597,"_31190":2565,"_21615":59043,"_5":14871,"_28382":58976,"_3078":59044},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3626":2598,"_31190":2565,"_21615":59046,"_5":14871,"_28382":58980,"_3078":59047},[],"In Bash, compare the two public-key digests:",{"_3626":2599,"_31190":2565,"_21615":59049,"_5":14871,"_28382":58980,"_3078":59050},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3626":2600,"_31190":2565,"_21615":59052,"_5":14871,"_28382":58980,"_3078":59053},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3626":2601,"_31190":2565,"_21615":59055,"_5":14871,"_28382":58984,"_3078":56437},[],{"_3626":2602,"_31190":2565,"_21615":59057,"_5":14871,"_28382":58984,"_3078":59058},[],"What to review",{"_3626":2603,"_31190":2565,"_21615":59060,"_5":14871,"_28382":58984,"_3078":59061},[],"The CA rejects issuance",{"_3626":2604,"_31190":2565,"_21615":59063,"_5":14871,"_28382":58984,"_3078":59064},[],"Permissions, CA state and key, algorithm and profile.",{"_3626":2605,"_31190":2565,"_21615":59066,"_5":14871,"_28382":58984,"_3078":59067},[],"Different subject or usages",{"_3626":2606,"_31190":2565,"_21615":59069,"_5":14871,"_28382":58984,"_3078":59070},[],"Applied profile and requested values.",{"_3626":2607,"_31190":2565,"_21615":59072,"_5":14871,"_28382":58984,"_3078":59073},[],"Issuer cannot be found",{"_3626":2608,"_31190":2565,"_21615":59075,"_5":14871,"_28382":58984,"_3078":59076},[],"Downloaded CA and required intermediate chain.",{"_3626":2609,"_31190":2565,"_21615":59078,"_5":14871,"_28382":58984,"_3078":59079},[],"Validity fails",{"_3626":2610,"_31190":2565,"_21615":59081,"_5":14871,"_28382":58984,"_3078":59082},[],"Certificate and CA dates, and the computer's clock.",{"_3626":2611,"_31190":2565,"_21615":59084,"_5":14871,"_28382":58984,"_3078":59085},[],"Public-key digests differ",{"_3626":2612,"_31190":2565,"_21615":59087,"_5":14871,"_28382":58984,"_3078":59088},[],"Certificate and key files from the same issuance.",{"_3626":2613,"_31190":2565,"_21615":59090,"_5":14871,"_28382":58984,"_3078":59091},[],"See PKI diagnostics to narrow an issuance failure.",{"_3626":2614,"_31190":2565,"_21615":59093,"_5":14871,"_28382":58987,"_3078":59094},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3626":2615,"_31190":2565,"_21615":59096,"_5":14871,"_28382":58987,"_3078":59097},[],"Manage certificates for inspection, status and revocation.",{"_3626":2616,"_31190":2565,"_21615":59099,"_5":14871,"_28382":58987,"_3078":59100},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3626":2617,"_31190":2565,"_21615":59102,"_5":14871,"_28382":58987,"_3078":59103},[],"Prepare EST for the device to request its next identities.",{"_3626":2618,"_31190":2565,"_21615":59105,"_5":14871,"_28382":58987,"_3078":59106},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3626":2619,"_31190":2619,"_5":15231,"_3078":59108,"_31548":59109,"_21615":59110,"_28382":2619},"PKI getting started",[50967,52479,56659,56096],[],{"_3626":2620,"_31190":2619,"_21615":59112,"_5":14871,"_28382":2619,"_3078":59113},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3626":2621,"_31190":2619,"_5":31545,"_21615":59115,"_28382":59116,"_3078":50977},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/overview#before-you-begin",{"_3626":2622,"_31190":2619,"_5":31545,"_21615":59118,"_28382":59119,"_3078":59120},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3626":2623,"_31190":2619,"_5":31545,"_21615":59122,"_28382":59123,"_3078":56288},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/overview#expected-result",{"_3626":2624,"_31190":2619,"_5":31545,"_21615":59125,"_28382":59126,"_3078":59127},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3626":2625,"_31190":2619,"_21615":59129,"_5":14871,"_28382":2619,"_3078":59130},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3626":2626,"_31190":2619,"_21615":59132,"_5":14871,"_28382":59116,"_3078":59133},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3626":2627,"_31190":2619,"_21615":59135,"_5":14871,"_28382":59116,"_3078":59136},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3626":2628,"_31190":2619,"_21615":59138,"_5":14871,"_28382":59116,"_3078":59139},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3626":2629,"_31190":2619,"_21615":59141,"_5":14871,"_28382":59116,"_3078":59142},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3626":2630,"_31190":2619,"_21615":59144,"_5":14871,"_28382":59116,"_3078":59145},[],"A working directory with restricted access for the downloaded key.",{"_3626":2631,"_31190":2619,"_21615":59147,"_5":14871,"_28382":59119,"_3078":59148},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3626":2632,"_31190":2619,"_21615":59150,"_5":14871,"_28382":59119,"_3078":59151},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3626":2633,"_31190":2619,"_21615":59153,"_5":14871,"_28382":59119,"_3078":59154},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3626":2634,"_31190":2619,"_21615":59156,"_5":14871,"_28382":59119,"_3078":59157},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3626":2635,"_31190":2619,"_21615":59159,"_5":14871,"_28382":59123,"_3078":59160},[],"File or resource",{"_3626":2636,"_31190":2619,"_21615":59162,"_5":14871,"_28382":59123,"_3078":56285},[],{"_3626":2637,"_31190":2619,"_21615":59164,"_5":14871,"_28382":59123,"_3078":59165},[],"Active root CA and `ca.pem`",{"_3626":2638,"_31190":2619,"_21615":59167,"_5":14871,"_28382":59123,"_3078":59168},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3626":2639,"_31190":2619,"_21615":59170,"_5":14871,"_28382":59123,"_3078":59171},[],"End-entity certificate and `device.crt`",{"_3626":2640,"_31190":2619,"_21615":59173,"_5":14871,"_28382":59123,"_3078":59174},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3626":2641,"_31190":2619,"_21615":59176,"_5":14871,"_28382":59123,"_3078":59177},[],"Private key `device.key`",{"_3626":2642,"_31190":2619,"_21615":59179,"_5":14871,"_28382":59123,"_3078":59180},[],"Its public key matches the one included in `device.crt`.",{"_3626":2643,"_31190":2619,"_21615":59182,"_5":14871,"_28382":59123,"_3078":59183},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3626":2644,"_31190":2619,"_21615":59185,"_5":14871,"_28382":59126,"_3078":59186},[],"To operate certificates, continue with Certificates and Validation.",{"_3626":2645,"_31190":2619,"_21615":59188,"_5":14871,"_28382":59126,"_3078":59189},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3626":2646,"_31190":2619,"_21615":59191,"_5":14871,"_28382":59126,"_3078":59192},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3626":2647,"_31190":2647,"_5":15231,"_3078":59194,"_31548":59195,"_21615":59196,"_28382":2647},"PKI troubleshooting",[50967,52479,56659,55234],[],{"_3626":2648,"_31190":2647,"_21615":59198,"_5":14871,"_28382":2647,"_3078":59199},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3626":2649,"_31190":2647,"_5":31545,"_21615":59201,"_28382":59202,"_3078":59203},[],"/docs/pr-preview/pr-77/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3626":2650,"_31190":2647,"_5":31545,"_21615":59205,"_28382":59206,"_3078":59207},[],"/docs/pr-preview/pr-77/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3626":2651,"_31190":2647,"_5":31545,"_21615":59209,"_28382":59210,"_3078":59211},[],"/docs/pr-preview/pr-77/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3626":2652,"_31190":2647,"_21615":59213,"_5":14871,"_28382":2647,"_3078":59214},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3626":2653,"_31190":2647,"_21615":59216,"_5":14871,"_28382":2647,"_3078":59217},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3626":2654,"_31190":2647,"_21615":59219,"_5":14871,"_28382":59202,"_3078":56285},[],{"_3626":2655,"_31190":2647,"_21615":59221,"_5":14871,"_28382":59202,"_3078":59222},[],"What to inspect",{"_3626":2656,"_31190":2647,"_21615":59224,"_5":14871,"_28382":59202,"_3078":51001},[],{"_3626":2657,"_31190":2647,"_21615":59226,"_5":14871,"_28382":59202,"_3078":55501},[],{"_3626":2658,"_31190":2647,"_21615":59228,"_5":14871,"_28382":59202,"_3078":59229},[],"Exists, is active and has usable dates.",{"_3626":2659,"_31190":2647,"_21615":59231,"_5":14871,"_28382":59202,"_3078":59232},[],"Authorities.",{"_3626":2660,"_31190":2647,"_21615":59234,"_5":14871,"_28382":59202,"_3078":59235},[],"Key",{"_3626":2661,"_31190":2647,"_21615":59237,"_5":14871,"_28382":59202,"_3078":59238},[],"The record has a usable private key and the engine can sign.",{"_3626":2662,"_31190":2647,"_21615":59240,"_5":14871,"_28382":59202,"_3078":59241},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3626":2663,"_31190":2647,"_21615":59243,"_5":14871,"_28382":59202,"_3078":59244},[],"CSR",{"_3626":2664,"_31190":2647,"_21615":59246,"_5":14871,"_28382":59202,"_3078":59247},[],"Correct PEM and verifiable signature.",{"_3626":2665,"_31190":2647,"_21615":59249,"_5":14871,"_28382":59202,"_3078":59250},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3626":2666,"_31190":2647,"_21615":59252,"_5":14871,"_28382":59202,"_3078":59253},[],"Profile",{"_3626":2667,"_31190":2647,"_21615":59255,"_5":14871,"_28382":59202,"_3078":59256},[],"Selected source, existing ID, allowed algorithm and size.",{"_3626":2668,"_31190":2647,"_21615":59258,"_5":14871,"_28382":59202,"_3078":59259},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3626":2669,"_31190":2647,"_21615":59261,"_5":14871,"_28382":59202,"_3078":56437},[],{"_3626":2670,"_31190":2647,"_21615":59263,"_5":14871,"_28382":59202,"_3078":59264},[],"Appropriate subject, SAN, usages and dates.",{"_3626":2671,"_31190":2647,"_21615":59266,"_5":14871,"_28382":59202,"_3078":59267},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3626":2672,"_31190":2647,"_21615":59269,"_5":14871,"_28382":59202,"_3078":59270},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3626":2673,"_31190":2647,"_21615":59272,"_5":14871,"_28382":59202,"_3078":59273},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3626":2674,"_31190":2647,"_21615":59275,"_5":14871,"_28382":59202,"_3078":59276},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3626":2675,"_31190":2647,"_21615":59278,"_5":14871,"_28382":59206,"_3078":59279},[],"Check each boundary independently:",{"_3626":2676,"_31190":2647,"_21615":59281,"_5":14871,"_28382":59206,"_3078":59282},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3626":2677,"_31190":2647,"_21615":59284,"_5":14871,"_28382":59206,"_3078":59285},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3626":2678,"_31190":2647,"_21615":59287,"_5":14871,"_28382":59206,"_3078":59288},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3626":2679,"_31190":2647,"_21615":59290,"_5":14871,"_28382":59206,"_3078":59291},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3626":2680,"_31190":2647,"_21615":59293,"_5":14871,"_28382":59206,"_3078":59294},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3626":2681,"_31190":2647,"_21615":59296,"_5":14871,"_28382":59206,"_3078":59297},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3626":2682,"_31190":2647,"_21615":59299,"_5":14871,"_28382":59210,"_3078":59300},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3626":2683,"_31190":2647,"_21615":59302,"_5":14871,"_28382":59210,"_3078":59303},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3626":2684,"_31190":2684,"_5":15231,"_3078":59305,"_31548":59306,"_21615":59307,"_28382":2684},"Security",[50967],[],{"_3626":2685,"_31190":2684,"_21615":59309,"_5":14871,"_28382":2684,"_3078":59310},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3626":2686,"_31190":2684,"_5":31545,"_21615":59312,"_28382":59313,"_3078":59314},[],"/docs/pr-preview/pr-77/security#report-a-vulnerability","Report a vulnerability",{"_3626":2687,"_31190":2684,"_5":31545,"_21615":59316,"_28382":59317,"_3078":59318},[],"/docs/pr-preview/pr-77/security#what-to-include-in-a-report","What to include in a report",{"_3626":2688,"_31190":2684,"_5":31545,"_21615":59320,"_28382":59321,"_3078":59322},[],"/docs/pr-preview/pr-77/security#supported-versions","Supported versions",{"_3626":2689,"_31190":2684,"_5":31545,"_21615":59324,"_28382":59325,"_3078":59326},[],"/docs/pr-preview/pr-77/security#responsible-disclosure","Responsible disclosure",{"_3626":2690,"_31190":2684,"_21615":59328,"_5":14871,"_28382":2684,"_3078":59329},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3626":2691,"_31190":2684,"_21615":59331,"_5":14871,"_28382":59313,"_3078":59332},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3626":2692,"_31190":2684,"_21615":59334,"_5":14871,"_28382":59313,"_3078":59335},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3626":2693,"_31190":2684,"_21615":59337,"_5":14871,"_28382":59313,"_3078":15510},[],{"_3626":2694,"_31190":2684,"_21615":59339,"_5":14871,"_28382":59313,"_3078":15439},[],{"_3626":2695,"_31190":2684,"_21615":59341,"_5":14871,"_28382":59313,"_3078":15497},[],{"_3626":2696,"_31190":2684,"_21615":59343,"_5":14871,"_28382":59313,"_3078":59344},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3626":2697,"_31190":2684,"_21615":59346,"_5":14871,"_28382":59313,"_3078":59347},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3626":2698,"_31190":2684,"_21615":59349,"_5":14871,"_28382":59317,"_3078":59350},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3626":2699,"_31190":2684,"_21615":59352,"_5":14871,"_28382":59317,"_3078":59353},[],"Do not include in the report:",{"_3626":2700,"_31190":2684,"_21615":59355,"_5":14871,"_28382":59317,"_3078":59356},[],"Credentials, tokens, or private keys",{"_3626":2701,"_31190":2684,"_21615":59358,"_5":14871,"_28382":59317,"_3078":59359},[],"Customer data or customer-identifiable information",{"_3626":2702,"_31190":2684,"_21615":59361,"_5":14871,"_28382":59317,"_3078":59362},[],"Confidential architecture or internal infrastructure details",{"_3626":2703,"_31190":2684,"_21615":59364,"_5":14871,"_28382":59321,"_3078":59365},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3626":2704,"_31190":2684,"_21615":59367,"_5":14871,"_28382":59321,"_3078":59368},[],"For upgrade guidance, see Upgrades.",{"_3626":2705,"_31190":2684,"_21615":59370,"_5":14871,"_28382":59325,"_3078":59371},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3626":2706,"_31190":2684,"_21615":59373,"_5":14871,"_28382":59325,"_3078":59374},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3626":2707,"_31190":2684,"_21615":59376,"_5":14871,"_28382":59325,"_3078":59377},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3626":2708,"_31190":2684,"_21615":59379,"_5":14871,"_28382":59325,"_3078":59380},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3626":2709,"_31190":2684,"_21615":59382,"_5":14871,"_28382":59325,"_3078":59383},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3626":2710,"_31190":2710,"_5":15231,"_3078":59385,"_31548":59386,"_21615":59388,"_28382":2710},"3.8.0 to 4.0.0",[50967,59387],"Upgrades",[],{"_3626":2711,"_31190":2710,"_21615":59390,"_5":14871,"_28382":2710,"_3078":59391},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3626":2712,"_31190":2710,"_5":31545,"_21615":59393,"_28382":59394,"_3078":59395},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3626":2713,"_31190":2710,"_5":31545,"_21615":59397,"_28382":59398,"_3078":59399},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3626":2714,"_31190":2710,"_5":31545,"_21615":59401,"_28382":59402,"_3078":59403},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3626":2715,"_31190":2710,"_5":31545,"_21615":59405,"_28382":59406,"_3078":59407},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3626":2716,"_31190":2710,"_5":31545,"_21615":59409,"_28382":59410,"_3078":59411},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3626":2717,"_31190":2710,"_5":31545,"_21615":59413,"_28382":59414,"_3078":59415},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3626":2718,"_31190":2710,"_5":31545,"_21615":59417,"_28382":59418,"_3078":59419},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3626":2719,"_31190":2710,"_5":31545,"_21615":59421,"_28382":59422,"_3078":59423},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3626":2720,"_31190":2710,"_5":31545,"_21615":59425,"_28382":59426,"_3078":59427},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3626":2721,"_31190":2710,"_5":31545,"_21615":59429,"_28382":59430,"_3078":59431},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3626":2722,"_31190":2710,"_5":31545,"_21615":59433,"_28382":59434,"_3078":51605},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3626":2723,"_31190":2710,"_5":31545,"_21615":59436,"_28382":59437,"_3078":59438},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3626":2724,"_31190":2710,"_5":31545,"_21615":59440,"_28382":59441,"_3078":59442},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3626":2725,"_31190":2710,"_5":31545,"_21615":59444,"_28382":59445,"_3078":59446},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3626":2726,"_31190":2710,"_5":31545,"_21615":59448,"_28382":59449,"_3078":59450},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3626":2727,"_31190":2710,"_5":31545,"_21615":59452,"_28382":59453,"_3078":59454},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3626":2728,"_31190":2710,"_5":31545,"_21615":59456,"_28382":59457,"_3078":59458},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3626":2729,"_31190":2710,"_5":31545,"_21615":59460,"_28382":59461,"_3078":59462},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3626":2730,"_31190":2710,"_5":31545,"_21615":59464,"_28382":59465,"_3078":59466},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3626":2731,"_31190":2710,"_5":31545,"_21615":59468,"_28382":59469,"_3078":59470},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3626":2732,"_31190":2710,"_5":31545,"_21615":59472,"_28382":59473,"_3078":59474},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3626":2733,"_31190":2710,"_5":31545,"_21615":59476,"_28382":59477,"_3078":59478},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3626":2734,"_31190":2710,"_5":31545,"_21615":59480,"_28382":59481,"_3078":59482},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3626":2735,"_31190":2710,"_5":31545,"_21615":59484,"_28382":59485,"_3078":59486},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3626":2736,"_31190":2710,"_5":31545,"_21615":59488,"_28382":59489,"_3078":59490},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3626":2737,"_31190":2710,"_5":31545,"_21615":59492,"_28382":59493,"_3078":59494},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3626":2738,"_31190":2710,"_5":31545,"_21615":59496,"_28382":59497,"_3078":59498},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3626":2739,"_31190":2710,"_5":31545,"_21615":59500,"_28382":59501,"_3078":59502},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3626":2740,"_31190":2710,"_5":31545,"_21615":59504,"_28382":59505,"_3078":59506},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3626":2741,"_31190":2710,"_5":31545,"_21615":59508,"_28382":59509,"_3078":59510},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3626":2742,"_31190":2710,"_5":31545,"_21615":59512,"_28382":59513,"_3078":59514},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3626":2743,"_31190":2710,"_5":31545,"_21615":59516,"_28382":59517,"_3078":59518},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3626":2744,"_31190":2710,"_5":31545,"_21615":59520,"_28382":59521,"_3078":59522},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3626":2745,"_31190":2710,"_5":31545,"_21615":59524,"_28382":59525,"_3078":59526},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3626":2746,"_31190":2710,"_5":31545,"_21615":59528,"_28382":59529,"_3078":59522},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3626":2747,"_31190":2710,"_5":31545,"_21615":59531,"_28382":59532,"_3078":59533},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3626":2748,"_31190":2710,"_5":31545,"_21615":59535,"_28382":59536,"_3078":59537},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3626":2749,"_31190":2710,"_5":31545,"_21615":59539,"_28382":59540,"_3078":59541},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3626":2750,"_31190":2710,"_5":31545,"_21615":59543,"_28382":59544,"_3078":59545},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3626":2751,"_31190":2710,"_5":31545,"_21615":59547,"_28382":59548,"_3078":59549},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3626":2752,"_31190":2710,"_5":31545,"_21615":59551,"_28382":59552,"_3078":59553},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3626":2753,"_31190":2710,"_5":31545,"_21615":59555,"_28382":59556,"_3078":59557},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3626":2754,"_31190":2710,"_5":31545,"_21615":59559,"_28382":59560,"_3078":59561},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3626":2755,"_31190":2710,"_5":31545,"_21615":59563,"_28382":59564,"_3078":59565},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3626":2756,"_31190":2710,"_5":31545,"_21615":59567,"_28382":59568,"_3078":55234},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3626":2757,"_31190":2710,"_5":31545,"_21615":59570,"_28382":59571,"_3078":59572},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3626":2758,"_31190":2710,"_5":31545,"_21615":59574,"_28382":59575,"_3078":59576},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3626":2759,"_31190":2710,"_21615":59578,"_5":14871,"_28382":2710,"_3078":59579},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3626":2760,"_31190":2710,"_21615":59581,"_5":14871,"_28382":2710,"_3078":59582},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3626":2761,"_31190":2710,"_21615":59584,"_5":14871,"_28382":2710,"_3078":59585},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3626":2762,"_31190":2710,"_21615":59587,"_5":14871,"_28382":2710,"_3078":59588},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3626":2763,"_31190":2710,"_21615":59590,"_5":14871,"_28382":2710,"_3078":59591},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3626":2764,"_31190":2710,"_21615":59593,"_5":14871,"_28382":2710,"_3078":59594},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3626":2765,"_31190":2710,"_21615":59596,"_5":14871,"_28382":2710,"_3078":59597},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3626":2766,"_31190":2710,"_21615":59599,"_5":14871,"_28382":59398,"_3078":59600},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3626":2767,"_31190":2710,"_21615":59602,"_5":14871,"_28382":59398,"_3078":59603},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3626":2768,"_31190":2710,"_21615":59605,"_5":14871,"_28382":59402,"_3078":59606},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3626":2769,"_31190":2710,"_21615":59608,"_5":14871,"_28382":59402,"_3078":59609},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3626":2770,"_31190":2710,"_21615":59611,"_5":14871,"_28382":59406,"_3078":59612},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3626":2771,"_31190":2710,"_21615":59614,"_5":14871,"_28382":59410,"_3078":59615},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3626":2772,"_31190":2710,"_21615":59617,"_5":14871,"_28382":59410,"_3078":59618},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3626":2773,"_31190":2710,"_21615":59620,"_5":14871,"_28382":59410,"_3078":59621},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3626":2774,"_31190":2710,"_21615":59623,"_5":14871,"_28382":59410,"_3078":59624},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3626":2775,"_31190":2710,"_21615":59626,"_5":14871,"_28382":59410,"_3078":59627},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3626":2776,"_31190":2710,"_21615":59629,"_5":14871,"_28382":59414,"_3078":59630},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3626":2777,"_31190":2710,"_21615":59632,"_5":14871,"_28382":59414,"_3078":59633},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3626":2778,"_31190":2710,"_21615":59635,"_5":14871,"_28382":59414,"_3078":59636},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3626":2779,"_31190":2710,"_21615":59638,"_5":14871,"_28382":59414,"_3078":59639},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3626":2780,"_31190":2710,"_21615":59641,"_5":14871,"_28382":59414,"_3078":59642},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3626":2781,"_31190":2710,"_21615":59644,"_5":14871,"_28382":59414,"_3078":59645},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3626":2782,"_31190":2710,"_21615":59647,"_5":14871,"_28382":59418,"_3078":59648},[],"Change",{"_3626":2783,"_31190":2710,"_21615":59650,"_5":14871,"_28382":59418,"_3078":59651},[],"Who is affected",{"_3626":2784,"_31190":2710,"_21615":59653,"_5":14871,"_28382":59418,"_3078":59654},[],"Severity",{"_3626":2785,"_31190":2710,"_21615":59656,"_5":14871,"_28382":59418,"_3078":58107},[],{"_3626":2786,"_31190":2710,"_21615":59658,"_5":14871,"_28382":59418,"_3078":59427},[],{"_3626":2787,"_31190":2710,"_21615":59660,"_5":14871,"_28382":59418,"_3078":59661},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3626":2788,"_31190":2710,"_21615":59663,"_5":14871,"_28382":59418,"_3078":59664},[],"High: KMS and VA start on empty volumes",{"_3626":2789,"_31190":2710,"_21615":59666,"_5":14871,"_28382":59418,"_3078":59667},[],"Copy the data into the new volumes",{"_3626":2790,"_31190":2710,"_21615":59669,"_5":14871,"_28382":59418,"_3078":59431},[],{"_3626":2791,"_31190":2710,"_21615":59671,"_5":14871,"_28382":59418,"_3078":59672},[],"Every Helm release",{"_3626":2792,"_31190":2710,"_21615":59674,"_5":14871,"_28382":59418,"_3078":59675},[],"High: `helm upgrade` fails",{"_3626":2793,"_31190":2710,"_21615":59677,"_5":14871,"_28382":59418,"_3078":59678},[],"Remove or rename legacy keys",{"_3626":2794,"_31190":2710,"_21615":59680,"_5":14871,"_28382":59418,"_3078":51605},[],{"_3626":2795,"_31190":2710,"_21615":59682,"_5":14871,"_28382":59418,"_3078":59672},[],{"_3626":2796,"_31190":2710,"_21615":59684,"_5":14871,"_28382":59418,"_3078":59685},[],"High: `helm upgrade` fails on inline credentials",{"_3626":2797,"_31190":2710,"_21615":59687,"_5":14871,"_28382":59418,"_3078":59688},[],"Create the Secrets first; see Step 2",{"_3626":2798,"_31190":2710,"_21615":59690,"_5":14871,"_28382":59418,"_3078":59438},[],{"_3626":2799,"_31190":2710,"_21615":59692,"_5":14871,"_28382":59418,"_3078":59693},[],"Every deployment",{"_3626":2800,"_31190":2710,"_21615":59695,"_5":14871,"_28382":59418,"_3078":59696},[],"High: without a bootstrap principal there is no administrator",{"_3626":2801,"_31190":2710,"_21615":59698,"_5":14871,"_28382":59418,"_3078":59699},[],"Configure `services.authz`",{"_3626":2802,"_31190":2710,"_21615":59701,"_5":14871,"_28382":59418,"_3078":59442},[],{"_3626":2803,"_31190":2710,"_21615":59703,"_5":14871,"_28382":59418,"_3078":59672},[],{"_3626":2804,"_31190":2710,"_21615":59705,"_5":14871,"_28382":59418,"_3078":59706},[],"High: `helm upgrade` fails on the old keys",{"_3626":2805,"_31190":2710,"_21615":59708,"_5":14871,"_28382":59418,"_3078":59709},[],"Move JWKS and roles into `services.authz`",{"_3626":2806,"_31190":2710,"_21615":59711,"_5":14871,"_28382":59418,"_3078":59462},[],{"_3626":2807,"_31190":2710,"_21615":59713,"_5":14871,"_28382":59418,"_3078":59714},[],"3.8.0 deployments with per-service databases",{"_3626":2808,"_31190":2710,"_21615":59716,"_5":14871,"_28382":59418,"_3078":59717},[],"High: services find no data, or a migration aborts",{"_3626":2809,"_31190":2710,"_21615":59719,"_5":14871,"_28382":59418,"_3078":59720},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3626":2810,"_31190":2710,"_21615":59722,"_5":14871,"_28382":59418,"_3078":59466},[],{"_3626":2811,"_31190":2710,"_21615":59724,"_5":14871,"_28382":59418,"_3078":59725},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3626":2812,"_31190":2710,"_21615":59727,"_5":14871,"_28382":59418,"_3078":59728},[],"High: the backend no longer starts with them",{"_3626":2813,"_31190":2710,"_21615":59730,"_5":14871,"_28382":59418,"_3078":59731},[],"Move to PostgreSQL before upgrading",{"_3626":2814,"_31190":2710,"_21615":59733,"_5":14871,"_28382":59418,"_3078":59514},[],{"_3626":2815,"_31190":2710,"_21615":59735,"_5":14871,"_28382":59418,"_3078":59736},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3626":2816,"_31190":2710,"_21615":59738,"_5":14871,"_28382":59418,"_3078":59739},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3626":2817,"_31190":2710,"_21615":59741,"_5":14871,"_28382":59418,"_3078":59742},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3626":2818,"_31190":2710,"_21615":59744,"_5":14871,"_28382":59418,"_3078":59745},[],"Webhooks with file references",{"_3626":2819,"_31190":2710,"_21615":59747,"_5":14871,"_28382":59418,"_3078":59748},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3626":2820,"_31190":2710,"_21615":59750,"_5":14871,"_28382":59418,"_3078":59751},[],"High: enrollments calling the webhook fail",{"_3626":2821,"_31190":2710,"_21615":59753,"_5":14871,"_28382":59418,"_3078":59754},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3626":2822,"_31190":2710,"_21615":59756,"_5":14871,"_28382":59418,"_3078":59446},[],{"_3626":2823,"_31190":2710,"_21615":59758,"_5":14871,"_28382":59418,"_3078":59759},[],"Releases with per-service identity overrides or mounted key material",{"_3626":2824,"_31190":2710,"_21615":59761,"_5":14871,"_28382":59418,"_3078":59762},[],"Medium: services cannot read their files",{"_3626":2825,"_31190":2710,"_21615":59764,"_5":14871,"_28382":59418,"_3078":59765},[],"Remove the overrides and fix volume ownership",{"_3626":2826,"_31190":2710,"_21615":59767,"_5":14871,"_28382":59418,"_3078":59450},[],{"_3626":2827,"_31190":2710,"_21615":59769,"_5":14871,"_28382":59418,"_3078":59770},[],"Releases that set `amqp.tls`",{"_3626":2828,"_31190":2710,"_21615":59772,"_5":14871,"_28382":59418,"_3078":59773},[],"Medium: clients connect to the wrong port",{"_3626":2829,"_31190":2710,"_21615":59775,"_5":14871,"_28382":59418,"_3078":59776},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3626":2830,"_31190":2710,"_21615":59778,"_5":14871,"_28382":59418,"_3078":59470},[],{"_3626":2831,"_31190":2710,"_21615":59780,"_5":14871,"_28382":59418,"_3078":59781},[],"Installations whose CA keys predate the KMS",{"_3626":2832,"_31190":2710,"_21615":59783,"_5":14871,"_28382":59418,"_3078":59784},[],"Medium: CA keys stay unmanaged",{"_3626":2833,"_31190":2710,"_21615":59786,"_5":14871,"_28382":59418,"_3078":59787},[],"Run the CA-to-KMS migration",{"_3626":2834,"_31190":2710,"_21615":59789,"_5":14871,"_28382":59418,"_3078":59790},[],"Receiver certificate verification",{"_3626":2835,"_31190":2710,"_21615":59792,"_5":14871,"_28382":59418,"_3078":59793},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3626":2836,"_31190":2710,"_21615":59795,"_5":14871,"_28382":59418,"_3078":59796},[],"Medium: credentials go to an unverified receiver",{"_3626":2837,"_31190":2710,"_21615":59798,"_5":14871,"_28382":59418,"_3078":59799},[],"Set `insecure_skip_verify` to `false`",{"_3626":2838,"_31190":2710,"_21615":59801,"_5":14871,"_28382":59418,"_3078":59486},[],{"_3626":2839,"_31190":2710,"_21615":59803,"_5":14871,"_28382":59418,"_3078":59804},[],"Scripts and consoles that edit DMSs through the API",{"_3626":2840,"_31190":2710,"_21615":59806,"_5":14871,"_28382":59418,"_3078":59807},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3626":2841,"_31190":2710,"_21615":59809,"_5":14871,"_28382":59418,"_3078":59810},[],"Read the DMS before editing and use the new field",{"_3626":2842,"_31190":2710,"_21615":59812,"_5":14871,"_28382":59418,"_3078":59490},[],{"_3626":2843,"_31190":2710,"_21615":59814,"_5":14871,"_28382":59418,"_3078":59815},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3626":2844,"_31190":2710,"_21615":59817,"_5":14871,"_28382":59418,"_3078":59818},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3626":2845,"_31190":2710,"_21615":59820,"_5":14871,"_28382":59418,"_3078":59821},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3626":2846,"_31190":2710,"_21615":59823,"_5":14871,"_28382":59418,"_3078":59510},[],{"_3626":2847,"_31190":2710,"_21615":59825,"_5":14871,"_28382":59418,"_3078":59826},[],"Clients that create or update CRL settings through the API",{"_3626":2848,"_31190":2710,"_21615":59828,"_5":14871,"_28382":59418,"_3078":59829},[],"Medium: requests with the old field return an error",{"_3626":2849,"_31190":2710,"_21615":59831,"_5":14871,"_28382":59418,"_3078":59832},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3626":2850,"_31190":2710,"_21615":59834,"_5":14871,"_28382":59418,"_3078":59518},[],{"_3626":2851,"_31190":2710,"_21615":59836,"_5":14871,"_28382":59418,"_3078":59837},[],"Alert subscriptions and consumers of the VA events",{"_3626":2852,"_31190":2710,"_21615":59839,"_5":14871,"_28382":59418,"_3078":59840},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3626":2853,"_31190":2710,"_21615":59842,"_5":14871,"_28382":59418,"_3078":59843},[],"Review conditions filtering on the old event payload or subject",{"_3626":2854,"_31190":2710,"_21615":59845,"_5":14871,"_28382":59418,"_3078":59522},[],{"_3626":2855,"_31190":2710,"_21615":59847,"_5":14871,"_28382":59418,"_3078":59848},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3626":2856,"_31190":2710,"_21615":59850,"_5":14871,"_28382":59418,"_3078":59851},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3626":2857,"_31190":2710,"_21615":59853,"_5":14871,"_28382":59418,"_3078":59854},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3626":2858,"_31190":2710,"_21615":59856,"_5":14871,"_28382":59418,"_3078":59506},[],{"_3626":2859,"_31190":2710,"_21615":59858,"_5":14871,"_28382":59418,"_3078":59859},[],"Consumers that read the device `events` field",{"_3626":2860,"_31190":2710,"_21615":59861,"_5":14871,"_28382":59418,"_3078":59862},[],"Medium: the field disappears",{"_3626":2861,"_31190":2710,"_21615":59864,"_5":14871,"_28382":59418,"_3078":59865},[],"Use the new event endpoints",{"_3626":2862,"_31190":2710,"_21615":59867,"_5":14871,"_28382":59418,"_3078":59533},[],{"_3626":2863,"_31190":2710,"_21615":59869,"_5":14871,"_28382":59418,"_3078":59870},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3626":2864,"_31190":2710,"_21615":59872,"_5":14871,"_28382":59418,"_3078":59873},[],"Medium: the VA migration aborts",{"_3626":2865,"_31190":2710,"_21615":59875,"_5":14871,"_28382":59418,"_3078":59876},[],"Fix the affected roles before upgrading",{"_3626":2866,"_31190":2710,"_21615":59878,"_5":14871,"_28382":59418,"_3078":59454},[],{"_3626":2867,"_31190":2710,"_21615":59880,"_5":14871,"_28382":59418,"_3078":59881},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3626":2868,"_31190":2710,"_21615":59883,"_5":14871,"_28382":59418,"_3078":59884},[],"Low to medium: validation errors or changed defaults",{"_3626":2869,"_31190":2710,"_21615":59886,"_5":14871,"_28382":59418,"_3078":59887},[],"Update the values file",{"_3626":2870,"_31190":2710,"_21615":59889,"_5":14871,"_28382":59418,"_3078":59498},[],{"_3626":2871,"_31190":2710,"_21615":59891,"_5":14871,"_28382":59418,"_3078":59892},[],"Clients that send the DMS ID in the update body",{"_3626":2872,"_31190":2710,"_21615":59894,"_5":14871,"_28382":59418,"_3078":59895},[],"Low: the ID in the URL wins",{"_3626":2873,"_31190":2710,"_21615":59897,"_5":14871,"_28382":59418,"_3078":59898},[],"Send the ID in the URL",{"_3626":2874,"_31190":2710,"_21615":59900,"_5":14871,"_28382":59418,"_3078":59526},[],{"_3626":2875,"_31190":2710,"_21615":59902,"_5":14871,"_28382":59418,"_3078":59903},[],"Clients that send an `id` when creating or importing CAs",{"_3626":2876,"_31190":2710,"_21615":59905,"_5":14871,"_28382":59418,"_3078":59906},[],"Low: the ID in the body is ignored, and the field is removed",{"_3626":2877,"_31190":2710,"_21615":59908,"_5":14871,"_28382":59418,"_3078":59909},[],"Let the backend assign the ID and use the returned one",{"_3626":2878,"_31190":2710,"_21615":59911,"_5":14871,"_28382":59418,"_3078":59522},[],{"_3626":2879,"_31190":2710,"_21615":59913,"_5":14871,"_28382":59418,"_3078":59914},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3626":2880,"_31190":2710,"_21615":59916,"_5":14871,"_28382":59418,"_3078":59917},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3626":2881,"_31190":2710,"_21615":59919,"_5":14871,"_28382":59418,"_3078":59920},[],"Use the KMS `sign` and `verify` operations",{"_3626":2882,"_31190":2710,"_21615":59922,"_5":14871,"_28382":59418,"_3078":59502},[],{"_3626":2883,"_31190":2710,"_21615":59924,"_5":14871,"_28382":59418,"_3078":59925},[],"Consumers that match on certificate `type`",{"_3626":2884,"_31190":2710,"_21615":59927,"_5":14871,"_28382":59418,"_3078":59928},[],"Low: two values are renamed",{"_3626":2885,"_31190":2710,"_21615":59930,"_5":14871,"_28382":59418,"_3078":59931},[],"Adapt consumers",{"_3626":2886,"_31190":2710,"_21615":59933,"_5":14871,"_28382":59418,"_3078":59494},[],{"_3626":2887,"_31190":2710,"_21615":59935,"_5":14871,"_28382":59418,"_3078":59936},[],"Any DMS",{"_3626":2888,"_31190":2710,"_21615":59938,"_5":14871,"_28382":59418,"_3078":59939},[],"Low: informational",{"_3626":2889,"_31190":2710,"_21615":59941,"_5":14871,"_28382":59418,"_3078":59942},[],"Read both blocks before editing",{"_3626":2890,"_31190":2710,"_21615":59944,"_5":14871,"_28382":59426,"_3078":59945},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3626":2891,"_31190":2710,"_21615":59947,"_5":14871,"_28382":59426,"_3078":59948},[],"Step 4 of the migration guide copies the data.",{"_3626":2892,"_31190":2710,"_21615":59950,"_5":14871,"_28382":59430,"_3078":59951},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3626":2893,"_31190":2710,"_21615":59953,"_5":14871,"_28382":59434,"_3078":59954},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3626":2894,"_31190":2710,"_21615":59956,"_5":14871,"_28382":59434,"_3078":59957},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3626":2895,"_31190":2710,"_21615":59959,"_5":14871,"_28382":59437,"_3078":59960},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3626":2896,"_31190":2710,"_21615":59962,"_5":14871,"_28382":59441,"_3078":59963},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3626":2897,"_31190":2710,"_21615":59965,"_5":14871,"_28382":59445,"_3078":59966},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3626":2898,"_31190":2710,"_21615":59968,"_5":14871,"_28382":59445,"_3078":59969},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3626":2899,"_31190":2710,"_21615":59971,"_5":14871,"_28382":59445,"_3078":59972},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3626":2900,"_31190":2710,"_21615":59974,"_5":14871,"_28382":59449,"_3078":59975},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3626":2901,"_31190":2710,"_21615":59977,"_5":14871,"_28382":59453,"_3078":59978},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3626":2902,"_31190":2710,"_21615":59980,"_5":14871,"_28382":59453,"_3078":59981},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3626":2903,"_31190":2710,"_21615":59983,"_5":14871,"_28382":59453,"_3078":59984},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3626":2904,"_31190":2710,"_21615":59986,"_5":14871,"_28382":59453,"_3078":59987},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3626":2905,"_31190":2710,"_21615":59989,"_5":14871,"_28382":59453,"_3078":59990},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3626":2906,"_31190":2710,"_21615":59992,"_5":14871,"_28382":59453,"_3078":59993},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3626":2907,"_31190":2710,"_21615":59995,"_5":14871,"_28382":59461,"_3078":59996},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3626":2908,"_31190":2710,"_21615":59998,"_5":14871,"_28382":59461,"_3078":59999},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3626":2909,"_31190":2710,"_21615":60001,"_5":14871,"_28382":59461,"_3078":60002},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3626":2910,"_31190":2710,"_21615":60004,"_5":14871,"_28382":59461,"_3078":60005},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3626":2911,"_31190":2710,"_21615":60007,"_5":14871,"_28382":59461,"_3078":60008},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3626":2912,"_31190":2710,"_21615":60010,"_5":14871,"_28382":59465,"_3078":60011},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3626":2913,"_31190":2710,"_21615":60013,"_5":14871,"_28382":59469,"_3078":60014},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3626":2914,"_31190":2710,"_21615":60016,"_5":14871,"_28382":59469,"_3078":60017},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3626":2915,"_31190":2710,"_21615":60019,"_5":14871,"_28382":59469,"_3078":60020},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3626":2916,"_31190":2710,"_21615":60022,"_5":14871,"_28382":59469,"_3078":60023},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3626":2917,"_31190":2710,"_21615":60025,"_5":14871,"_28382":59469,"_3078":60026},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3626":2918,"_31190":2710,"_21615":60028,"_5":14871,"_28382":59469,"_3078":60029},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3626":2919,"_31190":2710,"_21615":60031,"_5":14871,"_28382":59469,"_3078":60032},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3626":2920,"_31190":2710,"_21615":60034,"_5":14871,"_28382":59469,"_3078":60035},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3626":2921,"_31190":2710,"_21615":60037,"_5":14871,"_28382":59473,"_3078":60038},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3626":2922,"_31190":2710,"_21615":60040,"_5":14871,"_28382":59481,"_3078":60041},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3626":2923,"_31190":2710,"_21615":60043,"_5":14871,"_28382":59481,"_3078":60044},[],"Field in 3.8.0",{"_3626":2924,"_31190":2710,"_21615":60046,"_5":14871,"_28382":59481,"_3078":60047},[],"Field in 4.0.0",{"_3626":2925,"_31190":2710,"_21615":60049,"_5":14871,"_28382":59481,"_3078":60050},[],"`validate_server_cert`",{"_3626":2926,"_31190":2710,"_21615":60052,"_5":14871,"_28382":59481,"_3078":60053},[],"`insecure_skip_verify` (value negated)",{"_3626":2927,"_31190":2710,"_21615":60055,"_5":14871,"_28382":59481,"_3078":60056},[],"`oidc`",{"_3626":2928,"_31190":2710,"_21615":60058,"_5":14871,"_28382":59481,"_3078":60059},[],"`jwt_options`",{"_3626":2929,"_31190":2710,"_21615":60061,"_5":14871,"_28382":59481,"_3078":60062},[],"`apikey`",{"_3626":2930,"_31190":2710,"_21615":60064,"_5":14871,"_28382":59481,"_3078":60065},[],"`apikey_options`",{"_3626":2931,"_31190":2710,"_21615":60067,"_5":14871,"_28382":59481,"_3078":60068},[],"`mtls`",{"_3626":2932,"_31190":2710,"_21615":60070,"_5":14871,"_28382":59481,"_3078":60071},[],"`mtls_options`",{"_3626":2933,"_31190":2710,"_21615":60073,"_5":14871,"_28382":59481,"_3078":60074},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3626":2934,"_31190":2710,"_21615":60076,"_5":14871,"_28382":59481,"_3078":60077},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3626":2935,"_31190":2710,"_21615":60079,"_5":14871,"_28382":59481,"_3078":60080},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3626":2936,"_31190":2710,"_21615":60082,"_5":14871,"_28382":59485,"_3078":60083},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3626":2937,"_31190":2710,"_21615":60085,"_5":14871,"_28382":59485,"_3078":60086},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3626":2938,"_31190":2710,"_21615":60088,"_5":14871,"_28382":59485,"_3078":60089},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3626":2939,"_31190":2710,"_21615":60091,"_5":14871,"_28382":59489,"_3078":60092},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3626":2940,"_31190":2710,"_21615":60094,"_5":14871,"_28382":59489,"_3078":60095},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3626":2941,"_31190":2710,"_21615":60097,"_5":14871,"_28382":59493,"_3078":60098},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3626":2942,"_31190":2710,"_21615":60100,"_5":14871,"_28382":59497,"_3078":60101},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3626":2943,"_31190":2710,"_21615":60103,"_5":14871,"_28382":59501,"_3078":60104},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3626":2944,"_31190":2710,"_21615":60106,"_5":14871,"_28382":59505,"_3078":60107},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3626":2945,"_31190":2710,"_21615":60109,"_5":14871,"_28382":59505,"_3078":60110},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3626":2946,"_31190":2710,"_21615":60112,"_5":14871,"_28382":59505,"_3078":60113},[],"`POST /v1/devices/:id/events` creates an event.",{"_3626":2947,"_31190":2710,"_21615":60115,"_5":14871,"_28382":59505,"_3078":60116},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3626":2948,"_31190":2710,"_21615":60118,"_5":14871,"_28382":59509,"_3078":60119},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3626":2949,"_31190":2710,"_21615":60121,"_5":14871,"_28382":59513,"_3078":60122},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3626":2950,"_31190":2710,"_21615":60124,"_5":14871,"_28382":59513,"_3078":60125},[],"Route",{"_3626":2951,"_31190":2710,"_21615":60127,"_5":14871,"_28382":59513,"_3078":54422},[],{"_3626":2952,"_31190":2710,"_21615":60129,"_5":14871,"_28382":59513,"_3078":60130},[],"`GET /v1/crl-settings`",{"_3626":2953,"_31190":2710,"_21615":60132,"_5":14871,"_28382":59513,"_3078":60133},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3626":2954,"_31190":2710,"_21615":60135,"_5":14871,"_28382":59513,"_3078":60136},[],"`GET /v1/crl-settings/{ca-id}`",{"_3626":2955,"_31190":2710,"_21615":60138,"_5":14871,"_28382":59513,"_3078":60139},[],"Reads the settings of a CA.",{"_3626":2956,"_31190":2710,"_21615":60141,"_5":14871,"_28382":59513,"_3078":60142},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3626":2957,"_31190":2710,"_21615":60144,"_5":14871,"_28382":59513,"_3078":60145},[],"Replaces `crl_options`.",{"_3626":2958,"_31190":2710,"_21615":60147,"_5":14871,"_28382":59513,"_3078":60148},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3626":2959,"_31190":2710,"_21615":60150,"_5":14871,"_28382":59513,"_3078":60151},[],"Removes the archived settings of a CA.",{"_3626":2960,"_31190":2710,"_21615":60153,"_5":14871,"_28382":59513,"_3078":60154},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3626":2961,"_31190":2710,"_21615":60156,"_5":14871,"_28382":59513,"_3078":60157},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3626":2962,"_31190":2710,"_21615":60159,"_5":14871,"_28382":59513,"_3078":60160},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3626":2963,"_31190":2710,"_21615":60162,"_5":14871,"_28382":59513,"_3078":60163},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3626":2964,"_31190":2710,"_21615":60165,"_5":14871,"_28382":59513,"_3078":60166},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3626":2965,"_31190":2710,"_21615":60168,"_5":14871,"_28382":59513,"_3078":60169},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3626":2966,"_31190":2710,"_21615":60171,"_5":14871,"_28382":59513,"_3078":60172},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3626":2967,"_31190":2710,"_21615":60174,"_5":14871,"_28382":59513,"_3078":60175},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3626":2968,"_31190":2710,"_21615":60177,"_5":14871,"_28382":59513,"_3078":60178},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3626":2969,"_31190":2710,"_21615":60180,"_5":14871,"_28382":59513,"_3078":60181},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3626":2970,"_31190":2710,"_21615":60183,"_5":14871,"_28382":59513,"_3078":60184},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3626":2971,"_31190":2710,"_21615":60186,"_5":14871,"_28382":59517,"_3078":60187},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3626":2972,"_31190":2710,"_21615":60189,"_5":14871,"_28382":59521,"_3078":60190},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3626":2973,"_31190":2710,"_21615":60192,"_5":14871,"_28382":59525,"_3078":60193},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3626":2974,"_31190":2710,"_21615":60195,"_5":14871,"_28382":59529,"_3078":60196},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3626":2975,"_31190":2710,"_21615":60198,"_5":14871,"_28382":59529,"_3078":60199},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3626":2976,"_31190":2710,"_21615":60201,"_5":14871,"_28382":59532,"_3078":60202},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3626":2977,"_31190":2710,"_21615":60204,"_5":14871,"_28382":59536,"_3078":60205},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3626":2978,"_31190":2710,"_21615":60207,"_5":14871,"_28382":59540,"_3078":60208},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3626":2979,"_31190":2710,"_21615":60210,"_5":14871,"_28382":59540,"_3078":60211},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3626":2980,"_31190":2710,"_21615":60213,"_5":14871,"_28382":59540,"_3078":60214},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3626":2981,"_31190":2710,"_21615":60216,"_5":14871,"_28382":59540,"_3078":60217},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3626":2982,"_31190":2710,"_21615":60219,"_5":14871,"_28382":59540,"_3078":60220},[],"Record the names of your local-storage PVCs:",{"_3626":2983,"_31190":2710,"_21615":60222,"_5":14871,"_28382":59540,"_3078":60223},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3626":2984,"_31190":2710,"_21615":60225,"_5":14871,"_28382":59544,"_3078":60226},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3626":2985,"_31190":2710,"_21615":60228,"_5":14871,"_28382":59544,"_3078":60229},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3626":2986,"_31190":2710,"_21615":60231,"_5":14871,"_28382":59544,"_3078":60232},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3626":2987,"_31190":2710,"_21615":60234,"_5":14871,"_28382":59544,"_3078":60235},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3626":2988,"_31190":2710,"_21615":60237,"_5":14871,"_28382":59544,"_3078":60238},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3626":2989,"_31190":2710,"_21615":60240,"_5":14871,"_28382":59548,"_3078":60241},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3626":2990,"_31190":2710,"_21615":60243,"_5":14871,"_28382":59548,"_3078":60244},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3626":2991,"_31190":2710,"_21615":60246,"_5":14871,"_28382":59548,"_3078":60247},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3626":2992,"_31190":2710,"_21615":60249,"_5":14871,"_28382":59548,"_3078":60250},[],"Secret (`existingSecret`)",{"_3626":2993,"_31190":2710,"_21615":60252,"_5":14871,"_28382":59548,"_3078":60253},[],"Required data keys",{"_3626":2994,"_31190":2710,"_21615":60255,"_5":14871,"_28382":59548,"_3078":60256},[],"When",{"_3626":2995,"_31190":2710,"_21615":60258,"_5":14871,"_28382":59548,"_3078":60259},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3626":2996,"_31190":2710,"_21615":60261,"_5":14871,"_28382":59548,"_3078":60262},[],"`username`, `password`",{"_3626":2997,"_31190":2710,"_21615":60264,"_5":14871,"_28382":59548,"_3078":60265},[],"Always",{"_3626":2998,"_31190":2710,"_21615":60267,"_5":14871,"_28382":59548,"_3078":60268},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3626":2999,"_31190":2710,"_21615":60270,"_5":14871,"_28382":59548,"_3078":60262},[],{"_3626":3000,"_31190":2710,"_21615":60272,"_5":14871,"_28382":59548,"_3078":60265},[],{"_3626":3001,"_31190":2710,"_21615":60274,"_5":14871,"_28382":59548,"_3078":60275},[],"`services.alerts.smtp_server.existingSecret`",{"_3626":3002,"_31190":2710,"_21615":60277,"_5":14871,"_28382":59548,"_3078":60262},[],{"_3626":3003,"_31190":2710,"_21615":60279,"_5":14871,"_28382":59548,"_3078":60280},[],"Only when SMTP authentication is enabled",{"_3626":3004,"_31190":2710,"_21615":60282,"_5":14871,"_28382":59548,"_3078":60283},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3626":3005,"_31190":2710,"_21615":60285,"_5":14871,"_28382":59548,"_3078":60286},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3626":3006,"_31190":2710,"_21615":60288,"_5":14871,"_28382":59548,"_3078":60289},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3626":3007,"_31190":2710,"_21615":60291,"_5":14871,"_28382":59548,"_3078":60292},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3626":3008,"_31190":2710,"_21615":60294,"_5":14871,"_28382":59548,"_3078":60295},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3626":3009,"_31190":2710,"_21615":60297,"_5":14871,"_28382":59548,"_3078":60298},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3626":3010,"_31190":2710,"_21615":60300,"_5":14871,"_28382":59548,"_3078":60301},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3626":3011,"_31190":2710,"_21615":60303,"_5":14871,"_28382":59548,"_3078":60304},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3626":3012,"_31190":2710,"_21615":60306,"_5":14871,"_28382":59548,"_3078":60307},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3626":3013,"_31190":2710,"_21615":60309,"_5":14871,"_28382":59548,"_3078":60310},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3626":3014,"_31190":2710,"_21615":60312,"_5":14871,"_28382":59548,"_3078":60313},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3626":3015,"_31190":2710,"_21615":60315,"_5":14871,"_28382":59548,"_3078":60316},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3626":3016,"_31190":2710,"_21615":60318,"_5":14871,"_28382":59548,"_3078":60319},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3626":3017,"_31190":2710,"_21615":60321,"_5":14871,"_28382":59548,"_3078":60322},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3626":3018,"_31190":2710,"_21615":60324,"_5":14871,"_28382":59548,"_3078":60325},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3626":3019,"_31190":2710,"_21615":60327,"_5":14871,"_28382":59552,"_3078":60328},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3626":3020,"_31190":2710,"_21615":60330,"_5":14871,"_28382":59552,"_3078":60331},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3626":3021,"_31190":2710,"_21615":60333,"_5":14871,"_28382":59556,"_3078":60334},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3626":3022,"_31190":2710,"_21615":60336,"_5":14871,"_28382":59556,"_3078":60337},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3626":3023,"_31190":2710,"_21615":60339,"_5":14871,"_28382":59556,"_3078":60340},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3626":3024,"_31190":2710,"_21615":60342,"_5":14871,"_28382":59556,"_3078":60343},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3626":3025,"_31190":2710,"_21615":60345,"_5":14871,"_28382":59556,"_3078":60346},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3626":3026,"_31190":2710,"_21615":60348,"_5":14871,"_28382":59556,"_3078":60349},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3626":3027,"_31190":2710,"_21615":60351,"_5":14871,"_28382":59556,"_3078":60352},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3626":3028,"_31190":2710,"_21615":60354,"_5":14871,"_28382":59556,"_3078":60355},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3626":3029,"_31190":2710,"_21615":60357,"_5":14871,"_28382":59556,"_3078":60358},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3626":3030,"_31190":2710,"_21615":60360,"_5":14871,"_28382":59556,"_3078":60361},[],"**Remove the helper and restore the recorded replica counts:**",{"_3626":3031,"_31190":2710,"_21615":60363,"_5":14871,"_28382":59556,"_3078":60364},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3626":3032,"_31190":2710,"_21615":60366,"_5":14871,"_28382":59560,"_3078":60367},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3626":3033,"_31190":2710,"_21615":60369,"_5":14871,"_28382":59560,"_3078":60370},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3626":3034,"_31190":2710,"_21615":60372,"_5":14871,"_28382":59564,"_3078":60373},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3626":3035,"_31190":2710,"_21615":60375,"_5":14871,"_28382":59564,"_3078":60376},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3626":3036,"_31190":2710,"_21615":60378,"_5":14871,"_28382":59564,"_3078":60379},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3626":3037,"_31190":2710,"_21615":60381,"_5":14871,"_28382":59564,"_3078":60382},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3626":3038,"_31190":2710,"_21615":60384,"_5":14871,"_28382":59564,"_3078":60385},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3626":3039,"_31190":2710,"_21615":60387,"_5":14871,"_28382":59564,"_3078":60388},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3626":3040,"_31190":2710,"_21615":60390,"_5":14871,"_28382":59564,"_3078":60391},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3626":3041,"_31190":2710,"_21615":60393,"_5":14871,"_28382":59564,"_3078":60394},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3626":3042,"_31190":2710,"_21615":60396,"_5":14871,"_28382":59568,"_3078":60397},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3626":3043,"_31190":2710,"_21615":60399,"_5":14871,"_28382":59568,"_3078":60400},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3626":3044,"_31190":2710,"_21615":60402,"_5":14871,"_28382":59568,"_3078":60403},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3626":3045,"_31190":2710,"_21615":60405,"_5":14871,"_28382":59568,"_3078":60406},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3626":3046,"_31190":2710,"_21615":60408,"_5":14871,"_28382":59568,"_3078":60409},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3626":3047,"_31190":2710,"_21615":60411,"_5":14871,"_28382":59568,"_3078":60412},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3626":3048,"_31190":2710,"_21615":60414,"_5":14871,"_28382":59568,"_3078":60415},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3626":3049,"_31190":2710,"_21615":60417,"_5":14871,"_28382":59568,"_3078":60418},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3626":3050,"_31190":2710,"_21615":60420,"_5":14871,"_28382":59568,"_3078":60421},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3626":3051,"_31190":2710,"_21615":60423,"_5":14871,"_28382":59568,"_3078":60424},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3626":3052,"_31190":2710,"_21615":60426,"_5":14871,"_28382":59568,"_3078":60427},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3626":3053,"_31190":2710,"_21615":60429,"_5":14871,"_28382":59571,"_3078":60430},[],"After the upgrade, check in this order:",{"_3626":3054,"_31190":2710,"_21615":60432,"_5":14871,"_28382":59571,"_3078":60433},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3626":3055,"_31190":2710,"_21615":60435,"_5":14871,"_28382":59571,"_3078":60436},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3626":3056,"_31190":2710,"_21615":60438,"_5":14871,"_28382":59571,"_3078":60439},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3626":3057,"_31190":2710,"_21615":60441,"_5":14871,"_28382":59571,"_3078":60442},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3626":3058,"_31190":2710,"_21615":60444,"_5":14871,"_28382":59571,"_3078":60445},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3626":3059,"_31190":2710,"_21615":60447,"_5":14871,"_28382":59571,"_3078":60448},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3626":3060,"_31190":2710,"_21615":60450,"_5":14871,"_28382":59571,"_3078":60451},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3626":3061,"_31190":2710,"_21615":60453,"_5":14871,"_28382":59571,"_3078":60454},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3626":3062,"_31190":2710,"_21615":60456,"_5":14871,"_28382":59571,"_3078":60457},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3626":3063,"_31190":2710,"_21615":60459,"_5":14871,"_28382":59571,"_3078":60460},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3626":3064,"_31190":2710,"_21615":60462,"_5":14871,"_28382":59571,"_3078":60463},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3626":3065,"_31190":2710,"_21615":60465,"_5":14871,"_28382":59571,"_3078":60466},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3626":3066,"_31190":2710,"_21615":60468,"_5":14871,"_28382":59571,"_3078":60469},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3626":3067,"_31190":2710,"_21615":60471,"_5":14871,"_28382":59571,"_3078":60472},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3626":3068,"_31190":2710,"_21615":60474,"_5":14871,"_28382":59571,"_3078":60475},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3626":3069,"_31190":2710,"_21615":60477,"_5":14871,"_28382":59575,"_3078":60478},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3626":3070,"_31190":2710,"_21615":60480,"_5":14871,"_28382":59575,"_3078":60481},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3626":3071,"_31190":2710,"_21615":60483,"_5":14871,"_28382":59575,"_3078":60484},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3626":3072,"_31190":2710,"_21615":60486,"_5":14871,"_28382":59575,"_3078":60487},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3626":3073,"_31190":2710,"_21615":60489,"_5":14871,"_28382":59575,"_3078":60490},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60493":60494,"_60495":60496,"_60497":60498,"_60499":60500,"_18752":3113,"_72750":3113},"language","english","sortableProperties",[3078,31190,5,28382],"sortablePropertiesWithTypes",{"_3078":25801,"_31190":25801,"_5":25801,"_28382":25801},"sorts",{"_3078":60501,"_31190":63564,"_5":66626,"_28382":69688},{"_4828":60502,"_60503":60504,"_5":25801},{"_14952":7235,"_15331":7157,"_15350":3551,"_30190":3459,"_15337":13749,"_20527":6852,"_14973":4236,"_14980":5366,"_30132":20831,"_30540":6248,"_30567":4932,"_30166":4985,"_35595":4370,"_30269":7824,"_30611":5124,"_35602":30782,"_35605":7343,"_35608":17157,"_35611":4158,"_31013":7807,"_35616":7883,"_35618":7892,"_31048":19468,"_15346":13922,"_35622":3687,"_35625":4542,"_35627":6438,"_30595":5959,"_31033":7952,"_31061":5182,"_35632":13856,"_35634":3481,"_35636":4938,"_30280":3179,"_35639":5345,"_35641":20825,"_35643":5340,"_35645":3807,"_35647":23808,"_30203":7961,"_35650":10837,"_35652":3483,"_30197":7928,"_30632":7494,"_35656":4380,"_35658":7781,"_35661":5154,"_30243":6980,"_35665":5178,"_30123":15410,"_35668":4965,"_30171":7259,"_35671":6062,"_35673":14495,"_35676":4464,"_15340":10461,"_35679":7314,"_35681":4034,"_35684":24361,"_35686":4792,"_35688":6303,"_35690":11367,"_35692":21793,"_20530":16105,"_35695":4163,"_35697":4381,"_30144":6981,"_305