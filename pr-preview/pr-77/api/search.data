6":50893,"_28346":15},"Deploy from AWS Marketplace",[50890,50891,50892],"Docs","Deployment","Other models",[],{"_3612":16,"_31165":15,"_21586":50895,"_5":14831,"_28346":15,"_3068":50896},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3612":17,"_31165":15,"_5":31520,"_21586":50898,"_28346":50899,"_3068":50900},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3612":18,"_31165":15,"_5":31520,"_21586":50902,"_28346":50903,"_3068":50904},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3612":19,"_31165":15,"_5":31520,"_21586":50906,"_28346":50907,"_3068":50908},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3612":20,"_31165":15,"_5":31520,"_21586":50910,"_28346":50911,"_3068":50912},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3612":21,"_31165":15,"_5":31520,"_21586":50914,"_28346":50915,"_3068":50916},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3612":22,"_31165":15,"_5":31520,"_21586":50918,"_28346":50919,"_3068":50920},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3612":23,"_31165":15,"_5":31520,"_21586":50922,"_28346":50923,"_3068":50924},[],"/docs/pr-preview/pr-77/deployment/aws-marketplace#next-step","Next step",{"_3612":24,"_31165":15,"_21586":50926,"_5":14831,"_28346":15,"_3068":50927},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3612":25,"_31165":15,"_21586":50929,"_5":14831,"_28346":50899,"_3068":50930},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3612":26,"_31165":15,"_21586":50932,"_5":14831,"_28346":50899,"_3068":50933},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3612":27,"_31165":15,"_21586":50935,"_5":14831,"_28346":50899,"_3068":50936},[],"A security group allowing the necessary endpoints.",{"_3612":28,"_31165":15,"_21586":50938,"_5":14831,"_28346":50903,"_3068":50939},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3612":29,"_31165":15,"_21586":50941,"_5":14831,"_28346":50903,"_3068":50942},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3612":30,"_31165":15,"_21586":50944,"_5":14831,"_28346":50903,"_3068":50945},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3612":31,"_31165":15,"_21586":50947,"_5":14831,"_28346":50907,"_3068":50948},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3612":32,"_31165":15,"_21586":50950,"_5":14831,"_28346":50911,"_3068":50951},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3612":33,"_31165":15,"_21586":50953,"_5":14831,"_28346":50915,"_3068":50954},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3612":34,"_31165":15,"_21586":50956,"_5":14831,"_28346":50919,"_3068":50957},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3612":35,"_31165":15,"_21586":50959,"_5":14831,"_28346":50923,"_3068":50960},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3612":36,"_31165":36,"_5":15196,"_3068":50962,"_31523":50963,"_21586":50964,"_28346":36},"Deploy Lamassu",[50890,50891],[],{"_3612":37,"_31165":36,"_21586":50966,"_5":14831,"_28346":36,"_3068":50967},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3612":38,"_31165":36,"_5":31520,"_21586":50969,"_28346":50970,"_3068":50971},[],"/docs/pr-preview/pr-77/deployment/overview#choose-a-model","Choose a model",{"_3612":39,"_31165":36,"_5":31520,"_21586":50973,"_28346":50974,"_3068":50975},[],"/docs/pr-preview/pr-77/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3612":40,"_31165":36,"_5":31520,"_21586":50977,"_28346":50978,"_3068":50979},[],"/docs/pr-preview/pr-77/deployment/overview#after-deployment","After deployment",{"_3612":41,"_31165":36,"_21586":50981,"_5":14831,"_28346":36,"_3068":50982},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3612":42,"_31165":36,"_21586":50984,"_5":14831,"_28346":50970,"_3068":50985},[],"Model",{"_3612":43,"_31165":36,"_21586":50987,"_5":14831,"_28346":50970,"_3068":50988},[],"Recommended for",{"_3612":44,"_31165":36,"_21586":50990,"_5":14831,"_28346":50970,"_3068":50991},[],"Who operates the infrastructure",{"_3612":45,"_31165":36,"_21586":50993,"_5":14831,"_28346":50970,"_3068":50994},[],"Starting point",{"_3612":46,"_31165":36,"_21586":50996,"_5":14831,"_28346":50970,"_3068":50997},[],"Kubernetes self-managed",{"_3612":47,"_31165":36,"_21586":50999,"_5":14831,"_28346":50970,"_3068":51000},[],"Production, regulated environments and custom deployments",{"_3612":48,"_31165":36,"_21586":51002,"_5":14831,"_28346":50970,"_3068":51003},[],"Your team",{"_3612":49,"_31165":36,"_21586":51005,"_5":14831,"_28346":50970,"_3068":51006},[],"Helm or Fastlane",{"_3612":50,"_31165":36,"_21586":51008,"_5":14831,"_28346":50970,"_3068":51009},[],"AWS Marketplace",{"_3612":51,"_31165":36,"_21586":51011,"_5":14831,"_28346":50970,"_3068":51012},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3612":52,"_31165":36,"_21586":51014,"_5":14831,"_28346":50970,"_3068":51003},[],{"_3612":53,"_31165":36,"_21586":51016,"_5":14831,"_28346":50970,"_3068":51017},[],"Preconfigured image on EC2",{"_3612":54,"_31165":36,"_21586":51019,"_5":14831,"_28346":50970,"_3068":51020},[],"SaaS",{"_3612":55,"_31165":36,"_21586":51022,"_5":14831,"_28346":50970,"_3068":51023},[],"Teams that want to use the platform without operating it",{"_3612":56,"_31165":36,"_21586":51025,"_5":14831,"_28346":50970,"_3068":51026},[],"Lamassu",{"_3612":57,"_31165":36,"_21586":51028,"_5":14831,"_28346":50970,"_3068":51029},[],"Managed subscription",{"_3612":58,"_31165":36,"_21586":51031,"_5":14831,"_28346":50970,"_3068":51032},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3612":59,"_31165":36,"_21586":51034,"_5":14831,"_28346":50970,"_3068":51035},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3612":60,"_31165":36,"_21586":51037,"_5":14831,"_28346":50970,"_3068":51038},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3612":61,"_31165":36,"_21586":51040,"_5":14831,"_28346":50974,"_3068":51041},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3612":62,"_31165":36,"_21586":51043,"_5":14831,"_28346":50978,"_3068":51044},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3612":63,"_31165":63,"_5":15196,"_3068":51046,"_31523":51047,"_21586":51048,"_28346":63},"Use Lamassu as SaaS",[50890,50891,50892],[],{"_3612":64,"_31165":63,"_21586":51050,"_5":14831,"_28346":63,"_3068":51051},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3612":65,"_31165":63,"_5":31520,"_21586":51053,"_28346":51054,"_3068":51055},[],"/docs/pr-preview/pr-77/deployment/saas#what-the-service-manages","What the service manages",{"_3612":66,"_31165":63,"_5":31520,"_21586":51057,"_28346":51058,"_3068":51059},[],"/docs/pr-preview/pr-77/deployment/saas#plans","Plans",{"_3612":67,"_31165":63,"_5":31520,"_21586":51061,"_28346":51062,"_3068":51063},[],"/docs/pr-preview/pr-77/deployment/saas#request-access","Request access",{"_3612":68,"_31165":63,"_21586":51065,"_5":14831,"_28346":63,"_3068":51066},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3612":69,"_31165":63,"_21586":51068,"_5":14831,"_28346":51054,"_3068":51069},[],"Platform availability and maintenance.",{"_3612":70,"_31165":63,"_21586":51071,"_5":14831,"_28346":51054,"_3068":51072},[],"Automatic backups.",{"_3612":71,"_31165":63,"_21586":51074,"_5":14831,"_28346":51054,"_3068":51075},[],"Version upgrades.",{"_3612":72,"_31165":63,"_21586":51077,"_5":14831,"_28346":51054,"_3068":51078},[],"Technical support and SLA according to your plan.",{"_3612":73,"_31165":63,"_21586":51080,"_5":14831,"_28346":51058,"_3068":51081},[],"Plan",{"_3612":74,"_31165":63,"_21586":51083,"_5":14831,"_28346":51058,"_3068":51084},[],"Devices",{"_3612":75,"_31165":63,"_21586":51086,"_5":14831,"_28346":51058,"_3068":51087},[],"Support",{"_3612":76,"_31165":63,"_21586":51089,"_5":14831,"_28346":51058,"_3068":51090},[],"SLA",{"_3612":77,"_31165":63,"_21586":51092,"_5":14831,"_28346":51058,"_3068":51093},[],"Starter",{"_3612":78,"_31165":63,"_21586":51095,"_5":14831,"_28346":51058,"_3068":51096},[],"Up to 1,000",{"_3612":79,"_31165":63,"_21586":51098,"_5":14831,"_28346":51058,"_3068":51099},[],"Email",{"_3612":80,"_31165":63,"_21586":51101,"_5":14831,"_28346":51058,"_3068":51102},[],"99.5 %",{"_3612":81,"_31165":63,"_21586":51104,"_5":14831,"_28346":51058,"_3068":51105},[],"Professional",{"_3612":82,"_31165":63,"_21586":51107,"_5":14831,"_28346":51058,"_3068":51108},[],"Up to 10,000",{"_3612":83,"_31165":63,"_21586":51110,"_5":14831,"_28346":51058,"_3068":51111},[],"Email and chat",{"_3612":84,"_31165":63,"_21586":51113,"_5":14831,"_28346":51058,"_3068":51114},[],"99.9 %",{"_3612":85,"_31165":63,"_21586":51116,"_5":14831,"_28346":51058,"_3068":51117},[],"Enterprise",{"_3612":86,"_31165":63,"_21586":51119,"_5":14831,"_28346":51058,"_3068":51120},[],"Unlimited",{"_3612":87,"_31165":63,"_21586":51122,"_5":14831,"_28346":51058,"_3068":51123},[],"Dedicated",{"_3612":88,"_31165":63,"_21586":51125,"_5":14831,"_28346":51058,"_3068":51126},[],"99.99 %",{"_3612":89,"_31165":63,"_21586":51128,"_5":14831,"_28346":51062,"_3068":51129},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3612":90,"_31165":63,"_21586":51131,"_5":14831,"_28346":51062,"_3068":51132},[],"When you receive your instance's credentials, continue with Get started.",{"_3612":91,"_31165":91,"_5":15196,"_3068":51134,"_31523":51135,"_21586":51136,"_28346":91},"Fastlane",[50890,50891,50997],[],{"_3612":92,"_31165":91,"_21586":51138,"_5":14831,"_28346":91,"_3068":51139},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3612":93,"_31165":91,"_5":31520,"_21586":51141,"_28346":51142,"_3068":51143},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3612":94,"_31165":91,"_5":31520,"_21586":51145,"_28346":51146,"_3068":51147},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3612":95,"_31165":91,"_5":31520,"_21586":51149,"_28346":51150,"_3068":50900},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#before-you-begin",{"_3612":96,"_31165":91,"_5":31520,"_21586":51152,"_28346":51153,"_3068":51154},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3612":97,"_31165":91,"_5":31520,"_21586":51156,"_28346":51157,"_3068":51158},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3612":98,"_31165":91,"_5":31520,"_21586":51160,"_28346":51161,"_3068":51162},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3612":99,"_31165":91,"_5":31520,"_21586":51164,"_28346":51165,"_3068":51166},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3612":100,"_31165":91,"_5":31520,"_21586":51168,"_28346":51169,"_3068":51170},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3612":101,"_31165":91,"_5":31520,"_21586":51172,"_28346":51173,"_3068":51174},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3612":102,"_31165":91,"_5":31520,"_21586":51176,"_28346":51177,"_3068":51178},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3612":103,"_31165":91,"_5":31520,"_21586":51180,"_28346":51181,"_3068":51182},[],"/docs/pr-preview/pr-77/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3612":104,"_31165":91,"_21586":51184,"_5":14831,"_28346":51142,"_3068":51185},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3612":105,"_31165":91,"_21586":51187,"_5":14831,"_28346":51142,"_3068":51188},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3612":106,"_31165":91,"_21586":51190,"_5":14831,"_28346":51146,"_3068":51191},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3612":107,"_31165":91,"_21586":51193,"_5":14831,"_28346":51146,"_3068":51194},[],"Fastlane installs or configures",{"_3612":108,"_31165":91,"_21586":51196,"_5":14831,"_28346":51146,"_3068":51197},[],"You still provide",{"_3612":109,"_31165":91,"_21586":51199,"_5":14831,"_28346":51146,"_3068":51200},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3612":110,"_31165":91,"_21586":51202,"_5":14831,"_28346":51146,"_3068":51203},[],"The Kubernetes cluster, nodes and persistent storage",{"_3612":111,"_31165":91,"_21586":51205,"_5":14831,"_28346":51146,"_3068":51206},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3612":112,"_31165":91,"_21586":51208,"_5":14831,"_28346":51146,"_3068":51209},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3612":113,"_31165":91,"_21586":51211,"_5":14831,"_28346":51146,"_3068":51212},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3612":114,"_31165":91,"_21586":51214,"_5":14831,"_28346":51146,"_3068":51215},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3612":115,"_31165":91,"_21586":51217,"_5":14831,"_28346":51146,"_3068":51218},[],"Optional observability and lab HSM components",{"_3612":116,"_31165":91,"_21586":51220,"_5":14831,"_28346":51146,"_3068":51221},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3612":117,"_31165":91,"_21586":51223,"_5":14831,"_28346":51146,"_3068":51224},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3612":118,"_31165":91,"_21586":51226,"_5":14831,"_28346":51150,"_3068":51227},[],"You need:",{"_3612":119,"_31165":91,"_21586":51229,"_5":14831,"_28346":51150,"_3068":51230},[],"an existing Kubernetes cluster",{"_3612":120,"_31165":91,"_21586":51232,"_5":14831,"_28346":51150,"_3068":51233},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3612":121,"_31165":91,"_21586":51235,"_5":14831,"_28346":51150,"_3068":51236},[],"`yq`",{"_3612":122,"_31165":91,"_21586":51238,"_5":14831,"_28346":51150,"_3068":24392},[],{"_3612":123,"_31165":91,"_21586":51240,"_5":14831,"_28346":51150,"_3068":51241},[],"`jq` only when using `--sample-data` or `--development`",{"_3612":124,"_31165":91,"_21586":51243,"_5":14831,"_28346":51150,"_3068":51244},[],"`ssh-keygen` only when using `--with-hsm`",{"_3612":125,"_31165":91,"_21586":51246,"_5":14831,"_28346":51150,"_3068":51247},[],"free external ports 80 and 443 on a single-node K3s host",{"_3612":126,"_31165":91,"_21586":51249,"_5":14831,"_28346":51150,"_3068":51250},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3612":127,"_31165":91,"_21586":51252,"_5":14831,"_28346":51150,"_3068":51253},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3612":128,"_31165":91,"_21586":51255,"_5":14831,"_28346":51153,"_3068":51256},[],"Run the script from a clone of the Helm repository:",{"_3612":129,"_31165":91,"_21586":51258,"_5":14831,"_28346":51153,"_3068":51259},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3612":130,"_31165":91,"_21586":51261,"_5":14831,"_28346":51157,"_3068":51262},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3612":131,"_31165":91,"_21586":51264,"_5":14831,"_28346":51157,"_3068":51265},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3612":132,"_31165":91,"_21586":51267,"_5":14831,"_28346":51157,"_3068":51268},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3612":133,"_31165":91,"_21586":51270,"_5":14831,"_28346":51157,"_3068":51271},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3612":134,"_31165":91,"_21586":51273,"_5":14831,"_28346":51161,"_3068":51274},[],"Option",{"_3612":135,"_31165":91,"_21586":51276,"_5":14831,"_28346":51161,"_3068":51277},[],"Default",{"_3612":136,"_31165":91,"_21586":51279,"_5":14831,"_28346":51161,"_3068":51280},[],"Purpose",{"_3612":137,"_31165":91,"_21586":51282,"_5":14831,"_28346":51161,"_3068":51283},[],"`-h`, `--help`",{"_3612":138,"_31165":91,"_21586":51285,"_5":14831,"_28346":51161,"_3068":51286},[],"—",{"_3612":139,"_31165":91,"_21586":51288,"_5":14831,"_28346":51161,"_3068":51289},[],"Show help",{"_3612":140,"_31165":91,"_21586":51291,"_5":14831,"_28346":51161,"_3068":51292},[],"`-c`, `--context`",{"_3612":141,"_31165":91,"_21586":51294,"_5":14831,"_28346":51161,"_3068":51295},[],"current context",{"_3612":142,"_31165":91,"_21586":51297,"_5":14831,"_28346":51161,"_3068":51298},[],"Select the kubeconfig context for kubectl and Helm",{"_3612":143,"_31165":91,"_21586":51300,"_5":14831,"_28346":51161,"_3068":51301},[],"`-n`, `--non-interactive`",{"_3612":144,"_31165":91,"_21586":51303,"_5":14831,"_28346":51161,"_3068":6776},[],{"_3612":145,"_31165":91,"_21586":51305,"_5":14831,"_28346":51161,"_3068":51306},[],"Skip prompts and generate dependency credentials",{"_3612":146,"_31165":91,"_21586":51308,"_5":14831,"_28346":51161,"_3068":51309},[],"`-ns`, `--namespace`",{"_3612":147,"_31165":91,"_21586":51311,"_5":14831,"_28346":51161,"_3068":51312},[],"`lamassu-dev`",{"_3612":148,"_31165":91,"_21586":51314,"_5":14831,"_28346":51161,"_3068":51315},[],"Namespace for the installation",{"_3612":149,"_31165":91,"_21586":51317,"_5":14831,"_28346":51161,"_3068":51318},[],"`-d`, `--domain`",{"_3612":150,"_31165":91,"_21586":51320,"_5":14831,"_28346":51161,"_3068":51321},[],"`dev.lamassu.io`",{"_3612":151,"_31165":91,"_21586":51323,"_5":14831,"_28346":51161,"_3068":51324},[],"Domain used by the UI, OIDC and certificate",{"_3612":152,"_31165":91,"_21586":51326,"_5":14831,"_28346":51161,"_3068":51327},[],"`-v`, `--version`",{"_3612":153,"_31165":91,"_21586":51329,"_5":14831,"_28346":51161,"_3068":15543},[],{"_3612":154,"_31165":91,"_21586":51331,"_5":14831,"_28346":51161,"_3068":51332},[],"Lamassu chart version",{"_3612":155,"_31165":91,"_21586":51334,"_5":14831,"_28346":51161,"_3068":51335},[],"`--https-port`",{"_3612":156,"_31165":91,"_21586":51337,"_5":14831,"_28346":51161,"_3068":51338},[],"`443`",{"_3612":157,"_31165":91,"_21586":51340,"_5":14831,"_28346":51161,"_3068":51341},[],"Gateway HTTPS listener port",{"_3612":158,"_31165":91,"_21586":51343,"_5":14831,"_28346":51161,"_3068":51344},[],"`--http-port`",{"_3612":159,"_31165":91,"_21586":51346,"_5":14831,"_28346":51161,"_3068":51347},[],"`80`",{"_3612":160,"_31165":91,"_21586":51349,"_5":14831,"_28346":51161,"_3068":51350},[],"Gateway HTTP listener port",{"_3612":161,"_31165":91,"_21586":51352,"_5":14831,"_28346":51161,"_3068":51353},[],"`--tls-crt`",{"_3612":162,"_31165":91,"_21586":51355,"_5":14831,"_28346":51161,"_3068":51286},[],{"_3612":163,"_31165":91,"_21586":51357,"_5":14831,"_28346":51161,"_3068":51358},[],"PEM certificate for downstream TLS",{"_3612":164,"_31165":91,"_21586":51360,"_5":14831,"_28346":51161,"_3068":51361},[],"`--tls-key`",{"_3612":165,"_31165":91,"_21586":51363,"_5":14831,"_28346":51161,"_3068":51286},[],{"_3612":166,"_31165":91,"_21586":51365,"_5":14831,"_28346":51161,"_3068":51366},[],"PEM private key for downstream TLS",{"_3612":167,"_31165":91,"_21586":51368,"_5":14831,"_28346":51161,"_3068":51369},[],"`-l`, `--local-chart-path`",{"_3612":168,"_31165":91,"_21586":51371,"_5":14831,"_28346":51161,"_3068":51372},[],"repository chart",{"_3612":169,"_31165":91,"_21586":51374,"_5":14831,"_28346":51161,"_3068":51375},[],"Use an unpacked local Lamassu chart",{"_3612":170,"_31165":91,"_21586":51377,"_5":14831,"_28346":51161,"_3068":51378},[],"`-ip`, `--gateway-ip`",{"_3612":171,"_31165":91,"_21586":51380,"_5":14831,"_28346":51161,"_3068":9062},[],{"_3612":172,"_31165":91,"_21586":51382,"_5":14831,"_28346":51161,"_3068":51383},[],"Override the address written to `gateway.addresses`",{"_3612":173,"_31165":91,"_21586":51385,"_5":14831,"_28346":51161,"_3068":51386},[],"`--otel`",{"_3612":174,"_31165":91,"_21586":51388,"_5":14831,"_28346":51161,"_3068":6776},[],{"_3612":175,"_31165":91,"_21586":51390,"_5":14831,"_28346":51161,"_3068":51391},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3612":176,"_31165":91,"_21586":51393,"_5":14831,"_28346":51161,"_3068":51394},[],"`--development`",{"_3612":177,"_31165":91,"_21586":51396,"_5":14831,"_28346":51161,"_3068":6776},[],{"_3612":178,"_31165":91,"_21586":51398,"_5":14831,"_28346":51161,"_3068":51399},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3612":179,"_31165":91,"_21586":51401,"_5":14831,"_28346":51161,"_3068":51402},[],"`--sample-data`",{"_3612":180,"_31165":91,"_21586":51404,"_5":14831,"_28346":51161,"_3068":6776},[],{"_3612":181,"_31165":91,"_21586":51406,"_5":14831,"_28346":51161,"_3068":51407},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3612":182,"_31165":91,"_21586":51409,"_5":14831,"_28346":51161,"_3068":51410},[],"`--with-hsm`",{"_3612":183,"_31165":91,"_21586":51412,"_5":14831,"_28346":51161,"_3068":6776},[],{"_3612":184,"_31165":91,"_21586":51414,"_5":14831,"_28346":51161,"_3068":51415},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3612":185,"_31165":91,"_21586":51417,"_5":14831,"_28346":51161,"_3068":51418},[],"`--softhsm-chart-path`",{"_3612":186,"_31165":91,"_21586":51420,"_5":14831,"_28346":51161,"_3068":51421},[],"`./charts/softhsm`",{"_3612":187,"_31165":91,"_21586":51423,"_5":14831,"_28346":51161,"_3068":51424},[],"Use a different local SoftHSM chart",{"_3612":188,"_31165":91,"_21586":51426,"_5":14831,"_28346":51161,"_3068":51427},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3612":189,"_31165":91,"_21586":51429,"_5":14831,"_28346":51165,"_3068":51430},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3612":190,"_31165":91,"_21586":51432,"_5":14831,"_28346":51165,"_3068":51433},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3612":191,"_31165":91,"_21586":51435,"_5":14831,"_28346":51165,"_3068":51436},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3612":192,"_31165":91,"_21586":51438,"_5":14831,"_28346":51165,"_3068":51439},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3612":193,"_31165":91,"_21586":51441,"_5":14831,"_28346":51165,"_3068":51442},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3612":194,"_31165":91,"_21586":51444,"_5":14831,"_28346":51165,"_3068":51445},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3612":195,"_31165":91,"_21586":51447,"_5":14831,"_28346":51169,"_3068":51448},[],"Fastlane:",{"_3612":196,"_31165":91,"_21586":51450,"_5":14831,"_28346":51169,"_3068":51451},[],"validates local tools and the selected cluster",{"_3612":197,"_31165":91,"_21586":51453,"_5":14831,"_28346":51169,"_3068":51454},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3612":198,"_31165":91,"_21586":51456,"_5":14831,"_28346":51169,"_3068":51457},[],"creates the namespace",{"_3612":199,"_31165":91,"_21586":51459,"_5":14831,"_28346":51169,"_3068":51460},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3612":200,"_31165":91,"_21586":51462,"_5":14831,"_28346":51169,"_3068":51463},[],"installs PostgreSQL and creates the required databases",{"_3612":201,"_31165":91,"_21586":51465,"_5":14831,"_28346":51169,"_3068":51466},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3612":202,"_31165":91,"_21586":51468,"_5":14831,"_28346":51169,"_3068":51469},[],"installs RabbitMQ",{"_3612":203,"_31165":91,"_21586":51471,"_5":14831,"_28346":51169,"_3068":51472},[],"optionally installs observability and lab HSM components",{"_3612":204,"_31165":91,"_21586":51474,"_5":14831,"_28346":51169,"_3068":51475},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3612":205,"_31165":91,"_21586":51477,"_5":14831,"_28346":51169,"_3068":51478},[],"optionally loads sample data",{"_3612":206,"_31165":91,"_21586":51480,"_5":14831,"_28346":51169,"_3068":51481},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3612":207,"_31165":91,"_21586":51483,"_5":14831,"_28346":51173,"_3068":51484},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3612":208,"_31165":91,"_21586":51486,"_5":14831,"_28346":51173,"_3068":51487},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3612":209,"_31165":91,"_21586":51489,"_5":14831,"_28346":51177,"_3068":51490},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3612":210,"_31165":91,"_21586":51492,"_5":14831,"_28346":51177,"_3068":51493},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3612":211,"_31165":91,"_21586":51495,"_5":14831,"_28346":51177,"_3068":51496},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3612":212,"_31165":91,"_21586":51498,"_5":14831,"_28346":51177,"_3068":51499},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3612":213,"_31165":91,"_21586":51501,"_5":14831,"_28346":51181,"_3068":51502},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3612":214,"_31165":214,"_5":15196,"_3068":51504,"_31523":51505,"_21586":51506,"_28346":214},"Install with Helm",[50890,50891,50997],[],{"_3612":215,"_31165":214,"_21586":51508,"_5":14831,"_28346":214,"_3068":51509},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3612":216,"_31165":214,"_5":31520,"_21586":51511,"_28346":51512,"_3068":51513},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3612":217,"_31165":214,"_5":31520,"_21586":51515,"_28346":51516,"_3068":50900},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#before-you-begin",{"_3612":218,"_31165":214,"_5":31520,"_21586":51518,"_28346":51519,"_3068":51520},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3612":219,"_31165":214,"_5":31520,"_21586":51522,"_28346":51523,"_3068":51524},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3612":220,"_31165":214,"_5":31520,"_21586":51526,"_28346":51527,"_3068":51528},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3612":221,"_31165":214,"_5":31520,"_21586":51530,"_28346":51531,"_3068":51532},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3612":222,"_31165":214,"_5":31520,"_21586":51534,"_28346":51535,"_3068":51536},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3612":223,"_31165":214,"_5":31520,"_21586":51538,"_28346":51539,"_3068":51540},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3612":224,"_31165":214,"_5":31520,"_21586":51542,"_28346":51543,"_3068":51544},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3612":225,"_31165":214,"_5":31520,"_21586":51546,"_28346":51547,"_3068":51548},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3612":226,"_31165":214,"_5":31520,"_21586":51550,"_28346":51551,"_3068":51552},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3612":227,"_31165":214,"_5":31520,"_21586":51554,"_28346":51555,"_3068":51556},[],"/docs/pr-preview/pr-77/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3612":228,"_31165":214,"_21586":51558,"_5":14831,"_28346":51512,"_3068":51559},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3612":229,"_31165":214,"_21586":51561,"_5":14831,"_28346":51516,"_3068":51562},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3612":230,"_31165":214,"_21586":51564,"_5":14831,"_28346":51516,"_3068":51565},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3612":231,"_31165":214,"_21586":51567,"_5":14831,"_28346":51516,"_3068":51568},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3612":232,"_31165":214,"_21586":51570,"_5":14831,"_28346":51516,"_3068":51571},[],"a reachable RabbitMQ broker and credentials",{"_3612":233,"_31165":214,"_21586":51573,"_5":14831,"_28346":51516,"_3068":51574},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3612":234,"_31165":214,"_21586":51576,"_5":14831,"_28346":51516,"_3068":51577},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3612":235,"_31165":214,"_21586":51579,"_5":14831,"_28346":51516,"_3068":51580},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3612":236,"_31165":214,"_21586":51582,"_5":14831,"_28346":51516,"_3068":51583},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3612":237,"_31165":214,"_21586":51585,"_5":14831,"_28346":51516,"_3068":51586},[],"a StorageClass and an external traffic design",{"_3612":238,"_31165":214,"_21586":51588,"_5":14831,"_28346":51516,"_3068":51589},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3612":239,"_31165":214,"_21586":51591,"_5":14831,"_28346":51516,"_3068":51592},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3612":240,"_31165":214,"_21586":51594,"_5":14831,"_28346":51516,"_3068":51595},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3612":241,"_31165":214,"_21586":51597,"_5":14831,"_28346":51519,"_3068":51598},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3612":242,"_31165":214,"_21586":51600,"_5":14831,"_28346":51519,"_3068":51601},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3612":243,"_31165":214,"_21586":51603,"_5":14831,"_28346":51519,"_3068":51604},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3612":244,"_31165":214,"_21586":51606,"_5":14831,"_28346":51523,"_3068":51607},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3612":245,"_31165":214,"_21586":51609,"_5":14831,"_28346":51523,"_3068":51610},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3612":246,"_31165":214,"_21586":51612,"_5":14831,"_28346":51523,"_3068":51613},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3612":247,"_31165":214,"_21586":51615,"_5":14831,"_28346":51523,"_3068":51616},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3612":248,"_31165":214,"_21586":51618,"_5":14831,"_28346":51527,"_3068":51619},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3612":249,"_31165":214,"_21586":51621,"_5":14831,"_28346":51527,"_3068":51622},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3612":250,"_31165":214,"_21586":51624,"_5":14831,"_28346":51527,"_3068":51625},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3612":251,"_31165":214,"_21586":51627,"_5":14831,"_28346":51527,"_3068":51628},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3612":252,"_31165":214,"_21586":51630,"_5":14831,"_28346":51527,"_3068":51631},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3612":253,"_31165":214,"_21586":51633,"_5":14831,"_28346":51527,"_3068":51634},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3612":254,"_31165":214,"_21586":51636,"_5":14831,"_28346":51527,"_3068":51637},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3612":255,"_31165":214,"_21586":51639,"_5":14831,"_28346":51527,"_3068":51640},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3612":256,"_31165":214,"_21586":51642,"_5":14831,"_28346":51531,"_3068":51643},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3612":257,"_31165":214,"_21586":51645,"_5":14831,"_28346":51535,"_3068":51646},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3612":258,"_31165":214,"_21586":51648,"_5":14831,"_28346":51535,"_3068":51649},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3612":259,"_31165":214,"_21586":51651,"_5":14831,"_28346":51535,"_3068":51652},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3612":260,"_31165":214,"_21586":51654,"_5":14831,"_28346":51535,"_3068":51655},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3612":261,"_31165":214,"_21586":51657,"_5":14831,"_28346":51535,"_3068":51658},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3612":262,"_31165":214,"_21586":51660,"_5":14831,"_28346":51535,"_3068":51661},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3612":263,"_31165":214,"_21586":51663,"_5":14831,"_28346":51535,"_3068":51664},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3612":264,"_31165":214,"_21586":51666,"_5":14831,"_28346":51539,"_3068":51667},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3612":265,"_31165":214,"_21586":51669,"_5":14831,"_28346":51539,"_3068":51670},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3612":266,"_31165":214,"_21586":51672,"_5":14831,"_28346":51539,"_3068":51673},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3612":267,"_31165":214,"_21586":51675,"_5":14831,"_28346":51539,"_3068":51676},[],"See Access control for the principal and policy model.",{"_3612":268,"_31165":214,"_21586":51678,"_5":14831,"_28346":51543,"_3068":51679},[],"To install a local checkout instead:",{"_3612":269,"_31165":214,"_21586":51681,"_5":14831,"_28346":51547,"_3068":51682},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3612":270,"_31165":214,"_21586":51684,"_5":14831,"_28346":51547,"_3068":51685},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3612":271,"_31165":214,"_21586":51687,"_5":14831,"_28346":51551,"_3068":51688},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3612":272,"_31165":214,"_21586":51690,"_5":14831,"_28346":51551,"_3068":51691},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3612":273,"_31165":214,"_21586":51693,"_5":14831,"_28346":51551,"_3068":51694},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3612":274,"_31165":214,"_21586":51696,"_5":14831,"_28346":51551,"_3068":51697},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3612":275,"_31165":214,"_21586":51699,"_5":14831,"_28346":51551,"_3068":51700},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3612":276,"_31165":214,"_21586":51702,"_5":14831,"_28346":51555,"_3068":51703},[],"Before going live, review:",{"_3612":277,"_31165":214,"_21586":51705,"_5":14831,"_28346":51555,"_3068":51706},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3612":278,"_31165":214,"_21586":51708,"_5":14831,"_28346":51555,"_3068":51709},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3612":279,"_31165":214,"_21586":51711,"_5":14831,"_28346":51555,"_3068":51712},[],"shared VA storage before increasing VA replicas",{"_3612":280,"_31165":214,"_21586":51714,"_5":14831,"_28346":51555,"_3068":51715},[],"managed OIDC roles and removal of evaluation credentials",{"_3612":281,"_31165":214,"_21586":51717,"_5":14831,"_28346":51555,"_3068":51718},[],"a trusted TLS issuer or externally managed certificate",{"_3612":282,"_31165":214,"_21586":51720,"_5":14831,"_28346":51555,"_3068":51721},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3612":283,"_31165":214,"_21586":51723,"_5":14831,"_28346":51555,"_3068":51724},[],"SMTP, observability and alert delivery",{"_3612":284,"_31165":214,"_21586":51726,"_5":14831,"_28346":51555,"_3068":51727},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3612":285,"_31165":214,"_21586":51729,"_5":14831,"_28346":51555,"_3068":51730},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3612":286,"_31165":286,"_5":15196,"_3068":51732,"_31523":51733,"_21586":51734,"_28346":286},"Expose the Gateway",[50890,50891,50997],[],{"_3612":287,"_31165":286,"_21586":51736,"_5":14831,"_28346":286,"_3068":51737},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3612":288,"_31165":286,"_5":31520,"_21586":51739,"_28346":51740,"_3068":51741},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3612":289,"_31165":286,"_5":31520,"_21586":51743,"_28346":51744,"_3068":51745},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3612":290,"_31165":286,"_5":31520,"_21586":51747,"_28346":51748,"_3068":51749},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3612":291,"_31165":286,"_5":31520,"_21586":51751,"_28346":51752,"_3068":51753},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#k3s","K3s",{"_3612":292,"_31165":286,"_5":31520,"_21586":51755,"_28346":51756,"_3068":51757},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3612":293,"_31165":286,"_5":31520,"_21586":51759,"_28346":51760,"_3068":51761},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3612":294,"_31165":286,"_5":31520,"_21586":51763,"_28346":51764,"_3068":51765},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3612":295,"_31165":286,"_5":31520,"_21586":51767,"_28346":51768,"_3068":51769},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3612":296,"_31165":286,"_5":31520,"_21586":51771,"_28346":51772,"_3068":51773},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3612":297,"_31165":286,"_5":31520,"_21586":51775,"_28346":51776,"_3068":51777},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3612":298,"_31165":286,"_5":31520,"_21586":51779,"_28346":51780,"_3068":51781},[],"/docs/pr-preview/pr-77/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3612":299,"_31165":286,"_21586":51783,"_5":14831,"_28346":51740,"_3068":51784},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3612":300,"_31165":286,"_21586":51786,"_5":14831,"_28346":51740,"_3068":51787},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3612":301,"_31165":286,"_21586":51789,"_5":14831,"_28346":51744,"_3068":51790},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3612":302,"_31165":286,"_21586":51792,"_5":14831,"_28346":51744,"_3068":51793},[],"Set it only when:",{"_3612":303,"_31165":286,"_21586":51795,"_5":14831,"_28346":51744,"_3068":51796},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3612":304,"_31165":286,"_21586":51798,"_5":14831,"_28346":51744,"_3068":51799},[],"that address is allocated to this Gateway",{"_3612":305,"_31165":286,"_21586":51801,"_5":14831,"_28346":51744,"_3068":51802},[],"the surrounding network already routes traffic for it to the cluster",{"_3612":306,"_31165":286,"_21586":51804,"_5":14831,"_28346":51744,"_3068":51805},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3612":307,"_31165":286,"_21586":51807,"_5":14831,"_28346":51744,"_3068":51808},[],"Keep these two settings separate:",{"_3612":308,"_31165":286,"_21586":51810,"_5":14831,"_28346":51744,"_3068":51811},[],"`gateway.addresses` requests an address for the Gateway.",{"_3612":309,"_31165":286,"_21586":51813,"_5":14831,"_28346":51744,"_3068":51814},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3612":310,"_31165":286,"_21586":51816,"_5":14831,"_28346":51744,"_3068":51817},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3612":311,"_31165":286,"_21586":51819,"_5":14831,"_28346":51748,"_3068":51820},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3612":312,"_31165":286,"_21586":51822,"_5":14831,"_28346":51748,"_3068":51823},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3612":313,"_31165":286,"_21586":51825,"_5":14831,"_28346":51752,"_3068":51826},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3612":314,"_31165":286,"_21586":51828,"_5":14831,"_28346":51752,"_3068":51829},[],"For the recommended design:",{"_3612":315,"_31165":286,"_21586":51831,"_5":14831,"_28346":51752,"_3068":51832},[],"Use only one externally exposed Lamassu Gateway.",{"_3612":316,"_31165":286,"_21586":51834,"_5":14831,"_28346":51752,"_3068":51835},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3612":317,"_31165":286,"_21586":51837,"_5":14831,"_28346":51752,"_3068":51838},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3612":318,"_31165":286,"_21586":51840,"_5":14831,"_28346":51752,"_3068":51841},[],"Point DNS at the VM's reachable address.",{"_3612":319,"_31165":286,"_21586":51843,"_5":14831,"_28346":51752,"_3068":51844},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3612":320,"_31165":286,"_21586":51846,"_5":14831,"_28346":51756,"_3068":51847},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3612":321,"_31165":286,"_21586":51849,"_5":14831,"_28346":51760,"_3068":51850},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3612":322,"_31165":286,"_21586":51852,"_5":14831,"_28346":51760,"_3068":51853},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3612":323,"_31165":286,"_21586":51855,"_5":14831,"_28346":51764,"_3068":51856},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3612":324,"_31165":286,"_21586":51858,"_5":14831,"_28346":51764,"_3068":51859},[],"Requirement",{"_3612":325,"_31165":286,"_21586":51861,"_5":14831,"_28346":51764,"_3068":51862},[],"Recommended design",{"_3612":326,"_31165":286,"_21586":51864,"_5":14831,"_28346":51764,"_3068":51865},[],"Consequence",{"_3612":327,"_31165":286,"_21586":51867,"_5":14831,"_28346":51764,"_3068":51868},[],"Several Lamassu URLs or services",{"_3612":328,"_31165":286,"_21586":51870,"_5":14831,"_28346":51764,"_3068":51871},[],"One Gateway with multiple routes",{"_3612":329,"_31165":286,"_21586":51873,"_5":14831,"_28346":51764,"_3068":51874},[],"One IP and one proxy fleet; this is the chart default",{"_3612":330,"_31165":286,"_21586":51876,"_5":14831,"_28346":51764,"_3068":51877},[],"Independent Gateways and separate external IPs",{"_3612":331,"_31165":286,"_21586":51879,"_5":14831,"_28346":51764,"_3068":51880},[],"One VIP per Gateway",{"_3612":332,"_31165":286,"_21586":51882,"_5":14831,"_28346":51764,"_3068":51883},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3612":333,"_31165":286,"_21586":51885,"_5":14831,"_28346":51764,"_3068":51886},[],"Independent Gateways on one node and one IP",{"_3612":334,"_31165":286,"_21586":51888,"_5":14831,"_28346":51764,"_3068":51889},[],"Use different external ports",{"_3612":335,"_31165":286,"_21586":51891,"_5":14831,"_28346":51764,"_3068":51892},[],"Clients must include non-standard ports",{"_3612":336,"_31165":286,"_21586":51894,"_5":14831,"_28346":51764,"_3068":51895},[],"Separate TLS/mTLS termination behind one IP",{"_3612":337,"_31165":286,"_21586":51897,"_5":14831,"_28346":51764,"_3068":51898},[],"Front-door SNI routing to internal Gateways",{"_3612":338,"_31165":286,"_21586":51900,"_5":14831,"_28346":51764,"_3068":51901},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3612":339,"_31165":286,"_21586":51903,"_5":14831,"_28346":51764,"_3068":51904},[],"Separate Gateway resources but shared proxy infrastructure",{"_3612":340,"_31165":286,"_21586":51906,"_5":14831,"_28346":51764,"_3068":51907},[],"Envoy merged-Gateway mode",{"_3612":341,"_31165":286,"_21586":51909,"_5":14831,"_28346":51764,"_3068":51910},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3612":342,"_31165":286,"_21586":51912,"_5":14831,"_28346":51764,"_3068":51913},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3612":343,"_31165":286,"_21586":51915,"_5":14831,"_28346":51764,"_3068":51916},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3612":344,"_31165":286,"_21586":51918,"_5":14831,"_28346":51764,"_3068":51919},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3612":345,"_31165":286,"_21586":51921,"_5":14831,"_28346":51764,"_3068":51922},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3612":346,"_31165":286,"_21586":51924,"_5":14831,"_28346":51768,"_3068":51925},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3612":347,"_31165":286,"_21586":51927,"_5":14831,"_28346":51772,"_3068":51928},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3612":348,"_31165":286,"_21586":51930,"_5":14831,"_28346":51772,"_3068":51931},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3612":349,"_31165":286,"_21586":51933,"_5":14831,"_28346":51772,"_3068":51934},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3612":350,"_31165":286,"_21586":51936,"_5":14831,"_28346":51772,"_3068":51937},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3612":351,"_31165":286,"_21586":51939,"_5":14831,"_28346":51772,"_3068":51940},[],"If none of those are possible, use different external ports or change the external network design.",{"_3612":352,"_31165":286,"_21586":51942,"_5":14831,"_28346":51776,"_3068":51943},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3612":353,"_31165":286,"_21586":51945,"_5":14831,"_28346":51776,"_3068":51946},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3612":354,"_31165":286,"_21586":51948,"_5":14831,"_28346":51780,"_3068":51949},[],"Check, in order:",{"_3612":355,"_31165":286,"_21586":51951,"_5":14831,"_28346":51780,"_3068":51952},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3612":356,"_31165":286,"_21586":51954,"_5":14831,"_28346":51780,"_3068":51955},[],"Its status contains the expected address.",{"_3612":357,"_31165":286,"_21586":51957,"_5":14831,"_28346":51780,"_3068":51958},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3612":358,"_31165":286,"_21586":51960,"_5":14831,"_28346":51780,"_3068":51961},[],"Port 443 reaches that address from the client network.",{"_3612":359,"_31165":286,"_21586":51963,"_5":14831,"_28346":51780,"_3068":51964},[],"DNS resolves to the externally reachable endpoint.",{"_3612":360,"_31165":286,"_21586":51966,"_5":14831,"_28346":51780,"_3068":51967},[],"The certificate contains the DNS name or IP used by the client.",{"_3612":361,"_31165":286,"_21586":51969,"_5":14831,"_28346":51780,"_3068":51970},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3612":362,"_31165":362,"_5":15196,"_3068":50997,"_31523":51972,"_21586":51973,"_28346":362},[50890,50891,50997],[],{"_3612":363,"_31165":362,"_21586":51975,"_5":14831,"_28346":362,"_3068":51976},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3612":364,"_31165":362,"_5":31520,"_21586":51978,"_28346":51979,"_3068":51980},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3612":365,"_31165":362,"_5":31520,"_21586":51982,"_28346":51983,"_3068":51984},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3612":366,"_31165":362,"_5":31520,"_21586":51986,"_28346":51987,"_3068":51988},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3612":367,"_31165":362,"_5":31520,"_21586":51990,"_28346":51991,"_3068":51992},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3612":368,"_31165":362,"_5":31520,"_21586":51994,"_28346":51995,"_3068":51996},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3612":369,"_31165":362,"_5":31520,"_21586":51998,"_28346":51999,"_3068":52000},[],"/docs/pr-preview/pr-77/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3612":370,"_31165":362,"_21586":52002,"_5":14831,"_28346":51979,"_3068":52003},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3612":371,"_31165":362,"_21586":52005,"_5":14831,"_28346":51983,"_3068":52006},[],"Workflow",{"_3612":372,"_31165":362,"_21586":52008,"_5":14831,"_28346":51983,"_3068":52009},[],"Use it for",{"_3612":373,"_31165":362,"_21586":52011,"_5":14831,"_28346":51983,"_3068":52012},[],"What it installs",{"_3612":374,"_31165":362,"_21586":52014,"_5":14831,"_28346":51983,"_3068":52015},[],"Helm",{"_3612":375,"_31165":362,"_21586":52017,"_5":14831,"_28346":51983,"_3068":52018},[],"Production and controlled environments",{"_3612":376,"_31165":362,"_21586":52020,"_5":14831,"_28346":51983,"_3068":52021},[],"Lamassu services and Gateway API resources",{"_3612":377,"_31165":362,"_21586":52023,"_5":14831,"_28346":51983,"_3068":51134},[],{"_3612":378,"_31165":362,"_21586":52025,"_5":14831,"_28346":51983,"_3068":52026},[],"Evaluation, demos, CI and small lab clusters",{"_3612":379,"_31165":362,"_21586":52028,"_5":14831,"_28346":51983,"_3068":52029},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3612":380,"_31165":362,"_21586":52031,"_5":14831,"_28346":51987,"_3068":52032},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3612":381,"_31165":362,"_21586":52034,"_5":14831,"_28346":51987,"_3068":52035},[],"Area",{"_3612":382,"_31165":362,"_21586":52037,"_5":14831,"_28346":51987,"_3068":52038},[],"The Lamassu chart provides",{"_3612":383,"_31165":362,"_21586":52040,"_5":14831,"_28346":51987,"_3068":52041},[],"You provide",{"_3612":384,"_31165":362,"_21586":52043,"_5":14831,"_28346":51987,"_3068":52044},[],"Lamassu applications",{"_3612":385,"_31165":362,"_21586":52046,"_5":14831,"_28346":51987,"_3068":52047},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3612":386,"_31165":362,"_21586":52049,"_5":14831,"_28346":51987,"_3068":52050},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3612":387,"_31165":362,"_21586":52052,"_5":14831,"_28346":51987,"_3068":52053},[],"PostgreSQL data",{"_3612":388,"_31165":362,"_21586":52055,"_5":14831,"_28346":51987,"_3068":52056},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3612":389,"_31165":362,"_21586":52058,"_5":14831,"_28346":51987,"_3068":52059},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3612":390,"_31165":362,"_21586":52061,"_5":14831,"_28346":51987,"_3068":52062},[],"Messaging",{"_3612":391,"_31165":362,"_21586":52064,"_5":14831,"_28346":51987,"_3068":52065},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3612":392,"_31165":362,"_21586":52067,"_5":14831,"_28346":51987,"_3068":52068},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3612":393,"_31165":362,"_21586":52070,"_5":14831,"_28346":51987,"_3068":52071},[],"Identity",{"_3612":394,"_31165":362,"_21586":52073,"_5":14831,"_28346":51987,"_3068":52074},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3612":395,"_31165":362,"_21586":52076,"_5":14831,"_28346":51987,"_3068":52077},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3612":396,"_31165":362,"_21586":52079,"_5":14831,"_28346":51987,"_3068":52080},[],"External routing",{"_3612":397,"_31165":362,"_21586":52082,"_5":14831,"_28346":51987,"_3068":52083},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3612":398,"_31165":362,"_21586":52085,"_5":14831,"_28346":51987,"_3068":52086},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3612":399,"_31165":362,"_21586":52088,"_5":14831,"_28346":51987,"_3068":52089},[],"TLS",{"_3612":400,"_31165":362,"_21586":52091,"_5":14831,"_28346":51987,"_3068":52092},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3612":401,"_31165":362,"_21586":52094,"_5":14831,"_28346":51987,"_3068":52095},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3612":402,"_31165":362,"_21586":52097,"_5":14831,"_28346":51987,"_3068":52098},[],"Persistent application data",{"_3612":403,"_31165":362,"_21586":52100,"_5":14831,"_28346":51987,"_3068":52101},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3612":404,"_31165":362,"_21586":52103,"_5":14831,"_28346":51987,"_3068":52104},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3612":405,"_31165":362,"_21586":52106,"_5":14831,"_28346":51987,"_3068":52107},[],"Optional integrations",{"_3612":406,"_31165":362,"_21586":52109,"_5":14831,"_28346":51987,"_3068":52110},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3612":407,"_31165":362,"_21586":52112,"_5":14831,"_28346":51987,"_3068":52113},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3612":408,"_31165":362,"_21586":52115,"_5":14831,"_28346":51987,"_3068":52116},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3612":409,"_31165":362,"_21586":52118,"_5":14831,"_28346":51987,"_3068":52119},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3612":410,"_31165":362,"_21586":52121,"_5":14831,"_28346":51991,"_3068":52122},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3612":411,"_31165":362,"_21586":52124,"_5":14831,"_28346":51991,"_3068":52125},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3612":412,"_31165":362,"_21586":52127,"_5":14831,"_28346":51995,"_3068":52128},[],"Kubernetes 1.24 or newer",{"_3612":413,"_31165":362,"_21586":52130,"_5":14831,"_28346":51995,"_3068":52131},[],"Helm 3.2 or newer",{"_3612":414,"_31165":362,"_21586":52133,"_5":14831,"_28346":51995,"_3068":52134},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3612":415,"_31165":362,"_21586":52136,"_5":14831,"_28346":51995,"_3068":52137},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3612":416,"_31165":362,"_21586":52139,"_5":14831,"_28346":51995,"_3068":52140},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3612":417,"_31165":362,"_21586":52142,"_5":14831,"_28346":51995,"_3068":52143},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3612":418,"_31165":362,"_21586":52145,"_5":14831,"_28346":51995,"_3068":52146},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3612":419,"_31165":362,"_21586":52148,"_5":14831,"_28346":51999,"_3068":52149},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3612":420,"_31165":362,"_21586":52151,"_5":14831,"_28346":51999,"_3068":52152},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3612":421,"_31165":362,"_21586":52154,"_5":14831,"_28346":51999,"_3068":52155},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3612":422,"_31165":362,"_21586":52157,"_5":14831,"_28346":51999,"_3068":52158},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3612":423,"_31165":423,"_5":15196,"_3068":52160,"_31523":52161,"_21586":52163,"_28346":423},"Deployment troubleshooting",[50890,50891,52162],"Operations",[],{"_3612":424,"_31165":423,"_21586":52165,"_5":14831,"_28346":423,"_3068":52166},[],"Diagnose access, service health and infrastructure dependencies.",{"_3612":425,"_31165":423,"_5":31520,"_21586":52168,"_28346":52169,"_3068":52170},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3612":426,"_31165":423,"_5":31520,"_21586":52172,"_28346":52173,"_3068":52174},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3612":427,"_31165":423,"_5":31520,"_21586":52176,"_28346":52177,"_3068":52178},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3612":428,"_31165":423,"_5":31520,"_21586":52180,"_28346":52181,"_3068":52182},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3612":429,"_31165":423,"_5":31520,"_21586":52184,"_28346":52185,"_3068":52186},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3612":430,"_31165":423,"_5":31520,"_21586":52188,"_28346":52189,"_3068":52190},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3612":431,"_31165":423,"_5":31520,"_21586":52192,"_28346":52193,"_3068":52194},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3612":432,"_31165":423,"_5":31520,"_21586":52196,"_28346":52197,"_3068":52198},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3612":433,"_31165":423,"_5":31520,"_21586":52200,"_28346":52201,"_3068":52202},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3612":434,"_31165":423,"_5":31520,"_21586":52204,"_28346":52205,"_3068":52206},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3612":435,"_31165":423,"_5":31520,"_21586":52208,"_28346":52209,"_3068":52210},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3612":436,"_31165":423,"_5":31520,"_21586":52212,"_28346":52213,"_3068":52214},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3612":437,"_31165":423,"_5":31520,"_21586":52216,"_28346":52217,"_3068":52218},[],"/docs/pr-preview/pr-77/deployment/troubleshooting#observability","Observability",{"_3612":438,"_31165":423,"_21586":52220,"_5":14831,"_28346":423,"_3068":52221},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3612":439,"_31165":423,"_21586":52223,"_5":14831,"_28346":52173,"_3068":52224},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3612":440,"_31165":423,"_21586":52226,"_5":14831,"_28346":52177,"_3068":52227},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3612":441,"_31165":423,"_21586":52229,"_5":14831,"_28346":52181,"_3068":52230},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3612":442,"_31165":423,"_21586":52232,"_5":14831,"_28346":52185,"_3068":52233},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3612":443,"_31165":423,"_21586":52235,"_5":14831,"_28346":52189,"_3068":52236},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3612":444,"_31165":423,"_21586":52238,"_5":14831,"_28346":52193,"_3068":52239},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3612":445,"_31165":423,"_21586":52241,"_5":14831,"_28346":52193,"_3068":52242},[],"Also run the chart's connectivity test:",{"_3612":446,"_31165":423,"_21586":52244,"_5":14831,"_28346":52193,"_3068":52245},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3612":447,"_31165":423,"_21586":52247,"_5":14831,"_28346":52193,"_3068":52248},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3612":448,"_31165":423,"_21586":52250,"_5":14831,"_28346":52197,"_3068":52251},[],"If you receive a 401:",{"_3612":449,"_31165":423,"_21586":52253,"_5":14831,"_28346":52197,"_3068":52254},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3612":450,"_31165":423,"_21586":52256,"_5":14831,"_28346":52197,"_3068":52257},[],"verify issuer, audience and expiration of the token;",{"_3612":451,"_31165":423,"_21586":52259,"_5":14831,"_28346":52197,"_3068":52260},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3612":452,"_31165":423,"_21586":52262,"_5":14831,"_28346":52197,"_3068":52263},[],"check that the provider's public and internal routes point to the same realm.",{"_3612":453,"_31165":423,"_21586":52265,"_5":14831,"_28346":52197,"_3068":52266},[],"If login succeeds but the APIs return 403:",{"_3612":454,"_31165":423,"_21586":52268,"_5":14831,"_28346":52197,"_3068":52269},[],"inspect the token's real claims;",{"_3612":455,"_31165":423,"_21586":52271,"_5":14831,"_28346":52197,"_3068":52272},[],"confirm they match an active principal;",{"_3612":456,"_31165":423,"_21586":52274,"_5":14831,"_28346":52197,"_3068":52275},[],"review the policies granted to that principal;",{"_3612":457,"_31165":423,"_21586":52277,"_5":14831,"_28346":52197,"_3068":52278},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3612":458,"_31165":423,"_21586":52280,"_5":14831,"_28346":52197,"_3068":52281},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3612":459,"_31165":423,"_21586":52283,"_5":14831,"_28346":52201,"_3068":52284},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3612":460,"_31165":423,"_21586":52286,"_5":14831,"_28346":52201,"_3068":52287},[],"Locate the authz pod and Service.",{"_3612":461,"_31165":423,"_21586":52289,"_5":14831,"_28346":52201,"_3068":52290},[],"Check /health, logs and its database connection.",{"_3612":462,"_31165":423,"_21586":52292,"_5":14831,"_28346":52201,"_3068":52293},[],"Verify the DNS and port configured in externalAuthorization.",{"_3612":463,"_31165":423,"_21586":52295,"_5":14831,"_28346":52201,"_3068":52296},[],"Check the check route is /v1/ext\\_authz/check.",{"_3612":464,"_31165":423,"_21586":52298,"_5":14831,"_28346":52201,"_3068":52299},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3612":465,"_31165":423,"_21586":52301,"_5":14831,"_28346":52205,"_3068":52302},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3612":466,"_31165":423,"_21586":52304,"_5":14831,"_28346":52209,"_3068":52305},[],"Review kubectl describe pod first. Common causes are:",{"_3612":467,"_31165":423,"_21586":52307,"_5":14831,"_28346":52209,"_3068":52308},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3612":468,"_31165":423,"_21586":52310,"_5":14831,"_28346":52209,"_3068":52311},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3612":469,"_31165":423,"_21586":52313,"_5":14831,"_28346":52209,"_3068":52314},[],"unbound persistent volume;",{"_3612":470,"_31165":423,"_21586":52316,"_5":14831,"_28346":52209,"_3068":52317},[],"inaccessible image or incorrect pull policy;",{"_3612":471,"_31165":423,"_21586":52319,"_5":14831,"_28346":52209,"_3068":52320},[],"invalid cryptographic engine configuration;",{"_3612":472,"_31165":423,"_21586":52322,"_5":14831,"_28346":52209,"_3068":52323},[],"CPU or memory limits set too low;",{"_3612":473,"_31165":423,"_21586":52325,"_5":14831,"_28346":52209,"_3068":52326},[],"an incomplete prior migration.",{"_3612":474,"_31165":423,"_21586":52328,"_5":14831,"_28346":52209,"_3068":52329},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3612":475,"_31165":423,"_21586":52331,"_5":14831,"_28346":52209,"_3068":52332},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3612":476,"_31165":423,"_21586":52334,"_5":14831,"_28346":52209,"_3068":52335},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3612":477,"_31165":423,"_21586":52337,"_5":14831,"_28346":52213,"_3068":52338},[],"Domain and audit events depend on the bus publisher:",{"_3612":478,"_31165":423,"_21586":52340,"_5":14831,"_28346":52213,"_3068":52341},[],"verify it is enabled in the emitting service;",{"_3612":479,"_31165":423,"_21586":52343,"_5":14831,"_28346":52213,"_3068":52344},[],"check AMQP connectivity and credentials;",{"_3612":480,"_31165":423,"_21586":52346,"_5":14831,"_28346":52213,"_3068":52347},[],"review exchange, routing key, queues and consumers;",{"_3612":481,"_31165":423,"_21586":52349,"_5":14831,"_28346":52213,"_3068":52350},[],"inspect dead-letter queues;",{"_3612":482,"_31165":423,"_21586":52352,"_5":14831,"_28346":52213,"_3068":52353},[],"alert on orphan durable queues and backlog growth.",{"_3612":483,"_31165":423,"_21586":52355,"_5":14831,"_28346":52213,"_3068":52356},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3612":484,"_31165":423,"_21586":52358,"_5":14831,"_28346":52213,"_3068":52359},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3612":485,"_31165":423,"_21586":52361,"_5":14831,"_28346":52213,"_3068":52362},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3612":486,"_31165":423,"_21586":52364,"_5":14831,"_28346":52213,"_3068":52365},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3612":487,"_31165":423,"_21586":52367,"_5":14831,"_28346":52213,"_3068":52368},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3612":488,"_31165":423,"_21586":52370,"_5":14831,"_28346":52213,"_3068":52371},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3612":489,"_31165":423,"_21586":52373,"_5":14831,"_28346":52213,"_3068":52374},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3612":490,"_31165":423,"_21586":52376,"_5":14831,"_28346":52217,"_3068":52377},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3612":491,"_31165":423,"_21586":52379,"_5":14831,"_28346":52217,"_3068":52380},[],"Before closing an incident, record:",{"_3612":492,"_31165":423,"_21586":52382,"_5":14831,"_28346":52217,"_3068":52383},[],"the confirmed cause;",{"_3612":493,"_31165":423,"_21586":52385,"_5":14831,"_28346":52217,"_3068":52386},[],"the time scope and affected resources;",{"_3612":494,"_31165":423,"_21586":52388,"_5":14831,"_28346":52217,"_3068":52389},[],"the commands or queries used;",{"_3612":495,"_31165":423,"_21586":52391,"_5":14831,"_28346":52217,"_3068":52392},[],"the applied change and how to revert it;",{"_3612":496,"_31165":423,"_21586":52394,"_5":14831,"_28346":52217,"_3068":52395},[],"validation from a consumer;",{"_3612":497,"_31165":423,"_21586":52397,"_5":14831,"_28346":52217,"_3068":52398},[],"the preventive action and its owner.",{"_3612":498,"_31165":498,"_5":15196,"_3068":52400,"_31523":52401,"_21586":52405,"_28346":498},"Data model",[50890,52402,52403,52404],"Platform","Administration","Access control",[],{"_3612":499,"_31165":498,"_21586":52407,"_5":14831,"_28346":498,"_3068":52408},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3612":500,"_31165":498,"_5":31520,"_21586":52410,"_28346":52411,"_3068":52412},[],"/docs/pr-preview/pr-77/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3612":501,"_31165":498,"_5":31520,"_21586":52414,"_28346":52415,"_3068":52416},[],"/docs/pr-preview/pr-77/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3612":502,"_31165":498,"_21586":52418,"_5":14831,"_28346":498,"_3068":52419},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3612":503,"_31165":498,"_21586":52421,"_5":14831,"_28346":52411,"_3068":52422},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3612":504,"_31165":498,"_21586":52424,"_5":14831,"_28346":52411,"_3068":52425},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3612":505,"_31165":498,"_21586":52427,"_5":14831,"_28346":52411,"_3068":52428},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3612":506,"_31165":498,"_21586":52430,"_5":14831,"_28346":52415,"_3068":52431},[],"Entity (`schema_name.entity_type`)",{"_3612":507,"_31165":498,"_21586":52433,"_5":14831,"_28346":52415,"_3068":52434},[],"Table (`table_name`)",{"_3612":508,"_31165":498,"_21586":52436,"_5":14831,"_28346":52415,"_3068":52437},[],"Key (`primary_key`)",{"_3612":509,"_31165":498,"_21586":52439,"_5":14831,"_28346":52415,"_3068":52440},[],"`alerts.event`",{"_3612":510,"_31165":498,"_21586":52442,"_5":14831,"_28346":52415,"_3068":52443},[],"`events`",{"_3612":511,"_31165":498,"_21586":52445,"_5":14831,"_28346":52415,"_3068":52446},[],"`event_type`",{"_3612":512,"_31165":498,"_21586":52448,"_5":14831,"_28346":52415,"_3068":52449},[],"`alerts.subscription`",{"_3612":513,"_31165":498,"_21586":52451,"_5":14831,"_28346":52415,"_3068":52452},[],"`subscriptions`",{"_3612":514,"_31165":498,"_21586":52454,"_5":14831,"_28346":52415,"_3068":52455},[],"`id`",{"_3612":515,"_31165":498,"_21586":52457,"_5":14831,"_28346":52415,"_3068":52458},[],"`ca.ca_certificate`",{"_3612":516,"_31165":498,"_21586":52460,"_5":14831,"_28346":52415,"_3068":52461},[],"`ca_certificates`",{"_3612":517,"_31165":498,"_21586":52463,"_5":14831,"_28346":52415,"_3068":52455},[],{"_3612":518,"_31165":498,"_21586":52465,"_5":14831,"_28346":52415,"_3068":52466},[],"`ca.certificate`",{"_3612":519,"_31165":498,"_21586":52468,"_5":14831,"_28346":52415,"_3068":52469},[],"`certificates`",{"_3612":520,"_31165":498,"_21586":52471,"_5":14831,"_28346":52415,"_3068":52472},[],"`serial_number`",{"_3612":521,"_31165":498,"_21586":52474,"_5":14831,"_28346":52415,"_3068":52475},[],"`ca.issuance_profile`",{"_3612":522,"_31165":498,"_21586":52477,"_5":14831,"_28346":52415,"_3068":52478},[],"`issuance_profiles`",{"_3612":523,"_31165":498,"_21586":52480,"_5":14831,"_28346":52415,"_3068":52455},[],{"_3612":524,"_31165":498,"_21586":52482,"_5":14831,"_28346":52415,"_3068":52483},[],"`devicemanager.device_group`",{"_3612":525,"_31165":498,"_21586":52485,"_5":14831,"_28346":52415,"_3068":52486},[],"`device_groups`",{"_3612":526,"_31165":498,"_21586":52488,"_5":14831,"_28346":52415,"_3068":52455},[],{"_3612":527,"_31165":498,"_21586":52490,"_5":14831,"_28346":52415,"_3068":52491},[],"`devicemanager.device`",{"_3612":528,"_31165":498,"_21586":52493,"_5":14831,"_28346":52415,"_3068":52494},[],"`devices`",{"_3612":529,"_31165":498,"_21586":52496,"_5":14831,"_28346":52415,"_3068":52455},[],{"_3612":530,"_31165":498,"_21586":52498,"_5":14831,"_28346":52415,"_3068":52499},[],"`dmsmanager.dms`",{"_3612":531,"_31165":498,"_21586":52501,"_5":14831,"_28346":52415,"_3068":52502},[],"`dms`",{"_3612":532,"_31165":498,"_21586":52504,"_5":14831,"_28346":52415,"_3068":52455},[],{"_3612":533,"_31165":498,"_21586":52506,"_5":14831,"_28346":52415,"_3068":52507},[],"`kms.kms_key`",{"_3612":534,"_31165":498,"_21586":52509,"_5":14831,"_28346":52415,"_3068":52510},[],"`kms_keys`",{"_3612":535,"_31165":498,"_21586":52512,"_5":14831,"_28346":52415,"_3068":52513},[],"`key_id`, `engine_id`",{"_3612":536,"_31165":498,"_21586":52515,"_5":14831,"_28346":52415,"_3068":52516},[],"`va.crl_settings`",{"_3612":537,"_31165":498,"_21586":52518,"_5":14831,"_28346":52415,"_3068":52519},[],"`crl_settings`",{"_3612":538,"_31165":498,"_21586":52521,"_5":14831,"_28346":52415,"_3068":52522},[],"`ca_id`",{"_3612":539,"_31165":498,"_21586":52524,"_5":14831,"_28346":52415,"_3068":52525},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3612":540,"_31165":498,"_21586":52527,"_5":14831,"_28346":52415,"_3068":52528},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3612":541,"_31165":498,"_21586":52530,"_5":14831,"_28346":52415,"_3068":52531},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3612":542,"_31165":542,"_5":15196,"_3068":52533,"_31523":52534,"_21586":52535,"_28346":542},"Access control overview",[50890,52402,52403,52404],[],{"_3612":543,"_31165":542,"_21586":52537,"_5":14831,"_28346":542,"_3068":52538},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3612":544,"_31165":542,"_5":31520,"_21586":52540,"_28346":52541,"_3068":52542},[],"/docs/pr-preview/pr-77/platform/administration/access-control#essential-concepts","Essential concepts",{"_3612":545,"_31165":542,"_5":31520,"_21586":52544,"_28346":52545,"_3068":52546},[],"/docs/pr-preview/pr-77/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3612":546,"_31165":542,"_5":31520,"_21586":52548,"_28346":52549,"_3068":52550},[],"/docs/pr-preview/pr-77/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3612":547,"_31165":542,"_5":31520,"_21586":52552,"_28346":52553,"_3068":52554},[],"/docs/pr-preview/pr-77/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3612":548,"_31165":542,"_5":31520,"_21586":52556,"_28346":52557,"_3068":52558},[],"/docs/pr-preview/pr-77/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3612":549,"_31165":542,"_5":31520,"_21586":52560,"_28346":52561,"_3068":52562},[],"/docs/pr-preview/pr-77/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3612":550,"_31165":542,"_5":31520,"_21586":52564,"_28346":52565,"_3068":52566},[],"/docs/pr-preview/pr-77/platform/administration/access-control#oidc-principals","OIDC principals",{"_3612":551,"_31165":542,"_5":31520,"_21586":52568,"_28346":52569,"_3068":52570},[],"/docs/pr-preview/pr-77/platform/administration/access-control#x509-principals","X.509 principals",{"_3612":552,"_31165":542,"_5":31520,"_21586":52572,"_28346":52573,"_3068":52574},[],"/docs/pr-preview/pr-77/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3612":553,"_31165":542,"_5":31520,"_21586":52576,"_28346":52577,"_3068":52578},[],"/docs/pr-preview/pr-77/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3612":554,"_31165":542,"_5":31520,"_21586":52580,"_28346":52581,"_3068":52582},[],"/docs/pr-preview/pr-77/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3612":555,"_31165":542,"_5":31520,"_21586":52584,"_28346":52585,"_3068":52586},[],"/docs/pr-preview/pr-77/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3612":556,"_31165":542,"_5":31520,"_21586":52588,"_28346":52589,"_3068":52590},[],"/docs/pr-preview/pr-77/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3612":557,"_31165":542,"_5":31520,"_21586":52592,"_28346":52593,"_3068":52594},[],"/docs/pr-preview/pr-77/platform/administration/access-control#http-rules","HTTP rules",{"_3612":558,"_31165":542,"_5":31520,"_21586":52596,"_28346":52597,"_3068":52598},[],"/docs/pr-preview/pr-77/platform/administration/access-control#included-policies","Included policies",{"_3612":559,"_31165":542,"_5":31520,"_21586":52600,"_28346":52601,"_3068":51540},[],"/docs/pr-preview/pr-77/platform/administration/access-control#provision-the-first-administrator",{"_3612":560,"_31165":542,"_5":31520,"_21586":52603,"_28346":52604,"_3068":52605},[],"/docs/pr-preview/pr-77/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3612":561,"_31165":542,"_5":31520,"_21586":52607,"_28346":52608,"_3068":52609},[],"/docs/pr-preview/pr-77/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3612":562,"_31165":542,"_5":31520,"_21586":52611,"_28346":52612,"_3068":52613},[],"/docs/pr-preview/pr-77/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3612":563,"_31165":542,"_5":31520,"_21586":52615,"_28346":52616,"_3068":52617},[],"/docs/pr-preview/pr-77/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3612":564,"_31165":542,"_5":31520,"_21586":52619,"_28346":52620,"_3068":52621},[],"/docs/pr-preview/pr-77/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3612":565,"_31165":542,"_5":31520,"_21586":52623,"_28346":52624,"_3068":52625},[],"/docs/pr-preview/pr-77/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3612":566,"_31165":542,"_5":31520,"_21586":52627,"_28346":52628,"_3068":52629},[],"/docs/pr-preview/pr-77/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3612":567,"_31165":542,"_5":31520,"_21586":52631,"_28346":52632,"_3068":52633},[],"/docs/pr-preview/pr-77/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3612":568,"_31165":542,"_5":31520,"_21586":52635,"_28346":52636,"_3068":52637},[],"/docs/pr-preview/pr-77/platform/administration/access-control#operational-checklist","Operational checklist",{"_3612":569,"_31165":542,"_5":31520,"_21586":52639,"_28346":52640,"_3068":52641},[],"/docs/pr-preview/pr-77/platform/administration/access-control#diagnostics","Diagnostics",{"_3612":570,"_31165":542,"_5":31520,"_21586":52643,"_28346":52644,"_3068":52645},[],"/docs/pr-preview/pr-77/platform/administration/access-control#the-response-is-401","The response is 401",{"_3612":571,"_31165":542,"_5":31520,"_21586":52647,"_28346":52648,"_3068":52649},[],"/docs/pr-preview/pr-77/platform/administration/access-control#the-response-is-403","The response is 403",{"_3612":572,"_31165":542,"_5":31520,"_21586":52651,"_28346":52652,"_3068":52653},[],"/docs/pr-preview/pr-77/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3612":573,"_31165":542,"_5":31520,"_21586":52655,"_28346":52656,"_3068":52657},[],"/docs/pr-preview/pr-77/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3612":574,"_31165":542,"_5":31520,"_21586":52659,"_28346":52660,"_3068":52661},[],"/docs/pr-preview/pr-77/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3612":575,"_31165":542,"_21586":52663,"_5":14831,"_28346":542,"_3068":52664},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3612":576,"_31165":542,"_21586":52666,"_5":14831,"_28346":542,"_3068":52667},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3612":577,"_31165":542,"_21586":52669,"_5":14831,"_28346":542,"_3068":52670},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3612":578,"_31165":542,"_21586":52672,"_5":14831,"_28346":52541,"_3068":52673},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3612":579,"_31165":542,"_21586":52675,"_5":14831,"_28346":52541,"_3068":52676},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3612":580,"_31165":542,"_21586":52678,"_5":14831,"_28346":52541,"_3068":52679},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3612":581,"_31165":542,"_21586":52681,"_5":14831,"_28346":52541,"_3068":52682},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3612":582,"_31165":542,"_21586":52684,"_5":14831,"_28346":52541,"_3068":52685},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3612":583,"_31165":542,"_21586":52687,"_5":14831,"_28346":52541,"_3068":52688},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3612":584,"_31165":542,"_21586":52690,"_5":14831,"_28346":52545,"_3068":52691},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3612":585,"_31165":542,"_21586":52693,"_5":14831,"_28346":52545,"_3068":52694},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3612":586,"_31165":542,"_21586":52696,"_5":14831,"_28346":52549,"_3068":52697},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3612":587,"_31165":542,"_21586":52699,"_5":14831,"_28346":52549,"_3068":52700},[],"The decision is made **before forwarding the request to the service**:",{"_3612":588,"_31165":542,"_21586":52702,"_5":14831,"_28346":52549,"_3068":52703},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3612":589,"_31165":542,"_21586":52705,"_5":14831,"_28346":52549,"_3068":52706},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3612":590,"_31165":542,"_21586":52708,"_5":14831,"_28346":52549,"_3068":52709},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3612":591,"_31165":542,"_21586":52711,"_5":14831,"_28346":52549,"_3068":52712},[],"It separately loads the policies granted to each principal.",{"_3612":592,"_31165":542,"_21586":52714,"_5":14831,"_28346":52549,"_3068":52715},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3612":593,"_31165":542,"_21586":52717,"_5":14831,"_28346":52549,"_3068":52718},[],"`authz` looks for an HTTP rule granting that action.",{"_3612":594,"_31165":542,"_21586":52720,"_5":14831,"_28346":52549,"_3068":52721},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3612":595,"_31165":542,"_21586":52723,"_5":14831,"_28346":52549,"_3068":52724},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3612":596,"_31165":542,"_21586":52726,"_5":14831,"_28346":52549,"_3068":52727},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3612":597,"_31165":542,"_21586":52729,"_5":14831,"_28346":52549,"_3068":52730},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3612":598,"_31165":542,"_21586":52732,"_5":14831,"_28346":52553,"_3068":52733},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3612":599,"_31165":542,"_21586":52735,"_5":14831,"_28346":52553,"_3068":52736},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3612":600,"_31165":542,"_21586":52738,"_5":14831,"_28346":52553,"_3068":52739},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3612":601,"_31165":542,"_21586":52741,"_5":14831,"_28346":52553,"_3068":52742},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3612":602,"_31165":542,"_21586":52744,"_5":14831,"_28346":52553,"_3068":52745},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3612":603,"_31165":542,"_21586":52747,"_5":14831,"_28346":52553,"_3068":52748},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3612":604,"_31165":542,"_21586":52750,"_5":14831,"_28346":52553,"_3068":52751},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3612":605,"_31165":542,"_21586":52753,"_5":14831,"_28346":52553,"_3068":52754},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3612":606,"_31165":542,"_21586":52756,"_5":14831,"_28346":52553,"_3068":52757},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3612":607,"_31165":542,"_21586":52759,"_5":14831,"_28346":52553,"_3068":52760},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3612":608,"_31165":542,"_21586":52762,"_5":14831,"_28346":52557,"_3068":52763},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3612":609,"_31165":542,"_21586":52765,"_5":14831,"_28346":52557,"_3068":52766},[],"The decision is made with the domain operation context:",{"_3612":610,"_31165":542,"_21586":52768,"_5":14831,"_28346":52557,"_3068":52769},[],"The middleware extracts the credential and resolves the matching principals.",{"_3612":611,"_31165":542,"_21586":52771,"_5":14831,"_28346":52557,"_3068":52772},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3612":612,"_31165":542,"_21586":52774,"_5":14831,"_28346":52557,"_3068":52775},[],"`authz` gathers the entity rules of the granted policies.",{"_3612":613,"_31165":542,"_21586":52777,"_5":14831,"_28346":52557,"_3068":52778},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3612":614,"_31165":542,"_21586":52780,"_5":14831,"_28346":52557,"_3068":52781},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3612":615,"_31165":542,"_21586":52783,"_5":14831,"_28346":52557,"_3068":52784},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3612":616,"_31165":542,"_21586":52786,"_5":14831,"_28346":52557,"_3068":52787},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3612":617,"_31165":542,"_21586":52789,"_5":14831,"_28346":52557,"_3068":52790},[],"Actions fall into two groups:",{"_3612":618,"_31165":542,"_21586":52792,"_5":14831,"_28346":52557,"_3068":52793},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3612":619,"_31165":542,"_21586":52795,"_5":14831,"_28346":52557,"_3068":52796},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3612":620,"_31165":542,"_21586":52798,"_5":14831,"_28346":52557,"_3068":52799},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3612":621,"_31165":542,"_21586":52801,"_5":14831,"_28346":52561,"_3068":52802},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3612":622,"_31165":542,"_21586":52804,"_5":14831,"_28346":52561,"_3068":52805},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3612":623,"_31165":542,"_21586":52807,"_5":14831,"_28346":52561,"_3068":52808},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3612":624,"_31165":542,"_21586":52810,"_5":14831,"_28346":52565,"_3068":52811},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3612":625,"_31165":542,"_21586":52813,"_5":14831,"_28346":52565,"_3068":52814},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3612":626,"_31165":542,"_21586":52816,"_5":14831,"_28346":52565,"_3068":52817},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3612":627,"_31165":542,"_21586":52819,"_5":14831,"_28346":52565,"_3068":52820},[],"The implemented operators are:",{"_3612":628,"_31165":542,"_21586":52822,"_5":14831,"_28346":52565,"_3068":52823},[],"`equals`, for exact equality;",{"_3612":629,"_31165":542,"_21586":52825,"_5":14831,"_28346":52565,"_3068":52826},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3612":630,"_31165":542,"_21586":52828,"_5":14831,"_28346":52565,"_3068":52829},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3612":631,"_31165":542,"_21586":52831,"_5":14831,"_28346":52565,"_3068":52832},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3612":632,"_31165":542,"_21586":52834,"_5":14831,"_28346":52569,"_3068":52835},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3612":633,"_31165":542,"_21586":52837,"_5":14831,"_28346":52569,"_3068":52838},[],"The available modes are:",{"_3612":634,"_31165":542,"_21586":52840,"_5":14831,"_28346":52569,"_3068":52841},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3612":635,"_31165":542,"_21586":52843,"_5":14831,"_28346":52569,"_3068":52844},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3612":636,"_31165":542,"_21586":52846,"_5":14831,"_28346":52569,"_3068":52847},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3612":637,"_31165":542,"_21586":52849,"_5":14831,"_28346":52569,"_3068":52850},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3612":638,"_31165":542,"_21586":52852,"_5":14831,"_28346":52569,"_3068":52853},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3612":639,"_31165":542,"_21586":52855,"_5":14831,"_28346":52569,"_3068":52856},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3612":640,"_31165":542,"_21586":52858,"_5":14831,"_28346":52573,"_3068":52859},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3612":641,"_31165":542,"_21586":52861,"_5":14831,"_28346":52573,"_3068":52862},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3612":642,"_31165":542,"_21586":52864,"_5":14831,"_28346":52573,"_3068":52865},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3612":643,"_31165":542,"_21586":52867,"_5":14831,"_28346":52573,"_3068":52868},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3612":644,"_31165":542,"_21586":52870,"_5":14831,"_28346":52581,"_3068":52871},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3612":645,"_31165":542,"_21586":52873,"_5":14831,"_28346":52581,"_3068":52874},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3612":646,"_31165":542,"_21586":52876,"_5":14831,"_28346":52585,"_3068":52877},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3612":647,"_31165":542,"_21586":52879,"_5":14831,"_28346":52585,"_3068":52880},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3612":648,"_31165":542,"_21586":52882,"_5":14831,"_28346":52585,"_3068":52883},[],"The data model shows how the resources used in entity rules are connected.",{"_3612":649,"_31165":542,"_21586":52885,"_5":14831,"_28346":52585,"_3068":52886},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3612":650,"_31165":542,"_21586":52888,"_5":14831,"_28346":52585,"_3068":52889},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3612":651,"_31165":542,"_21586":52891,"_5":14831,"_28346":52589,"_3068":52892},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3612":652,"_31165":542,"_21586":52894,"_5":14831,"_28346":52589,"_3068":52895},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3612":653,"_31165":542,"_21586":52897,"_5":14831,"_28346":52589,"_3068":52898},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3612":654,"_31165":542,"_21586":52900,"_5":14831,"_28346":52593,"_3068":52901},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3612":655,"_31165":542,"_21586":52903,"_5":14831,"_28346":52593,"_3068":52904},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3612":656,"_31165":542,"_21586":52906,"_5":14831,"_28346":52593,"_3068":52907},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3612":657,"_31165":542,"_21586":52909,"_5":14831,"_28346":52593,"_3068":52910},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3612":658,"_31165":542,"_21586":52912,"_5":14831,"_28346":52593,"_3068":52913},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3612":659,"_31165":542,"_21586":52915,"_5":14831,"_28346":52593,"_3068":52916},[],"Note that:",{"_3612":660,"_31165":542,"_21586":52918,"_5":14831,"_28346":52593,"_3068":52919},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3612":661,"_31165":542,"_21586":52921,"_5":14831,"_28346":52593,"_3068":52922},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3612":662,"_31165":542,"_21586":52924,"_5":14831,"_28346":52593,"_3068":52925},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3612":663,"_31165":542,"_21586":52927,"_5":14831,"_28346":52597,"_3068":52928},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3612":664,"_31165":542,"_21586":52930,"_5":14831,"_28346":52597,"_3068":52931},[],"full and read-only access to certificates and authorities;",{"_3612":665,"_31165":542,"_21586":52933,"_5":14831,"_28346":52597,"_3068":52934},[],"full and read-only access to the KMS;",{"_3612":666,"_31165":542,"_21586":52936,"_5":14831,"_28346":52597,"_3068":52937},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3612":667,"_31165":542,"_21586":52939,"_5":14831,"_28346":52597,"_3068":52940},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3612":668,"_31165":542,"_21586":52942,"_5":14831,"_28346":52597,"_3068":52943},[],"console access;",{"_3612":669,"_31165":542,"_21586":52945,"_5":14831,"_28346":52597,"_3068":52946},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3612":670,"_31165":542,"_21586":52948,"_5":14831,"_28346":52597,"_3068":52949},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3612":671,"_31165":542,"_21586":52951,"_5":14831,"_28346":52597,"_3068":52952},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3612":672,"_31165":542,"_21586":52954,"_5":14831,"_28346":52597,"_3068":52955},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3612":673,"_31165":542,"_21586":52957,"_5":14831,"_28346":52597,"_3068":52958},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3612":674,"_31165":542,"_21586":52960,"_5":14831,"_28346":52601,"_3068":52961},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3612":675,"_31165":542,"_21586":52963,"_5":14831,"_28346":52601,"_3068":52964},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3612":676,"_31165":542,"_21586":52966,"_5":14831,"_28346":52601,"_3068":52967},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3612":677,"_31165":542,"_21586":52969,"_5":14831,"_28346":52604,"_3068":52970},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3612":678,"_31165":542,"_21586":52972,"_5":14831,"_28346":52608,"_3068":52973},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3612":679,"_31165":542,"_21586":52975,"_5":14831,"_28346":52608,"_3068":52976},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3612":680,"_31165":542,"_21586":52978,"_5":14831,"_28346":52612,"_3068":52979},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3612":681,"_31165":542,"_21586":52981,"_5":14831,"_28346":52616,"_3068":52982},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3612":682,"_31165":542,"_21586":52984,"_5":14831,"_28346":52620,"_3068":52985},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3612":683,"_31165":542,"_21586":52987,"_5":14831,"_28346":52624,"_3068":52988},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3612":684,"_31165":542,"_21586":52990,"_5":14831,"_28346":52624,"_3068":52991},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3612":685,"_31165":542,"_21586":52993,"_5":14831,"_28346":52628,"_3068":52994},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3612":686,"_31165":542,"_21586":52996,"_5":14831,"_28346":52628,"_3068":52997},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3612":687,"_31165":542,"_21586":52999,"_5":14831,"_28346":52628,"_3068":53000},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3612":688,"_31165":542,"_21586":53002,"_5":14831,"_28346":52628,"_3068":53003},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3612":689,"_31165":542,"_21586":53005,"_5":14831,"_28346":52628,"_3068":53006},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3612":690,"_31165":542,"_21586":53008,"_5":14831,"_28346":52628,"_3068":53009},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3612":691,"_31165":542,"_21586":53011,"_5":14831,"_28346":52628,"_3068":53012},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3612":692,"_31165":542,"_21586":53014,"_5":14831,"_28346":52628,"_3068":53015},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3612":693,"_31165":542,"_21586":53017,"_5":14831,"_28346":52632,"_3068":53018},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3612":694,"_31165":542,"_21586":53020,"_5":14831,"_28346":52632,"_3068":53021},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3612":695,"_31165":542,"_21586":53023,"_5":14831,"_28346":52632,"_3068":53024},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3612":696,"_31165":542,"_21586":53026,"_5":14831,"_28346":52636,"_3068":53027},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3612":697,"_31165":542,"_21586":53029,"_5":14831,"_28346":52636,"_3068":53030},[],"Use groups or stable roles for people and independent identities for automations.",{"_3612":698,"_31165":542,"_21586":53032,"_5":14831,"_28346":52636,"_3068":53033},[],"Keep at least two recovery administrators and test their access periodically.",{"_3612":699,"_31165":542,"_21586":53035,"_5":14831,"_28346":52636,"_3068":53036},[],"Review active principals, their matches and their grants after IdP changes.",{"_3612":700,"_31165":542,"_21586":53038,"_5":14831,"_28346":52636,"_3068":53039},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3612":701,"_31165":542,"_21586":53041,"_5":14831,"_28346":52636,"_3068":53042},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3612":702,"_31165":542,"_21586":53044,"_5":14831,"_28346":52636,"_3068":53045},[],"Always test one allowed and one denied operation for each role.",{"_3612":703,"_31165":542,"_21586":53047,"_5":14831,"_28346":52636,"_3068":53048},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3612":704,"_31165":542,"_21586":53050,"_5":14831,"_28346":52644,"_3068":53051},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3612":705,"_31165":542,"_21586":53053,"_5":14831,"_28346":52648,"_3068":53054},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3612":706,"_31165":542,"_21586":53056,"_5":14831,"_28346":52648,"_3068":53057},[],"that an active principal of the correct type exists;",{"_3612":707,"_31165":542,"_21586":53059,"_5":14831,"_28346":52648,"_3068":53060},[],"that the claim paths and values match the real token exactly;",{"_3612":708,"_31165":542,"_21586":53062,"_5":14831,"_28346":52648,"_3068":53063},[],"that all of the principal's conditions hold;",{"_3612":709,"_31165":542,"_21586":53065,"_5":14831,"_28346":52648,"_3068":53066},[],"that the principal has the expected policy granted;",{"_3612":710,"_31165":542,"_21586":53068,"_5":14831,"_28346":52648,"_3068":53069},[],"that the policy includes the action and the requested resource type or route;",{"_3612":711,"_31165":542,"_21586":53071,"_5":14831,"_28346":52648,"_3068":53072},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3612":712,"_31165":542,"_21586":53074,"_5":14831,"_28346":52648,"_3068":53075},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3612":713,"_31165":542,"_21586":53077,"_5":14831,"_28346":52648,"_3068":53078},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3612":714,"_31165":542,"_21586":53080,"_5":14831,"_28346":52652,"_3068":53081},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3612":715,"_31165":542,"_21586":53083,"_5":14831,"_28346":52656,"_3068":53084},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3612":716,"_31165":542,"_21586":53086,"_5":14831,"_28346":52660,"_3068":53087},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3612":717,"_31165":542,"_21586":53089,"_5":14831,"_28346":52660,"_3068":53090},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3612":718,"_31165":718,"_5":15196,"_3068":53092,"_31523":53093,"_21586":53094,"_28346":718},"Alerts and subscriptions",[50890,52402,52403],[],{"_3612":719,"_31165":718,"_21586":53096,"_5":14831,"_28346":718,"_3068":53097},[],"Send PKI events to people and external systems.",{"_3612":720,"_31165":718,"_5":31520,"_21586":53099,"_28346":53100,"_3068":53101},[],"/docs/pr-preview/pr-77/platform/administration/alerts#how-it-works","How it works",{"_3612":721,"_31165":718,"_5":31520,"_21586":53103,"_28346":53104,"_3068":53105},[],"/docs/pr-preview/pr-77/platform/administration/alerts#available-channels","Available channels",{"_3612":722,"_31165":718,"_5":31520,"_21586":53107,"_28346":53108,"_3068":53109},[],"/docs/pr-preview/pr-77/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3612":723,"_31165":718,"_5":31520,"_21586":53111,"_28346":53112,"_3068":53113},[],"/docs/pr-preview/pr-77/platform/administration/alerts#choose-the-event","Choose the event",{"_3612":724,"_31165":718,"_5":31520,"_21586":53115,"_28346":53116,"_3068":53117},[],"/docs/pr-preview/pr-77/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3612":725,"_31165":718,"_5":31520,"_21586":53119,"_28346":53120,"_3068":53121},[],"/docs/pr-preview/pr-77/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3612":726,"_31165":718,"_5":31520,"_21586":53123,"_28346":53124,"_3068":53125},[],"/docs/pr-preview/pr-77/platform/administration/alerts#review-and-activate","Review and activate",{"_3612":727,"_31165":718,"_5":31520,"_21586":53127,"_28346":53128,"_3068":53129},[],"/docs/pr-preview/pr-77/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3612":728,"_31165":718,"_5":31520,"_21586":53131,"_28346":53132,"_3068":53133},[],"/docs/pr-preview/pr-77/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3612":729,"_31165":718,"_5":31520,"_21586":53135,"_28346":53136,"_3068":53137},[],"/docs/pr-preview/pr-77/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3612":730,"_31165":718,"_5":31520,"_21586":53139,"_28346":53140,"_3068":53141},[],"/docs/pr-preview/pr-77/platform/administration/alerts#event-families","Event families",{"_3612":731,"_31165":718,"_21586":53143,"_5":14831,"_28346":718,"_3068":53144},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3612":732,"_31165":718,"_21586":53146,"_5":14831,"_28346":53100,"_3068":53147},[],"A service publishes a domain event.",{"_3612":733,"_31165":718,"_21586":53149,"_5":14831,"_28346":53100,"_3068":53150},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3612":734,"_31165":718,"_21586":53152,"_5":14831,"_28346":53100,"_3068":53153},[],"Each subscription's filter decides whether it should be notified.",{"_3612":735,"_31165":718,"_21586":53155,"_5":14831,"_28346":53100,"_3068":53156},[],"Lamassu delivers the event to the configured channel.",{"_3612":736,"_31165":718,"_21586":53158,"_5":14831,"_28346":53100,"_3068":53159},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3612":737,"_31165":718,"_21586":53161,"_5":14831,"_28346":53104,"_3068":53162},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3612":738,"_31165":718,"_21586":53164,"_5":14831,"_28346":53104,"_3068":53165},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3612":739,"_31165":718,"_21586":53167,"_5":14831,"_28346":53104,"_3068":53168},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3612":740,"_31165":718,"_21586":53170,"_5":14831,"_28346":53104,"_3068":53171},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3612":741,"_31165":718,"_21586":53173,"_5":14831,"_28346":53104,"_3068":53174},[],"`apikey_options` requires `header` and `key`.",{"_3612":742,"_31165":718,"_21586":53176,"_5":14831,"_28346":53104,"_3068":53177},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3612":743,"_31165":718,"_21586":53179,"_5":14831,"_28346":53104,"_3068":53180},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3612":744,"_31165":718,"_21586":53182,"_5":14831,"_28346":53104,"_3068":53183},[],"The alerts API reference documents the full `http_client` schema.",{"_3612":745,"_31165":718,"_21586":53185,"_5":14831,"_28346":53112,"_3068":53186},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3612":746,"_31165":718,"_21586":53188,"_5":14831,"_28346":53116,"_3068":53189},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3612":747,"_31165":718,"_21586":53191,"_5":14831,"_28346":53120,"_3068":53192},[],"Add a filter if you don't want to receive every instance of the event.",{"_3612":748,"_31165":718,"_21586":53194,"_5":14831,"_28346":53120,"_3068":53195},[],"**None** notifies all instances of the event.",{"_3612":749,"_31165":718,"_21586":53197,"_5":14831,"_28346":53120,"_3068":53198},[],"**JSON Path** evaluates one or more specific fields.",{"_3612":750,"_31165":718,"_21586":53200,"_5":14831,"_28346":53120,"_3068":53201},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3612":751,"_31165":718,"_21586":53203,"_5":14831,"_28346":53120,"_3068":53204},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3612":752,"_31165":718,"_21586":53206,"_5":14831,"_28346":53120,"_3068":53207},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3612":753,"_31165":718,"_21586":53209,"_5":14831,"_28346":53120,"_3068":53210},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3612":754,"_31165":718,"_21586":53212,"_5":14831,"_28346":53124,"_3068":53213},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3612":755,"_31165":718,"_21586":53215,"_5":14831,"_28346":53128,"_3068":53216},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3612":756,"_31165":718,"_21586":53218,"_5":14831,"_28346":53128,"_3068":53219},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3612":757,"_31165":718,"_21586":53221,"_5":14831,"_28346":53128,"_3068":53222},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3612":758,"_31165":718,"_21586":53224,"_5":14831,"_28346":53128,"_3068":53225},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3612":759,"_31165":718,"_21586":53227,"_5":14831,"_28346":53128,"_3068":53228},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3612":760,"_31165":718,"_21586":53230,"_5":14831,"_28346":53128,"_3068":53231},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3612":761,"_31165":718,"_21586":53233,"_5":14831,"_28346":53128,"_3068":53234},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3612":762,"_31165":718,"_21586":53236,"_5":14831,"_28346":53128,"_3068":53237},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3612":763,"_31165":718,"_21586":53239,"_5":14831,"_28346":53132,"_3068":53240},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3612":764,"_31165":718,"_21586":53242,"_5":14831,"_28346":53132,"_3068":53243},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3612":765,"_31165":718,"_21586":53245,"_5":14831,"_28346":53132,"_3068":53246},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3612":766,"_31165":718,"_21586":53248,"_5":14831,"_28346":53132,"_3068":53249},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3612":767,"_31165":718,"_21586":53251,"_5":14831,"_28346":53132,"_3068":53252},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3612":768,"_31165":718,"_21586":53254,"_5":14831,"_28346":53132,"_3068":53255},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3612":769,"_31165":718,"_21586":53257,"_5":14831,"_28346":53132,"_3068":53258},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3612":770,"_31165":718,"_21586":53260,"_5":14831,"_28346":53132,"_3068":53261},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3612":771,"_31165":718,"_21586":53263,"_5":14831,"_28346":53136,"_3068":53264},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3612":772,"_31165":718,"_21586":53266,"_5":14831,"_28346":53136,"_3068":53267},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3612":773,"_31165":718,"_21586":53269,"_5":14831,"_28346":53140,"_3068":53270},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3612":774,"_31165":718,"_21586":53272,"_5":14831,"_28346":53140,"_3068":53273},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3612":775,"_31165":718,"_21586":53275,"_5":14831,"_28346":53140,"_3068":53276},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3612":776,"_31165":718,"_21586":53278,"_5":14831,"_28346":53140,"_3068":53279},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3612":777,"_31165":718,"_21586":53281,"_5":14831,"_28346":53140,"_3068":53282},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3612":778,"_31165":718,"_21586":53284,"_5":14831,"_28346":53140,"_3068":53285},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3612":779,"_31165":718,"_21586":53287,"_5":14831,"_28346":53140,"_3068":53288},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3612":780,"_31165":718,"_21586":53290,"_5":14831,"_28346":53140,"_3068":53291},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3612":781,"_31165":718,"_21586":53293,"_5":14831,"_28346":53140,"_3068":53294},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3612":782,"_31165":718,"_21586":53296,"_5":14831,"_28346":53140,"_3068":53297},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3612":783,"_31165":783,"_5":15196,"_3068":53299,"_31523":53300,"_21586":53301,"_28346":783},"Audit logs",[50890,52402,52403],[],{"_3612":784,"_31165":783,"_21586":53303,"_5":14831,"_28346":783,"_3068":53304},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3612":785,"_31165":783,"_5":31520,"_21586":53306,"_28346":53307,"_3068":53308},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3612":786,"_31165":783,"_5":31520,"_21586":53310,"_28346":53311,"_3068":53312},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#coverage","Coverage",{"_3612":787,"_31165":783,"_5":31520,"_21586":53314,"_28346":53315,"_3068":53316},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3612":788,"_31165":783,"_5":31520,"_21586":53318,"_28346":53319,"_3068":53320},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3612":789,"_31165":783,"_5":31520,"_21586":53322,"_28346":53323,"_3068":53324},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3612":790,"_31165":783,"_5":31520,"_21586":53326,"_28346":53327,"_3068":53328},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3612":791,"_31165":783,"_5":31520,"_21586":53330,"_28346":53331,"_3068":53332},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3612":792,"_31165":783,"_5":31520,"_21586":53334,"_28346":53335,"_3068":53336},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3612":793,"_31165":783,"_5":31520,"_21586":53338,"_28346":53339,"_3068":53340},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3612":794,"_31165":783,"_5":31520,"_21586":53342,"_28346":53343,"_3068":53344},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3612":795,"_31165":783,"_5":31520,"_21586":53346,"_28346":53347,"_3068":53348},[],"/docs/pr-preview/pr-77/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3612":796,"_31165":783,"_21586":53350,"_5":14831,"_28346":783,"_3068":53351},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3612":797,"_31165":783,"_21586":53353,"_5":14831,"_28346":53307,"_3068":53354},[],"The audit body includes:",{"_3612":798,"_31165":783,"_21586":53356,"_5":14831,"_28346":53307,"_3068":53357},[],"input: data received by the operation;",{"_3612":799,"_31165":783,"_21586":53359,"_5":14831,"_28346":53307,"_3068":53360},[],"has\\_error: whether the service returned an error;",{"_3612":800,"_31165":783,"_21586":53362,"_5":14831,"_28346":53307,"_3068":53363},[],"output: produced result or error message;",{"_3612":801,"_31165":783,"_21586":53365,"_5":14831,"_28346":53307,"_3068":53366},[],"principals: identifiers of the principals that matched the request.",{"_3612":802,"_31165":783,"_21586":53368,"_5":14831,"_28346":53307,"_3068":53369},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3612":803,"_31165":783,"_21586":53371,"_5":14831,"_28346":53307,"_3068":53372},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3612":804,"_31165":783,"_21586":53374,"_5":14831,"_28346":53311,"_3068":53375},[],"The backend applies auditing to mutations of:",{"_3612":805,"_31165":783,"_21586":53377,"_5":14831,"_28346":53311,"_3068":53378},[],"authorities, certificates and issuance profiles;",{"_3612":806,"_31165":783,"_21586":53380,"_5":14831,"_28346":53311,"_3068":53381},[],"keys and KMS engines;",{"_3612":807,"_31165":783,"_21586":53383,"_5":14831,"_28346":53311,"_3068":53384},[],"devices and identities;",{"_3612":808,"_31165":783,"_21586":53386,"_5":14831,"_28346":53311,"_3068":53387},[],"DMSs and enrollment operations;",{"_3612":809,"_31165":783,"_21586":53389,"_5":14831,"_28346":53311,"_3068":53390},[],"validation functions and CRL;",{"_3612":810,"_31165":783,"_21586":53392,"_5":14831,"_28346":53311,"_3068":53393},[],"principals, policies and authorization grants.",{"_3612":811,"_31165":783,"_21586":53395,"_5":14831,"_28346":53311,"_3068":53396},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3612":812,"_31165":783,"_21586":53398,"_5":14831,"_28346":53315,"_3068":53399},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3612":813,"_31165":783,"_21586":53401,"_5":14831,"_28346":53315,"_3068":53402},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3612":814,"_31165":783,"_21586":53404,"_5":14831,"_28346":53315,"_3068":53405},[],"Design the consumer to:",{"_3612":815,"_31165":783,"_21586":53407,"_5":14831,"_28346":53315,"_3068":53408},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3612":816,"_31165":783,"_21586":53410,"_5":14831,"_28346":53315,"_3068":53411},[],"keep the complete CloudEvent unmodified;",{"_3612":817,"_31165":783,"_21586":53413,"_5":14831,"_28346":53315,"_3068":53414},[],"record the ingestion time and detect duplicates by ID;",{"_3612":818,"_31165":783,"_21586":53416,"_5":14831,"_28346":53315,"_3068":53417},[],"encrypt in transit and at rest;",{"_3612":819,"_31165":783,"_21586":53419,"_5":14831,"_28346":53315,"_3068":53420},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3612":820,"_31165":783,"_21586":53422,"_5":14831,"_28346":53315,"_3068":53423},[],"apply an explicit retention and legal hold policy;",{"_3612":821,"_31165":783,"_21586":53425,"_5":14831,"_28346":53315,"_3068":53426},[],"alert if it stops consuming or the pending queue grows.",{"_3612":822,"_31165":783,"_21586":53428,"_5":14831,"_28346":53319,"_3068":53429},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3612":823,"_31165":783,"_21586":53431,"_5":14831,"_28346":53319,"_3068":53432},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3612":824,"_31165":783,"_21586":53434,"_5":14831,"_28346":53327,"_3068":53435},[],"Start from the reported time and normalize every source to UTC.",{"_3612":825,"_31165":783,"_21586":53437,"_5":14831,"_28346":53331,"_3068":53438},[],"Filter by event type, service source and resource identifier.",{"_3612":826,"_31165":783,"_21586":53440,"_5":14831,"_28346":53335,"_3068":53441},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3612":827,"_31165":783,"_21586":53443,"_5":14831,"_28346":53339,"_3068":53444},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3612":828,"_31165":783,"_21586":53446,"_5":14831,"_28346":53343,"_3068":53447},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3612":829,"_31165":783,"_21586":53449,"_5":14831,"_28346":53347,"_3068":53450},[],"Generate a controlled mutation in a test environment and check that:",{"_3612":830,"_31165":783,"_21586":53452,"_5":14831,"_28346":53347,"_3068":53453},[],"a successful audit event appears;",{"_3612":831,"_31165":783,"_21586":53455,"_5":14831,"_28346":53347,"_3068":53456},[],"the principal matches the identity used;",{"_3612":832,"_31165":783,"_21586":53458,"_5":14831,"_28346":53347,"_3068":53459},[],"the consumer persists it exactly once;",{"_3612":833,"_31165":783,"_21586":53461,"_5":14831,"_28346":53347,"_3068":53462},[],"it can be retrieved by resource, actor and period;",{"_3612":834,"_31165":783,"_21586":53464,"_5":14831,"_28346":53347,"_3068":53465},[],"a consumer outage raises an alert.",{"_3612":835,"_31165":783,"_21586":53467,"_5":14831,"_28346":53347,"_3068":53468},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3612":836,"_31165":836,"_5":15196,"_3068":53470,"_31523":53471,"_21586":53472,"_28346":836},"Platform architecture",[50890,52402],[],{"_3612":837,"_31165":836,"_21586":53474,"_5":14831,"_28346":836,"_3068":53475},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3612":838,"_31165":836,"_5":31520,"_21586":53477,"_28346":53478,"_3068":53479},[],"/docs/pr-preview/pr-77/platform/concepts/architecture#control-plane","Control plane",{"_3612":839,"_31165":836,"_5":31520,"_21586":53481,"_28346":53482,"_3068":53483},[],"/docs/pr-preview/pr-77/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3612":840,"_31165":836,"_5":31520,"_21586":53485,"_28346":53486,"_3068":53487},[],"/docs/pr-preview/pr-77/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3612":841,"_31165":836,"_5":31520,"_21586":53489,"_28346":53490,"_3068":53491},[],"/docs/pr-preview/pr-77/platform/concepts/architecture#status-and-validation","Status and validation",{"_3612":842,"_31165":836,"_5":31520,"_21586":53493,"_28346":53494,"_3068":53495},[],"/docs/pr-preview/pr-77/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3612":843,"_31165":836,"_21586":53497,"_5":14831,"_28346":836,"_3068":53498},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3612":844,"_31165":836,"_21586":53500,"_5":14831,"_28346":836,"_3068":53501},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3612":845,"_31165":836,"_21586":53503,"_5":14831,"_28346":53478,"_3068":53504},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3612":846,"_31165":836,"_21586":53506,"_5":14831,"_28346":53482,"_3068":53507},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3612":847,"_31165":836,"_21586":53509,"_5":14831,"_28346":53486,"_3068":53510},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3612":848,"_31165":836,"_21586":53512,"_5":14831,"_28346":53490,"_3068":53513},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3612":849,"_31165":836,"_21586":53515,"_5":14831,"_28346":53494,"_3068":53516},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3612":850,"_31165":850,"_5":15196,"_3068":53518,"_31523":53519,"_21586":53520,"_28346":850},"How Lamassu works",[50890,52402],[],{"_3612":851,"_31165":850,"_21586":53522,"_5":14831,"_28346":850,"_3068":53523},[],"The mental model of trust, keys, certificates and devices.",{"_3612":852,"_31165":850,"_5":31520,"_21586":53525,"_28346":53526,"_3068":53527},[],"/docs/pr-preview/pr-77/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3612":853,"_31165":850,"_5":31520,"_21586":53529,"_28346":53530,"_3068":53531},[],"/docs/pr-preview/pr-77/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3612":854,"_31165":850,"_21586":53533,"_5":14831,"_28346":850,"_3068":53534},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3612":855,"_31165":850,"_21586":53536,"_5":14831,"_28346":53526,"_3068":53537},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3612":856,"_31165":850,"_21586":53539,"_5":14831,"_28346":53526,"_3068":53540},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3612":857,"_31165":850,"_21586":53542,"_5":14831,"_28346":53526,"_3068":53543},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3612":858,"_31165":850,"_21586":53545,"_5":14831,"_28346":53526,"_3068":53546},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3612":859,"_31165":850,"_21586":53548,"_5":14831,"_28346":53526,"_3068":53549},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3612":860,"_31165":850,"_21586":53551,"_5":14831,"_28346":53530,"_3068":53552},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3612":861,"_31165":850,"_21586":53554,"_5":14831,"_28346":53530,"_3068":53555},[],"A DMS relates that CA to an enrollment policy.",{"_3612":862,"_31165":850,"_21586":53557,"_5":14831,"_28346":53530,"_3068":53558},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3612":863,"_31165":850,"_21586":53560,"_5":14831,"_28346":53530,"_3068":53561},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3612":864,"_31165":850,"_21586":53563,"_5":14831,"_28346":53530,"_3068":53564},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3612":865,"_31165":850,"_21586":53566,"_5":14831,"_28346":53530,"_3068":53567},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3612":866,"_31165":850,"_21586":53569,"_5":14831,"_28346":53530,"_3068":53570},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3612":867,"_31165":867,"_5":15196,"_3068":53572,"_31523":53573,"_21586":53575,"_28346":867},"Devices and identities",[50890,52402,53574,53572],"IoT Fleets",[],{"_3612":868,"_31165":867,"_21586":53577,"_5":14831,"_28346":867,"_3068":53578},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3612":869,"_31165":867,"_5":31520,"_21586":53580,"_28346":53581,"_3068":53582},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#device-states","Device states",{"_3612":870,"_31165":867,"_5":31520,"_21586":53584,"_28346":53585,"_3068":53586},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3612":871,"_31165":867,"_5":31520,"_21586":53588,"_28346":53589,"_3068":53590},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3612":872,"_31165":867,"_5":31520,"_21586":53592,"_28346":53593,"_3068":53594},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3612":873,"_31165":867,"_5":31520,"_21586":53596,"_28346":53597,"_3068":53598},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3612":874,"_31165":867,"_5":31520,"_21586":53600,"_28346":53601,"_3068":53602},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3612":875,"_31165":867,"_5":31520,"_21586":53604,"_28346":53605,"_3068":53606},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3612":876,"_31165":867,"_5":31520,"_21586":53608,"_28346":53609,"_3068":53610},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3612":877,"_31165":867,"_5":31520,"_21586":53612,"_28346":53613,"_3068":53614},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3612":878,"_31165":867,"_5":31520,"_21586":53616,"_28346":53617,"_3068":53618},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3612":879,"_31165":867,"_5":31520,"_21586":53620,"_28346":53621,"_3068":53622},[],"/docs/pr-preview/pr-77/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3612":880,"_31165":867,"_21586":53624,"_5":14831,"_28346":867,"_3068":53625},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3612":881,"_31165":867,"_21586":53627,"_5":14831,"_28346":867,"_3068":53628},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3612":882,"_31165":867,"_21586":53630,"_5":14831,"_28346":53581,"_3068":53631},[],"Operational view",{"_3612":883,"_31165":867,"_21586":53633,"_5":14831,"_28346":53581,"_3068":53634},[],"Meaning",{"_3612":884,"_31165":867,"_21586":53636,"_5":14831,"_28346":53581,"_3068":53637},[],"**No Identity**",{"_3612":885,"_31165":867,"_21586":53639,"_5":14831,"_28346":53581,"_3068":53640},[],"A record exists without an associated identity.",{"_3612":886,"_31165":867,"_21586":53642,"_5":14831,"_28346":53581,"_3068":53643},[],"**Active**",{"_3612":887,"_31165":867,"_21586":53645,"_5":14831,"_28346":53581,"_3068":53646},[],"The slot is active; also check certificate dates, status and usages.",{"_3612":888,"_31165":867,"_21586":53648,"_5":14831,"_28346":53581,"_3068":53649},[],"**Renewal Pending**",{"_3612":889,"_31165":867,"_21586":53651,"_5":14831,"_28346":53581,"_3068":53652},[],"The identity is in the operational renewal window.",{"_3612":890,"_31165":867,"_21586":53654,"_5":14831,"_28346":53581,"_3068":53655},[],"**Expiring Soon**",{"_3612":891,"_31165":867,"_21586":53657,"_5":14831,"_28346":53581,"_3068":53658},[],"Expiration is approaching according to configured thresholds.",{"_3612":892,"_31165":867,"_21586":53660,"_5":14831,"_28346":53581,"_3068":53661},[],"**Expired**",{"_3612":893,"_31165":867,"_21586":53663,"_5":14831,"_28346":53581,"_3068":53664},[],"The identity has expired.",{"_3612":894,"_31165":867,"_21586":53666,"_5":14831,"_28346":53581,"_3068":53667},[],"**Revoked**",{"_3612":895,"_31165":867,"_21586":53669,"_5":14831,"_28346":53581,"_3068":53670},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3612":896,"_31165":867,"_21586":53672,"_5":14831,"_28346":53581,"_3068":53673},[],"**Decommissioned**",{"_3612":897,"_31165":867,"_21586":53675,"_5":14831,"_28346":53581,"_3068":53676},[],"The record is retired and ordinary updates do not restore operation.",{"_3612":898,"_31165":867,"_21586":53678,"_5":14831,"_28346":53581,"_3068":53679},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3612":899,"_31165":867,"_21586":53681,"_5":14831,"_28346":53585,"_3068":53682},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3612":900,"_31165":867,"_21586":53684,"_5":14831,"_28346":53585,"_3068":53685},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3612":901,"_31165":867,"_21586":53687,"_5":14831,"_28346":53585,"_3068":53688},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3612":902,"_31165":867,"_21586":53690,"_5":14831,"_28346":53585,"_3068":53691},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3612":903,"_31165":867,"_21586":53693,"_5":14831,"_28346":53589,"_3068":53694},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3612":904,"_31165":867,"_21586":53696,"_5":14831,"_28346":53593,"_3068":53697},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3612":905,"_31165":867,"_21586":53699,"_5":14831,"_28346":53597,"_3068":53700},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3612":906,"_31165":867,"_21586":53702,"_5":14831,"_28346":53601,"_3068":53703},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3612":907,"_31165":867,"_21586":53705,"_5":14831,"_28346":53605,"_3068":53706},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3612":908,"_31165":867,"_21586":53708,"_5":14831,"_28346":53605,"_3068":53709},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3612":909,"_31165":867,"_21586":53711,"_5":14831,"_28346":53609,"_3068":53712},[],"From **No Identity**, use **Assign Identity**:",{"_3612":910,"_31165":867,"_21586":53714,"_5":14831,"_28346":53609,"_3068":53715},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3612":911,"_31165":867,"_21586":53717,"_5":14831,"_28346":53609,"_3068":53718},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3612":912,"_31165":867,"_21586":53720,"_5":14831,"_28346":53609,"_3068":53721},[],"Confirm and read the serial, active version and history again.",{"_3612":913,"_31165":867,"_21586":53723,"_5":14831,"_28346":53609,"_3068":53724},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3612":914,"_31165":867,"_21586":53726,"_5":14831,"_28346":53609,"_3068":53727},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3612":915,"_31165":867,"_21586":53729,"_5":14831,"_28346":53613,"_3068":53730},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3612":916,"_31165":867,"_21586":53732,"_5":14831,"_28346":53613,"_3068":53733},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3612":917,"_31165":867,"_21586":53735,"_5":14831,"_28346":53613,"_3068":53736},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3612":918,"_31165":867,"_21586":53738,"_5":14831,"_28346":53617,"_3068":53739},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3612":919,"_31165":867,"_21586":53741,"_5":14831,"_28346":53617,"_3068":53742},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3612":920,"_31165":867,"_21586":53744,"_5":14831,"_28346":53617,"_3068":53745},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3612":921,"_31165":867,"_21586":53747,"_5":14831,"_28346":53617,"_3068":53748},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3612":922,"_31165":867,"_21586":53750,"_5":14831,"_28346":53621,"_3068":53751},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3612":923,"_31165":867,"_21586":53753,"_5":14831,"_28346":53621,"_3068":53754},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3612":924,"_31165":924,"_5":15196,"_3068":53756,"_31523":53757,"_21586":53759,"_28346":924},"Bootstrap identity and authentication",[50890,52402,53574,53572,53758],"Enrollment with PKI",[],{"_3612":925,"_31165":924,"_21586":53761,"_5":14831,"_28346":924,"_3068":53762},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3612":926,"_31165":924,"_5":31520,"_21586":53764,"_28346":53765,"_3068":53766},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3612":927,"_31165":924,"_5":31520,"_21586":53768,"_28346":53769,"_3068":53770},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3612":928,"_31165":924,"_5":31520,"_21586":53772,"_28346":53773,"_3068":53774},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3612":929,"_31165":924,"_5":31520,"_21586":53776,"_28346":53777,"_3068":53778},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3612":930,"_31165":924,"_5":31520,"_21586":53780,"_28346":53781,"_3068":53782},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3612":931,"_31165":924,"_21586":53784,"_5":14831,"_28346":924,"_3068":53785},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3612":932,"_31165":924,"_21586":53787,"_5":14831,"_28346":53765,"_3068":53788},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3612":933,"_31165":924,"_21586":53790,"_5":14831,"_28346":53765,"_3068":53791},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3612":934,"_31165":924,"_21586":53793,"_5":14831,"_28346":53769,"_3068":53794},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3612":935,"_31165":924,"_21586":53796,"_5":14831,"_28346":53769,"_3068":53797},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3612":936,"_31165":924,"_21586":53799,"_5":14831,"_28346":53769,"_3068":53800},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3612":937,"_31165":924,"_21586":53802,"_5":14831,"_28346":53773,"_3068":53803},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3612":938,"_31165":924,"_21586":53805,"_5":14831,"_28346":53773,"_3068":53806},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3612":939,"_31165":924,"_21586":53808,"_5":14831,"_28346":53777,"_3068":53809},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3612":940,"_31165":924,"_21586":53811,"_5":14831,"_28346":53777,"_3068":53812},[],"Example body:",{"_3612":941,"_31165":924,"_21586":53814,"_5":14831,"_28346":53777,"_3068":53815},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3612":942,"_31165":924,"_21586":53817,"_5":14831,"_28346":53777,"_3068":53818},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3612":943,"_31165":924,"_21586":53820,"_5":14831,"_28346":53777,"_3068":53821},[],"Continuation requires a successful HTTP response and JSON:",{"_3612":944,"_31165":924,"_21586":53823,"_5":14831,"_28346":53777,"_3068":53824},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3612":945,"_31165":924,"_21586":53826,"_5":14831,"_28346":53781,"_3068":53827},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3612":946,"_31165":924,"_21586":53829,"_5":14831,"_28346":53781,"_3068":53830},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3612":947,"_31165":947,"_5":15196,"_3068":53832,"_31523":53833,"_21586":53834,"_28346":947},"Configure and operate the DMS",[50890,52402,53574,53572,53758],[],{"_3612":948,"_31165":947,"_21586":53836,"_5":14831,"_28346":947,"_3068":53837},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3612":949,"_31165":947,"_5":31520,"_21586":53839,"_28346":53840,"_3068":50900},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3612":950,"_31165":947,"_5":31520,"_21586":53842,"_28346":53843,"_3068":53844},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3612":951,"_31165":947,"_5":31520,"_21586":53846,"_28346":53847,"_3068":53848},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3612":952,"_31165":947,"_5":31520,"_21586":53850,"_28346":53851,"_3068":53852},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3612":953,"_31165":947,"_5":31520,"_21586":53854,"_28346":53855,"_3068":53856},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3612":954,"_31165":947,"_5":31520,"_21586":53858,"_28346":53859,"_3068":53860},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3612":955,"_31165":947,"_5":31520,"_21586":53862,"_28346":53863,"_3068":53864},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3612":956,"_31165":947,"_5":31520,"_21586":53866,"_28346":53867,"_3068":53868},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3612":957,"_31165":947,"_5":31520,"_21586":53870,"_28346":53871,"_3068":53872},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3612":958,"_31165":947,"_5":31520,"_21586":53874,"_28346":53875,"_3068":53876},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3612":959,"_31165":947,"_5":31520,"_21586":53878,"_28346":53879,"_3068":53880},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3612":960,"_31165":947,"_5":31520,"_21586":53882,"_28346":53883,"_3068":53884},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3612":961,"_31165":947,"_5":31520,"_21586":53886,"_28346":53887,"_3068":53888},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3612":962,"_31165":947,"_5":31520,"_21586":53890,"_28346":53891,"_3068":53892},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3612":963,"_31165":947,"_5":31520,"_21586":53894,"_28346":53895,"_3068":53896},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3612":964,"_31165":947,"_5":31520,"_21586":53898,"_28346":53899,"_3068":53900},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3612":965,"_31165":947,"_5":31520,"_21586":53902,"_28346":53903,"_3068":53904},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3612":966,"_31165":947,"_5":31520,"_21586":53906,"_28346":53907,"_3068":53908},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3612":967,"_31165":947,"_21586":53910,"_5":14831,"_28346":947,"_3068":53911},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3612":968,"_31165":947,"_21586":53913,"_5":14831,"_28346":53840,"_3068":53914},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3612":969,"_31165":947,"_21586":53916,"_5":14831,"_28346":53840,"_3068":53917},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3612":970,"_31165":947,"_21586":53919,"_5":14831,"_28346":53847,"_3068":53920},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3612":971,"_31165":947,"_21586":53922,"_5":14831,"_28346":53851,"_3068":53923},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3612":972,"_31165":947,"_21586":53925,"_5":14831,"_28346":53855,"_3068":53926},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3612":973,"_31165":947,"_21586":53928,"_5":14831,"_28346":53859,"_3068":53929},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3612":974,"_31165":947,"_21586":53931,"_5":14831,"_28346":53863,"_3068":53932},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3612":975,"_31165":947,"_21586":53934,"_5":14831,"_28346":53871,"_3068":53935},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3612":976,"_31165":947,"_21586":53937,"_5":14831,"_28346":53871,"_3068":53938},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3612":977,"_31165":947,"_21586":53940,"_5":14831,"_28346":53875,"_3068":53941},[],"`settings.enrollment_settings` field",{"_3612":978,"_31165":947,"_21586":53943,"_5":14831,"_28346":53875,"_3068":53944},[],"Decision",{"_3612":979,"_31165":947,"_21586":53946,"_5":14831,"_28346":53875,"_3068":53947},[],"`protocol`",{"_3612":980,"_31165":947,"_21586":53949,"_5":14831,"_28346":53875,"_3068":53950},[],"`EST_RFC7030` for these operations.",{"_3612":981,"_31165":947,"_21586":53952,"_5":14831,"_28346":53875,"_3068":53953},[],"`enrollment_ca`",{"_3612":982,"_31165":947,"_21586":53955,"_5":14831,"_28346":53875,"_3068":53956},[],"ID of the signing CA.",{"_3612":983,"_31165":947,"_21586":53958,"_5":14831,"_28346":53875,"_3068":53959},[],"`verify_csr_signature`",{"_3612":984,"_31165":947,"_21586":53961,"_5":14831,"_28346":53875,"_3068":53962},[],"Keep `true` to verify CSR key possession.",{"_3612":985,"_31165":947,"_21586":53964,"_5":14831,"_28346":53875,"_3068":53965},[],"`enable_replaceable_enrollment`",{"_3612":986,"_31165":947,"_21586":53967,"_5":14831,"_28346":53875,"_3068":53968},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3612":987,"_31165":947,"_21586":53970,"_5":14831,"_28346":53875,"_3068":53971},[],"`est_rfc7030_settings.auth_mode`",{"_3612":988,"_31165":947,"_21586":53973,"_5":14831,"_28346":53875,"_3068":53974},[],"One of the four authentication modes.",{"_3612":989,"_31165":947,"_21586":53976,"_5":14831,"_28346":53875,"_3068":53977},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3612":990,"_31165":947,"_21586":53979,"_5":14831,"_28346":53879,"_3068":53980},[],"The blocks are independent:",{"_3612":991,"_31165":947,"_21586":53982,"_5":14831,"_28346":53879,"_3068":53983},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3612":992,"_31165":947,"_21586":53985,"_5":14831,"_28346":53879,"_3068":53986},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3612":993,"_31165":947,"_21586":53988,"_5":14831,"_28346":53879,"_3068":53989},[],"`auth_mode`",{"_3612":994,"_31165":947,"_21586":53991,"_5":14831,"_28346":53879,"_3068":53992},[],"Control applied in the configured operation",{"_3612":995,"_31165":947,"_21586":53994,"_5":14831,"_28346":53879,"_3068":53995},[],"`CLIENT_CERTIFICATE`",{"_3612":996,"_31165":947,"_21586":53997,"_5":14831,"_28346":53879,"_3068":53998},[],"Presented certificate validation.",{"_3612":997,"_31165":947,"_21586":54000,"_5":14831,"_28346":53879,"_3068":54001},[],"`EXTERNAL_WEBHOOK`",{"_3612":998,"_31165":947,"_21586":54003,"_5":14831,"_28346":53879,"_3068":54004},[],"Configured webhook authorization.",{"_3612":999,"_31165":947,"_21586":54006,"_5":14831,"_28346":53879,"_3068":54007},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3612":1000,"_31165":947,"_21586":54009,"_5":14831,"_28346":53879,"_3068":54010},[],"Certificate validation followed by webhook approval.",{"_3612":1001,"_31165":947,"_21586":54012,"_5":14831,"_28346":53879,"_3068":54013},[],"`NO_AUTH`",{"_3612":1002,"_31165":947,"_21586":54015,"_5":14831,"_28346":53879,"_3068":54016},[],"No DMS requester authentication.",{"_3612":1003,"_31165":947,"_21586":54018,"_5":14831,"_28346":53879,"_3068":54019},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3612":1004,"_31165":947,"_21586":54021,"_5":14831,"_28346":53879,"_3068":54022},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `allow_unverifiable_revocation` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3612":1005,"_31165":947,"_21586":54024,"_5":14831,"_28346":53879,"_3068":54025},[],"The authentication editor offers an **Allow certificates without revocation information** switch (`allow_unverifiable_revocation`, off by default). When it is on, certificates — and intermediate CAs of the chain — that Lamassu does not manage and that list no OCSP or CRL endpoint are accepted; unreachable, stale or inconclusive revocation answers are always rejected. While the switch is on, the console shows an amber warning: **Revocation will not be verified** — a revoked certificate with no OCSP or CRL endpoint, and not managed by Lamassu, will be accepted, and this also applies to the intermediate CAs of the chain.",{"_3612":1006,"_31165":947,"_21586":54027,"_5":14831,"_28346":53879,"_3068":54028},[],"The same switch is offered in both the enrollment and re-enrollment authentication editors and is stored per block inside `est_rfc7030_settings.client_certificate_settings`; a DMS stored before this field existed loads with the switch off. The console also shows an amber warning alert whenever an authentication option is in its insecure state — **Allow expired certificates** on, **Allow expired renewal** on or **Verify CSR signature** off — and the No authentication note is presented as a warning alert too.",{"_3612":1007,"_31165":947,"_21586":54030,"_5":14831,"_28346":53879,"_3068":54031},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3612":1008,"_31165":947,"_21586":54033,"_5":14831,"_28346":53879,"_3068":54034},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3612":1009,"_31165":947,"_21586":54036,"_5":14831,"_28346":53883,"_3068":54037},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3612":1010,"_31165":947,"_21586":54039,"_5":14831,"_28346":53883,"_3068":54040},[],"`external_webhook_settings` field",{"_3612":1011,"_31165":947,"_21586":54042,"_5":14831,"_28346":53883,"_3068":53944},[],{"_3612":1012,"_31165":947,"_21586":54044,"_5":14831,"_28346":53883,"_3068":54045},[],"`url`",{"_3612":1013,"_31165":947,"_21586":54047,"_5":14831,"_28346":53883,"_3068":54048},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3612":1014,"_31165":947,"_21586":54050,"_5":14831,"_28346":53883,"_3068":54051},[],"`method`",{"_3612":1015,"_31165":947,"_21586":54053,"_5":14831,"_28346":53883,"_3068":54054},[],"`POST` or `PUT`; `POST` by default.",{"_3612":1016,"_31165":947,"_21586":54056,"_5":14831,"_28346":53883,"_3068":54057},[],"`name`",{"_3612":1017,"_31165":947,"_21586":54059,"_5":14831,"_28346":53883,"_3068":54060},[],"Label used in service logs.",{"_3612":1018,"_31165":947,"_21586":54062,"_5":14831,"_28346":53883,"_3068":54063},[],"`config.auth_mode`",{"_3612":1019,"_31165":947,"_21586":54065,"_5":14831,"_28346":53883,"_3068":54066},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3612":1020,"_31165":947,"_21586":54068,"_5":14831,"_28346":53883,"_3068":54069},[],"`config.log_level`",{"_3612":1021,"_31165":947,"_21586":54071,"_5":14831,"_28346":53883,"_3068":54072},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3612":1022,"_31165":947,"_21586":54074,"_5":14831,"_28346":53883,"_3068":54075},[],"`config.apikey_options`",{"_3612":1023,"_31165":947,"_21586":54077,"_5":14831,"_28346":53883,"_3068":54078},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3612":1024,"_31165":947,"_21586":54080,"_5":14831,"_28346":53883,"_3068":54081},[],"`config.jwt_options`",{"_3612":1025,"_31165":947,"_21586":54083,"_5":14831,"_28346":53883,"_3068":54084},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3612":1026,"_31165":947,"_21586":54086,"_5":14831,"_28346":53883,"_3068":54087},[],"`config.mtls_options`",{"_3612":1027,"_31165":947,"_21586":54089,"_5":14831,"_28346":53883,"_3068":54090},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3612":1028,"_31165":947,"_21586":54092,"_5":14831,"_28346":53883,"_3068":54093},[],"`config.insecure_skip_verify`",{"_3612":1029,"_31165":947,"_21586":54095,"_5":14831,"_28346":53883,"_3068":54096},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3612":1030,"_31165":947,"_21586":54098,"_5":14831,"_28346":53883,"_3068":54099},[],"`config.call_timeout`",{"_3612":1031,"_31165":947,"_21586":54101,"_5":14831,"_28346":53883,"_3068":54102},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3612":1032,"_31165":947,"_21586":54104,"_5":14831,"_28346":53883,"_3068":54105},[],"Rules for that configuration:",{"_3612":1033,"_31165":947,"_21586":54107,"_5":14831,"_28346":53883,"_3068":54108},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3612":1034,"_31165":947,"_21586":54110,"_5":14831,"_28346":53883,"_3068":54111},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3612":1035,"_31165":947,"_21586":54113,"_5":14831,"_28346":53883,"_3068":54114},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3612":1036,"_31165":947,"_21586":54116,"_5":14831,"_28346":53883,"_3068":54117},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3612":1037,"_31165":947,"_21586":54119,"_5":14831,"_28346":53883,"_3068":54120},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3612":1038,"_31165":947,"_21586":54122,"_5":14831,"_28346":53883,"_3068":54123},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3612":1039,"_31165":947,"_21586":54125,"_5":14831,"_28346":53883,"_3068":54126},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3612":1040,"_31165":947,"_21586":54128,"_5":14831,"_28346":53883,"_3068":54129},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3612":1041,"_31165":947,"_21586":54131,"_5":14831,"_28346":53883,"_3068":54132},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3612":1042,"_31165":947,"_21586":54134,"_5":14831,"_28346":53887,"_3068":54135},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3612":1043,"_31165":947,"_21586":54137,"_5":14831,"_28346":53891,"_3068":54138},[],"`settings.reenrollment_settings` field",{"_3612":1044,"_31165":947,"_21586":54140,"_5":14831,"_28346":53891,"_3068":51280},[],{"_3612":1045,"_31165":947,"_21586":54142,"_5":14831,"_28346":53891,"_3068":54143},[],"`reenrollment_delta`",{"_3612":1046,"_31165":947,"_21586":54145,"_5":14831,"_28346":53891,"_3068":54146},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3612":1047,"_31165":947,"_21586":54148,"_5":14831,"_28346":53891,"_3068":54149},[],"`preventive_delta`",{"_3612":1048,"_31165":947,"_21586":54151,"_5":14831,"_28346":53891,"_3068":54152},[],"Preventive operational monitoring threshold.",{"_3612":1049,"_31165":947,"_21586":54154,"_5":14831,"_28346":53891,"_3068":54155},[],"`critical_delta`",{"_3612":1050,"_31165":947,"_21586":54157,"_5":14831,"_28346":53891,"_3068":54158},[],"Critical operational monitoring threshold.",{"_3612":1051,"_31165":947,"_21586":54160,"_5":14831,"_28346":53891,"_3068":54161},[],"`enable_expired_renewal`",{"_3612":1052,"_31165":947,"_21586":54163,"_5":14831,"_28346":53891,"_3068":54164},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3612":1053,"_31165":947,"_21586":54166,"_5":14831,"_28346":53891,"_3068":54167},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3612":1054,"_31165":947,"_21586":54169,"_5":14831,"_28346":53891,"_3068":54170},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3612":1055,"_31165":947,"_21586":54172,"_5":14831,"_28346":53891,"_3068":54173},[],"`revoke_on_reenrollment`",{"_3612":1056,"_31165":947,"_21586":54175,"_5":14831,"_28346":53891,"_3068":54176},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3612":1057,"_31165":947,"_21586":54178,"_5":14831,"_28346":53891,"_3068":54179},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3612":1058,"_31165":947,"_21586":54181,"_5":14831,"_28346":53895,"_3068":54182},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3612":1059,"_31165":947,"_21586":54184,"_5":14831,"_28346":53899,"_3068":51274},[],{"_3612":1060,"_31165":947,"_21586":54186,"_5":14831,"_28346":53899,"_3068":54187},[],"Published material",{"_3612":1061,"_31165":947,"_21586":54189,"_5":14831,"_28346":53899,"_3068":54190},[],"**Include Lamassu System CA**",{"_3612":1062,"_31165":947,"_21586":54192,"_5":14831,"_28346":53899,"_3068":54193},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3612":1063,"_31165":947,"_21586":54195,"_5":14831,"_28346":53899,"_3068":54196},[],"**Include Enrollment CA**",{"_3612":1064,"_31165":947,"_21586":54198,"_5":14831,"_28346":53899,"_3068":54199},[],"Selected issuing CA certificate.",{"_3612":1065,"_31165":947,"_21586":54201,"_5":14831,"_28346":53899,"_3068":54202},[],"**Managed CAs**",{"_3612":1066,"_31165":947,"_21586":54204,"_5":14831,"_28346":53899,"_3068":54205},[],"Explicitly selected CA certificates.",{"_3612":1067,"_31165":947,"_21586":54207,"_5":14831,"_28346":53899,"_3068":54208},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3612":1068,"_31165":947,"_21586":54210,"_5":14831,"_28346":53903,"_3068":54211},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3612":1069,"_31165":947,"_21586":54213,"_5":14831,"_28346":53903,"_3068":54214},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3612":1070,"_31165":947,"_21586":54216,"_5":14831,"_28346":53903,"_3068":54217},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3612":1071,"_31165":947,"_21586":54219,"_5":14831,"_28346":53907,"_3068":54220},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3612":1072,"_31165":1072,"_5":15196,"_3068":54222,"_31523":54223,"_21586":54224,"_28346":1072},"Integrate the EST client",[50890,52402,53574,53572,53758],[],{"_3612":1073,"_31165":1072,"_21586":54226,"_5":14831,"_28346":1072,"_3068":54227},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3612":1074,"_31165":1072,"_5":31520,"_21586":54229,"_28346":54230,"_3068":50900},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3612":1075,"_31165":1072,"_5":31520,"_21586":54232,"_28346":54233,"_3068":54234},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3612":1076,"_31165":1072,"_5":31520,"_21586":54236,"_28346":54237,"_3068":54238},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3612":1077,"_31165":1072,"_5":31520,"_21586":54240,"_28346":54241,"_3068":54242},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3612":1078,"_31165":1072,"_5":31520,"_21586":54244,"_28346":54245,"_3068":54246},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3612":1079,"_31165":1072,"_5":31520,"_21586":54248,"_28346":54249,"_3068":54250},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3612":1080,"_31165":1072,"_21586":54252,"_5":14831,"_28346":1072,"_3068":54253},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3612":1081,"_31165":1072,"_21586":54255,"_5":14831,"_28346":54230,"_3068":54256},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3612":1082,"_31165":1072,"_21586":54258,"_5":14831,"_28346":54230,"_3068":54259},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3612":1083,"_31165":1072,"_21586":54261,"_5":14831,"_28346":54230,"_3068":54262},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3612":1084,"_31165":1072,"_21586":54264,"_5":14831,"_28346":54233,"_3068":54265},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3612":1085,"_31165":1072,"_21586":54267,"_5":14831,"_28346":54233,"_3068":54268},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3612":1086,"_31165":1072,"_21586":54270,"_5":14831,"_28346":54237,"_3068":54271},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3612":1087,"_31165":1072,"_21586":54273,"_5":14831,"_28346":54237,"_3068":54274},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3612":1088,"_31165":1072,"_21586":54276,"_5":14831,"_28346":54241,"_3068":54277},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3612":1089,"_31165":1072,"_21586":54279,"_5":14831,"_28346":54241,"_3068":54280},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3612":1090,"_31165":1072,"_21586":54282,"_5":14831,"_28346":54245,"_3068":54283},[],"For a root that issues directly:",{"_3612":1091,"_31165":1072,"_21586":54285,"_5":14831,"_28346":54245,"_3068":54286},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3612":1092,"_31165":1072,"_21586":54288,"_5":14831,"_28346":54245,"_3068":54289},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3612":1093,"_31165":1072,"_21586":54291,"_5":14831,"_28346":54249,"_3068":54292},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3612":1094,"_31165":1094,"_5":15196,"_3068":54294,"_31523":54295,"_21586":54296,"_28346":1094},"EST reference",[50890,52402,53574,53572,53758],[],{"_3612":1095,"_31165":1094,"_21586":54298,"_5":14831,"_28346":1094,"_3068":54299},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3612":1096,"_31165":1094,"_5":31520,"_21586":54301,"_28346":54302,"_3068":54303},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3612":1097,"_31165":1094,"_5":31520,"_21586":54305,"_28346":54306,"_3068":23388},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3612":1098,"_31165":1094,"_5":31520,"_21586":54308,"_28346":54309,"_3068":26892},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3612":1099,"_31165":1094,"_5":31520,"_21586":54311,"_28346":54312,"_3068":26899},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3612":1100,"_31165":1094,"_5":31520,"_21586":54314,"_28346":54315,"_3068":26156},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3612":1101,"_31165":1094,"_5":31520,"_21586":54317,"_28346":54318,"_3068":54319},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3612":1102,"_31165":1094,"_5":31520,"_21586":54321,"_28346":54322,"_3068":54323},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3612":1103,"_31165":1094,"_5":31520,"_21586":54325,"_28346":54326,"_3068":54327},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3612":1104,"_31165":1094,"_21586":54329,"_5":14831,"_28346":1094,"_3068":54330},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3612":1105,"_31165":1094,"_21586":54332,"_5":14831,"_28346":54302,"_3068":54333},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3612":1106,"_31165":1094,"_21586":54335,"_5":14831,"_28346":54302,"_3068":54336},[],"Operation",{"_3612":1107,"_31165":1094,"_21586":54338,"_5":14831,"_28346":54302,"_3068":54339},[],"Method",{"_3612":1108,"_31165":1094,"_21586":54341,"_5":14831,"_28346":54302,"_3068":54342},[],"Authentication and condition",{"_3612":1109,"_31165":1094,"_21586":54344,"_5":14831,"_28346":54302,"_3068":54345},[],"`/cacerts`",{"_3612":1110,"_31165":1094,"_21586":54347,"_5":14831,"_28346":54302,"_3068":54348},[],"GET",{"_3612":1111,"_31165":1094,"_21586":54350,"_5":14831,"_28346":54302,"_3068":54351},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3612":1112,"_31165":1094,"_21586":54353,"_5":14831,"_28346":54302,"_3068":54354},[],"`/simpleenroll`",{"_3612":1113,"_31165":1094,"_21586":54356,"_5":14831,"_28346":54302,"_3068":54357},[],"POST",{"_3612":1114,"_31165":1094,"_21586":54359,"_5":14831,"_28346":54302,"_3068":54360},[],"Initial authentication and DMS registration/replacement policy.",{"_3612":1115,"_31165":1094,"_21586":54362,"_5":14831,"_28346":54302,"_3068":54363},[],"`/simplereenroll`",{"_3612":1116,"_31165":1094,"_21586":54365,"_5":14831,"_28346":54302,"_3068":54357},[],{"_3612":1117,"_31165":1094,"_21586":54367,"_5":14831,"_28346":54302,"_3068":54368},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3612":1118,"_31165":1094,"_21586":54370,"_5":14831,"_28346":54302,"_3068":54371},[],"`/serverkeygen`",{"_3612":1119,"_31165":1094,"_21586":54373,"_5":14831,"_28346":54302,"_3068":54357},[],{"_3612":1120,"_31165":1094,"_21586":54375,"_5":14831,"_28346":54302,"_3068":54376},[],"Initial authentication and admission; server generation enabled.",{"_3612":1121,"_31165":1094,"_21586":54378,"_5":14831,"_28346":54302,"_3068":54379},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3612":1122,"_31165":1094,"_21586":54381,"_5":14831,"_28346":54306,"_3068":54382},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3612":1123,"_31165":1094,"_21586":54384,"_5":14831,"_28346":54306,"_3068":54385},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3612":1124,"_31165":1094,"_21586":54387,"_5":14831,"_28346":54309,"_3068":54388},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3612":1125,"_31165":1094,"_21586":54390,"_5":14831,"_28346":54309,"_3068":54391},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3612":1126,"_31165":1094,"_21586":54393,"_5":14831,"_28346":54312,"_3068":54394},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3612":1127,"_31165":1094,"_21586":54396,"_5":14831,"_28346":54312,"_3068":54397},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3612":1128,"_31165":1094,"_21586":54399,"_5":14831,"_28346":54315,"_3068":54400},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3612":1129,"_31165":1094,"_21586":54402,"_5":14831,"_28346":54315,"_3068":54403},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3612":1130,"_31165":1094,"_21586":54405,"_5":14831,"_28346":54318,"_3068":54406},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3612":1131,"_31165":1094,"_21586":54408,"_5":14831,"_28346":54318,"_3068":54409},[],"Part",{"_3612":1132,"_31165":1094,"_21586":54411,"_5":14831,"_28346":54318,"_3068":54412},[],"Content after decoding its Base64",{"_3612":1133,"_31165":1094,"_21586":54414,"_5":14831,"_28346":54318,"_3068":54415},[],"`application/pkcs8`",{"_3612":1134,"_31165":1094,"_21586":54417,"_5":14831,"_28346":54318,"_3068":54418},[],"Unencrypted DER PKCS#8 private key.",{"_3612":1135,"_31165":1094,"_21586":54420,"_5":14831,"_28346":54318,"_3068":54421},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3612":1136,"_31165":1094,"_21586":54423,"_5":14831,"_28346":54318,"_3068":54424},[],"DER PKCS#7 containing the issued certificate.",{"_3612":1137,"_31165":1094,"_21586":54426,"_5":14831,"_28346":54318,"_3068":54427},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3612":1138,"_31165":1094,"_21586":54429,"_5":14831,"_28346":54322,"_3068":54430},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3612":1139,"_31165":1094,"_21586":54432,"_5":14831,"_28346":54322,"_3068":54433},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3612":1140,"_31165":1094,"_21586":54435,"_5":14831,"_28346":54322,"_3068":54436},[],"Convert and check the result:",{"_3612":1141,"_31165":1094,"_21586":54438,"_5":14831,"_28346":54322,"_3068":54439},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3612":1142,"_31165":1094,"_21586":54441,"_5":14831,"_28346":54326,"_3068":54442},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3612":1143,"_31165":1094,"_21586":54444,"_5":14831,"_28346":54326,"_3068":54445},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3612":1144,"_31165":1144,"_5":15196,"_3068":53758,"_31523":54447,"_21586":54448,"_28346":1144},[50890,52402,53574,53572,53758],[],{"_3612":1145,"_31165":1144,"_21586":54450,"_5":14831,"_28346":1144,"_3068":54451},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3612":1146,"_31165":1144,"_5":31520,"_21586":54453,"_28346":54454,"_3068":54455},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3612":1147,"_31165":1144,"_5":31520,"_21586":54457,"_28346":54458,"_3068":54459},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3612":1148,"_31165":1144,"_5":31520,"_21586":54461,"_28346":54462,"_3068":54463},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3612":1149,"_31165":1144,"_5":31520,"_21586":54465,"_28346":54466,"_3068":54467},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3612":1150,"_31165":1144,"_21586":54469,"_5":14831,"_28346":1144,"_3068":54470},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3612":1151,"_31165":1144,"_21586":54472,"_5":14831,"_28346":54454,"_3068":54473},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3612":1152,"_31165":1144,"_21586":54475,"_5":14831,"_28346":54454,"_3068":54476},[],"The integrator installs initial EST server trust and an admission credential.",{"_3612":1153,"_31165":1144,"_21586":54478,"_5":14831,"_28346":54454,"_3068":54479},[],"The client requests an identity for its `Device ID` through EST.",{"_3612":1154,"_31165":1144,"_21586":54481,"_5":14831,"_28346":54454,"_3068":54482},[],"Certificate, device binding and key/certificate installation are checked.",{"_3612":1155,"_31165":1144,"_21586":54484,"_5":14831,"_28346":54454,"_3068":54485},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3612":1156,"_31165":1144,"_21586":54487,"_5":14831,"_28346":54454,"_3068":54488},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3612":1157,"_31165":1144,"_21586":54490,"_5":14831,"_28346":54458,"_3068":54491},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3612":1158,"_31165":1144,"_21586":54493,"_5":14831,"_28346":54458,"_3068":54494},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3612":1159,"_31165":1144,"_21586":54496,"_5":14831,"_28346":54458,"_3068":54497},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3612":1160,"_31165":1144,"_21586":54499,"_5":14831,"_28346":54458,"_3068":54500},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3612":1161,"_31165":1144,"_21586":54502,"_5":14831,"_28346":54462,"_3068":54503},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3612":1162,"_31165":1144,"_21586":54505,"_5":14831,"_28346":54462,"_3068":54506},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3612":1163,"_31165":1144,"_21586":54508,"_5":14831,"_28346":54462,"_3068":54509},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3612":1164,"_31165":1144,"_21586":54511,"_5":14831,"_28346":54462,"_3068":54512},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3612":1165,"_31165":1144,"_21586":54514,"_5":14831,"_28346":54466,"_3068":54515},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3612":1166,"_31165":1144,"_21586":54517,"_5":14831,"_28346":54466,"_3068":54518},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3612":1167,"_31165":1167,"_5":15196,"_3068":54520,"_31523":54521,"_21586":54522,"_28346":1167},"Provisioning strategies",[50890,52402,53574,53572,53758],[],{"_3612":1168,"_31165":1167,"_21586":54524,"_5":14831,"_28346":1167,"_3068":54525},[],"Choose device registration, identity authorization and key generation.",{"_3612":1169,"_31165":1167,"_5":31520,"_21586":54527,"_28346":54528,"_3068":54529},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3612":1170,"_31165":1167,"_5":31520,"_21586":54531,"_28346":54532,"_3068":54533},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3612":1171,"_31165":1167,"_5":31520,"_21586":54535,"_28346":54536,"_3068":54537},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3612":1172,"_31165":1167,"_5":31520,"_21586":54539,"_28346":54540,"_3068":54541},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3612":1173,"_31165":1167,"_5":31520,"_21586":54543,"_28346":54544,"_3068":54545},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3612":1174,"_31165":1167,"_21586":54547,"_5":14831,"_28346":1167,"_3068":54548},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3612":1175,"_31165":1167,"_21586":54550,"_5":14831,"_28346":54528,"_3068":54551},[],"Path",{"_3612":1176,"_31165":1167,"_21586":54553,"_5":14831,"_28346":54528,"_3068":54554},[],"When the device exists",{"_3612":1177,"_31165":1167,"_21586":54556,"_5":14831,"_28346":54528,"_3068":54557},[],"What to check",{"_3612":1178,"_31165":1167,"_21586":54559,"_5":14831,"_28346":54528,"_3068":54560},[],"Manual assignment",{"_3612":1179,"_31165":1167,"_21586":54562,"_5":14831,"_28346":54528,"_3068":54563},[],"An operator creates it before associating a certificate.",{"_3612":1180,"_31165":1167,"_21586":54565,"_5":14831,"_28346":54528,"_3068":54566},[],"ID, owning DMS, certificate CN and bound serial.",{"_3612":1181,"_31165":1167,"_21586":54568,"_5":14831,"_28346":54528,"_3068":54569},[],"EST with `JITP`",{"_3612":1182,"_31165":1167,"_21586":54571,"_5":14831,"_28346":54528,"_3068":54572},[],"Created for an unknown CN during `/simpleenroll`.",{"_3612":1183,"_31165":1167,"_21586":54574,"_5":14831,"_28346":54528,"_3068":54575},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3612":1184,"_31165":1167,"_21586":54577,"_5":14831,"_28346":54528,"_3068":54578},[],"EST with `PRE_REGISTRATION`",{"_3612":1185,"_31165":1167,"_21586":54580,"_5":14831,"_28346":54528,"_3068":54581},[],"Must exist before `/simpleenroll`.",{"_3612":1186,"_31165":1167,"_21586":54583,"_5":14831,"_28346":54528,"_3068":54584},[],"Approved record, same DMS and replacement conditions for your version.",{"_3612":1187,"_31165":1167,"_21586":54586,"_5":14831,"_28346":54528,"_3068":54587},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3612":1188,"_31165":1167,"_21586":54589,"_5":14831,"_28346":54528,"_3068":54590},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3612":1189,"_31165":1167,"_21586":54592,"_5":14831,"_28346":54532,"_3068":54593},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3612":1190,"_31165":1167,"_21586":54595,"_5":14831,"_28346":54532,"_3068":54596},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3612":1191,"_31165":1167,"_21586":54598,"_5":14831,"_28346":54532,"_3068":54599},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3612":1192,"_31165":1167,"_21586":54601,"_5":14831,"_28346":54536,"_3068":54602},[],"Decide initial enrollment and re-enrollment separately:",{"_3612":1193,"_31165":1167,"_21586":54604,"_5":14831,"_28346":54536,"_3068":54605},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3612":1194,"_31165":1167,"_21586":54607,"_5":14831,"_28346":54536,"_3068":54608},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3612":1195,"_31165":1167,"_21586":54610,"_5":14831,"_28346":54536,"_3068":54611},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3612":1196,"_31165":1167,"_21586":54613,"_5":14831,"_28346":54536,"_3068":54614},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3612":1197,"_31165":1167,"_21586":54616,"_5":14831,"_28346":54536,"_3068":54617},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3612":1198,"_31165":1167,"_21586":54619,"_5":14831,"_28346":54540,"_3068":51274},[],{"_3612":1199,"_31165":1167,"_21586":54621,"_5":14831,"_28346":54540,"_3068":54622},[],"Material crossing EST",{"_3612":1200,"_31165":1167,"_21586":54624,"_5":14831,"_28346":54540,"_3068":54625},[],"Device-generated key",{"_3612":1201,"_31165":1167,"_21586":54627,"_5":14831,"_28346":54540,"_3068":54628},[],"Public CSR and certificate; the key stays on the client.",{"_3612":1202,"_31165":1167,"_21586":54630,"_5":14831,"_28346":54540,"_3068":54631},[],"Existing device key",{"_3612":1203,"_31165":1167,"_21586":54633,"_5":14831,"_28346":54540,"_3068":54634},[],"CSR signed with that key and a new certificate.",{"_3612":1204,"_31165":1167,"_21586":54636,"_5":14831,"_28346":54540,"_3068":53896},[],{"_3612":1205,"_31165":1167,"_21586":54638,"_5":14831,"_28346":54540,"_3068":54639},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3612":1206,"_31165":1167,"_21586":54641,"_5":14831,"_28346":54540,"_3068":54642},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3612":1207,"_31165":1167,"_21586":54644,"_5":14831,"_28346":54544,"_3068":54645},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3612":1208,"_31165":1208,"_5":15196,"_3068":54647,"_31523":54648,"_21586":54649,"_28346":1208},"Renewal and recovery",[50890,52402,53574,53572,53758],[],{"_3612":1209,"_31165":1208,"_21586":54651,"_5":14831,"_28346":1208,"_3068":54652},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3612":1210,"_31165":1208,"_5":31520,"_21586":54654,"_28346":54655,"_3068":54656},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3612":1211,"_31165":1208,"_5":31520,"_21586":54658,"_28346":54659,"_3068":54660},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3612":1212,"_31165":1208,"_5":31520,"_21586":54662,"_28346":54663,"_3068":54664},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3612":1213,"_31165":1208,"_5":31520,"_21586":54666,"_28346":54667,"_3068":54668},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3612":1214,"_31165":1208,"_5":31520,"_21586":54670,"_28346":54671,"_3068":54672},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3612":1215,"_31165":1208,"_21586":54674,"_5":14831,"_28346":1208,"_3068":54675},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3612":1216,"_31165":1208,"_21586":54677,"_5":14831,"_28346":54655,"_3068":54678},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3612":1217,"_31165":1208,"_21586":54680,"_5":14831,"_28346":54655,"_3068":54681},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3612":1218,"_31165":1208,"_21586":54683,"_5":14831,"_28346":54655,"_3068":54684},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3612":1219,"_31165":1208,"_21586":54686,"_5":14831,"_28346":54655,"_3068":54687},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3612":1220,"_31165":1208,"_21586":54689,"_5":14831,"_28346":54659,"_3068":54690},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3612":1221,"_31165":1208,"_21586":54692,"_5":14831,"_28346":54659,"_3068":54693},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3612":1222,"_31165":1208,"_21586":54695,"_5":14831,"_28346":54663,"_3068":54696},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3612":1223,"_31165":1208,"_21586":54698,"_5":14831,"_28346":54663,"_3068":54699},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3612":1224,"_31165":1208,"_21586":54701,"_5":14831,"_28346":54663,"_3068":54702},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3612":1225,"_31165":1208,"_21586":54704,"_5":14831,"_28346":54667,"_3068":54705},[],"Situation",{"_3612":1226,"_31165":1208,"_21586":54707,"_5":14831,"_28346":54667,"_3068":54708},[],"Procedure",{"_3612":1227,"_31165":1208,"_21586":54710,"_5":14831,"_28346":54667,"_3068":54711},[],"Valid certificate, outside the window",{"_3612":1228,"_31165":1208,"_21586":54713,"_5":14831,"_28346":54667,"_3068":54714},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3612":1229,"_31165":1208,"_21586":54716,"_5":14831,"_28346":54667,"_3068":54717},[],"Expired certificate, key available",{"_3612":1230,"_31165":1208,"_21586":54719,"_5":14831,"_28346":54667,"_3068":54720},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3612":1231,"_31165":1208,"_21586":54722,"_5":14831,"_28346":54667,"_3068":54723},[],"Renewal through webhook or `NO_AUTH`",{"_3612":1232,"_31165":1208,"_21586":54725,"_5":14831,"_28346":54667,"_3068":54726},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3612":1233,"_31165":1208,"_21586":54728,"_5":14831,"_28346":54667,"_3068":54729},[],"Lost or inaccessible key",{"_3612":1234,"_31165":1208,"_21586":54731,"_5":14831,"_28346":54667,"_3068":54732},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3612":1235,"_31165":1208,"_21586":54734,"_5":14831,"_28346":54667,"_3068":54735},[],"Current identity revoked",{"_3612":1236,"_31165":1208,"_21586":54737,"_5":14831,"_28346":54667,"_3068":54738},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3612":1237,"_31165":1208,"_21586":54740,"_5":14831,"_28346":54667,"_3068":54741},[],"Device without an identity",{"_3612":1238,"_31165":1208,"_21586":54743,"_5":14831,"_28346":54667,"_3068":54744},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3612":1239,"_31165":1208,"_21586":54746,"_5":14831,"_28346":54667,"_3068":54747},[],"Retired device",{"_3612":1240,"_31165":1208,"_21586":54749,"_5":14831,"_28346":54667,"_3068":54750},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3612":1241,"_31165":1208,"_21586":54752,"_5":14831,"_28346":54667,"_3068":54753},[],"Timeout, HTTP 500 or installation failure",{"_3612":1242,"_31165":1208,"_21586":54755,"_5":14831,"_28346":54667,"_3068":54756},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3612":1243,"_31165":1208,"_21586":54758,"_5":14831,"_28346":54671,"_3068":54759},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3612":1244,"_31165":1208,"_21586":54761,"_5":14831,"_28346":54671,"_3068":54762},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3612":1245,"_31165":1245,"_5":15196,"_3068":54764,"_31523":54765,"_21586":54766,"_28346":1245},"Enrollment troubleshooting",[50890,52402,53574,53572,53758],[],{"_3612":1246,"_31165":1245,"_21586":54768,"_5":14831,"_28346":1245,"_3068":54769},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3612":1247,"_31165":1245,"_5":31520,"_21586":54771,"_28346":54772,"_3068":54773},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3612":1248,"_31165":1245,"_5":31520,"_21586":54775,"_28346":54776,"_3068":54777},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3612":1249,"_31165":1245,"_5":31520,"_21586":54779,"_28346":54780,"_3068":54327},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3612":1250,"_31165":1245,"_5":31520,"_21586":54782,"_28346":54783,"_3068":54784},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3612":1251,"_31165":1245,"_21586":54786,"_5":14831,"_28346":1245,"_3068":54787},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3612":1252,"_31165":1245,"_21586":54789,"_5":14831,"_28346":54776,"_3068":54790},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3612":1253,"_31165":1245,"_21586":54792,"_5":14831,"_28346":54776,"_3068":54793},[],"Symptom or message",{"_3612":1254,"_31165":1245,"_21586":54795,"_5":14831,"_28346":54776,"_3068":54557},[],{"_3612":1255,"_31165":1245,"_21586":54797,"_5":14831,"_28346":54776,"_3068":54798},[],"curl rejects TLS, name or issuer",{"_3612":1256,"_31165":1245,"_21586":54800,"_5":14831,"_28346":54776,"_3068":54801},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3612":1257,"_31165":1245,"_21586":54803,"_5":14831,"_28346":54776,"_3068":54804},[],"404 or missing APS",{"_3612":1258,"_31165":1245,"_21586":54806,"_5":14831,"_28346":54776,"_3068":54807},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3612":1259,"_31165":1245,"_21586":54809,"_5":14831,"_28346":54776,"_3068":54810},[],"400, CSR or format error",{"_3612":1260,"_31165":1245,"_21586":54812,"_5":14831,"_28346":54776,"_3068":54813},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3612":1261,"_31165":1245,"_21586":54815,"_5":14831,"_28346":54776,"_3068":54816},[],"Missing credential or invalid certificate",{"_3612":1262,"_31165":1245,"_21586":54818,"_5":14831,"_28346":54776,"_3068":54819},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3612":1263,"_31165":1245,"_21586":54821,"_5":14831,"_28346":54776,"_3068":54822},[],"Webhook denies, times out or responds without authorization",{"_3612":1264,"_31165":1245,"_21586":54824,"_5":14831,"_28346":54776,"_3068":54825},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3612":1265,"_31165":1245,"_21586":54827,"_5":14831,"_28346":54776,"_3068":54828},[],"`unexpected status code: <n>: redirects are not followed`",{"_3612":1266,"_31165":1245,"_21586":54830,"_5":14831,"_28346":54776,"_3068":54831},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3612":1267,"_31165":1245,"_21586":54833,"_5":14831,"_28346":54776,"_3068":54834},[],"`webhook response exceeds 1048576 bytes`",{"_3612":1268,"_31165":1245,"_21586":54836,"_5":14831,"_28346":54776,"_3068":54837},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3612":1269,"_31165":1245,"_21586":54839,"_5":14831,"_28346":54776,"_3068":54840},[],"`webhook config must not reference files`",{"_3612":1270,"_31165":1245,"_21586":54842,"_5":14831,"_28346":54776,"_3068":54843},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3612":1271,"_31165":1245,"_21586":54845,"_5":14831,"_28346":54776,"_3068":54846},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3612":1272,"_31165":1245,"_21586":54848,"_5":14831,"_28346":54776,"_3068":54849},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3612":1273,"_31165":1245,"_21586":54851,"_5":14831,"_28346":54776,"_3068":54852},[],"`webhook mTLS certificate and key are invalid: …`",{"_3612":1274,"_31165":1245,"_21586":54854,"_5":14831,"_28346":54776,"_3068":54855},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3612":1275,"_31165":1245,"_21586":54857,"_5":14831,"_28346":54776,"_3068":54858},[],"400 `struct validation error` creating or updating a DMS",{"_3612":1276,"_31165":1245,"_21586":54860,"_5":14831,"_28346":54776,"_3068":54861},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3612":1277,"_31165":1245,"_21586":54863,"_5":14831,"_28346":54776,"_3068":54864},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3612":1278,"_31165":1245,"_21586":54866,"_5":14831,"_28346":54776,"_3068":54867},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3612":1279,"_31165":1245,"_21586":54869,"_5":14831,"_28346":54776,"_3068":54870},[],"`device not preregistered`",{"_3612":1280,"_31165":1245,"_21586":54872,"_5":14831,"_28346":54776,"_3068":54873},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3612":1281,"_31165":1245,"_21586":54875,"_5":14831,"_28346":54776,"_3068":54876},[],"`forbiddenNewEnrollment`",{"_3612":1282,"_31165":1245,"_21586":54878,"_5":14831,"_28346":54776,"_3068":54879},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3612":1283,"_31165":1245,"_21586":54881,"_5":14831,"_28346":54776,"_3068":54882},[],"Different owning DMS",{"_3612":1284,"_31165":1245,"_21586":54884,"_5":14831,"_28346":54776,"_3068":54885},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3612":1285,"_31165":1245,"_21586":54887,"_5":14831,"_28346":54776,"_3068":54888},[],"`invalid RawSubject bytes`",{"_3612":1286,"_31165":1245,"_21586":54890,"_5":14831,"_28346":54776,"_3068":54891},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3612":1287,"_31165":1245,"_21586":54893,"_5":14831,"_28346":54776,"_3068":54894},[],"`invalid reenroll window`",{"_3612":1288,"_31165":1245,"_21586":54896,"_5":14831,"_28346":54776,"_3068":54897},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3612":1289,"_31165":1245,"_21586":54899,"_5":14831,"_28346":54776,"_3068":54900},[],"Current certificate revoked",{"_3612":1290,"_31165":1245,"_21586":54902,"_5":14831,"_28346":54776,"_3068":54903},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3612":1291,"_31165":1245,"_21586":54905,"_5":14831,"_28346":54776,"_3068":54906},[],"CA, profile or signing error",{"_3612":1292,"_31165":1245,"_21586":54908,"_5":14831,"_28346":54776,"_3068":54909},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3612":1293,"_31165":1245,"_21586":54911,"_5":14831,"_28346":54776,"_3068":54912},[],"HTTP 200 without a device connection",{"_3612":1294,"_31165":1245,"_21586":54914,"_5":14831,"_28346":54776,"_3068":54915},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3612":1295,"_31165":1245,"_21586":54917,"_5":14831,"_28346":54776,"_3068":54918},[],"Timeout or error after issuance",{"_3612":1296,"_31165":1245,"_21586":54920,"_5":14831,"_28346":54776,"_3068":54921},[],"New certificates, current slot and previous identity's state before retrying.",{"_3612":1297,"_31165":1245,"_21586":54923,"_5":14831,"_28346":54780,"_3068":54924},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3612":1298,"_31165":1245,"_21586":54926,"_5":14831,"_28346":54780,"_3068":54927},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3612":1299,"_31165":1245,"_21586":54929,"_5":14831,"_28346":54783,"_3068":54930},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3612":1300,"_31165":1245,"_21586":54932,"_5":14831,"_28346":54783,"_3068":54933},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3612":1301,"_31165":1245,"_21586":54935,"_5":14831,"_28346":54783,"_3068":54936},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3612":1302,"_31165":1245,"_21586":54938,"_5":14831,"_28346":54783,"_3068":54939},[],"Make one request, save headers/body and query the device and certificates.",{"_3612":1303,"_31165":1245,"_21586":54941,"_5":14831,"_28346":54783,"_3068":54942},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3612":1304,"_31165":1245,"_21586":54944,"_5":14831,"_28346":54783,"_3068":54945},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3612":1305,"_31165":1245,"_21586":54947,"_5":14831,"_28346":54783,"_3068":54948},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3612":1306,"_31165":1306,"_5":15196,"_3068":54950,"_31523":54951,"_21586":54952,"_28346":1306},"Trust distribution and updates",[50890,52402,53574,53572,53758],[],{"_3612":1307,"_31165":1306,"_21586":54954,"_5":14831,"_28346":1306,"_3068":54955},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3612":1308,"_31165":1306,"_5":31520,"_21586":54957,"_28346":54958,"_3068":54959},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3612":1309,"_31165":1306,"_5":31520,"_21586":54961,"_28346":54962,"_3068":54963},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3612":1310,"_31165":1306,"_5":31520,"_21586":54965,"_28346":54966,"_3068":54967},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3612":1311,"_31165":1306,"_5":31520,"_21586":54969,"_28346":54970,"_3068":54971},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3612":1312,"_31165":1306,"_5":31520,"_21586":54973,"_28346":54974,"_3068":54975},[],"/docs/pr-preview/pr-77/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3612":1313,"_31165":1306,"_21586":54977,"_5":14831,"_28346":1306,"_3068":54978},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3612":1314,"_31165":1306,"_21586":54980,"_5":14831,"_28346":54958,"_3068":54981},[],"Relationship",{"_3612":1315,"_31165":1306,"_21586":54983,"_5":14831,"_28346":54958,"_3068":54984},[],"Material prepared by its owner",{"_3612":1316,"_31165":1306,"_21586":54986,"_5":14831,"_28346":54958,"_3068":54987},[],"Device → EST server",{"_3612":1317,"_31165":1306,"_21586":54989,"_5":14831,"_28346":54958,"_3068":54990},[],"Previously verified server root, chain or pin and TLS name.",{"_3612":1318,"_31165":1306,"_21586":54992,"_5":14831,"_28346":54958,"_3068":54993},[],"DMS → requester",{"_3612":1319,"_31165":1306,"_21586":54995,"_5":14831,"_28346":54958,"_3068":54996},[],"CAs and rules authorizing initial or renewal credentials.",{"_3612":1320,"_31165":1306,"_21586":54998,"_5":14831,"_28346":54958,"_3068":54999},[],"Consumer → device",{"_3612":1321,"_31165":1306,"_21586":55001,"_5":14831,"_28346":54958,"_3068":55002},[],"Operational identity roots, intermediates, validation and permissions.",{"_3612":1322,"_31165":1306,"_21586":55004,"_5":14831,"_28346":54958,"_3068":55005},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3612":1323,"_31165":1306,"_21586":55007,"_5":14831,"_28346":54962,"_3068":55008},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3612":1324,"_31165":1306,"_21586":55010,"_5":14831,"_28346":54962,"_3068":55011},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3612":1325,"_31165":1306,"_21586":55013,"_5":14831,"_28346":54966,"_3068":55014},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3612":1326,"_31165":1306,"_21586":55016,"_5":14831,"_28346":54966,"_3068":55017},[],"Select policy-approved roots as anchors.",{"_3612":1327,"_31165":1306,"_21586":55019,"_5":14831,"_28346":54966,"_3068":55020},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3612":1328,"_31165":1306,"_21586":55022,"_5":14831,"_28346":54966,"_3068":55023},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3612":1329,"_31165":1306,"_21586":55025,"_5":14831,"_28346":54966,"_3068":55026},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3612":1330,"_31165":1306,"_21586":55028,"_5":14831,"_28346":54966,"_3068":55029},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3612":1331,"_31165":1306,"_21586":55031,"_5":14831,"_28346":54970,"_3068":55032},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3612":1332,"_31165":1306,"_21586":55034,"_5":14831,"_28346":54970,"_3068":55035},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3612":1333,"_31165":1306,"_21586":55037,"_5":14831,"_28346":54970,"_3068":55038},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3612":1334,"_31165":1306,"_21586":55040,"_5":14831,"_28346":54974,"_3068":55041},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3612":1335,"_31165":1335,"_5":15196,"_3068":55043,"_31523":55044,"_21586":55046,"_28346":1335},"AWS IoT Core",[50890,52402,53574,53572,55045],"Integrations",[],{"_3612":1336,"_31165":1335,"_21586":55048,"_5":14831,"_28346":1335,"_3068":55049},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3612":1337,"_31165":1335,"_5":31520,"_21586":55051,"_28346":55052,"_3068":55053},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3612":1338,"_31165":1335,"_5":31520,"_21586":55055,"_28346":55056,"_3068":55057},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3612":1339,"_31165":1335,"_5":31520,"_21586":55059,"_28346":55060,"_3068":55061},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3612":1340,"_31165":1335,"_5":31520,"_21586":55063,"_28346":55064,"_3068":55065},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3612":1341,"_31165":1335,"_5":31520,"_21586":55067,"_28346":55068,"_3068":55069},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3612":1342,"_31165":1335,"_5":31520,"_21586":55071,"_28346":55072,"_3068":55073},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3612":1343,"_31165":1335,"_5":31520,"_21586":55075,"_28346":55076,"_3068":55077},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3612":1344,"_31165":1335,"_5":31520,"_21586":55079,"_28346":55080,"_3068":55081},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3612":1345,"_31165":1335,"_5":31520,"_21586":55083,"_28346":55084,"_3068":55085},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3612":1346,"_31165":1335,"_5":31520,"_21586":55087,"_28346":55088,"_3068":55089},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3612":1347,"_31165":1335,"_5":31520,"_21586":55091,"_28346":55092,"_3068":55093},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3612":1348,"_31165":1335,"_5":31520,"_21586":55095,"_28346":55096,"_3068":55097},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3612":1349,"_31165":1335,"_5":31520,"_21586":55099,"_28346":55100,"_3068":55101},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3612":1350,"_31165":1335,"_5":31520,"_21586":55103,"_28346":55104,"_3068":55105},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3612":1351,"_31165":1335,"_5":31520,"_21586":55107,"_28346":55108,"_3068":55109},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3612":1352,"_31165":1335,"_5":31520,"_21586":55111,"_28346":55112,"_3068":55113},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3612":1353,"_31165":1335,"_5":31520,"_21586":55115,"_28346":55116,"_3068":55117},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3612":1354,"_31165":1335,"_5":31520,"_21586":55119,"_28346":55120,"_3068":55121},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3612":1355,"_31165":1335,"_5":31520,"_21586":55123,"_28346":55124,"_3068":55125},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3612":1356,"_31165":1335,"_5":31520,"_21586":55127,"_28346":55128,"_3068":55129},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3612":1357,"_31165":1335,"_5":31520,"_21586":55131,"_28346":55132,"_3068":55133},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3612":1358,"_31165":1335,"_5":31520,"_21586":55135,"_28346":55136,"_3068":55137},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3612":1359,"_31165":1335,"_5":31520,"_21586":55139,"_28346":55140,"_3068":55141},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3612":1360,"_31165":1335,"_5":31520,"_21586":55143,"_28346":55144,"_3068":55145},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3612":1361,"_31165":1335,"_5":31520,"_21586":55147,"_28346":55148,"_3068":55149},[],"/docs/pr-preview/pr-77/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3612":1362,"_31165":1335,"_21586":55151,"_5":14831,"_28346":1335,"_3068":55152},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3612":1363,"_31165":1335,"_21586":55154,"_5":14831,"_28346":1335,"_3068":55155},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3612":1364,"_31165":1335,"_21586":55157,"_5":14831,"_28346":1335,"_3068":55158},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3612":1365,"_31165":1335,"_21586":55160,"_5":14831,"_28346":55052,"_3068":55161},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3612":1366,"_31165":1335,"_21586":55163,"_5":14831,"_28346":55052,"_3068":55164},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3612":1367,"_31165":1335,"_21586":55166,"_5":14831,"_28346":55052,"_3068":55167},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3612":1368,"_31165":1335,"_21586":55169,"_5":14831,"_28346":55052,"_3068":55170},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3612":1369,"_31165":1335,"_21586":55172,"_5":14831,"_28346":55056,"_3068":55173},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3612":1370,"_31165":1335,"_21586":55175,"_5":14831,"_28346":55060,"_3068":55176},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3612":1371,"_31165":1335,"_21586":55178,"_5":14831,"_28346":55060,"_3068":55179},[],"IAM action",{"_3612":1372,"_31165":1335,"_21586":55181,"_5":14831,"_28346":55060,"_3068":51280},[],{"_3612":1373,"_31165":1335,"_21586":55183,"_5":14831,"_28346":55060,"_3068":55184},[],"`iot:GetRegistrationCode`",{"_3612":1374,"_31165":1335,"_21586":55186,"_5":14831,"_28346":55060,"_3068":55187},[],"Obtain the verification code for CA registration in the Primary Account",{"_3612":1375,"_31165":1335,"_21586":55189,"_5":14831,"_28346":55060,"_3068":55190},[],"`iot:RegisterCACertificate`",{"_3612":1376,"_31165":1335,"_21586":55192,"_5":14831,"_28346":55060,"_3068":55193},[],"Register the CA in AWS IoT",{"_3612":1377,"_31165":1335,"_21586":55195,"_5":14831,"_28346":55060,"_3068":55196},[],"`iot:DescribeCACertificate`",{"_3612":1378,"_31165":1335,"_21586":55198,"_5":14831,"_28346":55060,"_3068":55199},[],"Check the CA registration status",{"_3612":1379,"_31165":1335,"_21586":55201,"_5":14831,"_28346":55060,"_3068":55202},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3612":1380,"_31165":1335,"_21586":55204,"_5":14831,"_28346":55060,"_3068":55205},[],"Create or update Things in IoT Core",{"_3612":1381,"_31165":1335,"_21586":55207,"_5":14831,"_28346":55060,"_3068":55208},[],"`iot:RegisterThing`",{"_3612":1382,"_31165":1335,"_21586":55210,"_5":14831,"_28346":55060,"_3068":55211},[],"Provision Things through a template",{"_3612":1383,"_31165":1335,"_21586":55213,"_5":14831,"_28346":55060,"_3068":55214},[],"`iot:RegisterCertificate`",{"_3612":1384,"_31165":1335,"_21586":55216,"_5":14831,"_28346":55060,"_3068":55217},[],"Register device certificates",{"_3612":1385,"_31165":1335,"_21586":55219,"_5":14831,"_28346":55060,"_3068":55220},[],"`iot:UpdateCertificate`",{"_3612":1386,"_31165":1335,"_21586":55222,"_5":14831,"_28346":55060,"_3068":55223},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3612":1387,"_31165":1335,"_21586":55225,"_5":14831,"_28346":55060,"_3068":55226},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3612":1388,"_31165":1335,"_21586":55228,"_5":14831,"_28346":55060,"_3068":55229},[],"Create and attach IoT policies",{"_3612":1389,"_31165":1335,"_21586":55231,"_5":14831,"_28346":55060,"_3068":55232},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3612":1390,"_31165":1335,"_21586":55234,"_5":14831,"_28346":55060,"_3068":55235},[],"Manage Thing groups",{"_3612":1391,"_31165":1335,"_21586":55237,"_5":14831,"_28346":55060,"_3068":55238},[],"`iot:CreateProvisioningTemplate`",{"_3612":1392,"_31165":1335,"_21586":55240,"_5":14831,"_28346":55060,"_3068":55241},[],"Create JITP templates",{"_3612":1393,"_31165":1335,"_21586":55243,"_5":14831,"_28346":55060,"_3068":55244},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3612":1394,"_31165":1335,"_21586":55246,"_5":14831,"_28346":55060,"_3068":55247},[],"Read and write the Device Shadow",{"_3612":1395,"_31165":1335,"_21586":55249,"_5":14831,"_28346":55060,"_3068":55250},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3612":1396,"_31165":1335,"_21586":55252,"_5":14831,"_28346":55064,"_3068":55253},[],"Parameter",{"_3612":1397,"_31165":1335,"_21586":55255,"_5":14831,"_28346":55064,"_3068":55256},[],"Type",{"_3612":1398,"_31165":1335,"_21586":55258,"_5":14831,"_28346":55064,"_3068":55259},[],"Required",{"_3612":1399,"_31165":1335,"_21586":55261,"_5":14831,"_28346":55064,"_3068":55262},[],"Description",{"_3612":1400,"_31165":1335,"_21586":55264,"_5":14831,"_28346":55064,"_3068":55265},[],"`connector_id`",{"_3612":1401,"_31165":1335,"_21586":55267,"_5":14831,"_28346":55064,"_3068":25766},[],{"_3612":1402,"_31165":1335,"_21586":55269,"_5":14831,"_28346":55064,"_3068":55270},[],"Yes",{"_3612":1403,"_31165":1335,"_21586":55272,"_5":14831,"_28346":55064,"_3068":55273},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3612":1404,"_31165":1335,"_21586":55275,"_5":14831,"_28346":55064,"_3068":55276},[],"`aws_config.region`",{"_3612":1405,"_31165":1335,"_21586":55278,"_5":14831,"_28346":55064,"_3068":25766},[],{"_3612":1406,"_31165":1335,"_21586":55280,"_5":14831,"_28346":55064,"_3068":55270},[],{"_3612":1407,"_31165":1335,"_21586":55282,"_5":14831,"_28346":55064,"_3068":55283},[],"AWS region where the connector operates.",{"_3612":1408,"_31165":1335,"_21586":55285,"_5":14831,"_28346":55064,"_3068":55286},[],"`aws_config.auth_method`",{"_3612":1409,"_31165":1335,"_21586":55288,"_5":14831,"_28346":55064,"_3068":25766},[],{"_3612":1410,"_31165":1335,"_21586":55290,"_5":14831,"_28346":55064,"_3068":55270},[],{"_3612":1411,"_31165":1335,"_21586":55292,"_5":14831,"_28346":55064,"_3068":55293},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3612":1412,"_31165":1335,"_21586":55295,"_5":14831,"_28346":55064,"_3068":55296},[],"`aws_config.access_key_id`",{"_3612":1413,"_31165":1335,"_21586":55298,"_5":14831,"_28346":55064,"_3068":25766},[],{"_3612":1414,"_31165":1335,"_21586":55300,"_5":14831,"_28346":55064,"_3068":55301},[],"Only with `auth_method=static`",{"_3612":1415,"_31165":1335,"_21586":55303,"_5":14831,"_28346":55064,"_3068":55304},[],"AWS access key.",{"_3612":1416,"_31165":1335,"_21586":55306,"_5":14831,"_28346":55064,"_3068":55307},[],"`aws_config.secret_access_key`",{"_3612":1417,"_31165":1335,"_21586":55309,"_5":14831,"_28346":55064,"_3068":25766},[],{"_3612":1418,"_31165":1335,"_21586":55311,"_5":14831,"_28346":55064,"_3068":55301},[],{"_3612":1419,"_31165":1335,"_21586":55313,"_5":14831,"_28346":55064,"_3068":55314},[],"AWS secret key.",{"_3612":1420,"_31165":1335,"_21586":55316,"_5":14831,"_28346":55064,"_3068":55317},[],"`aws_config.session_token`",{"_3612":1421,"_31165":1335,"_21586":55319,"_5":14831,"_28346":55064,"_3068":25766},[],{"_3612":1422,"_31165":1335,"_21586":55321,"_5":14831,"_28346":55064,"_3068":55322},[],"No",{"_3612":1423,"_31165":1335,"_21586":55324,"_5":14831,"_28346":55064,"_3068":55325},[],"Session token (with `auth_method=static`).",{"_3612":1424,"_31165":1335,"_21586":55327,"_5":14831,"_28346":55064,"_3068":55328},[],"`aws_config.role_arn`",{"_3612":1425,"_31165":1335,"_21586":55330,"_5":14831,"_28346":55064,"_3068":25766},[],{"_3612":1426,"_31165":1335,"_21586":55332,"_5":14831,"_28346":55064,"_3068":55333},[],"Only with `auth_method=role`",{"_3612":1427,"_31165":1335,"_21586":55335,"_5":14831,"_28346":55064,"_3068":55336},[],"ARN of the role to assume.",{"_3612":1428,"_31165":1335,"_21586":55338,"_5":14831,"_28346":55064,"_3068":55339},[],"`aws_config.endpoint_url`",{"_3612":1429,"_31165":1335,"_21586":55341,"_5":14831,"_28346":55064,"_3068":25766},[],{"_3612":1430,"_31165":1335,"_21586":55343,"_5":14831,"_28346":55064,"_3068":55322},[],{"_3612":1431,"_31165":1335,"_21586":55345,"_5":14831,"_28346":55064,"_3068":55346},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3612":1432,"_31165":1335,"_21586":55348,"_5":14831,"_28346":55064,"_3068":55349},[],"`subscriber_event_bus`",{"_3612":1433,"_31165":1335,"_21586":55351,"_5":14831,"_28346":55064,"_3068":18188},[],{"_3612":1434,"_31165":1335,"_21586":55353,"_5":14831,"_28346":55064,"_3068":55270},[],{"_3612":1435,"_31165":1335,"_21586":55355,"_5":14831,"_28346":55064,"_3068":55356},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3612":1436,"_31165":1335,"_21586":55358,"_5":14831,"_28346":55064,"_3068":55359},[],"`dms_manager_client`",{"_3612":1437,"_31165":1335,"_21586":55361,"_5":14831,"_28346":55064,"_3068":25766},[],{"_3612":1438,"_31165":1335,"_21586":55363,"_5":14831,"_28346":55064,"_3068":55270},[],{"_3612":1439,"_31165":1335,"_21586":55365,"_5":14831,"_28346":55064,"_3068":55366},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3612":1440,"_31165":1335,"_21586":55368,"_5":14831,"_28346":55064,"_3068":55369},[],"`device_manager_client`",{"_3612":1441,"_31165":1335,"_21586":55371,"_5":14831,"_28346":55064,"_3068":25766},[],{"_3612":1442,"_31165":1335,"_21586":55373,"_5":14831,"_28346":55064,"_3068":55270},[],{"_3612":1443,"_31165":1335,"_21586":55375,"_5":14831,"_28346":55064,"_3068":55376},[],"HTTP URL of Lamassu's Device Manager.",{"_3612":1444,"_31165":1335,"_21586":55378,"_5":14831,"_28346":55064,"_3068":55379},[],"`ca_client`",{"_3612":1445,"_31165":1335,"_21586":55381,"_5":14831,"_28346":55064,"_3068":25766},[],{"_3612":1446,"_31165":1335,"_21586":55383,"_5":14831,"_28346":55064,"_3068":55270},[],{"_3612":1447,"_31165":1335,"_21586":55385,"_5":14831,"_28346":55064,"_3068":55386},[],"HTTP URL of Lamassu's CA service.",{"_3612":1448,"_31165":1335,"_21586":55388,"_5":14831,"_28346":55068,"_3068":55389},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3612":1449,"_31165":1335,"_21586":55391,"_5":14831,"_28346":55068,"_3068":55392},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3612":1450,"_31165":1335,"_21586":55394,"_5":14831,"_28346":55068,"_3068":55395},[],"CloudEvent type",{"_3612":1451,"_31165":1335,"_21586":55397,"_5":14831,"_28346":55068,"_3068":55398},[],"Lamassu resource",{"_3612":1452,"_31165":1335,"_21586":55400,"_5":14831,"_28346":55068,"_3068":55401},[],"AWS Resource",{"_3612":1453,"_31165":1335,"_21586":55403,"_5":14831,"_28346":55068,"_3068":55404},[],"IAM actions",{"_3612":1454,"_31165":1335,"_21586":55406,"_5":14831,"_28346":55068,"_3068":55407},[],"AWS calls and effect",{"_3612":1455,"_31165":1335,"_21586":55409,"_5":14831,"_28346":55068,"_3068":55410},[],"Where in this page",{"_3612":1456,"_31165":1335,"_21586":55412,"_5":14831,"_28346":55068,"_3068":55413},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3612":1457,"_31165":1335,"_21586":55415,"_5":14831,"_28346":55068,"_3068":55416},[],"CA",{"_3612":1458,"_31165":1335,"_21586":55418,"_5":14831,"_28346":55068,"_3068":55419},[],"`IoTCore/CACertificate`",{"_3612":1459,"_31165":1335,"_21586":55421,"_5":14831,"_28346":55068,"_3068":55422},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3612":1460,"_31165":1335,"_21586":55424,"_5":14831,"_28346":55068,"_3068":55425},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3612":1461,"_31165":1335,"_21586":55427,"_5":14831,"_28346":55068,"_3068":55081},[],{"_3612":1462,"_31165":1335,"_21586":55429,"_5":14831,"_28346":55068,"_3068":55430},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3612":1463,"_31165":1335,"_21586":55432,"_5":14831,"_28346":55068,"_3068":55433},[],"DMS",{"_3612":1464,"_31165":1335,"_21586":55435,"_5":14831,"_28346":55068,"_3068":55436},[],"`IoTCore/ProvisioningTemplate`",{"_3612":1465,"_31165":1335,"_21586":55438,"_5":14831,"_28346":55068,"_3068":55439},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3612":1466,"_31165":1335,"_21586":55441,"_5":14831,"_28346":55068,"_3068":55442},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3612":1467,"_31165":1335,"_21586":55444,"_5":14831,"_28346":55068,"_3068":55109},[],{"_3612":1468,"_31165":1335,"_21586":55446,"_5":14831,"_28346":55068,"_3068":55447},[],"`EventBindDeviceIdentityKey`",{"_3612":1469,"_31165":1335,"_21586":55449,"_5":14831,"_28346":55068,"_3068":55450},[],"Device",{"_3612":1470,"_31165":1335,"_21586":55452,"_5":14831,"_28346":55068,"_3068":55453},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3612":1471,"_31165":1335,"_21586":55455,"_5":14831,"_28346":55068,"_3068":55456},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3612":1472,"_31165":1335,"_21586":55458,"_5":14831,"_28346":55068,"_3068":55459},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3612":1473,"_31165":1335,"_21586":55461,"_5":14831,"_28346":55068,"_3068":55117},[],{"_3612":1474,"_31165":1335,"_21586":55463,"_5":14831,"_28346":55068,"_3068":55464},[],"`EventUpdateCertificateStatusKey`",{"_3612":1475,"_31165":1335,"_21586":55466,"_5":14831,"_28346":55068,"_3068":55467},[],"Certificate",{"_3612":1476,"_31165":1335,"_21586":55469,"_5":14831,"_28346":55068,"_3068":55470},[],"`IoTCore/Certificate`",{"_3612":1477,"_31165":1335,"_21586":55472,"_5":14831,"_28346":55068,"_3068":55473},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3612":1478,"_31165":1335,"_21586":55475,"_5":14831,"_28346":55068,"_3068":55476},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3612":1479,"_31165":1335,"_21586":55478,"_5":14831,"_28346":55068,"_3068":55129},[],{"_3612":1480,"_31165":1335,"_21586":55480,"_5":14831,"_28346":55068,"_3068":55481},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3612":1481,"_31165":1335,"_21586":55483,"_5":14831,"_28346":55068,"_3068":55484},[],"Certificate / Device",{"_3612":1482,"_31165":1335,"_21586":55486,"_5":14831,"_28346":55068,"_3068":55487},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3612":1483,"_31165":1335,"_21586":55489,"_5":14831,"_28346":55068,"_3068":51286},[],{"_3612":1484,"_31165":1335,"_21586":55491,"_5":14831,"_28346":55068,"_3068":55492},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3612":1485,"_31165":1335,"_21586":55494,"_5":14831,"_28346":55068,"_3068":55137},[],{"_3612":1486,"_31165":1335,"_21586":55496,"_5":14831,"_28346":55072,"_3068":55497},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3612":1487,"_31165":1335,"_21586":55499,"_5":14831,"_28346":55076,"_3068":55500},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3612":1488,"_31165":1335,"_21586":55502,"_5":14831,"_28346":55076,"_3068":55503},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3612":1489,"_31165":1335,"_21586":55505,"_5":14831,"_28346":55080,"_3068":55506},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3612":1490,"_31165":1335,"_21586":55508,"_5":14831,"_28346":55080,"_3068":55509},[],"Transition",{"_3612":1491,"_31165":1335,"_21586":55511,"_5":14831,"_28346":55080,"_3068":55512},[],"AWS calls",{"_3612":1492,"_31165":1335,"_21586":55514,"_5":14831,"_28346":55080,"_3068":55515},[],"`NotRegistered` → `Requested`",{"_3612":1493,"_31165":1335,"_21586":55517,"_5":14831,"_28346":55080,"_3068":55518},[],"none (metadata write only)",{"_3612":1494,"_31165":1335,"_21586":55520,"_5":14831,"_28346":55080,"_3068":55521},[],"`Requested` → `Registering`",{"_3612":1495,"_31165":1335,"_21586":55523,"_5":14831,"_28346":55080,"_3068":55524},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3612":1496,"_31165":1335,"_21586":55526,"_5":14831,"_28346":55080,"_3068":55527},[],"`Registering` → `Succeeded`",{"_3612":1497,"_31165":1335,"_21586":55529,"_5":14831,"_28346":55080,"_3068":55530},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3612":1498,"_31165":1335,"_21586":55532,"_5":14831,"_28346":55080,"_3068":55533},[],"`Registering` → `Failed`",{"_3612":1499,"_31165":1335,"_21586":55535,"_5":14831,"_28346":55080,"_3068":55536},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3612":1500,"_31165":1335,"_21586":55538,"_5":14831,"_28346":55080,"_3068":55539},[],"`Failed` / `Succeeded` → `Requested`",{"_3612":1501,"_31165":1335,"_21586":55541,"_5":14831,"_28346":55080,"_3068":55542},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3612":1502,"_31165":1335,"_21586":55544,"_5":14831,"_28346":55084,"_3068":55545},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3612":1503,"_31165":1335,"_21586":55547,"_5":14831,"_28346":55084,"_3068":55548},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3612":1504,"_31165":1335,"_21586":55550,"_5":14831,"_28346":55084,"_3068":55551},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3612":1505,"_31165":1335,"_21586":55553,"_5":14831,"_28346":55084,"_3068":55554},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3612":1506,"_31165":1335,"_21586":55556,"_5":14831,"_28346":55084,"_3068":55557},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3612":1507,"_31165":1335,"_21586":55559,"_5":14831,"_28346":55084,"_3068":55560},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3612":1508,"_31165":1335,"_21586":55562,"_5":14831,"_28346":55088,"_3068":55563},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3612":1509,"_31165":1335,"_21586":55565,"_5":14831,"_28346":55092,"_3068":55566},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3612":1510,"_31165":1335,"_21586":55568,"_5":14831,"_28346":55092,"_3068":55569},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3612":1511,"_31165":1335,"_21586":55571,"_5":14831,"_28346":55096,"_3068":55572},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3612":1512,"_31165":1335,"_21586":55574,"_5":14831,"_28346":55100,"_3068":55575},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3612":1513,"_31165":1335,"_21586":55577,"_5":14831,"_28346":55100,"_3068":55578},[],"Creates or updates the IoT policies configured in the DMS.",{"_3612":1514,"_31165":1335,"_21586":55580,"_5":14831,"_28346":55100,"_3068":55581},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3612":1515,"_31165":1335,"_21586":55583,"_5":14831,"_28346":55100,"_3068":55584},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3612":1516,"_31165":1335,"_21586":55586,"_5":14831,"_28346":55100,"_3068":55587},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3612":1517,"_31165":1335,"_21586":55589,"_5":14831,"_28346":55100,"_3068":55590},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3612":1518,"_31165":1335,"_21586":55592,"_5":14831,"_28346":55100,"_3068":55593},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3612":1519,"_31165":1335,"_21586":55595,"_5":14831,"_28346":55104,"_3068":55596},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3612":1520,"_31165":1335,"_21586":55598,"_5":14831,"_28346":55104,"_3068":55599},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3612":1521,"_31165":1335,"_21586":55601,"_5":14831,"_28346":55104,"_3068":55602},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3612":1522,"_31165":1335,"_21586":55604,"_5":14831,"_28346":55104,"_3068":55605},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3612":1523,"_31165":1335,"_21586":55607,"_5":14831,"_28346":55104,"_3068":55608},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3612":1524,"_31165":1335,"_21586":55610,"_5":14831,"_28346":55108,"_3068":55611},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3612":1525,"_31165":1335,"_21586":55613,"_5":14831,"_28346":55108,"_3068":55509},[],{"_3612":1526,"_31165":1335,"_21586":55615,"_5":14831,"_28346":55108,"_3068":55512},[],{"_3612":1527,"_31165":1335,"_21586":55617,"_5":14831,"_28346":55108,"_3068":55618},[],"`Unconfigured` → `None` / `Auto`",{"_3612":1528,"_31165":1335,"_21586":55620,"_5":14831,"_28346":55108,"_3068":55621},[],"none (configuration only)",{"_3612":1529,"_31165":1335,"_21586":55623,"_5":14831,"_28346":55108,"_3068":55624},[],"`None` ↔ `Auto`",{"_3612":1530,"_31165":1335,"_21586":55626,"_5":14831,"_28346":55108,"_3068":55621},[],{"_3612":1531,"_31165":1335,"_21586":55628,"_5":14831,"_28346":55108,"_3068":55629},[],"Any → `Jitp`",{"_3612":1532,"_31165":1335,"_21586":55631,"_5":14831,"_28346":55108,"_3068":55632},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3612":1533,"_31165":1335,"_21586":55634,"_5":14831,"_28346":55108,"_3068":55635},[],"`Jitp` → `None` / `Auto`",{"_3612":1534,"_31165":1335,"_21586":55637,"_5":14831,"_28346":55108,"_3068":55638},[],"none (the template stays in the AWS account)",{"_3612":1535,"_31165":1335,"_21586":55640,"_5":14831,"_28346":55112,"_3068":55641},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3612":1536,"_31165":1335,"_21586":55643,"_5":14831,"_28346":55112,"_3068":55644},[],"The full flow from the device's perspective is:",{"_3612":1537,"_31165":1335,"_21586":55646,"_5":14831,"_28346":55112,"_3068":55647},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3612":1538,"_31165":1335,"_21586":55649,"_5":14831,"_28346":55116,"_3068":55650},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3612":1539,"_31165":1335,"_21586":55652,"_5":14831,"_28346":55116,"_3068":55509},[],{"_3612":1540,"_31165":1335,"_21586":55654,"_5":14831,"_28346":55116,"_3068":55512},[],{"_3612":1541,"_31165":1335,"_21586":55656,"_5":14831,"_28346":55116,"_3068":55657},[],"`Absent` → `Provisioned`",{"_3612":1542,"_31165":1335,"_21586":55659,"_5":14831,"_28346":55116,"_3068":55660},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3612":1543,"_31165":1335,"_21586":55662,"_5":14831,"_28346":55116,"_3068":55663},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3612":1544,"_31165":1335,"_21586":55665,"_5":14831,"_28346":55116,"_3068":55666},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3612":1545,"_31165":1335,"_21586":55668,"_5":14831,"_28346":55116,"_3068":55669},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3612":1546,"_31165":1335,"_21586":55671,"_5":14831,"_28346":55120,"_3068":55672},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3612":1547,"_31165":1335,"_21586":55674,"_5":14831,"_28346":55120,"_3068":55675},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3612":1548,"_31165":1335,"_21586":55677,"_5":14831,"_28346":55120,"_3068":55678},[],"For the JITP flow to work correctly:",{"_3612":1549,"_31165":1335,"_21586":55680,"_5":14831,"_28346":55120,"_3068":55681},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3612":1550,"_31165":1335,"_21586":55683,"_5":14831,"_28346":55120,"_3068":55684},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3612":1551,"_31165":1335,"_21586":55686,"_5":14831,"_28346":55120,"_3068":55687},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3612":1552,"_31165":1335,"_21586":55689,"_5":14831,"_28346":55120,"_3068":55690},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3612":1553,"_31165":1335,"_21586":55692,"_5":14831,"_28346":55124,"_3068":55693},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3612":1554,"_31165":1335,"_21586":55695,"_5":14831,"_28346":55124,"_3068":55696},[],"Status in Lamassu",{"_3612":1555,"_31165":1335,"_21586":55698,"_5":14831,"_28346":55124,"_3068":55699},[],"Revocation reason",{"_3612":1556,"_31165":1335,"_21586":55701,"_5":14831,"_28346":55124,"_3068":55702},[],"Status in AWS IoT Core",{"_3612":1557,"_31165":1335,"_21586":55704,"_5":14831,"_28346":55124,"_3068":55705},[],"`Active`",{"_3612":1558,"_31165":1335,"_21586":55707,"_5":14831,"_28346":55124,"_3068":55708},[],"None",{"_3612":1559,"_31165":1335,"_21586":55710,"_5":14831,"_28346":55124,"_3068":55711},[],"`ACTIVE`",{"_3612":1560,"_31165":1335,"_21586":55713,"_5":14831,"_28346":55124,"_3068":55714},[],"`Revoked`",{"_3612":1561,"_31165":1335,"_21586":55716,"_5":14831,"_28346":55124,"_3068":55717},[],"`certificateHold`",{"_3612":1562,"_31165":1335,"_21586":55719,"_5":14831,"_28346":55124,"_3068":55720},[],"`INACTIVE`",{"_3612":1563,"_31165":1335,"_21586":55722,"_5":14831,"_28346":55124,"_3068":55714},[],{"_3612":1564,"_31165":1335,"_21586":55724,"_5":14831,"_28346":55124,"_3068":55725},[],"Any other reason",{"_3612":1565,"_31165":1335,"_21586":55727,"_5":14831,"_28346":55124,"_3068":55728},[],"`REVOKED`",{"_3612":1566,"_31165":1335,"_21586":55730,"_5":14831,"_28346":55124,"_3068":55731},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3612":1567,"_31165":1335,"_21586":55733,"_5":14831,"_28346":55128,"_3068":55734},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3612":1568,"_31165":1335,"_21586":55736,"_5":14831,"_28346":55128,"_3068":55509},[],{"_3612":1569,"_31165":1335,"_21586":55738,"_5":14831,"_28346":55128,"_3068":55512},[],{"_3612":1570,"_31165":1335,"_21586":55740,"_5":14831,"_28346":55128,"_3068":55741},[],"`NotSynced` → `Active`",{"_3612":1571,"_31165":1335,"_21586":55743,"_5":14831,"_28346":55128,"_3068":55220},[],{"_3612":1572,"_31165":1335,"_21586":55745,"_5":14831,"_28346":55128,"_3068":55746},[],"`Active` → `Inactive`",{"_3612":1573,"_31165":1335,"_21586":55748,"_5":14831,"_28346":55128,"_3068":55749},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3612":1574,"_31165":1335,"_21586":55751,"_5":14831,"_28346":55128,"_3068":55752},[],"`Active` → `Revoked`",{"_3612":1575,"_31165":1335,"_21586":55754,"_5":14831,"_28346":55128,"_3068":55749},[],{"_3612":1576,"_31165":1335,"_21586":55756,"_5":14831,"_28346":55128,"_3068":55757},[],"`Inactive` / `Revoked` → `Active`",{"_3612":1577,"_31165":1335,"_21586":55759,"_5":14831,"_28346":55128,"_3068":55220},[],{"_3612":1578,"_31165":1335,"_21586":55761,"_5":14831,"_28346":55128,"_3068":55762},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3612":1579,"_31165":1335,"_21586":55764,"_5":14831,"_28346":55128,"_3068":55765},[],"none (these states are not synced to AWS)",{"_3612":1580,"_31165":1335,"_21586":55767,"_5":14831,"_28346":55132,"_3068":55768},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3612":1581,"_31165":1335,"_21586":55770,"_5":14831,"_28346":55132,"_3068":55771},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3612":1582,"_31165":1335,"_21586":55773,"_5":14831,"_28346":55132,"_3068":55774},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3612":1583,"_31165":1335,"_21586":55776,"_5":14831,"_28346":55136,"_3068":55777},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3612":1584,"_31165":1335,"_21586":55779,"_5":14831,"_28346":55136,"_3068":55780},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3612":1585,"_31165":1335,"_21586":55782,"_5":14831,"_28346":55140,"_3068":55783},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3612":1586,"_31165":1335,"_21586":55785,"_5":14831,"_28346":55140,"_3068":55786},[],"There are two action types:",{"_3612":1587,"_31165":1335,"_21586":55788,"_5":14831,"_28346":55140,"_3068":55789},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3612":1588,"_31165":1335,"_21586":55791,"_5":14831,"_28346":55140,"_3068":55792},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3612":1589,"_31165":1335,"_21586":55794,"_5":14831,"_28346":55140,"_3068":55795},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3612":1590,"_31165":1335,"_21586":55797,"_5":14831,"_28346":55144,"_3068":55798},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3612":1591,"_31165":1335,"_21586":55800,"_5":14831,"_28346":55144,"_3068":55801},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3612":1592,"_31165":1335,"_21586":55803,"_5":14831,"_28346":55144,"_3068":55804},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3612":1593,"_31165":1335,"_21586":55806,"_5":14831,"_28346":55148,"_3068":55807},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3612":1594,"_31165":1335,"_21586":55809,"_5":14831,"_28346":55148,"_3068":55810},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3612":1595,"_31165":1335,"_21586":55812,"_5":14831,"_28346":55148,"_3068":55813},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3612":1596,"_31165":1335,"_21586":55815,"_5":14831,"_28346":55148,"_3068":55816},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3612":1597,"_31165":1335,"_21586":55818,"_5":14831,"_28346":55148,"_3068":55819},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3612":1598,"_31165":1335,"_21586":55821,"_5":14831,"_28346":55148,"_3068":55822},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3612":1599,"_31165":1335,"_21586":55824,"_5":14831,"_28346":55148,"_3068":55825},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3612":1600,"_31165":1335,"_21586":55827,"_5":14831,"_28346":55148,"_3068":55828},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3612":1601,"_31165":1335,"_21586":55830,"_5":14831,"_28346":55148,"_3068":55831},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3612":1602,"_31165":1335,"_21586":55833,"_5":14831,"_28346":55148,"_3068":55834},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3612":1603,"_31165":1335,"_21586":55836,"_5":14831,"_28346":55148,"_3068":55837},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3612":1604,"_31165":1335,"_21586":55839,"_5":14831,"_28346":55148,"_3068":55840},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3612":1605,"_31165":1335,"_21586":55842,"_5":14831,"_28346":55148,"_3068":55843},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3612":1606,"_31165":1335,"_21586":55845,"_5":14831,"_28346":55148,"_3068":55846},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3612":1607,"_31165":1335,"_21586":55848,"_5":14831,"_28346":55148,"_3068":55849},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3612":1608,"_31165":1335,"_21586":55851,"_5":14831,"_28346":55148,"_3068":55852},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3612":1609,"_31165":1335,"_21586":55854,"_5":14831,"_28346":55148,"_3068":55855},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3612":1610,"_31165":1335,"_21586":55857,"_5":14831,"_28346":55148,"_3068":55858},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3612":1611,"_31165":1335,"_21586":55860,"_5":14831,"_28346":55148,"_3068":55861},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3612":1612,"_31165":1335,"_21586":55863,"_5":14831,"_28346":55148,"_3068":55864},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3612":1613,"_31165":1335,"_21586":55866,"_5":14831,"_28346":55148,"_3068":55867},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3612":1614,"_31165":1335,"_21586":55869,"_5":14831,"_28346":55148,"_3068":55870},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3612":1615,"_31165":1335,"_21586":55872,"_5":14831,"_28346":55148,"_3068":55873},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3612":1616,"_31165":1335,"_21586":55875,"_5":14831,"_28346":55148,"_3068":55876},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3612":1617,"_31165":1617,"_5":15196,"_3068":53574,"_31523":55878,"_21586":55879,"_28346":1617},[50890,52402,53574],[],{"_3612":1618,"_31165":1617,"_21586":55881,"_5":14831,"_28346":1617,"_3068":55882},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3612":1619,"_31165":1617,"_5":31520,"_21586":55884,"_28346":55885,"_3068":55886},[],"/docs/pr-preview/pr-77/platform/iot-fleets/overview#start-here","Start here",{"_3612":1620,"_31165":1617,"_5":31520,"_21586":55888,"_28346":55889,"_3068":53572},[],"/docs/pr-preview/pr-77/platform/iot-fleets/overview#devices-and-identities",{"_3612":1621,"_31165":1617,"_5":31520,"_21586":55891,"_28346":55892,"_3068":53758},[],"/docs/pr-preview/pr-77/platform/iot-fleets/overview#enrollment-with-pki",{"_3612":1622,"_31165":1617,"_5":31520,"_21586":55894,"_28346":55895,"_3068":55045},[],"/docs/pr-preview/pr-77/platform/iot-fleets/overview#integrations",{"_3612":1623,"_31165":1617,"_5":31520,"_21586":55897,"_28346":55898,"_3068":55899},[],"/docs/pr-preview/pr-77/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3612":1624,"_31165":1617,"_21586":55901,"_5":14831,"_28346":1617,"_3068":55902},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3612":1625,"_31165":1617,"_21586":55904,"_5":14831,"_28346":55885,"_3068":55905},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3612":1626,"_31165":1617,"_21586":55907,"_5":14831,"_28346":55885,"_3068":55908},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3612":1627,"_31165":1617,"_21586":55910,"_5":14831,"_28346":55889,"_3068":55911},[],"Resource",{"_3612":1628,"_31165":1617,"_21586":55913,"_5":14831,"_28346":55889,"_3068":55914},[],"What it represents",{"_3612":1629,"_31165":1617,"_21586":55916,"_5":14831,"_28346":55889,"_3068":55917},[],"**Device**",{"_3612":1630,"_31165":1617,"_21586":55919,"_5":14831,"_28346":55889,"_3068":55920},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3612":1631,"_31165":1617,"_21586":55922,"_5":14831,"_28346":55889,"_3068":55923},[],"**Identity**",{"_3612":1632,"_31165":1617,"_21586":55925,"_5":14831,"_28346":55889,"_3068":55926},[],"The device's association with its certificates: an active version and a history.",{"_3612":1633,"_31165":1617,"_21586":55928,"_5":14831,"_28346":55889,"_3068":55929},[],"**DMS**",{"_3612":1634,"_31165":1617,"_21586":55931,"_5":14831,"_28346":55889,"_3068":55932},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3612":1635,"_31165":1617,"_21586":55934,"_5":14831,"_28346":55889,"_3068":55935},[],"**Fleet**",{"_3612":1636,"_31165":1617,"_21586":55937,"_5":14831,"_28346":55889,"_3068":55938},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3612":1637,"_31165":1617,"_21586":55940,"_5":14831,"_28346":55889,"_3068":55941},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3612":1638,"_31165":1617,"_21586":55943,"_5":14831,"_28346":55889,"_3068":55944},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3612":1639,"_31165":1617,"_21586":55946,"_5":14831,"_28346":55892,"_3068":55947},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3612":1640,"_31165":1617,"_21586":55949,"_5":14831,"_28346":55892,"_3068":55950},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3612":1641,"_31165":1617,"_21586":55952,"_5":14831,"_28346":55892,"_3068":55953},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3612":1642,"_31165":1617,"_21586":55955,"_5":14831,"_28346":55892,"_3068":55956},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3612":1643,"_31165":1617,"_21586":55958,"_5":14831,"_28346":55892,"_3068":55959},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3612":1644,"_31165":1617,"_21586":55961,"_5":14831,"_28346":55892,"_3068":55962},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3612":1645,"_31165":1617,"_21586":55964,"_5":14831,"_28346":55892,"_3068":55965},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3612":1646,"_31165":1617,"_21586":55967,"_5":14831,"_28346":55892,"_3068":55968},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3612":1647,"_31165":1617,"_21586":55970,"_5":14831,"_28346":55895,"_3068":55971},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3612":1648,"_31165":1617,"_21586":55973,"_5":14831,"_28346":55895,"_3068":55974},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3612":1649,"_31165":1617,"_21586":55976,"_5":14831,"_28346":55898,"_3068":55977},[],"Participant",{"_3612":1650,"_31165":1617,"_21586":55979,"_5":14831,"_28346":55898,"_3068":55980},[],"Responsibility",{"_3612":1651,"_31165":1617,"_21586":55982,"_5":14831,"_28346":55898,"_3068":55983},[],"PKI administrator",{"_3612":1652,"_31165":1617,"_21586":55985,"_5":14831,"_28346":55898,"_3068":55986},[],"CA, issuance profile, chain and revocation publication.",{"_3612":1653,"_31165":1617,"_21586":55988,"_5":14831,"_28346":55898,"_3068":55989},[],"Provisioning administrator",{"_3612":1654,"_31165":1617,"_21586":55991,"_5":14831,"_28346":55898,"_3068":55992},[],"DMS, admission, authentication per operation and inventory.",{"_3612":1655,"_31165":1617,"_21586":55994,"_5":14831,"_28346":55898,"_3068":55995},[],"Device integrator",{"_3612":1656,"_31165":1617,"_21586":55997,"_5":14831,"_28346":55898,"_3068":55998},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3612":1657,"_31165":1617,"_21586":56000,"_5":14831,"_28346":55898,"_3068":56001},[],"Consumer integrator",{"_3612":1658,"_31165":1617,"_21586":56003,"_5":14831,"_28346":55898,"_3068":56004},[],"Trusted issuers, validation and device permissions in the destination.",{"_3612":1659,"_31165":1617,"_21586":56006,"_5":14831,"_28346":55898,"_3068":56007},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3612":1660,"_31165":1660,"_5":15196,"_3068":56009,"_31523":56010,"_21586":56012,"_28346":1660},"Enroll and connect your first device",[50890,52402,53574,56011],"Getting started",[],{"_3612":1661,"_31165":1660,"_21586":56014,"_5":14831,"_28346":1660,"_3068":56015},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3612":1662,"_31165":1660,"_5":31520,"_21586":56017,"_28346":56018,"_3068":50900},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3612":1663,"_31165":1660,"_5":31520,"_21586":56020,"_28346":56021,"_3068":56022},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3612":1664,"_31165":1660,"_5":31520,"_21586":56024,"_28346":56025,"_3068":56026},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3612":1665,"_31165":1660,"_5":31520,"_21586":56028,"_28346":56029,"_3068":56030},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3612":1666,"_31165":1660,"_5":31520,"_21586":56032,"_28346":56033,"_3068":56034},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3612":1667,"_31165":1660,"_5":31520,"_21586":56036,"_28346":56037,"_3068":56038},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3612":1668,"_31165":1660,"_5":31520,"_21586":56040,"_28346":56041,"_3068":56042},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3612":1669,"_31165":1660,"_5":31520,"_21586":56044,"_28346":56045,"_3068":56046},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3612":1670,"_31165":1660,"_21586":56048,"_5":14831,"_28346":1660,"_3068":56049},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3612":1671,"_31165":1660,"_21586":56051,"_5":14831,"_28346":56018,"_3068":56052},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3612":1672,"_31165":1660,"_21586":56054,"_5":14831,"_28346":56018,"_3068":56055},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3612":1673,"_31165":1660,"_21586":56057,"_5":14831,"_28346":56018,"_3068":56058},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3612":1674,"_31165":1660,"_21586":56060,"_5":14831,"_28346":56018,"_3068":56061},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3612":1675,"_31165":1660,"_21586":56063,"_5":14831,"_28346":56018,"_3068":56064},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3612":1676,"_31165":1660,"_21586":56066,"_5":14831,"_28346":56021,"_3068":56067},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3612":1677,"_31165":1660,"_21586":56069,"_5":14831,"_28346":56021,"_3068":56070},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3612":1678,"_31165":1660,"_21586":56072,"_5":14831,"_28346":56025,"_3068":56073},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3612":1679,"_31165":1660,"_21586":56075,"_5":14831,"_28346":56025,"_3068":56076},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3612":1680,"_31165":1660,"_21586":56078,"_5":14831,"_28346":56025,"_3068":56079},[],"Setting",{"_3612":1681,"_31165":1660,"_21586":56081,"_5":14831,"_28346":56025,"_3068":56082},[],"Evaluation value",{"_3612":1682,"_31165":1660,"_21586":56084,"_5":14831,"_28346":56025,"_3068":56085},[],"Enrollment CA",{"_3612":1683,"_31165":1660,"_21586":56087,"_5":14831,"_28346":56025,"_3068":56088},[],"Issuing root from `device-root.pem`.",{"_3612":1684,"_31165":1660,"_21586":56090,"_5":14831,"_28346":56025,"_3068":53888},[],{"_3612":1685,"_31165":1660,"_21586":56092,"_5":14831,"_28346":56025,"_3068":56093},[],"The 1-hour leaf profile you just prepared.",{"_3612":1686,"_31165":1660,"_21586":56095,"_5":14831,"_28346":56025,"_3068":56096},[],"Protocol / Registration Mode",{"_3612":1687,"_31165":1660,"_21586":56098,"_5":14831,"_28346":56025,"_3068":56099},[],"`EST_RFC7030` / `JITP`.",{"_3612":1688,"_31165":1660,"_21586":56101,"_5":14831,"_28346":56025,"_3068":56102},[],"Verify CSR Signature",{"_3612":1689,"_31165":1660,"_21586":56104,"_5":14831,"_28346":56025,"_3068":56105},[],"Enabled.",{"_3612":1690,"_31165":1660,"_21586":56107,"_5":14831,"_28346":56025,"_3068":56108},[],"Enable Replaceable Enrollment",{"_3612":1691,"_31165":1660,"_21586":56110,"_5":14831,"_28346":56025,"_3068":56111},[],"Disabled; the ID must be new.",{"_3612":1692,"_31165":1660,"_21586":56113,"_5":14831,"_28346":56025,"_3068":56114},[],"Initial authentication",{"_3612":1693,"_31165":1660,"_21586":56116,"_5":14831,"_28346":56025,"_3068":56117},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3612":1694,"_31165":1660,"_21586":56119,"_5":14831,"_28346":56025,"_3068":56120},[],"Renewal authentication",{"_3612":1695,"_31165":1660,"_21586":56122,"_5":14831,"_28346":56025,"_3068":56123},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3612":1696,"_31165":1660,"_21586":56125,"_5":14831,"_28346":56025,"_3068":56126},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3612":1697,"_31165":1660,"_21586":56128,"_5":14831,"_28346":56025,"_3068":56129},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3612":1698,"_31165":1660,"_21586":56131,"_5":14831,"_28346":56025,"_3068":56132},[],"Re-enrollment Delta",{"_3612":1699,"_31165":1660,"_21586":56134,"_5":14831,"_28346":56025,"_3068":56135},[],"1 hour.",{"_3612":1700,"_31165":1660,"_21586":56137,"_5":14831,"_28346":56025,"_3068":56138},[],"Preventive / Critical Delta",{"_3612":1701,"_31165":1660,"_21586":56140,"_5":14831,"_28346":56025,"_3068":56141},[],"30 minutes / 10 minutes.",{"_3612":1702,"_31165":1660,"_21586":56143,"_5":14831,"_28346":56025,"_3068":56144},[],"Revoke on Re-enrollment",{"_3612":1703,"_31165":1660,"_21586":56146,"_5":14831,"_28346":56025,"_3068":56147},[],"Disabled to test the successor before retiring the previous identity.",{"_3612":1704,"_31165":1660,"_21586":56149,"_5":14831,"_28346":56025,"_3068":53896},[],{"_3612":1705,"_31165":1660,"_21586":56151,"_5":14831,"_28346":56025,"_3068":56152},[],"Disabled; the operational key is generated in the client.",{"_3612":1706,"_31165":1660,"_21586":56154,"_5":14831,"_28346":56025,"_3068":56155},[],"CA Distribution",{"_3612":1707,"_31165":1660,"_21586":56157,"_5":14831,"_28346":56025,"_3068":56158},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3612":1708,"_31165":1660,"_21586":56160,"_5":14831,"_28346":56025,"_3068":56161},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3612":1709,"_31165":1660,"_21586":56163,"_5":14831,"_28346":56029,"_3068":56164},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3612":1710,"_31165":1660,"_21586":56166,"_5":14831,"_28346":56029,"_3068":56167},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3612":1711,"_31165":1660,"_21586":56169,"_5":14831,"_28346":56033,"_3068":56170},[],"Generate a new key and CSR with the selected identifier:",{"_3612":1712,"_31165":1660,"_21586":56172,"_5":14831,"_28346":56033,"_3068":56173},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3612":1713,"_31165":1660,"_21586":56175,"_5":14831,"_28346":56033,"_3068":56176},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3612":1714,"_31165":1660,"_21586":56178,"_5":14831,"_28346":56037,"_3068":56179},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3612":1715,"_31165":1660,"_21586":56181,"_5":14831,"_28346":56037,"_3068":56182},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3612":1716,"_31165":1660,"_21586":56184,"_5":14831,"_28346":56041,"_3068":56185},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3612":1717,"_31165":1660,"_21586":56187,"_5":14831,"_28346":56041,"_3068":56188},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3612":1718,"_31165":1660,"_21586":56190,"_5":14831,"_28346":56041,"_3068":56191},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3612":1719,"_31165":1660,"_21586":56193,"_5":14831,"_28346":56041,"_3068":56194},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3612":1720,"_31165":1660,"_21586":56196,"_5":14831,"_28346":56041,"_3068":56197},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3612":1721,"_31165":1660,"_21586":56199,"_5":14831,"_28346":56045,"_3068":56200},[],"Check",{"_3612":1722,"_31165":1660,"_21586":56202,"_5":14831,"_28346":56045,"_3068":56203},[],"Expected result",{"_3612":1723,"_31165":1660,"_21586":56205,"_5":14831,"_28346":56045,"_3068":56206},[],"Registration",{"_3612":1724,"_31165":1660,"_21586":56208,"_5":14831,"_28346":56045,"_3068":56209},[],"ID created automatically and correct DMS.",{"_3612":1725,"_31165":1660,"_21586":56211,"_5":14831,"_28346":56045,"_3068":55467},[],{"_3612":1726,"_31165":1660,"_21586":56213,"_5":14831,"_28346":56045,"_3068":56214},[],"CN, profile, serial and key verified.",{"_3612":1727,"_31165":1660,"_21586":56216,"_5":14831,"_28346":56045,"_3068":56217},[],"Inventory",{"_3612":1728,"_31165":1660,"_21586":56219,"_5":14831,"_28346":56045,"_3068":56220},[],"Received serial visible as the current identity and in history.",{"_3612":1729,"_31165":1660,"_21586":56222,"_5":14831,"_28346":56045,"_3068":56223},[],"Consumer",{"_3612":1730,"_31165":1660,"_21586":56225,"_5":14831,"_28346":56045,"_3068":56226},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3612":1731,"_31165":1660,"_21586":56228,"_5":14831,"_28346":56045,"_3068":56229},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3612":1732,"_31165":1660,"_21586":56231,"_5":14831,"_28346":56045,"_3068":56232},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3612":1733,"_31165":1733,"_5":15196,"_3068":53590,"_31523":56234,"_21586":56235,"_28346":1733},[50890,52402,53574,56011],[],{"_3612":1734,"_31165":1733,"_21586":56237,"_5":14831,"_28346":1733,"_3068":56238},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3612":1735,"_31165":1733,"_5":31520,"_21586":56240,"_28346":56241,"_3068":50900},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3612":1736,"_31165":1733,"_5":31520,"_21586":56243,"_28346":56244,"_3068":56245},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3612":1737,"_31165":1733,"_5":31520,"_21586":56247,"_28346":56248,"_3068":56249},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3612":1738,"_31165":1733,"_5":31520,"_21586":56251,"_28346":56252,"_3068":56253},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3612":1739,"_31165":1733,"_5":31520,"_21586":56255,"_28346":56256,"_3068":56257},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3612":1740,"_31165":1733,"_5":31520,"_21586":56259,"_28346":56260,"_3068":56261},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3612":1741,"_31165":1733,"_5":31520,"_21586":56263,"_28346":56264,"_3068":56203},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3612":1742,"_31165":1733,"_5":31520,"_21586":56266,"_28346":56267,"_3068":56268},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3612":1743,"_31165":1733,"_5":31520,"_21586":56270,"_28346":56271,"_3068":56272},[],"/docs/pr-preview/pr-77/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3612":1744,"_31165":1733,"_21586":56274,"_5":14831,"_28346":1733,"_3068":56275},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3612":1745,"_31165":1733,"_21586":56277,"_5":14831,"_28346":1733,"_3068":56278},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3612":1746,"_31165":1733,"_21586":56280,"_5":14831,"_28346":56241,"_3068":56281},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3612":1747,"_31165":1733,"_21586":56283,"_5":14831,"_28346":56241,"_3068":56284},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3612":1748,"_31165":1733,"_21586":56286,"_5":14831,"_28346":56241,"_3068":56287},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3612":1749,"_31165":1733,"_21586":56289,"_5":14831,"_28346":56241,"_3068":56290},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3612":1750,"_31165":1733,"_21586":56292,"_5":14831,"_28346":56244,"_3068":56293},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3612":1751,"_31165":1733,"_21586":56295,"_5":14831,"_28346":56244,"_3068":56296},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3612":1752,"_31165":1733,"_21586":56298,"_5":14831,"_28346":56244,"_3068":56299},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3612":1753,"_31165":1733,"_21586":56301,"_5":14831,"_28346":56244,"_3068":56302},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3612":1754,"_31165":1733,"_21586":56304,"_5":14831,"_28346":56244,"_3068":56305},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3612":1755,"_31165":1733,"_21586":56307,"_5":14831,"_28346":56244,"_3068":56308},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3612":1756,"_31165":1733,"_21586":56310,"_5":14831,"_28346":56244,"_3068":56311},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3612":1757,"_31165":1733,"_21586":56313,"_5":14831,"_28346":56244,"_3068":56314},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3612":1758,"_31165":1733,"_21586":56316,"_5":14831,"_28346":56248,"_3068":56317},[],"Open **Managed Devices** and the registration action. Complete:",{"_3612":1759,"_31165":1733,"_21586":56319,"_5":14831,"_28346":56248,"_3068":56320},[],"**Device ID**: `device-001`.",{"_3612":1760,"_31165":1733,"_21586":56322,"_5":14831,"_28346":56248,"_3068":56323},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3612":1761,"_31165":1733,"_21586":56325,"_5":14831,"_28346":56248,"_3068":56326},[],"**Icon** and **Tags**: optional classification.",{"_3612":1762,"_31165":1733,"_21586":56328,"_5":14831,"_28346":56248,"_3068":56329},[],"Confirm registration.",{"_3612":1763,"_31165":1733,"_21586":56331,"_5":14831,"_28346":56252,"_3068":56332},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3612":1764,"_31165":1733,"_21586":56334,"_5":14831,"_28346":56252,"_3068":56335},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3612":1765,"_31165":1733,"_21586":56337,"_5":14831,"_28346":56256,"_3068":56338},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3612":1766,"_31165":1733,"_21586":56340,"_5":14831,"_28346":56256,"_3068":56341},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3612":1767,"_31165":1733,"_21586":56343,"_5":14831,"_28346":56260,"_3068":56344},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3612":1768,"_31165":1733,"_21586":56346,"_5":14831,"_28346":56260,"_3068":56347},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3612":1769,"_31165":1733,"_21586":56349,"_5":14831,"_28346":56264,"_3068":56200},[],{"_3612":1770,"_31165":1733,"_21586":56351,"_5":14831,"_28346":56264,"_3068":56352},[],"Result",{"_3612":1771,"_31165":1733,"_21586":56354,"_5":14831,"_28346":56264,"_3068":55450},[],{"_3612":1772,"_31165":1733,"_21586":56356,"_5":14831,"_28346":56264,"_3068":56357},[],"`device-001` appears in inventory with the expected DMS.",{"_3612":1773,"_31165":1733,"_21586":56359,"_5":14831,"_28346":56264,"_3068":56360},[],"Current identity",{"_3612":1774,"_31165":1733,"_21586":56362,"_5":14831,"_28346":56264,"_3068":56363},[],"The associated certificate matches the one you verified in PKI.",{"_3612":1775,"_31165":1733,"_21586":56365,"_5":14831,"_28346":56264,"_3068":56366},[],"History",{"_3612":1776,"_31165":1733,"_21586":56368,"_5":14831,"_28346":56264,"_3068":56369},[],"The associated issuance appears with its serial number and dates.",{"_3612":1777,"_31165":1733,"_21586":56371,"_5":14831,"_28346":56264,"_3068":56372},[],"Key and certificate",{"_3612":1778,"_31165":1733,"_21586":56374,"_5":14831,"_28346":56264,"_3068":56375},[],"You have the verified pair ready to install on the device.",{"_3612":1779,"_31165":1733,"_21586":56377,"_5":14831,"_28346":56267,"_3068":56378},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3612":1780,"_31165":1733,"_21586":56380,"_5":14831,"_28346":56267,"_3068":56381},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3612":1781,"_31165":1733,"_21586":56383,"_5":14831,"_28346":56267,"_3068":56384},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3612":1782,"_31165":1733,"_21586":56386,"_5":14831,"_28346":56267,"_3068":56387},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3612":1783,"_31165":1733,"_21586":56389,"_5":14831,"_28346":56271,"_3068":56390},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3612":1784,"_31165":1733,"_21586":56392,"_5":14831,"_28346":56271,"_3068":56393},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3612":1785,"_31165":1733,"_21586":56395,"_5":14831,"_28346":56271,"_3068":56396},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3612":1786,"_31165":1786,"_5":15196,"_3068":56398,"_31523":56399,"_21586":56400,"_28346":1786},"Lamassu IoT Platform",[50890,52402],[],{"_3612":1787,"_31165":1786,"_21586":56402,"_5":14831,"_28346":1786,"_3068":56403},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3612":1788,"_31165":1786,"_5":31520,"_21586":56405,"_28346":56406,"_3068":55886},[],"/docs/pr-preview/pr-77/platform/overview#start-here",{"_3612":1789,"_31165":1786,"_5":31520,"_21586":56408,"_28346":56409,"_3068":56410},[],"/docs/pr-preview/pr-77/platform/overview#choose-your-path","Choose your path",{"_3612":1790,"_31165":1786,"_5":31520,"_21586":56412,"_28346":56413,"_3068":56414},[],"/docs/pr-preview/pr-77/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3612":1791,"_31165":1786,"_5":31520,"_21586":56416,"_28346":56417,"_3068":56418},[],"/docs/pr-preview/pr-77/platform/overview#core-capabilities","Core capabilities",{"_3612":1792,"_31165":1786,"_5":31520,"_21586":56420,"_28346":56421,"_3068":56422},[],"/docs/pr-preview/pr-77/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3612":1793,"_31165":1786,"_5":31520,"_21586":56424,"_28346":56425,"_3068":56426},[],"/docs/pr-preview/pr-77/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3612":1794,"_31165":1786,"_5":31520,"_21586":56428,"_28346":56429,"_3068":56430},[],"/docs/pr-preview/pr-77/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3612":1795,"_31165":1786,"_5":31520,"_21586":56432,"_28346":56433,"_3068":56434},[],"/docs/pr-preview/pr-77/platform/overview#automate-device-identities","Automate device identities",{"_3612":1796,"_31165":1786,"_5":31520,"_21586":56436,"_28346":56437,"_3068":56438},[],"/docs/pr-preview/pr-77/platform/overview#publish-validation-status","Publish validation status",{"_3612":1797,"_31165":1786,"_5":31520,"_21586":56440,"_28346":56441,"_3068":56442},[],"/docs/pr-preview/pr-77/platform/overview#react-to-events","React to events",{"_3612":1798,"_31165":1786,"_5":31520,"_21586":56444,"_28346":56445,"_3068":56446},[],"/docs/pr-preview/pr-77/platform/overview#operational-reference","Operational reference",{"_3612":1799,"_31165":1786,"_21586":56448,"_5":14831,"_28346":1786,"_3068":56449},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3612":1800,"_31165":1786,"_21586":56451,"_5":14831,"_28346":56406,"_3068":56452},[],"Choose the result you need:",{"_3612":1801,"_31165":1786,"_21586":56454,"_5":14831,"_28346":56406,"_3068":56455},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3612":1802,"_31165":1786,"_21586":56457,"_5":14831,"_28346":56406,"_3068":56458},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3612":1803,"_31165":1786,"_21586":56460,"_5":14831,"_28346":56406,"_3068":56461},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3612":1804,"_31165":1786,"_21586":56463,"_5":14831,"_28346":56409,"_3068":56464},[],"Section",{"_3612":1805,"_31165":1786,"_21586":56466,"_5":14831,"_28346":56409,"_3068":56467},[],"What you manage",{"_3612":1806,"_31165":1786,"_21586":56469,"_5":14831,"_28346":56409,"_3068":56470},[],"Entry point",{"_3612":1807,"_31165":1786,"_21586":56472,"_5":14831,"_28346":56409,"_3068":56473},[],"**PKI**",{"_3612":1808,"_31165":1786,"_21586":56475,"_5":14831,"_28346":56409,"_3068":56476},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3612":1809,"_31165":1786,"_21586":56478,"_5":14831,"_28346":56409,"_3068":56479},[],"PKI overview",{"_3612":1810,"_31165":1786,"_21586":56481,"_5":14831,"_28346":56409,"_3068":56482},[],"**IoT Fleets**",{"_3612":1811,"_31165":1786,"_21586":56484,"_5":14831,"_28346":56409,"_3068":56485},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3612":1812,"_31165":1786,"_21586":56487,"_5":14831,"_28346":56409,"_3068":56488},[],"IoT Fleets overview",{"_3612":1813,"_31165":1786,"_21586":56490,"_5":14831,"_28346":56409,"_3068":56491},[],"**Administration**",{"_3612":1814,"_31165":1786,"_21586":56493,"_5":14831,"_28346":56409,"_3068":56494},[],"Operator permissions, audit and event subscriptions.",{"_3612":1815,"_31165":1786,"_21586":56496,"_5":14831,"_28346":56409,"_3068":52404},[],{"_3612":1816,"_31165":1786,"_21586":56498,"_5":14831,"_28346":56409,"_3068":56499},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3612":1817,"_31165":1786,"_21586":56501,"_5":14831,"_28346":56413,"_3068":56502},[],"An identity's journey connects four responsibilities:",{"_3612":1818,"_31165":1786,"_21586":56504,"_5":14831,"_28346":56413,"_3068":56505},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3612":1819,"_31165":1786,"_21586":56507,"_5":14831,"_28346":56413,"_3068":56508},[],"The provisioning administrator configures the DMS and initial trust.",{"_3612":1820,"_31165":1786,"_21586":56510,"_5":14831,"_28346":56413,"_3068":56511},[],"The device client requests a certificate and installs it with the matching key.",{"_3612":1821,"_31165":1786,"_21586":56513,"_5":14831,"_28346":56413,"_3068":56514},[],"The consumer validates the identity and applies its access permissions.",{"_3612":1822,"_31165":1786,"_21586":56516,"_5":14831,"_28346":56413,"_3068":56517},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3612":1823,"_31165":1786,"_21586":56519,"_5":14831,"_28346":56421,"_3068":56520},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3612":1824,"_31165":1786,"_21586":56522,"_5":14831,"_28346":56425,"_3068":56523},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3612":1825,"_31165":1786,"_21586":56525,"_5":14831,"_28346":56429,"_3068":56526},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3612":1826,"_31165":1786,"_21586":56528,"_5":14831,"_28346":56433,"_3068":56529},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3612":1827,"_31165":1786,"_21586":56531,"_5":14831,"_28346":56437,"_3068":56532},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3612":1828,"_31165":1786,"_21586":56534,"_5":14831,"_28346":56441,"_3068":56535},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3612":1829,"_31165":1786,"_21586":56537,"_5":14831,"_28346":56445,"_3068":55980},[],{"_3612":1830,"_31165":1786,"_21586":56539,"_5":14831,"_28346":56445,"_3068":56540},[],"What it prepares or checks",{"_3612":1831,"_31165":1786,"_21586":56542,"_5":14831,"_28346":56445,"_3068":55983},[],{"_3612":1832,"_31165":1786,"_21586":56544,"_5":14831,"_28346":56445,"_3068":56545},[],"Key custody, CA hierarchy, profiles and validation.",{"_3612":1833,"_31165":1786,"_21586":56547,"_5":14831,"_28346":56445,"_3068":56548},[],"Fleet administrator",{"_3612":1834,"_31165":1786,"_21586":56550,"_5":14831,"_28346":56445,"_3068":56551},[],"DMS, device admission, renewal policy and inventory.",{"_3612":1835,"_31165":1786,"_21586":56553,"_5":14831,"_28346":56445,"_3068":55995},[],{"_3612":1836,"_31165":1786,"_21586":56555,"_5":14831,"_28346":56445,"_3068":56556},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3612":1837,"_31165":1786,"_21586":56558,"_5":14831,"_28346":56445,"_3068":56001},[],{"_3612":1838,"_31165":1786,"_21586":56560,"_5":14831,"_28346":56445,"_3068":56561},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3612":1839,"_31165":1786,"_21586":56563,"_5":14831,"_28346":56445,"_3068":56564},[],"Infrastructure operator",{"_3612":1840,"_31165":1786,"_21586":56566,"_5":14831,"_28346":56445,"_3068":56567},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3612":1841,"_31165":1786,"_21586":56569,"_5":14831,"_28346":56445,"_3068":56570},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3612":1842,"_31165":1842,"_5":15196,"_3068":56572,"_31523":56573,"_21586":56576,"_28346":1842},"CA hierarchy and rotation",[50890,52402,56574,56575],"PKI","Keys, authorities and certificates",[],{"_3612":1843,"_31165":1842,"_21586":56578,"_5":14831,"_28346":1842,"_3068":56579},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3612":1844,"_31165":1842,"_5":31520,"_21586":56581,"_28346":56582,"_3068":56583},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3612":1845,"_31165":1842,"_5":31520,"_21586":56585,"_28346":56586,"_3068":56587},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3612":1846,"_31165":1842,"_5":31520,"_21586":56589,"_28346":56590,"_3068":56591},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3612":1847,"_31165":1842,"_5":31520,"_21586":56593,"_28346":56594,"_3068":56595},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3612":1848,"_31165":1842,"_5":31520,"_21586":56597,"_28346":56598,"_3068":56599},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3612":1849,"_31165":1842,"_5":31520,"_21586":56601,"_28346":56602,"_3068":56603},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3612":1850,"_31165":1842,"_5":31520,"_21586":56605,"_28346":56606,"_3068":56607},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3612":1851,"_31165":1842,"_5":31520,"_21586":56609,"_28346":56610,"_3068":56611},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3612":1852,"_31165":1842,"_5":31520,"_21586":56613,"_28346":56614,"_3068":56615},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3612":1853,"_31165":1842,"_5":31520,"_21586":56617,"_28346":56618,"_3068":56619},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3612":1854,"_31165":1842,"_5":31520,"_21586":56621,"_28346":56622,"_3068":56623},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3612":1855,"_31165":1842,"_5":31520,"_21586":56625,"_28346":56626,"_3068":56627},[],"/docs/pr-preview/pr-77/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3612":1856,"_31165":1842,"_21586":56629,"_5":14831,"_28346":1842,"_3068":56630},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3612":1857,"_31165":1842,"_21586":56632,"_5":14831,"_28346":1842,"_3068":56633},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3612":1858,"_31165":1842,"_21586":56635,"_5":14831,"_28346":56582,"_3068":56636},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3612":1859,"_31165":1842,"_21586":56638,"_5":14831,"_28346":56582,"_3068":56639},[],"environment, such as production and preproduction;",{"_3612":1860,"_31165":1842,"_21586":56641,"_5":14831,"_28346":56582,"_3068":56642},[],"owner or operating team;",{"_3612":1861,"_31165":1842,"_21586":56644,"_5":14831,"_28346":56582,"_3068":56645},[],"device family or manufacturing process;",{"_3612":1862,"_31165":1842,"_21586":56647,"_5":14831,"_28346":56582,"_3068":56648},[],"region or regulatory requirement;",{"_3612":1863,"_31165":1842,"_21586":56650,"_5":14831,"_28346":56582,"_3068":56651},[],"cryptographic engine or key policy;",{"_3612":1864,"_31165":1842,"_21586":56653,"_5":14831,"_28346":56582,"_3068":56654},[],"maintenance window and renewal cadence.",{"_3612":1865,"_31165":1842,"_21586":56656,"_5":14831,"_28346":56582,"_3068":56657},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3612":1866,"_31165":1842,"_21586":56659,"_5":14831,"_28346":56582,"_3068":56660},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3612":1867,"_31165":1842,"_21586":56662,"_5":14831,"_28346":56586,"_3068":56663},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3612":1868,"_31165":1842,"_21586":56665,"_5":14831,"_28346":56586,"_3068":56666},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3612":1869,"_31165":1842,"_21586":56668,"_5":14831,"_28346":56586,"_3068":56669},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3612":1870,"_31165":1842,"_21586":56671,"_5":14831,"_28346":56586,"_3068":56672},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3612":1871,"_31165":1842,"_21586":56674,"_5":14831,"_28346":56590,"_3068":56675},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3612":1872,"_31165":1842,"_21586":56677,"_5":14831,"_28346":56590,"_3068":56678},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3612":1873,"_31165":1842,"_21586":56680,"_5":14831,"_28346":56590,"_3068":56681},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3612":1874,"_31165":1842,"_21586":56683,"_5":14831,"_28346":56590,"_3068":56684},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3612":1875,"_31165":1842,"_21586":56686,"_5":14831,"_28346":56598,"_3068":56687},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3612":1876,"_31165":1842,"_21586":56689,"_5":14831,"_28346":56602,"_3068":56690},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3612":1877,"_31165":1842,"_21586":56692,"_5":14831,"_28346":56606,"_3068":56693},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3612":1878,"_31165":1842,"_21586":56695,"_5":14831,"_28346":56610,"_3068":56696},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3612":1879,"_31165":1842,"_21586":56698,"_5":14831,"_28346":56614,"_3068":56699},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3612":1880,"_31165":1842,"_21586":56701,"_5":14831,"_28346":56618,"_3068":56702},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3612":1881,"_31165":1842,"_21586":56704,"_5":14831,"_28346":56622,"_3068":56705},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3612":1882,"_31165":1842,"_21586":56707,"_5":14831,"_28346":56622,"_3068":56708},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3612":1883,"_31165":1842,"_21586":56710,"_5":14831,"_28346":56622,"_3068":56711},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3612":1884,"_31165":1842,"_21586":56713,"_5":14831,"_28346":56622,"_3068":56714},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3612":1885,"_31165":1842,"_21586":56716,"_5":14831,"_28346":56626,"_3068":56717},[],"The new chain ends in an anchor installed by the consumer.",{"_3612":1886,"_31165":1842,"_21586":56719,"_5":14831,"_28346":56626,"_3068":56720},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3612":1887,"_31165":1842,"_21586":56722,"_5":14831,"_28346":56626,"_3068":56723},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3612":1888,"_31165":1842,"_21586":56725,"_5":14831,"_28346":56626,"_3068":56726},[],"Re-enrollment accepts the old identity during the planned period.",{"_3612":1889,"_31165":1842,"_21586":56728,"_5":14831,"_28346":56626,"_3068":56729},[],"OCSP and CRL respond for the authorities that remain active.",{"_3612":1890,"_31165":1842,"_21586":56731,"_5":14831,"_28346":56626,"_3068":56732},[],"No DMS is left accidentally issuing from the old CA.",{"_3612":1891,"_31165":1842,"_21586":56734,"_5":14831,"_28346":56626,"_3068":56735},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3612":1892,"_31165":1892,"_5":15196,"_3068":56737,"_31523":56738,"_21586":56739,"_28346":1892},"Certification authorities",[50890,52402,56574,56575],[],{"_3612":1893,"_31165":1892,"_21586":56741,"_5":14831,"_28346":1892,"_3068":56742},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3612":1894,"_31165":1892,"_5":31520,"_21586":56744,"_28346":56745,"_3068":56746},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3612":1895,"_31165":1892,"_5":31520,"_21586":56748,"_28346":56749,"_3068":56750},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3612":1896,"_31165":1892,"_5":31520,"_21586":56752,"_28346":56753,"_3068":50900},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#before-you-begin",{"_3612":1897,"_31165":1892,"_5":31520,"_21586":56755,"_28346":56756,"_3068":56757},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3612":1898,"_31165":1892,"_5":31520,"_21586":56759,"_28346":56760,"_3068":56761},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3612":1899,"_31165":1892,"_5":31520,"_21586":56763,"_28346":56764,"_3068":56765},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3612":1900,"_31165":1892,"_5":31520,"_21586":56767,"_28346":56768,"_3068":56769},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3612":1901,"_31165":1892,"_5":31520,"_21586":56771,"_28346":56772,"_3068":56773},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3612":1902,"_31165":1892,"_5":31520,"_21586":56775,"_28346":56776,"_3068":56777},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3612":1903,"_31165":1892,"_5":31520,"_21586":56779,"_28346":56780,"_3068":56781},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3612":1904,"_31165":1892,"_5":31520,"_21586":56783,"_28346":56784,"_3068":56785},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3612":1905,"_31165":1892,"_5":31520,"_21586":56787,"_28346":56788,"_3068":56789},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3612":1906,"_31165":1892,"_5":31520,"_21586":56791,"_28346":56792,"_3068":56793},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3612":1907,"_31165":1892,"_5":31520,"_21586":56795,"_28346":56796,"_3068":56797},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3612":1908,"_31165":1892,"_5":31520,"_21586":56799,"_28346":56800,"_3068":56801},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3612":1909,"_31165":1892,"_5":31520,"_21586":56803,"_28346":56804,"_3068":56805},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3612":1910,"_31165":1892,"_5":31520,"_21586":56807,"_28346":56808,"_3068":56809},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3612":1911,"_31165":1892,"_5":31520,"_21586":56811,"_28346":56812,"_3068":56813},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3612":1912,"_31165":1892,"_5":31520,"_21586":56815,"_28346":56816,"_3068":56817},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3612":1913,"_31165":1892,"_5":31520,"_21586":56819,"_28346":56820,"_3068":56821},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3612":1914,"_31165":1892,"_5":31520,"_21586":56823,"_28346":56824,"_3068":56825},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3612":1915,"_31165":1892,"_5":31520,"_21586":56827,"_28346":56828,"_3068":56829},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3612":1916,"_31165":1892,"_5":31520,"_21586":56831,"_28346":56832,"_3068":56833},[],"/docs/pr-preview/pr-77/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3612":1917,"_31165":1892,"_21586":56835,"_5":14831,"_28346":1892,"_3068":56836},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3612":1918,"_31165":1892,"_21586":56838,"_5":14831,"_28346":1892,"_3068":56839},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3612":1919,"_31165":1892,"_21586":56841,"_5":14831,"_28346":1892,"_3068":56842},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3612":1920,"_31165":1892,"_21586":56844,"_5":14831,"_28346":56745,"_3068":56845},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3612":1921,"_31165":1892,"_21586":56847,"_5":14831,"_28346":56745,"_3068":56848},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3612":1922,"_31165":1892,"_21586":56850,"_5":14831,"_28346":56745,"_3068":56851},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3612":1923,"_31165":1892,"_21586":56853,"_5":14831,"_28346":56745,"_3068":56854},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3612":1924,"_31165":1892,"_21586":56856,"_5":14831,"_28346":56745,"_3068":56857},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3612":1925,"_31165":1892,"_21586":56859,"_5":14831,"_28346":56753,"_3068":56860},[],"Decide whether the CA will be a root or an intermediate.",{"_3612":1926,"_31165":1892,"_21586":56862,"_5":14831,"_28346":56753,"_3068":56863},[],"Choose the engine that will keep the key.",{"_3612":1927,"_31165":1892,"_21586":56865,"_5":14831,"_28346":56753,"_3068":56866},[],"Define a validity longer than that of the certificates it will issue.",{"_3612":1928,"_31165":1892,"_21586":56868,"_5":14831,"_28346":56753,"_3068":56869},[],"For an intermediate CA, make sure the parent CA is active.",{"_3612":1929,"_31165":1892,"_21586":56871,"_5":14831,"_28346":56756,"_3068":56872},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3612":1930,"_31165":1892,"_21586":56874,"_5":14831,"_28346":56760,"_3068":56875},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3612":1931,"_31165":1892,"_21586":56877,"_5":14831,"_28346":56760,"_3068":56878},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3612":1932,"_31165":1892,"_21586":56880,"_5":14831,"_28346":56764,"_3068":56881},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3612":1933,"_31165":1892,"_21586":56883,"_5":14831,"_28346":56768,"_3068":56884},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3612":1934,"_31165":1892,"_21586":56886,"_5":14831,"_28346":56768,"_3068":56887},[],"`C`: two-letter ISO 3166-1 country code.",{"_3612":1935,"_31165":1892,"_21586":56889,"_5":14831,"_28346":56768,"_3068":56890},[],"`ST`: state or province.",{"_3612":1936,"_31165":1892,"_21586":56892,"_5":14831,"_28346":56768,"_3068":56893},[],"`L`: locality.",{"_3612":1937,"_31165":1892,"_21586":56895,"_5":14831,"_28346":56768,"_3068":56896},[],"`O`: organization.",{"_3612":1938,"_31165":1892,"_21586":56898,"_5":14831,"_28346":56768,"_3068":56899},[],"`OU`: organizational unit.",{"_3612":1939,"_31165":1892,"_21586":56901,"_5":14831,"_28346":56768,"_3068":56902},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3612":1940,"_31165":1892,"_21586":56904,"_5":14831,"_28346":56772,"_3068":56905},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3612":1941,"_31165":1892,"_21586":56907,"_5":14831,"_28346":56772,"_3068":56908},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3612":1942,"_31165":1892,"_21586":56910,"_5":14831,"_28346":56776,"_3068":56911},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3612":1943,"_31165":1892,"_21586":56913,"_5":14831,"_28346":56776,"_3068":56914},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3612":1944,"_31165":1892,"_21586":56916,"_5":14831,"_28346":56780,"_3068":56917},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3612":1945,"_31165":1892,"_21586":56919,"_5":14831,"_28346":56780,"_3068":56920},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3612":1946,"_31165":1892,"_21586":56922,"_5":14831,"_28346":56784,"_3068":56923},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3612":1947,"_31165":1892,"_21586":56925,"_5":14831,"_28346":56784,"_3068":56926},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3612":1948,"_31165":1892,"_21586":56928,"_5":14831,"_28346":56784,"_3068":56929},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3612":1949,"_31165":1892,"_21586":56931,"_5":14831,"_28346":56788,"_3068":56932},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3612":1950,"_31165":1892,"_21586":56934,"_5":14831,"_28346":56792,"_3068":56935},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3612":1951,"_31165":1892,"_21586":56937,"_5":14831,"_28346":56792,"_3068":56938},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3612":1952,"_31165":1892,"_21586":56940,"_5":14831,"_28346":56796,"_3068":56941},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3612":1953,"_31165":1892,"_21586":56943,"_5":14831,"_28346":56800,"_3068":56944},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3612":1954,"_31165":1892,"_21586":56946,"_5":14831,"_28346":56800,"_3068":56947},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3612":1955,"_31165":1892,"_21586":56949,"_5":14831,"_28346":56800,"_3068":56950},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3612":1956,"_31165":1892,"_21586":56952,"_5":14831,"_28346":56804,"_3068":56953},[],"Open a CA from the inventory to review:",{"_3612":1957,"_31165":1892,"_21586":56955,"_5":14831,"_28346":56804,"_3068":56956},[],"Status and validity period.",{"_3612":1958,"_31165":1892,"_21586":56958,"_5":14831,"_28346":56804,"_3068":56959},[],"Certificate and chain in PEM format.",{"_3612":1959,"_31165":1892,"_21586":56961,"_5":14831,"_28346":56804,"_3068":56962},[],"Number of active, expired and revoked certificates.",{"_3612":1960,"_31165":1892,"_21586":56964,"_5":14831,"_28346":56804,"_3068":56965},[],"Certificates issued in **Issued Certificates**.",{"_3612":1961,"_31165":1892,"_21586":56967,"_5":14831,"_28346":56804,"_3068":56968},[],"The CRL linked to the authority.",{"_3612":1962,"_31165":1892,"_21586":56970,"_5":14831,"_28346":56804,"_3068":56971},[],"Metadata and the associated cryptographic engine.",{"_3612":1963,"_31165":1892,"_21586":56973,"_5":14831,"_28346":56804,"_3068":56974},[],"You can filter the inventory by name, status and CA type.",{"_3612":1964,"_31165":1892,"_21586":56976,"_5":14831,"_28346":56808,"_3068":56977},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3612":1965,"_31165":1892,"_21586":56979,"_5":14831,"_28346":56808,"_3068":56980},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3612":1966,"_31165":1892,"_21586":56982,"_5":14831,"_28346":56808,"_3068":56983},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3612":1967,"_31165":1892,"_21586":56985,"_5":14831,"_28346":56808,"_3068":56986},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3612":1968,"_31165":1892,"_21586":56988,"_5":14831,"_28346":56808,"_3068":56989},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3612":1969,"_31165":1892,"_21586":56991,"_5":14831,"_28346":56808,"_3068":56992},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3612":1970,"_31165":1892,"_21586":56994,"_5":14831,"_28346":56812,"_3068":56995},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3612":1971,"_31165":1892,"_21586":56997,"_5":14831,"_28346":56816,"_3068":56998},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3612":1972,"_31165":1892,"_21586":57000,"_5":14831,"_28346":56820,"_3068":57001},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3612":1973,"_31165":1892,"_21586":57003,"_5":14831,"_28346":56824,"_3068":57004},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3612":1974,"_31165":1892,"_21586":57006,"_5":14831,"_28346":56828,"_3068":57007},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3612":1975,"_31165":1892,"_21586":57009,"_5":14831,"_28346":56832,"_3068":57010},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3612":1976,"_31165":1892,"_21586":57012,"_5":14831,"_28346":56832,"_3068":57013},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3612":1977,"_31165":1892,"_21586":57015,"_5":14831,"_28346":56832,"_3068":57016},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3612":1978,"_31165":1892,"_21586":57018,"_5":14831,"_28346":56832,"_3068":57019},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3612":1979,"_31165":1979,"_5":15196,"_3068":57021,"_31523":57022,"_21586":57023,"_28346":1979},"Certificate profiles",[50890,52402,56574,56575],[],{"_3612":1980,"_31165":1979,"_21586":57025,"_5":14831,"_28346":1979,"_3068":57026},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3612":1981,"_31165":1979,"_5":31520,"_21586":57028,"_28346":57029,"_3068":57030},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3612":1982,"_31165":1979,"_5":31520,"_21586":57032,"_28346":57033,"_3068":57034},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#validity","Validity",{"_3612":1983,"_31165":1979,"_5":31520,"_21586":57036,"_28346":57037,"_3068":57038},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3612":1984,"_31165":1979,"_5":31520,"_21586":57040,"_28346":57041,"_3068":57042},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3612":1985,"_31165":1979,"_5":31520,"_21586":57044,"_28346":57045,"_3068":57046},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#subject","Subject",{"_3612":1986,"_31165":1979,"_5":31520,"_21586":57048,"_28346":57049,"_3068":57050},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3612":1987,"_31165":1979,"_5":31520,"_21586":57052,"_28346":57053,"_3068":57054},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3612":1988,"_31165":1979,"_5":31520,"_21586":57056,"_28346":57057,"_3068":57058},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3612":1989,"_31165":1979,"_5":31520,"_21586":57060,"_28346":57061,"_3068":57062},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3612":1990,"_31165":1979,"_5":31520,"_21586":57064,"_28346":57065,"_3068":57066},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3612":1991,"_31165":1979,"_5":31520,"_21586":57068,"_28346":57069,"_3068":57070},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3612":1992,"_31165":1979,"_5":31520,"_21586":57072,"_28346":57073,"_3068":57074},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3612":1993,"_31165":1979,"_5":31520,"_21586":57076,"_28346":57077,"_3068":57078},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3612":1994,"_31165":1979,"_5":31520,"_21586":57080,"_28346":57081,"_3068":57082},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3612":1995,"_31165":1979,"_5":31520,"_21586":57084,"_28346":57085,"_3068":57086},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#design-examples","Design examples",{"_3612":1996,"_31165":1979,"_5":31520,"_21586":57088,"_28346":57089,"_3068":57090},[],"/docs/pr-preview/pr-77/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3612":1997,"_31165":1979,"_21586":57092,"_5":14831,"_28346":1979,"_3068":57093},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3612":1998,"_31165":1979,"_21586":57095,"_5":14831,"_28346":1979,"_3068":57096},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3612":1999,"_31165":1979,"_21586":57098,"_5":14831,"_28346":57033,"_3068":57099},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3612":2000,"_31165":1979,"_21586":57101,"_5":14831,"_28346":57033,"_3068":57102},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3612":2001,"_31165":1979,"_21586":57104,"_5":14831,"_28346":57037,"_3068":57105},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3612":2002,"_31165":1979,"_21586":57107,"_5":14831,"_28346":57041,"_3068":57108},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3612":2003,"_31165":1979,"_21586":57110,"_5":14831,"_28346":57041,"_3068":57111},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3612":2004,"_31165":1979,"_21586":57113,"_5":14831,"_28346":57041,"_3068":57114},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3612":2005,"_31165":1979,"_21586":57116,"_5":14831,"_28346":57045,"_3068":57117},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3612":2006,"_31165":1979,"_21586":57119,"_5":14831,"_28346":57049,"_3068":57120},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3612":2007,"_31165":1979,"_21586":57122,"_5":14831,"_28346":57049,"_3068":57123},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3612":2008,"_31165":1979,"_21586":57125,"_5":14831,"_28346":57053,"_3068":57126},[],"The cryptographic enforcement can:",{"_3612":2009,"_31165":1979,"_21586":57128,"_5":14831,"_28346":57053,"_3068":57129},[],"allow or block RSA keys;",{"_3612":2010,"_31165":1979,"_21586":57131,"_5":14831,"_28346":57053,"_3068":57132},[],"limit the supported RSA sizes;",{"_3612":2011,"_31165":1979,"_21586":57134,"_5":14831,"_28346":57053,"_3068":57135},[],"allow or block ECDSA keys;",{"_3612":2012,"_31165":1979,"_21586":57137,"_5":14831,"_28346":57053,"_3068":57138},[],"limit the supported ECDSA sizes or curves.",{"_3612":2013,"_31165":1979,"_21586":57140,"_5":14831,"_28346":57053,"_3068":57141},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3612":2014,"_31165":1979,"_21586":57143,"_5":14831,"_28346":57057,"_3068":57144},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3612":2015,"_31165":1979,"_21586":57146,"_5":14831,"_28346":57057,"_3068":54336},[],{"_3612":2016,"_31165":1979,"_21586":57148,"_5":14831,"_28346":57057,"_3068":57149},[],"First choice",{"_3612":2017,"_31165":1979,"_21586":57151,"_5":14831,"_28346":57057,"_3068":57152},[],"Second choice",{"_3612":2018,"_31165":1979,"_21586":57154,"_5":14831,"_28346":57057,"_3068":57155},[],"If neither is supplied",{"_3612":2019,"_31165":1979,"_21586":57157,"_5":14831,"_28346":57057,"_3068":57158},[],"Direct signing with a CA",{"_3612":2020,"_31165":1979,"_21586":57160,"_5":14831,"_28346":57057,"_3068":57161},[],"`issuance_profile` embedded in the request",{"_3612":2021,"_31165":1979,"_21586":57163,"_5":14831,"_28346":57057,"_3068":57164},[],"Request `issuance_profile_id`",{"_3612":2022,"_31165":1979,"_21586":57166,"_5":14831,"_28346":57057,"_3068":57167},[],"CA default profile (`profile_id`).",{"_3612":2023,"_31165":1979,"_21586":57169,"_5":14831,"_28346":57057,"_3068":57170},[],"Issuance through a DMS",{"_3612":2024,"_31165":1979,"_21586":57172,"_5":14831,"_28346":57057,"_3068":57173},[],"`settings.issuance_profile_id`",{"_3612":2025,"_31165":1979,"_21586":57175,"_5":14831,"_28346":57057,"_3068":57176},[],"`settings.issuance_profile` embedded in the DMS",{"_3612":2026,"_31165":1979,"_21586":57178,"_5":14831,"_28346":57057,"_3068":57179},[],"Enrollment CA default profile.",{"_3612":2027,"_31165":1979,"_21586":57181,"_5":14831,"_28346":57057,"_3068":57182},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3612":2028,"_31165":1979,"_21586":57184,"_5":14831,"_28346":57057,"_3068":57185},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3612":2029,"_31165":1979,"_21586":57187,"_5":14831,"_28346":57065,"_3068":57188},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3612":2030,"_31165":1979,"_21586":57190,"_5":14831,"_28346":57069,"_3068":57191},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3612":2031,"_31165":1979,"_21586":57193,"_5":14831,"_28346":57073,"_3068":57194},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3612":2032,"_31165":1979,"_21586":57196,"_5":14831,"_28346":57077,"_3068":57197},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3612":2033,"_31165":1979,"_21586":57199,"_5":14831,"_28346":57081,"_3068":57200},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3612":2034,"_31165":1979,"_21586":57202,"_5":14831,"_28346":57081,"_3068":57203},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3612":2035,"_31165":1979,"_21586":57205,"_5":14831,"_28346":57085,"_3068":57206},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3612":2036,"_31165":1979,"_21586":57208,"_5":14831,"_28346":57085,"_3068":57209},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3612":2037,"_31165":1979,"_21586":57211,"_5":14831,"_28346":57085,"_3068":57212},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3612":2038,"_31165":1979,"_21586":57214,"_5":14831,"_28346":57085,"_3068":57215},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3612":2039,"_31165":1979,"_21586":57217,"_5":14831,"_28346":57089,"_3068":57218},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3612":2040,"_31165":1979,"_21586":57220,"_5":14831,"_28346":57089,"_3068":57221},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3612":2041,"_31165":2041,"_5":15196,"_3068":57223,"_31523":57224,"_21586":57226,"_28346":2041},"Certificate validation",[50890,52402,56574,57225],"Validation",[],{"_3612":2042,"_31165":2041,"_21586":57228,"_5":14831,"_28346":2041,"_3068":57229},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3612":2043,"_31165":2041,"_5":31520,"_21586":57231,"_28346":57232,"_3068":57233},[],"/docs/pr-preview/pr-77/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3612":2044,"_31165":2041,"_5":31520,"_21586":57235,"_28346":57236,"_3068":57237},[],"/docs/pr-preview/pr-77/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3612":2045,"_31165":2041,"_5":31520,"_21586":57239,"_28346":57240,"_3068":57241},[],"/docs/pr-preview/pr-77/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3612":2046,"_31165":2041,"_21586":57243,"_5":14831,"_28346":2041,"_3068":57244},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3612":2047,"_31165":2041,"_21586":57246,"_5":14831,"_28346":57232,"_3068":57247},[],"Verify these criteria together:",{"_3612":2048,"_31165":2041,"_21586":57249,"_5":14831,"_28346":57232,"_3068":56200},[],{"_3612":2049,"_31165":2041,"_21586":57251,"_5":14831,"_28346":57232,"_3068":57252},[],"Required result",{"_3612":2050,"_31165":2041,"_21586":57254,"_5":14831,"_28346":57232,"_3068":57255},[],"Chain and signature",{"_3612":2051,"_31165":2041,"_21586":57257,"_5":14831,"_28346":57232,"_3068":57258},[],"Valid chain to a root deliberately installed in the consumer.",{"_3612":2052,"_31165":2041,"_21586":57260,"_5":14831,"_28346":57232,"_3068":57261},[],"Dates",{"_3612":2053,"_31165":2041,"_21586":57263,"_5":14831,"_28346":57232,"_3068":57264},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3612":2054,"_31165":2041,"_21586":57266,"_5":14831,"_28346":57232,"_3068":52071},[],{"_3612":2055,"_31165":2041,"_21586":57268,"_5":14831,"_28346":57232,"_3068":57269},[],"Name, SAN or identifier matches the expected peer.",{"_3612":2056,"_31165":2041,"_21586":57271,"_5":14831,"_28346":57232,"_3068":51280},[],{"_3612":2057,"_31165":2041,"_21586":57273,"_5":14831,"_28346":57232,"_3068":57274},[],"KU, EKU and constraints permit the specific operation.",{"_3612":2058,"_31165":2041,"_21586":57276,"_5":14831,"_28346":57232,"_3068":57277},[],"Revocation",{"_3612":2059,"_31165":2041,"_21586":57279,"_5":14831,"_28346":57232,"_3068":57280},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3612":2060,"_31165":2041,"_21586":57282,"_5":14831,"_28346":57232,"_3068":57283},[],"Authorization",{"_3612":2061,"_31165":2041,"_21586":57285,"_5":14831,"_28346":57232,"_3068":57286},[],"The application permits that identity to perform the action.",{"_3612":2062,"_31165":2041,"_21586":57288,"_5":14831,"_28346":57232,"_3068":57289},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3612":2063,"_31165":2041,"_21586":57291,"_5":14831,"_28346":57236,"_3068":57292},[],"Mechanism",{"_3612":2064,"_31165":2041,"_21586":57294,"_5":14831,"_28346":57236,"_3068":57295},[],"When to use it",{"_3612":2065,"_31165":2041,"_21586":57297,"_5":14831,"_28346":57236,"_3068":57298},[],"What you must maintain",{"_3612":2066,"_31165":2041,"_21586":57300,"_5":14831,"_28346":57236,"_3068":57301},[],"OCSP",{"_3612":2067,"_31165":2041,"_21586":57303,"_5":14831,"_28346":57236,"_3068":57304},[],"Status query for a specific certificate.",{"_3612":2068,"_31165":2041,"_21586":57306,"_5":14831,"_28346":57236,"_3068":57307},[],"Responder access, signature verification and cache/freshness policy.",{"_3612":2069,"_31165":2041,"_21586":57309,"_5":14831,"_28346":57236,"_3068":57310},[],"CRL",{"_3612":2070,"_31165":2041,"_21586":57312,"_5":14831,"_28346":57236,"_3068":57313},[],"Local checks for many certificates or offline operation.",{"_3612":2071,"_31165":2041,"_21586":57315,"_5":14831,"_28346":57236,"_3068":57316},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3612":2072,"_31165":2041,"_21586":57318,"_5":14831,"_28346":57236,"_3068":57319},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3612":2073,"_31165":2041,"_21586":57321,"_5":14831,"_28346":57236,"_3068":57322},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3612":2074,"_31165":2041,"_21586":57324,"_5":14831,"_28346":57240,"_3068":57325},[],"Accept a current, authorized certificate with a known chain.",{"_3612":2075,"_31165":2041,"_21586":57327,"_5":14831,"_28346":57240,"_3068":57328},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3612":2076,"_31165":2041,"_21586":57330,"_5":14831,"_28346":57240,"_3068":57331},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3612":2077,"_31165":2041,"_21586":57333,"_5":14831,"_28346":57240,"_3068":57334},[],"Check that a new connection with that identity is rejected.",{"_3612":2078,"_31165":2041,"_21586":57336,"_5":14831,"_28346":57240,"_3068":57337},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3612":2079,"_31165":2041,"_21586":57339,"_5":14831,"_28346":57240,"_3068":57340},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3612":2080,"_31165":2041,"_21586":57342,"_5":14831,"_28346":57240,"_3068":57343},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3612":2081,"_31165":2041,"_21586":57345,"_5":14831,"_28346":57240,"_3068":57346},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3612":2082,"_31165":2041,"_21586":57348,"_5":14831,"_28346":57240,"_3068":57349},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3612":2083,"_31165":2083,"_5":15196,"_3068":57351,"_31523":57352,"_21586":57353,"_28346":2083},"Certificates",[50890,52402,56574,56575],[],{"_3612":2084,"_31165":2083,"_21586":57355,"_5":14831,"_28346":2083,"_3068":57356},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3612":2085,"_31165":2083,"_5":31520,"_21586":57358,"_28346":57359,"_3068":57360},[],"/docs/pr-preview/pr-77/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3612":2086,"_31165":2083,"_5":31520,"_21586":57362,"_28346":57363,"_3068":57364},[],"/docs/pr-preview/pr-77/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3612":2087,"_31165":2083,"_5":31520,"_21586":57366,"_28346":57367,"_3068":57368},[],"/docs/pr-preview/pr-77/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3612":2088,"_31165":2083,"_5":31520,"_21586":57370,"_28346":57371,"_3068":57372},[],"/docs/pr-preview/pr-77/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3612":2089,"_31165":2083,"_5":31520,"_21586":57374,"_28346":57375,"_3068":57376},[],"/docs/pr-preview/pr-77/platform/pki/certificates#open-the-action","Open the action",{"_3612":2090,"_31165":2083,"_5":31520,"_21586":57378,"_28346":57379,"_3068":57380},[],"/docs/pr-preview/pr-77/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3612":2091,"_31165":2083,"_5":31520,"_21586":57382,"_28346":57383,"_3068":57384},[],"/docs/pr-preview/pr-77/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3612":2092,"_31165":2083,"_5":31520,"_21586":57386,"_28346":57387,"_3068":57388},[],"/docs/pr-preview/pr-77/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3612":2093,"_31165":2083,"_5":31520,"_21586":57390,"_28346":57391,"_3068":57392},[],"/docs/pr-preview/pr-77/platform/pki/certificates#continue","Continue",{"_3612":2094,"_31165":2083,"_21586":57394,"_5":14831,"_28346":2083,"_3068":57395},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3612":2095,"_31165":2083,"_21586":57397,"_5":14831,"_28346":57359,"_3068":57398},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3612":2096,"_31165":2083,"_21586":57400,"_5":14831,"_28346":57359,"_3068":57401},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3612":2097,"_31165":2083,"_21586":57403,"_5":14831,"_28346":57359,"_3068":57404},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3612":2098,"_31165":2083,"_21586":57406,"_5":14831,"_28346":57359,"_3068":57407},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3612":2099,"_31165":2083,"_21586":57409,"_5":14831,"_28346":57359,"_3068":57410},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3612":2100,"_31165":2083,"_21586":57412,"_5":14831,"_28346":57359,"_3068":57413},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3612":2101,"_31165":2083,"_21586":57415,"_5":14831,"_28346":57359,"_3068":57416},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3612":2102,"_31165":2083,"_21586":57418,"_5":14831,"_28346":57363,"_3068":57419},[],"Download the PEM and inspect it:",{"_3612":2103,"_31165":2083,"_21586":57421,"_5":14831,"_28346":57363,"_3068":57422},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3612":2104,"_31165":2083,"_21586":57424,"_5":14831,"_28346":57367,"_3068":57425},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3612":2105,"_31165":2083,"_21586":57427,"_5":14831,"_28346":57367,"_3068":57428},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3612":2106,"_31165":2083,"_21586":57430,"_5":14831,"_28346":57367,"_3068":57431},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3612":2107,"_31165":2083,"_21586":57433,"_5":14831,"_28346":57367,"_3068":57434},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3612":2108,"_31165":2083,"_21586":57436,"_5":14831,"_28346":57367,"_3068":57437},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3612":2109,"_31165":2083,"_21586":57439,"_5":14831,"_28346":57367,"_3068":57440},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3612":2110,"_31165":2083,"_21586":57442,"_5":14831,"_28346":57367,"_3068":57443},[],"For browser key generation, follow Issue your first certificate.",{"_3612":2111,"_31165":2083,"_21586":57445,"_5":14831,"_28346":57371,"_3068":57446},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3612":2112,"_31165":2083,"_21586":57448,"_5":14831,"_28346":57375,"_3068":57449},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3612":2113,"_31165":2083,"_21586":57451,"_5":14831,"_28346":57379,"_3068":57452},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3612":2114,"_31165":2083,"_21586":57454,"_5":14831,"_28346":57383,"_3068":57455},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3612":2115,"_31165":2083,"_21586":57457,"_5":14831,"_28346":57383,"_3068":57458},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3612":2116,"_31165":2083,"_21586":57460,"_5":14831,"_28346":57383,"_3068":57461},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3612":2117,"_31165":2083,"_21586":57463,"_5":14831,"_28346":57387,"_3068":57464},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3612":2118,"_31165":2083,"_21586":57466,"_5":14831,"_28346":57387,"_3068":57467},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3612":2119,"_31165":2083,"_21586":57469,"_5":14831,"_28346":57387,"_3068":57470},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3612":2120,"_31165":2083,"_21586":57472,"_5":14831,"_28346":57391,"_3068":57473},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3612":2121,"_31165":2083,"_21586":57475,"_5":14831,"_28346":57391,"_3068":57476},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3612":2122,"_31165":2122,"_5":15196,"_3068":57478,"_31523":57479,"_21586":57481,"_28346":2122},"Certificate lifecycle",[50890,52402,56574,57480],"Concepts",[],{"_3612":2123,"_31165":2122,"_21586":57483,"_5":14831,"_28346":2122,"_3068":57484},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3612":2124,"_31165":2122,"_5":31520,"_21586":57486,"_28346":57487,"_3068":57488},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3612":2125,"_31165":2122,"_5":31520,"_21586":57490,"_28346":57491,"_3068":57492},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3612":2126,"_31165":2122,"_5":31520,"_21586":57494,"_28346":57495,"_3068":57496},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3612":2127,"_31165":2122,"_5":31520,"_21586":57498,"_28346":57499,"_3068":57500},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3612":2128,"_31165":2122,"_5":31520,"_21586":57502,"_28346":57503,"_3068":57504},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3612":2129,"_31165":2122,"_5":31520,"_21586":57506,"_28346":57507,"_3068":57508},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3612":2130,"_31165":2122,"_5":31520,"_21586":57510,"_28346":57511,"_3068":57512},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3612":2131,"_31165":2122,"_5":31520,"_21586":57514,"_28346":57515,"_3068":57516},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3612":2132,"_31165":2122,"_5":31520,"_21586":57518,"_28346":57519,"_3068":57520},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3612":2133,"_31165":2122,"_5":31520,"_21586":57522,"_28346":57523,"_3068":57524},[],"/docs/pr-preview/pr-77/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3612":2134,"_31165":2122,"_21586":57526,"_5":14831,"_28346":2122,"_3068":57527},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3612":2135,"_31165":2122,"_21586":57529,"_5":14831,"_28346":57491,"_3068":57530},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3612":2136,"_31165":2122,"_21586":57532,"_5":14831,"_28346":57495,"_3068":57533},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3612":2137,"_31165":2122,"_21586":57535,"_5":14831,"_28346":57499,"_3068":57536},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3612":2138,"_31165":2122,"_21586":57538,"_5":14831,"_28346":57503,"_3068":57539},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3612":2139,"_31165":2122,"_21586":57541,"_5":14831,"_28346":57507,"_3068":57542},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3612":2140,"_31165":2122,"_21586":57544,"_5":14831,"_28346":57511,"_3068":57545},[],"Lamassu persists four X.509 states:",{"_3612":2141,"_31165":2122,"_21586":57547,"_5":14831,"_28346":57511,"_3068":57548},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3612":2142,"_31165":2122,"_21586":57550,"_5":14831,"_28346":57511,"_3068":57551},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3612":2143,"_31165":2122,"_21586":57553,"_5":14831,"_28346":57511,"_3068":57554},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3612":2144,"_31165":2122,"_21586":57556,"_5":14831,"_28346":57511,"_3068":57557},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3612":2145,"_31165":2122,"_21586":57559,"_5":14831,"_28346":57511,"_3068":57560},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3612":2146,"_31165":2122,"_21586":57562,"_5":14831,"_28346":57515,"_3068":57563},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3612":2147,"_31165":2122,"_21586":57565,"_5":14831,"_28346":57515,"_3068":57566},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3612":2148,"_31165":2122,"_21586":57568,"_5":14831,"_28346":57515,"_3068":57569},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3612":2149,"_31165":2122,"_21586":57571,"_5":14831,"_28346":57519,"_3068":57572},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3612":2150,"_31165":2122,"_21586":57574,"_5":14831,"_28346":57519,"_3068":57575},[],"Before confirming:",{"_3612":2151,"_31165":2122,"_21586":57577,"_5":14831,"_28346":57519,"_3068":57578},[],"Identify DMSs, devices and services that trust that chain.",{"_3612":2152,"_31165":2122,"_21586":57580,"_5":14831,"_28346":57519,"_3068":57581},[],"Distribute the new chain of trust.",{"_3612":2153,"_31165":2122,"_21586":57583,"_5":14831,"_28346":57519,"_3068":57584},[],"Reissue the necessary identities.",{"_3612":2154,"_31165":2122,"_21586":57586,"_5":14831,"_28346":57519,"_3068":57587},[],"Check OCSP and CRL from a real consumer.",{"_3612":2155,"_31165":2122,"_21586":57589,"_5":14831,"_28346":57519,"_3068":57590},[],"Revoke the old CA once no legitimate traffic remains.",{"_3612":2156,"_31165":2122,"_21586":57592,"_5":14831,"_28346":57519,"_3068":57593},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3612":2157,"_31165":2122,"_21586":57595,"_5":14831,"_28346":57523,"_3068":57596},[],"Certificates entering the preventive or critical renewal window.",{"_3612":2158,"_31165":2122,"_21586":57598,"_5":14831,"_28346":57523,"_3068":57599},[],"Repeated enrollment or re-enrollment failures.",{"_3612":2159,"_31165":2122,"_21586":57601,"_5":14831,"_28346":57523,"_3068":57602},[],"Status changes and revocation reasons.",{"_3612":2160,"_31165":2122,"_21586":57604,"_5":14831,"_28346":57523,"_3068":57605},[],"OCSP and CRL publication and validity.",{"_3612":2161,"_31165":2122,"_21586":57607,"_5":14831,"_28346":57523,"_3068":57608},[],"Dependencies still presenting a replaced certificate.",{"_3612":2162,"_31165":2122,"_21586":57610,"_5":14831,"_28346":57523,"_3068":57611},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3612":2163,"_31165":2163,"_5":15196,"_3068":57613,"_31523":57614,"_21586":57615,"_28346":2163},"Trust model",[50890,52402,56574,57480],[],{"_3612":2164,"_31165":2163,"_21586":57617,"_5":14831,"_28346":2163,"_3068":57618},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3612":2165,"_31165":2163,"_5":31520,"_21586":57620,"_28346":57621,"_3068":57622},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3612":2166,"_31165":2163,"_5":31520,"_21586":57624,"_28346":57625,"_3068":57626},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3612":2167,"_31165":2163,"_5":31520,"_21586":57628,"_28346":57629,"_3068":57630},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3612":2168,"_31165":2163,"_5":31520,"_21586":57632,"_28346":57633,"_3068":57634},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3612":2169,"_31165":2163,"_5":31520,"_21586":57636,"_28346":57637,"_3068":57638},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3612":2170,"_31165":2163,"_5":31520,"_21586":57640,"_28346":57641,"_3068":57642},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3612":2171,"_31165":2163,"_5":31520,"_21586":57644,"_28346":57645,"_3068":57646},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3612":2172,"_31165":2163,"_5":31520,"_21586":57648,"_28346":57649,"_3068":57650},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3612":2173,"_31165":2163,"_5":31520,"_21586":57652,"_28346":57653,"_3068":57654},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3612":2174,"_31165":2163,"_5":31520,"_21586":57656,"_28346":57657,"_3068":57658},[],"/docs/pr-preview/pr-77/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3612":2175,"_31165":2163,"_21586":57660,"_5":14831,"_28346":2163,"_3068":57661},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3612":2176,"_31165":2163,"_21586":57663,"_5":14831,"_28346":57625,"_3068":57664},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3612":2177,"_31165":2163,"_21586":57666,"_5":14831,"_28346":57629,"_3068":57667},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3612":2178,"_31165":2163,"_21586":57669,"_5":14831,"_28346":57633,"_3068":57670},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3612":2179,"_31165":2163,"_21586":57672,"_5":14831,"_28346":57637,"_3068":57673},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3612":2180,"_31165":2163,"_21586":57675,"_5":14831,"_28346":57641,"_3068":57676},[],"The device proves it can enroll according to the DMS policy.",{"_3612":2181,"_31165":2163,"_21586":57678,"_5":14831,"_28346":57641,"_3068":57679},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3612":2182,"_31165":2163,"_21586":57681,"_5":14831,"_28346":57641,"_3068":57682},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3612":2183,"_31165":2163,"_21586":57684,"_5":14831,"_28346":57641,"_3068":57685},[],"The device installs the certificate and the chain it needs.",{"_3612":2184,"_31165":2163,"_21586":57687,"_5":14831,"_28346":57641,"_3068":57688},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3612":2185,"_31165":2163,"_21586":57690,"_5":14831,"_28346":57641,"_3068":57691},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3612":2186,"_31165":2163,"_21586":57693,"_5":14831,"_28346":57645,"_3068":57694},[],"A DMS relates three sets that are worth designing separately:",{"_3612":2187,"_31165":2163,"_21586":57696,"_5":14831,"_28346":57645,"_3068":57697},[],"**Enrollment CA:** signs the new identities.",{"_3612":2188,"_31165":2163,"_21586":57699,"_5":14831,"_28346":57645,"_3068":57700},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3612":2189,"_31165":2163,"_21586":57702,"_5":14831,"_28346":57645,"_3068":57703},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3612":2190,"_31165":2163,"_21586":57705,"_5":14831,"_28346":57645,"_3068":57706},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3612":2191,"_31165":2163,"_21586":57708,"_5":14831,"_28346":57649,"_3068":57709},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3612":2192,"_31165":2163,"_21586":57711,"_5":14831,"_28346":57649,"_3068":57712},[],"that the current date is between `Not Before` and `Not After`;",{"_3612":2193,"_31165":2163,"_21586":57714,"_5":14831,"_28346":57649,"_3068":57715},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3612":2194,"_31165":2163,"_21586":57717,"_5":14831,"_28346":57649,"_3068":57718},[],"that names, SANs and subject match the expected identity;",{"_3612":2195,"_31165":2163,"_21586":57720,"_5":14831,"_28346":57649,"_3068":57721},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3612":2196,"_31165":2163,"_21586":57723,"_5":14831,"_28346":57649,"_3068":57724},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3612":2197,"_31165":2163,"_21586":57726,"_5":14831,"_28346":57649,"_3068":57727},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3612":2198,"_31165":2163,"_21586":57729,"_5":14831,"_28346":57653,"_3068":57730},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3612":2199,"_31165":2163,"_21586":57732,"_5":14831,"_28346":57657,"_3068":57733},[],"Keep the root out of daily operations, or with very restricted access.",{"_3612":2200,"_31165":2163,"_21586":57735,"_5":14831,"_28346":57657,"_3068":57736},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3612":2201,"_31165":2163,"_21586":57738,"_5":14831,"_28346":57657,"_3068":57739},[],"Assign explicit profiles to every use case.",{"_3612":2202,"_31165":2163,"_21586":57741,"_5":14831,"_28346":57657,"_3068":57742},[],"Distribute the new trust before starting a rotation.",{"_3612":2203,"_31165":2163,"_21586":57744,"_5":14831,"_28346":57657,"_3068":57745},[],"Keep enough overlap to renew a disconnected fleet.",{"_3612":2204,"_31165":2163,"_21586":57747,"_5":14831,"_28346":57657,"_3068":57748},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3612":2205,"_31165":2163,"_21586":57750,"_5":14831,"_28346":57657,"_3068":57751},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3612":2206,"_31165":2206,"_5":15196,"_3068":57753,"_31523":57754,"_21586":57755,"_28346":2206},"Revocation lists (CRL)",[50890,52402,56574,57225],[],{"_3612":2207,"_31165":2206,"_21586":57757,"_5":14831,"_28346":2206,"_3068":57758},[],"Generate and distribute signed lists to validate certificates offline.",{"_3612":2208,"_31165":2206,"_5":31520,"_21586":57760,"_28346":57761,"_3068":57762},[],"/docs/pr-preview/pr-77/platform/pki/crl#crl-settings","CRL settings",{"_3612":2209,"_31165":2206,"_5":31520,"_21586":57764,"_28346":57765,"_3068":57766},[],"/docs/pr-preview/pr-77/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3612":2210,"_31165":2206,"_5":31520,"_21586":57768,"_28346":57769,"_3068":57770},[],"/docs/pr-preview/pr-77/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3612":2211,"_31165":2206,"_5":31520,"_21586":57772,"_28346":57773,"_3068":57774},[],"/docs/pr-preview/pr-77/platform/pki/crl#crl-contents","CRL contents",{"_3612":2212,"_31165":2206,"_5":31520,"_21586":57776,"_28346":57777,"_3068":57778},[],"/docs/pr-preview/pr-77/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3612":2213,"_31165":2206,"_5":31520,"_21586":57780,"_28346":57781,"_3068":57782},[],"/docs/pr-preview/pr-77/platform/pki/crl#crl-settings-api","CRL settings API",{"_3612":2214,"_31165":2206,"_5":31520,"_21586":57784,"_28346":57785,"_3068":57786},[],"/docs/pr-preview/pr-77/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3612":2215,"_31165":2206,"_5":31520,"_21586":57788,"_28346":57789,"_3068":57790},[],"/docs/pr-preview/pr-77/platform/pki/crl#references","References",{"_3612":2216,"_31165":2206,"_21586":57792,"_5":14831,"_28346":2206,"_3068":57793},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3612":2217,"_31165":2206,"_21586":57795,"_5":14831,"_28346":57761,"_3068":57796},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3612":2218,"_31165":2206,"_21586":57798,"_5":14831,"_28346":57761,"_3068":57799},[],"Field",{"_3612":2219,"_31165":2206,"_21586":57801,"_5":14831,"_28346":57761,"_3068":51280},[],{"_3612":2220,"_31165":2206,"_21586":57803,"_5":14831,"_28346":57761,"_3068":52522},[],{"_3612":2221,"_31165":2206,"_21586":57805,"_5":14831,"_28346":57761,"_3068":57806},[],"ID of the CA the settings belong to.",{"_3612":2222,"_31165":2206,"_21586":57808,"_5":14831,"_28346":57761,"_3068":57809},[],"`status`",{"_3612":2223,"_31165":2206,"_21586":57811,"_5":14831,"_28346":57761,"_3068":57812},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3612":2224,"_31165":2206,"_21586":57814,"_5":14831,"_28346":57761,"_3068":57815},[],"`legacy_ski`",{"_3612":2225,"_31165":2206,"_21586":57817,"_5":14831,"_28346":57761,"_3068":57818},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3612":2226,"_31165":2206,"_21586":57820,"_5":14831,"_28346":57761,"_3068":57821},[],"`latest_crl`",{"_3612":2227,"_31165":2206,"_21586":57823,"_5":14831,"_28346":57761,"_3068":57824},[],"Version, validity start and end of the last published list. Read-only.",{"_3612":2228,"_31165":2206,"_21586":57826,"_5":14831,"_28346":57761,"_3068":57827},[],"`crl_options` field",{"_3612":2229,"_31165":2206,"_21586":57829,"_5":14831,"_28346":57761,"_3068":51280},[],{"_3612":2230,"_31165":2206,"_21586":57831,"_5":14831,"_28346":57761,"_3068":57832},[],"Initial value",{"_3612":2231,"_31165":2206,"_21586":57834,"_5":14831,"_28346":57761,"_3068":57835},[],"`validity`",{"_3612":2232,"_31165":2206,"_21586":57837,"_5":14831,"_28346":57761,"_3068":57838},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3612":2233,"_31165":2206,"_21586":57840,"_5":14831,"_28346":57761,"_3068":57841},[],"7 days.",{"_3612":2234,"_31165":2206,"_21586":57843,"_5":14831,"_28346":57761,"_3068":57844},[],"`refresh_interval`",{"_3612":2235,"_31165":2206,"_21586":57846,"_5":14831,"_28346":57761,"_3068":57847},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3612":2236,"_31165":2206,"_21586":57849,"_5":14831,"_28346":57761,"_3068":57850},[],"6 days and 23 hours.",{"_3612":2237,"_31165":2206,"_21586":57852,"_5":14831,"_28346":57761,"_3068":57853},[],"`regenerate_on_revoke`",{"_3612":2238,"_31165":2206,"_21586":57855,"_5":14831,"_28346":57761,"_3068":57856},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3612":2239,"_31165":2206,"_21586":57858,"_5":14831,"_28346":57761,"_3068":57859},[],"`true`.",{"_3612":2240,"_31165":2206,"_21586":57861,"_5":14831,"_28346":57761,"_3068":57862},[],"`signer_serial_number`",{"_3612":2241,"_31165":2206,"_21586":57864,"_5":14831,"_28346":57761,"_3068":57865},[],"Serial number of the existing certificate that signs the CRL.",{"_3612":2242,"_31165":2206,"_21586":57867,"_5":14831,"_28346":57761,"_3068":57868},[],"Serial number of the CA’s current certificate.",{"_3612":2243,"_31165":2206,"_21586":57870,"_5":14831,"_28346":57761,"_3068":57871},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3612":2244,"_31165":2206,"_21586":57873,"_5":14831,"_28346":57761,"_3068":57874},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3612":2245,"_31165":2206,"_21586":57876,"_5":14831,"_28346":57761,"_3068":57877},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3612":2246,"_31165":2206,"_21586":57879,"_5":14831,"_28346":57761,"_3068":57880},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3612":2247,"_31165":2206,"_21586":57882,"_5":14831,"_28346":57761,"_3068":57883},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3612":2248,"_31165":2206,"_21586":57885,"_5":14831,"_28346":57761,"_3068":57886},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3612":2249,"_31165":2206,"_21586":57888,"_5":14831,"_28346":57761,"_3068":57889},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3612":2250,"_31165":2206,"_21586":57891,"_5":14831,"_28346":57761,"_3068":57892},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3612":2251,"_31165":2206,"_21586":57894,"_5":14831,"_28346":57761,"_3068":57895},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3612":2252,"_31165":2206,"_21586":57897,"_5":14831,"_28346":57761,"_3068":57898},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3612":2253,"_31165":2206,"_21586":57900,"_5":14831,"_28346":57761,"_3068":57901},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3612":2254,"_31165":2206,"_21586":57903,"_5":14831,"_28346":57765,"_3068":57904},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3612":2255,"_31165":2206,"_21586":57906,"_5":14831,"_28346":57765,"_3068":57907},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3612":2256,"_31165":2206,"_21586":57909,"_5":14831,"_28346":57765,"_3068":57910},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3612":2257,"_31165":2206,"_21586":57912,"_5":14831,"_28346":57765,"_3068":57913},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3612":2258,"_31165":2206,"_21586":57915,"_5":14831,"_28346":57769,"_3068":57916},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3612":2259,"_31165":2206,"_21586":57918,"_5":14831,"_28346":57769,"_3068":57919},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3612":2260,"_31165":2206,"_21586":57921,"_5":14831,"_28346":57769,"_3068":57922},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3612":2261,"_31165":2206,"_21586":57924,"_5":14831,"_28346":57769,"_3068":57925},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3612":2262,"_31165":2206,"_21586":57927,"_5":14831,"_28346":57769,"_3068":57928},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3612":2263,"_31165":2206,"_21586":57930,"_5":14831,"_28346":57769,"_3068":57931},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3612":2264,"_31165":2206,"_21586":57933,"_5":14831,"_28346":57769,"_3068":57934},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3612":2265,"_31165":2206,"_21586":57936,"_5":14831,"_28346":57769,"_3068":57937},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3612":2266,"_31165":2206,"_21586":57939,"_5":14831,"_28346":57769,"_3068":57940},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3612":2267,"_31165":2206,"_21586":57942,"_5":14831,"_28346":57773,"_3068":57943},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3612":2268,"_31165":2206,"_21586":57945,"_5":14831,"_28346":57773,"_3068":57946},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3612":2269,"_31165":2206,"_21586":57948,"_5":14831,"_28346":57777,"_3068":57949},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3612":2270,"_31165":2206,"_21586":57951,"_5":14831,"_28346":57777,"_3068":57952},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3612":2271,"_31165":2206,"_21586":57954,"_5":14831,"_28346":57777,"_3068":57955},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3612":2272,"_31165":2206,"_21586":57957,"_5":14831,"_28346":57777,"_3068":57958},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3612":2273,"_31165":2206,"_21586":57960,"_5":14831,"_28346":57777,"_3068":57961},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3612":2274,"_31165":2206,"_21586":57963,"_5":14831,"_28346":57781,"_3068":57964},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3612":2275,"_31165":2206,"_21586":57966,"_5":14831,"_28346":57781,"_3068":54339},[],{"_3612":2276,"_31165":2206,"_21586":57968,"_5":14831,"_28346":57781,"_3068":57969},[],"Relative path",{"_3612":2277,"_31165":2206,"_21586":57971,"_5":14831,"_28346":57781,"_3068":54336},[],{"_3612":2278,"_31165":2206,"_21586":57973,"_5":14831,"_28346":57781,"_3068":57974},[],"`GET`",{"_3612":2279,"_31165":2206,"_21586":57976,"_5":14831,"_28346":57781,"_3068":57977},[],"`/v1/crl-settings`",{"_3612":2280,"_31165":2206,"_21586":57979,"_5":14831,"_28346":57781,"_3068":57980},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3612":2281,"_31165":2206,"_21586":57982,"_5":14831,"_28346":57781,"_3068":57974},[],{"_3612":2282,"_31165":2206,"_21586":57984,"_5":14831,"_28346":57781,"_3068":57985},[],"`/v1/crl-settings/{ca-id}`",{"_3612":2283,"_31165":2206,"_21586":57987,"_5":14831,"_28346":57781,"_3068":57988},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3612":2284,"_31165":2206,"_21586":57990,"_5":14831,"_28346":57781,"_3068":57991},[],"`PUT`",{"_3612":2285,"_31165":2206,"_21586":57993,"_5":14831,"_28346":57781,"_3068":57985},[],{"_3612":2286,"_31165":2206,"_21586":57995,"_5":14831,"_28346":57781,"_3068":57996},[],"Replace the CRL configuration of a CA.",{"_3612":2287,"_31165":2206,"_21586":57998,"_5":14831,"_28346":57781,"_3068":57999},[],"`DELETE`",{"_3612":2288,"_31165":2206,"_21586":58001,"_5":14831,"_28346":57781,"_3068":57985},[],{"_3612":2289,"_31165":2206,"_21586":58003,"_5":14831,"_28346":57781,"_3068":58004},[],"Remove the archived CRL settings of a CA.",{"_3612":2290,"_31165":2206,"_21586":58006,"_5":14831,"_28346":57781,"_3068":58007},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3612":2291,"_31165":2206,"_21586":58009,"_5":14831,"_28346":57781,"_3068":58010},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3612":2292,"_31165":2206,"_21586":58012,"_5":14831,"_28346":57781,"_3068":58013},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3612":2293,"_31165":2206,"_21586":58015,"_5":14831,"_28346":57785,"_3068":58016},[],"Symptom",{"_3612":2294,"_31165":2206,"_21586":58018,"_5":14831,"_28346":57785,"_3068":58019},[],"Cause",{"_3612":2295,"_31165":2206,"_21586":58021,"_5":14831,"_28346":57785,"_3068":58022},[],"Action",{"_3612":2296,"_31165":2206,"_21586":58024,"_5":14831,"_28346":57785,"_3068":58025},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3612":2297,"_31165":2206,"_21586":58027,"_5":14831,"_28346":57785,"_3068":58028},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3612":2298,"_31165":2206,"_21586":58030,"_5":14831,"_28346":57785,"_3068":58031},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3612":2299,"_31165":2206,"_21586":58033,"_5":14831,"_28346":57785,"_3068":58034},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3612":2300,"_31165":2206,"_21586":58036,"_5":14831,"_28346":57785,"_3068":58037},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3612":2301,"_31165":2206,"_21586":58039,"_5":14831,"_28346":57785,"_3068":58040},[],"Delete the CA first; deleting it archives its settings.",{"_3612":2302,"_31165":2206,"_21586":58042,"_5":14831,"_28346":57785,"_3068":58043},[],"`PUT` returns 400.",{"_3612":2303,"_31165":2206,"_21586":58045,"_5":14831,"_28346":57785,"_3068":58046},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3612":2304,"_31165":2206,"_21586":58048,"_5":14831,"_28346":57785,"_3068":58049},[],"Set the serial number of a valid certificate of that CA.",{"_3612":2305,"_31165":2206,"_21586":58051,"_5":14831,"_28346":57785,"_3068":58052},[],"`PUT` returns 404.",{"_3612":2306,"_31165":2206,"_21586":58054,"_5":14831,"_28346":57785,"_3068":58055},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3612":2307,"_31165":2206,"_21586":58057,"_5":14831,"_28346":57785,"_3068":58058},[],"Check the CA ID and the signer serial number.",{"_3612":2308,"_31165":2206,"_21586":58060,"_5":14831,"_28346":57785,"_3068":58061},[],"`PUT` returns 400 from a 3.x client.",{"_3612":2309,"_31165":2206,"_21586":58063,"_5":14831,"_28346":57785,"_3068":58064},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3612":2310,"_31165":2206,"_21586":58066,"_5":14831,"_28346":57785,"_3068":58067},[],"Update the client to send the new field.",{"_3612":2311,"_31165":2206,"_21586":58069,"_5":14831,"_28346":57785,"_3068":58070},[],"The CRL does not change after revoking a certificate.",{"_3612":2312,"_31165":2206,"_21586":58072,"_5":14831,"_28346":57785,"_3068":58073},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3612":2313,"_31165":2206,"_21586":58075,"_5":14831,"_28346":57785,"_3068":58076},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3612":2314,"_31165":2206,"_21586":58078,"_5":14831,"_28346":57785,"_3068":58079},[],"A verifier rejects the CRL because of the issuer.",{"_3612":2315,"_31165":2206,"_21586":58081,"_5":14831,"_28346":57785,"_3068":58082},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3612":2316,"_31165":2206,"_21586":58084,"_5":14831,"_28346":57785,"_3068":58085},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3612":2317,"_31165":2206,"_21586":58087,"_5":14831,"_28346":57789,"_3068":58088},[],"RFC 5280: X.509 and CRL profile.",{"_3612":2318,"_31165":2206,"_21586":58090,"_5":14831,"_28346":57789,"_3068":58091},[],"OpenSSL: openssl-crl.",{"_3612":2319,"_31165":2206,"_21586":58093,"_5":14831,"_28346":57789,"_3068":58094},[],"OpenSSL: openssl-verify.",{"_3612":2320,"_31165":2206,"_21586":58096,"_5":14831,"_28346":57789,"_3068":58097},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3612":2321,"_31165":2206,"_21586":58099,"_5":14831,"_28346":57789,"_3068":58100},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3612":2322,"_31165":2322,"_5":15196,"_3068":58102,"_31523":58103,"_21586":58104,"_28346":2322},"Keys and cryptographic engines",[50890,52402,56574,56575],[],{"_3612":2323,"_31165":2322,"_21586":58106,"_5":14831,"_28346":2322,"_3068":58107},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3612":2324,"_31165":2322,"_5":31520,"_21586":58109,"_28346":58110,"_3068":58111},[],"/docs/pr-preview/pr-77/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3612":2325,"_31165":2322,"_5":31520,"_21586":58113,"_28346":58114,"_3068":58115},[],"/docs/pr-preview/pr-77/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3612":2326,"_31165":2322,"_5":31520,"_21586":58117,"_28346":58118,"_3068":58119},[],"/docs/pr-preview/pr-77/platform/pki/key-management#file-system","File System",{"_3612":2327,"_31165":2322,"_5":31520,"_21586":58121,"_28346":58122,"_3068":58123},[],"/docs/pr-preview/pr-77/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3612":2328,"_31165":2322,"_5":31520,"_21586":58125,"_28346":58126,"_3068":58127},[],"/docs/pr-preview/pr-77/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3612":2329,"_31165":2322,"_5":31520,"_21586":58129,"_28346":58130,"_3068":58131},[],"/docs/pr-preview/pr-77/platform/pki/key-management#aws-kms","AWS KMS",{"_3612":2330,"_31165":2322,"_5":31520,"_21586":58133,"_28346":58134,"_3068":58135},[],"/docs/pr-preview/pr-77/platform/pki/key-management#pkcs11","PKCS#11",{"_3612":2331,"_31165":2322,"_5":31520,"_21586":58137,"_28346":58138,"_3068":58139},[],"/docs/pr-preview/pr-77/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3612":2332,"_31165":2322,"_5":31520,"_21586":58141,"_28346":58142,"_3068":58143},[],"/docs/pr-preview/pr-77/platform/pki/key-management#key-inventory","Key inventory",{"_3612":2333,"_31165":2322,"_5":31520,"_21586":58145,"_28346":58146,"_3068":58147},[],"/docs/pr-preview/pr-77/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3612":2334,"_31165":2322,"_5":31520,"_21586":58149,"_28346":58150,"_3068":58151},[],"/docs/pr-preview/pr-77/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3612":2335,"_31165":2322,"_5":31520,"_21586":58153,"_28346":58154,"_3068":58155},[],"/docs/pr-preview/pr-77/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3612":2336,"_31165":2322,"_5":31520,"_21586":58157,"_28346":58158,"_3068":58159},[],"/docs/pr-preview/pr-77/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3612":2337,"_31165":2322,"_5":31520,"_21586":58161,"_28346":58162,"_3068":58163},[],"/docs/pr-preview/pr-77/platform/pki/key-management#view-details","View details",{"_3612":2338,"_31165":2322,"_5":31520,"_21586":58165,"_28346":58166,"_3068":58167},[],"/docs/pr-preview/pr-77/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3612":2339,"_31165":2322,"_5":31520,"_21586":58169,"_28346":58170,"_3068":58171},[],"/docs/pr-preview/pr-77/platform/pki/key-management#sign","Sign",{"_3612":2340,"_31165":2322,"_5":31520,"_21586":58173,"_28346":58174,"_3068":58175},[],"/docs/pr-preview/pr-77/platform/pki/key-management#verify","Verify",{"_3612":2341,"_31165":2322,"_5":31520,"_21586":58177,"_28346":58178,"_3068":58179},[],"/docs/pr-preview/pr-77/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3612":2342,"_31165":2322,"_5":31520,"_21586":58181,"_28346":58182,"_3068":58183},[],"/docs/pr-preview/pr-77/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3612":2343,"_31165":2322,"_5":31520,"_21586":58185,"_28346":58186,"_3068":58187},[],"/docs/pr-preview/pr-77/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3612":2344,"_31165":2322,"_21586":58189,"_5":14831,"_28346":2322,"_3068":58190},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3612":2345,"_31165":2322,"_21586":58192,"_5":14831,"_28346":2322,"_3068":58193},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3612":2346,"_31165":2322,"_21586":58195,"_5":14831,"_28346":58110,"_3068":58196},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3612":2347,"_31165":2322,"_21586":58198,"_5":14831,"_28346":58110,"_3068":58199},[],"In practice, it lets you:",{"_3612":2348,"_31165":2322,"_21586":58201,"_5":14831,"_28346":58110,"_3068":58202},[],"Generate new key pairs from Lamassu IoT.",{"_3612":2349,"_31165":2322,"_21586":58204,"_5":14831,"_28346":58110,"_3068":58205},[],"Import keys created externally.",{"_3612":2350,"_31165":2322,"_21586":58207,"_5":14831,"_28346":58110,"_3068":58208},[],"Delegate custody and cryptographic operations to external engines.",{"_3612":2351,"_31165":2322,"_21586":58210,"_5":14831,"_28346":58110,"_3068":58211},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3612":2352,"_31165":2322,"_21586":58213,"_5":14831,"_28346":58114,"_3068":58214},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3612":2353,"_31165":2322,"_21586":58216,"_5":14831,"_28346":58114,"_3068":58217},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3612":2354,"_31165":2322,"_21586":58219,"_5":14831,"_28346":58114,"_3068":58220},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3612":2355,"_31165":2322,"_21586":58222,"_5":14831,"_28346":58118,"_3068":58223},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3612":2356,"_31165":2322,"_21586":58225,"_5":14831,"_28346":58122,"_3068":58226},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3612":2357,"_31165":2322,"_21586":58228,"_5":14831,"_28346":58122,"_3068":58229},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3612":2358,"_31165":2322,"_21586":58231,"_5":14831,"_28346":58126,"_3068":58232},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3612":2359,"_31165":2322,"_21586":58234,"_5":14831,"_28346":58130,"_3068":58235},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3612":2360,"_31165":2322,"_21586":58237,"_5":14831,"_28346":58134,"_3068":58238},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3612":2361,"_31165":2322,"_21586":58240,"_5":14831,"_28346":58138,"_3068":58241},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3612":2362,"_31165":2322,"_21586":58243,"_5":14831,"_28346":58138,"_3068":58244},[],"Lamassu shows the enabled engines in the console.",{"_3612":2363,"_31165":2322,"_21586":58246,"_5":14831,"_28346":58138,"_3068":58247},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3612":2364,"_31165":2322,"_21586":58249,"_5":14831,"_28346":58138,"_3068":58250},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3612":2365,"_31165":2322,"_21586":58252,"_5":14831,"_28346":58142,"_3068":58253},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3612":2366,"_31165":2322,"_21586":58255,"_5":14831,"_28346":58142,"_3068":58256},[],"The table includes the following fields:",{"_3612":2367,"_31165":2322,"_21586":58258,"_5":14831,"_28346":58142,"_3068":58259},[],"**Name**: descriptive name of the key.",{"_3612":2368,"_31165":2322,"_21586":58261,"_5":14831,"_28346":58142,"_3068":58262},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3612":2369,"_31165":2322,"_21586":58264,"_5":14831,"_28346":58142,"_3068":58265},[],"**Strength**: visual indicator of cryptographic strength.",{"_3612":2370,"_31165":2322,"_21586":58267,"_5":14831,"_28346":58142,"_3068":58268},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3612":2371,"_31165":2322,"_21586":58270,"_5":14831,"_28346":58142,"_3068":58271},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3612":2372,"_31165":2322,"_21586":58273,"_5":14831,"_28346":58142,"_3068":58274},[],"**Aliases**: alternative names associated with the key.",{"_3612":2373,"_31165":2322,"_21586":58276,"_5":14831,"_28346":58142,"_3068":58277},[],"**Tags**: labels for classification and search.",{"_3612":2374,"_31165":2322,"_21586":58279,"_5":14831,"_28346":58142,"_3068":58280},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3612":2375,"_31165":2322,"_21586":58282,"_5":14831,"_28346":58142,"_3068":58283},[],"From this view you also reach the most common actions:",{"_3612":2376,"_31165":2322,"_21586":58285,"_5":14831,"_28346":58142,"_3068":58286},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3612":2377,"_31165":2322,"_21586":58288,"_5":14831,"_28346":58142,"_3068":58289},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3612":2378,"_31165":2322,"_21586":58291,"_5":14831,"_28346":58142,"_3068":58292},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3612":2379,"_31165":2322,"_21586":58294,"_5":14831,"_28346":58142,"_3068":58295},[],"**Delete Key** to remove the key from the system.",{"_3612":2380,"_31165":2322,"_21586":58297,"_5":14831,"_28346":58146,"_3068":58298},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3612":2381,"_31165":2322,"_21586":58300,"_5":14831,"_28346":58150,"_3068":58301},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3612":2382,"_31165":2322,"_21586":58303,"_5":14831,"_28346":58150,"_3068":58304},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3612":2383,"_31165":2322,"_21586":58306,"_5":14831,"_28346":58150,"_3068":58307},[],"**Key Name**: unique and descriptive name.",{"_3612":2384,"_31165":2322,"_21586":58309,"_5":14831,"_28346":58150,"_3068":58310},[],"**Crypto Engine**: engine that will keep the key.",{"_3612":2385,"_31165":2322,"_21586":58312,"_5":14831,"_28346":58150,"_3068":58313},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3612":2386,"_31165":2322,"_21586":58315,"_5":14831,"_28346":58150,"_3068":58316},[],"**Tags**: metadata to classify the key.",{"_3612":2387,"_31165":2322,"_21586":58318,"_5":14831,"_28346":58150,"_3068":58319},[],"**Metadata**: additional information for advanced uses.",{"_3612":2388,"_31165":2322,"_21586":58321,"_5":14831,"_28346":58154,"_3068":58322},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3612":2389,"_31165":2322,"_21586":58324,"_5":14831,"_28346":58154,"_3068":58325},[],"When you have an exportable private key and the destination engine supports import.",{"_3612":2390,"_31165":2322,"_21586":58327,"_5":14831,"_28346":58154,"_3068":58328},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3612":2391,"_31165":2322,"_21586":58330,"_5":14831,"_28346":58154,"_3068":58331},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3612":2392,"_31165":2322,"_21586":58333,"_5":14831,"_28346":58154,"_3068":58334},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3612":2393,"_31165":2322,"_21586":58336,"_5":14831,"_28346":58154,"_3068":58337},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3612":2394,"_31165":2322,"_21586":58339,"_5":14831,"_28346":58154,"_3068":58340},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3612":2395,"_31165":2322,"_21586":58342,"_5":14831,"_28346":58154,"_3068":58343},[],"**Tags**: labels for organization and search.",{"_3612":2396,"_31165":2322,"_21586":58345,"_5":14831,"_28346":58154,"_3068":58346},[],"**Metadata**: additional optional information.",{"_3612":2397,"_31165":2322,"_21586":58348,"_5":14831,"_28346":58154,"_3068":58349},[],"**Private Key (PEM)**: private key in PEM format.",{"_3612":2398,"_31165":2322,"_21586":58351,"_5":14831,"_28346":58154,"_3068":58352},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3612":2399,"_31165":2322,"_21586":58354,"_5":14831,"_28346":58158,"_3068":58355},[],"Each registered key has a detail view and several operational actions.",{"_3612":2400,"_31165":2322,"_21586":58357,"_5":14831,"_28346":58162,"_3068":58358},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3612":2401,"_31165":2322,"_21586":58360,"_5":14831,"_28346":58162,"_3068":58361},[],"The **Overview** tab shows, among others, these fields:",{"_3612":2402,"_31165":2322,"_21586":58363,"_5":14831,"_28346":58162,"_3068":58364},[],"**Key Name**: descriptive name.",{"_3612":2403,"_31165":2322,"_21586":58366,"_5":14831,"_28346":58162,"_3068":58367},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3612":2404,"_31165":2322,"_21586":58369,"_5":14831,"_28346":58162,"_3068":58370},[],"**Tags**: associated labels.",{"_3612":2405,"_31165":2322,"_21586":58372,"_5":14831,"_28346":58162,"_3068":58373},[],"**Aliases**: alternative names.",{"_3612":2406,"_31165":2322,"_21586":58375,"_5":14831,"_28346":58162,"_3068":58376},[],"**Crypto Engine**: engine where the key resides.",{"_3612":2407,"_31165":2322,"_21586":58378,"_5":14831,"_28346":58162,"_3068":58379},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3612":2408,"_31165":2322,"_21586":58381,"_5":14831,"_28346":58162,"_3068":58382},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3612":2409,"_31165":2322,"_21586":58384,"_5":14831,"_28346":58162,"_3068":58385},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3612":2410,"_31165":2322,"_21586":58387,"_5":14831,"_28346":58166,"_3068":58388},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3612":2411,"_31165":2322,"_21586":58390,"_5":14831,"_28346":58166,"_3068":58391},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3612":2412,"_31165":2322,"_21586":58393,"_5":14831,"_28346":58166,"_3068":58394},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3612":2413,"_31165":2322,"_21586":58396,"_5":14831,"_28346":58170,"_3068":58397},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3612":2414,"_31165":2322,"_21586":58399,"_5":14831,"_28346":58170,"_3068":58400},[],"Main fields:",{"_3612":2415,"_31165":2322,"_21586":58402,"_5":14831,"_28346":58170,"_3068":58403},[],"**Algorithm**: signing algorithm available for the key type.",{"_3612":2416,"_31165":2322,"_21586":58405,"_5":14831,"_28346":58170,"_3068":58406},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3612":2417,"_31165":2322,"_21586":58408,"_5":14831,"_28346":58170,"_3068":58409},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3612":2418,"_31165":2322,"_21586":58411,"_5":14831,"_28346":58170,"_3068":58412},[],"**Message**: content to sign.",{"_3612":2419,"_31165":2322,"_21586":58414,"_5":14831,"_28346":58170,"_3068":58415},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3612":2420,"_31165":2322,"_21586":58417,"_5":14831,"_28346":58174,"_3068":58418},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3612":2421,"_31165":2322,"_21586":58420,"_5":14831,"_28346":58174,"_3068":58400},[],{"_3612":2422,"_31165":2322,"_21586":58422,"_5":14831,"_28346":58174,"_3068":58423},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3612":2423,"_31165":2322,"_21586":58425,"_5":14831,"_28346":58174,"_3068":58426},[],"**Message Type**: `Raw` or `Digest`.",{"_3612":2424,"_31165":2322,"_21586":58428,"_5":14831,"_28346":58174,"_3068":58429},[],"**Payload Encoding**: encoding of the message.",{"_3612":2425,"_31165":2322,"_21586":58431,"_5":14831,"_28346":58174,"_3068":58432},[],"**Message**: original message or hash.",{"_3612":2426,"_31165":2322,"_21586":58434,"_5":14831,"_28346":58174,"_3068":58435},[],"**Signature**: signature to check.",{"_3612":2427,"_31165":2322,"_21586":58437,"_5":14831,"_28346":58174,"_3068":58438},[],"**Result**: indicator of the validation result.",{"_3612":2428,"_31165":2322,"_21586":58440,"_5":14831,"_28346":58178,"_3068":58441},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3612":2429,"_31165":2322,"_21586":58443,"_5":14831,"_28346":58178,"_3068":58444},[],"This flow is useful for:",{"_3612":2430,"_31165":2322,"_21586":58446,"_5":14831,"_28346":58178,"_3068":58447},[],"Requesting certificates from an external CA.",{"_3612":2431,"_31165":2322,"_21586":58449,"_5":14831,"_28346":58178,"_3068":58450},[],"Renewing an identity while keeping the same key.",{"_3612":2432,"_31165":2322,"_21586":58452,"_5":14831,"_28346":58178,"_3068":58453},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3612":2433,"_31165":2322,"_21586":58455,"_5":14831,"_28346":58178,"_3068":58456},[],"**Common Name (CN)**: main name of the identity.",{"_3612":2434,"_31165":2322,"_21586":58458,"_5":14831,"_28346":58178,"_3068":58459},[],"**Organization (O)**: organization or company.",{"_3612":2435,"_31165":2322,"_21586":58461,"_5":14831,"_28346":58178,"_3068":58462},[],"**Organizational Unit (OU)**: department or unit.",{"_3612":2436,"_31165":2322,"_21586":58464,"_5":14831,"_28346":58178,"_3068":58465},[],"**Country (C)**: two-letter country code.",{"_3612":2437,"_31165":2322,"_21586":58467,"_5":14831,"_28346":58178,"_3068":58468},[],"**State / Province (ST)**: state or province.",{"_3612":2438,"_31165":2322,"_21586":58470,"_5":14831,"_28346":58178,"_3068":58471},[],"**Locality (L)**: city or locality.",{"_3612":2439,"_31165":2322,"_21586":58473,"_5":14831,"_28346":58178,"_3068":58474},[],"**Email Address**: contact email.",{"_3612":2440,"_31165":2322,"_21586":58476,"_5":14831,"_28346":58178,"_3068":58477},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3612":2441,"_31165":2322,"_21586":58479,"_5":14831,"_28346":58178,"_3068":58480},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3612":2442,"_31165":2322,"_21586":58482,"_5":14831,"_28346":58182,"_3068":58483},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3612":2443,"_31165":2322,"_21586":58485,"_5":14831,"_28346":58182,"_3068":58486},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3612":2444,"_31165":2322,"_21586":58488,"_5":14831,"_28346":58186,"_3068":58489},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3612":2445,"_31165":2322,"_21586":58491,"_5":14831,"_28346":58186,"_3068":58492},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3612":2446,"_31165":2446,"_5":15196,"_3068":58494,"_31523":58495,"_21586":58496,"_28346":2446},"Online validation with OCSP",[50890,52402,56574,57225],[],{"_3612":2447,"_31165":2446,"_21586":58498,"_5":14831,"_28346":2446,"_3068":58499},[],"Query signed status and verify the responder’s response.",{"_3612":2448,"_31165":2446,"_5":31520,"_21586":58501,"_28346":58502,"_3068":58503},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3612":2449,"_31165":2446,"_5":31520,"_21586":58505,"_28346":58506,"_3068":58507},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3612":2450,"_31165":2446,"_5":31520,"_21586":58509,"_28346":58510,"_3068":58511},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3612":2451,"_31165":2446,"_5":31520,"_21586":58513,"_28346":58514,"_3068":58515},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3612":2452,"_31165":2446,"_5":31520,"_21586":58517,"_28346":58518,"_3068":58519},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3612":2453,"_31165":2446,"_5":31520,"_21586":58521,"_28346":58522,"_3068":57790},[],"/docs/pr-preview/pr-77/platform/pki/ocsp#references",{"_3612":2454,"_31165":2446,"_21586":58524,"_5":14831,"_28346":2446,"_3068":58525},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3612":2455,"_31165":2446,"_21586":58527,"_5":14831,"_28346":58502,"_3068":58528},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3612":2456,"_31165":2446,"_21586":58530,"_5":14831,"_28346":58502,"_3068":58531},[],"Record status",{"_3612":2457,"_31165":2446,"_21586":58533,"_5":14831,"_28346":58502,"_3068":58534},[],"Signed response",{"_3612":2458,"_31165":2446,"_21586":58536,"_5":14831,"_28346":58502,"_3068":55711},[],{"_3612":2459,"_31165":2446,"_21586":58538,"_5":14831,"_28346":58502,"_3068":58539},[],"`Good`.",{"_3612":2460,"_31165":2446,"_21586":58541,"_5":14831,"_28346":58502,"_3068":55728},[],{"_3612":2461,"_31165":2446,"_21586":58543,"_5":14831,"_28346":58502,"_3068":58544},[],"`Revoked`, with revocation reason and timestamp.",{"_3612":2462,"_31165":2446,"_21586":58546,"_5":14831,"_28346":58502,"_3068":58547},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3612":2463,"_31165":2446,"_21586":58549,"_5":14831,"_28346":58502,"_3068":58550},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3612":2464,"_31165":2446,"_21586":58552,"_5":14831,"_28346":58502,"_3068":58553},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3612":2465,"_31165":2446,"_21586":58555,"_5":14831,"_28346":58502,"_3068":58556},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3612":2466,"_31165":2446,"_21586":58558,"_5":14831,"_28346":58502,"_3068":58559},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3612":2467,"_31165":2446,"_21586":58561,"_5":14831,"_28346":58506,"_3068":58562},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3612":2468,"_31165":2446,"_21586":58564,"_5":14831,"_28346":58506,"_3068":58565},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3612":2469,"_31165":2446,"_21586":58567,"_5":14831,"_28346":58510,"_3068":58568},[],"The service accepts:",{"_3612":2470,"_31165":2446,"_21586":58570,"_5":14831,"_28346":58510,"_3068":54339},[],{"_3612":2471,"_31165":2446,"_21586":58572,"_5":14831,"_28346":58510,"_3068":58573},[],"VA service path",{"_3612":2472,"_31165":2446,"_21586":58575,"_5":14831,"_28346":58510,"_3068":58576},[],"Format",{"_3612":2473,"_31165":2446,"_21586":58578,"_5":14831,"_28346":58510,"_3068":58579},[],"`POST`",{"_3612":2474,"_31165":2446,"_21586":58581,"_5":14831,"_28346":58510,"_3068":58582},[],"`/ocsp`",{"_3612":2475,"_31165":2446,"_21586":58584,"_5":14831,"_28346":58510,"_3068":58585},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3612":2476,"_31165":2446,"_21586":58587,"_5":14831,"_28346":58510,"_3068":57974},[],{"_3612":2477,"_31165":2446,"_21586":58589,"_5":14831,"_28346":58510,"_3068":58590},[],"`/ocsp/{ocsp_request}`",{"_3612":2478,"_31165":2446,"_21586":58592,"_5":14831,"_28346":58510,"_3068":58593},[],"DER request encoded using padded URL Base64.",{"_3612":2479,"_31165":2446,"_21586":58595,"_5":14831,"_28346":58510,"_3068":58596},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3612":2480,"_31165":2446,"_21586":58598,"_5":14831,"_28346":58514,"_3068":58599},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3612":2481,"_31165":2446,"_21586":58601,"_5":14831,"_28346":58514,"_3068":58602},[],"Generate the request:",{"_3612":2482,"_31165":2446,"_21586":58604,"_5":14831,"_28346":58514,"_3068":58605},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3612":2483,"_31165":2446,"_21586":58607,"_5":14831,"_28346":58514,"_3068":58608},[],"Replace the example URL with the inspected endpoint:",{"_3612":2484,"_31165":2446,"_21586":58610,"_5":14831,"_28346":58514,"_3068":58611},[],"Verify the returned DER:",{"_3612":2485,"_31165":2446,"_21586":58613,"_5":14831,"_28346":58514,"_3068":58614},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3612":2486,"_31165":2446,"_21586":58616,"_5":14831,"_28346":58518,"_3068":58617},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3612":2487,"_31165":2446,"_21586":58619,"_5":14831,"_28346":58518,"_3068":58620},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3612":2488,"_31165":2446,"_21586":58622,"_5":14831,"_28346":58522,"_3068":58623},[],"RFC 6960: OCSP.",{"_3612":2489,"_31165":2446,"_21586":58625,"_5":14831,"_28346":58522,"_3068":58626},[],"OpenSSL: openssl-ocsp.",{"_3612":2490,"_31165":2446,"_21586":58628,"_5":14831,"_28346":58522,"_3068":58629},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3612":2491,"_31165":2446,"_21586":58631,"_5":14831,"_28346":58522,"_3068":58100},[],{"_3612":2492,"_31165":2492,"_5":15196,"_3068":56574,"_31523":58633,"_21586":58634,"_28346":2492},[50890,52402,56574],[],{"_3612":2493,"_31165":2492,"_21586":58636,"_5":14831,"_28346":2492,"_3068":58637},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3612":2494,"_31165":2492,"_5":31520,"_21586":58639,"_28346":58640,"_3068":55886},[],"/docs/pr-preview/pr-77/platform/pki/overview#start-here",{"_3612":2495,"_31165":2492,"_5":31520,"_21586":58642,"_28346":58643,"_3068":58644},[],"/docs/pr-preview/pr-77/platform/pki/overview#what-you-need","What you need",{"_3612":2496,"_31165":2492,"_5":31520,"_21586":58646,"_28346":58647,"_3068":56418},[],"/docs/pr-preview/pr-77/platform/pki/overview#core-capabilities",{"_3612":2497,"_31165":2492,"_5":31520,"_21586":58649,"_28346":58650,"_3068":56422},[],"/docs/pr-preview/pr-77/platform/pki/overview#build-your-trust-hierarchy",{"_3612":2498,"_31165":2492,"_5":31520,"_21586":58652,"_28346":58653,"_3068":56426},[],"/docs/pr-preview/pr-77/platform/pki/overview#protect-cryptographic-keys",{"_3612":2499,"_31165":2492,"_5":31520,"_21586":58655,"_28346":58656,"_3068":56430},[],"/docs/pr-preview/pr-77/platform/pki/overview#issue-and-control-certificates",{"_3612":2500,"_31165":2492,"_5":31520,"_21586":58658,"_28346":58659,"_3068":56438},[],"/docs/pr-preview/pr-77/platform/pki/overview#publish-validation-status",{"_3612":2501,"_31165":2492,"_5":31520,"_21586":58661,"_28346":58662,"_3068":58663},[],"/docs/pr-preview/pr-77/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3612":2502,"_31165":2492,"_5":31520,"_21586":58665,"_28346":58666,"_3068":57392},[],"/docs/pr-preview/pr-77/platform/pki/overview#continue",{"_3612":2503,"_31165":2492,"_21586":58668,"_5":14831,"_28346":2492,"_3068":58669},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3612":2504,"_31165":2492,"_21586":58671,"_5":14831,"_28346":58640,"_3068":58672},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3612":2505,"_31165":2492,"_21586":58674,"_5":14831,"_28346":58640,"_3068":58675},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3612":2506,"_31165":2492,"_21586":58677,"_5":14831,"_28346":58643,"_3068":58678},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3612":2507,"_31165":2492,"_21586":58680,"_5":14831,"_28346":58643,"_3068":58681},[],"An available cryptographic engine to keep the authority's key.",{"_3612":2508,"_31165":2492,"_21586":58683,"_5":14831,"_28346":58643,"_3068":58684},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3612":2509,"_31165":2492,"_21586":58686,"_5":14831,"_28346":58643,"_3068":58687},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3612":2510,"_31165":2492,"_21586":58689,"_5":14831,"_28346":58643,"_3068":58690},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3612":2511,"_31165":2492,"_21586":58692,"_5":14831,"_28346":58650,"_3068":58693},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3612":2512,"_31165":2492,"_21586":58695,"_5":14831,"_28346":58653,"_3068":58696},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3612":2513,"_31165":2492,"_21586":58698,"_5":14831,"_28346":58656,"_3068":58699},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3612":2514,"_31165":2492,"_21586":58701,"_5":14831,"_28346":58659,"_3068":58702},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3612":2515,"_31165":2492,"_21586":58704,"_5":14831,"_28346":58662,"_3068":58705},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3612":2516,"_31165":2492,"_21586":58707,"_5":14831,"_28346":58662,"_3068":58708},[],"its subject and extensions identify the expected client;",{"_3612":2517,"_31165":2492,"_21586":58710,"_5":14831,"_28346":58662,"_3068":58711},[],"its public key matches the client's private key;",{"_3612":2518,"_31165":2492,"_21586":58713,"_5":14831,"_28346":58662,"_3068":58714},[],"its chain reaches a root trusted by the consumer;",{"_3612":2519,"_31165":2492,"_21586":58716,"_5":14831,"_28346":58662,"_3068":58717},[],"its dates and usages allow the operation;",{"_3612":2520,"_31165":2492,"_21586":58719,"_5":14831,"_28346":58662,"_3068":58720},[],"the consumer applies revocation checks and authorization.",{"_3612":2521,"_31165":2492,"_21586":58722,"_5":14831,"_28346":58662,"_3068":58723},[],"The issuance path includes the first independent checks.",{"_3612":2522,"_31165":2492,"_21586":58725,"_5":14831,"_28346":58666,"_3068":58726},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3612":2523,"_31165":2492,"_21586":58728,"_5":14831,"_28346":58666,"_3068":58729},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3612":2524,"_31165":2492,"_21586":58731,"_5":14831,"_28346":58666,"_3068":58732},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3612":2525,"_31165":2525,"_5":15196,"_3068":58734,"_31523":58735,"_21586":58736,"_28346":2525},"Create your first CA",[50890,52402,56574,56011],[],{"_3612":2526,"_31165":2525,"_21586":58738,"_5":14831,"_28346":2525,"_3068":58739},[],"Create an evaluation root and check its certificate before issuing.",{"_3612":2527,"_31165":2525,"_5":31520,"_21586":58741,"_28346":58742,"_3068":50900},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3612":2528,"_31165":2525,"_5":31520,"_21586":58744,"_28346":58745,"_3068":58746},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3612":2529,"_31165":2525,"_5":31520,"_21586":58748,"_28346":58749,"_3068":58750},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3612":2530,"_31165":2525,"_5":31520,"_21586":58752,"_28346":58753,"_3068":58754},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3612":2531,"_31165":2525,"_5":31520,"_21586":58756,"_28346":58757,"_3068":58758},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3612":2532,"_31165":2525,"_5":31520,"_21586":58760,"_28346":58761,"_3068":58762},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3612":2533,"_31165":2525,"_5":31520,"_21586":58764,"_28346":58765,"_3068":58766},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3612":2534,"_31165":2525,"_5":31520,"_21586":58768,"_28346":58769,"_3068":56268},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3612":2535,"_31165":2525,"_5":31520,"_21586":58771,"_28346":58772,"_3068":50924},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3612":2536,"_31165":2525,"_21586":58774,"_5":14831,"_28346":2525,"_3068":58775},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3612":2537,"_31165":2525,"_21586":58777,"_5":14831,"_28346":58742,"_3068":58778},[],"Console access and permission to create keys and authorities.",{"_3612":2538,"_31165":2525,"_21586":58780,"_5":14831,"_28346":58742,"_3068":58781},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3612":2539,"_31165":2525,"_21586":58783,"_5":14831,"_28346":58742,"_3068":58784},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3612":2540,"_31165":2525,"_21586":58786,"_5":14831,"_28346":58742,"_3068":58787},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3612":2541,"_31165":2525,"_21586":58789,"_5":14831,"_28346":58745,"_3068":58790},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3612":2542,"_31165":2525,"_21586":58792,"_5":14831,"_28346":58745,"_3068":58793},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3612":2543,"_31165":2525,"_21586":58795,"_5":14831,"_28346":58749,"_3068":58796},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3612":2544,"_31165":2525,"_21586":58798,"_5":14831,"_28346":58749,"_3068":58799},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3612":2545,"_31165":2525,"_21586":58801,"_5":14831,"_28346":58753,"_3068":58802},[],"Select **Root CA** and complete:",{"_3612":2546,"_31165":2525,"_21586":58804,"_5":14831,"_28346":58753,"_3068":58805},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3612":2547,"_31165":2525,"_21586":58807,"_5":14831,"_28346":58753,"_3068":58808},[],"**Subject**: organization and country details for your evaluation.",{"_3612":2548,"_31165":2525,"_21586":58810,"_5":14831,"_28346":58753,"_3068":58811},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3612":2549,"_31165":2525,"_21586":58813,"_5":14831,"_28346":58753,"_3068":58814},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3612":2550,"_31165":2525,"_21586":58816,"_5":14831,"_28346":58753,"_3068":58817},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3612":2551,"_31165":2525,"_21586":58819,"_5":14831,"_28346":58757,"_3068":58820},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3612":2552,"_31165":2525,"_21586":58822,"_5":14831,"_28346":58761,"_3068":58823},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3612":2553,"_31165":2525,"_21586":58825,"_5":14831,"_28346":58761,"_3068":58826},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3612":2554,"_31165":2525,"_21586":58828,"_5":14831,"_28346":58765,"_3068":58829},[],"Run from the directory where you saved `ca.pem`:",{"_3612":2555,"_31165":2525,"_21586":58831,"_5":14831,"_28346":58765,"_3068":58832},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3612":2556,"_31165":2525,"_21586":58834,"_5":14831,"_28346":58765,"_3068":58835},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3612":2557,"_31165":2525,"_21586":58837,"_5":14831,"_28346":58769,"_3068":58838},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3612":2558,"_31165":2525,"_21586":58840,"_5":14831,"_28346":58769,"_3068":58841},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3612":2559,"_31165":2525,"_21586":58843,"_5":14831,"_28346":58769,"_3068":58844},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3612":2560,"_31165":2525,"_21586":58846,"_5":14831,"_28346":58769,"_3068":58847},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3612":2561,"_31165":2525,"_21586":58849,"_5":14831,"_28346":58772,"_3068":58850},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3612":2562,"_31165":2562,"_5":15196,"_3068":58852,"_31523":58853,"_21586":58854,"_28346":2562},"Issue and verify a certificate",[50890,52402,56574,56011],[],{"_3612":2563,"_31165":2562,"_21586":58856,"_5":14831,"_28346":2562,"_3068":58857},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3612":2564,"_31165":2562,"_5":31520,"_21586":58859,"_28346":58860,"_3068":50900},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3612":2565,"_31165":2562,"_5":31520,"_21586":58862,"_28346":58863,"_3068":58864},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3612":2566,"_31165":2562,"_5":31520,"_21586":58866,"_28346":58867,"_3068":58868},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3612":2567,"_31165":2562,"_5":31520,"_21586":58870,"_28346":58871,"_3068":58872},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3612":2568,"_31165":2562,"_5":31520,"_21586":58874,"_28346":58875,"_3068":58876},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3612":2569,"_31165":2562,"_5":31520,"_21586":58878,"_28346":58879,"_3068":58880},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3612":2570,"_31165":2562,"_5":31520,"_21586":58882,"_28346":58883,"_3068":58884},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3612":2571,"_31165":2562,"_5":31520,"_21586":58886,"_28346":58887,"_3068":58888},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3612":2572,"_31165":2562,"_5":31520,"_21586":58890,"_28346":58891,"_3068":58892},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3612":2573,"_31165":2562,"_5":31520,"_21586":58894,"_28346":58895,"_3068":58896},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3612":2574,"_31165":2562,"_5":31520,"_21586":58898,"_28346":58899,"_3068":56268},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3612":2575,"_31165":2562,"_5":31520,"_21586":58901,"_28346":58902,"_3068":50924},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/issue-certificate#next-step",{"_3612":2576,"_31165":2562,"_21586":58904,"_5":14831,"_28346":2562,"_3068":58905},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3612":2577,"_31165":2562,"_21586":58907,"_5":14831,"_28346":58860,"_3068":58908},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3612":2578,"_31165":2562,"_21586":58910,"_5":14831,"_28346":58860,"_3068":58911},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3612":2579,"_31165":2562,"_21586":58913,"_5":14831,"_28346":58860,"_3068":58914},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3612":2580,"_31165":2562,"_21586":58916,"_5":14831,"_28346":58860,"_3068":58917},[],"A client identifier: here we use `device-001`.",{"_3612":2581,"_31165":2562,"_21586":58919,"_5":14831,"_28346":58860,"_3068":58920},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3612":2582,"_31165":2562,"_21586":58922,"_5":14831,"_28346":58863,"_3068":58923},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3612":2583,"_31165":2562,"_21586":58925,"_5":14831,"_28346":58867,"_3068":58926},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3612":2584,"_31165":2562,"_21586":58928,"_5":14831,"_28346":58867,"_3068":58929},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3612":2585,"_31165":2562,"_21586":58931,"_5":14831,"_28346":58871,"_3068":58932},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3612":2586,"_31165":2562,"_21586":58934,"_5":14831,"_28346":58871,"_3068":58935},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3612":2587,"_31165":2562,"_21586":58937,"_5":14831,"_28346":58875,"_3068":58938},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3612":2588,"_31165":2562,"_21586":58940,"_5":14831,"_28346":58875,"_3068":58941},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3612":2589,"_31165":2562,"_21586":58943,"_5":14831,"_28346":58879,"_3068":58944},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3612":2590,"_31165":2562,"_21586":58946,"_5":14831,"_28346":58883,"_3068":58947},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3612":2591,"_31165":2562,"_21586":58949,"_5":14831,"_28346":58887,"_3068":58950},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3612":2592,"_31165":2562,"_21586":58952,"_5":14831,"_28346":58891,"_3068":58953},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3612":2593,"_31165":2562,"_21586":58955,"_5":14831,"_28346":58891,"_3068":58956},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3612":2594,"_31165":2562,"_21586":58958,"_5":14831,"_28346":58891,"_3068":58959},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3612":2595,"_31165":2562,"_21586":58961,"_5":14831,"_28346":58895,"_3068":58962},[],"In Bash, compare the two public-key digests:",{"_3612":2596,"_31165":2562,"_21586":58964,"_5":14831,"_28346":58895,"_3068":58965},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3612":2597,"_31165":2562,"_21586":58967,"_5":14831,"_28346":58895,"_3068":58968},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3612":2598,"_31165":2562,"_21586":58970,"_5":14831,"_28346":58899,"_3068":56352},[],{"_3612":2599,"_31165":2562,"_21586":58972,"_5":14831,"_28346":58899,"_3068":58973},[],"What to review",{"_3612":2600,"_31165":2562,"_21586":58975,"_5":14831,"_28346":58899,"_3068":58976},[],"The CA rejects issuance",{"_3612":2601,"_31165":2562,"_21586":58978,"_5":14831,"_28346":58899,"_3068":58979},[],"Permissions, CA state and key, algorithm and profile.",{"_3612":2602,"_31165":2562,"_21586":58981,"_5":14831,"_28346":58899,"_3068":58982},[],"Different subject or usages",{"_3612":2603,"_31165":2562,"_21586":58984,"_5":14831,"_28346":58899,"_3068":58985},[],"Applied profile and requested values.",{"_3612":2604,"_31165":2562,"_21586":58987,"_5":14831,"_28346":58899,"_3068":58988},[],"Issuer cannot be found",{"_3612":2605,"_31165":2562,"_21586":58990,"_5":14831,"_28346":58899,"_3068":58991},[],"Downloaded CA and required intermediate chain.",{"_3612":2606,"_31165":2562,"_21586":58993,"_5":14831,"_28346":58899,"_3068":58994},[],"Validity fails",{"_3612":2607,"_31165":2562,"_21586":58996,"_5":14831,"_28346":58899,"_3068":58997},[],"Certificate and CA dates, and the computer's clock.",{"_3612":2608,"_31165":2562,"_21586":58999,"_5":14831,"_28346":58899,"_3068":59000},[],"Public-key digests differ",{"_3612":2609,"_31165":2562,"_21586":59002,"_5":14831,"_28346":58899,"_3068":59003},[],"Certificate and key files from the same issuance.",{"_3612":2610,"_31165":2562,"_21586":59005,"_5":14831,"_28346":58899,"_3068":59006},[],"See PKI diagnostics to narrow an issuance failure.",{"_3612":2611,"_31165":2562,"_21586":59008,"_5":14831,"_28346":58902,"_3068":59009},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3612":2612,"_31165":2562,"_21586":59011,"_5":14831,"_28346":58902,"_3068":59012},[],"Manage certificates for inspection, status and revocation.",{"_3612":2613,"_31165":2562,"_21586":59014,"_5":14831,"_28346":58902,"_3068":59015},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3612":2614,"_31165":2562,"_21586":59017,"_5":14831,"_28346":58902,"_3068":59018},[],"Prepare EST for the device to request its next identities.",{"_3612":2615,"_31165":2562,"_21586":59020,"_5":14831,"_28346":58902,"_3068":59021},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3612":2616,"_31165":2616,"_5":15196,"_3068":59023,"_31523":59024,"_21586":59025,"_28346":2616},"PKI getting started",[50890,52402,56574,56011],[],{"_3612":2617,"_31165":2616,"_21586":59027,"_5":14831,"_28346":2616,"_3068":59028},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3612":2618,"_31165":2616,"_5":31520,"_21586":59030,"_28346":59031,"_3068":50900},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/overview#before-you-begin",{"_3612":2619,"_31165":2616,"_5":31520,"_21586":59033,"_28346":59034,"_3068":59035},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3612":2620,"_31165":2616,"_5":31520,"_21586":59037,"_28346":59038,"_3068":56203},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/overview#expected-result",{"_3612":2621,"_31165":2616,"_5":31520,"_21586":59040,"_28346":59041,"_3068":59042},[],"/docs/pr-preview/pr-77/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3612":2622,"_31165":2616,"_21586":59044,"_5":14831,"_28346":2616,"_3068":59045},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3612":2623,"_31165":2616,"_21586":59047,"_5":14831,"_28346":59031,"_3068":59048},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3612":2624,"_31165":2616,"_21586":59050,"_5":14831,"_28346":59031,"_3068":59051},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3612":2625,"_31165":2616,"_21586":59053,"_5":14831,"_28346":59031,"_3068":59054},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3612":2626,"_31165":2616,"_21586":59056,"_5":14831,"_28346":59031,"_3068":59057},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3612":2627,"_31165":2616,"_21586":59059,"_5":14831,"_28346":59031,"_3068":59060},[],"A working directory with restricted access for the downloaded key.",{"_3612":2628,"_31165":2616,"_21586":59062,"_5":14831,"_28346":59034,"_3068":59063},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3612":2629,"_31165":2616,"_21586":59065,"_5":14831,"_28346":59034,"_3068":59066},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3612":2630,"_31165":2616,"_21586":59068,"_5":14831,"_28346":59034,"_3068":59069},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3612":2631,"_31165":2616,"_21586":59071,"_5":14831,"_28346":59034,"_3068":59072},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3612":2632,"_31165":2616,"_21586":59074,"_5":14831,"_28346":59038,"_3068":59075},[],"File or resource",{"_3612":2633,"_31165":2616,"_21586":59077,"_5":14831,"_28346":59038,"_3068":56200},[],{"_3612":2634,"_31165":2616,"_21586":59079,"_5":14831,"_28346":59038,"_3068":59080},[],"Active root CA and `ca.pem`",{"_3612":2635,"_31165":2616,"_21586":59082,"_5":14831,"_28346":59038,"_3068":59083},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3612":2636,"_31165":2616,"_21586":59085,"_5":14831,"_28346":59038,"_3068":59086},[],"End-entity certificate and `device.crt`",{"_3612":2637,"_31165":2616,"_21586":59088,"_5":14831,"_28346":59038,"_3068":59089},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3612":2638,"_31165":2616,"_21586":59091,"_5":14831,"_28346":59038,"_3068":59092},[],"Private key `device.key`",{"_3612":2639,"_31165":2616,"_21586":59094,"_5":14831,"_28346":59038,"_3068":59095},[],"Its public key matches the one included in `device.crt`.",{"_3612":2640,"_31165":2616,"_21586":59097,"_5":14831,"_28346":59038,"_3068":59098},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3612":2641,"_31165":2616,"_21586":59100,"_5":14831,"_28346":59041,"_3068":59101},[],"To operate certificates, continue with Certificates and Validation.",{"_3612":2642,"_31165":2616,"_21586":59103,"_5":14831,"_28346":59041,"_3068":59104},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3612":2643,"_31165":2616,"_21586":59106,"_5":14831,"_28346":59041,"_3068":59107},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3612":2644,"_31165":2644,"_5":15196,"_3068":59109,"_31523":59110,"_21586":59111,"_28346":2644},"PKI troubleshooting",[50890,52402,56574,55149],[],{"_3612":2645,"_31165":2644,"_21586":59113,"_5":14831,"_28346":2644,"_3068":59114},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3612":2646,"_31165":2644,"_5":31520,"_21586":59116,"_28346":59117,"_3068":59118},[],"/docs/pr-preview/pr-77/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3612":2647,"_31165":2644,"_5":31520,"_21586":59120,"_28346":59121,"_3068":59122},[],"/docs/pr-preview/pr-77/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3612":2648,"_31165":2644,"_5":31520,"_21586":59124,"_28346":59125,"_3068":59126},[],"/docs/pr-preview/pr-77/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3612":2649,"_31165":2644,"_21586":59128,"_5":14831,"_28346":2644,"_3068":59129},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3612":2650,"_31165":2644,"_21586":59131,"_5":14831,"_28346":2644,"_3068":59132},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3612":2651,"_31165":2644,"_21586":59134,"_5":14831,"_28346":59117,"_3068":56200},[],{"_3612":2652,"_31165":2644,"_21586":59136,"_5":14831,"_28346":59117,"_3068":59137},[],"What to inspect",{"_3612":2653,"_31165":2644,"_21586":59139,"_5":14831,"_28346":59117,"_3068":50924},[],{"_3612":2654,"_31165":2644,"_21586":59141,"_5":14831,"_28346":59117,"_3068":55416},[],{"_3612":2655,"_31165":2644,"_21586":59143,"_5":14831,"_28346":59117,"_3068":59144},[],"Exists, is active and has usable dates.",{"_3612":2656,"_31165":2644,"_21586":59146,"_5":14831,"_28346":59117,"_3068":59147},[],"Authorities.",{"_3612":2657,"_31165":2644,"_21586":59149,"_5":14831,"_28346":59117,"_3068":59150},[],"Key",{"_3612":2658,"_31165":2644,"_21586":59152,"_5":14831,"_28346":59117,"_3068":59153},[],"The record has a usable private key and the engine can sign.",{"_3612":2659,"_31165":2644,"_21586":59155,"_5":14831,"_28346":59117,"_3068":59156},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3612":2660,"_31165":2644,"_21586":59158,"_5":14831,"_28346":59117,"_3068":59159},[],"CSR",{"_3612":2661,"_31165":2644,"_21586":59161,"_5":14831,"_28346":59117,"_3068":59162},[],"Correct PEM and verifiable signature.",{"_3612":2662,"_31165":2644,"_21586":59164,"_5":14831,"_28346":59117,"_3068":59165},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3612":2663,"_31165":2644,"_21586":59167,"_5":14831,"_28346":59117,"_3068":59168},[],"Profile",{"_3612":2664,"_31165":2644,"_21586":59170,"_5":14831,"_28346":59117,"_3068":59171},[],"Selected source, existing ID, allowed algorithm and size.",{"_3612":2665,"_31165":2644,"_21586":59173,"_5":14831,"_28346":59117,"_3068":59174},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3612":2666,"_31165":2644,"_21586":59176,"_5":14831,"_28346":59117,"_3068":56352},[],{"_3612":2667,"_31165":2644,"_21586":59178,"_5":14831,"_28346":59117,"_3068":59179},[],"Appropriate subject, SAN, usages and dates.",{"_3612":2668,"_31165":2644,"_21586":59181,"_5":14831,"_28346":59117,"_3068":59182},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3612":2669,"_31165":2644,"_21586":59184,"_5":14831,"_28346":59117,"_3068":59185},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3612":2670,"_31165":2644,"_21586":59187,"_5":14831,"_28346":59117,"_3068":59188},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3612":2671,"_31165":2644,"_21586":59190,"_5":14831,"_28346":59117,"_3068":59191},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3612":2672,"_31165":2644,"_21586":59193,"_5":14831,"_28346":59121,"_3068":59194},[],"Check each boundary independently:",{"_3612":2673,"_31165":2644,"_21586":59196,"_5":14831,"_28346":59121,"_3068":59197},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3612":2674,"_31165":2644,"_21586":59199,"_5":14831,"_28346":59121,"_3068":59200},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3612":2675,"_31165":2644,"_21586":59202,"_5":14831,"_28346":59121,"_3068":59203},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3612":2676,"_31165":2644,"_21586":59205,"_5":14831,"_28346":59121,"_3068":59206},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3612":2677,"_31165":2644,"_21586":59208,"_5":14831,"_28346":59121,"_3068":59209},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3612":2678,"_31165":2644,"_21586":59211,"_5":14831,"_28346":59121,"_3068":59212},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3612":2679,"_31165":2644,"_21586":59214,"_5":14831,"_28346":59125,"_3068":59215},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3612":2680,"_31165":2644,"_21586":59217,"_5":14831,"_28346":59125,"_3068":59218},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3612":2681,"_31165":2681,"_5":15196,"_3068":59220,"_31523":59221,"_21586":59222,"_28346":2681},"Security",[50890],[],{"_3612":2682,"_31165":2681,"_21586":59224,"_5":14831,"_28346":2681,"_3068":59225},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3612":2683,"_31165":2681,"_5":31520,"_21586":59227,"_28346":59228,"_3068":59229},[],"/docs/pr-preview/pr-77/security#report-a-vulnerability","Report a vulnerability",{"_3612":2684,"_31165":2681,"_5":31520,"_21586":59231,"_28346":59232,"_3068":59233},[],"/docs/pr-preview/pr-77/security#what-to-include-in-a-report","What to include in a report",{"_3612":2685,"_31165":2681,"_5":31520,"_21586":59235,"_28346":59236,"_3068":59237},[],"/docs/pr-preview/pr-77/security#supported-versions","Supported versions",{"_3612":2686,"_31165":2681,"_5":31520,"_21586":59239,"_28346":59240,"_3068":59241},[],"/docs/pr-preview/pr-77/security#responsible-disclosure","Responsible disclosure",{"_3612":2687,"_31165":2681,"_21586":59243,"_5":14831,"_28346":2681,"_3068":59244},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3612":2688,"_31165":2681,"_21586":59246,"_5":14831,"_28346":59228,"_3068":59247},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3612":2689,"_31165":2681,"_21586":59249,"_5":14831,"_28346":59228,"_3068":59250},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3612":2690,"_31165":2681,"_21586":59252,"_5":14831,"_28346":59228,"_3068":15470},[],{"_3612":2691,"_31165":2681,"_21586":59254,"_5":14831,"_28346":59228,"_3068":15399},[],{"_3612":2692,"_31165":2681,"_21586":59256,"_5":14831,"_28346":59228,"_3068":15457},[],{"_3612":2693,"_31165":2681,"_21586":59258,"_5":14831,"_28346":59228,"_3068":59259},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3612":2694,"_31165":2681,"_21586":59261,"_5":14831,"_28346":59228,"_3068":59262},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3612":2695,"_31165":2681,"_21586":59264,"_5":14831,"_28346":59232,"_3068":59265},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3612":2696,"_31165":2681,"_21586":59267,"_5":14831,"_28346":59232,"_3068":59268},[],"Do not include in the report:",{"_3612":2697,"_31165":2681,"_21586":59270,"_5":14831,"_28346":59232,"_3068":59271},[],"Credentials, tokens, or private keys",{"_3612":2698,"_31165":2681,"_21586":59273,"_5":14831,"_28346":59232,"_3068":59274},[],"Customer data or customer-identifiable information",{"_3612":2699,"_31165":2681,"_21586":59276,"_5":14831,"_28346":59232,"_3068":59277},[],"Confidential architecture or internal infrastructure details",{"_3612":2700,"_31165":2681,"_21586":59279,"_5":14831,"_28346":59236,"_3068":59280},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3612":2701,"_31165":2681,"_21586":59282,"_5":14831,"_28346":59236,"_3068":59283},[],"For upgrade guidance, see Upgrades.",{"_3612":2702,"_31165":2681,"_21586":59285,"_5":14831,"_28346":59240,"_3068":59286},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3612":2703,"_31165":2681,"_21586":59288,"_5":14831,"_28346":59240,"_3068":59289},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3612":2704,"_31165":2681,"_21586":59291,"_5":14831,"_28346":59240,"_3068":59292},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3612":2705,"_31165":2681,"_21586":59294,"_5":14831,"_28346":59240,"_3068":59295},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3612":2706,"_31165":2681,"_21586":59297,"_5":14831,"_28346":59240,"_3068":59298},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3612":2707,"_31165":2707,"_5":15196,"_3068":59300,"_31523":59301,"_21586":59303,"_28346":2707},"3.8.0 to 4.0.0",[50890,59302],"Upgrades",[],{"_3612":2708,"_31165":2707,"_21586":59305,"_5":14831,"_28346":2707,"_3068":59306},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3612":2709,"_31165":2707,"_5":31520,"_21586":59308,"_28346":59309,"_3068":59310},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3612":2710,"_31165":2707,"_5":31520,"_21586":59312,"_28346":59313,"_3068":59314},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3612":2711,"_31165":2707,"_5":31520,"_21586":59316,"_28346":59317,"_3068":59318},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3612":2712,"_31165":2707,"_5":31520,"_21586":59320,"_28346":59321,"_3068":59322},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3612":2713,"_31165":2707,"_5":31520,"_21586":59324,"_28346":59325,"_3068":59326},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3612":2714,"_31165":2707,"_5":31520,"_21586":59328,"_28346":59329,"_3068":59330},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3612":2715,"_31165":2707,"_5":31520,"_21586":59332,"_28346":59333,"_3068":59334},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3612":2716,"_31165":2707,"_5":31520,"_21586":59336,"_28346":59337,"_3068":59338},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3612":2717,"_31165":2707,"_5":31520,"_21586":59340,"_28346":59341,"_3068":59342},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3612":2718,"_31165":2707,"_5":31520,"_21586":59344,"_28346":59345,"_3068":59346},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3612":2719,"_31165":2707,"_5":31520,"_21586":59348,"_28346":59349,"_3068":51528},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3612":2720,"_31165":2707,"_5":31520,"_21586":59351,"_28346":59352,"_3068":59353},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3612":2721,"_31165":2707,"_5":31520,"_21586":59355,"_28346":59356,"_3068":59357},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3612":2722,"_31165":2707,"_5":31520,"_21586":59359,"_28346":59360,"_3068":59361},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3612":2723,"_31165":2707,"_5":31520,"_21586":59363,"_28346":59364,"_3068":59365},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3612":2724,"_31165":2707,"_5":31520,"_21586":59367,"_28346":59368,"_3068":59369},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3612":2725,"_31165":2707,"_5":31520,"_21586":59371,"_28346":59372,"_3068":59373},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3612":2726,"_31165":2707,"_5":31520,"_21586":59375,"_28346":59376,"_3068":59377},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3612":2727,"_31165":2707,"_5":31520,"_21586":59379,"_28346":59380,"_3068":59381},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3612":2728,"_31165":2707,"_5":31520,"_21586":59383,"_28346":59384,"_3068":59385},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3612":2729,"_31165":2707,"_5":31520,"_21586":59387,"_28346":59388,"_3068":59389},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3612":2730,"_31165":2707,"_5":31520,"_21586":59391,"_28346":59392,"_3068":59393},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3612":2731,"_31165":2707,"_5":31520,"_21586":59395,"_28346":59396,"_3068":59397},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3612":2732,"_31165":2707,"_5":31520,"_21586":59399,"_28346":59400,"_3068":59401},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3612":2733,"_31165":2707,"_5":31520,"_21586":59403,"_28346":59404,"_3068":59405},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3612":2734,"_31165":2707,"_5":31520,"_21586":59407,"_28346":59408,"_3068":59409},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3612":2735,"_31165":2707,"_5":31520,"_21586":59411,"_28346":59412,"_3068":59413},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3612":2736,"_31165":2707,"_5":31520,"_21586":59415,"_28346":59416,"_3068":59417},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3612":2737,"_31165":2707,"_5":31520,"_21586":59419,"_28346":59420,"_3068":59421},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3612":2738,"_31165":2707,"_5":31520,"_21586":59423,"_28346":59424,"_3068":59425},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3612":2739,"_31165":2707,"_5":31520,"_21586":59427,"_28346":59428,"_3068":59429},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3612":2740,"_31165":2707,"_5":31520,"_21586":59431,"_28346":59432,"_3068":59433},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3612":2741,"_31165":2707,"_5":31520,"_21586":59435,"_28346":59436,"_3068":59437},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3612":2742,"_31165":2707,"_5":31520,"_21586":59439,"_28346":59440,"_3068":59433},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3612":2743,"_31165":2707,"_5":31520,"_21586":59442,"_28346":59443,"_3068":59444},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3612":2744,"_31165":2707,"_5":31520,"_21586":59446,"_28346":59447,"_3068":59448},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3612":2745,"_31165":2707,"_5":31520,"_21586":59450,"_28346":59451,"_3068":59452},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3612":2746,"_31165":2707,"_5":31520,"_21586":59454,"_28346":59455,"_3068":59456},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3612":2747,"_31165":2707,"_5":31520,"_21586":59458,"_28346":59459,"_3068":59460},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3612":2748,"_31165":2707,"_5":31520,"_21586":59462,"_28346":59463,"_3068":59464},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3612":2749,"_31165":2707,"_5":31520,"_21586":59466,"_28346":59467,"_3068":59468},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3612":2750,"_31165":2707,"_5":31520,"_21586":59470,"_28346":59471,"_3068":59472},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3612":2751,"_31165":2707,"_5":31520,"_21586":59474,"_28346":59475,"_3068":59476},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3612":2752,"_31165":2707,"_5":31520,"_21586":59478,"_28346":59479,"_3068":55149},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3612":2753,"_31165":2707,"_5":31520,"_21586":59481,"_28346":59482,"_3068":59483},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3612":2754,"_31165":2707,"_5":31520,"_21586":59485,"_28346":59486,"_3068":59487},[],"/docs/pr-preview/pr-77/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3612":2755,"_31165":2707,"_21586":59489,"_5":14831,"_28346":2707,"_3068":59490},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3612":2756,"_31165":2707,"_21586":59492,"_5":14831,"_28346":2707,"_3068":59493},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3612":2757,"_31165":2707,"_21586":59495,"_5":14831,"_28346":2707,"_3068":59496},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3612":2758,"_31165":2707,"_21586":59498,"_5":14831,"_28346":2707,"_3068":59499},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3612":2759,"_31165":2707,"_21586":59501,"_5":14831,"_28346":2707,"_3068":59502},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3612":2760,"_31165":2707,"_21586":59504,"_5":14831,"_28346":2707,"_3068":59505},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3612":2761,"_31165":2707,"_21586":59507,"_5":14831,"_28346":2707,"_3068":59508},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3612":2762,"_31165":2707,"_21586":59510,"_5":14831,"_28346":59313,"_3068":59511},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3612":2763,"_31165":2707,"_21586":59513,"_5":14831,"_28346":59313,"_3068":59514},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3612":2764,"_31165":2707,"_21586":59516,"_5":14831,"_28346":59317,"_3068":59517},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3612":2765,"_31165":2707,"_21586":59519,"_5":14831,"_28346":59317,"_3068":59520},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3612":2766,"_31165":2707,"_21586":59522,"_5":14831,"_28346":59321,"_3068":59523},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3612":2767,"_31165":2707,"_21586":59525,"_5":14831,"_28346":59325,"_3068":59526},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3612":2768,"_31165":2707,"_21586":59528,"_5":14831,"_28346":59325,"_3068":59529},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3612":2769,"_31165":2707,"_21586":59531,"_5":14831,"_28346":59325,"_3068":59532},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3612":2770,"_31165":2707,"_21586":59534,"_5":14831,"_28346":59325,"_3068":59535},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3612":2771,"_31165":2707,"_21586":59537,"_5":14831,"_28346":59325,"_3068":59538},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3612":2772,"_31165":2707,"_21586":59540,"_5":14831,"_28346":59329,"_3068":59541},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3612":2773,"_31165":2707,"_21586":59543,"_5":14831,"_28346":59329,"_3068":59544},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3612":2774,"_31165":2707,"_21586":59546,"_5":14831,"_28346":59329,"_3068":59547},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3612":2775,"_31165":2707,"_21586":59549,"_5":14831,"_28346":59329,"_3068":59550},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3612":2776,"_31165":2707,"_21586":59552,"_5":14831,"_28346":59329,"_3068":59553},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3612":2777,"_31165":2707,"_21586":59555,"_5":14831,"_28346":59329,"_3068":59556},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3612":2778,"_31165":2707,"_21586":59558,"_5":14831,"_28346":59333,"_3068":59559},[],"Change",{"_3612":2779,"_31165":2707,"_21586":59561,"_5":14831,"_28346":59333,"_3068":59562},[],"Who is affected",{"_3612":2780,"_31165":2707,"_21586":59564,"_5":14831,"_28346":59333,"_3068":59565},[],"Severity",{"_3612":2781,"_31165":2707,"_21586":59567,"_5":14831,"_28346":59333,"_3068":58022},[],{"_3612":2782,"_31165":2707,"_21586":59569,"_5":14831,"_28346":59333,"_3068":59342},[],{"_3612":2783,"_31165":2707,"_21586":59571,"_5":14831,"_28346":59333,"_3068":59572},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3612":2784,"_31165":2707,"_21586":59574,"_5":14831,"_28346":59333,"_3068":59575},[],"High: KMS and VA start on empty volumes",{"_3612":2785,"_31165":2707,"_21586":59577,"_5":14831,"_28346":59333,"_3068":59578},[],"Copy the data into the new volumes",{"_3612":2786,"_31165":2707,"_21586":59580,"_5":14831,"_28346":59333,"_3068":59346},[],{"_3612":2787,"_31165":2707,"_21586":59582,"_5":14831,"_28346":59333,"_3068":59583},[],"Every Helm release",{"_3612":2788,"_31165":2707,"_21586":59585,"_5":14831,"_28346":59333,"_3068":59586},[],"High: `helm upgrade` fails",{"_3612":2789,"_31165":2707,"_21586":59588,"_5":14831,"_28346":59333,"_3068":59589},[],"Remove or rename legacy keys",{"_3612":2790,"_31165":2707,"_21586":59591,"_5":14831,"_28346":59333,"_3068":51528},[],{"_3612":2791,"_31165":2707,"_21586":59593,"_5":14831,"_28346":59333,"_3068":59583},[],{"_3612":2792,"_31165":2707,"_21586":59595,"_5":14831,"_28346":59333,"_3068":59596},[],"High: `helm upgrade` fails on inline credentials",{"_3612":2793,"_31165":2707,"_21586":59598,"_5":14831,"_28346":59333,"_3068":59599},[],"Create the Secrets first; see Step 2",{"_3612":2794,"_31165":2707,"_21586":59601,"_5":14831,"_28346":59333,"_3068":59353},[],{"_3612":2795,"_31165":2707,"_21586":59603,"_5":14831,"_28346":59333,"_3068":59604},[],"Every deployment",{"_3612":2796,"_31165":2707,"_21586":59606,"_5":14831,"_28346":59333,"_3068":59607},[],"High: without a bootstrap principal there is no administrator",{"_3612":2797,"_31165":2707,"_21586":59609,"_5":14831,"_28346":59333,"_3068":59610},[],"Configure `services.authz`",{"_3612":2798,"_31165":2707,"_21586":59612,"_5":14831,"_28346":59333,"_3068":59357},[],{"_3612":2799,"_31165":2707,"_21586":59614,"_5":14831,"_28346":59333,"_3068":59583},[],{"_3612":2800,"_31165":2707,"_21586":59616,"_5":14831,"_28346":59333,"_3068":59617},[],"High: `helm upgrade` fails on the old keys",{"_3612":2801,"_31165":2707,"_21586":59619,"_5":14831,"_28346":59333,"_3068":59620},[],"Move JWKS and roles into `services.authz`",{"_3612":2802,"_31165":2707,"_21586":59622,"_5":14831,"_28346":59333,"_3068":59377},[],{"_3612":2803,"_31165":2707,"_21586":59624,"_5":14831,"_28346":59333,"_3068":59625},[],"3.8.0 deployments with per-service databases",{"_3612":2804,"_31165":2707,"_21586":59627,"_5":14831,"_28346":59333,"_3068":59628},[],"High: services find no data, or a migration aborts",{"_3612":2805,"_31165":2707,"_21586":59630,"_5":14831,"_28346":59333,"_3068":59631},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3612":2806,"_31165":2707,"_21586":59633,"_5":14831,"_28346":59333,"_3068":59381},[],{"_3612":2807,"_31165":2707,"_21586":59635,"_5":14831,"_28346":59333,"_3068":59636},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3612":2808,"_31165":2707,"_21586":59638,"_5":14831,"_28346":59333,"_3068":59639},[],"High: the backend no longer starts with them",{"_3612":2809,"_31165":2707,"_21586":59641,"_5":14831,"_28346":59333,"_3068":59642},[],"Move to PostgreSQL before upgrading",{"_3612":2810,"_31165":2707,"_21586":59644,"_5":14831,"_28346":59333,"_3068":59425},[],{"_3612":2811,"_31165":2707,"_21586":59646,"_5":14831,"_28346":59333,"_3068":59647},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3612":2812,"_31165":2707,"_21586":59649,"_5":14831,"_28346":59333,"_3068":59650},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3612":2813,"_31165":2707,"_21586":59652,"_5":14831,"_28346":59333,"_3068":59653},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3612":2814,"_31165":2707,"_21586":59655,"_5":14831,"_28346":59333,"_3068":59656},[],"Webhooks with file references",{"_3612":2815,"_31165":2707,"_21586":59658,"_5":14831,"_28346":59333,"_3068":59659},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3612":2816,"_31165":2707,"_21586":59661,"_5":14831,"_28346":59333,"_3068":59662},[],"High: enrollments calling the webhook fail",{"_3612":2817,"_31165":2707,"_21586":59664,"_5":14831,"_28346":59333,"_3068":59665},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3612":2818,"_31165":2707,"_21586":59667,"_5":14831,"_28346":59333,"_3068":59361},[],{"_3612":2819,"_31165":2707,"_21586":59669,"_5":14831,"_28346":59333,"_3068":59670},[],"Releases with per-service identity overrides or mounted key material",{"_3612":2820,"_31165":2707,"_21586":59672,"_5":14831,"_28346":59333,"_3068":59673},[],"Medium: services cannot read their files",{"_3612":2821,"_31165":2707,"_21586":59675,"_5":14831,"_28346":59333,"_3068":59676},[],"Remove the overrides and fix volume ownership",{"_3612":2822,"_31165":2707,"_21586":59678,"_5":14831,"_28346":59333,"_3068":59365},[],{"_3612":2823,"_31165":2707,"_21586":59680,"_5":14831,"_28346":59333,"_3068":59681},[],"Releases that set `amqp.tls`",{"_3612":2824,"_31165":2707,"_21586":59683,"_5":14831,"_28346":59333,"_3068":59684},[],"Medium: clients connect to the wrong port",{"_3612":2825,"_31165":2707,"_21586":59686,"_5":14831,"_28346":59333,"_3068":59687},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3612":2826,"_31165":2707,"_21586":59689,"_5":14831,"_28346":59333,"_3068":59385},[],{"_3612":2827,"_31165":2707,"_21586":59691,"_5":14831,"_28346":59333,"_3068":59692},[],"Installations whose CA keys predate the KMS",{"_3612":2828,"_31165":2707,"_21586":59694,"_5":14831,"_28346":59333,"_3068":59695},[],"Medium: CA keys stay unmanaged",{"_3612":2829,"_31165":2707,"_21586":59697,"_5":14831,"_28346":59333,"_3068":59698},[],"Run the CA-to-KMS migration",{"_3612":2830,"_31165":2707,"_21586":59700,"_5":14831,"_28346":59333,"_3068":59701},[],"Receiver certificate verification",{"_3612":2831,"_31165":2707,"_21586":59703,"_5":14831,"_28346":59333,"_3068":59704},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3612":2832,"_31165":2707,"_21586":59706,"_5":14831,"_28346":59333,"_3068":59707},[],"Medium: credentials go to an unverified receiver",{"_3612":2833,"_31165":2707,"_21586":59709,"_5":14831,"_28346":59333,"_3068":59710},[],"Set `insecure_skip_verify` to `false`",{"_3612":2834,"_31165":2707,"_21586":59712,"_5":14831,"_28346":59333,"_3068":59401},[],{"_3612":2835,"_31165":2707,"_21586":59714,"_5":14831,"_28346":59333,"_3068":59715},[],"Scripts and consoles that edit DMSs through the API",{"_3612":2836,"_31165":2707,"_21586":59717,"_5":14831,"_28346":59333,"_3068":59718},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3612":2837,"_31165":2707,"_21586":59720,"_5":14831,"_28346":59333,"_3068":59721},[],"Read the DMS before editing and use the new field",{"_3612":2838,"_31165":2707,"_21586":59723,"_5":14831,"_28346":59333,"_3068":59421},[],{"_3612":2839,"_31165":2707,"_21586":59725,"_5":14831,"_28346":59333,"_3068":59726},[],"Clients that create or update CRL settings through the API",{"_3612":2840,"_31165":2707,"_21586":59728,"_5":14831,"_28346":59333,"_3068":59729},[],"Medium: requests with the old field return an error",{"_3612":2841,"_31165":2707,"_21586":59731,"_5":14831,"_28346":59333,"_3068":59732},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3612":2842,"_31165":2707,"_21586":59734,"_5":14831,"_28346":59333,"_3068":59429},[],{"_3612":2843,"_31165":2707,"_21586":59736,"_5":14831,"_28346":59333,"_3068":59737},[],"Alert subscriptions and consumers of the VA events",{"_3612":2844,"_31165":2707,"_21586":59739,"_5":14831,"_28346":59333,"_3068":59740},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3612":2845,"_31165":2707,"_21586":59742,"_5":14831,"_28346":59333,"_3068":59743},[],"Review conditions filtering on the old event payload or subject",{"_3612":2846,"_31165":2707,"_21586":59745,"_5":14831,"_28346":59333,"_3068":59433},[],{"_3612":2847,"_31165":2707,"_21586":59747,"_5":14831,"_28346":59333,"_3068":59748},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3612":2848,"_31165":2707,"_21586":59750,"_5":14831,"_28346":59333,"_3068":59751},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3612":2849,"_31165":2707,"_21586":59753,"_5":14831,"_28346":59333,"_3068":59754},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3612":2850,"_31165":2707,"_21586":59756,"_5":14831,"_28346":59333,"_3068":59417},[],{"_3612":2851,"_31165":2707,"_21586":59758,"_5":14831,"_28346":59333,"_3068":59759},[],"Consumers that read the device `events` field",{"_3612":2852,"_31165":2707,"_21586":59761,"_5":14831,"_28346":59333,"_3068":59762},[],"Medium: the field disappears",{"_3612":2853,"_31165":2707,"_21586":59764,"_5":14831,"_28346":59333,"_3068":59765},[],"Use the new event endpoints",{"_3612":2854,"_31165":2707,"_21586":59767,"_5":14831,"_28346":59333,"_3068":59444},[],{"_3612":2855,"_31165":2707,"_21586":59769,"_5":14831,"_28346":59333,"_3068":59770},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3612":2856,"_31165":2707,"_21586":59772,"_5":14831,"_28346":59333,"_3068":59773},[],"Medium: the VA migration aborts",{"_3612":2857,"_31165":2707,"_21586":59775,"_5":14831,"_28346":59333,"_3068":59776},[],"Fix the affected roles before upgrading",{"_3612":2858,"_31165":2707,"_21586":59778,"_5":14831,"_28346":59333,"_3068":59369},[],{"_3612":2859,"_31165":2707,"_21586":59780,"_5":14831,"_28346":59333,"_3068":59781},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3612":2860,"_31165":2707,"_21586":59783,"_5":14831,"_28346":59333,"_3068":59784},[],"Low to medium: validation errors or changed defaults",{"_3612":2861,"_31165":2707,"_21586":59786,"_5":14831,"_28346":59333,"_3068":59787},[],"Update the values file",{"_3612":2862,"_31165":2707,"_21586":59789,"_5":14831,"_28346":59333,"_3068":59409},[],{"_3612":2863,"_31165":2707,"_21586":59791,"_5":14831,"_28346":59333,"_3068":59792},[],"Clients that send the DMS ID in the update body",{"_3612":2864,"_31165":2707,"_21586":59794,"_5":14831,"_28346":59333,"_3068":59795},[],"Low: the ID in the URL wins",{"_3612":2865,"_31165":2707,"_21586":59797,"_5":14831,"_28346":59333,"_3068":59798},[],"Send the ID in the URL",{"_3612":2866,"_31165":2707,"_21586":59800,"_5":14831,"_28346":59333,"_3068":59437},[],{"_3612":2867,"_31165":2707,"_21586":59802,"_5":14831,"_28346":59333,"_3068":59803},[],"Clients that send an `id` when creating or importing CAs",{"_3612":2868,"_31165":2707,"_21586":59805,"_5":14831,"_28346":59333,"_3068":59806},[],"Low: the ID in the body is ignored, and the field is removed",{"_3612":2869,"_31165":2707,"_21586":59808,"_5":14831,"_28346":59333,"_3068":59809},[],"Let the backend assign the ID and use the returned one",{"_3612":2870,"_31165":2707,"_21586":59811,"_5":14831,"_28346":59333,"_3068":59433},[],{"_3612":2871,"_31165":2707,"_21586":59813,"_5":14831,"_28346":59333,"_3068":59814},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3612":2872,"_31165":2707,"_21586":59816,"_5":14831,"_28346":59333,"_3068":59817},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3612":2873,"_31165":2707,"_21586":59819,"_5":14831,"_28346":59333,"_3068":59820},[],"Use the KMS `sign` and `verify` operations",{"_3612":2874,"_31165":2707,"_21586":59822,"_5":14831,"_28346":59333,"_3068":59413},[],{"_3612":2875,"_31165":2707,"_21586":59824,"_5":14831,"_28346":59333,"_3068":59825},[],"Consumers that match on certificate `type`",{"_3612":2876,"_31165":2707,"_21586":59827,"_5":14831,"_28346":59333,"_3068":59828},[],"Low: two values are renamed",{"_3612":2877,"_31165":2707,"_21586":59830,"_5":14831,"_28346":59333,"_3068":59831},[],"Adapt consumers",{"_3612":2878,"_31165":2707,"_21586":59833,"_5":14831,"_28346":59333,"_3068":59405},[],{"_3612":2879,"_31165":2707,"_21586":59835,"_5":14831,"_28346":59333,"_3068":59836},[],"Any DMS",{"_3612":2880,"_31165":2707,"_21586":59838,"_5":14831,"_28346":59333,"_3068":59839},[],"Low: informational",{"_3612":2881,"_31165":2707,"_21586":59841,"_5":14831,"_28346":59333,"_3068":59842},[],"Read both blocks before editing",{"_3612":2882,"_31165":2707,"_21586":59844,"_5":14831,"_28346":59341,"_3068":59845},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3612":2883,"_31165":2707,"_21586":59847,"_5":14831,"_28346":59341,"_3068":59848},[],"Step 4 of the migration guide copies the data.",{"_3612":2884,"_31165":2707,"_21586":59850,"_5":14831,"_28346":59345,"_3068":59851},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3612":2885,"_31165":2707,"_21586":59853,"_5":14831,"_28346":59349,"_3068":59854},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3612":2886,"_31165":2707,"_21586":59856,"_5":14831,"_28346":59349,"_3068":59857},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3612":2887,"_31165":2707,"_21586":59859,"_5":14831,"_28346":59352,"_3068":59860},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3612":2888,"_31165":2707,"_21586":59862,"_5":14831,"_28346":59356,"_3068":59863},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3612":2889,"_31165":2707,"_21586":59865,"_5":14831,"_28346":59360,"_3068":59866},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3612":2890,"_31165":2707,"_21586":59868,"_5":14831,"_28346":59360,"_3068":59869},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3612":2891,"_31165":2707,"_21586":59871,"_5":14831,"_28346":59360,"_3068":59872},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3612":2892,"_31165":2707,"_21586":59874,"_5":14831,"_28346":59364,"_3068":59875},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3612":2893,"_31165":2707,"_21586":59877,"_5":14831,"_28346":59368,"_3068":59878},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3612":2894,"_31165":2707,"_21586":59880,"_5":14831,"_28346":59368,"_3068":59881},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3612":2895,"_31165":2707,"_21586":59883,"_5":14831,"_28346":59368,"_3068":59884},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3612":2896,"_31165":2707,"_21586":59886,"_5":14831,"_28346":59368,"_3068":59887},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3612":2897,"_31165":2707,"_21586":59889,"_5":14831,"_28346":59368,"_3068":59890},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3612":2898,"_31165":2707,"_21586":59892,"_5":14831,"_28346":59368,"_3068":59893},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3612":2899,"_31165":2707,"_21586":59895,"_5":14831,"_28346":59376,"_3068":59896},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3612":2900,"_31165":2707,"_21586":59898,"_5":14831,"_28346":59376,"_3068":59899},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3612":2901,"_31165":2707,"_21586":59901,"_5":14831,"_28346":59376,"_3068":59902},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3612":2902,"_31165":2707,"_21586":59904,"_5":14831,"_28346":59376,"_3068":59905},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3612":2903,"_31165":2707,"_21586":59907,"_5":14831,"_28346":59376,"_3068":59908},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3612":2904,"_31165":2707,"_21586":59910,"_5":14831,"_28346":59380,"_3068":59911},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3612":2905,"_31165":2707,"_21586":59913,"_5":14831,"_28346":59384,"_3068":59914},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3612":2906,"_31165":2707,"_21586":59916,"_5":14831,"_28346":59384,"_3068":59917},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3612":2907,"_31165":2707,"_21586":59919,"_5":14831,"_28346":59384,"_3068":59920},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3612":2908,"_31165":2707,"_21586":59922,"_5":14831,"_28346":59384,"_3068":59923},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3612":2909,"_31165":2707,"_21586":59925,"_5":14831,"_28346":59384,"_3068":59926},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3612":2910,"_31165":2707,"_21586":59928,"_5":14831,"_28346":59384,"_3068":59929},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3612":2911,"_31165":2707,"_21586":59931,"_5":14831,"_28346":59384,"_3068":59932},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3612":2912,"_31165":2707,"_21586":59934,"_5":14831,"_28346":59384,"_3068":59935},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3612":2913,"_31165":2707,"_21586":59937,"_5":14831,"_28346":59388,"_3068":59938},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3612":2914,"_31165":2707,"_21586":59940,"_5":14831,"_28346":59396,"_3068":59941},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3612":2915,"_31165":2707,"_21586":59943,"_5":14831,"_28346":59396,"_3068":59944},[],"Field in 3.8.0",{"_3612":2916,"_31165":2707,"_21586":59946,"_5":14831,"_28346":59396,"_3068":59947},[],"Field in 4.0.0",{"_3612":2917,"_31165":2707,"_21586":59949,"_5":14831,"_28346":59396,"_3068":59950},[],"`validate_server_cert`",{"_3612":2918,"_31165":2707,"_21586":59952,"_5":14831,"_28346":59396,"_3068":59953},[],"`insecure_skip_verify` (value negated)",{"_3612":2919,"_31165":2707,"_21586":59955,"_5":14831,"_28346":59396,"_3068":59956},[],"`oidc`",{"_3612":2920,"_31165":2707,"_21586":59958,"_5":14831,"_28346":59396,"_3068":59959},[],"`jwt_options`",{"_3612":2921,"_31165":2707,"_21586":59961,"_5":14831,"_28346":59396,"_3068":59962},[],"`apikey`",{"_3612":2922,"_31165":2707,"_21586":59964,"_5":14831,"_28346":59396,"_3068":59965},[],"`apikey_options`",{"_3612":2923,"_31165":2707,"_21586":59967,"_5":14831,"_28346":59396,"_3068":59968},[],"`mtls`",{"_3612":2924,"_31165":2707,"_21586":59970,"_5":14831,"_28346":59396,"_3068":59971},[],"`mtls_options`",{"_3612":2925,"_31165":2707,"_21586":59973,"_5":14831,"_28346":59396,"_3068":59974},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3612":2926,"_31165":2707,"_21586":59976,"_5":14831,"_28346":59396,"_3068":59977},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3612":2927,"_31165":2707,"_21586":59979,"_5":14831,"_28346":59396,"_3068":59980},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3612":2928,"_31165":2707,"_21586":59982,"_5":14831,"_28346":59400,"_3068":59983},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3612":2929,"_31165":2707,"_21586":59985,"_5":14831,"_28346":59400,"_3068":59986},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3612":2930,"_31165":2707,"_21586":59988,"_5":14831,"_28346":59400,"_3068":59989},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3612":2931,"_31165":2707,"_21586":59991,"_5":14831,"_28346":59404,"_3068":59992},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3612":2932,"_31165":2707,"_21586":59994,"_5":14831,"_28346":59408,"_3068":59995},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3612":2933,"_31165":2707,"_21586":59997,"_5":14831,"_28346":59412,"_3068":59998},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3612":2934,"_31165":2707,"_21586":60000,"_5":14831,"_28346":59416,"_3068":60001},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3612":2935,"_31165":2707,"_21586":60003,"_5":14831,"_28346":59416,"_3068":60004},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3612":2936,"_31165":2707,"_21586":60006,"_5":14831,"_28346":59416,"_3068":60007},[],"`POST /v1/devices/:id/events` creates an event.",{"_3612":2937,"_31165":2707,"_21586":60009,"_5":14831,"_28346":59416,"_3068":60010},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3612":2938,"_31165":2707,"_21586":60012,"_5":14831,"_28346":59420,"_3068":60013},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3612":2939,"_31165":2707,"_21586":60015,"_5":14831,"_28346":59424,"_3068":60016},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3612":2940,"_31165":2707,"_21586":60018,"_5":14831,"_28346":59424,"_3068":60019},[],"Route",{"_3612":2941,"_31165":2707,"_21586":60021,"_5":14831,"_28346":59424,"_3068":54336},[],{"_3612":2942,"_31165":2707,"_21586":60023,"_5":14831,"_28346":59424,"_3068":60024},[],"`GET /v1/crl-settings`",{"_3612":2943,"_31165":2707,"_21586":60026,"_5":14831,"_28346":59424,"_3068":60027},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3612":2944,"_31165":2707,"_21586":60029,"_5":14831,"_28346":59424,"_3068":60030},[],"`GET /v1/crl-settings/{ca-id}`",{"_3612":2945,"_31165":2707,"_21586":60032,"_5":14831,"_28346":59424,"_3068":60033},[],"Reads the settings of a CA.",{"_3612":2946,"_31165":2707,"_21586":60035,"_5":14831,"_28346":59424,"_3068":60036},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3612":2947,"_31165":2707,"_21586":60038,"_5":14831,"_28346":59424,"_3068":60039},[],"Replaces `crl_options`.",{"_3612":2948,"_31165":2707,"_21586":60041,"_5":14831,"_28346":59424,"_3068":60042},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3612":2949,"_31165":2707,"_21586":60044,"_5":14831,"_28346":59424,"_3068":60045},[],"Removes the archived settings of a CA.",{"_3612":2950,"_31165":2707,"_21586":60047,"_5":14831,"_28346":59424,"_3068":60048},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3612":2951,"_31165":2707,"_21586":60050,"_5":14831,"_28346":59424,"_3068":60051},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3612":2952,"_31165":2707,"_21586":60053,"_5":14831,"_28346":59424,"_3068":60054},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3612":2953,"_31165":2707,"_21586":60056,"_5":14831,"_28346":59424,"_3068":60057},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3612":2954,"_31165":2707,"_21586":60059,"_5":14831,"_28346":59424,"_3068":60060},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3612":2955,"_31165":2707,"_21586":60062,"_5":14831,"_28346":59424,"_3068":60063},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3612":2956,"_31165":2707,"_21586":60065,"_5":14831,"_28346":59424,"_3068":60066},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3612":2957,"_31165":2707,"_21586":60068,"_5":14831,"_28346":59424,"_3068":60069},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3612":2958,"_31165":2707,"_21586":60071,"_5":14831,"_28346":59424,"_3068":60072},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3612":2959,"_31165":2707,"_21586":60074,"_5":14831,"_28346":59424,"_3068":60075},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3612":2960,"_31165":2707,"_21586":60077,"_5":14831,"_28346":59424,"_3068":60078},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3612":2961,"_31165":2707,"_21586":60080,"_5":14831,"_28346":59428,"_3068":60081},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3612":2962,"_31165":2707,"_21586":60083,"_5":14831,"_28346":59432,"_3068":60084},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3612":2963,"_31165":2707,"_21586":60086,"_5":14831,"_28346":59436,"_3068":60087},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3612":2964,"_31165":2707,"_21586":60089,"_5":14831,"_28346":59440,"_3068":60090},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3612":2965,"_31165":2707,"_21586":60092,"_5":14831,"_28346":59440,"_3068":60093},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3612":2966,"_31165":2707,"_21586":60095,"_5":14831,"_28346":59443,"_3068":60096},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3612":2967,"_31165":2707,"_21586":60098,"_5":14831,"_28346":59447,"_3068":60099},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3612":2968,"_31165":2707,"_21586":60101,"_5":14831,"_28346":59451,"_3068":60102},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3612":2969,"_31165":2707,"_21586":60104,"_5":14831,"_28346":59451,"_3068":60105},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3612":2970,"_31165":2707,"_21586":60107,"_5":14831,"_28346":59451,"_3068":60108},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3612":2971,"_31165":2707,"_21586":60110,"_5":14831,"_28346":59451,"_3068":60111},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3612":2972,"_31165":2707,"_21586":60113,"_5":14831,"_28346":59451,"_3068":60114},[],"Record the names of your local-storage PVCs:",{"_3612":2973,"_31165":2707,"_21586":60116,"_5":14831,"_28346":59451,"_3068":60117},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3612":2974,"_31165":2707,"_21586":60119,"_5":14831,"_28346":59455,"_3068":60120},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3612":2975,"_31165":2707,"_21586":60122,"_5":14831,"_28346":59455,"_3068":60123},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3612":2976,"_31165":2707,"_21586":60125,"_5":14831,"_28346":59455,"_3068":60126},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3612":2977,"_31165":2707,"_21586":60128,"_5":14831,"_28346":59455,"_3068":60129},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3612":2978,"_31165":2707,"_21586":60131,"_5":14831,"_28346":59455,"_3068":60132},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3612":2979,"_31165":2707,"_21586":60134,"_5":14831,"_28346":59459,"_3068":60135},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3612":2980,"_31165":2707,"_21586":60137,"_5":14831,"_28346":59459,"_3068":60138},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3612":2981,"_31165":2707,"_21586":60140,"_5":14831,"_28346":59459,"_3068":60141},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3612":2982,"_31165":2707,"_21586":60143,"_5":14831,"_28346":59459,"_3068":60144},[],"Secret (`existingSecret`)",{"_3612":2983,"_31165":2707,"_21586":60146,"_5":14831,"_28346":59459,"_3068":60147},[],"Required data keys",{"_3612":2984,"_31165":2707,"_21586":60149,"_5":14831,"_28346":59459,"_3068":60150},[],"When",{"_3612":2985,"_31165":2707,"_21586":60152,"_5":14831,"_28346":59459,"_3068":60153},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3612":2986,"_31165":2707,"_21586":60155,"_5":14831,"_28346":59459,"_3068":60156},[],"`username`, `password`",{"_3612":2987,"_31165":2707,"_21586":60158,"_5":14831,"_28346":59459,"_3068":60159},[],"Always",{"_3612":2988,"_31165":2707,"_21586":60161,"_5":14831,"_28346":59459,"_3068":60162},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3612":2989,"_31165":2707,"_21586":60164,"_5":14831,"_28346":59459,"_3068":60156},[],{"_3612":2990,"_31165":2707,"_21586":60166,"_5":14831,"_28346":59459,"_3068":60159},[],{"_3612":2991,"_31165":2707,"_21586":60168,"_5":14831,"_28346":59459,"_3068":60169},[],"`services.alerts.smtp_server.existingSecret`",{"_3612":2992,"_31165":2707,"_21586":60171,"_5":14831,"_28346":59459,"_3068":60156},[],{"_3612":2993,"_31165":2707,"_21586":60173,"_5":14831,"_28346":59459,"_3068":60174},[],"Only when SMTP authentication is enabled",{"_3612":2994,"_31165":2707,"_21586":60176,"_5":14831,"_28346":59459,"_3068":60177},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3612":2995,"_31165":2707,"_21586":60179,"_5":14831,"_28346":59459,"_3068":60180},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3612":2996,"_31165":2707,"_21586":60182,"_5":14831,"_28346":59459,"_3068":60183},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3612":2997,"_31165":2707,"_21586":60185,"_5":14831,"_28346":59459,"_3068":60186},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3612":2998,"_31165":2707,"_21586":60188,"_5":14831,"_28346":59459,"_3068":60189},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3612":2999,"_31165":2707,"_21586":60191,"_5":14831,"_28346":59459,"_3068":60192},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3612":3000,"_31165":2707,"_21586":60194,"_5":14831,"_28346":59459,"_3068":60195},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3612":3001,"_31165":2707,"_21586":60197,"_5":14831,"_28346":59459,"_3068":60198},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3612":3002,"_31165":2707,"_21586":60200,"_5":14831,"_28346":59459,"_3068":60201},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3612":3003,"_31165":2707,"_21586":60203,"_5":14831,"_28346":59459,"_3068":60204},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3612":3004,"_31165":2707,"_21586":60206,"_5":14831,"_28346":59459,"_3068":60207},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3612":3005,"_31165":2707,"_21586":60209,"_5":14831,"_28346":59459,"_3068":60210},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3612":3006,"_31165":2707,"_21586":60212,"_5":14831,"_28346":59459,"_3068":60213},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3612":3007,"_31165":2707,"_21586":60215,"_5":14831,"_28346":59459,"_3068":60216},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3612":3008,"_31165":2707,"_21586":60218,"_5":14831,"_28346":59459,"_3068":60219},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3612":3009,"_31165":2707,"_21586":60221,"_5":14831,"_28346":59463,"_3068":60222},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3612":3010,"_31165":2707,"_21586":60224,"_5":14831,"_28346":59463,"_3068":60225},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3612":3011,"_31165":2707,"_21586":60227,"_5":14831,"_28346":59467,"_3068":60228},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3612":3012,"_31165":2707,"_21586":60230,"_5":14831,"_28346":59467,"_3068":60231},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3612":3013,"_31165":2707,"_21586":60233,"_5":14831,"_28346":59467,"_3068":60234},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3612":3014,"_31165":2707,"_21586":60236,"_5":14831,"_28346":59467,"_3068":60237},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3612":3015,"_31165":2707,"_21586":60239,"_5":14831,"_28346":59467,"_3068":60240},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3612":3016,"_31165":2707,"_21586":60242,"_5":14831,"_28346":59467,"_3068":60243},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3612":3017,"_31165":2707,"_21586":60245,"_5":14831,"_28346":59467,"_3068":60246},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3612":3018,"_31165":2707,"_21586":60248,"_5":14831,"_28346":59467,"_3068":60249},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3612":3019,"_31165":2707,"_21586":60251,"_5":14831,"_28346":59467,"_3068":60252},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3612":3020,"_31165":2707,"_21586":60254,"_5":14831,"_28346":59467,"_3068":60255},[],"**Remove the helper and restore the recorded replica counts:**",{"_3612":3021,"_31165":2707,"_21586":60257,"_5":14831,"_28346":59467,"_3068":60258},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3612":3022,"_31165":2707,"_21586":60260,"_5":14831,"_28346":59471,"_3068":60261},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3612":3023,"_31165":2707,"_21586":60263,"_5":14831,"_28346":59471,"_3068":60264},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3612":3024,"_31165":2707,"_21586":60266,"_5":14831,"_28346":59475,"_3068":60267},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3612":3025,"_31165":2707,"_21586":60269,"_5":14831,"_28346":59475,"_3068":60270},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3612":3026,"_31165":2707,"_21586":60272,"_5":14831,"_28346":59475,"_3068":60273},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3612":3027,"_31165":2707,"_21586":60275,"_5":14831,"_28346":59475,"_3068":60276},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3612":3028,"_31165":2707,"_21586":60278,"_5":14831,"_28346":59475,"_3068":60279},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3612":3029,"_31165":2707,"_21586":60281,"_5":14831,"_28346":59475,"_3068":60282},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3612":3030,"_31165":2707,"_21586":60284,"_5":14831,"_28346":59475,"_3068":60285},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3612":3031,"_31165":2707,"_21586":60287,"_5":14831,"_28346":59475,"_3068":60288},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3612":3032,"_31165":2707,"_21586":60290,"_5":14831,"_28346":59479,"_3068":60291},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3612":3033,"_31165":2707,"_21586":60293,"_5":14831,"_28346":59479,"_3068":60294},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3612":3034,"_31165":2707,"_21586":60296,"_5":14831,"_28346":59479,"_3068":60297},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3612":3035,"_31165":2707,"_21586":60299,"_5":14831,"_28346":59479,"_3068":60300},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3612":3036,"_31165":2707,"_21586":60302,"_5":14831,"_28346":59479,"_3068":60303},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3612":3037,"_31165":2707,"_21586":60305,"_5":14831,"_28346":59479,"_3068":60306},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3612":3038,"_31165":2707,"_21586":60308,"_5":14831,"_28346":59479,"_3068":60309},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3612":3039,"_31165":2707,"_21586":60311,"_5":14831,"_28346":59479,"_3068":60312},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3612":3040,"_31165":2707,"_21586":60314,"_5":14831,"_28346":59479,"_3068":60315},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3612":3041,"_31165":2707,"_21586":60317,"_5":14831,"_28346":59479,"_3068":60318},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3612":3042,"_31165":2707,"_21586":60320,"_5":14831,"_28346":59479,"_3068":60321},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3612":3043,"_31165":2707,"_21586":60323,"_5":14831,"_28346":59482,"_3068":60324},[],"After the upgrade, check in this order:",{"_3612":3044,"_31165":2707,"_21586":60326,"_5":14831,"_28346":59482,"_3068":60327},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3612":3045,"_31165":2707,"_21586":60329,"_5":14831,"_28346":59482,"_3068":60330},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3612":3046,"_31165":2707,"_21586":60332,"_5":14831,"_28346":59482,"_3068":60333},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3612":3047,"_31165":2707,"_21586":60335,"_5":14831,"_28346":59482,"_3068":60336},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3612":3048,"_31165":2707,"_21586":60338,"_5":14831,"_28346":59482,"_3068":60339},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3612":3049,"_31165":2707,"_21586":60341,"_5":14831,"_28346":59482,"_3068":60342},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3612":3050,"_31165":2707,"_21586":60344,"_5":14831,"_28346":59482,"_3068":60345},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3612":3051,"_31165":2707,"_21586":60347,"_5":14831,"_28346":59482,"_3068":60348},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3612":3052,"_31165":2707,"_21586":60350,"_5":14831,"_28346":59482,"_3068":60351},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3612":3053,"_31165":2707,"_21586":60353,"_5":14831,"_28346":59482,"_3068":60354},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3612":3054,"_31165":2707,"_21586":60356,"_5":14831,"_28346":59482,"_3068":60357},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3612":3055,"_31165":2707,"_21586":60359,"_5":14831,"_28346":59482,"_3068":60360},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3612":3056,"_31165":2707,"_21586":60362,"_5":14831,"_28346":59482,"_3068":60363},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3612":3057,"_31165":2707,"_21586":60365,"_5":14831,"_28346":59482,"_3068":60366},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3612":3058,"_31165":2707,"_21586":60368,"_5":14831,"_28346":59482,"_3068":60369},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3612":3059,"_31165":2707,"_21586":60371,"_5":14831,"_28346":59486,"_3068":60372},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3612":3060,"_31165":2707,"_21586":60374,"_5":14831,"_28346":59486,"_3068":60375},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3612":3061,"_31165":2707,"_21586":60377,"_5":14831,"_28346":59486,"_3068":60378},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3612":3062,"_31165":2707,"_21586":60380,"_5":14831,"_28346":59486,"_3068":60381},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3612":3063,"_31165":2707,"_21586":60383,"_5":14831,"_28346":59486,"_3068":60384},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60387":60388,"_60389":60390,"_60391":60392,"_60393":60394,"_18712":3103,"_72604":3103},"language","english","sortableProperties",[3068,31165,5,28346],"sortablePropertiesWithTypes",{"_3068":25766,"_31165":25766,"_5":25766,"_28346":25766},"sorts",{"_3068":60395,"_31165":63448,"_5":66500,"_28346":69552},{"_4812":60396,"_60397":60398,"_5":25766},{"_14912":3376,"_15291":6048,"_15310":9404,"_30164":7879,"_15297":11671,"_20493":6829,"_14933":7470,"_14940":7469,"_30106":6948,"_30520":24586,"_30541":10811,"_30140":6167,"_35570":4340,"_30243":7793,"_30585":5108,"_35577":30756,"_35580":6876,"_35583":14909,"_35586":4143,"_30987":5878,"_35591":7852,"_35593":7204,"_31022":13472,"_15306":4307,"_35597":3459,"_35600":3324,"_35602":6420,"_30569":3870,"_31007":6043,"_31035":5166,"_35607":6226,"_35609":7885,"_35611":4158,"_30260":3168,"_35614":4900,"_35616":7840,"_35618":10193,"_35620":3793,"_35622":10603,"_30177":7126,"_35625":14484,"_35627":3468,"_30171":9117,"_30606":7463,"_35631":4363,"_35633":7750,"_35636":4569,"_30217":4153,"_35640":5161,"_30097":15370,"_35643":6058,"_30145":3912,"_35646":15552,"_35648":3475,"_35651":3282,"_15300":7754,"_35654":7284,"_35656":18343,"_35659":3486,"_35661":11697,"_35663":4939,"_35665":4938,"_35667":7256,"_20496":5359,"_35670":3138,"_35672":4364,"_30118":4085,"_30563":16076,"_35676":5630,"_35678":6252,"_35680":5495,"_31052":5358,"_35683":8852,"_35685":6157,"_35687":3237,"_31145":12705,"_30622":21497,"_35691":3327,"_35693":7861,"_30155":4571,"_35696":3539,"_35698":11237,"_35700":5124,"_31068":4139,"_30237":7580,"_29617":4949,"_35705":5709,"_35707":10166,"_35709":4947,"_30286":20757,"_35713":15199,"_30557":5123,"_35717":22361,"_35719":4472,"_35721":7912,"_35723":3159,"_35725":3394,"_35727":7578,"_30275":4353,"_30525":4889,"_35731":4258,"_35733":6569,"_35735":10793,"_35738":3523,"_35740":4483,"_35742":9