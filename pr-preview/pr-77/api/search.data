41532":129178,"_41534":129181,"_41536":129184,"_41538":129187,"_41540":129190,"_41542":129193,"_41544":129196,"_41546":129199,"_41548":129202,"_41550":129205,"_41552":129208,"_41554":129211,"_41556":129214,"_41558":129217,"_41560":129220,"_41562":129223,"_41565":129226,"_41567":129229,"_41569":129232,"_41571":129235,"_41573":129238,"_41575":129241,"_41577":129244,"_41579":129247,"_41581":129250,"_41583":129253,"_41585":129256,"_41587":129259,"_41589":129262,"_41591":129265,"_41594":129268,"_41596":129271,"_41598":129274,"_41600":129277,"_41602":129280,"_41604":129283,"_41606":129286,"_41608":129289,"_41610":129292,"_41612":129295,"_41614":129298,"_41616":129301,"_41618":129304,"_41620":129307,"_41622":129310,"_41624":129313,"_41626":129316,"_41628":129319,"_41630":129322,"_41632":129325,"_41634":129328,"_41636":129331,"_41638":129334,"_41640":129337,"_41642":129340,"_41644":129343,"_41646":129346,"_41648":129349,"_41650":129352,"_41652":129355,"_41654":129358,"_41656":129361,"_41659":129364,"_41661":129367,"_41663":129370},{"_3612":72611,"_31165":72611,"_5":15196,"_3068":120116,"_31523":120117,"_21586":120120,"_28346":72611},"Despliega desde AWS Marketplace",[50890,120118,120119],"Despliegue","Otros modelos",[],{"_3612":72612,"_31165":72611,"_21586":120122,"_5":14831,"_28346":72611,"_3068":120123},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3612":72613,"_31165":72611,"_5":31520,"_21586":120125,"_28346":120126,"_3068":120127},[],"/docs/pr-preview/pr-77/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3612":72614,"_31165":72611,"_5":31520,"_21586":120129,"_28346":120130,"_3068":120131},[],"/docs/pr-preview/pr-77/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3612":72615,"_31165":72611,"_5":31520,"_21586":120133,"_28346":120134,"_3068":120135},[],"/docs/pr-preview/pr-77/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3612":72616,"_31165":72611,"_5":31520,"_21586":120137,"_28346":120138,"_3068":120139},[],"/docs/pr-preview/pr-77/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3612":72617,"_31165":72611,"_5":31520,"_21586":120141,"_28346":120142,"_3068":120143},[],"/docs/pr-preview/pr-77/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3612":72618,"_31165":72611,"_5":31520,"_21586":120145,"_28346":120146,"_3068":120147},[],"/docs/pr-preview/pr-77/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3612":72619,"_31165":72611,"_5":31520,"_21586":120149,"_28346":120150,"_3068":120151},[],"/docs/pr-preview/pr-77/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3612":72620,"_31165":72611,"_21586":120153,"_5":14831,"_28346":72611,"_3068":120154},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3612":72621,"_31165":72611,"_21586":120156,"_5":14831,"_28346":120126,"_3068":120157},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3612":72622,"_31165":72611,"_21586":120159,"_5":14831,"_28346":120126,"_3068":120160},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3612":72623,"_31165":72611,"_21586":120162,"_5":14831,"_28346":120126,"_3068":120163},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3612":72624,"_31165":72611,"_21586":120165,"_5":14831,"_28346":120130,"_3068":120166},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3612":72625,"_31165":72611,"_21586":120168,"_5":14831,"_28346":120130,"_3068":120169},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3612":72626,"_31165":72611,"_21586":120171,"_5":14831,"_28346":120130,"_3068":120172},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3612":72627,"_31165":72611,"_21586":120174,"_5":14831,"_28346":120134,"_3068":120175},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3612":72628,"_31165":72611,"_21586":120177,"_5":14831,"_28346":120138,"_3068":120178},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3612":72629,"_31165":72611,"_21586":120180,"_5":14831,"_28346":120142,"_3068":120181},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3612":72630,"_31165":72611,"_21586":120183,"_5":14831,"_28346":120146,"_3068":120184},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3612":72631,"_31165":72611,"_21586":120186,"_5":14831,"_28346":120150,"_3068":120187},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3612":72632,"_31165":72632,"_5":15196,"_3068":120189,"_31523":120190,"_21586":120191,"_28346":72632},"Despliega Lamassu",[50890,120118],[],{"_3612":72633,"_31165":72632,"_21586":120193,"_5":14831,"_28346":72632,"_3068":120194},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3612":72634,"_31165":72632,"_5":31520,"_21586":120196,"_28346":120197,"_3068":120198},[],"/docs/pr-preview/pr-77/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3612":72635,"_31165":72632,"_5":31520,"_21586":120200,"_28346":120201,"_3068":120202},[],"/docs/pr-preview/pr-77/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3612":72636,"_31165":72632,"_5":31520,"_21586":120204,"_28346":120205,"_3068":120206},[],"/docs/pr-preview/pr-77/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3612":72637,"_31165":72632,"_21586":120208,"_5":14831,"_28346":72632,"_3068":120209},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3612":72638,"_31165":72632,"_21586":120211,"_5":14831,"_28346":120197,"_3068":120212},[],"Modelo",{"_3612":72639,"_31165":72632,"_21586":120214,"_5":14831,"_28346":120197,"_3068":120215},[],"Recomendado para",{"_3612":72640,"_31165":72632,"_21586":120217,"_5":14831,"_28346":120197,"_3068":120218},[],"Quién opera la infraestructura",{"_3612":72641,"_31165":72632,"_21586":120220,"_5":14831,"_28346":120197,"_3068":120221},[],"Punto de partida",{"_3612":72642,"_31165":72632,"_21586":120223,"_5":14831,"_28346":120197,"_3068":50997},[],{"_3612":72643,"_31165":72632,"_21586":120225,"_5":14831,"_28346":120197,"_3068":120226},[],"Producción, entornos regulados y despliegues personalizados",{"_3612":72644,"_31165":72632,"_21586":120228,"_5":14831,"_28346":120197,"_3068":120229},[],"Tu equipo",{"_3612":72645,"_31165":72632,"_21586":120231,"_5":14831,"_28346":120197,"_3068":120232},[],"Helm o Fastlane",{"_3612":72646,"_31165":72632,"_21586":120234,"_5":14831,"_28346":120197,"_3068":51009},[],{"_3612":72647,"_31165":72632,"_21586":120236,"_5":14831,"_28346":120197,"_3068":120237},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3612":72648,"_31165":72632,"_21586":120239,"_5":14831,"_28346":120197,"_3068":120229},[],{"_3612":72649,"_31165":72632,"_21586":120241,"_5":14831,"_28346":120197,"_3068":120242},[],"Imagen preconfigurada en EC2",{"_3612":72650,"_31165":72632,"_21586":120244,"_5":14831,"_28346":120197,"_3068":51020},[],{"_3612":72651,"_31165":72632,"_21586":120246,"_5":14831,"_28346":120197,"_3068":120247},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3612":72652,"_31165":72632,"_21586":120249,"_5":14831,"_28346":120197,"_3068":51026},[],{"_3612":72653,"_31165":72632,"_21586":120251,"_5":14831,"_28346":120197,"_3068":120252},[],"Suscripción gestionada",{"_3612":72654,"_31165":72632,"_21586":120254,"_5":14831,"_28346":120197,"_3068":120255},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3612":72655,"_31165":72632,"_21586":120257,"_5":14831,"_28346":120197,"_3068":120258},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3612":72656,"_31165":72632,"_21586":120260,"_5":14831,"_28346":120197,"_3068":120261},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3612":72657,"_31165":72632,"_21586":120263,"_5":14831,"_28346":120201,"_3068":120264},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3612":72658,"_31165":72632,"_21586":120266,"_5":14831,"_28346":120205,"_3068":120267},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3612":72659,"_31165":72659,"_5":15196,"_3068":120269,"_31523":120270,"_21586":120271,"_28346":72659},"Utiliza Lamassu como SaaS",[50890,120118,120119],[],{"_3612":72660,"_31165":72659,"_21586":120273,"_5":14831,"_28346":72659,"_3068":120274},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3612":72661,"_31165":72659,"_5":31520,"_21586":120276,"_28346":120277,"_3068":120278},[],"/docs/pr-preview/pr-77/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3612":72662,"_31165":72659,"_5":31520,"_21586":120280,"_28346":120281,"_3068":120282},[],"/docs/pr-preview/pr-77/es/deployment/saas#planes","Planes",{"_3612":72663,"_31165":72659,"_5":31520,"_21586":120284,"_28346":120285,"_3068":120286},[],"/docs/pr-preview/pr-77/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3612":72664,"_31165":72659,"_21586":120288,"_5":14831,"_28346":72659,"_3068":120289},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3612":72665,"_31165":72659,"_21586":120291,"_5":14831,"_28346":120277,"_3068":120292},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3612":72666,"_31165":72659,"_21586":120294,"_5":14831,"_28346":120277,"_3068":120295},[],"Copias de seguridad automáticas.",{"_3612":72667,"_31165":72659,"_21586":120297,"_5":14831,"_28346":120277,"_3068":120298},[],"Actualizaciones de versión.",{"_3612":72668,"_31165":72659,"_21586":120300,"_5":14831,"_28346":120277,"_3068":120301},[],"Soporte técnico y SLA según el plan contratado.",{"_3612":72669,"_31165":72659,"_21586":120303,"_5":14831,"_28346":120281,"_3068":51081},[],{"_3612":72670,"_31165":72659,"_21586":120305,"_5":14831,"_28346":120281,"_3068":120306},[],"Dispositivos",{"_3612":72671,"_31165":72659,"_21586":120308,"_5":14831,"_28346":120281,"_3068":120309},[],"Soporte",{"_3612":72672,"_31165":72659,"_21586":120311,"_5":14831,"_28346":120281,"_3068":51090},[],{"_3612":72673,"_31165":72659,"_21586":120313,"_5":14831,"_28346":120281,"_3068":51093},[],{"_3612":72674,"_31165":72659,"_21586":120315,"_5":14831,"_28346":120281,"_3068":120316},[],"Hasta 1.000",{"_3612":72675,"_31165":72659,"_21586":120318,"_5":14831,"_28346":120281,"_3068":51099},[],{"_3612":72676,"_31165":72659,"_21586":120320,"_5":14831,"_28346":120281,"_3068":120321},[],"99,5 %",{"_3612":72677,"_31165":72659,"_21586":120323,"_5":14831,"_28346":120281,"_3068":51105},[],{"_3612":72678,"_31165":72659,"_21586":120325,"_5":14831,"_28346":120281,"_3068":120326},[],"Hasta 10.000",{"_3612":72679,"_31165":72659,"_21586":120328,"_5":14831,"_28346":120281,"_3068":120329},[],"Email y chat",{"_3612":72680,"_31165":72659,"_21586":120331,"_5":14831,"_28346":120281,"_3068":120332},[],"99,9 %",{"_3612":72681,"_31165":72659,"_21586":120334,"_5":14831,"_28346":120281,"_3068":51117},[],{"_3612":72682,"_31165":72659,"_21586":120336,"_5":14831,"_28346":120281,"_3068":120337},[],"Ilimitados",{"_3612":72683,"_31165":72659,"_21586":120339,"_5":14831,"_28346":120281,"_3068":120340},[],"Dedicado",{"_3612":72684,"_31165":72659,"_21586":120342,"_5":14831,"_28346":120281,"_3068":120343},[],"99,99 %",{"_3612":72685,"_31165":72659,"_21586":120345,"_5":14831,"_28346":120285,"_3068":120346},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3612":72686,"_31165":72659,"_21586":120348,"_5":14831,"_28346":120285,"_3068":120349},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3612":72687,"_31165":72687,"_5":15196,"_3068":51134,"_31523":120351,"_21586":120353,"_28346":72687},[50890,120118,120352],"Kubernetes autogestionado",[],{"_3612":72688,"_31165":72687,"_21586":120355,"_5":14831,"_28346":72687,"_3068":120356},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3612":72689,"_31165":72687,"_5":31520,"_21586":120358,"_28346":120359,"_3068":120360},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3612":72690,"_31165":72687,"_5":31520,"_21586":120362,"_28346":120363,"_3068":120364},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3612":72691,"_31165":72687,"_5":31520,"_21586":120366,"_28346":120367,"_3068":120368},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3612":72692,"_31165":72687,"_5":31520,"_21586":120370,"_28346":120371,"_3068":120372},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3612":72693,"_31165":72687,"_5":31520,"_21586":120374,"_28346":120375,"_3068":120376},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3612":72694,"_31165":72687,"_5":31520,"_21586":120378,"_28346":120379,"_3068":120380},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3612":72695,"_31165":72687,"_5":31520,"_21586":120382,"_28346":120383,"_3068":120384},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3612":72696,"_31165":72687,"_5":31520,"_21586":120386,"_28346":120387,"_3068":120388},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3612":72697,"_31165":72687,"_5":31520,"_21586":120390,"_28346":120391,"_3068":120392},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3612":72698,"_31165":72687,"_5":31520,"_21586":120394,"_28346":120395,"_3068":120396},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3612":72699,"_31165":72687,"_5":31520,"_21586":120398,"_28346":120399,"_3068":120400},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3612":72700,"_31165":72687,"_21586":120402,"_5":14831,"_28346":120359,"_3068":120403},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3612":72701,"_31165":72687,"_21586":120405,"_5":14831,"_28346":120359,"_3068":120406},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3612":72702,"_31165":72687,"_21586":120408,"_5":14831,"_28346":120363,"_3068":120409},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3612":72703,"_31165":72687,"_21586":120411,"_5":14831,"_28346":120363,"_3068":120412},[],"Fastlane instala o configura",{"_3612":72704,"_31165":72687,"_21586":120414,"_5":14831,"_28346":120363,"_3068":120415},[],"Tú sigues proporcionando",{"_3612":72705,"_31165":72687,"_21586":120417,"_5":14831,"_28346":120363,"_3068":120418},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3612":72706,"_31165":72687,"_21586":120420,"_5":14831,"_28346":120363,"_3068":120421},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3612":72707,"_31165":72687,"_21586":120423,"_5":14831,"_28346":120363,"_3068":120424},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3612":72708,"_31165":72687,"_21586":120426,"_5":14831,"_28346":120363,"_3068":120427},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3612":72709,"_31165":72687,"_21586":120429,"_5":14831,"_28346":120363,"_3068":120430},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3612":72710,"_31165":72687,"_21586":120432,"_5":14831,"_28346":120363,"_3068":120433},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3612":72711,"_31165":72687,"_21586":120435,"_5":14831,"_28346":120363,"_3068":120436},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3612":72712,"_31165":72687,"_21586":120438,"_5":14831,"_28346":120363,"_3068":120439},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3612":72713,"_31165":72687,"_21586":120441,"_5":14831,"_28346":120363,"_3068":120442},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3612":72714,"_31165":72687,"_21586":120444,"_5":14831,"_28346":120367,"_3068":120445},[],"Necesitas:",{"_3612":72715,"_31165":72687,"_21586":120447,"_5":14831,"_28346":120367,"_3068":120448},[],"un clúster Kubernetes existente",{"_3612":72716,"_31165":72687,"_21586":120450,"_5":14831,"_28346":120367,"_3068":120451},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3612":72717,"_31165":72687,"_21586":120453,"_5":14831,"_28346":120367,"_3068":51236},[],{"_3612":72718,"_31165":72687,"_21586":120455,"_5":14831,"_28346":120367,"_3068":24392},[],{"_3612":72719,"_31165":72687,"_21586":120457,"_5":14831,"_28346":120367,"_3068":120458},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3612":72720,"_31165":72687,"_21586":120460,"_5":14831,"_28346":120367,"_3068":120461},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3612":72721,"_31165":72687,"_21586":120463,"_5":14831,"_28346":120367,"_3068":120464},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3612":72722,"_31165":72687,"_21586":120466,"_5":14831,"_28346":120367,"_3068":120467},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3612":72723,"_31165":72687,"_21586":120469,"_5":14831,"_28346":120367,"_3068":120470},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3612":72724,"_31165":72687,"_21586":120472,"_5":14831,"_28346":120371,"_3068":120473},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3612":72725,"_31165":72687,"_21586":120475,"_5":14831,"_28346":120371,"_3068":120476},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3612":72726,"_31165":72687,"_21586":120478,"_5":14831,"_28346":120375,"_3068":120479},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3612":72727,"_31165":72687,"_21586":120481,"_5":14831,"_28346":120375,"_3068":120482},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3612":72728,"_31165":72687,"_21586":120484,"_5":14831,"_28346":120375,"_3068":120485},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3612":72729,"_31165":72687,"_21586":120487,"_5":14831,"_28346":120375,"_3068":120488},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3612":72730,"_31165":72687,"_21586":120490,"_5":14831,"_28346":120379,"_3068":120491},[],"Opción",{"_3612":72731,"_31165":72687,"_21586":120493,"_5":14831,"_28346":120379,"_3068":120494},[],"Valor predeterminado",{"_3612":72732,"_31165":72687,"_21586":120496,"_5":14831,"_28346":120379,"_3068":120497},[],"Propósito",{"_3612":72733,"_31165":72687,"_21586":120499,"_5":14831,"_28346":120379,"_3068":51283},[],{"_3612":72734,"_31165":72687,"_21586":120501,"_5":14831,"_28346":120379,"_3068":51286},[],{"_3612":72735,"_31165":72687,"_21586":120503,"_5":14831,"_28346":120379,"_3068":120504},[],"Muestra la ayuda",{"_3612":72736,"_31165":72687,"_21586":120506,"_5":14831,"_28346":120379,"_3068":51292},[],{"_3612":72737,"_31165":72687,"_21586":120508,"_5":14831,"_28346":120379,"_3068":120509},[],"contexto actual",{"_3612":72738,"_31165":72687,"_21586":120511,"_5":14831,"_28346":120379,"_3068":120512},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3612":72739,"_31165":72687,"_21586":120514,"_5":14831,"_28346":120379,"_3068":51301},[],{"_3612":72740,"_31165":72687,"_21586":120516,"_5":14831,"_28346":120379,"_3068":6776},[],{"_3612":72741,"_31165":72687,"_21586":120518,"_5":14831,"_28346":120379,"_3068":120519},[],"Omite prompts y genera credenciales para las dependencias",{"_3612":72742,"_31165":72687,"_21586":120521,"_5":14831,"_28346":120379,"_3068":51309},[],{"_3612":72743,"_31165":72687,"_21586":120523,"_5":14831,"_28346":120379,"_3068":51312},[],{"_3612":72744,"_31165":72687,"_21586":120525,"_5":14831,"_28346":120379,"_3068":120526},[],"Namespace de la instalación",{"_3612":72745,"_31165":72687,"_21586":120528,"_5":14831,"_28346":120379,"_3068":51318},[],{"_3612":72746,"_31165":72687,"_21586":120530,"_5":14831,"_28346":120379,"_3068":51321},[],{"_3612":72747,"_31165":72687,"_21586":120532,"_5":14831,"_28346":120379,"_3068":120533},[],"Dominio usado por la UI, OIDC y el certificado",{"_3612":72748,"_31165":72687,"_21586":120535,"_5":14831,"_28346":120379,"_3068":51327},[],{"_3612":72749,"_31165":72687,"_21586":120537,"_5":14831,"_28346":120379,"_3068":15543},[],{"_3612":72750,"_31165":72687,"_21586":120539,"_5":14831,"_28346":120379,"_3068":120540},[],"Versión del chart de Lamassu",{"_3612":72751,"_31165":72687,"_21586":120542,"_5":14831,"_28346":120379,"_3068":51335},[],{"_3612":72752,"_31165":72687,"_21586":120544,"_5":14831,"_28346":120379,"_3068":51338},[],{"_3612":72753,"_31165":72687,"_21586":120546,"_5":14831,"_28346":120379,"_3068":120547},[],"Puerto del listener HTTPS",{"_3612":72754,"_31165":72687,"_21586":120549,"_5":14831,"_28346":120379,"_3068":51344},[],{"_3612":72755,"_31165":72687,"_21586":120551,"_5":14831,"_28346":120379,"_3068":51347},[],{"_3612":72756,"_31165":72687,"_21586":120553,"_5":14831,"_28346":120379,"_3068":120554},[],"Puerto del listener HTTP",{"_3612":72757,"_31165":72687,"_21586":120556,"_5":14831,"_28346":120379,"_3068":51353},[],{"_3612":72758,"_31165":72687,"_21586":120558,"_5":14831,"_28346":120379,"_3068":51286},[],{"_3612":72759,"_31165":72687,"_21586":120560,"_5":14831,"_28346":120379,"_3068":120561},[],"Certificado PEM para TLS downstream",{"_3612":72760,"_31165":72687,"_21586":120563,"_5":14831,"_28346":120379,"_3068":51361},[],{"_3612":72761,"_31165":72687,"_21586":120565,"_5":14831,"_28346":120379,"_3068":51286},[],{"_3612":72762,"_31165":72687,"_21586":120567,"_5":14831,"_28346":120379,"_3068":120568},[],"Clave privada PEM para TLS downstream",{"_3612":72763,"_31165":72687,"_21586":120570,"_5":14831,"_28346":120379,"_3068":51369},[],{"_3612":72764,"_31165":72687,"_21586":120572,"_5":14831,"_28346":120379,"_3068":120573},[],"chart del repositorio",{"_3612":72765,"_31165":72687,"_21586":120575,"_5":14831,"_28346":120379,"_3068":120576},[],"Usa un chart local de Lamassu sin empaquetar",{"_3612":72766,"_31165":72687,"_21586":120578,"_5":14831,"_28346":120379,"_3068":51378},[],{"_3612":72767,"_31165":72687,"_21586":120580,"_5":14831,"_28346":120379,"_3068":120581},[],"detección automática",{"_3612":72768,"_31165":72687,"_21586":120583,"_5":14831,"_28346":120379,"_3068":120584},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3612":72769,"_31165":72687,"_21586":120586,"_5":14831,"_28346":120379,"_3068":51386},[],{"_3612":72770,"_31165":72687,"_21586":120588,"_5":14831,"_28346":120379,"_3068":6776},[],{"_3612":72771,"_31165":72687,"_21586":120590,"_5":14831,"_28346":120379,"_3068":120591},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3612":72772,"_31165":72687,"_21586":120593,"_5":14831,"_28346":120379,"_3068":51394},[],{"_3612":72773,"_31165":72687,"_21586":120595,"_5":14831,"_28346":120379,"_3068":6776},[],{"_3612":72774,"_31165":72687,"_21586":120597,"_5":14831,"_28346":120379,"_3068":120598},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3612":72775,"_31165":72687,"_21586":120600,"_5":14831,"_28346":120379,"_3068":51402},[],{"_3612":72776,"_31165":72687,"_21586":120602,"_5":14831,"_28346":120379,"_3068":6776},[],{"_3612":72777,"_31165":72687,"_21586":120604,"_5":14831,"_28346":120379,"_3068":120605},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3612":72778,"_31165":72687,"_21586":120607,"_5":14831,"_28346":120379,"_3068":51410},[],{"_3612":72779,"_31165":72687,"_21586":120609,"_5":14831,"_28346":120379,"_3068":6776},[],{"_3612":72780,"_31165":72687,"_21586":120611,"_5":14831,"_28346":120379,"_3068":120612},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3612":72781,"_31165":72687,"_21586":120614,"_5":14831,"_28346":120379,"_3068":51418},[],{"_3612":72782,"_31165":72687,"_21586":120616,"_5":14831,"_28346":120379,"_3068":51421},[],{"_3612":72783,"_31165":72687,"_21586":120618,"_5":14831,"_28346":120379,"_3068":120619},[],"Usa otro chart local de SoftHSM",{"_3612":72784,"_31165":72687,"_21586":120621,"_5":14831,"_28346":120379,"_3068":120622},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3612":72785,"_31165":72687,"_21586":120624,"_5":14831,"_28346":120383,"_3068":120625},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3612":72786,"_31165":72687,"_21586":120627,"_5":14831,"_28346":120383,"_3068":120628},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3612":72787,"_31165":72687,"_21586":120630,"_5":14831,"_28346":120383,"_3068":120631},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3612":72788,"_31165":72687,"_21586":120633,"_5":14831,"_28346":120383,"_3068":120634},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3612":72789,"_31165":72687,"_21586":120636,"_5":14831,"_28346":120383,"_3068":120637},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3612":72790,"_31165":72687,"_21586":120639,"_5":14831,"_28346":120383,"_3068":120640},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3612":72791,"_31165":72687,"_21586":120642,"_5":14831,"_28346":120387,"_3068":51448},[],{"_3612":72792,"_31165":72687,"_21586":120644,"_5":14831,"_28346":120387,"_3068":120645},[],"valida las herramientas locales y el clúster seleccionado",{"_3612":72793,"_31165":72687,"_21586":120647,"_5":14831,"_28346":120387,"_3068":120648},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3612":72794,"_31165":72687,"_21586":120650,"_5":14831,"_28346":120387,"_3068":120651},[],"crea el namespace",{"_3612":72795,"_31165":72687,"_21586":120653,"_5":14831,"_28346":120387,"_3068":120654},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3612":72796,"_31165":72687,"_21586":120656,"_5":14831,"_28346":120387,"_3068":120657},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3612":72797,"_31165":72687,"_21586":120659,"_5":14831,"_28346":120387,"_3068":120660},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3612":72798,"_31165":72687,"_21586":120662,"_5":14831,"_28346":120387,"_3068":120663},[],"instala RabbitMQ",{"_3612":72799,"_31165":72687,"_21586":120665,"_5":14831,"_28346":120387,"_3068":120666},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3612":72800,"_31165":72687,"_21586":120668,"_5":14831,"_28346":120387,"_3068":120669},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3612":72801,"_31165":72687,"_21586":120671,"_5":14831,"_28346":120387,"_3068":120672},[],"carga datos de ejemplo opcionalmente",{"_3612":72802,"_31165":72687,"_21586":120674,"_5":14831,"_28346":120387,"_3068":120675},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3612":72803,"_31165":72687,"_21586":120677,"_5":14831,"_28346":120391,"_3068":120678},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3612":72804,"_31165":72687,"_21586":120680,"_5":14831,"_28346":120391,"_3068":120681},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3612":72805,"_31165":72687,"_21586":120683,"_5":14831,"_28346":120395,"_3068":120684},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3612":72806,"_31165":72687,"_21586":120686,"_5":14831,"_28346":120395,"_3068":120687},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3612":72807,"_31165":72687,"_21586":120689,"_5":14831,"_28346":120395,"_3068":120690},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3612":72808,"_31165":72687,"_21586":120692,"_5":14831,"_28346":120395,"_3068":120693},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3612":72809,"_31165":72687,"_21586":120695,"_5":14831,"_28346":120399,"_3068":120696},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3612":72810,"_31165":72810,"_5":15196,"_3068":120698,"_31523":120699,"_21586":120700,"_28346":72810},"Instala con Helm",[50890,120118,120352],[],{"_3612":72811,"_31165":72810,"_21586":120702,"_5":14831,"_28346":72810,"_3068":120703},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3612":72812,"_31165":72810,"_5":31520,"_21586":120705,"_28346":120706,"_3068":120707},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3612":72813,"_31165":72810,"_5":31520,"_21586":120709,"_28346":120710,"_3068":120368},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3612":72814,"_31165":72810,"_5":31520,"_21586":120712,"_28346":120713,"_3068":120714},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3612":72815,"_31165":72810,"_5":31520,"_21586":120716,"_28346":120717,"_3068":120718},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3612":72816,"_31165":72810,"_5":31520,"_21586":120720,"_28346":120721,"_3068":120722},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3612":72817,"_31165":72810,"_5":31520,"_21586":120724,"_28346":120725,"_3068":120726},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3612":72818,"_31165":72810,"_5":31520,"_21586":120728,"_28346":120729,"_3068":120730},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3612":72819,"_31165":72810,"_5":31520,"_21586":120732,"_28346":120733,"_3068":120734},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3612":72820,"_31165":72810,"_5":31520,"_21586":120736,"_28346":120737,"_3068":120738},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3612":72821,"_31165":72810,"_5":31520,"_21586":120740,"_28346":120741,"_3068":120742},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3612":72822,"_31165":72810,"_5":31520,"_21586":120744,"_28346":120745,"_3068":120746},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3612":72823,"_31165":72810,"_5":31520,"_21586":120748,"_28346":120749,"_3068":120750},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3612":72824,"_31165":72810,"_21586":120752,"_5":14831,"_28346":120706,"_3068":120753},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3612":72825,"_31165":72810,"_21586":120755,"_5":14831,"_28346":120710,"_3068":120756},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3612":72826,"_31165":72810,"_21586":120758,"_5":14831,"_28346":120710,"_3068":120759},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3612":72827,"_31165":72810,"_21586":120761,"_5":14831,"_28346":120710,"_3068":120762},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3612":72828,"_31165":72810,"_21586":120764,"_5":14831,"_28346":120710,"_3068":120765},[],"un broker RabbitMQ accesible y sus credenciales",{"_3612":72829,"_31165":72810,"_21586":120767,"_5":14831,"_28346":120710,"_3068":120768},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3612":72830,"_31165":72810,"_21586":120770,"_5":14831,"_28346":120710,"_3068":120771},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3612":72831,"_31165":72810,"_21586":120773,"_5":14831,"_28346":120710,"_3068":120774},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3612":72832,"_31165":72810,"_21586":120776,"_5":14831,"_28346":120710,"_3068":120777},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3612":72833,"_31165":72810,"_21586":120779,"_5":14831,"_28346":120710,"_3068":120780},[],"una StorageClass y un diseño de tráfico externo",{"_3612":72834,"_31165":72810,"_21586":120782,"_5":14831,"_28346":120710,"_3068":120783},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3612":72835,"_31165":72810,"_21586":120785,"_5":14831,"_28346":120710,"_3068":120786},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3612":72836,"_31165":72810,"_21586":120788,"_5":14831,"_28346":120710,"_3068":120789},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3612":72837,"_31165":72810,"_21586":120791,"_5":14831,"_28346":120713,"_3068":120792},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3612":72838,"_31165":72810,"_21586":120794,"_5":14831,"_28346":120713,"_3068":120795},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3612":72839,"_31165":72810,"_21586":120797,"_5":14831,"_28346":120713,"_3068":120798},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3612":72840,"_31165":72810,"_21586":120800,"_5":14831,"_28346":120717,"_3068":120801},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3612":72841,"_31165":72810,"_21586":120803,"_5":14831,"_28346":120717,"_3068":120804},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3612":72842,"_31165":72810,"_21586":120806,"_5":14831,"_28346":120717,"_3068":120807},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3612":72843,"_31165":72810,"_21586":120809,"_5":14831,"_28346":120717,"_3068":120810},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3612":72844,"_31165":72810,"_21586":120812,"_5":14831,"_28346":120721,"_3068":120813},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3612":72845,"_31165":72810,"_21586":120815,"_5":14831,"_28346":120721,"_3068":120816},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3612":72846,"_31165":72810,"_21586":120818,"_5":14831,"_28346":120721,"_3068":120819},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3612":72847,"_31165":72810,"_21586":120821,"_5":14831,"_28346":120721,"_3068":120822},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3612":72848,"_31165":72810,"_21586":120824,"_5":14831,"_28346":120721,"_3068":120825},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3612":72849,"_31165":72810,"_21586":120827,"_5":14831,"_28346":120721,"_3068":120828},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3612":72850,"_31165":72810,"_21586":120830,"_5":14831,"_28346":120721,"_3068":120831},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3612":72851,"_31165":72810,"_21586":120833,"_5":14831,"_28346":120721,"_3068":120834},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3612":72852,"_31165":72810,"_21586":120836,"_5":14831,"_28346":120725,"_3068":120837},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3612":72853,"_31165":72810,"_21586":120839,"_5":14831,"_28346":120729,"_3068":120840},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3612":72854,"_31165":72810,"_21586":120842,"_5":14831,"_28346":120729,"_3068":120843},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3612":72855,"_31165":72810,"_21586":120845,"_5":14831,"_28346":120729,"_3068":120846},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3612":72856,"_31165":72810,"_21586":120848,"_5":14831,"_28346":120729,"_3068":120849},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3612":72857,"_31165":72810,"_21586":120851,"_5":14831,"_28346":120729,"_3068":120852},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3612":72858,"_31165":72810,"_21586":120854,"_5":14831,"_28346":120729,"_3068":120855},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3612":72859,"_31165":72810,"_21586":120857,"_5":14831,"_28346":120729,"_3068":120858},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3612":72860,"_31165":72810,"_21586":120860,"_5":14831,"_28346":120733,"_3068":120861},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3612":72861,"_31165":72810,"_21586":120863,"_5":14831,"_28346":120733,"_3068":120864},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3612":72862,"_31165":72810,"_21586":120866,"_5":14831,"_28346":120733,"_3068":120867},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3612":72863,"_31165":72810,"_21586":120869,"_5":14831,"_28346":120733,"_3068":120870},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3612":72864,"_31165":72810,"_21586":120872,"_5":14831,"_28346":120737,"_3068":120873},[],"Para instalar un checkout local:",{"_3612":72865,"_31165":72810,"_21586":120875,"_5":14831,"_28346":120741,"_3068":120876},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3612":72866,"_31165":72810,"_21586":120878,"_5":14831,"_28346":120741,"_3068":120879},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3612":72867,"_31165":72810,"_21586":120881,"_5":14831,"_28346":120745,"_3068":120882},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3612":72868,"_31165":72810,"_21586":120884,"_5":14831,"_28346":120745,"_3068":120885},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3612":72869,"_31165":72810,"_21586":120887,"_5":14831,"_28346":120745,"_3068":120888},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3612":72870,"_31165":72810,"_21586":120890,"_5":14831,"_28346":120745,"_3068":120891},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3612":72871,"_31165":72810,"_21586":120893,"_5":14831,"_28346":120745,"_3068":120894},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3612":72872,"_31165":72810,"_21586":120896,"_5":14831,"_28346":120749,"_3068":120897},[],"Antes de pasar a producción, revisa:",{"_3612":72873,"_31165":72810,"_21586":120899,"_5":14831,"_28346":120749,"_3068":120900},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3612":72874,"_31165":72810,"_21586":120902,"_5":14831,"_28346":120749,"_3068":120903},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3612":72875,"_31165":72810,"_21586":120905,"_5":14831,"_28346":120749,"_3068":120906},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3612":72876,"_31165":72810,"_21586":120908,"_5":14831,"_28346":120749,"_3068":120909},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3612":72877,"_31165":72810,"_21586":120911,"_5":14831,"_28346":120749,"_3068":120912},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3612":72878,"_31165":72810,"_21586":120914,"_5":14831,"_28346":120749,"_3068":120915},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3612":72879,"_31165":72810,"_21586":120917,"_5":14831,"_28346":120749,"_3068":120918},[],"SMTP, observabilidad y entrega de alertas",{"_3612":72880,"_31165":72810,"_21586":120920,"_5":14831,"_28346":120749,"_3068":120921},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3612":72881,"_31165":72810,"_21586":120923,"_5":14831,"_28346":120749,"_3068":120924},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3612":72882,"_31165":72882,"_5":15196,"_3068":120926,"_31523":120927,"_21586":120928,"_28346":72882},"Expón el Gateway",[50890,120118,120352],[],{"_3612":72883,"_31165":72882,"_21586":120930,"_5":14831,"_28346":72882,"_3068":120931},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3612":72884,"_31165":72882,"_5":31520,"_21586":120933,"_28346":120934,"_3068":120935},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3612":72885,"_31165":72882,"_5":31520,"_21586":120937,"_28346":120938,"_3068":120939},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3612":72886,"_31165":72882,"_5":31520,"_21586":120941,"_28346":120942,"_3068":120943},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3612":72887,"_31165":72882,"_5":31520,"_21586":120945,"_28346":120946,"_3068":51753},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/networking#k3s",{"_3612":72888,"_31165":72882,"_5":31520,"_21586":120948,"_28346":120949,"_3068":120950},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3612":72889,"_31165":72882,"_5":31520,"_21586":120952,"_28346":120953,"_3068":120954},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3612":72890,"_31165":72882,"_5":31520,"_21586":120956,"_28346":120957,"_3068":120958},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3612":72891,"_31165":72882,"_5":31520,"_21586":120960,"_28346":120961,"_3068":120962},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3612":72892,"_31165":72882,"_5":31520,"_21586":120964,"_28346":120965,"_3068":120966},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3612":72893,"_31165":72882,"_5":31520,"_21586":120968,"_28346":120969,"_3068":120970},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3612":72894,"_31165":72882,"_5":31520,"_21586":120972,"_28346":120973,"_3068":120974},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3612":72895,"_31165":72882,"_21586":120976,"_5":14831,"_28346":120934,"_3068":120977},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3612":72896,"_31165":72882,"_21586":120979,"_5":14831,"_28346":120934,"_3068":120980},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3612":72897,"_31165":72882,"_21586":120982,"_5":14831,"_28346":120938,"_3068":120983},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3612":72898,"_31165":72882,"_21586":120985,"_5":14831,"_28346":120938,"_3068":120986},[],"Defínelo únicamente cuando:",{"_3612":72899,"_31165":72882,"_21586":120988,"_5":14831,"_28346":120938,"_3068":120989},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3612":72900,"_31165":72882,"_21586":120991,"_5":14831,"_28346":120938,"_3068":120992},[],"esa dirección está asignada a este Gateway",{"_3612":72901,"_31165":72882,"_21586":120994,"_5":14831,"_28346":120938,"_3068":120995},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3612":72902,"_31165":72882,"_21586":120997,"_5":14831,"_28346":120938,"_3068":120998},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3612":72903,"_31165":72882,"_21586":121000,"_5":14831,"_28346":120938,"_3068":121001},[],"No confundas estos valores:",{"_3612":72904,"_31165":72882,"_21586":121003,"_5":14831,"_28346":120938,"_3068":121004},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3612":72905,"_31165":72882,"_21586":121006,"_5":14831,"_28346":120938,"_3068":121007},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3612":72906,"_31165":72882,"_21586":121009,"_5":14831,"_28346":120938,"_3068":121010},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3612":72907,"_31165":72882,"_21586":121012,"_5":14831,"_28346":120942,"_3068":121013},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3612":72908,"_31165":72882,"_21586":121015,"_5":14831,"_28346":120942,"_3068":121016},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3612":72909,"_31165":72882,"_21586":121018,"_5":14831,"_28346":120946,"_3068":121019},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3612":72910,"_31165":72882,"_21586":121021,"_5":14831,"_28346":120946,"_3068":121022},[],"Para el diseño recomendado:",{"_3612":72911,"_31165":72882,"_21586":121024,"_5":14831,"_28346":120946,"_3068":121025},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3612":72912,"_31165":72882,"_21586":121027,"_5":14831,"_28346":120946,"_3068":121028},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3612":72913,"_31165":72882,"_21586":121030,"_5":14831,"_28346":120946,"_3068":121031},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3612":72914,"_31165":72882,"_21586":121033,"_5":14831,"_28346":120946,"_3068":121034},[],"Apunta DNS a la dirección accesible de la VM.",{"_3612":72915,"_31165":72882,"_21586":121036,"_5":14831,"_28346":120946,"_3068":121037},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3612":72916,"_31165":72882,"_21586":121039,"_5":14831,"_28346":120949,"_3068":121040},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3612":72917,"_31165":72882,"_21586":121042,"_5":14831,"_28346":120953,"_3068":121043},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3612":72918,"_31165":72882,"_21586":121045,"_5":14831,"_28346":120953,"_3068":121046},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3612":72919,"_31165":72882,"_21586":121048,"_5":14831,"_28346":120957,"_3068":121049},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3612":72920,"_31165":72882,"_21586":121051,"_5":14831,"_28346":120957,"_3068":121052},[],"Requisito",{"_3612":72921,"_31165":72882,"_21586":121054,"_5":14831,"_28346":120957,"_3068":121055},[],"Diseño recomendado",{"_3612":72922,"_31165":72882,"_21586":121057,"_5":14831,"_28346":120957,"_3068":121058},[],"Consecuencia",{"_3612":72923,"_31165":72882,"_21586":121060,"_5":14831,"_28346":120957,"_3068":121061},[],"Varias URL o servicios de Lamassu",{"_3612":72924,"_31165":72882,"_21586":121063,"_5":14831,"_28346":120957,"_3068":121064},[],"Un Gateway con varias rutas",{"_3612":72925,"_31165":72882,"_21586":121066,"_5":14831,"_28346":120957,"_3068":121067},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3612":72926,"_31165":72882,"_21586":121069,"_5":14831,"_28346":120957,"_3068":121070},[],"Gateways independientes e IP externas distintas",{"_3612":72927,"_31165":72882,"_21586":121072,"_5":14831,"_28346":120957,"_3068":121073},[],"Una VIP por Gateway",{"_3612":72928,"_31165":72882,"_21586":121075,"_5":14831,"_28346":120957,"_3068":121076},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3612":72929,"_31165":72882,"_21586":121078,"_5":14831,"_28346":120957,"_3068":121079},[],"Gateways independientes, un nodo y una IP",{"_3612":72930,"_31165":72882,"_21586":121081,"_5":14831,"_28346":120957,"_3068":121082},[],"Puertos externos diferentes",{"_3612":72931,"_31165":72882,"_21586":121084,"_5":14831,"_28346":120957,"_3068":121085},[],"Los clientes deben indicar puertos no estándar",{"_3612":72932,"_31165":72882,"_21586":121087,"_5":14831,"_28346":120957,"_3068":121088},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3612":72933,"_31165":72882,"_21586":121090,"_5":14831,"_28346":120957,"_3068":121091},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3612":72934,"_31165":72882,"_21586":121093,"_5":14831,"_28346":120957,"_3068":121094},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3612":72935,"_31165":72882,"_21586":121096,"_5":14831,"_28346":120957,"_3068":121097},[],"Recursos Gateway separados pero proxy compartido",{"_3612":72936,"_31165":72882,"_21586":121099,"_5":14831,"_28346":120957,"_3068":121100},[],"Modo merged Gateway de Envoy",{"_3612":72937,"_31165":72882,"_21586":121102,"_5":14831,"_28346":120957,"_3068":121103},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3612":72938,"_31165":72882,"_21586":121105,"_5":14831,"_28346":120957,"_3068":121106},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3612":72939,"_31165":72882,"_21586":121108,"_5":14831,"_28346":120957,"_3068":121109},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3612":72940,"_31165":72882,"_21586":121111,"_5":14831,"_28346":120957,"_3068":121112},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3612":72941,"_31165":72882,"_21586":121114,"_5":14831,"_28346":120957,"_3068":121115},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3612":72942,"_31165":72882,"_21586":121117,"_5":14831,"_28346":120961,"_3068":121118},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3612":72943,"_31165":72882,"_21586":121120,"_5":14831,"_28346":120965,"_3068":121121},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3612":72944,"_31165":72882,"_21586":121123,"_5":14831,"_28346":120965,"_3068":121124},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3612":72945,"_31165":72882,"_21586":121126,"_5":14831,"_28346":120965,"_3068":121127},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3612":72946,"_31165":72882,"_21586":121129,"_5":14831,"_28346":120965,"_3068":121130},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3612":72947,"_31165":72882,"_21586":121132,"_5":14831,"_28346":120965,"_3068":121133},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3612":72948,"_31165":72882,"_21586":121135,"_5":14831,"_28346":120969,"_3068":121136},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3612":72949,"_31165":72882,"_21586":121138,"_5":14831,"_28346":120969,"_3068":121139},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3612":72950,"_31165":72882,"_21586":121141,"_5":14831,"_28346":120973,"_3068":121142},[],"Comprueba, en orden:",{"_3612":72951,"_31165":72882,"_21586":121144,"_5":14831,"_28346":120973,"_3068":121145},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3612":72952,"_31165":72882,"_21586":121147,"_5":14831,"_28346":120973,"_3068":121148},[],"Su estado contiene la dirección esperada.",{"_3612":72953,"_31165":72882,"_21586":121150,"_5":14831,"_28346":120973,"_3068":121151},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3612":72954,"_31165":72882,"_21586":121153,"_5":14831,"_28346":120973,"_3068":121154},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3612":72955,"_31165":72882,"_21586":121156,"_5":14831,"_28346":120973,"_3068":121157},[],"DNS resuelve al endpoint accesible externamente.",{"_3612":72956,"_31165":72882,"_21586":121159,"_5":14831,"_28346":120973,"_3068":121160},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3612":72957,"_31165":72882,"_21586":121162,"_5":14831,"_28346":120973,"_3068":121163},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3612":72958,"_31165":72958,"_5":15196,"_3068":50997,"_31523":121165,"_21586":121166,"_28346":72958},[50890,120118,120352],[],{"_3612":72959,"_31165":72958,"_21586":121168,"_5":14831,"_28346":72958,"_3068":121169},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3612":72960,"_31165":72958,"_5":31520,"_21586":121171,"_28346":121172,"_3068":121173},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3612":72961,"_31165":72958,"_5":31520,"_21586":121175,"_28346":121176,"_3068":121177},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3612":72962,"_31165":72958,"_5":31520,"_21586":121179,"_28346":121180,"_3068":121181},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3612":72963,"_31165":72958,"_5":31520,"_21586":121183,"_28346":121184,"_3068":121185},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3612":72964,"_31165":72958,"_5":31520,"_21586":121187,"_28346":121188,"_3068":121189},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3612":72965,"_31165":72958,"_5":31520,"_21586":121191,"_28346":121192,"_3068":121193},[],"/docs/pr-preview/pr-77/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3612":72966,"_31165":72958,"_21586":121195,"_5":14831,"_28346":121172,"_3068":121196},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3612":72967,"_31165":72958,"_21586":121198,"_5":14831,"_28346":121176,"_3068":121199},[],"Flujo",{"_3612":72968,"_31165":72958,"_21586":121201,"_5":14831,"_28346":121176,"_3068":121202},[],"Úsalo para",{"_3612":72969,"_31165":72958,"_21586":121204,"_5":14831,"_28346":121176,"_3068":121205},[],"Qué instala",{"_3612":72970,"_31165":72958,"_21586":121207,"_5":14831,"_28346":121176,"_3068":52015},[],{"_3612":72971,"_31165":72958,"_21586":121209,"_5":14831,"_28346":121176,"_3068":121210},[],"Producción y entornos controlados",{"_3612":72972,"_31165":72958,"_21586":121212,"_5":14831,"_28346":121176,"_3068":121213},[],"Servicios de Lamassu y recursos de Gateway API",{"_3612":72973,"_31165":72958,"_21586":121215,"_5":14831,"_28346":121176,"_3068":51134},[],{"_3612":72974,"_31165":72958,"_21586":121217,"_5":14831,"_28346":121176,"_3068":121218},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3612":72975,"_31165":72958,"_21586":121220,"_5":14831,"_28346":121176,"_3068":121221},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3612":72976,"_31165":72958,"_21586":121223,"_5":14831,"_28346":121180,"_3068":121224},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3612":72977,"_31165":72958,"_21586":121226,"_5":14831,"_28346":121180,"_3068":121227},[],"Área",{"_3612":72978,"_31165":72958,"_21586":121229,"_5":14831,"_28346":121180,"_3068":121230},[],"El chart de Lamassu proporciona",{"_3612":72979,"_31165":72958,"_21586":121232,"_5":14831,"_28346":121180,"_3068":121233},[],"Tú proporcionas",{"_3612":72980,"_31165":72958,"_21586":121235,"_5":14831,"_28346":121180,"_3068":121236},[],"Aplicaciones Lamassu",{"_3612":72981,"_31165":72958,"_21586":121238,"_5":14831,"_28346":121180,"_3068":121239},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3612":72982,"_31165":72958,"_21586":121241,"_5":14831,"_28346":121180,"_3068":121242},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3612":72983,"_31165":72958,"_21586":121244,"_5":14831,"_28346":121180,"_3068":121245},[],"Datos PostgreSQL",{"_3612":72984,"_31165":72958,"_21586":121247,"_5":14831,"_28346":121180,"_3068":121248},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3612":72985,"_31165":72958,"_21586":121250,"_5":14831,"_28346":121180,"_3068":121251},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3612":72986,"_31165":72958,"_21586":121253,"_5":14831,"_28346":121180,"_3068":121254},[],"Mensajería",{"_3612":72987,"_31165":72958,"_21586":121256,"_5":14831,"_28346":121180,"_3068":121257},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3612":72988,"_31165":72958,"_21586":121259,"_5":14831,"_28346":121180,"_3068":121260},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3612":72989,"_31165":72958,"_21586":121262,"_5":14831,"_28346":121180,"_3068":121263},[],"Identidad",{"_3612":72990,"_31165":72958,"_21586":121265,"_5":14831,"_28346":121180,"_3068":121266},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3612":72991,"_31165":72958,"_21586":121268,"_5":14831,"_28346":121180,"_3068":121269},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3612":72992,"_31165":72958,"_21586":121271,"_5":14831,"_28346":121180,"_3068":121272},[],"Enrutamiento externo",{"_3612":72993,"_31165":72958,"_21586":121274,"_5":14831,"_28346":121180,"_3068":121275},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3612":72994,"_31165":72958,"_21586":121277,"_5":14831,"_28346":121180,"_3068":121278},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3612":72995,"_31165":72958,"_21586":121280,"_5":14831,"_28346":121180,"_3068":52089},[],{"_3612":72996,"_31165":72958,"_21586":121282,"_5":14831,"_28346":121180,"_3068":121283},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3612":72997,"_31165":72958,"_21586":121285,"_5":14831,"_28346":121180,"_3068":121286},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3612":72998,"_31165":72958,"_21586":121288,"_5":14831,"_28346":121180,"_3068":121289},[],"Datos persistentes de la aplicación",{"_3612":72999,"_31165":72958,"_21586":121291,"_5":14831,"_28346":121180,"_3068":121292},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3612":73000,"_31165":72958,"_21586":121294,"_5":14831,"_28346":121180,"_3068":121295},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3612":73001,"_31165":72958,"_21586":121297,"_5":14831,"_28346":121180,"_3068":121298},[],"Integraciones opcionales",{"_3612":73002,"_31165":72958,"_21586":121300,"_5":14831,"_28346":121180,"_3068":121301},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3612":73003,"_31165":72958,"_21586":121303,"_5":14831,"_28346":121180,"_3068":121304},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3612":73004,"_31165":72958,"_21586":121306,"_5":14831,"_28346":121180,"_3068":121307},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3612":73005,"_31165":72958,"_21586":121309,"_5":14831,"_28346":121180,"_3068":121310},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3612":73006,"_31165":72958,"_21586":121312,"_5":14831,"_28346":121184,"_3068":121313},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3612":73007,"_31165":72958,"_21586":121315,"_5":14831,"_28346":121184,"_3068":121316},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3612":73008,"_31165":72958,"_21586":121318,"_5":14831,"_28346":121188,"_3068":121319},[],"Kubernetes 1.24 o posterior",{"_3612":73009,"_31165":72958,"_21586":121321,"_5":14831,"_28346":121188,"_3068":121322},[],"Helm 3.2 o posterior",{"_3612":73010,"_31165":72958,"_21586":121324,"_5":14831,"_28346":121188,"_3068":121325},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3612":73011,"_31165":72958,"_21586":121327,"_5":14831,"_28346":121188,"_3068":121328},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3612":73012,"_31165":72958,"_21586":121330,"_5":14831,"_28346":121188,"_3068":121331},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3612":73013,"_31165":72958,"_21586":121333,"_5":14831,"_28346":121188,"_3068":121334},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3612":73014,"_31165":72958,"_21586":121336,"_5":14831,"_28346":121188,"_3068":121337},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3612":73015,"_31165":72958,"_21586":121339,"_5":14831,"_28346":121192,"_3068":121340},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3612":73016,"_31165":72958,"_21586":121342,"_5":14831,"_28346":121192,"_3068":121343},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3612":73017,"_31165":72958,"_21586":121345,"_5":14831,"_28346":121192,"_3068":121346},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3612":73018,"_31165":72958,"_21586":121348,"_5":14831,"_28346":121192,"_3068":121349},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3612":73019,"_31165":73019,"_5":15196,"_3068":121351,"_31523":121352,"_21586":121354,"_28346":73019},"Resolución de problemas de despliegue",[50890,120118,121353],"Operación",[],{"_3612":73020,"_31165":73019,"_21586":121356,"_5":14831,"_28346":73019,"_3068":121357},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3612":73021,"_31165":73019,"_5":31520,"_21586":121359,"_28346":121360,"_3068":121361},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3612":73022,"_31165":73019,"_5":31520,"_21586":121363,"_28346":121364,"_3068":121365},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3612":73023,"_31165":73019,"_5":31520,"_21586":121367,"_28346":121368,"_3068":121369},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3612":73024,"_31165":73019,"_5":31520,"_21586":121371,"_28346":121372,"_3068":121373},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3612":73025,"_31165":73019,"_5":31520,"_21586":121375,"_28346":121376,"_3068":121377},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3612":73026,"_31165":73019,"_5":31520,"_21586":121379,"_28346":121380,"_3068":121381},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3612":73027,"_31165":73019,"_5":31520,"_21586":121383,"_28346":121384,"_3068":121385},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3612":73028,"_31165":73019,"_5":31520,"_21586":121387,"_28346":121388,"_3068":121389},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3612":73029,"_31165":73019,"_5":31520,"_21586":121391,"_28346":121392,"_3068":121393},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3612":73030,"_31165":73019,"_5":31520,"_21586":121395,"_28346":121396,"_3068":121397},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3612":73031,"_31165":73019,"_5":31520,"_21586":121399,"_28346":121400,"_3068":121401},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3612":73032,"_31165":73019,"_5":31520,"_21586":121403,"_28346":121404,"_3068":121405},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3612":73033,"_31165":73019,"_5":31520,"_21586":121407,"_28346":121408,"_3068":121409},[],"/docs/pr-preview/pr-77/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3612":73034,"_31165":73019,"_21586":121411,"_5":14831,"_28346":73019,"_3068":121412},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3612":73035,"_31165":73019,"_21586":121414,"_5":14831,"_28346":121364,"_3068":121415},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3612":73036,"_31165":73019,"_21586":121417,"_5":14831,"_28346":121368,"_3068":121418},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3612":73037,"_31165":73019,"_21586":121420,"_5":14831,"_28346":121372,"_3068":121421},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3612":73038,"_31165":73019,"_21586":121423,"_5":14831,"_28346":121376,"_3068":121424},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3612":73039,"_31165":73019,"_21586":121426,"_5":14831,"_28346":121380,"_3068":121427},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3612":73040,"_31165":73019,"_21586":121429,"_5":14831,"_28346":121384,"_3068":121430},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3612":73041,"_31165":73019,"_21586":121432,"_5":14831,"_28346":121384,"_3068":121433},[],"Ejecuta también la prueba de conectividad del chart:",{"_3612":73042,"_31165":73019,"_21586":121435,"_5":14831,"_28346":121384,"_3068":121436},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3612":73043,"_31165":73019,"_21586":121438,"_5":14831,"_28346":121384,"_3068":121439},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3612":73044,"_31165":73019,"_21586":121441,"_5":14831,"_28346":121388,"_3068":121442},[],"Si recibes un 401:",{"_3612":73045,"_31165":73019,"_21586":121444,"_5":14831,"_28346":121388,"_3068":121445},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3612":73046,"_31165":73019,"_21586":121447,"_5":14831,"_28346":121388,"_3068":121448},[],"verifica emisor, audiencia y expiración del token;",{"_3612":73047,"_31165":73019,"_21586":121450,"_5":14831,"_28346":121388,"_3068":121451},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3612":73048,"_31165":73019,"_21586":121453,"_5":14831,"_28346":121388,"_3068":121454},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3612":73049,"_31165":73019,"_21586":121456,"_5":14831,"_28346":121388,"_3068":121457},[],"Si el login termina pero las APIs devuelven 403:",{"_3612":73050,"_31165":73019,"_21586":121459,"_5":14831,"_28346":121388,"_3068":121460},[],"inspecciona los claims reales del token;",{"_3612":73051,"_31165":73019,"_21586":121462,"_5":14831,"_28346":121388,"_3068":121463},[],"confirma que coinciden con un principal activo;",{"_3612":73052,"_31165":73019,"_21586":121465,"_5":14831,"_28346":121388,"_3068":121466},[],"revisa las políticas concedidas al principal;",{"_3612":73053,"_31165":73019,"_21586":121468,"_5":14831,"_28346":121388,"_3068":121469},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3612":73054,"_31165":73019,"_21586":121471,"_5":14831,"_28346":121388,"_3068":121472},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3612":73055,"_31165":73019,"_21586":121474,"_5":14831,"_28346":121392,"_3068":121475},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3612":73056,"_31165":73019,"_21586":121477,"_5":14831,"_28346":121392,"_3068":121478},[],"Localiza el pod y Service de authz.",{"_3612":73057,"_31165":73019,"_21586":121480,"_5":14831,"_28346":121392,"_3068":121481},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3612":73058,"_31165":73019,"_21586":121483,"_5":14831,"_28346":121392,"_3068":121484},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3612":73059,"_31165":73019,"_21586":121486,"_5":14831,"_28346":121392,"_3068":121487},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3612":73060,"_31165":73019,"_21586":121489,"_5":14831,"_28346":121392,"_3068":121490},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3612":73061,"_31165":73019,"_21586":121492,"_5":14831,"_28346":121396,"_3068":121493},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3612":73062,"_31165":73019,"_21586":121495,"_5":14831,"_28346":121400,"_3068":121496},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3612":73063,"_31165":73019,"_21586":121498,"_5":14831,"_28346":121400,"_3068":121499},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3612":73064,"_31165":73019,"_21586":121501,"_5":14831,"_28346":121400,"_3068":121502},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3612":73065,"_31165":73019,"_21586":121504,"_5":14831,"_28346":121400,"_3068":121505},[],"volumen persistente sin enlazar;",{"_3612":73066,"_31165":73019,"_21586":121507,"_5":14831,"_28346":121400,"_3068":121508},[],"imagen inaccesible o política de pull incorrecta;",{"_3612":73067,"_31165":73019,"_21586":121510,"_5":14831,"_28346":121400,"_3068":121511},[],"configuración inválida del motor criptográfico;",{"_3612":73068,"_31165":73019,"_21586":121513,"_5":14831,"_28346":121400,"_3068":121514},[],"límites de CPU o memoria demasiado bajos;",{"_3612":73069,"_31165":73019,"_21586":121516,"_5":14831,"_28346":121400,"_3068":121517},[],"migración previa incompleta.",{"_3612":73070,"_31165":73019,"_21586":121519,"_5":14831,"_28346":121400,"_3068":121520},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3612":73071,"_31165":73019,"_21586":121522,"_5":14831,"_28346":121400,"_3068":121523},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3612":73072,"_31165":73019,"_21586":121525,"_5":14831,"_28346":121400,"_3068":121526},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3612":73073,"_31165":73019,"_21586":121528,"_5":14831,"_28346":121404,"_3068":121529},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3612":73074,"_31165":73019,"_21586":121531,"_5":14831,"_28346":121404,"_3068":121532},[],"verifica que esté habilitado en el servicio emisor;",{"_3612":73075,"_31165":73019,"_21586":121534,"_5":14831,"_28346":121404,"_3068":121535},[],"comprueba conectividad y credenciales AMQP;",{"_3612":73076,"_31165":73019,"_21586":121537,"_5":14831,"_28346":121404,"_3068":121538},[],"revisa exchange, routing key, colas y consumidores;",{"_3612":73077,"_31165":73019,"_21586":121540,"_5":14831,"_28346":121404,"_3068":121541},[],"inspecciona dead-letter queues;",{"_3612":73078,"_31165":73019,"_21586":121543,"_5":14831,"_28346":121404,"_3068":121544},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3612":73079,"_31165":73019,"_21586":121546,"_5":14831,"_28346":121404,"_3068":121547},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3612":73080,"_31165":73019,"_21586":121549,"_5":14831,"_28346":121404,"_3068":121550},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3612":73081,"_31165":73019,"_21586":121552,"_5":14831,"_28346":121404,"_3068":121553},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3612":73082,"_31165":73019,"_21586":121555,"_5":14831,"_28346":121404,"_3068":121556},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3612":73083,"_31165":73019,"_21586":121558,"_5":14831,"_28346":121404,"_3068":121559},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3612":73084,"_31165":73019,"_21586":121561,"_5":14831,"_28346":121404,"_3068":121562},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3612":73085,"_31165":73019,"_21586":121564,"_5":14831,"_28346":121404,"_3068":121565},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3612":73086,"_31165":73019,"_21586":121567,"_5":14831,"_28346":121408,"_3068":121568},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3612":73087,"_31165":73019,"_21586":121570,"_5":14831,"_28346":121408,"_3068":121571},[],"Antes de cerrar una incidencia, guarda:",{"_3612":73088,"_31165":73019,"_21586":121573,"_5":14831,"_28346":121408,"_3068":121574},[],"causa confirmada;",{"_3612":73089,"_31165":73019,"_21586":121576,"_5":14831,"_28346":121408,"_3068":121577},[],"alcance temporal y recursos afectados;",{"_3612":73090,"_31165":73019,"_21586":121579,"_5":14831,"_28346":121408,"_3068":121580},[],"comandos o consultas utilizados;",{"_3612":73091,"_31165":73019,"_21586":121582,"_5":14831,"_28346":121408,"_3068":121583},[],"cambio aplicado y forma de revertirlo;",{"_3612":73092,"_31165":73019,"_21586":121585,"_5":14831,"_28346":121408,"_3068":121586},[],"validación desde un consumidor;",{"_3612":73093,"_31165":73019,"_21586":121588,"_5":14831,"_28346":121408,"_3068":121589},[],"acción preventiva y propietario.",{"_3612":73094,"_31165":73094,"_5":15196,"_3068":121591,"_31523":121592,"_21586":121596,"_28346":73094},"Modelo de datos",[50890,121593,121594,121595],"Plataforma","Administración","Control de acceso",[],{"_3612":73095,"_31165":73094,"_21586":121598,"_5":14831,"_28346":73094,"_3068":121599},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3612":73096,"_31165":73094,"_5":31520,"_21586":121601,"_28346":121602,"_3068":121603},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3612":73097,"_31165":73094,"_5":31520,"_21586":121605,"_28346":121606,"_3068":121607},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3612":73098,"_31165":73094,"_21586":121609,"_5":14831,"_28346":73094,"_3068":121610},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3612":73099,"_31165":73094,"_21586":121612,"_5":14831,"_28346":121602,"_3068":121613},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3612":73100,"_31165":73094,"_21586":121615,"_5":14831,"_28346":121602,"_3068":121616},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3612":73101,"_31165":73094,"_21586":121618,"_5":14831,"_28346":121602,"_3068":121619},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3612":73102,"_31165":73094,"_21586":121621,"_5":14831,"_28346":121606,"_3068":121622},[],"Entidad (`schema_name.entity_type`)",{"_3612":73103,"_31165":73094,"_21586":121624,"_5":14831,"_28346":121606,"_3068":121625},[],"Tabla (`table_name`)",{"_3612":73104,"_31165":73094,"_21586":121627,"_5":14831,"_28346":121606,"_3068":121628},[],"Clave (`primary_key`)",{"_3612":73105,"_31165":73094,"_21586":121630,"_5":14831,"_28346":121606,"_3068":52440},[],{"_3612":73106,"_31165":73094,"_21586":121632,"_5":14831,"_28346":121606,"_3068":52443},[],{"_3612":73107,"_31165":73094,"_21586":121634,"_5":14831,"_28346":121606,"_3068":52446},[],{"_3612":73108,"_31165":73094,"_21586":121636,"_5":14831,"_28346":121606,"_3068":52449},[],{"_3612":73109,"_31165":73094,"_21586":121638,"_5":14831,"_28346":121606,"_3068":52452},[],{"_3612":73110,"_31165":73094,"_21586":121640,"_5":14831,"_28346":121606,"_3068":52455},[],{"_3612":73111,"_31165":73094,"_21586":121642,"_5":14831,"_28346":121606,"_3068":52458},[],{"_3612":73112,"_31165":73094,"_21586":121644,"_5":14831,"_28346":121606,"_3068":52461},[],{"_3612":73113,"_31165":73094,"_21586":121646,"_5":14831,"_28346":121606,"_3068":52455},[],{"_3612":73114,"_31165":73094,"_21586":121648,"_5":14831,"_28346":121606,"_3068":52466},[],{"_3612":73115,"_31165":73094,"_21586":121650,"_5":14831,"_28346":121606,"_3068":52469},[],{"_3612":73116,"_31165":73094,"_21586":121652,"_5":14831,"_28346":121606,"_3068":52472},[],{"_3612":73117,"_31165":73094,"_21586":121654,"_5":14831,"_28346":121606,"_3068":52475},[],{"_3612":73118,"_31165":73094,"_21586":121656,"_5":14831,"_28346":121606,"_3068":52478},[],{"_3612":73119,"_31165":73094,"_21586":121658,"_5":14831,"_28346":121606,"_3068":52455},[],{"_3612":73120,"_31165":73094,"_21586":121660,"_5":14831,"_28346":121606,"_3068":52483},[],{"_3612":73121,"_31165":73094,"_21586":121662,"_5":14831,"_28346":121606,"_3068":52486},[],{"_3612":73122,"_31165":73094,"_21586":121664,"_5":14831,"_28346":121606,"_3068":52455},[],{"_3612":73123,"_31165":73094,"_21586":121666,"_5":14831,"_28346":121606,"_3068":52491},[],{"_3612":73124,"_31165":73094,"_21586":121668,"_5":14831,"_28346":121606,"_3068":52494},[],{"_3612":73125,"_31165":73094,"_21586":121670,"_5":14831,"_28346":121606,"_3068":52455},[],{"_3612":73126,"_31165":73094,"_21586":121672,"_5":14831,"_28346":121606,"_3068":52499},[],{"_3612":73127,"_31165":73094,"_21586":121674,"_5":14831,"_28346":121606,"_3068":52502},[],{"_3612":73128,"_31165":73094,"_21586":121676,"_5":14831,"_28346":121606,"_3068":52455},[],{"_3612":73129,"_31165":73094,"_21586":121678,"_5":14831,"_28346":121606,"_3068":52507},[],{"_3612":73130,"_31165":73094,"_21586":121680,"_5":14831,"_28346":121606,"_3068":52510},[],{"_3612":73131,"_31165":73094,"_21586":121682,"_5":14831,"_28346":121606,"_3068":52513},[],{"_3612":73132,"_31165":73094,"_21586":121684,"_5":14831,"_28346":121606,"_3068":52516},[],{"_3612":73133,"_31165":73094,"_21586":121686,"_5":14831,"_28346":121606,"_3068":52519},[],{"_3612":73134,"_31165":73094,"_21586":121688,"_5":14831,"_28346":121606,"_3068":52522},[],{"_3612":73135,"_31165":73094,"_21586":121690,"_5":14831,"_28346":121606,"_3068":121691},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3612":73136,"_31165":73094,"_21586":121693,"_5":14831,"_28346":121606,"_3068":121694},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3612":73137,"_31165":73094,"_21586":121696,"_5":14831,"_28346":121606,"_3068":121697},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3612":73138,"_31165":73138,"_5":15196,"_3068":121699,"_31523":121700,"_21586":121701,"_28346":73138},"Visión general del control de acceso",[50890,121593,121594,121595],[],{"_3612":73139,"_31165":73138,"_21586":121703,"_5":14831,"_28346":73138,"_3068":121704},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3612":73140,"_31165":73138,"_5":31520,"_21586":121706,"_28346":121707,"_3068":121708},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3612":73141,"_31165":73138,"_5":31520,"_21586":121710,"_28346":121711,"_3068":121712},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3612":73142,"_31165":73138,"_5":31520,"_21586":121714,"_28346":121715,"_3068":121716},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3612":73143,"_31165":73138,"_5":31520,"_21586":121718,"_28346":121719,"_3068":121720},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3612":73144,"_31165":73138,"_5":31520,"_21586":121722,"_28346":121723,"_3068":121724},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3612":73145,"_31165":73138,"_5":31520,"_21586":121726,"_28346":121727,"_3068":121728},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3612":73146,"_31165":73138,"_5":31520,"_21586":121730,"_28346":121731,"_3068":121732},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3612":73147,"_31165":73138,"_5":31520,"_21586":121734,"_28346":121735,"_3068":121736},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3612":73148,"_31165":73138,"_5":31520,"_21586":121738,"_28346":121739,"_3068":121740},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3612":73149,"_31165":73138,"_5":31520,"_21586":121742,"_28346":121743,"_3068":121744},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3612":73150,"_31165":73138,"_5":31520,"_21586":121746,"_28346":121747,"_3068":121748},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3612":73151,"_31165":73138,"_5":31520,"_21586":121750,"_28346":121751,"_3068":121752},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3612":73152,"_31165":73138,"_5":31520,"_21586":121754,"_28346":121755,"_3068":121756},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3612":73153,"_31165":73138,"_5":31520,"_21586":121758,"_28346":121759,"_3068":121760},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3612":73154,"_31165":73138,"_5":31520,"_21586":121762,"_28346":121763,"_3068":121764},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3612":73155,"_31165":73138,"_5":31520,"_21586":121766,"_28346":121767,"_3068":120734},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3612":73156,"_31165":73138,"_5":31520,"_21586":121769,"_28346":121770,"_3068":121771},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3612":73157,"_31165":73138,"_5":31520,"_21586":121773,"_28346":121774,"_3068":121775},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3612":73158,"_31165":73138,"_5":31520,"_21586":121777,"_28346":121778,"_3068":121779},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3612":73159,"_31165":73138,"_5":31520,"_21586":121781,"_28346":121782,"_3068":121783},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3612":73160,"_31165":73138,"_5":31520,"_21586":121785,"_28346":121786,"_3068":121787},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3612":73161,"_31165":73138,"_5":31520,"_21586":121789,"_28346":121790,"_3068":121791},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3612":73162,"_31165":73138,"_5":31520,"_21586":121793,"_28346":121794,"_3068":121795},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3612":73163,"_31165":73138,"_5":31520,"_21586":121797,"_28346":121798,"_3068":121799},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3612":73164,"_31165":73138,"_5":31520,"_21586":121801,"_28346":121802,"_3068":121803},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3612":73165,"_31165":73138,"_5":31520,"_21586":121805,"_28346":121806,"_3068":121807},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3612":73166,"_31165":73138,"_5":31520,"_21586":121809,"_28346":121810,"_3068":121811},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3612":73167,"_31165":73138,"_5":31520,"_21586":121813,"_28346":121814,"_3068":121815},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3612":73168,"_31165":73138,"_5":31520,"_21586":121817,"_28346":121818,"_3068":121819},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3612":73169,"_31165":73138,"_5":31520,"_21586":121821,"_28346":121822,"_3068":121823},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3612":73170,"_31165":73138,"_5":31520,"_21586":121825,"_28346":121826,"_3068":121827},[],"/docs/pr-preview/pr-77/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3612":73171,"_31165":73138,"_21586":121829,"_5":14831,"_28346":73138,"_3068":121830},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3612":73172,"_31165":73138,"_21586":121832,"_5":14831,"_28346":73138,"_3068":121833},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3612":73173,"_31165":73138,"_21586":121835,"_5":14831,"_28346":73138,"_3068":121836},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3612":73174,"_31165":73138,"_21586":121838,"_5":14831,"_28346":121707,"_3068":121839},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3612":73175,"_31165":73138,"_21586":121841,"_5":14831,"_28346":121707,"_3068":121842},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3612":73176,"_31165":73138,"_21586":121844,"_5":14831,"_28346":121707,"_3068":121845},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3612":73177,"_31165":73138,"_21586":121847,"_5":14831,"_28346":121707,"_3068":121848},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3612":73178,"_31165":73138,"_21586":121850,"_5":14831,"_28346":121707,"_3068":121851},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3612":73179,"_31165":73138,"_21586":121853,"_5":14831,"_28346":121707,"_3068":121854},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3612":73180,"_31165":73138,"_21586":121856,"_5":14831,"_28346":121711,"_3068":121857},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3612":73181,"_31165":73138,"_21586":121859,"_5":14831,"_28346":121711,"_3068":121860},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3612":73182,"_31165":73138,"_21586":121862,"_5":14831,"_28346":121715,"_3068":121863},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3612":73183,"_31165":73138,"_21586":121865,"_5":14831,"_28346":121715,"_3068":121866},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3612":73184,"_31165":73138,"_21586":121868,"_5":14831,"_28346":121715,"_3068":121869},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3612":73185,"_31165":73138,"_21586":121871,"_5":14831,"_28346":121715,"_3068":121872},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3612":73186,"_31165":73138,"_21586":121874,"_5":14831,"_28346":121715,"_3068":121875},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3612":73187,"_31165":73138,"_21586":121877,"_5":14831,"_28346":121715,"_3068":121878},[],"Carga por separado las políticas concedidas a cada principal.",{"_3612":73188,"_31165":73138,"_21586":121880,"_5":14831,"_28346":121715,"_3068":121881},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3612":73189,"_31165":73138,"_21586":121883,"_5":14831,"_28346":121715,"_3068":121884},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3612":73190,"_31165":73138,"_21586":121886,"_5":14831,"_28346":121715,"_3068":121887},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3612":73191,"_31165":73138,"_21586":121889,"_5":14831,"_28346":121715,"_3068":121890},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3612":73192,"_31165":73138,"_21586":121892,"_5":14831,"_28346":121715,"_3068":121893},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3612":73193,"_31165":73138,"_21586":121895,"_5":14831,"_28346":121715,"_3068":121896},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3612":73194,"_31165":73138,"_21586":121898,"_5":14831,"_28346":121719,"_3068":121899},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3612":73195,"_31165":73138,"_21586":121901,"_5":14831,"_28346":121719,"_3068":121902},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3612":73196,"_31165":73138,"_21586":121904,"_5":14831,"_28346":121719,"_3068":121905},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3612":73197,"_31165":73138,"_21586":121907,"_5":14831,"_28346":121719,"_3068":121908},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3612":73198,"_31165":73138,"_21586":121910,"_5":14831,"_28346":121719,"_3068":121911},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3612":73199,"_31165":73138,"_21586":121913,"_5":14831,"_28346":121719,"_3068":121914},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3612":73200,"_31165":73138,"_21586":121916,"_5":14831,"_28346":121719,"_3068":121917},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3612":73201,"_31165":73138,"_21586":121919,"_5":14831,"_28346":121719,"_3068":121920},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3612":73202,"_31165":73138,"_21586":121922,"_5":14831,"_28346":121719,"_3068":121923},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3612":73203,"_31165":73138,"_21586":121925,"_5":14831,"_28346":121719,"_3068":121926},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3612":73204,"_31165":73138,"_21586":121928,"_5":14831,"_28346":121723,"_3068":121929},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3612":73205,"_31165":73138,"_21586":121931,"_5":14831,"_28346":121723,"_3068":121932},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3612":73206,"_31165":73138,"_21586":121934,"_5":14831,"_28346":121723,"_3068":121935},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3612":73207,"_31165":73138,"_21586":121937,"_5":14831,"_28346":121723,"_3068":121938},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3612":73208,"_31165":73138,"_21586":121940,"_5":14831,"_28346":121723,"_3068":121941},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3612":73209,"_31165":73138,"_21586":121943,"_5":14831,"_28346":121723,"_3068":121944},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3612":73210,"_31165":73138,"_21586":121946,"_5":14831,"_28346":121723,"_3068":121947},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3612":73211,"_31165":73138,"_21586":121949,"_5":14831,"_28346":121723,"_3068":121950},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3612":73212,"_31165":73138,"_21586":121952,"_5":14831,"_28346":121723,"_3068":121953},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3612":73213,"_31165":73138,"_21586":121955,"_5":14831,"_28346":121723,"_3068":121956},[],"Las acciones se dividen en dos grupos:",{"_3612":73214,"_31165":73138,"_21586":121958,"_5":14831,"_28346":121723,"_3068":121959},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3612":73215,"_31165":73138,"_21586":121961,"_5":14831,"_28346":121723,"_3068":121962},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3612":73216,"_31165":73138,"_21586":121964,"_5":14831,"_28346":121723,"_3068":121965},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3612":73217,"_31165":73138,"_21586":121967,"_5":14831,"_28346":121727,"_3068":121968},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3612":73218,"_31165":73138,"_21586":121970,"_5":14831,"_28346":121727,"_3068":121971},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3612":73219,"_31165":73138,"_21586":121973,"_5":14831,"_28346":121727,"_3068":121974},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3612":73220,"_31165":73138,"_21586":121976,"_5":14831,"_28346":121731,"_3068":121977},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3612":73221,"_31165":73138,"_21586":121979,"_5":14831,"_28346":121731,"_3068":121980},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3612":73222,"_31165":73138,"_21586":121982,"_5":14831,"_28346":121731,"_3068":121983},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3612":73223,"_31165":73138,"_21586":121985,"_5":14831,"_28346":121731,"_3068":121986},[],"Los operadores implementados son:",{"_3612":73224,"_31165":73138,"_21586":121988,"_5":14831,"_28346":121731,"_3068":121989},[],"`equals`, para igualdad exacta;",{"_3612":73225,"_31165":73138,"_21586":121991,"_5":14831,"_28346":121731,"_3068":121992},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3612":73226,"_31165":73138,"_21586":121994,"_5":14831,"_28346":121731,"_3068":121995},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3612":73227,"_31165":73138,"_21586":121997,"_5":14831,"_28346":121731,"_3068":121998},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3612":73228,"_31165":73138,"_21586":122000,"_5":14831,"_28346":121735,"_3068":122001},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3612":73229,"_31165":73138,"_21586":122003,"_5":14831,"_28346":121735,"_3068":122004},[],"Los modos disponibles son:",{"_3612":73230,"_31165":73138,"_21586":122006,"_5":14831,"_28346":121735,"_3068":122007},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3612":73231,"_31165":73138,"_21586":122009,"_5":14831,"_28346":121735,"_3068":122010},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3612":73232,"_31165":73138,"_21586":122012,"_5":14831,"_28346":121735,"_3068":122013},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3612":73233,"_31165":73138,"_21586":122015,"_5":14831,"_28346":121735,"_3068":122016},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3612":73234,"_31165":73138,"_21586":122018,"_5":14831,"_28346":121735,"_3068":122019},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3612":73235,"_31165":73138,"_21586":122021,"_5":14831,"_28346":121735,"_3068":122022},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3612":73236,"_31165":73138,"_21586":122024,"_5":14831,"_28346":121739,"_3068":122025},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3612":73237,"_31165":73138,"_21586":122027,"_5":14831,"_28346":121739,"_3068":122028},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3612":73238,"_31165":73138,"_21586":122030,"_5":14831,"_28346":121739,"_3068":122031},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3612":73239,"_31165":73138,"_21586":122033,"_5":14831,"_28346":121739,"_3068":122034},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3612":73240,"_31165":73138,"_21586":122036,"_5":14831,"_28346":121747,"_3068":122037},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3612":73241,"_31165":73138,"_21586":122039,"_5":14831,"_28346":121747,"_3068":122040},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3612":73242,"_31165":73138,"_21586":122042,"_5":14831,"_28346":121751,"_3068":122043},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3612":73243,"_31165":73138,"_21586":122045,"_5":14831,"_28346":121751,"_3068":122046},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3612":73244,"_31165":73138,"_21586":122048,"_5":14831,"_28346":121751,"_3068":122049},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3612":73245,"_31165":73138,"_21586":122051,"_5":14831,"_28346":121751,"_3068":122052},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3612":73246,"_31165":73138,"_21586":122054,"_5":14831,"_28346":121751,"_3068":122055},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3612":73247,"_31165":73138,"_21586":122057,"_5":14831,"_28346":121755,"_3068":122058},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3612":73248,"_31165":73138,"_21586":122060,"_5":14831,"_28346":121755,"_3068":122061},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3612":73249,"_31165":73138,"_21586":122063,"_5":14831,"_28346":121755,"_3068":122064},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3612":73250,"_31165":73138,"_21586":122066,"_5":14831,"_28346":121759,"_3068":122067},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3612":73251,"_31165":73138,"_21586":122069,"_5":14831,"_28346":121759,"_3068":122070},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3612":73252,"_31165":73138,"_21586":122072,"_5":14831,"_28346":121759,"_3068":122073},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3612":73253,"_31165":73138,"_21586":122075,"_5":14831,"_28346":121759,"_3068":122076},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3612":73254,"_31165":73138,"_21586":122078,"_5":14831,"_28346":121759,"_3068":122079},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3612":73255,"_31165":73138,"_21586":122081,"_5":14831,"_28346":121759,"_3068":122082},[],"Ten en cuenta que:",{"_3612":73256,"_31165":73138,"_21586":122084,"_5":14831,"_28346":121759,"_3068":122085},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3612":73257,"_31165":73138,"_21586":122087,"_5":14831,"_28346":121759,"_3068":122088},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3612":73258,"_31165":73138,"_21586":122090,"_5":14831,"_28346":121759,"_3068":122091},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3612":73259,"_31165":73138,"_21586":122093,"_5":14831,"_28346":121763,"_3068":122094},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3612":73260,"_31165":73138,"_21586":122096,"_5":14831,"_28346":121763,"_3068":122097},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3612":73261,"_31165":73138,"_21586":122099,"_5":14831,"_28346":121763,"_3068":122100},[],"acceso completo y de solo lectura a KMS;",{"_3612":73262,"_31165":73138,"_21586":122102,"_5":14831,"_28346":121763,"_3068":122103},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3612":73263,"_31165":73138,"_21586":122105,"_5":14831,"_28346":121763,"_3068":122106},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3612":73264,"_31165":73138,"_21586":122108,"_5":14831,"_28346":121763,"_3068":122109},[],"acceso a la interfaz;",{"_3612":73265,"_31165":73138,"_21586":122111,"_5":14831,"_28346":121763,"_3068":122112},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3612":73266,"_31165":73138,"_21586":122114,"_5":14831,"_28346":121763,"_3068":122115},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3612":73267,"_31165":73138,"_21586":122117,"_5":14831,"_28346":121763,"_3068":122118},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3612":73268,"_31165":73138,"_21586":122120,"_5":14831,"_28346":121763,"_3068":122121},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3612":73269,"_31165":73138,"_21586":122123,"_5":14831,"_28346":121763,"_3068":122124},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3612":73270,"_31165":73138,"_21586":122126,"_5":14831,"_28346":121767,"_3068":122127},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3612":73271,"_31165":73138,"_21586":122129,"_5":14831,"_28346":121767,"_3068":122130},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3612":73272,"_31165":73138,"_21586":122132,"_5":14831,"_28346":121767,"_3068":122133},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3612":73273,"_31165":73138,"_21586":122135,"_5":14831,"_28346":121770,"_3068":122136},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3612":73274,"_31165":73138,"_21586":122138,"_5":14831,"_28346":121774,"_3068":122139},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3612":73275,"_31165":73138,"_21586":122141,"_5":14831,"_28346":121774,"_3068":122142},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3612":73276,"_31165":73138,"_21586":122144,"_5":14831,"_28346":121778,"_3068":122145},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3612":73277,"_31165":73138,"_21586":122147,"_5":14831,"_28346":121782,"_3068":122148},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3612":73278,"_31165":73138,"_21586":122150,"_5":14831,"_28346":121786,"_3068":122151},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3612":73279,"_31165":73138,"_21586":122153,"_5":14831,"_28346":121790,"_3068":122154},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3612":73280,"_31165":73138,"_21586":122156,"_5":14831,"_28346":121790,"_3068":122157},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3612":73281,"_31165":73138,"_21586":122159,"_5":14831,"_28346":121794,"_3068":122160},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3612":73282,"_31165":73138,"_21586":122162,"_5":14831,"_28346":121794,"_3068":122163},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3612":73283,"_31165":73138,"_21586":122165,"_5":14831,"_28346":121794,"_3068":122166},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3612":73284,"_31165":73138,"_21586":122168,"_5":14831,"_28346":121794,"_3068":122169},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3612":73285,"_31165":73138,"_21586":122171,"_5":14831,"_28346":121794,"_3068":122172},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3612":73286,"_31165":73138,"_21586":122174,"_5":14831,"_28346":121794,"_3068":122175},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3612":73287,"_31165":73138,"_21586":122177,"_5":14831,"_28346":121794,"_3068":122178},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3612":73288,"_31165":73138,"_21586":122180,"_5":14831,"_28346":121794,"_3068":122181},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3612":73289,"_31165":73138,"_21586":122183,"_5":14831,"_28346":121798,"_3068":122184},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3612":73290,"_31165":73138,"_21586":122186,"_5":14831,"_28346":121798,"_3068":122187},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3612":73291,"_31165":73138,"_21586":122189,"_5":14831,"_28346":121798,"_3068":122190},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3612":73292,"_31165":73138,"_21586":122192,"_5":14831,"_28346":121802,"_3068":122193},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3612":73293,"_31165":73138,"_21586":122195,"_5":14831,"_28346":121802,"_3068":122196},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3612":73294,"_31165":73138,"_21586":122198,"_5":14831,"_28346":121802,"_3068":122199},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3612":73295,"_31165":73138,"_21586":122201,"_5":14831,"_28346":121802,"_3068":122202},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3612":73296,"_31165":73138,"_21586":122204,"_5":14831,"_28346":121802,"_3068":122205},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3612":73297,"_31165":73138,"_21586":122207,"_5":14831,"_28346":121802,"_3068":122208},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3612":73298,"_31165":73138,"_21586":122210,"_5":14831,"_28346":121802,"_3068":122211},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3612":73299,"_31165":73138,"_21586":122213,"_5":14831,"_28346":121802,"_3068":122214},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3612":73300,"_31165":73138,"_21586":122216,"_5":14831,"_28346":121810,"_3068":122217},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3612":73301,"_31165":73138,"_21586":122219,"_5":14831,"_28346":121814,"_3068":122220},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3612":73302,"_31165":73138,"_21586":122222,"_5":14831,"_28346":121814,"_3068":122223},[],"que exista un principal activo del tipo correcto;",{"_3612":73303,"_31165":73138,"_21586":122225,"_5":14831,"_28346":121814,"_3068":122226},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3612":73304,"_31165":73138,"_21586":122228,"_5":14831,"_28346":121814,"_3068":122229},[],"que todas las condiciones del principal se cumplan;",{"_3612":73305,"_31165":73138,"_21586":122231,"_5":14831,"_28346":121814,"_3068":122232},[],"que el principal tenga concedida la política esperada;",{"_3612":73306,"_31165":73138,"_21586":122234,"_5":14831,"_28346":121814,"_3068":122235},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3612":73307,"_31165":73138,"_21586":122237,"_5":14831,"_28346":121814,"_3068":122238},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3612":73308,"_31165":73138,"_21586":122240,"_5":14831,"_28346":121814,"_3068":122241},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3612":73309,"_31165":73138,"_21586":122243,"_5":14831,"_28346":121814,"_3068":122244},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3612":73310,"_31165":73138,"_21586":122246,"_5":14831,"_28346":121818,"_3068":122247},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3612":73311,"_31165":73138,"_21586":122249,"_5":14831,"_28346":121822,"_3068":122250},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3612":73312,"_31165":73138,"_21586":122252,"_5":14831,"_28346":121826,"_3068":122253},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3612":73313,"_31165":73138,"_21586":122255,"_5":14831,"_28346":121826,"_3068":122256},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3612":73314,"_31165":73314,"_5":15196,"_3068":122258,"_31523":122259,"_21586":122260,"_28346":73314},"Alertas y suscripciones",[50890,121593,121594],[],{"_3612":73315,"_31165":73314,"_21586":122262,"_5":14831,"_28346":73314,"_3068":122263},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3612":73316,"_31165":73314,"_5":31520,"_21586":122265,"_28346":122266,"_3068":122267},[],"/docs/pr-preview/pr-77/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3612":73317,"_31165":73314,"_5":31520,"_21586":122269,"_28346":122270,"_3068":122271},[],"/docs/pr-preview/pr-77/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3612":73318,"_31165":73314,"_5":31520,"_21586":122273,"_28346":122274,"_3068":122275},[],"/docs/pr-preview/pr-77/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3612":73319,"_31165":73314,"_5":31520,"_21586":122277,"_28346":122278,"_3068":122279},[],"/docs/pr-preview/pr-77/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3612":73320,"_31165":73314,"_5":31520,"_21586":122281,"_28346":122282,"_3068":122283},[],"/docs/pr-preview/pr-77/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3612":73321,"_31165":73314,"_5":31520,"_21586":122285,"_28346":122286,"_3068":122287},[],"/docs/pr-preview/pr-77/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3612":73322,"_31165":73314,"_5":31520,"_21586":122289,"_28346":122290,"_3068":122291},[],"/docs/pr-preview/pr-77/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3612":73323,"_31165":73314,"_5":31520,"_21586":122293,"_28346":122294,"_3068":122295},[],"/docs/pr-preview/pr-77/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3612":73324,"_31165":73314,"_5":31520,"_21586":122297,"_28346":122298,"_3068":122299},[],"/docs/pr-preview/pr-77/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3612":73325,"_31165":73314,"_5":31520,"_21586":122301,"_28346":122302,"_3068":122303},[],"/docs/pr-preview/pr-77/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3612":73326,"_31165":73314,"_5":31520,"_21586":122305,"_28346":122306,"_3068":122307},[],"/docs/pr-preview/pr-77/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3612":73327,"_31165":73314,"_21586":122309,"_5":14831,"_28346":73314,"_3068":122310},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3612":73328,"_31165":73314,"_21586":122312,"_5":14831,"_28346":122266,"_3068":122313},[],"Un servicio publica un evento de dominio.",{"_3612":73329,"_31165":73314,"_21586":122315,"_5":14831,"_28346":122266,"_3068":122316},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3612":73330,"_31165":73314,"_21586":122318,"_5":14831,"_28346":122266,"_3068":122319},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3612":73331,"_31165":73314,"_21586":122321,"_5":14831,"_28346":122266,"_3068":122322},[],"Lamassu entrega el evento al canal configurado.",{"_3612":73332,"_31165":73314,"_21586":122324,"_5":14831,"_28346":122266,"_3068":122325},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3612":73333,"_31165":73314,"_21586":122327,"_5":14831,"_28346":122270,"_3068":122328},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3612":73334,"_31165":73314,"_21586":122330,"_5":14831,"_28346":122270,"_3068":122331},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3612":73335,"_31165":73314,"_21586":122333,"_5":14831,"_28346":122270,"_3068":122334},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3612":73336,"_31165":73314,"_21586":122336,"_5":14831,"_28346":122270,"_3068":122337},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3612":73337,"_31165":73314,"_21586":122339,"_5":14831,"_28346":122270,"_3068":122340},[],"`apikey_options` necesita `header` y `key`.",{"_3612":73338,"_31165":73314,"_21586":122342,"_5":14831,"_28346":122270,"_3068":122343},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3612":73339,"_31165":73314,"_21586":122345,"_5":14831,"_28346":122270,"_3068":122346},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3612":73340,"_31165":73314,"_21586":122348,"_5":14831,"_28346":122270,"_3068":122349},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3612":73341,"_31165":73314,"_21586":122351,"_5":14831,"_28346":122278,"_3068":122352},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3612":73342,"_31165":73314,"_21586":122354,"_5":14831,"_28346":122282,"_3068":122355},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3612":73343,"_31165":73314,"_21586":122357,"_5":14831,"_28346":122286,"_3068":122358},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3612":73344,"_31165":73314,"_21586":122360,"_5":14831,"_28346":122286,"_3068":122361},[],"**None** notifica todas las instancias del evento.",{"_3612":73345,"_31165":73314,"_21586":122363,"_5":14831,"_28346":122286,"_3068":122364},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3612":73346,"_31165":73314,"_21586":122366,"_5":14831,"_28346":122286,"_3068":122367},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3612":73347,"_31165":73314,"_21586":122369,"_5":14831,"_28346":122286,"_3068":122370},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3612":73348,"_31165":73314,"_21586":122372,"_5":14831,"_28346":122286,"_3068":122373},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3612":73349,"_31165":73314,"_21586":122375,"_5":14831,"_28346":122286,"_3068":122376},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3612":73350,"_31165":73314,"_21586":122378,"_5":14831,"_28346":122290,"_3068":122379},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3612":73351,"_31165":73314,"_21586":122381,"_5":14831,"_28346":122294,"_3068":122382},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3612":73352,"_31165":73314,"_21586":122384,"_5":14831,"_28346":122294,"_3068":122385},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3612":73353,"_31165":73314,"_21586":122387,"_5":14831,"_28346":122294,"_3068":122388},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3612":73354,"_31165":73314,"_21586":122390,"_5":14831,"_28346":122294,"_3068":122391},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3612":73355,"_31165":73314,"_21586":122393,"_5":14831,"_28346":122294,"_3068":122394},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3612":73356,"_31165":73314,"_21586":122396,"_5":14831,"_28346":122294,"_3068":122397},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3612":73357,"_31165":73314,"_21586":122399,"_5":14831,"_28346":122294,"_3068":122400},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3612":73358,"_31165":73314,"_21586":122402,"_5":14831,"_28346":122294,"_3068":122403},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3612":73359,"_31165":73314,"_21586":122405,"_5":14831,"_28346":122298,"_3068":122406},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3612":73360,"_31165":73314,"_21586":122408,"_5":14831,"_28346":122298,"_3068":122409},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3612":73361,"_31165":73314,"_21586":122411,"_5":14831,"_28346":122298,"_3068":122412},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3612":73362,"_31165":73314,"_21586":122414,"_5":14831,"_28346":122298,"_3068":122415},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3612":73363,"_31165":73314,"_21586":122417,"_5":14831,"_28346":122298,"_3068":122418},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3612":73364,"_31165":73314,"_21586":122420,"_5":14831,"_28346":122298,"_3068":122421},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3612":73365,"_31165":73314,"_21586":122423,"_5":14831,"_28346":122298,"_3068":122424},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3612":73366,"_31165":73314,"_21586":122426,"_5":14831,"_28346":122298,"_3068":122427},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3612":73367,"_31165":73314,"_21586":122429,"_5":14831,"_28346":122302,"_3068":122430},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3612":73368,"_31165":73314,"_21586":122432,"_5":14831,"_28346":122302,"_3068":122433},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3612":73369,"_31165":73314,"_21586":122435,"_5":14831,"_28346":122306,"_3068":122436},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3612":73370,"_31165":73314,"_21586":122438,"_5":14831,"_28346":122306,"_3068":122439},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3612":73371,"_31165":73314,"_21586":122441,"_5":14831,"_28346":122306,"_3068":122442},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3612":73372,"_31165":73314,"_21586":122444,"_5":14831,"_28346":122306,"_3068":122445},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3612":73373,"_31165":73314,"_21586":122447,"_5":14831,"_28346":122306,"_3068":122448},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3612":73374,"_31165":73314,"_21586":122450,"_5":14831,"_28346":122306,"_3068":122451},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3612":73375,"_31165":73314,"_21586":122453,"_5":14831,"_28346":122306,"_3068":122454},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3612":73376,"_31165":73314,"_21586":122456,"_5":14831,"_28346":122306,"_3068":122457},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3612":73377,"_31165":73314,"_21586":122459,"_5":14831,"_28346":122306,"_3068":122460},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3612":73378,"_31165":73314,"_21586":122462,"_5":14831,"_28346":122306,"_3068":122463},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3612":73379,"_31165":73379,"_5":15196,"_3068":122465,"_31523":122466,"_21586":122467,"_28346":73379},"Registros de auditoría",[50890,121593,121594],[],{"_3612":73380,"_31165":73379,"_21586":122469,"_5":14831,"_28346":73379,"_3068":122470},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3612":73381,"_31165":73379,"_5":31520,"_21586":122472,"_28346":122473,"_3068":122474},[],"/docs/pr-preview/pr-77/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3612":73382,"_31165":73379,"_5":31520,"_21586":122476,"_28346":122477,"_3068":122478},[],"/docs/pr-preview/pr-77/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3612":73383,"_31165":73379,"_5":31520,"_21586":122480,"_28346":122481,"_3068":122482},[],"/docs/pr-preview/pr-77/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3612":73384,"_31165":73379,"_5":31520,"_21586":122484,"_28346":122485,"_3068":122486},[],"/docs/pr-preview/pr-77/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3612":73385,"_31165":73379,"_5":31520,"_21586":122488,"_28346":122489,"_3068":122490},[],"/docs/pr-preview/pr-77/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3612":73386,"_31165":73379,"_5":31520,"_21586":122492,"_28346":122493,"_3068":122494},[],"/docs/pr-preview/pr-77/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3612":73387,"_31165":73379,"_5":31520,"_21586":122496,"_28346":122497,"_3068":122498},[],"/docs/pr-preview/pr-77/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3612":73388,"_31165":73379,"_5":31520,"_21586":122500,"_28346":122501,"_3068":122502},[],"/docs/pr-preview/pr-77/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3612":73389,"_31165":73379,"_5":31520,"_21586":122504,"_28346":122505,"_3068":122506},[],"/docs/pr-preview/pr-77/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3612":73390,"_31165":73379,"_5":31520,"_21586":122508,"_28346":122509,"_3068":122510},[],"/docs/pr-preview/pr-77/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3612":73391,"_31165":73379,"_5":31520,"_21586":122512,"_28346":122513,"_3068":122514},[],"/docs/pr-preview/pr-77/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3612":73392,"_31165":73379,"_21586":122516,"_5":14831,"_28346":73379,"_3068":122517},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3612":73393,"_31165":73379,"_21586":122519,"_5":14831,"_28346":122473,"_3068":122520},[],"El cuerpo de auditoría incluye:",{"_3612":73394,"_31165":73379,"_21586":122522,"_5":14831,"_28346":122473,"_3068":122523},[],"input: datos recibidos por la operación;",{"_3612":73395,"_31165":73379,"_21586":122525,"_5":14831,"_28346":122473,"_3068":122526},[],"has\\_error: indica si el servicio devolvió un error;",{"_3612":73396,"_31165":73379,"_21586":122528,"_5":14831,"_28346":122473,"_3068":122529},[],"output: resultado producido o mensaje de error;",{"_3612":73397,"_31165":73379,"_21586":122531,"_5":14831,"_28346":122473,"_3068":122532},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3612":73398,"_31165":73379,"_21586":122534,"_5":14831,"_28346":122473,"_3068":122535},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3612":73399,"_31165":73379,"_21586":122537,"_5":14831,"_28346":122473,"_3068":122538},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3612":73400,"_31165":73379,"_21586":122540,"_5":14831,"_28346":122477,"_3068":122541},[],"El backend aplica auditoría a mutaciones de:",{"_3612":73401,"_31165":73379,"_21586":122543,"_5":14831,"_28346":122477,"_3068":122544},[],"autoridades, certificados y perfiles de emisión;",{"_3612":73402,"_31165":73379,"_21586":122546,"_5":14831,"_28346":122477,"_3068":122547},[],"claves y motores KMS;",{"_3612":73403,"_31165":73379,"_21586":122549,"_5":14831,"_28346":122477,"_3068":122550},[],"dispositivos e identidades;",{"_3612":73404,"_31165":73379,"_21586":122552,"_5":14831,"_28346":122477,"_3068":122553},[],"DMS y operaciones de enrolamiento;",{"_3612":73405,"_31165":73379,"_21586":122555,"_5":14831,"_28346":122477,"_3068":122556},[],"funciones de validación y CRL;",{"_3612":73406,"_31165":73379,"_21586":122558,"_5":14831,"_28346":122477,"_3068":122559},[],"principales, políticas y concesiones de autorización.",{"_3612":73407,"_31165":73379,"_21586":122561,"_5":14831,"_28346":122477,"_3068":122562},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3612":73408,"_31165":73379,"_21586":122564,"_5":14831,"_28346":122481,"_3068":122565},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3612":73409,"_31165":73379,"_21586":122567,"_5":14831,"_28346":122481,"_3068":122568},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3612":73410,"_31165":73379,"_21586":122570,"_5":14831,"_28346":122481,"_3068":122571},[],"Diseña el consumidor para:",{"_3612":73411,"_31165":73379,"_21586":122573,"_5":14831,"_28346":122481,"_3068":122574},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3612":73412,"_31165":73379,"_21586":122576,"_5":14831,"_28346":122481,"_3068":122577},[],"conservar el CloudEvent completo sin modificar;",{"_3612":73413,"_31165":73379,"_21586":122579,"_5":14831,"_28346":122481,"_3068":122580},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3612":73414,"_31165":73379,"_21586":122582,"_5":14831,"_28346":122481,"_3068":122583},[],"cifrar en tránsito y en reposo;",{"_3612":73415,"_31165":73379,"_21586":122585,"_5":14831,"_28346":122481,"_3068":122586},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3612":73416,"_31165":73379,"_21586":122588,"_5":14831,"_28346":122481,"_3068":122589},[],"aplicar una política explícita de retención y legal hold;",{"_3612":73417,"_31165":73379,"_21586":122591,"_5":14831,"_28346":122481,"_3068":122592},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3612":73418,"_31165":73379,"_21586":122594,"_5":14831,"_28346":122485,"_3068":122595},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3612":73419,"_31165":73379,"_21586":122597,"_5":14831,"_28346":122485,"_3068":122598},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3612":73420,"_31165":73379,"_21586":122600,"_5":14831,"_28346":122493,"_3068":122601},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3612":73421,"_31165":73379,"_21586":122603,"_5":14831,"_28346":122497,"_3068":122604},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3612":73422,"_31165":73379,"_21586":122606,"_5":14831,"_28346":122501,"_3068":122607},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3612":73423,"_31165":73379,"_21586":122609,"_5":14831,"_28346":122505,"_3068":122610},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3612":73424,"_31165":73379,"_21586":122612,"_5":14831,"_28346":122509,"_3068":122613},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3612":73425,"_31165":73379,"_21586":122615,"_5":14831,"_28346":122513,"_3068":122616},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3612":73426,"_31165":73379,"_21586":122618,"_5":14831,"_28346":122513,"_3068":122619},[],"aparece un evento de auditoría correcto;",{"_3612":73427,"_31165":73379,"_21586":122621,"_5":14831,"_28346":122513,"_3068":122622},[],"el principal coincide con la identidad utilizada;",{"_3612":73428,"_31165":73379,"_21586":122624,"_5":14831,"_28346":122513,"_3068":122625},[],"el consumidor lo persiste una sola vez;",{"_3612":73429,"_31165":73379,"_21586":122627,"_5":14831,"_28346":122513,"_3068":122628},[],"puede recuperarse por recurso, actor y periodo;",{"_3612":73430,"_31165":73379,"_21586":122630,"_5":14831,"_28346":122513,"_3068":122631},[],"una interrupción del consumidor produce una alerta.",{"_3612":73431,"_31165":73379,"_21586":122633,"_5":14831,"_28346":122513,"_3068":122634},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3612":73432,"_31165":73432,"_5":15196,"_3068":122636,"_31523":122637,"_21586":122638,"_28346":73432},"Arquitectura de la plataforma",[50890,121593],[],{"_3612":73433,"_31165":73432,"_21586":122640,"_5":14831,"_28346":73432,"_3068":122641},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3612":73434,"_31165":73432,"_5":31520,"_21586":122643,"_28346":122644,"_3068":122645},[],"/docs/pr-preview/pr-77/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3612":73435,"_31165":73432,"_5":31520,"_21586":122647,"_28346":122648,"_3068":122649},[],"/docs/pr-preview/pr-77/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3612":73436,"_31165":73432,"_5":31520,"_21586":122651,"_28346":122652,"_3068":122653},[],"/docs/pr-preview/pr-77/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3612":73437,"_31165":73432,"_5":31520,"_21586":122655,"_28346":122656,"_3068":122657},[],"/docs/pr-preview/pr-77/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3612":73438,"_31165":73432,"_5":31520,"_21586":122659,"_28346":122660,"_3068":122661},[],"/docs/pr-preview/pr-77/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3612":73439,"_31165":73432,"_21586":122663,"_5":14831,"_28346":73432,"_3068":122664},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3612":73440,"_31165":73432,"_21586":122666,"_5":14831,"_28346":73432,"_3068":122667},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3612":73441,"_31165":73432,"_21586":122669,"_5":14831,"_28346":122644,"_3068":122670},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3612":73442,"_31165":73432,"_21586":122672,"_5":14831,"_28346":122648,"_3068":122673},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3612":73443,"_31165":73432,"_21586":122675,"_5":14831,"_28346":122652,"_3068":122676},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3612":73444,"_31165":73432,"_21586":122678,"_5":14831,"_28346":122656,"_3068":122679},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3612":73445,"_31165":73432,"_21586":122681,"_5":14831,"_28346":122660,"_3068":122682},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3612":73446,"_31165":73446,"_5":15196,"_3068":122684,"_31523":122685,"_21586":122686,"_28346":73446},"Cómo funciona Lamassu",[50890,121593],[],{"_3612":73447,"_31165":73446,"_21586":122688,"_5":14831,"_28346":73446,"_3068":122689},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3612":73448,"_31165":73446,"_5":31520,"_21586":122691,"_28346":122692,"_3068":122693},[],"/docs/pr-preview/pr-77/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3612":73449,"_31165":73446,"_5":31520,"_21586":122695,"_28346":122696,"_3068":122697},[],"/docs/pr-preview/pr-77/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3612":73450,"_31165":73446,"_21586":122699,"_5":14831,"_28346":73446,"_3068":122700},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3612":73451,"_31165":73446,"_21586":122702,"_5":14831,"_28346":122692,"_3068":122703},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3612":73452,"_31165":73446,"_21586":122705,"_5":14831,"_28346":122692,"_3068":122706},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3612":73453,"_31165":73446,"_21586":122708,"_5":14831,"_28346":122692,"_3068":122709},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3612":73454,"_31165":73446,"_21586":122711,"_5":14831,"_28346":122692,"_3068":122712},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3612":73455,"_31165":73446,"_21586":122714,"_5":14831,"_28346":122692,"_3068":122715},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3612":73456,"_31165":73446,"_21586":122717,"_5":14831,"_28346":122696,"_3068":122718},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3612":73457,"_31165":73446,"_21586":122720,"_5":14831,"_28346":122696,"_3068":122721},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3612":73458,"_31165":73446,"_21586":122723,"_5":14831,"_28346":122696,"_3068":122724},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3612":73459,"_31165":73446,"_21586":122726,"_5":14831,"_28346":122696,"_3068":122727},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3612":73460,"_31165":73446,"_21586":122729,"_5":14831,"_28346":122696,"_3068":122730},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3612":73461,"_31165":73446,"_21586":122732,"_5":14831,"_28346":122696,"_3068":122733},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3612":73462,"_31165":73446,"_21586":122735,"_5":14831,"_28346":122696,"_3068":122736},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3612":73463,"_31165":73463,"_5":15196,"_3068":122738,"_31523":122739,"_21586":122740,"_28346":73463},"Dispositivos e identidades",[50890,121593,53574,122738],[],{"_3612":73464,"_31165":73463,"_21586":122742,"_5":14831,"_28346":73463,"_3068":122743},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3612":73465,"_31165":73463,"_5":31520,"_21586":122745,"_28346":122746,"_3068":122747},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3612":73466,"_31165":73463,"_5":31520,"_21586":122749,"_28346":122750,"_3068":122751},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3612":73467,"_31165":73463,"_5":31520,"_21586":122753,"_28346":122754,"_3068":122755},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3612":73468,"_31165":73463,"_5":31520,"_21586":122757,"_28346":122758,"_3068":122759},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3612":73469,"_31165":73463,"_5":31520,"_21586":122761,"_28346":122762,"_3068":122763},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3612":73470,"_31165":73463,"_5":31520,"_21586":122765,"_28346":122766,"_3068":122767},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3612":73471,"_31165":73463,"_5":31520,"_21586":122769,"_28346":122770,"_3068":122771},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3612":73472,"_31165":73463,"_5":31520,"_21586":122773,"_28346":122774,"_3068":122775},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3612":73473,"_31165":73463,"_5":31520,"_21586":122777,"_28346":122778,"_3068":122779},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3612":73474,"_31165":73463,"_5":31520,"_21586":122781,"_28346":122782,"_3068":122783},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3612":73475,"_31165":73463,"_5":31520,"_21586":122785,"_28346":122786,"_3068":122787},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3612":73476,"_31165":73463,"_21586":122789,"_5":14831,"_28346":73463,"_3068":122790},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3612":73477,"_31165":73463,"_21586":122792,"_5":14831,"_28346":73463,"_3068":122793},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3612":73478,"_31165":73463,"_21586":122795,"_5":14831,"_28346":122746,"_3068":122796},[],"Vista operativa",{"_3612":73479,"_31165":73463,"_21586":122798,"_5":14831,"_28346":122746,"_3068":122799},[],"Interpretación",{"_3612":73480,"_31165":73463,"_21586":122801,"_5":14831,"_28346":122746,"_3068":53637},[],{"_3612":73481,"_31165":73463,"_21586":122803,"_5":14831,"_28346":122746,"_3068":122804},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3612":73482,"_31165":73463,"_21586":122806,"_5":14831,"_28346":122746,"_3068":53643},[],{"_3612":73483,"_31165":73463,"_21586":122808,"_5":14831,"_28346":122746,"_3068":122809},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3612":73484,"_31165":73463,"_21586":122811,"_5":14831,"_28346":122746,"_3068":53649},[],{"_3612":73485,"_31165":73463,"_21586":122813,"_5":14831,"_28346":122746,"_3068":122814},[],"La identidad está en la ventana operativa de renovación.",{"_3612":73486,"_31165":73463,"_21586":122816,"_5":14831,"_28346":122746,"_3068":53655},[],{"_3612":73487,"_31165":73463,"_21586":122818,"_5":14831,"_28346":122746,"_3068":122819},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3612":73488,"_31165":73463,"_21586":122821,"_5":14831,"_28346":122746,"_3068":53661},[],{"_3612":73489,"_31165":73463,"_21586":122823,"_5":14831,"_28346":122746,"_3068":122824},[],"La identidad ha vencido.",{"_3612":73490,"_31165":73463,"_21586":122826,"_5":14831,"_28346":122746,"_3068":53667},[],{"_3612":73491,"_31165":73463,"_21586":122828,"_5":14831,"_28346":122746,"_3068":122829},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3612":73492,"_31165":73463,"_21586":122831,"_5":14831,"_28346":122746,"_3068":53673},[],{"_3612":73493,"_31165":73463,"_21586":122833,"_5":14831,"_28346":122746,"_3068":122834},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3612":73494,"_31165":73463,"_21586":122836,"_5":14831,"_28346":122746,"_3068":122837},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3612":73495,"_31165":73463,"_21586":122839,"_5":14831,"_28346":122750,"_3068":122840},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3612":73496,"_31165":73463,"_21586":122842,"_5":14831,"_28346":122750,"_3068":122843},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3612":73497,"_31165":73463,"_21586":122845,"_5":14831,"_28346":122750,"_3068":122846},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3612":73498,"_31165":73463,"_21586":122848,"_5":14831,"_28346":122750,"_3068":122849},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3612":73499,"_31165":73463,"_21586":122851,"_5":14831,"_28346":122754,"_3068":122852},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3612":73500,"_31165":73463,"_21586":122854,"_5":14831,"_28346":122758,"_3068":122855},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3612":73501,"_31165":73463,"_21586":122857,"_5":14831,"_28346":122762,"_3068":122858},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3612":73502,"_31165":73463,"_21586":122860,"_5":14831,"_28346":122766,"_3068":122861},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3612":73503,"_31165":73463,"_21586":122863,"_5":14831,"_28346":122770,"_3068":122864},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3612":73504,"_31165":73463,"_21586":122866,"_5":14831,"_28346":122770,"_3068":122867},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3612":73505,"_31165":73463,"_21586":122869,"_5":14831,"_28346":122774,"_3068":122870},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3612":73506,"_31165":73463,"_21586":122872,"_5":14831,"_28346":122774,"_3068":122873},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3612":73507,"_31165":73463,"_21586":122875,"_5":14831,"_28346":122774,"_3068":122876},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3612":73508,"_31165":73463,"_21586":122878,"_5":14831,"_28346":122774,"_3068":122879},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3612":73509,"_31165":73463,"_21586":122881,"_5":14831,"_28346":122774,"_3068":122882},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3612":73510,"_31165":73463,"_21586":122884,"_5":14831,"_28346":122774,"_3068":122885},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3612":73511,"_31165":73463,"_21586":122887,"_5":14831,"_28346":122778,"_3068":122888},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3612":73512,"_31165":73463,"_21586":122890,"_5":14831,"_28346":122778,"_3068":122891},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3612":73513,"_31165":73463,"_21586":122893,"_5":14831,"_28346":122778,"_3068":122894},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3612":73514,"_31165":73463,"_21586":122896,"_5":14831,"_28346":122782,"_3068":122897},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3612":73515,"_31165":73463,"_21586":122899,"_5":14831,"_28346":122782,"_3068":122900},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3612":73516,"_31165":73463,"_21586":122902,"_5":14831,"_28346":122782,"_3068":122903},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3612":73517,"_31165":73463,"_21586":122905,"_5":14831,"_28346":122782,"_3068":122906},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3612":73518,"_31165":73463,"_21586":122908,"_5":14831,"_28346":122786,"_3068":122909},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3612":73519,"_31165":73463,"_21586":122911,"_5":14831,"_28346":122786,"_3068":122912},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3612":73520,"_31165":73520,"_5":15196,"_3068":122914,"_31523":122915,"_21586":122917,"_28346":73520},"Identidad inicial y autenticación",[50890,121593,53574,122738,122916],"Enrolamiento con PKI",[],{"_3612":73521,"_31165":73520,"_21586":122919,"_5":14831,"_28346":73520,"_3068":122920},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3612":73522,"_31165":73520,"_5":31520,"_21586":122922,"_28346":122923,"_3068":122924},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3612":73523,"_31165":73520,"_5":31520,"_21586":122926,"_28346":122927,"_3068":122928},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3612":73524,"_31165":73520,"_5":31520,"_21586":122930,"_28346":122931,"_3068":122932},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3612":73525,"_31165":73520,"_5":31520,"_21586":122934,"_28346":122935,"_3068":122936},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3612":73526,"_31165":73520,"_5":31520,"_21586":122938,"_28346":122939,"_3068":122940},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3612":73527,"_31165":73520,"_21586":122942,"_5":14831,"_28346":73520,"_3068":122943},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3612":73528,"_31165":73520,"_21586":122945,"_5":14831,"_28346":122923,"_3068":122946},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3612":73529,"_31165":73520,"_21586":122948,"_5":14831,"_28346":122923,"_3068":122949},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3612":73530,"_31165":73520,"_21586":122951,"_5":14831,"_28346":122927,"_3068":122952},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3612":73531,"_31165":73520,"_21586":122954,"_5":14831,"_28346":122927,"_3068":122955},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3612":73532,"_31165":73520,"_21586":122957,"_5":14831,"_28346":122927,"_3068":122958},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3612":73533,"_31165":73520,"_21586":122960,"_5":14831,"_28346":122931,"_3068":122961},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3612":73534,"_31165":73520,"_21586":122963,"_5":14831,"_28346":122931,"_3068":122964},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3612":73535,"_31165":73520,"_21586":122966,"_5":14831,"_28346":122935,"_3068":122967},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3612":73536,"_31165":73520,"_21586":122969,"_5":14831,"_28346":122935,"_3068":122970},[],"Ejemplo de cuerpo:",{"_3612":73537,"_31165":73520,"_21586":122972,"_5":14831,"_28346":122935,"_3068":122973},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3612":73538,"_31165":73520,"_21586":122975,"_5":14831,"_28346":122935,"_3068":122976},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3612":73539,"_31165":73520,"_21586":122978,"_5":14831,"_28346":122935,"_3068":122979},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3612":73540,"_31165":73520,"_21586":122981,"_5":14831,"_28346":122935,"_3068":122982},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3612":73541,"_31165":73520,"_21586":122984,"_5":14831,"_28346":122939,"_3068":122985},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3612":73542,"_31165":73520,"_21586":122987,"_5":14831,"_28346":122939,"_3068":122988},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3612":73543,"_31165":73543,"_5":15196,"_3068":122990,"_31523":122991,"_21586":122992,"_28346":73543},"Configura y opera el DMS",[50890,121593,53574,122738,122916],[],{"_3612":73544,"_31165":73543,"_21586":122994,"_5":14831,"_28346":73543,"_3068":122995},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3612":73545,"_31165":73543,"_5":31520,"_21586":122997,"_28346":122998,"_3068":120127},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3612":73546,"_31165":73543,"_5":31520,"_21586":123000,"_28346":123001,"_3068":123002},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3612":73547,"_31165":73543,"_5":31520,"_21586":123004,"_28346":123005,"_3068":123006},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3612":73548,"_31165":73543,"_5":31520,"_21586":123008,"_28346":123009,"_3068":123010},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3612":73549,"_31165":73543,"_5":31520,"_21586":123012,"_28346":123013,"_3068":123014},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3612":73550,"_31165":73543,"_5":31520,"_21586":123016,"_28346":123017,"_3068":123018},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3612":73551,"_31165":73543,"_5":31520,"_21586":123020,"_28346":123021,"_3068":123022},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3612":73552,"_31165":73543,"_5":31520,"_21586":123024,"_28346":123025,"_3068":123026},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3612":73553,"_31165":73543,"_5":31520,"_21586":123028,"_28346":123029,"_3068":53872},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3612":73554,"_31165":73543,"_5":31520,"_21586":123031,"_28346":123032,"_3068":53876},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3612":73555,"_31165":73543,"_5":31520,"_21586":123034,"_28346":123035,"_3068":123036},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3612":73556,"_31165":73543,"_5":31520,"_21586":123038,"_28346":123039,"_3068":123040},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3612":73557,"_31165":73543,"_5":31520,"_21586":123042,"_28346":123043,"_3068":123044},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3612":73558,"_31165":73543,"_5":31520,"_21586":123046,"_28346":123047,"_3068":123048},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3612":73559,"_31165":73543,"_5":31520,"_21586":123050,"_28346":123051,"_3068":53896},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3612":73560,"_31165":73543,"_5":31520,"_21586":123053,"_28346":123054,"_3068":123055},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3612":73561,"_31165":73543,"_5":31520,"_21586":123057,"_28346":123058,"_3068":123059},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3612":73562,"_31165":73543,"_5":31520,"_21586":123061,"_28346":123062,"_3068":123063},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3612":73563,"_31165":73543,"_21586":123065,"_5":14831,"_28346":73543,"_3068":123066},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3612":73564,"_31165":73543,"_21586":123068,"_5":14831,"_28346":122998,"_3068":123069},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3612":73565,"_31165":73543,"_21586":123071,"_5":14831,"_28346":122998,"_3068":123072},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3612":73566,"_31165":73543,"_21586":123074,"_5":14831,"_28346":123005,"_3068":123075},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3612":73567,"_31165":73543,"_21586":123077,"_5":14831,"_28346":123009,"_3068":123078},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3612":73568,"_31165":73543,"_21586":123080,"_5":14831,"_28346":123013,"_3068":123081},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3612":73569,"_31165":73543,"_21586":123083,"_5":14831,"_28346":123017,"_3068":123084},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3612":73570,"_31165":73543,"_21586":123086,"_5":14831,"_28346":123021,"_3068":123087},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3612":73571,"_31165":73543,"_21586":123089,"_5":14831,"_28346":123029,"_3068":123090},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3612":73572,"_31165":73543,"_21586":123092,"_5":14831,"_28346":123029,"_3068":123093},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3612":73573,"_31165":73543,"_21586":123095,"_5":14831,"_28346":123032,"_3068":123096},[],"Campo de `settings.enrollment_settings`",{"_3612":73574,"_31165":73543,"_21586":123098,"_5":14831,"_28346":123032,"_3068":123099},[],"Decisión",{"_3612":73575,"_31165":73543,"_21586":123101,"_5":14831,"_28346":123032,"_3068":53947},[],{"_3612":73576,"_31165":73543,"_21586":123103,"_5":14831,"_28346":123032,"_3068":123104},[],"`EST_RFC7030` para estas operaciones.",{"_3612":73577,"_31165":73543,"_21586":123106,"_5":14831,"_28346":123032,"_3068":53953},[],{"_3612":73578,"_31165":73543,"_21586":123108,"_5":14831,"_28346":123032,"_3068":123109},[],"ID de la CA que firmará.",{"_3612":73579,"_31165":73543,"_21586":123111,"_5":14831,"_28346":123032,"_3068":53959},[],{"_3612":73580,"_31165":73543,"_21586":123113,"_5":14831,"_28346":123032,"_3068":123114},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3612":73581,"_31165":73543,"_21586":123116,"_5":14831,"_28346":123032,"_3068":53965},[],{"_3612":73582,"_31165":73543,"_21586":123118,"_5":14831,"_28346":123032,"_3068":123119},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3612":73583,"_31165":73543,"_21586":123121,"_5":14831,"_28346":123032,"_3068":53971},[],{"_3612":73584,"_31165":73543,"_21586":123123,"_5":14831,"_28346":123032,"_3068":123124},[],"Uno de los cuatro modos de autenticación.",{"_3612":73585,"_31165":73543,"_21586":123126,"_5":14831,"_28346":123032,"_3068":123127},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3612":73586,"_31165":73543,"_21586":123129,"_5":14831,"_28346":123035,"_3068":123130},[],"Los bloques son independientes:",{"_3612":73587,"_31165":73543,"_21586":123132,"_5":14831,"_28346":123035,"_3068":123133},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3612":73588,"_31165":73543,"_21586":123135,"_5":14831,"_28346":123035,"_3068":123136},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3612":73589,"_31165":73543,"_21586":123138,"_5":14831,"_28346":123035,"_3068":53989},[],{"_3612":73590,"_31165":73543,"_21586":123140,"_5":14831,"_28346":123035,"_3068":123141},[],"Control aplicado en la operación configurada",{"_3612":73591,"_31165":73543,"_21586":123143,"_5":14831,"_28346":123035,"_3068":53995},[],{"_3612":73592,"_31165":73543,"_21586":123145,"_5":14831,"_28346":123035,"_3068":123146},[],"Validación del certificado presentado.",{"_3612":73593,"_31165":73543,"_21586":123148,"_5":14831,"_28346":123035,"_3068":54001},[],{"_3612":73594,"_31165":73543,"_21586":123150,"_5":14831,"_28346":123035,"_3068":123151},[],"Autorización del webhook configurado.",{"_3612":73595,"_31165":73543,"_21586":123153,"_5":14831,"_28346":123035,"_3068":54007},[],{"_3612":73596,"_31165":73543,"_21586":123155,"_5":14831,"_28346":123035,"_3068":123156},[],"Validación del certificado y, después, aprobación del webhook.",{"_3612":73597,"_31165":73543,"_21586":123158,"_5":14831,"_28346":123035,"_3068":54013},[],{"_3612":73598,"_31165":73543,"_21586":123160,"_5":14831,"_28346":123035,"_3068":123161},[],"Sin autenticación del solicitante por el DMS.",{"_3612":73599,"_31165":73543,"_21586":123163,"_5":14831,"_28346":123035,"_3068":123164},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3612":73600,"_31165":73543,"_21586":123166,"_5":14831,"_28346":123035,"_3068":123167},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `allow_unverifiable_revocation` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3612":73601,"_31165":73543,"_21586":123169,"_5":14831,"_28346":123035,"_3068":123170},[],"El editor de autenticación ofrece el interruptor **Allow certificates without revocation information** (`allow_unverifiable_revocation`, desactivado por defecto). Cuando está activado, se aceptan certificados — y CAs intermedias de la cadena — que Lamassu no gestiona y que no declaran ningún endpoint OCSP o CRL; las respuestas de revocación inaccesibles, obsoletas o no concluyentes se rechazan siempre. Mientras el interruptor esté activado, la consola muestra una alerta de aviso: **Revocation will not be verified** — un certificado revocado sin endpoint OCSP o CRL, y no gestionado por Lamassu, será aceptado, y esto se aplica también a las CAs intermedias de la cadena.",{"_3612":73602,"_31165":73543,"_21586":123172,"_5":14831,"_28346":123035,"_3068":123173},[],"El mismo interruptor se ofrece tanto en el editor de autenticación de enrolamiento como en el de reenrolamiento, y se almacena por bloque dentro de `est_rfc7030_settings.client_certificate_settings`; un DMS almacenado antes de que existiera el campo se carga con el interruptor desactivado. La consola también muestra una alerta de aviso siempre que una opción de autenticación esté en su estado inseguro — **Allow expired certificates** activado, **Allow expired renewal** activado o **Verify CSR signature** desactivado — y la nota de No authentication se presenta también como alerta de aviso.",{"_3612":73603,"_31165":73543,"_21586":123175,"_5":14831,"_28346":123035,"_3068":123176},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3612":73604,"_31165":73543,"_21586":123178,"_5":14831,"_28346":123035,"_3068":123179},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3612":73605,"_31165":73543,"_21586":123181,"_5":14831,"_28346":123039,"_3068":123182},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3612":73606,"_31165":73543,"_21586":123184,"_5":14831,"_28346":123039,"_3068":123185},[],"Campo de `external_webhook_settings`",{"_3612":73607,"_31165":73543,"_21586":123187,"_5":14831,"_28346":123039,"_3068":123099},[],{"_3612":73608,"_31165":73543,"_21586":123189,"_5":14831,"_28346":123039,"_3068":54045},[],{"_3612":73609,"_31165":73543,"_21586":123191,"_5":14831,"_28346":123039,"_3068":123192},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3612":73610,"_31165":73543,"_21586":123194,"_5":14831,"_28346":123039,"_3068":54051},[],{"_3612":73611,"_31165":73543,"_21586":123196,"_5":14831,"_28346":123039,"_3068":123197},[],"`POST` o `PUT`; `POST` por defecto.",{"_3612":73612,"_31165":73543,"_21586":123199,"_5":14831,"_28346":123039,"_3068":54057},[],{"_3612":73613,"_31165":73543,"_21586":123201,"_5":14831,"_28346":123039,"_3068":123202},[],"Etiqueta usada en los logs del servicio.",{"_3612":73614,"_31165":73543,"_21586":123204,"_5":14831,"_28346":123039,"_3068":54063},[],{"_3612":73615,"_31165":73543,"_21586":123206,"_5":14831,"_28346":123039,"_3068":123207},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3612":73616,"_31165":73543,"_21586":123209,"_5":14831,"_28346":123039,"_3068":54069},[],{"_3612":73617,"_31165":73543,"_21586":123211,"_5":14831,"_28346":123039,"_3068":123212},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3612":73618,"_31165":73543,"_21586":123214,"_5":14831,"_28346":123039,"_3068":54075},[],{"_3612":73619,"_31165":73543,"_21586":123216,"_5":14831,"_28346":123039,"_3068":123217},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3612":73620,"_31165":73543,"_21586":123219,"_5":14831,"_28346":123039,"_3068":54081},[],{"_3612":73621,"_31165":73543,"_21586":123221,"_5":14831,"_28346":123039,"_3068":123222},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3612":73622,"_31165":73543,"_21586":123224,"_5":14831,"_28346":123039,"_3068":54087},[],{"_3612":73623,"_31165":73543,"_21586":123226,"_5":14831,"_28346":123039,"_3068":123227},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3612":73624,"_31165":73543,"_21586":123229,"_5":14831,"_28346":123039,"_3068":54093},[],{"_3612":73625,"_31165":73543,"_21586":123231,"_5":14831,"_28346":123039,"_3068":123232},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3612":73626,"_31165":73543,"_21586":123234,"_5":14831,"_28346":123039,"_3068":54099},[],{"_3612":73627,"_31165":73543,"_21586":123236,"_5":14831,"_28346":123039,"_3068":123237},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3612":73628,"_31165":73543,"_21586":123239,"_5":14831,"_28346":123039,"_3068":123240},[],"Reglas de esa configuración:",{"_3612":73629,"_31165":73543,"_21586":123242,"_5":14831,"_28346":123039,"_3068":123243},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3612":73630,"_31165":73543,"_21586":123245,"_5":14831,"_28346":123039,"_3068":123246},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3612":73631,"_31165":73543,"_21586":123248,"_5":14831,"_28346":123039,"_3068":123249},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3612":73632,"_31165":73543,"_21586":123251,"_5":14831,"_28346":123039,"_3068":123252},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3612":73633,"_31165":73543,"_21586":123254,"_5":14831,"_28346":123039,"_3068":123255},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3612":73634,"_31165":73543,"_21586":123257,"_5":14831,"_28346":123039,"_3068":123258},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3612":73635,"_31165":73543,"_21586":123260,"_5":14831,"_28346":123039,"_3068":123261},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3612":73636,"_31165":73543,"_21586":123263,"_5":14831,"_28346":123039,"_3068":123264},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3612":73637,"_31165":73543,"_21586":123266,"_5":14831,"_28346":123039,"_3068":123267},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3612":73638,"_31165":73543,"_21586":123269,"_5":14831,"_28346":123043,"_3068":123270},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3612":73639,"_31165":73543,"_21586":123272,"_5":14831,"_28346":123047,"_3068":123273},[],"Campo de `settings.reenrollment_settings`",{"_3612":73640,"_31165":73543,"_21586":123275,"_5":14831,"_28346":123047,"_3068":123276},[],"Función",{"_3612":73641,"_31165":73543,"_21586":123278,"_5":14831,"_28346":123047,"_3068":54143},[],{"_3612":73642,"_31165":73543,"_21586":123280,"_5":14831,"_28346":123047,"_3068":123281},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3612":73643,"_31165":73543,"_21586":123283,"_5":14831,"_28346":123047,"_3068":54149},[],{"_3612":73644,"_31165":73543,"_21586":123285,"_5":14831,"_28346":123047,"_3068":123286},[],"Umbral operativo preventivo de monitorización.",{"_3612":73645,"_31165":73543,"_21586":123288,"_5":14831,"_28346":123047,"_3068":54155},[],{"_3612":73646,"_31165":73543,"_21586":123290,"_5":14831,"_28346":123047,"_3068":123291},[],"Umbral operativo crítico de monitorización.",{"_3612":73647,"_31165":73543,"_21586":123293,"_5":14831,"_28346":123047,"_3068":54161},[],{"_3612":73648,"_31165":73543,"_21586":123295,"_5":14831,"_28346":123047,"_3068":123296},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3612":73649,"_31165":73543,"_21586":123298,"_5":14831,"_28346":123047,"_3068":54167},[],{"_3612":73650,"_31165":73543,"_21586":123300,"_5":14831,"_28346":123047,"_3068":123301},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3612":73651,"_31165":73543,"_21586":123303,"_5":14831,"_28346":123047,"_3068":54173},[],{"_3612":73652,"_31165":73543,"_21586":123305,"_5":14831,"_28346":123047,"_3068":123306},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3612":73653,"_31165":73543,"_21586":123308,"_5":14831,"_28346":123047,"_3068":123309},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3612":73654,"_31165":73543,"_21586":123311,"_5":14831,"_28346":123051,"_3068":123312},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3612":73655,"_31165":73543,"_21586":123314,"_5":14831,"_28346":123054,"_3068":120491},[],{"_3612":73656,"_31165":73543,"_21586":123316,"_5":14831,"_28346":123054,"_3068":123317},[],"Qué publica",{"_3612":73657,"_31165":73543,"_21586":123319,"_5":14831,"_28346":123054,"_3068":54190},[],{"_3612":73658,"_31165":73543,"_21586":123321,"_5":14831,"_28346":123054,"_3068":123322},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3612":73659,"_31165":73543,"_21586":123324,"_5":14831,"_28346":123054,"_3068":54196},[],{"_3612":73660,"_31165":73543,"_21586":123326,"_5":14831,"_28346":123054,"_3068":123327},[],"Certificado de la CA emisora seleccionada.",{"_3612":73661,"_31165":73543,"_21586":123329,"_5":14831,"_28346":123054,"_3068":54202},[],{"_3612":73662,"_31165":73543,"_21586":123331,"_5":14831,"_28346":123054,"_3068":123332},[],"Certificados de las CAs elegidas explícitamente.",{"_3612":73663,"_31165":73543,"_21586":123334,"_5":14831,"_28346":123054,"_3068":123335},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3612":73664,"_31165":73543,"_21586":123337,"_5":14831,"_28346":123058,"_3068":123338},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3612":73665,"_31165":73543,"_21586":123340,"_5":14831,"_28346":123058,"_3068":123341},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3612":73666,"_31165":73543,"_21586":123343,"_5":14831,"_28346":123058,"_3068":123344},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3612":73667,"_31165":73543,"_21586":123346,"_5":14831,"_28346":123062,"_3068":123347},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3612":73668,"_31165":73668,"_5":15196,"_3068":123349,"_31523":123350,"_21586":123351,"_28346":73668},"Integra el cliente EST",[50890,121593,53574,122738,122916],[],{"_3612":73669,"_31165":73668,"_21586":123353,"_5":14831,"_28346":73668,"_3068":123354},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3612":73670,"_31165":73668,"_5":31520,"_21586":123356,"_28346":123357,"_3068":120127},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3612":73671,"_31165":73668,"_5":31520,"_21586":123359,"_28346":123360,"_3068":123361},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3612":73672,"_31165":73668,"_5":31520,"_21586":123363,"_28346":123364,"_3068":123365},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3612":73673,"_31165":73668,"_5":31520,"_21586":123367,"_28346":123368,"_3068":123369},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3612":73674,"_31165":73668,"_5":31520,"_21586":123371,"_28346":123372,"_3068":123373},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3612":73675,"_31165":73668,"_5":31520,"_21586":123375,"_28346":123376,"_3068":123377},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3612":73676,"_31165":73668,"_21586":123379,"_5":14831,"_28346":73668,"_3068":123380},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3612":73677,"_31165":73668,"_21586":123382,"_5":14831,"_28346":123357,"_3068":123383},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3612":73678,"_31165":73668,"_21586":123385,"_5":14831,"_28346":123357,"_3068":123386},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3612":73679,"_31165":73668,"_21586":123388,"_5":14831,"_28346":123357,"_3068":123389},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3612":73680,"_31165":73668,"_21586":123391,"_5":14831,"_28346":123360,"_3068":123392},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3612":73681,"_31165":73668,"_21586":123394,"_5":14831,"_28346":123360,"_3068":123395},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3612":73682,"_31165":73668,"_21586":123397,"_5":14831,"_28346":123364,"_3068":123398},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3612":73683,"_31165":73668,"_21586":123400,"_5":14831,"_28346":123364,"_3068":123401},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3612":73684,"_31165":73668,"_21586":123403,"_5":14831,"_28346":123368,"_3068":123404},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3612":73685,"_31165":73668,"_21586":123406,"_5":14831,"_28346":123368,"_3068":123407},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3612":73686,"_31165":73668,"_21586":123409,"_5":14831,"_28346":123372,"_3068":123410},[],"Para el caso de una raíz que emite directamente:",{"_3612":73687,"_31165":73668,"_21586":123412,"_5":14831,"_28346":123372,"_3068":123413},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3612":73688,"_31165":73668,"_21586":123415,"_5":14831,"_28346":123372,"_3068":123416},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3612":73689,"_31165":73668,"_21586":123418,"_5":14831,"_28346":123376,"_3068":123419},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3612":73690,"_31165":73690,"_5":15196,"_3068":123421,"_31523":123422,"_21586":123423,"_28346":73690},"Referencia EST",[50890,121593,53574,122738,122916],[],{"_3612":73691,"_31165":73690,"_21586":123425,"_5":14831,"_28346":73690,"_3068":123426},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3612":73692,"_31165":73690,"_5":31520,"_21586":123428,"_28346":123429,"_3068":123430},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3612":73693,"_31165":73690,"_5":31520,"_21586":123432,"_28346":123433,"_3068":23388},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3612":73694,"_31165":73690,"_5":31520,"_21586":123435,"_28346":123436,"_3068":26892},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3612":73695,"_31165":73690,"_5":31520,"_21586":123438,"_28346":123439,"_3068":26899},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3612":73696,"_31165":73690,"_5":31520,"_21586":123441,"_28346":123442,"_3068":26156},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3612":73697,"_31165":73690,"_5":31520,"_21586":123444,"_28346":123445,"_3068":123446},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3612":73698,"_31165":73690,"_5":31520,"_21586":123448,"_28346":123449,"_3068":123450},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3612":73699,"_31165":73690,"_5":31520,"_21586":123452,"_28346":123453,"_3068":123454},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3612":73700,"_31165":73690,"_21586":123456,"_5":14831,"_28346":73690,"_3068":123457},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3612":73701,"_31165":73690,"_21586":123459,"_5":14831,"_28346":123429,"_3068":123460},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3612":73702,"_31165":73690,"_21586":123462,"_5":14831,"_28346":123429,"_3068":121353},[],{"_3612":73703,"_31165":73690,"_21586":123464,"_5":14831,"_28346":123429,"_3068":123465},[],"Método",{"_3612":73704,"_31165":73690,"_21586":123467,"_5":14831,"_28346":123429,"_3068":123468},[],"Autenticación y condición",{"_3612":73705,"_31165":73690,"_21586":123470,"_5":14831,"_28346":123429,"_3068":54345},[],{"_3612":73706,"_31165":73690,"_21586":123472,"_5":14831,"_28346":123429,"_3068":54348},[],{"_3612":73707,"_31165":73690,"_21586":123474,"_5":14831,"_28346":123429,"_3068":123475},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3612":73708,"_31165":73690,"_21586":123477,"_5":14831,"_28346":123429,"_3068":54354},[],{"_3612":73709,"_31165":73690,"_21586":123479,"_5":14831,"_28346":123429,"_3068":54357},[],{"_3612":73710,"_31165":73690,"_21586":123481,"_5":14831,"_28346":123429,"_3068":123482},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3612":73711,"_31165":73690,"_21586":123484,"_5":14831,"_28346":123429,"_3068":54363},[],{"_3612":73712,"_31165":73690,"_21586":123486,"_5":14831,"_28346":123429,"_3068":54357},[],{"_3612":73713,"_31165":73690,"_21586":123488,"_5":14831,"_28346":123429,"_3068":123489},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3612":73714,"_31165":73690,"_21586":123491,"_5":14831,"_28346":123429,"_3068":54371},[],{"_3612":73715,"_31165":73690,"_21586":123493,"_5":14831,"_28346":123429,"_3068":54357},[],{"_3612":73716,"_31165":73690,"_21586":123495,"_5":14831,"_28346":123429,"_3068":123496},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3612":73717,"_31165":73690,"_21586":123498,"_5":14831,"_28346":123429,"_3068":123499},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3612":73718,"_31165":73690,"_21586":123501,"_5":14831,"_28346":123433,"_3068":123502},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3612":73719,"_31165":73690,"_21586":123504,"_5":14831,"_28346":123433,"_3068":123505},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3612":73720,"_31165":73690,"_21586":123507,"_5":14831,"_28346":123436,"_3068":123508},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3612":73721,"_31165":73690,"_21586":123510,"_5":14831,"_28346":123436,"_3068":123511},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3612":73722,"_31165":73690,"_21586":123513,"_5":14831,"_28346":123439,"_3068":123514},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3612":73723,"_31165":73690,"_21586":123516,"_5":14831,"_28346":123439,"_3068":123517},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3612":73724,"_31165":73690,"_21586":123519,"_5":14831,"_28346":123442,"_3068":123520},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3612":73725,"_31165":73690,"_21586":123522,"_5":14831,"_28346":123442,"_3068":123523},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3612":73726,"_31165":73690,"_21586":123525,"_5":14831,"_28346":123445,"_3068":123526},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3612":73727,"_31165":73690,"_21586":123528,"_5":14831,"_28346":123445,"_3068":123529},[],"Parte",{"_3612":73728,"_31165":73690,"_21586":123531,"_5":14831,"_28346":123445,"_3068":123532},[],"Contenido tras decodificar su Base64",{"_3612":73729,"_31165":73690,"_21586":123534,"_5":14831,"_28346":123445,"_3068":54415},[],{"_3612":73730,"_31165":73690,"_21586":123536,"_5":14831,"_28346":123445,"_3068":123537},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3612":73731,"_31165":73690,"_21586":123539,"_5":14831,"_28346":123445,"_3068":54421},[],{"_3612":73732,"_31165":73690,"_21586":123541,"_5":14831,"_28346":123445,"_3068":123542},[],"PKCS#7 DER con el certificado emitido.",{"_3612":73733,"_31165":73690,"_21586":123544,"_5":14831,"_28346":123445,"_3068":123545},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3612":73734,"_31165":73690,"_21586":123547,"_5":14831,"_28346":123449,"_3068":123548},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3612":73735,"_31165":73690,"_21586":123550,"_5":14831,"_28346":123449,"_3068":123551},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3612":73736,"_31165":73690,"_21586":123553,"_5":14831,"_28346":123449,"_3068":123554},[],"Convierte y comprueba el resultado:",{"_3612":73737,"_31165":73690,"_21586":123556,"_5":14831,"_28346":123449,"_3068":123557},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3612":73738,"_31165":73690,"_21586":123559,"_5":14831,"_28346":123453,"_3068":123560},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3612":73739,"_31165":73690,"_21586":123562,"_5":14831,"_28346":123453,"_3068":123563},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3612":73740,"_31165":73740,"_5":15196,"_3068":122916,"_31523":123565,"_21586":123566,"_28346":73740},[50890,121593,53574,122738,122916],[],{"_3612":73741,"_31165":73740,"_21586":123568,"_5":14831,"_28346":73740,"_3068":123569},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3612":73742,"_31165":73740,"_5":31520,"_21586":123571,"_28346":123572,"_3068":123573},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3612":73743,"_31165":73740,"_5":31520,"_21586":123575,"_28346":123576,"_3068":123577},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3612":73744,"_31165":73740,"_5":31520,"_21586":123579,"_28346":123580,"_3068":123581},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3612":73745,"_31165":73740,"_5":31520,"_21586":123583,"_28346":123584,"_3068":123585},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3612":73746,"_31165":73740,"_21586":123587,"_5":14831,"_28346":73740,"_3068":123588},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3612":73747,"_31165":73740,"_21586":123590,"_5":14831,"_28346":123572,"_3068":123591},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3612":73748,"_31165":73740,"_21586":123593,"_5":14831,"_28346":123572,"_3068":123594},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3612":73749,"_31165":73740,"_21586":123596,"_5":14831,"_28346":123572,"_3068":123597},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3612":73750,"_31165":73740,"_21586":123599,"_5":14831,"_28346":123572,"_3068":123600},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3612":73751,"_31165":73740,"_21586":123602,"_5":14831,"_28346":123572,"_3068":123603},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3612":73752,"_31165":73740,"_21586":123605,"_5":14831,"_28346":123572,"_3068":123606},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3612":73753,"_31165":73740,"_21586":123608,"_5":14831,"_28346":123576,"_3068":123609},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3612":73754,"_31165":73740,"_21586":123611,"_5":14831,"_28346":123576,"_3068":123612},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3612":73755,"_31165":73740,"_21586":123614,"_5":14831,"_28346":123576,"_3068":123615},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3612":73756,"_31165":73740,"_21586":123617,"_5":14831,"_28346":123576,"_3068":123618},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3612":73757,"_31165":73740,"_21586":123620,"_5":14831,"_28346":123580,"_3068":123621},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3612":73758,"_31165":73740,"_21586":123623,"_5":14831,"_28346":123580,"_3068":123624},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3612":73759,"_31165":73740,"_21586":123626,"_5":14831,"_28346":123580,"_3068":123627},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3612":73760,"_31165":73740,"_21586":123629,"_5":14831,"_28346":123580,"_3068":123630},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3612":73761,"_31165":73740,"_21586":123632,"_5":14831,"_28346":123584,"_3068":123633},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3612":73762,"_31165":73740,"_21586":123635,"_5":14831,"_28346":123584,"_3068":123636},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3612":73763,"_31165":73763,"_5":15196,"_3068":123638,"_31523":123639,"_21586":123640,"_28346":73763},"Estrategias de aprovisionamiento",[50890,121593,53574,122738,122916],[],{"_3612":73764,"_31165":73763,"_21586":123642,"_5":14831,"_28346":73763,"_3068":123643},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3612":73765,"_31165":73763,"_5":31520,"_21586":123645,"_28346":123646,"_3068":123647},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3612":73766,"_31165":73763,"_5":31520,"_21586":123649,"_28346":123650,"_3068":123651},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3612":73767,"_31165":73763,"_5":31520,"_21586":123653,"_28346":123654,"_3068":123655},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3612":73768,"_31165":73763,"_5":31520,"_21586":123657,"_28346":123658,"_3068":123659},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3612":73769,"_31165":73763,"_5":31520,"_21586":123661,"_28346":123662,"_3068":123663},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3612":73770,"_31165":73763,"_21586":123665,"_5":14831,"_28346":73763,"_3068":123666},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3612":73771,"_31165":73763,"_21586":123668,"_5":14831,"_28346":123646,"_3068":123669},[],"Recorrido",{"_3612":73772,"_31165":73763,"_21586":123671,"_5":14831,"_28346":123646,"_3068":123672},[],"Cuándo existe el dispositivo",{"_3612":73773,"_31165":73763,"_21586":123674,"_5":14831,"_28346":123646,"_3068":123675},[],"Qué compruebas",{"_3612":73774,"_31165":73763,"_21586":123677,"_5":14831,"_28346":123646,"_3068":123678},[],"Asignación manual",{"_3612":73775,"_31165":73763,"_21586":123680,"_5":14831,"_28346":123646,"_3068":123681},[],"El operador lo crea antes de asociar un certificado.",{"_3612":73776,"_31165":73763,"_21586":123683,"_5":14831,"_28346":123646,"_3068":123684},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3612":73777,"_31165":73763,"_21586":123686,"_5":14831,"_28346":123646,"_3068":123687},[],"EST con `JITP`",{"_3612":73778,"_31165":73763,"_21586":123689,"_5":14831,"_28346":123646,"_3068":123690},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3612":73779,"_31165":73763,"_21586":123692,"_5":14831,"_28346":123646,"_3068":123693},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3612":73780,"_31165":73763,"_21586":123695,"_5":14831,"_28346":123646,"_3068":123696},[],"EST con `PRE_REGISTRATION`",{"_3612":73781,"_31165":73763,"_21586":123698,"_5":14831,"_28346":123646,"_3068":123699},[],"Debe existir antes de `/simpleenroll`.",{"_3612":73782,"_31165":73763,"_21586":123701,"_5":14831,"_28346":123646,"_3068":123702},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3612":73783,"_31165":73763,"_21586":123704,"_5":14831,"_28346":123646,"_3068":123705},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3612":73784,"_31165":73763,"_21586":123707,"_5":14831,"_28346":123646,"_3068":123708},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3612":73785,"_31165":73763,"_21586":123710,"_5":14831,"_28346":123650,"_3068":123711},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3612":73786,"_31165":73763,"_21586":123713,"_5":14831,"_28346":123650,"_3068":123714},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3612":73787,"_31165":73763,"_21586":123716,"_5":14831,"_28346":123650,"_3068":123717},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3612":73788,"_31165":73763,"_21586":123719,"_5":14831,"_28346":123654,"_3068":123720},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3612":73789,"_31165":73763,"_21586":123722,"_5":14831,"_28346":123654,"_3068":123723},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3612":73790,"_31165":73763,"_21586":123725,"_5":14831,"_28346":123654,"_3068":123726},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3612":73791,"_31165":73763,"_21586":123728,"_5":14831,"_28346":123654,"_3068":123729},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3612":73792,"_31165":73763,"_21586":123731,"_5":14831,"_28346":123654,"_3068":123732},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3612":73793,"_31165":73763,"_21586":123734,"_5":14831,"_28346":123654,"_3068":123735},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3612":73794,"_31165":73763,"_21586":123737,"_5":14831,"_28346":123658,"_3068":120491},[],{"_3612":73795,"_31165":73763,"_21586":123739,"_5":14831,"_28346":123658,"_3068":123740},[],"Material que atraviesa EST",{"_3612":73796,"_31165":73763,"_21586":123742,"_5":14831,"_28346":123658,"_3068":123743},[],"Clave generada por el dispositivo",{"_3612":73797,"_31165":73763,"_21586":123745,"_5":14831,"_28346":123658,"_3068":123746},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3612":73798,"_31165":73763,"_21586":123748,"_5":14831,"_28346":123658,"_3068":123749},[],"Clave ya disponible en el dispositivo",{"_3612":73799,"_31165":73763,"_21586":123751,"_5":14831,"_28346":123658,"_3068":123752},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3612":73800,"_31165":73763,"_21586":123754,"_5":14831,"_28346":123658,"_3068":53896},[],{"_3612":73801,"_31165":73763,"_21586":123756,"_5":14831,"_28346":123658,"_3068":123757},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3612":73802,"_31165":73763,"_21586":123759,"_5":14831,"_28346":123658,"_3068":123760},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3612":73803,"_31165":73763,"_21586":123762,"_5":14831,"_28346":123662,"_3068":123763},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3612":73804,"_31165":73804,"_5":15196,"_3068":123765,"_31523":123766,"_21586":123767,"_28346":73804},"Renovación y recuperación",[50890,121593,53574,122738,122916],[],{"_3612":73805,"_31165":73804,"_21586":123769,"_5":14831,"_28346":73804,"_3068":123770},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3612":73806,"_31165":73804,"_5":31520,"_21586":123772,"_28346":123773,"_3068":123774},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3612":73807,"_31165":73804,"_5":31520,"_21586":123776,"_28346":123777,"_3068":123778},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3612":73808,"_31165":73804,"_5":31520,"_21586":123780,"_28346":123781,"_3068":123782},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3612":73809,"_31165":73804,"_5":31520,"_21586":123784,"_28346":123785,"_3068":123786},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3612":73810,"_31165":73804,"_5":31520,"_21586":123788,"_28346":123789,"_3068":123790},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3612":73811,"_31165":73804,"_21586":123792,"_5":14831,"_28346":73804,"_3068":123793},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3612":73812,"_31165":73804,"_21586":123795,"_5":14831,"_28346":123773,"_3068":123796},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3612":73813,"_31165":73804,"_21586":123798,"_5":14831,"_28346":123773,"_3068":123799},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3612":73814,"_31165":73804,"_21586":123801,"_5":14831,"_28346":123773,"_3068":123802},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3612":73815,"_31165":73804,"_21586":123804,"_5":14831,"_28346":123773,"_3068":123805},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3612":73816,"_31165":73804,"_21586":123807,"_5":14831,"_28346":123777,"_3068":123808},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3612":73817,"_31165":73804,"_21586":123810,"_5":14831,"_28346":123777,"_3068":123811},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3612":73818,"_31165":73804,"_21586":123813,"_5":14831,"_28346":123781,"_3068":123814},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3612":73819,"_31165":73804,"_21586":123816,"_5":14831,"_28346":123781,"_3068":123817},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3612":73820,"_31165":73804,"_21586":123819,"_5":14831,"_28346":123781,"_3068":123820},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3612":73821,"_31165":73804,"_21586":123822,"_5":14831,"_28346":123785,"_3068":123823},[],"Situación",{"_3612":73822,"_31165":73804,"_21586":123825,"_5":14831,"_28346":123785,"_3068":123826},[],"Procedimiento",{"_3612":73823,"_31165":73804,"_21586":123828,"_5":14831,"_28346":123785,"_3068":123829},[],"Certificado vigente, fuera de ventana",{"_3612":73824,"_31165":73804,"_21586":123831,"_5":14831,"_28346":123785,"_3068":123832},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3612":73825,"_31165":73804,"_21586":123834,"_5":14831,"_28346":123785,"_3068":123835},[],"Certificado vencido, clave disponible",{"_3612":73826,"_31165":73804,"_21586":123837,"_5":14831,"_28346":123785,"_3068":123838},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3612":73827,"_31165":73804,"_21586":123840,"_5":14831,"_28346":123785,"_3068":123841},[],"Renovación por webhook o `NO_AUTH`",{"_3612":73828,"_31165":73804,"_21586":123843,"_5":14831,"_28346":123785,"_3068":123844},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3612":73829,"_31165":73804,"_21586":123846,"_5":14831,"_28346":123785,"_3068":123847},[],"Clave perdida o inaccesible",{"_3612":73830,"_31165":73804,"_21586":123849,"_5":14831,"_28346":123785,"_3068":123850},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3612":73831,"_31165":73804,"_21586":123852,"_5":14831,"_28346":123785,"_3068":123853},[],"Identidad actual revocada",{"_3612":73832,"_31165":73804,"_21586":123855,"_5":14831,"_28346":123785,"_3068":123856},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3612":73833,"_31165":73804,"_21586":123858,"_5":14831,"_28346":123785,"_3068":123859},[],"Dispositivo sin identidad",{"_3612":73834,"_31165":73804,"_21586":123861,"_5":14831,"_28346":123785,"_3068":123862},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3612":73835,"_31165":73804,"_21586":123864,"_5":14831,"_28346":123785,"_3068":123865},[],"Dispositivo retirado",{"_3612":73836,"_31165":73804,"_21586":123867,"_5":14831,"_28346":123785,"_3068":123868},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3612":73837,"_31165":73804,"_21586":123870,"_5":14831,"_28346":123785,"_3068":123871},[],"Timeout, HTTP 500 o fallo de instalación",{"_3612":73838,"_31165":73804,"_21586":123873,"_5":14831,"_28346":123785,"_3068":123874},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3612":73839,"_31165":73804,"_21586":123876,"_5":14831,"_28346":123789,"_3068":123877},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3612":73840,"_31165":73804,"_21586":123879,"_5":14831,"_28346":123789,"_3068":123880},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3612":73841,"_31165":73841,"_5":15196,"_3068":123882,"_31523":123883,"_21586":123884,"_28346":73841},"Diagnóstico de enrolamiento",[50890,121593,53574,122738,122916],[],{"_3612":73842,"_31165":73841,"_21586":123886,"_5":14831,"_28346":73841,"_3068":123887},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3612":73843,"_31165":73841,"_5":31520,"_21586":123889,"_28346":123890,"_3068":123891},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3612":73844,"_31165":73841,"_5":31520,"_21586":123893,"_28346":123894,"_3068":123895},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3612":73845,"_31165":73841,"_5":31520,"_21586":123897,"_28346":123898,"_3068":123454},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3612":73846,"_31165":73841,"_5":31520,"_21586":123900,"_28346":123901,"_3068":123902},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3612":73847,"_31165":73841,"_21586":123904,"_5":14831,"_28346":73841,"_3068":123905},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3612":73848,"_31165":73841,"_21586":123907,"_5":14831,"_28346":123894,"_3068":123908},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3612":73849,"_31165":73841,"_21586":123910,"_5":14831,"_28346":123894,"_3068":123911},[],"Síntoma o mensaje",{"_3612":73850,"_31165":73841,"_21586":123913,"_5":14831,"_28346":123894,"_3068":123914},[],"Qué revisar",{"_3612":73851,"_31165":73841,"_21586":123916,"_5":14831,"_28346":123894,"_3068":123917},[],"curl rechaza TLS, nombre o emisor",{"_3612":73852,"_31165":73841,"_21586":123919,"_5":14831,"_28346":123894,"_3068":123920},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3612":73853,"_31165":73841,"_21586":123922,"_5":14831,"_28346":123894,"_3068":123923},[],"404 o APS ausente",{"_3612":73854,"_31165":73841,"_21586":123925,"_5":14831,"_28346":123894,"_3068":123926},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3612":73855,"_31165":73841,"_21586":123928,"_5":14831,"_28346":123894,"_3068":123929},[],"400, error de CSR o formato",{"_3612":73856,"_31165":73841,"_21586":123931,"_5":14831,"_28346":123894,"_3068":123932},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3612":73857,"_31165":73841,"_21586":123934,"_5":14831,"_28346":123894,"_3068":123935},[],"Credencial ausente o certificado no válido",{"_3612":73858,"_31165":73841,"_21586":123937,"_5":14831,"_28346":123894,"_3068":123938},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3612":73859,"_31165":73841,"_21586":123940,"_5":14831,"_28346":123894,"_3068":123941},[],"Webhook deniega, expira o responde sin autorización",{"_3612":73860,"_31165":73841,"_21586":123943,"_5":14831,"_28346":123894,"_3068":123944},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3612":73861,"_31165":73841,"_21586":123946,"_5":14831,"_28346":123894,"_3068":54828},[],{"_3612":73862,"_31165":73841,"_21586":123948,"_5":14831,"_28346":123894,"_3068":123949},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3612":73863,"_31165":73841,"_21586":123951,"_5":14831,"_28346":123894,"_3068":54834},[],{"_3612":73864,"_31165":73841,"_21586":123953,"_5":14831,"_28346":123894,"_3068":123954},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3612":73865,"_31165":73841,"_21586":123956,"_5":14831,"_28346":123894,"_3068":54840},[],{"_3612":73866,"_31165":73841,"_21586":123958,"_5":14831,"_28346":123894,"_3068":123959},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3612":73867,"_31165":73841,"_21586":123961,"_5":14831,"_28346":123894,"_3068":54846},[],{"_3612":73868,"_31165":73841,"_21586":123963,"_5":14831,"_28346":123894,"_3068":123964},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3612":73869,"_31165":73841,"_21586":123966,"_5":14831,"_28346":123894,"_3068":54852},[],{"_3612":73870,"_31165":73841,"_21586":123968,"_5":14831,"_28346":123894,"_3068":123969},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3612":73871,"_31165":73841,"_21586":123971,"_5":14831,"_28346":123894,"_3068":123972},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3612":73872,"_31165":73841,"_21586":123974,"_5":14831,"_28346":123894,"_3068":123975},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3612":73873,"_31165":73841,"_21586":123977,"_5":14831,"_28346":123894,"_3068":123978},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3612":73874,"_31165":73841,"_21586":123980,"_5":14831,"_28346":123894,"_3068":123981},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3612":73875,"_31165":73841,"_21586":123983,"_5":14831,"_28346":123894,"_3068":54870},[],{"_3612":73876,"_31165":73841,"_21586":123985,"_5":14831,"_28346":123894,"_3068":123986},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3612":73877,"_31165":73841,"_21586":123988,"_5":14831,"_28346":123894,"_3068":54876},[],{"_3612":73878,"_31165":73841,"_21586":123990,"_5":14831,"_28346":123894,"_3068":123991},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3612":73879,"_31165":73841,"_21586":123993,"_5":14831,"_28346":123894,"_3068":123994},[],"DMS propietario distinto",{"_3612":73880,"_31165":73841,"_21586":123996,"_5":14831,"_28346":123894,"_3068":123997},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3612":73881,"_31165":73841,"_21586":123999,"_5":14831,"_28346":123894,"_3068":54888},[],{"_3612":73882,"_31165":73841,"_21586":124001,"_5":14831,"_28346":123894,"_3068":124002},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3612":73883,"_31165":73841,"_21586":124004,"_5":14831,"_28346":123894,"_3068":54894},[],{"_3612":73884,"_31165":73841,"_21586":124006,"_5":14831,"_28346":123894,"_3068":124007},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3612":73885,"_31165":73841,"_21586":124009,"_5":14831,"_28346":123894,"_3068":124010},[],"Certificado actual revocado",{"_3612":73886,"_31165":73841,"_21586":124012,"_5":14831,"_28346":123894,"_3068":124013},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3612":73887,"_31165":73841,"_21586":124015,"_5":14831,"_28346":123894,"_3068":124016},[],"Error de CA, perfil o firma",{"_3612":73888,"_31165":73841,"_21586":124018,"_5":14831,"_28346":123894,"_3068":124019},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3612":73889,"_31165":73841,"_21586":124021,"_5":14831,"_28346":123894,"_3068":124022},[],"HTTP 200 sin conexión del dispositivo",{"_3612":73890,"_31165":73841,"_21586":124024,"_5":14831,"_28346":123894,"_3068":124025},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3612":73891,"_31165":73841,"_21586":124027,"_5":14831,"_28346":123894,"_3068":124028},[],"Timeout o error después de emitir",{"_3612":73892,"_31165":73841,"_21586":124030,"_5":14831,"_28346":123894,"_3068":124031},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3612":73893,"_31165":73841,"_21586":124033,"_5":14831,"_28346":123898,"_3068":124034},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3612":73894,"_31165":73841,"_21586":124036,"_5":14831,"_28346":123898,"_3068":124037},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3612":73895,"_31165":73841,"_21586":124039,"_5":14831,"_28346":123901,"_3068":124040},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3612":73896,"_31165":73841,"_21586":124042,"_5":14831,"_28346":123901,"_3068":124043},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3612":73897,"_31165":73841,"_21586":124045,"_5":14831,"_28346":123901,"_3068":124046},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3612":73898,"_31165":73841,"_21586":124048,"_5":14831,"_28346":123901,"_3068":124049},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3612":73899,"_31165":73841,"_21586":124051,"_5":14831,"_28346":123901,"_3068":124052},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3612":73900,"_31165":73841,"_21586":124054,"_5":14831,"_28346":123901,"_3068":124055},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3612":73901,"_31165":73841,"_21586":124057,"_5":14831,"_28346":123901,"_3068":124058},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3612":73902,"_31165":73902,"_5":15196,"_3068":124060,"_31523":124061,"_21586":124062,"_28346":73902},"Distribución y actualización de confianza",[50890,121593,53574,122738,122916],[],{"_3612":73903,"_31165":73902,"_21586":124064,"_5":14831,"_28346":73902,"_3068":124065},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3612":73904,"_31165":73902,"_5":31520,"_21586":124067,"_28346":124068,"_3068":124069},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3612":73905,"_31165":73902,"_5":31520,"_21586":124071,"_28346":124072,"_3068":124073},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3612":73906,"_31165":73902,"_5":31520,"_21586":124075,"_28346":124076,"_3068":124077},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3612":73907,"_31165":73902,"_5":31520,"_21586":124079,"_28346":124080,"_3068":124081},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3612":73908,"_31165":73902,"_5":31520,"_21586":124083,"_28346":124084,"_3068":124085},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3612":73909,"_31165":73902,"_21586":124087,"_5":14831,"_28346":73902,"_3068":124088},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3612":73910,"_31165":73902,"_21586":124090,"_5":14831,"_28346":124068,"_3068":124091},[],"Relación",{"_3612":73911,"_31165":73902,"_21586":124093,"_5":14831,"_28346":124068,"_3068":124094},[],"Material que prepara el responsable",{"_3612":73912,"_31165":73902,"_21586":124096,"_5":14831,"_28346":124068,"_3068":124097},[],"Dispositivo → servidor EST",{"_3612":73913,"_31165":73902,"_21586":124099,"_5":14831,"_28346":124068,"_3068":124100},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3612":73914,"_31165":73902,"_21586":124102,"_5":14831,"_28346":124068,"_3068":124103},[],"DMS → solicitante",{"_3612":73915,"_31165":73902,"_21586":124105,"_5":14831,"_28346":124068,"_3068":124106},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3612":73916,"_31165":73902,"_21586":124108,"_5":14831,"_28346":124068,"_3068":124109},[],"Consumidor → dispositivo",{"_3612":73917,"_31165":73902,"_21586":124111,"_5":14831,"_28346":124068,"_3068":124112},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3612":73918,"_31165":73902,"_21586":124114,"_5":14831,"_28346":124068,"_3068":124115},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3612":73919,"_31165":73902,"_21586":124117,"_5":14831,"_28346":124072,"_3068":124118},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3612":73920,"_31165":73902,"_21586":124120,"_5":14831,"_28346":124072,"_3068":124121},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3612":73921,"_31165":73902,"_21586":124123,"_5":14831,"_28346":124076,"_3068":124124},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3612":73922,"_31165":73902,"_21586":124126,"_5":14831,"_28346":124076,"_3068":124127},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3612":73923,"_31165":73902,"_21586":124129,"_5":14831,"_28346":124076,"_3068":124130},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3612":73924,"_31165":73902,"_21586":124132,"_5":14831,"_28346":124076,"_3068":124133},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3612":73925,"_31165":73902,"_21586":124135,"_5":14831,"_28346":124076,"_3068":124136},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3612":73926,"_31165":73902,"_21586":124138,"_5":14831,"_28346":124076,"_3068":124139},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3612":73927,"_31165":73902,"_21586":124141,"_5":14831,"_28346":124080,"_3068":124142},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3612":73928,"_31165":73902,"_21586":124144,"_5":14831,"_28346":124080,"_3068":124145},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3612":73929,"_31165":73902,"_21586":124147,"_5":14831,"_28346":124080,"_3068":124148},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3612":73930,"_31165":73902,"_21586":124150,"_5":14831,"_28346":124084,"_3068":124151},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3612":73931,"_31165":73931,"_5":15196,"_3068":55043,"_31523":124153,"_21586":124155,"_28346":73931},[50890,121593,53574,122738,124154],"Integraciones",[],{"_3612":73932,"_31165":73931,"_21586":124157,"_5":14831,"_28346":73931,"_3068":124158},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3612":73933,"_31165":73931,"_5":31520,"_21586":124160,"_28346":124161,"_3068":124162},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3612":73934,"_31165":73931,"_5":31520,"_21586":124164,"_28346":124165,"_3068":124166},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3612":73935,"_31165":73931,"_5":31520,"_21586":124168,"_28346":124169,"_3068":124170},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3612":73936,"_31165":73931,"_5":31520,"_21586":124172,"_28346":124173,"_3068":124174},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3612":73937,"_31165":73931,"_5":31520,"_21586":124176,"_28346":124177,"_3068":124178},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3612":73938,"_31165":73931,"_5":31520,"_21586":124180,"_28346":124181,"_3068":124182},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3612":73939,"_31165":73931,"_5":31520,"_21586":124184,"_28346":124185,"_3068":124186},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3612":73940,"_31165":73931,"_5":31520,"_21586":124188,"_28346":124189,"_3068":124190},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3612":73941,"_31165":73931,"_5":31520,"_21586":124192,"_28346":124193,"_3068":55085},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3612":73942,"_31165":73931,"_5":31520,"_21586":124195,"_28346":124196,"_3068":55089},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3612":73943,"_31165":73931,"_5":31520,"_21586":124198,"_28346":124199,"_3068":124200},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3612":73944,"_31165":73931,"_5":31520,"_21586":124202,"_28346":124203,"_3068":124204},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3612":73945,"_31165":73931,"_5":31520,"_21586":124206,"_28346":124207,"_3068":124208},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3612":73946,"_31165":73931,"_5":31520,"_21586":124210,"_28346":124211,"_3068":124212},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3612":73947,"_31165":73931,"_5":31520,"_21586":124214,"_28346":124215,"_3068":124216},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3612":73948,"_31165":73931,"_5":31520,"_21586":124218,"_28346":124219,"_3068":124220},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3612":73949,"_31165":73931,"_5":31520,"_21586":124222,"_28346":124223,"_3068":124224},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3612":73950,"_31165":73931,"_5":31520,"_21586":124226,"_28346":124227,"_3068":124228},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3612":73951,"_31165":73931,"_5":31520,"_21586":124230,"_28346":124231,"_3068":124232},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3612":73952,"_31165":73931,"_5":31520,"_21586":124234,"_28346":124235,"_3068":124236},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3612":73953,"_31165":73931,"_5":31520,"_21586":124238,"_28346":124239,"_3068":124240},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3612":73954,"_31165":73931,"_5":31520,"_21586":124242,"_28346":124243,"_3068":124244},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3612":73955,"_31165":73931,"_5":31520,"_21586":124246,"_28346":124247,"_3068":124248},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3612":73956,"_31165":73931,"_5":31520,"_21586":124250,"_28346":124251,"_3068":124252},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3612":73957,"_31165":73931,"_5":31520,"_21586":124254,"_28346":124255,"_3068":124256},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3612":73958,"_31165":73931,"_21586":124258,"_5":14831,"_28346":73931,"_3068":124259},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3612":73959,"_31165":73931,"_21586":124261,"_5":14831,"_28346":73931,"_3068":124262},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3612":73960,"_31165":73931,"_21586":124264,"_5":14831,"_28346":73931,"_3068":124265},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3612":73961,"_31165":73931,"_21586":124267,"_5":14831,"_28346":124161,"_3068":124268},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3612":73962,"_31165":73931,"_21586":124270,"_5":14831,"_28346":124161,"_3068":124271},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3612":73963,"_31165":73931,"_21586":124273,"_5":14831,"_28346":124161,"_3068":124274},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3612":73964,"_31165":73931,"_21586":124276,"_5":14831,"_28346":124161,"_3068":124277},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3612":73965,"_31165":73931,"_21586":124279,"_5":14831,"_28346":124165,"_3068":124280},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3612":73966,"_31165":73931,"_21586":124282,"_5":14831,"_28346":124169,"_3068":124283},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3612":73967,"_31165":73931,"_21586":124285,"_5":14831,"_28346":124169,"_3068":124286},[],"Acción IAM",{"_3612":73968,"_31165":73931,"_21586":124288,"_5":14831,"_28346":124169,"_3068":120497},[],{"_3612":73969,"_31165":73931,"_21586":124290,"_5":14831,"_28346":124169,"_3068":55184},[],{"_3612":73970,"_31165":73931,"_21586":124292,"_5":14831,"_28346":124169,"_3068":124293},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3612":73971,"_31165":73931,"_21586":124295,"_5":14831,"_28346":124169,"_3068":55190},[],{"_3612":73972,"_31165":73931,"_21586":124297,"_5":14831,"_28346":124169,"_3068":124298},[],"Registrar la CA en AWS IoT",{"_3612":73973,"_31165":73931,"_21586":124300,"_5":14831,"_28346":124169,"_3068":55196},[],{"_3612":73974,"_31165":73931,"_21586":124302,"_5":14831,"_28346":124169,"_3068":124303},[],"Consultar el estado del registro de la CA",{"_3612":73975,"_31165":73931,"_21586":124305,"_5":14831,"_28346":124169,"_3068":55202},[],{"_3612":73976,"_31165":73931,"_21586":124307,"_5":14831,"_28346":124169,"_3068":124308},[],"Crear o actualizar Things en IoT Core",{"_3612":73977,"_31165":73931,"_21586":124310,"_5":14831,"_28346":124169,"_3068":55208},[],{"_3612":73978,"_31165":73931,"_21586":124312,"_5":14831,"_28346":124169,"_3068":124313},[],"Aprovisionar Things mediante plantilla",{"_3612":73979,"_31165":73931,"_21586":124315,"_5":14831,"_28346":124169,"_3068":55214},[],{"_3612":73980,"_31165":73931,"_21586":124317,"_5":14831,"_28346":124169,"_3068":124318},[],"Registrar certificados de dispositivo",{"_3612":73981,"_31165":73931,"_21586":124320,"_5":14831,"_28346":124169,"_3068":55220},[],{"_3612":73982,"_31165":73931,"_21586":124322,"_5":14831,"_28346":124169,"_3068":124323},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3612":73983,"_31165":73931,"_21586":124325,"_5":14831,"_28346":124169,"_3068":55226},[],{"_3612":73984,"_31165":73931,"_21586":124327,"_5":14831,"_28346":124169,"_3068":124328},[],"Crear y adjuntar políticas IoT",{"_3612":73985,"_31165":73931,"_21586":124330,"_5":14831,"_28346":124169,"_3068":55232},[],{"_3612":73986,"_31165":73931,"_21586":124332,"_5":14831,"_28346":124169,"_3068":124333},[],"Gestionar grupos de Things",{"_3612":73987,"_31165":73931,"_21586":124335,"_5":14831,"_28346":124169,"_3068":55238},[],{"_3612":73988,"_31165":73931,"_21586":124337,"_5":14831,"_28346":124169,"_3068":124338},[],"Crear plantillas JITP",{"_3612":73989,"_31165":73931,"_21586":124340,"_5":14831,"_28346":124169,"_3068":55244},[],{"_3612":73990,"_31165":73931,"_21586":124342,"_5":14831,"_28346":124169,"_3068":124343},[],"Leer y escribir el Device Shadow",{"_3612":73991,"_31165":73931,"_21586":124345,"_5":14831,"_28346":124169,"_3068":124346},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3612":73992,"_31165":73931,"_21586":124348,"_5":14831,"_28346":124173,"_3068":124349},[],"Parámetro",{"_3612":73993,"_31165":73931,"_21586":124351,"_5":14831,"_28346":124173,"_3068":124352},[],"Tipo",{"_3612":73994,"_31165":73931,"_21586":124354,"_5":14831,"_28346":124173,"_3068":124355},[],"Requerido",{"_3612":73995,"_31165":73931,"_21586":124357,"_5":14831,"_28346":124173,"_3068":124358},[],"Descripción",{"_3612":73996,"_31165":73931,"_21586":124360,"_5":14831,"_28346":124173,"_3068":55265},[],{"_3612":73997,"_31165":73931,"_21586":124362,"_5":14831,"_28346":124173,"_3068":25766},[],{"_3612":73998,"_31165":73931,"_21586":124364,"_5":14831,"_28346":124173,"_3068":124365},[],"Sí",{"_3612":73999,"_31165":73931,"_21586":124367,"_5":14831,"_28346":124173,"_3068":124368},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3612":74000,"_31165":73931,"_21586":124370,"_5":14831,"_28346":124173,"_3068":55276},[],{"_3612":74001,"_31165":73931,"_21586":124372,"_5":14831,"_28346":124173,"_3068":25766},[],{"_3612":74002,"_31165":73931,"_21586":124374,"_5":14831,"_28346":124173,"_3068":124365},[],{"_3612":74003,"_31165":73931,"_21586":124376,"_5":14831,"_28346":124173,"_3068":124377},[],"Región AWS donde opera el conector.",{"_3612":74004,"_31165":73931,"_21586":124379,"_5":14831,"_28346":124173,"_3068":55286},[],{"_3612":74005,"_31165":73931,"_21586":124381,"_5":14831,"_28346":124173,"_3068":25766},[],{"_3612":74006,"_31165":73931,"_21586":124383,"_5":14831,"_28346":124173,"_3068":124365},[],{"_3612":74007,"_31165":73931,"_21586":124385,"_5":14831,"_28346":124173,"_3068":124386},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3612":74008,"_31165":73931,"_21586":124388,"_5":14831,"_28346":124173,"_3068":55296},[],{"_3612":74009,"_31165":73931,"_21586":124390,"_5":14831,"_28346":124173,"_3068":25766},[],{"_3612":74010,"_31165":73931,"_21586":124392,"_5":14831,"_28346":124173,"_3068":124393},[],"Solo con `auth_method=static`",{"_3612":74011,"_31165":73931,"_21586":124395,"_5":14831,"_28346":124173,"_3068":124396},[],"Clave de acceso AWS.",{"_3612":74012,"_31165":73931,"_21586":124398,"_5":14831,"_28346":124173,"_3068":55307},[],{"_3612":74013,"_31165":73931,"_21586":124400,"_5":14831,"_28346":124173,"_3068":25766},[],{"_3612":74014,"_31165":73931,"_21586":124402,"_5":14831,"_28346":124173,"_3068":124393},[],{"_3612":74015,"_31165":73931,"_21586":124404,"_5":14831,"_28346":124173,"_3068":124405},[],"Clave secreta AWS.",{"_3612":74016,"_31165":73931,"_21586":124407,"_5":14831,"_28346":124173,"_3068":55317},[],{"_3612":74017,"_31165":73931,"_21586":124409,"_5":14831,"_28346":124173,"_3068":25766},[],{"_3612":74018,"_31165":73931,"_21586":124411,"_5":14831,"_28346":124173,"_3068":55322},[],{"_3612":74019,"_31165":73931,"_21586":124413,"_5":14831,"_28346":124173,"_3068":124414},[],"Token de sesión (con `auth_method=static`).",{"_3612":74020,"_31165":73931,"_21586":124416,"_5":14831,"_28346":124173,"_3068":55328},[],{"_3612":74021,"_31165":73931,"_21586":124418,"_5":14831,"_28346":124173,"_3068":25766},[],{"_3612":74022,"_31165":73931,"_21586":124420,"_5":14831,"_28346":124173,"_3068":124421},[],"Solo con `auth_method=role`",{"_3612":74023,"_31165":73931,"_21586":124423,"_5":14831,"_28346":124173,"_3068":124424},[],"ARN del rol a asumir.",{"_3612":74024,"_31165":73931,"_21586":124426,"_5":14831,"_28346":124173,"_3068":55339},[],{"_3612":74025,"_31165":73931,"_21586":124428,"_5":14831,"_28346":124173,"_3068":25766},[],{"_3612":74026,"_31165":73931,"_21586":124430,"_5":14831,"_28346":124173,"_3068":55322},[],{"_3612":74027,"_31165":73931,"_21586":124432,"_5":14831,"_28346":124173,"_3068":124433},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3612":74028,"_31165":73931,"_21586":124435,"_5":14831,"_28346":124173,"_3068":55349},[],{"_3612":74029,"_31165":73931,"_21586":124437,"_5":14831,"_28346":124173,"_3068":92760},[],{"_3612":74030,"_31165":73931,"_21586":124439,"_5":14831,"_28346":124173,"_3068":124365},[],{"_3612":74031,"_31165":73931,"_21586":124441,"_5":14831,"_28346":124173,"_3068":124442},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3612":74032,"_31165":73931,"_21586":124444,"_5":14831,"_28346":124173,"_3068":55359},[],{"_3612":74033,"_31165":73931,"_21586":124446,"_5":14831,"_28346":124173,"_3068":25766},[],{"_3612":74034,"_31165":73931,"_21586":124448,"_5":14831,"_28346":124173,"_3068":124365},[],{"_3612":74035,"_31165":73931,"_21586":124450,"_5":14831,"_28346":124173,"_3068":124451},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3612":74036,"_31165":73931,"_21586":124453,"_5":14831,"_28346":124173,"_3068":55369},[],{"_3612":74037,"_31165":73931,"_21586":124455,"_5":14831,"_28346":124173,"_3068":25766},[],{"_3612":74038,"_31165":73931,"_21586":124457,"_5":14831,"_28346":124173,"_3068":124365},[],{"_3612":74039,"_31165":73931,"_21586":124459,"_5":14831,"_28346":124173,"_3068":124460},[],"URL HTTP del Device Manager de Lamassu.",{"_3612":74040,"_31165":73931,"_21586":124462,"_5":14831,"_28346":124173,"_3068":55379},[],{"_3612":74041,"_31165":73931,"_21586":124464,"_5":14831,"_28346":124173,"_3068":25766},[],{"_3612":74042,"_31165":73931,"_21586":124466,"_5":14831,"_28346":124173,"_3068":124365},[],{"_3612":74043,"_31165":73931,"_21586":124468,"_5":14831,"_28346":124173,"_3068":124469},[],"URL HTTP del servicio de CA de Lamassu.",{"_3612":74044,"_31165":73931,"_21586":124471,"_5":14831,"_28346":124177,"_3068":124472},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3612":74045,"_31165":73931,"_21586":124474,"_5":14831,"_28346":124177,"_3068":124475},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3612":74046,"_31165":73931,"_21586":124477,"_5":14831,"_28346":124177,"_3068":124478},[],"Tipo de CloudEvent",{"_3612":74047,"_31165":73931,"_21586":124480,"_5":14831,"_28346":124177,"_3068":124481},[],"Recurso en Lamassu",{"_3612":74048,"_31165":73931,"_21586":124483,"_5":14831,"_28346":124177,"_3068":124484},[],"Recurso AWS",{"_3612":74049,"_31165":73931,"_21586":124486,"_5":14831,"_28346":124177,"_3068":124487},[],"Acciones IAM",{"_3612":74050,"_31165":73931,"_21586":124489,"_5":14831,"_28346":124177,"_3068":124490},[],"Llamadas AWS y efecto",{"_3612":74051,"_31165":73931,"_21586":124492,"_5":14831,"_28346":124177,"_3068":124493},[],"Dónde en esta página",{"_3612":74052,"_31165":73931,"_21586":124495,"_5":14831,"_28346":124177,"_3068":55413},[],{"_3612":74053,"_31165":73931,"_21586":124497,"_5":14831,"_28346":124177,"_3068":55416},[],{"_3612":74054,"_31165":73931,"_21586":124499,"_5":14831,"_28346":124177,"_3068":55419},[],{"_3612":74055,"_31165":73931,"_21586":124501,"_5":14831,"_28346":124177,"_3068":55422},[],{"_3612":74056,"_31165":73931,"_21586":124503,"_5":14831,"_28346":124177,"_3068":124504},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3612":74057,"_31165":73931,"_21586":124506,"_5":14831,"_28346":124177,"_3068":124190},[],{"_3612":74058,"_31165":73931,"_21586":124508,"_5":14831,"_28346":124177,"_3068":55430},[],{"_3612":74059,"_31165":73931,"_21586":124510,"_5":14831,"_28346":124177,"_3068":55433},[],{"_3612":74060,"_31165":73931,"_21586":124512,"_5":14831,"_28346":124177,"_3068":55436},[],{"_3612":74061,"_31165":73931,"_21586":124514,"_5":14831,"_28346":124177,"_3068":55439},[],{"_3612":74062,"_31165":73931,"_21586":124516,"_5":14831,"_28346":124177,"_3068":124517},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3612":74063,"_31165":73931,"_21586":124519,"_5":14831,"_28346":124177,"_3068":124216},[],{"_3612":74064,"_31165":73931,"_21586":124521,"_5":14831,"_28346":124177,"_3068":55447},[],{"_3612":74065,"_31165":73931,"_21586":124523,"_5":14831,"_28346":124177,"_3068":124524},[],"Dispositivo",{"_3612":74066,"_31165":73931,"_21586":124526,"_5":14831,"_28346":124177,"_3068":55453},[],{"_3612":74067,"_31165":73931,"_21586":124528,"_5":14831,"_28346":124177,"_3068":55456},[],{"_3612":74068,"_31165":73931,"_21586":124530,"_5":14831,"_28346":124177,"_3068":124531},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3612":74069,"_31165":73931,"_21586":124533,"_5":14831,"_28346":124177,"_3068":124224},[],{"_3612":74070,"_31165":73931,"_21586":124535,"_5":14831,"_28346":124177,"_3068":55464},[],{"_3612":74071,"_31165":73931,"_21586":124537,"_5":14831,"_28346":124177,"_3068":124538},[],"Certificado",{"_3612":74072,"_31165":73931,"_21586":124540,"_5":14831,"_28346":124177,"_3068":55470},[],{"_3612":74073,"_31165":73931,"_21586":124542,"_5":14831,"_28346":124177,"_3068":124543},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3612":74074,"_31165":73931,"_21586":124545,"_5":14831,"_28346":124177,"_3068":124546},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3612":74075,"_31165":73931,"_21586":124548,"_5":14831,"_28346":124177,"_3068":124236},[],{"_3612":74076,"_31165":73931,"_21586":124550,"_5":14831,"_28346":124177,"_3068":55481},[],{"_3612":74077,"_31165":73931,"_21586":124552,"_5":14831,"_28346":124177,"_3068":124553},[],"Certificado / Dispositivo",{"_3612":74078,"_31165":73931,"_21586":124555,"_5":14831,"_28346":124177,"_3068":55487},[],{"_3612":74079,"_31165":73931,"_21586":124557,"_5":14831,"_28346":124177,"_3068":51286},[],{"_3612":74080,"_31165":73931,"_21586":124559,"_5":14831,"_28346":124177,"_3068":124560},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3612":74081,"_31165":73931,"_21586":124562,"_5":14831,"_28346":124177,"_3068":124244},[],{"_3612":74082,"_31165":73931,"_21586":124564,"_5":14831,"_28346":124181,"_3068":124565},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3612":74083,"_31165":73931,"_21586":124567,"_5":14831,"_28346":124185,"_3068":124568},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3612":74084,"_31165":73931,"_21586":124570,"_5":14831,"_28346":124185,"_3068":124571},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3612":74085,"_31165":73931,"_21586":124573,"_5":14831,"_28346":124189,"_3068":124574},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3612":74086,"_31165":73931,"_21586":124576,"_5":14831,"_28346":124189,"_3068":124577},[],"Transición",{"_3612":74087,"_31165":73931,"_21586":124579,"_5":14831,"_28346":124189,"_3068":124580},[],"Llamadas AWS",{"_3612":74088,"_31165":73931,"_21586":124582,"_5":14831,"_28346":124189,"_3068":124583},[],"`NoRegistrada` → `Solicitada`",{"_3612":74089,"_31165":73931,"_21586":124585,"_5":14831,"_28346":124189,"_3068":124586},[],"ninguna (solo escritura de metadatos)",{"_3612":74090,"_31165":73931,"_21586":124588,"_5":14831,"_28346":124189,"_3068":124589},[],"`Solicitada` → `Registrando`",{"_3612":74091,"_31165":73931,"_21586":124591,"_5":14831,"_28346":124189,"_3068":124592},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3612":74092,"_31165":73931,"_21586":124594,"_5":14831,"_28346":124189,"_3068":124595},[],"`Registrando` → `Completada`",{"_3612":74093,"_31165":73931,"_21586":124597,"_5":14831,"_28346":124189,"_3068":124598},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3612":74094,"_31165":73931,"_21586":124600,"_5":14831,"_28346":124189,"_3068":124601},[],"`Registrando` → `Fallida`",{"_3612":74095,"_31165":73931,"_21586":124603,"_5":14831,"_28346":124189,"_3068":124604},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3612":74096,"_31165":73931,"_21586":124606,"_5":14831,"_28346":124189,"_3068":124607},[],"`Fallida` / `Completada` → `Solicitada`",{"_3612":74097,"_31165":73931,"_21586":124609,"_5":14831,"_28346":124189,"_3068":124610},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3612":74098,"_31165":73931,"_21586":124612,"_5":14831,"_28346":124193,"_3068":124613},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3612":74099,"_31165":73931,"_21586":124615,"_5":14831,"_28346":124193,"_3068":124616},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3612":74100,"_31165":73931,"_21586":124618,"_5":14831,"_28346":124193,"_3068":124619},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3612":74101,"_31165":73931,"_21586":124621,"_5":14831,"_28346":124193,"_3068":124622},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3612":74102,"_31165":73931,"_21586":124624,"_5":14831,"_28346":124193,"_3068":124625},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3612":74103,"_31165":73931,"_21586":124627,"_5":14831,"_28346":124193,"_3068":124628},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3612":74104,"_31165":73931,"_21586":124630,"_5":14831,"_28346":124196,"_3068":124631},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3612":74105,"_31165":73931,"_21586":124633,"_5":14831,"_28346":124199,"_3068":124634},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3612":74106,"_31165":73931,"_21586":124636,"_5":14831,"_28346":124199,"_3068":124637},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3612":74107,"_31165":73931,"_21586":124639,"_5":14831,"_28346":124203,"_3068":124640},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3612":74108,"_31165":73931,"_21586":124642,"_5":14831,"_28346":124207,"_3068":124643},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3612":74109,"_31165":73931,"_21586":124645,"_5":14831,"_28346":124207,"_3068":124646},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3612":74110,"_31165":73931,"_21586":124648,"_5":14831,"_28346":124207,"_3068":124649},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3612":74111,"_31165":73931,"_21586":124651,"_5":14831,"_28346":124207,"_3068":124652},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3612":74112,"_31165":73931,"_21586":124654,"_5":14831,"_28346":124207,"_3068":124655},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3612":74113,"_31165":73931,"_21586":124657,"_5":14831,"_28346":124207,"_3068":124658},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3612":74114,"_31165":73931,"_21586":124660,"_5":14831,"_28346":124211,"_3068":124661},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3612":74115,"_31165":73931,"_21586":124663,"_5":14831,"_28346":124211,"_3068":124664},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3612":74116,"_31165":73931,"_21586":124666,"_5":14831,"_28346":124211,"_3068":124667},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3612":74117,"_31165":73931,"_21586":124669,"_5":14831,"_28346":124211,"_3068":124670},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3612":74118,"_31165":73931,"_21586":124672,"_5":14831,"_28346":124211,"_3068":124673},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3612":74119,"_31165":73931,"_21586":124675,"_5":14831,"_28346":124215,"_3068":124676},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3612":74120,"_31165":73931,"_21586":124678,"_5":14831,"_28346":124215,"_3068":124577},[],{"_3612":74121,"_31165":73931,"_21586":124680,"_5":14831,"_28346":124215,"_3068":124580},[],{"_3612":74122,"_31165":73931,"_21586":124682,"_5":14831,"_28346":124215,"_3068":124683},[],"`SinConfigurar` → `None` / `Auto`",{"_3612":74123,"_31165":73931,"_21586":124685,"_5":14831,"_28346":124215,"_3068":124686},[],"ninguna (solo configuración)",{"_3612":74124,"_31165":73931,"_21586":124688,"_5":14831,"_28346":124215,"_3068":55624},[],{"_3612":74125,"_31165":73931,"_21586":124690,"_5":14831,"_28346":124215,"_3068":124686},[],{"_3612":74126,"_31165":73931,"_21586":124692,"_5":14831,"_28346":124215,"_3068":124693},[],"Cualquiera → `Jitp`",{"_3612":74127,"_31165":73931,"_21586":124695,"_5":14831,"_28346":124215,"_3068":124696},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3612":74128,"_31165":73931,"_21586":124698,"_5":14831,"_28346":124215,"_3068":55635},[],{"_3612":74129,"_31165":73931,"_21586":124700,"_5":14831,"_28346":124215,"_3068":124701},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3612":74130,"_31165":73931,"_21586":124703,"_5":14831,"_28346":124219,"_3068":124704},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3612":74131,"_31165":73931,"_21586":124706,"_5":14831,"_28346":124219,"_3068":124707},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3612":74132,"_31165":73931,"_21586":124709,"_5":14831,"_28346":124219,"_3068":124710},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3612":74133,"_31165":73931,"_21586":124712,"_5":14831,"_28346":124223,"_3068":124713},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3612":74134,"_31165":73931,"_21586":124715,"_5":14831,"_28346":124223,"_3068":124577},[],{"_3612":74135,"_31165":73931,"_21586":124717,"_5":14831,"_28346":124223,"_3068":124580},[],{"_3612":74136,"_31165":73931,"_21586":124719,"_5":14831,"_28346":124223,"_3068":124720},[],"`Ausente` → `Aprovisionado`",{"_3612":74137,"_31165":73931,"_21586":124722,"_5":14831,"_28346":124223,"_3068":124723},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3612":74138,"_31165":73931,"_21586":124725,"_5":14831,"_28346":124223,"_3068":124726},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3612":74139,"_31165":73931,"_21586":124728,"_5":14831,"_28346":124223,"_3068":124729},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3612":74140,"_31165":73931,"_21586":124731,"_5":14831,"_28346":124223,"_3068":124732},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3612":74141,"_31165":73931,"_21586":124734,"_5":14831,"_28346":124227,"_3068":124735},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3612":74142,"_31165":73931,"_21586":124737,"_5":14831,"_28346":124227,"_3068":124738},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3612":74143,"_31165":73931,"_21586":124740,"_5":14831,"_28346":124227,"_3068":124741},[],"Para que el flujo JITP funcione correctamente:",{"_3612":74144,"_31165":73931,"_21586":124743,"_5":14831,"_28346":124227,"_3068":124744},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3612":74145,"_31165":73931,"_21586":124746,"_5":14831,"_28346":124227,"_3068":124747},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3612":74146,"_31165":73931,"_21586":124749,"_5":14831,"_28346":124227,"_3068":124750},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3612":74147,"_31165":73931,"_21586":124752,"_5":14831,"_28346":124227,"_3068":124753},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3612":74148,"_31165":73931,"_21586":124755,"_5":14831,"_28346":124231,"_3068":124756},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3612":74149,"_31165":73931,"_21586":124758,"_5":14831,"_28346":124231,"_3068":124759},[],"Estado en Lamassu",{"_3612":74150,"_31165":73931,"_21586":124761,"_5":14831,"_28346":124231,"_3068":124762},[],"Razón de revocación",{"_3612":74151,"_31165":73931,"_21586":124764,"_5":14831,"_28346":124231,"_3068":124765},[],"Estado en AWS IoT Core",{"_3612":74152,"_31165":73931,"_21586":124767,"_5":14831,"_28346":124231,"_3068":55705},[],{"_3612":74153,"_31165":73931,"_21586":124769,"_5":14831,"_28346":124231,"_3068":124770},[],"Ninguna",{"_3612":74154,"_31165":73931,"_21586":124772,"_5":14831,"_28346":124231,"_3068":55711},[],{"_3612":74155,"_31165":73931,"_21586":124774,"_5":14831,"_28346":124231,"_3068":55714},[],{"_3612":74156,"_31165":73931,"_21586":124776,"_5":14831,"_28346":124231,"_3068":55717},[],{"_3612":74157,"_31165":73931,"_21586":124778,"_5":14831,"_28346":124231,"_3068":55720},[],{"_3612":74158,"_31165":73931,"_21586":124780,"_5":14831,"_28346":124231,"_3068":55714},[],{"_3612":74159,"_31165":73931,"_21586":124782,"_5":14831,"_28346":124231,"_3068":124783},[],"Cualquier otra razón",{"_3612":74160,"_31165":73931,"_21586":124785,"_5":14831,"_28346":124231,"_3068":55728},[],{"_3612":74161,"_31165":73931,"_21586":124787,"_5":14831,"_28346":124231,"_3068":124788},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3612":74162,"_31165":73931,"_21586":124790,"_5":14831,"_28346":124235,"_3068":124791},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3612":74163,"_31165":73931,"_21586":124793,"_5":14831,"_28346":124235,"_3068":124577},[],{"_3612":74164,"_31165":73931,"_21586":124795,"_5":14831,"_28346":124235,"_3068":124580},[],{"_3612":74165,"_31165":73931,"_21586":124797,"_5":14831,"_28346":124235,"_3068":124798},[],"`NoSincronizado` → `Active`",{"_3612":74166,"_31165":73931,"_21586":124800,"_5":14831,"_28346":124235,"_3068":55220},[],{"_3612":74167,"_31165":73931,"_21586":124802,"_5":14831,"_28346":124235,"_3068":55746},[],{"_3612":74168,"_31165":73931,"_21586":124804,"_5":14831,"_28346":124235,"_3068":124805},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3612":74169,"_31165":73931,"_21586":124807,"_5":14831,"_28346":124235,"_3068":55752},[],{"_3612":74170,"_31165":73931,"_21586":124809,"_5":14831,"_28346":124235,"_3068":124805},[],{"_3612":74171,"_31165":73931,"_21586":124811,"_5":14831,"_28346":124235,"_3068":55757},[],{"_3612":74172,"_31165":73931,"_21586":124813,"_5":14831,"_28346":124235,"_3068":55220},[],{"_3612":74173,"_31165":73931,"_21586":124815,"_5":14831,"_28346":124235,"_3068":55762},[],{"_3612":74174,"_31165":73931,"_21586":124817,"_5":14831,"_28346":124235,"_3068":124818},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3612":74175,"_31165":73931,"_21586":124820,"_5":14831,"_28346":124239,"_3068":124821},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3612":74176,"_31165":73931,"_21586":124823,"_5":14831,"_28346":124239,"_3068":124824},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3612":74177,"_31165":73931,"_21586":124826,"_5":14831,"_28346":124239,"_3068":124827},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3612":74178,"_31165":73931,"_21586":124829,"_5":14831,"_28346":124243,"_3068":124830},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3612":74179,"_31165":73931,"_21586":124832,"_5":14831,"_28346":124243,"_3068":124833},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3612":74180,"_31165":73931,"_21586":124835,"_5":14831,"_28346":124247,"_3068":124836},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3612":74181,"_31165":73931,"_21586":124838,"_5":14831,"_28346":124247,"_3068":124839},[],"Existen dos tipos de acciones:",{"_3612":74182,"_31165":73931,"_21586":124841,"_5":14831,"_28346":124247,"_3068":124842},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3612":74183,"_31165":73931,"_21586":124844,"_5":14831,"_28346":124247,"_3068":124845},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3612":74184,"_31165":73931,"_21586":124847,"_5":14831,"_28346":124247,"_3068":124848},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3612":74185,"_31165":73931,"_21586":124850,"_5":14831,"_28346":124251,"_3068":124851},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3612":74186,"_31165":73931,"_21586":124853,"_5":14831,"_28346":124251,"_3068":124854},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3612":74187,"_31165":73931,"_21586":124856,"_5":14831,"_28346":124251,"_3068":124857},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3612":74188,"_31165":73931,"_21586":124859,"_5":14831,"_28346":124255,"_3068":124860},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3612":74189,"_31165":73931,"_21586":124862,"_5":14831,"_28346":124255,"_3068":124863},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3612":74190,"_31165":73931,"_21586":124865,"_5":14831,"_28346":124255,"_3068":124866},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3612":74191,"_31165":73931,"_21586":124868,"_5":14831,"_28346":124255,"_3068":124869},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3612":74192,"_31165":73931,"_21586":124871,"_5":14831,"_28346":124255,"_3068":124872},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3612":74193,"_31165":73931,"_21586":124874,"_5":14831,"_28346":124255,"_3068":124875},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3612":74194,"_31165":73931,"_21586":124877,"_5":14831,"_28346":124255,"_3068":124878},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3612":74195,"_31165":73931,"_21586":124880,"_5":14831,"_28346":124255,"_3068":124881},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3612":74196,"_31165":73931,"_21586":124883,"_5":14831,"_28346":124255,"_3068":124884},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3612":74197,"_31165":73931,"_21586":124886,"_5":14831,"_28346":124255,"_3068":124887},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3612":74198,"_31165":73931,"_21586":124889,"_5":14831,"_28346":124255,"_3068":124890},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3612":74199,"_31165":73931,"_21586":124892,"_5":14831,"_28346":124255,"_3068":124893},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3612":74200,"_31165":73931,"_21586":124895,"_5":14831,"_28346":124255,"_3068":124896},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3612":74201,"_31165":73931,"_21586":124898,"_5":14831,"_28346":124255,"_3068":124899},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3612":74202,"_31165":73931,"_21586":124901,"_5":14831,"_28346":124255,"_3068":124902},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3612":74203,"_31165":73931,"_21586":124904,"_5":14831,"_28346":124255,"_3068":124905},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3612":74204,"_31165":73931,"_21586":124907,"_5":14831,"_28346":124255,"_3068":124908},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3612":74205,"_31165":73931,"_21586":124910,"_5":14831,"_28346":124255,"_3068":124911},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3612":74206,"_31165":73931,"_21586":124913,"_5":14831,"_28346":124255,"_3068":124914},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3612":74207,"_31165":73931,"_21586":124916,"_5":14831,"_28346":124255,"_3068":124917},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3612":74208,"_31165":73931,"_21586":124919,"_5":14831,"_28346":124255,"_3068":124920},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3612":74209,"_31165":73931,"_21586":124922,"_5":14831,"_28346":124255,"_3068":124923},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3612":74210,"_31165":73931,"_21586":124925,"_5":14831,"_28346":124255,"_3068":124926},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3612":74211,"_31165":73931,"_21586":124928,"_5":14831,"_28346":124255,"_3068":124929},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3612":74212,"_31165":74212,"_5":15196,"_3068":53574,"_31523":124931,"_21586":124932,"_28346":74212},[50890,121593,53574],[],{"_3612":74213,"_31165":74212,"_21586":124934,"_5":14831,"_28346":74212,"_3068":124935},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3612":74214,"_31165":74212,"_5":31520,"_21586":124937,"_28346":124938,"_3068":124939},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3612":74215,"_31165":74212,"_5":31520,"_21586":124941,"_28346":124942,"_3068":122738},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3612":74216,"_31165":74212,"_5":31520,"_21586":124944,"_28346":124945,"_3068":122916},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3612":74217,"_31165":74212,"_5":31520,"_21586":124947,"_28346":124948,"_3068":124154},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/overview#integraciones",{"_3612":74218,"_31165":74212,"_5":31520,"_21586":124950,"_28346":124951,"_3068":124952},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3612":74219,"_31165":74212,"_21586":124954,"_5":14831,"_28346":74212,"_3068":124955},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3612":74220,"_31165":74212,"_21586":124957,"_5":14831,"_28346":124938,"_3068":124958},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3612":74221,"_31165":74212,"_21586":124960,"_5":14831,"_28346":124938,"_3068":124961},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3612":74222,"_31165":74212,"_21586":124963,"_5":14831,"_28346":124942,"_3068":124964},[],"Recurso",{"_3612":74223,"_31165":74212,"_21586":124966,"_5":14831,"_28346":124942,"_3068":124967},[],"Qué representa",{"_3612":74224,"_31165":74212,"_21586":124969,"_5":14831,"_28346":124942,"_3068":124970},[],"**Dispositivo**",{"_3612":74225,"_31165":74212,"_21586":124972,"_5":14831,"_28346":124942,"_3068":124973},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3612":74226,"_31165":74212,"_21586":124975,"_5":14831,"_28346":124942,"_3068":124976},[],"**Identidad**",{"_3612":74227,"_31165":74212,"_21586":124978,"_5":14831,"_28346":124942,"_3068":124979},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3612":74228,"_31165":74212,"_21586":124981,"_5":14831,"_28346":124942,"_3068":55929},[],{"_3612":74229,"_31165":74212,"_21586":124983,"_5":14831,"_28346":124942,"_3068":124984},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3612":74230,"_31165":74212,"_21586":124986,"_5":14831,"_28346":124942,"_3068":124987},[],"**Flota**",{"_3612":74231,"_31165":74212,"_21586":124989,"_5":14831,"_28346":124942,"_3068":124990},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3612":74232,"_31165":74212,"_21586":124992,"_5":14831,"_28346":124942,"_3068":124993},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3612":74233,"_31165":74212,"_21586":124995,"_5":14831,"_28346":124942,"_3068":124996},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3612":74234,"_31165":74212,"_21586":124998,"_5":14831,"_28346":124945,"_3068":124999},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3612":74235,"_31165":74212,"_21586":125001,"_5":14831,"_28346":124945,"_3068":125002},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3612":74236,"_31165":74212,"_21586":125004,"_5":14831,"_28346":124945,"_3068":125005},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3612":74237,"_31165":74212,"_21586":125007,"_5":14831,"_28346":124945,"_3068":125008},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3612":74238,"_31165":74212,"_21586":125010,"_5":14831,"_28346":124945,"_3068":125011},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3612":74239,"_31165":74212,"_21586":125013,"_5":14831,"_28346":124945,"_3068":125014},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3612":74240,"_31165":74212,"_21586":125016,"_5":14831,"_28346":124945,"_3068":125017},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3612":74241,"_31165":74212,"_21586":125019,"_5":14831,"_28346":124945,"_3068":125020},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3612":74242,"_31165":74212,"_21586":125022,"_5":14831,"_28346":124948,"_3068":125023},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3612":74243,"_31165":74212,"_21586":125025,"_5":14831,"_28346":124948,"_3068":125026},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3612":74244,"_31165":74212,"_21586":125028,"_5":14831,"_28346":124951,"_3068":125029},[],"Participante",{"_3612":74245,"_31165":74212,"_21586":125031,"_5":14831,"_28346":124951,"_3068":125032},[],"Responsabilidad",{"_3612":74246,"_31165":74212,"_21586":125034,"_5":14831,"_28346":124951,"_3068":125035},[],"Administrador PKI",{"_3612":74247,"_31165":74212,"_21586":125037,"_5":14831,"_28346":124951,"_3068":125038},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3612":74248,"_31165":74212,"_21586":125040,"_5":14831,"_28346":124951,"_3068":125041},[],"Administrador del aprovisionamiento",{"_3612":74249,"_31165":74212,"_21586":125043,"_5":14831,"_28346":124951,"_3068":125044},[],"DMS, admisión, autenticación por operación e inventario.",{"_3612":74250,"_31165":74212,"_21586":125046,"_5":14831,"_28346":124951,"_3068":125047},[],"Integrador del dispositivo",{"_3612":74251,"_31165":74212,"_21586":125049,"_5":14831,"_28346":124951,"_3068":125050},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3612":74252,"_31165":74212,"_21586":125052,"_5":14831,"_28346":124951,"_3068":125053},[],"Integrador del consumidor",{"_3612":74253,"_31165":74212,"_21586":125055,"_5":14831,"_28346":124951,"_3068":125056},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3612":74254,"_31165":74212,"_21586":125058,"_5":14831,"_28346":124951,"_3068":125059},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3612":74255,"_31165":74255,"_5":15196,"_3068":125061,"_31523":125062,"_21586":125064,"_28346":74255},"Enrola y conecta tu primer dispositivo",[50890,121593,53574,125063],"Primeros pasos",[],{"_3612":74256,"_31165":74255,"_21586":125066,"_5":14831,"_28346":74255,"_3068":125067},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3612":74257,"_31165":74255,"_5":31520,"_21586":125069,"_28346":125070,"_3068":120127},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3612":74258,"_31165":74255,"_5":31520,"_21586":125072,"_28346":125073,"_3068":125074},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3612":74259,"_31165":74255,"_5":31520,"_21586":125076,"_28346":125077,"_3068":125078},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3612":74260,"_31165":74255,"_5":31520,"_21586":125080,"_28346":125081,"_3068":125082},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3612":74261,"_31165":74255,"_5":31520,"_21586":125084,"_28346":125085,"_3068":125086},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3612":74262,"_31165":74255,"_5":31520,"_21586":125088,"_28346":125089,"_3068":125090},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3612":74263,"_31165":74255,"_5":31520,"_21586":125092,"_28346":125093,"_3068":125094},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3612":74264,"_31165":74255,"_5":31520,"_21586":125096,"_28346":125097,"_3068":125098},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3612":74265,"_31165":74255,"_21586":125100,"_5":14831,"_28346":74255,"_3068":125101},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3612":74266,"_31165":74255,"_21586":125103,"_5":14831,"_28346":125070,"_3068":125104},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3612":74267,"_31165":74255,"_21586":125106,"_5":14831,"_28346":125070,"_3068":125107},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3612":74268,"_31165":74255,"_21586":125109,"_5":14831,"_28346":125070,"_3068":125110},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3612":74269,"_31165":74255,"_21586":125112,"_5":14831,"_28346":125070,"_3068":125113},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3612":74270,"_31165":74255,"_21586":125115,"_5":14831,"_28346":125070,"_3068":125116},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3612":74271,"_31165":74255,"_21586":125118,"_5":14831,"_28346":125073,"_3068":125119},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3612":74272,"_31165":74255,"_21586":125121,"_5":14831,"_28346":125073,"_3068":125122},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3612":74273,"_31165":74255,"_21586":125124,"_5":14831,"_28346":125077,"_3068":125125},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3612":74274,"_31165":74255,"_21586":125127,"_5":14831,"_28346":125077,"_3068":125128},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3612":74275,"_31165":74255,"_21586":125130,"_5":14831,"_28346":125077,"_3068":125131},[],"Ajuste",{"_3612":74276,"_31165":74255,"_21586":125133,"_5":14831,"_28346":125077,"_3068":125134},[],"Valor de evaluación",{"_3612":74277,"_31165":74255,"_21586":125136,"_5":14831,"_28346":125077,"_3068":56085},[],{"_3612":74278,"_31165":74255,"_21586":125138,"_5":14831,"_28346":125077,"_3068":125139},[],"Raíz emisora de `device-root.pem`.",{"_3612":74279,"_31165":74255,"_21586":125141,"_5":14831,"_28346":125077,"_3068":123044},[],{"_3612":74280,"_31165":74255,"_21586":125143,"_5":14831,"_28346":125077,"_3068":125144},[],"Perfil final de 1 hora que acabas de preparar.",{"_3612":74281,"_31165":74255,"_21586":125146,"_5":14831,"_28346":125077,"_3068":56096},[],{"_3612":74282,"_31165":74255,"_21586":125148,"_5":14831,"_28346":125077,"_3068":56099},[],{"_3612":74283,"_31165":74255,"_21586":125150,"_5":14831,"_28346":125077,"_3068":56102},[],{"_3612":74284,"_31165":74255,"_21586":125152,"_5":14831,"_28346":125077,"_3068":125153},[],"Habilitado.",{"_3612":74285,"_31165":74255,"_21586":125155,"_5":14831,"_28346":125077,"_3068":56108},[],{"_3612":74286,"_31165":74255,"_21586":125157,"_5":14831,"_28346":125077,"_3068":125158},[],"Deshabilitado; el ID debe ser nuevo.",{"_3612":74287,"_31165":74255,"_21586":125160,"_5":14831,"_28346":125077,"_3068":125161},[],"Autenticación inicial",{"_3612":74288,"_31165":74255,"_21586":125163,"_5":14831,"_28346":125077,"_3068":125164},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3612":74289,"_31165":74255,"_21586":125166,"_5":14831,"_28346":125077,"_3068":125167},[],"Autenticación de renovación",{"_3612":74290,"_31165":74255,"_21586":125169,"_5":14831,"_28346":125077,"_3068":125170},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3612":74291,"_31165":74255,"_21586":125172,"_5":14831,"_28346":125077,"_3068":56126},[],{"_3612":74292,"_31165":74255,"_21586":125174,"_5":14831,"_28346":125077,"_3068":125175},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3612":74293,"_31165":74255,"_21586":125177,"_5":14831,"_28346":125077,"_3068":56132},[],{"_3612":74294,"_31165":74255,"_21586":125179,"_5":14831,"_28346":125077,"_3068":125180},[],"1 hora.",{"_3612":74295,"_31165":74255,"_21586":125182,"_5":14831,"_28346":125077,"_3068":56138},[],{"_3612":74296,"_31165":74255,"_21586":125184,"_5":14831,"_28346":125077,"_3068":125185},[],"30 minutos / 10 minutos.",{"_3612":74297,"_31165":74255,"_21586":125187,"_5":14831,"_28346":125077,"_3068":56144},[],{"_3612":74298,"_31165":74255,"_21586":125189,"_5":14831,"_28346":125077,"_3068":125190},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3612":74299,"_31165":74255,"_21586":125192,"_5":14831,"_28346":125077,"_3068":53896},[],{"_3612":74300,"_31165":74255,"_21586":125194,"_5":14831,"_28346":125077,"_3068":125195},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3612":74301,"_31165":74255,"_21586":125197,"_5":14831,"_28346":125077,"_3068":56155},[],{"_3612":74302,"_31165":74255,"_21586":125199,"_5":14831,"_28346":125077,"_3068":125200},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3612":74303,"_31165":74255,"_21586":125202,"_5":14831,"_28346":125077,"_3068":125203},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3612":74304,"_31165":74255,"_21586":125205,"_5":14831,"_28346":125081,"_3068":125206},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3612":74305,"_31165":74255,"_21586":125208,"_5":14831,"_28346":125081,"_3068":125209},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3612":74306,"_31165":74255,"_21586":125211,"_5":14831,"_28346":125085,"_3068":125212},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3612":74307,"_31165":74255,"_21586":125214,"_5":14831,"_28346":125085,"_3068":125215},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3612":74308,"_31165":74255,"_21586":125217,"_5":14831,"_28346":125085,"_3068":125218},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3612":74309,"_31165":74255,"_21586":125220,"_5":14831,"_28346":125089,"_3068":125221},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3612":74310,"_31165":74255,"_21586":125223,"_5":14831,"_28346":125089,"_3068":125224},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3612":74311,"_31165":74255,"_21586":125226,"_5":14831,"_28346":125093,"_3068":125227},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3612":74312,"_31165":74255,"_21586":125229,"_5":14831,"_28346":125093,"_3068":125230},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3612":74313,"_31165":74255,"_21586":125232,"_5":14831,"_28346":125093,"_3068":125233},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3612":74314,"_31165":74255,"_21586":125235,"_5":14831,"_28346":125093,"_3068":125236},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3612":74315,"_31165":74255,"_21586":125238,"_5":14831,"_28346":125093,"_3068":125239},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3612":74316,"_31165":74255,"_21586":125241,"_5":14831,"_28346":125097,"_3068":125242},[],"Comprobación",{"_3612":74317,"_31165":74255,"_21586":125244,"_5":14831,"_28346":125097,"_3068":125245},[],"Resultado esperado",{"_3612":74318,"_31165":74255,"_21586":125247,"_5":14831,"_28346":125097,"_3068":125248},[],"Registro",{"_3612":74319,"_31165":74255,"_21586":125250,"_5":14831,"_28346":125097,"_3068":125251},[],"ID creado automáticamente y DMS correcto.",{"_3612":74320,"_31165":74255,"_21586":125253,"_5":14831,"_28346":125097,"_3068":124538},[],{"_3612":74321,"_31165":74255,"_21586":125255,"_5":14831,"_28346":125097,"_3068":125256},[],"CN, perfil, serie y clave verificados.",{"_3612":74322,"_31165":74255,"_21586":125258,"_5":14831,"_28346":125097,"_3068":125259},[],"Inventario",{"_3612":74323,"_31165":74255,"_21586":125261,"_5":14831,"_28346":125097,"_3068":125262},[],"Serie recibida visible como identidad actual y en el historial.",{"_3612":74324,"_31165":74255,"_21586":125264,"_5":14831,"_28346":125097,"_3068":125265},[],"Consumidor",{"_3612":74325,"_31165":74255,"_21586":125267,"_5":14831,"_28346":125097,"_3068":125268},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3612":74326,"_31165":74255,"_21586":125270,"_5":14831,"_28346":125097,"_3068":125271},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3612":74327,"_31165":74255,"_21586":125273,"_5":14831,"_28346":125097,"_3068":125274},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3612":74328,"_31165":74328,"_5":15196,"_3068":122755,"_31523":125276,"_21586":125277,"_28346":74328},[50890,121593,53574,125063],[],{"_3612":74329,"_31165":74328,"_21586":125279,"_5":14831,"_28346":74328,"_3068":125280},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3612":74330,"_31165":74328,"_5":31520,"_21586":125282,"_28346":125283,"_3068":120127},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3612":74331,"_31165":74328,"_5":31520,"_21586":125285,"_28346":125286,"_3068":125287},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3612":74332,"_31165":74328,"_5":31520,"_21586":125289,"_28346":125290,"_3068":125291},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3612":74333,"_31165":74328,"_5":31520,"_21586":125293,"_28346":125294,"_3068":125295},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3612":74334,"_31165":74328,"_5":31520,"_21586":125297,"_28346":125298,"_3068":125299},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3612":74335,"_31165":74328,"_5":31520,"_21586":125301,"_28346":125302,"_3068":125303},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3612":74336,"_31165":74328,"_5":31520,"_21586":125305,"_28346":125306,"_3068":125245},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3612":74337,"_31165":74328,"_5":31520,"_21586":125308,"_28346":125309,"_3068":125310},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3612":74338,"_31165":74328,"_5":31520,"_21586":125312,"_28346":125313,"_3068":125314},[],"/docs/pr-preview/pr-77/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3612":74339,"_31165":74328,"_21586":125316,"_5":14831,"_28346":74328,"_3068":125317},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3612":74340,"_31165":74328,"_21586":125319,"_5":14831,"_28346":74328,"_3068":125320},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3612":74341,"_31165":74328,"_21586":125322,"_5":14831,"_28346":125283,"_3068":125323},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3612":74342,"_31165":74328,"_21586":125325,"_5":14831,"_28346":125283,"_3068":125326},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3612":74343,"_31165":74328,"_21586":125328,"_5":14831,"_28346":125283,"_3068":125329},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3612":74344,"_31165":74328,"_21586":125331,"_5":14831,"_28346":125283,"_3068":125332},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3612":74345,"_31165":74328,"_21586":125334,"_5":14831,"_28346":125286,"_3068":125335},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3612":74346,"_31165":74328,"_21586":125337,"_5":14831,"_28346":125286,"_3068":125338},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3612":74347,"_31165":74328,"_21586":125340,"_5":14831,"_28346":125286,"_3068":125341},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3612":74348,"_31165":74328,"_21586":125343,"_5":14831,"_28346":125286,"_3068":125344},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3612":74349,"_31165":74328,"_21586":125346,"_5":14831,"_28346":125286,"_3068":125347},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3612":74350,"_31165":74328,"_21586":125349,"_5":14831,"_28346":125286,"_3068":125350},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3612":74351,"_31165":74328,"_21586":125352,"_5":14831,"_28346":125286,"_3068":125353},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3612":74352,"_31165":74328,"_21586":125355,"_5":14831,"_28346":125286,"_3068":125356},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3612":74353,"_31165":74328,"_21586":125358,"_5":14831,"_28346":125290,"_3068":125359},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3612":74354,"_31165":74328,"_21586":125361,"_5":14831,"_28346":125290,"_3068":56320},[],{"_3612":74355,"_31165":74328,"_21586":125363,"_5":14831,"_28346":125290,"_3068":125364},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3612":74356,"_31165":74328,"_21586":125366,"_5":14831,"_28346":125290,"_3068":125367},[],"**Icon** y **Tags**: clasificación opcional.",{"_3612":74357,"_31165":74328,"_21586":125369,"_5":14831,"_28346":125290,"_3068":125370},[],"Confirma el registro.",{"_3612":74358,"_31165":74328,"_21586":125372,"_5":14831,"_28346":125294,"_3068":125373},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3612":74359,"_31165":74328,"_21586":125375,"_5":14831,"_28346":125294,"_3068":125376},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3612":74360,"_31165":74328,"_21586":125378,"_5":14831,"_28346":125298,"_3068":125379},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3612":74361,"_31165":74328,"_21586":125381,"_5":14831,"_28346":125298,"_3068":125382},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3612":74362,"_31165":74328,"_21586":125384,"_5":14831,"_28346":125302,"_3068":125385},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3612":74363,"_31165":74328,"_21586":125387,"_5":14831,"_28346":125302,"_3068":125388},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3612":74364,"_31165":74328,"_21586":125390,"_5":14831,"_28346":125306,"_3068":125242},[],{"_3612":74365,"_31165":74328,"_21586":125392,"_5":14831,"_28346":125306,"_3068":125393},[],"Resultado",{"_3612":74366,"_31165":74328,"_21586":125395,"_5":14831,"_28346":125306,"_3068":124524},[],{"_3612":74367,"_31165":74328,"_21586":125397,"_5":14831,"_28346":125306,"_3068":125398},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3612":74368,"_31165":74328,"_21586":125400,"_5":14831,"_28346":125306,"_3068":125401},[],"Identidad actual",{"_3612":74369,"_31165":74328,"_21586":125403,"_5":14831,"_28346":125306,"_3068":125404},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3612":74370,"_31165":74328,"_21586":125406,"_5":14831,"_28346":125306,"_3068":125407},[],"Historial",{"_3612":74371,"_31165":74328,"_21586":125409,"_5":14831,"_28346":125306,"_3068":125410},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3612":74372,"_31165":74328,"_21586":125412,"_5":14831,"_28346":125306,"_3068":125413},[],"Clave y certificado",{"_3612":74373,"_31165":74328,"_21586":125415,"_5":14831,"_28346":125306,"_3068":125416},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3612":74374,"_31165":74328,"_21586":125418,"_5":14831,"_28346":125309,"_3068":125419},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3612":74375,"_31165":74328,"_21586":125421,"_5":14831,"_28346":125309,"_3068":125422},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3612":74376,"_31165":74328,"_21586":125424,"_5":14831,"_28346":125309,"_3068":125425},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3612":74377,"_31165":74328,"_21586":125427,"_5":14831,"_28346":125309,"_3068":125428},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3612":74378,"_31165":74328,"_21586":125430,"_5":14831,"_28346":125313,"_3068":125431},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3612":74379,"_31165":74328,"_21586":125433,"_5":14831,"_28346":125313,"_3068":125434},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3612":74380,"_31165":74328,"_21586":125436,"_5":14831,"_28346":125313,"_3068":125437},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3612":74381,"_31165":74381,"_5":15196,"_3068":125439,"_31523":125440,"_21586":125441,"_28346":74381},"Plataforma Lamassu IoT",[50890,121593],[],{"_3612":74382,"_31165":74381,"_21586":125443,"_5":14831,"_28346":74381,"_3068":125444},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3612":74383,"_31165":74381,"_5":31520,"_21586":125446,"_28346":125447,"_3068":124939},[],"/docs/pr-preview/pr-77/es/platform/overview#empieza-aquí",{"_3612":74384,"_31165":74381,"_5":31520,"_21586":125449,"_28346":125450,"_3068":125451},[],"/docs/pr-preview/pr-77/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3612":74385,"_31165":74381,"_5":31520,"_21586":125453,"_28346":125454,"_3068":125455},[],"/docs/pr-preview/pr-77/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3612":74386,"_31165":74381,"_5":31520,"_21586":125457,"_28346":125458,"_3068":125459},[],"/docs/pr-preview/pr-77/es/platform/overview#capacidades-principales","Capacidades principales",{"_3612":74387,"_31165":74381,"_5":31520,"_21586":125461,"_28346":125462,"_3068":125463},[],"/docs/pr-preview/pr-77/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3612":74388,"_31165":74381,"_5":31520,"_21586":125465,"_28346":125466,"_3068":125467},[],"/docs/pr-preview/pr-77/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3612":74389,"_31165":74381,"_5":31520,"_21586":125469,"_28346":125470,"_3068":125471},[],"/docs/pr-preview/pr-77/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3612":74390,"_31165":74381,"_5":31520,"_21586":125473,"_28346":125474,"_3068":125475},[],"/docs/pr-preview/pr-77/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3612":74391,"_31165":74381,"_5":31520,"_21586":125477,"_28346":125478,"_3068":125479},[],"/docs/pr-preview/pr-77/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3612":74392,"_31165":74381,"_5":31520,"_21586":125481,"_28346":125482,"_3068":125483},[],"/docs/pr-preview/pr-77/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3612":74393,"_31165":74381,"_5":31520,"_21586":125485,"_28346":125486,"_3068":125487},[],"/docs/pr-preview/pr-77/es/platform/overview#referencia-operativa","Referencia operativa",{"_3612":74394,"_31165":74381,"_21586":125489,"_5":14831,"_28346":74381,"_3068":125490},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3612":74395,"_31165":74381,"_21586":125492,"_5":14831,"_28346":125447,"_3068":125493},[],"Elige el resultado que necesitas obtener:",{"_3612":74396,"_31165":74381,"_21586":125495,"_5":14831,"_28346":125447,"_3068":125496},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3612":74397,"_31165":74381,"_21586":125498,"_5":14831,"_28346":125447,"_3068":125499},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3612":74398,"_31165":74381,"_21586":125501,"_5":14831,"_28346":125447,"_3068":125502},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3612":74399,"_31165":74381,"_21586":125504,"_5":14831,"_28346":125450,"_3068":125505},[],"Bloque",{"_3612":74400,"_31165":74381,"_21586":125507,"_5":14831,"_28346":125450,"_3068":125508},[],"Qué gestionas",{"_3612":74401,"_31165":74381,"_21586":125510,"_5":14831,"_28346":125450,"_3068":125511},[],"Punto de entrada",{"_3612":74402,"_31165":74381,"_21586":125513,"_5":14831,"_28346":125450,"_3068":56473},[],{"_3612":74403,"_31165":74381,"_21586":125515,"_5":14831,"_28346":125450,"_3068":125516},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3612":74404,"_31165":74381,"_21586":125518,"_5":14831,"_28346":125450,"_3068":125519},[],"Visión general de PKI",{"_3612":74405,"_31165":74381,"_21586":125521,"_5":14831,"_28346":125450,"_3068":56482},[],{"_3612":74406,"_31165":74381,"_21586":125523,"_5":14831,"_28346":125450,"_3068":125524},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3612":74407,"_31165":74381,"_21586":125526,"_5":14831,"_28346":125450,"_3068":125527},[],"Visión general de IoT Fleets",{"_3612":74408,"_31165":74381,"_21586":125529,"_5":14831,"_28346":125450,"_3068":125530},[],"**Administración**",{"_3612":74409,"_31165":74381,"_21586":125532,"_5":14831,"_28346":125450,"_3068":125533},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3612":74410,"_31165":74381,"_21586":125535,"_5":14831,"_28346":125450,"_3068":121595},[],{"_3612":74411,"_31165":74381,"_21586":125537,"_5":14831,"_28346":125450,"_3068":125538},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3612":74412,"_31165":74381,"_21586":125540,"_5":14831,"_28346":125454,"_3068":125541},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3612":74413,"_31165":74381,"_21586":125543,"_5":14831,"_28346":125454,"_3068":125544},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3612":74414,"_31165":74381,"_21586":125546,"_5":14831,"_28346":125454,"_3068":125547},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3612":74415,"_31165":74381,"_21586":125549,"_5":14831,"_28346":125454,"_3068":125550},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3612":74416,"_31165":74381,"_21586":125552,"_5":14831,"_28346":125454,"_3068":125553},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3612":74417,"_31165":74381,"_21586":125555,"_5":14831,"_28346":125454,"_3068":125556},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3612":74418,"_31165":74381,"_21586":125558,"_5":14831,"_28346":125462,"_3068":125559},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3612":74419,"_31165":74381,"_21586":125561,"_5":14831,"_28346":125466,"_3068":125562},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3612":74420,"_31165":74381,"_21586":125564,"_5":14831,"_28346":125470,"_3068":125565},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3612":74421,"_31165":74381,"_21586":125567,"_5":14831,"_28346":125474,"_3068":125568},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3612":74422,"_31165":74381,"_21586":125570,"_5":14831,"_28346":125478,"_3068":125571},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3612":74423,"_31165":74381,"_21586":125573,"_5":14831,"_28346":125482,"_3068":125574},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3612":74424,"_31165":74381,"_21586":125576,"_5":14831,"_28346":125486,"_3068":125032},[],{"_3612":74425,"_31165":74381,"_21586":125578,"_5":14831,"_28346":125486,"_3068":125579},[],"Qué prepara o comprueba",{"_3612":74426,"_31165":74381,"_21586":125581,"_5":14831,"_28346":125486,"_3068":125035},[],{"_3612":74427,"_31165":74381,"_21586":125583,"_5":14831,"_28346":125486,"_3068":125584},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3612":74428,"_31165":74381,"_21586":125586,"_5":14831,"_28346":125486,"_3068":125587},[],"Administrador de la flota",{"_3612":74429,"_31165":74381,"_21586":125589,"_5":14831,"_28346":125486,"_3068":125590},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3612":74430,"_31165":74381,"_21586":125592,"_5":14831,"_28346":125486,"_3068":125047},[],{"_3612":74431,"_31165":74381,"_21586":125594,"_5":14831,"_28346":125486,"_3068":125595},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3612":74432,"_31165":74381,"_21586":125597,"_5":14831,"_28346":125486,"_3068":125053},[],{"_3612":74433,"_31165":74381,"_21586":125599,"_5":14831,"_28346":125486,"_3068":125600},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3612":74434,"_31165":74381,"_21586":125602,"_5":14831,"_28346":125486,"_3068":125603},[],"Operador de infraestructura",{"_3612":74435,"_31165":74381,"_21586":125605,"_5":14831,"_28346":125486,"_3068":125606},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3612":74436,"_31165":74381,"_21586":125608,"_5":14831,"_28346":125486,"_3068":125609},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3612":74437,"_31165":74437,"_5":15196,"_3068":125611,"_31523":125612,"_21586":125614,"_28346":74437},"Jerarquía y rotación de CAs",[50890,121593,56574,125613],"Claves, autoridades y certificados",[],{"_3612":74438,"_31165":74437,"_21586":125616,"_5":14831,"_28346":74437,"_3068":125617},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3612":74439,"_31165":74437,"_5":31520,"_21586":125619,"_28346":125620,"_3068":125621},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3612":74440,"_31165":74437,"_5":31520,"_21586":125623,"_28346":125624,"_3068":125625},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3612":74441,"_31165":74437,"_5":31520,"_21586":125627,"_28346":125628,"_3068":125629},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3612":74442,"_31165":74437,"_5":31520,"_21586":125631,"_28346":125632,"_3068":125633},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3612":74443,"_31165":74437,"_5":31520,"_21586":125635,"_28346":125636,"_3068":125637},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3612":74444,"_31165":74437,"_5":31520,"_21586":125639,"_28346":125640,"_3068":125641},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3612":74445,"_31165":74437,"_5":31520,"_21586":125643,"_28346":125644,"_3068":125645},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3612":74446,"_31165":74437,"_5":31520,"_21586":125647,"_28346":125648,"_3068":125649},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3612":74447,"_31165":74437,"_5":31520,"_21586":125651,"_28346":125652,"_3068":125653},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3612":74448,"_31165":74437,"_5":31520,"_21586":125655,"_28346":125656,"_3068":125657},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3612":74449,"_31165":74437,"_5":31520,"_21586":125659,"_28346":125660,"_3068":125661},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3612":74450,"_31165":74437,"_5":31520,"_21586":125663,"_28346":125664,"_3068":125665},[],"/docs/pr-preview/pr-77/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3612":74451,"_31165":74437,"_21586":125667,"_5":14831,"_28346":74437,"_3068":125668},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3612":74452,"_31165":74437,"_21586":125670,"_5":14831,"_28346":74437,"_3068":125671},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3612":74453,"_31165":74437,"_21586":125673,"_5":14831,"_28346":125620,"_3068":125674},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3612":74454,"_31165":74437,"_21586":125676,"_5":14831,"_28346":125620,"_3068":125677},[],"entorno, como producción y preproducción;",{"_3612":74455,"_31165":74437,"_21586":125679,"_5":14831,"_28346":125620,"_3068":125680},[],"propietario o equipo operador;",{"_3612":74456,"_31165":74437,"_21586":125682,"_5":14831,"_28346":125620,"_3068":125683},[],"familia de dispositivos o proceso de fabricación;",{"_3612":74457,"_31165":74437,"_21586":125685,"_5":14831,"_28346":125620,"_3068":125686},[],"región o requisito regulatorio;",{"_3612":74458,"_31165":74437,"_21586":125688,"_5":14831,"_28346":125620,"_3068":125689},[],"motor criptográfico o política de clave;",{"_3612":74459,"_31165":74437,"_21586":125691,"_5":14831,"_28346":125620,"_3068":125692},[],"ventana de mantenimiento y ritmo de renovación.",{"_3612":74460,"_31165":74437,"_21586":125694,"_5":14831,"_28346":125620,"_3068":125695},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3612":74461,"_31165":74437,"_21586":125697,"_5":14831,"_28346":125620,"_3068":125698},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3612":74462,"_31165":74437,"_21586":125700,"_5":14831,"_28346":125624,"_3068":125701},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3612":74463,"_31165":74437,"_21586":125703,"_5":14831,"_28346":125624,"_3068":125704},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3612":74464,"_31165":74437,"_21586":125706,"_5":14831,"_28346":125624,"_3068":125707},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3612":74465,"_31165":74437,"_21586":125709,"_5":14831,"_28346":125624,"_3068":125710},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3612":74466,"_31165":74437,"_21586":125712,"_5":14831,"_28346":125628,"_3068":125713},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3612":74467,"_31165":74437,"_21586":125715,"_5":14831,"_28346":125628,"_3068":125716},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3612":74468,"_31165":74437,"_21586":125718,"_5":14831,"_28346":125628,"_3068":125719},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3612":74469,"_31165":74437,"_21586":125721,"_5":14831,"_28346":125628,"_3068":125722},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3612":74470,"_31165":74437,"_21586":125724,"_5":14831,"_28346":125636,"_3068":125725},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3612":74471,"_31165":74437,"_21586":125727,"_5":14831,"_28346":125640,"_3068":125728},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3612":74472,"_31165":74437,"_21586":125730,"_5":14831,"_28346":125644,"_3068":125731},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3612":74473,"_31165":74437,"_21586":125733,"_5":14831,"_28346":125648,"_3068":125734},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3612":74474,"_31165":74437,"_21586":125736,"_5":14831,"_28346":125652,"_3068":125737},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3612":74475,"_31165":74437,"_21586":125739,"_5":14831,"_28346":125656,"_3068":125740},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3612":74476,"_31165":74437,"_21586":125742,"_5":14831,"_28346":125660,"_3068":125743},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3612":74477,"_31165":74437,"_21586":125745,"_5":14831,"_28346":125660,"_3068":125746},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3612":74478,"_31165":74437,"_21586":125748,"_5":14831,"_28346":125660,"_3068":125749},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3612":74479,"_31165":74437,"_21586":125751,"_5":14831,"_28346":125660,"_3068":125752},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3612":74480,"_31165":74437,"_21586":125754,"_5":14831,"_28346":125664,"_3068":125755},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3612":74481,"_31165":74437,"_21586":125757,"_5":14831,"_28346":125664,"_3068":125758},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3612":74482,"_31165":74437,"_21586":125760,"_5":14831,"_28346":125664,"_3068":125761},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3612":74483,"_31165":74437,"_21586":125763,"_5":14831,"_28346":125664,"_3068":125764},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3612":74484,"_31165":74437,"_21586":125766,"_5":14831,"_28346":125664,"_3068":125767},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3612":74485,"_31165":74437,"_21586":125769,"_5":14831,"_28346":125664,"_3068":125770},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3612":74486,"_31165":74437,"_21586":125772,"_5":14831,"_28346":125664,"_3068":125773},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3612":74487,"_31165":74487,"_5":15196,"_3068":125775,"_31523":125776,"_21586":125777,"_28346":74487},"Autoridades de certificación",[50890,121593,56574,125613],[],{"_3612":74488,"_31165":74487,"_21586":125779,"_5":14831,"_28346":74487,"_3068":125780},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3612":74489,"_31165":74487,"_5":31520,"_21586":125782,"_28346":125783,"_3068":125784},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3612":74490,"_31165":74487,"_5":31520,"_21586":125786,"_28346":125787,"_3068":125788},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3612":74491,"_31165":74487,"_5":31520,"_21586":125790,"_28346":125791,"_3068":120127},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3612":74492,"_31165":74487,"_5":31520,"_21586":125793,"_28346":125794,"_3068":125795},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3612":74493,"_31165":74487,"_5":31520,"_21586":125797,"_28346":125798,"_3068":125799},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3612":74494,"_31165":74487,"_5":31520,"_21586":125801,"_28346":125802,"_3068":125803},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3612":74495,"_31165":74487,"_5":31520,"_21586":125805,"_28346":125806,"_3068":125807},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3612":74496,"_31165":74487,"_5":31520,"_21586":125809,"_28346":125810,"_3068":125811},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3612":74497,"_31165":74487,"_5":31520,"_21586":125813,"_28346":125814,"_3068":125815},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3612":74498,"_31165":74487,"_5":31520,"_21586":125817,"_28346":125818,"_3068":125819},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3612":74499,"_31165":74487,"_5":31520,"_21586":125821,"_28346":125822,"_3068":125823},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3612":74500,"_31165":74487,"_5":31520,"_21586":125825,"_28346":125826,"_3068":125827},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3612":74501,"_31165":74487,"_5":31520,"_21586":125829,"_28346":125830,"_3068":125831},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3612":74502,"_31165":74487,"_5":31520,"_21586":125833,"_28346":125834,"_3068":125835},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3612":74503,"_31165":74487,"_5":31520,"_21586":125837,"_28346":125838,"_3068":125839},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3612":74504,"_31165":74487,"_5":31520,"_21586":125841,"_28346":125842,"_3068":125843},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3612":74505,"_31165":74487,"_5":31520,"_21586":125845,"_28346":125846,"_3068":125847},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3612":74506,"_31165":74487,"_5":31520,"_21586":125849,"_28346":125850,"_3068":125851},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3612":74507,"_31165":74487,"_5":31520,"_21586":125853,"_28346":125854,"_3068":125855},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3612":74508,"_31165":74487,"_5":31520,"_21586":125857,"_28346":125858,"_3068":125859},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3612":74509,"_31165":74487,"_5":31520,"_21586":125861,"_28346":125862,"_3068":125863},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3612":74510,"_31165":74487,"_5":31520,"_21586":125865,"_28346":125866,"_3068":125867},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3612":74511,"_31165":74487,"_5":31520,"_21586":125869,"_28346":125870,"_3068":125871},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3612":74512,"_31165":74487,"_21586":125873,"_5":14831,"_28346":74487,"_3068":125874},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3612":74513,"_31165":74487,"_21586":125876,"_5":14831,"_28346":74487,"_3068":125877},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3612":74514,"_31165":74487,"_21586":125879,"_5":14831,"_28346":74487,"_3068":125880},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3612":74515,"_31165":74487,"_21586":125882,"_5":14831,"_28346":125783,"_3068":125883},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3612":74516,"_31165":74487,"_21586":125885,"_5":14831,"_28346":125783,"_3068":125886},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3612":74517,"_31165":74487,"_21586":125888,"_5":14831,"_28346":125783,"_3068":125889},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3612":74518,"_31165":74487,"_21586":125891,"_5":14831,"_28346":125783,"_3068":125892},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3612":74519,"_31165":74487,"_21586":125894,"_5":14831,"_28346":125783,"_3068":125895},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3612":74520,"_31165":74487,"_21586":125897,"_5":14831,"_28346":125791,"_3068":125898},[],"Decide si la CA será raíz o intermedia.",{"_3612":74521,"_31165":74487,"_21586":125900,"_5":14831,"_28346":125791,"_3068":125901},[],"Elige el motor que custodiará la clave.",{"_3612":74522,"_31165":74487,"_21586":125903,"_5":14831,"_28346":125791,"_3068":125904},[],"Define una validez superior a la de los certificados que emitirá.",{"_3612":74523,"_31165":74487,"_21586":125906,"_5":14831,"_28346":125791,"_3068":125907},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3612":74524,"_31165":74487,"_21586":125909,"_5":14831,"_28346":125794,"_3068":125910},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3612":74525,"_31165":74487,"_21586":125912,"_5":14831,"_28346":125798,"_3068":125913},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3612":74526,"_31165":74487,"_21586":125915,"_5":14831,"_28346":125798,"_3068":125916},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3612":74527,"_31165":74487,"_21586":125918,"_5":14831,"_28346":125802,"_3068":125919},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3612":74528,"_31165":74487,"_21586":125921,"_5":14831,"_28346":125806,"_3068":125922},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3612":74529,"_31165":74487,"_21586":125924,"_5":14831,"_28346":125806,"_3068":125925},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3612":74530,"_31165":74487,"_21586":125927,"_5":14831,"_28346":125806,"_3068":125928},[],"`ST`: estado o provincia.",{"_3612":74531,"_31165":74487,"_21586":125930,"_5":14831,"_28346":125806,"_3068":125931},[],"`L`: localidad.",{"_3612":74532,"_31165":74487,"_21586":125933,"_5":14831,"_28346":125806,"_3068":125934},[],"`O`: organización.",{"_3612":74533,"_31165":74487,"_21586":125936,"_5":14831,"_28346":125806,"_3068":125937},[],"`OU`: unidad organizativa.",{"_3612":74534,"_31165":74487,"_21586":125939,"_5":14831,"_28346":125806,"_3068":125940},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3612":74535,"_31165":74487,"_21586":125942,"_5":14831,"_28346":125810,"_3068":125943},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3612":74536,"_31165":74487,"_21586":125945,"_5":14831,"_28346":125810,"_3068":125946},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3612":74537,"_31165":74487,"_21586":125948,"_5":14831,"_28346":125814,"_3068":125949},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3612":74538,"_31165":74487,"_21586":125951,"_5":14831,"_28346":125814,"_3068":125952},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3612":74539,"_31165":74487,"_21586":125954,"_5":14831,"_28346":125818,"_3068":125955},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3612":74540,"_31165":74487,"_21586":125957,"_5":14831,"_28346":125818,"_3068":125958},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3612":74541,"_31165":74487,"_21586":125960,"_5":14831,"_28346":125822,"_3068":125961},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3612":74542,"_31165":74487,"_21586":125963,"_5":14831,"_28346":125822,"_3068":125964},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3612":74543,"_31165":74487,"_21586":125966,"_5":14831,"_28346":125822,"_3068":125967},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3612":74544,"_31165":74487,"_21586":125969,"_5":14831,"_28346":125826,"_3068":125970},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3612":74545,"_31165":74487,"_21586":125972,"_5":14831,"_28346":125830,"_3068":125973},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3612":74546,"_31165":74487,"_21586":125975,"_5":14831,"_28346":125830,"_3068":125976},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3612":74547,"_31165":74487,"_21586":125978,"_5":14831,"_28346":125834,"_3068":125979},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3612":74548,"_31165":74487,"_21586":125981,"_5":14831,"_28346":125838,"_3068":125982},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3612":74549,"_31165":74487,"_21586":125984,"_5":14831,"_28346":125838,"_3068":125985},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3612":74550,"_31165":74487,"_21586":125987,"_5":14831,"_28346":125838,"_3068":125988},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3612":74551,"_31165":74487,"_21586":125990,"_5":14831,"_28346":125842,"_3068":125991},[],"Abre una CA desde el inventario para consultar:",{"_3612":74552,"_31165":74487,"_21586":125993,"_5":14831,"_28346":125842,"_3068":125994},[],"Estado y periodo de validez.",{"_3612":74553,"_31165":74487,"_21586":125996,"_5":14831,"_28346":125842,"_3068":125997},[],"Certificado y cadena en formato PEM.",{"_3612":74554,"_31165":74487,"_21586":125999,"_5":14831,"_28346":125842,"_3068":126000},[],"Número de certificados activos, expirados y revocados.",{"_3612":74555,"_31165":74487,"_21586":126002,"_5":14831,"_28346":125842,"_3068":126003},[],"Certificados emitidos en **Issued Certificates**.",{"_3612":74556,"_31165":74487,"_21586":126005,"_5":14831,"_28346":125842,"_3068":126006},[],"CRL vinculada a la autoridad.",{"_3612":74557,"_31165":74487,"_21586":126008,"_5":14831,"_28346":125842,"_3068":126009},[],"Metadatos y motor criptográfico asociado.",{"_3612":74558,"_31165":74487,"_21586":126011,"_5":14831,"_28346":125842,"_3068":126012},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3612":74559,"_31165":74487,"_21586":126014,"_5":14831,"_28346":125846,"_3068":126015},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3612":74560,"_31165":74487,"_21586":126017,"_5":14831,"_28346":125846,"_3068":126018},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3612":74561,"_31165":74487,"_21586":126020,"_5":14831,"_28346":125846,"_3068":126021},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3612":74562,"_31165":74487,"_21586":126023,"_5":14831,"_28346":125846,"_3068":126024},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3612":74563,"_31165":74487,"_21586":126026,"_5":14831,"_28346":125846,"_3068":126027},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3612":74564,"_31165":74487,"_21586":126029,"_5":14831,"_28346":125846,"_3068":126030},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3612":74565,"_31165":74487,"_21586":126032,"_5":14831,"_28346":125850,"_3068":126033},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3612":74566,"_31165":74487,"_21586":126035,"_5":14831,"_28346":125854,"_3068":126036},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3612":74567,"_31165":74487,"_21586":126038,"_5":14831,"_28346":125858,"_3068":126039},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3612":74568,"_31165":74487,"_21586":126041,"_5":14831,"_28346":125862,"_3068":126042},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3612":74569,"_31165":74487,"_21586":126044,"_5":14831,"_28346":125866,"_3068":126045},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3612":74570,"_31165":74487,"_21586":126047,"_5":14831,"_28346":125870,"_3068":126048},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3612":74571,"_31165":74487,"_21586":126050,"_5":14831,"_28346":125870,"_3068":126051},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3612":74572,"_31165":74487,"_21586":126053,"_5":14831,"_28346":125870,"_3068":126054},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3612":74573,"_31165":74487,"_21586":126056,"_5":14831,"_28346":125870,"_3068":126057},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3612":74574,"_31165":74574,"_5":15196,"_3068":126059,"_31523":126060,"_21586":126061,"_28346":74574},"Perfiles de certificado",[50890,121593,56574,125613],[],{"_3612":74575,"_31165":74574,"_21586":126063,"_5":14831,"_28346":74574,"_3068":126064},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3612":74576,"_31165":74574,"_5":31520,"_21586":126066,"_28346":126067,"_3068":126068},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3612":74577,"_31165":74574,"_5":31520,"_21586":126070,"_28346":126071,"_3068":126072},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#validez","Validez",{"_3612":74578,"_31165":74574,"_5":31520,"_21586":126074,"_28346":126075,"_3068":126076},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3612":74579,"_31165":74574,"_5":31520,"_21586":126078,"_28346":126079,"_3068":126080},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3612":74580,"_31165":74574,"_5":31520,"_21586":126082,"_28346":126083,"_3068":126084},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3612":74581,"_31165":74574,"_5":31520,"_21586":126086,"_28346":126087,"_3068":126088},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3612":74582,"_31165":74574,"_5":31520,"_21586":126090,"_28346":126091,"_3068":126092},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3612":74583,"_31165":74574,"_5":31520,"_21586":126094,"_28346":126095,"_3068":126096},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3612":74584,"_31165":74574,"_5":31520,"_21586":126098,"_28346":126099,"_3068":126100},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3612":74585,"_31165":74574,"_5":31520,"_21586":126102,"_28346":126103,"_3068":126104},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3612":74586,"_31165":74574,"_5":31520,"_21586":126106,"_28346":126107,"_3068":126108},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3612":74587,"_31165":74574,"_5":31520,"_21586":126110,"_28346":126111,"_3068":126112},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3612":74588,"_31165":74574,"_5":31520,"_21586":126114,"_28346":126115,"_3068":126116},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3612":74589,"_31165":74574,"_5":31520,"_21586":126118,"_28346":126119,"_3068":126120},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3612":74590,"_31165":74574,"_5":31520,"_21586":126122,"_28346":126123,"_3068":126124},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3612":74591,"_31165":74574,"_5":31520,"_21586":126126,"_28346":126127,"_3068":126128},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3612":74592,"_31165":74574,"_21586":126130,"_5":14831,"_28346":74574,"_3068":126131},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3612":74593,"_31165":74574,"_21586":126133,"_5":14831,"_28346":74574,"_3068":126134},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3612":74594,"_31165":74574,"_21586":126136,"_5":14831,"_28346":126071,"_3068":126137},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3612":74595,"_31165":74574,"_21586":126139,"_5":14831,"_28346":126071,"_3068":126140},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3612":74596,"_31165":74574,"_21586":126142,"_5":14831,"_28346":126075,"_3068":126143},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3612":74597,"_31165":74574,"_21586":126145,"_5":14831,"_28346":126079,"_3068":126146},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3612":74598,"_31165":74574,"_21586":126148,"_5":14831,"_28346":126079,"_3068":126149},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3612":74599,"_31165":74574,"_21586":126151,"_5":14831,"_28346":126079,"_3068":126152},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3612":74600,"_31165":74574,"_21586":126154,"_5":14831,"_28346":126083,"_3068":126155},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3612":74601,"_31165":74574,"_21586":126157,"_5":14831,"_28346":126087,"_3068":126158},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3612":74602,"_31165":74574,"_21586":126160,"_5":14831,"_28346":126087,"_3068":126161},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3612":74603,"_31165":74574,"_21586":126163,"_5":14831,"_28346":126091,"_3068":126164},[],"La aplicación criptográfica puede:",{"_3612":74604,"_31165":74574,"_21586":126166,"_5":14831,"_28346":126091,"_3068":126167},[],"permitir o bloquear claves RSA;",{"_3612":74605,"_31165":74574,"_21586":126169,"_5":14831,"_28346":126091,"_3068":126170},[],"limitar los tamaños RSA admitidos;",{"_3612":74606,"_31165":74574,"_21586":126172,"_5":14831,"_28346":126091,"_3068":126173},[],"permitir o bloquear claves ECDSA;",{"_3612":74607,"_31165":74574,"_21586":126175,"_5":14831,"_28346":126091,"_3068":126176},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3612":74608,"_31165":74574,"_21586":126178,"_5":14831,"_28346":126091,"_3068":126179},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3612":74609,"_31165":74574,"_21586":126181,"_5":14831,"_28346":126095,"_3068":126182},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3612":74610,"_31165":74574,"_21586":126184,"_5":14831,"_28346":126095,"_3068":121353},[],{"_3612":74611,"_31165":74574,"_21586":126186,"_5":14831,"_28346":126095,"_3068":126187},[],"Primera opción",{"_3612":74612,"_31165":74574,"_21586":126189,"_5":14831,"_28346":126095,"_3068":126190},[],"Segunda opción",{"_3612":74613,"_31165":74574,"_21586":126192,"_5":14831,"_28346":126095,"_3068":126193},[],"Si no hay ninguna",{"_3612":74614,"_31165":74574,"_21586":126195,"_5":14831,"_28346":126095,"_3068":126196},[],"Firma directa con una CA",{"_3612":74615,"_31165":74574,"_21586":126198,"_5":14831,"_28346":126095,"_3068":126199},[],"`issuance_profile` incluido en la solicitud",{"_3612":74616,"_31165":74574,"_21586":126201,"_5":14831,"_28346":126095,"_3068":126202},[],"`issuance_profile_id` de la solicitud",{"_3612":74617,"_31165":74574,"_21586":126204,"_5":14831,"_28346":126095,"_3068":126205},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3612":74618,"_31165":74574,"_21586":126207,"_5":14831,"_28346":126095,"_3068":126208},[],"Emisión mediante DMS",{"_3612":74619,"_31165":74574,"_21586":126210,"_5":14831,"_28346":126095,"_3068":57173},[],{"_3612":74620,"_31165":74574,"_21586":126212,"_5":14831,"_28346":126095,"_3068":126213},[],"`settings.issuance_profile` incluido en el DMS",{"_3612":74621,"_31165":74574,"_21586":126215,"_5":14831,"_28346":126095,"_3068":126216},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3612":74622,"_31165":74574,"_21586":126218,"_5":14831,"_28346":126095,"_3068":126219},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3612":74623,"_31165":74574,"_21586":126221,"_5":14831,"_28346":126095,"_3068":126222},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3612":74624,"_31165":74574,"_21586":126224,"_5":14831,"_28346":126103,"_3068":126225},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3612":74625,"_31165":74574,"_21586":126227,"_5":14831,"_28346":126107,"_3068":126228},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3612":74626,"_31165":74574,"_21586":126230,"_5":14831,"_28346":126111,"_3068":126231},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3612":74627,"_31165":74574,"_21586":126233,"_5":14831,"_28346":126115,"_3068":126234},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3612":74628,"_31165":74574,"_21586":126236,"_5":14831,"_28346":126119,"_3068":126237},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3612":74629,"_31165":74574,"_21586":126239,"_5":14831,"_28346":126119,"_3068":126240},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3612":74630,"_31165":74574,"_21586":126242,"_5":14831,"_28346":126123,"_3068":126243},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3612":74631,"_31165":74574,"_21586":126245,"_5":14831,"_28346":126123,"_3068":126246},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3612":74632,"_31165":74574,"_21586":126248,"_5":14831,"_28346":126123,"_3068":126249},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3612":74633,"_31165":74574,"_21586":126251,"_5":14831,"_28346":126123,"_3068":126252},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3612":74634,"_31165":74574,"_21586":126254,"_5":14831,"_28346":126127,"_3068":126255},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3612":74635,"_31165":74574,"_21586":126257,"_5":14831,"_28346":126127,"_3068":126258},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3612":74636,"_31165":74636,"_5":15196,"_3068":126260,"_31523":126261,"_21586":126263,"_28346":74636},"Validación de certificados",[50890,121593,56574,126262],"Validación",[],{"_3612":74637,"_31165":74636,"_21586":126265,"_5":14831,"_28346":74636,"_3068":126266},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3612":74638,"_31165":74636,"_5":31520,"_21586":126268,"_28346":126269,"_3068":126270},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3612":74639,"_31165":74636,"_5":31520,"_21586":126272,"_28346":126273,"_3068":126274},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3612":74640,"_31165":74636,"_5":31520,"_21586":126276,"_28346":126277,"_3068":126278},[],"/docs/pr-preview/pr-77/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3612":74641,"_31165":74636,"_21586":126280,"_5":14831,"_28346":74636,"_3068":126281},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3612":74642,"_31165":74636,"_21586":126283,"_5":14831,"_28346":126269,"_3068":126284},[],"Verifica estos criterios juntos:",{"_3612":74643,"_31165":74636,"_21586":126286,"_5":14831,"_28346":126269,"_3068":125242},[],{"_3612":74644,"_31165":74636,"_21586":126288,"_5":14831,"_28346":126269,"_3068":126289},[],"Resultado necesario",{"_3612":74645,"_31165":74636,"_21586":126291,"_5":14831,"_28346":126269,"_3068":126292},[],"Cadena y firma",{"_3612":74646,"_31165":74636,"_21586":126294,"_5":14831,"_28346":126269,"_3068":126295},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3612":74647,"_31165":74636,"_21586":126297,"_5":14831,"_28346":126269,"_3068":126298},[],"Fechas",{"_3612":74648,"_31165":74636,"_21586":126300,"_5":14831,"_28346":126269,"_3068":126301},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3612":74649,"_31165":74636,"_21586":126303,"_5":14831,"_28346":126269,"_3068":121263},[],{"_3612":74650,"_31165":74636,"_21586":126305,"_5":14831,"_28346":126269,"_3068":126306},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3612":74651,"_31165":74636,"_21586":126308,"_5":14831,"_28346":126269,"_3068":126309},[],"Uso",{"_3612":74652,"_31165":74636,"_21586":126311,"_5":14831,"_28346":126269,"_3068":126312},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3612":74653,"_31165":74636,"_21586":126314,"_5":14831,"_28346":126269,"_3068":126315},[],"Revocación",{"_3612":74654,"_31165":74636,"_21586":126317,"_5":14831,"_28346":126269,"_3068":126318},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3612":74655,"_31165":74636,"_21586":126320,"_5":14831,"_28346":126269,"_3068":126321},[],"Autorización",{"_3612":74656,"_31165":74636,"_21586":126323,"_5":14831,"_28346":126269,"_3068":126324},[],"La aplicación permite la acción a esa identidad.",{"_3612":74657,"_31165":74636,"_21586":126326,"_5":14831,"_28346":126269,"_3068":126327},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3612":74658,"_31165":74636,"_21586":126329,"_5":14831,"_28346":126273,"_3068":126330},[],"Mecanismo",{"_3612":74659,"_31165":74636,"_21586":126332,"_5":14831,"_28346":126273,"_3068":126333},[],"Cuándo utilizarlo",{"_3612":74660,"_31165":74636,"_21586":126335,"_5":14831,"_28346":126273,"_3068":126336},[],"Qué debes mantener",{"_3612":74661,"_31165":74636,"_21586":126338,"_5":14831,"_28346":126273,"_3068":57301},[],{"_3612":74662,"_31165":74636,"_21586":126340,"_5":14831,"_28346":126273,"_3068":126341},[],"Consulta del estado de un certificado concreto.",{"_3612":74663,"_31165":74636,"_21586":126343,"_5":14831,"_28346":126273,"_3068":126344},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3612":74664,"_31165":74636,"_21586":126346,"_5":14831,"_28346":126273,"_3068":57310},[],{"_3612":74665,"_31165":74636,"_21586":126348,"_5":14831,"_28346":126273,"_3068":126349},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3612":74666,"_31165":74636,"_21586":126351,"_5":14831,"_28346":126273,"_3068":126352},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3612":74667,"_31165":74636,"_21586":126354,"_5":14831,"_28346":126273,"_3068":126355},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3612":74668,"_31165":74636,"_21586":126357,"_5":14831,"_28346":126273,"_3068":126358},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3612":74669,"_31165":74636,"_21586":126360,"_5":14831,"_28346":126277,"_3068":126361},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3612":74670,"_31165":74636,"_21586":126363,"_5":14831,"_28346":126277,"_3068":126364},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3612":74671,"_31165":74636,"_21586":126366,"_5":14831,"_28346":126277,"_3068":126367},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3612":74672,"_31165":74636,"_21586":126369,"_5":14831,"_28346":126277,"_3068":126370},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3612":74673,"_31165":74636,"_21586":126372,"_5":14831,"_28346":126277,"_3068":126373},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3612":74674,"_31165":74636,"_21586":126375,"_5":14831,"_28346":126277,"_3068":126376},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3612":74675,"_31165":74636,"_21586":126378,"_5":14831,"_28346":126277,"_3068":126379},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3612":74676,"_31165":74636,"_21586":126381,"_5":14831,"_28346":126277,"_3068":126382},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3612":74677,"_31165":74636,"_21586":126384,"_5":14831,"_28346":126277,"_3068":126385},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3612":74678,"_31165":74678,"_5":15196,"_3068":126387,"_31523":126388,"_21586":126389,"_28346":74678},"Certificados",[50890,121593,56574,125613],[],{"_3612":74679,"_31165":74678,"_21586":126391,"_5":14831,"_28346":74678,"_3068":126392},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3612":74680,"_31165":74678,"_5":31520,"_21586":126394,"_28346":126395,"_3068":126396},[],"/docs/pr-preview/pr-77/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3612":74681,"_31165":74678,"_5":31520,"_21586":126398,"_28346":126399,"_3068":126400},[],"/docs/pr-preview/pr-77/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3612":74682,"_31165":74678,"_5":31520,"_21586":126402,"_28346":126403,"_3068":126404},[],"/docs/pr-preview/pr-77/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3612":74683,"_31165":74678,"_5":31520,"_21586":126406,"_28346":126407,"_3068":126408},[],"/docs/pr-preview/pr-77/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3612":74684,"_31165":74678,"_5":31520,"_21586":126410,"_28346":126411,"_3068":126412},[],"/docs/pr-preview/pr-77/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3612":74685,"_31165":74678,"_5":31520,"_21586":126414,"_28346":126415,"_3068":126416},[],"/docs/pr-preview/pr-77/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3612":74686,"_31165":74678,"_5":31520,"_21586":126418,"_28346":126419,"_3068":126420},[],"/docs/pr-preview/pr-77/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3612":74687,"_31165":74678,"_5":31520,"_21586":126422,"_28346":126423,"_3068":126424},[],"/docs/pr-preview/pr-77/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3612":74688,"_31165":74678,"_5":31520,"_21586":126426,"_28346":126427,"_3068":126428},[],"/docs/pr-preview/pr-77/es/platform/pki/certificates#continúa","Continúa",{"_3612":74689,"_31165":74678,"_21586":126430,"_5":14831,"_28346":74678,"_3068":126431},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3612":74690,"_31165":74678,"_21586":126433,"_5":14831,"_28346":126395,"_3068":126434},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3612":74691,"_31165":74678,"_21586":126436,"_5":14831,"_28346":126395,"_3068":126437},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3612":74692,"_31165":74678,"_21586":126439,"_5":14831,"_28346":126395,"_3068":126440},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3612":74693,"_31165":74678,"_21586":126442,"_5":14831,"_28346":126395,"_3068":126443},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3612":74694,"_31165":74678,"_21586":126445,"_5":14831,"_28346":126395,"_3068":126446},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3612":74695,"_31165":74678,"_21586":126448,"_5":14831,"_28346":126395,"_3068":126449},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3612":74696,"_31165":74678,"_21586":126451,"_5":14831,"_28346":126395,"_3068":126452},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3612":74697,"_31165":74678,"_21586":126454,"_5":14831,"_28346":126399,"_3068":126455},[],"Descarga el PEM e inspecciónalo:",{"_3612":74698,"_31165":74678,"_21586":126457,"_5":14831,"_28346":126399,"_3068":126458},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3612":74699,"_31165":74678,"_21586":126460,"_5":14831,"_28346":126403,"_3068":126461},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3612":74700,"_31165":74678,"_21586":126463,"_5":14831,"_28346":126403,"_3068":126464},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3612":74701,"_31165":74678,"_21586":126466,"_5":14831,"_28346":126403,"_3068":126467},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3612":74702,"_31165":74678,"_21586":126469,"_5":14831,"_28346":126403,"_3068":126470},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3612":74703,"_31165":74678,"_21586":126472,"_5":14831,"_28346":126403,"_3068":126473},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3612":74704,"_31165":74678,"_21586":126475,"_5":14831,"_28346":126403,"_3068":126476},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3612":74705,"_31165":74678,"_21586":126478,"_5":14831,"_28346":126403,"_3068":126479},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3612":74706,"_31165":74678,"_21586":126481,"_5":14831,"_28346":126407,"_3068":126482},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3612":74707,"_31165":74678,"_21586":126484,"_5":14831,"_28346":126411,"_3068":126485},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3612":74708,"_31165":74678,"_21586":126487,"_5":14831,"_28346":126415,"_3068":126488},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3612":74709,"_31165":74678,"_21586":126490,"_5":14831,"_28346":126419,"_3068":126491},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3612":74710,"_31165":74678,"_21586":126493,"_5":14831,"_28346":126419,"_3068":126494},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3612":74711,"_31165":74678,"_21586":126496,"_5":14831,"_28346":126419,"_3068":126497},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3612":74712,"_31165":74678,"_21586":126499,"_5":14831,"_28346":126423,"_3068":126500},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3612":74713,"_31165":74678,"_21586":126502,"_5":14831,"_28346":126423,"_3068":126503},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3612":74714,"_31165":74678,"_21586":126505,"_5":14831,"_28346":126423,"_3068":126506},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3612":74715,"_31165":74678,"_21586":126508,"_5":14831,"_28346":126427,"_3068":126509},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3612":74716,"_31165":74678,"_21586":126511,"_5":14831,"_28346":126427,"_3068":126512},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3612":74717,"_31165":74717,"_5":15196,"_3068":126514,"_31523":126515,"_21586":126517,"_28346":74717},"Ciclo de vida de un certificado",[50890,121593,56574,126516],"Conceptos",[],{"_3612":74718,"_31165":74717,"_21586":126519,"_5":14831,"_28346":74717,"_3068":126520},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3612":74719,"_31165":74717,"_5":31520,"_21586":126522,"_28346":126523,"_3068":126524},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3612":74720,"_31165":74717,"_5":31520,"_21586":126526,"_28346":126527,"_3068":126528},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3612":74721,"_31165":74717,"_5":31520,"_21586":126530,"_28346":126531,"_3068":126532},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3612":74722,"_31165":74717,"_5":31520,"_21586":126534,"_28346":126535,"_3068":126536},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3612":74723,"_31165":74717,"_5":31520,"_21586":126538,"_28346":126539,"_3068":126540},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3612":74724,"_31165":74717,"_5":31520,"_21586":126542,"_28346":126543,"_3068":126544},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3612":74725,"_31165":74717,"_5":31520,"_21586":126546,"_28346":126547,"_3068":124236},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3612":74726,"_31165":74717,"_5":31520,"_21586":126549,"_28346":126550,"_3068":126551},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3612":74727,"_31165":74717,"_5":31520,"_21586":126553,"_28346":126554,"_3068":126555},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3612":74728,"_31165":74717,"_5":31520,"_21586":126557,"_28346":126558,"_3068":126559},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3612":74729,"_31165":74717,"_21586":126561,"_5":14831,"_28346":74717,"_3068":126562},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3612":74730,"_31165":74717,"_21586":126564,"_5":14831,"_28346":126527,"_3068":126565},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3612":74731,"_31165":74717,"_21586":126567,"_5":14831,"_28346":126531,"_3068":126568},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3612":74732,"_31165":74717,"_21586":126570,"_5":14831,"_28346":126535,"_3068":126571},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3612":74733,"_31165":74717,"_21586":126573,"_5":14831,"_28346":126539,"_3068":126574},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3612":74734,"_31165":74717,"_21586":126576,"_5":14831,"_28346":126543,"_3068":126577},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3612":74735,"_31165":74717,"_21586":126579,"_5":14831,"_28346":126547,"_3068":126580},[],"Lamassu persiste cuatro estados X.509:",{"_3612":74736,"_31165":74717,"_21586":126582,"_5":14831,"_28346":126547,"_3068":126583},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3612":74737,"_31165":74717,"_21586":126585,"_5":14831,"_28346":126547,"_3068":126586},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3612":74738,"_31165":74717,"_21586":126588,"_5":14831,"_28346":126547,"_3068":126589},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3612":74739,"_31165":74717,"_21586":126591,"_5":14831,"_28346":126547,"_3068":126592},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3612":74740,"_31165":74717,"_21586":126594,"_5":14831,"_28346":126547,"_3068":126595},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3612":74741,"_31165":74717,"_21586":126597,"_5":14831,"_28346":126550,"_3068":126598},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3612":74742,"_31165":74717,"_21586":126600,"_5":14831,"_28346":126550,"_3068":126601},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3612":74743,"_31165":74717,"_21586":126603,"_5":14831,"_28346":126550,"_3068":126604},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3612":74744,"_31165":74717,"_21586":126606,"_5":14831,"_28346":126554,"_3068":126607},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3612":74745,"_31165":74717,"_21586":126609,"_5":14831,"_28346":126554,"_3068":126610},[],"Antes de confirmar:",{"_3612":74746,"_31165":74717,"_21586":126612,"_5":14831,"_28346":126554,"_3068":126613},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3612":74747,"_31165":74717,"_21586":126615,"_5":14831,"_28346":126554,"_3068":126616},[],"Distribuye la nueva cadena de confianza.",{"_3612":74748,"_31165":74717,"_21586":126618,"_5":14831,"_28346":126554,"_3068":126619},[],"Reemite las identidades necesarias.",{"_3612":74749,"_31165":74717,"_21586":126621,"_5":14831,"_28346":126554,"_3068":126622},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3612":74750,"_31165":74717,"_21586":126624,"_5":14831,"_28346":126554,"_3068":126625},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3612":74751,"_31165":74717,"_21586":126627,"_5":14831,"_28346":126554,"_3068":126628},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3612":74752,"_31165":74717,"_21586":126630,"_5":14831,"_28346":126558,"_3068":126631},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3612":74753,"_31165":74717,"_21586":126633,"_5":14831,"_28346":126558,"_3068":126634},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3612":74754,"_31165":74717,"_21586":126636,"_5":14831,"_28346":126558,"_3068":126637},[],"Cambios de estado y razones de revocación.",{"_3612":74755,"_31165":74717,"_21586":126639,"_5":14831,"_28346":126558,"_3068":126640},[],"Publicación y vigencia de OCSP y CRLs.",{"_3612":74756,"_31165":74717,"_21586":126642,"_5":14831,"_28346":126558,"_3068":126643},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3612":74757,"_31165":74717,"_21586":126645,"_5":14831,"_28346":126558,"_3068":126646},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3612":74758,"_31165":74758,"_5":15196,"_3068":126648,"_31523":126649,"_21586":126650,"_28346":74758},"Modelo de confianza",[50890,121593,56574,126516],[],{"_3612":74759,"_31165":74758,"_21586":126652,"_5":14831,"_28346":74758,"_3068":126653},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3612":74760,"_31165":74758,"_5":31520,"_21586":126655,"_28346":126656,"_3068":126657},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3612":74761,"_31165":74758,"_5":31520,"_21586":126659,"_28346":126660,"_3068":126661},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3612":74762,"_31165":74758,"_5":31520,"_21586":126663,"_28346":126664,"_3068":126665},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3612":74763,"_31165":74758,"_5":31520,"_21586":126667,"_28346":126668,"_3068":126669},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3612":74764,"_31165":74758,"_5":31520,"_21586":126671,"_28346":126672,"_3068":126673},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3612":74765,"_31165":74758,"_5":31520,"_21586":126675,"_28346":126676,"_3068":126677},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3612":74766,"_31165":74758,"_5":31520,"_21586":126679,"_28346":126680,"_3068":126681},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3612":74767,"_31165":74758,"_5":31520,"_21586":126683,"_28346":126684,"_3068":126685},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3612":74768,"_31165":74758,"_5":31520,"_21586":126687,"_28346":126688,"_3068":126689},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3612":74769,"_31165":74758,"_5":31520,"_21586":126691,"_28346":126692,"_3068":126693},[],"/docs/pr-preview/pr-77/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3612":74770,"_31165":74758,"_21586":126695,"_5":14831,"_28346":74758,"_3068":126696},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3612":74771,"_31165":74758,"_21586":126698,"_5":14831,"_28346":126660,"_3068":126699},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3612":74772,"_31165":74758,"_21586":126701,"_5":14831,"_28346":126664,"_3068":126702},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3612":74773,"_31165":74758,"_21586":126704,"_5":14831,"_28346":126668,"_3068":126705},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3612":74774,"_31165":74758,"_21586":126707,"_5":14831,"_28346":126672,"_3068":126708},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3612":74775,"_31165":74758,"_21586":126710,"_5":14831,"_28346":126676,"_3068":126711},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3612":74776,"_31165":74758,"_21586":126713,"_5":14831,"_28346":126676,"_3068":126714},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3612":74777,"_31165":74758,"_21586":126716,"_5":14831,"_28346":126676,"_3068":126717},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3612":74778,"_31165":74758,"_21586":126719,"_5":14831,"_28346":126676,"_3068":126720},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3612":74779,"_31165":74758,"_21586":126722,"_5":14831,"_28346":126676,"_3068":126723},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3612":74780,"_31165":74758,"_21586":126725,"_5":14831,"_28346":126676,"_3068":126726},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3612":74781,"_31165":74758,"_21586":126728,"_5":14831,"_28346":126680,"_3068":126729},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3612":74782,"_31165":74758,"_21586":126731,"_5":14831,"_28346":126680,"_3068":126732},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3612":74783,"_31165":74758,"_21586":126734,"_5":14831,"_28346":126680,"_3068":126735},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3612":74784,"_31165":74758,"_21586":126737,"_5":14831,"_28346":126680,"_3068":126738},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3612":74785,"_31165":74758,"_21586":126740,"_5":14831,"_28346":126680,"_3068":126741},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3612":74786,"_31165":74758,"_21586":126743,"_5":14831,"_28346":126684,"_3068":126744},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3612":74787,"_31165":74758,"_21586":126746,"_5":14831,"_28346":126684,"_3068":126747},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3612":74788,"_31165":74758,"_21586":126749,"_5":14831,"_28346":126684,"_3068":126750},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3612":74789,"_31165":74758,"_21586":126752,"_5":14831,"_28346":126684,"_3068":126753},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3612":74790,"_31165":74758,"_21586":126755,"_5":14831,"_28346":126684,"_3068":126756},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3612":74791,"_31165":74758,"_21586":126758,"_5":14831,"_28346":126684,"_3068":126759},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3612":74792,"_31165":74758,"_21586":126761,"_5":14831,"_28346":126684,"_3068":126762},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3612":74793,"_31165":74758,"_21586":126764,"_5":14831,"_28346":126688,"_3068":126765},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3612":74794,"_31165":74758,"_21586":126767,"_5":14831,"_28346":126692,"_3068":126768},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3612":74795,"_31165":74758,"_21586":126770,"_5":14831,"_28346":126692,"_3068":126771},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3612":74796,"_31165":74758,"_21586":126773,"_5":14831,"_28346":126692,"_3068":126774},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3612":74797,"_31165":74758,"_21586":126776,"_5":14831,"_28346":126692,"_3068":126777},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3612":74798,"_31165":74758,"_21586":126779,"_5":14831,"_28346":126692,"_3068":126780},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3612":74799,"_31165":74758,"_21586":126782,"_5":14831,"_28346":126692,"_3068":126783},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3612":74800,"_31165":74758,"_21586":126785,"_5":14831,"_28346":126692,"_3068":126786},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3612":74801,"_31165":74801,"_5":15196,"_3068":126788,"_31523":126789,"_21586":126790,"_28346":74801},"Listas de revocación (CRL)",[50890,121593,56574,126262],[],{"_3612":74802,"_31165":74801,"_21586":126792,"_5":14831,"_28346":74801,"_3068":126793},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3612":74803,"_31165":74801,"_5":31520,"_21586":126795,"_28346":126796,"_3068":126797},[],"/docs/pr-preview/pr-77/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3612":74804,"_31165":74801,"_5":31520,"_21586":126799,"_28346":126800,"_3068":126801},[],"/docs/pr-preview/pr-77/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3612":74805,"_31165":74801,"_5":31520,"_21586":126803,"_28346":126804,"_3068":126805},[],"/docs/pr-preview/pr-77/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3612":74806,"_31165":74801,"_5":31520,"_21586":126807,"_28346":126808,"_3068":126809},[],"/docs/pr-preview/pr-77/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3612":74807,"_31165":74801,"_5":31520,"_21586":126811,"_28346":126812,"_3068":126813},[],"/docs/pr-preview/pr-77/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3612":74808,"_31165":74801,"_5":31520,"_21586":126815,"_28346":126816,"_3068":126817},[],"/docs/pr-preview/pr-77/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3612":74809,"_31165":74801,"_5":31520,"_21586":126819,"_28346":126820,"_3068":126821},[],"/docs/pr-preview/pr-77/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3612":74810,"_31165":74801,"_5":31520,"_21586":126823,"_28346":126824,"_3068":126825},[],"/docs/pr-preview/pr-77/es/platform/pki/crl#referencias","Referencias",{"_3612":74811,"_31165":74801,"_21586":126827,"_5":14831,"_28346":74801,"_3068":126828},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3612":74812,"_31165":74801,"_21586":126830,"_5":14831,"_28346":126796,"_3068":126831},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3612":74813,"_31165":74801,"_21586":126833,"_5":14831,"_28346":126796,"_3068":126834},[],"Campo",{"_3612":74814,"_31165":74801,"_21586":126836,"_5":14831,"_28346":126796,"_3068":123276},[],{"_3612":74815,"_31165":74801,"_21586":126838,"_5":14831,"_28346":126796,"_3068":52522},[],{"_3612":74816,"_31165":74801,"_21586":126840,"_5":14831,"_28346":126796,"_3068":126841},[],"ID de la CA a la que pertenecen los ajustes.",{"_3612":74817,"_31165":74801,"_21586":126843,"_5":14831,"_28346":126796,"_3068":57809},[],{"_3612":74818,"_31165":74801,"_21586":126845,"_5":14831,"_28346":126796,"_3068":126846},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3612":74819,"_31165":74801,"_21586":126848,"_5":14831,"_28346":126796,"_3068":57815},[],{"_3612":74820,"_31165":74801,"_21586":126850,"_5":14831,"_28346":126796,"_3068":126851},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3612":74821,"_31165":74801,"_21586":126853,"_5":14831,"_28346":126796,"_3068":57821},[],{"_3612":74822,"_31165":74801,"_21586":126855,"_5":14831,"_28346":126796,"_3068":126856},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3612":74823,"_31165":74801,"_21586":126858,"_5":14831,"_28346":126796,"_3068":126859},[],"Campo de `crl_options`",{"_3612":74824,"_31165":74801,"_21586":126861,"_5":14831,"_28346":126796,"_3068":123276},[],{"_3612":74825,"_31165":74801,"_21586":126863,"_5":14831,"_28346":126796,"_3068":126864},[],"Valor inicial",{"_3612":74826,"_31165":74801,"_21586":126866,"_5":14831,"_28346":126796,"_3068":57835},[],{"_3612":74827,"_31165":74801,"_21586":126868,"_5":14831,"_28346":126796,"_3068":126869},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3612":74828,"_31165":74801,"_21586":126871,"_5":14831,"_28346":126796,"_3068":126872},[],"7 días.",{"_3612":74829,"_31165":74801,"_21586":126874,"_5":14831,"_28346":126796,"_3068":57844},[],{"_3612":74830,"_31165":74801,"_21586":126876,"_5":14831,"_28346":126796,"_3068":126877},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3612":74831,"_31165":74801,"_21586":126879,"_5":14831,"_28346":126796,"_3068":126880},[],"6 días y 23 horas.",{"_3612":74832,"_31165":74801,"_21586":126882,"_5":14831,"_28346":126796,"_3068":57853},[],{"_3612":74833,"_31165":74801,"_21586":126884,"_5":14831,"_28346":126796,"_3068":126885},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3612":74834,"_31165":74801,"_21586":126887,"_5":14831,"_28346":126796,"_3068":57859},[],{"_3612":74835,"_31165":74801,"_21586":126889,"_5":14831,"_28346":126796,"_3068":57862},[],{"_3612":74836,"_31165":74801,"_21586":126891,"_5":14831,"_28346":126796,"_3068":126892},[],"Número de serie del certificado existente que firma la CRL.",{"_3612":74837,"_31165":74801,"_21586":126894,"_5":14831,"_28346":126796,"_3068":126895},[],"Número de serie del certificado actual de la CA.",{"_3612":74838,"_31165":74801,"_21586":126897,"_5":14831,"_28346":126796,"_3068":126898},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3612":74839,"_31165":74801,"_21586":126900,"_5":14831,"_28346":126796,"_3068":126901},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3612":74840,"_31165":74801,"_21586":126903,"_5":14831,"_28346":126796,"_3068":126904},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3612":74841,"_31165":74801,"_21586":126906,"_5":14831,"_28346":126796,"_3068":126907},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3612":74842,"_31165":74801,"_21586":126909,"_5":14831,"_28346":126796,"_3068":126910},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3612":74843,"_31165":74801,"_21586":126912,"_5":14831,"_28346":126796,"_3068":126913},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3612":74844,"_31165":74801,"_21586":126915,"_5":14831,"_28346":126796,"_3068":126916},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3612":74845,"_31165":74801,"_21586":126918,"_5":14831,"_28346":126796,"_3068":126919},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3612":74846,"_31165":74801,"_21586":126921,"_5":14831,"_28346":126796,"_3068":126922},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3612":74847,"_31165":74801,"_21586":126924,"_5":14831,"_28346":126796,"_3068":126925},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3612":74848,"_31165":74801,"_21586":126927,"_5":14831,"_28346":126796,"_3068":126928},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3612":74849,"_31165":74801,"_21586":126930,"_5":14831,"_28346":126800,"_3068":126931},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3612":74850,"_31165":74801,"_21586":126933,"_5":14831,"_28346":126800,"_3068":126934},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3612":74851,"_31165":74801,"_21586":126936,"_5":14831,"_28346":126800,"_3068":126937},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3612":74852,"_31165":74801,"_21586":126939,"_5":14831,"_28346":126800,"_3068":126940},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3612":74853,"_31165":74801,"_21586":126942,"_5":14831,"_28346":126804,"_3068":126943},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3612":74854,"_31165":74801,"_21586":126945,"_5":14831,"_28346":126804,"_3068":126946},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3612":74855,"_31165":74801,"_21586":126948,"_5":14831,"_28346":126804,"_3068":126949},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3612":74856,"_31165":74801,"_21586":126951,"_5":14831,"_28346":126804,"_3068":126952},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3612":74857,"_31165":74801,"_21586":126954,"_5":14831,"_28346":126804,"_3068":126955},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3612":74858,"_31165":74801,"_21586":126957,"_5":14831,"_28346":126804,"_3068":126958},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3612":74859,"_31165":74801,"_21586":126960,"_5":14831,"_28346":126804,"_3068":126961},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3612":74860,"_31165":74801,"_21586":126963,"_5":14831,"_28346":126804,"_3068":126964},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3612":74861,"_31165":74801,"_21586":126966,"_5":14831,"_28346":126804,"_3068":126967},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3612":74862,"_31165":74801,"_21586":126969,"_5":14831,"_28346":126808,"_3068":126970},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3612":74863,"_31165":74801,"_21586":126972,"_5":14831,"_28346":126808,"_3068":126973},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3612":74864,"_31165":74801,"_21586":126975,"_5":14831,"_28346":126812,"_3068":126976},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3612":74865,"_31165":74801,"_21586":126978,"_5":14831,"_28346":126812,"_3068":126979},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3612":74866,"_31165":74801,"_21586":126981,"_5":14831,"_28346":126812,"_3068":126982},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3612":74867,"_31165":74801,"_21586":126984,"_5":14831,"_28346":126812,"_3068":126985},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3612":74868,"_31165":74801,"_21586":126987,"_5":14831,"_28346":126812,"_3068":126988},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3612":74869,"_31165":74801,"_21586":126990,"_5":14831,"_28346":126816,"_3068":126991},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3612":74870,"_31165":74801,"_21586":126993,"_5":14831,"_28346":126816,"_3068":123465},[],{"_3612":74871,"_31165":74801,"_21586":126995,"_5":14831,"_28346":126816,"_3068":126996},[],"Path relativo",{"_3612":74872,"_31165":74801,"_21586":126998,"_5":14831,"_28346":126816,"_3068":121353},[],{"_3612":74873,"_31165":74801,"_21586":127000,"_5":14831,"_28346":126816,"_3068":57974},[],{"_3612":74874,"_31165":74801,"_21586":127002,"_5":14831,"_28346":126816,"_3068":57977},[],{"_3612":74875,"_31165":74801,"_21586":127004,"_5":14831,"_28346":126816,"_3068":127005},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3612":74876,"_31165":74801,"_21586":127007,"_5":14831,"_28346":126816,"_3068":57974},[],{"_3612":74877,"_31165":74801,"_21586":127009,"_5":14831,"_28346":126816,"_3068":57985},[],{"_3612":74878,"_31165":74801,"_21586":127011,"_5":14831,"_28346":126816,"_3068":127012},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3612":74879,"_31165":74801,"_21586":127014,"_5":14831,"_28346":126816,"_3068":57991},[],{"_3612":74880,"_31165":74801,"_21586":127016,"_5":14831,"_28346":126816,"_3068":57985},[],{"_3612":74881,"_31165":74801,"_21586":127018,"_5":14831,"_28346":126816,"_3068":127019},[],"Sustituir la configuración de CRL de una CA.",{"_3612":74882,"_31165":74801,"_21586":127021,"_5":14831,"_28346":126816,"_3068":57999},[],{"_3612":74883,"_31165":74801,"_21586":127023,"_5":14831,"_28346":126816,"_3068":57985},[],{"_3612":74884,"_31165":74801,"_21586":127025,"_5":14831,"_28346":126816,"_3068":127026},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3612":74885,"_31165":74801,"_21586":127028,"_5":14831,"_28346":126816,"_3068":127029},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3612":74886,"_31165":74801,"_21586":127031,"_5":14831,"_28346":126816,"_3068":127032},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3612":74887,"_31165":74801,"_21586":127034,"_5":14831,"_28346":126816,"_3068":127035},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3612":74888,"_31165":74801,"_21586":127037,"_5":14831,"_28346":126820,"_3068":127038},[],"Síntoma",{"_3612":74889,"_31165":74801,"_21586":127040,"_5":14831,"_28346":126820,"_3068":127041},[],"Causa",{"_3612":74890,"_31165":74801,"_21586":127043,"_5":14831,"_28346":126820,"_3068":127044},[],"Acción",{"_3612":74891,"_31165":74801,"_21586":127046,"_5":14831,"_28346":126820,"_3068":127047},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3612":74892,"_31165":74801,"_21586":127049,"_5":14831,"_28346":126820,"_3068":127050},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3612":74893,"_31165":74801,"_21586":127052,"_5":14831,"_28346":126820,"_3068":127053},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3612":74894,"_31165":74801,"_21586":127055,"_5":14831,"_28346":126820,"_3068":127056},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3612":74895,"_31165":74801,"_21586":127058,"_5":14831,"_28346":126820,"_3068":127059},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3612":74896,"_31165":74801,"_21586":127061,"_5":14831,"_28346":126820,"_3068":127062},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3612":74897,"_31165":74801,"_21586":127064,"_5":14831,"_28346":126820,"_3068":127065},[],"`PUT` devuelve 400.",{"_3612":74898,"_31165":74801,"_21586":127067,"_5":14831,"_28346":126820,"_3068":127068},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3612":74899,"_31165":74801,"_21586":127070,"_5":14831,"_28346":126820,"_3068":127071},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3612":74900,"_31165":74801,"_21586":127073,"_5":14831,"_28346":126820,"_3068":127074},[],"`PUT` devuelve 404.",{"_3612":74901,"_31165":74801,"_21586":127076,"_5":14831,"_28346":126820,"_3068":127077},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3612":74902,"_31165":74801,"_21586":127079,"_5":14831,"_28346":126820,"_3068":127080},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3612":74903,"_31165":74801,"_21586":127082,"_5":14831,"_28346":126820,"_3068":127083},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3612":74904,"_31165":74801,"_21586":127085,"_5":14831,"_28346":126820,"_3068":127086},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3612":74905,"_31165":74801,"_21586":127088,"_5":14831,"_28346":126820,"_3068":127089},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3612":74906,"_31165":74801,"_21586":127091,"_5":14831,"_28346":126820,"_3068":127092},[],"La CRL no cambia tras revocar un certificado.",{"_3612":74907,"_31165":74801,"_21586":127094,"_5":14831,"_28346":126820,"_3068":127095},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3612":74908,"_31165":74801,"_21586":127097,"_5":14831,"_28346":126820,"_3068":127098},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3612":74909,"_31165":74801,"_21586":127100,"_5":14831,"_28346":126820,"_3068":127101},[],"Un verificador rechaza la CRL por el emisor.",{"_3612":74910,"_31165":74801,"_21586":127103,"_5":14831,"_28346":126820,"_3068":127104},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3612":74911,"_31165":74801,"_21586":127106,"_5":14831,"_28346":126820,"_3068":127107},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3612":74912,"_31165":74801,"_21586":127109,"_5":14831,"_28346":126824,"_3068":127110},[],"RFC 5280: perfil X.509 y CRL.",{"_3612":74913,"_31165":74801,"_21586":127112,"_5":14831,"_28346":126824,"_3068":58091},[],{"_3612":74914,"_31165":74801,"_21586":127114,"_5":14831,"_28346":126824,"_3068":58094},[],{"_3612":74915,"_31165":74801,"_21586":127116,"_5":14831,"_28346":126824,"_3068":127117},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3612":74916,"_31165":74801,"_21586":127119,"_5":14831,"_28346":126824,"_3068":127120},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3612":74917,"_31165":74917,"_5":15196,"_3068":127122,"_31523":127123,"_21586":127124,"_28346":74917},"Claves y motores criptográficos",[50890,121593,56574,125613],[],{"_3612":74918,"_31165":74917,"_21586":127126,"_5":14831,"_28346":74917,"_3068":127127},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3612":74919,"_31165":74917,"_5":31520,"_21586":127129,"_28346":127130,"_3068":127131},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3612":74920,"_31165":74917,"_5":31520,"_21586":127133,"_28346":127134,"_3068":127135},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3612":74921,"_31165":74917,"_5":31520,"_21586":127137,"_28346":127138,"_3068":58119},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#file-system",{"_3612":74922,"_31165":74917,"_5":31520,"_21586":127140,"_28346":127141,"_3068":58123},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#hashicorp-vault",{"_3612":74923,"_31165":74917,"_5":31520,"_21586":127143,"_28346":127144,"_3068":58127},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#aws-secrets-manager",{"_3612":74924,"_31165":74917,"_5":31520,"_21586":127146,"_28346":127147,"_3068":58131},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#aws-kms",{"_3612":74925,"_31165":74917,"_5":31520,"_21586":127149,"_28346":127150,"_3068":58135},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#pkcs11",{"_3612":74926,"_31165":74917,"_5":31520,"_21586":127152,"_28346":127153,"_3068":58139},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#azure-key-vault",{"_3612":74927,"_31165":74917,"_5":31520,"_21586":127155,"_28346":127156,"_3068":127157},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3612":74928,"_31165":74917,"_5":31520,"_21586":127159,"_28346":127160,"_3068":127161},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3612":74929,"_31165":74917,"_5":31520,"_21586":127163,"_28346":127164,"_3068":127165},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3612":74930,"_31165":74917,"_5":31520,"_21586":127167,"_28346":127168,"_3068":127169},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3612":74931,"_31165":74917,"_5":31520,"_21586":127171,"_28346":127172,"_3068":127173},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3612":74932,"_31165":74917,"_5":31520,"_21586":127175,"_28346":127176,"_3068":127177},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3612":74933,"_31165":74917,"_5":31520,"_21586":127179,"_28346":127180,"_3068":127181},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3612":74934,"_31165":74917,"_5":31520,"_21586":127183,"_28346":127184,"_3068":58171},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#sign",{"_3612":74935,"_31165":74917,"_5":31520,"_21586":127186,"_28346":127187,"_3068":58175},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#verify",{"_3612":74936,"_31165":74917,"_5":31520,"_21586":127189,"_28346":127190,"_3068":127191},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3612":74937,"_31165":74917,"_5":31520,"_21586":127193,"_28346":127194,"_3068":127195},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3612":74938,"_31165":74917,"_5":31520,"_21586":127197,"_28346":127198,"_3068":127199},[],"/docs/pr-preview/pr-77/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3612":74939,"_31165":74917,"_21586":127201,"_5":14831,"_28346":74917,"_3068":127202},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3612":74940,"_31165":74917,"_21586":127204,"_5":14831,"_28346":74917,"_3068":127205},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3612":74941,"_31165":74917,"_21586":127207,"_5":14831,"_28346":127130,"_3068":127208},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3612":74942,"_31165":74917,"_21586":127210,"_5":14831,"_28346":127130,"_3068":127211},[],"En la práctica, permite:",{"_3612":74943,"_31165":74917,"_21586":127213,"_5":14831,"_28346":127130,"_3068":127214},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3612":74944,"_31165":74917,"_21586":127216,"_5":14831,"_28346":127130,"_3068":127217},[],"Importar claves creadas externamente.",{"_3612":74945,"_31165":74917,"_21586":127219,"_5":14831,"_28346":127130,"_3068":127220},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3612":74946,"_31165":74917,"_21586":127222,"_5":14831,"_28346":127130,"_3068":127223},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3612":74947,"_31165":74917,"_21586":127225,"_5":14831,"_28346":127134,"_3068":127226},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3612":74948,"_31165":74917,"_21586":127228,"_5":14831,"_28346":127134,"_3068":127229},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3612":74949,"_31165":74917,"_21586":127231,"_5":14831,"_28346":127134,"_3068":127232},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3612":74950,"_31165":74917,"_21586":127234,"_5":14831,"_28346":127138,"_3068":127235},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3612":74951,"_31165":74917,"_21586":127237,"_5":14831,"_28346":127141,"_3068":127238},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3612":74952,"_31165":74917,"_21586":127240,"_5":14831,"_28346":127141,"_3068":127241},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3612":74953,"_31165":74917,"_21586":127243,"_5":14831,"_28346":127144,"_3068":127244},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3612":74954,"_31165":74917,"_21586":127246,"_5":14831,"_28346":127147,"_3068":127247},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3612":74955,"_31165":74917,"_21586":127249,"_5":14831,"_28346":127150,"_3068":127250},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3612":74956,"_31165":74917,"_21586":127252,"_5":14831,"_28346":127153,"_3068":127253},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3612":74957,"_31165":74917,"_21586":127255,"_5":14831,"_28346":127153,"_3068":127256},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3612":74958,"_31165":74917,"_21586":127258,"_5":14831,"_28346":127153,"_3068":127259},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3612":74959,"_31165":74917,"_21586":127261,"_5":14831,"_28346":127153,"_3068":127262},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3612":74960,"_31165":74917,"_21586":127264,"_5":14831,"_28346":127156,"_3068":127265},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3612":74961,"_31165":74917,"_21586":127267,"_5":14831,"_28346":127156,"_3068":127268},[],"La tabla incluye los siguientes campos:",{"_3612":74962,"_31165":74917,"_21586":127270,"_5":14831,"_28346":127156,"_3068":127271},[],"**Name**: nombre descriptivo de la clave.",{"_3612":74963,"_31165":74917,"_21586":127273,"_5":14831,"_28346":127156,"_3068":127274},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3612":74964,"_31165":74917,"_21586":127276,"_5":14831,"_28346":127156,"_3068":127277},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3612":74965,"_31165":74917,"_21586":127279,"_5":14831,"_28346":127156,"_3068":127280},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3612":74966,"_31165":74917,"_21586":127282,"_5":14831,"_28346":127156,"_3068":127283},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3612":74967,"_31165":74917,"_21586":127285,"_5":14831,"_28346":127156,"_3068":127286},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3612":74968,"_31165":74917,"_21586":127288,"_5":14831,"_28346":127156,"_3068":127289},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3612":74969,"_31165":74917,"_21586":127291,"_5":14831,"_28346":127156,"_3068":127292},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3612":74970,"_31165":74917,"_21586":127294,"_5":14831,"_28346":127156,"_3068":127295},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3612":74971,"_31165":74917,"_21586":127297,"_5":14831,"_28346":127156,"_3068":127298},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3612":74972,"_31165":74917,"_21586":127300,"_5":14831,"_28346":127156,"_3068":127301},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3612":74973,"_31165":74917,"_21586":127303,"_5":14831,"_28346":127156,"_3068":127304},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3612":74974,"_31165":74917,"_21586":127306,"_5":14831,"_28346":127156,"_3068":127307},[],"**Delete Key** para eliminar la clave del sistema.",{"_3612":74975,"_31165":74917,"_21586":127309,"_5":14831,"_28346":127160,"_3068":127310},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3612":74976,"_31165":74917,"_21586":127312,"_5":14831,"_28346":127164,"_3068":127313},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3612":74977,"_31165":74917,"_21586":127315,"_5":14831,"_28346":127164,"_3068":127316},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3612":74978,"_31165":74917,"_21586":127318,"_5":14831,"_28346":127164,"_3068":127319},[],"**Key Name**: nombre único y descriptivo.",{"_3612":74979,"_31165":74917,"_21586":127321,"_5":14831,"_28346":127164,"_3068":127322},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3612":74980,"_31165":74917,"_21586":127324,"_5":14831,"_28346":127164,"_3068":127325},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3612":74981,"_31165":74917,"_21586":127327,"_5":14831,"_28346":127164,"_3068":127328},[],"**Tags**: metadatos para clasificar la clave.",{"_3612":74982,"_31165":74917,"_21586":127330,"_5":14831,"_28346":127164,"_3068":127331},[],"**Metadata**: información adicional para usos avanzados.",{"_3612":74983,"_31165":74917,"_21586":127333,"_5":14831,"_28346":127168,"_3068":127334},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3612":74984,"_31165":74917,"_21586":127336,"_5":14831,"_28346":127168,"_3068":127337},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3612":74985,"_31165":74917,"_21586":127339,"_5":14831,"_28346":127168,"_3068":127340},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3612":74986,"_31165":74917,"_21586":127342,"_5":14831,"_28346":127168,"_3068":127343},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3612":74987,"_31165":74917,"_21586":127345,"_5":14831,"_28346":127168,"_3068":127346},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3612":74988,"_31165":74917,"_21586":127348,"_5":14831,"_28346":127168,"_3068":127349},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3612":74989,"_31165":74917,"_21586":127351,"_5":14831,"_28346":127168,"_3068":127352},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3612":74990,"_31165":74917,"_21586":127354,"_5":14831,"_28346":127168,"_3068":127355},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3612":74991,"_31165":74917,"_21586":127357,"_5":14831,"_28346":127168,"_3068":127358},[],"**Metadata**: información adicional opcional.",{"_3612":74992,"_31165":74917,"_21586":127360,"_5":14831,"_28346":127168,"_3068":127361},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3612":74993,"_31165":74917,"_21586":127363,"_5":14831,"_28346":127168,"_3068":127364},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3612":74994,"_31165":74917,"_21586":127366,"_5":14831,"_28346":127172,"_3068":127367},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3612":74995,"_31165":74917,"_21586":127369,"_5":14831,"_28346":127176,"_3068":127370},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3612":74996,"_31165":74917,"_21586":127372,"_5":14831,"_28346":127176,"_3068":127373},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3612":74997,"_31165":74917,"_21586":127375,"_5":14831,"_28346":127176,"_3068":127376},[],"**Key Name**: nombre descriptivo.",{"_3612":74998,"_31165":74917,"_21586":127378,"_5":14831,"_28346":127176,"_3068":127379},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3612":74999,"_31165":74917,"_21586":127381,"_5":14831,"_28346":127176,"_3068":127382},[],"**Tags**: etiquetas asociadas.",{"_3612":75000,"_31165":74917,"_21586":127384,"_5":14831,"_28346":127176,"_3068":127385},[],"**Aliases**: nombres alternativos.",{"_3612":75001,"_31165":74917,"_21586":127387,"_5":14831,"_28346":127176,"_3068":127388},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3612":75002,"_31165":74917,"_21586":127390,"_5":14831,"_28346":127176,"_3068":127391},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3612":75003,"_31165":74917,"_21586":127393,"_5":14831,"_28346":127176,"_3068":127394},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3612":75004,"_31165":74917,"_21586":127396,"_5":14831,"_28346":127176,"_3068":127397},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3612":75005,"_31165":74917,"_21586":127399,"_5":14831,"_28346":127180,"_3068":127400},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3612":75006,"_31165":74917,"_21586":127402,"_5":14831,"_28346":127180,"_3068":127403},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3612":75007,"_31165":74917,"_21586":127405,"_5":14831,"_28346":127180,"_3068":127406},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3612":75008,"_31165":74917,"_21586":127408,"_5":14831,"_28346":127184,"_3068":127409},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3612":75009,"_31165":74917,"_21586":127411,"_5":14831,"_28346":127184,"_3068":127412},[],"Campos principales:",{"_3612":75010,"_31165":74917,"_21586":127414,"_5":14831,"_28346":127184,"_3068":127415},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3612":75011,"_31165":74917,"_21586":127417,"_5":14831,"_28346":127184,"_3068":127418},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3612":75012,"_31165":74917,"_21586":127420,"_5":14831,"_28346":127184,"_3068":127421},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3612":75013,"_31165":74917,"_21586":127423,"_5":14831,"_28346":127184,"_3068":127424},[],"**Message**: contenido que se va a firmar.",{"_3612":75014,"_31165":74917,"_21586":127426,"_5":14831,"_28346":127184,"_3068":127427},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3612":75015,"_31165":74917,"_21586":127429,"_5":14831,"_28346":127187,"_3068":127430},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3612":75016,"_31165":74917,"_21586":127432,"_5":14831,"_28346":127187,"_3068":127412},[],{"_3612":75017,"_31165":74917,"_21586":127434,"_5":14831,"_28346":127187,"_3068":127435},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3612":75018,"_31165":74917,"_21586":127437,"_5":14831,"_28346":127187,"_3068":127438},[],"**Message Type**: `Raw` o `Digest`.",{"_3612":75019,"_31165":74917,"_21586":127440,"_5":14831,"_28346":127187,"_3068":127441},[],"**Payload Encoding**: codificación del mensaje.",{"_3612":75020,"_31165":74917,"_21586":127443,"_5":14831,"_28346":127187,"_3068":127444},[],"**Message**: mensaje original o hash.",{"_3612":75021,"_31165":74917,"_21586":127446,"_5":14831,"_28346":127187,"_3068":127447},[],"**Signature**: firma que se desea comprobar.",{"_3612":75022,"_31165":74917,"_21586":127449,"_5":14831,"_28346":127187,"_3068":127450},[],"**Result**: indicador del resultado de la validación.",{"_3612":75023,"_31165":74917,"_21586":127452,"_5":14831,"_28346":127190,"_3068":127453},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3612":75024,"_31165":74917,"_21586":127455,"_5":14831,"_28346":127190,"_3068":127456},[],"Este flujo es útil para:",{"_3612":75025,"_31165":74917,"_21586":127458,"_5":14831,"_28346":127190,"_3068":127459},[],"Solicitar certificados a una CA externa.",{"_3612":75026,"_31165":74917,"_21586":127461,"_5":14831,"_28346":127190,"_3068":127462},[],"Renovar una identidad manteniendo la misma clave.",{"_3612":75027,"_31165":74917,"_21586":127464,"_5":14831,"_28346":127190,"_3068":127465},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3612":75028,"_31165":74917,"_21586":127467,"_5":14831,"_28346":127190,"_3068":127468},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3612":75029,"_31165":74917,"_21586":127470,"_5":14831,"_28346":127190,"_3068":127471},[],"**Organization (O)**: organización o empresa.",{"_3612":75030,"_31165":74917,"_21586":127473,"_5":14831,"_28346":127190,"_3068":127474},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3612":75031,"_31165":74917,"_21586":127476,"_5":14831,"_28346":127190,"_3068":127477},[],"**Country (C)**: código de país de dos letras.",{"_3612":75032,"_31165":74917,"_21586":127479,"_5":14831,"_28346":127190,"_3068":127480},[],"**State / Province (ST)**: estado o provincia.",{"_3612":75033,"_31165":74917,"_21586":127482,"_5":14831,"_28346":127190,"_3068":127483},[],"**Locality (L)**: ciudad o localidad.",{"_3612":75034,"_31165":74917,"_21586":127485,"_5":14831,"_28346":127190,"_3068":127486},[],"**Email Address**: correo de contacto.",{"_3612":75035,"_31165":74917,"_21586":127488,"_5":14831,"_28346":127190,"_3068":127489},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3612":75036,"_31165":74917,"_21586":127491,"_5":14831,"_28346":127190,"_3068":127492},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3612":75037,"_31165":74917,"_21586":127494,"_5":14831,"_28346":127194,"_3068":127495},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3612":75038,"_31165":74917,"_21586":127497,"_5":14831,"_28346":127194,"_3068":127498},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3612":75039,"_31165":74917,"_21586":127500,"_5":14831,"_28346":127198,"_3068":127501},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3612":75040,"_31165":74917,"_21586":127503,"_5":14831,"_28346":127198,"_3068":127504},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3612":75041,"_31165":75041,"_5":15196,"_3068":127506,"_31523":127507,"_21586":127508,"_28346":75041},"Validación online con OCSP",[50890,121593,56574,126262],[],{"_3612":75042,"_31165":75041,"_21586":127510,"_5":14831,"_28346":75041,"_3068":127511},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3612":75043,"_31165":75041,"_5":31520,"_21586":127513,"_28346":127514,"_3068":127515},[],"/docs/pr-preview/pr-77/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3612":75044,"_31165":75041,"_5":31520,"_21586":127517,"_28346":127518,"_3068":127519},[],"/docs/pr-preview/pr-77/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3612":75045,"_31165":75041,"_5":31520,"_21586":127521,"_28346":127522,"_3068":127523},[],"/docs/pr-preview/pr-77/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3612":75046,"_31165":75041,"_5":31520,"_21586":127525,"_28346":127526,"_3068":127527},[],"/docs/pr-preview/pr-77/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3612":75047,"_31165":75041,"_5":31520,"_21586":127529,"_28346":127530,"_3068":127531},[],"/docs/pr-preview/pr-77/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3612":75048,"_31165":75041,"_5":31520,"_21586":127533,"_28346":127534,"_3068":126825},[],"/docs/pr-preview/pr-77/es/platform/pki/ocsp#referencias",{"_3612":75049,"_31165":75041,"_21586":127536,"_5":14831,"_28346":75041,"_3068":127537},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3612":75050,"_31165":75041,"_21586":127539,"_5":14831,"_28346":127514,"_3068":127540},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3612":75051,"_31165":75041,"_21586":127542,"_5":14831,"_28346":127514,"_3068":127543},[],"Estado del registro",{"_3612":75052,"_31165":75041,"_21586":127545,"_5":14831,"_28346":127514,"_3068":127546},[],"Respuesta firmada",{"_3612":75053,"_31165":75041,"_21586":127548,"_5":14831,"_28346":127514,"_3068":55711},[],{"_3612":75054,"_31165":75041,"_21586":127550,"_5":14831,"_28346":127514,"_3068":58539},[],{"_3612":75055,"_31165":75041,"_21586":127552,"_5":14831,"_28346":127514,"_3068":55728},[],{"_3612":75056,"_31165":75041,"_21586":127554,"_5":14831,"_28346":127514,"_3068":127555},[],"`Revoked`, con razón y fecha de revocación.",{"_3612":75057,"_31165":75041,"_21586":127557,"_5":14831,"_28346":127514,"_3068":127558},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3612":75058,"_31165":75041,"_21586":127560,"_5":14831,"_28346":127514,"_3068":127561},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3612":75059,"_31165":75041,"_21586":127563,"_5":14831,"_28346":127514,"_3068":127564},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3612":75060,"_31165":75041,"_21586":127566,"_5":14831,"_28346":127514,"_3068":127567},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3612":75061,"_31165":75041,"_21586":127569,"_5":14831,"_28346":127514,"_3068":127570},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3612":75062,"_31165":75041,"_21586":127572,"_5":14831,"_28346":127518,"_3068":127573},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3612":75063,"_31165":75041,"_21586":127575,"_5":14831,"_28346":127518,"_3068":127576},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3612":75064,"_31165":75041,"_21586":127578,"_5":14831,"_28346":127522,"_3068":127579},[],"El servicio acepta:",{"_3612":75065,"_31165":75041,"_21586":127581,"_5":14831,"_28346":127522,"_3068":123465},[],{"_3612":75066,"_31165":75041,"_21586":127583,"_5":14831,"_28346":127522,"_3068":127584},[],"Ruta del servicio VA",{"_3612":75067,"_31165":75041,"_21586":127586,"_5":14831,"_28346":127522,"_3068":127587},[],"Formato",{"_3612":75068,"_31165":75041,"_21586":127589,"_5":14831,"_28346":127522,"_3068":58579},[],{"_3612":75069,"_31165":75041,"_21586":127591,"_5":14831,"_28346":127522,"_3068":58582},[],{"_3612":75070,"_31165":75041,"_21586":127593,"_5":14831,"_28346":127522,"_3068":127594},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3612":75071,"_31165":75041,"_21586":127596,"_5":14831,"_28346":127522,"_3068":57974},[],{"_3612":75072,"_31165":75041,"_21586":127598,"_5":14831,"_28346":127522,"_3068":58590},[],{"_3612":75073,"_31165":75041,"_21586":127600,"_5":14831,"_28346":127522,"_3068":127601},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3612":75074,"_31165":75041,"_21586":127603,"_5":14831,"_28346":127522,"_3068":127604},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3612":75075,"_31165":75041,"_21586":127606,"_5":14831,"_28346":127526,"_3068":127607},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3612":75076,"_31165":75041,"_21586":127609,"_5":14831,"_28346":127526,"_3068":127610},[],"Genera la solicitud:",{"_3612":75077,"_31165":75041,"_21586":127612,"_5":14831,"_28346":127526,"_3068":127613},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3612":75078,"_31165":75041,"_21586":127615,"_5":14831,"_28346":127526,"_3068":127616},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3612":75079,"_31165":75041,"_21586":127618,"_5":14831,"_28346":127526,"_3068":127619},[],"Verifica el DER recibido:",{"_3612":75080,"_31165":75041,"_21586":127621,"_5":14831,"_28346":127526,"_3068":127622},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3612":75081,"_31165":75041,"_21586":127624,"_5":14831,"_28346":127530,"_3068":127625},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3612":75082,"_31165":75041,"_21586":127627,"_5":14831,"_28346":127530,"_3068":127628},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3612":75083,"_31165":75041,"_21586":127630,"_5":14831,"_28346":127534,"_3068":58623},[],{"_3612":75084,"_31165":75041,"_21586":127632,"_5":14831,"_28346":127534,"_3068":58626},[],{"_3612":75085,"_31165":75041,"_21586":127634,"_5":14831,"_28346":127534,"_3068":127635},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3612":75086,"_31165":75041,"_21586":127637,"_5":14831,"_28346":127534,"_3068":127120},[],{"_3612":75087,"_31165":75087,"_5":15196,"_3068":56574,"_31523":127639,"_21586":127640,"_28346":75087},[50890,121593,56574],[],{"_3612":75088,"_31165":75087,"_21586":127642,"_5":14831,"_28346":75087,"_3068":127643},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3612":75089,"_31165":75087,"_5":31520,"_21586":127645,"_28346":127646,"_3068":124939},[],"/docs/pr-preview/pr-77/es/platform/pki/overview#empieza-aquí",{"_3612":75090,"_31165":75087,"_5":31520,"_21586":127648,"_28346":127649,"_3068":127650},[],"/docs/pr-preview/pr-77/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3612":75091,"_31165":75087,"_5":31520,"_21586":127652,"_28346":127653,"_3068":125459},[],"/docs/pr-preview/pr-77/es/platform/pki/overview#capacidades-principales",{"_3612":75092,"_31165":75087,"_5":31520,"_21586":127655,"_28346":127656,"_3068":125463},[],"/docs/pr-preview/pr-77/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3612":75093,"_31165":75087,"_5":31520,"_21586":127658,"_28346":127659,"_3068":125467},[],"/docs/pr-preview/pr-77/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3612":75094,"_31165":75087,"_5":31520,"_21586":127661,"_28346":127662,"_3068":125471},[],"/docs/pr-preview/pr-77/es/platform/pki/overview#emite-y-controla-certificados",{"_3612":75095,"_31165":75087,"_5":31520,"_21586":127664,"_28346":127665,"_3068":125479},[],"/docs/pr-preview/pr-77/es/platform/pki/overview#publica-el-estado-de-validación",{"_3612":75096,"_31165":75087,"_5":31520,"_21586":127667,"_28346":127668,"_3068":127669},[],"/docs/pr-preview/pr-77/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3612":75097,"_31165":75087,"_5":31520,"_21586":127671,"_28346":127672,"_3068":126428},[],"/docs/pr-preview/pr-77/es/platform/pki/overview#continúa",{"_3612":75098,"_31165":75087,"_21586":127674,"_5":14831,"_28346":75087,"_3068":127675},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3612":75099,"_31165":75087,"_21586":127677,"_5":14831,"_28346":127646,"_3068":127678},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3612":75100,"_31165":75087,"_21586":127680,"_5":14831,"_28346":127646,"_3068":127681},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3612":75101,"_31165":75087,"_21586":127683,"_5":14831,"_28346":127649,"_3068":127684},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3612":75102,"_31165":75087,"_21586":127686,"_5":14831,"_28346":127649,"_3068":127687},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3612":75103,"_31165":75087,"_21586":127689,"_5":14831,"_28346":127649,"_3068":127690},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3612":75104,"_31165":75087,"_21586":127692,"_5":14831,"_28346":127649,"_3068":127693},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3612":75105,"_31165":75087,"_21586":127695,"_5":14831,"_28346":127649,"_3068":127696},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3612":75106,"_31165":75087,"_21586":127698,"_5":14831,"_28346":127656,"_3068":127699},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3612":75107,"_31165":75087,"_21586":127701,"_5":14831,"_28346":127659,"_3068":127702},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3612":75108,"_31165":75087,"_21586":127704,"_5":14831,"_28346":127662,"_3068":127705},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3612":75109,"_31165":75087,"_21586":127707,"_5":14831,"_28346":127665,"_3068":127708},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3612":75110,"_31165":75087,"_21586":127710,"_5":14831,"_28346":127668,"_3068":127711},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3612":75111,"_31165":75087,"_21586":127713,"_5":14831,"_28346":127668,"_3068":127714},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3612":75112,"_31165":75087,"_21586":127716,"_5":14831,"_28346":127668,"_3068":127717},[],"su clave pública corresponda a la clave privada del cliente;",{"_3612":75113,"_31165":75087,"_21586":127719,"_5":14831,"_28346":127668,"_3068":127720},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3612":75114,"_31165":75087,"_21586":127722,"_5":14831,"_28346":127668,"_3068":127723},[],"sus fechas y usos permitan la operación;",{"_3612":75115,"_31165":75087,"_21586":127725,"_5":14831,"_28346":127668,"_3068":127726},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3612":75116,"_31165":75087,"_21586":127728,"_5":14831,"_28346":127668,"_3068":127729},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3612":75117,"_31165":75087,"_21586":127731,"_5":14831,"_28346":127672,"_3068":127732},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3612":75118,"_31165":75087,"_21586":127734,"_5":14831,"_28346":127672,"_3068":127735},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3612":75119,"_31165":75087,"_21586":127737,"_5":14831,"_28346":127672,"_3068":127738},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3612":75120,"_31165":75120,"_5":15196,"_3068":127740,"_31523":127741,"_21586":127742,"_28346":75120},"Crea tu primera CA",[50890,121593,56574,125063],[],{"_3612":75121,"_31165":75120,"_21586":127744,"_5":14831,"_28346":75120,"_3068":127745},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3612":75122,"_31165":75120,"_5":31520,"_21586":127747,"_28346":127748,"_3068":120127},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3612":75123,"_31165":75120,"_5":31520,"_21586":127750,"_28346":127751,"_3068":127752},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3612":75124,"_31165":75120,"_5":31520,"_21586":127754,"_28346":127755,"_3068":127756},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3612":75125,"_31165":75120,"_5":31520,"_21586":127758,"_28346":127759,"_3068":127760},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3612":75126,"_31165":75120,"_5":31520,"_21586":127762,"_28346":127763,"_3068":127764},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3612":75127,"_31165":75120,"_5":31520,"_21586":127766,"_28346":127767,"_3068":127768},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3612":75128,"_31165":75120,"_5":31520,"_21586":127770,"_28346":127771,"_3068":127772},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3612":75129,"_31165":75120,"_5":31520,"_21586":127774,"_28346":127775,"_3068":125310},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3612":75130,"_31165":75120,"_5":31520,"_21586":127777,"_28346":127778,"_3068":120151},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3612":75131,"_31165":75120,"_21586":127780,"_5":14831,"_28346":75120,"_3068":127781},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3612":75132,"_31165":75120,"_21586":127783,"_5":14831,"_28346":127748,"_3068":127784},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3612":75133,"_31165":75120,"_21586":127786,"_5":14831,"_28346":127748,"_3068":127787},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3612":75134,"_31165":75120,"_21586":127789,"_5":14831,"_28346":127748,"_3068":127790},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3612":75135,"_31165":75120,"_21586":127792,"_5":14831,"_28346":127748,"_3068":127793},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3612":75136,"_31165":75120,"_21586":127795,"_5":14831,"_28346":127751,"_3068":127796},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3612":75137,"_31165":75120,"_21586":127798,"_5":14831,"_28346":127751,"_3068":127799},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3612":75138,"_31165":75120,"_21586":127801,"_5":14831,"_28346":127755,"_3068":127802},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3612":75139,"_31165":75120,"_21586":127804,"_5":14831,"_28346":127755,"_3068":127805},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3612":75140,"_31165":75120,"_21586":127807,"_5":14831,"_28346":127759,"_3068":127808},[],"Selecciona **Root CA** y completa:",{"_3612":75141,"_31165":75120,"_21586":127810,"_5":14831,"_28346":127759,"_3068":58805},[],{"_3612":75142,"_31165":75120,"_21586":127812,"_5":14831,"_28346":127759,"_3068":127813},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3612":75143,"_31165":75120,"_21586":127815,"_5":14831,"_28346":127759,"_3068":127816},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3612":75144,"_31165":75120,"_21586":127818,"_5":14831,"_28346":127759,"_3068":127819},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3612":75145,"_31165":75120,"_21586":127821,"_5":14831,"_28346":127759,"_3068":127822},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3612":75146,"_31165":75120,"_21586":127824,"_5":14831,"_28346":127763,"_3068":127825},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3612":75147,"_31165":75120,"_21586":127827,"_5":14831,"_28346":127767,"_3068":127828},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3612":75148,"_31165":75120,"_21586":127830,"_5":14831,"_28346":127767,"_3068":127831},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3612":75149,"_31165":75120,"_21586":127833,"_5":14831,"_28346":127771,"_3068":127834},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3612":75150,"_31165":75120,"_21586":127836,"_5":14831,"_28346":127771,"_3068":127837},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3612":75151,"_31165":75120,"_21586":127839,"_5":14831,"_28346":127771,"_3068":127840},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3612":75152,"_31165":75120,"_21586":127842,"_5":14831,"_28346":127775,"_3068":127843},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3612":75153,"_31165":75120,"_21586":127845,"_5":14831,"_28346":127775,"_3068":127846},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3612":75154,"_31165":75120,"_21586":127848,"_5":14831,"_28346":127775,"_3068":127849},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3612":75155,"_31165":75120,"_21586":127851,"_5":14831,"_28346":127775,"_3068":127852},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3612":75156,"_31165":75120,"_21586":127854,"_5":14831,"_28346":127778,"_3068":127855},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3612":75157,"_31165":75157,"_5":15196,"_3068":127857,"_31523":127858,"_21586":127859,"_28346":75157},"Emite y verifica un certificado",[50890,121593,56574,125063],[],{"_3612":75158,"_31165":75157,"_21586":127861,"_5":14831,"_28346":75157,"_3068":127862},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3612":75159,"_31165":75157,"_5":31520,"_21586":127864,"_28346":127865,"_3068":120127},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3612":75160,"_31165":75157,"_5":31520,"_21586":127867,"_28346":127868,"_3068":127869},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3612":75161,"_31165":75157,"_5":31520,"_21586":127871,"_28346":127872,"_3068":127873},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3612":75162,"_31165":75157,"_5":31520,"_21586":127875,"_28346":127876,"_3068":127877},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3612":75163,"_31165":75157,"_5":31520,"_21586":127879,"_28346":127880,"_3068":127881},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3612":75164,"_31165":75157,"_5":31520,"_21586":127883,"_28346":127884,"_3068":127885},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3612":75165,"_31165":75157,"_5":31520,"_21586":127887,"_28346":127888,"_3068":127889},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3612":75166,"_31165":75157,"_5":31520,"_21586":127891,"_28346":127892,"_3068":127893},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3612":75167,"_31165":75157,"_5":31520,"_21586":127895,"_28346":127896,"_3068":127897},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3612":75168,"_31165":75157,"_5":31520,"_21586":127899,"_28346":127900,"_3068":127901},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3612":75169,"_31165":75157,"_5":31520,"_21586":127903,"_28346":127904,"_3068":125310},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3612":75170,"_31165":75157,"_5":31520,"_21586":127906,"_28346":127907,"_3068":120151},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3612":75171,"_31165":75157,"_21586":127909,"_5":14831,"_28346":75157,"_3068":127910},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3612":75172,"_31165":75157,"_21586":127912,"_5":14831,"_28346":127865,"_3068":127913},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3612":75173,"_31165":75157,"_21586":127915,"_5":14831,"_28346":127865,"_3068":127916},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3612":75174,"_31165":75157,"_21586":127918,"_5":14831,"_28346":127865,"_3068":127919},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3612":75175,"_31165":75157,"_21586":127921,"_5":14831,"_28346":127865,"_3068":127922},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3612":75176,"_31165":75157,"_21586":127924,"_5":14831,"_28346":127865,"_3068":127925},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3612":75177,"_31165":75157,"_21586":127927,"_5":14831,"_28346":127868,"_3068":127928},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3612":75178,"_31165":75157,"_21586":127930,"_5":14831,"_28346":127872,"_3068":127931},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3612":75179,"_31165":75157,"_21586":127933,"_5":14831,"_28346":127872,"_3068":127934},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3612":75180,"_31165":75157,"_21586":127936,"_5":14831,"_28346":127876,"_3068":127937},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3612":75181,"_31165":75157,"_21586":127939,"_5":14831,"_28346":127876,"_3068":127940},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3612":75182,"_31165":75157,"_21586":127942,"_5":14831,"_28346":127880,"_3068":127943},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3612":75183,"_31165":75157,"_21586":127945,"_5":14831,"_28346":127880,"_3068":127946},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3612":75184,"_31165":75157,"_21586":127948,"_5":14831,"_28346":127884,"_3068":127949},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3612":75185,"_31165":75157,"_21586":127951,"_5":14831,"_28346":127888,"_3068":127952},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3612":75186,"_31165":75157,"_21586":127954,"_5":14831,"_28346":127892,"_3068":127955},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3612":75187,"_31165":75157,"_21586":127957,"_5":14831,"_28346":127896,"_3068":127958},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3612":75188,"_31165":75157,"_21586":127960,"_5":14831,"_28346":127896,"_3068":127961},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3612":75189,"_31165":75157,"_21586":127963,"_5":14831,"_28346":127896,"_3068":127964},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3612":75190,"_31165":75157,"_21586":127966,"_5":14831,"_28346":127900,"_3068":127967},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3612":75191,"_31165":75157,"_21586":127969,"_5":14831,"_28346":127900,"_3068":127970},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3612":75192,"_31165":75157,"_21586":127972,"_5":14831,"_28346":127900,"_3068":127973},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3612":75193,"_31165":75157,"_21586":127975,"_5":14831,"_28346":127904,"_3068":125393},[],{"_3612":75194,"_31165":75157,"_21586":127977,"_5":14831,"_28346":127904,"_3068":123914},[],{"_3612":75195,"_31165":75157,"_21586":127979,"_5":14831,"_28346":127904,"_3068":127980},[],"La CA rechaza la emisión",{"_3612":75196,"_31165":75157,"_21586":127982,"_5":14831,"_28346":127904,"_3068":127983},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3612":75197,"_31165":75157,"_21586":127985,"_5":14831,"_28346":127904,"_3068":127986},[],"Sujeto o usos diferentes",{"_3612":75198,"_31165":75157,"_21586":127988,"_5":14831,"_28346":127904,"_3068":127989},[],"Perfil aplicado y valores solicitados.",{"_3612":75199,"_31165":75157,"_21586":127991,"_5":14831,"_28346":127904,"_3068":127992},[],"No se encuentra el emisor",{"_3612":75200,"_31165":75157,"_21586":127994,"_5":14831,"_28346":127904,"_3068":127995},[],"CA descargada y cadena intermedia necesaria.",{"_3612":75201,"_31165":75157,"_21586":127997,"_5":14831,"_28346":127904,"_3068":127998},[],"Falla la vigencia",{"_3612":75202,"_31165":75157,"_21586":128000,"_5":14831,"_28346":127904,"_3068":128001},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3612":75203,"_31165":75157,"_21586":128003,"_5":14831,"_28346":127904,"_3068":128004},[],"Los resúmenes de clave difieren",{"_3612":75204,"_31165":75157,"_21586":128006,"_5":14831,"_28346":127904,"_3068":128007},[],"Archivos de certificado y clave de la misma emisión.",{"_3612":75205,"_31165":75157,"_21586":128009,"_5":14831,"_28346":127904,"_3068":128010},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3612":75206,"_31165":75157,"_21586":128012,"_5":14831,"_28346":127907,"_3068":128013},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3612":75207,"_31165":75157,"_21586":128015,"_5":14831,"_28346":127907,"_3068":128016},[],"Gestionar certificados para inspección, estado y revocación.",{"_3612":75208,"_31165":75157,"_21586":128018,"_5":14831,"_28346":127907,"_3068":128019},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3612":75209,"_31165":75157,"_21586":128021,"_5":14831,"_28346":127907,"_3068":128022},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3612":75210,"_31165":75157,"_21586":128024,"_5":14831,"_28346":127907,"_3068":128025},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3612":75211,"_31165":75211,"_5":15196,"_3068":128027,"_31523":128028,"_21586":128029,"_28346":75211},"Primeros pasos de PKI",[50890,121593,56574,125063],[],{"_3612":75212,"_31165":75211,"_21586":128031,"_5":14831,"_28346":75211,"_3068":128032},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3612":75213,"_31165":75211,"_5":31520,"_21586":128034,"_28346":128035,"_3068":120127},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3612":75214,"_31165":75211,"_5":31520,"_21586":128037,"_28346":128038,"_3068":128039},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3612":75215,"_31165":75211,"_5":31520,"_21586":128041,"_28346":128042,"_3068":125245},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3612":75216,"_31165":75211,"_5":31520,"_21586":128044,"_28346":128045,"_3068":128046},[],"/docs/pr-preview/pr-77/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3612":75217,"_31165":75211,"_21586":128048,"_5":14831,"_28346":75211,"_3068":128049},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3612":75218,"_31165":75211,"_21586":128051,"_5":14831,"_28346":128035,"_3068":128052},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3612":75219,"_31165":75211,"_21586":128054,"_5":14831,"_28346":128035,"_3068":128055},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3612":75220,"_31165":75211,"_21586":128057,"_5":14831,"_28346":128035,"_3068":128058},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3612":75221,"_31165":75211,"_21586":128060,"_5":14831,"_28346":128035,"_3068":128061},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3612":75222,"_31165":75211,"_21586":128063,"_5":14831,"_28346":128035,"_3068":128064},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3612":75223,"_31165":75211,"_21586":128066,"_5":14831,"_28346":128038,"_3068":128067},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3612":75224,"_31165":75211,"_21586":128069,"_5":14831,"_28346":128038,"_3068":128070},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3612":75225,"_31165":75211,"_21586":128072,"_5":14831,"_28346":128038,"_3068":128073},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3612":75226,"_31165":75211,"_21586":128075,"_5":14831,"_28346":128038,"_3068":128076},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3612":75227,"_31165":75211,"_21586":128078,"_5":14831,"_28346":128042,"_3068":128079},[],"Archivo o recurso",{"_3612":75228,"_31165":75211,"_21586":128081,"_5":14831,"_28346":128042,"_3068":125242},[],{"_3612":75229,"_31165":75211,"_21586":128083,"_5":14831,"_28346":128042,"_3068":128084},[],"CA raíz activa y `ca.pem`",{"_3612":75230,"_31165":75211,"_21586":128086,"_5":14831,"_28346":128042,"_3068":128087},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3612":75231,"_31165":75211,"_21586":128089,"_5":14831,"_28346":128042,"_3068":128090},[],"Certificado final y `device.crt`",{"_3612":75232,"_31165":75211,"_21586":128092,"_5":14831,"_28346":128042,"_3068":128093},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3612":75233,"_31165":75211,"_21586":128095,"_5":14831,"_28346":128042,"_3068":128096},[],"Clave privada `device.key`",{"_3612":75234,"_31165":75211,"_21586":128098,"_5":14831,"_28346":128042,"_3068":128099},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3612":75235,"_31165":75211,"_21586":128101,"_5":14831,"_28346":128042,"_3068":128102},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3612":75236,"_31165":75211,"_21586":128104,"_5":14831,"_28346":128045,"_3068":128105},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3612":75237,"_31165":75211,"_21586":128107,"_5":14831,"_28346":128045,"_3068":128108},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3612":75238,"_31165":75211,"_21586":128110,"_5":14831,"_28346":128045,"_3068":128111},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3612":75239,"_31165":75239,"_5":15196,"_3068":128113,"_31523":128114,"_21586":128116,"_28346":75239},"Resolución de problemas PKI",[50890,121593,56574,128115],"Resolución de problemas",[],{"_3612":75240,"_31165":75239,"_21586":128118,"_5":14831,"_28346":75239,"_3068":128119},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3612":75241,"_31165":75239,"_5":31520,"_21586":128121,"_28346":128122,"_3068":128123},[],"/docs/pr-preview/pr-77/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3612":75242,"_31165":75239,"_5":31520,"_21586":128125,"_28346":128126,"_3068":128127},[],"/docs/pr-preview/pr-77/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3612":75243,"_31165":75239,"_5":31520,"_21586":128129,"_28346":128130,"_3068":128131},[],"/docs/pr-preview/pr-77/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3612":75244,"_31165":75239,"_21586":128133,"_5":14831,"_28346":75239,"_3068":128134},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3612":75245,"_31165":75239,"_21586":128136,"_5":14831,"_28346":75239,"_3068":128137},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3612":75246,"_31165":75239,"_21586":128139,"_5":14831,"_28346":128122,"_3068":125242},[],{"_3612":75247,"_31165":75239,"_21586":128141,"_5":14831,"_28346":128122,"_3068":123914},[],{"_3612":75248,"_31165":75239,"_21586":128143,"_5":14831,"_28346":128122,"_3068":120151},[],{"_3612":75249,"_31165":75239,"_21586":128145,"_5":14831,"_28346":128122,"_3068":55416},[],{"_3612":75250,"_31165":75239,"_21586":128147,"_5":14831,"_28346":128122,"_3068":128148},[],"Existe, está activa y sus fechas son utilizables.",{"_3612":75251,"_31165":75239,"_21586":128150,"_5":14831,"_28346":128122,"_3068":128151},[],"Autoridades.",{"_3612":75252,"_31165":75239,"_21586":128153,"_5":14831,"_28346":128122,"_3068":128154},[],"Clave",{"_3612":75253,"_31165":75239,"_21586":128156,"_5":14831,"_28346":128122,"_3068":128157},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3612":75254,"_31165":75239,"_21586":128159,"_5":14831,"_28346":128122,"_3068":128160},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3612":75255,"_31165":75239,"_21586":128162,"_5":14831,"_28346":128122,"_3068":59159},[],{"_3612":75256,"_31165":75239,"_21586":128164,"_5":14831,"_28346":128122,"_3068":128165},[],"PEM correcto y firma verificable.",{"_3612":75257,"_31165":75239,"_21586":128167,"_5":14831,"_28346":128122,"_3068":59165},[],{"_3612":75258,"_31165":75239,"_21586":128169,"_5":14831,"_28346":128122,"_3068":128170},[],"Perfil",{"_3612":75259,"_31165":75239,"_21586":128172,"_5":14831,"_28346":128122,"_3068":128173},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3612":75260,"_31165":75239,"_21586":128175,"_5":14831,"_28346":128122,"_3068":128176},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3612":75261,"_31165":75239,"_21586":128178,"_5":14831,"_28346":128122,"_3068":125393},[],{"_3612":75262,"_31165":75239,"_21586":128180,"_5":14831,"_28346":128122,"_3068":128181},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3612":75263,"_31165":75239,"_21586":128183,"_5":14831,"_28346":128122,"_3068":128184},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3612":75264,"_31165":75239,"_21586":128186,"_5":14831,"_28346":128122,"_3068":128187},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3612":75265,"_31165":75239,"_21586":128189,"_5":14831,"_28346":128122,"_3068":128190},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3612":75266,"_31165":75239,"_21586":128192,"_5":14831,"_28346":128122,"_3068":128193},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3612":75267,"_31165":75239,"_21586":128195,"_5":14831,"_28346":128126,"_3068":128196},[],"Revisa cada frontera por separado:",{"_3612":75268,"_31165":75239,"_21586":128198,"_5":14831,"_28346":128126,"_3068":128199},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3612":75269,"_31165":75239,"_21586":128201,"_5":14831,"_28346":128126,"_3068":128202},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3612":75270,"_31165":75239,"_21586":128204,"_5":14831,"_28346":128126,"_3068":128205},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3612":75271,"_31165":75239,"_21586":128207,"_5":14831,"_28346":128126,"_3068":128208},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3612":75272,"_31165":75239,"_21586":128210,"_5":14831,"_28346":128126,"_3068":128211},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3612":75273,"_31165":75239,"_21586":128213,"_5":14831,"_28346":128126,"_3068":128214},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3612":75274,"_31165":75239,"_21586":128216,"_5":14831,"_28346":128130,"_3068":128217},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3612":75275,"_31165":75239,"_21586":128219,"_5":14831,"_28346":128130,"_3068":128220},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3612":75276,"_31165":75276,"_5":15196,"_3068":128222,"_31523":128223,"_21586":128224,"_28346":75276},"Seguridad",[50890],[],{"_3612":75277,"_31165":75276,"_21586":128226,"_5":14831,"_28346":75276,"_3068":128227},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3612":75278,"_31165":75276,"_5":31520,"_21586":128229,"_28346":128230,"_3068":128231},[],"/docs/pr-preview/pr-77/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3612":75279,"_31165":75276,"_5":31520,"_21586":128233,"_28346":128234,"_3068":128235},[],"/docs/pr-preview/pr-77/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3612":75280,"_31165":75276,"_5":31520,"_21586":128237,"_28346":128238,"_3068":128239},[],"/docs/pr-preview/pr-77/es/security#versiones-soportadas","Versiones soportadas",{"_3612":75281,"_31165":75276,"_5":31520,"_21586":128241,"_28346":128242,"_3068":128243},[],"/docs/pr-preview/pr-77/es/security#divulgación-responsable","Divulgación responsable",{"_3612":75282,"_31165":75276,"_21586":128245,"_5":14831,"_28346":75276,"_3068":128246},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3612":75283,"_31165":75276,"_21586":128248,"_5":14831,"_28346":128230,"_3068":128249},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3612":75284,"_31165":75276,"_21586":128251,"_5":14831,"_28346":128230,"_3068":128252},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3612":75285,"_31165":75276,"_21586":128254,"_5":14831,"_28346":128230,"_3068":15470},[],{"_3612":75286,"_31165":75276,"_21586":128256,"_5":14831,"_28346":128230,"_3068":15399},[],{"_3612":75287,"_31165":75276,"_21586":128258,"_5":14831,"_28346":128230,"_3068":15457},[],{"_3612":75288,"_31165":75276,"_21586":128260,"_5":14831,"_28346":128230,"_3068":128261},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3612":75289,"_31165":75276,"_21586":128263,"_5":14831,"_28346":128230,"_3068":128264},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3612":75290,"_31165":75276,"_21586":128266,"_5":14831,"_28346":128234,"_3068":128267},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3612":75291,"_31165":75276,"_21586":128269,"_5":14831,"_28346":128234,"_3068":128270},[],"No incluyas en el reporte:",{"_3612":75292,"_31165":75276,"_21586":128272,"_5":14831,"_28346":128234,"_3068":128273},[],"Credenciales, tokens o claves privadas",{"_3612":75293,"_31165":75276,"_21586":128275,"_5":14831,"_28346":128234,"_3068":128276},[],"Datos de clientes o información identificable de clientes",{"_3612":75294,"_31165":75276,"_21586":128278,"_5":14831,"_28346":128234,"_3068":128279},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3612":75295,"_31165":75276,"_21586":128281,"_5":14831,"_28346":128238,"_3068":128282},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3612":75296,"_31165":75276,"_21586":128284,"_5":14831,"_28346":128238,"_3068":128285},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3612":75297,"_31165":75276,"_21586":128287,"_5":14831,"_28346":128242,"_3068":128288},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3612":75298,"_31165":75276,"_21586":128290,"_5":14831,"_28346":128242,"_3068":128291},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3612":75299,"_31165":75276,"_21586":128293,"_5":14831,"_28346":128242,"_3068":128294},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3612":75300,"_31165":75276,"_21586":128296,"_5":14831,"_28346":128242,"_3068":128297},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3612":75301,"_31165":75276,"_21586":128299,"_5":14831,"_28346":128242,"_3068":128300},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3612":75302,"_31165":75302,"_5":15196,"_3068":128302,"_31523":128303,"_21586":128305,"_28346":75302},"3.8.0 a 4.0.0",[50890,128304],"Actualizaciones",[],{"_3612":75303,"_31165":75302,"_21586":128307,"_5":14831,"_28346":75302,"_3068":128308},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3612":75304,"_31165":75302,"_5":31520,"_21586":128310,"_28346":128311,"_3068":128312},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3612":75305,"_31165":75302,"_5":31520,"_21586":128314,"_28346":128315,"_3068":128316},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3612":75306,"_31165":75302,"_5":31520,"_21586":128318,"_28346":128319,"_3068":128320},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3612":75307,"_31165":75302,"_5":31520,"_21586":128322,"_28346":128323,"_3068":128324},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3612":75308,"_31165":75302,"_5":31520,"_21586":128326,"_28346":128327,"_3068":128328},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3612":75309,"_31165":75302,"_5":31520,"_21586":128330,"_28346":128331,"_3068":128332},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3612":75310,"_31165":75302,"_5":31520,"_21586":128334,"_28346":128335,"_3068":59334},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3612":75311,"_31165":75302,"_5":31520,"_21586":128337,"_28346":128338,"_3068":128339},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3612":75312,"_31165":75302,"_5":31520,"_21586":128341,"_28346":128342,"_3068":128343},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3612":75313,"_31165":75302,"_5":31520,"_21586":128345,"_28346":128346,"_3068":128347},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3612":75314,"_31165":75302,"_5":31520,"_21586":128349,"_28346":128350,"_3068":120722},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3612":75315,"_31165":75302,"_5":31520,"_21586":128352,"_28346":128353,"_3068":128354},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3612":75316,"_31165":75302,"_5":31520,"_21586":128356,"_28346":128357,"_3068":128358},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3612":75317,"_31165":75302,"_5":31520,"_21586":128360,"_28346":128361,"_3068":128362},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3612":75318,"_31165":75302,"_5":31520,"_21586":128364,"_28346":128365,"_3068":128366},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3612":75319,"_31165":75302,"_5":31520,"_21586":128368,"_28346":128369,"_3068":128370},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3612":75320,"_31165":75302,"_5":31520,"_21586":128372,"_28346":128373,"_3068":128374},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3612":75321,"_31165":75302,"_5":31520,"_21586":128376,"_28346":128377,"_3068":128378},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3612":75322,"_31165":75302,"_5":31520,"_21586":128380,"_28346":128381,"_3068":128382},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3612":75323,"_31165":75302,"_5":31520,"_21586":128384,"_28346":128385,"_3068":128386},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3612":75324,"_31165":75302,"_5":31520,"_21586":128388,"_28346":128389,"_3068":128390},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3612":75325,"_31165":75302,"_5":31520,"_21586":128392,"_28346":128393,"_3068":128394},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3612":75326,"_31165":75302,"_5":31520,"_21586":128396,"_28346":128397,"_3068":128398},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3612":75327,"_31165":75302,"_5":31520,"_21586":128400,"_28346":128401,"_3068":128402},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3612":75328,"_31165":75302,"_5":31520,"_21586":128404,"_28346":128405,"_3068":128406},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3612":75329,"_31165":75302,"_5":31520,"_21586":128408,"_28346":128409,"_3068":128410},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3612":75330,"_31165":75302,"_5":31520,"_21586":128412,"_28346":128413,"_3068":128414},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3612":75331,"_31165":75302,"_5":31520,"_21586":128416,"_28346":128417,"_3068":128418},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3612":75332,"_31165":75302,"_5":31520,"_21586":128420,"_28346":128421,"_3068":128422},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3612":75333,"_31165":75302,"_5":31520,"_21586":128424,"_28346":128425,"_3068":128426},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3612":75334,"_31165":75302,"_5":31520,"_21586":128428,"_28346":128429,"_3068":128430},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3612":75335,"_31165":75302,"_5":31520,"_21586":128432,"_28346":128433,"_3068":128434},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3612":75336,"_31165":75302,"_5":31520,"_21586":128436,"_28346":128437,"_3068":128438},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3612":75337,"_31165":75302,"_5":31520,"_21586":128440,"_28346":128441,"_3068":128442},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3612":75338,"_31165":75302,"_5":31520,"_21586":128444,"_28346":128445,"_3068":128446},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3612":75339,"_31165":75302,"_5":31520,"_21586":128448,"_28346":128449,"_3068":128450},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3612":75340,"_31165":75302,"_5":31520,"_21586":128452,"_28346":128453,"_3068":128454},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3612":75341,"_31165":75302,"_5":31520,"_21586":128456,"_28346":128457,"_3068":128458},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3612":75342,"_31165":75302,"_5":31520,"_21586":128460,"_28346":128461,"_3068":128462},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3612":75343,"_31165":75302,"_5":31520,"_21586":128464,"_28346":128465,"_3068":128466},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3612":75344,"_31165":75302,"_5":31520,"_21586":128468,"_28346":128469,"_3068":128470},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3612":75345,"_31165":75302,"_5":31520,"_21586":128472,"_28346":128473,"_3068":128474},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3612":75346,"_31165":75302,"_5":31520,"_21586":128476,"_28346":128477,"_3068":128478},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3612":75347,"_31165":75302,"_5":31520,"_21586":128480,"_28346":128481,"_3068":124256},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3612":75348,"_31165":75302,"_5":31520,"_21586":128483,"_28346":128484,"_3068":128485},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3612":75349,"_31165":75302,"_5":31520,"_21586":128487,"_28346":128488,"_3068":128489},[],"/docs/pr-preview/pr-77/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3612":75350,"_31165":75302,"_21586":128491,"_5":14831,"_28346":75302,"_3068":128492},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3612":75351,"_31165":75302,"_21586":128494,"_5":14831,"_28346":75302,"_3068":128495},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3612":75352,"_31165":75302,"_21586":128497,"_5":14831,"_28346":75302,"_3068":128498},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3612":75353,"_31165":75302,"_21586":128500,"_5":14831,"_28346":75302,"_3068":128501},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3612":75354,"_31165":75302,"_21586":128503,"_5":14831,"_28346":75302,"_3068":128504},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3612":75355,"_31165":75302,"_21586":128506,"_5":14831,"_28346":75302,"_3068":128507},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3612":75356,"_31165":75302,"_21586":128509,"_5":14831,"_28346":75302,"_3068":128510},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3612":75357,"_31165":75302,"_21586":128512,"_5":14831,"_28346":128315,"_3068":128513},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3612":75358,"_31165":75302,"_21586":128515,"_5":14831,"_28346":128315,"_3068":128516},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3612":75359,"_31165":75302,"_21586":128518,"_5":14831,"_28346":128319,"_3068":128519},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3612":75360,"_31165":75302,"_21586":128521,"_5":14831,"_28346":128319,"_3068":128522},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3612":75361,"_31165":75302,"_21586":128524,"_5":14831,"_28346":128323,"_3068":128525},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3612":75362,"_31165":75302,"_21586":128527,"_5":14831,"_28346":128327,"_3068":128528},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3612":75363,"_31165":75302,"_21586":128530,"_5":14831,"_28346":128327,"_3068":128531},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3612":75364,"_31165":75302,"_21586":128533,"_5":14831,"_28346":128327,"_3068":128534},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3612":75365,"_31165":75302,"_21586":128536,"_5":14831,"_28346":128327,"_3068":128537},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3612":75366,"_31165":75302,"_21586":128539,"_5":14831,"_28346":128327,"_3068":128540},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3612":75367,"_31165":75302,"_21586":128542,"_5":14831,"_28346":128331,"_3068":128543},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3612":75368,"_31165":75302,"_21586":128545,"_5":14831,"_28346":128331,"_3068":128546},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3612":75369,"_31165":75302,"_21586":128548,"_5":14831,"_28346":128331,"_3068":128549},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3612":75370,"_31165":75302,"_21586":128551,"_5":14831,"_28346":128331,"_3068":128552},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3612":75371,"_31165":75302,"_21586":128554,"_5":14831,"_28346":128331,"_3068":128555},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3612":75372,"_31165":75302,"_21586":128557,"_5":14831,"_28346":128331,"_3068":128558},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3612":75373,"_31165":75302,"_21586":128560,"_5":14831,"_28346":128335,"_3068":128561},[],"Cambio",{"_3612":75374,"_31165":75302,"_21586":128563,"_5":14831,"_28346":128335,"_3068":128564},[],"A quién afecta",{"_3612":75375,"_31165":75302,"_21586":128566,"_5":14831,"_28346":128335,"_3068":128567},[],"Gravedad",{"_3612":75376,"_31165":75302,"_21586":128569,"_5":14831,"_28346":128335,"_3068":127044},[],{"_3612":75377,"_31165":75302,"_21586":128571,"_5":14831,"_28346":128335,"_3068":128343},[],{"_3612":75378,"_31165":75302,"_21586":128573,"_5":14831,"_28346":128335,"_3068":128574},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3612":75379,"_31165":75302,"_21586":128576,"_5":14831,"_28346":128335,"_3068":128577},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3612":75380,"_31165":75302,"_21586":128579,"_5":14831,"_28346":128335,"_3068":128580},[],"Copiar los datos a los volúmenes nuevos",{"_3612":75381,"_31165":75302,"_21586":128582,"_5":14831,"_28346":128335,"_3068":128347},[],{"_3612":75382,"_31165":75302,"_21586":128584,"_5":14831,"_28346":128335,"_3068":128585},[],"Todas las releases de Helm",{"_3612":75383,"_31165":75302,"_21586":128587,"_5":14831,"_28346":128335,"_3068":128588},[],"Alta: `helm upgrade` falla",{"_3612":75384,"_31165":75302,"_21586":128590,"_5":14831,"_28346":128335,"_3068":128591},[],"Eliminar o renombrar las claves heredadas",{"_3612":75385,"_31165":75302,"_21586":128593,"_5":14831,"_28346":128335,"_3068":120722},[],{"_3612":75386,"_31165":75302,"_21586":128595,"_5":14831,"_28346":128335,"_3068":128585},[],{"_3612":75387,"_31165":75302,"_21586":128597,"_5":14831,"_28346":128335,"_3068":128598},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3612":75388,"_31165":75302,"_21586":128600,"_5":14831,"_28346":128335,"_3068":128601},[],"Crear primero los Secrets; consulta el paso 2",{"_3612":75389,"_31165":75302,"_21586":128603,"_5":14831,"_28346":128335,"_3068":128354},[],{"_3612":75390,"_31165":75302,"_21586":128605,"_5":14831,"_28346":128335,"_3068":128606},[],"Todos los despliegues",{"_3612":75391,"_31165":75302,"_21586":128608,"_5":14831,"_28346":128335,"_3068":128609},[],"Alta: sin principal de bootstrap no hay administrador",{"_3612":75392,"_31165":75302,"_21586":128611,"_5":14831,"_28346":128335,"_3068":128612},[],"Configurar `services.authz`",{"_3612":75393,"_31165":75302,"_21586":128614,"_5":14831,"_28346":128335,"_3068":128358},[],{"_3612":75394,"_31165":75302,"_21586":128616,"_5":14831,"_28346":128335,"_3068":128585},[],{"_3612":75395,"_31165":75302,"_21586":128618,"_5":14831,"_28346":128335,"_3068":128619},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3612":75396,"_31165":75302,"_21586":128621,"_5":14831,"_28346":128335,"_3068":128622},[],"Mover JWKS y roles a `services.authz`",{"_3612":75397,"_31165":75302,"_21586":128624,"_5":14831,"_28346":128335,"_3068":128378},[],{"_3612":75398,"_31165":75302,"_21586":128626,"_5":14831,"_28346":128335,"_3068":128627},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3612":75399,"_31165":75302,"_21586":128629,"_5":14831,"_28346":128335,"_3068":128630},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3612":75400,"_31165":75302,"_21586":128632,"_5":14831,"_28346":128335,"_3068":128633},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3612":75401,"_31165":75302,"_21586":128635,"_5":14831,"_28346":128335,"_3068":128382},[],{"_3612":75402,"_31165":75302,"_21586":128637,"_5":14831,"_28346":128335,"_3068":128638},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3612":75403,"_31165":75302,"_21586":128640,"_5":14831,"_28346":128335,"_3068":128641},[],"Alta: el backend ya no arranca con ellos",{"_3612":75404,"_31165":75302,"_21586":128643,"_5":14831,"_28346":128335,"_3068":128644},[],"Pasar a PostgreSQL antes de actualizar",{"_3612":75405,"_31165":75302,"_21586":128646,"_5":14831,"_28346":128335,"_3068":128426},[],{"_3612":75406,"_31165":75302,"_21586":128648,"_5":14831,"_28346":128335,"_3068":128649},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3612":75407,"_31165":75302,"_21586":128651,"_5":14831,"_28346":128335,"_3068":128652},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3612":75408,"_31165":75302,"_21586":128654,"_5":14831,"_28346":128335,"_3068":128655},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3612":75409,"_31165":75302,"_21586":128657,"_5":14831,"_28346":128335,"_3068":128658},[],"Webhooks con referencias a archivos",{"_3612":75410,"_31165":75302,"_21586":128660,"_5":14831,"_28346":128335,"_3068":128661},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3612":75411,"_31165":75302,"_21586":128663,"_5":14831,"_28346":128335,"_3068":128664},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3612":75412,"_31165":75302,"_21586":128666,"_5":14831,"_28346":128335,"_3068":128667},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3612":75413,"_31165":75302,"_21586":128669,"_5":14831,"_28346":128335,"_3068":128362},[],{"_3612":75414,"_31165":75302,"_21586":128671,"_5":14831,"_28346":128335,"_3068":128672},[],"Releases con identidades por servicio o material de claves montado",{"_3612":75415,"_31165":75302,"_21586":128674,"_5":14831,"_28346":128335,"_3068":128675},[],"Media: los servicios no pueden leer sus archivos",{"_3612":75416,"_31165":75302,"_21586":128677,"_5":14831,"_28346":128335,"_3068":128678},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3612":75417,"_31165":75302,"_21586":128680,"_5":14831,"_28346":128335,"_3068":128366},[],{"_3612":75418,"_31165":75302,"_21586":128682,"_5":14831,"_28346":128335,"_3068":128683},[],"Releases que definen `amqp.tls`",{"_3612":75419,"_31165":75302,"_21586":128685,"_5":14831,"_28346":128335,"_3068":128686},[],"Media: los clientes se conectan al puerto equivocado",{"_3612":75420,"_31165":75302,"_21586":128688,"_5":14831,"_28346":128335,"_3068":128689},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3612":75421,"_31165":75302,"_21586":128691,"_5":14831,"_28346":128335,"_3068":128386},[],{"_3612":75422,"_31165":75302,"_21586":128693,"_5":14831,"_28346":128335,"_3068":128694},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3612":75423,"_31165":75302,"_21586":128696,"_5":14831,"_28346":128335,"_3068":128697},[],"Media: las claves de CA quedan sin gestionar",{"_3612":75424,"_31165":75302,"_21586":128699,"_5":14831,"_28346":128335,"_3068":128700},[],"Ejecutar la migración de CA a KMS",{"_3612":75425,"_31165":75302,"_21586":128702,"_5":14831,"_28346":128335,"_3068":128703},[],"Verificación del certificado del receptor",{"_3612":75426,"_31165":75302,"_21586":128705,"_5":14831,"_28346":128335,"_3068":128706},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3612":75427,"_31165":75302,"_21586":128708,"_5":14831,"_28346":128335,"_3068":128709},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3612":75428,"_31165":75302,"_21586":128711,"_5":14831,"_28346":128335,"_3068":128712},[],"Poner `insecure_skip_verify` a `false`",{"_3612":75429,"_31165":75302,"_21586":128714,"_5":14831,"_28346":128335,"_3068":128402},[],{"_3612":75430,"_31165":75302,"_21586":128716,"_5":14831,"_28346":128335,"_3068":128717},[],"Scripts y consolas que editan DMS por API",{"_3612":75431,"_31165":75302,"_21586":128719,"_5":14831,"_28346":128335,"_3068":128720},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3612":75432,"_31165":75302,"_21586":128722,"_5":14831,"_28346":128335,"_3068":128723},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3612":75433,"_31165":75302,"_21586":128725,"_5":14831,"_28346":128335,"_3068":128422},[],{"_3612":75434,"_31165":75302,"_21586":128727,"_5":14831,"_28346":128335,"_3068":128728},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3612":75435,"_31165":75302,"_21586":128730,"_5":14831,"_28346":128335,"_3068":128731},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3612":75436,"_31165":75302,"_21586":128733,"_5":14831,"_28346":128335,"_3068":128734},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3612":75437,"_31165":75302,"_21586":128736,"_5":14831,"_28346":128335,"_3068":128430},[],{"_3612":75438,"_31165":75302,"_21586":128738,"_5":14831,"_28346":128335,"_3068":128739},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3612":75439,"_31165":75302,"_21586":128741,"_5":14831,"_28346":128335,"_3068":128742},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3612":75440,"_31165":75302,"_21586":128744,"_5":14831,"_28346":128335,"_3068":128745},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3612":75441,"_31165":75302,"_21586":128747,"_5":14831,"_28346":128335,"_3068":128434},[],{"_3612":75442,"_31165":75302,"_21586":128749,"_5":14831,"_28346":128335,"_3068":128750},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3612":75443,"_31165":75302,"_21586":128752,"_5":14831,"_28346":128335,"_3068":128753},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3612":75444,"_31165":75302,"_21586":128755,"_5":14831,"_28346":128335,"_3068":128756},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3612":75445,"_31165":75302,"_21586":128758,"_5":14831,"_28346":128335,"_3068":128418},[],{"_3612":75446,"_31165":75302,"_21586":128760,"_5":14831,"_28346":128335,"_3068":128761},[],"Consumidores que leen el campo `events` del dispositivo",{"_3612":75447,"_31165":75302,"_21586":128763,"_5":14831,"_28346":128335,"_3068":128764},[],"Media: el campo desaparece",{"_3612":75448,"_31165":75302,"_21586":128766,"_5":14831,"_28346":128335,"_3068":128767},[],"Usar los nuevos endpoints de eventos",{"_3612":75449,"_31165":75302,"_21586":128769,"_5":14831,"_28346":128335,"_3068":128446},[],{"_3612":75450,"_31165":75302,"_21586":128771,"_5":14831,"_28346":128335,"_3068":128772},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3612":75451,"_31165":75302,"_21586":128774,"_5":14831,"_28346":128335,"_3068":128775},[],"Media: la migración de la VA aborta",{"_3612":75452,"_31165":75302,"_21586":128777,"_5":14831,"_28346":128335,"_3068":128778},[],"Corregir los roles afectados antes de actualizar",{"_3612":75453,"_31165":75302,"_21586":128780,"_5":14831,"_28346":128335,"_3068":128370},[],{"_3612":75454,"_31165":75302,"_21586":128782,"_5":14831,"_28346":128335,"_3068":128783},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3612":75455,"_31165":75302,"_21586":128785,"_5":14831,"_28346":128335,"_3068":128786},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3612":75456,"_31165":75302,"_21586":128788,"_5":14831,"_28346":128335,"_3068":128789},[],"Actualizar el archivo de values",{"_3612":75457,"_31165":75302,"_21586":128791,"_5":14831,"_28346":128335,"_3068":128410},[],{"_3612":75458,"_31165":75302,"_21586":128793,"_5":14831,"_28346":128335,"_3068":128794},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3612":75459,"_31165":75302,"_21586":128796,"_5":14831,"_28346":128335,"_3068":128797},[],"Baja: prevalece el ID de la URL",{"_3612":75460,"_31165":75302,"_21586":128799,"_5":14831,"_28346":128335,"_3068":128800},[],"Enviar el ID en la URL",{"_3612":75461,"_31165":75302,"_21586":128802,"_5":14831,"_28346":128335,"_3068":128438},[],{"_3612":75462,"_31165":75302,"_21586":128804,"_5":14831,"_28346":128335,"_3068":128805},[],"Clientes que envían un `id` al crear o importar CAs",{"_3612":75463,"_31165":75302,"_21586":128807,"_5":14831,"_28346":128335,"_3068":128808},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3612":75464,"_31165":75302,"_21586":128810,"_5":14831,"_28346":128335,"_3068":128811},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3612":75465,"_31165":75302,"_21586":128813,"_5":14831,"_28346":128335,"_3068":128442},[],{"_3612":75466,"_31165":75302,"_21586":128815,"_5":14831,"_28346":128335,"_3068":128816},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3612":75467,"_31165":75302,"_21586":128818,"_5":14831,"_28346":128335,"_3068":128819},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3612":75468,"_31165":75302,"_21586":128821,"_5":14831,"_28346":128335,"_3068":128822},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3612":75469,"_31165":75302,"_21586":128824,"_5":14831,"_28346":128335,"_3068":128414},[],{"_3612":75470,"_31165":75302,"_21586":128826,"_5":14831,"_28346":128335,"_3068":128827},[],"Consumidores que comparan el `type` del certificado",{"_3612":75471,"_31165":75302,"_21586":128829,"_5":14831,"_28346":128335,"_3068":128830},[],"Baja: dos valores cambian de nombre",{"_3612":75472,"_31165":75302,"_21586":128832,"_5":14831,"_28346":128335,"_3068":128833},[],"Adaptar los consumidores",{"_3612":75473,"_31165":75302,"_21586":128835,"_5":14831,"_28346":128335,"_3068":128406},[],{"_3612":75474,"_31165":75302,"_21586":128837,"_5":14831,"_28346":128335,"_3068":128838},[],"Cualquier DMS",{"_3612":75475,"_31165":75302,"_21586":128840,"_5":14831,"_28346":128335,"_3068":128841},[],"Baja: solo informativo",{"_3612":75476,"_31165":75302,"_21586":128843,"_5":14831,"_28346":128335,"_3068":128844},[],"Revisar ambos bloques antes de editar",{"_3612":75477,"_31165":75302,"_21586":128846,"_5":14831,"_28346":128342,"_3068":128847},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3612":75478,"_31165":75302,"_21586":128849,"_5":14831,"_28346":128342,"_3068":128850},[],"El paso 4 de la guía de migración copia los datos.",{"_3612":75479,"_31165":75302,"_21586":128852,"_5":14831,"_28346":128346,"_3068":128853},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3612":75480,"_31165":75302,"_21586":128855,"_5":14831,"_28346":128350,"_3068":128856},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3612":75481,"_31165":75302,"_21586":128858,"_5":14831,"_28346":128350,"_3068":128859},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3612":75482,"_31165":75302,"_21586":128861,"_5":14831,"_28346":128353,"_3068":128862},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3612":75483,"_31165":75302,"_21586":128864,"_5":14831,"_28346":128357,"_3068":128865},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3612":75484,"_31165":75302,"_21586":128867,"_5":14831,"_28346":128361,"_3068":128868},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3612":75485,"_31165":75302,"_21586":128870,"_5":14831,"_28346":128361,"_3068":128871},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3612":75486,"_31165":75302,"_21586":128873,"_5":14831,"_28346":128361,"_3068":128874},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3612":75487,"_31165":75302,"_21586":128876,"_5":14831,"_28346":128365,"_3068":128877},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3612":75488,"_31165":75302,"_21586":128879,"_5":14831,"_28346":128369,"_3068":128880},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3612":75489,"_31165":75302,"_21586":128882,"_5":14831,"_28346":128369,"_3068":128883},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3612":75490,"_31165":75302,"_21586":128885,"_5":14831,"_28346":128369,"_3068":128886},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3612":75491,"_31165":75302,"_21586":128888,"_5":14831,"_28346":128369,"_3068":128889},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3612":75492,"_31165":75302,"_21586":128891,"_5":14831,"_28346":128369,"_3068":128892},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3612":75493,"_31165":75302,"_21586":128894,"_5":14831,"_28346":128369,"_3068":128895},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3612":75494,"_31165":75302,"_21586":128897,"_5":14831,"_28346":128377,"_3068":128898},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3612":75495,"_31165":75302,"_21586":128900,"_5":14831,"_28346":128377,"_3068":128901},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3612":75496,"_31165":75302,"_21586":128903,"_5":14831,"_28346":128377,"_3068":128904},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3612":75497,"_31165":75302,"_21586":128906,"_5":14831,"_28346":128377,"_3068":128907},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3612":75498,"_31165":75302,"_21586":128909,"_5":14831,"_28346":128377,"_3068":128910},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3612":75499,"_31165":75302,"_21586":128912,"_5":14831,"_28346":128381,"_3068":128913},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3612":75500,"_31165":75302,"_21586":128915,"_5":14831,"_28346":128385,"_3068":128916},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3612":75501,"_31165":75302,"_21586":128918,"_5":14831,"_28346":128385,"_3068":128919},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3612":75502,"_31165":75302,"_21586":128921,"_5":14831,"_28346":128385,"_3068":128922},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3612":75503,"_31165":75302,"_21586":128924,"_5":14831,"_28346":128385,"_3068":128925},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3612":75504,"_31165":75302,"_21586":128927,"_5":14831,"_28346":128385,"_3068":128928},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3612":75505,"_31165":75302,"_21586":128930,"_5":14831,"_28346":128385,"_3068":128931},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3612":75506,"_31165":75302,"_21586":128933,"_5":14831,"_28346":128385,"_3068":128934},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3612":75507,"_31165":75302,"_21586":128936,"_5":14831,"_28346":128385,"_3068":128937},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3612":75508,"_31165":75302,"_21586":128939,"_5":14831,"_28346":128389,"_3068":128940},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3612":75509,"_31165":75302,"_21586":128942,"_5":14831,"_28346":128397,"_3068":128943},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3612":75510,"_31165":75302,"_21586":128945,"_5":14831,"_28346":128397,"_3068":128946},[],"Campo en 3.8.0",{"_3612":75511,"_31165":75302,"_21586":128948,"_5":14831,"_28346":128397,"_3068":128949},[],"Campo en 4.0.0",{"_3612":75512,"_31165":75302,"_21586":128951,"_5":14831,"_28346":128397,"_3068":59950},[],{"_3612":75513,"_31165":75302,"_21586":128953,"_5":14831,"_28346":128397,"_3068":128954},[],"`insecure_skip_verify` (con el valor negado)",{"_3612":75514,"_31165":75302,"_21586":128956,"_5":14831,"_28346":128397,"_3068":59956},[],{"_3612":75515,"_31165":75302,"_21586":128958,"_5":14831,"_28346":128397,"_3068":59959},[],{"_3612":75516,"_31165":75302,"_21586":128960,"_5":14831,"_28346":128397,"_3068":59962},[],{"_3612":75517,"_31165":75302,"_21586":128962,"_5":14831,"_28346":128397,"_3068":59965},[],{"_3612":75518,"_31165":75302,"_21586":128964,"_5":14831,"_28346":128397,"_3068":59968},[],{"_3612":75519,"_31165":75302,"_21586":128966,"_5":14831,"_28346":128397,"_3068":59971},[],{"_3612":75520,"_31165":75302,"_21586":128968,"_5":14831,"_28346":128397,"_3068":128969},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3612":75521,"_31165":75302,"_21586":128971,"_5":14831,"_28346":128397,"_3068":128972},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3612":75522,"_31165":75302,"_21586":128974,"_5":14831,"_28346":128397,"_3068":128975},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3612":75523,"_31165":75302,"_21586":128977,"_5":14831,"_28346":128401,"_3068":128978},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3612":75524,"_31165":75302,"_21586":128980,"_5":14831,"_28346":128401,"_3068":128981},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3612":75525,"_31165":75302,"_21586":128983,"_5":14831,"_28346":128401,"_3068":128984},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3612":75526,"_31165":75302,"_21586":128986,"_5":14831,"_28346":128405,"_3068":128987},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3612":75527,"_31165":75302,"_21586":128989,"_5":14831,"_28346":128409,"_3068":128990},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3612":75528,"_31165":75302,"_21586":128992,"_5":14831,"_28346":128413,"_3068":128993},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3612":75529,"_31165":75302,"_21586":128995,"_5":14831,"_28346":128417,"_3068":128996},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3612":75530,"_31165":75302,"_21586":128998,"_5":14831,"_28346":128417,"_3068":128999},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3612":75531,"_31165":75302,"_21586":129001,"_5":14831,"_28346":128417,"_3068":129002},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3612":75532,"_31165":75302,"_21586":129004,"_5":14831,"_28346":128417,"_3068":129005},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3612":75533,"_31165":75302,"_21586":129007,"_5":14831,"_28346":128421,"_3068":129008},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3612":75534,"_31165":75302,"_21586":129010,"_5":14831,"_28346":128425,"_3068":129011},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3612":75535,"_31165":75302,"_21586":129013,"_5":14831,"_28346":128425,"_3068":129014},[],"Ruta",{"_3612":75536,"_31165":75302,"_21586":129016,"_5":14831,"_28346":128425,"_3068":121353},[],{"_3612":75537,"_31165":75302,"_21586":129018,"_5":14831,"_28346":128425,"_3068":60024},[],{"_3612":75538,"_31165":75302,"_21586":129020,"_5":14831,"_28346":128425,"_3068":129021},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3612":75539,"_31165":75302,"_21586":129023,"_5":14831,"_28346":128425,"_3068":60030},[],{"_3612":75540,"_31165":75302,"_21586":129025,"_5":14831,"_28346":128425,"_3068":129026},[],"Lee los ajustes de una CA.",{"_3612":75541,"_31165":75302,"_21586":129028,"_5":14831,"_28346":128425,"_3068":60036},[],{"_3612":75542,"_31165":75302,"_21586":129030,"_5":14831,"_28346":128425,"_3068":129031},[],"Sustituye los `crl_options`.",{"_3612":75543,"_31165":75302,"_21586":129033,"_5":14831,"_28346":128425,"_3068":60042},[],{"_3612":75544,"_31165":75302,"_21586":129035,"_5":14831,"_28346":128425,"_3068":129036},[],"Elimina los ajustes archivados de una CA.",{"_3612":75545,"_31165":75302,"_21586":129038,"_5":14831,"_28346":128425,"_3068":129039},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3612":75546,"_31165":75302,"_21586":129041,"_5":14831,"_28346":128425,"_3068":129042},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3612":75547,"_31165":75302,"_21586":129044,"_5":14831,"_28346":128425,"_3068":129045},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3612":75548,"_31165":75302,"_21586":129047,"_5":14831,"_28346":128425,"_3068":129048},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3612":75549,"_31165":75302,"_21586":129050,"_5":14831,"_28346":128425,"_3068":129051},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3612":75550,"_31165":75302,"_21586":129053,"_5":14831,"_28346":128425,"_3068":129054},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3612":75551,"_31165":75302,"_21586":129056,"_5":14831,"_28346":128425,"_3068":129057},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3612":75552,"_31165":75302,"_21586":129059,"_5":14831,"_28346":128425,"_3068":129060},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3612":75553,"_31165":75302,"_21586":129062,"_5":14831,"_28346":128425,"_3068":129063},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3612":75554,"_31165":75302,"_21586":129065,"_5":14831,"_28346":128425,"_3068":129066},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3612":75555,"_31165":75302,"_21586":129068,"_5":14831,"_28346":128425,"_3068":129069},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3612":75556,"_31165":75302,"_21586":129071,"_5":14831,"_28346":128429,"_3068":129072},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3612":75557,"_31165":75302,"_21586":129074,"_5":14831,"_28346":128433,"_3068":129075},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3612":75558,"_31165":75302,"_21586":129077,"_5":14831,"_28346":128437,"_3068":129078},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3612":75559,"_31165":75302,"_21586":129080,"_5":14831,"_28346":128441,"_3068":129081},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3612":75560,"_31165":75302,"_21586":129083,"_5":14831,"_28346":128441,"_3068":129084},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3612":75561,"_31165":75302,"_21586":129086,"_5":14831,"_28346":128445,"_3068":129087},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3612":75562,"_31165":75302,"_21586":129089,"_5":14831,"_28346":128449,"_3068":129090},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3612":75563,"_31165":75302,"_21586":129092,"_5":14831,"_28346":128453,"_3068":129093},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3612":75564,"_31165":75302,"_21586":129095,"_5":14831,"_28346":128453,"_3068":129096},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3612":75565,"_31165":75302,"_21586":129098,"_5":14831,"_28346":128453,"_3068":129099},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3612":75566,"_31165":75302,"_21586":129101,"_5":14831,"_28346":128453,"_3068":129102},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3612":75567,"_31165":75302,"_21586":129104,"_5":14831,"_28346":128453,"_3068":129105},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3612":75568,"_31165":75302,"_21586":129107,"_5":14831,"_28346":128453,"_3068":129108},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3612":75569,"_31165":75302,"_21586":129110,"_5":14831,"_28346":128457,"_3068":129111},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3612":75570,"_31165":75302,"_21586":129113,"_5":14831,"_28346":128457,"_3068":129114},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3612":75571,"_31165":75302,"_21586":129116,"_5":14831,"_28346":128457,"_3068":129117},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3612":75572,"_31165":75302,"_21586":129119,"_5":14831,"_28346":128457,"_3068":129120},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3612":75573,"_31165":75302,"_21586":129122,"_5":14831,"_28346":128457,"_3068":129123},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3612":75574,"_31165":75302,"_21586":129125,"_5":14831,"_28346":128461,"_3068":129126},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3612":75575,"_31165":75302,"_21586":129128,"_5":14831,"_28346":128461,"_3068":129129},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3612":75576,"_31165":75302,"_21586":129131,"_5":14831,"_28346":128461,"_3068":129132},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3612":75577,"_31165":75302,"_21586":129134,"_5":14831,"_28346":128461,"_3068":60144},[],{"_3612":75578,"_31165":75302,"_21586":129136,"_5":14831,"_28346":128461,"_3068":129137},[],"Claves de datos obligatorias",{"_3612":75579,"_31165":75302,"_21586":129139,"_5":14831,"_28346":128461,"_3068":129140},[],"Cuándo",{"_3612":75580,"_31165":75302,"_21586":129142,"_5":14831,"_28346":128461,"_3068":129143},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3612":75581,"_31165":75302,"_21586":129145,"_5":14831,"_28346":128461,"_3068":60156},[],{"_3612":75582,"_31165":75302,"_21586":129147,"_5":14831,"_28346":128461,"_3068":129148},[],"Siempre",{"_3612":75583,"_31165":75302,"_21586":129150,"_5":14831,"_28346":128461,"_3068":129151},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3612":75584,"_31165":75302,"_21586":129153,"_5":14831,"_28346":128461,"_3068":60156},[],{"_3612":75585,"_31165":75302,"_21586":129155,"_5":14831,"_28346":128461,"_3068":129148},[],{"_3612":75586,"_31165":75302,"_21586":129157,"_5":14831,"_28346":128461,"_3068":60169},[],{"_3612":75587,"_31165":75302,"_21586":129159,"_5":14831,"_28346":128461,"_3068":60156},[],{"_3612":75588,"_31165":75302,"_21586":129161,"_5":14831,"_28346":128461,"_3068":129162},[],"Solo cuando hay autenticación SMTP",{"_3612":75589,"_31165":75302,"_21586":129164,"_5":14831,"_28346":128461,"_3068":129165},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3612":75590,"_31165":75302,"_21586":129167,"_5":14831,"_28346":128461,"_3068":129168},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3612":75591,"_31165":75302,"_21586":129170,"_5":14831,"_28346":128461,"_3068":129171},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3612":75592,"_31165":75302,"_21586":129173,"_5":14831,"_28346":128461,"_3068":129174},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3612":75593,"_31165":75302,"_21586":129176,"_5":14831,"_28346":128461,"_3068":129177},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3612":75594,"_31165":75302,"_21586":129179,"_5":14831,"_28346":128461,"_3068":129180},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3612":75595,"_31165":75302,"_21586":129182,"_5":14831,"_28346":128461,"_3068":129183},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3612":75596,"_31165":75302,"_21586":129185,"_5":14831,"_28346":128461,"_3068":129186},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3612":75597,"_31165":75302,"_21586":129188,"_5":14831,"_28346":128461,"_3068":129189},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3612":75598,"_31165":75302,"_21586":129191,"_5":14831,"_28346":128461,"_3068":129192},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3612":75599,"_31165":75302,"_21586":129194,"_5":14831,"_28346":128461,"_3068":129195},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3612":75600,"_31165":75302,"_21586":129197,"_5":14831,"_28346":128461,"_3068":129198},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3612":75601,"_31165":75302,"_21586":129200,"_5":14831,"_28346":128461,"_3068":129201},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3612":75602,"_31165":75302,"_21586":129203,"_5":14831,"_28346":128461,"_3068":129204},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3612":75603,"_31165":75302,"_21586":129206,"_5":14831,"_28346":128461,"_3068":129207},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3612":75604,"_31165":75302,"_21586":129209,"_5":14831,"_28346":128465,"_3068":129210},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3612":75605,"_31165":75302,"_21586":129212,"_5":14831,"_28346":128465,"_3068":129213},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3612":75606,"_31165":75302,"_21586":129215,"_5":14831,"_28346":128469,"_3068":129216},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3612":75607,"_31165":75302,"_21586":129218,"_5":14831,"_28346":128469,"_3068":129219},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3612":75608,"_31165":75302,"_21586":129221,"_5":14831,"_28346":128469,"_3068":129222},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3612":75609,"_31165":75302,"_21586":129224,"_5":14831,"_28346":128469,"_3068":129225},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3612":75610,"_31165":75302,"_21586":129227,"_5":14831,"_28346":128469,"_3068":129228},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3612":75611,"_31165":75302,"_21586":129230,"_5":14831,"_28346":128469,"_3068":129231},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3612":75612,"_31165":75302,"_21586":129233,"_5":14831,"_28346":128469,"_3068":129234},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3612":75613,"_31165":75302,"_21586":129236,"_5":14831,"_28346":128469,"_3068":129237},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3612":75614,"_31165":75302,"_21586":129239,"_5":14831,"_28346":128469,"_3068":129240},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3612":75615,"_31165":75302,"_21586":129242,"_5":14831,"_28346":128469,"_3068":129243},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3612":75616,"_31165":75302,"_21586":129245,"_5":14831,"_28346":128469,"_3068":129246},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3612":75617,"_31165":75302,"_21586":129248,"_5":14831,"_28346":128473,"_3068":129249},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3612":75618,"_31165":75302,"_21586":129251,"_5":14831,"_28346":128473,"_3068":129252},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3612":75619,"_31165":75302,"_21586":129254,"_5":14831,"_28346":128477,"_3068":129255},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3612":75620,"_31165":75302,"_21586":129257,"_5":14831,"_28346":128477,"_3068":129258},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3612":75621,"_31165":75302,"_21586":129260,"_5":14831,"_28346":128477,"_3068":129261},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3612":75622,"_31165":75302,"_21586":129263,"_5":14831,"_28346":128477,"_3068":129264},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3612":75623,"_31165":75302,"_21586":129266,"_5":14831,"_28346":128477,"_3068":129267},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3612":75624,"_31165":75302,"_21586":129269,"_5":14831,"_28346":128477,"_3068":129270},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3612":75625,"_31165":75302,"_21586":129272,"_5":14831,"_28346":128477,"_3068":129273},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3612":75626,"_31165":75302,"_21586":129275,"_5":14831,"_28346":128477,"_3068":129276},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3612":75627,"_31165":75302,"_21586":129278,"_5":14831,"_28346":128481,"_3068":129279},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3612":75628,"_31165":75302,"_21586":129281,"_5":14831,"_28346":128481,"_3068":129282},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3612":75629,"_31165":75302,"_21586":129284,"_5":14831,"_28346":128481,"_3068":129285},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3612":75630,"_31165":75302,"_21586":129287,"_5":14831,"_28346":128481,"_3068":129288},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3612":75631,"_31165":75302,"_21586":129290,"_5":14831,"_28346":128481,"_3068":129291},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3612":75632,"_31165":75302,"_21586":129293,"_5":14831,"_28346":128481,"_3068":129294},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3612":75633,"_31165":75302,"_21586":129296,"_5":14831,"_28346":128481,"_3068":129297},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3612":75634,"_31165":75302,"_21586":129299,"_5":14831,"_28346":128481,"_3068":129300},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3612":75635,"_31165":75302,"_21586":129302,"_5":14831,"_28346":128481,"_3068":129303},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3612":75636,"_31165":75302,"_21586":129305,"_5":14831,"_28346":128481,"_3068":129306},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3612":75637,"_31165":75302,"_21586":129308,"_5":14831,"_28346":128481,"_3068":129309},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3612":75638,"_31165":75302,"_21586":129311,"_5":14831,"_28346":128484,"_3068":129312},[],"Tras la actualización, comprueba en este orden:",{"_3612":75639,"_31165":75302,"_21586":129314,"_5":14831,"_28346":128484,"_3068":129315},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3612":75640,"_31165":75302,"_21586":129317,"_5":14831,"_28346":128484,"_3068":129318},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3612":75641,"_31165":75302,"_21586":129320,"_5":14831,"_28346":128484,"_3068":129321},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3612":75642,"_31165":75302,"_21586":129323,"_5":14831,"_28346":128484,"_3068":129324},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3612":75643,"_31165":75302,"_21586":129326,"_5":14831,"_28346":128484,"_3068":129327},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3612":75644,"_31165":75302,"_21586":129329,"_5":14831,"_28346":128484,"_3068":129330},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3612":75645,"_31165":75302,"_21586":129332,"_5":14831,"_28346":128484,"_3068":129333},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3612":75646,"_31165":75302,"_21586":129335,"_5":14831,"_28346":128484,"_3068":129336},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3612":75647,"_31165":75302,"_21586":129338,"_5":14831,"_28346":128484,"_3068":129339},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3612":75648,"_31165":75302,"_21586":129341,"_5":14831,"_28346":128484,"_3068":129342},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3612":75649,"_31165":75302,"_21586":129344,"_5":14831,"_28346":128484,"_3068":129345},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3612":75650,"_31165":75302,"_21586":129347,"_5":14831,"_28346":128484,"_3068":129348},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3612":75651,"_31165":75302,"_21586":129350,"_5":14831,"_28346":128484,"_3068":129351},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3612":75652,"_31165":75302,"_21586":129353,"_5":14831,"_28346":128484,"_3068":129354},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3612":75653,"_31165":75302,"_21586":129356,"_5":14831,"_28346":128484,"_3068":129357},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3612":75654,"_31165":75302,"_21586":129359,"_5":14831,"_28346":128488,"_3068":129360},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3612":75655,"_31165":75302,"_21586":129362,"_5":14831,"_28346":128488,"_3068":129363},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3612":75656,"_31165":75302,"_21586":129365,"_5":14831,"_28346":128488,"_3068":129366},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3612":75657,"_31165":75302,"_21586":129368,"_5":14831,"_28346":128488,"_3068":129369},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3612":75658,"_31165":75302,"_21586":129371,"_5":14831,"_28346":128488,"_3068":129372},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60387":129374,"_60389":129375,"_60391":129376,"_60393":129377,"_18712":3103,"_72604":3103},"spanish",[3068,31165,5,28346],{"_3068":25766,"_31165":25766,"_5":25766,"_28346":25766},{"_3068":129378,"_31165":132429,"_5":135480,"_28346":138531},{"_4812":129379,"_60397":129380,"_5":25766},{"_14912":7205,"_15291":7761,"_15310":4649,"_30164":7716,"_15297":4199,"_20493":6711,"_14933":5963,"_14940":20799,"_30106":3516,"_30520":6206,"_30541":7249,"_30140":4554,"_35570":6843,"_30243":20979,"_30585":10200,"_35577":5435,"_35580":4200,"_35583":7950,"_35586":5628,"_30987":12402,"_35591":4890,"_35593":26162,"_31022":5325,"_15306":16298,"_35597":7790,"_35600":10808,"_35602":6226,"_30569":11691,"_31007":17691,"_31035":4713,"_35607":13821,"_35609":3254,"_35611":4089,"_30260":7964,"_35614":8731,"_35616":6174,"_35618":5339,"_35620":7965,"_35622":25575,"_30177":7583,"_35625":7211,"_35627":3876,"_30171":3180,"_30606":14621,"_35631":18588,"_35633":6442,"_35636":4556,"_30217":4710,"_35640":8472,"_30097":6186,"_35643":6228,"_30145":5774,"_35646":5131,"_35648":26438,"_35651":11697,"_15300":19147,"_35654":6162,"_35656":11382,"_35659":7931,"_35661":6860,"_35663":7687,"_35665":21348,"_35667":6537,"_20496":4786,"_35670":12040,"_35672":4302,"_30118":6733,"_30563":3558,"_35676":7763,"_35678":7175,"_35680":9511,"_31052":14788,"_35683":3780,"_35685":5117,"_35687":6713,"_31145":3694,"_30622":18714,"_35691":7832,"_3