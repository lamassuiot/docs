ets/enrollment/dms.mdx",{"_36":250,"_43":54,"_38":251,"_48":252,"_57":-7,"_12":253,"_59":254},"es:platform/iot-fleets/enrollment/bootstrap-identity.mdx","Identidad inicial y autenticación","Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.","/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/bootstrap-identity",{"_61":255},"platform/iot-fleets/enrollment/bootstrap-identity.mdx",{"_36":257,"_43":54,"_38":258,"_48":259,"_57":-7,"_12":260,"_59":261},"es:platform/iot-fleets/enrollment/est-client.mdx","Integra el cliente EST","Prepara la confianza, envía una CSR y comprueba la identidad recibida.","/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-client",{"_61":262},"platform/iot-fleets/enrollment/est-client.mdx",{"_36":264,"_43":54,"_38":265,"_48":266,"_57":-7,"_12":267,"_59":268},"es:platform/iot-fleets/enrollment/renewal-and-recovery.mdx","Renovación y recuperación","Renueva sin perder la identidad y recupera dispositivos según su estado real.","/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/renewal-and-recovery",{"_61":269},"platform/iot-fleets/enrollment/renewal-and-recovery.mdx",{"_36":271,"_43":54,"_38":272,"_48":273,"_57":-7,"_12":274,"_59":275},"es:platform/iot-fleets/enrollment/trust-distribution.mdx","Distribución y actualización de confianza","Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.","/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/trust-distribution",{"_61":276},"platform/iot-fleets/enrollment/trust-distribution.mdx",{"_36":278,"_43":54,"_38":279,"_48":280,"_57":-7,"_12":281,"_59":282},"es:platform/iot-fleets/enrollment/est-reference.mdx","Referencia EST","Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.","/docs/pr-preview/pr-77/es/platform/iot-fleets/enrollment/est-reference",{"_61":283},"platform/iot-fleets/enrollment/est-reference.mdx",{"_36":285,"_43":54,"_38":286,"_48":287,"_57":-7,"_12":288,"_59":289},"es:platform