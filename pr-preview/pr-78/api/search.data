cuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3626":72857,"_31300":72855,"_5":31656,"_21660":120551,"_28477":120552,"_3077":120553},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3626":72858,"_31300":72855,"_5":31656,"_21660":120555,"_28477":120556,"_3077":120557},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3626":72859,"_31300":72855,"_5":31656,"_21660":120559,"_28477":120560,"_3077":120561},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3626":72860,"_31300":72855,"_5":31656,"_21660":120563,"_28477":120564,"_3077":120565},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3626":72861,"_31300":72855,"_5":31656,"_21660":120567,"_28477":120568,"_3077":120569},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3626":72862,"_31300":72855,"_5":31656,"_21660":120571,"_28477":120572,"_3077":120573},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3626":72863,"_31300":72855,"_5":31656,"_21660":120575,"_28477":120576,"_3077":120577},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3626":72864,"_31300":72855,"_21660":120579,"_5":14907,"_28477":72855,"_3077":120580},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3626":72865,"_31300":72855,"_21660":120582,"_5":14907,"_28477":120552,"_3077":120583},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3626":72866,"_31300":72855,"_21660":120585,"_5":14907,"_28477":120552,"_3077":120586},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3626":72867,"_31300":72855,"_21660":120588,"_5":14907,"_28477":120552,"_3077":120589},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3626":72868,"_31300":72855,"_21660":120591,"_5":14907,"_28477":120556,"_3077":120592},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3626":72869,"_31300":72855,"_21660":120594,"_5":14907,"_28477":120556,"_3077":120595},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3626":72870,"_31300":72855,"_21660":120597,"_5":14907,"_28477":120556,"_3077":120598},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3626":72871,"_31300":72855,"_21660":120600,"_5":14907,"_28477":120560,"_3077":120601},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3626":72872,"_31300":72855,"_21660":120603,"_5":14907,"_28477":120564,"_3077":120604},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3626":72873,"_31300":72855,"_21660":120606,"_5":14907,"_28477":120568,"_3077":120607},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3626":72874,"_31300":72855,"_21660":120609,"_5":14907,"_28477":120572,"_3077":120610},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3626":72875,"_31300":72855,"_21660":120612,"_5":14907,"_28477":120576,"_3077":120613},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3626":72876,"_31300":72876,"_5":15267,"_3077":120615,"_31659":120616,"_21660":120617,"_28477":72876},"Despliega Lamassu",[51072,120544],[],{"_3626":72877,"_31300":72876,"_21660":120619,"_5":14907,"_28477":72876,"_3077":120620},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3626":72878,"_31300":72876,"_5":31656,"_21660":120622,"_28477":120623,"_3077":120624},[],"/docs/pr-preview/pr-78/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3626":72879,"_31300":72876,"_5":31656,"_21660":120626,"_28477":120627,"_3077":120628},[],"/docs/pr-preview/pr-78/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3626":72880,"_31300":72876,"_5":31656,"_21660":120630,"_28477":120631,"_3077":120632},[],"/docs/pr-preview/pr-78/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3626":72881,"_31300":72876,"_21660":120634,"_5":14907,"_28477":72876,"_3077":120635},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3626":72882,"_31300":72876,"_21660":120637,"_5":14907,"_28477":120623,"_3077":120638},[],"Modelo",{"_3626":72883,"_31300":72876,"_21660":120640,"_5":14907,"_28477":120623,"_3077":120641},[],"Recomendado para",{"_3626":72884,"_31300":72876,"_21660":120643,"_5":14907,"_28477":120623,"_3077":120644},[],"Quién opera la infraestructura",{"_3626":72885,"_31300":72876,"_21660":120646,"_5":14907,"_28477":120623,"_3077":120647},[],"Punto de partida",{"_3626":72886,"_31300":72876,"_21660":120649,"_5":14907,"_28477":120623,"_3077":51179},[],{"_3626":72887,"_31300":72876,"_21660":120651,"_5":14907,"_28477":120623,"_3077":120652},[],"Producción, entornos regulados y despliegues personalizados",{"_3626":72888,"_31300":72876,"_21660":120654,"_5":14907,"_28477":120623,"_3077":120655},[],"Tu equipo",{"_3626":72889,"_31300":72876,"_21660":120657,"_5":14907,"_28477":120623,"_3077":120658},[],"Helm o Fastlane",{"_3626":72890,"_31300":72876,"_21660":120660,"_5":14907,"_28477":120623,"_3077":51191},[],{"_3626":72891,"_31300":72876,"_21660":120662,"_5":14907,"_28477":120623,"_3077":120663},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3626":72892,"_31300":72876,"_21660":120665,"_5":14907,"_28477":120623,"_3077":120655},[],{"_3626":72893,"_31300":72876,"_21660":120667,"_5":14907,"_28477":120623,"_3077":120668},[],"Imagen preconfigurada en EC2",{"_3626":72894,"_31300":72876,"_21660":120670,"_5":14907,"_28477":120623,"_3077":51202},[],{"_3626":72895,"_31300":72876,"_21660":120672,"_5":14907,"_28477":120623,"_3077":120673},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3626":72896,"_31300":72876,"_21660":120675,"_5":14907,"_28477":120623,"_3077":51208},[],{"_3626":72897,"_31300":72876,"_21660":120677,"_5":14907,"_28477":120623,"_3077":120678},[],"Suscripción gestionada",{"_3626":72898,"_31300":72876,"_21660":120680,"_5":14907,"_28477":120623,"_3077":120681},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3626":72899,"_31300":72876,"_21660":120683,"_5":14907,"_28477":120623,"_3077":120684},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3626":72900,"_31300":72876,"_21660":120686,"_5":14907,"_28477":120623,"_3077":120687},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3626":72901,"_31300":72876,"_21660":120689,"_5":14907,"_28477":120627,"_3077":120690},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3626":72902,"_31300":72876,"_21660":120692,"_5":14907,"_28477":120631,"_3077":120693},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3626":72903,"_31300":72903,"_5":15267,"_3077":120695,"_31659":120696,"_21660":120697,"_28477":72903},"Utiliza Lamassu como SaaS",[51072,120544,120545],[],{"_3626":72904,"_31300":72903,"_21660":120699,"_5":14907,"_28477":72903,"_3077":120700},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3626":72905,"_31300":72903,"_5":31656,"_21660":120702,"_28477":120703,"_3077":120704},[],"/docs/pr-preview/pr-78/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3626":72906,"_31300":72903,"_5":31656,"_21660":120706,"_28477":120707,"_3077":120708},[],"/docs/pr-preview/pr-78/es/deployment/saas#planes","Planes",{"_3626":72907,"_31300":72903,"_5":31656,"_21660":120710,"_28477":120711,"_3077":120712},[],"/docs/pr-preview/pr-78/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3626":72908,"_31300":72903,"_21660":120714,"_5":14907,"_28477":72903,"_3077":120715},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3626":72909,"_31300":72903,"_21660":120717,"_5":14907,"_28477":120703,"_3077":120718},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3626":72910,"_31300":72903,"_21660":120720,"_5":14907,"_28477":120703,"_3077":120721},[],"Copias de seguridad automáticas.",{"_3626":72911,"_31300":72903,"_21660":120723,"_5":14907,"_28477":120703,"_3077":120724},[],"Actualizaciones de versión.",{"_3626":72912,"_31300":72903,"_21660":120726,"_5":14907,"_28477":120703,"_3077":120727},[],"Soporte técnico y SLA según el plan contratado.",{"_3626":72913,"_31300":72903,"_21660":120729,"_5":14907,"_28477":120707,"_3077":51263},[],{"_3626":72914,"_31300":72903,"_21660":120731,"_5":14907,"_28477":120707,"_3077":120732},[],"Dispositivos",{"_3626":72915,"_31300":72903,"_21660":120734,"_5":14907,"_28477":120707,"_3077":120735},[],"Soporte",{"_3626":72916,"_31300":72903,"_21660":120737,"_5":14907,"_28477":120707,"_3077":51272},[],{"_3626":72917,"_31300":72903,"_21660":120739,"_5":14907,"_28477":120707,"_3077":51275},[],{"_3626":72918,"_31300":72903,"_21660":120741,"_5":14907,"_28477":120707,"_3077":120742},[],"Hasta 1.000",{"_3626":72919,"_31300":72903,"_21660":120744,"_5":14907,"_28477":120707,"_3077":51281},[],{"_3626":72920,"_31300":72903,"_21660":120746,"_5":14907,"_28477":120707,"_3077":120747},[],"99,5 %",{"_3626":72921,"_31300":72903,"_21660":120749,"_5":14907,"_28477":120707,"_3077":51287},[],{"_3626":72922,"_31300":72903,"_21660":120751,"_5":14907,"_28477":120707,"_3077":120752},[],"Hasta 10.000",{"_3626":72923,"_31300":72903,"_21660":120754,"_5":14907,"_28477":120707,"_3077":120755},[],"Email y chat",{"_3626":72924,"_31300":72903,"_21660":120757,"_5":14907,"_28477":120707,"_3077":120758},[],"99,9 %",{"_3626":72925,"_31300":72903,"_21660":120760,"_5":14907,"_28477":120707,"_3077":51299},[],{"_3626":72926,"_31300":72903,"_21660":120762,"_5":14907,"_28477":120707,"_3077":120763},[],"Ilimitados",{"_3626":72927,"_31300":72903,"_21660":120765,"_5":14907,"_28477":120707,"_3077":120766},[],"Dedicado",{"_3626":72928,"_31300":72903,"_21660":120768,"_5":14907,"_28477":120707,"_3077":120769},[],"99,99 %",{"_3626":72929,"_31300":72903,"_21660":120771,"_5":14907,"_28477":120711,"_3077":120772},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3626":72930,"_31300":72903,"_21660":120774,"_5":14907,"_28477":120711,"_3077":120775},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3626":72931,"_31300":72931,"_5":15267,"_3077":51316,"_31659":120777,"_21660":120779,"_28477":72931},[51072,120544,120778],"Kubernetes autogestionado",[],{"_3626":72932,"_31300":72931,"_21660":120781,"_5":14907,"_28477":72931,"_3077":120782},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3626":72933,"_31300":72931,"_5":31656,"_21660":120784,"_28477":120785,"_3077":120786},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3626":72934,"_31300":72931,"_5":31656,"_21660":120788,"_28477":120789,"_3077":120790},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3626":72935,"_31300":72931,"_5":31656,"_21660":120792,"_28477":120793,"_3077":120794},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3626":72936,"_31300":72931,"_5":31656,"_21660":120796,"_28477":120797,"_3077":120798},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3626":72937,"_31300":72931,"_5":31656,"_21660":120800,"_28477":120801,"_3077":120802},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3626":72938,"_31300":72931,"_5":31656,"_21660":120804,"_28477":120805,"_3077":120806},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3626":72939,"_31300":72931,"_5":31656,"_21660":120808,"_28477":120809,"_3077":120810},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3626":72940,"_31300":72931,"_5":31656,"_21660":120812,"_28477":120813,"_3077":120814},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3626":72941,"_31300":72931,"_5":31656,"_21660":120816,"_28477":120817,"_3077":120818},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3626":72942,"_31300":72931,"_5":31656,"_21660":120820,"_28477":120821,"_3077":120822},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3626":72943,"_31300":72931,"_5":31656,"_21660":120824,"_28477":120825,"_3077":120826},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3626":72944,"_31300":72931,"_21660":120828,"_5":14907,"_28477":120785,"_3077":120829},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3626":72945,"_31300":72931,"_21660":120831,"_5":14907,"_28477":120785,"_3077":120832},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3626":72946,"_31300":72931,"_21660":120834,"_5":14907,"_28477":120789,"_3077":120835},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3626":72947,"_31300":72931,"_21660":120837,"_5":14907,"_28477":120789,"_3077":120838},[],"Fastlane instala o configura",{"_3626":72948,"_31300":72931,"_21660":120840,"_5":14907,"_28477":120789,"_3077":120841},[],"Tú sigues proporcionando",{"_3626":72949,"_31300":72931,"_21660":120843,"_5":14907,"_28477":120789,"_3077":120844},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3626":72950,"_31300":72931,"_21660":120846,"_5":14907,"_28477":120789,"_3077":120847},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3626":72951,"_31300":72931,"_21660":120849,"_5":14907,"_28477":120789,"_3077":120850},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3626":72952,"_31300":72931,"_21660":120852,"_5":14907,"_28477":120789,"_3077":120853},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3626":72953,"_31300":72931,"_21660":120855,"_5":14907,"_28477":120789,"_3077":120856},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3626":72954,"_31300":72931,"_21660":120858,"_5":14907,"_28477":120789,"_3077":120859},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3626":72955,"_31300":72931,"_21660":120861,"_5":14907,"_28477":120789,"_3077":120862},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3626":72956,"_31300":72931,"_21660":120864,"_5":14907,"_28477":120789,"_3077":120865},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3626":72957,"_31300":72931,"_21660":120867,"_5":14907,"_28477":120789,"_3077":120868},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3626":72958,"_31300":72931,"_21660":120870,"_5":14907,"_28477":120793,"_3077":120871},[],"Necesitas:",{"_3626":72959,"_31300":72931,"_21660":120873,"_5":14907,"_28477":120793,"_3077":120874},[],"un clúster Kubernetes existente",{"_3626":72960,"_31300":72931,"_21660":120876,"_5":14907,"_28477":120793,"_3077":120877},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3626":72961,"_31300":72931,"_21660":120879,"_5":14907,"_28477":120793,"_3077":51418},[],{"_3626":72962,"_31300":72931,"_21660":120881,"_5":14907,"_28477":120793,"_3077":24492},[],{"_3626":72963,"_31300":72931,"_21660":120883,"_5":14907,"_28477":120793,"_3077":120884},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3626":72964,"_31300":72931,"_21660":120886,"_5":14907,"_28477":120793,"_3077":120887},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3626":72965,"_31300":72931,"_21660":120889,"_5":14907,"_28477":120793,"_3077":120890},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3626":72966,"_31300":72931,"_21660":120892,"_5":14907,"_28477":120793,"_3077":120893},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3626":72967,"_31300":72931,"_21660":120895,"_5":14907,"_28477":120793,"_3077":120896},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3626":72968,"_31300":72931,"_21660":120898,"_5":14907,"_28477":120797,"_3077":120899},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3626":72969,"_31300":72931,"_21660":120901,"_5":14907,"_28477":120797,"_3077":120902},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3626":72970,"_31300":72931,"_21660":120904,"_5":14907,"_28477":120801,"_3077":120905},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3626":72971,"_31300":72931,"_21660":120907,"_5":14907,"_28477":120801,"_3077":120908},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3626":72972,"_31300":72931,"_21660":120910,"_5":14907,"_28477":120801,"_3077":120911},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3626":72973,"_31300":72931,"_21660":120913,"_5":14907,"_28477":120801,"_3077":120914},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3626":72974,"_31300":72931,"_21660":120916,"_5":14907,"_28477":120805,"_3077":120917},[],"Opción",{"_3626":72975,"_31300":72931,"_21660":120919,"_5":14907,"_28477":120805,"_3077":120920},[],"Valor predeterminado",{"_3626":72976,"_31300":72931,"_21660":120922,"_5":14907,"_28477":120805,"_3077":120923},[],"Propósito",{"_3626":72977,"_31300":72931,"_21660":120925,"_5":14907,"_28477":120805,"_3077":51465},[],{"_3626":72978,"_31300":72931,"_21660":120927,"_5":14907,"_28477":120805,"_3077":51468},[],{"_3626":72979,"_31300":72931,"_21660":120929,"_5":14907,"_28477":120805,"_3077":120930},[],"Muestra la ayuda",{"_3626":72980,"_31300":72931,"_21660":120932,"_5":14907,"_28477":120805,"_3077":51474},[],{"_3626":72981,"_31300":72931,"_21660":120934,"_5":14907,"_28477":120805,"_3077":120935},[],"contexto actual",{"_3626":72982,"_31300":72931,"_21660":120937,"_5":14907,"_28477":120805,"_3077":120938},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3626":72983,"_31300":72931,"_21660":120940,"_5":14907,"_28477":120805,"_3077":51483},[],{"_3626":72984,"_31300":72931,"_21660":120942,"_5":14907,"_28477":120805,"_3077":6797},[],{"_3626":72985,"_31300":72931,"_21660":120944,"_5":14907,"_28477":120805,"_3077":120945},[],"Omite prompts y genera credenciales para las dependencias",{"_3626":72986,"_31300":72931,"_21660":120947,"_5":14907,"_28477":120805,"_3077":51491},[],{"_3626":72987,"_31300":72931,"_21660":120949,"_5":14907,"_28477":120805,"_3077":51494},[],{"_3626":72988,"_31300":72931,"_21660":120951,"_5":14907,"_28477":120805,"_3077":120952},[],"Namespace de la instalación",{"_3626":72989,"_31300":72931,"_21660":120954,"_5":14907,"_28477":120805,"_3077":51500},[],{"_3626":72990,"_31300":72931,"_21660":120956,"_5":14907,"_28477":120805,"_3077":51503},[],{"_3626":72991,"_31300":72931,"_21660":120958,"_5":14907,"_28477":120805,"_3077":120959},[],"Dominio usado por la UI, OIDC y el certificado",{"_3626":72992,"_31300":72931,"_21660":120961,"_5":14907,"_28477":120805,"_3077":51509},[],{"_3626":72993,"_31300":72931,"_21660":120963,"_5":14907,"_28477":120805,"_3077":15624},[],{"_3626":72994,"_31300":72931,"_21660":120965,"_5":14907,"_28477":120805,"_3077":120966},[],"Versión del chart de Lamassu",{"_3626":72995,"_31300":72931,"_21660":120968,"_5":14907,"_28477":120805,"_3077":51517},[],{"_3626":72996,"_31300":72931,"_21660":120970,"_5":14907,"_28477":120805,"_3077":51520},[],{"_3626":72997,"_31300":72931,"_21660":120972,"_5":14907,"_28477":120805,"_3077":120973},[],"Puerto del listener HTTPS",{"_3626":72998,"_31300":72931,"_21660":120975,"_5":14907,"_28477":120805,"_3077":51526},[],{"_3626":72999,"_31300":72931,"_21660":120977,"_5":14907,"_28477":120805,"_3077":51529},[],{"_3626":73000,"_31300":72931,"_21660":120979,"_5":14907,"_28477":120805,"_3077":120980},[],"Puerto del listener HTTP",{"_3626":73001,"_31300":72931,"_21660":120982,"_5":14907,"_28477":120805,"_3077":51535},[],{"_3626":73002,"_31300":72931,"_21660":120984,"_5":14907,"_28477":120805,"_3077":51468},[],{"_3626":73003,"_31300":72931,"_21660":120986,"_5":14907,"_28477":120805,"_3077":120987},[],"Certificado PEM para TLS downstream",{"_3626":73004,"_31300":72931,"_21660":120989,"_5":14907,"_28477":120805,"_3077":51543},[],{"_3626":73005,"_31300":72931,"_21660":120991,"_5":14907,"_28477":120805,"_3077":51468},[],{"_3626":73006,"_31300":72931,"_21660":120993,"_5":14907,"_28477":120805,"_3077":120994},[],"Clave privada PEM para TLS downstream",{"_3626":73007,"_31300":72931,"_21660":120996,"_5":14907,"_28477":120805,"_3077":51551},[],{"_3626":73008,"_31300":72931,"_21660":120998,"_5":14907,"_28477":120805,"_3077":120999},[],"chart del repositorio",{"_3626":73009,"_31300":72931,"_21660":121001,"_5":14907,"_28477":120805,"_3077":121002},[],"Usa un chart local de Lamassu sin empaquetar",{"_3626":73010,"_31300":72931,"_21660":121004,"_5":14907,"_28477":120805,"_3077":51560},[],{"_3626":73011,"_31300":72931,"_21660":121006,"_5":14907,"_28477":120805,"_3077":121007},[],"detección automática",{"_3626":73012,"_31300":72931,"_21660":121009,"_5":14907,"_28477":120805,"_3077":121010},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3626":73013,"_31300":72931,"_21660":121012,"_5":14907,"_28477":120805,"_3077":51568},[],{"_3626":73014,"_31300":72931,"_21660":121014,"_5":14907,"_28477":120805,"_3077":6797},[],{"_3626":73015,"_31300":72931,"_21660":121016,"_5":14907,"_28477":120805,"_3077":121017},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3626":73016,"_31300":72931,"_21660":121019,"_5":14907,"_28477":120805,"_3077":51576},[],{"_3626":73017,"_31300":72931,"_21660":121021,"_5":14907,"_28477":120805,"_3077":6797},[],{"_3626":73018,"_31300":72931,"_21660":121023,"_5":14907,"_28477":120805,"_3077":121024},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3626":73019,"_31300":72931,"_21660":121026,"_5":14907,"_28477":120805,"_3077":51584},[],{"_3626":73020,"_31300":72931,"_21660":121028,"_5":14907,"_28477":120805,"_3077":6797},[],{"_3626":73021,"_31300":72931,"_21660":121030,"_5":14907,"_28477":120805,"_3077":121031},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3626":73022,"_31300":72931,"_21660":121033,"_5":14907,"_28477":120805,"_3077":51592},[],{"_3626":73023,"_31300":72931,"_21660":121035,"_5":14907,"_28477":120805,"_3077":6797},[],{"_3626":73024,"_31300":72931,"_21660":121037,"_5":14907,"_28477":120805,"_3077":121038},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3626":73025,"_31300":72931,"_21660":121040,"_5":14907,"_28477":120805,"_3077":51600},[],{"_3626":73026,"_31300":72931,"_21660":121042,"_5":14907,"_28477":120805,"_3077":51603},[],{"_3626":73027,"_31300":72931,"_21660":121044,"_5":14907,"_28477":120805,"_3077":121045},[],"Usa otro chart local de SoftHSM",{"_3626":73028,"_31300":72931,"_21660":121047,"_5":14907,"_28477":120805,"_3077":121048},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3626":73029,"_31300":72931,"_21660":121050,"_5":14907,"_28477":120809,"_3077":121051},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3626":73030,"_31300":72931,"_21660":121053,"_5":14907,"_28477":120809,"_3077":121054},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3626":73031,"_31300":72931,"_21660":121056,"_5":14907,"_28477":120809,"_3077":121057},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3626":73032,"_31300":72931,"_21660":121059,"_5":14907,"_28477":120809,"_3077":121060},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3626":73033,"_31300":72931,"_21660":121062,"_5":14907,"_28477":120809,"_3077":121063},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3626":73034,"_31300":72931,"_21660":121065,"_5":14907,"_28477":120809,"_3077":121066},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3626":73035,"_31300":72931,"_21660":121068,"_5":14907,"_28477":120813,"_3077":51630},[],{"_3626":73036,"_31300":72931,"_21660":121070,"_5":14907,"_28477":120813,"_3077":121071},[],"valida las herramientas locales y el clúster seleccionado",{"_3626":73037,"_31300":72931,"_21660":121073,"_5":14907,"_28477":120813,"_3077":121074},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3626":73038,"_31300":72931,"_21660":121076,"_5":14907,"_28477":120813,"_3077":121077},[],"crea el namespace",{"_3626":73039,"_31300":72931,"_21660":121079,"_5":14907,"_28477":120813,"_3077":121080},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3626":73040,"_31300":72931,"_21660":121082,"_5":14907,"_28477":120813,"_3077":121083},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3626":73041,"_31300":72931,"_21660":121085,"_5":14907,"_28477":120813,"_3077":121086},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3626":73042,"_31300":72931,"_21660":121088,"_5":14907,"_28477":120813,"_3077":121089},[],"instala RabbitMQ",{"_3626":73043,"_31300":72931,"_21660":121091,"_5":14907,"_28477":120813,"_3077":121092},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3626":73044,"_31300":72931,"_21660":121094,"_5":14907,"_28477":120813,"_3077":121095},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3626":73045,"_31300":72931,"_21660":121097,"_5":14907,"_28477":120813,"_3077":121098},[],"carga datos de ejemplo opcionalmente",{"_3626":73046,"_31300":72931,"_21660":121100,"_5":14907,"_28477":120813,"_3077":121101},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3626":73047,"_31300":72931,"_21660":121103,"_5":14907,"_28477":120817,"_3077":121104},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3626":73048,"_31300":72931,"_21660":121106,"_5":14907,"_28477":120817,"_3077":121107},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3626":73049,"_31300":72931,"_21660":121109,"_5":14907,"_28477":120821,"_3077":121110},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3626":73050,"_31300":72931,"_21660":121112,"_5":14907,"_28477":120821,"_3077":121113},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3626":73051,"_31300":72931,"_21660":121115,"_5":14907,"_28477":120821,"_3077":121116},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3626":73052,"_31300":72931,"_21660":121118,"_5":14907,"_28477":120821,"_3077":121119},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3626":73053,"_31300":72931,"_21660":121121,"_5":14907,"_28477":120825,"_3077":121122},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3626":73054,"_31300":73054,"_5":15267,"_3077":121124,"_31659":121125,"_21660":121126,"_28477":73054},"Instala con Helm",[51072,120544,120778],[],{"_3626":73055,"_31300":73054,"_21660":121128,"_5":14907,"_28477":73054,"_3077":121129},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3626":73056,"_31300":73054,"_5":31656,"_21660":121131,"_28477":121132,"_3077":121133},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3626":73057,"_31300":73054,"_5":31656,"_21660":121135,"_28477":121136,"_3077":120794},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3626":73058,"_31300":73054,"_5":31656,"_21660":121138,"_28477":121139,"_3077":121140},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3626":73059,"_31300":73054,"_5":31656,"_21660":121142,"_28477":121143,"_3077":121144},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3626":73060,"_31300":73054,"_5":31656,"_21660":121146,"_28477":121147,"_3077":121148},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3626":73061,"_31300":73054,"_5":31656,"_21660":121150,"_28477":121151,"_3077":121152},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3626":73062,"_31300":73054,"_5":31656,"_21660":121154,"_28477":121155,"_3077":121156},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3626":73063,"_31300":73054,"_5":31656,"_21660":121158,"_28477":121159,"_3077":121160},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3626":73064,"_31300":73054,"_5":31656,"_21660":121162,"_28477":121163,"_3077":121164},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3626":73065,"_31300":73054,"_5":31656,"_21660":121166,"_28477":121167,"_3077":121168},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3626":73066,"_31300":73054,"_5":31656,"_21660":121170,"_28477":121171,"_3077":121172},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3626":73067,"_31300":73054,"_5":31656,"_21660":121174,"_28477":121175,"_3077":121176},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3626":73068,"_31300":73054,"_21660":121178,"_5":14907,"_28477":121132,"_3077":121179},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3626":73069,"_31300":73054,"_21660":121181,"_5":14907,"_28477":121136,"_3077":121182},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3626":73070,"_31300":73054,"_21660":121184,"_5":14907,"_28477":121136,"_3077":121185},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3626":73071,"_31300":73054,"_21660":121187,"_5":14907,"_28477":121136,"_3077":121188},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3626":73072,"_31300":73054,"_21660":121190,"_5":14907,"_28477":121136,"_3077":121191},[],"un broker RabbitMQ accesible y sus credenciales",{"_3626":73073,"_31300":73054,"_21660":121193,"_5":14907,"_28477":121136,"_3077":121194},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3626":73074,"_31300":73054,"_21660":121196,"_5":14907,"_28477":121136,"_3077":121197},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3626":73075,"_31300":73054,"_21660":121199,"_5":14907,"_28477":121136,"_3077":121200},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3626":73076,"_31300":73054,"_21660":121202,"_5":14907,"_28477":121136,"_3077":121203},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3626":73077,"_31300":73054,"_21660":121205,"_5":14907,"_28477":121136,"_3077":121206},[],"una StorageClass y un diseño de tráfico externo",{"_3626":73078,"_31300":73054,"_21660":121208,"_5":14907,"_28477":121136,"_3077":121209},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3626":73079,"_31300":73054,"_21660":121211,"_5":14907,"_28477":121136,"_3077":121212},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3626":73080,"_31300":73054,"_21660":121214,"_5":14907,"_28477":121136,"_3077":121215},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3626":73081,"_31300":73054,"_21660":121217,"_5":14907,"_28477":121139,"_3077":121218},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3626":73082,"_31300":73054,"_21660":121220,"_5":14907,"_28477":121139,"_3077":121221},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3626":73083,"_31300":73054,"_21660":121223,"_5":14907,"_28477":121139,"_3077":121224},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3626":73084,"_31300":73054,"_21660":121226,"_5":14907,"_28477":121143,"_3077":121227},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3626":73085,"_31300":73054,"_21660":121229,"_5":14907,"_28477":121143,"_3077":121230},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3626":73086,"_31300":73054,"_21660":121232,"_5":14907,"_28477":121143,"_3077":121233},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3626":73087,"_31300":73054,"_21660":121235,"_5":14907,"_28477":121143,"_3077":121236},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3626":73088,"_31300":73054,"_21660":121238,"_5":14907,"_28477":121147,"_3077":121239},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3626":73089,"_31300":73054,"_21660":121241,"_5":14907,"_28477":121147,"_3077":121242},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3626":73090,"_31300":73054,"_21660":121244,"_5":14907,"_28477":121147,"_3077":121245},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3626":73091,"_31300":73054,"_21660":121247,"_5":14907,"_28477":121147,"_3077":121248},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3626":73092,"_31300":73054,"_21660":121250,"_5":14907,"_28477":121147,"_3077":121251},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3626":73093,"_31300":73054,"_21660":121253,"_5":14907,"_28477":121147,"_3077":121254},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3626":73094,"_31300":73054,"_21660":121256,"_5":14907,"_28477":121147,"_3077":121257},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3626":73095,"_31300":73054,"_21660":121259,"_5":14907,"_28477":121147,"_3077":121260},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3626":73096,"_31300":73054,"_21660":121262,"_5":14907,"_28477":121151,"_3077":121263},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3626":73097,"_31300":73054,"_21660":121265,"_5":14907,"_28477":121155,"_3077":121266},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3626":73098,"_31300":73054,"_21660":121268,"_5":14907,"_28477":121155,"_3077":121269},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3626":73099,"_31300":73054,"_21660":121271,"_5":14907,"_28477":121155,"_3077":121272},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3626":73100,"_31300":73054,"_21660":121274,"_5":14907,"_28477":121155,"_3077":121275},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3626":73101,"_31300":73054,"_21660":121277,"_5":14907,"_28477":121155,"_3077":121278},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3626":73102,"_31300":73054,"_21660":121280,"_5":14907,"_28477":121155,"_3077":121281},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3626":73103,"_31300":73054,"_21660":121283,"_5":14907,"_28477":121155,"_3077":121284},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3626":73104,"_31300":73054,"_21660":121286,"_5":14907,"_28477":121159,"_3077":121287},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3626":73105,"_31300":73054,"_21660":121289,"_5":14907,"_28477":121159,"_3077":121290},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3626":73106,"_31300":73054,"_21660":121292,"_5":14907,"_28477":121159,"_3077":121293},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3626":73107,"_31300":73054,"_21660":121295,"_5":14907,"_28477":121159,"_3077":121296},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3626":73108,"_31300":73054,"_21660":121298,"_5":14907,"_28477":121163,"_3077":121299},[],"Para instalar un checkout local:",{"_3626":73109,"_31300":73054,"_21660":121301,"_5":14907,"_28477":121167,"_3077":121302},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3626":73110,"_31300":73054,"_21660":121304,"_5":14907,"_28477":121167,"_3077":121305},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3626":73111,"_31300":73054,"_21660":121307,"_5":14907,"_28477":121171,"_3077":121308},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3626":73112,"_31300":73054,"_21660":121310,"_5":14907,"_28477":121171,"_3077":121311},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3626":73113,"_31300":73054,"_21660":121313,"_5":14907,"_28477":121171,"_3077":121314},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3626":73114,"_31300":73054,"_21660":121316,"_5":14907,"_28477":121171,"_3077":121317},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3626":73115,"_31300":73054,"_21660":121319,"_5":14907,"_28477":121171,"_3077":121320},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3626":73116,"_31300":73054,"_21660":121322,"_5":14907,"_28477":121175,"_3077":121323},[],"Antes de pasar a producción, revisa:",{"_3626":73117,"_31300":73054,"_21660":121325,"_5":14907,"_28477":121175,"_3077":121326},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3626":73118,"_31300":73054,"_21660":121328,"_5":14907,"_28477":121175,"_3077":121329},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3626":73119,"_31300":73054,"_21660":121331,"_5":14907,"_28477":121175,"_3077":121332},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3626":73120,"_31300":73054,"_21660":121334,"_5":14907,"_28477":121175,"_3077":121335},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3626":73121,"_31300":73054,"_21660":121337,"_5":14907,"_28477":121175,"_3077":121338},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3626":73122,"_31300":73054,"_21660":121340,"_5":14907,"_28477":121175,"_3077":121341},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3626":73123,"_31300":73054,"_21660":121343,"_5":14907,"_28477":121175,"_3077":121344},[],"SMTP, observabilidad y entrega de alertas",{"_3626":73124,"_31300":73054,"_21660":121346,"_5":14907,"_28477":121175,"_3077":121347},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3626":73125,"_31300":73054,"_21660":121349,"_5":14907,"_28477":121175,"_3077":121350},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3626":73126,"_31300":73126,"_5":15267,"_3077":121352,"_31659":121353,"_21660":121354,"_28477":73126},"Expón el Gateway",[51072,120544,120778],[],{"_3626":73127,"_31300":73126,"_21660":121356,"_5":14907,"_28477":73126,"_3077":121357},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3626":73128,"_31300":73126,"_5":31656,"_21660":121359,"_28477":121360,"_3077":121361},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3626":73129,"_31300":73126,"_5":31656,"_21660":121363,"_28477":121364,"_3077":121365},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3626":73130,"_31300":73126,"_5":31656,"_21660":121367,"_28477":121368,"_3077":121369},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3626":73131,"_31300":73126,"_5":31656,"_21660":121371,"_28477":121372,"_3077":51935},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#k3s",{"_3626":73132,"_31300":73126,"_5":31656,"_21660":121374,"_28477":121375,"_3077":121376},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3626":73133,"_31300":73126,"_5":31656,"_21660":121378,"_28477":121379,"_3077":121380},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3626":73134,"_31300":73126,"_5":31656,"_21660":121382,"_28477":121383,"_3077":121384},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3626":73135,"_31300":73126,"_5":31656,"_21660":121386,"_28477":121387,"_3077":121388},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3626":73136,"_31300":73126,"_5":31656,"_21660":121390,"_28477":121391,"_3077":121392},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3626":73137,"_31300":73126,"_5":31656,"_21660":121394,"_28477":121395,"_3077":121396},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3626":73138,"_31300":73126,"_5":31656,"_21660":121398,"_28477":121399,"_3077":121400},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3626":73139,"_31300":73126,"_21660":121402,"_5":14907,"_28477":121360,"_3077":121403},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3626":73140,"_31300":73126,"_21660":121405,"_5":14907,"_28477":121360,"_3077":121406},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3626":73141,"_31300":73126,"_21660":121408,"_5":14907,"_28477":121364,"_3077":121409},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3626":73142,"_31300":73126,"_21660":121411,"_5":14907,"_28477":121364,"_3077":121412},[],"Defínelo únicamente cuando:",{"_3626":73143,"_31300":73126,"_21660":121414,"_5":14907,"_28477":121364,"_3077":121415},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3626":73144,"_31300":73126,"_21660":121417,"_5":14907,"_28477":121364,"_3077":121418},[],"esa dirección está asignada a este Gateway",{"_3626":73145,"_31300":73126,"_21660":121420,"_5":14907,"_28477":121364,"_3077":121421},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3626":73146,"_31300":73126,"_21660":121423,"_5":14907,"_28477":121364,"_3077":121424},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3626":73147,"_31300":73126,"_21660":121426,"_5":14907,"_28477":121364,"_3077":121427},[],"No confundas estos valores:",{"_3626":73148,"_31300":73126,"_21660":121429,"_5":14907,"_28477":121364,"_3077":121430},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3626":73149,"_31300":73126,"_21660":121432,"_5":14907,"_28477":121364,"_3077":121433},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3626":73150,"_31300":73126,"_21660":121435,"_5":14907,"_28477":121364,"_3077":121436},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3626":73151,"_31300":73126,"_21660":121438,"_5":14907,"_28477":121368,"_3077":121439},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3626":73152,"_31300":73126,"_21660":121441,"_5":14907,"_28477":121368,"_3077":121442},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3626":73153,"_31300":73126,"_21660":121444,"_5":14907,"_28477":121372,"_3077":121445},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3626":73154,"_31300":73126,"_21660":121447,"_5":14907,"_28477":121372,"_3077":121448},[],"Para el diseño recomendado:",{"_3626":73155,"_31300":73126,"_21660":121450,"_5":14907,"_28477":121372,"_3077":121451},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3626":73156,"_31300":73126,"_21660":121453,"_5":14907,"_28477":121372,"_3077":121454},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3626":73157,"_31300":73126,"_21660":121456,"_5":14907,"_28477":121372,"_3077":121457},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3626":73158,"_31300":73126,"_21660":121459,"_5":14907,"_28477":121372,"_3077":121460},[],"Apunta DNS a la dirección accesible de la VM.",{"_3626":73159,"_31300":73126,"_21660":121462,"_5":14907,"_28477":121372,"_3077":121463},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3626":73160,"_31300":73126,"_21660":121465,"_5":14907,"_28477":121375,"_3077":121466},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3626":73161,"_31300":73126,"_21660":121468,"_5":14907,"_28477":121379,"_3077":121469},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3626":73162,"_31300":73126,"_21660":121471,"_5":14907,"_28477":121379,"_3077":121472},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3626":73163,"_31300":73126,"_21660":121474,"_5":14907,"_28477":121383,"_3077":121475},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3626":73164,"_31300":73126,"_21660":121477,"_5":14907,"_28477":121383,"_3077":121478},[],"Requisito",{"_3626":73165,"_31300":73126,"_21660":121480,"_5":14907,"_28477":121383,"_3077":121481},[],"Diseño recomendado",{"_3626":73166,"_31300":73126,"_21660":121483,"_5":14907,"_28477":121383,"_3077":121484},[],"Consecuencia",{"_3626":73167,"_31300":73126,"_21660":121486,"_5":14907,"_28477":121383,"_3077":121487},[],"Varias URL o servicios de Lamassu",{"_3626":73168,"_31300":73126,"_21660":121489,"_5":14907,"_28477":121383,"_3077":121490},[],"Un Gateway con varias rutas",{"_3626":73169,"_31300":73126,"_21660":121492,"_5":14907,"_28477":121383,"_3077":121493},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3626":73170,"_31300":73126,"_21660":121495,"_5":14907,"_28477":121383,"_3077":121496},[],"Gateways independientes e IP externas distintas",{"_3626":73171,"_31300":73126,"_21660":121498,"_5":14907,"_28477":121383,"_3077":121499},[],"Una VIP por Gateway",{"_3626":73172,"_31300":73126,"_21660":121501,"_5":14907,"_28477":121383,"_3077":121502},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3626":73173,"_31300":73126,"_21660":121504,"_5":14907,"_28477":121383,"_3077":121505},[],"Gateways independientes, un nodo y una IP",{"_3626":73174,"_31300":73126,"_21660":121507,"_5":14907,"_28477":121383,"_3077":121508},[],"Puertos externos diferentes",{"_3626":73175,"_31300":73126,"_21660":121510,"_5":14907,"_28477":121383,"_3077":121511},[],"Los clientes deben indicar puertos no estándar",{"_3626":73176,"_31300":73126,"_21660":121513,"_5":14907,"_28477":121383,"_3077":121514},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3626":73177,"_31300":73126,"_21660":121516,"_5":14907,"_28477":121383,"_3077":121517},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3626":73178,"_31300":73126,"_21660":121519,"_5":14907,"_28477":121383,"_3077":121520},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3626":73179,"_31300":73126,"_21660":121522,"_5":14907,"_28477":121383,"_3077":121523},[],"Recursos Gateway separados pero proxy compartido",{"_3626":73180,"_31300":73126,"_21660":121525,"_5":14907,"_28477":121383,"_3077":121526},[],"Modo merged Gateway de Envoy",{"_3626":73181,"_31300":73126,"_21660":121528,"_5":14907,"_28477":121383,"_3077":121529},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3626":73182,"_31300":73126,"_21660":121531,"_5":14907,"_28477":121383,"_3077":121532},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3626":73183,"_31300":73126,"_21660":121534,"_5":14907,"_28477":121383,"_3077":121535},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3626":73184,"_31300":73126,"_21660":121537,"_5":14907,"_28477":121383,"_3077":121538},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3626":73185,"_31300":73126,"_21660":121540,"_5":14907,"_28477":121383,"_3077":121541},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3626":73186,"_31300":73126,"_21660":121543,"_5":14907,"_28477":121387,"_3077":121544},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3626":73187,"_31300":73126,"_21660":121546,"_5":14907,"_28477":121391,"_3077":121547},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3626":73188,"_31300":73126,"_21660":121549,"_5":14907,"_28477":121391,"_3077":121550},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3626":73189,"_31300":73126,"_21660":121552,"_5":14907,"_28477":121391,"_3077":121553},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3626":73190,"_31300":73126,"_21660":121555,"_5":14907,"_28477":121391,"_3077":121556},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3626":73191,"_31300":73126,"_21660":121558,"_5":14907,"_28477":121391,"_3077":121559},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3626":73192,"_31300":73126,"_21660":121561,"_5":14907,"_28477":121395,"_3077":121562},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3626":73193,"_31300":73126,"_21660":121564,"_5":14907,"_28477":121395,"_3077":121565},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3626":73194,"_31300":73126,"_21660":121567,"_5":14907,"_28477":121399,"_3077":121568},[],"Comprueba, en orden:",{"_3626":73195,"_31300":73126,"_21660":121570,"_5":14907,"_28477":121399,"_3077":121571},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3626":73196,"_31300":73126,"_21660":121573,"_5":14907,"_28477":121399,"_3077":121574},[],"Su estado contiene la dirección esperada.",{"_3626":73197,"_31300":73126,"_21660":121576,"_5":14907,"_28477":121399,"_3077":121577},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3626":73198,"_31300":73126,"_21660":121579,"_5":14907,"_28477":121399,"_3077":121580},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3626":73199,"_31300":73126,"_21660":121582,"_5":14907,"_28477":121399,"_3077":121583},[],"DNS resuelve al endpoint accesible externamente.",{"_3626":73200,"_31300":73126,"_21660":121585,"_5":14907,"_28477":121399,"_3077":121586},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3626":73201,"_31300":73126,"_21660":121588,"_5":14907,"_28477":121399,"_3077":121589},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3626":73202,"_31300":73202,"_5":15267,"_3077":51179,"_31659":121591,"_21660":121592,"_28477":73202},[51072,120544,120778],[],{"_3626":73203,"_31300":73202,"_21660":121594,"_5":14907,"_28477":73202,"_3077":121595},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3626":73204,"_31300":73202,"_5":31656,"_21660":121597,"_28477":121598,"_3077":121599},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3626":73205,"_31300":73202,"_5":31656,"_21660":121601,"_28477":121602,"_3077":121603},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3626":73206,"_31300":73202,"_5":31656,"_21660":121605,"_28477":121606,"_3077":121607},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3626":73207,"_31300":73202,"_5":31656,"_21660":121609,"_28477":121610,"_3077":121611},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3626":73208,"_31300":73202,"_5":31656,"_21660":121613,"_28477":121614,"_3077":121615},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3626":73209,"_31300":73202,"_5":31656,"_21660":121617,"_28477":121618,"_3077":121619},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3626":73210,"_31300":73202,"_21660":121621,"_5":14907,"_28477":121598,"_3077":121622},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3626":73211,"_31300":73202,"_21660":121624,"_5":14907,"_28477":121602,"_3077":121625},[],"Flujo",{"_3626":73212,"_31300":73202,"_21660":121627,"_5":14907,"_28477":121602,"_3077":121628},[],"Úsalo para",{"_3626":73213,"_31300":73202,"_21660":121630,"_5":14907,"_28477":121602,"_3077":121631},[],"Qué instala",{"_3626":73214,"_31300":73202,"_21660":121633,"_5":14907,"_28477":121602,"_3077":52197},[],{"_3626":73215,"_31300":73202,"_21660":121635,"_5":14907,"_28477":121602,"_3077":121636},[],"Producción y entornos controlados",{"_3626":73216,"_31300":73202,"_21660":121638,"_5":14907,"_28477":121602,"_3077":121639},[],"Servicios de Lamassu y recursos de Gateway API",{"_3626":73217,"_31300":73202,"_21660":121641,"_5":14907,"_28477":121602,"_3077":51316},[],{"_3626":73218,"_31300":73202,"_21660":121643,"_5":14907,"_28477":121602,"_3077":121644},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3626":73219,"_31300":73202,"_21660":121646,"_5":14907,"_28477":121602,"_3077":121647},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3626":73220,"_31300":73202,"_21660":121649,"_5":14907,"_28477":121606,"_3077":121650},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3626":73221,"_31300":73202,"_21660":121652,"_5":14907,"_28477":121606,"_3077":121653},[],"Área",{"_3626":73222,"_31300":73202,"_21660":121655,"_5":14907,"_28477":121606,"_3077":121656},[],"El chart de Lamassu proporciona",{"_3626":73223,"_31300":73202,"_21660":121658,"_5":14907,"_28477":121606,"_3077":121659},[],"Tú proporcionas",{"_3626":73224,"_31300":73202,"_21660":121661,"_5":14907,"_28477":121606,"_3077":121662},[],"Aplicaciones Lamassu",{"_3626":73225,"_31300":73202,"_21660":121664,"_5":14907,"_28477":121606,"_3077":121665},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3626":73226,"_31300":73202,"_21660":121667,"_5":14907,"_28477":121606,"_3077":121668},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3626":73227,"_31300":73202,"_21660":121670,"_5":14907,"_28477":121606,"_3077":121671},[],"Datos PostgreSQL",{"_3626":73228,"_31300":73202,"_21660":121673,"_5":14907,"_28477":121606,"_3077":121674},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3626":73229,"_31300":73202,"_21660":121676,"_5":14907,"_28477":121606,"_3077":121677},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3626":73230,"_31300":73202,"_21660":121679,"_5":14907,"_28477":121606,"_3077":121680},[],"Mensajería",{"_3626":73231,"_31300":73202,"_21660":121682,"_5":14907,"_28477":121606,"_3077":121683},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3626":73232,"_31300":73202,"_21660":121685,"_5":14907,"_28477":121606,"_3077":121686},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3626":73233,"_31300":73202,"_21660":121688,"_5":14907,"_28477":121606,"_3077":121689},[],"Identidad",{"_3626":73234,"_31300":73202,"_21660":121691,"_5":14907,"_28477":121606,"_3077":121692},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3626":73235,"_31300":73202,"_21660":121694,"_5":14907,"_28477":121606,"_3077":121695},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3626":73236,"_31300":73202,"_21660":121697,"_5":14907,"_28477":121606,"_3077":121698},[],"Enrutamiento externo",{"_3626":73237,"_31300":73202,"_21660":121700,"_5":14907,"_28477":121606,"_3077":121701},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3626":73238,"_31300":73202,"_21660":121703,"_5":14907,"_28477":121606,"_3077":121704},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3626":73239,"_31300":73202,"_21660":121706,"_5":14907,"_28477":121606,"_3077":52271},[],{"_3626":73240,"_31300":73202,"_21660":121708,"_5":14907,"_28477":121606,"_3077":121709},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3626":73241,"_31300":73202,"_21660":121711,"_5":14907,"_28477":121606,"_3077":121712},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3626":73242,"_31300":73202,"_21660":121714,"_5":14907,"_28477":121606,"_3077":121715},[],"Datos persistentes de la aplicación",{"_3626":73243,"_31300":73202,"_21660":121717,"_5":14907,"_28477":121606,"_3077":121718},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3626":73244,"_31300":73202,"_21660":121720,"_5":14907,"_28477":121606,"_3077":121721},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3626":73245,"_31300":73202,"_21660":121723,"_5":14907,"_28477":121606,"_3077":121724},[],"Integraciones opcionales",{"_3626":73246,"_31300":73202,"_21660":121726,"_5":14907,"_28477":121606,"_3077":121727},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3626":73247,"_31300":73202,"_21660":121729,"_5":14907,"_28477":121606,"_3077":121730},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3626":73248,"_31300":73202,"_21660":121732,"_5":14907,"_28477":121606,"_3077":121733},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3626":73249,"_31300":73202,"_21660":121735,"_5":14907,"_28477":121606,"_3077":121736},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3626":73250,"_31300":73202,"_21660":121738,"_5":14907,"_28477":121610,"_3077":121739},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3626":73251,"_31300":73202,"_21660":121741,"_5":14907,"_28477":121610,"_3077":121742},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3626":73252,"_31300":73202,"_21660":121744,"_5":14907,"_28477":121614,"_3077":121745},[],"Kubernetes 1.24 o posterior",{"_3626":73253,"_31300":73202,"_21660":121747,"_5":14907,"_28477":121614,"_3077":121748},[],"Helm 3.2 o posterior",{"_3626":73254,"_31300":73202,"_21660":121750,"_5":14907,"_28477":121614,"_3077":121751},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3626":73255,"_31300":73202,"_21660":121753,"_5":14907,"_28477":121614,"_3077":121754},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3626":73256,"_31300":73202,"_21660":121756,"_5":14907,"_28477":121614,"_3077":121757},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3626":73257,"_31300":73202,"_21660":121759,"_5":14907,"_28477":121614,"_3077":121760},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3626":73258,"_31300":73202,"_21660":121762,"_5":14907,"_28477":121614,"_3077":121763},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3626":73259,"_31300":73202,"_21660":121765,"_5":14907,"_28477":121618,"_3077":121766},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3626":73260,"_31300":73202,"_21660":121768,"_5":14907,"_28477":121618,"_3077":121769},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3626":73261,"_31300":73202,"_21660":121771,"_5":14907,"_28477":121618,"_3077":121772},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3626":73262,"_31300":73202,"_21660":121774,"_5":14907,"_28477":121618,"_3077":121775},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3626":73263,"_31300":73263,"_5":15267,"_3077":121777,"_31659":121778,"_21660":121780,"_28477":73263},"Resolución de problemas de despliegue",[51072,120544,121779],"Operación",[],{"_3626":73264,"_31300":73263,"_21660":121782,"_5":14907,"_28477":73263,"_3077":121783},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3626":73265,"_31300":73263,"_5":31656,"_21660":121785,"_28477":121786,"_3077":121787},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3626":73266,"_31300":73263,"_5":31656,"_21660":121789,"_28477":121790,"_3077":121791},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3626":73267,"_31300":73263,"_5":31656,"_21660":121793,"_28477":121794,"_3077":121795},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3626":73268,"_31300":73263,"_5":31656,"_21660":121797,"_28477":121798,"_3077":121799},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3626":73269,"_31300":73263,"_5":31656,"_21660":121801,"_28477":121802,"_3077":121803},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3626":73270,"_31300":73263,"_5":31656,"_21660":121805,"_28477":121806,"_3077":121807},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3626":73271,"_31300":73263,"_5":31656,"_21660":121809,"_28477":121810,"_3077":121811},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3626":73272,"_31300":73263,"_5":31656,"_21660":121813,"_28477":121814,"_3077":121815},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3626":73273,"_31300":73263,"_5":31656,"_21660":121817,"_28477":121818,"_3077":121819},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3626":73274,"_31300":73263,"_5":31656,"_21660":121821,"_28477":121822,"_3077":121823},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3626":73275,"_31300":73263,"_5":31656,"_21660":121825,"_28477":121826,"_3077":121827},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3626":73276,"_31300":73263,"_5":31656,"_21660":121829,"_28477":121830,"_3077":121831},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3626":73277,"_31300":73263,"_5":31656,"_21660":121833,"_28477":121834,"_3077":121835},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3626":73278,"_31300":73263,"_21660":121837,"_5":14907,"_28477":73263,"_3077":121838},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3626":73279,"_31300":73263,"_21660":121840,"_5":14907,"_28477":121790,"_3077":121841},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3626":73280,"_31300":73263,"_21660":121843,"_5":14907,"_28477":121794,"_3077":121844},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3626":73281,"_31300":73263,"_21660":121846,"_5":14907,"_28477":121798,"_3077":121847},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3626":73282,"_31300":73263,"_21660":121849,"_5":14907,"_28477":121802,"_3077":121850},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3626":73283,"_31300":73263,"_21660":121852,"_5":14907,"_28477":121806,"_3077":121853},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3626":73284,"_31300":73263,"_21660":121855,"_5":14907,"_28477":121810,"_3077":121856},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3626":73285,"_31300":73263,"_21660":121858,"_5":14907,"_28477":121810,"_3077":121859},[],"Ejecuta también la prueba de conectividad del chart:",{"_3626":73286,"_31300":73263,"_21660":121861,"_5":14907,"_28477":121810,"_3077":121862},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3626":73287,"_31300":73263,"_21660":121864,"_5":14907,"_28477":121810,"_3077":121865},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3626":73288,"_31300":73263,"_21660":121867,"_5":14907,"_28477":121814,"_3077":121868},[],"Si recibes un 401:",{"_3626":73289,"_31300":73263,"_21660":121870,"_5":14907,"_28477":121814,"_3077":121871},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3626":73290,"_31300":73263,"_21660":121873,"_5":14907,"_28477":121814,"_3077":121874},[],"verifica emisor, audiencia y expiración del token;",{"_3626":73291,"_31300":73263,"_21660":121876,"_5":14907,"_28477":121814,"_3077":121877},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3626":73292,"_31300":73263,"_21660":121879,"_5":14907,"_28477":121814,"_3077":121880},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3626":73293,"_31300":73263,"_21660":121882,"_5":14907,"_28477":121814,"_3077":121883},[],"Si el login termina pero las APIs devuelven 403:",{"_3626":73294,"_31300":73263,"_21660":121885,"_5":14907,"_28477":121814,"_3077":121886},[],"inspecciona los claims reales del token;",{"_3626":73295,"_31300":73263,"_21660":121888,"_5":14907,"_28477":121814,"_3077":121889},[],"confirma que coinciden con un principal activo;",{"_3626":73296,"_31300":73263,"_21660":121891,"_5":14907,"_28477":121814,"_3077":121892},[],"revisa las políticas concedidas al principal;",{"_3626":73297,"_31300":73263,"_21660":121894,"_5":14907,"_28477":121814,"_3077":121895},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3626":73298,"_31300":73263,"_21660":121897,"_5":14907,"_28477":121814,"_3077":121898},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3626":73299,"_31300":73263,"_21660":121900,"_5":14907,"_28477":121818,"_3077":121901},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3626":73300,"_31300":73263,"_21660":121903,"_5":14907,"_28477":121818,"_3077":121904},[],"Localiza el pod y Service de authz.",{"_3626":73301,"_31300":73263,"_21660":121906,"_5":14907,"_28477":121818,"_3077":121907},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3626":73302,"_31300":73263,"_21660":121909,"_5":14907,"_28477":121818,"_3077":121910},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3626":73303,"_31300":73263,"_21660":121912,"_5":14907,"_28477":121818,"_3077":121913},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3626":73304,"_31300":73263,"_21660":121915,"_5":14907,"_28477":121818,"_3077":121916},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3626":73305,"_31300":73263,"_21660":121918,"_5":14907,"_28477":121822,"_3077":121919},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3626":73306,"_31300":73263,"_21660":121921,"_5":14907,"_28477":121826,"_3077":121922},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3626":73307,"_31300":73263,"_21660":121924,"_5":14907,"_28477":121826,"_3077":121925},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3626":73308,"_31300":73263,"_21660":121927,"_5":14907,"_28477":121826,"_3077":121928},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3626":73309,"_31300":73263,"_21660":121930,"_5":14907,"_28477":121826,"_3077":121931},[],"volumen persistente sin enlazar;",{"_3626":73310,"_31300":73263,"_21660":121933,"_5":14907,"_28477":121826,"_3077":121934},[],"imagen inaccesible o política de pull incorrecta;",{"_3626":73311,"_31300":73263,"_21660":121936,"_5":14907,"_28477":121826,"_3077":121937},[],"configuración inválida del motor criptográfico;",{"_3626":73312,"_31300":73263,"_21660":121939,"_5":14907,"_28477":121826,"_3077":121940},[],"límites de CPU o memoria demasiado bajos;",{"_3626":73313,"_31300":73263,"_21660":121942,"_5":14907,"_28477":121826,"_3077":121943},[],"migración previa incompleta.",{"_3626":73314,"_31300":73263,"_21660":121945,"_5":14907,"_28477":121826,"_3077":121946},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3626":73315,"_31300":73263,"_21660":121948,"_5":14907,"_28477":121826,"_3077":121949},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3626":73316,"_31300":73263,"_21660":121951,"_5":14907,"_28477":121826,"_3077":121952},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3626":73317,"_31300":73263,"_21660":121954,"_5":14907,"_28477":121830,"_3077":121955},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3626":73318,"_31300":73263,"_21660":121957,"_5":14907,"_28477":121830,"_3077":121958},[],"verifica que esté habilitado en el servicio emisor;",{"_3626":73319,"_31300":73263,"_21660":121960,"_5":14907,"_28477":121830,"_3077":121961},[],"comprueba conectividad y credenciales AMQP;",{"_3626":73320,"_31300":73263,"_21660":121963,"_5":14907,"_28477":121830,"_3077":121964},[],"revisa exchange, routing key, colas y consumidores;",{"_3626":73321,"_31300":73263,"_21660":121966,"_5":14907,"_28477":121830,"_3077":121967},[],"inspecciona dead-letter queues;",{"_3626":73322,"_31300":73263,"_21660":121969,"_5":14907,"_28477":121830,"_3077":121970},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3626":73323,"_31300":73263,"_21660":121972,"_5":14907,"_28477":121830,"_3077":121973},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3626":73324,"_31300":73263,"_21660":121975,"_5":14907,"_28477":121830,"_3077":121976},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3626":73325,"_31300":73263,"_21660":121978,"_5":14907,"_28477":121830,"_3077":121979},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3626":73326,"_31300":73263,"_21660":121981,"_5":14907,"_28477":121830,"_3077":121982},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3626":73327,"_31300":73263,"_21660":121984,"_5":14907,"_28477":121830,"_3077":121985},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3626":73328,"_31300":73263,"_21660":121987,"_5":14907,"_28477":121830,"_3077":121988},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3626":73329,"_31300":73263,"_21660":121990,"_5":14907,"_28477":121830,"_3077":121991},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3626":73330,"_31300":73263,"_21660":121993,"_5":14907,"_28477":121834,"_3077":121994},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3626":73331,"_31300":73263,"_21660":121996,"_5":14907,"_28477":121834,"_3077":121997},[],"Antes de cerrar una incidencia, guarda:",{"_3626":73332,"_31300":73263,"_21660":121999,"_5":14907,"_28477":121834,"_3077":122000},[],"causa confirmada;",{"_3626":73333,"_31300":73263,"_21660":122002,"_5":14907,"_28477":121834,"_3077":122003},[],"alcance temporal y recursos afectados;",{"_3626":73334,"_31300":73263,"_21660":122005,"_5":14907,"_28477":121834,"_3077":122006},[],"comandos o consultas utilizados;",{"_3626":73335,"_31300":73263,"_21660":122008,"_5":14907,"_28477":121834,"_3077":122009},[],"cambio aplicado y forma de revertirlo;",{"_3626":73336,"_31300":73263,"_21660":122011,"_5":14907,"_28477":121834,"_3077":122012},[],"validación desde un consumidor;",{"_3626":73337,"_31300":73263,"_21660":122014,"_5":14907,"_28477":121834,"_3077":122015},[],"acción preventiva y propietario.",{"_3626":73338,"_31300":73338,"_5":15267,"_3077":122017,"_31659":122018,"_21660":122022,"_28477":73338},"Modelo de datos",[51072,122019,122020,122021],"Plataforma","Administración","Control de acceso",[],{"_3626":73339,"_31300":73338,"_21660":122024,"_5":14907,"_28477":73338,"_3077":122025},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3626":73340,"_31300":73338,"_5":31656,"_21660":122027,"_28477":122028,"_3077":122029},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3626":73341,"_31300":73338,"_5":31656,"_21660":122031,"_28477":122032,"_3077":122033},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3626":73342,"_31300":73338,"_21660":122035,"_5":14907,"_28477":73338,"_3077":122036},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3626":73343,"_31300":73338,"_21660":122038,"_5":14907,"_28477":122028,"_3077":122039},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3626":73344,"_31300":73338,"_21660":122041,"_5":14907,"_28477":122028,"_3077":122042},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3626":73345,"_31300":73338,"_21660":122044,"_5":14907,"_28477":122028,"_3077":122045},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3626":73346,"_31300":73338,"_21660":122047,"_5":14907,"_28477":122032,"_3077":122048},[],"Entidad (`schema_name.entity_type`)",{"_3626":73347,"_31300":73338,"_21660":122050,"_5":14907,"_28477":122032,"_3077":122051},[],"Tabla (`table_name`)",{"_3626":73348,"_31300":73338,"_21660":122053,"_5":14907,"_28477":122032,"_3077":122054},[],"Clave (`primary_key`)",{"_3626":73349,"_31300":73338,"_21660":122056,"_5":14907,"_28477":122032,"_3077":52622},[],{"_3626":73350,"_31300":73338,"_21660":122058,"_5":14907,"_28477":122032,"_3077":52625},[],{"_3626":73351,"_31300":73338,"_21660":122060,"_5":14907,"_28477":122032,"_3077":52628},[],{"_3626":73352,"_31300":73338,"_21660":122062,"_5":14907,"_28477":122032,"_3077":52631},[],{"_3626":73353,"_31300":73338,"_21660":122064,"_5":14907,"_28477":122032,"_3077":52634},[],{"_3626":73354,"_31300":73338,"_21660":122066,"_5":14907,"_28477":122032,"_3077":52637},[],{"_3626":73355,"_31300":73338,"_21660":122068,"_5":14907,"_28477":122032,"_3077":52640},[],{"_3626":73356,"_31300":73338,"_21660":122070,"_5":14907,"_28477":122032,"_3077":52643},[],{"_3626":73357,"_31300":73338,"_21660":122072,"_5":14907,"_28477":122032,"_3077":52637},[],{"_3626":73358,"_31300":73338,"_21660":122074,"_5":14907,"_28477":122032,"_3077":52648},[],{"_3626":73359,"_31300":73338,"_21660":122076,"_5":14907,"_28477":122032,"_3077":52651},[],{"_3626":73360,"_31300":73338,"_21660":122078,"_5":14907,"_28477":122032,"_3077":52654},[],{"_3626":73361,"_31300":73338,"_21660":122080,"_5":14907,"_28477":122032,"_3077":52657},[],{"_3626":73362,"_31300":73338,"_21660":122082,"_5":14907,"_28477":122032,"_3077":52660},[],{"_3626":73363,"_31300":73338,"_21660":122084,"_5":14907,"_28477":122032,"_3077":52637},[],{"_3626":73364,"_31300":73338,"_21660":122086,"_5":14907,"_28477":122032,"_3077":52665},[],{"_3626":73365,"_31300":73338,"_21660":122088,"_5":14907,"_28477":122032,"_3077":52668},[],{"_3626":73366,"_31300":73338,"_21660":122090,"_5":14907,"_28477":122032,"_3077":52637},[],{"_3626":73367,"_31300":73338,"_21660":122092,"_5":14907,"_28477":122032,"_3077":52673},[],{"_3626":73368,"_31300":73338,"_21660":122094,"_5":14907,"_28477":122032,"_3077":52676},[],{"_3626":73369,"_31300":73338,"_21660":122096,"_5":14907,"_28477":122032,"_3077":52637},[],{"_3626":73370,"_31300":73338,"_21660":122098,"_5":14907,"_28477":122032,"_3077":52681},[],{"_3626":73371,"_31300":73338,"_21660":122100,"_5":14907,"_28477":122032,"_3077":52684},[],{"_3626":73372,"_31300":73338,"_21660":122102,"_5":14907,"_28477":122032,"_3077":52637},[],{"_3626":73373,"_31300":73338,"_21660":122104,"_5":14907,"_28477":122032,"_3077":52689},[],{"_3626":73374,"_31300":73338,"_21660":122106,"_5":14907,"_28477":122032,"_3077":52692},[],{"_3626":73375,"_31300":73338,"_21660":122108,"_5":14907,"_28477":122032,"_3077":52695},[],{"_3626":73376,"_31300":73338,"_21660":122110,"_5":14907,"_28477":122032,"_3077":52698},[],{"_3626":73377,"_31300":73338,"_21660":122112,"_5":14907,"_28477":122032,"_3077":52701},[],{"_3626":73378,"_31300":73338,"_21660":122114,"_5":14907,"_28477":122032,"_3077":52704},[],{"_3626":73379,"_31300":73338,"_21660":122116,"_5":14907,"_28477":122032,"_3077":122117},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3626":73380,"_31300":73338,"_21660":122119,"_5":14907,"_28477":122032,"_3077":122120},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3626":73381,"_31300":73338,"_21660":122122,"_5":14907,"_28477":122032,"_3077":122123},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3626":73382,"_31300":73382,"_5":15267,"_3077":122125,"_31659":122126,"_21660":122127,"_28477":73382},"Visión general del control de acceso",[51072,122019,122020,122021],[],{"_3626":73383,"_31300":73382,"_21660":122129,"_5":14907,"_28477":73382,"_3077":122130},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3626":73384,"_31300":73382,"_5":31656,"_21660":122132,"_28477":122133,"_3077":122134},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3626":73385,"_31300":73382,"_5":31656,"_21660":122136,"_28477":122137,"_3077":122138},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3626":73386,"_31300":73382,"_5":31656,"_21660":122140,"_28477":122141,"_3077":122142},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3626":73387,"_31300":73382,"_5":31656,"_21660":122144,"_28477":122145,"_3077":122146},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3626":73388,"_31300":73382,"_5":31656,"_21660":122148,"_28477":122149,"_3077":122150},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3626":73389,"_31300":73382,"_5":31656,"_21660":122152,"_28477":122153,"_3077":122154},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3626":73390,"_31300":73382,"_5":31656,"_21660":122156,"_28477":122157,"_3077":122158},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3626":73391,"_31300":73382,"_5":31656,"_21660":122160,"_28477":122161,"_3077":122162},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3626":73392,"_31300":73382,"_5":31656,"_21660":122164,"_28477":122165,"_3077":122166},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3626":73393,"_31300":73382,"_5":31656,"_21660":122168,"_28477":122169,"_3077":122170},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3626":73394,"_31300":73382,"_5":31656,"_21660":122172,"_28477":122173,"_3077":122174},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3626":73395,"_31300":73382,"_5":31656,"_21660":122176,"_28477":122177,"_3077":122178},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3626":73396,"_31300":73382,"_5":31656,"_21660":122180,"_28477":122181,"_3077":122182},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3626":73397,"_31300":73382,"_5":31656,"_21660":122184,"_28477":122185,"_3077":122186},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3626":73398,"_31300":73382,"_5":31656,"_21660":122188,"_28477":122189,"_3077":122190},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3626":73399,"_31300":73382,"_5":31656,"_21660":122192,"_28477":122193,"_3077":121160},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3626":73400,"_31300":73382,"_5":31656,"_21660":122195,"_28477":122196,"_3077":122197},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3626":73401,"_31300":73382,"_5":31656,"_21660":122199,"_28477":122200,"_3077":122201},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3626":73402,"_31300":73382,"_5":31656,"_21660":122203,"_28477":122204,"_3077":122205},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3626":73403,"_31300":73382,"_5":31656,"_21660":122207,"_28477":122208,"_3077":122209},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3626":73404,"_31300":73382,"_5":31656,"_21660":122211,"_28477":122212,"_3077":122213},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3626":73405,"_31300":73382,"_5":31656,"_21660":122215,"_28477":122216,"_3077":122217},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3626":73406,"_31300":73382,"_5":31656,"_21660":122219,"_28477":122220,"_3077":122221},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3626":73407,"_31300":73382,"_5":31656,"_21660":122223,"_28477":122224,"_3077":122225},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3626":73408,"_31300":73382,"_5":31656,"_21660":122227,"_28477":122228,"_3077":122229},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3626":73409,"_31300":73382,"_5":31656,"_21660":122231,"_28477":122232,"_3077":122233},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3626":73410,"_31300":73382,"_5":31656,"_21660":122235,"_28477":122236,"_3077":122237},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3626":73411,"_31300":73382,"_5":31656,"_21660":122239,"_28477":122240,"_3077":122241},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3626":73412,"_31300":73382,"_5":31656,"_21660":122243,"_28477":122244,"_3077":122245},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3626":73413,"_31300":73382,"_5":31656,"_21660":122247,"_28477":122248,"_3077":122249},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3626":73414,"_31300":73382,"_5":31656,"_21660":122251,"_28477":122252,"_3077":122253},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3626":73415,"_31300":73382,"_21660":122255,"_5":14907,"_28477":73382,"_3077":122256},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3626":73416,"_31300":73382,"_21660":122258,"_5":14907,"_28477":73382,"_3077":122259},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3626":73417,"_31300":73382,"_21660":122261,"_5":14907,"_28477":73382,"_3077":122262},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3626":73418,"_31300":73382,"_21660":122264,"_5":14907,"_28477":122133,"_3077":122265},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3626":73419,"_31300":73382,"_21660":122267,"_5":14907,"_28477":122133,"_3077":122268},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3626":73420,"_31300":73382,"_21660":122270,"_5":14907,"_28477":122133,"_3077":122271},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3626":73421,"_31300":73382,"_21660":122273,"_5":14907,"_28477":122133,"_3077":122274},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3626":73422,"_31300":73382,"_21660":122276,"_5":14907,"_28477":122133,"_3077":122277},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3626":73423,"_31300":73382,"_21660":122279,"_5":14907,"_28477":122133,"_3077":122280},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3626":73424,"_31300":73382,"_21660":122282,"_5":14907,"_28477":122137,"_3077":122283},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3626":73425,"_31300":73382,"_21660":122285,"_5":14907,"_28477":122137,"_3077":122286},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3626":73426,"_31300":73382,"_21660":122288,"_5":14907,"_28477":122141,"_3077":122289},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3626":73427,"_31300":73382,"_21660":122291,"_5":14907,"_28477":122141,"_3077":122292},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3626":73428,"_31300":73382,"_21660":122294,"_5":14907,"_28477":122141,"_3077":122295},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3626":73429,"_31300":73382,"_21660":122297,"_5":14907,"_28477":122141,"_3077":122298},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3626":73430,"_31300":73382,"_21660":122300,"_5":14907,"_28477":122141,"_3077":122301},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3626":73431,"_31300":73382,"_21660":122303,"_5":14907,"_28477":122141,"_3077":122304},[],"Carga por separado las políticas concedidas a cada principal.",{"_3626":73432,"_31300":73382,"_21660":122306,"_5":14907,"_28477":122141,"_3077":122307},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3626":73433,"_31300":73382,"_21660":122309,"_5":14907,"_28477":122141,"_3077":122310},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3626":73434,"_31300":73382,"_21660":122312,"_5":14907,"_28477":122141,"_3077":122313},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3626":73435,"_31300":73382,"_21660":122315,"_5":14907,"_28477":122141,"_3077":122316},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3626":73436,"_31300":73382,"_21660":122318,"_5":14907,"_28477":122141,"_3077":122319},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3626":73437,"_31300":73382,"_21660":122321,"_5":14907,"_28477":122141,"_3077":122322},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3626":73438,"_31300":73382,"_21660":122324,"_5":14907,"_28477":122145,"_3077":122325},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3626":73439,"_31300":73382,"_21660":122327,"_5":14907,"_28477":122145,"_3077":122328},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3626":73440,"_31300":73382,"_21660":122330,"_5":14907,"_28477":122145,"_3077":122331},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3626":73441,"_31300":73382,"_21660":122333,"_5":14907,"_28477":122145,"_3077":122334},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3626":73442,"_31300":73382,"_21660":122336,"_5":14907,"_28477":122145,"_3077":122337},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3626":73443,"_31300":73382,"_21660":122339,"_5":14907,"_28477":122145,"_3077":122340},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3626":73444,"_31300":73382,"_21660":122342,"_5":14907,"_28477":122145,"_3077":122343},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3626":73445,"_31300":73382,"_21660":122345,"_5":14907,"_28477":122145,"_3077":122346},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3626":73446,"_31300":73382,"_21660":122348,"_5":14907,"_28477":122145,"_3077":122349},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3626":73447,"_31300":73382,"_21660":122351,"_5":14907,"_28477":122145,"_3077":122352},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3626":73448,"_31300":73382,"_21660":122354,"_5":14907,"_28477":122149,"_3077":122355},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3626":73449,"_31300":73382,"_21660":122357,"_5":14907,"_28477":122149,"_3077":122358},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3626":73450,"_31300":73382,"_21660":122360,"_5":14907,"_28477":122149,"_3077":122361},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3626":73451,"_31300":73382,"_21660":122363,"_5":14907,"_28477":122149,"_3077":122364},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3626":73452,"_31300":73382,"_21660":122366,"_5":14907,"_28477":122149,"_3077":122367},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3626":73453,"_31300":73382,"_21660":122369,"_5":14907,"_28477":122149,"_3077":122370},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3626":73454,"_31300":73382,"_21660":122372,"_5":14907,"_28477":122149,"_3077":122373},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3626":73455,"_31300":73382,"_21660":122375,"_5":14907,"_28477":122149,"_3077":122376},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3626":73456,"_31300":73382,"_21660":122378,"_5":14907,"_28477":122149,"_3077":122379},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3626":73457,"_31300":73382,"_21660":122381,"_5":14907,"_28477":122149,"_3077":122382},[],"Las acciones se dividen en dos grupos:",{"_3626":73458,"_31300":73382,"_21660":122384,"_5":14907,"_28477":122149,"_3077":122385},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3626":73459,"_31300":73382,"_21660":122387,"_5":14907,"_28477":122149,"_3077":122388},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3626":73460,"_31300":73382,"_21660":122390,"_5":14907,"_28477":122149,"_3077":122391},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3626":73461,"_31300":73382,"_21660":122393,"_5":14907,"_28477":122153,"_3077":122394},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3626":73462,"_31300":73382,"_21660":122396,"_5":14907,"_28477":122153,"_3077":122397},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3626":73463,"_31300":73382,"_21660":122399,"_5":14907,"_28477":122153,"_3077":122400},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3626":73464,"_31300":73382,"_21660":122402,"_5":14907,"_28477":122157,"_3077":122403},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3626":73465,"_31300":73382,"_21660":122405,"_5":14907,"_28477":122157,"_3077":122406},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3626":73466,"_31300":73382,"_21660":122408,"_5":14907,"_28477":122157,"_3077":122409},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3626":73467,"_31300":73382,"_21660":122411,"_5":14907,"_28477":122157,"_3077":122412},[],"Los operadores implementados son:",{"_3626":73468,"_31300":73382,"_21660":122414,"_5":14907,"_28477":122157,"_3077":122415},[],"`equals`, para igualdad exacta;",{"_3626":73469,"_31300":73382,"_21660":122417,"_5":14907,"_28477":122157,"_3077":122418},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3626":73470,"_31300":73382,"_21660":122420,"_5":14907,"_28477":122157,"_3077":122421},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3626":73471,"_31300":73382,"_21660":122423,"_5":14907,"_28477":122157,"_3077":122424},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3626":73472,"_31300":73382,"_21660":122426,"_5":14907,"_28477":122161,"_3077":122427},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3626":73473,"_31300":73382,"_21660":122429,"_5":14907,"_28477":122161,"_3077":122430},[],"Los modos disponibles son:",{"_3626":73474,"_31300":73382,"_21660":122432,"_5":14907,"_28477":122161,"_3077":122433},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3626":73475,"_31300":73382,"_21660":122435,"_5":14907,"_28477":122161,"_3077":122436},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3626":73476,"_31300":73382,"_21660":122438,"_5":14907,"_28477":122161,"_3077":122439},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3626":73477,"_31300":73382,"_21660":122441,"_5":14907,"_28477":122161,"_3077":122442},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3626":73478,"_31300":73382,"_21660":122444,"_5":14907,"_28477":122161,"_3077":122445},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3626":73479,"_31300":73382,"_21660":122447,"_5":14907,"_28477":122161,"_3077":122448},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3626":73480,"_31300":73382,"_21660":122450,"_5":14907,"_28477":122165,"_3077":122451},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3626":73481,"_31300":73382,"_21660":122453,"_5":14907,"_28477":122165,"_3077":122454},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3626":73482,"_31300":73382,"_21660":122456,"_5":14907,"_28477":122165,"_3077":122457},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3626":73483,"_31300":73382,"_21660":122459,"_5":14907,"_28477":122165,"_3077":122460},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3626":73484,"_31300":73382,"_21660":122462,"_5":14907,"_28477":122173,"_3077":122463},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3626":73485,"_31300":73382,"_21660":122465,"_5":14907,"_28477":122173,"_3077":122466},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3626":73486,"_31300":73382,"_21660":122468,"_5":14907,"_28477":122177,"_3077":122469},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3626":73487,"_31300":73382,"_21660":122471,"_5":14907,"_28477":122177,"_3077":122472},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3626":73488,"_31300":73382,"_21660":122474,"_5":14907,"_28477":122177,"_3077":122475},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3626":73489,"_31300":73382,"_21660":122477,"_5":14907,"_28477":122177,"_3077":122478},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3626":73490,"_31300":73382,"_21660":122480,"_5":14907,"_28477":122177,"_3077":122481},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3626":73491,"_31300":73382,"_21660":122483,"_5":14907,"_28477":122181,"_3077":122484},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3626":73492,"_31300":73382,"_21660":122486,"_5":14907,"_28477":122181,"_3077":122487},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3626":73493,"_31300":73382,"_21660":122489,"_5":14907,"_28477":122181,"_3077":122490},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3626":73494,"_31300":73382,"_21660":122492,"_5":14907,"_28477":122185,"_3077":122493},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3626":73495,"_31300":73382,"_21660":122495,"_5":14907,"_28477":122185,"_3077":122496},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3626":73496,"_31300":73382,"_21660":122498,"_5":14907,"_28477":122185,"_3077":122499},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3626":73497,"_31300":73382,"_21660":122501,"_5":14907,"_28477":122185,"_3077":122502},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3626":73498,"_31300":73382,"_21660":122504,"_5":14907,"_28477":122185,"_3077":122505},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3626":73499,"_31300":73382,"_21660":122507,"_5":14907,"_28477":122185,"_3077":122508},[],"Ten en cuenta que:",{"_3626":73500,"_31300":73382,"_21660":122510,"_5":14907,"_28477":122185,"_3077":122511},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3626":73501,"_31300":73382,"_21660":122513,"_5":14907,"_28477":122185,"_3077":122514},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3626":73502,"_31300":73382,"_21660":122516,"_5":14907,"_28477":122185,"_3077":122517},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3626":73503,"_31300":73382,"_21660":122519,"_5":14907,"_28477":122189,"_3077":122520},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3626":73504,"_31300":73382,"_21660":122522,"_5":14907,"_28477":122189,"_3077":122523},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3626":73505,"_31300":73382,"_21660":122525,"_5":14907,"_28477":122189,"_3077":122526},[],"acceso completo y de solo lectura a KMS;",{"_3626":73506,"_31300":73382,"_21660":122528,"_5":14907,"_28477":122189,"_3077":122529},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3626":73507,"_31300":73382,"_21660":122531,"_5":14907,"_28477":122189,"_3077":122532},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3626":73508,"_31300":73382,"_21660":122534,"_5":14907,"_28477":122189,"_3077":122535},[],"acceso a la interfaz;",{"_3626":73509,"_31300":73382,"_21660":122537,"_5":14907,"_28477":122189,"_3077":122538},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3626":73510,"_31300":73382,"_21660":122540,"_5":14907,"_28477":122189,"_3077":122541},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3626":73511,"_31300":73382,"_21660":122543,"_5":14907,"_28477":122189,"_3077":122544},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3626":73512,"_31300":73382,"_21660":122546,"_5":14907,"_28477":122189,"_3077":122547},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3626":73513,"_31300":73382,"_21660":122549,"_5":14907,"_28477":122189,"_3077":122550},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3626":73514,"_31300":73382,"_21660":122552,"_5":14907,"_28477":122193,"_3077":122553},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3626":73515,"_31300":73382,"_21660":122555,"_5":14907,"_28477":122193,"_3077":122556},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3626":73516,"_31300":73382,"_21660":122558,"_5":14907,"_28477":122193,"_3077":122559},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3626":73517,"_31300":73382,"_21660":122561,"_5":14907,"_28477":122196,"_3077":122562},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3626":73518,"_31300":73382,"_21660":122564,"_5":14907,"_28477":122200,"_3077":122565},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3626":73519,"_31300":73382,"_21660":122567,"_5":14907,"_28477":122200,"_3077":122568},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3626":73520,"_31300":73382,"_21660":122570,"_5":14907,"_28477":122204,"_3077":122571},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3626":73521,"_31300":73382,"_21660":122573,"_5":14907,"_28477":122208,"_3077":122574},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3626":73522,"_31300":73382,"_21660":122576,"_5":14907,"_28477":122212,"_3077":122577},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3626":73523,"_31300":73382,"_21660":122579,"_5":14907,"_28477":122216,"_3077":122580},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3626":73524,"_31300":73382,"_21660":122582,"_5":14907,"_28477":122216,"_3077":122583},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3626":73525,"_31300":73382,"_21660":122585,"_5":14907,"_28477":122220,"_3077":122586},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3626":73526,"_31300":73382,"_21660":122588,"_5":14907,"_28477":122220,"_3077":122589},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3626":73527,"_31300":73382,"_21660":122591,"_5":14907,"_28477":122220,"_3077":122592},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3626":73528,"_31300":73382,"_21660":122594,"_5":14907,"_28477":122220,"_3077":122595},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3626":73529,"_31300":73382,"_21660":122597,"_5":14907,"_28477":122220,"_3077":122598},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3626":73530,"_31300":73382,"_21660":122600,"_5":14907,"_28477":122220,"_3077":122601},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3626":73531,"_31300":73382,"_21660":122603,"_5":14907,"_28477":122220,"_3077":122604},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3626":73532,"_31300":73382,"_21660":122606,"_5":14907,"_28477":122220,"_3077":122607},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3626":73533,"_31300":73382,"_21660":122609,"_5":14907,"_28477":122224,"_3077":122610},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3626":73534,"_31300":73382,"_21660":122612,"_5":14907,"_28477":122224,"_3077":122613},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3626":73535,"_31300":73382,"_21660":122615,"_5":14907,"_28477":122224,"_3077":122616},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3626":73536,"_31300":73382,"_21660":122618,"_5":14907,"_28477":122228,"_3077":122619},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3626":73537,"_31300":73382,"_21660":122621,"_5":14907,"_28477":122228,"_3077":122622},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3626":73538,"_31300":73382,"_21660":122624,"_5":14907,"_28477":122228,"_3077":122625},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3626":73539,"_31300":73382,"_21660":122627,"_5":14907,"_28477":122228,"_3077":122628},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3626":73540,"_31300":73382,"_21660":122630,"_5":14907,"_28477":122228,"_3077":122631},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3626":73541,"_31300":73382,"_21660":122633,"_5":14907,"_28477":122228,"_3077":122634},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3626":73542,"_31300":73382,"_21660":122636,"_5":14907,"_28477":122228,"_3077":122637},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3626":73543,"_31300":73382,"_21660":122639,"_5":14907,"_28477":122228,"_3077":122640},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3626":73544,"_31300":73382,"_21660":122642,"_5":14907,"_28477":122236,"_3077":122643},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3626":73545,"_31300":73382,"_21660":122645,"_5":14907,"_28477":122240,"_3077":122646},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3626":73546,"_31300":73382,"_21660":122648,"_5":14907,"_28477":122240,"_3077":122649},[],"que exista un principal activo del tipo correcto;",{"_3626":73547,"_31300":73382,"_21660":122651,"_5":14907,"_28477":122240,"_3077":122652},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3626":73548,"_31300":73382,"_21660":122654,"_5":14907,"_28477":122240,"_3077":122655},[],"que todas las condiciones del principal se cumplan;",{"_3626":73549,"_31300":73382,"_21660":122657,"_5":14907,"_28477":122240,"_3077":122658},[],"que el principal tenga concedida la política esperada;",{"_3626":73550,"_31300":73382,"_21660":122660,"_5":14907,"_28477":122240,"_3077":122661},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3626":73551,"_31300":73382,"_21660":122663,"_5":14907,"_28477":122240,"_3077":122664},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3626":73552,"_31300":73382,"_21660":122666,"_5":14907,"_28477":122240,"_3077":122667},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3626":73553,"_31300":73382,"_21660":122669,"_5":14907,"_28477":122240,"_3077":122670},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3626":73554,"_31300":73382,"_21660":122672,"_5":14907,"_28477":122244,"_3077":122673},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3626":73555,"_31300":73382,"_21660":122675,"_5":14907,"_28477":122248,"_3077":122676},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3626":73556,"_31300":73382,"_21660":122678,"_5":14907,"_28477":122252,"_3077":122679},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3626":73557,"_31300":73382,"_21660":122681,"_5":14907,"_28477":122252,"_3077":122682},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3626":73558,"_31300":73558,"_5":15267,"_3077":122684,"_31659":122685,"_21660":122686,"_28477":73558},"Alertas y suscripciones",[51072,122019,122020],[],{"_3626":73559,"_31300":73558,"_21660":122688,"_5":14907,"_28477":73558,"_3077":122689},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3626":73560,"_31300":73558,"_5":31656,"_21660":122691,"_28477":122692,"_3077":122693},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3626":73561,"_31300":73558,"_5":31656,"_21660":122695,"_28477":122696,"_3077":122697},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3626":73562,"_31300":73558,"_5":31656,"_21660":122699,"_28477":122700,"_3077":122701},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3626":73563,"_31300":73558,"_5":31656,"_21660":122703,"_28477":122704,"_3077":122705},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3626":73564,"_31300":73558,"_5":31656,"_21660":122707,"_28477":122708,"_3077":122709},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3626":73565,"_31300":73558,"_5":31656,"_21660":122711,"_28477":122712,"_3077":122713},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3626":73566,"_31300":73558,"_5":31656,"_21660":122715,"_28477":122716,"_3077":122717},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3626":73567,"_31300":73558,"_5":31656,"_21660":122719,"_28477":122720,"_3077":122721},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3626":73568,"_31300":73558,"_5":31656,"_21660":122723,"_28477":122724,"_3077":122725},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3626":73569,"_31300":73558,"_5":31656,"_21660":122727,"_28477":122728,"_3077":122729},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3626":73570,"_31300":73558,"_5":31656,"_21660":122731,"_28477":122732,"_3077":122733},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3626":73571,"_31300":73558,"_21660":122735,"_5":14907,"_28477":73558,"_3077":122736},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3626":73572,"_31300":73558,"_21660":122738,"_5":14907,"_28477":122692,"_3077":122739},[],"Un servicio publica un evento de dominio.",{"_3626":73573,"_31300":73558,"_21660":122741,"_5":14907,"_28477":122692,"_3077":122742},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3626":73574,"_31300":73558,"_21660":122744,"_5":14907,"_28477":122692,"_3077":122745},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3626":73575,"_31300":73558,"_21660":122747,"_5":14907,"_28477":122692,"_3077":122748},[],"Lamassu entrega el evento al canal configurado.",{"_3626":73576,"_31300":73558,"_21660":122750,"_5":14907,"_28477":122692,"_3077":122751},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3626":73577,"_31300":73558,"_21660":122753,"_5":14907,"_28477":122696,"_3077":122754},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3626":73578,"_31300":73558,"_21660":122756,"_5":14907,"_28477":122696,"_3077":122757},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3626":73579,"_31300":73558,"_21660":122759,"_5":14907,"_28477":122696,"_3077":122760},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3626":73580,"_31300":73558,"_21660":122762,"_5":14907,"_28477":122696,"_3077":122763},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3626":73581,"_31300":73558,"_21660":122765,"_5":14907,"_28477":122696,"_3077":122766},[],"`apikey_options` necesita `header` y `key`.",{"_3626":73582,"_31300":73558,"_21660":122768,"_5":14907,"_28477":122696,"_3077":122769},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3626":73583,"_31300":73558,"_21660":122771,"_5":14907,"_28477":122696,"_3077":122772},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3626":73584,"_31300":73558,"_21660":122774,"_5":14907,"_28477":122696,"_3077":122775},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3626":73585,"_31300":73558,"_21660":122777,"_5":14907,"_28477":122704,"_3077":122778},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3626":73586,"_31300":73558,"_21660":122780,"_5":14907,"_28477":122708,"_3077":122781},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3626":73587,"_31300":73558,"_21660":122783,"_5":14907,"_28477":122712,"_3077":122784},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3626":73588,"_31300":73558,"_21660":122786,"_5":14907,"_28477":122712,"_3077":122787},[],"**None** notifica todas las instancias del evento.",{"_3626":73589,"_31300":73558,"_21660":122789,"_5":14907,"_28477":122712,"_3077":122790},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3626":73590,"_31300":73558,"_21660":122792,"_5":14907,"_28477":122712,"_3077":122793},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3626":73591,"_31300":73558,"_21660":122795,"_5":14907,"_28477":122712,"_3077":122796},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3626":73592,"_31300":73558,"_21660":122798,"_5":14907,"_28477":122712,"_3077":122799},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3626":73593,"_31300":73558,"_21660":122801,"_5":14907,"_28477":122712,"_3077":122802},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3626":73594,"_31300":73558,"_21660":122804,"_5":14907,"_28477":122716,"_3077":122805},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3626":73595,"_31300":73558,"_21660":122807,"_5":14907,"_28477":122720,"_3077":122808},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3626":73596,"_31300":73558,"_21660":122810,"_5":14907,"_28477":122720,"_3077":122811},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3626":73597,"_31300":73558,"_21660":122813,"_5":14907,"_28477":122720,"_3077":122814},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3626":73598,"_31300":73558,"_21660":122816,"_5":14907,"_28477":122720,"_3077":122817},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3626":73599,"_31300":73558,"_21660":122819,"_5":14907,"_28477":122720,"_3077":122820},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3626":73600,"_31300":73558,"_21660":122822,"_5":14907,"_28477":122720,"_3077":122823},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3626":73601,"_31300":73558,"_21660":122825,"_5":14907,"_28477":122720,"_3077":122826},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3626":73602,"_31300":73558,"_21660":122828,"_5":14907,"_28477":122720,"_3077":122829},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3626":73603,"_31300":73558,"_21660":122831,"_5":14907,"_28477":122724,"_3077":122832},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3626":73604,"_31300":73558,"_21660":122834,"_5":14907,"_28477":122724,"_3077":122835},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3626":73605,"_31300":73558,"_21660":122837,"_5":14907,"_28477":122724,"_3077":122838},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3626":73606,"_31300":73558,"_21660":122840,"_5":14907,"_28477":122724,"_3077":122841},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3626":73607,"_31300":73558,"_21660":122843,"_5":14907,"_28477":122724,"_3077":122844},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3626":73608,"_31300":73558,"_21660":122846,"_5":14907,"_28477":122724,"_3077":122847},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3626":73609,"_31300":73558,"_21660":122849,"_5":14907,"_28477":122724,"_3077":122850},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3626":73610,"_31300":73558,"_21660":122852,"_5":14907,"_28477":122724,"_3077":122853},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3626":73611,"_31300":73558,"_21660":122855,"_5":14907,"_28477":122728,"_3077":122856},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3626":73612,"_31300":73558,"_21660":122858,"_5":14907,"_28477":122728,"_3077":122859},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3626":73613,"_31300":73558,"_21660":122861,"_5":14907,"_28477":122732,"_3077":122862},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3626":73614,"_31300":73558,"_21660":122864,"_5":14907,"_28477":122732,"_3077":122865},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3626":73615,"_31300":73558,"_21660":122867,"_5":14907,"_28477":122732,"_3077":122868},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3626":73616,"_31300":73558,"_21660":122870,"_5":14907,"_28477":122732,"_3077":122871},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3626":73617,"_31300":73558,"_21660":122873,"_5":14907,"_28477":122732,"_3077":122874},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3626":73618,"_31300":73558,"_21660":122876,"_5":14907,"_28477":122732,"_3077":122877},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3626":73619,"_31300":73558,"_21660":122879,"_5":14907,"_28477":122732,"_3077":122880},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3626":73620,"_31300":73558,"_21660":122882,"_5":14907,"_28477":122732,"_3077":122883},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3626":73621,"_31300":73558,"_21660":122885,"_5":14907,"_28477":122732,"_3077":122886},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3626":73622,"_31300":73558,"_21660":122888,"_5":14907,"_28477":122732,"_3077":122889},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3626":73623,"_31300":73623,"_5":15267,"_3077":122891,"_31659":122892,"_21660":122893,"_28477":73623},"Registros de auditoría",[51072,122019,122020],[],{"_3626":73624,"_31300":73623,"_21660":122895,"_5":14907,"_28477":73623,"_3077":122896},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3626":73625,"_31300":73623,"_5":31656,"_21660":122898,"_28477":122899,"_3077":122900},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3626":73626,"_31300":73623,"_5":31656,"_21660":122902,"_28477":122903,"_3077":122904},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3626":73627,"_31300":73623,"_5":31656,"_21660":122906,"_28477":122907,"_3077":122908},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3626":73628,"_31300":73623,"_5":31656,"_21660":122910,"_28477":122911,"_3077":122912},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3626":73629,"_31300":73623,"_5":31656,"_21660":122914,"_28477":122915,"_3077":122916},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3626":73630,"_31300":73623,"_5":31656,"_21660":122918,"_28477":122919,"_3077":122920},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3626":73631,"_31300":73623,"_5":31656,"_21660":122922,"_28477":122923,"_3077":122924},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3626":73632,"_31300":73623,"_5":31656,"_21660":122926,"_28477":122927,"_3077":122928},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3626":73633,"_31300":73623,"_5":31656,"_21660":122930,"_28477":122931,"_3077":122932},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3626":73634,"_31300":73623,"_5":31656,"_21660":122934,"_28477":122935,"_3077":122936},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3626":73635,"_31300":73623,"_5":31656,"_21660":122938,"_28477":122939,"_3077":122940},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3626":73636,"_31300":73623,"_21660":122942,"_5":14907,"_28477":73623,"_3077":122943},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3626":73637,"_31300":73623,"_21660":122945,"_5":14907,"_28477":122899,"_3077":122946},[],"El cuerpo de auditoría incluye:",{"_3626":73638,"_31300":73623,"_21660":122948,"_5":14907,"_28477":122899,"_3077":122949},[],"input: datos recibidos por la operación;",{"_3626":73639,"_31300":73623,"_21660":122951,"_5":14907,"_28477":122899,"_3077":122952},[],"has\\_error: indica si el servicio devolvió un error;",{"_3626":73640,"_31300":73623,"_21660":122954,"_5":14907,"_28477":122899,"_3077":122955},[],"output: resultado producido o mensaje de error;",{"_3626":73641,"_31300":73623,"_21660":122957,"_5":14907,"_28477":122899,"_3077":122958},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3626":73642,"_31300":73623,"_21660":122960,"_5":14907,"_28477":122899,"_3077":122961},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3626":73643,"_31300":73623,"_21660":122963,"_5":14907,"_28477":122899,"_3077":122964},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3626":73644,"_31300":73623,"_21660":122966,"_5":14907,"_28477":122903,"_3077":122967},[],"El backend aplica auditoría a mutaciones de:",{"_3626":73645,"_31300":73623,"_21660":122969,"_5":14907,"_28477":122903,"_3077":122970},[],"autoridades, certificados y perfiles de emisión;",{"_3626":73646,"_31300":73623,"_21660":122972,"_5":14907,"_28477":122903,"_3077":122973},[],"claves y motores KMS;",{"_3626":73647,"_31300":73623,"_21660":122975,"_5":14907,"_28477":122903,"_3077":122976},[],"dispositivos e identidades;",{"_3626":73648,"_31300":73623,"_21660":122978,"_5":14907,"_28477":122903,"_3077":122979},[],"DMS y operaciones de enrolamiento;",{"_3626":73649,"_31300":73623,"_21660":122981,"_5":14907,"_28477":122903,"_3077":122982},[],"funciones de validación y CRL;",{"_3626":73650,"_31300":73623,"_21660":122984,"_5":14907,"_28477":122903,"_3077":122985},[],"principales, políticas y concesiones de autorización.",{"_3626":73651,"_31300":73623,"_21660":122987,"_5":14907,"_28477":122903,"_3077":122988},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3626":73652,"_31300":73623,"_21660":122990,"_5":14907,"_28477":122907,"_3077":122991},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3626":73653,"_31300":73623,"_21660":122993,"_5":14907,"_28477":122907,"_3077":122994},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3626":73654,"_31300":73623,"_21660":122996,"_5":14907,"_28477":122907,"_3077":122997},[],"Diseña el consumidor para:",{"_3626":73655,"_31300":73623,"_21660":122999,"_5":14907,"_28477":122907,"_3077":123000},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3626":73656,"_31300":73623,"_21660":123002,"_5":14907,"_28477":122907,"_3077":123003},[],"conservar el CloudEvent completo sin modificar;",{"_3626":73657,"_31300":73623,"_21660":123005,"_5":14907,"_28477":122907,"_3077":123006},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3626":73658,"_31300":73623,"_21660":123008,"_5":14907,"_28477":122907,"_3077":123009},[],"cifrar en tránsito y en reposo;",{"_3626":73659,"_31300":73623,"_21660":123011,"_5":14907,"_28477":122907,"_3077":123012},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3626":73660,"_31300":73623,"_21660":123014,"_5":14907,"_28477":122907,"_3077":123015},[],"aplicar una política explícita de retención y legal hold;",{"_3626":73661,"_31300":73623,"_21660":123017,"_5":14907,"_28477":122907,"_3077":123018},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3626":73662,"_31300":73623,"_21660":123020,"_5":14907,"_28477":122911,"_3077":123021},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3626":73663,"_31300":73623,"_21660":123023,"_5":14907,"_28477":122911,"_3077":123024},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3626":73664,"_31300":73623,"_21660":123026,"_5":14907,"_28477":122919,"_3077":123027},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3626":73665,"_31300":73623,"_21660":123029,"_5":14907,"_28477":122923,"_3077":123030},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3626":73666,"_31300":73623,"_21660":123032,"_5":14907,"_28477":122927,"_3077":123033},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3626":73667,"_31300":73623,"_21660":123035,"_5":14907,"_28477":122931,"_3077":123036},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3626":73668,"_31300":73623,"_21660":123038,"_5":14907,"_28477":122935,"_3077":123039},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3626":73669,"_31300":73623,"_21660":123041,"_5":14907,"_28477":122939,"_3077":123042},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3626":73670,"_31300":73623,"_21660":123044,"_5":14907,"_28477":122939,"_3077":123045},[],"aparece un evento de auditoría correcto;",{"_3626":73671,"_31300":73623,"_21660":123047,"_5":14907,"_28477":122939,"_3077":123048},[],"el principal coincide con la identidad utilizada;",{"_3626":73672,"_31300":73623,"_21660":123050,"_5":14907,"_28477":122939,"_3077":123051},[],"el consumidor lo persiste una sola vez;",{"_3626":73673,"_31300":73623,"_21660":123053,"_5":14907,"_28477":122939,"_3077":123054},[],"puede recuperarse por recurso, actor y periodo;",{"_3626":73674,"_31300":73623,"_21660":123056,"_5":14907,"_28477":122939,"_3077":123057},[],"una interrupción del consumidor produce una alerta.",{"_3626":73675,"_31300":73623,"_21660":123059,"_5":14907,"_28477":122939,"_3077":123060},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3626":73676,"_31300":73676,"_5":15267,"_3077":123062,"_31659":123063,"_21660":123064,"_28477":73676},"Arquitectura de la plataforma",[51072,122019],[],{"_3626":73677,"_31300":73676,"_21660":123066,"_5":14907,"_28477":73676,"_3077":123067},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3626":73678,"_31300":73676,"_5":31656,"_21660":123069,"_28477":123070,"_3077":123071},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3626":73679,"_31300":73676,"_5":31656,"_21660":123073,"_28477":123074,"_3077":123075},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3626":73680,"_31300":73676,"_5":31656,"_21660":123077,"_28477":123078,"_3077":123079},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3626":73681,"_31300":73676,"_5":31656,"_21660":123081,"_28477":123082,"_3077":123083},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3626":73682,"_31300":73676,"_5":31656,"_21660":123085,"_28477":123086,"_3077":123087},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3626":73683,"_31300":73676,"_21660":123089,"_5":14907,"_28477":73676,"_3077":123090},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3626":73684,"_31300":73676,"_21660":123092,"_5":14907,"_28477":73676,"_3077":123093},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3626":73685,"_31300":73676,"_21660":123095,"_5":14907,"_28477":123070,"_3077":123096},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3626":73686,"_31300":73676,"_21660":123098,"_5":14907,"_28477":123074,"_3077":123099},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3626":73687,"_31300":73676,"_21660":123101,"_5":14907,"_28477":123078,"_3077":123102},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3626":73688,"_31300":73676,"_21660":123104,"_5":14907,"_28477":123082,"_3077":123105},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3626":73689,"_31300":73676,"_21660":123107,"_5":14907,"_28477":123086,"_3077":123108},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3626":73690,"_31300":73690,"_5":15267,"_3077":123110,"_31659":123111,"_21660":123112,"_28477":73690},"Cómo funciona Lamassu",[51072,122019],[],{"_3626":73691,"_31300":73690,"_21660":123114,"_5":14907,"_28477":73690,"_3077":123115},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3626":73692,"_31300":73690,"_5":31656,"_21660":123117,"_28477":123118,"_3077":123119},[],"/docs/pr-preview/pr-78/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3626":73693,"_31300":73690,"_5":31656,"_21660":123121,"_28477":123122,"_3077":123123},[],"/docs/pr-preview/pr-78/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3626":73694,"_31300":73690,"_21660":123125,"_5":14907,"_28477":73690,"_3077":123126},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3626":73695,"_31300":73690,"_21660":123128,"_5":14907,"_28477":123118,"_3077":123129},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3626":73696,"_31300":73690,"_21660":123131,"_5":14907,"_28477":123118,"_3077":123132},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3626":73697,"_31300":73690,"_21660":123134,"_5":14907,"_28477":123118,"_3077":123135},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3626":73698,"_31300":73690,"_21660":123137,"_5":14907,"_28477":123118,"_3077":123138},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3626":73699,"_31300":73690,"_21660":123140,"_5":14907,"_28477":123118,"_3077":123141},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3626":73700,"_31300":73690,"_21660":123143,"_5":14907,"_28477":123122,"_3077":123144},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3626":73701,"_31300":73690,"_21660":123146,"_5":14907,"_28477":123122,"_3077":123147},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3626":73702,"_31300":73690,"_21660":123149,"_5":14907,"_28477":123122,"_3077":123150},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3626":73703,"_31300":73690,"_21660":123152,"_5":14907,"_28477":123122,"_3077":123153},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3626":73704,"_31300":73690,"_21660":123155,"_5":14907,"_28477":123122,"_3077":123156},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3626":73705,"_31300":73690,"_21660":123158,"_5":14907,"_28477":123122,"_3077":123159},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3626":73706,"_31300":73690,"_21660":123161,"_5":14907,"_28477":123122,"_3077":123162},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3626":73707,"_31300":73707,"_5":15267,"_3077":123164,"_31659":123165,"_21660":123166,"_28477":73707},"Dispositivos e identidades",[51072,122019,53756,123164],[],{"_3626":73708,"_31300":73707,"_21660":123168,"_5":14907,"_28477":73707,"_3077":123169},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3626":73709,"_31300":73707,"_5":31656,"_21660":123171,"_28477":123172,"_3077":123173},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3626":73710,"_31300":73707,"_5":31656,"_21660":123175,"_28477":123176,"_3077":123177},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3626":73711,"_31300":73707,"_5":31656,"_21660":123179,"_28477":123180,"_3077":123181},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3626":73712,"_31300":73707,"_5":31656,"_21660":123183,"_28477":123184,"_3077":123185},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3626":73713,"_31300":73707,"_5":31656,"_21660":123187,"_28477":123188,"_3077":123189},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3626":73714,"_31300":73707,"_5":31656,"_21660":123191,"_28477":123192,"_3077":123193},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3626":73715,"_31300":73707,"_5":31656,"_21660":123195,"_28477":123196,"_3077":123197},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3626":73716,"_31300":73707,"_5":31656,"_21660":123199,"_28477":123200,"_3077":123201},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3626":73717,"_31300":73707,"_5":31656,"_21660":123203,"_28477":123204,"_3077":123205},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3626":73718,"_31300":73707,"_5":31656,"_21660":123207,"_28477":123208,"_3077":123209},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3626":73719,"_31300":73707,"_5":31656,"_21660":123211,"_28477":123212,"_3077":123213},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3626":73720,"_31300":73707,"_21660":123215,"_5":14907,"_28477":73707,"_3077":123216},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3626":73721,"_31300":73707,"_21660":123218,"_5":14907,"_28477":73707,"_3077":123219},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3626":73722,"_31300":73707,"_21660":123221,"_5":14907,"_28477":123172,"_3077":123222},[],"Vista operativa",{"_3626":73723,"_31300":73707,"_21660":123224,"_5":14907,"_28477":123172,"_3077":123225},[],"Interpretación",{"_3626":73724,"_31300":73707,"_21660":123227,"_5":14907,"_28477":123172,"_3077":53819},[],{"_3626":73725,"_31300":73707,"_21660":123229,"_5":14907,"_28477":123172,"_3077":123230},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3626":73726,"_31300":73707,"_21660":123232,"_5":14907,"_28477":123172,"_3077":53825},[],{"_3626":73727,"_31300":73707,"_21660":123234,"_5":14907,"_28477":123172,"_3077":123235},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3626":73728,"_31300":73707,"_21660":123237,"_5":14907,"_28477":123172,"_3077":53831},[],{"_3626":73729,"_31300":73707,"_21660":123239,"_5":14907,"_28477":123172,"_3077":123240},[],"La identidad está en la ventana operativa de renovación.",{"_3626":73730,"_31300":73707,"_21660":123242,"_5":14907,"_28477":123172,"_3077":53837},[],{"_3626":73731,"_31300":73707,"_21660":123244,"_5":14907,"_28477":123172,"_3077":123245},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3626":73732,"_31300":73707,"_21660":123247,"_5":14907,"_28477":123172,"_3077":53843},[],{"_3626":73733,"_31300":73707,"_21660":123249,"_5":14907,"_28477":123172,"_3077":123250},[],"La identidad ha vencido.",{"_3626":73734,"_31300":73707,"_21660":123252,"_5":14907,"_28477":123172,"_3077":53849},[],{"_3626":73735,"_31300":73707,"_21660":123254,"_5":14907,"_28477":123172,"_3077":123255},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3626":73736,"_31300":73707,"_21660":123257,"_5":14907,"_28477":123172,"_3077":53855},[],{"_3626":73737,"_31300":73707,"_21660":123259,"_5":14907,"_28477":123172,"_3077":123260},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3626":73738,"_31300":73707,"_21660":123262,"_5":14907,"_28477":123172,"_3077":123263},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3626":73739,"_31300":73707,"_21660":123265,"_5":14907,"_28477":123176,"_3077":123266},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3626":73740,"_31300":73707,"_21660":123268,"_5":14907,"_28477":123176,"_3077":123269},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3626":73741,"_31300":73707,"_21660":123271,"_5":14907,"_28477":123176,"_3077":123272},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3626":73742,"_31300":73707,"_21660":123274,"_5":14907,"_28477":123176,"_3077":123275},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3626":73743,"_31300":73707,"_21660":123277,"_5":14907,"_28477":123180,"_3077":123278},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3626":73744,"_31300":73707,"_21660":123280,"_5":14907,"_28477":123184,"_3077":123281},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3626":73745,"_31300":73707,"_21660":123283,"_5":14907,"_28477":123188,"_3077":123284},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3626":73746,"_31300":73707,"_21660":123286,"_5":14907,"_28477":123192,"_3077":123287},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3626":73747,"_31300":73707,"_21660":123289,"_5":14907,"_28477":123196,"_3077":123290},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3626":73748,"_31300":73707,"_21660":123292,"_5":14907,"_28477":123196,"_3077":123293},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3626":73749,"_31300":73707,"_21660":123295,"_5":14907,"_28477":123200,"_3077":123296},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3626":73750,"_31300":73707,"_21660":123298,"_5":14907,"_28477":123200,"_3077":123299},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3626":73751,"_31300":73707,"_21660":123301,"_5":14907,"_28477":123200,"_3077":123302},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3626":73752,"_31300":73707,"_21660":123304,"_5":14907,"_28477":123200,"_3077":123305},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3626":73753,"_31300":73707,"_21660":123307,"_5":14907,"_28477":123200,"_3077":123308},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3626":73754,"_31300":73707,"_21660":123310,"_5":14907,"_28477":123200,"_3077":123311},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3626":73755,"_31300":73707,"_21660":123313,"_5":14907,"_28477":123204,"_3077":123314},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3626":73756,"_31300":73707,"_21660":123316,"_5":14907,"_28477":123204,"_3077":123317},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3626":73757,"_31300":73707,"_21660":123319,"_5":14907,"_28477":123204,"_3077":123320},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3626":73758,"_31300":73707,"_21660":123322,"_5":14907,"_28477":123208,"_3077":123323},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3626":73759,"_31300":73707,"_21660":123325,"_5":14907,"_28477":123208,"_3077":123326},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3626":73760,"_31300":73707,"_21660":123328,"_5":14907,"_28477":123208,"_3077":123329},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3626":73761,"_31300":73707,"_21660":123331,"_5":14907,"_28477":123208,"_3077":123332},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3626":73762,"_31300":73707,"_21660":123334,"_5":14907,"_28477":123212,"_3077":123335},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3626":73763,"_31300":73707,"_21660":123337,"_5":14907,"_28477":123212,"_3077":123338},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3626":73764,"_31300":73764,"_5":15267,"_3077":123340,"_31659":123341,"_21660":123343,"_28477":73764},"Identidad inicial y autenticación",[51072,122019,53756,123164,123342],"Enrolamiento con PKI",[],{"_3626":73765,"_31300":73764,"_21660":123345,"_5":14907,"_28477":73764,"_3077":123346},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3626":73766,"_31300":73764,"_5":31656,"_21660":123348,"_28477":123349,"_3077":123350},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3626":73767,"_31300":73764,"_5":31656,"_21660":123352,"_28477":123353,"_3077":123354},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3626":73768,"_31300":73764,"_5":31656,"_21660":123356,"_28477":123357,"_3077":123358},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3626":73769,"_31300":73764,"_5":31656,"_21660":123360,"_28477":123361,"_3077":123362},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3626":73770,"_31300":73764,"_5":31656,"_21660":123364,"_28477":123365,"_3077":123366},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3626":73771,"_31300":73764,"_21660":123368,"_5":14907,"_28477":73764,"_3077":123369},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3626":73772,"_31300":73764,"_21660":123371,"_5":14907,"_28477":123349,"_3077":123372},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3626":73773,"_31300":73764,"_21660":123374,"_5":14907,"_28477":123349,"_3077":123375},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3626":73774,"_31300":73764,"_21660":123377,"_5":14907,"_28477":123353,"_3077":123378},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3626":73775,"_31300":73764,"_21660":123380,"_5":14907,"_28477":123353,"_3077":123381},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3626":73776,"_31300":73764,"_21660":123383,"_5":14907,"_28477":123353,"_3077":123384},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3626":73777,"_31300":73764,"_21660":123386,"_5":14907,"_28477":123357,"_3077":123387},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3626":73778,"_31300":73764,"_21660":123389,"_5":14907,"_28477":123357,"_3077":123390},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3626":73779,"_31300":73764,"_21660":123392,"_5":14907,"_28477":123361,"_3077":123393},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3626":73780,"_31300":73764,"_21660":123395,"_5":14907,"_28477":123361,"_3077":123396},[],"Ejemplo de cuerpo:",{"_3626":73781,"_31300":73764,"_21660":123398,"_5":14907,"_28477":123361,"_3077":123399},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3626":73782,"_31300":73764,"_21660":123401,"_5":14907,"_28477":123361,"_3077":123402},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3626":73783,"_31300":73764,"_21660":123404,"_5":14907,"_28477":123361,"_3077":123405},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3626":73784,"_31300":73764,"_21660":123407,"_5":14907,"_28477":123361,"_3077":123408},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3626":73785,"_31300":73764,"_21660":123410,"_5":14907,"_28477":123365,"_3077":123411},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3626":73786,"_31300":73764,"_21660":123413,"_5":14907,"_28477":123365,"_3077":123414},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3626":73787,"_31300":73764,"_21660":123416,"_5":14907,"_28477":123365,"_3077":123417},[],"Los puntos de distribución CRL descargados se almacenan en caché en memoria en el DMS Manager, indexados por su URL, de modo que las operaciones de enrolamiento y reenrolamiento simultáneas comparten una única descarga. Una lista en caché se reutiliza como máximo durante `crl_cache.max_ttl` (1 hora por defecto) y nunca más allá de su propio `nextUpdate` — o, si la lista no lo tiene, unas 24 horas tras `thisUpdate` conforme a la regla de frescura anterior. Leer una lista en caché no alarga su vida, y su firma se verifica frente al emisor del certificado en cada uso. Una lista caducada, mayor que `crl_cache.max_size_mb` (256 MB por defecto) o cuya descarga falló no se guarda en caché; la siguiente operación la descarga de nuevo. La caché es una configuración del servicio DMS Manager compartida por todos los DMS, no una opción por DMS, y afecta solo a los puntos de distribución CRL — las respuestas OCSP nunca se guardan en caché. Ambos ajustes son claves de la sección `crl_cache` del fichero de configuración del DMS Manager (`max_ttl` como duración, por ejemplo `10m`, y `max_size_mb` como entero); un valor sin definir o `0` usa el valor por defecto, y un valor negativo detiene el servicio al arrancar. La caché no se puede desactivar: para acortar la ventana en la que una revocación recién publicada sigue sin verse, reduce `max_ttl`. El Helm chart de Lamassu no expone `crl_cache` como valor, así que un despliegue con Helm funciona con los valores por defecto salvo que modifiques la configuración renderizada del DMS Manager. Los certificados gestionados por Lamassu no pasan por esta ruta: se comprueban con su estado almacenado y nunca llegan a la vía CRL.",{"_3626":73788,"_31300":73764,"_21660":123419,"_5":14907,"_28477":123365,"_3077":123420},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). Una revocación publicada en una CRL externa recién emitida puede tardar además hasta la ventana de caché — `crl_cache.max_ttl`, 1 hora por defecto — en volverse visible, además del propio ritmo de publicación de los responders. La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3626":73789,"_31300":73764,"_21660":123422,"_5":14907,"_28477":123365,"_3077":123423},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3626":73790,"_31300":73790,"_5":15267,"_3077":123425,"_31659":123426,"_21660":123427,"_28477":73790},"Configura y opera el DMS",[51072,122019,53756,123164,123342],[],{"_3626":73791,"_31300":73790,"_21660":123429,"_5":14907,"_28477":73790,"_3077":123430},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3626":73792,"_31300":73790,"_5":31656,"_21660":123432,"_28477":123433,"_3077":120553},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3626":73793,"_31300":73790,"_5":31656,"_21660":123435,"_28477":123436,"_3077":123437},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3626":73794,"_31300":73790,"_5":31656,"_21660":123439,"_28477":123440,"_3077":123441},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3626":73795,"_31300":73790,"_5":31656,"_21660":123443,"_28477":123444,"_3077":123445},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3626":73796,"_31300":73790,"_5":31656,"_21660":123447,"_28477":123448,"_3077":123449},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3626":73797,"_31300":73790,"_5":31656,"_21660":123451,"_28477":123452,"_3077":123453},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3626":73798,"_31300":73790,"_5":31656,"_21660":123455,"_28477":123456,"_3077":123457},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3626":73799,"_31300":73790,"_5":31656,"_21660":123459,"_28477":123460,"_3077":123461},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3626":73800,"_31300":73790,"_5":31656,"_21660":123463,"_28477":123464,"_3077":54063},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3626":73801,"_31300":73790,"_5":31656,"_21660":123466,"_28477":123467,"_3077":54067},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3626":73802,"_31300":73790,"_5":31656,"_21660":123469,"_28477":123470,"_3077":123471},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3626":73803,"_31300":73790,"_5":31656,"_21660":123473,"_28477":123474,"_3077":123475},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3626":73804,"_31300":73790,"_5":31656,"_21660":123477,"_28477":123478,"_3077":123479},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3626":73805,"_31300":73790,"_5":31656,"_21660":123481,"_28477":123482,"_3077":123483},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3626":73806,"_31300":73790,"_5":31656,"_21660":123485,"_28477":123486,"_3077":54087},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3626":73807,"_31300":73790,"_5":31656,"_21660":123488,"_28477":123489,"_3077":123490},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3626":73808,"_31300":73790,"_5":31656,"_21660":123492,"_28477":123493,"_3077":123494},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3626":73809,"_31300":73790,"_5":31656,"_21660":123496,"_28477":123497,"_3077":123498},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3626":73810,"_31300":73790,"_21660":123500,"_5":14907,"_28477":73790,"_3077":123501},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3626":73811,"_31300":73790,"_21660":123503,"_5":14907,"_28477":123433,"_3077":123504},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3626":73812,"_31300":73790,"_21660":123506,"_5":14907,"_28477":123433,"_3077":123507},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3626":73813,"_31300":73790,"_21660":123509,"_5":14907,"_28477":123440,"_3077":123510},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3626":73814,"_31300":73790,"_21660":123512,"_5":14907,"_28477":123444,"_3077":123513},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3626":73815,"_31300":73790,"_21660":123515,"_5":14907,"_28477":123448,"_3077":123516},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3626":73816,"_31300":73790,"_21660":123518,"_5":14907,"_28477":123452,"_3077":123519},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3626":73817,"_31300":73790,"_21660":123521,"_5":14907,"_28477":123456,"_3077":123522},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3626":73818,"_31300":73790,"_21660":123524,"_5":14907,"_28477":123464,"_3077":123525},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3626":73819,"_31300":73790,"_21660":123527,"_5":14907,"_28477":123464,"_3077":123528},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3626":73820,"_31300":73790,"_21660":123530,"_5":14907,"_28477":123467,"_3077":123531},[],"Campo de `settings.enrollment_settings`",{"_3626":73821,"_31300":73790,"_21660":123533,"_5":14907,"_28477":123467,"_3077":123534},[],"Decisión",{"_3626":73822,"_31300":73790,"_21660":123536,"_5":14907,"_28477":123467,"_3077":54138},[],{"_3626":73823,"_31300":73790,"_21660":123538,"_5":14907,"_28477":123467,"_3077":123539},[],"`EST_RFC7030` para estas operaciones.",{"_3626":73824,"_31300":73790,"_21660":123541,"_5":14907,"_28477":123467,"_3077":54144},[],{"_3626":73825,"_31300":73790,"_21660":123543,"_5":14907,"_28477":123467,"_3077":123544},[],"ID de la CA que firmará.",{"_3626":73826,"_31300":73790,"_21660":123546,"_5":14907,"_28477":123467,"_3077":54150},[],{"_3626":73827,"_31300":73790,"_21660":123548,"_5":14907,"_28477":123467,"_3077":123549},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3626":73828,"_31300":73790,"_21660":123551,"_5":14907,"_28477":123467,"_3077":54156},[],{"_3626":73829,"_31300":73790,"_21660":123553,"_5":14907,"_28477":123467,"_3077":123554},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3626":73830,"_31300":73790,"_21660":123556,"_5":14907,"_28477":123467,"_3077":54162},[],{"_3626":73831,"_31300":73790,"_21660":123558,"_5":14907,"_28477":123467,"_3077":123559},[],"Uno de los cuatro modos de autenticación.",{"_3626":73832,"_31300":73790,"_21660":123561,"_5":14907,"_28477":123467,"_3077":123562},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3626":73833,"_31300":73790,"_21660":123564,"_5":14907,"_28477":123470,"_3077":123565},[],"Los bloques son independientes:",{"_3626":73834,"_31300":73790,"_21660":123567,"_5":14907,"_28477":123470,"_3077":123568},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3626":73835,"_31300":73790,"_21660":123570,"_5":14907,"_28477":123470,"_3077":123571},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3626":73836,"_31300":73790,"_21660":123573,"_5":14907,"_28477":123470,"_3077":54180},[],{"_3626":73837,"_31300":73790,"_21660":123575,"_5":14907,"_28477":123470,"_3077":123576},[],"Control aplicado en la operación configurada",{"_3626":73838,"_31300":73790,"_21660":123578,"_5":14907,"_28477":123470,"_3077":54186},[],{"_3626":73839,"_31300":73790,"_21660":123580,"_5":14907,"_28477":123470,"_3077":123581},[],"Validación del certificado presentado.",{"_3626":73840,"_31300":73790,"_21660":123583,"_5":14907,"_28477":123470,"_3077":54192},[],{"_3626":73841,"_31300":73790,"_21660":123585,"_5":14907,"_28477":123470,"_3077":123586},[],"Autorización del webhook configurado.",{"_3626":73842,"_31300":73790,"_21660":123588,"_5":14907,"_28477":123470,"_3077":54198},[],{"_3626":73843,"_31300":73790,"_21660":123590,"_5":14907,"_28477":123470,"_3077":123591},[],"Validación del certificado y, después, aprobación del webhook.",{"_3626":73844,"_31300":73790,"_21660":123593,"_5":14907,"_28477":123470,"_3077":54204},[],{"_3626":73845,"_31300":73790,"_21660":123595,"_5":14907,"_28477":123470,"_3077":123596},[],"Sin autenticación del solicitante por el DMS.",{"_3626":73846,"_31300":73790,"_21660":123598,"_5":14907,"_28477":123470,"_3077":123599},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3626":73847,"_31300":73790,"_21660":123601,"_5":14907,"_28477":123470,"_3077":123602},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3626":73848,"_31300":73790,"_21660":123604,"_5":14907,"_28477":123470,"_3077":123605},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones. Las listas CRL descargadas para estas comprobaciones se reutilizan durante un tiempo limitado antes de volver a descargarse; consulta Revocación y comprobaciones para conocer la ventana de caché y su efecto sobre la visibilidad de una revocación.",{"_3626":73849,"_31300":73790,"_21660":123607,"_5":14907,"_28477":123470,"_3077":123608},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3626":73850,"_31300":73790,"_21660":123610,"_5":14907,"_28477":123470,"_3077":123611},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3626":73851,"_31300":73790,"_21660":123613,"_5":14907,"_28477":123474,"_3077":123614},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3626":73852,"_31300":73790,"_21660":123616,"_5":14907,"_28477":123474,"_3077":123617},[],"Campo de `external_webhook_settings`",{"_3626":73853,"_31300":73790,"_21660":123619,"_5":14907,"_28477":123474,"_3077":123534},[],{"_3626":73854,"_31300":73790,"_21660":123621,"_5":14907,"_28477":123474,"_3077":54233},[],{"_3626":73855,"_31300":73790,"_21660":123623,"_5":14907,"_28477":123474,"_3077":123624},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3626":73856,"_31300":73790,"_21660":123626,"_5":14907,"_28477":123474,"_3077":54239},[],{"_3626":73857,"_31300":73790,"_21660":123628,"_5":14907,"_28477":123474,"_3077":123629},[],"`POST` o `PUT`; `POST` por defecto.",{"_3626":73858,"_31300":73790,"_21660":123631,"_5":14907,"_28477":123474,"_3077":54245},[],{"_3626":73859,"_31300":73790,"_21660":123633,"_5":14907,"_28477":123474,"_3077":123634},[],"Etiqueta usada en los logs del servicio.",{"_3626":73860,"_31300":73790,"_21660":123636,"_5":14907,"_28477":123474,"_3077":54251},[],{"_3626":73861,"_31300":73790,"_21660":123638,"_5":14907,"_28477":123474,"_3077":123639},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3626":73862,"_31300":73790,"_21660":123641,"_5":14907,"_28477":123474,"_3077":54257},[],{"_3626":73863,"_31300":73790,"_21660":123643,"_5":14907,"_28477":123474,"_3077":123644},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3626":73864,"_31300":73790,"_21660":123646,"_5":14907,"_28477":123474,"_3077":54263},[],{"_3626":73865,"_31300":73790,"_21660":123648,"_5":14907,"_28477":123474,"_3077":123649},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3626":73866,"_31300":73790,"_21660":123651,"_5":14907,"_28477":123474,"_3077":54269},[],{"_3626":73867,"_31300":73790,"_21660":123653,"_5":14907,"_28477":123474,"_3077":123654},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3626":73868,"_31300":73790,"_21660":123656,"_5":14907,"_28477":123474,"_3077":54275},[],{"_3626":73869,"_31300":73790,"_21660":123658,"_5":14907,"_28477":123474,"_3077":123659},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3626":73870,"_31300":73790,"_21660":123661,"_5":14907,"_28477":123474,"_3077":54281},[],{"_3626":73871,"_31300":73790,"_21660":123663,"_5":14907,"_28477":123474,"_3077":123664},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3626":73872,"_31300":73790,"_21660":123666,"_5":14907,"_28477":123474,"_3077":54287},[],{"_3626":73873,"_31300":73790,"_21660":123668,"_5":14907,"_28477":123474,"_3077":123669},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3626":73874,"_31300":73790,"_21660":123671,"_5":14907,"_28477":123474,"_3077":123672},[],"Reglas de esa configuración:",{"_3626":73875,"_31300":73790,"_21660":123674,"_5":14907,"_28477":123474,"_3077":123675},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3626":73876,"_31300":73790,"_21660":123677,"_5":14907,"_28477":123474,"_3077":123678},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3626":73877,"_31300":73790,"_21660":123680,"_5":14907,"_28477":123474,"_3077":123681},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3626":73878,"_31300":73790,"_21660":123683,"_5":14907,"_28477":123474,"_3077":123684},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3626":73879,"_31300":73790,"_21660":123686,"_5":14907,"_28477":123474,"_3077":123687},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3626":73880,"_31300":73790,"_21660":123689,"_5":14907,"_28477":123474,"_3077":123690},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3626":73881,"_31300":73790,"_21660":123692,"_5":14907,"_28477":123474,"_3077":123693},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3626":73882,"_31300":73790,"_21660":123695,"_5":14907,"_28477":123474,"_3077":123696},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3626":73883,"_31300":73790,"_21660":123698,"_5":14907,"_28477":123474,"_3077":123699},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3626":73884,"_31300":73790,"_21660":123701,"_5":14907,"_28477":123478,"_3077":123702},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3626":73885,"_31300":73790,"_21660":123704,"_5":14907,"_28477":123482,"_3077":123705},[],"Campo de `settings.reenrollment_settings`",{"_3626":73886,"_31300":73790,"_21660":123707,"_5":14907,"_28477":123482,"_3077":123708},[],"Función",{"_3626":73887,"_31300":73790,"_21660":123710,"_5":14907,"_28477":123482,"_3077":54331},[],{"_3626":73888,"_31300":73790,"_21660":123712,"_5":14907,"_28477":123482,"_3077":123713},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3626":73889,"_31300":73790,"_21660":123715,"_5":14907,"_28477":123482,"_3077":54337},[],{"_3626":73890,"_31300":73790,"_21660":123717,"_5":14907,"_28477":123482,"_3077":123718},[],"Umbral operativo preventivo de monitorización.",{"_3626":73891,"_31300":73790,"_21660":123720,"_5":14907,"_28477":123482,"_3077":54343},[],{"_3626":73892,"_31300":73790,"_21660":123722,"_5":14907,"_28477":123482,"_3077":123723},[],"Umbral operativo crítico de monitorización.",{"_3626":73893,"_31300":73790,"_21660":123725,"_5":14907,"_28477":123482,"_3077":54349},[],{"_3626":73894,"_31300":73790,"_21660":123727,"_5":14907,"_28477":123482,"_3077":123728},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3626":73895,"_31300":73790,"_21660":123730,"_5":14907,"_28477":123482,"_3077":54355},[],{"_3626":73896,"_31300":73790,"_21660":123732,"_5":14907,"_28477":123482,"_3077":123733},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3626":73897,"_31300":73790,"_21660":123735,"_5":14907,"_28477":123482,"_3077":54361},[],{"_3626":73898,"_31300":73790,"_21660":123737,"_5":14907,"_28477":123482,"_3077":123738},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3626":73899,"_31300":73790,"_21660":123740,"_5":14907,"_28477":123482,"_3077":123741},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3626":73900,"_31300":73790,"_21660":123743,"_5":14907,"_28477":123486,"_3077":123744},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3626":73901,"_31300":73790,"_21660":123746,"_5":14907,"_28477":123489,"_3077":120917},[],{"_3626":73902,"_31300":73790,"_21660":123748,"_5":14907,"_28477":123489,"_3077":123749},[],"Qué publica",{"_3626":73903,"_31300":73790,"_21660":123751,"_5":14907,"_28477":123489,"_3077":54378},[],{"_3626":73904,"_31300":73790,"_21660":123753,"_5":14907,"_28477":123489,"_3077":123754},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3626":73905,"_31300":73790,"_21660":123756,"_5":14907,"_28477":123489,"_3077":54384},[],{"_3626":73906,"_31300":73790,"_21660":123758,"_5":14907,"_28477":123489,"_3077":123759},[],"Certificado de la CA emisora seleccionada.",{"_3626":73907,"_31300":73790,"_21660":123761,"_5":14907,"_28477":123489,"_3077":54390},[],{"_3626":73908,"_31300":73790,"_21660":123763,"_5":14907,"_28477":123489,"_3077":123764},[],"Certificados de las CAs elegidas explícitamente.",{"_3626":73909,"_31300":73790,"_21660":123766,"_5":14907,"_28477":123489,"_3077":123767},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3626":73910,"_31300":73790,"_21660":123769,"_5":14907,"_28477":123493,"_3077":123770},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3626":73911,"_31300":73790,"_21660":123772,"_5":14907,"_28477":123493,"_3077":123773},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3626":73912,"_31300":73790,"_21660":123775,"_5":14907,"_28477":123493,"_3077":123776},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3626":73913,"_31300":73790,"_21660":123778,"_5":14907,"_28477":123497,"_3077":123779},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3626":73914,"_31300":73914,"_5":15267,"_3077":123781,"_31659":123782,"_21660":123783,"_28477":73914},"Integra el cliente EST",[51072,122019,53756,123164,123342],[],{"_3626":73915,"_31300":73914,"_21660":123785,"_5":14907,"_28477":73914,"_3077":123786},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3626":73916,"_31300":73914,"_5":31656,"_21660":123788,"_28477":123789,"_3077":120553},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3626":73917,"_31300":73914,"_5":31656,"_21660":123791,"_28477":123792,"_3077":123793},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3626":73918,"_31300":73914,"_5":31656,"_21660":123795,"_28477":123796,"_3077":123797},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3626":73919,"_31300":73914,"_5":31656,"_21660":123799,"_28477":123800,"_3077":123801},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3626":73920,"_31300":73914,"_5":31656,"_21660":123803,"_28477":123804,"_3077":123805},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3626":73921,"_31300":73914,"_5":31656,"_21660":123807,"_28477":123808,"_3077":123809},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3626":73922,"_31300":73914,"_21660":123811,"_5":14907,"_28477":73914,"_3077":123812},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3626":73923,"_31300":73914,"_21660":123814,"_5":14907,"_28477":123789,"_3077":123815},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3626":73924,"_31300":73914,"_21660":123817,"_5":14907,"_28477":123789,"_3077":123818},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3626":73925,"_31300":73914,"_21660":123820,"_5":14907,"_28477":123789,"_3077":123821},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3626":73926,"_31300":73914,"_21660":123823,"_5":14907,"_28477":123792,"_3077":123824},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3626":73927,"_31300":73914,"_21660":123826,"_5":14907,"_28477":123792,"_3077":123827},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3626":73928,"_31300":73914,"_21660":123829,"_5":14907,"_28477":123796,"_3077":123830},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3626":73929,"_31300":73914,"_21660":123832,"_5":14907,"_28477":123796,"_3077":123833},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3626":73930,"_31300":73914,"_21660":123835,"_5":14907,"_28477":123800,"_3077":123836},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3626":73931,"_31300":73914,"_21660":123838,"_5":14907,"_28477":123800,"_3077":123839},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3626":73932,"_31300":73914,"_21660":123841,"_5":14907,"_28477":123804,"_3077":123842},[],"Para el caso de una raíz que emite directamente:",{"_3626":73933,"_31300":73914,"_21660":123844,"_5":14907,"_28477":123804,"_3077":123845},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3626":73934,"_31300":73914,"_21660":123847,"_5":14907,"_28477":123804,"_3077":123848},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3626":73935,"_31300":73914,"_21660":123850,"_5":14907,"_28477":123808,"_3077":123851},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3626":73936,"_31300":73936,"_5":15267,"_3077":123853,"_31659":123854,"_21660":123855,"_28477":73936},"Referencia EST",[51072,122019,53756,123164,123342],[],{"_3626":73937,"_31300":73936,"_21660":123857,"_5":14907,"_28477":73936,"_3077":123858},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3626":73938,"_31300":73936,"_5":31656,"_21660":123860,"_28477":123861,"_3077":123862},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3626":73939,"_31300":73936,"_5":31656,"_21660":123864,"_28477":123865,"_3077":23468},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3626":73940,"_31300":73936,"_5":31656,"_21660":123867,"_28477":123868,"_3077":27006},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3626":73941,"_31300":73936,"_5":31656,"_21660":123870,"_28477":123871,"_3077":27013},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3626":73942,"_31300":73936,"_5":31656,"_21660":123873,"_28477":123874,"_3077":26275},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3626":73943,"_31300":73936,"_5":31656,"_21660":123876,"_28477":123877,"_3077":123878},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3626":73944,"_31300":73936,"_5":31656,"_21660":123880,"_28477":123881,"_3077":123882},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3626":73945,"_31300":73936,"_5":31656,"_21660":123884,"_28477":123885,"_3077":123886},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3626":73946,"_31300":73936,"_21660":123888,"_5":14907,"_28477":73936,"_3077":123889},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3626":73947,"_31300":73936,"_21660":123891,"_5":14907,"_28477":123861,"_3077":123892},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3626":73948,"_31300":73936,"_21660":123894,"_5":14907,"_28477":123861,"_3077":121779},[],{"_3626":73949,"_31300":73936,"_21660":123896,"_5":14907,"_28477":123861,"_3077":123897},[],"Método",{"_3626":73950,"_31300":73936,"_21660":123899,"_5":14907,"_28477":123861,"_3077":123900},[],"Autenticación y condición",{"_3626":73951,"_31300":73936,"_21660":123902,"_5":14907,"_28477":123861,"_3077":54533},[],{"_3626":73952,"_31300":73936,"_21660":123904,"_5":14907,"_28477":123861,"_3077":54536},[],{"_3626":73953,"_31300":73936,"_21660":123906,"_5":14907,"_28477":123861,"_3077":123907},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3626":73954,"_31300":73936,"_21660":123909,"_5":14907,"_28477":123861,"_3077":54542},[],{"_3626":73955,"_31300":73936,"_21660":123911,"_5":14907,"_28477":123861,"_3077":54545},[],{"_3626":73956,"_31300":73936,"_21660":123913,"_5":14907,"_28477":123861,"_3077":123914},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3626":73957,"_31300":73936,"_21660":123916,"_5":14907,"_28477":123861,"_3077":54551},[],{"_3626":73958,"_31300":73936,"_21660":123918,"_5":14907,"_28477":123861,"_3077":54545},[],{"_3626":73959,"_31300":73936,"_21660":123920,"_5":14907,"_28477":123861,"_3077":123921},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3626":73960,"_31300":73936,"_21660":123923,"_5":14907,"_28477":123861,"_3077":54559},[],{"_3626":73961,"_31300":73936,"_21660":123925,"_5":14907,"_28477":123861,"_3077":54545},[],{"_3626":73962,"_31300":73936,"_21660":123927,"_5":14907,"_28477":123861,"_3077":123928},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3626":73963,"_31300":73936,"_21660":123930,"_5":14907,"_28477":123861,"_3077":123931},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3626":73964,"_31300":73936,"_21660":123933,"_5":14907,"_28477":123865,"_3077":123934},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3626":73965,"_31300":73936,"_21660":123936,"_5":14907,"_28477":123865,"_3077":123937},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3626":73966,"_31300":73936,"_21660":123939,"_5":14907,"_28477":123868,"_3077":123940},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3626":73967,"_31300":73936,"_21660":123942,"_5":14907,"_28477":123868,"_3077":123943},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3626":73968,"_31300":73936,"_21660":123945,"_5":14907,"_28477":123871,"_3077":123946},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3626":73969,"_31300":73936,"_21660":123948,"_5":14907,"_28477":123871,"_3077":123949},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3626":73970,"_31300":73936,"_21660":123951,"_5":14907,"_28477":123874,"_3077":123952},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3626":73971,"_31300":73936,"_21660":123954,"_5":14907,"_28477":123874,"_3077":123955},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3626":73972,"_31300":73936,"_21660":123957,"_5":14907,"_28477":123877,"_3077":123958},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3626":73973,"_31300":73936,"_21660":123960,"_5":14907,"_28477":123877,"_3077":123961},[],"Parte",{"_3626":73974,"_31300":73936,"_21660":123963,"_5":14907,"_28477":123877,"_3077":123964},[],"Contenido tras decodificar su Base64",{"_3626":73975,"_31300":73936,"_21660":123966,"_5":14907,"_28477":123877,"_3077":54603},[],{"_3626":73976,"_31300":73936,"_21660":123968,"_5":14907,"_28477":123877,"_3077":123969},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3626":73977,"_31300":73936,"_21660":123971,"_5":14907,"_28477":123877,"_3077":54609},[],{"_3626":73978,"_31300":73936,"_21660":123973,"_5":14907,"_28477":123877,"_3077":123974},[],"PKCS#7 DER con el certificado emitido.",{"_3626":73979,"_31300":73936,"_21660":123976,"_5":14907,"_28477":123877,"_3077":123977},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3626":73980,"_31300":73936,"_21660":123979,"_5":14907,"_28477":123881,"_3077":123980},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3626":73981,"_31300":73936,"_21660":123982,"_5":14907,"_28477":123881,"_3077":123983},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3626":73982,"_31300":73936,"_21660":123985,"_5":14907,"_28477":123881,"_3077":123986},[],"Convierte y comprueba el resultado:",{"_3626":73983,"_31300":73936,"_21660":123988,"_5":14907,"_28477":123881,"_3077":123989},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3626":73984,"_31300":73936,"_21660":123991,"_5":14907,"_28477":123885,"_3077":123992},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3626":73985,"_31300":73936,"_21660":123994,"_5":14907,"_28477":123885,"_3077":123995},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3626":73986,"_31300":73986,"_5":15267,"_3077":123342,"_31659":123997,"_21660":123998,"_28477":73986},[51072,122019,53756,123164,123342],[],{"_3626":73987,"_31300":73986,"_21660":124000,"_5":14907,"_28477":73986,"_3077":124001},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3626":73988,"_31300":73986,"_5":31656,"_21660":124003,"_28477":124004,"_3077":124005},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3626":73989,"_31300":73986,"_5":31656,"_21660":124007,"_28477":124008,"_3077":124009},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3626":73990,"_31300":73986,"_5":31656,"_21660":124011,"_28477":124012,"_3077":124013},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3626":73991,"_31300":73986,"_21660":124015,"_5":14907,"_28477":73986,"_3077":124016},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3626":73992,"_31300":73986,"_21660":124018,"_5":14907,"_28477":124004,"_3077":124019},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3626":73993,"_31300":73986,"_21660":124021,"_5":14907,"_28477":124004,"_3077":124022},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3626":73994,"_31300":73986,"_21660":124024,"_5":14907,"_28477":124004,"_3077":124025},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3626":73995,"_31300":73986,"_21660":124027,"_5":14907,"_28477":124004,"_3077":124028},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3626":73996,"_31300":73986,"_21660":124030,"_5":14907,"_28477":124004,"_3077":124031},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3626":73997,"_31300":73986,"_21660":124033,"_5":14907,"_28477":124004,"_3077":124034},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3626":73998,"_31300":73986,"_21660":124036,"_5":14907,"_28477":124008,"_3077":124037},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3626":73999,"_31300":73986,"_21660":124039,"_5":14907,"_28477":124008,"_3077":124040},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3626":74000,"_31300":73986,"_21660":124042,"_5":14907,"_28477":124008,"_3077":124043},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3626":74001,"_31300":73986,"_21660":124045,"_5":14907,"_28477":124008,"_3077":124046},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3626":74002,"_31300":73986,"_21660":124048,"_5":14907,"_28477":124012,"_3077":124049},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3626":74003,"_31300":73986,"_21660":124051,"_5":14907,"_28477":124012,"_3077":124052},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3626":74004,"_31300":73986,"_21660":124054,"_5":14907,"_28477":124012,"_3077":124055},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3626":74005,"_31300":73986,"_21660":124057,"_5":14907,"_28477":124012,"_3077":124058},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3626":74006,"_31300":73986,"_21660":124060,"_5":14907,"_28477":124012,"_3077":124061},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3626":74007,"_31300":74007,"_5":15267,"_3077":124063,"_31659":124064,"_21660":124065,"_28477":74007},"Estrategias de aprovisionamiento",[51072,122019,53756,123164,123342],[],{"_3626":74008,"_31300":74007,"_21660":124067,"_5":14907,"_28477":74007,"_3077":124068},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3626":74009,"_31300":74007,"_5":31656,"_21660":124070,"_28477":124071,"_3077":124072},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3626":74010,"_31300":74007,"_5":31656,"_21660":124074,"_28477":124075,"_3077":124076},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3626":74011,"_31300":74007,"_5":31656,"_21660":124078,"_28477":124079,"_3077":124080},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3626":74012,"_31300":74007,"_5":31656,"_21660":124082,"_28477":124083,"_3077":124084},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3626":74013,"_31300":74007,"_5":31656,"_21660":124086,"_28477":124087,"_3077":124088},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3626":74014,"_31300":74007,"_21660":124090,"_5":14907,"_28477":74007,"_3077":124091},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3626":74015,"_31300":74007,"_21660":124093,"_5":14907,"_28477":124071,"_3077":124094},[],"Recorrido",{"_3626":74016,"_31300":74007,"_21660":124096,"_5":14907,"_28477":124071,"_3077":124097},[],"Cuándo existe el dispositivo",{"_3626":74017,"_31300":74007,"_21660":124099,"_5":14907,"_28477":124071,"_3077":124100},[],"Qué compruebas",{"_3626":74018,"_31300":74007,"_21660":124102,"_5":14907,"_28477":124071,"_3077":124103},[],"Asignación manual",{"_3626":74019,"_31300":74007,"_21660":124105,"_5":14907,"_28477":124071,"_3077":124106},[],"El operador lo crea antes de asociar un certificado.",{"_3626":74020,"_31300":74007,"_21660":124108,"_5":14907,"_28477":124071,"_3077":124109},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3626":74021,"_31300":74007,"_21660":124111,"_5":14907,"_28477":124071,"_3077":124112},[],"EST con `JITP`",{"_3626":74022,"_31300":74007,"_21660":124114,"_5":14907,"_28477":124071,"_3077":124115},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3626":74023,"_31300":74007,"_21660":124117,"_5":14907,"_28477":124071,"_3077":124118},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3626":74024,"_31300":74007,"_21660":124120,"_5":14907,"_28477":124071,"_3077":124121},[],"EST con `PRE_REGISTRATION`",{"_3626":74025,"_31300":74007,"_21660":124123,"_5":14907,"_28477":124071,"_3077":124124},[],"Debe existir antes de `/simpleenroll`.",{"_3626":74026,"_31300":74007,"_21660":124126,"_5":14907,"_28477":124071,"_3077":124127},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3626":74027,"_31300":74007,"_21660":124129,"_5":14907,"_28477":124071,"_3077":124130},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3626":74028,"_31300":74007,"_21660":124132,"_5":14907,"_28477":124071,"_3077":124133},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3626":74029,"_31300":74007,"_21660":124135,"_5":14907,"_28477":124075,"_3077":124136},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3626":74030,"_31300":74007,"_21660":124138,"_5":14907,"_28477":124075,"_3077":124139},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3626":74031,"_31300":74007,"_21660":124141,"_5":14907,"_28477":124075,"_3077":124142},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3626":74032,"_31300":74007,"_21660":124144,"_5":14907,"_28477":124079,"_3077":124145},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3626":74033,"_31300":74007,"_21660":124147,"_5":14907,"_28477":124079,"_3077":124148},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3626":74034,"_31300":74007,"_21660":124150,"_5":14907,"_28477":124079,"_3077":124151},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3626":74035,"_31300":74007,"_21660":124153,"_5":14907,"_28477":124079,"_3077":124154},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3626":74036,"_31300":74007,"_21660":124156,"_5":14907,"_28477":124079,"_3077":124157},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3626":74037,"_31300":74007,"_21660":124159,"_5":14907,"_28477":124079,"_3077":124160},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3626":74038,"_31300":74007,"_21660":124162,"_5":14907,"_28477":124083,"_3077":120917},[],{"_3626":74039,"_31300":74007,"_21660":124164,"_5":14907,"_28477":124083,"_3077":124165},[],"Material que atraviesa EST",{"_3626":74040,"_31300":74007,"_21660":124167,"_5":14907,"_28477":124083,"_3077":124168},[],"Clave generada por el dispositivo",{"_3626":74041,"_31300":74007,"_21660":124170,"_5":14907,"_28477":124083,"_3077":124171},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3626":74042,"_31300":74007,"_21660":124173,"_5":14907,"_28477":124083,"_3077":124174},[],"Clave ya disponible en el dispositivo",{"_3626":74043,"_31300":74007,"_21660":124176,"_5":14907,"_28477":124083,"_3077":124177},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3626":74044,"_31300":74007,"_21660":124179,"_5":14907,"_28477":124083,"_3077":54087},[],{"_3626":74045,"_31300":74007,"_21660":124181,"_5":14907,"_28477":124083,"_3077":124182},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3626":74046,"_31300":74007,"_21660":124184,"_5":14907,"_28477":124083,"_3077":124185},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3626":74047,"_31300":74007,"_21660":124187,"_5":14907,"_28477":124087,"_3077":124188},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3626":74048,"_31300":74048,"_5":15267,"_3077":124190,"_31659":124191,"_21660":124192,"_28477":74048},"Renovación y recuperación",[51072,122019,53756,123164,123342],[],{"_3626":74049,"_31300":74048,"_21660":124194,"_5":14907,"_28477":74048,"_3077":124195},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3626":74050,"_31300":74048,"_5":31656,"_21660":124197,"_28477":124198,"_3077":124199},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3626":74051,"_31300":74048,"_5":31656,"_21660":124201,"_28477":124202,"_3077":124203},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3626":74052,"_31300":74048,"_5":31656,"_21660":124205,"_28477":124206,"_3077":124207},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3626":74053,"_31300":74048,"_5":31656,"_21660":124209,"_28477":124210,"_3077":124211},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3626":74054,"_31300":74048,"_5":31656,"_21660":124213,"_28477":124214,"_3077":124215},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3626":74055,"_31300":74048,"_21660":124217,"_5":14907,"_28477":74048,"_3077":124218},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3626":74056,"_31300":74048,"_21660":124220,"_5":14907,"_28477":124198,"_3077":124221},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3626":74057,"_31300":74048,"_21660":124223,"_5":14907,"_28477":124198,"_3077":124224},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3626":74058,"_31300":74048,"_21660":124226,"_5":14907,"_28477":124198,"_3077":124227},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3626":74059,"_31300":74048,"_21660":124229,"_5":14907,"_28477":124198,"_3077":124230},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3626":74060,"_31300":74048,"_21660":124232,"_5":14907,"_28477":124202,"_3077":124233},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3626":74061,"_31300":74048,"_21660":124235,"_5":14907,"_28477":124202,"_3077":124236},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3626":74062,"_31300":74048,"_21660":124238,"_5":14907,"_28477":124206,"_3077":124239},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3626":74063,"_31300":74048,"_21660":124241,"_5":14907,"_28477":124206,"_3077":124242},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3626":74064,"_31300":74048,"_21660":124244,"_5":14907,"_28477":124206,"_3077":124245},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3626":74065,"_31300":74048,"_21660":124247,"_5":14907,"_28477":124210,"_3077":124248},[],"Situación",{"_3626":74066,"_31300":74048,"_21660":124250,"_5":14907,"_28477":124210,"_3077":124251},[],"Procedimiento",{"_3626":74067,"_31300":74048,"_21660":124253,"_5":14907,"_28477":124210,"_3077":124254},[],"Certificado vigente, fuera de ventana",{"_3626":74068,"_31300":74048,"_21660":124256,"_5":14907,"_28477":124210,"_3077":124257},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3626":74069,"_31300":74048,"_21660":124259,"_5":14907,"_28477":124210,"_3077":124260},[],"Certificado vencido, clave disponible",{"_3626":74070,"_31300":74048,"_21660":124262,"_5":14907,"_28477":124210,"_3077":124263},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3626":74071,"_31300":74048,"_21660":124265,"_5":14907,"_28477":124210,"_3077":124266},[],"Renovación por webhook o `NO_AUTH`",{"_3626":74072,"_31300":74048,"_21660":124268,"_5":14907,"_28477":124210,"_3077":124269},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3626":74073,"_31300":74048,"_21660":124271,"_5":14907,"_28477":124210,"_3077":124272},[],"Clave perdida o inaccesible",{"_3626":74074,"_31300":74048,"_21660":124274,"_5":14907,"_28477":124210,"_3077":124275},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3626":74075,"_31300":74048,"_21660":124277,"_5":14907,"_28477":124210,"_3077":124278},[],"Identidad actual revocada",{"_3626":74076,"_31300":74048,"_21660":124280,"_5":14907,"_28477":124210,"_3077":124281},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3626":74077,"_31300":74048,"_21660":124283,"_5":14907,"_28477":124210,"_3077":124284},[],"Dispositivo sin identidad",{"_3626":74078,"_31300":74048,"_21660":124286,"_5":14907,"_28477":124210,"_3077":124287},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3626":74079,"_31300":74048,"_21660":124289,"_5":14907,"_28477":124210,"_3077":124290},[],"Dispositivo retirado",{"_3626":74080,"_31300":74048,"_21660":124292,"_5":14907,"_28477":124210,"_3077":124293},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3626":74081,"_31300":74048,"_21660":124295,"_5":14907,"_28477":124210,"_3077":124296},[],"Timeout, HTTP 500 o fallo de instalación",{"_3626":74082,"_31300":74048,"_21660":124298,"_5":14907,"_28477":124210,"_3077":124299},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3626":74083,"_31300":74048,"_21660":124301,"_5":14907,"_28477":124214,"_3077":124302},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3626":74084,"_31300":74048,"_21660":124304,"_5":14907,"_28477":124214,"_3077":124305},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3626":74085,"_31300":74085,"_5":15267,"_3077":124307,"_31659":124308,"_21660":124309,"_28477":74085},"Diagnóstico de enrolamiento",[51072,122019,53756,123164,123342],[],{"_3626":74086,"_31300":74085,"_21660":124311,"_5":14907,"_28477":74085,"_3077":124312},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3626":74087,"_31300":74085,"_5":31656,"_21660":124314,"_28477":124315,"_3077":124316},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3626":74088,"_31300":74085,"_5":31656,"_21660":124318,"_28477":124319,"_3077":124320},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3626":74089,"_31300":74085,"_5":31656,"_21660":124322,"_28477":124323,"_3077":123886},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3626":74090,"_31300":74085,"_5":31656,"_21660":124325,"_28477":124326,"_3077":124327},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3626":74091,"_31300":74085,"_21660":124329,"_5":14907,"_28477":74085,"_3077":124330},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3626":74092,"_31300":74085,"_21660":124332,"_5":14907,"_28477":124319,"_3077":124333},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3626":74093,"_31300":74085,"_21660":124335,"_5":14907,"_28477":124319,"_3077":124336},[],"Síntoma o mensaje",{"_3626":74094,"_31300":74085,"_21660":124338,"_5":14907,"_28477":124319,"_3077":124339},[],"Qué revisar",{"_3626":74095,"_31300":74085,"_21660":124341,"_5":14907,"_28477":124319,"_3077":124342},[],"curl rechaza TLS, nombre o emisor",{"_3626":74096,"_31300":74085,"_21660":124344,"_5":14907,"_28477":124319,"_3077":124345},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3626":74097,"_31300":74085,"_21660":124347,"_5":14907,"_28477":124319,"_3077":124348},[],"404 o APS ausente",{"_3626":74098,"_31300":74085,"_21660":124350,"_5":14907,"_28477":124319,"_3077":124351},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3626":74099,"_31300":74085,"_21660":124353,"_5":14907,"_28477":124319,"_3077":124354},[],"400, error de CSR o formato",{"_3626":74100,"_31300":74085,"_21660":124356,"_5":14907,"_28477":124319,"_3077":124357},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3626":74101,"_31300":74085,"_21660":124359,"_5":14907,"_28477":124319,"_3077":124360},[],"Credencial ausente o certificado no válido",{"_3626":74102,"_31300":74085,"_21660":124362,"_5":14907,"_28477":124319,"_3077":124363},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3626":74103,"_31300":74085,"_21660":124365,"_5":14907,"_28477":124319,"_3077":124366},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3626":74104,"_31300":74085,"_21660":124368,"_5":14907,"_28477":124319,"_3077":124369},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3626":74105,"_31300":74085,"_21660":124371,"_5":14907,"_28477":124319,"_3077":124372},[],"Webhook deniega, expira o responde sin autorización",{"_3626":74106,"_31300":74085,"_21660":124374,"_5":14907,"_28477":124319,"_3077":124375},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3626":74107,"_31300":74085,"_21660":124377,"_5":14907,"_28477":124319,"_3077":55015},[],{"_3626":74108,"_31300":74085,"_21660":124379,"_5":14907,"_28477":124319,"_3077":124380},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3626":74109,"_31300":74085,"_21660":124382,"_5":14907,"_28477":124319,"_3077":55021},[],{"_3626":74110,"_31300":74085,"_21660":124384,"_5":14907,"_28477":124319,"_3077":124385},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3626":74111,"_31300":74085,"_21660":124387,"_5":14907,"_28477":124319,"_3077":55027},[],{"_3626":74112,"_31300":74085,"_21660":124389,"_5":14907,"_28477":124319,"_3077":124390},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3626":74113,"_31300":74085,"_21660":124392,"_5":14907,"_28477":124319,"_3077":55033},[],{"_3626":74114,"_31300":74085,"_21660":124394,"_5":14907,"_28477":124319,"_3077":124395},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3626":74115,"_31300":74085,"_21660":124397,"_5":14907,"_28477":124319,"_3077":55039},[],{"_3626":74116,"_31300":74085,"_21660":124399,"_5":14907,"_28477":124319,"_3077":124400},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3626":74117,"_31300":74085,"_21660":124402,"_5":14907,"_28477":124319,"_3077":124403},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3626":74118,"_31300":74085,"_21660":124405,"_5":14907,"_28477":124319,"_3077":124406},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3626":74119,"_31300":74085,"_21660":124408,"_5":14907,"_28477":124319,"_3077":124409},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3626":74120,"_31300":74085,"_21660":124411,"_5":14907,"_28477":124319,"_3077":124412},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3626":74121,"_31300":74085,"_21660":124414,"_5":14907,"_28477":124319,"_3077":55057},[],{"_3626":74122,"_31300":74085,"_21660":124416,"_5":14907,"_28477":124319,"_3077":124417},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3626":74123,"_31300":74085,"_21660":124419,"_5":14907,"_28477":124319,"_3077":55063},[],{"_3626":74124,"_31300":74085,"_21660":124421,"_5":14907,"_28477":124319,"_3077":124422},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3626":74125,"_31300":74085,"_21660":124424,"_5":14907,"_28477":124319,"_3077":124425},[],"DMS propietario distinto",{"_3626":74126,"_31300":74085,"_21660":124427,"_5":14907,"_28477":124319,"_3077":124428},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3626":74127,"_31300":74085,"_21660":124430,"_5":14907,"_28477":124319,"_3077":55075},[],{"_3626":74128,"_31300":74085,"_21660":124432,"_5":14907,"_28477":124319,"_3077":124433},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3626":74129,"_31300":74085,"_21660":124435,"_5":14907,"_28477":124319,"_3077":55081},[],{"_3626":74130,"_31300":74085,"_21660":124437,"_5":14907,"_28477":124319,"_3077":124438},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3626":74131,"_31300":74085,"_21660":124440,"_5":14907,"_28477":124319,"_3077":124441},[],"Certificado actual revocado",{"_3626":74132,"_31300":74085,"_21660":124443,"_5":14907,"_28477":124319,"_3077":124444},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3626":74133,"_31300":74085,"_21660":124446,"_5":14907,"_28477":124319,"_3077":124447},[],"Error de CA, perfil o firma",{"_3626":74134,"_31300":74085,"_21660":124449,"_5":14907,"_28477":124319,"_3077":124450},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3626":74135,"_31300":74085,"_21660":124452,"_5":14907,"_28477":124319,"_3077":124453},[],"HTTP 200 sin conexión del dispositivo",{"_3626":74136,"_31300":74085,"_21660":124455,"_5":14907,"_28477":124319,"_3077":124456},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3626":74137,"_31300":74085,"_21660":124458,"_5":14907,"_28477":124319,"_3077":124459},[],"Timeout o error después de emitir",{"_3626":74138,"_31300":74085,"_21660":124461,"_5":14907,"_28477":124319,"_3077":124462},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3626":74139,"_31300":74085,"_21660":124464,"_5":14907,"_28477":124323,"_3077":124465},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3626":74140,"_31300":74085,"_21660":124467,"_5":14907,"_28477":124323,"_3077":124468},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3626":74141,"_31300":74085,"_21660":124470,"_5":14907,"_28477":124326,"_3077":124471},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3626":74142,"_31300":74085,"_21660":124473,"_5":14907,"_28477":124326,"_3077":124474},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3626":74143,"_31300":74085,"_21660":124476,"_5":14907,"_28477":124326,"_3077":124477},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3626":74144,"_31300":74085,"_21660":124479,"_5":14907,"_28477":124326,"_3077":124480},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3626":74145,"_31300":74085,"_21660":124482,"_5":14907,"_28477":124326,"_3077":124483},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3626":74146,"_31300":74085,"_21660":124485,"_5":14907,"_28477":124326,"_3077":124486},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3626":74147,"_31300":74085,"_21660":124488,"_5":14907,"_28477":124326,"_3077":124489},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3626":74148,"_31300":74148,"_5":15267,"_3077":124491,"_31659":124492,"_21660":124493,"_28477":74148},"Distribución y actualización de confianza",[51072,122019,53756,123164,123342],[],{"_3626":74149,"_31300":74148,"_21660":124495,"_5":14907,"_28477":74148,"_3077":124496},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3626":74150,"_31300":74148,"_5":31656,"_21660":124498,"_28477":124499,"_3077":124500},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3626":74151,"_31300":74148,"_5":31656,"_21660":124502,"_28477":124503,"_3077":124504},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3626":74152,"_31300":74148,"_5":31656,"_21660":124506,"_28477":124507,"_3077":124508},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3626":74153,"_31300":74148,"_5":31656,"_21660":124510,"_28477":124511,"_3077":124512},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3626":74154,"_31300":74148,"_5":31656,"_21660":124514,"_28477":124515,"_3077":124516},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3626":74155,"_31300":74148,"_21660":124518,"_5":14907,"_28477":74148,"_3077":124519},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3626":74156,"_31300":74148,"_21660":124521,"_5":14907,"_28477":124499,"_3077":124522},[],"Relación",{"_3626":74157,"_31300":74148,"_21660":124524,"_5":14907,"_28477":124499,"_3077":124525},[],"Material que prepara el responsable",{"_3626":74158,"_31300":74148,"_21660":124527,"_5":14907,"_28477":124499,"_3077":124528},[],"Dispositivo → servidor EST",{"_3626":74159,"_31300":74148,"_21660":124530,"_5":14907,"_28477":124499,"_3077":124531},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3626":74160,"_31300":74148,"_21660":124533,"_5":14907,"_28477":124499,"_3077":124534},[],"DMS → solicitante",{"_3626":74161,"_31300":74148,"_21660":124536,"_5":14907,"_28477":124499,"_3077":124537},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3626":74162,"_31300":74148,"_21660":124539,"_5":14907,"_28477":124499,"_3077":124540},[],"Consumidor → dispositivo",{"_3626":74163,"_31300":74148,"_21660":124542,"_5":14907,"_28477":124499,"_3077":124543},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3626":74164,"_31300":74148,"_21660":124545,"_5":14907,"_28477":124499,"_3077":124546},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3626":74165,"_31300":74148,"_21660":124548,"_5":14907,"_28477":124503,"_3077":124549},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3626":74166,"_31300":74148,"_21660":124551,"_5":14907,"_28477":124503,"_3077":124552},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3626":74167,"_31300":74148,"_21660":124554,"_5":14907,"_28477":124507,"_3077":124555},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3626":74168,"_31300":74148,"_21660":124557,"_5":14907,"_28477":124507,"_3077":124558},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3626":74169,"_31300":74148,"_21660":124560,"_5":14907,"_28477":124507,"_3077":124561},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3626":74170,"_31300":74148,"_21660":124563,"_5":14907,"_28477":124507,"_3077":124564},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3626":74171,"_31300":74148,"_21660":124566,"_5":14907,"_28477":124507,"_3077":124567},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3626":74172,"_31300":74148,"_21660":124569,"_5":14907,"_28477":124507,"_3077":124570},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3626":74173,"_31300":74148,"_21660":124572,"_5":14907,"_28477":124511,"_3077":124573},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3626":74174,"_31300":74148,"_21660":124575,"_5":14907,"_28477":124511,"_3077":124576},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3626":74175,"_31300":74148,"_21660":124578,"_5":14907,"_28477":124511,"_3077":124579},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3626":74176,"_31300":74148,"_21660":124581,"_5":14907,"_28477":124515,"_3077":124582},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3626":74177,"_31300":74177,"_5":15267,"_3077":55230,"_31659":124584,"_21660":124586,"_28477":74177},[51072,122019,53756,123164,124585],"Integraciones",[],{"_3626":74178,"_31300":74177,"_21660":124588,"_5":14907,"_28477":74177,"_3077":124589},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3626":74179,"_31300":74177,"_5":31656,"_21660":124591,"_28477":124592,"_3077":124593},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3626":74180,"_31300":74177,"_5":31656,"_21660":124595,"_28477":124596,"_3077":124597},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3626":74181,"_31300":74177,"_5":31656,"_21660":124599,"_28477":124600,"_3077":124601},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3626":74182,"_31300":74177,"_5":31656,"_21660":124603,"_28477":124604,"_3077":124605},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3626":74183,"_31300":74177,"_5":31656,"_21660":124607,"_28477":124608,"_3077":124609},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3626":74184,"_31300":74177,"_5":31656,"_21660":124611,"_28477":124612,"_3077":124613},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3626":74185,"_31300":74177,"_5":31656,"_21660":124615,"_28477":124616,"_3077":124617},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3626":74186,"_31300":74177,"_5":31656,"_21660":124619,"_28477":124620,"_3077":124621},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3626":74187,"_31300":74177,"_5":31656,"_21660":124623,"_28477":124624,"_3077":55272},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3626":74188,"_31300":74177,"_5":31656,"_21660":124626,"_28477":124627,"_3077":55276},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3626":74189,"_31300":74177,"_5":31656,"_21660":124629,"_28477":124630,"_3077":124631},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3626":74190,"_31300":74177,"_5":31656,"_21660":124633,"_28477":124634,"_3077":124635},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3626":74191,"_31300":74177,"_5":31656,"_21660":124637,"_28477":124638,"_3077":124639},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3626":74192,"_31300":74177,"_5":31656,"_21660":124641,"_28477":124642,"_3077":124643},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3626":74193,"_31300":74177,"_5":31656,"_21660":124645,"_28477":124646,"_3077":124647},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3626":74194,"_31300":74177,"_5":31656,"_21660":124649,"_28477":124650,"_3077":124651},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3626":74195,"_31300":74177,"_5":31656,"_21660":124653,"_28477":124654,"_3077":124655},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3626":74196,"_31300":74177,"_5":31656,"_21660":124657,"_28477":124658,"_3077":124659},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3626":74197,"_31300":74177,"_5":31656,"_21660":124661,"_28477":124662,"_3077":124663},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3626":74198,"_31300":74177,"_5":31656,"_21660":124665,"_28477":124666,"_3077":124667},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3626":74199,"_31300":74177,"_5":31656,"_21660":124669,"_28477":124670,"_3077":124671},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3626":74200,"_31300":74177,"_5":31656,"_21660":124673,"_28477":124674,"_3077":124675},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3626":74201,"_31300":74177,"_5":31656,"_21660":124677,"_28477":124678,"_3077":124679},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3626":74202,"_31300":74177,"_5":31656,"_21660":124681,"_28477":124682,"_3077":124683},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3626":74203,"_31300":74177,"_5":31656,"_21660":124685,"_28477":124686,"_3077":124687},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3626":74204,"_31300":74177,"_21660":124689,"_5":14907,"_28477":74177,"_3077":124690},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3626":74205,"_31300":74177,"_21660":124692,"_5":14907,"_28477":74177,"_3077":124693},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3626":74206,"_31300":74177,"_21660":124695,"_5":14907,"_28477":74177,"_3077":124696},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3626":74207,"_31300":74177,"_21660":124698,"_5":14907,"_28477":124592,"_3077":124699},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3626":74208,"_31300":74177,"_21660":124701,"_5":14907,"_28477":124592,"_3077":124702},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3626":74209,"_31300":74177,"_21660":124704,"_5":14907,"_28477":124592,"_3077":124705},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3626":74210,"_31300":74177,"_21660":124707,"_5":14907,"_28477":124592,"_3077":124708},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3626":74211,"_31300":74177,"_21660":124710,"_5":14907,"_28477":124596,"_3077":124711},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3626":74212,"_31300":74177,"_21660":124713,"_5":14907,"_28477":124600,"_3077":124714},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3626":74213,"_31300":74177,"_21660":124716,"_5":14907,"_28477":124600,"_3077":124717},[],"Acción IAM",{"_3626":74214,"_31300":74177,"_21660":124719,"_5":14907,"_28477":124600,"_3077":120923},[],{"_3626":74215,"_31300":74177,"_21660":124721,"_5":14907,"_28477":124600,"_3077":55371},[],{"_3626":74216,"_31300":74177,"_21660":124723,"_5":14907,"_28477":124600,"_3077":124724},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3626":74217,"_31300":74177,"_21660":124726,"_5":14907,"_28477":124600,"_3077":55377},[],{"_3626":74218,"_31300":74177,"_21660":124728,"_5":14907,"_28477":124600,"_3077":124729},[],"Registrar la CA en AWS IoT",{"_3626":74219,"_31300":74177,"_21660":124731,"_5":14907,"_28477":124600,"_3077":55383},[],{"_3626":74220,"_31300":74177,"_21660":124733,"_5":14907,"_28477":124600,"_3077":124734},[],"Consultar el estado del registro de la CA",{"_3626":74221,"_31300":74177,"_21660":124736,"_5":14907,"_28477":124600,"_3077":55389},[],{"_3626":74222,"_31300":74177,"_21660":124738,"_5":14907,"_28477":124600,"_3077":124739},[],"Crear o actualizar Things en IoT Core",{"_3626":74223,"_31300":74177,"_21660":124741,"_5":14907,"_28477":124600,"_3077":55395},[],{"_3626":74224,"_31300":74177,"_21660":124743,"_5":14907,"_28477":124600,"_3077":124744},[],"Aprovisionar Things mediante plantilla",{"_3626":74225,"_31300":74177,"_21660":124746,"_5":14907,"_28477":124600,"_3077":55401},[],{"_3626":74226,"_31300":74177,"_21660":124748,"_5":14907,"_28477":124600,"_3077":124749},[],"Registrar certificados de dispositivo",{"_3626":74227,"_31300":74177,"_21660":124751,"_5":14907,"_28477":124600,"_3077":55407},[],{"_3626":74228,"_31300":74177,"_21660":124753,"_5":14907,"_28477":124600,"_3077":124754},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3626":74229,"_31300":74177,"_21660":124756,"_5":14907,"_28477":124600,"_3077":55413},[],{"_3626":74230,"_31300":74177,"_21660":124758,"_5":14907,"_28477":124600,"_3077":124759},[],"Crear y adjuntar políticas IoT",{"_3626":74231,"_31300":74177,"_21660":124761,"_5":14907,"_28477":124600,"_3077":55419},[],{"_3626":74232,"_31300":74177,"_21660":124763,"_5":14907,"_28477":124600,"_3077":124764},[],"Gestionar grupos de Things",{"_3626":74233,"_31300":74177,"_21660":124766,"_5":14907,"_28477":124600,"_3077":55425},[],{"_3626":74234,"_31300":74177,"_21660":124768,"_5":14907,"_28477":124600,"_3077":124769},[],"Crear plantillas JITP",{"_3626":74235,"_31300":74177,"_21660":124771,"_5":14907,"_28477":124600,"_3077":55431},[],{"_3626":74236,"_31300":74177,"_21660":124773,"_5":14907,"_28477":124600,"_3077":124774},[],"Leer y escribir el Device Shadow",{"_3626":74237,"_31300":74177,"_21660":124776,"_5":14907,"_28477":124600,"_3077":124777},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3626":74238,"_31300":74177,"_21660":124779,"_5":14907,"_28477":124604,"_3077":124780},[],"Parámetro",{"_3626":74239,"_31300":74177,"_21660":124782,"_5":14907,"_28477":124604,"_3077":124783},[],"Tipo",{"_3626":74240,"_31300":74177,"_21660":124785,"_5":14907,"_28477":124604,"_3077":124786},[],"Requerido",{"_3626":74241,"_31300":74177,"_21660":124788,"_5":14907,"_28477":124604,"_3077":124789},[],"Descripción",{"_3626":74242,"_31300":74177,"_21660":124791,"_5":14907,"_28477":124604,"_3077":55452},[],{"_3626":74243,"_31300":74177,"_21660":124793,"_5":14907,"_28477":124604,"_3077":25875},[],{"_3626":74244,"_31300":74177,"_21660":124795,"_5":14907,"_28477":124604,"_3077":124796},[],"Sí",{"_3626":74245,"_31300":74177,"_21660":124798,"_5":14907,"_28477":124604,"_3077":124799},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3626":74246,"_31300":74177,"_21660":124801,"_5":14907,"_28477":124604,"_3077":55463},[],{"_3626":74247,"_31300":74177,"_21660":124803,"_5":14907,"_28477":124604,"_3077":25875},[],{"_3626":74248,"_31300":74177,"_21660":124805,"_5":14907,"_28477":124604,"_3077":124796},[],{"_3626":74249,"_31300":74177,"_21660":124807,"_5":14907,"_28477":124604,"_3077":124808},[],"Región AWS donde opera el conector.",{"_3626":74250,"_31300":74177,"_21660":124810,"_5":14907,"_28477":124604,"_3077":55473},[],{"_3626":74251,"_31300":74177,"_21660":124812,"_5":14907,"_28477":124604,"_3077":25875},[],{"_3626":74252,"_31300":74177,"_21660":124814,"_5":14907,"_28477":124604,"_3077":124796},[],{"_3626":74253,"_31300":74177,"_21660":124816,"_5":14907,"_28477":124604,"_3077":124817},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3626":74254,"_31300":74177,"_21660":124819,"_5":14907,"_28477":124604,"_3077":55483},[],{"_3626":74255,"_31300":74177,"_21660":124821,"_5":14907,"_28477":124604,"_3077":25875},[],{"_3626":74256,"_31300":74177,"_21660":124823,"_5":14907,"_28477":124604,"_3077":124824},[],"Solo con `auth_method=static`",{"_3626":74257,"_31300":74177,"_21660":124826,"_5":14907,"_28477":124604,"_3077":124827},[],"Clave de acceso AWS.",{"_3626":74258,"_31300":74177,"_21660":124829,"_5":14907,"_28477":124604,"_3077":55494},[],{"_3626":74259,"_31300":74177,"_21660":124831,"_5":14907,"_28477":124604,"_3077":25875},[],{"_3626":74260,"_31300":74177,"_21660":124833,"_5":14907,"_28477":124604,"_3077":124824},[],{"_3626":74261,"_31300":74177,"_21660":124835,"_5":14907,"_28477":124604,"_3077":124836},[],"Clave secreta AWS.",{"_3626":74262,"_31300":74177,"_21660":124838,"_5":14907,"_28477":124604,"_3077":55504},[],{"_3626":74263,"_31300":74177,"_21660":124840,"_5":14907,"_28477":124604,"_3077":25875},[],{"_3626":74264,"_31300":74177,"_21660":124842,"_5":14907,"_28477":124604,"_3077":55509},[],{"_3626":74265,"_31300":74177,"_21660":124844,"_5":14907,"_28477":124604,"_3077":124845},[],"Token de sesión (con `auth_method=static`).",{"_3626":74266,"_31300":74177,"_21660":124847,"_5":14907,"_28477":124604,"_3077":55515},[],{"_3626":74267,"_31300":74177,"_21660":124849,"_5":14907,"_28477":124604,"_3077":25875},[],{"_3626":74268,"_31300":74177,"_21660":124851,"_5":14907,"_28477":124604,"_3077":124852},[],"Solo con `auth_method=role`",{"_3626":74269,"_31300":74177,"_21660":124854,"_5":14907,"_28477":124604,"_3077":124855},[],"ARN del rol a asumir.",{"_3626":74270,"_31300":74177,"_21660":124857,"_5":14907,"_28477":124604,"_3077":55526},[],{"_3626":74271,"_31300":74177,"_21660":124859,"_5":14907,"_28477":124604,"_3077":25875},[],{"_3626":74272,"_31300":74177,"_21660":124861,"_5":14907,"_28477":124604,"_3077":55509},[],{"_3626":74273,"_31300":74177,"_21660":124863,"_5":14907,"_28477":124604,"_3077":124864},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3626":74274,"_31300":74177,"_21660":124866,"_5":14907,"_28477":124604,"_3077":55536},[],{"_3626":74275,"_31300":74177,"_21660":124868,"_5":14907,"_28477":124604,"_3077":93074},[],{"_3626":74276,"_31300":74177,"_21660":124870,"_5":14907,"_28477":124604,"_3077":124796},[],{"_3626":74277,"_31300":74177,"_21660":124872,"_5":14907,"_28477":124604,"_3077":124873},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3626":74278,"_31300":74177,"_21660":124875,"_5":14907,"_28477":124604,"_3077":55546},[],{"_3626":74279,"_31300":74177,"_21660":124877,"_5":14907,"_28477":124604,"_3077":25875},[],{"_3626":74280,"_31300":74177,"_21660":124879,"_5":14907,"_28477":124604,"_3077":124796},[],{"_3626":74281,"_31300":74177,"_21660":124881,"_5":14907,"_28477":124604,"_3077":124882},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3626":74282,"_31300":74177,"_21660":124884,"_5":14907,"_28477":124604,"_3077":55556},[],{"_3626":74283,"_31300":74177,"_21660":124886,"_5":14907,"_28477":124604,"_3077":25875},[],{"_3626":74284,"_31300":74177,"_21660":124888,"_5":14907,"_28477":124604,"_3077":124796},[],{"_3626":74285,"_31300":74177,"_21660":124890,"_5":14907,"_28477":124604,"_3077":124891},[],"URL HTTP del Device Manager de Lamassu.",{"_3626":74286,"_31300":74177,"_21660":124893,"_5":14907,"_28477":124604,"_3077":55566},[],{"_3626":74287,"_31300":74177,"_21660":124895,"_5":14907,"_28477":124604,"_3077":25875},[],{"_3626":74288,"_31300":74177,"_21660":124897,"_5":14907,"_28477":124604,"_3077":124796},[],{"_3626":74289,"_31300":74177,"_21660":124899,"_5":14907,"_28477":124604,"_3077":124900},[],"URL HTTP del servicio de CA de Lamassu.",{"_3626":74290,"_31300":74177,"_21660":124902,"_5":14907,"_28477":124608,"_3077":124903},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3626":74291,"_31300":74177,"_21660":124905,"_5":14907,"_28477":124608,"_3077":124906},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3626":74292,"_31300":74177,"_21660":124908,"_5":14907,"_28477":124608,"_3077":124909},[],"Tipo de CloudEvent",{"_3626":74293,"_31300":74177,"_21660":124911,"_5":14907,"_28477":124608,"_3077":124912},[],"Recurso en Lamassu",{"_3626":74294,"_31300":74177,"_21660":124914,"_5":14907,"_28477":124608,"_3077":124915},[],"Recurso AWS",{"_3626":74295,"_31300":74177,"_21660":124917,"_5":14907,"_28477":124608,"_3077":124918},[],"Acciones IAM",{"_3626":74296,"_31300":74177,"_21660":124920,"_5":14907,"_28477":124608,"_3077":124921},[],"Llamadas AWS y efecto",{"_3626":74297,"_31300":74177,"_21660":124923,"_5":14907,"_28477":124608,"_3077":124924},[],"Dónde en esta página",{"_3626":74298,"_31300":74177,"_21660":124926,"_5":14907,"_28477":124608,"_3077":55600},[],{"_3626":74299,"_31300":74177,"_21660":124928,"_5":14907,"_28477":124608,"_3077":55603},[],{"_3626":74300,"_31300":74177,"_21660":124930,"_5":14907,"_28477":124608,"_3077":55606},[],{"_3626":74301,"_31300":74177,"_21660":124932,"_5":14907,"_28477":124608,"_3077":55609},[],{"_3626":74302,"_31300":74177,"_21660":124934,"_5":14907,"_28477":124608,"_3077":124935},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3626":74303,"_31300":74177,"_21660":124937,"_5":14907,"_28477":124608,"_3077":124621},[],{"_3626":74304,"_31300":74177,"_21660":124939,"_5":14907,"_28477":124608,"_3077":55617},[],{"_3626":74305,"_31300":74177,"_21660":124941,"_5":14907,"_28477":124608,"_3077":55620},[],{"_3626":74306,"_31300":74177,"_21660":124943,"_5":14907,"_28477":124608,"_3077":55623},[],{"_3626":74307,"_31300":74177,"_21660":124945,"_5":14907,"_28477":124608,"_3077":55626},[],{"_3626":74308,"_31300":74177,"_21660":124947,"_5":14907,"_28477":124608,"_3077":124948},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3626":74309,"_31300":74177,"_21660":124950,"_5":14907,"_28477":124608,"_3077":124647},[],{"_3626":74310,"_31300":74177,"_21660":124952,"_5":14907,"_28477":124608,"_3077":55634},[],{"_3626":74311,"_31300":74177,"_21660":124954,"_5":14907,"_28477":124608,"_3077":124955},[],"Dispositivo",{"_3626":74312,"_31300":74177,"_21660":124957,"_5":14907,"_28477":124608,"_3077":55640},[],{"_3626":74313,"_31300":74177,"_21660":124959,"_5":14907,"_28477":124608,"_3077":55643},[],{"_3626":74314,"_31300":74177,"_21660":124961,"_5":14907,"_28477":124608,"_3077":124962},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3626":74315,"_31300":74177,"_21660":124964,"_5":14907,"_28477":124608,"_3077":124655},[],{"_3626":74316,"_31300":74177,"_21660":124966,"_5":14907,"_28477":124608,"_3077":55651},[],{"_3626":74317,"_31300":74177,"_21660":124968,"_5":14907,"_28477":124608,"_3077":124969},[],"Certificado",{"_3626":74318,"_31300":74177,"_21660":124971,"_5":14907,"_28477":124608,"_3077":55657},[],{"_3626":74319,"_31300":74177,"_21660":124973,"_5":14907,"_28477":124608,"_3077":124974},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3626":74320,"_31300":74177,"_21660":124976,"_5":14907,"_28477":124608,"_3077":124977},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3626":74321,"_31300":74177,"_21660":124979,"_5":14907,"_28477":124608,"_3077":124667},[],{"_3626":74322,"_31300":74177,"_21660":124981,"_5":14907,"_28477":124608,"_3077":55668},[],{"_3626":74323,"_31300":74177,"_21660":124983,"_5":14907,"_28477":124608,"_3077":124984},[],"Certificado / Dispositivo",{"_3626":74324,"_31300":74177,"_21660":124986,"_5":14907,"_28477":124608,"_3077":55674},[],{"_3626":74325,"_31300":74177,"_21660":124988,"_5":14907,"_28477":124608,"_3077":51468},[],{"_3626":74326,"_31300":74177,"_21660":124990,"_5":14907,"_28477":124608,"_3077":124991},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3626":74327,"_31300":74177,"_21660":124993,"_5":14907,"_28477":124608,"_3077":124675},[],{"_3626":74328,"_31300":74177,"_21660":124995,"_5":14907,"_28477":124612,"_3077":124996},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3626":74329,"_31300":74177,"_21660":124998,"_5":14907,"_28477":124616,"_3077":124999},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3626":74330,"_31300":74177,"_21660":125001,"_5":14907,"_28477":124616,"_3077":125002},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3626":74331,"_31300":74177,"_21660":125004,"_5":14907,"_28477":124620,"_3077":125005},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3626":74332,"_31300":74177,"_21660":125007,"_5":14907,"_28477":124620,"_3077":125008},[],"Transición",{"_3626":74333,"_31300":74177,"_21660":125010,"_5":14907,"_28477":124620,"_3077":125011},[],"Llamadas AWS",{"_3626":74334,"_31300":74177,"_21660":125013,"_5":14907,"_28477":124620,"_3077":125014},[],"`NoRegistrada` → `Solicitada`",{"_3626":74335,"_31300":74177,"_21660":125016,"_5":14907,"_28477":124620,"_3077":125017},[],"ninguna (solo escritura de metadatos)",{"_3626":74336,"_31300":74177,"_21660":125019,"_5":14907,"_28477":124620,"_3077":125020},[],"`Solicitada` → `Registrando`",{"_3626":74337,"_31300":74177,"_21660":125022,"_5":14907,"_28477":124620,"_3077":125023},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3626":74338,"_31300":74177,"_21660":125025,"_5":14907,"_28477":124620,"_3077":125026},[],"`Registrando` → `Completada`",{"_3626":74339,"_31300":74177,"_21660":125028,"_5":14907,"_28477":124620,"_3077":125029},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3626":74340,"_31300":74177,"_21660":125031,"_5":14907,"_28477":124620,"_3077":125032},[],"`Registrando` → `Fallida`",{"_3626":74341,"_31300":74177,"_21660":125034,"_5":14907,"_28477":124620,"_3077":125035},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3626":74342,"_31300":74177,"_21660":125037,"_5":14907,"_28477":124620,"_3077":125038},[],"`Fallida` / `Completada` → `Solicitada`",{"_3626":74343,"_31300":74177,"_21660":125040,"_5":14907,"_28477":124620,"_3077":125041},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3626":74344,"_31300":74177,"_21660":125043,"_5":14907,"_28477":124624,"_3077":125044},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3626":74345,"_31300":74177,"_21660":125046,"_5":14907,"_28477":124624,"_3077":125047},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3626":74346,"_31300":74177,"_21660":125049,"_5":14907,"_28477":124624,"_3077":125050},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3626":74347,"_31300":74177,"_21660":125052,"_5":14907,"_28477":124624,"_3077":125053},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3626":74348,"_31300":74177,"_21660":125055,"_5":14907,"_28477":124624,"_3077":125056},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3626":74349,"_31300":74177,"_21660":125058,"_5":14907,"_28477":124624,"_3077":125059},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3626":74350,"_31300":74177,"_21660":125061,"_5":14907,"_28477":124627,"_3077":125062},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3626":74351,"_31300":74177,"_21660":125064,"_5":14907,"_28477":124630,"_3077":125065},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3626":74352,"_31300":74177,"_21660":125067,"_5":14907,"_28477":124630,"_3077":125068},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3626":74353,"_31300":74177,"_21660":125070,"_5":14907,"_28477":124634,"_3077":125071},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3626":74354,"_31300":74177,"_21660":125073,"_5":14907,"_28477":124638,"_3077":125074},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3626":74355,"_31300":74177,"_21660":125076,"_5":14907,"_28477":124638,"_3077":125077},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3626":74356,"_31300":74177,"_21660":125079,"_5":14907,"_28477":124638,"_3077":125080},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3626":74357,"_31300":74177,"_21660":125082,"_5":14907,"_28477":124638,"_3077":125083},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3626":74358,"_31300":74177,"_21660":125085,"_5":14907,"_28477":124638,"_3077":125086},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3626":74359,"_31300":74177,"_21660":125088,"_5":14907,"_28477":124638,"_3077":125089},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3626":74360,"_31300":74177,"_21660":125091,"_5":14907,"_28477":124642,"_3077":125092},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3626":74361,"_31300":74177,"_21660":125094,"_5":14907,"_28477":124642,"_3077":125095},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3626":74362,"_31300":74177,"_21660":125097,"_5":14907,"_28477":124642,"_3077":125098},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3626":74363,"_31300":74177,"_21660":125100,"_5":14907,"_28477":124642,"_3077":125101},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3626":74364,"_31300":74177,"_21660":125103,"_5":14907,"_28477":124642,"_3077":125104},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3626":74365,"_31300":74177,"_21660":125106,"_5":14907,"_28477":124646,"_3077":125107},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3626":74366,"_31300":74177,"_21660":125109,"_5":14907,"_28477":124646,"_3077":125008},[],{"_3626":74367,"_31300":74177,"_21660":125111,"_5":14907,"_28477":124646,"_3077":125011},[],{"_3626":74368,"_31300":74177,"_21660":125113,"_5":14907,"_28477":124646,"_3077":125114},[],"`SinConfigurar` → `None` / `Auto`",{"_3626":74369,"_31300":74177,"_21660":125116,"_5":14907,"_28477":124646,"_3077":125117},[],"ninguna (solo configuración)",{"_3626":74370,"_31300":74177,"_21660":125119,"_5":14907,"_28477":124646,"_3077":55811},[],{"_3626":74371,"_31300":74177,"_21660":125121,"_5":14907,"_28477":124646,"_3077":125117},[],{"_3626":74372,"_31300":74177,"_21660":125123,"_5":14907,"_28477":124646,"_3077":125124},[],"Cualquiera → `Jitp`",{"_3626":74373,"_31300":74177,"_21660":125126,"_5":14907,"_28477":124646,"_3077":125127},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3626":74374,"_31300":74177,"_21660":125129,"_5":14907,"_28477":124646,"_3077":55822},[],{"_3626":74375,"_31300":74177,"_21660":125131,"_5":14907,"_28477":124646,"_3077":125132},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3626":74376,"_31300":74177,"_21660":125134,"_5":14907,"_28477":124650,"_3077":125135},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3626":74377,"_31300":74177,"_21660":125137,"_5":14907,"_28477":124650,"_3077":125138},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3626":74378,"_31300":74177,"_21660":125140,"_5":14907,"_28477":124650,"_3077":125141},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3626":74379,"_31300":74177,"_21660":125143,"_5":14907,"_28477":124654,"_3077":125144},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3626":74380,"_31300":74177,"_21660":125146,"_5":14907,"_28477":124654,"_3077":125008},[],{"_3626":74381,"_31300":74177,"_21660":125148,"_5":14907,"_28477":124654,"_3077":125011},[],{"_3626":74382,"_31300":74177,"_21660":125150,"_5":14907,"_28477":124654,"_3077":125151},[],"`Ausente` → `Aprovisionado`",{"_3626":74383,"_31300":74177,"_21660":125153,"_5":14907,"_28477":124654,"_3077":125154},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3626":74384,"_31300":74177,"_21660":125156,"_5":14907,"_28477":124654,"_3077":125157},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3626":74385,"_31300":74177,"_21660":125159,"_5":14907,"_28477":124654,"_3077":125160},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3626":74386,"_31300":74177,"_21660":125162,"_5":14907,"_28477":124654,"_3077":125163},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3626":74387,"_31300":74177,"_21660":125165,"_5":14907,"_28477":124658,"_3077":125166},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3626":74388,"_31300":74177,"_21660":125168,"_5":14907,"_28477":124658,"_3077":125169},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3626":74389,"_31300":74177,"_21660":125171,"_5":14907,"_28477":124658,"_3077":125172},[],"Para que el flujo JITP funcione correctamente:",{"_3626":74390,"_31300":74177,"_21660":125174,"_5":14907,"_28477":124658,"_3077":125175},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3626":74391,"_31300":74177,"_21660":125177,"_5":14907,"_28477":124658,"_3077":125178},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3626":74392,"_31300":74177,"_21660":125180,"_5":14907,"_28477":124658,"_3077":125181},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3626":74393,"_31300":74177,"_21660":125183,"_5":14907,"_28477":124658,"_3077":125184},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3626":74394,"_31300":74177,"_21660":125186,"_5":14907,"_28477":124662,"_3077":125187},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3626":74395,"_31300":74177,"_21660":125189,"_5":14907,"_28477":124662,"_3077":125190},[],"Estado en Lamassu",{"_3626":74396,"_31300":74177,"_21660":125192,"_5":14907,"_28477":124662,"_3077":125193},[],"Razón de revocación",{"_3626":74397,"_31300":74177,"_21660":125195,"_5":14907,"_28477":124662,"_3077":125196},[],"Estado en AWS IoT Core",{"_3626":74398,"_31300":74177,"_21660":125198,"_5":14907,"_28477":124662,"_3077":55892},[],{"_3626":74399,"_31300":74177,"_21660":125200,"_5":14907,"_28477":124662,"_3077":125201},[],"Ninguna",{"_3626":74400,"_31300":74177,"_21660":125203,"_5":14907,"_28477":124662,"_3077":55898},[],{"_3626":74401,"_31300":74177,"_21660":125205,"_5":14907,"_28477":124662,"_3077":55901},[],{"_3626":74402,"_31300":74177,"_21660":125207,"_5":14907,"_28477":124662,"_3077":55904},[],{"_3626":74403,"_31300":74177,"_21660":125209,"_5":14907,"_28477":124662,"_3077":55907},[],{"_3626":74404,"_31300":74177,"_21660":125211,"_5":14907,"_28477":124662,"_3077":55901},[],{"_3626":74405,"_31300":74177,"_21660":125213,"_5":14907,"_28477":124662,"_3077":125214},[],"Cualquier otra razón",{"_3626":74406,"_31300":74177,"_21660":125216,"_5":14907,"_28477":124662,"_3077":55915},[],{"_3626":74407,"_31300":74177,"_21660":125218,"_5":14907,"_28477":124662,"_3077":125219},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3626":74408,"_31300":74177,"_21660":125221,"_5":14907,"_28477":124666,"_3077":125222},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3626":74409,"_31300":74177,"_21660":125224,"_5":14907,"_28477":124666,"_3077":125008},[],{"_3626":74410,"_31300":74177,"_21660":125226,"_5":14907,"_28477":124666,"_3077":125011},[],{"_3626":74411,"_31300":74177,"_21660":125228,"_5":14907,"_28477":124666,"_3077":125229},[],"`NoSincronizado` → `Active`",{"_3626":74412,"_31300":74177,"_21660":125231,"_5":14907,"_28477":124666,"_3077":55407},[],{"_3626":74413,"_31300":74177,"_21660":125233,"_5":14907,"_28477":124666,"_3077":55933},[],{"_3626":74414,"_31300":74177,"_21660":125235,"_5":14907,"_28477":124666,"_3077":125236},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3626":74415,"_31300":74177,"_21660":125238,"_5":14907,"_28477":124666,"_3077":55939},[],{"_3626":74416,"_31300":74177,"_21660":125240,"_5":14907,"_28477":124666,"_3077":125236},[],{"_3626":74417,"_31300":74177,"_21660":125242,"_5":14907,"_28477":124666,"_3077":55944},[],{"_3626":74418,"_31300":74177,"_21660":125244,"_5":14907,"_28477":124666,"_3077":55407},[],{"_3626":74419,"_31300":74177,"_21660":125246,"_5":14907,"_28477":124666,"_3077":55949},[],{"_3626":74420,"_31300":74177,"_21660":125248,"_5":14907,"_28477":124666,"_3077":125249},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3626":74421,"_31300":74177,"_21660":125251,"_5":14907,"_28477":124670,"_3077":125252},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3626":74422,"_31300":74177,"_21660":125254,"_5":14907,"_28477":124670,"_3077":125255},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3626":74423,"_31300":74177,"_21660":125257,"_5":14907,"_28477":124670,"_3077":125258},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3626":74424,"_31300":74177,"_21660":125260,"_5":14907,"_28477":124674,"_3077":125261},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3626":74425,"_31300":74177,"_21660":125263,"_5":14907,"_28477":124674,"_3077":125264},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3626":74426,"_31300":74177,"_21660":125266,"_5":14907,"_28477":124678,"_3077":125267},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3626":74427,"_31300":74177,"_21660":125269,"_5":14907,"_28477":124678,"_3077":125270},[],"Existen dos tipos de acciones:",{"_3626":74428,"_31300":74177,"_21660":125272,"_5":14907,"_28477":124678,"_3077":125273},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3626":74429,"_31300":74177,"_21660":125275,"_5":14907,"_28477":124678,"_3077":125276},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3626":74430,"_31300":74177,"_21660":125278,"_5":14907,"_28477":124678,"_3077":125279},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3626":74431,"_31300":74177,"_21660":125281,"_5":14907,"_28477":124682,"_3077":125282},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3626":74432,"_31300":74177,"_21660":125284,"_5":14907,"_28477":124682,"_3077":125285},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3626":74433,"_31300":74177,"_21660":125287,"_5":14907,"_28477":124682,"_3077":125288},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3626":74434,"_31300":74177,"_21660":125290,"_5":14907,"_28477":124686,"_3077":125291},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3626":74435,"_31300":74177,"_21660":125293,"_5":14907,"_28477":124686,"_3077":125294},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3626":74436,"_31300":74177,"_21660":125296,"_5":14907,"_28477":124686,"_3077":125297},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3626":74437,"_31300":74177,"_21660":125299,"_5":14907,"_28477":124686,"_3077":125300},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3626":74438,"_31300":74177,"_21660":125302,"_5":14907,"_28477":124686,"_3077":125303},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3626":74439,"_31300":74177,"_21660":125305,"_5":14907,"_28477":124686,"_3077":125306},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3626":74440,"_31300":74177,"_21660":125308,"_5":14907,"_28477":124686,"_3077":125309},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3626":74441,"_31300":74177,"_21660":125311,"_5":14907,"_28477":124686,"_3077":125312},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3626":74442,"_31300":74177,"_21660":125314,"_5":14907,"_28477":124686,"_3077":125315},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3626":74443,"_31300":74177,"_21660":125317,"_5":14907,"_28477":124686,"_3077":125318},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3626":74444,"_31300":74177,"_21660":125320,"_5":14907,"_28477":124686,"_3077":125321},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3626":74445,"_31300":74177,"_21660":125323,"_5":14907,"_28477":124686,"_3077":125324},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3626":74446,"_31300":74177,"_21660":125326,"_5":14907,"_28477":124686,"_3077":125327},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3626":74447,"_31300":74177,"_21660":125329,"_5":14907,"_28477":124686,"_3077":125330},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3626":74448,"_31300":74177,"_21660":125332,"_5":14907,"_28477":124686,"_3077":125333},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3626":74449,"_31300":74177,"_21660":125335,"_5":14907,"_28477":124686,"_3077":125336},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3626":74450,"_31300":74177,"_21660":125338,"_5":14907,"_28477":124686,"_3077":125339},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3626":74451,"_31300":74177,"_21660":125341,"_5":14907,"_28477":124686,"_3077":125342},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3626":74452,"_31300":74177,"_21660":125344,"_5":14907,"_28477":124686,"_3077":125345},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3626":74453,"_31300":74177,"_21660":125347,"_5":14907,"_28477":124686,"_3077":125348},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3626":74454,"_31300":74177,"_21660":125350,"_5":14907,"_28477":124686,"_3077":125351},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3626":74455,"_31300":74177,"_21660":125353,"_5":14907,"_28477":124686,"_3077":125354},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3626":74456,"_31300":74177,"_21660":125356,"_5":14907,"_28477":124686,"_3077":125357},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3626":74457,"_31300":74177,"_21660":125359,"_5":14907,"_28477":124686,"_3077":125360},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3626":74458,"_31300":74458,"_5":15267,"_3077":53756,"_31659":125362,"_21660":125363,"_28477":74458},[51072,122019,53756],[],{"_3626":74459,"_31300":74458,"_21660":125365,"_5":14907,"_28477":74458,"_3077":125366},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3626":74460,"_31300":74458,"_5":31656,"_21660":125368,"_28477":125369,"_3077":125370},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3626":74461,"_31300":74458,"_5":31656,"_21660":125372,"_28477":125373,"_3077":123164},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3626":74462,"_31300":74458,"_5":31656,"_21660":125375,"_28477":125376,"_3077":123342},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3626":74463,"_31300":74458,"_5":31656,"_21660":125378,"_28477":125379,"_3077":124585},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#integraciones",{"_3626":74464,"_31300":74458,"_5":31656,"_21660":125381,"_28477":125382,"_3077":125383},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3626":74465,"_31300":74458,"_21660":125385,"_5":14907,"_28477":74458,"_3077":125386},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3626":74466,"_31300":74458,"_21660":125388,"_5":14907,"_28477":125369,"_3077":125389},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3626":74467,"_31300":74458,"_21660":125391,"_5":14907,"_28477":125369,"_3077":125392},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3626":74468,"_31300":74458,"_21660":125394,"_5":14907,"_28477":125373,"_3077":125395},[],"Recurso",{"_3626":74469,"_31300":74458,"_21660":125397,"_5":14907,"_28477":125373,"_3077":125398},[],"Qué representa",{"_3626":74470,"_31300":74458,"_21660":125400,"_5":14907,"_28477":125373,"_3077":125401},[],"**Dispositivo**",{"_3626":74471,"_31300":74458,"_21660":125403,"_5":14907,"_28477":125373,"_3077":125404},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3626":74472,"_31300":74458,"_21660":125406,"_5":14907,"_28477":125373,"_3077":125407},[],"**Identidad**",{"_3626":74473,"_31300":74458,"_21660":125409,"_5":14907,"_28477":125373,"_3077":125410},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3626":74474,"_31300":74458,"_21660":125412,"_5":14907,"_28477":125373,"_3077":56116},[],{"_3626":74475,"_31300":74458,"_21660":125414,"_5":14907,"_28477":125373,"_3077":125415},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3626":74476,"_31300":74458,"_21660":125417,"_5":14907,"_28477":125373,"_3077":125418},[],"**Flota**",{"_3626":74477,"_31300":74458,"_21660":125420,"_5":14907,"_28477":125373,"_3077":125421},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3626":74478,"_31300":74458,"_21660":125423,"_5":14907,"_28477":125373,"_3077":125424},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3626":74479,"_31300":74458,"_21660":125426,"_5":14907,"_28477":125373,"_3077":125427},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3626":74480,"_31300":74458,"_21660":125429,"_5":14907,"_28477":125376,"_3077":125430},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3626":74481,"_31300":74458,"_21660":125432,"_5":14907,"_28477":125376,"_3077":125433},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3626":74482,"_31300":74458,"_21660":125435,"_5":14907,"_28477":125376,"_3077":125436},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3626":74483,"_31300":74458,"_21660":125438,"_5":14907,"_28477":125376,"_3077":125439},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3626":74484,"_31300":74458,"_21660":125441,"_5":14907,"_28477":125376,"_3077":125442},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3626":74485,"_31300":74458,"_21660":125444,"_5":14907,"_28477":125376,"_3077":125445},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3626":74486,"_31300":74458,"_21660":125447,"_5":14907,"_28477":125376,"_3077":125448},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3626":74487,"_31300":74458,"_21660":125450,"_5":14907,"_28477":125376,"_3077":125451},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3626":74488,"_31300":74458,"_21660":125453,"_5":14907,"_28477":125379,"_3077":125454},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3626":74489,"_31300":74458,"_21660":125456,"_5":14907,"_28477":125379,"_3077":125457},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3626":74490,"_31300":74458,"_21660":125459,"_5":14907,"_28477":125382,"_3077":125460},[],"Participante",{"_3626":74491,"_31300":74458,"_21660":125462,"_5":14907,"_28477":125382,"_3077":125463},[],"Responsabilidad",{"_3626":74492,"_31300":74458,"_21660":125465,"_5":14907,"_28477":125382,"_3077":125466},[],"Administrador PKI",{"_3626":74493,"_31300":74458,"_21660":125468,"_5":14907,"_28477":125382,"_3077":125469},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3626":74494,"_31300":74458,"_21660":125471,"_5":14907,"_28477":125382,"_3077":125472},[],"Administrador del aprovisionamiento",{"_3626":74495,"_31300":74458,"_21660":125474,"_5":14907,"_28477":125382,"_3077":125475},[],"DMS, admisión, autenticación por operación e inventario.",{"_3626":74496,"_31300":74458,"_21660":125477,"_5":14907,"_28477":125382,"_3077":125478},[],"Integrador del dispositivo",{"_3626":74497,"_31300":74458,"_21660":125480,"_5":14907,"_28477":125382,"_3077":125481},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3626":74498,"_31300":74458,"_21660":125483,"_5":14907,"_28477":125382,"_3077":125484},[],"Integrador del consumidor",{"_3626":74499,"_31300":74458,"_21660":125486,"_5":14907,"_28477":125382,"_3077":125487},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3626":74500,"_31300":74458,"_21660":125489,"_5":14907,"_28477":125382,"_3077":125490},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3626":74501,"_31300":74501,"_5":15267,"_3077":125492,"_31659":125493,"_21660":125495,"_28477":74501},"Enrola y conecta tu primer dispositivo",[51072,122019,53756,125494],"Primeros pasos",[],{"_3626":74502,"_31300":74501,"_21660":125497,"_5":14907,"_28477":74501,"_3077":125498},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3626":74503,"_31300":74501,"_5":31656,"_21660":125500,"_28477":125501,"_3077":120553},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3626":74504,"_31300":74501,"_5":31656,"_21660":125503,"_28477":125504,"_3077":125505},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3626":74505,"_31300":74501,"_5":31656,"_21660":125507,"_28477":125508,"_3077":125509},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3626":74506,"_31300":74501,"_5":31656,"_21660":125511,"_28477":125512,"_3077":125513},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3626":74507,"_31300":74501,"_5":31656,"_21660":125515,"_28477":125516,"_3077":125517},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3626":74508,"_31300":74501,"_5":31656,"_21660":125519,"_28477":125520,"_3077":125521},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3626":74509,"_31300":74501,"_5":31656,"_21660":125523,"_28477":125524,"_3077":125525},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3626":74510,"_31300":74501,"_5":31656,"_21660":125527,"_28477":125528,"_3077":125529},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3626":74511,"_31300":74501,"_21660":125531,"_5":14907,"_28477":74501,"_3077":125532},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3626":74512,"_31300":74501,"_21660":125534,"_5":14907,"_28477":125501,"_3077":125535},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3626":74513,"_31300":74501,"_21660":125537,"_5":14907,"_28477":125501,"_3077":125538},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3626":74514,"_31300":74501,"_21660":125540,"_5":14907,"_28477":125501,"_3077":125541},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3626":74515,"_31300":74501,"_21660":125543,"_5":14907,"_28477":125501,"_3077":125544},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3626":74516,"_31300":74501,"_21660":125546,"_5":14907,"_28477":125501,"_3077":125547},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3626":74517,"_31300":74501,"_21660":125549,"_5":14907,"_28477":125504,"_3077":125550},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3626":74518,"_31300":74501,"_21660":125552,"_5":14907,"_28477":125504,"_3077":125553},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3626":74519,"_31300":74501,"_21660":125555,"_5":14907,"_28477":125508,"_3077":125556},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3626":74520,"_31300":74501,"_21660":125558,"_5":14907,"_28477":125508,"_3077":125559},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3626":74521,"_31300":74501,"_21660":125561,"_5":14907,"_28477":125508,"_3077":125562},[],"Ajuste",{"_3626":74522,"_31300":74501,"_21660":125564,"_5":14907,"_28477":125508,"_3077":125565},[],"Valor de evaluación",{"_3626":74523,"_31300":74501,"_21660":125567,"_5":14907,"_28477":125508,"_3077":56272},[],{"_3626":74524,"_31300":74501,"_21660":125569,"_5":14907,"_28477":125508,"_3077":125570},[],"Raíz emisora de `device-root.pem`.",{"_3626":74525,"_31300":74501,"_21660":125572,"_5":14907,"_28477":125508,"_3077":123479},[],{"_3626":74526,"_31300":74501,"_21660":125574,"_5":14907,"_28477":125508,"_3077":125575},[],"Perfil final de 1 hora que acabas de preparar.",{"_3626":74527,"_31300":74501,"_21660":125577,"_5":14907,"_28477":125508,"_3077":56283},[],{"_3626":74528,"_31300":74501,"_21660":125579,"_5":14907,"_28477":125508,"_3077":56286},[],{"_3626":74529,"_31300":74501,"_21660":125581,"_5":14907,"_28477":125508,"_3077":56289},[],{"_3626":74530,"_31300":74501,"_21660":125583,"_5":14907,"_28477":125508,"_3077":125584},[],"Habilitado.",{"_3626":74531,"_31300":74501,"_21660":125586,"_5":14907,"_28477":125508,"_3077":56295},[],{"_3626":74532,"_31300":74501,"_21660":125588,"_5":14907,"_28477":125508,"_3077":125589},[],"Deshabilitado; el ID debe ser nuevo.",{"_3626":74533,"_31300":74501,"_21660":125591,"_5":14907,"_28477":125508,"_3077":125592},[],"Autenticación inicial",{"_3626":74534,"_31300":74501,"_21660":125594,"_5":14907,"_28477":125508,"_3077":125595},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3626":74535,"_31300":74501,"_21660":125597,"_5":14907,"_28477":125508,"_3077":125598},[],"Autenticación de renovación",{"_3626":74536,"_31300":74501,"_21660":125600,"_5":14907,"_28477":125508,"_3077":125601},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3626":74537,"_31300":74501,"_21660":125603,"_5":14907,"_28477":125508,"_3077":56313},[],{"_3626":74538,"_31300":74501,"_21660":125605,"_5":14907,"_28477":125508,"_3077":125606},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3626":74539,"_31300":74501,"_21660":125608,"_5":14907,"_28477":125508,"_3077":56319},[],{"_3626":74540,"_31300":74501,"_21660":125610,"_5":14907,"_28477":125508,"_3077":125611},[],"1 hora.",{"_3626":74541,"_31300":74501,"_21660":125613,"_5":14907,"_28477":125508,"_3077":56325},[],{"_3626":74542,"_31300":74501,"_21660":125615,"_5":14907,"_28477":125508,"_3077":125616},[],"30 minutos / 10 minutos.",{"_3626":74543,"_31300":74501,"_21660":125618,"_5":14907,"_28477":125508,"_3077":56331},[],{"_3626":74544,"_31300":74501,"_21660":125620,"_5":14907,"_28477":125508,"_3077":125621},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3626":74545,"_31300":74501,"_21660":125623,"_5":14907,"_28477":125508,"_3077":54087},[],{"_3626":74546,"_31300":74501,"_21660":125625,"_5":14907,"_28477":125508,"_3077":125626},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3626":74547,"_31300":74501,"_21660":125628,"_5":14907,"_28477":125508,"_3077":56342},[],{"_3626":74548,"_31300":74501,"_21660":125630,"_5":14907,"_28477":125508,"_3077":125631},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3626":74549,"_31300":74501,"_21660":125633,"_5":14907,"_28477":125508,"_3077":125634},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3626":74550,"_31300":74501,"_21660":125636,"_5":14907,"_28477":125512,"_3077":125637},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3626":74551,"_31300":74501,"_21660":125639,"_5":14907,"_28477":125512,"_3077":125640},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3626":74552,"_31300":74501,"_21660":125642,"_5":14907,"_28477":125516,"_3077":125643},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3626":74553,"_31300":74501,"_21660":125645,"_5":14907,"_28477":125516,"_3077":125646},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3626":74554,"_31300":74501,"_21660":125648,"_5":14907,"_28477":125516,"_3077":125649},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3626":74555,"_31300":74501,"_21660":125651,"_5":14907,"_28477":125520,"_3077":125652},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3626":74556,"_31300":74501,"_21660":125654,"_5":14907,"_28477":125520,"_3077":125655},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3626":74557,"_31300":74501,"_21660":125657,"_5":14907,"_28477":125524,"_3077":125658},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3626":74558,"_31300":74501,"_21660":125660,"_5":14907,"_28477":125524,"_3077":125661},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3626":74559,"_31300":74501,"_21660":125663,"_5":14907,"_28477":125524,"_3077":125664},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3626":74560,"_31300":74501,"_21660":125666,"_5":14907,"_28477":125524,"_3077":125667},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3626":74561,"_31300":74501,"_21660":125669,"_5":14907,"_28477":125524,"_3077":125670},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3626":74562,"_31300":74501,"_21660":125672,"_5":14907,"_28477":125528,"_3077":125673},[],"Comprobación",{"_3626":74563,"_31300":74501,"_21660":125675,"_5":14907,"_28477":125528,"_3077":125676},[],"Resultado esperado",{"_3626":74564,"_31300":74501,"_21660":125678,"_5":14907,"_28477":125528,"_3077":125679},[],"Registro",{"_3626":74565,"_31300":74501,"_21660":125681,"_5":14907,"_28477":125528,"_3077":125682},[],"ID creado automáticamente y DMS correcto.",{"_3626":74566,"_31300":74501,"_21660":125684,"_5":14907,"_28477":125528,"_3077":124969},[],{"_3626":74567,"_31300":74501,"_21660":125686,"_5":14907,"_28477":125528,"_3077":125687},[],"CN, perfil, serie y clave verificados.",{"_3626":74568,"_31300":74501,"_21660":125689,"_5":14907,"_28477":125528,"_3077":125690},[],"Inventario",{"_3626":74569,"_31300":74501,"_21660":125692,"_5":14907,"_28477":125528,"_3077":125693},[],"Serie recibida visible como identidad actual y en el historial.",{"_3626":74570,"_31300":74501,"_21660":125695,"_5":14907,"_28477":125528,"_3077":125696},[],"Consumidor",{"_3626":74571,"_31300":74501,"_21660":125698,"_5":14907,"_28477":125528,"_3077":125699},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3626":74572,"_31300":74501,"_21660":125701,"_5":14907,"_28477":125528,"_3077":125702},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3626":74573,"_31300":74501,"_21660":125704,"_5":14907,"_28477":125528,"_3077":125705},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3626":74574,"_31300":74574,"_5":15267,"_3077":123181,"_31659":125707,"_21660":125708,"_28477":74574},[51072,122019,53756,125494],[],{"_3626":74575,"_31300":74574,"_21660":125710,"_5":14907,"_28477":74574,"_3077":125711},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3626":74576,"_31300":74574,"_5":31656,"_21660":125713,"_28477":125714,"_3077":120553},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3626":74577,"_31300":74574,"_5":31656,"_21660":125716,"_28477":125717,"_3077":125718},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3626":74578,"_31300":74574,"_5":31656,"_21660":125720,"_28477":125721,"_3077":125722},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3626":74579,"_31300":74574,"_5":31656,"_21660":125724,"_28477":125725,"_3077":125726},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3626":74580,"_31300":74574,"_5":31656,"_21660":125728,"_28477":125729,"_3077":125730},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3626":74581,"_31300":74574,"_5":31656,"_21660":125732,"_28477":125733,"_3077":125734},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3626":74582,"_31300":74574,"_5":31656,"_21660":125736,"_28477":125737,"_3077":125676},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3626":74583,"_31300":74574,"_5":31656,"_21660":125739,"_28477":125740,"_3077":125741},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3626":74584,"_31300":74574,"_5":31656,"_21660":125743,"_28477":125744,"_3077":125745},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3626":74585,"_31300":74574,"_21660":125747,"_5":14907,"_28477":74574,"_3077":125748},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3626":74586,"_31300":74574,"_21660":125750,"_5":14907,"_28477":74574,"_3077":125751},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3626":74587,"_31300":74574,"_21660":125753,"_5":14907,"_28477":125714,"_3077":125754},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3626":74588,"_31300":74574,"_21660":125756,"_5":14907,"_28477":125714,"_3077":125757},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3626":74589,"_31300":74574,"_21660":125759,"_5":14907,"_28477":125714,"_3077":125760},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3626":74590,"_31300":74574,"_21660":125762,"_5":14907,"_28477":125714,"_3077":125763},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3626":74591,"_31300":74574,"_21660":125765,"_5":14907,"_28477":125717,"_3077":125766},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3626":74592,"_31300":74574,"_21660":125768,"_5":14907,"_28477":125717,"_3077":125769},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3626":74593,"_31300":74574,"_21660":125771,"_5":14907,"_28477":125717,"_3077":125772},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3626":74594,"_31300":74574,"_21660":125774,"_5":14907,"_28477":125717,"_3077":125775},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3626":74595,"_31300":74574,"_21660":125777,"_5":14907,"_28477":125717,"_3077":125778},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3626":74596,"_31300":74574,"_21660":125780,"_5":14907,"_28477":125717,"_3077":125781},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3626":74597,"_31300":74574,"_21660":125783,"_5":14907,"_28477":125717,"_3077":125784},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3626":74598,"_31300":74574,"_21660":125786,"_5":14907,"_28477":125717,"_3077":125787},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3626":74599,"_31300":74574,"_21660":125789,"_5":14907,"_28477":125721,"_3077":125790},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3626":74600,"_31300":74574,"_21660":125792,"_5":14907,"_28477":125721,"_3077":56507},[],{"_3626":74601,"_31300":74574,"_21660":125794,"_5":14907,"_28477":125721,"_3077":125795},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3626":74602,"_31300":74574,"_21660":125797,"_5":14907,"_28477":125721,"_3077":125798},[],"**Icon** y **Tags**: clasificación opcional.",{"_3626":74603,"_31300":74574,"_21660":125800,"_5":14907,"_28477":125721,"_3077":125801},[],"Confirma el registro.",{"_3626":74604,"_31300":74574,"_21660":125803,"_5":14907,"_28477":125725,"_3077":125804},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3626":74605,"_31300":74574,"_21660":125806,"_5":14907,"_28477":125725,"_3077":125807},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3626":74606,"_31300":74574,"_21660":125809,"_5":14907,"_28477":125729,"_3077":125810},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3626":74607,"_31300":74574,"_21660":125812,"_5":14907,"_28477":125729,"_3077":125813},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3626":74608,"_31300":74574,"_21660":125815,"_5":14907,"_28477":125733,"_3077":125816},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3626":74609,"_31300":74574,"_21660":125818,"_5":14907,"_28477":125733,"_3077":125819},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3626":74610,"_31300":74574,"_21660":125821,"_5":14907,"_28477":125737,"_3077":125673},[],{"_3626":74611,"_31300":74574,"_21660":125823,"_5":14907,"_28477":125737,"_3077":125824},[],"Resultado",{"_3626":74612,"_31300":74574,"_21660":125826,"_5":14907,"_28477":125737,"_3077":124955},[],{"_3626":74613,"_31300":74574,"_21660":125828,"_5":14907,"_28477":125737,"_3077":125829},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3626":74614,"_31300":74574,"_21660":125831,"_5":14907,"_28477":125737,"_3077":125832},[],"Identidad actual",{"_3626":74615,"_31300":74574,"_21660":125834,"_5":14907,"_28477":125737,"_3077":125835},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3626":74616,"_31300":74574,"_21660":125837,"_5":14907,"_28477":125737,"_3077":125838},[],"Historial",{"_3626":74617,"_31300":74574,"_21660":125840,"_5":14907,"_28477":125737,"_3077":125841},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3626":74618,"_31300":74574,"_21660":125843,"_5":14907,"_28477":125737,"_3077":125844},[],"Clave y certificado",{"_3626":74619,"_31300":74574,"_21660":125846,"_5":14907,"_28477":125737,"_3077":125847},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3626":74620,"_31300":74574,"_21660":125849,"_5":14907,"_28477":125740,"_3077":125850},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3626":74621,"_31300":74574,"_21660":125852,"_5":14907,"_28477":125740,"_3077":125853},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3626":74622,"_31300":74574,"_21660":125855,"_5":14907,"_28477":125740,"_3077":125856},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3626":74623,"_31300":74574,"_21660":125858,"_5":14907,"_28477":125740,"_3077":125859},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3626":74624,"_31300":74574,"_21660":125861,"_5":14907,"_28477":125744,"_3077":125862},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3626":74625,"_31300":74574,"_21660":125864,"_5":14907,"_28477":125744,"_3077":125865},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3626":74626,"_31300":74574,"_21660":125867,"_5":14907,"_28477":125744,"_3077":125868},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3626":74627,"_31300":74627,"_5":15267,"_3077":125870,"_31659":125871,"_21660":125872,"_28477":74627},"Plataforma Lamassu IoT",[51072,122019],[],{"_3626":74628,"_31300":74627,"_21660":125874,"_5":14907,"_28477":74627,"_3077":125875},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3626":74629,"_31300":74627,"_5":31656,"_21660":125877,"_28477":125878,"_3077":125370},[],"/docs/pr-preview/pr-78/es/platform/overview#empieza-aquí",{"_3626":74630,"_31300":74627,"_5":31656,"_21660":125880,"_28477":125881,"_3077":125882},[],"/docs/pr-preview/pr-78/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3626":74631,"_31300":74627,"_5":31656,"_21660":125884,"_28477":125885,"_3077":125886},[],"/docs/pr-preview/pr-78/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3626":74632,"_31300":74627,"_5":31656,"_21660":125888,"_28477":125889,"_3077":125890},[],"/docs/pr-preview/pr-78/es/platform/overview#capacidades-principales","Capacidades principales",{"_3626":74633,"_31300":74627,"_5":31656,"_21660":125892,"_28477":125893,"_3077":125894},[],"/docs/pr-preview/pr-78/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3626":74634,"_31300":74627,"_5":31656,"_21660":125896,"_28477":125897,"_3077":125898},[],"/docs/pr-preview/pr-78/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3626":74635,"_31300":74627,"_5":31656,"_21660":125900,"_28477":125901,"_3077":125902},[],"/docs/pr-preview/pr-78/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3626":74636,"_31300":74627,"_5":31656,"_21660":125904,"_28477":125905,"_3077":125906},[],"/docs/pr-preview/pr-78/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3626":74637,"_31300":74627,"_5":31656,"_21660":125908,"_28477":125909,"_3077":125910},[],"/docs/pr-preview/pr-78/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3626":74638,"_31300":74627,"_5":31656,"_21660":125912,"_28477":125913,"_3077":125914},[],"/docs/pr-preview/pr-78/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3626":74639,"_31300":74627,"_5":31656,"_21660":125916,"_28477":125917,"_3077":125918},[],"/docs/pr-preview/pr-78/es/platform/overview#referencia-operativa","Referencia operativa",{"_3626":74640,"_31300":74627,"_21660":125920,"_5":14907,"_28477":74627,"_3077":125921},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3626":74641,"_31300":74627,"_21660":125923,"_5":14907,"_28477":125878,"_3077":125924},[],"Elige el resultado que necesitas obtener:",{"_3626":74642,"_31300":74627,"_21660":125926,"_5":14907,"_28477":125878,"_3077":125927},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3626":74643,"_31300":74627,"_21660":125929,"_5":14907,"_28477":125878,"_3077":125930},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3626":74644,"_31300":74627,"_21660":125932,"_5":14907,"_28477":125878,"_3077":125933},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3626":74645,"_31300":74627,"_21660":125935,"_5":14907,"_28477":125881,"_3077":125936},[],"Bloque",{"_3626":74646,"_31300":74627,"_21660":125938,"_5":14907,"_28477":125881,"_3077":125939},[],"Qué gestionas",{"_3626":74647,"_31300":74627,"_21660":125941,"_5":14907,"_28477":125881,"_3077":125942},[],"Punto de entrada",{"_3626":74648,"_31300":74627,"_21660":125944,"_5":14907,"_28477":125881,"_3077":56660},[],{"_3626":74649,"_31300":74627,"_21660":125946,"_5":14907,"_28477":125881,"_3077":125947},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3626":74650,"_31300":74627,"_21660":125949,"_5":14907,"_28477":125881,"_3077":125950},[],"Visión general de PKI",{"_3626":74651,"_31300":74627,"_21660":125952,"_5":14907,"_28477":125881,"_3077":56669},[],{"_3626":74652,"_31300":74627,"_21660":125954,"_5":14907,"_28477":125881,"_3077":125955},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3626":74653,"_31300":74627,"_21660":125957,"_5":14907,"_28477":125881,"_3077":125958},[],"Visión general de IoT Fleets",{"_3626":74654,"_31300":74627,"_21660":125960,"_5":14907,"_28477":125881,"_3077":125961},[],"**Administración**",{"_3626":74655,"_31300":74627,"_21660":125963,"_5":14907,"_28477":125881,"_3077":125964},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3626":74656,"_31300":74627,"_21660":125966,"_5":14907,"_28477":125881,"_3077":122021},[],{"_3626":74657,"_31300":74627,"_21660":125968,"_5":14907,"_28477":125881,"_3077":125969},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3626":74658,"_31300":74627,"_21660":125971,"_5":14907,"_28477":125885,"_3077":125972},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3626":74659,"_31300":74627,"_21660":125974,"_5":14907,"_28477":125885,"_3077":125975},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3626":74660,"_31300":74627,"_21660":125977,"_5":14907,"_28477":125885,"_3077":125978},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3626":74661,"_31300":74627,"_21660":125980,"_5":14907,"_28477":125885,"_3077":125981},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3626":74662,"_31300":74627,"_21660":125983,"_5":14907,"_28477":125885,"_3077":125984},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3626":74663,"_31300":74627,"_21660":125986,"_5":14907,"_28477":125885,"_3077":125987},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3626":74664,"_31300":74627,"_21660":125989,"_5":14907,"_28477":125893,"_3077":125990},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3626":74665,"_31300":74627,"_21660":125992,"_5":14907,"_28477":125897,"_3077":125993},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3626":74666,"_31300":74627,"_21660":125995,"_5":14907,"_28477":125901,"_3077":125996},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3626":74667,"_31300":74627,"_21660":125998,"_5":14907,"_28477":125905,"_3077":125999},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3626":74668,"_31300":74627,"_21660":126001,"_5":14907,"_28477":125909,"_3077":126002},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3626":74669,"_31300":74627,"_21660":126004,"_5":14907,"_28477":125913,"_3077":126005},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3626":74670,"_31300":74627,"_21660":126007,"_5":14907,"_28477":125917,"_3077":125463},[],{"_3626":74671,"_31300":74627,"_21660":126009,"_5":14907,"_28477":125917,"_3077":126010},[],"Qué prepara o comprueba",{"_3626":74672,"_31300":74627,"_21660":126012,"_5":14907,"_28477":125917,"_3077":125466},[],{"_3626":74673,"_31300":74627,"_21660":126014,"_5":14907,"_28477":125917,"_3077":126015},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3626":74674,"_31300":74627,"_21660":126017,"_5":14907,"_28477":125917,"_3077":126018},[],"Administrador de la flota",{"_3626":74675,"_31300":74627,"_21660":126020,"_5":14907,"_28477":125917,"_3077":126021},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3626":74676,"_31300":74627,"_21660":126023,"_5":14907,"_28477":125917,"_3077":125478},[],{"_3626":74677,"_31300":74627,"_21660":126025,"_5":14907,"_28477":125917,"_3077":126026},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3626":74678,"_31300":74627,"_21660":126028,"_5":14907,"_28477":125917,"_3077":125484},[],{"_3626":74679,"_31300":74627,"_21660":126030,"_5":14907,"_28477":125917,"_3077":126031},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3626":74680,"_31300":74627,"_21660":126033,"_5":14907,"_28477":125917,"_3077":126034},[],"Operador de infraestructura",{"_3626":74681,"_31300":74627,"_21660":126036,"_5":14907,"_28477":125917,"_3077":126037},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3626":74682,"_31300":74627,"_21660":126039,"_5":14907,"_28477":125917,"_3077":126040},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3626":74683,"_31300":74683,"_5":15267,"_3077":126042,"_31659":126043,"_21660":126045,"_28477":74683},"Jerarquía y rotación de CAs",[51072,122019,56761,126044],"Claves, autoridades y certificados",[],{"_3626":74684,"_31300":74683,"_21660":126047,"_5":14907,"_28477":74683,"_3077":126048},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3626":74685,"_31300":74683,"_5":31656,"_21660":126050,"_28477":126051,"_3077":126052},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3626":74686,"_31300":74683,"_5":31656,"_21660":126054,"_28477":126055,"_3077":126056},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3626":74687,"_31300":74683,"_5":31656,"_21660":126058,"_28477":126059,"_3077":126060},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3626":74688,"_31300":74683,"_5":31656,"_21660":126062,"_28477":126063,"_3077":126064},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3626":74689,"_31300":74683,"_5":31656,"_21660":126066,"_28477":126067,"_3077":126068},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3626":74690,"_31300":74683,"_5":31656,"_21660":126070,"_28477":126071,"_3077":126072},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3626":74691,"_31300":74683,"_5":31656,"_21660":126074,"_28477":126075,"_3077":126076},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3626":74692,"_31300":74683,"_5":31656,"_21660":126078,"_28477":126079,"_3077":126080},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3626":74693,"_31300":74683,"_5":31656,"_21660":126082,"_28477":126083,"_3077":126084},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3626":74694,"_31300":74683,"_5":31656,"_21660":126086,"_28477":126087,"_3077":126088},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3626":74695,"_31300":74683,"_5":31656,"_21660":126090,"_28477":126091,"_3077":126092},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3626":74696,"_31300":74683,"_5":31656,"_21660":126094,"_28477":126095,"_3077":126096},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3626":74697,"_31300":74683,"_21660":126098,"_5":14907,"_28477":74683,"_3077":126099},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3626":74698,"_31300":74683,"_21660":126101,"_5":14907,"_28477":74683,"_3077":126102},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3626":74699,"_31300":74683,"_21660":126104,"_5":14907,"_28477":126051,"_3077":126105},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3626":74700,"_31300":74683,"_21660":126107,"_5":14907,"_28477":126051,"_3077":126108},[],"entorno, como producción y preproducción;",{"_3626":74701,"_31300":74683,"_21660":126110,"_5":14907,"_28477":126051,"_3077":126111},[],"propietario o equipo operador;",{"_3626":74702,"_31300":74683,"_21660":126113,"_5":14907,"_28477":126051,"_3077":126114},[],"familia de dispositivos o proceso de fabricación;",{"_3626":74703,"_31300":74683,"_21660":126116,"_5":14907,"_28477":126051,"_3077":126117},[],"región o requisito regulatorio;",{"_3626":74704,"_31300":74683,"_21660":126119,"_5":14907,"_28477":126051,"_3077":126120},[],"motor criptográfico o política de clave;",{"_3626":74705,"_31300":74683,"_21660":126122,"_5":14907,"_28477":126051,"_3077":126123},[],"ventana de mantenimiento y ritmo de renovación.",{"_3626":74706,"_31300":74683,"_21660":126125,"_5":14907,"_28477":126051,"_3077":126126},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3626":74707,"_31300":74683,"_21660":126128,"_5":14907,"_28477":126051,"_3077":126129},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3626":74708,"_31300":74683,"_21660":126131,"_5":14907,"_28477":126055,"_3077":126132},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3626":74709,"_31300":74683,"_21660":126134,"_5":14907,"_28477":126055,"_3077":126135},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3626":74710,"_31300":74683,"_21660":126137,"_5":14907,"_28477":126055,"_3077":126138},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3626":74711,"_31300":74683,"_21660":126140,"_5":14907,"_28477":126055,"_3077":126141},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3626":74712,"_31300":74683,"_21660":126143,"_5":14907,"_28477":126059,"_3077":126144},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3626":74713,"_31300":74683,"_21660":126146,"_5":14907,"_28477":126059,"_3077":126147},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3626":74714,"_31300":74683,"_21660":126149,"_5":14907,"_28477":126059,"_3077":126150},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3626":74715,"_31300":74683,"_21660":126152,"_5":14907,"_28477":126059,"_3077":126153},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3626":74716,"_31300":74683,"_21660":126155,"_5":14907,"_28477":126067,"_3077":126156},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3626":74717,"_31300":74683,"_21660":126158,"_5":14907,"_28477":126071,"_3077":126159},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3626":74718,"_31300":74683,"_21660":126161,"_5":14907,"_28477":126075,"_3077":126162},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3626":74719,"_31300":74683,"_21660":126164,"_5":14907,"_28477":126079,"_3077":126165},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3626":74720,"_31300":74683,"_21660":126167,"_5":14907,"_28477":126083,"_3077":126168},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3626":74721,"_31300":74683,"_21660":126170,"_5":14907,"_28477":126087,"_3077":126171},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3626":74722,"_31300":74683,"_21660":126173,"_5":14907,"_28477":126091,"_3077":126174},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3626":74723,"_31300":74683,"_21660":126176,"_5":14907,"_28477":126091,"_3077":126177},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3626":74724,"_31300":74683,"_21660":126179,"_5":14907,"_28477":126091,"_3077":126180},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3626":74725,"_31300":74683,"_21660":126182,"_5":14907,"_28477":126091,"_3077":126183},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3626":74726,"_31300":74683,"_21660":126185,"_5":14907,"_28477":126095,"_3077":126186},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3626":74727,"_31300":74683,"_21660":126188,"_5":14907,"_28477":126095,"_3077":126189},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3626":74728,"_31300":74683,"_21660":126191,"_5":14907,"_28477":126095,"_3077":126192},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3626":74729,"_31300":74683,"_21660":126194,"_5":14907,"_28477":126095,"_3077":126195},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3626":74730,"_31300":74683,"_21660":126197,"_5":14907,"_28477":126095,"_3077":126198},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3626":74731,"_31300":74683,"_21660":126200,"_5":14907,"_28477":126095,"_3077":126201},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3626":74732,"_31300":74683,"_21660":126203,"_5":14907,"_28477":126095,"_3077":126204},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3626":74733,"_31300":74733,"_5":15267,"_3077":126206,"_31659":126207,"_21660":126208,"_28477":74733},"Autoridades de certificación",[51072,122019,56761,126044],[],{"_3626":74734,"_31300":74733,"_21660":126210,"_5":14907,"_28477":74733,"_3077":126211},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3626":74735,"_31300":74733,"_5":31656,"_21660":126213,"_28477":126214,"_3077":126215},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3626":74736,"_31300":74733,"_5":31656,"_21660":126217,"_28477":126218,"_3077":126219},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3626":74737,"_31300":74733,"_5":31656,"_21660":126221,"_28477":126222,"_3077":120553},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3626":74738,"_31300":74733,"_5":31656,"_21660":126224,"_28477":126225,"_3077":126226},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3626":74739,"_31300":74733,"_5":31656,"_21660":126228,"_28477":126229,"_3077":126230},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3626":74740,"_31300":74733,"_5":31656,"_21660":126232,"_28477":126233,"_3077":126234},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3626":74741,"_31300":74733,"_5":31656,"_21660":126236,"_28477":126237,"_3077":126238},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3626":74742,"_31300":74733,"_5":31656,"_21660":126240,"_28477":126241,"_3077":126242},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3626":74743,"_31300":74733,"_5":31656,"_21660":126244,"_28477":126245,"_3077":126246},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3626":74744,"_31300":74733,"_5":31656,"_21660":126248,"_28477":126249,"_3077":126250},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3626":74745,"_31300":74733,"_5":31656,"_21660":126252,"_28477":126253,"_3077":126254},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3626":74746,"_31300":74733,"_5":31656,"_21660":126256,"_28477":126257,"_3077":126258},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3626":74747,"_31300":74733,"_5":31656,"_21660":126260,"_28477":126261,"_3077":126262},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3626":74748,"_31300":74733,"_5":31656,"_21660":126264,"_28477":126265,"_3077":126266},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3626":74749,"_31300":74733,"_5":31656,"_21660":126268,"_28477":126269,"_3077":126270},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3626":74750,"_31300":74733,"_5":31656,"_21660":126272,"_28477":126273,"_3077":126274},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3626":74751,"_31300":74733,"_5":31656,"_21660":126276,"_28477":126277,"_3077":126278},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3626":74752,"_31300":74733,"_5":31656,"_21660":126280,"_28477":126281,"_3077":126282},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3626":74753,"_31300":74733,"_5":31656,"_21660":126284,"_28477":126285,"_3077":126286},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3626":74754,"_31300":74733,"_5":31656,"_21660":126288,"_28477":126289,"_3077":126290},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3626":74755,"_31300":74733,"_5":31656,"_21660":126292,"_28477":126293,"_3077":126294},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3626":74756,"_31300":74733,"_5":31656,"_21660":126296,"_28477":126297,"_3077":126298},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3626":74757,"_31300":74733,"_5":31656,"_21660":126300,"_28477":126301,"_3077":126302},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3626":74758,"_31300":74733,"_21660":126304,"_5":14907,"_28477":74733,"_3077":126305},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3626":74759,"_31300":74733,"_21660":126307,"_5":14907,"_28477":74733,"_3077":126308},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3626":74760,"_31300":74733,"_21660":126310,"_5":14907,"_28477":74733,"_3077":126311},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3626":74761,"_31300":74733,"_21660":126313,"_5":14907,"_28477":126214,"_3077":126314},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3626":74762,"_31300":74733,"_21660":126316,"_5":14907,"_28477":126214,"_3077":126317},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3626":74763,"_31300":74733,"_21660":126319,"_5":14907,"_28477":126214,"_3077":126320},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3626":74764,"_31300":74733,"_21660":126322,"_5":14907,"_28477":126214,"_3077":126323},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3626":74765,"_31300":74733,"_21660":126325,"_5":14907,"_28477":126214,"_3077":126326},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3626":74766,"_31300":74733,"_21660":126328,"_5":14907,"_28477":126222,"_3077":126329},[],"Decide si la CA será raíz o intermedia.",{"_3626":74767,"_31300":74733,"_21660":126331,"_5":14907,"_28477":126222,"_3077":126332},[],"Elige el motor que custodiará la clave.",{"_3626":74768,"_31300":74733,"_21660":126334,"_5":14907,"_28477":126222,"_3077":126335},[],"Define una validez superior a la de los certificados que emitirá.",{"_3626":74769,"_31300":74733,"_21660":126337,"_5":14907,"_28477":126222,"_3077":126338},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3626":74770,"_31300":74733,"_21660":126340,"_5":14907,"_28477":126225,"_3077":126341},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3626":74771,"_31300":74733,"_21660":126343,"_5":14907,"_28477":126229,"_3077":126344},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3626":74772,"_31300":74733,"_21660":126346,"_5":14907,"_28477":126229,"_3077":126347},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3626":74773,"_31300":74733,"_21660":126349,"_5":14907,"_28477":126233,"_3077":126350},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3626":74774,"_31300":74733,"_21660":126352,"_5":14907,"_28477":126237,"_3077":126353},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3626":74775,"_31300":74733,"_21660":126355,"_5":14907,"_28477":126237,"_3077":126356},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3626":74776,"_31300":74733,"_21660":126358,"_5":14907,"_28477":126237,"_3077":126359},[],"`ST`: estado o provincia.",{"_3626":74777,"_31300":74733,"_21660":126361,"_5":14907,"_28477":126237,"_3077":126362},[],"`L`: localidad.",{"_3626":74778,"_31300":74733,"_21660":126364,"_5":14907,"_28477":126237,"_3077":126365},[],"`O`: organización.",{"_3626":74779,"_31300":74733,"_21660":126367,"_5":14907,"_28477":126237,"_3077":126368},[],"`OU`: unidad organizativa.",{"_3626":74780,"_31300":74733,"_21660":126370,"_5":14907,"_28477":126237,"_3077":126371},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3626":74781,"_31300":74733,"_21660":126373,"_5":14907,"_28477":126241,"_3077":126374},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3626":74782,"_31300":74733,"_21660":126376,"_5":14907,"_28477":126241,"_3077":126377},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3626":74783,"_31300":74733,"_21660":126379,"_5":14907,"_28477":126245,"_3077":126380},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3626":74784,"_31300":74733,"_21660":126382,"_5":14907,"_28477":126245,"_3077":126383},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3626":74785,"_31300":74733,"_21660":126385,"_5":14907,"_28477":126249,"_3077":126386},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3626":74786,"_31300":74733,"_21660":126388,"_5":14907,"_28477":126249,"_3077":126389},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3626":74787,"_31300":74733,"_21660":126391,"_5":14907,"_28477":126253,"_3077":126392},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3626":74788,"_31300":74733,"_21660":126394,"_5":14907,"_28477":126253,"_3077":126395},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3626":74789,"_31300":74733,"_21660":126397,"_5":14907,"_28477":126253,"_3077":126398},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3626":74790,"_31300":74733,"_21660":126400,"_5":14907,"_28477":126257,"_3077":126401},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3626":74791,"_31300":74733,"_21660":126403,"_5":14907,"_28477":126261,"_3077":126404},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3626":74792,"_31300":74733,"_21660":126406,"_5":14907,"_28477":126261,"_3077":126407},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3626":74793,"_31300":74733,"_21660":126409,"_5":14907,"_28477":126265,"_3077":126410},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3626":74794,"_31300":74733,"_21660":126412,"_5":14907,"_28477":126269,"_3077":126413},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3626":74795,"_31300":74733,"_21660":126415,"_5":14907,"_28477":126269,"_3077":126416},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3626":74796,"_31300":74733,"_21660":126418,"_5":14907,"_28477":126269,"_3077":126419},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3626":74797,"_31300":74733,"_21660":126421,"_5":14907,"_28477":126273,"_3077":126422},[],"Abre una CA desde el inventario para consultar:",{"_3626":74798,"_31300":74733,"_21660":126424,"_5":14907,"_28477":126273,"_3077":126425},[],"Estado y periodo de validez.",{"_3626":74799,"_31300":74733,"_21660":126427,"_5":14907,"_28477":126273,"_3077":126428},[],"Certificado y cadena en formato PEM.",{"_3626":74800,"_31300":74733,"_21660":126430,"_5":14907,"_28477":126273,"_3077":126431},[],"Número de certificados activos, expirados y revocados.",{"_3626":74801,"_31300":74733,"_21660":126433,"_5":14907,"_28477":126273,"_3077":126434},[],"Certificados emitidos en **Issued Certificates**.",{"_3626":74802,"_31300":74733,"_21660":126436,"_5":14907,"_28477":126273,"_3077":126437},[],"CRL vinculada a la autoridad.",{"_3626":74803,"_31300":74733,"_21660":126439,"_5":14907,"_28477":126273,"_3077":126440},[],"Metadatos y motor criptográfico asociado.",{"_3626":74804,"_31300":74733,"_21660":126442,"_5":14907,"_28477":126273,"_3077":126443},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3626":74805,"_31300":74733,"_21660":126445,"_5":14907,"_28477":126277,"_3077":126446},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3626":74806,"_31300":74733,"_21660":126448,"_5":14907,"_28477":126277,"_3077":126449},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3626":74807,"_31300":74733,"_21660":126451,"_5":14907,"_28477":126277,"_3077":126452},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3626":74808,"_31300":74733,"_21660":126454,"_5":14907,"_28477":126277,"_3077":126455},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3626":74809,"_31300":74733,"_21660":126457,"_5":14907,"_28477":126277,"_3077":126458},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3626":74810,"_31300":74733,"_21660":126460,"_5":14907,"_28477":126277,"_3077":126461},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3626":74811,"_31300":74733,"_21660":126463,"_5":14907,"_28477":126281,"_3077":126464},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3626":74812,"_31300":74733,"_21660":126466,"_5":14907,"_28477":126285,"_3077":126467},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3626":74813,"_31300":74733,"_21660":126469,"_5":14907,"_28477":126289,"_3077":126470},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3626":74814,"_31300":74733,"_21660":126472,"_5":14907,"_28477":126293,"_3077":126473},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3626":74815,"_31300":74733,"_21660":126475,"_5":14907,"_28477":126297,"_3077":126476},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3626":74816,"_31300":74733,"_21660":126478,"_5":14907,"_28477":126301,"_3077":126479},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3626":74817,"_31300":74733,"_21660":126481,"_5":14907,"_28477":126301,"_3077":126482},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3626":74818,"_31300":74733,"_21660":126484,"_5":14907,"_28477":126301,"_3077":126485},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3626":74819,"_31300":74733,"_21660":126487,"_5":14907,"_28477":126301,"_3077":126488},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3626":74820,"_31300":74820,"_5":15267,"_3077":126490,"_31659":126491,"_21660":126492,"_28477":74820},"Perfiles de certificado",[51072,122019,56761,126044],[],{"_3626":74821,"_31300":74820,"_21660":126494,"_5":14907,"_28477":74820,"_3077":126495},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3626":74822,"_31300":74820,"_5":31656,"_21660":126497,"_28477":126498,"_3077":126499},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3626":74823,"_31300":74820,"_5":31656,"_21660":126501,"_28477":126502,"_3077":126503},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#validez","Validez",{"_3626":74824,"_31300":74820,"_5":31656,"_21660":126505,"_28477":126506,"_3077":126507},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3626":74825,"_31300":74820,"_5":31656,"_21660":126509,"_28477":126510,"_3077":126511},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3626":74826,"_31300":74820,"_5":31656,"_21660":126513,"_28477":126514,"_3077":126515},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3626":74827,"_31300":74820,"_5":31656,"_21660":126517,"_28477":126518,"_3077":126519},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3626":74828,"_31300":74820,"_5":31656,"_21660":126521,"_28477":126522,"_3077":126523},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3626":74829,"_31300":74820,"_5":31656,"_21660":126525,"_28477":126526,"_3077":126527},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3626":74830,"_31300":74820,"_5":31656,"_21660":126529,"_28477":126530,"_3077":126531},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3626":74831,"_31300":74820,"_5":31656,"_21660":126533,"_28477":126534,"_3077":126535},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3626":74832,"_31300":74820,"_5":31656,"_21660":126537,"_28477":126538,"_3077":126539},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3626":74833,"_31300":74820,"_5":31656,"_21660":126541,"_28477":126542,"_3077":126543},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3626":74834,"_31300":74820,"_5":31656,"_21660":126545,"_28477":126546,"_3077":126547},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3626":74835,"_31300":74820,"_5":31656,"_21660":126549,"_28477":126550,"_3077":126551},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3626":74836,"_31300":74820,"_5":31656,"_21660":126553,"_28477":126554,"_3077":126555},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3626":74837,"_31300":74820,"_5":31656,"_21660":126557,"_28477":126558,"_3077":126559},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3626":74838,"_31300":74820,"_21660":126561,"_5":14907,"_28477":74820,"_3077":126562},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3626":74839,"_31300":74820,"_21660":126564,"_5":14907,"_28477":74820,"_3077":126565},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3626":74840,"_31300":74820,"_21660":126567,"_5":14907,"_28477":126502,"_3077":126568},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3626":74841,"_31300":74820,"_21660":126570,"_5":14907,"_28477":126502,"_3077":126571},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3626":74842,"_31300":74820,"_21660":126573,"_5":14907,"_28477":126506,"_3077":126574},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3626":74843,"_31300":74820,"_21660":126576,"_5":14907,"_28477":126510,"_3077":126577},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3626":74844,"_31300":74820,"_21660":126579,"_5":14907,"_28477":126510,"_3077":126580},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3626":74845,"_31300":74820,"_21660":126582,"_5":14907,"_28477":126510,"_3077":126583},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3626":74846,"_31300":74820,"_21660":126585,"_5":14907,"_28477":126514,"_3077":126586},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3626":74847,"_31300":74820,"_21660":126588,"_5":14907,"_28477":126518,"_3077":126589},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3626":74848,"_31300":74820,"_21660":126591,"_5":14907,"_28477":126518,"_3077":126592},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3626":74849,"_31300":74820,"_21660":126594,"_5":14907,"_28477":126522,"_3077":126595},[],"La aplicación criptográfica puede:",{"_3626":74850,"_31300":74820,"_21660":126597,"_5":14907,"_28477":126522,"_3077":126598},[],"permitir o bloquear claves RSA;",{"_3626":74851,"_31300":74820,"_21660":126600,"_5":14907,"_28477":126522,"_3077":126601},[],"limitar los tamaños RSA admitidos;",{"_3626":74852,"_31300":74820,"_21660":126603,"_5":14907,"_28477":126522,"_3077":126604},[],"permitir o bloquear claves ECDSA;",{"_3626":74853,"_31300":74820,"_21660":126606,"_5":14907,"_28477":126522,"_3077":126607},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3626":74854,"_31300":74820,"_21660":126609,"_5":14907,"_28477":126522,"_3077":126610},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3626":74855,"_31300":74820,"_21660":126612,"_5":14907,"_28477":126526,"_3077":126613},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3626":74856,"_31300":74820,"_21660":126615,"_5":14907,"_28477":126526,"_3077":121779},[],{"_3626":74857,"_31300":74820,"_21660":126617,"_5":14907,"_28477":126526,"_3077":126618},[],"Primera opción",{"_3626":74858,"_31300":74820,"_21660":126620,"_5":14907,"_28477":126526,"_3077":126621},[],"Segunda opción",{"_3626":74859,"_31300":74820,"_21660":126623,"_5":14907,"_28477":126526,"_3077":126624},[],"Si no hay ninguna",{"_3626":74860,"_31300":74820,"_21660":126626,"_5":14907,"_28477":126526,"_3077":126627},[],"Firma directa con una CA",{"_3626":74861,"_31300":74820,"_21660":126629,"_5":14907,"_28477":126526,"_3077":126630},[],"`issuance_profile` incluido en la solicitud",{"_3626":74862,"_31300":74820,"_21660":126632,"_5":14907,"_28477":126526,"_3077":126633},[],"`issuance_profile_id` de la solicitud",{"_3626":74863,"_31300":74820,"_21660":126635,"_5":14907,"_28477":126526,"_3077":126636},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3626":74864,"_31300":74820,"_21660":126638,"_5":14907,"_28477":126526,"_3077":126639},[],"Emisión mediante DMS",{"_3626":74865,"_31300":74820,"_21660":126641,"_5":14907,"_28477":126526,"_3077":57360},[],{"_3626":74866,"_31300":74820,"_21660":126643,"_5":14907,"_28477":126526,"_3077":126644},[],"`settings.issuance_profile` incluido en el DMS",{"_3626":74867,"_31300":74820,"_21660":126646,"_5":14907,"_28477":126526,"_3077":126647},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3626":74868,"_31300":74820,"_21660":126649,"_5":14907,"_28477":126526,"_3077":126650},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3626":74869,"_31300":74820,"_21660":126652,"_5":14907,"_28477":126526,"_3077":126653},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3626":74870,"_31300":74820,"_21660":126655,"_5":14907,"_28477":126534,"_3077":126656},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3626":74871,"_31300":74820,"_21660":126658,"_5":14907,"_28477":126538,"_3077":126659},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3626":74872,"_31300":74820,"_21660":126661,"_5":14907,"_28477":126542,"_3077":126662},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3626":74873,"_31300":74820,"_21660":126664,"_5":14907,"_28477":126546,"_3077":126665},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3626":74874,"_31300":74820,"_21660":126667,"_5":14907,"_28477":126550,"_3077":126668},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3626":74875,"_31300":74820,"_21660":126670,"_5":14907,"_28477":126550,"_3077":126671},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3626":74876,"_31300":74820,"_21660":126673,"_5":14907,"_28477":126554,"_3077":126674},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3626":74877,"_31300":74820,"_21660":126676,"_5":14907,"_28477":126554,"_3077":126677},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3626":74878,"_31300":74820,"_21660":126679,"_5":14907,"_28477":126554,"_3077":126680},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3626":74879,"_31300":74820,"_21660":126682,"_5":14907,"_28477":126554,"_3077":126683},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3626":74880,"_31300":74820,"_21660":126685,"_5":14907,"_28477":126558,"_3077":126686},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3626":74881,"_31300":74820,"_21660":126688,"_5":14907,"_28477":126558,"_3077":126689},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3626":74882,"_31300":74882,"_5":15267,"_3077":126691,"_31659":126692,"_21660":126694,"_28477":74882},"Validación de certificados",[51072,122019,56761,126693],"Validación",[],{"_3626":74883,"_31300":74882,"_21660":126696,"_5":14907,"_28477":74882,"_3077":126697},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3626":74884,"_31300":74882,"_5":31656,"_21660":126699,"_28477":126700,"_3077":126701},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3626":74885,"_31300":74882,"_5":31656,"_21660":126703,"_28477":126704,"_3077":126705},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3626":74886,"_31300":74882,"_5":31656,"_21660":126707,"_28477":126708,"_3077":126709},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3626":74887,"_31300":74882,"_21660":126711,"_5":14907,"_28477":74882,"_3077":126712},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3626":74888,"_31300":74882,"_21660":126714,"_5":14907,"_28477":126700,"_3077":126715},[],"Verifica estos criterios juntos:",{"_3626":74889,"_31300":74882,"_21660":126717,"_5":14907,"_28477":126700,"_3077":125673},[],{"_3626":74890,"_31300":74882,"_21660":126719,"_5":14907,"_28477":126700,"_3077":126720},[],"Resultado necesario",{"_3626":74891,"_31300":74882,"_21660":126722,"_5":14907,"_28477":126700,"_3077":126723},[],"Cadena y firma",{"_3626":74892,"_31300":74882,"_21660":126725,"_5":14907,"_28477":126700,"_3077":126726},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3626":74893,"_31300":74882,"_21660":126728,"_5":14907,"_28477":126700,"_3077":126729},[],"Fechas",{"_3626":74894,"_31300":74882,"_21660":126731,"_5":14907,"_28477":126700,"_3077":126732},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3626":74895,"_31300":74882,"_21660":126734,"_5":14907,"_28477":126700,"_3077":121689},[],{"_3626":74896,"_31300":74882,"_21660":126736,"_5":14907,"_28477":126700,"_3077":126737},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3626":74897,"_31300":74882,"_21660":126739,"_5":14907,"_28477":126700,"_3077":126740},[],"Uso",{"_3626":74898,"_31300":74882,"_21660":126742,"_5":14907,"_28477":126700,"_3077":126743},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3626":74899,"_31300":74882,"_21660":126745,"_5":14907,"_28477":126700,"_3077":126746},[],"Revocación",{"_3626":74900,"_31300":74882,"_21660":126748,"_5":14907,"_28477":126700,"_3077":126749},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3626":74901,"_31300":74882,"_21660":126751,"_5":14907,"_28477":126700,"_3077":126752},[],"Autorización",{"_3626":74902,"_31300":74882,"_21660":126754,"_5":14907,"_28477":126700,"_3077":126755},[],"La aplicación permite la acción a esa identidad.",{"_3626":74903,"_31300":74882,"_21660":126757,"_5":14907,"_28477":126700,"_3077":126758},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3626":74904,"_31300":74882,"_21660":126760,"_5":14907,"_28477":126704,"_3077":126761},[],"Mecanismo",{"_3626":74905,"_31300":74882,"_21660":126763,"_5":14907,"_28477":126704,"_3077":126764},[],"Cuándo utilizarlo",{"_3626":74906,"_31300":74882,"_21660":126766,"_5":14907,"_28477":126704,"_3077":126767},[],"Qué debes mantener",{"_3626":74907,"_31300":74882,"_21660":126769,"_5":14907,"_28477":126704,"_3077":57488},[],{"_3626":74908,"_31300":74882,"_21660":126771,"_5":14907,"_28477":126704,"_3077":126772},[],"Consulta del estado de un certificado concreto.",{"_3626":74909,"_31300":74882,"_21660":126774,"_5":14907,"_28477":126704,"_3077":126775},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3626":74910,"_31300":74882,"_21660":126777,"_5":14907,"_28477":126704,"_3077":57497},[],{"_3626":74911,"_31300":74882,"_21660":126779,"_5":14907,"_28477":126704,"_3077":126780},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3626":74912,"_31300":74882,"_21660":126782,"_5":14907,"_28477":126704,"_3077":126783},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3626":74913,"_31300":74882,"_21660":126785,"_5":14907,"_28477":126704,"_3077":126786},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3626":74914,"_31300":74882,"_21660":126788,"_5":14907,"_28477":126704,"_3077":126789},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3626":74915,"_31300":74882,"_21660":126791,"_5":14907,"_28477":126708,"_3077":126792},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3626":74916,"_31300":74882,"_21660":126794,"_5":14907,"_28477":126708,"_3077":126795},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3626":74917,"_31300":74882,"_21660":126797,"_5":14907,"_28477":126708,"_3077":126798},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3626":74918,"_31300":74882,"_21660":126800,"_5":14907,"_28477":126708,"_3077":126801},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3626":74919,"_31300":74882,"_21660":126803,"_5":14907,"_28477":126708,"_3077":126804},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3626":74920,"_31300":74882,"_21660":126806,"_5":14907,"_28477":126708,"_3077":126807},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3626":74921,"_31300":74882,"_21660":126809,"_5":14907,"_28477":126708,"_3077":126810},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3626":74922,"_31300":74882,"_21660":126812,"_5":14907,"_28477":126708,"_3077":126813},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3626":74923,"_31300":74882,"_21660":126815,"_5":14907,"_28477":126708,"_3077":126816},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3626":74924,"_31300":74924,"_5":15267,"_3077":126818,"_31659":126819,"_21660":126820,"_28477":74924},"Certificados",[51072,122019,56761,126044],[],{"_3626":74925,"_31300":74924,"_21660":126822,"_5":14907,"_28477":74924,"_3077":126823},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3626":74926,"_31300":74924,"_5":31656,"_21660":126825,"_28477":126826,"_3077":126827},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3626":74927,"_31300":74924,"_5":31656,"_21660":126829,"_28477":126830,"_3077":126831},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3626":74928,"_31300":74924,"_5":31656,"_21660":126833,"_28477":126834,"_3077":126835},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3626":74929,"_31300":74924,"_5":31656,"_21660":126837,"_28477":126838,"_3077":126839},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3626":74930,"_31300":74924,"_5":31656,"_21660":126841,"_28477":126842,"_3077":126843},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3626":74931,"_31300":74924,"_5":31656,"_21660":126845,"_28477":126846,"_3077":126847},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3626":74932,"_31300":74924,"_5":31656,"_21660":126849,"_28477":126850,"_3077":126851},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3626":74933,"_31300":74924,"_5":31656,"_21660":126853,"_28477":126854,"_3077":126855},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3626":74934,"_31300":74924,"_5":31656,"_21660":126857,"_28477":126858,"_3077":126859},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#continúa","Continúa",{"_3626":74935,"_31300":74924,"_21660":126861,"_5":14907,"_28477":74924,"_3077":126862},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3626":74936,"_31300":74924,"_21660":126864,"_5":14907,"_28477":126826,"_3077":126865},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3626":74937,"_31300":74924,"_21660":126867,"_5":14907,"_28477":126826,"_3077":126868},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3626":74938,"_31300":74924,"_21660":126870,"_5":14907,"_28477":126826,"_3077":126871},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3626":74939,"_31300":74924,"_21660":126873,"_5":14907,"_28477":126826,"_3077":126874},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3626":74940,"_31300":74924,"_21660":126876,"_5":14907,"_28477":126826,"_3077":126877},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3626":74941,"_31300":74924,"_21660":126879,"_5":14907,"_28477":126826,"_3077":126880},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3626":74942,"_31300":74924,"_21660":126882,"_5":14907,"_28477":126826,"_3077":126883},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3626":74943,"_31300":74924,"_21660":126885,"_5":14907,"_28477":126830,"_3077":126886},[],"Descarga el PEM e inspecciónalo:",{"_3626":74944,"_31300":74924,"_21660":126888,"_5":14907,"_28477":126830,"_3077":126889},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3626":74945,"_31300":74924,"_21660":126891,"_5":14907,"_28477":126834,"_3077":126892},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3626":74946,"_31300":74924,"_21660":126894,"_5":14907,"_28477":126834,"_3077":126895},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3626":74947,"_31300":74924,"_21660":126897,"_5":14907,"_28477":126834,"_3077":126898},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3626":74948,"_31300":74924,"_21660":126900,"_5":14907,"_28477":126834,"_3077":126901},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3626":74949,"_31300":74924,"_21660":126903,"_5":14907,"_28477":126834,"_3077":126904},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3626":74950,"_31300":74924,"_21660":126906,"_5":14907,"_28477":126834,"_3077":126907},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3626":74951,"_31300":74924,"_21660":126909,"_5":14907,"_28477":126834,"_3077":126910},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3626":74952,"_31300":74924,"_21660":126912,"_5":14907,"_28477":126838,"_3077":126913},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3626":74953,"_31300":74924,"_21660":126915,"_5":14907,"_28477":126842,"_3077":126916},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3626":74954,"_31300":74924,"_21660":126918,"_5":14907,"_28477":126846,"_3077":126919},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3626":74955,"_31300":74924,"_21660":126921,"_5":14907,"_28477":126850,"_3077":126922},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3626":74956,"_31300":74924,"_21660":126924,"_5":14907,"_28477":126850,"_3077":126925},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3626":74957,"_31300":74924,"_21660":126927,"_5":14907,"_28477":126850,"_3077":126928},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3626":74958,"_31300":74924,"_21660":126930,"_5":14907,"_28477":126854,"_3077":126931},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3626":74959,"_31300":74924,"_21660":126933,"_5":14907,"_28477":126854,"_3077":126934},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3626":74960,"_31300":74924,"_21660":126936,"_5":14907,"_28477":126854,"_3077":126937},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3626":74961,"_31300":74924,"_21660":126939,"_5":14907,"_28477":126858,"_3077":126940},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3626":74962,"_31300":74924,"_21660":126942,"_5":14907,"_28477":126858,"_3077":126943},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3626":74963,"_31300":74963,"_5":15267,"_3077":126945,"_31659":126946,"_21660":126948,"_28477":74963},"Ciclo de vida de un certificado",[51072,122019,56761,126947],"Conceptos",[],{"_3626":74964,"_31300":74963,"_21660":126950,"_5":14907,"_28477":74963,"_3077":126951},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3626":74965,"_31300":74963,"_5":31656,"_21660":126953,"_28477":126954,"_3077":126955},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3626":74966,"_31300":74963,"_5":31656,"_21660":126957,"_28477":126958,"_3077":126959},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3626":74967,"_31300":74963,"_5":31656,"_21660":126961,"_28477":126962,"_3077":126963},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3626":74968,"_31300":74963,"_5":31656,"_21660":126965,"_28477":126966,"_3077":126967},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3626":74969,"_31300":74963,"_5":31656,"_21660":126969,"_28477":126970,"_3077":126971},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3626":74970,"_31300":74963,"_5":31656,"_21660":126973,"_28477":126974,"_3077":126975},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3626":74971,"_31300":74963,"_5":31656,"_21660":126977,"_28477":126978,"_3077":124667},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3626":74972,"_31300":74963,"_5":31656,"_21660":126980,"_28477":126981,"_3077":126982},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3626":74973,"_31300":74963,"_5":31656,"_21660":126984,"_28477":126985,"_3077":126986},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3626":74974,"_31300":74963,"_5":31656,"_21660":126988,"_28477":126989,"_3077":126990},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3626":74975,"_31300":74963,"_21660":126992,"_5":14907,"_28477":74963,"_3077":126993},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3626":74976,"_31300":74963,"_21660":126995,"_5":14907,"_28477":126958,"_3077":126996},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3626":74977,"_31300":74963,"_21660":126998,"_5":14907,"_28477":126962,"_3077":126999},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3626":74978,"_31300":74963,"_21660":127001,"_5":14907,"_28477":126966,"_3077":127002},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3626":74979,"_31300":74963,"_21660":127004,"_5":14907,"_28477":126970,"_3077":127005},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3626":74980,"_31300":74963,"_21660":127007,"_5":14907,"_28477":126974,"_3077":127008},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3626":74981,"_31300":74963,"_21660":127010,"_5":14907,"_28477":126978,"_3077":127011},[],"Lamassu persiste cuatro estados X.509:",{"_3626":74982,"_31300":74963,"_21660":127013,"_5":14907,"_28477":126978,"_3077":127014},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3626":74983,"_31300":74963,"_21660":127016,"_5":14907,"_28477":126978,"_3077":127017},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3626":74984,"_31300":74963,"_21660":127019,"_5":14907,"_28477":126978,"_3077":127020},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3626":74985,"_31300":74963,"_21660":127022,"_5":14907,"_28477":126978,"_3077":127023},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3626":74986,"_31300":74963,"_21660":127025,"_5":14907,"_28477":126978,"_3077":127026},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3626":74987,"_31300":74963,"_21660":127028,"_5":14907,"_28477":126981,"_3077":127029},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3626":74988,"_31300":74963,"_21660":127031,"_5":14907,"_28477":126981,"_3077":127032},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3626":74989,"_31300":74963,"_21660":127034,"_5":14907,"_28477":126981,"_3077":127035},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3626":74990,"_31300":74963,"_21660":127037,"_5":14907,"_28477":126985,"_3077":127038},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3626":74991,"_31300":74963,"_21660":127040,"_5":14907,"_28477":126985,"_3077":127041},[],"Antes de confirmar:",{"_3626":74992,"_31300":74963,"_21660":127043,"_5":14907,"_28477":126985,"_3077":127044},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3626":74993,"_31300":74963,"_21660":127046,"_5":14907,"_28477":126985,"_3077":127047},[],"Distribuye la nueva cadena de confianza.",{"_3626":74994,"_31300":74963,"_21660":127049,"_5":14907,"_28477":126985,"_3077":127050},[],"Reemite las identidades necesarias.",{"_3626":74995,"_31300":74963,"_21660":127052,"_5":14907,"_28477":126985,"_3077":127053},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3626":74996,"_31300":74963,"_21660":127055,"_5":14907,"_28477":126985,"_3077":127056},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3626":74997,"_31300":74963,"_21660":127058,"_5":14907,"_28477":126985,"_3077":127059},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3626":74998,"_31300":74963,"_21660":127061,"_5":14907,"_28477":126989,"_3077":127062},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3626":74999,"_31300":74963,"_21660":127064,"_5":14907,"_28477":126989,"_3077":127065},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3626":75000,"_31300":74963,"_21660":127067,"_5":14907,"_28477":126989,"_3077":127068},[],"Cambios de estado y razones de revocación.",{"_3626":75001,"_31300":74963,"_21660":127070,"_5":14907,"_28477":126989,"_3077":127071},[],"Publicación y vigencia de OCSP y CRLs.",{"_3626":75002,"_31300":74963,"_21660":127073,"_5":14907,"_28477":126989,"_3077":127074},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3626":75003,"_31300":74963,"_21660":127076,"_5":14907,"_28477":126989,"_3077":127077},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3626":75004,"_31300":75004,"_5":15267,"_3077":127079,"_31659":127080,"_21660":127081,"_28477":75004},"Modelo de confianza",[51072,122019,56761,126947],[],{"_3626":75005,"_31300":75004,"_21660":127083,"_5":14907,"_28477":75004,"_3077":127084},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3626":75006,"_31300":75004,"_5":31656,"_21660":127086,"_28477":127087,"_3077":127088},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3626":75007,"_31300":75004,"_5":31656,"_21660":127090,"_28477":127091,"_3077":127092},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3626":75008,"_31300":75004,"_5":31656,"_21660":127094,"_28477":127095,"_3077":127096},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3626":75009,"_31300":75004,"_5":31656,"_21660":127098,"_28477":127099,"_3077":127100},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3626":75010,"_31300":75004,"_5":31656,"_21660":127102,"_28477":127103,"_3077":127104},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3626":75011,"_31300":75004,"_5":31656,"_21660":127106,"_28477":127107,"_3077":127108},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3626":75012,"_31300":75004,"_5":31656,"_21660":127110,"_28477":127111,"_3077":127112},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3626":75013,"_31300":75004,"_5":31656,"_21660":127114,"_28477":127115,"_3077":127116},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3626":75014,"_31300":75004,"_5":31656,"_21660":127118,"_28477":127119,"_3077":127120},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3626":75015,"_31300":75004,"_5":31656,"_21660":127122,"_28477":127123,"_3077":127124},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3626":75016,"_31300":75004,"_21660":127126,"_5":14907,"_28477":75004,"_3077":127127},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3626":75017,"_31300":75004,"_21660":127129,"_5":14907,"_28477":127091,"_3077":127130},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3626":75018,"_31300":75004,"_21660":127132,"_5":14907,"_28477":127095,"_3077":127133},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3626":75019,"_31300":75004,"_21660":127135,"_5":14907,"_28477":127099,"_3077":127136},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3626":75020,"_31300":75004,"_21660":127138,"_5":14907,"_28477":127103,"_3077":127139},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3626":75021,"_31300":75004,"_21660":127141,"_5":14907,"_28477":127107,"_3077":127142},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3626":75022,"_31300":75004,"_21660":127144,"_5":14907,"_28477":127107,"_3077":127145},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3626":75023,"_31300":75004,"_21660":127147,"_5":14907,"_28477":127107,"_3077":127148},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3626":75024,"_31300":75004,"_21660":127150,"_5":14907,"_28477":127107,"_3077":127151},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3626":75025,"_31300":75004,"_21660":127153,"_5":14907,"_28477":127107,"_3077":127154},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3626":75026,"_31300":75004,"_21660":127156,"_5":14907,"_28477":127107,"_3077":127157},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3626":75027,"_31300":75004,"_21660":127159,"_5":14907,"_28477":127111,"_3077":127160},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3626":75028,"_31300":75004,"_21660":127162,"_5":14907,"_28477":127111,"_3077":127163},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3626":75029,"_31300":75004,"_21660":127165,"_5":14907,"_28477":127111,"_3077":127166},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3626":75030,"_31300":75004,"_21660":127168,"_5":14907,"_28477":127111,"_3077":127169},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3626":75031,"_31300":75004,"_21660":127171,"_5":14907,"_28477":127111,"_3077":127172},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3626":75032,"_31300":75004,"_21660":127174,"_5":14907,"_28477":127115,"_3077":127175},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3626":75033,"_31300":75004,"_21660":127177,"_5":14907,"_28477":127115,"_3077":127178},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3626":75034,"_31300":75004,"_21660":127180,"_5":14907,"_28477":127115,"_3077":127181},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3626":75035,"_31300":75004,"_21660":127183,"_5":14907,"_28477":127115,"_3077":127184},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3626":75036,"_31300":75004,"_21660":127186,"_5":14907,"_28477":127115,"_3077":127187},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3626":75037,"_31300":75004,"_21660":127189,"_5":14907,"_28477":127115,"_3077":127190},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3626":75038,"_31300":75004,"_21660":127192,"_5":14907,"_28477":127115,"_3077":127193},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3626":75039,"_31300":75004,"_21660":127195,"_5":14907,"_28477":127119,"_3077":127196},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3626":75040,"_31300":75004,"_21660":127198,"_5":14907,"_28477":127123,"_3077":127199},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3626":75041,"_31300":75004,"_21660":127201,"_5":14907,"_28477":127123,"_3077":127202},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3626":75042,"_31300":75004,"_21660":127204,"_5":14907,"_28477":127123,"_3077":127205},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3626":75043,"_31300":75004,"_21660":127207,"_5":14907,"_28477":127123,"_3077":127208},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3626":75044,"_31300":75004,"_21660":127210,"_5":14907,"_28477":127123,"_3077":127211},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3626":75045,"_31300":75004,"_21660":127213,"_5":14907,"_28477":127123,"_3077":127214},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3626":75046,"_31300":75004,"_21660":127216,"_5":14907,"_28477":127123,"_3077":127217},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3626":75047,"_31300":75047,"_5":15267,"_3077":127219,"_31659":127220,"_21660":127221,"_28477":75047},"Listas de revocación (CRL)",[51072,122019,56761,126693],[],{"_3626":75048,"_31300":75047,"_21660":127223,"_5":14907,"_28477":75047,"_3077":127224},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3626":75049,"_31300":75047,"_5":31656,"_21660":127226,"_28477":127227,"_3077":127228},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3626":75050,"_31300":75047,"_5":31656,"_21660":127230,"_28477":127231,"_3077":127232},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3626":75051,"_31300":75047,"_5":31656,"_21660":127234,"_28477":127235,"_3077":127236},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3626":75052,"_31300":75047,"_5":31656,"_21660":127238,"_28477":127239,"_3077":127240},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3626":75053,"_31300":75047,"_5":31656,"_21660":127242,"_28477":127243,"_3077":127244},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3626":75054,"_31300":75047,"_5":31656,"_21660":127246,"_28477":127247,"_3077":127248},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3626":75055,"_31300":75047,"_5":31656,"_21660":127250,"_28477":127251,"_3077":127252},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3626":75056,"_31300":75047,"_5":31656,"_21660":127254,"_28477":127255,"_3077":127256},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#referencias","Referencias",{"_3626":75057,"_31300":75047,"_21660":127258,"_5":14907,"_28477":75047,"_3077":127259},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3626":75058,"_31300":75047,"_21660":127261,"_5":14907,"_28477":127227,"_3077":127262},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3626":75059,"_31300":75047,"_21660":127264,"_5":14907,"_28477":127227,"_3077":127265},[],"Campo",{"_3626":75060,"_31300":75047,"_21660":127267,"_5":14907,"_28477":127227,"_3077":123708},[],{"_3626":75061,"_31300":75047,"_21660":127269,"_5":14907,"_28477":127227,"_3077":52704},[],{"_3626":75062,"_31300":75047,"_21660":127271,"_5":14907,"_28477":127227,"_3077":127272},[],"ID de la CA a la que pertenecen los ajustes.",{"_3626":75063,"_31300":75047,"_21660":127274,"_5":14907,"_28477":127227,"_3077":57996},[],{"_3626":75064,"_31300":75047,"_21660":127276,"_5":14907,"_28477":127227,"_3077":127277},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3626":75065,"_31300":75047,"_21660":127279,"_5":14907,"_28477":127227,"_3077":58002},[],{"_3626":75066,"_31300":75047,"_21660":127281,"_5":14907,"_28477":127227,"_3077":127282},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3626":75067,"_31300":75047,"_21660":127284,"_5":14907,"_28477":127227,"_3077":58008},[],{"_3626":75068,"_31300":75047,"_21660":127286,"_5":14907,"_28477":127227,"_3077":127287},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3626":75069,"_31300":75047,"_21660":127289,"_5":14907,"_28477":127227,"_3077":127290},[],"Campo de `crl_options`",{"_3626":75070,"_31300":75047,"_21660":127292,"_5":14907,"_28477":127227,"_3077":123708},[],{"_3626":75071,"_31300":75047,"_21660":127294,"_5":14907,"_28477":127227,"_3077":127295},[],"Valor inicial",{"_3626":75072,"_31300":75047,"_21660":127297,"_5":14907,"_28477":127227,"_3077":58022},[],{"_3626":75073,"_31300":75047,"_21660":127299,"_5":14907,"_28477":127227,"_3077":127300},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3626":75074,"_31300":75047,"_21660":127302,"_5":14907,"_28477":127227,"_3077":127303},[],"7 días.",{"_3626":75075,"_31300":75047,"_21660":127305,"_5":14907,"_28477":127227,"_3077":58031},[],{"_3626":75076,"_31300":75047,"_21660":127307,"_5":14907,"_28477":127227,"_3077":127308},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3626":75077,"_31300":75047,"_21660":127310,"_5":14907,"_28477":127227,"_3077":127311},[],"6 días y 23 horas.",{"_3626":75078,"_31300":75047,"_21660":127313,"_5":14907,"_28477":127227,"_3077":58040},[],{"_3626":75079,"_31300":75047,"_21660":127315,"_5":14907,"_28477":127227,"_3077":127316},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3626":75080,"_31300":75047,"_21660":127318,"_5":14907,"_28477":127227,"_3077":58046},[],{"_3626":75081,"_31300":75047,"_21660":127320,"_5":14907,"_28477":127227,"_3077":58049},[],{"_3626":75082,"_31300":75047,"_21660":127322,"_5":14907,"_28477":127227,"_3077":127323},[],"Número de serie del certificado existente que firma la CRL.",{"_3626":75083,"_31300":75047,"_21660":127325,"_5":14907,"_28477":127227,"_3077":127326},[],"Número de serie del certificado actual de la CA.",{"_3626":75084,"_31300":75047,"_21660":127328,"_5":14907,"_28477":127227,"_3077":127329},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3626":75085,"_31300":75047,"_21660":127331,"_5":14907,"_28477":127227,"_3077":127332},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3626":75086,"_31300":75047,"_21660":127334,"_5":14907,"_28477":127227,"_3077":127335},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3626":75087,"_31300":75047,"_21660":127337,"_5":14907,"_28477":127227,"_3077":127338},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3626":75088,"_31300":75047,"_21660":127340,"_5":14907,"_28477":127227,"_3077":127341},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3626":75089,"_31300":75047,"_21660":127343,"_5":14907,"_28477":127227,"_3077":127344},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3626":75090,"_31300":75047,"_21660":127346,"_5":14907,"_28477":127227,"_3077":127347},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3626":75091,"_31300":75047,"_21660":127349,"_5":14907,"_28477":127227,"_3077":127350},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3626":75092,"_31300":75047,"_21660":127352,"_5":14907,"_28477":127227,"_3077":127353},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3626":75093,"_31300":75047,"_21660":127355,"_5":14907,"_28477":127227,"_3077":127356},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3626":75094,"_31300":75047,"_21660":127358,"_5":14907,"_28477":127227,"_3077":127359},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3626":75095,"_31300":75047,"_21660":127361,"_5":14907,"_28477":127231,"_3077":127362},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3626":75096,"_31300":75047,"_21660":127364,"_5":14907,"_28477":127231,"_3077":127365},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3626":75097,"_31300":75047,"_21660":127367,"_5":14907,"_28477":127231,"_3077":127368},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3626":75098,"_31300":75047,"_21660":127370,"_5":14907,"_28477":127231,"_3077":127371},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3626":75099,"_31300":75047,"_21660":127373,"_5":14907,"_28477":127235,"_3077":127374},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3626":75100,"_31300":75047,"_21660":127376,"_5":14907,"_28477":127235,"_3077":127377},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3626":75101,"_31300":75047,"_21660":127379,"_5":14907,"_28477":127235,"_3077":127380},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3626":75102,"_31300":75047,"_21660":127382,"_5":14907,"_28477":127235,"_3077":127383},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3626":75103,"_31300":75047,"_21660":127385,"_5":14907,"_28477":127235,"_3077":127386},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3626":75104,"_31300":75047,"_21660":127388,"_5":14907,"_28477":127235,"_3077":127389},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3626":75105,"_31300":75047,"_21660":127391,"_5":14907,"_28477":127235,"_3077":127392},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3626":75106,"_31300":75047,"_21660":127394,"_5":14907,"_28477":127235,"_3077":127395},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3626":75107,"_31300":75047,"_21660":127397,"_5":14907,"_28477":127235,"_3077":127398},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3626":75108,"_31300":75047,"_21660":127400,"_5":14907,"_28477":127239,"_3077":127401},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3626":75109,"_31300":75047,"_21660":127403,"_5":14907,"_28477":127239,"_3077":127404},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3626":75110,"_31300":75047,"_21660":127406,"_5":14907,"_28477":127243,"_3077":127407},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3626":75111,"_31300":75047,"_21660":127409,"_5":14907,"_28477":127243,"_3077":127410},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3626":75112,"_31300":75047,"_21660":127412,"_5":14907,"_28477":127243,"_3077":127413},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3626":75113,"_31300":75047,"_21660":127415,"_5":14907,"_28477":127243,"_3077":127416},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3626":75114,"_31300":75047,"_21660":127418,"_5":14907,"_28477":127243,"_3077":127419},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3626":75115,"_31300":75047,"_21660":127421,"_5":14907,"_28477":127247,"_3077":127422},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3626":75116,"_31300":75047,"_21660":127424,"_5":14907,"_28477":127247,"_3077":123897},[],{"_3626":75117,"_31300":75047,"_21660":127426,"_5":14907,"_28477":127247,"_3077":127427},[],"Path relativo",{"_3626":75118,"_31300":75047,"_21660":127429,"_5":14907,"_28477":127247,"_3077":121779},[],{"_3626":75119,"_31300":75047,"_21660":127431,"_5":14907,"_28477":127247,"_3077":58161},[],{"_3626":75120,"_31300":75047,"_21660":127433,"_5":14907,"_28477":127247,"_3077":58164},[],{"_3626":75121,"_31300":75047,"_21660":127435,"_5":14907,"_28477":127247,"_3077":127436},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3626":75122,"_31300":75047,"_21660":127438,"_5":14907,"_28477":127247,"_3077":58161},[],{"_3626":75123,"_31300":75047,"_21660":127440,"_5":14907,"_28477":127247,"_3077":58172},[],{"_3626":75124,"_31300":75047,"_21660":127442,"_5":14907,"_28477":127247,"_3077":127443},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3626":75125,"_31300":75047,"_21660":127445,"_5":14907,"_28477":127247,"_3077":58178},[],{"_3626":75126,"_31300":75047,"_21660":127447,"_5":14907,"_28477":127247,"_3077":58172},[],{"_3626":75127,"_31300":75047,"_21660":127449,"_5":14907,"_28477":127247,"_3077":127450},[],"Sustituir la configuración de CRL de una CA.",{"_3626":75128,"_31300":75047,"_21660":127452,"_5":14907,"_28477":127247,"_3077":58186},[],{"_3626":75129,"_31300":75047,"_21660":127454,"_5":14907,"_28477":127247,"_3077":58172},[],{"_3626":75130,"_31300":75047,"_21660":127456,"_5":14907,"_28477":127247,"_3077":127457},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3626":75131,"_31300":75047,"_21660":127459,"_5":14907,"_28477":127247,"_3077":127460},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3626":75132,"_31300":75047,"_21660":127462,"_5":14907,"_28477":127247,"_3077":127463},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3626":75133,"_31300":75047,"_21660":127465,"_5":14907,"_28477":127247,"_3077":127466},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3626":75134,"_31300":75047,"_21660":127468,"_5":14907,"_28477":127251,"_3077":127469},[],"Síntoma",{"_3626":75135,"_31300":75047,"_21660":127471,"_5":14907,"_28477":127251,"_3077":127472},[],"Causa",{"_3626":75136,"_31300":75047,"_21660":127474,"_5":14907,"_28477":127251,"_3077":127475},[],"Acción",{"_3626":75137,"_31300":75047,"_21660":127477,"_5":14907,"_28477":127251,"_3077":127478},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3626":75138,"_31300":75047,"_21660":127480,"_5":14907,"_28477":127251,"_3077":127481},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3626":75139,"_31300":75047,"_21660":127483,"_5":14907,"_28477":127251,"_3077":127484},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3626":75140,"_31300":75047,"_21660":127486,"_5":14907,"_28477":127251,"_3077":127487},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3626":75141,"_31300":75047,"_21660":127489,"_5":14907,"_28477":127251,"_3077":127490},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3626":75142,"_31300":75047,"_21660":127492,"_5":14907,"_28477":127251,"_3077":127493},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3626":75143,"_31300":75047,"_21660":127495,"_5":14907,"_28477":127251,"_3077":127496},[],"`PUT` devuelve 400.",{"_3626":75144,"_31300":75047,"_21660":127498,"_5":14907,"_28477":127251,"_3077":127499},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3626":75145,"_31300":75047,"_21660":127501,"_5":14907,"_28477":127251,"_3077":127502},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3626":75146,"_31300":75047,"_21660":127504,"_5":14907,"_28477":127251,"_3077":127505},[],"`PUT` devuelve 404.",{"_3626":75147,"_31300":75047,"_21660":127507,"_5":14907,"_28477":127251,"_3077":127508},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3626":75148,"_31300":75047,"_21660":127510,"_5":14907,"_28477":127251,"_3077":127511},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3626":75149,"_31300":75047,"_21660":127513,"_5":14907,"_28477":127251,"_3077":127514},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3626":75150,"_31300":75047,"_21660":127516,"_5":14907,"_28477":127251,"_3077":127517},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3626":75151,"_31300":75047,"_21660":127519,"_5":14907,"_28477":127251,"_3077":127520},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3626":75152,"_31300":75047,"_21660":127522,"_5":14907,"_28477":127251,"_3077":127523},[],"La CRL no cambia tras revocar un certificado.",{"_3626":75153,"_31300":75047,"_21660":127525,"_5":14907,"_28477":127251,"_3077":127526},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3626":75154,"_31300":75047,"_21660":127528,"_5":14907,"_28477":127251,"_3077":127529},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3626":75155,"_31300":75047,"_21660":127531,"_5":14907,"_28477":127251,"_3077":127532},[],"Un verificador rechaza la CRL por el emisor.",{"_3626":75156,"_31300":75047,"_21660":127534,"_5":14907,"_28477":127251,"_3077":127535},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3626":75157,"_31300":75047,"_21660":127537,"_5":14907,"_28477":127251,"_3077":127538},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3626":75158,"_31300":75047,"_21660":127540,"_5":14907,"_28477":127255,"_3077":127541},[],"RFC 5280: perfil X.509 y CRL.",{"_3626":75159,"_31300":75047,"_21660":127543,"_5":14907,"_28477":127255,"_3077":58278},[],{"_3626":75160,"_31300":75047,"_21660":127545,"_5":14907,"_28477":127255,"_3077":58281},[],{"_3626":75161,"_31300":75047,"_21660":127547,"_5":14907,"_28477":127255,"_3077":127548},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3626":75162,"_31300":75047,"_21660":127550,"_5":14907,"_28477":127255,"_3077":127551},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3626":75163,"_31300":75163,"_5":15267,"_3077":127553,"_31659":127554,"_21660":127555,"_28477":75163},"Claves y motores criptográficos",[51072,122019,56761,126044],[],{"_3626":75164,"_31300":75163,"_21660":127557,"_5":14907,"_28477":75163,"_3077":127558},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3626":75165,"_31300":75163,"_5":31656,"_21660":127560,"_28477":127561,"_3077":127562},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3626":75166,"_31300":75163,"_5":31656,"_21660":127564,"_28477":127565,"_3077":127566},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3626":75167,"_31300":75163,"_5":31656,"_21660":127568,"_28477":127569,"_3077":58306},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#file-system",{"_3626":75168,"_31300":75163,"_5":31656,"_21660":127571,"_28477":127572,"_3077":58310},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#hashicorp-vault",{"_3626":75169,"_31300":75163,"_5":31656,"_21660":127574,"_28477":127575,"_3077":58314},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#aws-secrets-manager",{"_3626":75170,"_31300":75163,"_5":31656,"_21660":127577,"_28477":127578,"_3077":58318},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#aws-kms",{"_3626":75171,"_31300":75163,"_5":31656,"_21660":127580,"_28477":127581,"_3077":58322},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#pkcs11",{"_3626":75172,"_31300":75163,"_5":31656,"_21660":127583,"_28477":127584,"_3077":58326},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#azure-key-vault",{"_3626":75173,"_31300":75163,"_5":31656,"_21660":127586,"_28477":127587,"_3077":127588},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3626":75174,"_31300":75163,"_5":31656,"_21660":127590,"_28477":127591,"_3077":127592},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3626":75175,"_31300":75163,"_5":31656,"_21660":127594,"_28477":127595,"_3077":127596},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3626":75176,"_31300":75163,"_5":31656,"_21660":127598,"_28477":127599,"_3077":127600},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3626":75177,"_31300":75163,"_5":31656,"_21660":127602,"_28477":127603,"_3077":127604},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3626":75178,"_31300":75163,"_5":31656,"_21660":127606,"_28477":127607,"_3077":127608},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3626":75179,"_31300":75163,"_5":31656,"_21660":127610,"_28477":127611,"_3077":127612},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3626":75180,"_31300":75163,"_5":31656,"_21660":127614,"_28477":127615,"_3077":58358},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#sign",{"_3626":75181,"_31300":75163,"_5":31656,"_21660":127617,"_28477":127618,"_3077":58362},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#verify",{"_3626":75182,"_31300":75163,"_5":31656,"_21660":127620,"_28477":127621,"_3077":127622},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3626":75183,"_31300":75163,"_5":31656,"_21660":127624,"_28477":127625,"_3077":127626},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3626":75184,"_31300":75163,"_5":31656,"_21660":127628,"_28477":127629,"_3077":127630},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3626":75185,"_31300":75163,"_21660":127632,"_5":14907,"_28477":75163,"_3077":127633},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3626":75186,"_31300":75163,"_21660":127635,"_5":14907,"_28477":75163,"_3077":127636},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3626":75187,"_31300":75163,"_21660":127638,"_5":14907,"_28477":127561,"_3077":127639},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3626":75188,"_31300":75163,"_21660":127641,"_5":14907,"_28477":127561,"_3077":127642},[],"En la práctica, permite:",{"_3626":75189,"_31300":75163,"_21660":127644,"_5":14907,"_28477":127561,"_3077":127645},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3626":75190,"_31300":75163,"_21660":127647,"_5":14907,"_28477":127561,"_3077":127648},[],"Importar claves creadas externamente.",{"_3626":75191,"_31300":75163,"_21660":127650,"_5":14907,"_28477":127561,"_3077":127651},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3626":75192,"_31300":75163,"_21660":127653,"_5":14907,"_28477":127561,"_3077":127654},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3626":75193,"_31300":75163,"_21660":127656,"_5":14907,"_28477":127565,"_3077":127657},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3626":75194,"_31300":75163,"_21660":127659,"_5":14907,"_28477":127565,"_3077":127660},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3626":75195,"_31300":75163,"_21660":127662,"_5":14907,"_28477":127565,"_3077":127663},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3626":75196,"_31300":75163,"_21660":127665,"_5":14907,"_28477":127569,"_3077":127666},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3626":75197,"_31300":75163,"_21660":127668,"_5":14907,"_28477":127572,"_3077":127669},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3626":75198,"_31300":75163,"_21660":127671,"_5":14907,"_28477":127572,"_3077":127672},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3626":75199,"_31300":75163,"_21660":127674,"_5":14907,"_28477":127575,"_3077":127675},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3626":75200,"_31300":75163,"_21660":127677,"_5":14907,"_28477":127578,"_3077":127678},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3626":75201,"_31300":75163,"_21660":127680,"_5":14907,"_28477":127581,"_3077":127681},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3626":75202,"_31300":75163,"_21660":127683,"_5":14907,"_28477":127584,"_3077":127684},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3626":75203,"_31300":75163,"_21660":127686,"_5":14907,"_28477":127584,"_3077":127687},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3626":75204,"_31300":75163,"_21660":127689,"_5":14907,"_28477":127584,"_3077":127690},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3626":75205,"_31300":75163,"_21660":127692,"_5":14907,"_28477":127584,"_3077":127693},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3626":75206,"_31300":75163,"_21660":127695,"_5":14907,"_28477":127587,"_3077":127696},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3626":75207,"_31300":75163,"_21660":127698,"_5":14907,"_28477":127587,"_3077":127699},[],"La tabla incluye los siguientes campos:",{"_3626":75208,"_31300":75163,"_21660":127701,"_5":14907,"_28477":127587,"_3077":127702},[],"**Name**: nombre descriptivo de la clave.",{"_3626":75209,"_31300":75163,"_21660":127704,"_5":14907,"_28477":127587,"_3077":127705},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3626":75210,"_31300":75163,"_21660":127707,"_5":14907,"_28477":127587,"_3077":127708},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3626":75211,"_31300":75163,"_21660":127710,"_5":14907,"_28477":127587,"_3077":127711},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3626":75212,"_31300":75163,"_21660":127713,"_5":14907,"_28477":127587,"_3077":127714},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3626":75213,"_31300":75163,"_21660":127716,"_5":14907,"_28477":127587,"_3077":127717},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3626":75214,"_31300":75163,"_21660":127719,"_5":14907,"_28477":127587,"_3077":127720},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3626":75215,"_31300":75163,"_21660":127722,"_5":14907,"_28477":127587,"_3077":127723},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3626":75216,"_31300":75163,"_21660":127725,"_5":14907,"_28477":127587,"_3077":127726},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3626":75217,"_31300":75163,"_21660":127728,"_5":14907,"_28477":127587,"_3077":127729},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3626":75218,"_31300":75163,"_21660":127731,"_5":14907,"_28477":127587,"_3077":127732},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3626":75219,"_31300":75163,"_21660":127734,"_5":14907,"_28477":127587,"_3077":127735},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3626":75220,"_31300":75163,"_21660":127737,"_5":14907,"_28477":127587,"_3077":127738},[],"**Delete Key** para eliminar la clave del sistema.",{"_3626":75221,"_31300":75163,"_21660":127740,"_5":14907,"_28477":127591,"_3077":127741},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3626":75222,"_31300":75163,"_21660":127743,"_5":14907,"_28477":127595,"_3077":127744},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3626":75223,"_31300":75163,"_21660":127746,"_5":14907,"_28477":127595,"_3077":127747},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3626":75224,"_31300":75163,"_21660":127749,"_5":14907,"_28477":127595,"_3077":127750},[],"**Key Name**: nombre único y descriptivo.",{"_3626":75225,"_31300":75163,"_21660":127752,"_5":14907,"_28477":127595,"_3077":127753},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3626":75226,"_31300":75163,"_21660":127755,"_5":14907,"_28477":127595,"_3077":127756},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3626":75227,"_31300":75163,"_21660":127758,"_5":14907,"_28477":127595,"_3077":127759},[],"**Tags**: metadatos para clasificar la clave.",{"_3626":75228,"_31300":75163,"_21660":127761,"_5":14907,"_28477":127595,"_3077":127762},[],"**Metadata**: información adicional para usos avanzados.",{"_3626":75229,"_31300":75163,"_21660":127764,"_5":14907,"_28477":127599,"_3077":127765},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3626":75230,"_31300":75163,"_21660":127767,"_5":14907,"_28477":127599,"_3077":127768},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3626":75231,"_31300":75163,"_21660":127770,"_5":14907,"_28477":127599,"_3077":127771},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3626":75232,"_31300":75163,"_21660":127773,"_5":14907,"_28477":127599,"_3077":127774},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3626":75233,"_31300":75163,"_21660":127776,"_5":14907,"_28477":127599,"_3077":127777},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3626":75234,"_31300":75163,"_21660":127779,"_5":14907,"_28477":127599,"_3077":127780},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3626":75235,"_31300":75163,"_21660":127782,"_5":14907,"_28477":127599,"_3077":127783},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3626":75236,"_31300":75163,"_21660":127785,"_5":14907,"_28477":127599,"_3077":127786},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3626":75237,"_31300":75163,"_21660":127788,"_5":14907,"_28477":127599,"_3077":127789},[],"**Metadata**: información adicional opcional.",{"_3626":75238,"_31300":75163,"_21660":127791,"_5":14907,"_28477":127599,"_3077":127792},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3626":75239,"_31300":75163,"_21660":127794,"_5":14907,"_28477":127599,"_3077":127795},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3626":75240,"_31300":75163,"_21660":127797,"_5":14907,"_28477":127603,"_3077":127798},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3626":75241,"_31300":75163,"_21660":127800,"_5":14907,"_28477":127607,"_3077":127801},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3626":75242,"_31300":75163,"_21660":127803,"_5":14907,"_28477":127607,"_3077":127804},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3626":75243,"_31300":75163,"_21660":127806,"_5":14907,"_28477":127607,"_3077":127807},[],"**Key Name**: nombre descriptivo.",{"_3626":75244,"_31300":75163,"_21660":127809,"_5":14907,"_28477":127607,"_3077":127810},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3626":75245,"_31300":75163,"_21660":127812,"_5":14907,"_28477":127607,"_3077":127813},[],"**Tags**: etiquetas asociadas.",{"_3626":75246,"_31300":75163,"_21660":127815,"_5":14907,"_28477":127607,"_3077":127816},[],"**Aliases**: nombres alternativos.",{"_3626":75247,"_31300":75163,"_21660":127818,"_5":14907,"_28477":127607,"_3077":127819},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3626":75248,"_31300":75163,"_21660":127821,"_5":14907,"_28477":127607,"_3077":127822},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3626":75249,"_31300":75163,"_21660":127824,"_5":14907,"_28477":127607,"_3077":127825},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3626":75250,"_31300":75163,"_21660":127827,"_5":14907,"_28477":127607,"_3077":127828},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3626":75251,"_31300":75163,"_21660":127830,"_5":14907,"_28477":127611,"_3077":127831},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3626":75252,"_31300":75163,"_21660":127833,"_5":14907,"_28477":127611,"_3077":127834},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3626":75253,"_31300":75163,"_21660":127836,"_5":14907,"_28477":127611,"_3077":127837},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3626":75254,"_31300":75163,"_21660":127839,"_5":14907,"_28477":127615,"_3077":127840},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3626":75255,"_31300":75163,"_21660":127842,"_5":14907,"_28477":127615,"_3077":127843},[],"Campos principales:",{"_3626":75256,"_31300":75163,"_21660":127845,"_5":14907,"_28477":127615,"_3077":127846},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3626":75257,"_31300":75163,"_21660":127848,"_5":14907,"_28477":127615,"_3077":127849},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3626":75258,"_31300":75163,"_21660":127851,"_5":14907,"_28477":127615,"_3077":127852},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3626":75259,"_31300":75163,"_21660":127854,"_5":14907,"_28477":127615,"_3077":127855},[],"**Message**: contenido que se va a firmar.",{"_3626":75260,"_31300":75163,"_21660":127857,"_5":14907,"_28477":127615,"_3077":127858},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3626":75261,"_31300":75163,"_21660":127860,"_5":14907,"_28477":127618,"_3077":127861},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3626":75262,"_31300":75163,"_21660":127863,"_5":14907,"_28477":127618,"_3077":127843},[],{"_3626":75263,"_31300":75163,"_21660":127865,"_5":14907,"_28477":127618,"_3077":127866},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3626":75264,"_31300":75163,"_21660":127868,"_5":14907,"_28477":127618,"_3077":127869},[],"**Message Type**: `Raw` o `Digest`.",{"_3626":75265,"_31300":75163,"_21660":127871,"_5":14907,"_28477":127618,"_3077":127872},[],"**Payload Encoding**: codificación del mensaje.",{"_3626":75266,"_31300":75163,"_21660":127874,"_5":14907,"_28477":127618,"_3077":127875},[],"**Message**: mensaje original o hash.",{"_3626":75267,"_31300":75163,"_21660":127877,"_5":14907,"_28477":127618,"_3077":127878},[],"**Signature**: firma que se desea comprobar.",{"_3626":75268,"_31300":75163,"_21660":127880,"_5":14907,"_28477":127618,"_3077":127881},[],"**Result**: indicador del resultado de la validación.",{"_3626":75269,"_31300":75163,"_21660":127883,"_5":14907,"_28477":127621,"_3077":127884},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3626":75270,"_31300":75163,"_21660":127886,"_5":14907,"_28477":127621,"_3077":127887},[],"Este flujo es útil para:",{"_3626":75271,"_31300":75163,"_21660":127889,"_5":14907,"_28477":127621,"_3077":127890},[],"Solicitar certificados a una CA externa.",{"_3626":75272,"_31300":75163,"_21660":127892,"_5":14907,"_28477":127621,"_3077":127893},[],"Renovar una identidad manteniendo la misma clave.",{"_3626":75273,"_31300":75163,"_21660":127895,"_5":14907,"_28477":127621,"_3077":127896},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3626":75274,"_31300":75163,"_21660":127898,"_5":14907,"_28477":127621,"_3077":127899},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3626":75275,"_31300":75163,"_21660":127901,"_5":14907,"_28477":127621,"_3077":127902},[],"**Organization (O)**: organización o empresa.",{"_3626":75276,"_31300":75163,"_21660":127904,"_5":14907,"_28477":127621,"_3077":127905},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3626":75277,"_31300":75163,"_21660":127907,"_5":14907,"_28477":127621,"_3077":127908},[],"**Country (C)**: código de país de dos letras.",{"_3626":75278,"_31300":75163,"_21660":127910,"_5":14907,"_28477":127621,"_3077":127911},[],"**State / Province (ST)**: estado o provincia.",{"_3626":75279,"_31300":75163,"_21660":127913,"_5":14907,"_28477":127621,"_3077":127914},[],"**Locality (L)**: ciudad o localidad.",{"_3626":75280,"_31300":75163,"_21660":127916,"_5":14907,"_28477":127621,"_3077":127917},[],"**Email Address**: correo de contacto.",{"_3626":75281,"_31300":75163,"_21660":127919,"_5":14907,"_28477":127621,"_3077":127920},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3626":75282,"_31300":75163,"_21660":127922,"_5":14907,"_28477":127621,"_3077":127923},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3626":75283,"_31300":75163,"_21660":127925,"_5":14907,"_28477":127625,"_3077":127926},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3626":75284,"_31300":75163,"_21660":127928,"_5":14907,"_28477":127625,"_3077":127929},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3626":75285,"_31300":75163,"_21660":127931,"_5":14907,"_28477":127629,"_3077":127932},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3626":75286,"_31300":75163,"_21660":127934,"_5":14907,"_28477":127629,"_3077":127935},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3626":75287,"_31300":75287,"_5":15267,"_3077":127937,"_31659":127938,"_21660":127939,"_28477":75287},"Validación online con OCSP",[51072,122019,56761,126693],[],{"_3626":75288,"_31300":75287,"_21660":127941,"_5":14907,"_28477":75287,"_3077":127942},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3626":75289,"_31300":75287,"_5":31656,"_21660":127944,"_28477":127945,"_3077":127946},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3626":75290,"_31300":75287,"_5":31656,"_21660":127948,"_28477":127949,"_3077":127950},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3626":75291,"_31300":75287,"_5":31656,"_21660":127952,"_28477":127953,"_3077":127954},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3626":75292,"_31300":75287,"_5":31656,"_21660":127956,"_28477":127957,"_3077":127958},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3626":75293,"_31300":75287,"_5":31656,"_21660":127960,"_28477":127961,"_3077":127962},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3626":75294,"_31300":75287,"_5":31656,"_21660":127964,"_28477":127965,"_3077":127256},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#referencias",{"_3626":75295,"_31300":75287,"_21660":127967,"_5":14907,"_28477":75287,"_3077":127968},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3626":75296,"_31300":75287,"_21660":127970,"_5":14907,"_28477":127945,"_3077":127971},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3626":75297,"_31300":75287,"_21660":127973,"_5":14907,"_28477":127945,"_3077":127974},[],"Estado del registro",{"_3626":75298,"_31300":75287,"_21660":127976,"_5":14907,"_28477":127945,"_3077":127977},[],"Respuesta firmada",{"_3626":75299,"_31300":75287,"_21660":127979,"_5":14907,"_28477":127945,"_3077":55898},[],{"_3626":75300,"_31300":75287,"_21660":127981,"_5":14907,"_28477":127945,"_3077":58726},[],{"_3626":75301,"_31300":75287,"_21660":127983,"_5":14907,"_28477":127945,"_3077":55915},[],{"_3626":75302,"_31300":75287,"_21660":127985,"_5":14907,"_28477":127945,"_3077":127986},[],"`Revoked`, con razón y fecha de revocación.",{"_3626":75303,"_31300":75287,"_21660":127988,"_5":14907,"_28477":127945,"_3077":127989},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3626":75304,"_31300":75287,"_21660":127991,"_5":14907,"_28477":127945,"_3077":127992},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3626":75305,"_31300":75287,"_21660":127994,"_5":14907,"_28477":127945,"_3077":127995},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3626":75306,"_31300":75287,"_21660":127997,"_5":14907,"_28477":127945,"_3077":127998},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3626":75307,"_31300":75287,"_21660":128000,"_5":14907,"_28477":127945,"_3077":128001},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3626":75308,"_31300":75287,"_21660":128003,"_5":14907,"_28477":127949,"_3077":128004},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3626":75309,"_31300":75287,"_21660":128006,"_5":14907,"_28477":127949,"_3077":128007},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3626":75310,"_31300":75287,"_21660":128009,"_5":14907,"_28477":127953,"_3077":128010},[],"El servicio acepta:",{"_3626":75311,"_31300":75287,"_21660":128012,"_5":14907,"_28477":127953,"_3077":123897},[],{"_3626":75312,"_31300":75287,"_21660":128014,"_5":14907,"_28477":127953,"_3077":128015},[],"Ruta del servicio VA",{"_3626":75313,"_31300":75287,"_21660":128017,"_5":14907,"_28477":127953,"_3077":128018},[],"Formato",{"_3626":75314,"_31300":75287,"_21660":128020,"_5":14907,"_28477":127953,"_3077":58766},[],{"_3626":75315,"_31300":75287,"_21660":128022,"_5":14907,"_28477":127953,"_3077":58769},[],{"_3626":75316,"_31300":75287,"_21660":128024,"_5":14907,"_28477":127953,"_3077":128025},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3626":75317,"_31300":75287,"_21660":128027,"_5":14907,"_28477":127953,"_3077":58161},[],{"_3626":75318,"_31300":75287,"_21660":128029,"_5":14907,"_28477":127953,"_3077":58777},[],{"_3626":75319,"_31300":75287,"_21660":128031,"_5":14907,"_28477":127953,"_3077":128032},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3626":75320,"_31300":75287,"_21660":128034,"_5":14907,"_28477":127953,"_3077":128035},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3626":75321,"_31300":75287,"_21660":128037,"_5":14907,"_28477":127957,"_3077":128038},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3626":75322,"_31300":75287,"_21660":128040,"_5":14907,"_28477":127957,"_3077":128041},[],"Genera la solicitud:",{"_3626":75323,"_31300":75287,"_21660":128043,"_5":14907,"_28477":127957,"_3077":128044},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3626":75324,"_31300":75287,"_21660":128046,"_5":14907,"_28477":127957,"_3077":128047},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3626":75325,"_31300":75287,"_21660":128049,"_5":14907,"_28477":127957,"_3077":128050},[],"Verifica el DER recibido:",{"_3626":75326,"_31300":75287,"_21660":128052,"_5":14907,"_28477":127957,"_3077":128053},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3626":75327,"_31300":75287,"_21660":128055,"_5":14907,"_28477":127961,"_3077":128056},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3626":75328,"_31300":75287,"_21660":128058,"_5":14907,"_28477":127961,"_3077":128059},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3626":75329,"_31300":75287,"_21660":128061,"_5":14907,"_28477":127965,"_3077":58810},[],{"_3626":75330,"_31300":75287,"_21660":128063,"_5":14907,"_28477":127965,"_3077":58813},[],{"_3626":75331,"_31300":75287,"_21660":128065,"_5":14907,"_28477":127965,"_3077":128066},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3626":75332,"_31300":75287,"_21660":128068,"_5":14907,"_28477":127965,"_3077":127551},[],{"_3626":75333,"_31300":75333,"_5":15267,"_3077":56761,"_31659":128070,"_21660":128071,"_28477":75333},[51072,122019,56761],[],{"_3626":75334,"_31300":75333,"_21660":128073,"_5":14907,"_28477":75333,"_3077":128074},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3626":75335,"_31300":75333,"_5":31656,"_21660":128076,"_28477":128077,"_3077":125370},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#empieza-aquí",{"_3626":75336,"_31300":75333,"_5":31656,"_21660":128079,"_28477":128080,"_3077":128081},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3626":75337,"_31300":75333,"_5":31656,"_21660":128083,"_28477":128084,"_3077":125890},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#capacidades-principales",{"_3626":75338,"_31300":75333,"_5":31656,"_21660":128086,"_28477":128087,"_3077":125894},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3626":75339,"_31300":75333,"_5":31656,"_21660":128089,"_28477":128090,"_3077":125898},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3626":75340,"_31300":75333,"_5":31656,"_21660":128092,"_28477":128093,"_3077":125902},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#emite-y-controla-certificados",{"_3626":75341,"_31300":75333,"_5":31656,"_21660":128095,"_28477":128096,"_3077":125910},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#publica-el-estado-de-validación",{"_3626":75342,"_31300":75333,"_5":31656,"_21660":128098,"_28477":128099,"_3077":128100},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3626":75343,"_31300":75333,"_5":31656,"_21660":128102,"_28477":128103,"_3077":126859},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#continúa",{"_3626":75344,"_31300":75333,"_21660":128105,"_5":14907,"_28477":75333,"_3077":128106},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3626":75345,"_31300":75333,"_21660":128108,"_5":14907,"_28477":128077,"_3077":128109},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3626":75346,"_31300":75333,"_21660":128111,"_5":14907,"_28477":128077,"_3077":128112},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3626":75347,"_31300":75333,"_21660":128114,"_5":14907,"_28477":128080,"_3077":128115},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3626":75348,"_31300":75333,"_21660":128117,"_5":14907,"_28477":128080,"_3077":128118},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3626":75349,"_31300":75333,"_21660":128120,"_5":14907,"_28477":128080,"_3077":128121},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3626":75350,"_31300":75333,"_21660":128123,"_5":14907,"_28477":128080,"_3077":128124},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3626":75351,"_31300":75333,"_21660":128126,"_5":14907,"_28477":128080,"_3077":128127},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3626":75352,"_31300":75333,"_21660":128129,"_5":14907,"_28477":128087,"_3077":128130},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3626":75353,"_31300":75333,"_21660":128132,"_5":14907,"_28477":128090,"_3077":128133},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3626":75354,"_31300":75333,"_21660":128135,"_5":14907,"_28477":128093,"_3077":128136},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3626":75355,"_31300":75333,"_21660":128138,"_5":14907,"_28477":128096,"_3077":128139},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3626":75356,"_31300":75333,"_21660":128141,"_5":14907,"_28477":128099,"_3077":128142},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3626":75357,"_31300":75333,"_21660":128144,"_5":14907,"_28477":128099,"_3077":128145},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3626":75358,"_31300":75333,"_21660":128147,"_5":14907,"_28477":128099,"_3077":128148},[],"su clave pública corresponda a la clave privada del cliente;",{"_3626":75359,"_31300":75333,"_21660":128150,"_5":14907,"_28477":128099,"_3077":128151},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3626":75360,"_31300":75333,"_21660":128153,"_5":14907,"_28477":128099,"_3077":128154},[],"sus fechas y usos permitan la operación;",{"_3626":75361,"_31300":75333,"_21660":128156,"_5":14907,"_28477":128099,"_3077":128157},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3626":75362,"_31300":75333,"_21660":128159,"_5":14907,"_28477":128099,"_3077":128160},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3626":75363,"_31300":75333,"_21660":128162,"_5":14907,"_28477":128103,"_3077":128163},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3626":75364,"_31300":75333,"_21660":128165,"_5":14907,"_28477":128103,"_3077":128166},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3626":75365,"_31300":75333,"_21660":128168,"_5":14907,"_28477":128103,"_3077":128169},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3626":75366,"_31300":75366,"_5":15267,"_3077":128171,"_31659":128172,"_21660":128173,"_28477":75366},"Crea tu primera CA",[51072,122019,56761,125494],[],{"_3626":75367,"_31300":75366,"_21660":128175,"_5":14907,"_28477":75366,"_3077":128176},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3626":75368,"_31300":75366,"_5":31656,"_21660":128178,"_28477":128179,"_3077":120553},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3626":75369,"_31300":75366,"_5":31656,"_21660":128181,"_28477":128182,"_3077":128183},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3626":75370,"_31300":75366,"_5":31656,"_21660":128185,"_28477":128186,"_3077":128187},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3626":75371,"_31300":75366,"_5":31656,"_21660":128189,"_28477":128190,"_3077":128191},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3626":75372,"_31300":75366,"_5":31656,"_21660":128193,"_28477":128194,"_3077":128195},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3626":75373,"_31300":75366,"_5":31656,"_21660":128197,"_28477":128198,"_3077":128199},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3626":75374,"_31300":75366,"_5":31656,"_21660":128201,"_28477":128202,"_3077":128203},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3626":75375,"_31300":75366,"_5":31656,"_21660":128205,"_28477":128206,"_3077":125741},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3626":75376,"_31300":75366,"_5":31656,"_21660":128208,"_28477":128209,"_3077":120577},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3626":75377,"_31300":75366,"_21660":128211,"_5":14907,"_28477":75366,"_3077":128212},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3626":75378,"_31300":75366,"_21660":128214,"_5":14907,"_28477":128179,"_3077":128215},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3626":75379,"_31300":75366,"_21660":128217,"_5":14907,"_28477":128179,"_3077":128218},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3626":75380,"_31300":75366,"_21660":128220,"_5":14907,"_28477":128179,"_3077":128221},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3626":75381,"_31300":75366,"_21660":128223,"_5":14907,"_28477":128179,"_3077":128224},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3626":75382,"_31300":75366,"_21660":128226,"_5":14907,"_28477":128182,"_3077":128227},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3626":75383,"_31300":75366,"_21660":128229,"_5":14907,"_28477":128182,"_3077":128230},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3626":75384,"_31300":75366,"_21660":128232,"_5":14907,"_28477":128186,"_3077":128233},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3626":75385,"_31300":75366,"_21660":128235,"_5":14907,"_28477":128186,"_3077":128236},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3626":75386,"_31300":75366,"_21660":128238,"_5":14907,"_28477":128190,"_3077":128239},[],"Selecciona **Root CA** y completa:",{"_3626":75387,"_31300":75366,"_21660":128241,"_5":14907,"_28477":128190,"_3077":58992},[],{"_3626":75388,"_31300":75366,"_21660":128243,"_5":14907,"_28477":128190,"_3077":128244},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3626":75389,"_31300":75366,"_21660":128246,"_5":14907,"_28477":128190,"_3077":128247},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3626":75390,"_31300":75366,"_21660":128249,"_5":14907,"_28477":128190,"_3077":128250},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3626":75391,"_31300":75366,"_21660":128252,"_5":14907,"_28477":128190,"_3077":128253},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3626":75392,"_31300":75366,"_21660":128255,"_5":14907,"_28477":128194,"_3077":128256},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3626":75393,"_31300":75366,"_21660":128258,"_5":14907,"_28477":128198,"_3077":128259},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3626":75394,"_31300":75366,"_21660":128261,"_5":14907,"_28477":128198,"_3077":128262},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3626":75395,"_31300":75366,"_21660":128264,"_5":14907,"_28477":128202,"_3077":128265},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3626":75396,"_31300":75366,"_21660":128267,"_5":14907,"_28477":128202,"_3077":128268},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3626":75397,"_31300":75366,"_21660":128270,"_5":14907,"_28477":128202,"_3077":128271},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3626":75398,"_31300":75366,"_21660":128273,"_5":14907,"_28477":128206,"_3077":128274},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3626":75399,"_31300":75366,"_21660":128276,"_5":14907,"_28477":128206,"_3077":128277},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3626":75400,"_31300":75366,"_21660":128279,"_5":14907,"_28477":128206,"_3077":128280},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3626":75401,"_31300":75366,"_21660":128282,"_5":14907,"_28477":128206,"_3077":128283},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3626":75402,"_31300":75366,"_21660":128285,"_5":14907,"_28477":128209,"_3077":128286},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3626":75403,"_31300":75403,"_5":15267,"_3077":128288,"_31659":128289,"_21660":128290,"_28477":75403},"Emite y verifica un certificado",[51072,122019,56761,125494],[],{"_3626":75404,"_31300":75403,"_21660":128292,"_5":14907,"_28477":75403,"_3077":128293},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3626":75405,"_31300":75403,"_5":31656,"_21660":128295,"_28477":128296,"_3077":120553},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3626":75406,"_31300":75403,"_5":31656,"_21660":128298,"_28477":128299,"_3077":128300},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3626":75407,"_31300":75403,"_5":31656,"_21660":128302,"_28477":128303,"_3077":128304},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3626":75408,"_31300":75403,"_5":31656,"_21660":128306,"_28477":128307,"_3077":128308},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3626":75409,"_31300":75403,"_5":31656,"_21660":128310,"_28477":128311,"_3077":128312},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3626":75410,"_31300":75403,"_5":31656,"_21660":128314,"_28477":128315,"_3077":128316},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3626":75411,"_31300":75403,"_5":31656,"_21660":128318,"_28477":128319,"_3077":128320},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3626":75412,"_31300":75403,"_5":31656,"_21660":128322,"_28477":128323,"_3077":128324},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3626":75413,"_31300":75403,"_5":31656,"_21660":128326,"_28477":128327,"_3077":128328},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3626":75414,"_31300":75403,"_5":31656,"_21660":128330,"_28477":128331,"_3077":128332},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3626":75415,"_31300":75403,"_5":31656,"_21660":128334,"_28477":128335,"_3077":125741},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3626":75416,"_31300":75403,"_5":31656,"_21660":128337,"_28477":128338,"_3077":120577},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3626":75417,"_31300":75403,"_21660":128340,"_5":14907,"_28477":75403,"_3077":128341},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3626":75418,"_31300":75403,"_21660":128343,"_5":14907,"_28477":128296,"_3077":128344},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3626":75419,"_31300":75403,"_21660":128346,"_5":14907,"_28477":128296,"_3077":128347},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3626":75420,"_31300":75403,"_21660":128349,"_5":14907,"_28477":128296,"_3077":128350},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3626":75421,"_31300":75403,"_21660":128352,"_5":14907,"_28477":128296,"_3077":128353},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3626":75422,"_31300":75403,"_21660":128355,"_5":14907,"_28477":128296,"_3077":128356},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3626":75423,"_31300":75403,"_21660":128358,"_5":14907,"_28477":128299,"_3077":128359},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3626":75424,"_31300":75403,"_21660":128361,"_5":14907,"_28477":128303,"_3077":128362},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3626":75425,"_31300":75403,"_21660":128364,"_5":14907,"_28477":128303,"_3077":128365},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3626":75426,"_31300":75403,"_21660":128367,"_5":14907,"_28477":128307,"_3077":128368},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3626":75427,"_31300":75403,"_21660":128370,"_5":14907,"_28477":128307,"_3077":128371},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3626":75428,"_31300":75403,"_21660":128373,"_5":14907,"_28477":128311,"_3077":128374},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3626":75429,"_31300":75403,"_21660":128376,"_5":14907,"_28477":128311,"_3077":128377},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3626":75430,"_31300":75403,"_21660":128379,"_5":14907,"_28477":128315,"_3077":128380},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3626":75431,"_31300":75403,"_21660":128382,"_5":14907,"_28477":128319,"_3077":128383},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3626":75432,"_31300":75403,"_21660":128385,"_5":14907,"_28477":128323,"_3077":128386},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3626":75433,"_31300":75403,"_21660":128388,"_5":14907,"_28477":128327,"_3077":128389},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3626":75434,"_31300":75403,"_21660":128391,"_5":14907,"_28477":128327,"_3077":128392},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3626":75435,"_31300":75403,"_21660":128394,"_5":14907,"_28477":128327,"_3077":128395},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3626":75436,"_31300":75403,"_21660":128397,"_5":14907,"_28477":128331,"_3077":128398},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3626":75437,"_31300":75403,"_21660":128400,"_5":14907,"_28477":128331,"_3077":128401},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3626":75438,"_31300":75403,"_21660":128403,"_5":14907,"_28477":128331,"_3077":128404},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3626":75439,"_31300":75403,"_21660":128406,"_5":14907,"_28477":128335,"_3077":125824},[],{"_3626":75440,"_31300":75403,"_21660":128408,"_5":14907,"_28477":128335,"_3077":124339},[],{"_3626":75441,"_31300":75403,"_21660":128410,"_5":14907,"_28477":128335,"_3077":128411},[],"La CA rechaza la emisión",{"_3626":75442,"_31300":75403,"_21660":128413,"_5":14907,"_28477":128335,"_3077":128414},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3626":75443,"_31300":75403,"_21660":128416,"_5":14907,"_28477":128335,"_3077":128417},[],"Sujeto o usos diferentes",{"_3626":75444,"_31300":75403,"_21660":128419,"_5":14907,"_28477":128335,"_3077":128420},[],"Perfil aplicado y valores solicitados.",{"_3626":75445,"_31300":75403,"_21660":128422,"_5":14907,"_28477":128335,"_3077":128423},[],"No se encuentra el emisor",{"_3626":75446,"_31300":75403,"_21660":128425,"_5":14907,"_28477":128335,"_3077":128426},[],"CA descargada y cadena intermedia necesaria.",{"_3626":75447,"_31300":75403,"_21660":128428,"_5":14907,"_28477":128335,"_3077":128429},[],"Falla la vigencia",{"_3626":75448,"_31300":75403,"_21660":128431,"_5":14907,"_28477":128335,"_3077":128432},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3626":75449,"_31300":75403,"_21660":128434,"_5":14907,"_28477":128335,"_3077":128435},[],"Los resúmenes de clave difieren",{"_3626":75450,"_31300":75403,"_21660":128437,"_5":14907,"_28477":128335,"_3077":128438},[],"Archivos de certificado y clave de la misma emisión.",{"_3626":75451,"_31300":75403,"_21660":128440,"_5":14907,"_28477":128335,"_3077":128441},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3626":75452,"_31300":75403,"_21660":128443,"_5":14907,"_28477":128338,"_3077":128444},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3626":75453,"_31300":75403,"_21660":128446,"_5":14907,"_28477":128338,"_3077":128447},[],"Gestionar certificados para inspección, estado y revocación.",{"_3626":75454,"_31300":75403,"_21660":128449,"_5":14907,"_28477":128338,"_3077":128450},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3626":75455,"_31300":75403,"_21660":128452,"_5":14907,"_28477":128338,"_3077":128453},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3626":75456,"_31300":75403,"_21660":128455,"_5":14907,"_28477":128338,"_3077":128456},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3626":75457,"_31300":75457,"_5":15267,"_3077":128458,"_31659":128459,"_21660":128460,"_28477":75457},"Primeros pasos de PKI",[51072,122019,56761,125494],[],{"_3626":75458,"_31300":75457,"_21660":128462,"_5":14907,"_28477":75457,"_3077":128463},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3626":75459,"_31300":75457,"_5":31656,"_21660":128465,"_28477":128466,"_3077":120553},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3626":75460,"_31300":75457,"_5":31656,"_21660":128468,"_28477":128469,"_3077":128470},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3626":75461,"_31300":75457,"_5":31656,"_21660":128472,"_28477":128473,"_3077":125676},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3626":75462,"_31300":75457,"_5":31656,"_21660":128475,"_28477":128476,"_3077":128477},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3626":75463,"_31300":75457,"_21660":128479,"_5":14907,"_28477":75457,"_3077":128480},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3626":75464,"_31300":75457,"_21660":128482,"_5":14907,"_28477":128466,"_3077":128483},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3626":75465,"_31300":75457,"_21660":128485,"_5":14907,"_28477":128466,"_3077":128486},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3626":75466,"_31300":75457,"_21660":128488,"_5":14907,"_28477":128466,"_3077":128489},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3626":75467,"_31300":75457,"_21660":128491,"_5":14907,"_28477":128466,"_3077":128492},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3626":75468,"_31300":75457,"_21660":128494,"_5":14907,"_28477":128466,"_3077":128495},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3626":75469,"_31300":75457,"_21660":128497,"_5":14907,"_28477":128469,"_3077":128498},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3626":75470,"_31300":75457,"_21660":128500,"_5":14907,"_28477":128469,"_3077":128501},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3626":75471,"_31300":75457,"_21660":128503,"_5":14907,"_28477":128469,"_3077":128504},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3626":75472,"_31300":75457,"_21660":128506,"_5":14907,"_28477":128469,"_3077":128507},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3626":75473,"_31300":75457,"_21660":128509,"_5":14907,"_28477":128473,"_3077":128510},[],"Archivo o recurso",{"_3626":75474,"_31300":75457,"_21660":128512,"_5":14907,"_28477":128473,"_3077":125673},[],{"_3626":75475,"_31300":75457,"_21660":128514,"_5":14907,"_28477":128473,"_3077":128515},[],"CA raíz activa y `ca.pem`",{"_3626":75476,"_31300":75457,"_21660":128517,"_5":14907,"_28477":128473,"_3077":128518},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3626":75477,"_31300":75457,"_21660":128520,"_5":14907,"_28477":128473,"_3077":128521},[],"Certificado final y `device.crt`",{"_3626":75478,"_31300":75457,"_21660":128523,"_5":14907,"_28477":128473,"_3077":128524},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3626":75479,"_31300":75457,"_21660":128526,"_5":14907,"_28477":128473,"_3077":128527},[],"Clave privada `device.key`",{"_3626":75480,"_31300":75457,"_21660":128529,"_5":14907,"_28477":128473,"_3077":128530},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3626":75481,"_31300":75457,"_21660":128532,"_5":14907,"_28477":128473,"_3077":128533},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3626":75482,"_31300":75457,"_21660":128535,"_5":14907,"_28477":128476,"_3077":128536},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3626":75483,"_31300":75457,"_21660":128538,"_5":14907,"_28477":128476,"_3077":128539},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3626":75484,"_31300":75457,"_21660":128541,"_5":14907,"_28477":128476,"_3077":128542},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3626":75485,"_31300":75485,"_5":15267,"_3077":128544,"_31659":128545,"_21660":128547,"_28477":75485},"Resolución de problemas PKI",[51072,122019,56761,128546],"Resolución de problemas",[],{"_3626":75486,"_31300":75485,"_21660":128549,"_5":14907,"_28477":75485,"_3077":128550},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3626":75487,"_31300":75485,"_5":31656,"_21660":128552,"_28477":128553,"_3077":128554},[],"/docs/pr-preview/pr-78/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3626":75488,"_31300":75485,"_5":31656,"_21660":128556,"_28477":128557,"_3077":128558},[],"/docs/pr-preview/pr-78/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3626":75489,"_31300":75485,"_5":31656,"_21660":128560,"_28477":128561,"_3077":128562},[],"/docs/pr-preview/pr-78/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3626":75490,"_31300":75485,"_21660":128564,"_5":14907,"_28477":75485,"_3077":128565},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3626":75491,"_31300":75485,"_21660":128567,"_5":14907,"_28477":75485,"_3077":128568},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3626":75492,"_31300":75485,"_21660":128570,"_5":14907,"_28477":128553,"_3077":125673},[],{"_3626":75493,"_31300":75485,"_21660":128572,"_5":14907,"_28477":128553,"_3077":124339},[],{"_3626":75494,"_31300":75485,"_21660":128574,"_5":14907,"_28477":128553,"_3077":120577},[],{"_3626":75495,"_31300":75485,"_21660":128576,"_5":14907,"_28477":128553,"_3077":55603},[],{"_3626":75496,"_31300":75485,"_21660":128578,"_5":14907,"_28477":128553,"_3077":128579},[],"Existe, está activa y sus fechas son utilizables.",{"_3626":75497,"_31300":75485,"_21660":128581,"_5":14907,"_28477":128553,"_3077":128582},[],"Autoridades.",{"_3626":75498,"_31300":75485,"_21660":128584,"_5":14907,"_28477":128553,"_3077":128585},[],"Clave",{"_3626":75499,"_31300":75485,"_21660":128587,"_5":14907,"_28477":128553,"_3077":128588},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3626":75500,"_31300":75485,"_21660":128590,"_5":14907,"_28477":128553,"_3077":128591},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3626":75501,"_31300":75485,"_21660":128593,"_5":14907,"_28477":128553,"_3077":59346},[],{"_3626":75502,"_31300":75485,"_21660":128595,"_5":14907,"_28477":128553,"_3077":128596},[],"PEM correcto y firma verificable.",{"_3626":75503,"_31300":75485,"_21660":128598,"_5":14907,"_28477":128553,"_3077":59352},[],{"_3626":75504,"_31300":75485,"_21660":128600,"_5":14907,"_28477":128553,"_3077":128601},[],"Perfil",{"_3626":75505,"_31300":75485,"_21660":128603,"_5":14907,"_28477":128553,"_3077":128604},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3626":75506,"_31300":75485,"_21660":128606,"_5":14907,"_28477":128553,"_3077":128607},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3626":75507,"_31300":75485,"_21660":128609,"_5":14907,"_28477":128553,"_3077":125824},[],{"_3626":75508,"_31300":75485,"_21660":128611,"_5":14907,"_28477":128553,"_3077":128612},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3626":75509,"_31300":75485,"_21660":128614,"_5":14907,"_28477":128553,"_3077":128615},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3626":75510,"_31300":75485,"_21660":128617,"_5":14907,"_28477":128553,"_3077":128618},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3626":75511,"_31300":75485,"_21660":128620,"_5":14907,"_28477":128553,"_3077":128621},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3626":75512,"_31300":75485,"_21660":128623,"_5":14907,"_28477":128553,"_3077":128624},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3626":75513,"_31300":75485,"_21660":128626,"_5":14907,"_28477":128557,"_3077":128627},[],"Revisa cada frontera por separado:",{"_3626":75514,"_31300":75485,"_21660":128629,"_5":14907,"_28477":128557,"_3077":128630},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3626":75515,"_31300":75485,"_21660":128632,"_5":14907,"_28477":128557,"_3077":128633},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3626":75516,"_31300":75485,"_21660":128635,"_5":14907,"_28477":128557,"_3077":128636},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3626":75517,"_31300":75485,"_21660":128638,"_5":14907,"_28477":128557,"_3077":128639},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3626":75518,"_31300":75485,"_21660":128641,"_5":14907,"_28477":128557,"_3077":128642},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3626":75519,"_31300":75485,"_21660":128644,"_5":14907,"_28477":128557,"_3077":128645},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3626":75520,"_31300":75485,"_21660":128647,"_5":14907,"_28477":128561,"_3077":128648},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3626":75521,"_31300":75485,"_21660":128650,"_5":14907,"_28477":128561,"_3077":128651},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3626":75522,"_31300":75522,"_5":15267,"_3077":128653,"_31659":128654,"_21660":128655,"_28477":75522},"Seguridad",[51072],[],{"_3626":75523,"_31300":75522,"_21660":128657,"_5":14907,"_28477":75522,"_3077":128658},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3626":75524,"_31300":75522,"_5":31656,"_21660":128660,"_28477":128661,"_3077":128662},[],"/docs/pr-preview/pr-78/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3626":75525,"_31300":75522,"_5":31656,"_21660":128664,"_28477":128665,"_3077":128666},[],"/docs/pr-preview/pr-78/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3626":75526,"_31300":75522,"_5":31656,"_21660":128668,"_28477":128669,"_3077":128670},[],"/docs/pr-preview/pr-78/es/security#versiones-soportadas","Versiones soportadas",{"_3626":75527,"_31300":75522,"_5":31656,"_21660":128672,"_28477":128673,"_3077":128674},[],"/docs/pr-preview/pr-78/es/security#divulgación-responsable","Divulgación responsable",{"_3626":75528,"_31300":75522,"_21660":128676,"_5":14907,"_28477":75522,"_3077":128677},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3626":75529,"_31300":75522,"_21660":128679,"_5":14907,"_28477":128661,"_3077":128680},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3626":75530,"_31300":75522,"_21660":128682,"_5":14907,"_28477":128661,"_3077":128683},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3626":75531,"_31300":75522,"_21660":128685,"_5":14907,"_28477":128661,"_3077":15551},[],{"_3626":75532,"_31300":75522,"_21660":128687,"_5":14907,"_28477":128661,"_3077":15475},[],{"_3626":75533,"_31300":75522,"_21660":128689,"_5":14907,"_28477":128661,"_3077":15538},[],{"_3626":75534,"_31300":75522,"_21660":128691,"_5":14907,"_28477":128661,"_3077":128692},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3626":75535,"_31300":75522,"_21660":128694,"_5":14907,"_28477":128661,"_3077":128695},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3626":75536,"_31300":75522,"_21660":128697,"_5":14907,"_28477":128665,"_3077":128698},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3626":75537,"_31300":75522,"_21660":128700,"_5":14907,"_28477":128665,"_3077":128701},[],"No incluyas en el reporte:",{"_3626":75538,"_31300":75522,"_21660":128703,"_5":14907,"_28477":128665,"_3077":128704},[],"Credenciales, tokens o claves privadas",{"_3626":75539,"_31300":75522,"_21660":128706,"_5":14907,"_28477":128665,"_3077":128707},[],"Datos de clientes o información identificable de clientes",{"_3626":75540,"_31300":75522,"_21660":128709,"_5":14907,"_28477":128665,"_3077":128710},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3626":75541,"_31300":75522,"_21660":128712,"_5":14907,"_28477":128669,"_3077":128713},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3626":75542,"_31300":75522,"_21660":128715,"_5":14907,"_28477":128669,"_3077":128716},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3626":75543,"_31300":75522,"_21660":128718,"_5":14907,"_28477":128673,"_3077":128719},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3626":75544,"_31300":75522,"_21660":128721,"_5":14907,"_28477":128673,"_3077":128722},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3626":75545,"_31300":75522,"_21660":128724,"_5":14907,"_28477":128673,"_3077":128725},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3626":75546,"_31300":75522,"_21660":128727,"_5":14907,"_28477":128673,"_3077":128728},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3626":75547,"_31300":75522,"_21660":128730,"_5":14907,"_28477":128673,"_3077":128731},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3626":75548,"_31300":75548,"_5":15267,"_3077":128733,"_31659":128734,"_21660":128736,"_28477":75548},"3.8.0 a 4.0.0",[51072,128735],"Actualizaciones",[],{"_3626":75549,"_31300":75548,"_21660":128738,"_5":14907,"_28477":75548,"_3077":128739},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3626":75550,"_31300":75548,"_5":31656,"_21660":128741,"_28477":128742,"_3077":128743},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3626":75551,"_31300":75548,"_5":31656,"_21660":128745,"_28477":128746,"_3077":128747},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3626":75552,"_31300":75548,"_5":31656,"_21660":128749,"_28477":128750,"_3077":128751},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3626":75553,"_31300":75548,"_5":31656,"_21660":128753,"_28477":128754,"_3077":128755},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3626":75554,"_31300":75548,"_5":31656,"_21660":128757,"_28477":128758,"_3077":128759},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3626":75555,"_31300":75548,"_5":31656,"_21660":128761,"_28477":128762,"_3077":128763},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3626":75556,"_31300":75548,"_5":31656,"_21660":128765,"_28477":128766,"_3077":59521},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3626":75557,"_31300":75548,"_5":31656,"_21660":128768,"_28477":128769,"_3077":128770},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3626":75558,"_31300":75548,"_5":31656,"_21660":128772,"_28477":128773,"_3077":128774},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3626":75559,"_31300":75548,"_5":31656,"_21660":128776,"_28477":128777,"_3077":128778},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3626":75560,"_31300":75548,"_5":31656,"_21660":128780,"_28477":128781,"_3077":121148},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3626":75561,"_31300":75548,"_5":31656,"_21660":128783,"_28477":128784,"_3077":128785},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3626":75562,"_31300":75548,"_5":31656,"_21660":128787,"_28477":128788,"_3077":128789},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3626":75563,"_31300":75548,"_5":31656,"_21660":128791,"_28477":128792,"_3077":128793},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3626":75564,"_31300":75548,"_5":31656,"_21660":128795,"_28477":128796,"_3077":128797},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3626":75565,"_31300":75548,"_5":31656,"_21660":128799,"_28477":128800,"_3077":128801},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3626":75566,"_31300":75548,"_5":31656,"_21660":128803,"_28477":128804,"_3077":128805},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3626":75567,"_31300":75548,"_5":31656,"_21660":128807,"_28477":128808,"_3077":128809},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3626":75568,"_31300":75548,"_5":31656,"_21660":128811,"_28477":128812,"_3077":128813},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3626":75569,"_31300":75548,"_5":31656,"_21660":128815,"_28477":128816,"_3077":128817},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3626":75570,"_31300":75548,"_5":31656,"_21660":128819,"_28477":128820,"_3077":128821},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3626":75571,"_31300":75548,"_5":31656,"_21660":128823,"_28477":128824,"_3077":128825},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3626":75572,"_31300":75548,"_5":31656,"_21660":128827,"_28477":128828,"_3077":128829},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3626":75573,"_31300":75548,"_5":31656,"_21660":128831,"_28477":128832,"_3077":128833},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3626":75574,"_31300":75548,"_5":31656,"_21660":128835,"_28477":128836,"_3077":128837},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3626":75575,"_31300":75548,"_5":31656,"_21660":128839,"_28477":128840,"_3077":128841},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3626":75576,"_31300":75548,"_5":31656,"_21660":128843,"_28477":128844,"_3077":128845},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3626":75577,"_31300":75548,"_5":31656,"_21660":128847,"_28477":128848,"_3077":128849},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3626":75578,"_31300":75548,"_5":31656,"_21660":128851,"_28477":128852,"_3077":128853},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3626":75579,"_31300":75548,"_5":31656,"_21660":128855,"_28477":128856,"_3077":128857},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3626":75580,"_31300":75548,"_5":31656,"_21660":128859,"_28477":128860,"_3077":128861},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3626":75581,"_31300":75548,"_5":31656,"_21660":128863,"_28477":128864,"_3077":128865},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3626":75582,"_31300":75548,"_5":31656,"_21660":128867,"_28477":128868,"_3077":128869},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3626":75583,"_31300":75548,"_5":31656,"_21660":128871,"_28477":128872,"_3077":128873},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3626":75584,"_31300":75548,"_5":31656,"_21660":128875,"_28477":128876,"_3077":128877},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3626":75585,"_31300":75548,"_5":31656,"_21660":128879,"_28477":128880,"_3077":128881},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3626":75586,"_31300":75548,"_5":31656,"_21660":128883,"_28477":128884,"_3077":128885},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3626":75587,"_31300":75548,"_5":31656,"_21660":128887,"_28477":128888,"_3077":128889},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3626":75588,"_31300":75548,"_5":31656,"_21660":128891,"_28477":128892,"_3077":128893},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3626":75589,"_31300":75548,"_5":31656,"_21660":128895,"_28477":128896,"_3077":128897},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3626":75590,"_31300":75548,"_5":31656,"_21660":128899,"_28477":128900,"_3077":128901},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3626":75591,"_31300":75548,"_5":31656,"_21660":128903,"_28477":128904,"_3077":128905},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3626":75592,"_31300":75548,"_5":31656,"_21660":128907,"_28477":128908,"_3077":128909},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3626":75593,"_31300":75548,"_5":31656,"_21660":128911,"_28477":128912,"_3077":128913},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3626":75594,"_31300":75548,"_5":31656,"_21660":128915,"_28477":128916,"_3077":124687},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3626":75595,"_31300":75548,"_5":31656,"_21660":128918,"_28477":128919,"_3077":128920},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3626":75596,"_31300":75548,"_5":31656,"_21660":128922,"_28477":128923,"_3077":128924},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3626":75597,"_31300":75548,"_21660":128926,"_5":14907,"_28477":75548,"_3077":128927},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3626":75598,"_31300":75548,"_21660":128929,"_5":14907,"_28477":75548,"_3077":128930},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3626":75599,"_31300":75548,"_21660":128932,"_5":14907,"_28477":75548,"_3077":128933},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3626":75600,"_31300":75548,"_21660":128935,"_5":14907,"_28477":75548,"_3077":128936},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3626":75601,"_31300":75548,"_21660":128938,"_5":14907,"_28477":75548,"_3077":128939},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3626":75602,"_31300":75548,"_21660":128941,"_5":14907,"_28477":75548,"_3077":128942},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3626":75603,"_31300":75548,"_21660":128944,"_5":14907,"_28477":75548,"_3077":128945},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3626":75604,"_31300":75548,"_21660":128947,"_5":14907,"_28477":128746,"_3077":128948},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3626":75605,"_31300":75548,"_21660":128950,"_5":14907,"_28477":128746,"_3077":128951},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3626":75606,"_31300":75548,"_21660":128953,"_5":14907,"_28477":128750,"_3077":128954},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3626":75607,"_31300":75548,"_21660":128956,"_5":14907,"_28477":128750,"_3077":128957},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3626":75608,"_31300":75548,"_21660":128959,"_5":14907,"_28477":128754,"_3077":128960},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3626":75609,"_31300":75548,"_21660":128962,"_5":14907,"_28477":128758,"_3077":128963},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3626":75610,"_31300":75548,"_21660":128965,"_5":14907,"_28477":128758,"_3077":128966},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3626":75611,"_31300":75548,"_21660":128968,"_5":14907,"_28477":128758,"_3077":128969},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3626":75612,"_31300":75548,"_21660":128971,"_5":14907,"_28477":128758,"_3077":128972},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3626":75613,"_31300":75548,"_21660":128974,"_5":14907,"_28477":128758,"_3077":128975},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3626":75614,"_31300":75548,"_21660":128977,"_5":14907,"_28477":128762,"_3077":128978},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3626":75615,"_31300":75548,"_21660":128980,"_5":14907,"_28477":128762,"_3077":128981},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3626":75616,"_31300":75548,"_21660":128983,"_5":14907,"_28477":128762,"_3077":128984},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3626":75617,"_31300":75548,"_21660":128986,"_5":14907,"_28477":128762,"_3077":128987},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3626":75618,"_31300":75548,"_21660":128989,"_5":14907,"_28477":128762,"_3077":128990},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3626":75619,"_31300":75548,"_21660":128992,"_5":14907,"_28477":128762,"_3077":128993},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3626":75620,"_31300":75548,"_21660":128995,"_5":14907,"_28477":128766,"_3077":128996},[],"Cambio",{"_3626":75621,"_31300":75548,"_21660":128998,"_5":14907,"_28477":128766,"_3077":128999},[],"A quién afecta",{"_3626":75622,"_31300":75548,"_21660":129001,"_5":14907,"_28477":128766,"_3077":129002},[],"Gravedad",{"_3626":75623,"_31300":75548,"_21660":129004,"_5":14907,"_28477":128766,"_3077":127475},[],{"_3626":75624,"_31300":75548,"_21660":129006,"_5":14907,"_28477":128766,"_3077":128774},[],{"_3626":75625,"_31300":75548,"_21660":129008,"_5":14907,"_28477":128766,"_3077":129009},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3626":75626,"_31300":75548,"_21660":129011,"_5":14907,"_28477":128766,"_3077":129012},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3626":75627,"_31300":75548,"_21660":129014,"_5":14907,"_28477":128766,"_3077":129015},[],"Copiar los datos a los volúmenes nuevos",{"_3626":75628,"_31300":75548,"_21660":129017,"_5":14907,"_28477":128766,"_3077":128778},[],{"_3626":75629,"_31300":75548,"_21660":129019,"_5":14907,"_28477":128766,"_3077":129020},[],"Todas las releases de Helm",{"_3626":75630,"_31300":75548,"_21660":129022,"_5":14907,"_28477":128766,"_3077":129023},[],"Alta: `helm upgrade` falla",{"_3626":75631,"_31300":75548,"_21660":129025,"_5":14907,"_28477":128766,"_3077":129026},[],"Eliminar o renombrar las claves heredadas",{"_3626":75632,"_31300":75548,"_21660":129028,"_5":14907,"_28477":128766,"_3077":121148},[],{"_3626":75633,"_31300":75548,"_21660":129030,"_5":14907,"_28477":128766,"_3077":129020},[],{"_3626":75634,"_31300":75548,"_21660":129032,"_5":14907,"_28477":128766,"_3077":129033},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3626":75635,"_31300":75548,"_21660":129035,"_5":14907,"_28477":128766,"_3077":129036},[],"Crear primero los Secrets; consulta el paso 2",{"_3626":75636,"_31300":75548,"_21660":129038,"_5":14907,"_28477":128766,"_3077":128785},[],{"_3626":75637,"_31300":75548,"_21660":129040,"_5":14907,"_28477":128766,"_3077":129041},[],"Todos los despliegues",{"_3626":75638,"_31300":75548,"_21660":129043,"_5":14907,"_28477":128766,"_3077":129044},[],"Alta: sin principal de bootstrap no hay administrador",{"_3626":75639,"_31300":75548,"_21660":129046,"_5":14907,"_28477":128766,"_3077":129047},[],"Configurar `services.authz`",{"_3626":75640,"_31300":75548,"_21660":129049,"_5":14907,"_28477":128766,"_3077":128789},[],{"_3626":75641,"_31300":75548,"_21660":129051,"_5":14907,"_28477":128766,"_3077":129020},[],{"_3626":75642,"_31300":75548,"_21660":129053,"_5":14907,"_28477":128766,"_3077":129054},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3626":75643,"_31300":75548,"_21660":129056,"_5":14907,"_28477":128766,"_3077":129057},[],"Mover JWKS y roles a `services.authz`",{"_3626":75644,"_31300":75548,"_21660":129059,"_5":14907,"_28477":128766,"_3077":128809},[],{"_3626":75645,"_31300":75548,"_21660":129061,"_5":14907,"_28477":128766,"_3077":129062},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3626":75646,"_31300":75548,"_21660":129064,"_5":14907,"_28477":128766,"_3077":129065},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3626":75647,"_31300":75548,"_21660":129067,"_5":14907,"_28477":128766,"_3077":129068},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3626":75648,"_31300":75548,"_21660":129070,"_5":14907,"_28477":128766,"_3077":128813},[],{"_3626":75649,"_31300":75548,"_21660":129072,"_5":14907,"_28477":128766,"_3077":129073},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3626":75650,"_31300":75548,"_21660":129075,"_5":14907,"_28477":128766,"_3077":129076},[],"Alta: el backend ya no arranca con ellos",{"_3626":75651,"_31300":75548,"_21660":129078,"_5":14907,"_28477":128766,"_3077":129079},[],"Pasar a PostgreSQL antes de actualizar",{"_3626":75652,"_31300":75548,"_21660":129081,"_5":14907,"_28477":128766,"_3077":128861},[],{"_3626":75653,"_31300":75548,"_21660":129083,"_5":14907,"_28477":128766,"_3077":129084},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3626":75654,"_31300":75548,"_21660":129086,"_5":14907,"_28477":128766,"_3077":129087},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3626":75655,"_31300":75548,"_21660":129089,"_5":14907,"_28477":128766,"_3077":129090},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3626":75656,"_31300":75548,"_21660":129092,"_5":14907,"_28477":128766,"_3077":129093},[],"Webhooks con referencias a archivos",{"_3626":75657,"_31300":75548,"_21660":129095,"_5":14907,"_28477":128766,"_3077":129096},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3626":75658,"_31300":75548,"_21660":129098,"_5":14907,"_28477":128766,"_3077":129099},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3626":75659,"_31300":75548,"_21660":129101,"_5":14907,"_28477":128766,"_3077":129102},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3626":75660,"_31300":75548,"_21660":129104,"_5":14907,"_28477":128766,"_3077":128793},[],{"_3626":75661,"_31300":75548,"_21660":129106,"_5":14907,"_28477":128766,"_3077":129107},[],"Releases con identidades por servicio o material de claves montado",{"_3626":75662,"_31300":75548,"_21660":129109,"_5":14907,"_28477":128766,"_3077":129110},[],"Media: los servicios no pueden leer sus archivos",{"_3626":75663,"_31300":75548,"_21660":129112,"_5":14907,"_28477":128766,"_3077":129113},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3626":75664,"_31300":75548,"_21660":129115,"_5":14907,"_28477":128766,"_3077":128797},[],{"_3626":75665,"_31300":75548,"_21660":129117,"_5":14907,"_28477":128766,"_3077":129118},[],"Releases que definen `amqp.tls`",{"_3626":75666,"_31300":75548,"_21660":129120,"_5":14907,"_28477":128766,"_3077":129121},[],"Media: los clientes se conectan al puerto equivocado",{"_3626":75667,"_31300":75548,"_21660":129123,"_5":14907,"_28477":128766,"_3077":129124},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3626":75668,"_31300":75548,"_21660":129126,"_5":14907,"_28477":128766,"_3077":128817},[],{"_3626":75669,"_31300":75548,"_21660":129128,"_5":14907,"_28477":128766,"_3077":129129},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3626":75670,"_31300":75548,"_21660":129131,"_5":14907,"_28477":128766,"_3077":129132},[],"Media: las claves de CA quedan sin gestionar",{"_3626":75671,"_31300":75548,"_21660":129134,"_5":14907,"_28477":128766,"_3077":129135},[],"Ejecutar la migración de CA a KMS",{"_3626":75672,"_31300":75548,"_21660":129137,"_5":14907,"_28477":128766,"_3077":129138},[],"Verificación del certificado del receptor",{"_3626":75673,"_31300":75548,"_21660":129140,"_5":14907,"_28477":128766,"_3077":129141},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3626":75674,"_31300":75548,"_21660":129143,"_5":14907,"_28477":128766,"_3077":129144},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3626":75675,"_31300":75548,"_21660":129146,"_5":14907,"_28477":128766,"_3077":129147},[],"Poner `insecure_skip_verify` a `false`",{"_3626":75676,"_31300":75548,"_21660":129149,"_5":14907,"_28477":128766,"_3077":128833},[],{"_3626":75677,"_31300":75548,"_21660":129151,"_5":14907,"_28477":128766,"_3077":129152},[],"Scripts y consolas que editan DMS por API",{"_3626":75678,"_31300":75548,"_21660":129154,"_5":14907,"_28477":128766,"_3077":129155},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3626":75679,"_31300":75548,"_21660":129157,"_5":14907,"_28477":128766,"_3077":129158},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3626":75680,"_31300":75548,"_21660":129160,"_5":14907,"_28477":128766,"_3077":128837},[],{"_3626":75681,"_31300":75548,"_21660":129162,"_5":14907,"_28477":128766,"_3077":129163},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3626":75682,"_31300":75548,"_21660":129165,"_5":14907,"_28477":128766,"_3077":129166},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3626":75683,"_31300":75548,"_21660":129168,"_5":14907,"_28477":128766,"_3077":129169},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3626":75684,"_31300":75548,"_21660":129171,"_5":14907,"_28477":128766,"_3077":128857},[],{"_3626":75685,"_31300":75548,"_21660":129173,"_5":14907,"_28477":128766,"_3077":129174},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3626":75686,"_31300":75548,"_21660":129176,"_5":14907,"_28477":128766,"_3077":129177},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3626":75687,"_31300":75548,"_21660":129179,"_5":14907,"_28477":128766,"_3077":129180},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3626":75688,"_31300":75548,"_21660":129182,"_5":14907,"_28477":128766,"_3077":128865},[],{"_3626":75689,"_31300":75548,"_21660":129184,"_5":14907,"_28477":128766,"_3077":129185},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3626":75690,"_31300":75548,"_21660":129187,"_5":14907,"_28477":128766,"_3077":129188},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3626":75691,"_31300":75548,"_21660":129190,"_5":14907,"_28477":128766,"_3077":129191},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3626":75692,"_31300":75548,"_21660":129193,"_5":14907,"_28477":128766,"_3077":128869},[],{"_3626":75693,"_31300":75548,"_21660":129195,"_5":14907,"_28477":128766,"_3077":129196},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3626":75694,"_31300":75548,"_21660":129198,"_5":14907,"_28477":128766,"_3077":129199},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3626":75695,"_31300":75548,"_21660":129201,"_5":14907,"_28477":128766,"_3077":129202},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3626":75696,"_31300":75548,"_21660":129204,"_5":14907,"_28477":128766,"_3077":128853},[],{"_3626":75697,"_31300":75548,"_21660":129206,"_5":14907,"_28477":128766,"_3077":129207},[],"Consumidores que leen el campo `events` del dispositivo",{"_3626":75698,"_31300":75548,"_21660":129209,"_5":14907,"_28477":128766,"_3077":129210},[],"Media: el campo desaparece",{"_3626":75699,"_31300":75548,"_21660":129212,"_5":14907,"_28477":128766,"_3077":129213},[],"Usar los nuevos endpoints de eventos",{"_3626":75700,"_31300":75548,"_21660":129215,"_5":14907,"_28477":128766,"_3077":128881},[],{"_3626":75701,"_31300":75548,"_21660":129217,"_5":14907,"_28477":128766,"_3077":129218},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3626":75702,"_31300":75548,"_21660":129220,"_5":14907,"_28477":128766,"_3077":129221},[],"Media: la migración de la VA aborta",{"_3626":75703,"_31300":75548,"_21660":129223,"_5":14907,"_28477":128766,"_3077":129224},[],"Corregir los roles afectados antes de actualizar",{"_3626":75704,"_31300":75548,"_21660":129226,"_5":14907,"_28477":128766,"_3077":128801},[],{"_3626":75705,"_31300":75548,"_21660":129228,"_5":14907,"_28477":128766,"_3077":129229},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3626":75706,"_31300":75548,"_21660":129231,"_5":14907,"_28477":128766,"_3077":129232},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3626":75707,"_31300":75548,"_21660":129234,"_5":14907,"_28477":128766,"_3077":129235},[],"Actualizar el archivo de values",{"_3626":75708,"_31300":75548,"_21660":129237,"_5":14907,"_28477":128766,"_3077":128845},[],{"_3626":75709,"_31300":75548,"_21660":129239,"_5":14907,"_28477":128766,"_3077":129240},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3626":75710,"_31300":75548,"_21660":129242,"_5":14907,"_28477":128766,"_3077":129243},[],"Baja: prevalece el ID de la URL",{"_3626":75711,"_31300":75548,"_21660":129245,"_5":14907,"_28477":128766,"_3077":129246},[],"Enviar el ID en la URL",{"_3626":75712,"_31300":75548,"_21660":129248,"_5":14907,"_28477":128766,"_3077":128873},[],{"_3626":75713,"_31300":75548,"_21660":129250,"_5":14907,"_28477":128766,"_3077":129251},[],"Clientes que envían un `id` al crear o importar CAs",{"_3626":75714,"_31300":75548,"_21660":129253,"_5":14907,"_28477":128766,"_3077":129254},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3626":75715,"_31300":75548,"_21660":129256,"_5":14907,"_28477":128766,"_3077":129257},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3626":75716,"_31300":75548,"_21660":129259,"_5":14907,"_28477":128766,"_3077":128877},[],{"_3626":75717,"_31300":75548,"_21660":129261,"_5":14907,"_28477":128766,"_3077":129262},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3626":75718,"_31300":75548,"_21660":129264,"_5":14907,"_28477":128766,"_3077":129265},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3626":75719,"_31300":75548,"_21660":129267,"_5":14907,"_28477":128766,"_3077":129268},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3626":75720,"_31300":75548,"_21660":129270,"_5":14907,"_28477":128766,"_3077":128849},[],{"_3626":75721,"_31300":75548,"_21660":129272,"_5":14907,"_28477":128766,"_3077":129273},[],"Consumidores que comparan el `type` del certificado",{"_3626":75722,"_31300":75548,"_21660":129275,"_5":14907,"_28477":128766,"_3077":129276},[],"Baja: dos valores cambian de nombre",{"_3626":75723,"_31300":75548,"_21660":129278,"_5":14907,"_28477":128766,"_3077":129279},[],"Adaptar los consumidores",{"_3626":75724,"_31300":75548,"_21660":129281,"_5":14907,"_28477":128766,"_3077":128841},[],{"_3626":75725,"_31300":75548,"_21660":129283,"_5":14907,"_28477":128766,"_3077":129284},[],"Cualquier DMS",{"_3626":75726,"_31300":75548,"_21660":129286,"_5":14907,"_28477":128766,"_3077":129287},[],"Baja: solo informativo",{"_3626":75727,"_31300":75548,"_21660":129289,"_5":14907,"_28477":128766,"_3077":129290},[],"Revisar ambos bloques antes de editar",{"_3626":75728,"_31300":75548,"_21660":129292,"_5":14907,"_28477":128773,"_3077":129293},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3626":75729,"_31300":75548,"_21660":129295,"_5":14907,"_28477":128773,"_3077":129296},[],"El paso 4 de la guía de migración copia los datos.",{"_3626":75730,"_31300":75548,"_21660":129298,"_5":14907,"_28477":128777,"_3077":129299},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3626":75731,"_31300":75548,"_21660":129301,"_5":14907,"_28477":128781,"_3077":129302},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3626":75732,"_31300":75548,"_21660":129304,"_5":14907,"_28477":128781,"_3077":129305},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3626":75733,"_31300":75548,"_21660":129307,"_5":14907,"_28477":128784,"_3077":129308},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3626":75734,"_31300":75548,"_21660":129310,"_5":14907,"_28477":128788,"_3077":129311},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3626":75735,"_31300":75548,"_21660":129313,"_5":14907,"_28477":128792,"_3077":129314},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3626":75736,"_31300":75548,"_21660":129316,"_5":14907,"_28477":128792,"_3077":129317},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3626":75737,"_31300":75548,"_21660":129319,"_5":14907,"_28477":128792,"_3077":129320},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3626":75738,"_31300":75548,"_21660":129322,"_5":14907,"_28477":128796,"_3077":129323},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3626":75739,"_31300":75548,"_21660":129325,"_5":14907,"_28477":128800,"_3077":129326},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3626":75740,"_31300":75548,"_21660":129328,"_5":14907,"_28477":128800,"_3077":129329},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3626":75741,"_31300":75548,"_21660":129331,"_5":14907,"_28477":128800,"_3077":129332},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3626":75742,"_31300":75548,"_21660":129334,"_5":14907,"_28477":128800,"_3077":129335},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3626":75743,"_31300":75548,"_21660":129337,"_5":14907,"_28477":128800,"_3077":129338},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3626":75744,"_31300":75548,"_21660":129340,"_5":14907,"_28477":128800,"_3077":129341},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3626":75745,"_31300":75548,"_21660":129343,"_5":14907,"_28477":128808,"_3077":129344},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3626":75746,"_31300":75548,"_21660":129346,"_5":14907,"_28477":128808,"_3077":129347},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3626":75747,"_31300":75548,"_21660":129349,"_5":14907,"_28477":128808,"_3077":129350},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3626":75748,"_31300":75548,"_21660":129352,"_5":14907,"_28477":128808,"_3077":129353},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3626":75749,"_31300":75548,"_21660":129355,"_5":14907,"_28477":128808,"_3077":129356},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3626":75750,"_31300":75548,"_21660":129358,"_5":14907,"_28477":128812,"_3077":129359},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3626":75751,"_31300":75548,"_21660":129361,"_5":14907,"_28477":128816,"_3077":129362},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3626":75752,"_31300":75548,"_21660":129364,"_5":14907,"_28477":128816,"_3077":129365},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3626":75753,"_31300":75548,"_21660":129367,"_5":14907,"_28477":128816,"_3077":129368},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3626":75754,"_31300":75548,"_21660":129370,"_5":14907,"_28477":128816,"_3077":129371},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3626":75755,"_31300":75548,"_21660":129373,"_5":14907,"_28477":128816,"_3077":129374},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3626":75756,"_31300":75548,"_21660":129376,"_5":14907,"_28477":128816,"_3077":129377},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3626":75757,"_31300":75548,"_21660":129379,"_5":14907,"_28477":128816,"_3077":129380},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3626":75758,"_31300":75548,"_21660":129382,"_5":14907,"_28477":128816,"_3077":129383},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3626":75759,"_31300":75548,"_21660":129385,"_5":14907,"_28477":128820,"_3077":129386},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3626":75760,"_31300":75548,"_21660":129388,"_5":14907,"_28477":128828,"_3077":129389},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3626":75761,"_31300":75548,"_21660":129391,"_5":14907,"_28477":128828,"_3077":129392},[],"Campo en 3.8.0",{"_3626":75762,"_31300":75548,"_21660":129394,"_5":14907,"_28477":128828,"_3077":129395},[],"Campo en 4.0.0",{"_3626":75763,"_31300":75548,"_21660":129397,"_5":14907,"_28477":128828,"_3077":60152},[],{"_3626":75764,"_31300":75548,"_21660":129399,"_5":14907,"_28477":128828,"_3077":129400},[],"`insecure_skip_verify` (con el valor negado)",{"_3626":75765,"_31300":75548,"_21660":129402,"_5":14907,"_28477":128828,"_3077":60158},[],{"_3626":75766,"_31300":75548,"_21660":129404,"_5":14907,"_28477":128828,"_3077":60161},[],{"_3626":75767,"_31300":75548,"_21660":129406,"_5":14907,"_28477":128828,"_3077":60164},[],{"_3626":75768,"_31300":75548,"_21660":129408,"_5":14907,"_28477":128828,"_3077":60167},[],{"_3626":75769,"_31300":75548,"_21660":129410,"_5":14907,"_28477":128828,"_3077":60170},[],{"_3626":75770,"_31300":75548,"_21660":129412,"_5":14907,"_28477":128828,"_3077":60173},[],{"_3626":75771,"_31300":75548,"_21660":129414,"_5":14907,"_28477":128828,"_3077":129415},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3626":75772,"_31300":75548,"_21660":129417,"_5":14907,"_28477":128828,"_3077":129418},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3626":75773,"_31300":75548,"_21660":129420,"_5":14907,"_28477":128828,"_3077":129421},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3626":75774,"_31300":75548,"_21660":129423,"_5":14907,"_28477":128832,"_3077":129424},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3626":75775,"_31300":75548,"_21660":129426,"_5":14907,"_28477":128832,"_3077":129427},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3626":75776,"_31300":75548,"_21660":129429,"_5":14907,"_28477":128832,"_3077":129430},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3626":75777,"_31300":75548,"_21660":129432,"_5":14907,"_28477":128836,"_3077":129433},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3626":75778,"_31300":75548,"_21660":129435,"_5":14907,"_28477":128836,"_3077":129436},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3626":75779,"_31300":75548,"_21660":129438,"_5":14907,"_28477":128840,"_3077":129439},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3626":75780,"_31300":75548,"_21660":129441,"_5":14907,"_28477":128844,"_3077":129442},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3626":75781,"_31300":75548,"_21660":129444,"_5":14907,"_28477":128848,"_3077":129445},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3626":75782,"_31300":75548,"_21660":129447,"_5":14907,"_28477":128852,"_3077":129448},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3626":75783,"_31300":75548,"_21660":129450,"_5":14907,"_28477":128852,"_3077":129451},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3626":75784,"_31300":75548,"_21660":129453,"_5":14907,"_28477":128852,"_3077":129454},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3626":75785,"_31300":75548,"_21660":129456,"_5":14907,"_28477":128852,"_3077":129457},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3626":75786,"_31300":75548,"_21660":129459,"_5":14907,"_28477":128856,"_3077":129460},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3626":75787,"_31300":75548,"_21660":129462,"_5":14907,"_28477":128860,"_3077":129463},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3626":75788,"_31300":75548,"_21660":129465,"_5":14907,"_28477":128860,"_3077":129466},[],"Ruta",{"_3626":75789,"_31300":75548,"_21660":129468,"_5":14907,"_28477":128860,"_3077":121779},[],{"_3626":75790,"_31300":75548,"_21660":129470,"_5":14907,"_28477":128860,"_3077":60232},[],{"_3626":75791,"_31300":75548,"_21660":129472,"_5":14907,"_28477":128860,"_3077":129473},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3626":75792,"_31300":75548,"_21660":129475,"_5":14907,"_28477":128860,"_3077":60238},[],{"_3626":75793,"_31300":75548,"_21660":129477,"_5":14907,"_28477":128860,"_3077":129478},[],"Lee los ajustes de una CA.",{"_3626":75794,"_31300":75548,"_21660":129480,"_5":14907,"_28477":128860,"_3077":60244},[],{"_3626":75795,"_31300":75548,"_21660":129482,"_5":14907,"_28477":128860,"_3077":129483},[],"Sustituye los `crl_options`.",{"_3626":75796,"_31300":75548,"_21660":129485,"_5":14907,"_28477":128860,"_3077":60250},[],{"_3626":75797,"_31300":75548,"_21660":129487,"_5":14907,"_28477":128860,"_3077":129488},[],"Elimina los ajustes archivados de una CA.",{"_3626":75798,"_31300":75548,"_21660":129490,"_5":14907,"_28477":128860,"_3077":129491},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3626":75799,"_31300":75548,"_21660":129493,"_5":14907,"_28477":128860,"_3077":129494},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3626":75800,"_31300":75548,"_21660":129496,"_5":14907,"_28477":128860,"_3077":129497},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3626":75801,"_31300":75548,"_21660":129499,"_5":14907,"_28477":128860,"_3077":129500},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3626":75802,"_31300":75548,"_21660":129502,"_5":14907,"_28477":128860,"_3077":129503},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3626":75803,"_31300":75548,"_21660":129505,"_5":14907,"_28477":128860,"_3077":129506},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3626":75804,"_31300":75548,"_21660":129508,"_5":14907,"_28477":128860,"_3077":129509},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3626":75805,"_31300":75548,"_21660":129511,"_5":14907,"_28477":128860,"_3077":129512},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3626":75806,"_31300":75548,"_21660":129514,"_5":14907,"_28477":128860,"_3077":129515},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3626":75807,"_31300":75548,"_21660":129517,"_5":14907,"_28477":128860,"_3077":129518},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3626":75808,"_31300":75548,"_21660":129520,"_5":14907,"_28477":128860,"_3077":129521},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3626":75809,"_31300":75548,"_21660":129523,"_5":14907,"_28477":128864,"_3077":129524},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3626":75810,"_31300":75548,"_21660":129526,"_5":14907,"_28477":128868,"_3077":129527},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3626":75811,"_31300":75548,"_21660":129529,"_5":14907,"_28477":128872,"_3077":129530},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3626":75812,"_31300":75548,"_21660":129532,"_5":14907,"_28477":128876,"_3077":129533},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3626":75813,"_31300":75548,"_21660":129535,"_5":14907,"_28477":128876,"_3077":129536},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3626":75814,"_31300":75548,"_21660":129538,"_5":14907,"_28477":128880,"_3077":129539},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3626":75815,"_31300":75548,"_21660":129541,"_5":14907,"_28477":128884,"_3077":129542},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3626":75816,"_31300":75548,"_21660":129544,"_5":14907,"_28477":128888,"_3077":129545},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3626":75817,"_31300":75548,"_21660":129547,"_5":14907,"_28477":128888,"_3077":129548},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3626":75818,"_31300":75548,"_21660":129550,"_5":14907,"_28477":128888,"_3077":129551},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3626":75819,"_31300":75548,"_21660":129553,"_5":14907,"_28477":128888,"_3077":129554},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3626":75820,"_31300":75548,"_21660":129556,"_5":14907,"_28477":128888,"_3077":129557},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3626":75821,"_31300":75548,"_21660":129559,"_5":14907,"_28477":128888,"_3077":129560},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3626":75822,"_31300":75548,"_21660":129562,"_5":14907,"_28477":128892,"_3077":129563},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3626":75823,"_31300":75548,"_21660":129565,"_5":14907,"_28477":128892,"_3077":129566},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3626":75824,"_31300":75548,"_21660":129568,"_5":14907,"_28477":128892,"_3077":129569},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3626":75825,"_31300":75548,"_21660":129571,"_5":14907,"_28477":128892,"_3077":129572},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3626":75826,"_31300":75548,"_21660":129574,"_5":14907,"_28477":128892,"_3077":129575},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3626":75827,"_31300":75548,"_21660":129577,"_5":14907,"_28477":128896,"_3077":129578},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3626":75828,"_31300":75548,"_21660":129580,"_5":14907,"_28477":128896,"_3077":129581},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3626":75829,"_31300":75548,"_21660":129583,"_5":14907,"_28477":128896,"_3077":129584},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3626":75830,"_31300":75548,"_21660":129586,"_5":14907,"_28477":128896,"_3077":60352},[],{"_3626":75831,"_31300":75548,"_21660":129588,"_5":14907,"_28477":128896,"_3077":129589},[],"Claves de datos obligatorias",{"_3626":75832,"_31300":75548,"_21660":129591,"_5":14907,"_28477":128896,"_3077":129592},[],"Cuándo",{"_3626":75833,"_31300":75548,"_21660":129594,"_5":14907,"_28477":128896,"_3077":129595},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3626":75834,"_31300":75548,"_21660":129597,"_5":14907,"_28477":128896,"_3077":60364},[],{"_3626":75835,"_31300":75548,"_21660":129599,"_5":14907,"_28477":128896,"_3077":129600},[],"Siempre",{"_3626":75836,"_31300":75548,"_21660":129602,"_5":14907,"_28477":128896,"_3077":129603},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3626":75837,"_31300":75548,"_21660":129605,"_5":14907,"_28477":128896,"_3077":60364},[],{"_3626":75838,"_31300":75548,"_21660":129607,"_5":14907,"_28477":128896,"_3077":129600},[],{"_3626":75839,"_31300":75548,"_21660":129609,"_5":14907,"_28477":128896,"_3077":60377},[],{"_3626":75840,"_31300":75548,"_21660":129611,"_5":14907,"_28477":128896,"_3077":60364},[],{"_3626":75841,"_31300":75548,"_21660":129613,"_5":14907,"_28477":128896,"_3077":129614},[],"Solo cuando hay autenticación SMTP",{"_3626":75842,"_31300":75548,"_21660":129616,"_5":14907,"_28477":128896,"_3077":129617},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3626":75843,"_31300":75548,"_21660":129619,"_5":14907,"_28477":128896,"_3077":129620},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3626":75844,"_31300":75548,"_21660":129622,"_5":14907,"_28477":128896,"_3077":129623},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3626":75845,"_31300":75548,"_21660":129625,"_5":14907,"_28477":128896,"_3077":129626},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3626":75846,"_31300":75548,"_21660":129628,"_5":14907,"_28477":128896,"_3077":129629},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3626":75847,"_31300":75548,"_21660":129631,"_5":14907,"_28477":128896,"_3077":129632},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3626":75848,"_31300":75548,"_21660":129634,"_5":14907,"_28477":128896,"_3077":129635},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3626":75849,"_31300":75548,"_21660":129637,"_5":14907,"_28477":128896,"_3077":129638},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3626":75850,"_31300":75548,"_21660":129640,"_5":14907,"_28477":128896,"_3077":129641},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3626":75851,"_31300":75548,"_21660":129643,"_5":14907,"_28477":128896,"_3077":129644},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3626":75852,"_31300":75548,"_21660":129646,"_5":14907,"_28477":128896,"_3077":129647},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3626":75853,"_31300":75548,"_21660":129649,"_5":14907,"_28477":128896,"_3077":129650},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3626":75854,"_31300":75548,"_21660":129652,"_5":14907,"_28477":128896,"_3077":129653},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3626":75855,"_31300":75548,"_21660":129655,"_5":14907,"_28477":128896,"_3077":129656},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3626":75856,"_31300":75548,"_21660":129658,"_5":14907,"_28477":128896,"_3077":129659},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3626":75857,"_31300":75548,"_21660":129661,"_5":14907,"_28477":128900,"_3077":129662},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3626":75858,"_31300":75548,"_21660":129664,"_5":14907,"_28477":128900,"_3077":129665},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3626":75859,"_31300":75548,"_21660":129667,"_5":14907,"_28477":128904,"_3077":129668},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3626":75860,"_31300":75548,"_21660":129670,"_5":14907,"_28477":128904,"_3077":129671},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3626":75861,"_31300":75548,"_21660":129673,"_5":14907,"_28477":128904,"_3077":129674},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3626":75862,"_31300":75548,"_21660":129676,"_5":14907,"_28477":128904,"_3077":129677},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3626":75863,"_31300":75548,"_21660":129679,"_5":14907,"_28477":128904,"_3077":129680},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3626":75864,"_31300":75548,"_21660":129682,"_5":14907,"_28477":128904,"_3077":129683},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3626":75865,"_31300":75548,"_21660":129685,"_5":14907,"_28477":128904,"_3077":129686},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3626":75866,"_31300":75548,"_21660":129688,"_5":14907,"_28477":128904,"_3077":129689},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3626":75867,"_31300":75548,"_21660":129691,"_5":14907,"_28477":128904,"_3077":129692},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3626":75868,"_31300":75548,"_21660":129694,"_5":14907,"_28477":128904,"_3077":129695},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3626":75869,"_31300":75548,"_21660":129697,"_5":14907,"_28477":128904,"_3077":129698},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3626":75870,"_31300":75548,"_21660":129700,"_5":14907,"_28477":128908,"_3077":129701},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3626":75871,"_31300":75548,"_21660":129703,"_5":14907,"_28477":128908,"_3077":129704},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3626":75872,"_31300":75548,"_21660":129706,"_5":14907,"_28477":128912,"_3077":129707},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3626":75873,"_31300":75548,"_21660":129709,"_5":14907,"_28477":128912,"_3077":129710},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3626":75874,"_31300":75548,"_21660":129712,"_5":14907,"_28477":128912,"_3077":129713},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3626":75875,"_31300":75548,"_21660":129715,"_5":14907,"_28477":128912,"_3077":129716},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3626":75876,"_31300":75548,"_21660":129718,"_5":14907,"_28477":128912,"_3077":129719},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3626":75877,"_31300":75548,"_21660":129721,"_5":14907,"_28477":128912,"_3077":129722},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3626":75878,"_31300":75548,"_21660":129724,"_5":14907,"_28477":128912,"_3077":129725},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3626":75879,"_31300":75548,"_21660":129727,"_5":14907,"_28477":128912,"_3077":129728},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3626":75880,"_31300":75548,"_21660":129730,"_5":14907,"_28477":128916,"_3077":129731},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3626":75881,"_31300":75548,"_21660":129733,"_5":14907,"_28477":128916,"_3077":129734},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3626":75882,"_31300":75548,"_21660":129736,"_5":14907,"_28477":128916,"_3077":129737},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3626":75883,"_31300":75548,"_21660":129739,"_5":14907,"_28477":128916,"_3077":129740},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3626":75884,"_31300":75548,"_21660":129742,"_5":14907,"_28477":128916,"_3077":129743},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3626":75885,"_31300":75548,"_21660":129745,"_5":14907,"_28477":128916,"_3077":129746},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3626":75886,"_31300":75548,"_21660":129748,"_5":14907,"_28477":128916,"_3077":129749},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3626":75887,"_31300":75548,"_21660":129751,"_5":14907,"_28477":128916,"_3077":129752},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3626":75888,"_31300":75548,"_21660":129754,"_5":14907,"_28477":128916,"_3077":129755},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3626":75889,"_31300":75548,"_21660":129757,"_5":14907,"_28477":128916,"_3077":129758},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3626":75890,"_31300":75548,"_21660":129760,"_5":14907,"_28477":128916,"_3077":129761},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3626":75891,"_31300":75548,"_21660":129763,"_5":14907,"_28477":128919,"_3077":129764},[],"Tras la actualización, comprueba en este orden:",{"_3626":75892,"_31300":75548,"_21660":129766,"_5":14907,"_28477":128919,"_3077":129767},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3626":75893,"_31300":75548,"_21660":129769,"_5":14907,"_28477":128919,"_3077":129770},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3626":75894,"_31300":75548,"_21660":129772,"_5":14907,"_28477":128919,"_3077":129773},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3626":75895,"_31300":75548,"_21660":129775,"_5":14907,"_28477":128919,"_3077":129776},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3626":75896,"_31300":75548,"_21660":129778,"_5":14907,"_28477":128919,"_3077":129779},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3626":75897,"_31300":75548,"_21660":129781,"_5":14907,"_28477":128919,"_3077":129782},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3626":75898,"_31300":75548,"_21660":129784,"_5":14907,"_28477":128919,"_3077":129785},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3626":75899,"_31300":75548,"_21660":129787,"_5":14907,"_28477":128919,"_3077":129788},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3626":75900,"_31300":75548,"_21660":129790,"_5":14907,"_28477":128919,"_3077":129791},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3626":75901,"_31300":75548,"_21660":129793,"_5":14907,"_28477":128919,"_3077":129794},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3626":75902,"_31300":75548,"_21660":129796,"_5":14907,"_28477":128919,"_3077":129797},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3626":75903,"_31300":75548,"_21660":129799,"_5":14907,"_28477":128919,"_3077":129800},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3626":75904,"_31300":75548,"_21660":129802,"_5":14907,"_28477":128919,"_3077":129803},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3626":75905,"_31300":75548,"_21660":129805,"_5":14907,"_28477":128919,"_3077":129806},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3626":75906,"_31300":75548,"_21660":129808,"_5":14907,"_28477":128919,"_3077":129809},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3626":75907,"_31300":75548,"_21660":129811,"_5":14907,"_28477":128923,"_3077":129812},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3626":75908,"_31300":75548,"_21660":129814,"_5":14907,"_28477":128923,"_3077":129815},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3626":75909,"_31300":75548,"_21660":129817,"_5":14907,"_28477":128923,"_3077":129818},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3626":75910,"_31300":75548,"_21660":129820,"_5":14907,"_28477":128923,"_3077":129821},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3626":75911,"_31300":75548,"_21660":129823,"_5":14907,"_28477":128923,"_3077":129824},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60595":129826,"_60597":129827,"_60599":129828,"_60601":129829,"_18797":3112,"_72848":3112},"spanish",[3077,31300,5,28477],{"_3077":25875,"_31300":25875,"_5":25875,"_28477":25875},{"_3077":129830,"_31300":132890,"_5":135950,"_28477":139010},{"_4827":129831,"_60605":129832,"_5":25875},{"_14988":7240,"_15367":7785,"_15386":4666,"_30295":7970,"_15373":4215,"_20572":3371,"_15009":5984,"_15016":20878,"_30237":12180,"_30645":7927,"_30677":7284,"_30271":4570,"_35706":5181,"_30374":21058,"_30721":10238,"_35713":5456,"_35716":4216,"_35719":5836,"_35722":5744,"_31123":10982,"_35727":4905,"_35729":3390,"_31158":5345,"_15382":16373,"_35733":7814,"_35736":7604,"_35738":5146,"_30705":12800,"_31143":4244,"_31171":3298,"_35743":5307,"_35745":3575,"_35747":6314,"_30385":7990,"_35750":3475,"_35752":6194,"_35754":13386,"_35756":3531,"_35758":3593,"_30308":6254,"_35761":7245,"_35763":3890,"_30302":3173,"_30742":14697,"_35767":18673,"_35769":6463,"_35772":4572,"_30348":4727,"_35776":8497,"_30228":6206,"_35