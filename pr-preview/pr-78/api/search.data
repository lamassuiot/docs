41700":129623,"_41702":129626,"_41704":129629,"_41706":129632,"_41708":129635,"_41710":129638,"_41712":129641,"_41714":129644,"_41716":129647,"_41718":129650,"_41720":129653,"_41722":129656,"_41724":129659,"_41726":129662,"_41728":129665,"_41730":129668,"_41732":129671,"_41734":129674,"_41736":129677,"_41738":129680,"_41740":129683,"_41742":129686,"_41744":129689,"_41746":129692,"_41748":129695,"_41750":129698,"_41752":129701,"_41755":129704,"_41757":129707,"_41759":129710},{"_3625":72796,"_31241":72796,"_5":15267,"_3077":120430,"_31600":120431,"_21645":120434,"_28433":72796},"Despliega desde AWS Marketplace",[51013,120432,120433],"Despliegue","Otros modelos",[],{"_3625":72797,"_31241":72796,"_21645":120436,"_5":14907,"_28433":72796,"_3077":120437},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3625":72798,"_31241":72796,"_5":31597,"_21645":120439,"_28433":120440,"_3077":120441},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3625":72799,"_31241":72796,"_5":31597,"_21645":120443,"_28433":120444,"_3077":120445},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3625":72800,"_31241":72796,"_5":31597,"_21645":120447,"_28433":120448,"_3077":120449},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3625":72801,"_31241":72796,"_5":31597,"_21645":120451,"_28433":120452,"_3077":120453},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3625":72802,"_31241":72796,"_5":31597,"_21645":120455,"_28433":120456,"_3077":120457},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3625":72803,"_31241":72796,"_5":31597,"_21645":120459,"_28433":120460,"_3077":120461},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3625":72804,"_31241":72796,"_5":31597,"_21645":120463,"_28433":120464,"_3077":120465},[],"/docs/pr-preview/pr-78/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3625":72805,"_31241":72796,"_21645":120467,"_5":14907,"_28433":72796,"_3077":120468},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3625":72806,"_31241":72796,"_21645":120470,"_5":14907,"_28433":120440,"_3077":120471},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3625":72807,"_31241":72796,"_21645":120473,"_5":14907,"_28433":120440,"_3077":120474},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3625":72808,"_31241":72796,"_21645":120476,"_5":14907,"_28433":120440,"_3077":120477},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3625":72809,"_31241":72796,"_21645":120479,"_5":14907,"_28433":120444,"_3077":120480},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3625":72810,"_31241":72796,"_21645":120482,"_5":14907,"_28433":120444,"_3077":120483},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3625":72811,"_31241":72796,"_21645":120485,"_5":14907,"_28433":120444,"_3077":120486},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3625":72812,"_31241":72796,"_21645":120488,"_5":14907,"_28433":120448,"_3077":120489},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3625":72813,"_31241":72796,"_21645":120491,"_5":14907,"_28433":120452,"_3077":120492},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3625":72814,"_31241":72796,"_21645":120494,"_5":14907,"_28433":120456,"_3077":120495},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3625":72815,"_31241":72796,"_21645":120497,"_5":14907,"_28433":120460,"_3077":120498},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3625":72816,"_31241":72796,"_21645":120500,"_5":14907,"_28433":120464,"_3077":120501},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3625":72817,"_31241":72817,"_5":15267,"_3077":120503,"_31600":120504,"_21645":120505,"_28433":72817},"Despliega Lamassu",[51013,120432],[],{"_3625":72818,"_31241":72817,"_21645":120507,"_5":14907,"_28433":72817,"_3077":120508},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3625":72819,"_31241":72817,"_5":31597,"_21645":120510,"_28433":120511,"_3077":120512},[],"/docs/pr-preview/pr-78/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3625":72820,"_31241":72817,"_5":31597,"_21645":120514,"_28433":120515,"_3077":120516},[],"/docs/pr-preview/pr-78/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3625":72821,"_31241":72817,"_5":31597,"_21645":120518,"_28433":120519,"_3077":120520},[],"/docs/pr-preview/pr-78/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3625":72822,"_31241":72817,"_21645":120522,"_5":14907,"_28433":72817,"_3077":120523},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3625":72823,"_31241":72817,"_21645":120525,"_5":14907,"_28433":120511,"_3077":120526},[],"Modelo",{"_3625":72824,"_31241":72817,"_21645":120528,"_5":14907,"_28433":120511,"_3077":120529},[],"Recomendado para",{"_3625":72825,"_31241":72817,"_21645":120531,"_5":14907,"_28433":120511,"_3077":120532},[],"Quién opera la infraestructura",{"_3625":72826,"_31241":72817,"_21645":120534,"_5":14907,"_28433":120511,"_3077":120535},[],"Punto de partida",{"_3625":72827,"_31241":72817,"_21645":120537,"_5":14907,"_28433":120511,"_3077":51120},[],{"_3625":72828,"_31241":72817,"_21645":120539,"_5":14907,"_28433":120511,"_3077":120540},[],"Producción, entornos regulados y despliegues personalizados",{"_3625":72829,"_31241":72817,"_21645":120542,"_5":14907,"_28433":120511,"_3077":120543},[],"Tu equipo",{"_3625":72830,"_31241":72817,"_21645":120545,"_5":14907,"_28433":120511,"_3077":120546},[],"Helm o Fastlane",{"_3625":72831,"_31241":72817,"_21645":120548,"_5":14907,"_28433":120511,"_3077":51132},[],{"_3625":72832,"_31241":72817,"_21645":120550,"_5":14907,"_28433":120511,"_3077":120551},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3625":72833,"_31241":72817,"_21645":120553,"_5":14907,"_28433":120511,"_3077":120543},[],{"_3625":72834,"_31241":72817,"_21645":120555,"_5":14907,"_28433":120511,"_3077":120556},[],"Imagen preconfigurada en EC2",{"_3625":72835,"_31241":72817,"_21645":120558,"_5":14907,"_28433":120511,"_3077":51143},[],{"_3625":72836,"_31241":72817,"_21645":120560,"_5":14907,"_28433":120511,"_3077":120561},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3625":72837,"_31241":72817,"_21645":120563,"_5":14907,"_28433":120511,"_3077":51149},[],{"_3625":72838,"_31241":72817,"_21645":120565,"_5":14907,"_28433":120511,"_3077":120566},[],"Suscripción gestionada",{"_3625":72839,"_31241":72817,"_21645":120568,"_5":14907,"_28433":120511,"_3077":120569},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3625":72840,"_31241":72817,"_21645":120571,"_5":14907,"_28433":120511,"_3077":120572},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3625":72841,"_31241":72817,"_21645":120574,"_5":14907,"_28433":120511,"_3077":120575},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3625":72842,"_31241":72817,"_21645":120577,"_5":14907,"_28433":120515,"_3077":120578},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3625":72843,"_31241":72817,"_21645":120580,"_5":14907,"_28433":120519,"_3077":120581},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3625":72844,"_31241":72844,"_5":15267,"_3077":120583,"_31600":120584,"_21645":120585,"_28433":72844},"Utiliza Lamassu como SaaS",[51013,120432,120433],[],{"_3625":72845,"_31241":72844,"_21645":120587,"_5":14907,"_28433":72844,"_3077":120588},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3625":72846,"_31241":72844,"_5":31597,"_21645":120590,"_28433":120591,"_3077":120592},[],"/docs/pr-preview/pr-78/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3625":72847,"_31241":72844,"_5":31597,"_21645":120594,"_28433":120595,"_3077":120596},[],"/docs/pr-preview/pr-78/es/deployment/saas#planes","Planes",{"_3625":72848,"_31241":72844,"_5":31597,"_21645":120598,"_28433":120599,"_3077":120600},[],"/docs/pr-preview/pr-78/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3625":72849,"_31241":72844,"_21645":120602,"_5":14907,"_28433":72844,"_3077":120603},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3625":72850,"_31241":72844,"_21645":120605,"_5":14907,"_28433":120591,"_3077":120606},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3625":72851,"_31241":72844,"_21645":120608,"_5":14907,"_28433":120591,"_3077":120609},[],"Copias de seguridad automáticas.",{"_3625":72852,"_31241":72844,"_21645":120611,"_5":14907,"_28433":120591,"_3077":120612},[],"Actualizaciones de versión.",{"_3625":72853,"_31241":72844,"_21645":120614,"_5":14907,"_28433":120591,"_3077":120615},[],"Soporte técnico y SLA según el plan contratado.",{"_3625":72854,"_31241":72844,"_21645":120617,"_5":14907,"_28433":120595,"_3077":51204},[],{"_3625":72855,"_31241":72844,"_21645":120619,"_5":14907,"_28433":120595,"_3077":120620},[],"Dispositivos",{"_3625":72856,"_31241":72844,"_21645":120622,"_5":14907,"_28433":120595,"_3077":120623},[],"Soporte",{"_3625":72857,"_31241":72844,"_21645":120625,"_5":14907,"_28433":120595,"_3077":51213},[],{"_3625":72858,"_31241":72844,"_21645":120627,"_5":14907,"_28433":120595,"_3077":51216},[],{"_3625":72859,"_31241":72844,"_21645":120629,"_5":14907,"_28433":120595,"_3077":120630},[],"Hasta 1.000",{"_3625":72860,"_31241":72844,"_21645":120632,"_5":14907,"_28433":120595,"_3077":51222},[],{"_3625":72861,"_31241":72844,"_21645":120634,"_5":14907,"_28433":120595,"_3077":120635},[],"99,5 %",{"_3625":72862,"_31241":72844,"_21645":120637,"_5":14907,"_28433":120595,"_3077":51228},[],{"_3625":72863,"_31241":72844,"_21645":120639,"_5":14907,"_28433":120595,"_3077":120640},[],"Hasta 10.000",{"_3625":72864,"_31241":72844,"_21645":120642,"_5":14907,"_28433":120595,"_3077":120643},[],"Email y chat",{"_3625":72865,"_31241":72844,"_21645":120645,"_5":14907,"_28433":120595,"_3077":120646},[],"99,9 %",{"_3625":72866,"_31241":72844,"_21645":120648,"_5":14907,"_28433":120595,"_3077":51240},[],{"_3625":72867,"_31241":72844,"_21645":120650,"_5":14907,"_28433":120595,"_3077":120651},[],"Ilimitados",{"_3625":72868,"_31241":72844,"_21645":120653,"_5":14907,"_28433":120595,"_3077":120654},[],"Dedicado",{"_3625":72869,"_31241":72844,"_21645":120656,"_5":14907,"_28433":120595,"_3077":120657},[],"99,99 %",{"_3625":72870,"_31241":72844,"_21645":120659,"_5":14907,"_28433":120599,"_3077":120660},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3625":72871,"_31241":72844,"_21645":120662,"_5":14907,"_28433":120599,"_3077":120663},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3625":72872,"_31241":72872,"_5":15267,"_3077":51257,"_31600":120665,"_21645":120667,"_28433":72872},[51013,120432,120666],"Kubernetes autogestionado",[],{"_3625":72873,"_31241":72872,"_21645":120669,"_5":14907,"_28433":72872,"_3077":120670},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3625":72874,"_31241":72872,"_5":31597,"_21645":120672,"_28433":120673,"_3077":120674},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3625":72875,"_31241":72872,"_5":31597,"_21645":120676,"_28433":120677,"_3077":120678},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3625":72876,"_31241":72872,"_5":31597,"_21645":120680,"_28433":120681,"_3077":120682},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3625":72877,"_31241":72872,"_5":31597,"_21645":120684,"_28433":120685,"_3077":120686},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3625":72878,"_31241":72872,"_5":31597,"_21645":120688,"_28433":120689,"_3077":120690},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3625":72879,"_31241":72872,"_5":31597,"_21645":120692,"_28433":120693,"_3077":120694},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3625":72880,"_31241":72872,"_5":31597,"_21645":120696,"_28433":120697,"_3077":120698},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3625":72881,"_31241":72872,"_5":31597,"_21645":120700,"_28433":120701,"_3077":120702},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3625":72882,"_31241":72872,"_5":31597,"_21645":120704,"_28433":120705,"_3077":120706},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3625":72883,"_31241":72872,"_5":31597,"_21645":120708,"_28433":120709,"_3077":120710},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3625":72884,"_31241":72872,"_5":31597,"_21645":120712,"_28433":120713,"_3077":120714},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3625":72885,"_31241":72872,"_21645":120716,"_5":14907,"_28433":120673,"_3077":120717},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3625":72886,"_31241":72872,"_21645":120719,"_5":14907,"_28433":120673,"_3077":120720},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3625":72887,"_31241":72872,"_21645":120722,"_5":14907,"_28433":120677,"_3077":120723},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3625":72888,"_31241":72872,"_21645":120725,"_5":14907,"_28433":120677,"_3077":120726},[],"Fastlane instala o configura",{"_3625":72889,"_31241":72872,"_21645":120728,"_5":14907,"_28433":120677,"_3077":120729},[],"Tú sigues proporcionando",{"_3625":72890,"_31241":72872,"_21645":120731,"_5":14907,"_28433":120677,"_3077":120732},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3625":72891,"_31241":72872,"_21645":120734,"_5":14907,"_28433":120677,"_3077":120735},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3625":72892,"_31241":72872,"_21645":120737,"_5":14907,"_28433":120677,"_3077":120738},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3625":72893,"_31241":72872,"_21645":120740,"_5":14907,"_28433":120677,"_3077":120741},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3625":72894,"_31241":72872,"_21645":120743,"_5":14907,"_28433":120677,"_3077":120744},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3625":72895,"_31241":72872,"_21645":120746,"_5":14907,"_28433":120677,"_3077":120747},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3625":72896,"_31241":72872,"_21645":120749,"_5":14907,"_28433":120677,"_3077":120750},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3625":72897,"_31241":72872,"_21645":120752,"_5":14907,"_28433":120677,"_3077":120753},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3625":72898,"_31241":72872,"_21645":120755,"_5":14907,"_28433":120677,"_3077":120756},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3625":72899,"_31241":72872,"_21645":120758,"_5":14907,"_28433":120681,"_3077":120759},[],"Necesitas:",{"_3625":72900,"_31241":72872,"_21645":120761,"_5":14907,"_28433":120681,"_3077":120762},[],"un clúster Kubernetes existente",{"_3625":72901,"_31241":72872,"_21645":120764,"_5":14907,"_28433":120681,"_3077":120765},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3625":72902,"_31241":72872,"_21645":120767,"_5":14907,"_28433":120681,"_3077":51359},[],{"_3625":72903,"_31241":72872,"_21645":120769,"_5":14907,"_28433":120681,"_3077":24477},[],{"_3625":72904,"_31241":72872,"_21645":120771,"_5":14907,"_28433":120681,"_3077":120772},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3625":72905,"_31241":72872,"_21645":120774,"_5":14907,"_28433":120681,"_3077":120775},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3625":72906,"_31241":72872,"_21645":120777,"_5":14907,"_28433":120681,"_3077":120778},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3625":72907,"_31241":72872,"_21645":120780,"_5":14907,"_28433":120681,"_3077":120781},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3625":72908,"_31241":72872,"_21645":120783,"_5":14907,"_28433":120681,"_3077":120784},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3625":72909,"_31241":72872,"_21645":120786,"_5":14907,"_28433":120685,"_3077":120787},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3625":72910,"_31241":72872,"_21645":120789,"_5":14907,"_28433":120685,"_3077":120790},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3625":72911,"_31241":72872,"_21645":120792,"_5":14907,"_28433":120689,"_3077":120793},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3625":72912,"_31241":72872,"_21645":120795,"_5":14907,"_28433":120689,"_3077":120796},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3625":72913,"_31241":72872,"_21645":120798,"_5":14907,"_28433":120689,"_3077":120799},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3625":72914,"_31241":72872,"_21645":120801,"_5":14907,"_28433":120689,"_3077":120802},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3625":72915,"_31241":72872,"_21645":120804,"_5":14907,"_28433":120693,"_3077":120805},[],"Opción",{"_3625":72916,"_31241":72872,"_21645":120807,"_5":14907,"_28433":120693,"_3077":120808},[],"Valor predeterminado",{"_3625":72917,"_31241":72872,"_21645":120810,"_5":14907,"_28433":120693,"_3077":120811},[],"Propósito",{"_3625":72918,"_31241":72872,"_21645":120813,"_5":14907,"_28433":120693,"_3077":51406},[],{"_3625":72919,"_31241":72872,"_21645":120815,"_5":14907,"_28433":120693,"_3077":51409},[],{"_3625":72920,"_31241":72872,"_21645":120817,"_5":14907,"_28433":120693,"_3077":120818},[],"Muestra la ayuda",{"_3625":72921,"_31241":72872,"_21645":120820,"_5":14907,"_28433":120693,"_3077":51415},[],{"_3625":72922,"_31241":72872,"_21645":120822,"_5":14907,"_28433":120693,"_3077":120823},[],"contexto actual",{"_3625":72923,"_31241":72872,"_21645":120825,"_5":14907,"_28433":120693,"_3077":120826},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3625":72924,"_31241":72872,"_21645":120828,"_5":14907,"_28433":120693,"_3077":51424},[],{"_3625":72925,"_31241":72872,"_21645":120830,"_5":14907,"_28433":120693,"_3077":6797},[],{"_3625":72926,"_31241":72872,"_21645":120832,"_5":14907,"_28433":120693,"_3077":120833},[],"Omite prompts y genera credenciales para las dependencias",{"_3625":72927,"_31241":72872,"_21645":120835,"_5":14907,"_28433":120693,"_3077":51432},[],{"_3625":72928,"_31241":72872,"_21645":120837,"_5":14907,"_28433":120693,"_3077":51435},[],{"_3625":72929,"_31241":72872,"_21645":120839,"_5":14907,"_28433":120693,"_3077":120840},[],"Namespace de la instalación",{"_3625":72930,"_31241":72872,"_21645":120842,"_5":14907,"_28433":120693,"_3077":51441},[],{"_3625":72931,"_31241":72872,"_21645":120844,"_5":14907,"_28433":120693,"_3077":51444},[],{"_3625":72932,"_31241":72872,"_21645":120846,"_5":14907,"_28433":120693,"_3077":120847},[],"Dominio usado por la UI, OIDC y el certificado",{"_3625":72933,"_31241":72872,"_21645":120849,"_5":14907,"_28433":120693,"_3077":51450},[],{"_3625":72934,"_31241":72872,"_21645":120851,"_5":14907,"_28433":120693,"_3077":15624},[],{"_3625":72935,"_31241":72872,"_21645":120853,"_5":14907,"_28433":120693,"_3077":120854},[],"Versión del chart de Lamassu",{"_3625":72936,"_31241":72872,"_21645":120856,"_5":14907,"_28433":120693,"_3077":51458},[],{"_3625":72937,"_31241":72872,"_21645":120858,"_5":14907,"_28433":120693,"_3077":51461},[],{"_3625":72938,"_31241":72872,"_21645":120860,"_5":14907,"_28433":120693,"_3077":120861},[],"Puerto del listener HTTPS",{"_3625":72939,"_31241":72872,"_21645":120863,"_5":14907,"_28433":120693,"_3077":51467},[],{"_3625":72940,"_31241":72872,"_21645":120865,"_5":14907,"_28433":120693,"_3077":51470},[],{"_3625":72941,"_31241":72872,"_21645":120867,"_5":14907,"_28433":120693,"_3077":120868},[],"Puerto del listener HTTP",{"_3625":72942,"_31241":72872,"_21645":120870,"_5":14907,"_28433":120693,"_3077":51476},[],{"_3625":72943,"_31241":72872,"_21645":120872,"_5":14907,"_28433":120693,"_3077":51409},[],{"_3625":72944,"_31241":72872,"_21645":120874,"_5":14907,"_28433":120693,"_3077":120875},[],"Certificado PEM para TLS downstream",{"_3625":72945,"_31241":72872,"_21645":120877,"_5":14907,"_28433":120693,"_3077":51484},[],{"_3625":72946,"_31241":72872,"_21645":120879,"_5":14907,"_28433":120693,"_3077":51409},[],{"_3625":72947,"_31241":72872,"_21645":120881,"_5":14907,"_28433":120693,"_3077":120882},[],"Clave privada PEM para TLS downstream",{"_3625":72948,"_31241":72872,"_21645":120884,"_5":14907,"_28433":120693,"_3077":51492},[],{"_3625":72949,"_31241":72872,"_21645":120886,"_5":14907,"_28433":120693,"_3077":120887},[],"chart del repositorio",{"_3625":72950,"_31241":72872,"_21645":120889,"_5":14907,"_28433":120693,"_3077":120890},[],"Usa un chart local de Lamassu sin empaquetar",{"_3625":72951,"_31241":72872,"_21645":120892,"_5":14907,"_28433":120693,"_3077":51501},[],{"_3625":72952,"_31241":72872,"_21645":120894,"_5":14907,"_28433":120693,"_3077":120895},[],"detección automática",{"_3625":72953,"_31241":72872,"_21645":120897,"_5":14907,"_28433":120693,"_3077":120898},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3625":72954,"_31241":72872,"_21645":120900,"_5":14907,"_28433":120693,"_3077":51509},[],{"_3625":72955,"_31241":72872,"_21645":120902,"_5":14907,"_28433":120693,"_3077":6797},[],{"_3625":72956,"_31241":72872,"_21645":120904,"_5":14907,"_28433":120693,"_3077":120905},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3625":72957,"_31241":72872,"_21645":120907,"_5":14907,"_28433":120693,"_3077":51517},[],{"_3625":72958,"_31241":72872,"_21645":120909,"_5":14907,"_28433":120693,"_3077":6797},[],{"_3625":72959,"_31241":72872,"_21645":120911,"_5":14907,"_28433":120693,"_3077":120912},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3625":72960,"_31241":72872,"_21645":120914,"_5":14907,"_28433":120693,"_3077":51525},[],{"_3625":72961,"_31241":72872,"_21645":120916,"_5":14907,"_28433":120693,"_3077":6797},[],{"_3625":72962,"_31241":72872,"_21645":120918,"_5":14907,"_28433":120693,"_3077":120919},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3625":72963,"_31241":72872,"_21645":120921,"_5":14907,"_28433":120693,"_3077":51533},[],{"_3625":72964,"_31241":72872,"_21645":120923,"_5":14907,"_28433":120693,"_3077":6797},[],{"_3625":72965,"_31241":72872,"_21645":120925,"_5":14907,"_28433":120693,"_3077":120926},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3625":72966,"_31241":72872,"_21645":120928,"_5":14907,"_28433":120693,"_3077":51541},[],{"_3625":72967,"_31241":72872,"_21645":120930,"_5":14907,"_28433":120693,"_3077":51544},[],{"_3625":72968,"_31241":72872,"_21645":120932,"_5":14907,"_28433":120693,"_3077":120933},[],"Usa otro chart local de SoftHSM",{"_3625":72969,"_31241":72872,"_21645":120935,"_5":14907,"_28433":120693,"_3077":120936},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3625":72970,"_31241":72872,"_21645":120938,"_5":14907,"_28433":120697,"_3077":120939},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3625":72971,"_31241":72872,"_21645":120941,"_5":14907,"_28433":120697,"_3077":120942},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3625":72972,"_31241":72872,"_21645":120944,"_5":14907,"_28433":120697,"_3077":120945},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3625":72973,"_31241":72872,"_21645":120947,"_5":14907,"_28433":120697,"_3077":120948},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3625":72974,"_31241":72872,"_21645":120950,"_5":14907,"_28433":120697,"_3077":120951},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3625":72975,"_31241":72872,"_21645":120953,"_5":14907,"_28433":120697,"_3077":120954},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3625":72976,"_31241":72872,"_21645":120956,"_5":14907,"_28433":120701,"_3077":51571},[],{"_3625":72977,"_31241":72872,"_21645":120958,"_5":14907,"_28433":120701,"_3077":120959},[],"valida las herramientas locales y el clúster seleccionado",{"_3625":72978,"_31241":72872,"_21645":120961,"_5":14907,"_28433":120701,"_3077":120962},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3625":72979,"_31241":72872,"_21645":120964,"_5":14907,"_28433":120701,"_3077":120965},[],"crea el namespace",{"_3625":72980,"_31241":72872,"_21645":120967,"_5":14907,"_28433":120701,"_3077":120968},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3625":72981,"_31241":72872,"_21645":120970,"_5":14907,"_28433":120701,"_3077":120971},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3625":72982,"_31241":72872,"_21645":120973,"_5":14907,"_28433":120701,"_3077":120974},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3625":72983,"_31241":72872,"_21645":120976,"_5":14907,"_28433":120701,"_3077":120977},[],"instala RabbitMQ",{"_3625":72984,"_31241":72872,"_21645":120979,"_5":14907,"_28433":120701,"_3077":120980},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3625":72985,"_31241":72872,"_21645":120982,"_5":14907,"_28433":120701,"_3077":120983},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3625":72986,"_31241":72872,"_21645":120985,"_5":14907,"_28433":120701,"_3077":120986},[],"carga datos de ejemplo opcionalmente",{"_3625":72987,"_31241":72872,"_21645":120988,"_5":14907,"_28433":120701,"_3077":120989},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3625":72988,"_31241":72872,"_21645":120991,"_5":14907,"_28433":120705,"_3077":120992},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3625":72989,"_31241":72872,"_21645":120994,"_5":14907,"_28433":120705,"_3077":120995},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3625":72990,"_31241":72872,"_21645":120997,"_5":14907,"_28433":120709,"_3077":120998},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3625":72991,"_31241":72872,"_21645":121000,"_5":14907,"_28433":120709,"_3077":121001},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3625":72992,"_31241":72872,"_21645":121003,"_5":14907,"_28433":120709,"_3077":121004},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3625":72993,"_31241":72872,"_21645":121006,"_5":14907,"_28433":120709,"_3077":121007},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3625":72994,"_31241":72872,"_21645":121009,"_5":14907,"_28433":120713,"_3077":121010},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3625":72995,"_31241":72995,"_5":15267,"_3077":121012,"_31600":121013,"_21645":121014,"_28433":72995},"Instala con Helm",[51013,120432,120666],[],{"_3625":72996,"_31241":72995,"_21645":121016,"_5":14907,"_28433":72995,"_3077":121017},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3625":72997,"_31241":72995,"_5":31597,"_21645":121019,"_28433":121020,"_3077":121021},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3625":72998,"_31241":72995,"_5":31597,"_21645":121023,"_28433":121024,"_3077":120682},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3625":72999,"_31241":72995,"_5":31597,"_21645":121026,"_28433":121027,"_3077":121028},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3625":73000,"_31241":72995,"_5":31597,"_21645":121030,"_28433":121031,"_3077":121032},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3625":73001,"_31241":72995,"_5":31597,"_21645":121034,"_28433":121035,"_3077":121036},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3625":73002,"_31241":72995,"_5":31597,"_21645":121038,"_28433":121039,"_3077":121040},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3625":73003,"_31241":72995,"_5":31597,"_21645":121042,"_28433":121043,"_3077":121044},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3625":73004,"_31241":72995,"_5":31597,"_21645":121046,"_28433":121047,"_3077":121048},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3625":73005,"_31241":72995,"_5":31597,"_21645":121050,"_28433":121051,"_3077":121052},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3625":73006,"_31241":72995,"_5":31597,"_21645":121054,"_28433":121055,"_3077":121056},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3625":73007,"_31241":72995,"_5":31597,"_21645":121058,"_28433":121059,"_3077":121060},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3625":73008,"_31241":72995,"_5":31597,"_21645":121062,"_28433":121063,"_3077":121064},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3625":73009,"_31241":72995,"_21645":121066,"_5":14907,"_28433":121020,"_3077":121067},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3625":73010,"_31241":72995,"_21645":121069,"_5":14907,"_28433":121024,"_3077":121070},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3625":73011,"_31241":72995,"_21645":121072,"_5":14907,"_28433":121024,"_3077":121073},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3625":73012,"_31241":72995,"_21645":121075,"_5":14907,"_28433":121024,"_3077":121076},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3625":73013,"_31241":72995,"_21645":121078,"_5":14907,"_28433":121024,"_3077":121079},[],"un broker RabbitMQ accesible y sus credenciales",{"_3625":73014,"_31241":72995,"_21645":121081,"_5":14907,"_28433":121024,"_3077":121082},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3625":73015,"_31241":72995,"_21645":121084,"_5":14907,"_28433":121024,"_3077":121085},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3625":73016,"_31241":72995,"_21645":121087,"_5":14907,"_28433":121024,"_3077":121088},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3625":73017,"_31241":72995,"_21645":121090,"_5":14907,"_28433":121024,"_3077":121091},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3625":73018,"_31241":72995,"_21645":121093,"_5":14907,"_28433":121024,"_3077":121094},[],"una StorageClass y un diseño de tráfico externo",{"_3625":73019,"_31241":72995,"_21645":121096,"_5":14907,"_28433":121024,"_3077":121097},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3625":73020,"_31241":72995,"_21645":121099,"_5":14907,"_28433":121024,"_3077":121100},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3625":73021,"_31241":72995,"_21645":121102,"_5":14907,"_28433":121024,"_3077":121103},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3625":73022,"_31241":72995,"_21645":121105,"_5":14907,"_28433":121027,"_3077":121106},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3625":73023,"_31241":72995,"_21645":121108,"_5":14907,"_28433":121027,"_3077":121109},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3625":73024,"_31241":72995,"_21645":121111,"_5":14907,"_28433":121027,"_3077":121112},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3625":73025,"_31241":72995,"_21645":121114,"_5":14907,"_28433":121031,"_3077":121115},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3625":73026,"_31241":72995,"_21645":121117,"_5":14907,"_28433":121031,"_3077":121118},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3625":73027,"_31241":72995,"_21645":121120,"_5":14907,"_28433":121031,"_3077":121121},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3625":73028,"_31241":72995,"_21645":121123,"_5":14907,"_28433":121031,"_3077":121124},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3625":73029,"_31241":72995,"_21645":121126,"_5":14907,"_28433":121035,"_3077":121127},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3625":73030,"_31241":72995,"_21645":121129,"_5":14907,"_28433":121035,"_3077":121130},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3625":73031,"_31241":72995,"_21645":121132,"_5":14907,"_28433":121035,"_3077":121133},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3625":73032,"_31241":72995,"_21645":121135,"_5":14907,"_28433":121035,"_3077":121136},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3625":73033,"_31241":72995,"_21645":121138,"_5":14907,"_28433":121035,"_3077":121139},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3625":73034,"_31241":72995,"_21645":121141,"_5":14907,"_28433":121035,"_3077":121142},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3625":73035,"_31241":72995,"_21645":121144,"_5":14907,"_28433":121035,"_3077":121145},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3625":73036,"_31241":72995,"_21645":121147,"_5":14907,"_28433":121035,"_3077":121148},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3625":73037,"_31241":72995,"_21645":121150,"_5":14907,"_28433":121039,"_3077":121151},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3625":73038,"_31241":72995,"_21645":121153,"_5":14907,"_28433":121043,"_3077":121154},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3625":73039,"_31241":72995,"_21645":121156,"_5":14907,"_28433":121043,"_3077":121157},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3625":73040,"_31241":72995,"_21645":121159,"_5":14907,"_28433":121043,"_3077":121160},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3625":73041,"_31241":72995,"_21645":121162,"_5":14907,"_28433":121043,"_3077":121163},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3625":73042,"_31241":72995,"_21645":121165,"_5":14907,"_28433":121043,"_3077":121166},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3625":73043,"_31241":72995,"_21645":121168,"_5":14907,"_28433":121043,"_3077":121169},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3625":73044,"_31241":72995,"_21645":121171,"_5":14907,"_28433":121043,"_3077":121172},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3625":73045,"_31241":72995,"_21645":121174,"_5":14907,"_28433":121047,"_3077":121175},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3625":73046,"_31241":72995,"_21645":121177,"_5":14907,"_28433":121047,"_3077":121178},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3625":73047,"_31241":72995,"_21645":121180,"_5":14907,"_28433":121047,"_3077":121181},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3625":73048,"_31241":72995,"_21645":121183,"_5":14907,"_28433":121047,"_3077":121184},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3625":73049,"_31241":72995,"_21645":121186,"_5":14907,"_28433":121051,"_3077":121187},[],"Para instalar un checkout local:",{"_3625":73050,"_31241":72995,"_21645":121189,"_5":14907,"_28433":121055,"_3077":121190},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3625":73051,"_31241":72995,"_21645":121192,"_5":14907,"_28433":121055,"_3077":121193},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3625":73052,"_31241":72995,"_21645":121195,"_5":14907,"_28433":121059,"_3077":121196},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3625":73053,"_31241":72995,"_21645":121198,"_5":14907,"_28433":121059,"_3077":121199},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3625":73054,"_31241":72995,"_21645":121201,"_5":14907,"_28433":121059,"_3077":121202},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3625":73055,"_31241":72995,"_21645":121204,"_5":14907,"_28433":121059,"_3077":121205},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3625":73056,"_31241":72995,"_21645":121207,"_5":14907,"_28433":121059,"_3077":121208},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3625":73057,"_31241":72995,"_21645":121210,"_5":14907,"_28433":121063,"_3077":121211},[],"Antes de pasar a producción, revisa:",{"_3625":73058,"_31241":72995,"_21645":121213,"_5":14907,"_28433":121063,"_3077":121214},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3625":73059,"_31241":72995,"_21645":121216,"_5":14907,"_28433":121063,"_3077":121217},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3625":73060,"_31241":72995,"_21645":121219,"_5":14907,"_28433":121063,"_3077":121220},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3625":73061,"_31241":72995,"_21645":121222,"_5":14907,"_28433":121063,"_3077":121223},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3625":73062,"_31241":72995,"_21645":121225,"_5":14907,"_28433":121063,"_3077":121226},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3625":73063,"_31241":72995,"_21645":121228,"_5":14907,"_28433":121063,"_3077":121229},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3625":73064,"_31241":72995,"_21645":121231,"_5":14907,"_28433":121063,"_3077":121232},[],"SMTP, observabilidad y entrega de alertas",{"_3625":73065,"_31241":72995,"_21645":121234,"_5":14907,"_28433":121063,"_3077":121235},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3625":73066,"_31241":72995,"_21645":121237,"_5":14907,"_28433":121063,"_3077":121238},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3625":73067,"_31241":73067,"_5":15267,"_3077":121240,"_31600":121241,"_21645":121242,"_28433":73067},"Expón el Gateway",[51013,120432,120666],[],{"_3625":73068,"_31241":73067,"_21645":121244,"_5":14907,"_28433":73067,"_3077":121245},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3625":73069,"_31241":73067,"_5":31597,"_21645":121247,"_28433":121248,"_3077":121249},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3625":73070,"_31241":73067,"_5":31597,"_21645":121251,"_28433":121252,"_3077":121253},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3625":73071,"_31241":73067,"_5":31597,"_21645":121255,"_28433":121256,"_3077":121257},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3625":73072,"_31241":73067,"_5":31597,"_21645":121259,"_28433":121260,"_3077":51876},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#k3s",{"_3625":73073,"_31241":73067,"_5":31597,"_21645":121262,"_28433":121263,"_3077":121264},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3625":73074,"_31241":73067,"_5":31597,"_21645":121266,"_28433":121267,"_3077":121268},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3625":73075,"_31241":73067,"_5":31597,"_21645":121270,"_28433":121271,"_3077":121272},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3625":73076,"_31241":73067,"_5":31597,"_21645":121274,"_28433":121275,"_3077":121276},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3625":73077,"_31241":73067,"_5":31597,"_21645":121278,"_28433":121279,"_3077":121280},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3625":73078,"_31241":73067,"_5":31597,"_21645":121282,"_28433":121283,"_3077":121284},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3625":73079,"_31241":73067,"_5":31597,"_21645":121286,"_28433":121287,"_3077":121288},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3625":73080,"_31241":73067,"_21645":121290,"_5":14907,"_28433":121248,"_3077":121291},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3625":73081,"_31241":73067,"_21645":121293,"_5":14907,"_28433":121248,"_3077":121294},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3625":73082,"_31241":73067,"_21645":121296,"_5":14907,"_28433":121252,"_3077":121297},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3625":73083,"_31241":73067,"_21645":121299,"_5":14907,"_28433":121252,"_3077":121300},[],"Defínelo únicamente cuando:",{"_3625":73084,"_31241":73067,"_21645":121302,"_5":14907,"_28433":121252,"_3077":121303},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3625":73085,"_31241":73067,"_21645":121305,"_5":14907,"_28433":121252,"_3077":121306},[],"esa dirección está asignada a este Gateway",{"_3625":73086,"_31241":73067,"_21645":121308,"_5":14907,"_28433":121252,"_3077":121309},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3625":73087,"_31241":73067,"_21645":121311,"_5":14907,"_28433":121252,"_3077":121312},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3625":73088,"_31241":73067,"_21645":121314,"_5":14907,"_28433":121252,"_3077":121315},[],"No confundas estos valores:",{"_3625":73089,"_31241":73067,"_21645":121317,"_5":14907,"_28433":121252,"_3077":121318},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3625":73090,"_31241":73067,"_21645":121320,"_5":14907,"_28433":121252,"_3077":121321},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3625":73091,"_31241":73067,"_21645":121323,"_5":14907,"_28433":121252,"_3077":121324},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3625":73092,"_31241":73067,"_21645":121326,"_5":14907,"_28433":121256,"_3077":121327},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3625":73093,"_31241":73067,"_21645":121329,"_5":14907,"_28433":121256,"_3077":121330},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3625":73094,"_31241":73067,"_21645":121332,"_5":14907,"_28433":121260,"_3077":121333},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3625":73095,"_31241":73067,"_21645":121335,"_5":14907,"_28433":121260,"_3077":121336},[],"Para el diseño recomendado:",{"_3625":73096,"_31241":73067,"_21645":121338,"_5":14907,"_28433":121260,"_3077":121339},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3625":73097,"_31241":73067,"_21645":121341,"_5":14907,"_28433":121260,"_3077":121342},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3625":73098,"_31241":73067,"_21645":121344,"_5":14907,"_28433":121260,"_3077":121345},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3625":73099,"_31241":73067,"_21645":121347,"_5":14907,"_28433":121260,"_3077":121348},[],"Apunta DNS a la dirección accesible de la VM.",{"_3625":73100,"_31241":73067,"_21645":121350,"_5":14907,"_28433":121260,"_3077":121351},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3625":73101,"_31241":73067,"_21645":121353,"_5":14907,"_28433":121263,"_3077":121354},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3625":73102,"_31241":73067,"_21645":121356,"_5":14907,"_28433":121267,"_3077":121357},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3625":73103,"_31241":73067,"_21645":121359,"_5":14907,"_28433":121267,"_3077":121360},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3625":73104,"_31241":73067,"_21645":121362,"_5":14907,"_28433":121271,"_3077":121363},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3625":73105,"_31241":73067,"_21645":121365,"_5":14907,"_28433":121271,"_3077":121366},[],"Requisito",{"_3625":73106,"_31241":73067,"_21645":121368,"_5":14907,"_28433":121271,"_3077":121369},[],"Diseño recomendado",{"_3625":73107,"_31241":73067,"_21645":121371,"_5":14907,"_28433":121271,"_3077":121372},[],"Consecuencia",{"_3625":73108,"_31241":73067,"_21645":121374,"_5":14907,"_28433":121271,"_3077":121375},[],"Varias URL o servicios de Lamassu",{"_3625":73109,"_31241":73067,"_21645":121377,"_5":14907,"_28433":121271,"_3077":121378},[],"Un Gateway con varias rutas",{"_3625":73110,"_31241":73067,"_21645":121380,"_5":14907,"_28433":121271,"_3077":121381},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3625":73111,"_31241":73067,"_21645":121383,"_5":14907,"_28433":121271,"_3077":121384},[],"Gateways independientes e IP externas distintas",{"_3625":73112,"_31241":73067,"_21645":121386,"_5":14907,"_28433":121271,"_3077":121387},[],"Una VIP por Gateway",{"_3625":73113,"_31241":73067,"_21645":121389,"_5":14907,"_28433":121271,"_3077":121390},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3625":73114,"_31241":73067,"_21645":121392,"_5":14907,"_28433":121271,"_3077":121393},[],"Gateways independientes, un nodo y una IP",{"_3625":73115,"_31241":73067,"_21645":121395,"_5":14907,"_28433":121271,"_3077":121396},[],"Puertos externos diferentes",{"_3625":73116,"_31241":73067,"_21645":121398,"_5":14907,"_28433":121271,"_3077":121399},[],"Los clientes deben indicar puertos no estándar",{"_3625":73117,"_31241":73067,"_21645":121401,"_5":14907,"_28433":121271,"_3077":121402},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3625":73118,"_31241":73067,"_21645":121404,"_5":14907,"_28433":121271,"_3077":121405},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3625":73119,"_31241":73067,"_21645":121407,"_5":14907,"_28433":121271,"_3077":121408},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3625":73120,"_31241":73067,"_21645":121410,"_5":14907,"_28433":121271,"_3077":121411},[],"Recursos Gateway separados pero proxy compartido",{"_3625":73121,"_31241":73067,"_21645":121413,"_5":14907,"_28433":121271,"_3077":121414},[],"Modo merged Gateway de Envoy",{"_3625":73122,"_31241":73067,"_21645":121416,"_5":14907,"_28433":121271,"_3077":121417},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3625":73123,"_31241":73067,"_21645":121419,"_5":14907,"_28433":121271,"_3077":121420},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3625":73124,"_31241":73067,"_21645":121422,"_5":14907,"_28433":121271,"_3077":121423},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3625":73125,"_31241":73067,"_21645":121425,"_5":14907,"_28433":121271,"_3077":121426},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3625":73126,"_31241":73067,"_21645":121428,"_5":14907,"_28433":121271,"_3077":121429},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3625":73127,"_31241":73067,"_21645":121431,"_5":14907,"_28433":121275,"_3077":121432},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3625":73128,"_31241":73067,"_21645":121434,"_5":14907,"_28433":121279,"_3077":121435},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3625":73129,"_31241":73067,"_21645":121437,"_5":14907,"_28433":121279,"_3077":121438},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3625":73130,"_31241":73067,"_21645":121440,"_5":14907,"_28433":121279,"_3077":121441},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3625":73131,"_31241":73067,"_21645":121443,"_5":14907,"_28433":121279,"_3077":121444},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3625":73132,"_31241":73067,"_21645":121446,"_5":14907,"_28433":121279,"_3077":121447},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3625":73133,"_31241":73067,"_21645":121449,"_5":14907,"_28433":121283,"_3077":121450},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3625":73134,"_31241":73067,"_21645":121452,"_5":14907,"_28433":121283,"_3077":121453},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3625":73135,"_31241":73067,"_21645":121455,"_5":14907,"_28433":121287,"_3077":121456},[],"Comprueba, en orden:",{"_3625":73136,"_31241":73067,"_21645":121458,"_5":14907,"_28433":121287,"_3077":121459},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3625":73137,"_31241":73067,"_21645":121461,"_5":14907,"_28433":121287,"_3077":121462},[],"Su estado contiene la dirección esperada.",{"_3625":73138,"_31241":73067,"_21645":121464,"_5":14907,"_28433":121287,"_3077":121465},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3625":73139,"_31241":73067,"_21645":121467,"_5":14907,"_28433":121287,"_3077":121468},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3625":73140,"_31241":73067,"_21645":121470,"_5":14907,"_28433":121287,"_3077":121471},[],"DNS resuelve al endpoint accesible externamente.",{"_3625":73141,"_31241":73067,"_21645":121473,"_5":14907,"_28433":121287,"_3077":121474},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3625":73142,"_31241":73067,"_21645":121476,"_5":14907,"_28433":121287,"_3077":121477},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3625":73143,"_31241":73143,"_5":15267,"_3077":51120,"_31600":121479,"_21645":121480,"_28433":73143},[51013,120432,120666],[],{"_3625":73144,"_31241":73143,"_21645":121482,"_5":14907,"_28433":73143,"_3077":121483},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3625":73145,"_31241":73143,"_5":31597,"_21645":121485,"_28433":121486,"_3077":121487},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3625":73146,"_31241":73143,"_5":31597,"_21645":121489,"_28433":121490,"_3077":121491},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3625":73147,"_31241":73143,"_5":31597,"_21645":121493,"_28433":121494,"_3077":121495},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3625":73148,"_31241":73143,"_5":31597,"_21645":121497,"_28433":121498,"_3077":121499},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3625":73149,"_31241":73143,"_5":31597,"_21645":121501,"_28433":121502,"_3077":121503},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3625":73150,"_31241":73143,"_5":31597,"_21645":121505,"_28433":121506,"_3077":121507},[],"/docs/pr-preview/pr-78/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3625":73151,"_31241":73143,"_21645":121509,"_5":14907,"_28433":121486,"_3077":121510},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3625":73152,"_31241":73143,"_21645":121512,"_5":14907,"_28433":121490,"_3077":121513},[],"Flujo",{"_3625":73153,"_31241":73143,"_21645":121515,"_5":14907,"_28433":121490,"_3077":121516},[],"Úsalo para",{"_3625":73154,"_31241":73143,"_21645":121518,"_5":14907,"_28433":121490,"_3077":121519},[],"Qué instala",{"_3625":73155,"_31241":73143,"_21645":121521,"_5":14907,"_28433":121490,"_3077":52138},[],{"_3625":73156,"_31241":73143,"_21645":121523,"_5":14907,"_28433":121490,"_3077":121524},[],"Producción y entornos controlados",{"_3625":73157,"_31241":73143,"_21645":121526,"_5":14907,"_28433":121490,"_3077":121527},[],"Servicios de Lamassu y recursos de Gateway API",{"_3625":73158,"_31241":73143,"_21645":121529,"_5":14907,"_28433":121490,"_3077":51257},[],{"_3625":73159,"_31241":73143,"_21645":121531,"_5":14907,"_28433":121490,"_3077":121532},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3625":73160,"_31241":73143,"_21645":121534,"_5":14907,"_28433":121490,"_3077":121535},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3625":73161,"_31241":73143,"_21645":121537,"_5":14907,"_28433":121494,"_3077":121538},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3625":73162,"_31241":73143,"_21645":121540,"_5":14907,"_28433":121494,"_3077":121541},[],"Área",{"_3625":73163,"_31241":73143,"_21645":121543,"_5":14907,"_28433":121494,"_3077":121544},[],"El chart de Lamassu proporciona",{"_3625":73164,"_31241":73143,"_21645":121546,"_5":14907,"_28433":121494,"_3077":121547},[],"Tú proporcionas",{"_3625":73165,"_31241":73143,"_21645":121549,"_5":14907,"_28433":121494,"_3077":121550},[],"Aplicaciones Lamassu",{"_3625":73166,"_31241":73143,"_21645":121552,"_5":14907,"_28433":121494,"_3077":121553},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3625":73167,"_31241":73143,"_21645":121555,"_5":14907,"_28433":121494,"_3077":121556},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3625":73168,"_31241":73143,"_21645":121558,"_5":14907,"_28433":121494,"_3077":121559},[],"Datos PostgreSQL",{"_3625":73169,"_31241":73143,"_21645":121561,"_5":14907,"_28433":121494,"_3077":121562},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3625":73170,"_31241":73143,"_21645":121564,"_5":14907,"_28433":121494,"_3077":121565},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3625":73171,"_31241":73143,"_21645":121567,"_5":14907,"_28433":121494,"_3077":121568},[],"Mensajería",{"_3625":73172,"_31241":73143,"_21645":121570,"_5":14907,"_28433":121494,"_3077":121571},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3625":73173,"_31241":73143,"_21645":121573,"_5":14907,"_28433":121494,"_3077":121574},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3625":73174,"_31241":73143,"_21645":121576,"_5":14907,"_28433":121494,"_3077":121577},[],"Identidad",{"_3625":73175,"_31241":73143,"_21645":121579,"_5":14907,"_28433":121494,"_3077":121580},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3625":73176,"_31241":73143,"_21645":121582,"_5":14907,"_28433":121494,"_3077":121583},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3625":73177,"_31241":73143,"_21645":121585,"_5":14907,"_28433":121494,"_3077":121586},[],"Enrutamiento externo",{"_3625":73178,"_31241":73143,"_21645":121588,"_5":14907,"_28433":121494,"_3077":121589},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3625":73179,"_31241":73143,"_21645":121591,"_5":14907,"_28433":121494,"_3077":121592},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3625":73180,"_31241":73143,"_21645":121594,"_5":14907,"_28433":121494,"_3077":52212},[],{"_3625":73181,"_31241":73143,"_21645":121596,"_5":14907,"_28433":121494,"_3077":121597},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3625":73182,"_31241":73143,"_21645":121599,"_5":14907,"_28433":121494,"_3077":121600},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3625":73183,"_31241":73143,"_21645":121602,"_5":14907,"_28433":121494,"_3077":121603},[],"Datos persistentes de la aplicación",{"_3625":73184,"_31241":73143,"_21645":121605,"_5":14907,"_28433":121494,"_3077":121606},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3625":73185,"_31241":73143,"_21645":121608,"_5":14907,"_28433":121494,"_3077":121609},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3625":73186,"_31241":73143,"_21645":121611,"_5":14907,"_28433":121494,"_3077":121612},[],"Integraciones opcionales",{"_3625":73187,"_31241":73143,"_21645":121614,"_5":14907,"_28433":121494,"_3077":121615},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3625":73188,"_31241":73143,"_21645":121617,"_5":14907,"_28433":121494,"_3077":121618},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3625":73189,"_31241":73143,"_21645":121620,"_5":14907,"_28433":121494,"_3077":121621},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3625":73190,"_31241":73143,"_21645":121623,"_5":14907,"_28433":121494,"_3077":121624},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3625":73191,"_31241":73143,"_21645":121626,"_5":14907,"_28433":121498,"_3077":121627},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3625":73192,"_31241":73143,"_21645":121629,"_5":14907,"_28433":121498,"_3077":121630},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3625":73193,"_31241":73143,"_21645":121632,"_5":14907,"_28433":121502,"_3077":121633},[],"Kubernetes 1.24 o posterior",{"_3625":73194,"_31241":73143,"_21645":121635,"_5":14907,"_28433":121502,"_3077":121636},[],"Helm 3.2 o posterior",{"_3625":73195,"_31241":73143,"_21645":121638,"_5":14907,"_28433":121502,"_3077":121639},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3625":73196,"_31241":73143,"_21645":121641,"_5":14907,"_28433":121502,"_3077":121642},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3625":73197,"_31241":73143,"_21645":121644,"_5":14907,"_28433":121502,"_3077":121645},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3625":73198,"_31241":73143,"_21645":121647,"_5":14907,"_28433":121502,"_3077":121648},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3625":73199,"_31241":73143,"_21645":121650,"_5":14907,"_28433":121502,"_3077":121651},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3625":73200,"_31241":73143,"_21645":121653,"_5":14907,"_28433":121506,"_3077":121654},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3625":73201,"_31241":73143,"_21645":121656,"_5":14907,"_28433":121506,"_3077":121657},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3625":73202,"_31241":73143,"_21645":121659,"_5":14907,"_28433":121506,"_3077":121660},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3625":73203,"_31241":73143,"_21645":121662,"_5":14907,"_28433":121506,"_3077":121663},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3625":73204,"_31241":73204,"_5":15267,"_3077":121665,"_31600":121666,"_21645":121668,"_28433":73204},"Resolución de problemas de despliegue",[51013,120432,121667],"Operación",[],{"_3625":73205,"_31241":73204,"_21645":121670,"_5":14907,"_28433":73204,"_3077":121671},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3625":73206,"_31241":73204,"_5":31597,"_21645":121673,"_28433":121674,"_3077":121675},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3625":73207,"_31241":73204,"_5":31597,"_21645":121677,"_28433":121678,"_3077":121679},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3625":73208,"_31241":73204,"_5":31597,"_21645":121681,"_28433":121682,"_3077":121683},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3625":73209,"_31241":73204,"_5":31597,"_21645":121685,"_28433":121686,"_3077":121687},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3625":73210,"_31241":73204,"_5":31597,"_21645":121689,"_28433":121690,"_3077":121691},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3625":73211,"_31241":73204,"_5":31597,"_21645":121693,"_28433":121694,"_3077":121695},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3625":73212,"_31241":73204,"_5":31597,"_21645":121697,"_28433":121698,"_3077":121699},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3625":73213,"_31241":73204,"_5":31597,"_21645":121701,"_28433":121702,"_3077":121703},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3625":73214,"_31241":73204,"_5":31597,"_21645":121705,"_28433":121706,"_3077":121707},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3625":73215,"_31241":73204,"_5":31597,"_21645":121709,"_28433":121710,"_3077":121711},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3625":73216,"_31241":73204,"_5":31597,"_21645":121713,"_28433":121714,"_3077":121715},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3625":73217,"_31241":73204,"_5":31597,"_21645":121717,"_28433":121718,"_3077":121719},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3625":73218,"_31241":73204,"_5":31597,"_21645":121721,"_28433":121722,"_3077":121723},[],"/docs/pr-preview/pr-78/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3625":73219,"_31241":73204,"_21645":121725,"_5":14907,"_28433":73204,"_3077":121726},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3625":73220,"_31241":73204,"_21645":121728,"_5":14907,"_28433":121678,"_3077":121729},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3625":73221,"_31241":73204,"_21645":121731,"_5":14907,"_28433":121682,"_3077":121732},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3625":73222,"_31241":73204,"_21645":121734,"_5":14907,"_28433":121686,"_3077":121735},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3625":73223,"_31241":73204,"_21645":121737,"_5":14907,"_28433":121690,"_3077":121738},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3625":73224,"_31241":73204,"_21645":121740,"_5":14907,"_28433":121694,"_3077":121741},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3625":73225,"_31241":73204,"_21645":121743,"_5":14907,"_28433":121698,"_3077":121744},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3625":73226,"_31241":73204,"_21645":121746,"_5":14907,"_28433":121698,"_3077":121747},[],"Ejecuta también la prueba de conectividad del chart:",{"_3625":73227,"_31241":73204,"_21645":121749,"_5":14907,"_28433":121698,"_3077":121750},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3625":73228,"_31241":73204,"_21645":121752,"_5":14907,"_28433":121698,"_3077":121753},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3625":73229,"_31241":73204,"_21645":121755,"_5":14907,"_28433":121702,"_3077":121756},[],"Si recibes un 401:",{"_3625":73230,"_31241":73204,"_21645":121758,"_5":14907,"_28433":121702,"_3077":121759},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3625":73231,"_31241":73204,"_21645":121761,"_5":14907,"_28433":121702,"_3077":121762},[],"verifica emisor, audiencia y expiración del token;",{"_3625":73232,"_31241":73204,"_21645":121764,"_5":14907,"_28433":121702,"_3077":121765},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3625":73233,"_31241":73204,"_21645":121767,"_5":14907,"_28433":121702,"_3077":121768},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3625":73234,"_31241":73204,"_21645":121770,"_5":14907,"_28433":121702,"_3077":121771},[],"Si el login termina pero las APIs devuelven 403:",{"_3625":73235,"_31241":73204,"_21645":121773,"_5":14907,"_28433":121702,"_3077":121774},[],"inspecciona los claims reales del token;",{"_3625":73236,"_31241":73204,"_21645":121776,"_5":14907,"_28433":121702,"_3077":121777},[],"confirma que coinciden con un principal activo;",{"_3625":73237,"_31241":73204,"_21645":121779,"_5":14907,"_28433":121702,"_3077":121780},[],"revisa las políticas concedidas al principal;",{"_3625":73238,"_31241":73204,"_21645":121782,"_5":14907,"_28433":121702,"_3077":121783},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3625":73239,"_31241":73204,"_21645":121785,"_5":14907,"_28433":121702,"_3077":121786},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3625":73240,"_31241":73204,"_21645":121788,"_5":14907,"_28433":121706,"_3077":121789},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3625":73241,"_31241":73204,"_21645":121791,"_5":14907,"_28433":121706,"_3077":121792},[],"Localiza el pod y Service de authz.",{"_3625":73242,"_31241":73204,"_21645":121794,"_5":14907,"_28433":121706,"_3077":121795},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3625":73243,"_31241":73204,"_21645":121797,"_5":14907,"_28433":121706,"_3077":121798},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3625":73244,"_31241":73204,"_21645":121800,"_5":14907,"_28433":121706,"_3077":121801},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3625":73245,"_31241":73204,"_21645":121803,"_5":14907,"_28433":121706,"_3077":121804},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3625":73246,"_31241":73204,"_21645":121806,"_5":14907,"_28433":121710,"_3077":121807},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3625":73247,"_31241":73204,"_21645":121809,"_5":14907,"_28433":121714,"_3077":121810},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3625":73248,"_31241":73204,"_21645":121812,"_5":14907,"_28433":121714,"_3077":121813},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3625":73249,"_31241":73204,"_21645":121815,"_5":14907,"_28433":121714,"_3077":121816},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3625":73250,"_31241":73204,"_21645":121818,"_5":14907,"_28433":121714,"_3077":121819},[],"volumen persistente sin enlazar;",{"_3625":73251,"_31241":73204,"_21645":121821,"_5":14907,"_28433":121714,"_3077":121822},[],"imagen inaccesible o política de pull incorrecta;",{"_3625":73252,"_31241":73204,"_21645":121824,"_5":14907,"_28433":121714,"_3077":121825},[],"configuración inválida del motor criptográfico;",{"_3625":73253,"_31241":73204,"_21645":121827,"_5":14907,"_28433":121714,"_3077":121828},[],"límites de CPU o memoria demasiado bajos;",{"_3625":73254,"_31241":73204,"_21645":121830,"_5":14907,"_28433":121714,"_3077":121831},[],"migración previa incompleta.",{"_3625":73255,"_31241":73204,"_21645":121833,"_5":14907,"_28433":121714,"_3077":121834},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3625":73256,"_31241":73204,"_21645":121836,"_5":14907,"_28433":121714,"_3077":121837},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3625":73257,"_31241":73204,"_21645":121839,"_5":14907,"_28433":121714,"_3077":121840},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3625":73258,"_31241":73204,"_21645":121842,"_5":14907,"_28433":121718,"_3077":121843},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3625":73259,"_31241":73204,"_21645":121845,"_5":14907,"_28433":121718,"_3077":121846},[],"verifica que esté habilitado en el servicio emisor;",{"_3625":73260,"_31241":73204,"_21645":121848,"_5":14907,"_28433":121718,"_3077":121849},[],"comprueba conectividad y credenciales AMQP;",{"_3625":73261,"_31241":73204,"_21645":121851,"_5":14907,"_28433":121718,"_3077":121852},[],"revisa exchange, routing key, colas y consumidores;",{"_3625":73262,"_31241":73204,"_21645":121854,"_5":14907,"_28433":121718,"_3077":121855},[],"inspecciona dead-letter queues;",{"_3625":73263,"_31241":73204,"_21645":121857,"_5":14907,"_28433":121718,"_3077":121858},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3625":73264,"_31241":73204,"_21645":121860,"_5":14907,"_28433":121718,"_3077":121861},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3625":73265,"_31241":73204,"_21645":121863,"_5":14907,"_28433":121718,"_3077":121864},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3625":73266,"_31241":73204,"_21645":121866,"_5":14907,"_28433":121718,"_3077":121867},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3625":73267,"_31241":73204,"_21645":121869,"_5":14907,"_28433":121718,"_3077":121870},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3625":73268,"_31241":73204,"_21645":121872,"_5":14907,"_28433":121718,"_3077":121873},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3625":73269,"_31241":73204,"_21645":121875,"_5":14907,"_28433":121718,"_3077":121876},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3625":73270,"_31241":73204,"_21645":121878,"_5":14907,"_28433":121718,"_3077":121879},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3625":73271,"_31241":73204,"_21645":121881,"_5":14907,"_28433":121722,"_3077":121882},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3625":73272,"_31241":73204,"_21645":121884,"_5":14907,"_28433":121722,"_3077":121885},[],"Antes de cerrar una incidencia, guarda:",{"_3625":73273,"_31241":73204,"_21645":121887,"_5":14907,"_28433":121722,"_3077":121888},[],"causa confirmada;",{"_3625":73274,"_31241":73204,"_21645":121890,"_5":14907,"_28433":121722,"_3077":121891},[],"alcance temporal y recursos afectados;",{"_3625":73275,"_31241":73204,"_21645":121893,"_5":14907,"_28433":121722,"_3077":121894},[],"comandos o consultas utilizados;",{"_3625":73276,"_31241":73204,"_21645":121896,"_5":14907,"_28433":121722,"_3077":121897},[],"cambio aplicado y forma de revertirlo;",{"_3625":73277,"_31241":73204,"_21645":121899,"_5":14907,"_28433":121722,"_3077":121900},[],"validación desde un consumidor;",{"_3625":73278,"_31241":73204,"_21645":121902,"_5":14907,"_28433":121722,"_3077":121903},[],"acción preventiva y propietario.",{"_3625":73279,"_31241":73279,"_5":15267,"_3077":121905,"_31600":121906,"_21645":121910,"_28433":73279},"Modelo de datos",[51013,121907,121908,121909],"Plataforma","Administración","Control de acceso",[],{"_3625":73280,"_31241":73279,"_21645":121912,"_5":14907,"_28433":73279,"_3077":121913},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3625":73281,"_31241":73279,"_5":31597,"_21645":121915,"_28433":121916,"_3077":121917},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3625":73282,"_31241":73279,"_5":31597,"_21645":121919,"_28433":121920,"_3077":121921},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3625":73283,"_31241":73279,"_21645":121923,"_5":14907,"_28433":73279,"_3077":121924},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3625":73284,"_31241":73279,"_21645":121926,"_5":14907,"_28433":121916,"_3077":121927},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3625":73285,"_31241":73279,"_21645":121929,"_5":14907,"_28433":121916,"_3077":121930},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3625":73286,"_31241":73279,"_21645":121932,"_5":14907,"_28433":121916,"_3077":121933},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3625":73287,"_31241":73279,"_21645":121935,"_5":14907,"_28433":121920,"_3077":121936},[],"Entidad (`schema_name.entity_type`)",{"_3625":73288,"_31241":73279,"_21645":121938,"_5":14907,"_28433":121920,"_3077":121939},[],"Tabla (`table_name`)",{"_3625":73289,"_31241":73279,"_21645":121941,"_5":14907,"_28433":121920,"_3077":121942},[],"Clave (`primary_key`)",{"_3625":73290,"_31241":73279,"_21645":121944,"_5":14907,"_28433":121920,"_3077":52563},[],{"_3625":73291,"_31241":73279,"_21645":121946,"_5":14907,"_28433":121920,"_3077":52566},[],{"_3625":73292,"_31241":73279,"_21645":121948,"_5":14907,"_28433":121920,"_3077":52569},[],{"_3625":73293,"_31241":73279,"_21645":121950,"_5":14907,"_28433":121920,"_3077":52572},[],{"_3625":73294,"_31241":73279,"_21645":121952,"_5":14907,"_28433":121920,"_3077":52575},[],{"_3625":73295,"_31241":73279,"_21645":121954,"_5":14907,"_28433":121920,"_3077":52578},[],{"_3625":73296,"_31241":73279,"_21645":121956,"_5":14907,"_28433":121920,"_3077":52581},[],{"_3625":73297,"_31241":73279,"_21645":121958,"_5":14907,"_28433":121920,"_3077":52584},[],{"_3625":73298,"_31241":73279,"_21645":121960,"_5":14907,"_28433":121920,"_3077":52578},[],{"_3625":73299,"_31241":73279,"_21645":121962,"_5":14907,"_28433":121920,"_3077":52589},[],{"_3625":73300,"_31241":73279,"_21645":121964,"_5":14907,"_28433":121920,"_3077":52592},[],{"_3625":73301,"_31241":73279,"_21645":121966,"_5":14907,"_28433":121920,"_3077":52595},[],{"_3625":73302,"_31241":73279,"_21645":121968,"_5":14907,"_28433":121920,"_3077":52598},[],{"_3625":73303,"_31241":73279,"_21645":121970,"_5":14907,"_28433":121920,"_3077":52601},[],{"_3625":73304,"_31241":73279,"_21645":121972,"_5":14907,"_28433":121920,"_3077":52578},[],{"_3625":73305,"_31241":73279,"_21645":121974,"_5":14907,"_28433":121920,"_3077":52606},[],{"_3625":73306,"_31241":73279,"_21645":121976,"_5":14907,"_28433":121920,"_3077":52609},[],{"_3625":73307,"_31241":73279,"_21645":121978,"_5":14907,"_28433":121920,"_3077":52578},[],{"_3625":73308,"_31241":73279,"_21645":121980,"_5":14907,"_28433":121920,"_3077":52614},[],{"_3625":73309,"_31241":73279,"_21645":121982,"_5":14907,"_28433":121920,"_3077":52617},[],{"_3625":73310,"_31241":73279,"_21645":121984,"_5":14907,"_28433":121920,"_3077":52578},[],{"_3625":73311,"_31241":73279,"_21645":121986,"_5":14907,"_28433":121920,"_3077":52622},[],{"_3625":73312,"_31241":73279,"_21645":121988,"_5":14907,"_28433":121920,"_3077":52625},[],{"_3625":73313,"_31241":73279,"_21645":121990,"_5":14907,"_28433":121920,"_3077":52578},[],{"_3625":73314,"_31241":73279,"_21645":121992,"_5":14907,"_28433":121920,"_3077":52630},[],{"_3625":73315,"_31241":73279,"_21645":121994,"_5":14907,"_28433":121920,"_3077":52633},[],{"_3625":73316,"_31241":73279,"_21645":121996,"_5":14907,"_28433":121920,"_3077":52636},[],{"_3625":73317,"_31241":73279,"_21645":121998,"_5":14907,"_28433":121920,"_3077":52639},[],{"_3625":73318,"_31241":73279,"_21645":122000,"_5":14907,"_28433":121920,"_3077":52642},[],{"_3625":73319,"_31241":73279,"_21645":122002,"_5":14907,"_28433":121920,"_3077":52645},[],{"_3625":73320,"_31241":73279,"_21645":122004,"_5":14907,"_28433":121920,"_3077":122005},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3625":73321,"_31241":73279,"_21645":122007,"_5":14907,"_28433":121920,"_3077":122008},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3625":73322,"_31241":73279,"_21645":122010,"_5":14907,"_28433":121920,"_3077":122011},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3625":73323,"_31241":73323,"_5":15267,"_3077":122013,"_31600":122014,"_21645":122015,"_28433":73323},"Visión general del control de acceso",[51013,121907,121908,121909],[],{"_3625":73324,"_31241":73323,"_21645":122017,"_5":14907,"_28433":73323,"_3077":122018},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3625":73325,"_31241":73323,"_5":31597,"_21645":122020,"_28433":122021,"_3077":122022},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3625":73326,"_31241":73323,"_5":31597,"_21645":122024,"_28433":122025,"_3077":122026},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3625":73327,"_31241":73323,"_5":31597,"_21645":122028,"_28433":122029,"_3077":122030},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3625":73328,"_31241":73323,"_5":31597,"_21645":122032,"_28433":122033,"_3077":122034},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3625":73329,"_31241":73323,"_5":31597,"_21645":122036,"_28433":122037,"_3077":122038},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3625":73330,"_31241":73323,"_5":31597,"_21645":122040,"_28433":122041,"_3077":122042},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3625":73331,"_31241":73323,"_5":31597,"_21645":122044,"_28433":122045,"_3077":122046},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3625":73332,"_31241":73323,"_5":31597,"_21645":122048,"_28433":122049,"_3077":122050},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3625":73333,"_31241":73323,"_5":31597,"_21645":122052,"_28433":122053,"_3077":122054},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3625":73334,"_31241":73323,"_5":31597,"_21645":122056,"_28433":122057,"_3077":122058},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3625":73335,"_31241":73323,"_5":31597,"_21645":122060,"_28433":122061,"_3077":122062},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3625":73336,"_31241":73323,"_5":31597,"_21645":122064,"_28433":122065,"_3077":122066},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3625":73337,"_31241":73323,"_5":31597,"_21645":122068,"_28433":122069,"_3077":122070},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3625":73338,"_31241":73323,"_5":31597,"_21645":122072,"_28433":122073,"_3077":122074},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3625":73339,"_31241":73323,"_5":31597,"_21645":122076,"_28433":122077,"_3077":122078},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3625":73340,"_31241":73323,"_5":31597,"_21645":122080,"_28433":122081,"_3077":121048},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3625":73341,"_31241":73323,"_5":31597,"_21645":122083,"_28433":122084,"_3077":122085},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3625":73342,"_31241":73323,"_5":31597,"_21645":122087,"_28433":122088,"_3077":122089},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3625":73343,"_31241":73323,"_5":31597,"_21645":122091,"_28433":122092,"_3077":122093},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3625":73344,"_31241":73323,"_5":31597,"_21645":122095,"_28433":122096,"_3077":122097},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3625":73345,"_31241":73323,"_5":31597,"_21645":122099,"_28433":122100,"_3077":122101},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3625":73346,"_31241":73323,"_5":31597,"_21645":122103,"_28433":122104,"_3077":122105},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3625":73347,"_31241":73323,"_5":31597,"_21645":122107,"_28433":122108,"_3077":122109},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3625":73348,"_31241":73323,"_5":31597,"_21645":122111,"_28433":122112,"_3077":122113},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3625":73349,"_31241":73323,"_5":31597,"_21645":122115,"_28433":122116,"_3077":122117},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3625":73350,"_31241":73323,"_5":31597,"_21645":122119,"_28433":122120,"_3077":122121},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3625":73351,"_31241":73323,"_5":31597,"_21645":122123,"_28433":122124,"_3077":122125},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3625":73352,"_31241":73323,"_5":31597,"_21645":122127,"_28433":122128,"_3077":122129},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3625":73353,"_31241":73323,"_5":31597,"_21645":122131,"_28433":122132,"_3077":122133},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3625":73354,"_31241":73323,"_5":31597,"_21645":122135,"_28433":122136,"_3077":122137},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3625":73355,"_31241":73323,"_5":31597,"_21645":122139,"_28433":122140,"_3077":122141},[],"/docs/pr-preview/pr-78/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3625":73356,"_31241":73323,"_21645":122143,"_5":14907,"_28433":73323,"_3077":122144},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3625":73357,"_31241":73323,"_21645":122146,"_5":14907,"_28433":73323,"_3077":122147},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3625":73358,"_31241":73323,"_21645":122149,"_5":14907,"_28433":73323,"_3077":122150},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3625":73359,"_31241":73323,"_21645":122152,"_5":14907,"_28433":122021,"_3077":122153},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3625":73360,"_31241":73323,"_21645":122155,"_5":14907,"_28433":122021,"_3077":122156},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3625":73361,"_31241":73323,"_21645":122158,"_5":14907,"_28433":122021,"_3077":122159},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3625":73362,"_31241":73323,"_21645":122161,"_5":14907,"_28433":122021,"_3077":122162},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3625":73363,"_31241":73323,"_21645":122164,"_5":14907,"_28433":122021,"_3077":122165},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3625":73364,"_31241":73323,"_21645":122167,"_5":14907,"_28433":122021,"_3077":122168},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3625":73365,"_31241":73323,"_21645":122170,"_5":14907,"_28433":122025,"_3077":122171},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3625":73366,"_31241":73323,"_21645":122173,"_5":14907,"_28433":122025,"_3077":122174},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3625":73367,"_31241":73323,"_21645":122176,"_5":14907,"_28433":122029,"_3077":122177},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3625":73368,"_31241":73323,"_21645":122179,"_5":14907,"_28433":122029,"_3077":122180},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3625":73369,"_31241":73323,"_21645":122182,"_5":14907,"_28433":122029,"_3077":122183},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3625":73370,"_31241":73323,"_21645":122185,"_5":14907,"_28433":122029,"_3077":122186},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3625":73371,"_31241":73323,"_21645":122188,"_5":14907,"_28433":122029,"_3077":122189},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3625":73372,"_31241":73323,"_21645":122191,"_5":14907,"_28433":122029,"_3077":122192},[],"Carga por separado las políticas concedidas a cada principal.",{"_3625":73373,"_31241":73323,"_21645":122194,"_5":14907,"_28433":122029,"_3077":122195},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3625":73374,"_31241":73323,"_21645":122197,"_5":14907,"_28433":122029,"_3077":122198},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3625":73375,"_31241":73323,"_21645":122200,"_5":14907,"_28433":122029,"_3077":122201},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3625":73376,"_31241":73323,"_21645":122203,"_5":14907,"_28433":122029,"_3077":122204},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3625":73377,"_31241":73323,"_21645":122206,"_5":14907,"_28433":122029,"_3077":122207},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3625":73378,"_31241":73323,"_21645":122209,"_5":14907,"_28433":122029,"_3077":122210},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3625":73379,"_31241":73323,"_21645":122212,"_5":14907,"_28433":122033,"_3077":122213},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3625":73380,"_31241":73323,"_21645":122215,"_5":14907,"_28433":122033,"_3077":122216},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3625":73381,"_31241":73323,"_21645":122218,"_5":14907,"_28433":122033,"_3077":122219},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3625":73382,"_31241":73323,"_21645":122221,"_5":14907,"_28433":122033,"_3077":122222},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3625":73383,"_31241":73323,"_21645":122224,"_5":14907,"_28433":122033,"_3077":122225},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3625":73384,"_31241":73323,"_21645":122227,"_5":14907,"_28433":122033,"_3077":122228},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3625":73385,"_31241":73323,"_21645":122230,"_5":14907,"_28433":122033,"_3077":122231},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3625":73386,"_31241":73323,"_21645":122233,"_5":14907,"_28433":122033,"_3077":122234},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3625":73387,"_31241":73323,"_21645":122236,"_5":14907,"_28433":122033,"_3077":122237},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3625":73388,"_31241":73323,"_21645":122239,"_5":14907,"_28433":122033,"_3077":122240},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3625":73389,"_31241":73323,"_21645":122242,"_5":14907,"_28433":122037,"_3077":122243},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3625":73390,"_31241":73323,"_21645":122245,"_5":14907,"_28433":122037,"_3077":122246},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3625":73391,"_31241":73323,"_21645":122248,"_5":14907,"_28433":122037,"_3077":122249},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3625":73392,"_31241":73323,"_21645":122251,"_5":14907,"_28433":122037,"_3077":122252},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3625":73393,"_31241":73323,"_21645":122254,"_5":14907,"_28433":122037,"_3077":122255},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3625":73394,"_31241":73323,"_21645":122257,"_5":14907,"_28433":122037,"_3077":122258},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3625":73395,"_31241":73323,"_21645":122260,"_5":14907,"_28433":122037,"_3077":122261},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3625":73396,"_31241":73323,"_21645":122263,"_5":14907,"_28433":122037,"_3077":122264},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3625":73397,"_31241":73323,"_21645":122266,"_5":14907,"_28433":122037,"_3077":122267},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3625":73398,"_31241":73323,"_21645":122269,"_5":14907,"_28433":122037,"_3077":122270},[],"Las acciones se dividen en dos grupos:",{"_3625":73399,"_31241":73323,"_21645":122272,"_5":14907,"_28433":122037,"_3077":122273},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3625":73400,"_31241":73323,"_21645":122275,"_5":14907,"_28433":122037,"_3077":122276},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3625":73401,"_31241":73323,"_21645":122278,"_5":14907,"_28433":122037,"_3077":122279},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3625":73402,"_31241":73323,"_21645":122281,"_5":14907,"_28433":122041,"_3077":122282},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3625":73403,"_31241":73323,"_21645":122284,"_5":14907,"_28433":122041,"_3077":122285},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3625":73404,"_31241":73323,"_21645":122287,"_5":14907,"_28433":122041,"_3077":122288},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3625":73405,"_31241":73323,"_21645":122290,"_5":14907,"_28433":122045,"_3077":122291},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3625":73406,"_31241":73323,"_21645":122293,"_5":14907,"_28433":122045,"_3077":122294},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3625":73407,"_31241":73323,"_21645":122296,"_5":14907,"_28433":122045,"_3077":122297},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3625":73408,"_31241":73323,"_21645":122299,"_5":14907,"_28433":122045,"_3077":122300},[],"Los operadores implementados son:",{"_3625":73409,"_31241":73323,"_21645":122302,"_5":14907,"_28433":122045,"_3077":122303},[],"`equals`, para igualdad exacta;",{"_3625":73410,"_31241":73323,"_21645":122305,"_5":14907,"_28433":122045,"_3077":122306},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3625":73411,"_31241":73323,"_21645":122308,"_5":14907,"_28433":122045,"_3077":122309},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3625":73412,"_31241":73323,"_21645":122311,"_5":14907,"_28433":122045,"_3077":122312},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3625":73413,"_31241":73323,"_21645":122314,"_5":14907,"_28433":122049,"_3077":122315},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3625":73414,"_31241":73323,"_21645":122317,"_5":14907,"_28433":122049,"_3077":122318},[],"Los modos disponibles son:",{"_3625":73415,"_31241":73323,"_21645":122320,"_5":14907,"_28433":122049,"_3077":122321},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3625":73416,"_31241":73323,"_21645":122323,"_5":14907,"_28433":122049,"_3077":122324},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3625":73417,"_31241":73323,"_21645":122326,"_5":14907,"_28433":122049,"_3077":122327},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3625":73418,"_31241":73323,"_21645":122329,"_5":14907,"_28433":122049,"_3077":122330},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3625":73419,"_31241":73323,"_21645":122332,"_5":14907,"_28433":122049,"_3077":122333},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3625":73420,"_31241":73323,"_21645":122335,"_5":14907,"_28433":122049,"_3077":122336},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3625":73421,"_31241":73323,"_21645":122338,"_5":14907,"_28433":122053,"_3077":122339},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3625":73422,"_31241":73323,"_21645":122341,"_5":14907,"_28433":122053,"_3077":122342},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3625":73423,"_31241":73323,"_21645":122344,"_5":14907,"_28433":122053,"_3077":122345},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3625":73424,"_31241":73323,"_21645":122347,"_5":14907,"_28433":122053,"_3077":122348},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3625":73425,"_31241":73323,"_21645":122350,"_5":14907,"_28433":122061,"_3077":122351},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3625":73426,"_31241":73323,"_21645":122353,"_5":14907,"_28433":122061,"_3077":122354},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3625":73427,"_31241":73323,"_21645":122356,"_5":14907,"_28433":122065,"_3077":122357},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3625":73428,"_31241":73323,"_21645":122359,"_5":14907,"_28433":122065,"_3077":122360},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3625":73429,"_31241":73323,"_21645":122362,"_5":14907,"_28433":122065,"_3077":122363},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3625":73430,"_31241":73323,"_21645":122365,"_5":14907,"_28433":122065,"_3077":122366},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3625":73431,"_31241":73323,"_21645":122368,"_5":14907,"_28433":122065,"_3077":122369},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3625":73432,"_31241":73323,"_21645":122371,"_5":14907,"_28433":122069,"_3077":122372},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3625":73433,"_31241":73323,"_21645":122374,"_5":14907,"_28433":122069,"_3077":122375},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3625":73434,"_31241":73323,"_21645":122377,"_5":14907,"_28433":122069,"_3077":122378},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3625":73435,"_31241":73323,"_21645":122380,"_5":14907,"_28433":122073,"_3077":122381},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3625":73436,"_31241":73323,"_21645":122383,"_5":14907,"_28433":122073,"_3077":122384},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3625":73437,"_31241":73323,"_21645":122386,"_5":14907,"_28433":122073,"_3077":122387},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3625":73438,"_31241":73323,"_21645":122389,"_5":14907,"_28433":122073,"_3077":122390},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3625":73439,"_31241":73323,"_21645":122392,"_5":14907,"_28433":122073,"_3077":122393},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3625":73440,"_31241":73323,"_21645":122395,"_5":14907,"_28433":122073,"_3077":122396},[],"Ten en cuenta que:",{"_3625":73441,"_31241":73323,"_21645":122398,"_5":14907,"_28433":122073,"_3077":122399},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3625":73442,"_31241":73323,"_21645":122401,"_5":14907,"_28433":122073,"_3077":122402},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3625":73443,"_31241":73323,"_21645":122404,"_5":14907,"_28433":122073,"_3077":122405},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3625":73444,"_31241":73323,"_21645":122407,"_5":14907,"_28433":122077,"_3077":122408},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3625":73445,"_31241":73323,"_21645":122410,"_5":14907,"_28433":122077,"_3077":122411},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3625":73446,"_31241":73323,"_21645":122413,"_5":14907,"_28433":122077,"_3077":122414},[],"acceso completo y de solo lectura a KMS;",{"_3625":73447,"_31241":73323,"_21645":122416,"_5":14907,"_28433":122077,"_3077":122417},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3625":73448,"_31241":73323,"_21645":122419,"_5":14907,"_28433":122077,"_3077":122420},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3625":73449,"_31241":73323,"_21645":122422,"_5":14907,"_28433":122077,"_3077":122423},[],"acceso a la interfaz;",{"_3625":73450,"_31241":73323,"_21645":122425,"_5":14907,"_28433":122077,"_3077":122426},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3625":73451,"_31241":73323,"_21645":122428,"_5":14907,"_28433":122077,"_3077":122429},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3625":73452,"_31241":73323,"_21645":122431,"_5":14907,"_28433":122077,"_3077":122432},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3625":73453,"_31241":73323,"_21645":122434,"_5":14907,"_28433":122077,"_3077":122435},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3625":73454,"_31241":73323,"_21645":122437,"_5":14907,"_28433":122077,"_3077":122438},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3625":73455,"_31241":73323,"_21645":122440,"_5":14907,"_28433":122081,"_3077":122441},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3625":73456,"_31241":73323,"_21645":122443,"_5":14907,"_28433":122081,"_3077":122444},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3625":73457,"_31241":73323,"_21645":122446,"_5":14907,"_28433":122081,"_3077":122447},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3625":73458,"_31241":73323,"_21645":122449,"_5":14907,"_28433":122084,"_3077":122450},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3625":73459,"_31241":73323,"_21645":122452,"_5":14907,"_28433":122088,"_3077":122453},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3625":73460,"_31241":73323,"_21645":122455,"_5":14907,"_28433":122088,"_3077":122456},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3625":73461,"_31241":73323,"_21645":122458,"_5":14907,"_28433":122092,"_3077":122459},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3625":73462,"_31241":73323,"_21645":122461,"_5":14907,"_28433":122096,"_3077":122462},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3625":73463,"_31241":73323,"_21645":122464,"_5":14907,"_28433":122100,"_3077":122465},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3625":73464,"_31241":73323,"_21645":122467,"_5":14907,"_28433":122104,"_3077":122468},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3625":73465,"_31241":73323,"_21645":122470,"_5":14907,"_28433":122104,"_3077":122471},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3625":73466,"_31241":73323,"_21645":122473,"_5":14907,"_28433":122108,"_3077":122474},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3625":73467,"_31241":73323,"_21645":122476,"_5":14907,"_28433":122108,"_3077":122477},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3625":73468,"_31241":73323,"_21645":122479,"_5":14907,"_28433":122108,"_3077":122480},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3625":73469,"_31241":73323,"_21645":122482,"_5":14907,"_28433":122108,"_3077":122483},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3625":73470,"_31241":73323,"_21645":122485,"_5":14907,"_28433":122108,"_3077":122486},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3625":73471,"_31241":73323,"_21645":122488,"_5":14907,"_28433":122108,"_3077":122489},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3625":73472,"_31241":73323,"_21645":122491,"_5":14907,"_28433":122108,"_3077":122492},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3625":73473,"_31241":73323,"_21645":122494,"_5":14907,"_28433":122108,"_3077":122495},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3625":73474,"_31241":73323,"_21645":122497,"_5":14907,"_28433":122112,"_3077":122498},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3625":73475,"_31241":73323,"_21645":122500,"_5":14907,"_28433":122112,"_3077":122501},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3625":73476,"_31241":73323,"_21645":122503,"_5":14907,"_28433":122112,"_3077":122504},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3625":73477,"_31241":73323,"_21645":122506,"_5":14907,"_28433":122116,"_3077":122507},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3625":73478,"_31241":73323,"_21645":122509,"_5":14907,"_28433":122116,"_3077":122510},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3625":73479,"_31241":73323,"_21645":122512,"_5":14907,"_28433":122116,"_3077":122513},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3625":73480,"_31241":73323,"_21645":122515,"_5":14907,"_28433":122116,"_3077":122516},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3625":73481,"_31241":73323,"_21645":122518,"_5":14907,"_28433":122116,"_3077":122519},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3625":73482,"_31241":73323,"_21645":122521,"_5":14907,"_28433":122116,"_3077":122522},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3625":73483,"_31241":73323,"_21645":122524,"_5":14907,"_28433":122116,"_3077":122525},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3625":73484,"_31241":73323,"_21645":122527,"_5":14907,"_28433":122116,"_3077":122528},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3625":73485,"_31241":73323,"_21645":122530,"_5":14907,"_28433":122124,"_3077":122531},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3625":73486,"_31241":73323,"_21645":122533,"_5":14907,"_28433":122128,"_3077":122534},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3625":73487,"_31241":73323,"_21645":122536,"_5":14907,"_28433":122128,"_3077":122537},[],"que exista un principal activo del tipo correcto;",{"_3625":73488,"_31241":73323,"_21645":122539,"_5":14907,"_28433":122128,"_3077":122540},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3625":73489,"_31241":73323,"_21645":122542,"_5":14907,"_28433":122128,"_3077":122543},[],"que todas las condiciones del principal se cumplan;",{"_3625":73490,"_31241":73323,"_21645":122545,"_5":14907,"_28433":122128,"_3077":122546},[],"que el principal tenga concedida la política esperada;",{"_3625":73491,"_31241":73323,"_21645":122548,"_5":14907,"_28433":122128,"_3077":122549},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3625":73492,"_31241":73323,"_21645":122551,"_5":14907,"_28433":122128,"_3077":122552},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3625":73493,"_31241":73323,"_21645":122554,"_5":14907,"_28433":122128,"_3077":122555},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3625":73494,"_31241":73323,"_21645":122557,"_5":14907,"_28433":122128,"_3077":122558},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3625":73495,"_31241":73323,"_21645":122560,"_5":14907,"_28433":122132,"_3077":122561},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3625":73496,"_31241":73323,"_21645":122563,"_5":14907,"_28433":122136,"_3077":122564},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3625":73497,"_31241":73323,"_21645":122566,"_5":14907,"_28433":122140,"_3077":122567},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3625":73498,"_31241":73323,"_21645":122569,"_5":14907,"_28433":122140,"_3077":122570},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3625":73499,"_31241":73499,"_5":15267,"_3077":122572,"_31600":122573,"_21645":122574,"_28433":73499},"Alertas y suscripciones",[51013,121907,121908],[],{"_3625":73500,"_31241":73499,"_21645":122576,"_5":14907,"_28433":73499,"_3077":122577},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3625":73501,"_31241":73499,"_5":31597,"_21645":122579,"_28433":122580,"_3077":122581},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3625":73502,"_31241":73499,"_5":31597,"_21645":122583,"_28433":122584,"_3077":122585},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3625":73503,"_31241":73499,"_5":31597,"_21645":122587,"_28433":122588,"_3077":122589},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3625":73504,"_31241":73499,"_5":31597,"_21645":122591,"_28433":122592,"_3077":122593},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3625":73505,"_31241":73499,"_5":31597,"_21645":122595,"_28433":122596,"_3077":122597},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3625":73506,"_31241":73499,"_5":31597,"_21645":122599,"_28433":122600,"_3077":122601},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3625":73507,"_31241":73499,"_5":31597,"_21645":122603,"_28433":122604,"_3077":122605},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3625":73508,"_31241":73499,"_5":31597,"_21645":122607,"_28433":122608,"_3077":122609},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3625":73509,"_31241":73499,"_5":31597,"_21645":122611,"_28433":122612,"_3077":122613},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3625":73510,"_31241":73499,"_5":31597,"_21645":122615,"_28433":122616,"_3077":122617},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3625":73511,"_31241":73499,"_5":31597,"_21645":122619,"_28433":122620,"_3077":122621},[],"/docs/pr-preview/pr-78/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3625":73512,"_31241":73499,"_21645":122623,"_5":14907,"_28433":73499,"_3077":122624},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3625":73513,"_31241":73499,"_21645":122626,"_5":14907,"_28433":122580,"_3077":122627},[],"Un servicio publica un evento de dominio.",{"_3625":73514,"_31241":73499,"_21645":122629,"_5":14907,"_28433":122580,"_3077":122630},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3625":73515,"_31241":73499,"_21645":122632,"_5":14907,"_28433":122580,"_3077":122633},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3625":73516,"_31241":73499,"_21645":122635,"_5":14907,"_28433":122580,"_3077":122636},[],"Lamassu entrega el evento al canal configurado.",{"_3625":73517,"_31241":73499,"_21645":122638,"_5":14907,"_28433":122580,"_3077":122639},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3625":73518,"_31241":73499,"_21645":122641,"_5":14907,"_28433":122584,"_3077":122642},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3625":73519,"_31241":73499,"_21645":122644,"_5":14907,"_28433":122584,"_3077":122645},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3625":73520,"_31241":73499,"_21645":122647,"_5":14907,"_28433":122584,"_3077":122648},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3625":73521,"_31241":73499,"_21645":122650,"_5":14907,"_28433":122584,"_3077":122651},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3625":73522,"_31241":73499,"_21645":122653,"_5":14907,"_28433":122584,"_3077":122654},[],"`apikey_options` necesita `header` y `key`.",{"_3625":73523,"_31241":73499,"_21645":122656,"_5":14907,"_28433":122584,"_3077":122657},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3625":73524,"_31241":73499,"_21645":122659,"_5":14907,"_28433":122584,"_3077":122660},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3625":73525,"_31241":73499,"_21645":122662,"_5":14907,"_28433":122584,"_3077":122663},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3625":73526,"_31241":73499,"_21645":122665,"_5":14907,"_28433":122592,"_3077":122666},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3625":73527,"_31241":73499,"_21645":122668,"_5":14907,"_28433":122596,"_3077":122669},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3625":73528,"_31241":73499,"_21645":122671,"_5":14907,"_28433":122600,"_3077":122672},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3625":73529,"_31241":73499,"_21645":122674,"_5":14907,"_28433":122600,"_3077":122675},[],"**None** notifica todas las instancias del evento.",{"_3625":73530,"_31241":73499,"_21645":122677,"_5":14907,"_28433":122600,"_3077":122678},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3625":73531,"_31241":73499,"_21645":122680,"_5":14907,"_28433":122600,"_3077":122681},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3625":73532,"_31241":73499,"_21645":122683,"_5":14907,"_28433":122600,"_3077":122684},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3625":73533,"_31241":73499,"_21645":122686,"_5":14907,"_28433":122600,"_3077":122687},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3625":73534,"_31241":73499,"_21645":122689,"_5":14907,"_28433":122600,"_3077":122690},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3625":73535,"_31241":73499,"_21645":122692,"_5":14907,"_28433":122604,"_3077":122693},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3625":73536,"_31241":73499,"_21645":122695,"_5":14907,"_28433":122608,"_3077":122696},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3625":73537,"_31241":73499,"_21645":122698,"_5":14907,"_28433":122608,"_3077":122699},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3625":73538,"_31241":73499,"_21645":122701,"_5":14907,"_28433":122608,"_3077":122702},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3625":73539,"_31241":73499,"_21645":122704,"_5":14907,"_28433":122608,"_3077":122705},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3625":73540,"_31241":73499,"_21645":122707,"_5":14907,"_28433":122608,"_3077":122708},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3625":73541,"_31241":73499,"_21645":122710,"_5":14907,"_28433":122608,"_3077":122711},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3625":73542,"_31241":73499,"_21645":122713,"_5":14907,"_28433":122608,"_3077":122714},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3625":73543,"_31241":73499,"_21645":122716,"_5":14907,"_28433":122608,"_3077":122717},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3625":73544,"_31241":73499,"_21645":122719,"_5":14907,"_28433":122612,"_3077":122720},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3625":73545,"_31241":73499,"_21645":122722,"_5":14907,"_28433":122612,"_3077":122723},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3625":73546,"_31241":73499,"_21645":122725,"_5":14907,"_28433":122612,"_3077":122726},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3625":73547,"_31241":73499,"_21645":122728,"_5":14907,"_28433":122612,"_3077":122729},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3625":73548,"_31241":73499,"_21645":122731,"_5":14907,"_28433":122612,"_3077":122732},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3625":73549,"_31241":73499,"_21645":122734,"_5":14907,"_28433":122612,"_3077":122735},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3625":73550,"_31241":73499,"_21645":122737,"_5":14907,"_28433":122612,"_3077":122738},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3625":73551,"_31241":73499,"_21645":122740,"_5":14907,"_28433":122612,"_3077":122741},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3625":73552,"_31241":73499,"_21645":122743,"_5":14907,"_28433":122616,"_3077":122744},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3625":73553,"_31241":73499,"_21645":122746,"_5":14907,"_28433":122616,"_3077":122747},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3625":73554,"_31241":73499,"_21645":122749,"_5":14907,"_28433":122620,"_3077":122750},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3625":73555,"_31241":73499,"_21645":122752,"_5":14907,"_28433":122620,"_3077":122753},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3625":73556,"_31241":73499,"_21645":122755,"_5":14907,"_28433":122620,"_3077":122756},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3625":73557,"_31241":73499,"_21645":122758,"_5":14907,"_28433":122620,"_3077":122759},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3625":73558,"_31241":73499,"_21645":122761,"_5":14907,"_28433":122620,"_3077":122762},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3625":73559,"_31241":73499,"_21645":122764,"_5":14907,"_28433":122620,"_3077":122765},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3625":73560,"_31241":73499,"_21645":122767,"_5":14907,"_28433":122620,"_3077":122768},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3625":73561,"_31241":73499,"_21645":122770,"_5":14907,"_28433":122620,"_3077":122771},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3625":73562,"_31241":73499,"_21645":122773,"_5":14907,"_28433":122620,"_3077":122774},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3625":73563,"_31241":73499,"_21645":122776,"_5":14907,"_28433":122620,"_3077":122777},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3625":73564,"_31241":73564,"_5":15267,"_3077":122779,"_31600":122780,"_21645":122781,"_28433":73564},"Registros de auditoría",[51013,121907,121908],[],{"_3625":73565,"_31241":73564,"_21645":122783,"_5":14907,"_28433":73564,"_3077":122784},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3625":73566,"_31241":73564,"_5":31597,"_21645":122786,"_28433":122787,"_3077":122788},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3625":73567,"_31241":73564,"_5":31597,"_21645":122790,"_28433":122791,"_3077":122792},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3625":73568,"_31241":73564,"_5":31597,"_21645":122794,"_28433":122795,"_3077":122796},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3625":73569,"_31241":73564,"_5":31597,"_21645":122798,"_28433":122799,"_3077":122800},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3625":73570,"_31241":73564,"_5":31597,"_21645":122802,"_28433":122803,"_3077":122804},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3625":73571,"_31241":73564,"_5":31597,"_21645":122806,"_28433":122807,"_3077":122808},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3625":73572,"_31241":73564,"_5":31597,"_21645":122810,"_28433":122811,"_3077":122812},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3625":73573,"_31241":73564,"_5":31597,"_21645":122814,"_28433":122815,"_3077":122816},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3625":73574,"_31241":73564,"_5":31597,"_21645":122818,"_28433":122819,"_3077":122820},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3625":73575,"_31241":73564,"_5":31597,"_21645":122822,"_28433":122823,"_3077":122824},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3625":73576,"_31241":73564,"_5":31597,"_21645":122826,"_28433":122827,"_3077":122828},[],"/docs/pr-preview/pr-78/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3625":73577,"_31241":73564,"_21645":122830,"_5":14907,"_28433":73564,"_3077":122831},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3625":73578,"_31241":73564,"_21645":122833,"_5":14907,"_28433":122787,"_3077":122834},[],"El cuerpo de auditoría incluye:",{"_3625":73579,"_31241":73564,"_21645":122836,"_5":14907,"_28433":122787,"_3077":122837},[],"input: datos recibidos por la operación;",{"_3625":73580,"_31241":73564,"_21645":122839,"_5":14907,"_28433":122787,"_3077":122840},[],"has\\_error: indica si el servicio devolvió un error;",{"_3625":73581,"_31241":73564,"_21645":122842,"_5":14907,"_28433":122787,"_3077":122843},[],"output: resultado producido o mensaje de error;",{"_3625":73582,"_31241":73564,"_21645":122845,"_5":14907,"_28433":122787,"_3077":122846},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3625":73583,"_31241":73564,"_21645":122848,"_5":14907,"_28433":122787,"_3077":122849},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3625":73584,"_31241":73564,"_21645":122851,"_5":14907,"_28433":122787,"_3077":122852},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3625":73585,"_31241":73564,"_21645":122854,"_5":14907,"_28433":122791,"_3077":122855},[],"El backend aplica auditoría a mutaciones de:",{"_3625":73586,"_31241":73564,"_21645":122857,"_5":14907,"_28433":122791,"_3077":122858},[],"autoridades, certificados y perfiles de emisión;",{"_3625":73587,"_31241":73564,"_21645":122860,"_5":14907,"_28433":122791,"_3077":122861},[],"claves y motores KMS;",{"_3625":73588,"_31241":73564,"_21645":122863,"_5":14907,"_28433":122791,"_3077":122864},[],"dispositivos e identidades;",{"_3625":73589,"_31241":73564,"_21645":122866,"_5":14907,"_28433":122791,"_3077":122867},[],"DMS y operaciones de enrolamiento;",{"_3625":73590,"_31241":73564,"_21645":122869,"_5":14907,"_28433":122791,"_3077":122870},[],"funciones de validación y CRL;",{"_3625":73591,"_31241":73564,"_21645":122872,"_5":14907,"_28433":122791,"_3077":122873},[],"principales, políticas y concesiones de autorización.",{"_3625":73592,"_31241":73564,"_21645":122875,"_5":14907,"_28433":122791,"_3077":122876},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3625":73593,"_31241":73564,"_21645":122878,"_5":14907,"_28433":122795,"_3077":122879},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3625":73594,"_31241":73564,"_21645":122881,"_5":14907,"_28433":122795,"_3077":122882},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3625":73595,"_31241":73564,"_21645":122884,"_5":14907,"_28433":122795,"_3077":122885},[],"Diseña el consumidor para:",{"_3625":73596,"_31241":73564,"_21645":122887,"_5":14907,"_28433":122795,"_3077":122888},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3625":73597,"_31241":73564,"_21645":122890,"_5":14907,"_28433":122795,"_3077":122891},[],"conservar el CloudEvent completo sin modificar;",{"_3625":73598,"_31241":73564,"_21645":122893,"_5":14907,"_28433":122795,"_3077":122894},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3625":73599,"_31241":73564,"_21645":122896,"_5":14907,"_28433":122795,"_3077":122897},[],"cifrar en tránsito y en reposo;",{"_3625":73600,"_31241":73564,"_21645":122899,"_5":14907,"_28433":122795,"_3077":122900},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3625":73601,"_31241":73564,"_21645":122902,"_5":14907,"_28433":122795,"_3077":122903},[],"aplicar una política explícita de retención y legal hold;",{"_3625":73602,"_31241":73564,"_21645":122905,"_5":14907,"_28433":122795,"_3077":122906},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3625":73603,"_31241":73564,"_21645":122908,"_5":14907,"_28433":122799,"_3077":122909},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3625":73604,"_31241":73564,"_21645":122911,"_5":14907,"_28433":122799,"_3077":122912},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3625":73605,"_31241":73564,"_21645":122914,"_5":14907,"_28433":122807,"_3077":122915},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3625":73606,"_31241":73564,"_21645":122917,"_5":14907,"_28433":122811,"_3077":122918},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3625":73607,"_31241":73564,"_21645":122920,"_5":14907,"_28433":122815,"_3077":122921},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3625":73608,"_31241":73564,"_21645":122923,"_5":14907,"_28433":122819,"_3077":122924},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3625":73609,"_31241":73564,"_21645":122926,"_5":14907,"_28433":122823,"_3077":122927},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3625":73610,"_31241":73564,"_21645":122929,"_5":14907,"_28433":122827,"_3077":122930},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3625":73611,"_31241":73564,"_21645":122932,"_5":14907,"_28433":122827,"_3077":122933},[],"aparece un evento de auditoría correcto;",{"_3625":73612,"_31241":73564,"_21645":122935,"_5":14907,"_28433":122827,"_3077":122936},[],"el principal coincide con la identidad utilizada;",{"_3625":73613,"_31241":73564,"_21645":122938,"_5":14907,"_28433":122827,"_3077":122939},[],"el consumidor lo persiste una sola vez;",{"_3625":73614,"_31241":73564,"_21645":122941,"_5":14907,"_28433":122827,"_3077":122942},[],"puede recuperarse por recurso, actor y periodo;",{"_3625":73615,"_31241":73564,"_21645":122944,"_5":14907,"_28433":122827,"_3077":122945},[],"una interrupción del consumidor produce una alerta.",{"_3625":73616,"_31241":73564,"_21645":122947,"_5":14907,"_28433":122827,"_3077":122948},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3625":73617,"_31241":73617,"_5":15267,"_3077":122950,"_31600":122951,"_21645":122952,"_28433":73617},"Arquitectura de la plataforma",[51013,121907],[],{"_3625":73618,"_31241":73617,"_21645":122954,"_5":14907,"_28433":73617,"_3077":122955},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3625":73619,"_31241":73617,"_5":31597,"_21645":122957,"_28433":122958,"_3077":122959},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3625":73620,"_31241":73617,"_5":31597,"_21645":122961,"_28433":122962,"_3077":122963},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3625":73621,"_31241":73617,"_5":31597,"_21645":122965,"_28433":122966,"_3077":122967},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3625":73622,"_31241":73617,"_5":31597,"_21645":122969,"_28433":122970,"_3077":122971},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3625":73623,"_31241":73617,"_5":31597,"_21645":122973,"_28433":122974,"_3077":122975},[],"/docs/pr-preview/pr-78/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3625":73624,"_31241":73617,"_21645":122977,"_5":14907,"_28433":73617,"_3077":122978},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3625":73625,"_31241":73617,"_21645":122980,"_5":14907,"_28433":73617,"_3077":122981},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3625":73626,"_31241":73617,"_21645":122983,"_5":14907,"_28433":122958,"_3077":122984},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3625":73627,"_31241":73617,"_21645":122986,"_5":14907,"_28433":122962,"_3077":122987},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3625":73628,"_31241":73617,"_21645":122989,"_5":14907,"_28433":122966,"_3077":122990},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3625":73629,"_31241":73617,"_21645":122992,"_5":14907,"_28433":122970,"_3077":122993},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3625":73630,"_31241":73617,"_21645":122995,"_5":14907,"_28433":122974,"_3077":122996},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3625":73631,"_31241":73631,"_5":15267,"_3077":122998,"_31600":122999,"_21645":123000,"_28433":73631},"Cómo funciona Lamassu",[51013,121907],[],{"_3625":73632,"_31241":73631,"_21645":123002,"_5":14907,"_28433":73631,"_3077":123003},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3625":73633,"_31241":73631,"_5":31597,"_21645":123005,"_28433":123006,"_3077":123007},[],"/docs/pr-preview/pr-78/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3625":73634,"_31241":73631,"_5":31597,"_21645":123009,"_28433":123010,"_3077":123011},[],"/docs/pr-preview/pr-78/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3625":73635,"_31241":73631,"_21645":123013,"_5":14907,"_28433":73631,"_3077":123014},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3625":73636,"_31241":73631,"_21645":123016,"_5":14907,"_28433":123006,"_3077":123017},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3625":73637,"_31241":73631,"_21645":123019,"_5":14907,"_28433":123006,"_3077":123020},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3625":73638,"_31241":73631,"_21645":123022,"_5":14907,"_28433":123006,"_3077":123023},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3625":73639,"_31241":73631,"_21645":123025,"_5":14907,"_28433":123006,"_3077":123026},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3625":73640,"_31241":73631,"_21645":123028,"_5":14907,"_28433":123006,"_3077":123029},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3625":73641,"_31241":73631,"_21645":123031,"_5":14907,"_28433":123010,"_3077":123032},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3625":73642,"_31241":73631,"_21645":123034,"_5":14907,"_28433":123010,"_3077":123035},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3625":73643,"_31241":73631,"_21645":123037,"_5":14907,"_28433":123010,"_3077":123038},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3625":73644,"_31241":73631,"_21645":123040,"_5":14907,"_28433":123010,"_3077":123041},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3625":73645,"_31241":73631,"_21645":123043,"_5":14907,"_28433":123010,"_3077":123044},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3625":73646,"_31241":73631,"_21645":123046,"_5":14907,"_28433":123010,"_3077":123047},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3625":73647,"_31241":73631,"_21645":123049,"_5":14907,"_28433":123010,"_3077":123050},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3625":73648,"_31241":73648,"_5":15267,"_3077":123052,"_31600":123053,"_21645":123054,"_28433":73648},"Dispositivos e identidades",[51013,121907,53697,123052],[],{"_3625":73649,"_31241":73648,"_21645":123056,"_5":14907,"_28433":73648,"_3077":123057},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3625":73650,"_31241":73648,"_5":31597,"_21645":123059,"_28433":123060,"_3077":123061},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3625":73651,"_31241":73648,"_5":31597,"_21645":123063,"_28433":123064,"_3077":123065},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3625":73652,"_31241":73648,"_5":31597,"_21645":123067,"_28433":123068,"_3077":123069},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3625":73653,"_31241":73648,"_5":31597,"_21645":123071,"_28433":123072,"_3077":123073},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3625":73654,"_31241":73648,"_5":31597,"_21645":123075,"_28433":123076,"_3077":123077},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3625":73655,"_31241":73648,"_5":31597,"_21645":123079,"_28433":123080,"_3077":123081},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3625":73656,"_31241":73648,"_5":31597,"_21645":123083,"_28433":123084,"_3077":123085},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3625":73657,"_31241":73648,"_5":31597,"_21645":123087,"_28433":123088,"_3077":123089},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3625":73658,"_31241":73648,"_5":31597,"_21645":123091,"_28433":123092,"_3077":123093},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3625":73659,"_31241":73648,"_5":31597,"_21645":123095,"_28433":123096,"_3077":123097},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3625":73660,"_31241":73648,"_5":31597,"_21645":123099,"_28433":123100,"_3077":123101},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3625":73661,"_31241":73648,"_21645":123103,"_5":14907,"_28433":73648,"_3077":123104},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3625":73662,"_31241":73648,"_21645":123106,"_5":14907,"_28433":73648,"_3077":123107},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3625":73663,"_31241":73648,"_21645":123109,"_5":14907,"_28433":123060,"_3077":123110},[],"Vista operativa",{"_3625":73664,"_31241":73648,"_21645":123112,"_5":14907,"_28433":123060,"_3077":123113},[],"Interpretación",{"_3625":73665,"_31241":73648,"_21645":123115,"_5":14907,"_28433":123060,"_3077":53760},[],{"_3625":73666,"_31241":73648,"_21645":123117,"_5":14907,"_28433":123060,"_3077":123118},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3625":73667,"_31241":73648,"_21645":123120,"_5":14907,"_28433":123060,"_3077":53766},[],{"_3625":73668,"_31241":73648,"_21645":123122,"_5":14907,"_28433":123060,"_3077":123123},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3625":73669,"_31241":73648,"_21645":123125,"_5":14907,"_28433":123060,"_3077":53772},[],{"_3625":73670,"_31241":73648,"_21645":123127,"_5":14907,"_28433":123060,"_3077":123128},[],"La identidad está en la ventana operativa de renovación.",{"_3625":73671,"_31241":73648,"_21645":123130,"_5":14907,"_28433":123060,"_3077":53778},[],{"_3625":73672,"_31241":73648,"_21645":123132,"_5":14907,"_28433":123060,"_3077":123133},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3625":73673,"_31241":73648,"_21645":123135,"_5":14907,"_28433":123060,"_3077":53784},[],{"_3625":73674,"_31241":73648,"_21645":123137,"_5":14907,"_28433":123060,"_3077":123138},[],"La identidad ha vencido.",{"_3625":73675,"_31241":73648,"_21645":123140,"_5":14907,"_28433":123060,"_3077":53790},[],{"_3625":73676,"_31241":73648,"_21645":123142,"_5":14907,"_28433":123060,"_3077":123143},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3625":73677,"_31241":73648,"_21645":123145,"_5":14907,"_28433":123060,"_3077":53796},[],{"_3625":73678,"_31241":73648,"_21645":123147,"_5":14907,"_28433":123060,"_3077":123148},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3625":73679,"_31241":73648,"_21645":123150,"_5":14907,"_28433":123060,"_3077":123151},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3625":73680,"_31241":73648,"_21645":123153,"_5":14907,"_28433":123064,"_3077":123154},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3625":73681,"_31241":73648,"_21645":123156,"_5":14907,"_28433":123064,"_3077":123157},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3625":73682,"_31241":73648,"_21645":123159,"_5":14907,"_28433":123064,"_3077":123160},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3625":73683,"_31241":73648,"_21645":123162,"_5":14907,"_28433":123064,"_3077":123163},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3625":73684,"_31241":73648,"_21645":123165,"_5":14907,"_28433":123068,"_3077":123166},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3625":73685,"_31241":73648,"_21645":123168,"_5":14907,"_28433":123072,"_3077":123169},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3625":73686,"_31241":73648,"_21645":123171,"_5":14907,"_28433":123076,"_3077":123172},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3625":73687,"_31241":73648,"_21645":123174,"_5":14907,"_28433":123080,"_3077":123175},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3625":73688,"_31241":73648,"_21645":123177,"_5":14907,"_28433":123084,"_3077":123178},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3625":73689,"_31241":73648,"_21645":123180,"_5":14907,"_28433":123084,"_3077":123181},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3625":73690,"_31241":73648,"_21645":123183,"_5":14907,"_28433":123088,"_3077":123184},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3625":73691,"_31241":73648,"_21645":123186,"_5":14907,"_28433":123088,"_3077":123187},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3625":73692,"_31241":73648,"_21645":123189,"_5":14907,"_28433":123088,"_3077":123190},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3625":73693,"_31241":73648,"_21645":123192,"_5":14907,"_28433":123088,"_3077":123193},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3625":73694,"_31241":73648,"_21645":123195,"_5":14907,"_28433":123088,"_3077":123196},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3625":73695,"_31241":73648,"_21645":123198,"_5":14907,"_28433":123088,"_3077":123199},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3625":73696,"_31241":73648,"_21645":123201,"_5":14907,"_28433":123092,"_3077":123202},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3625":73697,"_31241":73648,"_21645":123204,"_5":14907,"_28433":123092,"_3077":123205},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3625":73698,"_31241":73648,"_21645":123207,"_5":14907,"_28433":123092,"_3077":123208},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3625":73699,"_31241":73648,"_21645":123210,"_5":14907,"_28433":123096,"_3077":123211},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3625":73700,"_31241":73648,"_21645":123213,"_5":14907,"_28433":123096,"_3077":123214},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3625":73701,"_31241":73648,"_21645":123216,"_5":14907,"_28433":123096,"_3077":123217},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3625":73702,"_31241":73648,"_21645":123219,"_5":14907,"_28433":123096,"_3077":123220},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3625":73703,"_31241":73648,"_21645":123222,"_5":14907,"_28433":123100,"_3077":123223},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3625":73704,"_31241":73648,"_21645":123225,"_5":14907,"_28433":123100,"_3077":123226},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3625":73705,"_31241":73705,"_5":15267,"_3077":123228,"_31600":123229,"_21645":123231,"_28433":73705},"Identidad inicial y autenticación",[51013,121907,53697,123052,123230],"Enrolamiento con PKI",[],{"_3625":73706,"_31241":73705,"_21645":123233,"_5":14907,"_28433":73705,"_3077":123234},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3625":73707,"_31241":73705,"_5":31597,"_21645":123236,"_28433":123237,"_3077":123238},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3625":73708,"_31241":73705,"_5":31597,"_21645":123240,"_28433":123241,"_3077":123242},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3625":73709,"_31241":73705,"_5":31597,"_21645":123244,"_28433":123245,"_3077":123246},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3625":73710,"_31241":73705,"_5":31597,"_21645":123248,"_28433":123249,"_3077":123250},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3625":73711,"_31241":73705,"_5":31597,"_21645":123252,"_28433":123253,"_3077":123254},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3625":73712,"_31241":73705,"_21645":123256,"_5":14907,"_28433":73705,"_3077":123257},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3625":73713,"_31241":73705,"_21645":123259,"_5":14907,"_28433":123237,"_3077":123260},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3625":73714,"_31241":73705,"_21645":123262,"_5":14907,"_28433":123237,"_3077":123263},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3625":73715,"_31241":73705,"_21645":123265,"_5":14907,"_28433":123241,"_3077":123266},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3625":73716,"_31241":73705,"_21645":123268,"_5":14907,"_28433":123241,"_3077":123269},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3625":73717,"_31241":73705,"_21645":123271,"_5":14907,"_28433":123241,"_3077":123272},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3625":73718,"_31241":73705,"_21645":123274,"_5":14907,"_28433":123245,"_3077":123275},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3625":73719,"_31241":73705,"_21645":123277,"_5":14907,"_28433":123245,"_3077":123278},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3625":73720,"_31241":73705,"_21645":123280,"_5":14907,"_28433":123249,"_3077":123281},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3625":73721,"_31241":73705,"_21645":123283,"_5":14907,"_28433":123249,"_3077":123284},[],"Ejemplo de cuerpo:",{"_3625":73722,"_31241":73705,"_21645":123286,"_5":14907,"_28433":123249,"_3077":123287},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3625":73723,"_31241":73705,"_21645":123289,"_5":14907,"_28433":123249,"_3077":123290},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3625":73724,"_31241":73705,"_21645":123292,"_5":14907,"_28433":123249,"_3077":123293},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3625":73725,"_31241":73705,"_21645":123295,"_5":14907,"_28433":123249,"_3077":123296},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3625":73726,"_31241":73705,"_21645":123298,"_5":14907,"_28433":123253,"_3077":123299},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3625":73727,"_31241":73705,"_21645":123301,"_5":14907,"_28433":123253,"_3077":123302},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3625":73728,"_31241":73705,"_21645":123304,"_5":14907,"_28433":123253,"_3077":123305},[],"Los puntos de distribución CRL descargados se almacenan en caché en memoria en el DMS Manager, indexados por su URL, de modo que las operaciones de enrolamiento y reenrolamiento simultáneas comparten una única descarga. Una lista en caché se reutiliza como máximo durante `crl_cache.max_ttl` (1 hora por defecto) y nunca más allá de su propio `nextUpdate` — o, si la lista no lo tiene, unas 24 horas tras `thisUpdate` conforme a la regla de frescura anterior. Leer una lista en caché no alarga su vida, y su firma se verifica frente al emisor del certificado en cada uso. Una lista caducada, mayor que `crl_cache.max_size_mb` (256 MB por defecto) o cuya descarga falló no se guarda en caché; la siguiente operación la descarga de nuevo. La caché es una configuración del servicio DMS Manager compartida por todos los DMS, no una opción por DMS, y afecta solo a los puntos de distribución CRL — las respuestas OCSP nunca se guardan en caché. Los certificados gestionados por Lamassu no pasan por esta ruta: se comprueban con su estado almacenado y nunca llegan a la vía CRL.",{"_3625":73729,"_31241":73705,"_21645":123307,"_5":14907,"_28433":123253,"_3077":123308},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). Una revocación publicada en una CRL externa recién emitida puede tardar además hasta la ventana de caché — `crl_cache.max_ttl`, 1 hora por defecto — en volverse visible, además del propio ritmo de publicación de los responders. La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3625":73730,"_31241":73705,"_21645":123310,"_5":14907,"_28433":123253,"_3077":123311},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3625":73731,"_31241":73731,"_5":15267,"_3077":123313,"_31600":123314,"_21645":123315,"_28433":73731},"Configura y opera el DMS",[51013,121907,53697,123052,123230],[],{"_3625":73732,"_31241":73731,"_21645":123317,"_5":14907,"_28433":73731,"_3077":123318},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3625":73733,"_31241":73731,"_5":31597,"_21645":123320,"_28433":123321,"_3077":120441},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3625":73734,"_31241":73731,"_5":31597,"_21645":123323,"_28433":123324,"_3077":123325},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3625":73735,"_31241":73731,"_5":31597,"_21645":123327,"_28433":123328,"_3077":123329},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3625":73736,"_31241":73731,"_5":31597,"_21645":123331,"_28433":123332,"_3077":123333},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3625":73737,"_31241":73731,"_5":31597,"_21645":123335,"_28433":123336,"_3077":123337},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3625":73738,"_31241":73731,"_5":31597,"_21645":123339,"_28433":123340,"_3077":123341},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3625":73739,"_31241":73731,"_5":31597,"_21645":123343,"_28433":123344,"_3077":123345},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3625":73740,"_31241":73731,"_5":31597,"_21645":123347,"_28433":123348,"_3077":123349},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3625":73741,"_31241":73731,"_5":31597,"_21645":123351,"_28433":123352,"_3077":54004},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3625":73742,"_31241":73731,"_5":31597,"_21645":123354,"_28433":123355,"_3077":54008},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3625":73743,"_31241":73731,"_5":31597,"_21645":123357,"_28433":123358,"_3077":123359},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3625":73744,"_31241":73731,"_5":31597,"_21645":123361,"_28433":123362,"_3077":123363},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3625":73745,"_31241":73731,"_5":31597,"_21645":123365,"_28433":123366,"_3077":123367},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3625":73746,"_31241":73731,"_5":31597,"_21645":123369,"_28433":123370,"_3077":123371},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3625":73747,"_31241":73731,"_5":31597,"_21645":123373,"_28433":123374,"_3077":54028},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3625":73748,"_31241":73731,"_5":31597,"_21645":123376,"_28433":123377,"_3077":123378},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3625":73749,"_31241":73731,"_5":31597,"_21645":123380,"_28433":123381,"_3077":123382},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3625":73750,"_31241":73731,"_5":31597,"_21645":123384,"_28433":123385,"_3077":123386},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3625":73751,"_31241":73731,"_21645":123388,"_5":14907,"_28433":73731,"_3077":123389},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3625":73752,"_31241":73731,"_21645":123391,"_5":14907,"_28433":123321,"_3077":123392},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3625":73753,"_31241":73731,"_21645":123394,"_5":14907,"_28433":123321,"_3077":123395},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3625":73754,"_31241":73731,"_21645":123397,"_5":14907,"_28433":123328,"_3077":123398},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3625":73755,"_31241":73731,"_21645":123400,"_5":14907,"_28433":123332,"_3077":123401},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3625":73756,"_31241":73731,"_21645":123403,"_5":14907,"_28433":123336,"_3077":123404},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3625":73757,"_31241":73731,"_21645":123406,"_5":14907,"_28433":123340,"_3077":123407},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3625":73758,"_31241":73731,"_21645":123409,"_5":14907,"_28433":123344,"_3077":123410},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3625":73759,"_31241":73731,"_21645":123412,"_5":14907,"_28433":123352,"_3077":123413},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3625":73760,"_31241":73731,"_21645":123415,"_5":14907,"_28433":123352,"_3077":123416},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3625":73761,"_31241":73731,"_21645":123418,"_5":14907,"_28433":123355,"_3077":123419},[],"Campo de `settings.enrollment_settings`",{"_3625":73762,"_31241":73731,"_21645":123421,"_5":14907,"_28433":123355,"_3077":123422},[],"Decisión",{"_3625":73763,"_31241":73731,"_21645":123424,"_5":14907,"_28433":123355,"_3077":54079},[],{"_3625":73764,"_31241":73731,"_21645":123426,"_5":14907,"_28433":123355,"_3077":123427},[],"`EST_RFC7030` para estas operaciones.",{"_3625":73765,"_31241":73731,"_21645":123429,"_5":14907,"_28433":123355,"_3077":54085},[],{"_3625":73766,"_31241":73731,"_21645":123431,"_5":14907,"_28433":123355,"_3077":123432},[],"ID de la CA que firmará.",{"_3625":73767,"_31241":73731,"_21645":123434,"_5":14907,"_28433":123355,"_3077":54091},[],{"_3625":73768,"_31241":73731,"_21645":123436,"_5":14907,"_28433":123355,"_3077":123437},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3625":73769,"_31241":73731,"_21645":123439,"_5":14907,"_28433":123355,"_3077":54097},[],{"_3625":73770,"_31241":73731,"_21645":123441,"_5":14907,"_28433":123355,"_3077":123442},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3625":73771,"_31241":73731,"_21645":123444,"_5":14907,"_28433":123355,"_3077":54103},[],{"_3625":73772,"_31241":73731,"_21645":123446,"_5":14907,"_28433":123355,"_3077":123447},[],"Uno de los cuatro modos de autenticación.",{"_3625":73773,"_31241":73731,"_21645":123449,"_5":14907,"_28433":123355,"_3077":123450},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3625":73774,"_31241":73731,"_21645":123452,"_5":14907,"_28433":123358,"_3077":123453},[],"Los bloques son independientes:",{"_3625":73775,"_31241":73731,"_21645":123455,"_5":14907,"_28433":123358,"_3077":123456},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3625":73776,"_31241":73731,"_21645":123458,"_5":14907,"_28433":123358,"_3077":123459},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3625":73777,"_31241":73731,"_21645":123461,"_5":14907,"_28433":123358,"_3077":54121},[],{"_3625":73778,"_31241":73731,"_21645":123463,"_5":14907,"_28433":123358,"_3077":123464},[],"Control aplicado en la operación configurada",{"_3625":73779,"_31241":73731,"_21645":123466,"_5":14907,"_28433":123358,"_3077":54127},[],{"_3625":73780,"_31241":73731,"_21645":123468,"_5":14907,"_28433":123358,"_3077":123469},[],"Validación del certificado presentado.",{"_3625":73781,"_31241":73731,"_21645":123471,"_5":14907,"_28433":123358,"_3077":54133},[],{"_3625":73782,"_31241":73731,"_21645":123473,"_5":14907,"_28433":123358,"_3077":123474},[],"Autorización del webhook configurado.",{"_3625":73783,"_31241":73731,"_21645":123476,"_5":14907,"_28433":123358,"_3077":54139},[],{"_3625":73784,"_31241":73731,"_21645":123478,"_5":14907,"_28433":123358,"_3077":123479},[],"Validación del certificado y, después, aprobación del webhook.",{"_3625":73785,"_31241":73731,"_21645":123481,"_5":14907,"_28433":123358,"_3077":54145},[],{"_3625":73786,"_31241":73731,"_21645":123483,"_5":14907,"_28433":123358,"_3077":123484},[],"Sin autenticación del solicitante por el DMS.",{"_3625":73787,"_31241":73731,"_21645":123486,"_5":14907,"_28433":123358,"_3077":123487},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3625":73788,"_31241":73731,"_21645":123489,"_5":14907,"_28433":123358,"_3077":123490},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3625":73789,"_31241":73731,"_21645":123492,"_5":14907,"_28433":123358,"_3077":123493},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones. Las listas CRL descargadas para estas comprobaciones se reutilizan durante un tiempo limitado antes de volver a descargarse; consulta Revocación y comprobaciones para conocer la ventana de caché y su efecto sobre la visibilidad de una revocación.",{"_3625":73790,"_31241":73731,"_21645":123495,"_5":14907,"_28433":123358,"_3077":123496},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3625":73791,"_31241":73731,"_21645":123498,"_5":14907,"_28433":123358,"_3077":123499},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3625":73792,"_31241":73731,"_21645":123501,"_5":14907,"_28433":123362,"_3077":123502},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3625":73793,"_31241":73731,"_21645":123504,"_5":14907,"_28433":123362,"_3077":123505},[],"Campo de `external_webhook_settings`",{"_3625":73794,"_31241":73731,"_21645":123507,"_5":14907,"_28433":123362,"_3077":123422},[],{"_3625":73795,"_31241":73731,"_21645":123509,"_5":14907,"_28433":123362,"_3077":54174},[],{"_3625":73796,"_31241":73731,"_21645":123511,"_5":14907,"_28433":123362,"_3077":123512},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3625":73797,"_31241":73731,"_21645":123514,"_5":14907,"_28433":123362,"_3077":54180},[],{"_3625":73798,"_31241":73731,"_21645":123516,"_5":14907,"_28433":123362,"_3077":123517},[],"`POST` o `PUT`; `POST` por defecto.",{"_3625":73799,"_31241":73731,"_21645":123519,"_5":14907,"_28433":123362,"_3077":54186},[],{"_3625":73800,"_31241":73731,"_21645":123521,"_5":14907,"_28433":123362,"_3077":123522},[],"Etiqueta usada en los logs del servicio.",{"_3625":73801,"_31241":73731,"_21645":123524,"_5":14907,"_28433":123362,"_3077":54192},[],{"_3625":73802,"_31241":73731,"_21645":123526,"_5":14907,"_28433":123362,"_3077":123527},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3625":73803,"_31241":73731,"_21645":123529,"_5":14907,"_28433":123362,"_3077":54198},[],{"_3625":73804,"_31241":73731,"_21645":123531,"_5":14907,"_28433":123362,"_3077":123532},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3625":73805,"_31241":73731,"_21645":123534,"_5":14907,"_28433":123362,"_3077":54204},[],{"_3625":73806,"_31241":73731,"_21645":123536,"_5":14907,"_28433":123362,"_3077":123537},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3625":73807,"_31241":73731,"_21645":123539,"_5":14907,"_28433":123362,"_3077":54210},[],{"_3625":73808,"_31241":73731,"_21645":123541,"_5":14907,"_28433":123362,"_3077":123542},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3625":73809,"_31241":73731,"_21645":123544,"_5":14907,"_28433":123362,"_3077":54216},[],{"_3625":73810,"_31241":73731,"_21645":123546,"_5":14907,"_28433":123362,"_3077":123547},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3625":73811,"_31241":73731,"_21645":123549,"_5":14907,"_28433":123362,"_3077":54222},[],{"_3625":73812,"_31241":73731,"_21645":123551,"_5":14907,"_28433":123362,"_3077":123552},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3625":73813,"_31241":73731,"_21645":123554,"_5":14907,"_28433":123362,"_3077":54228},[],{"_3625":73814,"_31241":73731,"_21645":123556,"_5":14907,"_28433":123362,"_3077":123557},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3625":73815,"_31241":73731,"_21645":123559,"_5":14907,"_28433":123362,"_3077":123560},[],"Reglas de esa configuración:",{"_3625":73816,"_31241":73731,"_21645":123562,"_5":14907,"_28433":123362,"_3077":123563},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3625":73817,"_31241":73731,"_21645":123565,"_5":14907,"_28433":123362,"_3077":123566},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3625":73818,"_31241":73731,"_21645":123568,"_5":14907,"_28433":123362,"_3077":123569},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3625":73819,"_31241":73731,"_21645":123571,"_5":14907,"_28433":123362,"_3077":123572},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3625":73820,"_31241":73731,"_21645":123574,"_5":14907,"_28433":123362,"_3077":123575},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3625":73821,"_31241":73731,"_21645":123577,"_5":14907,"_28433":123362,"_3077":123578},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3625":73822,"_31241":73731,"_21645":123580,"_5":14907,"_28433":123362,"_3077":123581},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3625":73823,"_31241":73731,"_21645":123583,"_5":14907,"_28433":123362,"_3077":123584},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3625":73824,"_31241":73731,"_21645":123586,"_5":14907,"_28433":123362,"_3077":123587},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3625":73825,"_31241":73731,"_21645":123589,"_5":14907,"_28433":123366,"_3077":123590},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3625":73826,"_31241":73731,"_21645":123592,"_5":14907,"_28433":123370,"_3077":123593},[],"Campo de `settings.reenrollment_settings`",{"_3625":73827,"_31241":73731,"_21645":123595,"_5":14907,"_28433":123370,"_3077":123596},[],"Función",{"_3625":73828,"_31241":73731,"_21645":123598,"_5":14907,"_28433":123370,"_3077":54272},[],{"_3625":73829,"_31241":73731,"_21645":123600,"_5":14907,"_28433":123370,"_3077":123601},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3625":73830,"_31241":73731,"_21645":123603,"_5":14907,"_28433":123370,"_3077":54278},[],{"_3625":73831,"_31241":73731,"_21645":123605,"_5":14907,"_28433":123370,"_3077":123606},[],"Umbral operativo preventivo de monitorización.",{"_3625":73832,"_31241":73731,"_21645":123608,"_5":14907,"_28433":123370,"_3077":54284},[],{"_3625":73833,"_31241":73731,"_21645":123610,"_5":14907,"_28433":123370,"_3077":123611},[],"Umbral operativo crítico de monitorización.",{"_3625":73834,"_31241":73731,"_21645":123613,"_5":14907,"_28433":123370,"_3077":54290},[],{"_3625":73835,"_31241":73731,"_21645":123615,"_5":14907,"_28433":123370,"_3077":123616},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3625":73836,"_31241":73731,"_21645":123618,"_5":14907,"_28433":123370,"_3077":54296},[],{"_3625":73837,"_31241":73731,"_21645":123620,"_5":14907,"_28433":123370,"_3077":123621},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3625":73838,"_31241":73731,"_21645":123623,"_5":14907,"_28433":123370,"_3077":54302},[],{"_3625":73839,"_31241":73731,"_21645":123625,"_5":14907,"_28433":123370,"_3077":123626},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3625":73840,"_31241":73731,"_21645":123628,"_5":14907,"_28433":123370,"_3077":123629},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3625":73841,"_31241":73731,"_21645":123631,"_5":14907,"_28433":123374,"_3077":123632},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3625":73842,"_31241":73731,"_21645":123634,"_5":14907,"_28433":123377,"_3077":120805},[],{"_3625":73843,"_31241":73731,"_21645":123636,"_5":14907,"_28433":123377,"_3077":123637},[],"Qué publica",{"_3625":73844,"_31241":73731,"_21645":123639,"_5":14907,"_28433":123377,"_3077":54319},[],{"_3625":73845,"_31241":73731,"_21645":123641,"_5":14907,"_28433":123377,"_3077":123642},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3625":73846,"_31241":73731,"_21645":123644,"_5":14907,"_28433":123377,"_3077":54325},[],{"_3625":73847,"_31241":73731,"_21645":123646,"_5":14907,"_28433":123377,"_3077":123647},[],"Certificado de la CA emisora seleccionada.",{"_3625":73848,"_31241":73731,"_21645":123649,"_5":14907,"_28433":123377,"_3077":54331},[],{"_3625":73849,"_31241":73731,"_21645":123651,"_5":14907,"_28433":123377,"_3077":123652},[],"Certificados de las CAs elegidas explícitamente.",{"_3625":73850,"_31241":73731,"_21645":123654,"_5":14907,"_28433":123377,"_3077":123655},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3625":73851,"_31241":73731,"_21645":123657,"_5":14907,"_28433":123381,"_3077":123658},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3625":73852,"_31241":73731,"_21645":123660,"_5":14907,"_28433":123381,"_3077":123661},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3625":73853,"_31241":73731,"_21645":123663,"_5":14907,"_28433":123381,"_3077":123664},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3625":73854,"_31241":73731,"_21645":123666,"_5":14907,"_28433":123385,"_3077":123667},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3625":73855,"_31241":73855,"_5":15267,"_3077":123669,"_31600":123670,"_21645":123671,"_28433":73855},"Integra el cliente EST",[51013,121907,53697,123052,123230],[],{"_3625":73856,"_31241":73855,"_21645":123673,"_5":14907,"_28433":73855,"_3077":123674},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3625":73857,"_31241":73855,"_5":31597,"_21645":123676,"_28433":123677,"_3077":120441},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3625":73858,"_31241":73855,"_5":31597,"_21645":123679,"_28433":123680,"_3077":123681},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3625":73859,"_31241":73855,"_5":31597,"_21645":123683,"_28433":123684,"_3077":123685},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3625":73860,"_31241":73855,"_5":31597,"_21645":123687,"_28433":123688,"_3077":123689},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3625":73861,"_31241":73855,"_5":31597,"_21645":123691,"_28433":123692,"_3077":123693},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3625":73862,"_31241":73855,"_5":31597,"_21645":123695,"_28433":123696,"_3077":123697},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3625":73863,"_31241":73855,"_21645":123699,"_5":14907,"_28433":73855,"_3077":123700},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3625":73864,"_31241":73855,"_21645":123702,"_5":14907,"_28433":123677,"_3077":123703},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3625":73865,"_31241":73855,"_21645":123705,"_5":14907,"_28433":123677,"_3077":123706},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3625":73866,"_31241":73855,"_21645":123708,"_5":14907,"_28433":123677,"_3077":123709},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3625":73867,"_31241":73855,"_21645":123711,"_5":14907,"_28433":123680,"_3077":123712},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3625":73868,"_31241":73855,"_21645":123714,"_5":14907,"_28433":123680,"_3077":123715},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3625":73869,"_31241":73855,"_21645":123717,"_5":14907,"_28433":123684,"_3077":123718},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3625":73870,"_31241":73855,"_21645":123720,"_5":14907,"_28433":123684,"_3077":123721},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3625":73871,"_31241":73855,"_21645":123723,"_5":14907,"_28433":123688,"_3077":123724},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3625":73872,"_31241":73855,"_21645":123726,"_5":14907,"_28433":123688,"_3077":123727},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3625":73873,"_31241":73855,"_21645":123729,"_5":14907,"_28433":123692,"_3077":123730},[],"Para el caso de una raíz que emite directamente:",{"_3625":73874,"_31241":73855,"_21645":123732,"_5":14907,"_28433":123692,"_3077":123733},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3625":73875,"_31241":73855,"_21645":123735,"_5":14907,"_28433":123692,"_3077":123736},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3625":73876,"_31241":73855,"_21645":123738,"_5":14907,"_28433":123696,"_3077":123739},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3625":73877,"_31241":73877,"_5":15267,"_3077":123741,"_31600":123742,"_21645":123743,"_28433":73877},"Referencia EST",[51013,121907,53697,123052,123230],[],{"_3625":73878,"_31241":73877,"_21645":123745,"_5":14907,"_28433":73877,"_3077":123746},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3625":73879,"_31241":73877,"_5":31597,"_21645":123748,"_28433":123749,"_3077":123750},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3625":73880,"_31241":73877,"_5":31597,"_21645":123752,"_28433":123753,"_3077":23453},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3625":73881,"_31241":73877,"_5":31597,"_21645":123755,"_28433":123756,"_3077":26982},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3625":73882,"_31241":73877,"_5":31597,"_21645":123758,"_28433":123759,"_3077":26989},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3625":73883,"_31241":73877,"_5":31597,"_21645":123761,"_28433":123762,"_3077":26251},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3625":73884,"_31241":73877,"_5":31597,"_21645":123764,"_28433":123765,"_3077":123766},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3625":73885,"_31241":73877,"_5":31597,"_21645":123768,"_28433":123769,"_3077":123770},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3625":73886,"_31241":73877,"_5":31597,"_21645":123772,"_28433":123773,"_3077":123774},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3625":73887,"_31241":73877,"_21645":123776,"_5":14907,"_28433":73877,"_3077":123777},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3625":73888,"_31241":73877,"_21645":123779,"_5":14907,"_28433":123749,"_3077":123780},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3625":73889,"_31241":73877,"_21645":123782,"_5":14907,"_28433":123749,"_3077":121667},[],{"_3625":73890,"_31241":73877,"_21645":123784,"_5":14907,"_28433":123749,"_3077":123785},[],"Método",{"_3625":73891,"_31241":73877,"_21645":123787,"_5":14907,"_28433":123749,"_3077":123788},[],"Autenticación y condición",{"_3625":73892,"_31241":73877,"_21645":123790,"_5":14907,"_28433":123749,"_3077":54474},[],{"_3625":73893,"_31241":73877,"_21645":123792,"_5":14907,"_28433":123749,"_3077":54477},[],{"_3625":73894,"_31241":73877,"_21645":123794,"_5":14907,"_28433":123749,"_3077":123795},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3625":73895,"_31241":73877,"_21645":123797,"_5":14907,"_28433":123749,"_3077":54483},[],{"_3625":73896,"_31241":73877,"_21645":123799,"_5":14907,"_28433":123749,"_3077":54486},[],{"_3625":73897,"_31241":73877,"_21645":123801,"_5":14907,"_28433":123749,"_3077":123802},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3625":73898,"_31241":73877,"_21645":123804,"_5":14907,"_28433":123749,"_3077":54492},[],{"_3625":73899,"_31241":73877,"_21645":123806,"_5":14907,"_28433":123749,"_3077":54486},[],{"_3625":73900,"_31241":73877,"_21645":123808,"_5":14907,"_28433":123749,"_3077":123809},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3625":73901,"_31241":73877,"_21645":123811,"_5":14907,"_28433":123749,"_3077":54500},[],{"_3625":73902,"_31241":73877,"_21645":123813,"_5":14907,"_28433":123749,"_3077":54486},[],{"_3625":73903,"_31241":73877,"_21645":123815,"_5":14907,"_28433":123749,"_3077":123816},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3625":73904,"_31241":73877,"_21645":123818,"_5":14907,"_28433":123749,"_3077":123819},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3625":73905,"_31241":73877,"_21645":123821,"_5":14907,"_28433":123753,"_3077":123822},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3625":73906,"_31241":73877,"_21645":123824,"_5":14907,"_28433":123753,"_3077":123825},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3625":73907,"_31241":73877,"_21645":123827,"_5":14907,"_28433":123756,"_3077":123828},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3625":73908,"_31241":73877,"_21645":123830,"_5":14907,"_28433":123756,"_3077":123831},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3625":73909,"_31241":73877,"_21645":123833,"_5":14907,"_28433":123759,"_3077":123834},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3625":73910,"_31241":73877,"_21645":123836,"_5":14907,"_28433":123759,"_3077":123837},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3625":73911,"_31241":73877,"_21645":123839,"_5":14907,"_28433":123762,"_3077":123840},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3625":73912,"_31241":73877,"_21645":123842,"_5":14907,"_28433":123762,"_3077":123843},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3625":73913,"_31241":73877,"_21645":123845,"_5":14907,"_28433":123765,"_3077":123846},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3625":73914,"_31241":73877,"_21645":123848,"_5":14907,"_28433":123765,"_3077":123849},[],"Parte",{"_3625":73915,"_31241":73877,"_21645":123851,"_5":14907,"_28433":123765,"_3077":123852},[],"Contenido tras decodificar su Base64",{"_3625":73916,"_31241":73877,"_21645":123854,"_5":14907,"_28433":123765,"_3077":54544},[],{"_3625":73917,"_31241":73877,"_21645":123856,"_5":14907,"_28433":123765,"_3077":123857},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3625":73918,"_31241":73877,"_21645":123859,"_5":14907,"_28433":123765,"_3077":54550},[],{"_3625":73919,"_31241":73877,"_21645":123861,"_5":14907,"_28433":123765,"_3077":123862},[],"PKCS#7 DER con el certificado emitido.",{"_3625":73920,"_31241":73877,"_21645":123864,"_5":14907,"_28433":123765,"_3077":123865},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3625":73921,"_31241":73877,"_21645":123867,"_5":14907,"_28433":123769,"_3077":123868},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3625":73922,"_31241":73877,"_21645":123870,"_5":14907,"_28433":123769,"_3077":123871},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3625":73923,"_31241":73877,"_21645":123873,"_5":14907,"_28433":123769,"_3077":123874},[],"Convierte y comprueba el resultado:",{"_3625":73924,"_31241":73877,"_21645":123876,"_5":14907,"_28433":123769,"_3077":123877},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3625":73925,"_31241":73877,"_21645":123879,"_5":14907,"_28433":123773,"_3077":123880},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3625":73926,"_31241":73877,"_21645":123882,"_5":14907,"_28433":123773,"_3077":123883},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3625":73927,"_31241":73927,"_5":15267,"_3077":123230,"_31600":123885,"_21645":123886,"_28433":73927},[51013,121907,53697,123052,123230],[],{"_3625":73928,"_31241":73927,"_21645":123888,"_5":14907,"_28433":73927,"_3077":123889},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3625":73929,"_31241":73927,"_5":31597,"_21645":123891,"_28433":123892,"_3077":123893},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3625":73930,"_31241":73927,"_5":31597,"_21645":123895,"_28433":123896,"_3077":123897},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3625":73931,"_31241":73927,"_5":31597,"_21645":123899,"_28433":123900,"_3077":123901},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3625":73932,"_31241":73927,"_21645":123903,"_5":14907,"_28433":73927,"_3077":123904},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3625":73933,"_31241":73927,"_21645":123906,"_5":14907,"_28433":123892,"_3077":123907},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3625":73934,"_31241":73927,"_21645":123909,"_5":14907,"_28433":123892,"_3077":123910},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3625":73935,"_31241":73927,"_21645":123912,"_5":14907,"_28433":123892,"_3077":123913},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3625":73936,"_31241":73927,"_21645":123915,"_5":14907,"_28433":123892,"_3077":123916},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3625":73937,"_31241":73927,"_21645":123918,"_5":14907,"_28433":123892,"_3077":123919},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3625":73938,"_31241":73927,"_21645":123921,"_5":14907,"_28433":123892,"_3077":123922},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3625":73939,"_31241":73927,"_21645":123924,"_5":14907,"_28433":123896,"_3077":123925},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3625":73940,"_31241":73927,"_21645":123927,"_5":14907,"_28433":123896,"_3077":123928},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3625":73941,"_31241":73927,"_21645":123930,"_5":14907,"_28433":123896,"_3077":123931},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3625":73942,"_31241":73927,"_21645":123933,"_5":14907,"_28433":123896,"_3077":123934},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3625":73943,"_31241":73927,"_21645":123936,"_5":14907,"_28433":123900,"_3077":123937},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3625":73944,"_31241":73927,"_21645":123939,"_5":14907,"_28433":123900,"_3077":123940},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3625":73945,"_31241":73927,"_21645":123942,"_5":14907,"_28433":123900,"_3077":123943},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3625":73946,"_31241":73927,"_21645":123945,"_5":14907,"_28433":123900,"_3077":123946},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3625":73947,"_31241":73927,"_21645":123948,"_5":14907,"_28433":123900,"_3077":123949},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3625":73948,"_31241":73948,"_5":15267,"_3077":123951,"_31600":123952,"_21645":123953,"_28433":73948},"Estrategias de aprovisionamiento",[51013,121907,53697,123052,123230],[],{"_3625":73949,"_31241":73948,"_21645":123955,"_5":14907,"_28433":73948,"_3077":123956},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3625":73950,"_31241":73948,"_5":31597,"_21645":123958,"_28433":123959,"_3077":123960},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3625":73951,"_31241":73948,"_5":31597,"_21645":123962,"_28433":123963,"_3077":123964},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3625":73952,"_31241":73948,"_5":31597,"_21645":123966,"_28433":123967,"_3077":123968},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3625":73953,"_31241":73948,"_5":31597,"_21645":123970,"_28433":123971,"_3077":123972},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3625":73954,"_31241":73948,"_5":31597,"_21645":123974,"_28433":123975,"_3077":123976},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3625":73955,"_31241":73948,"_21645":123978,"_5":14907,"_28433":73948,"_3077":123979},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3625":73956,"_31241":73948,"_21645":123981,"_5":14907,"_28433":123959,"_3077":123982},[],"Recorrido",{"_3625":73957,"_31241":73948,"_21645":123984,"_5":14907,"_28433":123959,"_3077":123985},[],"Cuándo existe el dispositivo",{"_3625":73958,"_31241":73948,"_21645":123987,"_5":14907,"_28433":123959,"_3077":123988},[],"Qué compruebas",{"_3625":73959,"_31241":73948,"_21645":123990,"_5":14907,"_28433":123959,"_3077":123991},[],"Asignación manual",{"_3625":73960,"_31241":73948,"_21645":123993,"_5":14907,"_28433":123959,"_3077":123994},[],"El operador lo crea antes de asociar un certificado.",{"_3625":73961,"_31241":73948,"_21645":123996,"_5":14907,"_28433":123959,"_3077":123997},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3625":73962,"_31241":73948,"_21645":123999,"_5":14907,"_28433":123959,"_3077":124000},[],"EST con `JITP`",{"_3625":73963,"_31241":73948,"_21645":124002,"_5":14907,"_28433":123959,"_3077":124003},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3625":73964,"_31241":73948,"_21645":124005,"_5":14907,"_28433":123959,"_3077":124006},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3625":73965,"_31241":73948,"_21645":124008,"_5":14907,"_28433":123959,"_3077":124009},[],"EST con `PRE_REGISTRATION`",{"_3625":73966,"_31241":73948,"_21645":124011,"_5":14907,"_28433":123959,"_3077":124012},[],"Debe existir antes de `/simpleenroll`.",{"_3625":73967,"_31241":73948,"_21645":124014,"_5":14907,"_28433":123959,"_3077":124015},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3625":73968,"_31241":73948,"_21645":124017,"_5":14907,"_28433":123959,"_3077":124018},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3625":73969,"_31241":73948,"_21645":124020,"_5":14907,"_28433":123959,"_3077":124021},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3625":73970,"_31241":73948,"_21645":124023,"_5":14907,"_28433":123963,"_3077":124024},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3625":73971,"_31241":73948,"_21645":124026,"_5":14907,"_28433":123963,"_3077":124027},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3625":73972,"_31241":73948,"_21645":124029,"_5":14907,"_28433":123963,"_3077":124030},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3625":73973,"_31241":73948,"_21645":124032,"_5":14907,"_28433":123967,"_3077":124033},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3625":73974,"_31241":73948,"_21645":124035,"_5":14907,"_28433":123967,"_3077":124036},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3625":73975,"_31241":73948,"_21645":124038,"_5":14907,"_28433":123967,"_3077":124039},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3625":73976,"_31241":73948,"_21645":124041,"_5":14907,"_28433":123967,"_3077":124042},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3625":73977,"_31241":73948,"_21645":124044,"_5":14907,"_28433":123967,"_3077":124045},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3625":73978,"_31241":73948,"_21645":124047,"_5":14907,"_28433":123967,"_3077":124048},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3625":73979,"_31241":73948,"_21645":124050,"_5":14907,"_28433":123971,"_3077":120805},[],{"_3625":73980,"_31241":73948,"_21645":124052,"_5":14907,"_28433":123971,"_3077":124053},[],"Material que atraviesa EST",{"_3625":73981,"_31241":73948,"_21645":124055,"_5":14907,"_28433":123971,"_3077":124056},[],"Clave generada por el dispositivo",{"_3625":73982,"_31241":73948,"_21645":124058,"_5":14907,"_28433":123971,"_3077":124059},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3625":73983,"_31241":73948,"_21645":124061,"_5":14907,"_28433":123971,"_3077":124062},[],"Clave ya disponible en el dispositivo",{"_3625":73984,"_31241":73948,"_21645":124064,"_5":14907,"_28433":123971,"_3077":124065},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3625":73985,"_31241":73948,"_21645":124067,"_5":14907,"_28433":123971,"_3077":54028},[],{"_3625":73986,"_31241":73948,"_21645":124069,"_5":14907,"_28433":123971,"_3077":124070},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3625":73987,"_31241":73948,"_21645":124072,"_5":14907,"_28433":123971,"_3077":124073},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3625":73988,"_31241":73948,"_21645":124075,"_5":14907,"_28433":123975,"_3077":124076},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3625":73989,"_31241":73989,"_5":15267,"_3077":124078,"_31600":124079,"_21645":124080,"_28433":73989},"Renovación y recuperación",[51013,121907,53697,123052,123230],[],{"_3625":73990,"_31241":73989,"_21645":124082,"_5":14907,"_28433":73989,"_3077":124083},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3625":73991,"_31241":73989,"_5":31597,"_21645":124085,"_28433":124086,"_3077":124087},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3625":73992,"_31241":73989,"_5":31597,"_21645":124089,"_28433":124090,"_3077":124091},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3625":73993,"_31241":73989,"_5":31597,"_21645":124093,"_28433":124094,"_3077":124095},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3625":73994,"_31241":73989,"_5":31597,"_21645":124097,"_28433":124098,"_3077":124099},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3625":73995,"_31241":73989,"_5":31597,"_21645":124101,"_28433":124102,"_3077":124103},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3625":73996,"_31241":73989,"_21645":124105,"_5":14907,"_28433":73989,"_3077":124106},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3625":73997,"_31241":73989,"_21645":124108,"_5":14907,"_28433":124086,"_3077":124109},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3625":73998,"_31241":73989,"_21645":124111,"_5":14907,"_28433":124086,"_3077":124112},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3625":73999,"_31241":73989,"_21645":124114,"_5":14907,"_28433":124086,"_3077":124115},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3625":74000,"_31241":73989,"_21645":124117,"_5":14907,"_28433":124086,"_3077":124118},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3625":74001,"_31241":73989,"_21645":124120,"_5":14907,"_28433":124090,"_3077":124121},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3625":74002,"_31241":73989,"_21645":124123,"_5":14907,"_28433":124090,"_3077":124124},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3625":74003,"_31241":73989,"_21645":124126,"_5":14907,"_28433":124094,"_3077":124127},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3625":74004,"_31241":73989,"_21645":124129,"_5":14907,"_28433":124094,"_3077":124130},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3625":74005,"_31241":73989,"_21645":124132,"_5":14907,"_28433":124094,"_3077":124133},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3625":74006,"_31241":73989,"_21645":124135,"_5":14907,"_28433":124098,"_3077":124136},[],"Situación",{"_3625":74007,"_31241":73989,"_21645":124138,"_5":14907,"_28433":124098,"_3077":124139},[],"Procedimiento",{"_3625":74008,"_31241":73989,"_21645":124141,"_5":14907,"_28433":124098,"_3077":124142},[],"Certificado vigente, fuera de ventana",{"_3625":74009,"_31241":73989,"_21645":124144,"_5":14907,"_28433":124098,"_3077":124145},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3625":74010,"_31241":73989,"_21645":124147,"_5":14907,"_28433":124098,"_3077":124148},[],"Certificado vencido, clave disponible",{"_3625":74011,"_31241":73989,"_21645":124150,"_5":14907,"_28433":124098,"_3077":124151},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3625":74012,"_31241":73989,"_21645":124153,"_5":14907,"_28433":124098,"_3077":124154},[],"Renovación por webhook o `NO_AUTH`",{"_3625":74013,"_31241":73989,"_21645":124156,"_5":14907,"_28433":124098,"_3077":124157},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3625":74014,"_31241":73989,"_21645":124159,"_5":14907,"_28433":124098,"_3077":124160},[],"Clave perdida o inaccesible",{"_3625":74015,"_31241":73989,"_21645":124162,"_5":14907,"_28433":124098,"_3077":124163},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3625":74016,"_31241":73989,"_21645":124165,"_5":14907,"_28433":124098,"_3077":124166},[],"Identidad actual revocada",{"_3625":74017,"_31241":73989,"_21645":124168,"_5":14907,"_28433":124098,"_3077":124169},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3625":74018,"_31241":73989,"_21645":124171,"_5":14907,"_28433":124098,"_3077":124172},[],"Dispositivo sin identidad",{"_3625":74019,"_31241":73989,"_21645":124174,"_5":14907,"_28433":124098,"_3077":124175},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3625":74020,"_31241":73989,"_21645":124177,"_5":14907,"_28433":124098,"_3077":124178},[],"Dispositivo retirado",{"_3625":74021,"_31241":73989,"_21645":124180,"_5":14907,"_28433":124098,"_3077":124181},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3625":74022,"_31241":73989,"_21645":124183,"_5":14907,"_28433":124098,"_3077":124184},[],"Timeout, HTTP 500 o fallo de instalación",{"_3625":74023,"_31241":73989,"_21645":124186,"_5":14907,"_28433":124098,"_3077":124187},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3625":74024,"_31241":73989,"_21645":124189,"_5":14907,"_28433":124102,"_3077":124190},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3625":74025,"_31241":73989,"_21645":124192,"_5":14907,"_28433":124102,"_3077":124193},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3625":74026,"_31241":74026,"_5":15267,"_3077":124195,"_31600":124196,"_21645":124197,"_28433":74026},"Diagnóstico de enrolamiento",[51013,121907,53697,123052,123230],[],{"_3625":74027,"_31241":74026,"_21645":124199,"_5":14907,"_28433":74026,"_3077":124200},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3625":74028,"_31241":74026,"_5":31597,"_21645":124202,"_28433":124203,"_3077":124204},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3625":74029,"_31241":74026,"_5":31597,"_21645":124206,"_28433":124207,"_3077":124208},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3625":74030,"_31241":74026,"_5":31597,"_21645":124210,"_28433":124211,"_3077":123774},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3625":74031,"_31241":74026,"_5":31597,"_21645":124213,"_28433":124214,"_3077":124215},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3625":74032,"_31241":74026,"_21645":124217,"_5":14907,"_28433":74026,"_3077":124218},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3625":74033,"_31241":74026,"_21645":124220,"_5":14907,"_28433":124207,"_3077":124221},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3625":74034,"_31241":74026,"_21645":124223,"_5":14907,"_28433":124207,"_3077":124224},[],"Síntoma o mensaje",{"_3625":74035,"_31241":74026,"_21645":124226,"_5":14907,"_28433":124207,"_3077":124227},[],"Qué revisar",{"_3625":74036,"_31241":74026,"_21645":124229,"_5":14907,"_28433":124207,"_3077":124230},[],"curl rechaza TLS, nombre o emisor",{"_3625":74037,"_31241":74026,"_21645":124232,"_5":14907,"_28433":124207,"_3077":124233},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3625":74038,"_31241":74026,"_21645":124235,"_5":14907,"_28433":124207,"_3077":124236},[],"404 o APS ausente",{"_3625":74039,"_31241":74026,"_21645":124238,"_5":14907,"_28433":124207,"_3077":124239},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3625":74040,"_31241":74026,"_21645":124241,"_5":14907,"_28433":124207,"_3077":124242},[],"400, error de CSR o formato",{"_3625":74041,"_31241":74026,"_21645":124244,"_5":14907,"_28433":124207,"_3077":124245},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3625":74042,"_31241":74026,"_21645":124247,"_5":14907,"_28433":124207,"_3077":124248},[],"Credencial ausente o certificado no válido",{"_3625":74043,"_31241":74026,"_21645":124250,"_5":14907,"_28433":124207,"_3077":124251},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3625":74044,"_31241":74026,"_21645":124253,"_5":14907,"_28433":124207,"_3077":124254},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3625":74045,"_31241":74026,"_21645":124256,"_5":14907,"_28433":124207,"_3077":124257},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3625":74046,"_31241":74026,"_21645":124259,"_5":14907,"_28433":124207,"_3077":124260},[],"Webhook deniega, expira o responde sin autorización",{"_3625":74047,"_31241":74026,"_21645":124262,"_5":14907,"_28433":124207,"_3077":124263},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3625":74048,"_31241":74026,"_21645":124265,"_5":14907,"_28433":124207,"_3077":54956},[],{"_3625":74049,"_31241":74026,"_21645":124267,"_5":14907,"_28433":124207,"_3077":124268},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3625":74050,"_31241":74026,"_21645":124270,"_5":14907,"_28433":124207,"_3077":54962},[],{"_3625":74051,"_31241":74026,"_21645":124272,"_5":14907,"_28433":124207,"_3077":124273},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3625":74052,"_31241":74026,"_21645":124275,"_5":14907,"_28433":124207,"_3077":54968},[],{"_3625":74053,"_31241":74026,"_21645":124277,"_5":14907,"_28433":124207,"_3077":124278},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3625":74054,"_31241":74026,"_21645":124280,"_5":14907,"_28433":124207,"_3077":54974},[],{"_3625":74055,"_31241":74026,"_21645":124282,"_5":14907,"_28433":124207,"_3077":124283},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3625":74056,"_31241":74026,"_21645":124285,"_5":14907,"_28433":124207,"_3077":54980},[],{"_3625":74057,"_31241":74026,"_21645":124287,"_5":14907,"_28433":124207,"_3077":124288},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3625":74058,"_31241":74026,"_21645":124290,"_5":14907,"_28433":124207,"_3077":124291},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3625":74059,"_31241":74026,"_21645":124293,"_5":14907,"_28433":124207,"_3077":124294},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3625":74060,"_31241":74026,"_21645":124296,"_5":14907,"_28433":124207,"_3077":124297},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3625":74061,"_31241":74026,"_21645":124299,"_5":14907,"_28433":124207,"_3077":124300},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3625":74062,"_31241":74026,"_21645":124302,"_5":14907,"_28433":124207,"_3077":54998},[],{"_3625":74063,"_31241":74026,"_21645":124304,"_5":14907,"_28433":124207,"_3077":124305},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3625":74064,"_31241":74026,"_21645":124307,"_5":14907,"_28433":124207,"_3077":55004},[],{"_3625":74065,"_31241":74026,"_21645":124309,"_5":14907,"_28433":124207,"_3077":124310},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3625":74066,"_31241":74026,"_21645":124312,"_5":14907,"_28433":124207,"_3077":124313},[],"DMS propietario distinto",{"_3625":74067,"_31241":74026,"_21645":124315,"_5":14907,"_28433":124207,"_3077":124316},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3625":74068,"_31241":74026,"_21645":124318,"_5":14907,"_28433":124207,"_3077":55016},[],{"_3625":74069,"_31241":74026,"_21645":124320,"_5":14907,"_28433":124207,"_3077":124321},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3625":74070,"_31241":74026,"_21645":124323,"_5":14907,"_28433":124207,"_3077":55022},[],{"_3625":74071,"_31241":74026,"_21645":124325,"_5":14907,"_28433":124207,"_3077":124326},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3625":74072,"_31241":74026,"_21645":124328,"_5":14907,"_28433":124207,"_3077":124329},[],"Certificado actual revocado",{"_3625":74073,"_31241":74026,"_21645":124331,"_5":14907,"_28433":124207,"_3077":124332},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3625":74074,"_31241":74026,"_21645":124334,"_5":14907,"_28433":124207,"_3077":124335},[],"Error de CA, perfil o firma",{"_3625":74075,"_31241":74026,"_21645":124337,"_5":14907,"_28433":124207,"_3077":124338},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3625":74076,"_31241":74026,"_21645":124340,"_5":14907,"_28433":124207,"_3077":124341},[],"HTTP 200 sin conexión del dispositivo",{"_3625":74077,"_31241":74026,"_21645":124343,"_5":14907,"_28433":124207,"_3077":124344},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3625":74078,"_31241":74026,"_21645":124346,"_5":14907,"_28433":124207,"_3077":124347},[],"Timeout o error después de emitir",{"_3625":74079,"_31241":74026,"_21645":124349,"_5":14907,"_28433":124207,"_3077":124350},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3625":74080,"_31241":74026,"_21645":124352,"_5":14907,"_28433":124211,"_3077":124353},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3625":74081,"_31241":74026,"_21645":124355,"_5":14907,"_28433":124211,"_3077":124356},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3625":74082,"_31241":74026,"_21645":124358,"_5":14907,"_28433":124214,"_3077":124359},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3625":74083,"_31241":74026,"_21645":124361,"_5":14907,"_28433":124214,"_3077":124362},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3625":74084,"_31241":74026,"_21645":124364,"_5":14907,"_28433":124214,"_3077":124365},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3625":74085,"_31241":74026,"_21645":124367,"_5":14907,"_28433":124214,"_3077":124368},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3625":74086,"_31241":74026,"_21645":124370,"_5":14907,"_28433":124214,"_3077":124371},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3625":74087,"_31241":74026,"_21645":124373,"_5":14907,"_28433":124214,"_3077":124374},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3625":74088,"_31241":74026,"_21645":124376,"_5":14907,"_28433":124214,"_3077":124377},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3625":74089,"_31241":74089,"_5":15267,"_3077":124379,"_31600":124380,"_21645":124381,"_28433":74089},"Distribución y actualización de confianza",[51013,121907,53697,123052,123230],[],{"_3625":74090,"_31241":74089,"_21645":124383,"_5":14907,"_28433":74089,"_3077":124384},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3625":74091,"_31241":74089,"_5":31597,"_21645":124386,"_28433":124387,"_3077":124388},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3625":74092,"_31241":74089,"_5":31597,"_21645":124390,"_28433":124391,"_3077":124392},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3625":74093,"_31241":74089,"_5":31597,"_21645":124394,"_28433":124395,"_3077":124396},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3625":74094,"_31241":74089,"_5":31597,"_21645":124398,"_28433":124399,"_3077":124400},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3625":74095,"_31241":74089,"_5":31597,"_21645":124402,"_28433":124403,"_3077":124404},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3625":74096,"_31241":74089,"_21645":124406,"_5":14907,"_28433":74089,"_3077":124407},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3625":74097,"_31241":74089,"_21645":124409,"_5":14907,"_28433":124387,"_3077":124410},[],"Relación",{"_3625":74098,"_31241":74089,"_21645":124412,"_5":14907,"_28433":124387,"_3077":124413},[],"Material que prepara el responsable",{"_3625":74099,"_31241":74089,"_21645":124415,"_5":14907,"_28433":124387,"_3077":124416},[],"Dispositivo → servidor EST",{"_3625":74100,"_31241":74089,"_21645":124418,"_5":14907,"_28433":124387,"_3077":124419},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3625":74101,"_31241":74089,"_21645":124421,"_5":14907,"_28433":124387,"_3077":124422},[],"DMS → solicitante",{"_3625":74102,"_31241":74089,"_21645":124424,"_5":14907,"_28433":124387,"_3077":124425},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3625":74103,"_31241":74089,"_21645":124427,"_5":14907,"_28433":124387,"_3077":124428},[],"Consumidor → dispositivo",{"_3625":74104,"_31241":74089,"_21645":124430,"_5":14907,"_28433":124387,"_3077":124431},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3625":74105,"_31241":74089,"_21645":124433,"_5":14907,"_28433":124387,"_3077":124434},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3625":74106,"_31241":74089,"_21645":124436,"_5":14907,"_28433":124391,"_3077":124437},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3625":74107,"_31241":74089,"_21645":124439,"_5":14907,"_28433":124391,"_3077":124440},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3625":74108,"_31241":74089,"_21645":124442,"_5":14907,"_28433":124395,"_3077":124443},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3625":74109,"_31241":74089,"_21645":124445,"_5":14907,"_28433":124395,"_3077":124446},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3625":74110,"_31241":74089,"_21645":124448,"_5":14907,"_28433":124395,"_3077":124449},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3625":74111,"_31241":74089,"_21645":124451,"_5":14907,"_28433":124395,"_3077":124452},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3625":74112,"_31241":74089,"_21645":124454,"_5":14907,"_28433":124395,"_3077":124455},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3625":74113,"_31241":74089,"_21645":124457,"_5":14907,"_28433":124395,"_3077":124458},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3625":74114,"_31241":74089,"_21645":124460,"_5":14907,"_28433":124399,"_3077":124461},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3625":74115,"_31241":74089,"_21645":124463,"_5":14907,"_28433":124399,"_3077":124464},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3625":74116,"_31241":74089,"_21645":124466,"_5":14907,"_28433":124399,"_3077":124467},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3625":74117,"_31241":74089,"_21645":124469,"_5":14907,"_28433":124403,"_3077":124470},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3625":74118,"_31241":74118,"_5":15267,"_3077":55171,"_31600":124472,"_21645":124474,"_28433":74118},[51013,121907,53697,123052,124473],"Integraciones",[],{"_3625":74119,"_31241":74118,"_21645":124476,"_5":14907,"_28433":74118,"_3077":124477},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3625":74120,"_31241":74118,"_5":31597,"_21645":124479,"_28433":124480,"_3077":124481},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3625":74121,"_31241":74118,"_5":31597,"_21645":124483,"_28433":124484,"_3077":124485},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3625":74122,"_31241":74118,"_5":31597,"_21645":124487,"_28433":124488,"_3077":124489},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3625":74123,"_31241":74118,"_5":31597,"_21645":124491,"_28433":124492,"_3077":124493},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3625":74124,"_31241":74118,"_5":31597,"_21645":124495,"_28433":124496,"_3077":124497},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3625":74125,"_31241":74118,"_5":31597,"_21645":124499,"_28433":124500,"_3077":124501},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3625":74126,"_31241":74118,"_5":31597,"_21645":124503,"_28433":124504,"_3077":124505},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3625":74127,"_31241":74118,"_5":31597,"_21645":124507,"_28433":124508,"_3077":124509},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3625":74128,"_31241":74118,"_5":31597,"_21645":124511,"_28433":124512,"_3077":55213},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3625":74129,"_31241":74118,"_5":31597,"_21645":124514,"_28433":124515,"_3077":55217},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3625":74130,"_31241":74118,"_5":31597,"_21645":124517,"_28433":124518,"_3077":124519},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3625":74131,"_31241":74118,"_5":31597,"_21645":124521,"_28433":124522,"_3077":124523},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3625":74132,"_31241":74118,"_5":31597,"_21645":124525,"_28433":124526,"_3077":124527},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3625":74133,"_31241":74118,"_5":31597,"_21645":124529,"_28433":124530,"_3077":124531},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3625":74134,"_31241":74118,"_5":31597,"_21645":124533,"_28433":124534,"_3077":124535},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3625":74135,"_31241":74118,"_5":31597,"_21645":124537,"_28433":124538,"_3077":124539},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3625":74136,"_31241":74118,"_5":31597,"_21645":124541,"_28433":124542,"_3077":124543},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3625":74137,"_31241":74118,"_5":31597,"_21645":124545,"_28433":124546,"_3077":124547},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3625":74138,"_31241":74118,"_5":31597,"_21645":124549,"_28433":124550,"_3077":124551},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3625":74139,"_31241":74118,"_5":31597,"_21645":124553,"_28433":124554,"_3077":124555},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3625":74140,"_31241":74118,"_5":31597,"_21645":124557,"_28433":124558,"_3077":124559},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3625":74141,"_31241":74118,"_5":31597,"_21645":124561,"_28433":124562,"_3077":124563},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3625":74142,"_31241":74118,"_5":31597,"_21645":124565,"_28433":124566,"_3077":124567},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3625":74143,"_31241":74118,"_5":31597,"_21645":124569,"_28433":124570,"_3077":124571},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3625":74144,"_31241":74118,"_5":31597,"_21645":124573,"_28433":124574,"_3077":124575},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3625":74145,"_31241":74118,"_21645":124577,"_5":14907,"_28433":74118,"_3077":124578},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3625":74146,"_31241":74118,"_21645":124580,"_5":14907,"_28433":74118,"_3077":124581},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3625":74147,"_31241":74118,"_21645":124583,"_5":14907,"_28433":74118,"_3077":124584},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3625":74148,"_31241":74118,"_21645":124586,"_5":14907,"_28433":124480,"_3077":124587},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3625":74149,"_31241":74118,"_21645":124589,"_5":14907,"_28433":124480,"_3077":124590},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3625":74150,"_31241":74118,"_21645":124592,"_5":14907,"_28433":124480,"_3077":124593},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3625":74151,"_31241":74118,"_21645":124595,"_5":14907,"_28433":124480,"_3077":124596},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3625":74152,"_31241":74118,"_21645":124598,"_5":14907,"_28433":124484,"_3077":124599},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3625":74153,"_31241":74118,"_21645":124601,"_5":14907,"_28433":124488,"_3077":124602},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3625":74154,"_31241":74118,"_21645":124604,"_5":14907,"_28433":124488,"_3077":124605},[],"Acción IAM",{"_3625":74155,"_31241":74118,"_21645":124607,"_5":14907,"_28433":124488,"_3077":120811},[],{"_3625":74156,"_31241":74118,"_21645":124609,"_5":14907,"_28433":124488,"_3077":55312},[],{"_3625":74157,"_31241":74118,"_21645":124611,"_5":14907,"_28433":124488,"_3077":124612},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3625":74158,"_31241":74118,"_21645":124614,"_5":14907,"_28433":124488,"_3077":55318},[],{"_3625":74159,"_31241":74118,"_21645":124616,"_5":14907,"_28433":124488,"_3077":124617},[],"Registrar la CA en AWS IoT",{"_3625":74160,"_31241":74118,"_21645":124619,"_5":14907,"_28433":124488,"_3077":55324},[],{"_3625":74161,"_31241":74118,"_21645":124621,"_5":14907,"_28433":124488,"_3077":124622},[],"Consultar el estado del registro de la CA",{"_3625":74162,"_31241":74118,"_21645":124624,"_5":14907,"_28433":124488,"_3077":55330},[],{"_3625":74163,"_31241":74118,"_21645":124626,"_5":14907,"_28433":124488,"_3077":124627},[],"Crear o actualizar Things en IoT Core",{"_3625":74164,"_31241":74118,"_21645":124629,"_5":14907,"_28433":124488,"_3077":55336},[],{"_3625":74165,"_31241":74118,"_21645":124631,"_5":14907,"_28433":124488,"_3077":124632},[],"Aprovisionar Things mediante plantilla",{"_3625":74166,"_31241":74118,"_21645":124634,"_5":14907,"_28433":124488,"_3077":55342},[],{"_3625":74167,"_31241":74118,"_21645":124636,"_5":14907,"_28433":124488,"_3077":124637},[],"Registrar certificados de dispositivo",{"_3625":74168,"_31241":74118,"_21645":124639,"_5":14907,"_28433":124488,"_3077":55348},[],{"_3625":74169,"_31241":74118,"_21645":124641,"_5":14907,"_28433":124488,"_3077":124642},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3625":74170,"_31241":74118,"_21645":124644,"_5":14907,"_28433":124488,"_3077":55354},[],{"_3625":74171,"_31241":74118,"_21645":124646,"_5":14907,"_28433":124488,"_3077":124647},[],"Crear y adjuntar políticas IoT",{"_3625":74172,"_31241":74118,"_21645":124649,"_5":14907,"_28433":124488,"_3077":55360},[],{"_3625":74173,"_31241":74118,"_21645":124651,"_5":14907,"_28433":124488,"_3077":124652},[],"Gestionar grupos de Things",{"_3625":74174,"_31241":74118,"_21645":124654,"_5":14907,"_28433":124488,"_3077":55366},[],{"_3625":74175,"_31241":74118,"_21645":124656,"_5":14907,"_28433":124488,"_3077":124657},[],"Crear plantillas JITP",{"_3625":74176,"_31241":74118,"_21645":124659,"_5":14907,"_28433":124488,"_3077":55372},[],{"_3625":74177,"_31241":74118,"_21645":124661,"_5":14907,"_28433":124488,"_3077":124662},[],"Leer y escribir el Device Shadow",{"_3625":74178,"_31241":74118,"_21645":124664,"_5":14907,"_28433":124488,"_3077":124665},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3625":74179,"_31241":74118,"_21645":124667,"_5":14907,"_28433":124492,"_3077":124668},[],"Parámetro",{"_3625":74180,"_31241":74118,"_21645":124670,"_5":14907,"_28433":124492,"_3077":124671},[],"Tipo",{"_3625":74181,"_31241":74118,"_21645":124673,"_5":14907,"_28433":124492,"_3077":124674},[],"Requerido",{"_3625":74182,"_31241":74118,"_21645":124676,"_5":14907,"_28433":124492,"_3077":124677},[],"Descripción",{"_3625":74183,"_31241":74118,"_21645":124679,"_5":14907,"_28433":124492,"_3077":55393},[],{"_3625":74184,"_31241":74118,"_21645":124681,"_5":14907,"_28433":124492,"_3077":25851},[],{"_3625":74185,"_31241":74118,"_21645":124683,"_5":14907,"_28433":124492,"_3077":124684},[],"Sí",{"_3625":74186,"_31241":74118,"_21645":124686,"_5":14907,"_28433":124492,"_3077":124687},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3625":74187,"_31241":74118,"_21645":124689,"_5":14907,"_28433":124492,"_3077":55404},[],{"_3625":74188,"_31241":74118,"_21645":124691,"_5":14907,"_28433":124492,"_3077":25851},[],{"_3625":74189,"_31241":74118,"_21645":124693,"_5":14907,"_28433":124492,"_3077":124684},[],{"_3625":74190,"_31241":74118,"_21645":124695,"_5":14907,"_28433":124492,"_3077":124696},[],"Región AWS donde opera el conector.",{"_3625":74191,"_31241":74118,"_21645":124698,"_5":14907,"_28433":124492,"_3077":55414},[],{"_3625":74192,"_31241":74118,"_21645":124700,"_5":14907,"_28433":124492,"_3077":25851},[],{"_3625":74193,"_31241":74118,"_21645":124702,"_5":14907,"_28433":124492,"_3077":124684},[],{"_3625":74194,"_31241":74118,"_21645":124704,"_5":14907,"_28433":124492,"_3077":124705},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3625":74195,"_31241":74118,"_21645":124707,"_5":14907,"_28433":124492,"_3077":55424},[],{"_3625":74196,"_31241":74118,"_21645":124709,"_5":14907,"_28433":124492,"_3077":25851},[],{"_3625":74197,"_31241":74118,"_21645":124711,"_5":14907,"_28433":124492,"_3077":124712},[],"Solo con `auth_method=static`",{"_3625":74198,"_31241":74118,"_21645":124714,"_5":14907,"_28433":124492,"_3077":124715},[],"Clave de acceso AWS.",{"_3625":74199,"_31241":74118,"_21645":124717,"_5":14907,"_28433":124492,"_3077":55435},[],{"_3625":74200,"_31241":74118,"_21645":124719,"_5":14907,"_28433":124492,"_3077":25851},[],{"_3625":74201,"_31241":74118,"_21645":124721,"_5":14907,"_28433":124492,"_3077":124712},[],{"_3625":74202,"_31241":74118,"_21645":124723,"_5":14907,"_28433":124492,"_3077":124724},[],"Clave secreta AWS.",{"_3625":74203,"_31241":74118,"_21645":124726,"_5":14907,"_28433":124492,"_3077":55445},[],{"_3625":74204,"_31241":74118,"_21645":124728,"_5":14907,"_28433":124492,"_3077":25851},[],{"_3625":74205,"_31241":74118,"_21645":124730,"_5":14907,"_28433":124492,"_3077":55450},[],{"_3625":74206,"_31241":74118,"_21645":124732,"_5":14907,"_28433":124492,"_3077":124733},[],"Token de sesión (con `auth_method=static`).",{"_3625":74207,"_31241":74118,"_21645":124735,"_5":14907,"_28433":124492,"_3077":55456},[],{"_3625":74208,"_31241":74118,"_21645":124737,"_5":14907,"_28433":124492,"_3077":25851},[],{"_3625":74209,"_31241":74118,"_21645":124739,"_5":14907,"_28433":124492,"_3077":124740},[],"Solo con `auth_method=role`",{"_3625":74210,"_31241":74118,"_21645":124742,"_5":14907,"_28433":124492,"_3077":124743},[],"ARN del rol a asumir.",{"_3625":74211,"_31241":74118,"_21645":124745,"_5":14907,"_28433":124492,"_3077":55467},[],{"_3625":74212,"_31241":74118,"_21645":124747,"_5":14907,"_28433":124492,"_3077":25851},[],{"_3625":74213,"_31241":74118,"_21645":124749,"_5":14907,"_28433":124492,"_3077":55450},[],{"_3625":74214,"_31241":74118,"_21645":124751,"_5":14907,"_28433":124492,"_3077":124752},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3625":74215,"_31241":74118,"_21645":124754,"_5":14907,"_28433":124492,"_3077":55477},[],{"_3625":74216,"_31241":74118,"_21645":124756,"_5":14907,"_28433":124492,"_3077":92986},[],{"_3625":74217,"_31241":74118,"_21645":124758,"_5":14907,"_28433":124492,"_3077":124684},[],{"_3625":74218,"_31241":74118,"_21645":124760,"_5":14907,"_28433":124492,"_3077":124761},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3625":74219,"_31241":74118,"_21645":124763,"_5":14907,"_28433":124492,"_3077":55487},[],{"_3625":74220,"_31241":74118,"_21645":124765,"_5":14907,"_28433":124492,"_3077":25851},[],{"_3625":74221,"_31241":74118,"_21645":124767,"_5":14907,"_28433":124492,"_3077":124684},[],{"_3625":74222,"_31241":74118,"_21645":124769,"_5":14907,"_28433":124492,"_3077":124770},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3625":74223,"_31241":74118,"_21645":124772,"_5":14907,"_28433":124492,"_3077":55497},[],{"_3625":74224,"_31241":74118,"_21645":124774,"_5":14907,"_28433":124492,"_3077":25851},[],{"_3625":74225,"_31241":74118,"_21645":124776,"_5":14907,"_28433":124492,"_3077":124684},[],{"_3625":74226,"_31241":74118,"_21645":124778,"_5":14907,"_28433":124492,"_3077":124779},[],"URL HTTP del Device Manager de Lamassu.",{"_3625":74227,"_31241":74118,"_21645":124781,"_5":14907,"_28433":124492,"_3077":55507},[],{"_3625":74228,"_31241":74118,"_21645":124783,"_5":14907,"_28433":124492,"_3077":25851},[],{"_3625":74229,"_31241":74118,"_21645":124785,"_5":14907,"_28433":124492,"_3077":124684},[],{"_3625":74230,"_31241":74118,"_21645":124787,"_5":14907,"_28433":124492,"_3077":124788},[],"URL HTTP del servicio de CA de Lamassu.",{"_3625":74231,"_31241":74118,"_21645":124790,"_5":14907,"_28433":124496,"_3077":124791},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3625":74232,"_31241":74118,"_21645":124793,"_5":14907,"_28433":124496,"_3077":124794},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3625":74233,"_31241":74118,"_21645":124796,"_5":14907,"_28433":124496,"_3077":124797},[],"Tipo de CloudEvent",{"_3625":74234,"_31241":74118,"_21645":124799,"_5":14907,"_28433":124496,"_3077":124800},[],"Recurso en Lamassu",{"_3625":74235,"_31241":74118,"_21645":124802,"_5":14907,"_28433":124496,"_3077":124803},[],"Recurso AWS",{"_3625":74236,"_31241":74118,"_21645":124805,"_5":14907,"_28433":124496,"_3077":124806},[],"Acciones IAM",{"_3625":74237,"_31241":74118,"_21645":124808,"_5":14907,"_28433":124496,"_3077":124809},[],"Llamadas AWS y efecto",{"_3625":74238,"_31241":74118,"_21645":124811,"_5":14907,"_28433":124496,"_3077":124812},[],"Dónde en esta página",{"_3625":74239,"_31241":74118,"_21645":124814,"_5":14907,"_28433":124496,"_3077":55541},[],{"_3625":74240,"_31241":74118,"_21645":124816,"_5":14907,"_28433":124496,"_3077":55544},[],{"_3625":74241,"_31241":74118,"_21645":124818,"_5":14907,"_28433":124496,"_3077":55547},[],{"_3625":74242,"_31241":74118,"_21645":124820,"_5":14907,"_28433":124496,"_3077":55550},[],{"_3625":74243,"_31241":74118,"_21645":124822,"_5":14907,"_28433":124496,"_3077":124823},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3625":74244,"_31241":74118,"_21645":124825,"_5":14907,"_28433":124496,"_3077":124509},[],{"_3625":74245,"_31241":74118,"_21645":124827,"_5":14907,"_28433":124496,"_3077":55558},[],{"_3625":74246,"_31241":74118,"_21645":124829,"_5":14907,"_28433":124496,"_3077":55561},[],{"_3625":74247,"_31241":74118,"_21645":124831,"_5":14907,"_28433":124496,"_3077":55564},[],{"_3625":74248,"_31241":74118,"_21645":124833,"_5":14907,"_28433":124496,"_3077":55567},[],{"_3625":74249,"_31241":74118,"_21645":124835,"_5":14907,"_28433":124496,"_3077":124836},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3625":74250,"_31241":74118,"_21645":124838,"_5":14907,"_28433":124496,"_3077":124535},[],{"_3625":74251,"_31241":74118,"_21645":124840,"_5":14907,"_28433":124496,"_3077":55575},[],{"_3625":74252,"_31241":74118,"_21645":124842,"_5":14907,"_28433":124496,"_3077":124843},[],"Dispositivo",{"_3625":74253,"_31241":74118,"_21645":124845,"_5":14907,"_28433":124496,"_3077":55581},[],{"_3625":74254,"_31241":74118,"_21645":124847,"_5":14907,"_28433":124496,"_3077":55584},[],{"_3625":74255,"_31241":74118,"_21645":124849,"_5":14907,"_28433":124496,"_3077":124850},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3625":74256,"_31241":74118,"_21645":124852,"_5":14907,"_28433":124496,"_3077":124543},[],{"_3625":74257,"_31241":74118,"_21645":124854,"_5":14907,"_28433":124496,"_3077":55592},[],{"_3625":74258,"_31241":74118,"_21645":124856,"_5":14907,"_28433":124496,"_3077":124857},[],"Certificado",{"_3625":74259,"_31241":74118,"_21645":124859,"_5":14907,"_28433":124496,"_3077":55598},[],{"_3625":74260,"_31241":74118,"_21645":124861,"_5":14907,"_28433":124496,"_3077":124862},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3625":74261,"_31241":74118,"_21645":124864,"_5":14907,"_28433":124496,"_3077":124865},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3625":74262,"_31241":74118,"_21645":124867,"_5":14907,"_28433":124496,"_3077":124555},[],{"_3625":74263,"_31241":74118,"_21645":124869,"_5":14907,"_28433":124496,"_3077":55609},[],{"_3625":74264,"_31241":74118,"_21645":124871,"_5":14907,"_28433":124496,"_3077":124872},[],"Certificado / Dispositivo",{"_3625":74265,"_31241":74118,"_21645":124874,"_5":14907,"_28433":124496,"_3077":55615},[],{"_3625":74266,"_31241":74118,"_21645":124876,"_5":14907,"_28433":124496,"_3077":51409},[],{"_3625":74267,"_31241":74118,"_21645":124878,"_5":14907,"_28433":124496,"_3077":124879},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3625":74268,"_31241":74118,"_21645":124881,"_5":14907,"_28433":124496,"_3077":124563},[],{"_3625":74269,"_31241":74118,"_21645":124883,"_5":14907,"_28433":124500,"_3077":124884},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3625":74270,"_31241":74118,"_21645":124886,"_5":14907,"_28433":124504,"_3077":124887},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3625":74271,"_31241":74118,"_21645":124889,"_5":14907,"_28433":124504,"_3077":124890},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3625":74272,"_31241":74118,"_21645":124892,"_5":14907,"_28433":124508,"_3077":124893},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3625":74273,"_31241":74118,"_21645":124895,"_5":14907,"_28433":124508,"_3077":124896},[],"Transición",{"_3625":74274,"_31241":74118,"_21645":124898,"_5":14907,"_28433":124508,"_3077":124899},[],"Llamadas AWS",{"_3625":74275,"_31241":74118,"_21645":124901,"_5":14907,"_28433":124508,"_3077":124902},[],"`NoRegistrada` → `Solicitada`",{"_3625":74276,"_31241":74118,"_21645":124904,"_5":14907,"_28433":124508,"_3077":124905},[],"ninguna (solo escritura de metadatos)",{"_3625":74277,"_31241":74118,"_21645":124907,"_5":14907,"_28433":124508,"_3077":124908},[],"`Solicitada` → `Registrando`",{"_3625":74278,"_31241":74118,"_21645":124910,"_5":14907,"_28433":124508,"_3077":124911},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3625":74279,"_31241":74118,"_21645":124913,"_5":14907,"_28433":124508,"_3077":124914},[],"`Registrando` → `Completada`",{"_3625":74280,"_31241":74118,"_21645":124916,"_5":14907,"_28433":124508,"_3077":124917},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3625":74281,"_31241":74118,"_21645":124919,"_5":14907,"_28433":124508,"_3077":124920},[],"`Registrando` → `Fallida`",{"_3625":74282,"_31241":74118,"_21645":124922,"_5":14907,"_28433":124508,"_3077":124923},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3625":74283,"_31241":74118,"_21645":124925,"_5":14907,"_28433":124508,"_3077":124926},[],"`Fallida` / `Completada` → `Solicitada`",{"_3625":74284,"_31241":74118,"_21645":124928,"_5":14907,"_28433":124508,"_3077":124929},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3625":74285,"_31241":74118,"_21645":124931,"_5":14907,"_28433":124512,"_3077":124932},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3625":74286,"_31241":74118,"_21645":124934,"_5":14907,"_28433":124512,"_3077":124935},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3625":74287,"_31241":74118,"_21645":124937,"_5":14907,"_28433":124512,"_3077":124938},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3625":74288,"_31241":74118,"_21645":124940,"_5":14907,"_28433":124512,"_3077":124941},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3625":74289,"_31241":74118,"_21645":124943,"_5":14907,"_28433":124512,"_3077":124944},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3625":74290,"_31241":74118,"_21645":124946,"_5":14907,"_28433":124512,"_3077":124947},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3625":74291,"_31241":74118,"_21645":124949,"_5":14907,"_28433":124515,"_3077":124950},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3625":74292,"_31241":74118,"_21645":124952,"_5":14907,"_28433":124518,"_3077":124953},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3625":74293,"_31241":74118,"_21645":124955,"_5":14907,"_28433":124518,"_3077":124956},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3625":74294,"_31241":74118,"_21645":124958,"_5":14907,"_28433":124522,"_3077":124959},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3625":74295,"_31241":74118,"_21645":124961,"_5":14907,"_28433":124526,"_3077":124962},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3625":74296,"_31241":74118,"_21645":124964,"_5":14907,"_28433":124526,"_3077":124965},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3625":74297,"_31241":74118,"_21645":124967,"_5":14907,"_28433":124526,"_3077":124968},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3625":74298,"_31241":74118,"_21645":124970,"_5":14907,"_28433":124526,"_3077":124971},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3625":74299,"_31241":74118,"_21645":124973,"_5":14907,"_28433":124526,"_3077":124974},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3625":74300,"_31241":74118,"_21645":124976,"_5":14907,"_28433":124526,"_3077":124977},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3625":74301,"_31241":74118,"_21645":124979,"_5":14907,"_28433":124530,"_3077":124980},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3625":74302,"_31241":74118,"_21645":124982,"_5":14907,"_28433":124530,"_3077":124983},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3625":74303,"_31241":74118,"_21645":124985,"_5":14907,"_28433":124530,"_3077":124986},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3625":74304,"_31241":74118,"_21645":124988,"_5":14907,"_28433":124530,"_3077":124989},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3625":74305,"_31241":74118,"_21645":124991,"_5":14907,"_28433":124530,"_3077":124992},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3625":74306,"_31241":74118,"_21645":124994,"_5":14907,"_28433":124534,"_3077":124995},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3625":74307,"_31241":74118,"_21645":124997,"_5":14907,"_28433":124534,"_3077":124896},[],{"_3625":74308,"_31241":74118,"_21645":124999,"_5":14907,"_28433":124534,"_3077":124899},[],{"_3625":74309,"_31241":74118,"_21645":125001,"_5":14907,"_28433":124534,"_3077":125002},[],"`SinConfigurar` → `None` / `Auto`",{"_3625":74310,"_31241":74118,"_21645":125004,"_5":14907,"_28433":124534,"_3077":125005},[],"ninguna (solo configuración)",{"_3625":74311,"_31241":74118,"_21645":125007,"_5":14907,"_28433":124534,"_3077":55752},[],{"_3625":74312,"_31241":74118,"_21645":125009,"_5":14907,"_28433":124534,"_3077":125005},[],{"_3625":74313,"_31241":74118,"_21645":125011,"_5":14907,"_28433":124534,"_3077":125012},[],"Cualquiera → `Jitp`",{"_3625":74314,"_31241":74118,"_21645":125014,"_5":14907,"_28433":124534,"_3077":125015},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3625":74315,"_31241":74118,"_21645":125017,"_5":14907,"_28433":124534,"_3077":55763},[],{"_3625":74316,"_31241":74118,"_21645":125019,"_5":14907,"_28433":124534,"_3077":125020},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3625":74317,"_31241":74118,"_21645":125022,"_5":14907,"_28433":124538,"_3077":125023},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3625":74318,"_31241":74118,"_21645":125025,"_5":14907,"_28433":124538,"_3077":125026},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3625":74319,"_31241":74118,"_21645":125028,"_5":14907,"_28433":124538,"_3077":125029},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3625":74320,"_31241":74118,"_21645":125031,"_5":14907,"_28433":124542,"_3077":125032},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3625":74321,"_31241":74118,"_21645":125034,"_5":14907,"_28433":124542,"_3077":124896},[],{"_3625":74322,"_31241":74118,"_21645":125036,"_5":14907,"_28433":124542,"_3077":124899},[],{"_3625":74323,"_31241":74118,"_21645":125038,"_5":14907,"_28433":124542,"_3077":125039},[],"`Ausente` → `Aprovisionado`",{"_3625":74324,"_31241":74118,"_21645":125041,"_5":14907,"_28433":124542,"_3077":125042},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3625":74325,"_31241":74118,"_21645":125044,"_5":14907,"_28433":124542,"_3077":125045},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3625":74326,"_31241":74118,"_21645":125047,"_5":14907,"_28433":124542,"_3077":125048},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3625":74327,"_31241":74118,"_21645":125050,"_5":14907,"_28433":124542,"_3077":125051},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3625":74328,"_31241":74118,"_21645":125053,"_5":14907,"_28433":124546,"_3077":125054},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3625":74329,"_31241":74118,"_21645":125056,"_5":14907,"_28433":124546,"_3077":125057},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3625":74330,"_31241":74118,"_21645":125059,"_5":14907,"_28433":124546,"_3077":125060},[],"Para que el flujo JITP funcione correctamente:",{"_3625":74331,"_31241":74118,"_21645":125062,"_5":14907,"_28433":124546,"_3077":125063},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3625":74332,"_31241":74118,"_21645":125065,"_5":14907,"_28433":124546,"_3077":125066},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3625":74333,"_31241":74118,"_21645":125068,"_5":14907,"_28433":124546,"_3077":125069},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3625":74334,"_31241":74118,"_21645":125071,"_5":14907,"_28433":124546,"_3077":125072},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3625":74335,"_31241":74118,"_21645":125074,"_5":14907,"_28433":124550,"_3077":125075},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3625":74336,"_31241":74118,"_21645":125077,"_5":14907,"_28433":124550,"_3077":125078},[],"Estado en Lamassu",{"_3625":74337,"_31241":74118,"_21645":125080,"_5":14907,"_28433":124550,"_3077":125081},[],"Razón de revocación",{"_3625":74338,"_31241":74118,"_21645":125083,"_5":14907,"_28433":124550,"_3077":125084},[],"Estado en AWS IoT Core",{"_3625":74339,"_31241":74118,"_21645":125086,"_5":14907,"_28433":124550,"_3077":55833},[],{"_3625":74340,"_31241":74118,"_21645":125088,"_5":14907,"_28433":124550,"_3077":125089},[],"Ninguna",{"_3625":74341,"_31241":74118,"_21645":125091,"_5":14907,"_28433":124550,"_3077":55839},[],{"_3625":74342,"_31241":74118,"_21645":125093,"_5":14907,"_28433":124550,"_3077":55842},[],{"_3625":74343,"_31241":74118,"_21645":125095,"_5":14907,"_28433":124550,"_3077":55845},[],{"_3625":74344,"_31241":74118,"_21645":125097,"_5":14907,"_28433":124550,"_3077":55848},[],{"_3625":74345,"_31241":74118,"_21645":125099,"_5":14907,"_28433":124550,"_3077":55842},[],{"_3625":74346,"_31241":74118,"_21645":125101,"_5":14907,"_28433":124550,"_3077":125102},[],"Cualquier otra razón",{"_3625":74347,"_31241":74118,"_21645":125104,"_5":14907,"_28433":124550,"_3077":55856},[],{"_3625":74348,"_31241":74118,"_21645":125106,"_5":14907,"_28433":124550,"_3077":125107},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3625":74349,"_31241":74118,"_21645":125109,"_5":14907,"_28433":124554,"_3077":125110},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3625":74350,"_31241":74118,"_21645":125112,"_5":14907,"_28433":124554,"_3077":124896},[],{"_3625":74351,"_31241":74118,"_21645":125114,"_5":14907,"_28433":124554,"_3077":124899},[],{"_3625":74352,"_31241":74118,"_21645":125116,"_5":14907,"_28433":124554,"_3077":125117},[],"`NoSincronizado` → `Active`",{"_3625":74353,"_31241":74118,"_21645":125119,"_5":14907,"_28433":124554,"_3077":55348},[],{"_3625":74354,"_31241":74118,"_21645":125121,"_5":14907,"_28433":124554,"_3077":55874},[],{"_3625":74355,"_31241":74118,"_21645":125123,"_5":14907,"_28433":124554,"_3077":125124},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3625":74356,"_31241":74118,"_21645":125126,"_5":14907,"_28433":124554,"_3077":55880},[],{"_3625":74357,"_31241":74118,"_21645":125128,"_5":14907,"_28433":124554,"_3077":125124},[],{"_3625":74358,"_31241":74118,"_21645":125130,"_5":14907,"_28433":124554,"_3077":55885},[],{"_3625":74359,"_31241":74118,"_21645":125132,"_5":14907,"_28433":124554,"_3077":55348},[],{"_3625":74360,"_31241":74118,"_21645":125134,"_5":14907,"_28433":124554,"_3077":55890},[],{"_3625":74361,"_31241":74118,"_21645":125136,"_5":14907,"_28433":124554,"_3077":125137},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3625":74362,"_31241":74118,"_21645":125139,"_5":14907,"_28433":124558,"_3077":125140},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3625":74363,"_31241":74118,"_21645":125142,"_5":14907,"_28433":124558,"_3077":125143},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3625":74364,"_31241":74118,"_21645":125145,"_5":14907,"_28433":124558,"_3077":125146},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3625":74365,"_31241":74118,"_21645":125148,"_5":14907,"_28433":124562,"_3077":125149},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3625":74366,"_31241":74118,"_21645":125151,"_5":14907,"_28433":124562,"_3077":125152},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3625":74367,"_31241":74118,"_21645":125154,"_5":14907,"_28433":124566,"_3077":125155},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3625":74368,"_31241":74118,"_21645":125157,"_5":14907,"_28433":124566,"_3077":125158},[],"Existen dos tipos de acciones:",{"_3625":74369,"_31241":74118,"_21645":125160,"_5":14907,"_28433":124566,"_3077":125161},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3625":74370,"_31241":74118,"_21645":125163,"_5":14907,"_28433":124566,"_3077":125164},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3625":74371,"_31241":74118,"_21645":125166,"_5":14907,"_28433":124566,"_3077":125167},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3625":74372,"_31241":74118,"_21645":125169,"_5":14907,"_28433":124570,"_3077":125170},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3625":74373,"_31241":74118,"_21645":125172,"_5":14907,"_28433":124570,"_3077":125173},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3625":74374,"_31241":74118,"_21645":125175,"_5":14907,"_28433":124570,"_3077":125176},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3625":74375,"_31241":74118,"_21645":125178,"_5":14907,"_28433":124574,"_3077":125179},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3625":74376,"_31241":74118,"_21645":125181,"_5":14907,"_28433":124574,"_3077":125182},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3625":74377,"_31241":74118,"_21645":125184,"_5":14907,"_28433":124574,"_3077":125185},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3625":74378,"_31241":74118,"_21645":125187,"_5":14907,"_28433":124574,"_3077":125188},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3625":74379,"_31241":74118,"_21645":125190,"_5":14907,"_28433":124574,"_3077":125191},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3625":74380,"_31241":74118,"_21645":125193,"_5":14907,"_28433":124574,"_3077":125194},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3625":74381,"_31241":74118,"_21645":125196,"_5":14907,"_28433":124574,"_3077":125197},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3625":74382,"_31241":74118,"_21645":125199,"_5":14907,"_28433":124574,"_3077":125200},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3625":74383,"_31241":74118,"_21645":125202,"_5":14907,"_28433":124574,"_3077":125203},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3625":74384,"_31241":74118,"_21645":125205,"_5":14907,"_28433":124574,"_3077":125206},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3625":74385,"_31241":74118,"_21645":125208,"_5":14907,"_28433":124574,"_3077":125209},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3625":74386,"_31241":74118,"_21645":125211,"_5":14907,"_28433":124574,"_3077":125212},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3625":74387,"_31241":74118,"_21645":125214,"_5":14907,"_28433":124574,"_3077":125215},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3625":74388,"_31241":74118,"_21645":125217,"_5":14907,"_28433":124574,"_3077":125218},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3625":74389,"_31241":74118,"_21645":125220,"_5":14907,"_28433":124574,"_3077":125221},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3625":74390,"_31241":74118,"_21645":125223,"_5":14907,"_28433":124574,"_3077":125224},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3625":74391,"_31241":74118,"_21645":125226,"_5":14907,"_28433":124574,"_3077":125227},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3625":74392,"_31241":74118,"_21645":125229,"_5":14907,"_28433":124574,"_3077":125230},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3625":74393,"_31241":74118,"_21645":125232,"_5":14907,"_28433":124574,"_3077":125233},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3625":74394,"_31241":74118,"_21645":125235,"_5":14907,"_28433":124574,"_3077":125236},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3625":74395,"_31241":74118,"_21645":125238,"_5":14907,"_28433":124574,"_3077":125239},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3625":74396,"_31241":74118,"_21645":125241,"_5":14907,"_28433":124574,"_3077":125242},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3625":74397,"_31241":74118,"_21645":125244,"_5":14907,"_28433":124574,"_3077":125245},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3625":74398,"_31241":74118,"_21645":125247,"_5":14907,"_28433":124574,"_3077":125248},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3625":74399,"_31241":74399,"_5":15267,"_3077":53697,"_31600":125250,"_21645":125251,"_28433":74399},[51013,121907,53697],[],{"_3625":74400,"_31241":74399,"_21645":125253,"_5":14907,"_28433":74399,"_3077":125254},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3625":74401,"_31241":74399,"_5":31597,"_21645":125256,"_28433":125257,"_3077":125258},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3625":74402,"_31241":74399,"_5":31597,"_21645":125260,"_28433":125261,"_3077":123052},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3625":74403,"_31241":74399,"_5":31597,"_21645":125263,"_28433":125264,"_3077":123230},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3625":74404,"_31241":74399,"_5":31597,"_21645":125266,"_28433":125267,"_3077":124473},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#integraciones",{"_3625":74405,"_31241":74399,"_5":31597,"_21645":125269,"_28433":125270,"_3077":125271},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3625":74406,"_31241":74399,"_21645":125273,"_5":14907,"_28433":74399,"_3077":125274},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3625":74407,"_31241":74399,"_21645":125276,"_5":14907,"_28433":125257,"_3077":125277},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3625":74408,"_31241":74399,"_21645":125279,"_5":14907,"_28433":125257,"_3077":125280},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3625":74409,"_31241":74399,"_21645":125282,"_5":14907,"_28433":125261,"_3077":125283},[],"Recurso",{"_3625":74410,"_31241":74399,"_21645":125285,"_5":14907,"_28433":125261,"_3077":125286},[],"Qué representa",{"_3625":74411,"_31241":74399,"_21645":125288,"_5":14907,"_28433":125261,"_3077":125289},[],"**Dispositivo**",{"_3625":74412,"_31241":74399,"_21645":125291,"_5":14907,"_28433":125261,"_3077":125292},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3625":74413,"_31241":74399,"_21645":125294,"_5":14907,"_28433":125261,"_3077":125295},[],"**Identidad**",{"_3625":74414,"_31241":74399,"_21645":125297,"_5":14907,"_28433":125261,"_3077":125298},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3625":74415,"_31241":74399,"_21645":125300,"_5":14907,"_28433":125261,"_3077":56057},[],{"_3625":74416,"_31241":74399,"_21645":125302,"_5":14907,"_28433":125261,"_3077":125303},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3625":74417,"_31241":74399,"_21645":125305,"_5":14907,"_28433":125261,"_3077":125306},[],"**Flota**",{"_3625":74418,"_31241":74399,"_21645":125308,"_5":14907,"_28433":125261,"_3077":125309},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3625":74419,"_31241":74399,"_21645":125311,"_5":14907,"_28433":125261,"_3077":125312},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3625":74420,"_31241":74399,"_21645":125314,"_5":14907,"_28433":125261,"_3077":125315},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3625":74421,"_31241":74399,"_21645":125317,"_5":14907,"_28433":125264,"_3077":125318},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3625":74422,"_31241":74399,"_21645":125320,"_5":14907,"_28433":125264,"_3077":125321},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3625":74423,"_31241":74399,"_21645":125323,"_5":14907,"_28433":125264,"_3077":125324},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3625":74424,"_31241":74399,"_21645":125326,"_5":14907,"_28433":125264,"_3077":125327},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3625":74425,"_31241":74399,"_21645":125329,"_5":14907,"_28433":125264,"_3077":125330},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3625":74426,"_31241":74399,"_21645":125332,"_5":14907,"_28433":125264,"_3077":125333},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3625":74427,"_31241":74399,"_21645":125335,"_5":14907,"_28433":125264,"_3077":125336},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3625":74428,"_31241":74399,"_21645":125338,"_5":14907,"_28433":125264,"_3077":125339},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3625":74429,"_31241":74399,"_21645":125341,"_5":14907,"_28433":125267,"_3077":125342},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3625":74430,"_31241":74399,"_21645":125344,"_5":14907,"_28433":125267,"_3077":125345},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3625":74431,"_31241":74399,"_21645":125347,"_5":14907,"_28433":125270,"_3077":125348},[],"Participante",{"_3625":74432,"_31241":74399,"_21645":125350,"_5":14907,"_28433":125270,"_3077":125351},[],"Responsabilidad",{"_3625":74433,"_31241":74399,"_21645":125353,"_5":14907,"_28433":125270,"_3077":125354},[],"Administrador PKI",{"_3625":74434,"_31241":74399,"_21645":125356,"_5":14907,"_28433":125270,"_3077":125357},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3625":74435,"_31241":74399,"_21645":125359,"_5":14907,"_28433":125270,"_3077":125360},[],"Administrador del aprovisionamiento",{"_3625":74436,"_31241":74399,"_21645":125362,"_5":14907,"_28433":125270,"_3077":125363},[],"DMS, admisión, autenticación por operación e inventario.",{"_3625":74437,"_31241":74399,"_21645":125365,"_5":14907,"_28433":125270,"_3077":125366},[],"Integrador del dispositivo",{"_3625":74438,"_31241":74399,"_21645":125368,"_5":14907,"_28433":125270,"_3077":125369},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3625":74439,"_31241":74399,"_21645":125371,"_5":14907,"_28433":125270,"_3077":125372},[],"Integrador del consumidor",{"_3625":74440,"_31241":74399,"_21645":125374,"_5":14907,"_28433":125270,"_3077":125375},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3625":74441,"_31241":74399,"_21645":125377,"_5":14907,"_28433":125270,"_3077":125378},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3625":74442,"_31241":74442,"_5":15267,"_3077":125380,"_31600":125381,"_21645":125383,"_28433":74442},"Enrola y conecta tu primer dispositivo",[51013,121907,53697,125382],"Primeros pasos",[],{"_3625":74443,"_31241":74442,"_21645":125385,"_5":14907,"_28433":74442,"_3077":125386},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3625":74444,"_31241":74442,"_5":31597,"_21645":125388,"_28433":125389,"_3077":120441},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3625":74445,"_31241":74442,"_5":31597,"_21645":125391,"_28433":125392,"_3077":125393},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3625":74446,"_31241":74442,"_5":31597,"_21645":125395,"_28433":125396,"_3077":125397},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3625":74447,"_31241":74442,"_5":31597,"_21645":125399,"_28433":125400,"_3077":125401},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3625":74448,"_31241":74442,"_5":31597,"_21645":125403,"_28433":125404,"_3077":125405},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3625":74449,"_31241":74442,"_5":31597,"_21645":125407,"_28433":125408,"_3077":125409},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3625":74450,"_31241":74442,"_5":31597,"_21645":125411,"_28433":125412,"_3077":125413},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3625":74451,"_31241":74442,"_5":31597,"_21645":125415,"_28433":125416,"_3077":125417},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3625":74452,"_31241":74442,"_21645":125419,"_5":14907,"_28433":74442,"_3077":125420},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3625":74453,"_31241":74442,"_21645":125422,"_5":14907,"_28433":125389,"_3077":125423},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3625":74454,"_31241":74442,"_21645":125425,"_5":14907,"_28433":125389,"_3077":125426},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3625":74455,"_31241":74442,"_21645":125428,"_5":14907,"_28433":125389,"_3077":125429},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3625":74456,"_31241":74442,"_21645":125431,"_5":14907,"_28433":125389,"_3077":125432},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3625":74457,"_31241":74442,"_21645":125434,"_5":14907,"_28433":125389,"_3077":125435},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3625":74458,"_31241":74442,"_21645":125437,"_5":14907,"_28433":125392,"_3077":125438},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3625":74459,"_31241":74442,"_21645":125440,"_5":14907,"_28433":125392,"_3077":125441},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3625":74460,"_31241":74442,"_21645":125443,"_5":14907,"_28433":125396,"_3077":125444},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3625":74461,"_31241":74442,"_21645":125446,"_5":14907,"_28433":125396,"_3077":125447},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3625":74462,"_31241":74442,"_21645":125449,"_5":14907,"_28433":125396,"_3077":125450},[],"Ajuste",{"_3625":74463,"_31241":74442,"_21645":125452,"_5":14907,"_28433":125396,"_3077":125453},[],"Valor de evaluación",{"_3625":74464,"_31241":74442,"_21645":125455,"_5":14907,"_28433":125396,"_3077":56213},[],{"_3625":74465,"_31241":74442,"_21645":125457,"_5":14907,"_28433":125396,"_3077":125458},[],"Raíz emisora de `device-root.pem`.",{"_3625":74466,"_31241":74442,"_21645":125460,"_5":14907,"_28433":125396,"_3077":123367},[],{"_3625":74467,"_31241":74442,"_21645":125462,"_5":14907,"_28433":125396,"_3077":125463},[],"Perfil final de 1 hora que acabas de preparar.",{"_3625":74468,"_31241":74442,"_21645":125465,"_5":14907,"_28433":125396,"_3077":56224},[],{"_3625":74469,"_31241":74442,"_21645":125467,"_5":14907,"_28433":125396,"_3077":56227},[],{"_3625":74470,"_31241":74442,"_21645":125469,"_5":14907,"_28433":125396,"_3077":56230},[],{"_3625":74471,"_31241":74442,"_21645":125471,"_5":14907,"_28433":125396,"_3077":125472},[],"Habilitado.",{"_3625":74472,"_31241":74442,"_21645":125474,"_5":14907,"_28433":125396,"_3077":56236},[],{"_3625":74473,"_31241":74442,"_21645":125476,"_5":14907,"_28433":125396,"_3077":125477},[],"Deshabilitado; el ID debe ser nuevo.",{"_3625":74474,"_31241":74442,"_21645":125479,"_5":14907,"_28433":125396,"_3077":125480},[],"Autenticación inicial",{"_3625":74475,"_31241":74442,"_21645":125482,"_5":14907,"_28433":125396,"_3077":125483},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3625":74476,"_31241":74442,"_21645":125485,"_5":14907,"_28433":125396,"_3077":125486},[],"Autenticación de renovación",{"_3625":74477,"_31241":74442,"_21645":125488,"_5":14907,"_28433":125396,"_3077":125489},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3625":74478,"_31241":74442,"_21645":125491,"_5":14907,"_28433":125396,"_3077":56254},[],{"_3625":74479,"_31241":74442,"_21645":125493,"_5":14907,"_28433":125396,"_3077":125494},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3625":74480,"_31241":74442,"_21645":125496,"_5":14907,"_28433":125396,"_3077":56260},[],{"_3625":74481,"_31241":74442,"_21645":125498,"_5":14907,"_28433":125396,"_3077":125499},[],"1 hora.",{"_3625":74482,"_31241":74442,"_21645":125501,"_5":14907,"_28433":125396,"_3077":56266},[],{"_3625":74483,"_31241":74442,"_21645":125503,"_5":14907,"_28433":125396,"_3077":125504},[],"30 minutos / 10 minutos.",{"_3625":74484,"_31241":74442,"_21645":125506,"_5":14907,"_28433":125396,"_3077":56272},[],{"_3625":74485,"_31241":74442,"_21645":125508,"_5":14907,"_28433":125396,"_3077":125509},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3625":74486,"_31241":74442,"_21645":125511,"_5":14907,"_28433":125396,"_3077":54028},[],{"_3625":74487,"_31241":74442,"_21645":125513,"_5":14907,"_28433":125396,"_3077":125514},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3625":74488,"_31241":74442,"_21645":125516,"_5":14907,"_28433":125396,"_3077":56283},[],{"_3625":74489,"_31241":74442,"_21645":125518,"_5":14907,"_28433":125396,"_3077":125519},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3625":74490,"_31241":74442,"_21645":125521,"_5":14907,"_28433":125396,"_3077":125522},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3625":74491,"_31241":74442,"_21645":125524,"_5":14907,"_28433":125400,"_3077":125525},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3625":74492,"_31241":74442,"_21645":125527,"_5":14907,"_28433":125400,"_3077":125528},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3625":74493,"_31241":74442,"_21645":125530,"_5":14907,"_28433":125404,"_3077":125531},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3625":74494,"_31241":74442,"_21645":125533,"_5":14907,"_28433":125404,"_3077":125534},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3625":74495,"_31241":74442,"_21645":125536,"_5":14907,"_28433":125404,"_3077":125537},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3625":74496,"_31241":74442,"_21645":125539,"_5":14907,"_28433":125408,"_3077":125540},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3625":74497,"_31241":74442,"_21645":125542,"_5":14907,"_28433":125408,"_3077":125543},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3625":74498,"_31241":74442,"_21645":125545,"_5":14907,"_28433":125412,"_3077":125546},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3625":74499,"_31241":74442,"_21645":125548,"_5":14907,"_28433":125412,"_3077":125549},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3625":74500,"_31241":74442,"_21645":125551,"_5":14907,"_28433":125412,"_3077":125552},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3625":74501,"_31241":74442,"_21645":125554,"_5":14907,"_28433":125412,"_3077":125555},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3625":74502,"_31241":74442,"_21645":125557,"_5":14907,"_28433":125412,"_3077":125558},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3625":74503,"_31241":74442,"_21645":125560,"_5":14907,"_28433":125416,"_3077":125561},[],"Comprobación",{"_3625":74504,"_31241":74442,"_21645":125563,"_5":14907,"_28433":125416,"_3077":125564},[],"Resultado esperado",{"_3625":74505,"_31241":74442,"_21645":125566,"_5":14907,"_28433":125416,"_3077":125567},[],"Registro",{"_3625":74506,"_31241":74442,"_21645":125569,"_5":14907,"_28433":125416,"_3077":125570},[],"ID creado automáticamente y DMS correcto.",{"_3625":74507,"_31241":74442,"_21645":125572,"_5":14907,"_28433":125416,"_3077":124857},[],{"_3625":74508,"_31241":74442,"_21645":125574,"_5":14907,"_28433":125416,"_3077":125575},[],"CN, perfil, serie y clave verificados.",{"_3625":74509,"_31241":74442,"_21645":125577,"_5":14907,"_28433":125416,"_3077":125578},[],"Inventario",{"_3625":74510,"_31241":74442,"_21645":125580,"_5":14907,"_28433":125416,"_3077":125581},[],"Serie recibida visible como identidad actual y en el historial.",{"_3625":74511,"_31241":74442,"_21645":125583,"_5":14907,"_28433":125416,"_3077":125584},[],"Consumidor",{"_3625":74512,"_31241":74442,"_21645":125586,"_5":14907,"_28433":125416,"_3077":125587},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3625":74513,"_31241":74442,"_21645":125589,"_5":14907,"_28433":125416,"_3077":125590},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3625":74514,"_31241":74442,"_21645":125592,"_5":14907,"_28433":125416,"_3077":125593},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3625":74515,"_31241":74515,"_5":15267,"_3077":123069,"_31600":125595,"_21645":125596,"_28433":74515},[51013,121907,53697,125382],[],{"_3625":74516,"_31241":74515,"_21645":125598,"_5":14907,"_28433":74515,"_3077":125599},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3625":74517,"_31241":74515,"_5":31597,"_21645":125601,"_28433":125602,"_3077":120441},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3625":74518,"_31241":74515,"_5":31597,"_21645":125604,"_28433":125605,"_3077":125606},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3625":74519,"_31241":74515,"_5":31597,"_21645":125608,"_28433":125609,"_3077":125610},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3625":74520,"_31241":74515,"_5":31597,"_21645":125612,"_28433":125613,"_3077":125614},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3625":74521,"_31241":74515,"_5":31597,"_21645":125616,"_28433":125617,"_3077":125618},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3625":74522,"_31241":74515,"_5":31597,"_21645":125620,"_28433":125621,"_3077":125622},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3625":74523,"_31241":74515,"_5":31597,"_21645":125624,"_28433":125625,"_3077":125564},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3625":74524,"_31241":74515,"_5":31597,"_21645":125627,"_28433":125628,"_3077":125629},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3625":74525,"_31241":74515,"_5":31597,"_21645":125631,"_28433":125632,"_3077":125633},[],"/docs/pr-preview/pr-78/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3625":74526,"_31241":74515,"_21645":125635,"_5":14907,"_28433":74515,"_3077":125636},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3625":74527,"_31241":74515,"_21645":125638,"_5":14907,"_28433":74515,"_3077":125639},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3625":74528,"_31241":74515,"_21645":125641,"_5":14907,"_28433":125602,"_3077":125642},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3625":74529,"_31241":74515,"_21645":125644,"_5":14907,"_28433":125602,"_3077":125645},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3625":74530,"_31241":74515,"_21645":125647,"_5":14907,"_28433":125602,"_3077":125648},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3625":74531,"_31241":74515,"_21645":125650,"_5":14907,"_28433":125602,"_3077":125651},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3625":74532,"_31241":74515,"_21645":125653,"_5":14907,"_28433":125605,"_3077":125654},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3625":74533,"_31241":74515,"_21645":125656,"_5":14907,"_28433":125605,"_3077":125657},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3625":74534,"_31241":74515,"_21645":125659,"_5":14907,"_28433":125605,"_3077":125660},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3625":74535,"_31241":74515,"_21645":125662,"_5":14907,"_28433":125605,"_3077":125663},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3625":74536,"_31241":74515,"_21645":125665,"_5":14907,"_28433":125605,"_3077":125666},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3625":74537,"_31241":74515,"_21645":125668,"_5":14907,"_28433":125605,"_3077":125669},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3625":74538,"_31241":74515,"_21645":125671,"_5":14907,"_28433":125605,"_3077":125672},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3625":74539,"_31241":74515,"_21645":125674,"_5":14907,"_28433":125605,"_3077":125675},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3625":74540,"_31241":74515,"_21645":125677,"_5":14907,"_28433":125609,"_3077":125678},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3625":74541,"_31241":74515,"_21645":125680,"_5":14907,"_28433":125609,"_3077":56448},[],{"_3625":74542,"_31241":74515,"_21645":125682,"_5":14907,"_28433":125609,"_3077":125683},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3625":74543,"_31241":74515,"_21645":125685,"_5":14907,"_28433":125609,"_3077":125686},[],"**Icon** y **Tags**: clasificación opcional.",{"_3625":74544,"_31241":74515,"_21645":125688,"_5":14907,"_28433":125609,"_3077":125689},[],"Confirma el registro.",{"_3625":74545,"_31241":74515,"_21645":125691,"_5":14907,"_28433":125613,"_3077":125692},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3625":74546,"_31241":74515,"_21645":125694,"_5":14907,"_28433":125613,"_3077":125695},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3625":74547,"_31241":74515,"_21645":125697,"_5":14907,"_28433":125617,"_3077":125698},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3625":74548,"_31241":74515,"_21645":125700,"_5":14907,"_28433":125617,"_3077":125701},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3625":74549,"_31241":74515,"_21645":125703,"_5":14907,"_28433":125621,"_3077":125704},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3625":74550,"_31241":74515,"_21645":125706,"_5":14907,"_28433":125621,"_3077":125707},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3625":74551,"_31241":74515,"_21645":125709,"_5":14907,"_28433":125625,"_3077":125561},[],{"_3625":74552,"_31241":74515,"_21645":125711,"_5":14907,"_28433":125625,"_3077":125712},[],"Resultado",{"_3625":74553,"_31241":74515,"_21645":125714,"_5":14907,"_28433":125625,"_3077":124843},[],{"_3625":74554,"_31241":74515,"_21645":125716,"_5":14907,"_28433":125625,"_3077":125717},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3625":74555,"_31241":74515,"_21645":125719,"_5":14907,"_28433":125625,"_3077":125720},[],"Identidad actual",{"_3625":74556,"_31241":74515,"_21645":125722,"_5":14907,"_28433":125625,"_3077":125723},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3625":74557,"_31241":74515,"_21645":125725,"_5":14907,"_28433":125625,"_3077":125726},[],"Historial",{"_3625":74558,"_31241":74515,"_21645":125728,"_5":14907,"_28433":125625,"_3077":125729},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3625":74559,"_31241":74515,"_21645":125731,"_5":14907,"_28433":125625,"_3077":125732},[],"Clave y certificado",{"_3625":74560,"_31241":74515,"_21645":125734,"_5":14907,"_28433":125625,"_3077":125735},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3625":74561,"_31241":74515,"_21645":125737,"_5":14907,"_28433":125628,"_3077":125738},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3625":74562,"_31241":74515,"_21645":125740,"_5":14907,"_28433":125628,"_3077":125741},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3625":74563,"_31241":74515,"_21645":125743,"_5":14907,"_28433":125628,"_3077":125744},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3625":74564,"_31241":74515,"_21645":125746,"_5":14907,"_28433":125628,"_3077":125747},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3625":74565,"_31241":74515,"_21645":125749,"_5":14907,"_28433":125632,"_3077":125750},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3625":74566,"_31241":74515,"_21645":125752,"_5":14907,"_28433":125632,"_3077":125753},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3625":74567,"_31241":74515,"_21645":125755,"_5":14907,"_28433":125632,"_3077":125756},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3625":74568,"_31241":74568,"_5":15267,"_3077":125758,"_31600":125759,"_21645":125760,"_28433":74568},"Plataforma Lamassu IoT",[51013,121907],[],{"_3625":74569,"_31241":74568,"_21645":125762,"_5":14907,"_28433":74568,"_3077":125763},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3625":74570,"_31241":74568,"_5":31597,"_21645":125765,"_28433":125766,"_3077":125258},[],"/docs/pr-preview/pr-78/es/platform/overview#empieza-aquí",{"_3625":74571,"_31241":74568,"_5":31597,"_21645":125768,"_28433":125769,"_3077":125770},[],"/docs/pr-preview/pr-78/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3625":74572,"_31241":74568,"_5":31597,"_21645":125772,"_28433":125773,"_3077":125774},[],"/docs/pr-preview/pr-78/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3625":74573,"_31241":74568,"_5":31597,"_21645":125776,"_28433":125777,"_3077":125778},[],"/docs/pr-preview/pr-78/es/platform/overview#capacidades-principales","Capacidades principales",{"_3625":74574,"_31241":74568,"_5":31597,"_21645":125780,"_28433":125781,"_3077":125782},[],"/docs/pr-preview/pr-78/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3625":74575,"_31241":74568,"_5":31597,"_21645":125784,"_28433":125785,"_3077":125786},[],"/docs/pr-preview/pr-78/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3625":74576,"_31241":74568,"_5":31597,"_21645":125788,"_28433":125789,"_3077":125790},[],"/docs/pr-preview/pr-78/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3625":74577,"_31241":74568,"_5":31597,"_21645":125792,"_28433":125793,"_3077":125794},[],"/docs/pr-preview/pr-78/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3625":74578,"_31241":74568,"_5":31597,"_21645":125796,"_28433":125797,"_3077":125798},[],"/docs/pr-preview/pr-78/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3625":74579,"_31241":74568,"_5":31597,"_21645":125800,"_28433":125801,"_3077":125802},[],"/docs/pr-preview/pr-78/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3625":74580,"_31241":74568,"_5":31597,"_21645":125804,"_28433":125805,"_3077":125806},[],"/docs/pr-preview/pr-78/es/platform/overview#referencia-operativa","Referencia operativa",{"_3625":74581,"_31241":74568,"_21645":125808,"_5":14907,"_28433":74568,"_3077":125809},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3625":74582,"_31241":74568,"_21645":125811,"_5":14907,"_28433":125766,"_3077":125812},[],"Elige el resultado que necesitas obtener:",{"_3625":74583,"_31241":74568,"_21645":125814,"_5":14907,"_28433":125766,"_3077":125815},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3625":74584,"_31241":74568,"_21645":125817,"_5":14907,"_28433":125766,"_3077":125818},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3625":74585,"_31241":74568,"_21645":125820,"_5":14907,"_28433":125766,"_3077":125821},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3625":74586,"_31241":74568,"_21645":125823,"_5":14907,"_28433":125769,"_3077":125824},[],"Bloque",{"_3625":74587,"_31241":74568,"_21645":125826,"_5":14907,"_28433":125769,"_3077":125827},[],"Qué gestionas",{"_3625":74588,"_31241":74568,"_21645":125829,"_5":14907,"_28433":125769,"_3077":125830},[],"Punto de entrada",{"_3625":74589,"_31241":74568,"_21645":125832,"_5":14907,"_28433":125769,"_3077":56601},[],{"_3625":74590,"_31241":74568,"_21645":125834,"_5":14907,"_28433":125769,"_3077":125835},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3625":74591,"_31241":74568,"_21645":125837,"_5":14907,"_28433":125769,"_3077":125838},[],"Visión general de PKI",{"_3625":74592,"_31241":74568,"_21645":125840,"_5":14907,"_28433":125769,"_3077":56610},[],{"_3625":74593,"_31241":74568,"_21645":125842,"_5":14907,"_28433":125769,"_3077":125843},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3625":74594,"_31241":74568,"_21645":125845,"_5":14907,"_28433":125769,"_3077":125846},[],"Visión general de IoT Fleets",{"_3625":74595,"_31241":74568,"_21645":125848,"_5":14907,"_28433":125769,"_3077":125849},[],"**Administración**",{"_3625":74596,"_31241":74568,"_21645":125851,"_5":14907,"_28433":125769,"_3077":125852},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3625":74597,"_31241":74568,"_21645":125854,"_5":14907,"_28433":125769,"_3077":121909},[],{"_3625":74598,"_31241":74568,"_21645":125856,"_5":14907,"_28433":125769,"_3077":125857},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3625":74599,"_31241":74568,"_21645":125859,"_5":14907,"_28433":125773,"_3077":125860},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3625":74600,"_31241":74568,"_21645":125862,"_5":14907,"_28433":125773,"_3077":125863},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3625":74601,"_31241":74568,"_21645":125865,"_5":14907,"_28433":125773,"_3077":125866},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3625":74602,"_31241":74568,"_21645":125868,"_5":14907,"_28433":125773,"_3077":125869},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3625":74603,"_31241":74568,"_21645":125871,"_5":14907,"_28433":125773,"_3077":125872},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3625":74604,"_31241":74568,"_21645":125874,"_5":14907,"_28433":125773,"_3077":125875},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3625":74605,"_31241":74568,"_21645":125877,"_5":14907,"_28433":125781,"_3077":125878},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3625":74606,"_31241":74568,"_21645":125880,"_5":14907,"_28433":125785,"_3077":125881},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3625":74607,"_31241":74568,"_21645":125883,"_5":14907,"_28433":125789,"_3077":125884},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3625":74608,"_31241":74568,"_21645":125886,"_5":14907,"_28433":125793,"_3077":125887},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3625":74609,"_31241":74568,"_21645":125889,"_5":14907,"_28433":125797,"_3077":125890},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3625":74610,"_31241":74568,"_21645":125892,"_5":14907,"_28433":125801,"_3077":125893},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3625":74611,"_31241":74568,"_21645":125895,"_5":14907,"_28433":125805,"_3077":125351},[],{"_3625":74612,"_31241":74568,"_21645":125897,"_5":14907,"_28433":125805,"_3077":125898},[],"Qué prepara o comprueba",{"_3625":74613,"_31241":74568,"_21645":125900,"_5":14907,"_28433":125805,"_3077":125354},[],{"_3625":74614,"_31241":74568,"_21645":125902,"_5":14907,"_28433":125805,"_3077":125903},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3625":74615,"_31241":74568,"_21645":125905,"_5":14907,"_28433":125805,"_3077":125906},[],"Administrador de la flota",{"_3625":74616,"_31241":74568,"_21645":125908,"_5":14907,"_28433":125805,"_3077":125909},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3625":74617,"_31241":74568,"_21645":125911,"_5":14907,"_28433":125805,"_3077":125366},[],{"_3625":74618,"_31241":74568,"_21645":125913,"_5":14907,"_28433":125805,"_3077":125914},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3625":74619,"_31241":74568,"_21645":125916,"_5":14907,"_28433":125805,"_3077":125372},[],{"_3625":74620,"_31241":74568,"_21645":125918,"_5":14907,"_28433":125805,"_3077":125919},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3625":74621,"_31241":74568,"_21645":125921,"_5":14907,"_28433":125805,"_3077":125922},[],"Operador de infraestructura",{"_3625":74622,"_31241":74568,"_21645":125924,"_5":14907,"_28433":125805,"_3077":125925},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3625":74623,"_31241":74568,"_21645":125927,"_5":14907,"_28433":125805,"_3077":125928},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3625":74624,"_31241":74624,"_5":15267,"_3077":125930,"_31600":125931,"_21645":125933,"_28433":74624},"Jerarquía y rotación de CAs",[51013,121907,56702,125932],"Claves, autoridades y certificados",[],{"_3625":74625,"_31241":74624,"_21645":125935,"_5":14907,"_28433":74624,"_3077":125936},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3625":74626,"_31241":74624,"_5":31597,"_21645":125938,"_28433":125939,"_3077":125940},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3625":74627,"_31241":74624,"_5":31597,"_21645":125942,"_28433":125943,"_3077":125944},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3625":74628,"_31241":74624,"_5":31597,"_21645":125946,"_28433":125947,"_3077":125948},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3625":74629,"_31241":74624,"_5":31597,"_21645":125950,"_28433":125951,"_3077":125952},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3625":74630,"_31241":74624,"_5":31597,"_21645":125954,"_28433":125955,"_3077":125956},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3625":74631,"_31241":74624,"_5":31597,"_21645":125958,"_28433":125959,"_3077":125960},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3625":74632,"_31241":74624,"_5":31597,"_21645":125962,"_28433":125963,"_3077":125964},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3625":74633,"_31241":74624,"_5":31597,"_21645":125966,"_28433":125967,"_3077":125968},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3625":74634,"_31241":74624,"_5":31597,"_21645":125970,"_28433":125971,"_3077":125972},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3625":74635,"_31241":74624,"_5":31597,"_21645":125974,"_28433":125975,"_3077":125976},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3625":74636,"_31241":74624,"_5":31597,"_21645":125978,"_28433":125979,"_3077":125980},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3625":74637,"_31241":74624,"_5":31597,"_21645":125982,"_28433":125983,"_3077":125984},[],"/docs/pr-preview/pr-78/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3625":74638,"_31241":74624,"_21645":125986,"_5":14907,"_28433":74624,"_3077":125987},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3625":74639,"_31241":74624,"_21645":125989,"_5":14907,"_28433":74624,"_3077":125990},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3625":74640,"_31241":74624,"_21645":125992,"_5":14907,"_28433":125939,"_3077":125993},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3625":74641,"_31241":74624,"_21645":125995,"_5":14907,"_28433":125939,"_3077":125996},[],"entorno, como producción y preproducción;",{"_3625":74642,"_31241":74624,"_21645":125998,"_5":14907,"_28433":125939,"_3077":125999},[],"propietario o equipo operador;",{"_3625":74643,"_31241":74624,"_21645":126001,"_5":14907,"_28433":125939,"_3077":126002},[],"familia de dispositivos o proceso de fabricación;",{"_3625":74644,"_31241":74624,"_21645":126004,"_5":14907,"_28433":125939,"_3077":126005},[],"región o requisito regulatorio;",{"_3625":74645,"_31241":74624,"_21645":126007,"_5":14907,"_28433":125939,"_3077":126008},[],"motor criptográfico o política de clave;",{"_3625":74646,"_31241":74624,"_21645":126010,"_5":14907,"_28433":125939,"_3077":126011},[],"ventana de mantenimiento y ritmo de renovación.",{"_3625":74647,"_31241":74624,"_21645":126013,"_5":14907,"_28433":125939,"_3077":126014},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3625":74648,"_31241":74624,"_21645":126016,"_5":14907,"_28433":125939,"_3077":126017},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3625":74649,"_31241":74624,"_21645":126019,"_5":14907,"_28433":125943,"_3077":126020},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3625":74650,"_31241":74624,"_21645":126022,"_5":14907,"_28433":125943,"_3077":126023},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3625":74651,"_31241":74624,"_21645":126025,"_5":14907,"_28433":125943,"_3077":126026},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3625":74652,"_31241":74624,"_21645":126028,"_5":14907,"_28433":125943,"_3077":126029},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3625":74653,"_31241":74624,"_21645":126031,"_5":14907,"_28433":125947,"_3077":126032},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3625":74654,"_31241":74624,"_21645":126034,"_5":14907,"_28433":125947,"_3077":126035},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3625":74655,"_31241":74624,"_21645":126037,"_5":14907,"_28433":125947,"_3077":126038},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3625":74656,"_31241":74624,"_21645":126040,"_5":14907,"_28433":125947,"_3077":126041},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3625":74657,"_31241":74624,"_21645":126043,"_5":14907,"_28433":125955,"_3077":126044},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3625":74658,"_31241":74624,"_21645":126046,"_5":14907,"_28433":125959,"_3077":126047},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3625":74659,"_31241":74624,"_21645":126049,"_5":14907,"_28433":125963,"_3077":126050},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3625":74660,"_31241":74624,"_21645":126052,"_5":14907,"_28433":125967,"_3077":126053},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3625":74661,"_31241":74624,"_21645":126055,"_5":14907,"_28433":125971,"_3077":126056},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3625":74662,"_31241":74624,"_21645":126058,"_5":14907,"_28433":125975,"_3077":126059},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3625":74663,"_31241":74624,"_21645":126061,"_5":14907,"_28433":125979,"_3077":126062},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3625":74664,"_31241":74624,"_21645":126064,"_5":14907,"_28433":125979,"_3077":126065},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3625":74665,"_31241":74624,"_21645":126067,"_5":14907,"_28433":125979,"_3077":126068},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3625":74666,"_31241":74624,"_21645":126070,"_5":14907,"_28433":125979,"_3077":126071},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3625":74667,"_31241":74624,"_21645":126073,"_5":14907,"_28433":125983,"_3077":126074},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3625":74668,"_31241":74624,"_21645":126076,"_5":14907,"_28433":125983,"_3077":126077},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3625":74669,"_31241":74624,"_21645":126079,"_5":14907,"_28433":125983,"_3077":126080},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3625":74670,"_31241":74624,"_21645":126082,"_5":14907,"_28433":125983,"_3077":126083},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3625":74671,"_31241":74624,"_21645":126085,"_5":14907,"_28433":125983,"_3077":126086},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3625":74672,"_31241":74624,"_21645":126088,"_5":14907,"_28433":125983,"_3077":126089},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3625":74673,"_31241":74624,"_21645":126091,"_5":14907,"_28433":125983,"_3077":126092},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3625":74674,"_31241":74674,"_5":15267,"_3077":126094,"_31600":126095,"_21645":126096,"_28433":74674},"Autoridades de certificación",[51013,121907,56702,125932],[],{"_3625":74675,"_31241":74674,"_21645":126098,"_5":14907,"_28433":74674,"_3077":126099},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3625":74676,"_31241":74674,"_5":31597,"_21645":126101,"_28433":126102,"_3077":126103},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3625":74677,"_31241":74674,"_5":31597,"_21645":126105,"_28433":126106,"_3077":126107},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3625":74678,"_31241":74674,"_5":31597,"_21645":126109,"_28433":126110,"_3077":120441},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3625":74679,"_31241":74674,"_5":31597,"_21645":126112,"_28433":126113,"_3077":126114},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3625":74680,"_31241":74674,"_5":31597,"_21645":126116,"_28433":126117,"_3077":126118},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3625":74681,"_31241":74674,"_5":31597,"_21645":126120,"_28433":126121,"_3077":126122},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3625":74682,"_31241":74674,"_5":31597,"_21645":126124,"_28433":126125,"_3077":126126},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3625":74683,"_31241":74674,"_5":31597,"_21645":126128,"_28433":126129,"_3077":126130},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3625":74684,"_31241":74674,"_5":31597,"_21645":126132,"_28433":126133,"_3077":126134},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3625":74685,"_31241":74674,"_5":31597,"_21645":126136,"_28433":126137,"_3077":126138},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3625":74686,"_31241":74674,"_5":31597,"_21645":126140,"_28433":126141,"_3077":126142},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3625":74687,"_31241":74674,"_5":31597,"_21645":126144,"_28433":126145,"_3077":126146},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3625":74688,"_31241":74674,"_5":31597,"_21645":126148,"_28433":126149,"_3077":126150},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3625":74689,"_31241":74674,"_5":31597,"_21645":126152,"_28433":126153,"_3077":126154},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3625":74690,"_31241":74674,"_5":31597,"_21645":126156,"_28433":126157,"_3077":126158},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3625":74691,"_31241":74674,"_5":31597,"_21645":126160,"_28433":126161,"_3077":126162},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3625":74692,"_31241":74674,"_5":31597,"_21645":126164,"_28433":126165,"_3077":126166},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3625":74693,"_31241":74674,"_5":31597,"_21645":126168,"_28433":126169,"_3077":126170},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3625":74694,"_31241":74674,"_5":31597,"_21645":126172,"_28433":126173,"_3077":126174},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3625":74695,"_31241":74674,"_5":31597,"_21645":126176,"_28433":126177,"_3077":126178},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3625":74696,"_31241":74674,"_5":31597,"_21645":126180,"_28433":126181,"_3077":126182},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3625":74697,"_31241":74674,"_5":31597,"_21645":126184,"_28433":126185,"_3077":126186},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3625":74698,"_31241":74674,"_5":31597,"_21645":126188,"_28433":126189,"_3077":126190},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3625":74699,"_31241":74674,"_21645":126192,"_5":14907,"_28433":74674,"_3077":126193},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3625":74700,"_31241":74674,"_21645":126195,"_5":14907,"_28433":74674,"_3077":126196},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3625":74701,"_31241":74674,"_21645":126198,"_5":14907,"_28433":74674,"_3077":126199},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3625":74702,"_31241":74674,"_21645":126201,"_5":14907,"_28433":126102,"_3077":126202},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3625":74703,"_31241":74674,"_21645":126204,"_5":14907,"_28433":126102,"_3077":126205},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3625":74704,"_31241":74674,"_21645":126207,"_5":14907,"_28433":126102,"_3077":126208},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3625":74705,"_31241":74674,"_21645":126210,"_5":14907,"_28433":126102,"_3077":126211},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3625":74706,"_31241":74674,"_21645":126213,"_5":14907,"_28433":126102,"_3077":126214},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3625":74707,"_31241":74674,"_21645":126216,"_5":14907,"_28433":126110,"_3077":126217},[],"Decide si la CA será raíz o intermedia.",{"_3625":74708,"_31241":74674,"_21645":126219,"_5":14907,"_28433":126110,"_3077":126220},[],"Elige el motor que custodiará la clave.",{"_3625":74709,"_31241":74674,"_21645":126222,"_5":14907,"_28433":126110,"_3077":126223},[],"Define una validez superior a la de los certificados que emitirá.",{"_3625":74710,"_31241":74674,"_21645":126225,"_5":14907,"_28433":126110,"_3077":126226},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3625":74711,"_31241":74674,"_21645":126228,"_5":14907,"_28433":126113,"_3077":126229},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3625":74712,"_31241":74674,"_21645":126231,"_5":14907,"_28433":126117,"_3077":126232},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3625":74713,"_31241":74674,"_21645":126234,"_5":14907,"_28433":126117,"_3077":126235},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3625":74714,"_31241":74674,"_21645":126237,"_5":14907,"_28433":126121,"_3077":126238},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3625":74715,"_31241":74674,"_21645":126240,"_5":14907,"_28433":126125,"_3077":126241},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3625":74716,"_31241":74674,"_21645":126243,"_5":14907,"_28433":126125,"_3077":126244},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3625":74717,"_31241":74674,"_21645":126246,"_5":14907,"_28433":126125,"_3077":126247},[],"`ST`: estado o provincia.",{"_3625":74718,"_31241":74674,"_21645":126249,"_5":14907,"_28433":126125,"_3077":126250},[],"`L`: localidad.",{"_3625":74719,"_31241":74674,"_21645":126252,"_5":14907,"_28433":126125,"_3077":126253},[],"`O`: organización.",{"_3625":74720,"_31241":74674,"_21645":126255,"_5":14907,"_28433":126125,"_3077":126256},[],"`OU`: unidad organizativa.",{"_3625":74721,"_31241":74674,"_21645":126258,"_5":14907,"_28433":126125,"_3077":126259},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3625":74722,"_31241":74674,"_21645":126261,"_5":14907,"_28433":126129,"_3077":126262},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3625":74723,"_31241":74674,"_21645":126264,"_5":14907,"_28433":126129,"_3077":126265},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3625":74724,"_31241":74674,"_21645":126267,"_5":14907,"_28433":126133,"_3077":126268},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3625":74725,"_31241":74674,"_21645":126270,"_5":14907,"_28433":126133,"_3077":126271},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3625":74726,"_31241":74674,"_21645":126273,"_5":14907,"_28433":126137,"_3077":126274},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3625":74727,"_31241":74674,"_21645":126276,"_5":14907,"_28433":126137,"_3077":126277},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3625":74728,"_31241":74674,"_21645":126279,"_5":14907,"_28433":126141,"_3077":126280},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3625":74729,"_31241":74674,"_21645":126282,"_5":14907,"_28433":126141,"_3077":126283},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3625":74730,"_31241":74674,"_21645":126285,"_5":14907,"_28433":126141,"_3077":126286},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3625":74731,"_31241":74674,"_21645":126288,"_5":14907,"_28433":126145,"_3077":126289},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3625":74732,"_31241":74674,"_21645":126291,"_5":14907,"_28433":126149,"_3077":126292},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3625":74733,"_31241":74674,"_21645":126294,"_5":14907,"_28433":126149,"_3077":126295},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3625":74734,"_31241":74674,"_21645":126297,"_5":14907,"_28433":126153,"_3077":126298},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3625":74735,"_31241":74674,"_21645":126300,"_5":14907,"_28433":126157,"_3077":126301},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3625":74736,"_31241":74674,"_21645":126303,"_5":14907,"_28433":126157,"_3077":126304},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3625":74737,"_31241":74674,"_21645":126306,"_5":14907,"_28433":126157,"_3077":126307},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3625":74738,"_31241":74674,"_21645":126309,"_5":14907,"_28433":126161,"_3077":126310},[],"Abre una CA desde el inventario para consultar:",{"_3625":74739,"_31241":74674,"_21645":126312,"_5":14907,"_28433":126161,"_3077":126313},[],"Estado y periodo de validez.",{"_3625":74740,"_31241":74674,"_21645":126315,"_5":14907,"_28433":126161,"_3077":126316},[],"Certificado y cadena en formato PEM.",{"_3625":74741,"_31241":74674,"_21645":126318,"_5":14907,"_28433":126161,"_3077":126319},[],"Número de certificados activos, expirados y revocados.",{"_3625":74742,"_31241":74674,"_21645":126321,"_5":14907,"_28433":126161,"_3077":126322},[],"Certificados emitidos en **Issued Certificates**.",{"_3625":74743,"_31241":74674,"_21645":126324,"_5":14907,"_28433":126161,"_3077":126325},[],"CRL vinculada a la autoridad.",{"_3625":74744,"_31241":74674,"_21645":126327,"_5":14907,"_28433":126161,"_3077":126328},[],"Metadatos y motor criptográfico asociado.",{"_3625":74745,"_31241":74674,"_21645":126330,"_5":14907,"_28433":126161,"_3077":126331},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3625":74746,"_31241":74674,"_21645":126333,"_5":14907,"_28433":126165,"_3077":126334},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3625":74747,"_31241":74674,"_21645":126336,"_5":14907,"_28433":126165,"_3077":126337},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3625":74748,"_31241":74674,"_21645":126339,"_5":14907,"_28433":126165,"_3077":126340},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3625":74749,"_31241":74674,"_21645":126342,"_5":14907,"_28433":126165,"_3077":126343},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3625":74750,"_31241":74674,"_21645":126345,"_5":14907,"_28433":126165,"_3077":126346},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3625":74751,"_31241":74674,"_21645":126348,"_5":14907,"_28433":126165,"_3077":126349},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3625":74752,"_31241":74674,"_21645":126351,"_5":14907,"_28433":126169,"_3077":126352},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3625":74753,"_31241":74674,"_21645":126354,"_5":14907,"_28433":126173,"_3077":126355},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3625":74754,"_31241":74674,"_21645":126357,"_5":14907,"_28433":126177,"_3077":126358},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3625":74755,"_31241":74674,"_21645":126360,"_5":14907,"_28433":126181,"_3077":126361},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3625":74756,"_31241":74674,"_21645":126363,"_5":14907,"_28433":126185,"_3077":126364},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3625":74757,"_31241":74674,"_21645":126366,"_5":14907,"_28433":126189,"_3077":126367},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3625":74758,"_31241":74674,"_21645":126369,"_5":14907,"_28433":126189,"_3077":126370},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3625":74759,"_31241":74674,"_21645":126372,"_5":14907,"_28433":126189,"_3077":126373},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3625":74760,"_31241":74674,"_21645":126375,"_5":14907,"_28433":126189,"_3077":126376},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3625":74761,"_31241":74761,"_5":15267,"_3077":126378,"_31600":126379,"_21645":126380,"_28433":74761},"Perfiles de certificado",[51013,121907,56702,125932],[],{"_3625":74762,"_31241":74761,"_21645":126382,"_5":14907,"_28433":74761,"_3077":126383},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3625":74763,"_31241":74761,"_5":31597,"_21645":126385,"_28433":126386,"_3077":126387},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3625":74764,"_31241":74761,"_5":31597,"_21645":126389,"_28433":126390,"_3077":126391},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#validez","Validez",{"_3625":74765,"_31241":74761,"_5":31597,"_21645":126393,"_28433":126394,"_3077":126395},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3625":74766,"_31241":74761,"_5":31597,"_21645":126397,"_28433":126398,"_3077":126399},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3625":74767,"_31241":74761,"_5":31597,"_21645":126401,"_28433":126402,"_3077":126403},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3625":74768,"_31241":74761,"_5":31597,"_21645":126405,"_28433":126406,"_3077":126407},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3625":74769,"_31241":74761,"_5":31597,"_21645":126409,"_28433":126410,"_3077":126411},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3625":74770,"_31241":74761,"_5":31597,"_21645":126413,"_28433":126414,"_3077":126415},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3625":74771,"_31241":74761,"_5":31597,"_21645":126417,"_28433":126418,"_3077":126419},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3625":74772,"_31241":74761,"_5":31597,"_21645":126421,"_28433":126422,"_3077":126423},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3625":74773,"_31241":74761,"_5":31597,"_21645":126425,"_28433":126426,"_3077":126427},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3625":74774,"_31241":74761,"_5":31597,"_21645":126429,"_28433":126430,"_3077":126431},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3625":74775,"_31241":74761,"_5":31597,"_21645":126433,"_28433":126434,"_3077":126435},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3625":74776,"_31241":74761,"_5":31597,"_21645":126437,"_28433":126438,"_3077":126439},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3625":74777,"_31241":74761,"_5":31597,"_21645":126441,"_28433":126442,"_3077":126443},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3625":74778,"_31241":74761,"_5":31597,"_21645":126445,"_28433":126446,"_3077":126447},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3625":74779,"_31241":74761,"_21645":126449,"_5":14907,"_28433":74761,"_3077":126450},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3625":74780,"_31241":74761,"_21645":126452,"_5":14907,"_28433":74761,"_3077":126453},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3625":74781,"_31241":74761,"_21645":126455,"_5":14907,"_28433":126390,"_3077":126456},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3625":74782,"_31241":74761,"_21645":126458,"_5":14907,"_28433":126390,"_3077":126459},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3625":74783,"_31241":74761,"_21645":126461,"_5":14907,"_28433":126394,"_3077":126462},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3625":74784,"_31241":74761,"_21645":126464,"_5":14907,"_28433":126398,"_3077":126465},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3625":74785,"_31241":74761,"_21645":126467,"_5":14907,"_28433":126398,"_3077":126468},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3625":74786,"_31241":74761,"_21645":126470,"_5":14907,"_28433":126398,"_3077":126471},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3625":74787,"_31241":74761,"_21645":126473,"_5":14907,"_28433":126402,"_3077":126474},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3625":74788,"_31241":74761,"_21645":126476,"_5":14907,"_28433":126406,"_3077":126477},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3625":74789,"_31241":74761,"_21645":126479,"_5":14907,"_28433":126406,"_3077":126480},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3625":74790,"_31241":74761,"_21645":126482,"_5":14907,"_28433":126410,"_3077":126483},[],"La aplicación criptográfica puede:",{"_3625":74791,"_31241":74761,"_21645":126485,"_5":14907,"_28433":126410,"_3077":126486},[],"permitir o bloquear claves RSA;",{"_3625":74792,"_31241":74761,"_21645":126488,"_5":14907,"_28433":126410,"_3077":126489},[],"limitar los tamaños RSA admitidos;",{"_3625":74793,"_31241":74761,"_21645":126491,"_5":14907,"_28433":126410,"_3077":126492},[],"permitir o bloquear claves ECDSA;",{"_3625":74794,"_31241":74761,"_21645":126494,"_5":14907,"_28433":126410,"_3077":126495},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3625":74795,"_31241":74761,"_21645":126497,"_5":14907,"_28433":126410,"_3077":126498},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3625":74796,"_31241":74761,"_21645":126500,"_5":14907,"_28433":126414,"_3077":126501},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3625":74797,"_31241":74761,"_21645":126503,"_5":14907,"_28433":126414,"_3077":121667},[],{"_3625":74798,"_31241":74761,"_21645":126505,"_5":14907,"_28433":126414,"_3077":126506},[],"Primera opción",{"_3625":74799,"_31241":74761,"_21645":126508,"_5":14907,"_28433":126414,"_3077":126509},[],"Segunda opción",{"_3625":74800,"_31241":74761,"_21645":126511,"_5":14907,"_28433":126414,"_3077":126512},[],"Si no hay ninguna",{"_3625":74801,"_31241":74761,"_21645":126514,"_5":14907,"_28433":126414,"_3077":126515},[],"Firma directa con una CA",{"_3625":74802,"_31241":74761,"_21645":126517,"_5":14907,"_28433":126414,"_3077":126518},[],"`issuance_profile` incluido en la solicitud",{"_3625":74803,"_31241":74761,"_21645":126520,"_5":14907,"_28433":126414,"_3077":126521},[],"`issuance_profile_id` de la solicitud",{"_3625":74804,"_31241":74761,"_21645":126523,"_5":14907,"_28433":126414,"_3077":126524},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3625":74805,"_31241":74761,"_21645":126526,"_5":14907,"_28433":126414,"_3077":126527},[],"Emisión mediante DMS",{"_3625":74806,"_31241":74761,"_21645":126529,"_5":14907,"_28433":126414,"_3077":57301},[],{"_3625":74807,"_31241":74761,"_21645":126531,"_5":14907,"_28433":126414,"_3077":126532},[],"`settings.issuance_profile` incluido en el DMS",{"_3625":74808,"_31241":74761,"_21645":126534,"_5":14907,"_28433":126414,"_3077":126535},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3625":74809,"_31241":74761,"_21645":126537,"_5":14907,"_28433":126414,"_3077":126538},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3625":74810,"_31241":74761,"_21645":126540,"_5":14907,"_28433":126414,"_3077":126541},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3625":74811,"_31241":74761,"_21645":126543,"_5":14907,"_28433":126422,"_3077":126544},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3625":74812,"_31241":74761,"_21645":126546,"_5":14907,"_28433":126426,"_3077":126547},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3625":74813,"_31241":74761,"_21645":126549,"_5":14907,"_28433":126430,"_3077":126550},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3625":74814,"_31241":74761,"_21645":126552,"_5":14907,"_28433":126434,"_3077":126553},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3625":74815,"_31241":74761,"_21645":126555,"_5":14907,"_28433":126438,"_3077":126556},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3625":74816,"_31241":74761,"_21645":126558,"_5":14907,"_28433":126438,"_3077":126559},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3625":74817,"_31241":74761,"_21645":126561,"_5":14907,"_28433":126442,"_3077":126562},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3625":74818,"_31241":74761,"_21645":126564,"_5":14907,"_28433":126442,"_3077":126565},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3625":74819,"_31241":74761,"_21645":126567,"_5":14907,"_28433":126442,"_3077":126568},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3625":74820,"_31241":74761,"_21645":126570,"_5":14907,"_28433":126442,"_3077":126571},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3625":74821,"_31241":74761,"_21645":126573,"_5":14907,"_28433":126446,"_3077":126574},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3625":74822,"_31241":74761,"_21645":126576,"_5":14907,"_28433":126446,"_3077":126577},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3625":74823,"_31241":74823,"_5":15267,"_3077":126579,"_31600":126580,"_21645":126582,"_28433":74823},"Validación de certificados",[51013,121907,56702,126581],"Validación",[],{"_3625":74824,"_31241":74823,"_21645":126584,"_5":14907,"_28433":74823,"_3077":126585},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3625":74825,"_31241":74823,"_5":31597,"_21645":126587,"_28433":126588,"_3077":126589},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3625":74826,"_31241":74823,"_5":31597,"_21645":126591,"_28433":126592,"_3077":126593},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3625":74827,"_31241":74823,"_5":31597,"_21645":126595,"_28433":126596,"_3077":126597},[],"/docs/pr-preview/pr-78/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3625":74828,"_31241":74823,"_21645":126599,"_5":14907,"_28433":74823,"_3077":126600},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3625":74829,"_31241":74823,"_21645":126602,"_5":14907,"_28433":126588,"_3077":126603},[],"Verifica estos criterios juntos:",{"_3625":74830,"_31241":74823,"_21645":126605,"_5":14907,"_28433":126588,"_3077":125561},[],{"_3625":74831,"_31241":74823,"_21645":126607,"_5":14907,"_28433":126588,"_3077":126608},[],"Resultado necesario",{"_3625":74832,"_31241":74823,"_21645":126610,"_5":14907,"_28433":126588,"_3077":126611},[],"Cadena y firma",{"_3625":74833,"_31241":74823,"_21645":126613,"_5":14907,"_28433":126588,"_3077":126614},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3625":74834,"_31241":74823,"_21645":126616,"_5":14907,"_28433":126588,"_3077":126617},[],"Fechas",{"_3625":74835,"_31241":74823,"_21645":126619,"_5":14907,"_28433":126588,"_3077":126620},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3625":74836,"_31241":74823,"_21645":126622,"_5":14907,"_28433":126588,"_3077":121577},[],{"_3625":74837,"_31241":74823,"_21645":126624,"_5":14907,"_28433":126588,"_3077":126625},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3625":74838,"_31241":74823,"_21645":126627,"_5":14907,"_28433":126588,"_3077":126628},[],"Uso",{"_3625":74839,"_31241":74823,"_21645":126630,"_5":14907,"_28433":126588,"_3077":126631},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3625":74840,"_31241":74823,"_21645":126633,"_5":14907,"_28433":126588,"_3077":126634},[],"Revocación",{"_3625":74841,"_31241":74823,"_21645":126636,"_5":14907,"_28433":126588,"_3077":126637},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3625":74842,"_31241":74823,"_21645":126639,"_5":14907,"_28433":126588,"_3077":126640},[],"Autorización",{"_3625":74843,"_31241":74823,"_21645":126642,"_5":14907,"_28433":126588,"_3077":126643},[],"La aplicación permite la acción a esa identidad.",{"_3625":74844,"_31241":74823,"_21645":126645,"_5":14907,"_28433":126588,"_3077":126646},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3625":74845,"_31241":74823,"_21645":126648,"_5":14907,"_28433":126592,"_3077":126649},[],"Mecanismo",{"_3625":74846,"_31241":74823,"_21645":126651,"_5":14907,"_28433":126592,"_3077":126652},[],"Cuándo utilizarlo",{"_3625":74847,"_31241":74823,"_21645":126654,"_5":14907,"_28433":126592,"_3077":126655},[],"Qué debes mantener",{"_3625":74848,"_31241":74823,"_21645":126657,"_5":14907,"_28433":126592,"_3077":57429},[],{"_3625":74849,"_31241":74823,"_21645":126659,"_5":14907,"_28433":126592,"_3077":126660},[],"Consulta del estado de un certificado concreto.",{"_3625":74850,"_31241":74823,"_21645":126662,"_5":14907,"_28433":126592,"_3077":126663},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3625":74851,"_31241":74823,"_21645":126665,"_5":14907,"_28433":126592,"_3077":57438},[],{"_3625":74852,"_31241":74823,"_21645":126667,"_5":14907,"_28433":126592,"_3077":126668},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3625":74853,"_31241":74823,"_21645":126670,"_5":14907,"_28433":126592,"_3077":126671},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3625":74854,"_31241":74823,"_21645":126673,"_5":14907,"_28433":126592,"_3077":126674},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3625":74855,"_31241":74823,"_21645":126676,"_5":14907,"_28433":126592,"_3077":126677},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3625":74856,"_31241":74823,"_21645":126679,"_5":14907,"_28433":126596,"_3077":126680},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3625":74857,"_31241":74823,"_21645":126682,"_5":14907,"_28433":126596,"_3077":126683},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3625":74858,"_31241":74823,"_21645":126685,"_5":14907,"_28433":126596,"_3077":126686},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3625":74859,"_31241":74823,"_21645":126688,"_5":14907,"_28433":126596,"_3077":126689},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3625":74860,"_31241":74823,"_21645":126691,"_5":14907,"_28433":126596,"_3077":126692},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3625":74861,"_31241":74823,"_21645":126694,"_5":14907,"_28433":126596,"_3077":126695},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3625":74862,"_31241":74823,"_21645":126697,"_5":14907,"_28433":126596,"_3077":126698},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3625":74863,"_31241":74823,"_21645":126700,"_5":14907,"_28433":126596,"_3077":126701},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3625":74864,"_31241":74823,"_21645":126703,"_5":14907,"_28433":126596,"_3077":126704},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3625":74865,"_31241":74865,"_5":15267,"_3077":126706,"_31600":126707,"_21645":126708,"_28433":74865},"Certificados",[51013,121907,56702,125932],[],{"_3625":74866,"_31241":74865,"_21645":126710,"_5":14907,"_28433":74865,"_3077":126711},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3625":74867,"_31241":74865,"_5":31597,"_21645":126713,"_28433":126714,"_3077":126715},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3625":74868,"_31241":74865,"_5":31597,"_21645":126717,"_28433":126718,"_3077":126719},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3625":74869,"_31241":74865,"_5":31597,"_21645":126721,"_28433":126722,"_3077":126723},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3625":74870,"_31241":74865,"_5":31597,"_21645":126725,"_28433":126726,"_3077":126727},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3625":74871,"_31241":74865,"_5":31597,"_21645":126729,"_28433":126730,"_3077":126731},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3625":74872,"_31241":74865,"_5":31597,"_21645":126733,"_28433":126734,"_3077":126735},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3625":74873,"_31241":74865,"_5":31597,"_21645":126737,"_28433":126738,"_3077":126739},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3625":74874,"_31241":74865,"_5":31597,"_21645":126741,"_28433":126742,"_3077":126743},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3625":74875,"_31241":74865,"_5":31597,"_21645":126745,"_28433":126746,"_3077":126747},[],"/docs/pr-preview/pr-78/es/platform/pki/certificates#continúa","Continúa",{"_3625":74876,"_31241":74865,"_21645":126749,"_5":14907,"_28433":74865,"_3077":126750},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3625":74877,"_31241":74865,"_21645":126752,"_5":14907,"_28433":126714,"_3077":126753},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3625":74878,"_31241":74865,"_21645":126755,"_5":14907,"_28433":126714,"_3077":126756},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3625":74879,"_31241":74865,"_21645":126758,"_5":14907,"_28433":126714,"_3077":126759},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3625":74880,"_31241":74865,"_21645":126761,"_5":14907,"_28433":126714,"_3077":126762},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3625":74881,"_31241":74865,"_21645":126764,"_5":14907,"_28433":126714,"_3077":126765},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3625":74882,"_31241":74865,"_21645":126767,"_5":14907,"_28433":126714,"_3077":126768},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3625":74883,"_31241":74865,"_21645":126770,"_5":14907,"_28433":126714,"_3077":126771},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3625":74884,"_31241":74865,"_21645":126773,"_5":14907,"_28433":126718,"_3077":126774},[],"Descarga el PEM e inspecciónalo:",{"_3625":74885,"_31241":74865,"_21645":126776,"_5":14907,"_28433":126718,"_3077":126777},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3625":74886,"_31241":74865,"_21645":126779,"_5":14907,"_28433":126722,"_3077":126780},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3625":74887,"_31241":74865,"_21645":126782,"_5":14907,"_28433":126722,"_3077":126783},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3625":74888,"_31241":74865,"_21645":126785,"_5":14907,"_28433":126722,"_3077":126786},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3625":74889,"_31241":74865,"_21645":126788,"_5":14907,"_28433":126722,"_3077":126789},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3625":74890,"_31241":74865,"_21645":126791,"_5":14907,"_28433":126722,"_3077":126792},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3625":74891,"_31241":74865,"_21645":126794,"_5":14907,"_28433":126722,"_3077":126795},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3625":74892,"_31241":74865,"_21645":126797,"_5":14907,"_28433":126722,"_3077":126798},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3625":74893,"_31241":74865,"_21645":126800,"_5":14907,"_28433":126726,"_3077":126801},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3625":74894,"_31241":74865,"_21645":126803,"_5":14907,"_28433":126730,"_3077":126804},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3625":74895,"_31241":74865,"_21645":126806,"_5":14907,"_28433":126734,"_3077":126807},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3625":74896,"_31241":74865,"_21645":126809,"_5":14907,"_28433":126738,"_3077":126810},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3625":74897,"_31241":74865,"_21645":126812,"_5":14907,"_28433":126738,"_3077":126813},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3625":74898,"_31241":74865,"_21645":126815,"_5":14907,"_28433":126738,"_3077":126816},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3625":74899,"_31241":74865,"_21645":126818,"_5":14907,"_28433":126742,"_3077":126819},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3625":74900,"_31241":74865,"_21645":126821,"_5":14907,"_28433":126742,"_3077":126822},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3625":74901,"_31241":74865,"_21645":126824,"_5":14907,"_28433":126742,"_3077":126825},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3625":74902,"_31241":74865,"_21645":126827,"_5":14907,"_28433":126746,"_3077":126828},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3625":74903,"_31241":74865,"_21645":126830,"_5":14907,"_28433":126746,"_3077":126831},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3625":74904,"_31241":74904,"_5":15267,"_3077":126833,"_31600":126834,"_21645":126836,"_28433":74904},"Ciclo de vida de un certificado",[51013,121907,56702,126835],"Conceptos",[],{"_3625":74905,"_31241":74904,"_21645":126838,"_5":14907,"_28433":74904,"_3077":126839},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3625":74906,"_31241":74904,"_5":31597,"_21645":126841,"_28433":126842,"_3077":126843},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3625":74907,"_31241":74904,"_5":31597,"_21645":126845,"_28433":126846,"_3077":126847},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3625":74908,"_31241":74904,"_5":31597,"_21645":126849,"_28433":126850,"_3077":126851},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3625":74909,"_31241":74904,"_5":31597,"_21645":126853,"_28433":126854,"_3077":126855},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3625":74910,"_31241":74904,"_5":31597,"_21645":126857,"_28433":126858,"_3077":126859},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3625":74911,"_31241":74904,"_5":31597,"_21645":126861,"_28433":126862,"_3077":126863},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3625":74912,"_31241":74904,"_5":31597,"_21645":126865,"_28433":126866,"_3077":124555},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3625":74913,"_31241":74904,"_5":31597,"_21645":126868,"_28433":126869,"_3077":126870},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3625":74914,"_31241":74904,"_5":31597,"_21645":126872,"_28433":126873,"_3077":126874},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3625":74915,"_31241":74904,"_5":31597,"_21645":126876,"_28433":126877,"_3077":126878},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3625":74916,"_31241":74904,"_21645":126880,"_5":14907,"_28433":74904,"_3077":126881},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3625":74917,"_31241":74904,"_21645":126883,"_5":14907,"_28433":126846,"_3077":126884},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3625":74918,"_31241":74904,"_21645":126886,"_5":14907,"_28433":126850,"_3077":126887},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3625":74919,"_31241":74904,"_21645":126889,"_5":14907,"_28433":126854,"_3077":126890},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3625":74920,"_31241":74904,"_21645":126892,"_5":14907,"_28433":126858,"_3077":126893},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3625":74921,"_31241":74904,"_21645":126895,"_5":14907,"_28433":126862,"_3077":126896},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3625":74922,"_31241":74904,"_21645":126898,"_5":14907,"_28433":126866,"_3077":126899},[],"Lamassu persiste cuatro estados X.509:",{"_3625":74923,"_31241":74904,"_21645":126901,"_5":14907,"_28433":126866,"_3077":126902},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3625":74924,"_31241":74904,"_21645":126904,"_5":14907,"_28433":126866,"_3077":126905},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3625":74925,"_31241":74904,"_21645":126907,"_5":14907,"_28433":126866,"_3077":126908},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3625":74926,"_31241":74904,"_21645":126910,"_5":14907,"_28433":126866,"_3077":126911},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3625":74927,"_31241":74904,"_21645":126913,"_5":14907,"_28433":126866,"_3077":126914},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3625":74928,"_31241":74904,"_21645":126916,"_5":14907,"_28433":126869,"_3077":126917},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3625":74929,"_31241":74904,"_21645":126919,"_5":14907,"_28433":126869,"_3077":126920},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3625":74930,"_31241":74904,"_21645":126922,"_5":14907,"_28433":126869,"_3077":126923},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3625":74931,"_31241":74904,"_21645":126925,"_5":14907,"_28433":126873,"_3077":126926},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3625":74932,"_31241":74904,"_21645":126928,"_5":14907,"_28433":126873,"_3077":126929},[],"Antes de confirmar:",{"_3625":74933,"_31241":74904,"_21645":126931,"_5":14907,"_28433":126873,"_3077":126932},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3625":74934,"_31241":74904,"_21645":126934,"_5":14907,"_28433":126873,"_3077":126935},[],"Distribuye la nueva cadena de confianza.",{"_3625":74935,"_31241":74904,"_21645":126937,"_5":14907,"_28433":126873,"_3077":126938},[],"Reemite las identidades necesarias.",{"_3625":74936,"_31241":74904,"_21645":126940,"_5":14907,"_28433":126873,"_3077":126941},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3625":74937,"_31241":74904,"_21645":126943,"_5":14907,"_28433":126873,"_3077":126944},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3625":74938,"_31241":74904,"_21645":126946,"_5":14907,"_28433":126873,"_3077":126947},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3625":74939,"_31241":74904,"_21645":126949,"_5":14907,"_28433":126877,"_3077":126950},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3625":74940,"_31241":74904,"_21645":126952,"_5":14907,"_28433":126877,"_3077":126953},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3625":74941,"_31241":74904,"_21645":126955,"_5":14907,"_28433":126877,"_3077":126956},[],"Cambios de estado y razones de revocación.",{"_3625":74942,"_31241":74904,"_21645":126958,"_5":14907,"_28433":126877,"_3077":126959},[],"Publicación y vigencia de OCSP y CRLs.",{"_3625":74943,"_31241":74904,"_21645":126961,"_5":14907,"_28433":126877,"_3077":126962},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3625":74944,"_31241":74904,"_21645":126964,"_5":14907,"_28433":126877,"_3077":126965},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3625":74945,"_31241":74945,"_5":15267,"_3077":126967,"_31600":126968,"_21645":126969,"_28433":74945},"Modelo de confianza",[51013,121907,56702,126835],[],{"_3625":74946,"_31241":74945,"_21645":126971,"_5":14907,"_28433":74945,"_3077":126972},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3625":74947,"_31241":74945,"_5":31597,"_21645":126974,"_28433":126975,"_3077":126976},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3625":74948,"_31241":74945,"_5":31597,"_21645":126978,"_28433":126979,"_3077":126980},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3625":74949,"_31241":74945,"_5":31597,"_21645":126982,"_28433":126983,"_3077":126984},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3625":74950,"_31241":74945,"_5":31597,"_21645":126986,"_28433":126987,"_3077":126988},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3625":74951,"_31241":74945,"_5":31597,"_21645":126990,"_28433":126991,"_3077":126992},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3625":74952,"_31241":74945,"_5":31597,"_21645":126994,"_28433":126995,"_3077":126996},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3625":74953,"_31241":74945,"_5":31597,"_21645":126998,"_28433":126999,"_3077":127000},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3625":74954,"_31241":74945,"_5":31597,"_21645":127002,"_28433":127003,"_3077":127004},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3625":74955,"_31241":74945,"_5":31597,"_21645":127006,"_28433":127007,"_3077":127008},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3625":74956,"_31241":74945,"_5":31597,"_21645":127010,"_28433":127011,"_3077":127012},[],"/docs/pr-preview/pr-78/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3625":74957,"_31241":74945,"_21645":127014,"_5":14907,"_28433":74945,"_3077":127015},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3625":74958,"_31241":74945,"_21645":127017,"_5":14907,"_28433":126979,"_3077":127018},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3625":74959,"_31241":74945,"_21645":127020,"_5":14907,"_28433":126983,"_3077":127021},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3625":74960,"_31241":74945,"_21645":127023,"_5":14907,"_28433":126987,"_3077":127024},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3625":74961,"_31241":74945,"_21645":127026,"_5":14907,"_28433":126991,"_3077":127027},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3625":74962,"_31241":74945,"_21645":127029,"_5":14907,"_28433":126995,"_3077":127030},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3625":74963,"_31241":74945,"_21645":127032,"_5":14907,"_28433":126995,"_3077":127033},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3625":74964,"_31241":74945,"_21645":127035,"_5":14907,"_28433":126995,"_3077":127036},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3625":74965,"_31241":74945,"_21645":127038,"_5":14907,"_28433":126995,"_3077":127039},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3625":74966,"_31241":74945,"_21645":127041,"_5":14907,"_28433":126995,"_3077":127042},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3625":74967,"_31241":74945,"_21645":127044,"_5":14907,"_28433":126995,"_3077":127045},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3625":74968,"_31241":74945,"_21645":127047,"_5":14907,"_28433":126999,"_3077":127048},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3625":74969,"_31241":74945,"_21645":127050,"_5":14907,"_28433":126999,"_3077":127051},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3625":74970,"_31241":74945,"_21645":127053,"_5":14907,"_28433":126999,"_3077":127054},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3625":74971,"_31241":74945,"_21645":127056,"_5":14907,"_28433":126999,"_3077":127057},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3625":74972,"_31241":74945,"_21645":127059,"_5":14907,"_28433":126999,"_3077":127060},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3625":74973,"_31241":74945,"_21645":127062,"_5":14907,"_28433":127003,"_3077":127063},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3625":74974,"_31241":74945,"_21645":127065,"_5":14907,"_28433":127003,"_3077":127066},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3625":74975,"_31241":74945,"_21645":127068,"_5":14907,"_28433":127003,"_3077":127069},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3625":74976,"_31241":74945,"_21645":127071,"_5":14907,"_28433":127003,"_3077":127072},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3625":74977,"_31241":74945,"_21645":127074,"_5":14907,"_28433":127003,"_3077":127075},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3625":74978,"_31241":74945,"_21645":127077,"_5":14907,"_28433":127003,"_3077":127078},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3625":74979,"_31241":74945,"_21645":127080,"_5":14907,"_28433":127003,"_3077":127081},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3625":74980,"_31241":74945,"_21645":127083,"_5":14907,"_28433":127007,"_3077":127084},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3625":74981,"_31241":74945,"_21645":127086,"_5":14907,"_28433":127011,"_3077":127087},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3625":74982,"_31241":74945,"_21645":127089,"_5":14907,"_28433":127011,"_3077":127090},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3625":74983,"_31241":74945,"_21645":127092,"_5":14907,"_28433":127011,"_3077":127093},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3625":74984,"_31241":74945,"_21645":127095,"_5":14907,"_28433":127011,"_3077":127096},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3625":74985,"_31241":74945,"_21645":127098,"_5":14907,"_28433":127011,"_3077":127099},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3625":74986,"_31241":74945,"_21645":127101,"_5":14907,"_28433":127011,"_3077":127102},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3625":74987,"_31241":74945,"_21645":127104,"_5":14907,"_28433":127011,"_3077":127105},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3625":74988,"_31241":74988,"_5":15267,"_3077":127107,"_31600":127108,"_21645":127109,"_28433":74988},"Listas de revocación (CRL)",[51013,121907,56702,126581],[],{"_3625":74989,"_31241":74988,"_21645":127111,"_5":14907,"_28433":74988,"_3077":127112},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3625":74990,"_31241":74988,"_5":31597,"_21645":127114,"_28433":127115,"_3077":127116},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3625":74991,"_31241":74988,"_5":31597,"_21645":127118,"_28433":127119,"_3077":127120},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3625":74992,"_31241":74988,"_5":31597,"_21645":127122,"_28433":127123,"_3077":127124},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3625":74993,"_31241":74988,"_5":31597,"_21645":127126,"_28433":127127,"_3077":127128},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3625":74994,"_31241":74988,"_5":31597,"_21645":127130,"_28433":127131,"_3077":127132},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3625":74995,"_31241":74988,"_5":31597,"_21645":127134,"_28433":127135,"_3077":127136},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3625":74996,"_31241":74988,"_5":31597,"_21645":127138,"_28433":127139,"_3077":127140},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3625":74997,"_31241":74988,"_5":31597,"_21645":127142,"_28433":127143,"_3077":127144},[],"/docs/pr-preview/pr-78/es/platform/pki/crl#referencias","Referencias",{"_3625":74998,"_31241":74988,"_21645":127146,"_5":14907,"_28433":74988,"_3077":127147},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3625":74999,"_31241":74988,"_21645":127149,"_5":14907,"_28433":127115,"_3077":127150},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3625":75000,"_31241":74988,"_21645":127152,"_5":14907,"_28433":127115,"_3077":127153},[],"Campo",{"_3625":75001,"_31241":74988,"_21645":127155,"_5":14907,"_28433":127115,"_3077":123596},[],{"_3625":75002,"_31241":74988,"_21645":127157,"_5":14907,"_28433":127115,"_3077":52645},[],{"_3625":75003,"_31241":74988,"_21645":127159,"_5":14907,"_28433":127115,"_3077":127160},[],"ID de la CA a la que pertenecen los ajustes.",{"_3625":75004,"_31241":74988,"_21645":127162,"_5":14907,"_28433":127115,"_3077":57937},[],{"_3625":75005,"_31241":74988,"_21645":127164,"_5":14907,"_28433":127115,"_3077":127165},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3625":75006,"_31241":74988,"_21645":127167,"_5":14907,"_28433":127115,"_3077":57943},[],{"_3625":75007,"_31241":74988,"_21645":127169,"_5":14907,"_28433":127115,"_3077":127170},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3625":75008,"_31241":74988,"_21645":127172,"_5":14907,"_28433":127115,"_3077":57949},[],{"_3625":75009,"_31241":74988,"_21645":127174,"_5":14907,"_28433":127115,"_3077":127175},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3625":75010,"_31241":74988,"_21645":127177,"_5":14907,"_28433":127115,"_3077":127178},[],"Campo de `crl_options`",{"_3625":75011,"_31241":74988,"_21645":127180,"_5":14907,"_28433":127115,"_3077":123596},[],{"_3625":75012,"_31241":74988,"_21645":127182,"_5":14907,"_28433":127115,"_3077":127183},[],"Valor inicial",{"_3625":75013,"_31241":74988,"_21645":127185,"_5":14907,"_28433":127115,"_3077":57963},[],{"_3625":75014,"_31241":74988,"_21645":127187,"_5":14907,"_28433":127115,"_3077":127188},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3625":75015,"_31241":74988,"_21645":127190,"_5":14907,"_28433":127115,"_3077":127191},[],"7 días.",{"_3625":75016,"_31241":74988,"_21645":127193,"_5":14907,"_28433":127115,"_3077":57972},[],{"_3625":75017,"_31241":74988,"_21645":127195,"_5":14907,"_28433":127115,"_3077":127196},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3625":75018,"_31241":74988,"_21645":127198,"_5":14907,"_28433":127115,"_3077":127199},[],"6 días y 23 horas.",{"_3625":75019,"_31241":74988,"_21645":127201,"_5":14907,"_28433":127115,"_3077":57981},[],{"_3625":75020,"_31241":74988,"_21645":127203,"_5":14907,"_28433":127115,"_3077":127204},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3625":75021,"_31241":74988,"_21645":127206,"_5":14907,"_28433":127115,"_3077":57987},[],{"_3625":75022,"_31241":74988,"_21645":127208,"_5":14907,"_28433":127115,"_3077":57990},[],{"_3625":75023,"_31241":74988,"_21645":127210,"_5":14907,"_28433":127115,"_3077":127211},[],"Número de serie del certificado existente que firma la CRL.",{"_3625":75024,"_31241":74988,"_21645":127213,"_5":14907,"_28433":127115,"_3077":127214},[],"Número de serie del certificado actual de la CA.",{"_3625":75025,"_31241":74988,"_21645":127216,"_5":14907,"_28433":127115,"_3077":127217},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3625":75026,"_31241":74988,"_21645":127219,"_5":14907,"_28433":127115,"_3077":127220},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3625":75027,"_31241":74988,"_21645":127222,"_5":14907,"_28433":127115,"_3077":127223},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3625":75028,"_31241":74988,"_21645":127225,"_5":14907,"_28433":127115,"_3077":127226},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3625":75029,"_31241":74988,"_21645":127228,"_5":14907,"_28433":127115,"_3077":127229},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3625":75030,"_31241":74988,"_21645":127231,"_5":14907,"_28433":127115,"_3077":127232},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3625":75031,"_31241":74988,"_21645":127234,"_5":14907,"_28433":127115,"_3077":127235},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3625":75032,"_31241":74988,"_21645":127237,"_5":14907,"_28433":127115,"_3077":127238},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3625":75033,"_31241":74988,"_21645":127240,"_5":14907,"_28433":127115,"_3077":127241},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3625":75034,"_31241":74988,"_21645":127243,"_5":14907,"_28433":127115,"_3077":127244},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3625":75035,"_31241":74988,"_21645":127246,"_5":14907,"_28433":127115,"_3077":127247},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3625":75036,"_31241":74988,"_21645":127249,"_5":14907,"_28433":127119,"_3077":127250},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3625":75037,"_31241":74988,"_21645":127252,"_5":14907,"_28433":127119,"_3077":127253},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3625":75038,"_31241":74988,"_21645":127255,"_5":14907,"_28433":127119,"_3077":127256},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3625":75039,"_31241":74988,"_21645":127258,"_5":14907,"_28433":127119,"_3077":127259},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3625":75040,"_31241":74988,"_21645":127261,"_5":14907,"_28433":127123,"_3077":127262},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3625":75041,"_31241":74988,"_21645":127264,"_5":14907,"_28433":127123,"_3077":127265},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3625":75042,"_31241":74988,"_21645":127267,"_5":14907,"_28433":127123,"_3077":127268},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3625":75043,"_31241":74988,"_21645":127270,"_5":14907,"_28433":127123,"_3077":127271},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3625":75044,"_31241":74988,"_21645":127273,"_5":14907,"_28433":127123,"_3077":127274},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3625":75045,"_31241":74988,"_21645":127276,"_5":14907,"_28433":127123,"_3077":127277},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3625":75046,"_31241":74988,"_21645":127279,"_5":14907,"_28433":127123,"_3077":127280},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3625":75047,"_31241":74988,"_21645":127282,"_5":14907,"_28433":127123,"_3077":127283},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3625":75048,"_31241":74988,"_21645":127285,"_5":14907,"_28433":127123,"_3077":127286},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3625":75049,"_31241":74988,"_21645":127288,"_5":14907,"_28433":127127,"_3077":127289},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3625":75050,"_31241":74988,"_21645":127291,"_5":14907,"_28433":127127,"_3077":127292},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3625":75051,"_31241":74988,"_21645":127294,"_5":14907,"_28433":127131,"_3077":127295},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3625":75052,"_31241":74988,"_21645":127297,"_5":14907,"_28433":127131,"_3077":127298},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3625":75053,"_31241":74988,"_21645":127300,"_5":14907,"_28433":127131,"_3077":127301},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3625":75054,"_31241":74988,"_21645":127303,"_5":14907,"_28433":127131,"_3077":127304},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3625":75055,"_31241":74988,"_21645":127306,"_5":14907,"_28433":127131,"_3077":127307},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3625":75056,"_31241":74988,"_21645":127309,"_5":14907,"_28433":127135,"_3077":127310},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3625":75057,"_31241":74988,"_21645":127312,"_5":14907,"_28433":127135,"_3077":123785},[],{"_3625":75058,"_31241":74988,"_21645":127314,"_5":14907,"_28433":127135,"_3077":127315},[],"Path relativo",{"_3625":75059,"_31241":74988,"_21645":127317,"_5":14907,"_28433":127135,"_3077":121667},[],{"_3625":75060,"_31241":74988,"_21645":127319,"_5":14907,"_28433":127135,"_3077":58102},[],{"_3625":75061,"_31241":74988,"_21645":127321,"_5":14907,"_28433":127135,"_3077":58105},[],{"_3625":75062,"_31241":74988,"_21645":127323,"_5":14907,"_28433":127135,"_3077":127324},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3625":75063,"_31241":74988,"_21645":127326,"_5":14907,"_28433":127135,"_3077":58102},[],{"_3625":75064,"_31241":74988,"_21645":127328,"_5":14907,"_28433":127135,"_3077":58113},[],{"_3625":75065,"_31241":74988,"_21645":127330,"_5":14907,"_28433":127135,"_3077":127331},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3625":75066,"_31241":74988,"_21645":127333,"_5":14907,"_28433":127135,"_3077":58119},[],{"_3625":75067,"_31241":74988,"_21645":127335,"_5":14907,"_28433":127135,"_3077":58113},[],{"_3625":75068,"_31241":74988,"_21645":127337,"_5":14907,"_28433":127135,"_3077":127338},[],"Sustituir la configuración de CRL de una CA.",{"_3625":75069,"_31241":74988,"_21645":127340,"_5":14907,"_28433":127135,"_3077":58127},[],{"_3625":75070,"_31241":74988,"_21645":127342,"_5":14907,"_28433":127135,"_3077":58113},[],{"_3625":75071,"_31241":74988,"_21645":127344,"_5":14907,"_28433":127135,"_3077":127345},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3625":75072,"_31241":74988,"_21645":127347,"_5":14907,"_28433":127135,"_3077":127348},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3625":75073,"_31241":74988,"_21645":127350,"_5":14907,"_28433":127135,"_3077":127351},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3625":75074,"_31241":74988,"_21645":127353,"_5":14907,"_28433":127135,"_3077":127354},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3625":75075,"_31241":74988,"_21645":127356,"_5":14907,"_28433":127139,"_3077":127357},[],"Síntoma",{"_3625":75076,"_31241":74988,"_21645":127359,"_5":14907,"_28433":127139,"_3077":127360},[],"Causa",{"_3625":75077,"_31241":74988,"_21645":127362,"_5":14907,"_28433":127139,"_3077":127363},[],"Acción",{"_3625":75078,"_31241":74988,"_21645":127365,"_5":14907,"_28433":127139,"_3077":127366},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3625":75079,"_31241":74988,"_21645":127368,"_5":14907,"_28433":127139,"_3077":127369},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3625":75080,"_31241":74988,"_21645":127371,"_5":14907,"_28433":127139,"_3077":127372},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3625":75081,"_31241":74988,"_21645":127374,"_5":14907,"_28433":127139,"_3077":127375},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3625":75082,"_31241":74988,"_21645":127377,"_5":14907,"_28433":127139,"_3077":127378},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3625":75083,"_31241":74988,"_21645":127380,"_5":14907,"_28433":127139,"_3077":127381},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3625":75084,"_31241":74988,"_21645":127383,"_5":14907,"_28433":127139,"_3077":127384},[],"`PUT` devuelve 400.",{"_3625":75085,"_31241":74988,"_21645":127386,"_5":14907,"_28433":127139,"_3077":127387},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3625":75086,"_31241":74988,"_21645":127389,"_5":14907,"_28433":127139,"_3077":127390},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3625":75087,"_31241":74988,"_21645":127392,"_5":14907,"_28433":127139,"_3077":127393},[],"`PUT` devuelve 404.",{"_3625":75088,"_31241":74988,"_21645":127395,"_5":14907,"_28433":127139,"_3077":127396},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3625":75089,"_31241":74988,"_21645":127398,"_5":14907,"_28433":127139,"_3077":127399},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3625":75090,"_31241":74988,"_21645":127401,"_5":14907,"_28433":127139,"_3077":127402},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3625":75091,"_31241":74988,"_21645":127404,"_5":14907,"_28433":127139,"_3077":127405},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3625":75092,"_31241":74988,"_21645":127407,"_5":14907,"_28433":127139,"_3077":127408},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3625":75093,"_31241":74988,"_21645":127410,"_5":14907,"_28433":127139,"_3077":127411},[],"La CRL no cambia tras revocar un certificado.",{"_3625":75094,"_31241":74988,"_21645":127413,"_5":14907,"_28433":127139,"_3077":127414},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3625":75095,"_31241":74988,"_21645":127416,"_5":14907,"_28433":127139,"_3077":127417},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3625":75096,"_31241":74988,"_21645":127419,"_5":14907,"_28433":127139,"_3077":127420},[],"Un verificador rechaza la CRL por el emisor.",{"_3625":75097,"_31241":74988,"_21645":127422,"_5":14907,"_28433":127139,"_3077":127423},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3625":75098,"_31241":74988,"_21645":127425,"_5":14907,"_28433":127139,"_3077":127426},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3625":75099,"_31241":74988,"_21645":127428,"_5":14907,"_28433":127143,"_3077":127429},[],"RFC 5280: perfil X.509 y CRL.",{"_3625":75100,"_31241":74988,"_21645":127431,"_5":14907,"_28433":127143,"_3077":58219},[],{"_3625":75101,"_31241":74988,"_21645":127433,"_5":14907,"_28433":127143,"_3077":58222},[],{"_3625":75102,"_31241":74988,"_21645":127435,"_5":14907,"_28433":127143,"_3077":127436},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3625":75103,"_31241":74988,"_21645":127438,"_5":14907,"_28433":127143,"_3077":127439},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3625":75104,"_31241":75104,"_5":15267,"_3077":127441,"_31600":127442,"_21645":127443,"_28433":75104},"Claves y motores criptográficos",[51013,121907,56702,125932],[],{"_3625":75105,"_31241":75104,"_21645":127445,"_5":14907,"_28433":75104,"_3077":127446},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3625":75106,"_31241":75104,"_5":31597,"_21645":127448,"_28433":127449,"_3077":127450},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3625":75107,"_31241":75104,"_5":31597,"_21645":127452,"_28433":127453,"_3077":127454},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3625":75108,"_31241":75104,"_5":31597,"_21645":127456,"_28433":127457,"_3077":58247},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#file-system",{"_3625":75109,"_31241":75104,"_5":31597,"_21645":127459,"_28433":127460,"_3077":58251},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#hashicorp-vault",{"_3625":75110,"_31241":75104,"_5":31597,"_21645":127462,"_28433":127463,"_3077":58255},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#aws-secrets-manager",{"_3625":75111,"_31241":75104,"_5":31597,"_21645":127465,"_28433":127466,"_3077":58259},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#aws-kms",{"_3625":75112,"_31241":75104,"_5":31597,"_21645":127468,"_28433":127469,"_3077":58263},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#pkcs11",{"_3625":75113,"_31241":75104,"_5":31597,"_21645":127471,"_28433":127472,"_3077":58267},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#azure-key-vault",{"_3625":75114,"_31241":75104,"_5":31597,"_21645":127474,"_28433":127475,"_3077":127476},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3625":75115,"_31241":75104,"_5":31597,"_21645":127478,"_28433":127479,"_3077":127480},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3625":75116,"_31241":75104,"_5":31597,"_21645":127482,"_28433":127483,"_3077":127484},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3625":75117,"_31241":75104,"_5":31597,"_21645":127486,"_28433":127487,"_3077":127488},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3625":75118,"_31241":75104,"_5":31597,"_21645":127490,"_28433":127491,"_3077":127492},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3625":75119,"_31241":75104,"_5":31597,"_21645":127494,"_28433":127495,"_3077":127496},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3625":75120,"_31241":75104,"_5":31597,"_21645":127498,"_28433":127499,"_3077":127500},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3625":75121,"_31241":75104,"_5":31597,"_21645":127502,"_28433":127503,"_3077":58299},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#sign",{"_3625":75122,"_31241":75104,"_5":31597,"_21645":127505,"_28433":127506,"_3077":58303},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#verify",{"_3625":75123,"_31241":75104,"_5":31597,"_21645":127508,"_28433":127509,"_3077":127510},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3625":75124,"_31241":75104,"_5":31597,"_21645":127512,"_28433":127513,"_3077":127514},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3625":75125,"_31241":75104,"_5":31597,"_21645":127516,"_28433":127517,"_3077":127518},[],"/docs/pr-preview/pr-78/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3625":75126,"_31241":75104,"_21645":127520,"_5":14907,"_28433":75104,"_3077":127521},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3625":75127,"_31241":75104,"_21645":127523,"_5":14907,"_28433":75104,"_3077":127524},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3625":75128,"_31241":75104,"_21645":127526,"_5":14907,"_28433":127449,"_3077":127527},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3625":75129,"_31241":75104,"_21645":127529,"_5":14907,"_28433":127449,"_3077":127530},[],"En la práctica, permite:",{"_3625":75130,"_31241":75104,"_21645":127532,"_5":14907,"_28433":127449,"_3077":127533},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3625":75131,"_31241":75104,"_21645":127535,"_5":14907,"_28433":127449,"_3077":127536},[],"Importar claves creadas externamente.",{"_3625":75132,"_31241":75104,"_21645":127538,"_5":14907,"_28433":127449,"_3077":127539},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3625":75133,"_31241":75104,"_21645":127541,"_5":14907,"_28433":127449,"_3077":127542},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3625":75134,"_31241":75104,"_21645":127544,"_5":14907,"_28433":127453,"_3077":127545},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3625":75135,"_31241":75104,"_21645":127547,"_5":14907,"_28433":127453,"_3077":127548},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3625":75136,"_31241":75104,"_21645":127550,"_5":14907,"_28433":127453,"_3077":127551},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3625":75137,"_31241":75104,"_21645":127553,"_5":14907,"_28433":127457,"_3077":127554},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3625":75138,"_31241":75104,"_21645":127556,"_5":14907,"_28433":127460,"_3077":127557},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3625":75139,"_31241":75104,"_21645":127559,"_5":14907,"_28433":127460,"_3077":127560},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3625":75140,"_31241":75104,"_21645":127562,"_5":14907,"_28433":127463,"_3077":127563},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3625":75141,"_31241":75104,"_21645":127565,"_5":14907,"_28433":127466,"_3077":127566},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3625":75142,"_31241":75104,"_21645":127568,"_5":14907,"_28433":127469,"_3077":127569},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3625":75143,"_31241":75104,"_21645":127571,"_5":14907,"_28433":127472,"_3077":127572},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3625":75144,"_31241":75104,"_21645":127574,"_5":14907,"_28433":127472,"_3077":127575},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3625":75145,"_31241":75104,"_21645":127577,"_5":14907,"_28433":127472,"_3077":127578},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3625":75146,"_31241":75104,"_21645":127580,"_5":14907,"_28433":127472,"_3077":127581},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3625":75147,"_31241":75104,"_21645":127583,"_5":14907,"_28433":127475,"_3077":127584},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3625":75148,"_31241":75104,"_21645":127586,"_5":14907,"_28433":127475,"_3077":127587},[],"La tabla incluye los siguientes campos:",{"_3625":75149,"_31241":75104,"_21645":127589,"_5":14907,"_28433":127475,"_3077":127590},[],"**Name**: nombre descriptivo de la clave.",{"_3625":75150,"_31241":75104,"_21645":127592,"_5":14907,"_28433":127475,"_3077":127593},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3625":75151,"_31241":75104,"_21645":127595,"_5":14907,"_28433":127475,"_3077":127596},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3625":75152,"_31241":75104,"_21645":127598,"_5":14907,"_28433":127475,"_3077":127599},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3625":75153,"_31241":75104,"_21645":127601,"_5":14907,"_28433":127475,"_3077":127602},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3625":75154,"_31241":75104,"_21645":127604,"_5":14907,"_28433":127475,"_3077":127605},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3625":75155,"_31241":75104,"_21645":127607,"_5":14907,"_28433":127475,"_3077":127608},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3625":75156,"_31241":75104,"_21645":127610,"_5":14907,"_28433":127475,"_3077":127611},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3625":75157,"_31241":75104,"_21645":127613,"_5":14907,"_28433":127475,"_3077":127614},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3625":75158,"_31241":75104,"_21645":127616,"_5":14907,"_28433":127475,"_3077":127617},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3625":75159,"_31241":75104,"_21645":127619,"_5":14907,"_28433":127475,"_3077":127620},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3625":75160,"_31241":75104,"_21645":127622,"_5":14907,"_28433":127475,"_3077":127623},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3625":75161,"_31241":75104,"_21645":127625,"_5":14907,"_28433":127475,"_3077":127626},[],"**Delete Key** para eliminar la clave del sistema.",{"_3625":75162,"_31241":75104,"_21645":127628,"_5":14907,"_28433":127479,"_3077":127629},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3625":75163,"_31241":75104,"_21645":127631,"_5":14907,"_28433":127483,"_3077":127632},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3625":75164,"_31241":75104,"_21645":127634,"_5":14907,"_28433":127483,"_3077":127635},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3625":75165,"_31241":75104,"_21645":127637,"_5":14907,"_28433":127483,"_3077":127638},[],"**Key Name**: nombre único y descriptivo.",{"_3625":75166,"_31241":75104,"_21645":127640,"_5":14907,"_28433":127483,"_3077":127641},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3625":75167,"_31241":75104,"_21645":127643,"_5":14907,"_28433":127483,"_3077":127644},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3625":75168,"_31241":75104,"_21645":127646,"_5":14907,"_28433":127483,"_3077":127647},[],"**Tags**: metadatos para clasificar la clave.",{"_3625":75169,"_31241":75104,"_21645":127649,"_5":14907,"_28433":127483,"_3077":127650},[],"**Metadata**: información adicional para usos avanzados.",{"_3625":75170,"_31241":75104,"_21645":127652,"_5":14907,"_28433":127487,"_3077":127653},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3625":75171,"_31241":75104,"_21645":127655,"_5":14907,"_28433":127487,"_3077":127656},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3625":75172,"_31241":75104,"_21645":127658,"_5":14907,"_28433":127487,"_3077":127659},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3625":75173,"_31241":75104,"_21645":127661,"_5":14907,"_28433":127487,"_3077":127662},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3625":75174,"_31241":75104,"_21645":127664,"_5":14907,"_28433":127487,"_3077":127665},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3625":75175,"_31241":75104,"_21645":127667,"_5":14907,"_28433":127487,"_3077":127668},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3625":75176,"_31241":75104,"_21645":127670,"_5":14907,"_28433":127487,"_3077":127671},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3625":75177,"_31241":75104,"_21645":127673,"_5":14907,"_28433":127487,"_3077":127674},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3625":75178,"_31241":75104,"_21645":127676,"_5":14907,"_28433":127487,"_3077":127677},[],"**Metadata**: información adicional opcional.",{"_3625":75179,"_31241":75104,"_21645":127679,"_5":14907,"_28433":127487,"_3077":127680},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3625":75180,"_31241":75104,"_21645":127682,"_5":14907,"_28433":127487,"_3077":127683},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3625":75181,"_31241":75104,"_21645":127685,"_5":14907,"_28433":127491,"_3077":127686},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3625":75182,"_31241":75104,"_21645":127688,"_5":14907,"_28433":127495,"_3077":127689},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3625":75183,"_31241":75104,"_21645":127691,"_5":14907,"_28433":127495,"_3077":127692},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3625":75184,"_31241":75104,"_21645":127694,"_5":14907,"_28433":127495,"_3077":127695},[],"**Key Name**: nombre descriptivo.",{"_3625":75185,"_31241":75104,"_21645":127697,"_5":14907,"_28433":127495,"_3077":127698},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3625":75186,"_31241":75104,"_21645":127700,"_5":14907,"_28433":127495,"_3077":127701},[],"**Tags**: etiquetas asociadas.",{"_3625":75187,"_31241":75104,"_21645":127703,"_5":14907,"_28433":127495,"_3077":127704},[],"**Aliases**: nombres alternativos.",{"_3625":75188,"_31241":75104,"_21645":127706,"_5":14907,"_28433":127495,"_3077":127707},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3625":75189,"_31241":75104,"_21645":127709,"_5":14907,"_28433":127495,"_3077":127710},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3625":75190,"_31241":75104,"_21645":127712,"_5":14907,"_28433":127495,"_3077":127713},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3625":75191,"_31241":75104,"_21645":127715,"_5":14907,"_28433":127495,"_3077":127716},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3625":75192,"_31241":75104,"_21645":127718,"_5":14907,"_28433":127499,"_3077":127719},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3625":75193,"_31241":75104,"_21645":127721,"_5":14907,"_28433":127499,"_3077":127722},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3625":75194,"_31241":75104,"_21645":127724,"_5":14907,"_28433":127499,"_3077":127725},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3625":75195,"_31241":75104,"_21645":127727,"_5":14907,"_28433":127503,"_3077":127728},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3625":75196,"_31241":75104,"_21645":127730,"_5":14907,"_28433":127503,"_3077":127731},[],"Campos principales:",{"_3625":75197,"_31241":75104,"_21645":127733,"_5":14907,"_28433":127503,"_3077":127734},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3625":75198,"_31241":75104,"_21645":127736,"_5":14907,"_28433":127503,"_3077":127737},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3625":75199,"_31241":75104,"_21645":127739,"_5":14907,"_28433":127503,"_3077":127740},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3625":75200,"_31241":75104,"_21645":127742,"_5":14907,"_28433":127503,"_3077":127743},[],"**Message**: contenido que se va a firmar.",{"_3625":75201,"_31241":75104,"_21645":127745,"_5":14907,"_28433":127503,"_3077":127746},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3625":75202,"_31241":75104,"_21645":127748,"_5":14907,"_28433":127506,"_3077":127749},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3625":75203,"_31241":75104,"_21645":127751,"_5":14907,"_28433":127506,"_3077":127731},[],{"_3625":75204,"_31241":75104,"_21645":127753,"_5":14907,"_28433":127506,"_3077":127754},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3625":75205,"_31241":75104,"_21645":127756,"_5":14907,"_28433":127506,"_3077":127757},[],"**Message Type**: `Raw` o `Digest`.",{"_3625":75206,"_31241":75104,"_21645":127759,"_5":14907,"_28433":127506,"_3077":127760},[],"**Payload Encoding**: codificación del mensaje.",{"_3625":75207,"_31241":75104,"_21645":127762,"_5":14907,"_28433":127506,"_3077":127763},[],"**Message**: mensaje original o hash.",{"_3625":75208,"_31241":75104,"_21645":127765,"_5":14907,"_28433":127506,"_3077":127766},[],"**Signature**: firma que se desea comprobar.",{"_3625":75209,"_31241":75104,"_21645":127768,"_5":14907,"_28433":127506,"_3077":127769},[],"**Result**: indicador del resultado de la validación.",{"_3625":75210,"_31241":75104,"_21645":127771,"_5":14907,"_28433":127509,"_3077":127772},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3625":75211,"_31241":75104,"_21645":127774,"_5":14907,"_28433":127509,"_3077":127775},[],"Este flujo es útil para:",{"_3625":75212,"_31241":75104,"_21645":127777,"_5":14907,"_28433":127509,"_3077":127778},[],"Solicitar certificados a una CA externa.",{"_3625":75213,"_31241":75104,"_21645":127780,"_5":14907,"_28433":127509,"_3077":127781},[],"Renovar una identidad manteniendo la misma clave.",{"_3625":75214,"_31241":75104,"_21645":127783,"_5":14907,"_28433":127509,"_3077":127784},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3625":75215,"_31241":75104,"_21645":127786,"_5":14907,"_28433":127509,"_3077":127787},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3625":75216,"_31241":75104,"_21645":127789,"_5":14907,"_28433":127509,"_3077":127790},[],"**Organization (O)**: organización o empresa.",{"_3625":75217,"_31241":75104,"_21645":127792,"_5":14907,"_28433":127509,"_3077":127793},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3625":75218,"_31241":75104,"_21645":127795,"_5":14907,"_28433":127509,"_3077":127796},[],"**Country (C)**: código de país de dos letras.",{"_3625":75219,"_31241":75104,"_21645":127798,"_5":14907,"_28433":127509,"_3077":127799},[],"**State / Province (ST)**: estado o provincia.",{"_3625":75220,"_31241":75104,"_21645":127801,"_5":14907,"_28433":127509,"_3077":127802},[],"**Locality (L)**: ciudad o localidad.",{"_3625":75221,"_31241":75104,"_21645":127804,"_5":14907,"_28433":127509,"_3077":127805},[],"**Email Address**: correo de contacto.",{"_3625":75222,"_31241":75104,"_21645":127807,"_5":14907,"_28433":127509,"_3077":127808},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3625":75223,"_31241":75104,"_21645":127810,"_5":14907,"_28433":127509,"_3077":127811},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3625":75224,"_31241":75104,"_21645":127813,"_5":14907,"_28433":127513,"_3077":127814},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3625":75225,"_31241":75104,"_21645":127816,"_5":14907,"_28433":127513,"_3077":127817},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3625":75226,"_31241":75104,"_21645":127819,"_5":14907,"_28433":127517,"_3077":127820},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3625":75227,"_31241":75104,"_21645":127822,"_5":14907,"_28433":127517,"_3077":127823},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3625":75228,"_31241":75228,"_5":15267,"_3077":127825,"_31600":127826,"_21645":127827,"_28433":75228},"Validación online con OCSP",[51013,121907,56702,126581],[],{"_3625":75229,"_31241":75228,"_21645":127829,"_5":14907,"_28433":75228,"_3077":127830},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3625":75230,"_31241":75228,"_5":31597,"_21645":127832,"_28433":127833,"_3077":127834},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3625":75231,"_31241":75228,"_5":31597,"_21645":127836,"_28433":127837,"_3077":127838},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3625":75232,"_31241":75228,"_5":31597,"_21645":127840,"_28433":127841,"_3077":127842},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3625":75233,"_31241":75228,"_5":31597,"_21645":127844,"_28433":127845,"_3077":127846},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3625":75234,"_31241":75228,"_5":31597,"_21645":127848,"_28433":127849,"_3077":127850},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3625":75235,"_31241":75228,"_5":31597,"_21645":127852,"_28433":127853,"_3077":127144},[],"/docs/pr-preview/pr-78/es/platform/pki/ocsp#referencias",{"_3625":75236,"_31241":75228,"_21645":127855,"_5":14907,"_28433":75228,"_3077":127856},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3625":75237,"_31241":75228,"_21645":127858,"_5":14907,"_28433":127833,"_3077":127859},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3625":75238,"_31241":75228,"_21645":127861,"_5":14907,"_28433":127833,"_3077":127862},[],"Estado del registro",{"_3625":75239,"_31241":75228,"_21645":127864,"_5":14907,"_28433":127833,"_3077":127865},[],"Respuesta firmada",{"_3625":75240,"_31241":75228,"_21645":127867,"_5":14907,"_28433":127833,"_3077":55839},[],{"_3625":75241,"_31241":75228,"_21645":127869,"_5":14907,"_28433":127833,"_3077":58667},[],{"_3625":75242,"_31241":75228,"_21645":127871,"_5":14907,"_28433":127833,"_3077":55856},[],{"_3625":75243,"_31241":75228,"_21645":127873,"_5":14907,"_28433":127833,"_3077":127874},[],"`Revoked`, con razón y fecha de revocación.",{"_3625":75244,"_31241":75228,"_21645":127876,"_5":14907,"_28433":127833,"_3077":127877},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3625":75245,"_31241":75228,"_21645":127879,"_5":14907,"_28433":127833,"_3077":127880},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3625":75246,"_31241":75228,"_21645":127882,"_5":14907,"_28433":127833,"_3077":127883},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3625":75247,"_31241":75228,"_21645":127885,"_5":14907,"_28433":127833,"_3077":127886},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3625":75248,"_31241":75228,"_21645":127888,"_5":14907,"_28433":127833,"_3077":127889},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3625":75249,"_31241":75228,"_21645":127891,"_5":14907,"_28433":127837,"_3077":127892},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3625":75250,"_31241":75228,"_21645":127894,"_5":14907,"_28433":127837,"_3077":127895},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3625":75251,"_31241":75228,"_21645":127897,"_5":14907,"_28433":127841,"_3077":127898},[],"El servicio acepta:",{"_3625":75252,"_31241":75228,"_21645":127900,"_5":14907,"_28433":127841,"_3077":123785},[],{"_3625":75253,"_31241":75228,"_21645":127902,"_5":14907,"_28433":127841,"_3077":127903},[],"Ruta del servicio VA",{"_3625":75254,"_31241":75228,"_21645":127905,"_5":14907,"_28433":127841,"_3077":127906},[],"Formato",{"_3625":75255,"_31241":75228,"_21645":127908,"_5":14907,"_28433":127841,"_3077":58707},[],{"_3625":75256,"_31241":75228,"_21645":127910,"_5":14907,"_28433":127841,"_3077":58710},[],{"_3625":75257,"_31241":75228,"_21645":127912,"_5":14907,"_28433":127841,"_3077":127913},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3625":75258,"_31241":75228,"_21645":127915,"_5":14907,"_28433":127841,"_3077":58102},[],{"_3625":75259,"_31241":75228,"_21645":127917,"_5":14907,"_28433":127841,"_3077":58718},[],{"_3625":75260,"_31241":75228,"_21645":127919,"_5":14907,"_28433":127841,"_3077":127920},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3625":75261,"_31241":75228,"_21645":127922,"_5":14907,"_28433":127841,"_3077":127923},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3625":75262,"_31241":75228,"_21645":127925,"_5":14907,"_28433":127845,"_3077":127926},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3625":75263,"_31241":75228,"_21645":127928,"_5":14907,"_28433":127845,"_3077":127929},[],"Genera la solicitud:",{"_3625":75264,"_31241":75228,"_21645":127931,"_5":14907,"_28433":127845,"_3077":127932},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3625":75265,"_31241":75228,"_21645":127934,"_5":14907,"_28433":127845,"_3077":127935},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3625":75266,"_31241":75228,"_21645":127937,"_5":14907,"_28433":127845,"_3077":127938},[],"Verifica el DER recibido:",{"_3625":75267,"_31241":75228,"_21645":127940,"_5":14907,"_28433":127845,"_3077":127941},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3625":75268,"_31241":75228,"_21645":127943,"_5":14907,"_28433":127849,"_3077":127944},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3625":75269,"_31241":75228,"_21645":127946,"_5":14907,"_28433":127849,"_3077":127947},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3625":75270,"_31241":75228,"_21645":127949,"_5":14907,"_28433":127853,"_3077":58751},[],{"_3625":75271,"_31241":75228,"_21645":127951,"_5":14907,"_28433":127853,"_3077":58754},[],{"_3625":75272,"_31241":75228,"_21645":127953,"_5":14907,"_28433":127853,"_3077":127954},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3625":75273,"_31241":75228,"_21645":127956,"_5":14907,"_28433":127853,"_3077":127439},[],{"_3625":75274,"_31241":75274,"_5":15267,"_3077":56702,"_31600":127958,"_21645":127959,"_28433":75274},[51013,121907,56702],[],{"_3625":75275,"_31241":75274,"_21645":127961,"_5":14907,"_28433":75274,"_3077":127962},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3625":75276,"_31241":75274,"_5":31597,"_21645":127964,"_28433":127965,"_3077":125258},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#empieza-aquí",{"_3625":75277,"_31241":75274,"_5":31597,"_21645":127967,"_28433":127968,"_3077":127969},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3625":75278,"_31241":75274,"_5":31597,"_21645":127971,"_28433":127972,"_3077":125778},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#capacidades-principales",{"_3625":75279,"_31241":75274,"_5":31597,"_21645":127974,"_28433":127975,"_3077":125782},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3625":75280,"_31241":75274,"_5":31597,"_21645":127977,"_28433":127978,"_3077":125786},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3625":75281,"_31241":75274,"_5":31597,"_21645":127980,"_28433":127981,"_3077":125790},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#emite-y-controla-certificados",{"_3625":75282,"_31241":75274,"_5":31597,"_21645":127983,"_28433":127984,"_3077":125798},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#publica-el-estado-de-validación",{"_3625":75283,"_31241":75274,"_5":31597,"_21645":127986,"_28433":127987,"_3077":127988},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3625":75284,"_31241":75274,"_5":31597,"_21645":127990,"_28433":127991,"_3077":126747},[],"/docs/pr-preview/pr-78/es/platform/pki/overview#continúa",{"_3625":75285,"_31241":75274,"_21645":127993,"_5":14907,"_28433":75274,"_3077":127994},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3625":75286,"_31241":75274,"_21645":127996,"_5":14907,"_28433":127965,"_3077":127997},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3625":75287,"_31241":75274,"_21645":127999,"_5":14907,"_28433":127965,"_3077":128000},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3625":75288,"_31241":75274,"_21645":128002,"_5":14907,"_28433":127968,"_3077":128003},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3625":75289,"_31241":75274,"_21645":128005,"_5":14907,"_28433":127968,"_3077":128006},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3625":75290,"_31241":75274,"_21645":128008,"_5":14907,"_28433":127968,"_3077":128009},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3625":75291,"_31241":75274,"_21645":128011,"_5":14907,"_28433":127968,"_3077":128012},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3625":75292,"_31241":75274,"_21645":128014,"_5":14907,"_28433":127968,"_3077":128015},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3625":75293,"_31241":75274,"_21645":128017,"_5":14907,"_28433":127975,"_3077":128018},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3625":75294,"_31241":75274,"_21645":128020,"_5":14907,"_28433":127978,"_3077":128021},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3625":75295,"_31241":75274,"_21645":128023,"_5":14907,"_28433":127981,"_3077":128024},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3625":75296,"_31241":75274,"_21645":128026,"_5":14907,"_28433":127984,"_3077":128027},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3625":75297,"_31241":75274,"_21645":128029,"_5":14907,"_28433":127987,"_3077":128030},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3625":75298,"_31241":75274,"_21645":128032,"_5":14907,"_28433":127987,"_3077":128033},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3625":75299,"_31241":75274,"_21645":128035,"_5":14907,"_28433":127987,"_3077":128036},[],"su clave pública corresponda a la clave privada del cliente;",{"_3625":75300,"_31241":75274,"_21645":128038,"_5":14907,"_28433":127987,"_3077":128039},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3625":75301,"_31241":75274,"_21645":128041,"_5":14907,"_28433":127987,"_3077":128042},[],"sus fechas y usos permitan la operación;",{"_3625":75302,"_31241":75274,"_21645":128044,"_5":14907,"_28433":127987,"_3077":128045},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3625":75303,"_31241":75274,"_21645":128047,"_5":14907,"_28433":127987,"_3077":128048},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3625":75304,"_31241":75274,"_21645":128050,"_5":14907,"_28433":127991,"_3077":128051},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3625":75305,"_31241":75274,"_21645":128053,"_5":14907,"_28433":127991,"_3077":128054},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3625":75306,"_31241":75274,"_21645":128056,"_5":14907,"_28433":127991,"_3077":128057},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3625":75307,"_31241":75307,"_5":15267,"_3077":128059,"_31600":128060,"_21645":128061,"_28433":75307},"Crea tu primera CA",[51013,121907,56702,125382],[],{"_3625":75308,"_31241":75307,"_21645":128063,"_5":14907,"_28433":75307,"_3077":128064},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3625":75309,"_31241":75307,"_5":31597,"_21645":128066,"_28433":128067,"_3077":120441},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3625":75310,"_31241":75307,"_5":31597,"_21645":128069,"_28433":128070,"_3077":128071},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3625":75311,"_31241":75307,"_5":31597,"_21645":128073,"_28433":128074,"_3077":128075},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3625":75312,"_31241":75307,"_5":31597,"_21645":128077,"_28433":128078,"_3077":128079},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3625":75313,"_31241":75307,"_5":31597,"_21645":128081,"_28433":128082,"_3077":128083},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3625":75314,"_31241":75307,"_5":31597,"_21645":128085,"_28433":128086,"_3077":128087},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3625":75315,"_31241":75307,"_5":31597,"_21645":128089,"_28433":128090,"_3077":128091},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3625":75316,"_31241":75307,"_5":31597,"_21645":128093,"_28433":128094,"_3077":125629},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3625":75317,"_31241":75307,"_5":31597,"_21645":128096,"_28433":128097,"_3077":120465},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3625":75318,"_31241":75307,"_21645":128099,"_5":14907,"_28433":75307,"_3077":128100},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3625":75319,"_31241":75307,"_21645":128102,"_5":14907,"_28433":128067,"_3077":128103},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3625":75320,"_31241":75307,"_21645":128105,"_5":14907,"_28433":128067,"_3077":128106},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3625":75321,"_31241":75307,"_21645":128108,"_5":14907,"_28433":128067,"_3077":128109},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3625":75322,"_31241":75307,"_21645":128111,"_5":14907,"_28433":128067,"_3077":128112},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3625":75323,"_31241":75307,"_21645":128114,"_5":14907,"_28433":128070,"_3077":128115},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3625":75324,"_31241":75307,"_21645":128117,"_5":14907,"_28433":128070,"_3077":128118},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3625":75325,"_31241":75307,"_21645":128120,"_5":14907,"_28433":128074,"_3077":128121},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3625":75326,"_31241":75307,"_21645":128123,"_5":14907,"_28433":128074,"_3077":128124},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3625":75327,"_31241":75307,"_21645":128126,"_5":14907,"_28433":128078,"_3077":128127},[],"Selecciona **Root CA** y completa:",{"_3625":75328,"_31241":75307,"_21645":128129,"_5":14907,"_28433":128078,"_3077":58933},[],{"_3625":75329,"_31241":75307,"_21645":128131,"_5":14907,"_28433":128078,"_3077":128132},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3625":75330,"_31241":75307,"_21645":128134,"_5":14907,"_28433":128078,"_3077":128135},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3625":75331,"_31241":75307,"_21645":128137,"_5":14907,"_28433":128078,"_3077":128138},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3625":75332,"_31241":75307,"_21645":128140,"_5":14907,"_28433":128078,"_3077":128141},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3625":75333,"_31241":75307,"_21645":128143,"_5":14907,"_28433":128082,"_3077":128144},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3625":75334,"_31241":75307,"_21645":128146,"_5":14907,"_28433":128086,"_3077":128147},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3625":75335,"_31241":75307,"_21645":128149,"_5":14907,"_28433":128086,"_3077":128150},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3625":75336,"_31241":75307,"_21645":128152,"_5":14907,"_28433":128090,"_3077":128153},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3625":75337,"_31241":75307,"_21645":128155,"_5":14907,"_28433":128090,"_3077":128156},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3625":75338,"_31241":75307,"_21645":128158,"_5":14907,"_28433":128090,"_3077":128159},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3625":75339,"_31241":75307,"_21645":128161,"_5":14907,"_28433":128094,"_3077":128162},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3625":75340,"_31241":75307,"_21645":128164,"_5":14907,"_28433":128094,"_3077":128165},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3625":75341,"_31241":75307,"_21645":128167,"_5":14907,"_28433":128094,"_3077":128168},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3625":75342,"_31241":75307,"_21645":128170,"_5":14907,"_28433":128094,"_3077":128171},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3625":75343,"_31241":75307,"_21645":128173,"_5":14907,"_28433":128097,"_3077":128174},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3625":75344,"_31241":75344,"_5":15267,"_3077":128176,"_31600":128177,"_21645":128178,"_28433":75344},"Emite y verifica un certificado",[51013,121907,56702,125382],[],{"_3625":75345,"_31241":75344,"_21645":128180,"_5":14907,"_28433":75344,"_3077":128181},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3625":75346,"_31241":75344,"_5":31597,"_21645":128183,"_28433":128184,"_3077":120441},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3625":75347,"_31241":75344,"_5":31597,"_21645":128186,"_28433":128187,"_3077":128188},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3625":75348,"_31241":75344,"_5":31597,"_21645":128190,"_28433":128191,"_3077":128192},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3625":75349,"_31241":75344,"_5":31597,"_21645":128194,"_28433":128195,"_3077":128196},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3625":75350,"_31241":75344,"_5":31597,"_21645":128198,"_28433":128199,"_3077":128200},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3625":75351,"_31241":75344,"_5":31597,"_21645":128202,"_28433":128203,"_3077":128204},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3625":75352,"_31241":75344,"_5":31597,"_21645":128206,"_28433":128207,"_3077":128208},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3625":75353,"_31241":75344,"_5":31597,"_21645":128210,"_28433":128211,"_3077":128212},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3625":75354,"_31241":75344,"_5":31597,"_21645":128214,"_28433":128215,"_3077":128216},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3625":75355,"_31241":75344,"_5":31597,"_21645":128218,"_28433":128219,"_3077":128220},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3625":75356,"_31241":75344,"_5":31597,"_21645":128222,"_28433":128223,"_3077":125629},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3625":75357,"_31241":75344,"_5":31597,"_21645":128225,"_28433":128226,"_3077":120465},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3625":75358,"_31241":75344,"_21645":128228,"_5":14907,"_28433":75344,"_3077":128229},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3625":75359,"_31241":75344,"_21645":128231,"_5":14907,"_28433":128184,"_3077":128232},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3625":75360,"_31241":75344,"_21645":128234,"_5":14907,"_28433":128184,"_3077":128235},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3625":75361,"_31241":75344,"_21645":128237,"_5":14907,"_28433":128184,"_3077":128238},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3625":75362,"_31241":75344,"_21645":128240,"_5":14907,"_28433":128184,"_3077":128241},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3625":75363,"_31241":75344,"_21645":128243,"_5":14907,"_28433":128184,"_3077":128244},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3625":75364,"_31241":75344,"_21645":128246,"_5":14907,"_28433":128187,"_3077":128247},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3625":75365,"_31241":75344,"_21645":128249,"_5":14907,"_28433":128191,"_3077":128250},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3625":75366,"_31241":75344,"_21645":128252,"_5":14907,"_28433":128191,"_3077":128253},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3625":75367,"_31241":75344,"_21645":128255,"_5":14907,"_28433":128195,"_3077":128256},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3625":75368,"_31241":75344,"_21645":128258,"_5":14907,"_28433":128195,"_3077":128259},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3625":75369,"_31241":75344,"_21645":128261,"_5":14907,"_28433":128199,"_3077":128262},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3625":75370,"_31241":75344,"_21645":128264,"_5":14907,"_28433":128199,"_3077":128265},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3625":75371,"_31241":75344,"_21645":128267,"_5":14907,"_28433":128203,"_3077":128268},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3625":75372,"_31241":75344,"_21645":128270,"_5":14907,"_28433":128207,"_3077":128271},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3625":75373,"_31241":75344,"_21645":128273,"_5":14907,"_28433":128211,"_3077":128274},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3625":75374,"_31241":75344,"_21645":128276,"_5":14907,"_28433":128215,"_3077":128277},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3625":75375,"_31241":75344,"_21645":128279,"_5":14907,"_28433":128215,"_3077":128280},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3625":75376,"_31241":75344,"_21645":128282,"_5":14907,"_28433":128215,"_3077":128283},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3625":75377,"_31241":75344,"_21645":128285,"_5":14907,"_28433":128219,"_3077":128286},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3625":75378,"_31241":75344,"_21645":128288,"_5":14907,"_28433":128219,"_3077":128289},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3625":75379,"_31241":75344,"_21645":128291,"_5":14907,"_28433":128219,"_3077":128292},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3625":75380,"_31241":75344,"_21645":128294,"_5":14907,"_28433":128223,"_3077":125712},[],{"_3625":75381,"_31241":75344,"_21645":128296,"_5":14907,"_28433":128223,"_3077":124227},[],{"_3625":75382,"_31241":75344,"_21645":128298,"_5":14907,"_28433":128223,"_3077":128299},[],"La CA rechaza la emisión",{"_3625":75383,"_31241":75344,"_21645":128301,"_5":14907,"_28433":128223,"_3077":128302},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3625":75384,"_31241":75344,"_21645":128304,"_5":14907,"_28433":128223,"_3077":128305},[],"Sujeto o usos diferentes",{"_3625":75385,"_31241":75344,"_21645":128307,"_5":14907,"_28433":128223,"_3077":128308},[],"Perfil aplicado y valores solicitados.",{"_3625":75386,"_31241":75344,"_21645":128310,"_5":14907,"_28433":128223,"_3077":128311},[],"No se encuentra el emisor",{"_3625":75387,"_31241":75344,"_21645":128313,"_5":14907,"_28433":128223,"_3077":128314},[],"CA descargada y cadena intermedia necesaria.",{"_3625":75388,"_31241":75344,"_21645":128316,"_5":14907,"_28433":128223,"_3077":128317},[],"Falla la vigencia",{"_3625":75389,"_31241":75344,"_21645":128319,"_5":14907,"_28433":128223,"_3077":128320},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3625":75390,"_31241":75344,"_21645":128322,"_5":14907,"_28433":128223,"_3077":128323},[],"Los resúmenes de clave difieren",{"_3625":75391,"_31241":75344,"_21645":128325,"_5":14907,"_28433":128223,"_3077":128326},[],"Archivos de certificado y clave de la misma emisión.",{"_3625":75392,"_31241":75344,"_21645":128328,"_5":14907,"_28433":128223,"_3077":128329},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3625":75393,"_31241":75344,"_21645":128331,"_5":14907,"_28433":128226,"_3077":128332},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3625":75394,"_31241":75344,"_21645":128334,"_5":14907,"_28433":128226,"_3077":128335},[],"Gestionar certificados para inspección, estado y revocación.",{"_3625":75395,"_31241":75344,"_21645":128337,"_5":14907,"_28433":128226,"_3077":128338},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3625":75396,"_31241":75344,"_21645":128340,"_5":14907,"_28433":128226,"_3077":128341},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3625":75397,"_31241":75344,"_21645":128343,"_5":14907,"_28433":128226,"_3077":128344},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3625":75398,"_31241":75398,"_5":15267,"_3077":128346,"_31600":128347,"_21645":128348,"_28433":75398},"Primeros pasos de PKI",[51013,121907,56702,125382],[],{"_3625":75399,"_31241":75398,"_21645":128350,"_5":14907,"_28433":75398,"_3077":128351},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3625":75400,"_31241":75398,"_5":31597,"_21645":128353,"_28433":128354,"_3077":120441},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3625":75401,"_31241":75398,"_5":31597,"_21645":128356,"_28433":128357,"_3077":128358},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3625":75402,"_31241":75398,"_5":31597,"_21645":128360,"_28433":128361,"_3077":125564},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3625":75403,"_31241":75398,"_5":31597,"_21645":128363,"_28433":128364,"_3077":128365},[],"/docs/pr-preview/pr-78/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3625":75404,"_31241":75398,"_21645":128367,"_5":14907,"_28433":75398,"_3077":128368},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3625":75405,"_31241":75398,"_21645":128370,"_5":14907,"_28433":128354,"_3077":128371},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3625":75406,"_31241":75398,"_21645":128373,"_5":14907,"_28433":128354,"_3077":128374},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3625":75407,"_31241":75398,"_21645":128376,"_5":14907,"_28433":128354,"_3077":128377},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3625":75408,"_31241":75398,"_21645":128379,"_5":14907,"_28433":128354,"_3077":128380},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3625":75409,"_31241":75398,"_21645":128382,"_5":14907,"_28433":128354,"_3077":128383},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3625":75410,"_31241":75398,"_21645":128385,"_5":14907,"_28433":128357,"_3077":128386},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3625":75411,"_31241":75398,"_21645":128388,"_5":14907,"_28433":128357,"_3077":128389},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3625":75412,"_31241":75398,"_21645":128391,"_5":14907,"_28433":128357,"_3077":128392},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3625":75413,"_31241":75398,"_21645":128394,"_5":14907,"_28433":128357,"_3077":128395},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3625":75414,"_31241":75398,"_21645":128397,"_5":14907,"_28433":128361,"_3077":128398},[],"Archivo o recurso",{"_3625":75415,"_31241":75398,"_21645":128400,"_5":14907,"_28433":128361,"_3077":125561},[],{"_3625":75416,"_31241":75398,"_21645":128402,"_5":14907,"_28433":128361,"_3077":128403},[],"CA raíz activa y `ca.pem`",{"_3625":75417,"_31241":75398,"_21645":128405,"_5":14907,"_28433":128361,"_3077":128406},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3625":75418,"_31241":75398,"_21645":128408,"_5":14907,"_28433":128361,"_3077":128409},[],"Certificado final y `device.crt`",{"_3625":75419,"_31241":75398,"_21645":128411,"_5":14907,"_28433":128361,"_3077":128412},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3625":75420,"_31241":75398,"_21645":128414,"_5":14907,"_28433":128361,"_3077":128415},[],"Clave privada `device.key`",{"_3625":75421,"_31241":75398,"_21645":128417,"_5":14907,"_28433":128361,"_3077":128418},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3625":75422,"_31241":75398,"_21645":128420,"_5":14907,"_28433":128361,"_3077":128421},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3625":75423,"_31241":75398,"_21645":128423,"_5":14907,"_28433":128364,"_3077":128424},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3625":75424,"_31241":75398,"_21645":128426,"_5":14907,"_28433":128364,"_3077":128427},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3625":75425,"_31241":75398,"_21645":128429,"_5":14907,"_28433":128364,"_3077":128430},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3625":75426,"_31241":75426,"_5":15267,"_3077":128432,"_31600":128433,"_21645":128435,"_28433":75426},"Resolución de problemas PKI",[51013,121907,56702,128434],"Resolución de problemas",[],{"_3625":75427,"_31241":75426,"_21645":128437,"_5":14907,"_28433":75426,"_3077":128438},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3625":75428,"_31241":75426,"_5":31597,"_21645":128440,"_28433":128441,"_3077":128442},[],"/docs/pr-preview/pr-78/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3625":75429,"_31241":75426,"_5":31597,"_21645":128444,"_28433":128445,"_3077":128446},[],"/docs/pr-preview/pr-78/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3625":75430,"_31241":75426,"_5":31597,"_21645":128448,"_28433":128449,"_3077":128450},[],"/docs/pr-preview/pr-78/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3625":75431,"_31241":75426,"_21645":128452,"_5":14907,"_28433":75426,"_3077":128453},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3625":75432,"_31241":75426,"_21645":128455,"_5":14907,"_28433":75426,"_3077":128456},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3625":75433,"_31241":75426,"_21645":128458,"_5":14907,"_28433":128441,"_3077":125561},[],{"_3625":75434,"_31241":75426,"_21645":128460,"_5":14907,"_28433":128441,"_3077":124227},[],{"_3625":75435,"_31241":75426,"_21645":128462,"_5":14907,"_28433":128441,"_3077":120465},[],{"_3625":75436,"_31241":75426,"_21645":128464,"_5":14907,"_28433":128441,"_3077":55544},[],{"_3625":75437,"_31241":75426,"_21645":128466,"_5":14907,"_28433":128441,"_3077":128467},[],"Existe, está activa y sus fechas son utilizables.",{"_3625":75438,"_31241":75426,"_21645":128469,"_5":14907,"_28433":128441,"_3077":128470},[],"Autoridades.",{"_3625":75439,"_31241":75426,"_21645":128472,"_5":14907,"_28433":128441,"_3077":128473},[],"Clave",{"_3625":75440,"_31241":75426,"_21645":128475,"_5":14907,"_28433":128441,"_3077":128476},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3625":75441,"_31241":75426,"_21645":128478,"_5":14907,"_28433":128441,"_3077":128479},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3625":75442,"_31241":75426,"_21645":128481,"_5":14907,"_28433":128441,"_3077":59287},[],{"_3625":75443,"_31241":75426,"_21645":128483,"_5":14907,"_28433":128441,"_3077":128484},[],"PEM correcto y firma verificable.",{"_3625":75444,"_31241":75426,"_21645":128486,"_5":14907,"_28433":128441,"_3077":59293},[],{"_3625":75445,"_31241":75426,"_21645":128488,"_5":14907,"_28433":128441,"_3077":128489},[],"Perfil",{"_3625":75446,"_31241":75426,"_21645":128491,"_5":14907,"_28433":128441,"_3077":128492},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3625":75447,"_31241":75426,"_21645":128494,"_5":14907,"_28433":128441,"_3077":128495},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3625":75448,"_31241":75426,"_21645":128497,"_5":14907,"_28433":128441,"_3077":125712},[],{"_3625":75449,"_31241":75426,"_21645":128499,"_5":14907,"_28433":128441,"_3077":128500},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3625":75450,"_31241":75426,"_21645":128502,"_5":14907,"_28433":128441,"_3077":128503},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3625":75451,"_31241":75426,"_21645":128505,"_5":14907,"_28433":128441,"_3077":128506},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3625":75452,"_31241":75426,"_21645":128508,"_5":14907,"_28433":128441,"_3077":128509},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3625":75453,"_31241":75426,"_21645":128511,"_5":14907,"_28433":128441,"_3077":128512},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3625":75454,"_31241":75426,"_21645":128514,"_5":14907,"_28433":128445,"_3077":128515},[],"Revisa cada frontera por separado:",{"_3625":75455,"_31241":75426,"_21645":128517,"_5":14907,"_28433":128445,"_3077":128518},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3625":75456,"_31241":75426,"_21645":128520,"_5":14907,"_28433":128445,"_3077":128521},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3625":75457,"_31241":75426,"_21645":128523,"_5":14907,"_28433":128445,"_3077":128524},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3625":75458,"_31241":75426,"_21645":128526,"_5":14907,"_28433":128445,"_3077":128527},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3625":75459,"_31241":75426,"_21645":128529,"_5":14907,"_28433":128445,"_3077":128530},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3625":75460,"_31241":75426,"_21645":128532,"_5":14907,"_28433":128445,"_3077":128533},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3625":75461,"_31241":75426,"_21645":128535,"_5":14907,"_28433":128449,"_3077":128536},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3625":75462,"_31241":75426,"_21645":128538,"_5":14907,"_28433":128449,"_3077":128539},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3625":75463,"_31241":75463,"_5":15267,"_3077":128541,"_31600":128542,"_21645":128543,"_28433":75463},"Seguridad",[51013],[],{"_3625":75464,"_31241":75463,"_21645":128545,"_5":14907,"_28433":75463,"_3077":128546},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3625":75465,"_31241":75463,"_5":31597,"_21645":128548,"_28433":128549,"_3077":128550},[],"/docs/pr-preview/pr-78/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3625":75466,"_31241":75463,"_5":31597,"_21645":128552,"_28433":128553,"_3077":128554},[],"/docs/pr-preview/pr-78/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3625":75467,"_31241":75463,"_5":31597,"_21645":128556,"_28433":128557,"_3077":128558},[],"/docs/pr-preview/pr-78/es/security#versiones-soportadas","Versiones soportadas",{"_3625":75468,"_31241":75463,"_5":31597,"_21645":128560,"_28433":128561,"_3077":128562},[],"/docs/pr-preview/pr-78/es/security#divulgación-responsable","Divulgación responsable",{"_3625":75469,"_31241":75463,"_21645":128564,"_5":14907,"_28433":75463,"_3077":128565},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3625":75470,"_31241":75463,"_21645":128567,"_5":14907,"_28433":128549,"_3077":128568},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3625":75471,"_31241":75463,"_21645":128570,"_5":14907,"_28433":128549,"_3077":128571},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3625":75472,"_31241":75463,"_21645":128573,"_5":14907,"_28433":128549,"_3077":15551},[],{"_3625":75473,"_31241":75463,"_21645":128575,"_5":14907,"_28433":128549,"_3077":15475},[],{"_3625":75474,"_31241":75463,"_21645":128577,"_5":14907,"_28433":128549,"_3077":15538},[],{"_3625":75475,"_31241":75463,"_21645":128579,"_5":14907,"_28433":128549,"_3077":128580},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3625":75476,"_31241":75463,"_21645":128582,"_5":14907,"_28433":128549,"_3077":128583},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3625":75477,"_31241":75463,"_21645":128585,"_5":14907,"_28433":128553,"_3077":128586},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3625":75478,"_31241":75463,"_21645":128588,"_5":14907,"_28433":128553,"_3077":128589},[],"No incluyas en el reporte:",{"_3625":75479,"_31241":75463,"_21645":128591,"_5":14907,"_28433":128553,"_3077":128592},[],"Credenciales, tokens o claves privadas",{"_3625":75480,"_31241":75463,"_21645":128594,"_5":14907,"_28433":128553,"_3077":128595},[],"Datos de clientes o información identificable de clientes",{"_3625":75481,"_31241":75463,"_21645":128597,"_5":14907,"_28433":128553,"_3077":128598},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3625":75482,"_31241":75463,"_21645":128600,"_5":14907,"_28433":128557,"_3077":128601},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3625":75483,"_31241":75463,"_21645":128603,"_5":14907,"_28433":128557,"_3077":128604},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3625":75484,"_31241":75463,"_21645":128606,"_5":14907,"_28433":128561,"_3077":128607},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3625":75485,"_31241":75463,"_21645":128609,"_5":14907,"_28433":128561,"_3077":128610},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3625":75486,"_31241":75463,"_21645":128612,"_5":14907,"_28433":128561,"_3077":128613},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3625":75487,"_31241":75463,"_21645":128615,"_5":14907,"_28433":128561,"_3077":128616},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3625":75488,"_31241":75463,"_21645":128618,"_5":14907,"_28433":128561,"_3077":128619},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3625":75489,"_31241":75489,"_5":15267,"_3077":128621,"_31600":128622,"_21645":128624,"_28433":75489},"3.8.0 a 4.0.0",[51013,128623],"Actualizaciones",[],{"_3625":75490,"_31241":75489,"_21645":128626,"_5":14907,"_28433":75489,"_3077":128627},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3625":75491,"_31241":75489,"_5":31597,"_21645":128629,"_28433":128630,"_3077":128631},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3625":75492,"_31241":75489,"_5":31597,"_21645":128633,"_28433":128634,"_3077":128635},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3625":75493,"_31241":75489,"_5":31597,"_21645":128637,"_28433":128638,"_3077":128639},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3625":75494,"_31241":75489,"_5":31597,"_21645":128641,"_28433":128642,"_3077":128643},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3625":75495,"_31241":75489,"_5":31597,"_21645":128645,"_28433":128646,"_3077":128647},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3625":75496,"_31241":75489,"_5":31597,"_21645":128649,"_28433":128650,"_3077":128651},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3625":75497,"_31241":75489,"_5":31597,"_21645":128653,"_28433":128654,"_3077":59462},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3625":75498,"_31241":75489,"_5":31597,"_21645":128656,"_28433":128657,"_3077":128658},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3625":75499,"_31241":75489,"_5":31597,"_21645":128660,"_28433":128661,"_3077":128662},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3625":75500,"_31241":75489,"_5":31597,"_21645":128664,"_28433":128665,"_3077":128666},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3625":75501,"_31241":75489,"_5":31597,"_21645":128668,"_28433":128669,"_3077":121036},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3625":75502,"_31241":75489,"_5":31597,"_21645":128671,"_28433":128672,"_3077":128673},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3625":75503,"_31241":75489,"_5":31597,"_21645":128675,"_28433":128676,"_3077":128677},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3625":75504,"_31241":75489,"_5":31597,"_21645":128679,"_28433":128680,"_3077":128681},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3625":75505,"_31241":75489,"_5":31597,"_21645":128683,"_28433":128684,"_3077":128685},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3625":75506,"_31241":75489,"_5":31597,"_21645":128687,"_28433":128688,"_3077":128689},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3625":75507,"_31241":75489,"_5":31597,"_21645":128691,"_28433":128692,"_3077":128693},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3625":75508,"_31241":75489,"_5":31597,"_21645":128695,"_28433":128696,"_3077":128697},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3625":75509,"_31241":75489,"_5":31597,"_21645":128699,"_28433":128700,"_3077":128701},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3625":75510,"_31241":75489,"_5":31597,"_21645":128703,"_28433":128704,"_3077":128705},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3625":75511,"_31241":75489,"_5":31597,"_21645":128707,"_28433":128708,"_3077":128709},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3625":75512,"_31241":75489,"_5":31597,"_21645":128711,"_28433":128712,"_3077":128713},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3625":75513,"_31241":75489,"_5":31597,"_21645":128715,"_28433":128716,"_3077":128717},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3625":75514,"_31241":75489,"_5":31597,"_21645":128719,"_28433":128720,"_3077":128721},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3625":75515,"_31241":75489,"_5":31597,"_21645":128723,"_28433":128724,"_3077":128725},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3625":75516,"_31241":75489,"_5":31597,"_21645":128727,"_28433":128728,"_3077":128729},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3625":75517,"_31241":75489,"_5":31597,"_21645":128731,"_28433":128732,"_3077":128733},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3625":75518,"_31241":75489,"_5":31597,"_21645":128735,"_28433":128736,"_3077":128737},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3625":75519,"_31241":75489,"_5":31597,"_21645":128739,"_28433":128740,"_3077":128741},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3625":75520,"_31241":75489,"_5":31597,"_21645":128743,"_28433":128744,"_3077":128745},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3625":75521,"_31241":75489,"_5":31597,"_21645":128747,"_28433":128748,"_3077":128749},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3625":75522,"_31241":75489,"_5":31597,"_21645":128751,"_28433":128752,"_3077":128753},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3625":75523,"_31241":75489,"_5":31597,"_21645":128755,"_28433":128756,"_3077":128757},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3625":75524,"_31241":75489,"_5":31597,"_21645":128759,"_28433":128760,"_3077":128761},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3625":75525,"_31241":75489,"_5":31597,"_21645":128763,"_28433":128764,"_3077":128765},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3625":75526,"_31241":75489,"_5":31597,"_21645":128767,"_28433":128768,"_3077":128769},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3625":75527,"_31241":75489,"_5":31597,"_21645":128771,"_28433":128772,"_3077":128773},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3625":75528,"_31241":75489,"_5":31597,"_21645":128775,"_28433":128776,"_3077":128777},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3625":75529,"_31241":75489,"_5":31597,"_21645":128779,"_28433":128780,"_3077":128781},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3625":75530,"_31241":75489,"_5":31597,"_21645":128783,"_28433":128784,"_3077":128785},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3625":75531,"_31241":75489,"_5":31597,"_21645":128787,"_28433":128788,"_3077":128789},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3625":75532,"_31241":75489,"_5":31597,"_21645":128791,"_28433":128792,"_3077":128793},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3625":75533,"_31241":75489,"_5":31597,"_21645":128795,"_28433":128796,"_3077":128797},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3625":75534,"_31241":75489,"_5":31597,"_21645":128799,"_28433":128800,"_3077":128801},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3625":75535,"_31241":75489,"_5":31597,"_21645":128803,"_28433":128804,"_3077":124575},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3625":75536,"_31241":75489,"_5":31597,"_21645":128806,"_28433":128807,"_3077":128808},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3625":75537,"_31241":75489,"_5":31597,"_21645":128810,"_28433":128811,"_3077":128812},[],"/docs/pr-preview/pr-78/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3625":75538,"_31241":75489,"_21645":128814,"_5":14907,"_28433":75489,"_3077":128815},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3625":75539,"_31241":75489,"_21645":128817,"_5":14907,"_28433":75489,"_3077":128818},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3625":75540,"_31241":75489,"_21645":128820,"_5":14907,"_28433":75489,"_3077":128821},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3625":75541,"_31241":75489,"_21645":128823,"_5":14907,"_28433":75489,"_3077":128824},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3625":75542,"_31241":75489,"_21645":128826,"_5":14907,"_28433":75489,"_3077":128827},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3625":75543,"_31241":75489,"_21645":128829,"_5":14907,"_28433":75489,"_3077":128830},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3625":75544,"_31241":75489,"_21645":128832,"_5":14907,"_28433":75489,"_3077":128833},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3625":75545,"_31241":75489,"_21645":128835,"_5":14907,"_28433":128634,"_3077":128836},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3625":75546,"_31241":75489,"_21645":128838,"_5":14907,"_28433":128634,"_3077":128839},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3625":75547,"_31241":75489,"_21645":128841,"_5":14907,"_28433":128638,"_3077":128842},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3625":75548,"_31241":75489,"_21645":128844,"_5":14907,"_28433":128638,"_3077":128845},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3625":75549,"_31241":75489,"_21645":128847,"_5":14907,"_28433":128642,"_3077":128848},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3625":75550,"_31241":75489,"_21645":128850,"_5":14907,"_28433":128646,"_3077":128851},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3625":75551,"_31241":75489,"_21645":128853,"_5":14907,"_28433":128646,"_3077":128854},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3625":75552,"_31241":75489,"_21645":128856,"_5":14907,"_28433":128646,"_3077":128857},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3625":75553,"_31241":75489,"_21645":128859,"_5":14907,"_28433":128646,"_3077":128860},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3625":75554,"_31241":75489,"_21645":128862,"_5":14907,"_28433":128646,"_3077":128863},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3625":75555,"_31241":75489,"_21645":128865,"_5":14907,"_28433":128650,"_3077":128866},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3625":75556,"_31241":75489,"_21645":128868,"_5":14907,"_28433":128650,"_3077":128869},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3625":75557,"_31241":75489,"_21645":128871,"_5":14907,"_28433":128650,"_3077":128872},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3625":75558,"_31241":75489,"_21645":128874,"_5":14907,"_28433":128650,"_3077":128875},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3625":75559,"_31241":75489,"_21645":128877,"_5":14907,"_28433":128650,"_3077":128878},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3625":75560,"_31241":75489,"_21645":128880,"_5":14907,"_28433":128650,"_3077":128881},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3625":75561,"_31241":75489,"_21645":128883,"_5":14907,"_28433":128654,"_3077":128884},[],"Cambio",{"_3625":75562,"_31241":75489,"_21645":128886,"_5":14907,"_28433":128654,"_3077":128887},[],"A quién afecta",{"_3625":75563,"_31241":75489,"_21645":128889,"_5":14907,"_28433":128654,"_3077":128890},[],"Gravedad",{"_3625":75564,"_31241":75489,"_21645":128892,"_5":14907,"_28433":128654,"_3077":127363},[],{"_3625":75565,"_31241":75489,"_21645":128894,"_5":14907,"_28433":128654,"_3077":128662},[],{"_3625":75566,"_31241":75489,"_21645":128896,"_5":14907,"_28433":128654,"_3077":128897},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3625":75567,"_31241":75489,"_21645":128899,"_5":14907,"_28433":128654,"_3077":128900},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3625":75568,"_31241":75489,"_21645":128902,"_5":14907,"_28433":128654,"_3077":128903},[],"Copiar los datos a los volúmenes nuevos",{"_3625":75569,"_31241":75489,"_21645":128905,"_5":14907,"_28433":128654,"_3077":128666},[],{"_3625":75570,"_31241":75489,"_21645":128907,"_5":14907,"_28433":128654,"_3077":128908},[],"Todas las releases de Helm",{"_3625":75571,"_31241":75489,"_21645":128910,"_5":14907,"_28433":128654,"_3077":128911},[],"Alta: `helm upgrade` falla",{"_3625":75572,"_31241":75489,"_21645":128913,"_5":14907,"_28433":128654,"_3077":128914},[],"Eliminar o renombrar las claves heredadas",{"_3625":75573,"_31241":75489,"_21645":128916,"_5":14907,"_28433":128654,"_3077":121036},[],{"_3625":75574,"_31241":75489,"_21645":128918,"_5":14907,"_28433":128654,"_3077":128908},[],{"_3625":75575,"_31241":75489,"_21645":128920,"_5":14907,"_28433":128654,"_3077":128921},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3625":75576,"_31241":75489,"_21645":128923,"_5":14907,"_28433":128654,"_3077":128924},[],"Crear primero los Secrets; consulta el paso 2",{"_3625":75577,"_31241":75489,"_21645":128926,"_5":14907,"_28433":128654,"_3077":128673},[],{"_3625":75578,"_31241":75489,"_21645":128928,"_5":14907,"_28433":128654,"_3077":128929},[],"Todos los despliegues",{"_3625":75579,"_31241":75489,"_21645":128931,"_5":14907,"_28433":128654,"_3077":128932},[],"Alta: sin principal de bootstrap no hay administrador",{"_3625":75580,"_31241":75489,"_21645":128934,"_5":14907,"_28433":128654,"_3077":128935},[],"Configurar `services.authz`",{"_3625":75581,"_31241":75489,"_21645":128937,"_5":14907,"_28433":128654,"_3077":128677},[],{"_3625":75582,"_31241":75489,"_21645":128939,"_5":14907,"_28433":128654,"_3077":128908},[],{"_3625":75583,"_31241":75489,"_21645":128941,"_5":14907,"_28433":128654,"_3077":128942},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3625":75584,"_31241":75489,"_21645":128944,"_5":14907,"_28433":128654,"_3077":128945},[],"Mover JWKS y roles a `services.authz`",{"_3625":75585,"_31241":75489,"_21645":128947,"_5":14907,"_28433":128654,"_3077":128697},[],{"_3625":75586,"_31241":75489,"_21645":128949,"_5":14907,"_28433":128654,"_3077":128950},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3625":75587,"_31241":75489,"_21645":128952,"_5":14907,"_28433":128654,"_3077":128953},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3625":75588,"_31241":75489,"_21645":128955,"_5":14907,"_28433":128654,"_3077":128956},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3625":75589,"_31241":75489,"_21645":128958,"_5":14907,"_28433":128654,"_3077":128701},[],{"_3625":75590,"_31241":75489,"_21645":128960,"_5":14907,"_28433":128654,"_3077":128961},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3625":75591,"_31241":75489,"_21645":128963,"_5":14907,"_28433":128654,"_3077":128964},[],"Alta: el backend ya no arranca con ellos",{"_3625":75592,"_31241":75489,"_21645":128966,"_5":14907,"_28433":128654,"_3077":128967},[],"Pasar a PostgreSQL antes de actualizar",{"_3625":75593,"_31241":75489,"_21645":128969,"_5":14907,"_28433":128654,"_3077":128749},[],{"_3625":75594,"_31241":75489,"_21645":128971,"_5":14907,"_28433":128654,"_3077":128972},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3625":75595,"_31241":75489,"_21645":128974,"_5":14907,"_28433":128654,"_3077":128975},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3625":75596,"_31241":75489,"_21645":128977,"_5":14907,"_28433":128654,"_3077":128978},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3625":75597,"_31241":75489,"_21645":128980,"_5":14907,"_28433":128654,"_3077":128981},[],"Webhooks con referencias a archivos",{"_3625":75598,"_31241":75489,"_21645":128983,"_5":14907,"_28433":128654,"_3077":128984},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3625":75599,"_31241":75489,"_21645":128986,"_5":14907,"_28433":128654,"_3077":128987},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3625":75600,"_31241":75489,"_21645":128989,"_5":14907,"_28433":128654,"_3077":128990},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3625":75601,"_31241":75489,"_21645":128992,"_5":14907,"_28433":128654,"_3077":128681},[],{"_3625":75602,"_31241":75489,"_21645":128994,"_5":14907,"_28433":128654,"_3077":128995},[],"Releases con identidades por servicio o material de claves montado",{"_3625":75603,"_31241":75489,"_21645":128997,"_5":14907,"_28433":128654,"_3077":128998},[],"Media: los servicios no pueden leer sus archivos",{"_3625":75604,"_31241":75489,"_21645":129000,"_5":14907,"_28433":128654,"_3077":129001},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3625":75605,"_31241":75489,"_21645":129003,"_5":14907,"_28433":128654,"_3077":128685},[],{"_3625":75606,"_31241":75489,"_21645":129005,"_5":14907,"_28433":128654,"_3077":129006},[],"Releases que definen `amqp.tls`",{"_3625":75607,"_31241":75489,"_21645":129008,"_5":14907,"_28433":128654,"_3077":129009},[],"Media: los clientes se conectan al puerto equivocado",{"_3625":75608,"_31241":75489,"_21645":129011,"_5":14907,"_28433":128654,"_3077":129012},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3625":75609,"_31241":75489,"_21645":129014,"_5":14907,"_28433":128654,"_3077":128705},[],{"_3625":75610,"_31241":75489,"_21645":129016,"_5":14907,"_28433":128654,"_3077":129017},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3625":75611,"_31241":75489,"_21645":129019,"_5":14907,"_28433":128654,"_3077":129020},[],"Media: las claves de CA quedan sin gestionar",{"_3625":75612,"_31241":75489,"_21645":129022,"_5":14907,"_28433":128654,"_3077":129023},[],"Ejecutar la migración de CA a KMS",{"_3625":75613,"_31241":75489,"_21645":129025,"_5":14907,"_28433":128654,"_3077":129026},[],"Verificación del certificado del receptor",{"_3625":75614,"_31241":75489,"_21645":129028,"_5":14907,"_28433":128654,"_3077":129029},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3625":75615,"_31241":75489,"_21645":129031,"_5":14907,"_28433":128654,"_3077":129032},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3625":75616,"_31241":75489,"_21645":129034,"_5":14907,"_28433":128654,"_3077":129035},[],"Poner `insecure_skip_verify` a `false`",{"_3625":75617,"_31241":75489,"_21645":129037,"_5":14907,"_28433":128654,"_3077":128721},[],{"_3625":75618,"_31241":75489,"_21645":129039,"_5":14907,"_28433":128654,"_3077":129040},[],"Scripts y consolas que editan DMS por API",{"_3625":75619,"_31241":75489,"_21645":129042,"_5":14907,"_28433":128654,"_3077":129043},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3625":75620,"_31241":75489,"_21645":129045,"_5":14907,"_28433":128654,"_3077":129046},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3625":75621,"_31241":75489,"_21645":129048,"_5":14907,"_28433":128654,"_3077":128725},[],{"_3625":75622,"_31241":75489,"_21645":129050,"_5":14907,"_28433":128654,"_3077":129051},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3625":75623,"_31241":75489,"_21645":129053,"_5":14907,"_28433":128654,"_3077":129054},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3625":75624,"_31241":75489,"_21645":129056,"_5":14907,"_28433":128654,"_3077":129057},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3625":75625,"_31241":75489,"_21645":129059,"_5":14907,"_28433":128654,"_3077":128745},[],{"_3625":75626,"_31241":75489,"_21645":129061,"_5":14907,"_28433":128654,"_3077":129062},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3625":75627,"_31241":75489,"_21645":129064,"_5":14907,"_28433":128654,"_3077":129065},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3625":75628,"_31241":75489,"_21645":129067,"_5":14907,"_28433":128654,"_3077":129068},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3625":75629,"_31241":75489,"_21645":129070,"_5":14907,"_28433":128654,"_3077":128753},[],{"_3625":75630,"_31241":75489,"_21645":129072,"_5":14907,"_28433":128654,"_3077":129073},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3625":75631,"_31241":75489,"_21645":129075,"_5":14907,"_28433":128654,"_3077":129076},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3625":75632,"_31241":75489,"_21645":129078,"_5":14907,"_28433":128654,"_3077":129079},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3625":75633,"_31241":75489,"_21645":129081,"_5":14907,"_28433":128654,"_3077":128757},[],{"_3625":75634,"_31241":75489,"_21645":129083,"_5":14907,"_28433":128654,"_3077":129084},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3625":75635,"_31241":75489,"_21645":129086,"_5":14907,"_28433":128654,"_3077":129087},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3625":75636,"_31241":75489,"_21645":129089,"_5":14907,"_28433":128654,"_3077":129090},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3625":75637,"_31241":75489,"_21645":129092,"_5":14907,"_28433":128654,"_3077":128741},[],{"_3625":75638,"_31241":75489,"_21645":129094,"_5":14907,"_28433":128654,"_3077":129095},[],"Consumidores que leen el campo `events` del dispositivo",{"_3625":75639,"_31241":75489,"_21645":129097,"_5":14907,"_28433":128654,"_3077":129098},[],"Media: el campo desaparece",{"_3625":75640,"_31241":75489,"_21645":129100,"_5":14907,"_28433":128654,"_3077":129101},[],"Usar los nuevos endpoints de eventos",{"_3625":75641,"_31241":75489,"_21645":129103,"_5":14907,"_28433":128654,"_3077":128769},[],{"_3625":75642,"_31241":75489,"_21645":129105,"_5":14907,"_28433":128654,"_3077":129106},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3625":75643,"_31241":75489,"_21645":129108,"_5":14907,"_28433":128654,"_3077":129109},[],"Media: la migración de la VA aborta",{"_3625":75644,"_31241":75489,"_21645":129111,"_5":14907,"_28433":128654,"_3077":129112},[],"Corregir los roles afectados antes de actualizar",{"_3625":75645,"_31241":75489,"_21645":129114,"_5":14907,"_28433":128654,"_3077":128689},[],{"_3625":75646,"_31241":75489,"_21645":129116,"_5":14907,"_28433":128654,"_3077":129117},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3625":75647,"_31241":75489,"_21645":129119,"_5":14907,"_28433":128654,"_3077":129120},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3625":75648,"_31241":75489,"_21645":129122,"_5":14907,"_28433":128654,"_3077":129123},[],"Actualizar el archivo de values",{"_3625":75649,"_31241":75489,"_21645":129125,"_5":14907,"_28433":128654,"_3077":128733},[],{"_3625":75650,"_31241":75489,"_21645":129127,"_5":14907,"_28433":128654,"_3077":129128},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3625":75651,"_31241":75489,"_21645":129130,"_5":14907,"_28433":128654,"_3077":129131},[],"Baja: prevalece el ID de la URL",{"_3625":75652,"_31241":75489,"_21645":129133,"_5":14907,"_28433":128654,"_3077":129134},[],"Enviar el ID en la URL",{"_3625":75653,"_31241":75489,"_21645":129136,"_5":14907,"_28433":128654,"_3077":128761},[],{"_3625":75654,"_31241":75489,"_21645":129138,"_5":14907,"_28433":128654,"_3077":129139},[],"Clientes que envían un `id` al crear o importar CAs",{"_3625":75655,"_31241":75489,"_21645":129141,"_5":14907,"_28433":128654,"_3077":129142},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3625":75656,"_31241":75489,"_21645":129144,"_5":14907,"_28433":128654,"_3077":129145},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3625":75657,"_31241":75489,"_21645":129147,"_5":14907,"_28433":128654,"_3077":128765},[],{"_3625":75658,"_31241":75489,"_21645":129149,"_5":14907,"_28433":128654,"_3077":129150},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3625":75659,"_31241":75489,"_21645":129152,"_5":14907,"_28433":128654,"_3077":129153},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3625":75660,"_31241":75489,"_21645":129155,"_5":14907,"_28433":128654,"_3077":129156},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3625":75661,"_31241":75489,"_21645":129158,"_5":14907,"_28433":128654,"_3077":128737},[],{"_3625":75662,"_31241":75489,"_21645":129160,"_5":14907,"_28433":128654,"_3077":129161},[],"Consumidores que comparan el `type` del certificado",{"_3625":75663,"_31241":75489,"_21645":129163,"_5":14907,"_28433":128654,"_3077":129164},[],"Baja: dos valores cambian de nombre",{"_3625":75664,"_31241":75489,"_21645":129166,"_5":14907,"_28433":128654,"_3077":129167},[],"Adaptar los consumidores",{"_3625":75665,"_31241":75489,"_21645":129169,"_5":14907,"_28433":128654,"_3077":128729},[],{"_3625":75666,"_31241":75489,"_21645":129171,"_5":14907,"_28433":128654,"_3077":129172},[],"Cualquier DMS",{"_3625":75667,"_31241":75489,"_21645":129174,"_5":14907,"_28433":128654,"_3077":129175},[],"Baja: solo informativo",{"_3625":75668,"_31241":75489,"_21645":129177,"_5":14907,"_28433":128654,"_3077":129178},[],"Revisar ambos bloques antes de editar",{"_3625":75669,"_31241":75489,"_21645":129180,"_5":14907,"_28433":128661,"_3077":129181},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3625":75670,"_31241":75489,"_21645":129183,"_5":14907,"_28433":128661,"_3077":129184},[],"El paso 4 de la guía de migración copia los datos.",{"_3625":75671,"_31241":75489,"_21645":129186,"_5":14907,"_28433":128665,"_3077":129187},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3625":75672,"_31241":75489,"_21645":129189,"_5":14907,"_28433":128669,"_3077":129190},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3625":75673,"_31241":75489,"_21645":129192,"_5":14907,"_28433":128669,"_3077":129193},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3625":75674,"_31241":75489,"_21645":129195,"_5":14907,"_28433":128672,"_3077":129196},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3625":75675,"_31241":75489,"_21645":129198,"_5":14907,"_28433":128676,"_3077":129199},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3625":75676,"_31241":75489,"_21645":129201,"_5":14907,"_28433":128680,"_3077":129202},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3625":75677,"_31241":75489,"_21645":129204,"_5":14907,"_28433":128680,"_3077":129205},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3625":75678,"_31241":75489,"_21645":129207,"_5":14907,"_28433":128680,"_3077":129208},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3625":75679,"_31241":75489,"_21645":129210,"_5":14907,"_28433":128684,"_3077":129211},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3625":75680,"_31241":75489,"_21645":129213,"_5":14907,"_28433":128688,"_3077":129214},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3625":75681,"_31241":75489,"_21645":129216,"_5":14907,"_28433":128688,"_3077":129217},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3625":75682,"_31241":75489,"_21645":129219,"_5":14907,"_28433":128688,"_3077":129220},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3625":75683,"_31241":75489,"_21645":129222,"_5":14907,"_28433":128688,"_3077":129223},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3625":75684,"_31241":75489,"_21645":129225,"_5":14907,"_28433":128688,"_3077":129226},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3625":75685,"_31241":75489,"_21645":129228,"_5":14907,"_28433":128688,"_3077":129229},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3625":75686,"_31241":75489,"_21645":129231,"_5":14907,"_28433":128696,"_3077":129232},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3625":75687,"_31241":75489,"_21645":129234,"_5":14907,"_28433":128696,"_3077":129235},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3625":75688,"_31241":75489,"_21645":129237,"_5":14907,"_28433":128696,"_3077":129238},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3625":75689,"_31241":75489,"_21645":129240,"_5":14907,"_28433":128696,"_3077":129241},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3625":75690,"_31241":75489,"_21645":129243,"_5":14907,"_28433":128696,"_3077":129244},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3625":75691,"_31241":75489,"_21645":129246,"_5":14907,"_28433":128700,"_3077":129247},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3625":75692,"_31241":75489,"_21645":129249,"_5":14907,"_28433":128704,"_3077":129250},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3625":75693,"_31241":75489,"_21645":129252,"_5":14907,"_28433":128704,"_3077":129253},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3625":75694,"_31241":75489,"_21645":129255,"_5":14907,"_28433":128704,"_3077":129256},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3625":75695,"_31241":75489,"_21645":129258,"_5":14907,"_28433":128704,"_3077":129259},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3625":75696,"_31241":75489,"_21645":129261,"_5":14907,"_28433":128704,"_3077":129262},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3625":75697,"_31241":75489,"_21645":129264,"_5":14907,"_28433":128704,"_3077":129265},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3625":75698,"_31241":75489,"_21645":129267,"_5":14907,"_28433":128704,"_3077":129268},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3625":75699,"_31241":75489,"_21645":129270,"_5":14907,"_28433":128704,"_3077":129271},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3625":75700,"_31241":75489,"_21645":129273,"_5":14907,"_28433":128708,"_3077":129274},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3625":75701,"_31241":75489,"_21645":129276,"_5":14907,"_28433":128716,"_3077":129277},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3625":75702,"_31241":75489,"_21645":129279,"_5":14907,"_28433":128716,"_3077":129280},[],"Campo en 3.8.0",{"_3625":75703,"_31241":75489,"_21645":129282,"_5":14907,"_28433":128716,"_3077":129283},[],"Campo en 4.0.0",{"_3625":75704,"_31241":75489,"_21645":129285,"_5":14907,"_28433":128716,"_3077":60093},[],{"_3625":75705,"_31241":75489,"_21645":129287,"_5":14907,"_28433":128716,"_3077":129288},[],"`insecure_skip_verify` (con el valor negado)",{"_3625":75706,"_31241":75489,"_21645":129290,"_5":14907,"_28433":128716,"_3077":60099},[],{"_3625":75707,"_31241":75489,"_21645":129292,"_5":14907,"_28433":128716,"_3077":60102},[],{"_3625":75708,"_31241":75489,"_21645":129294,"_5":14907,"_28433":128716,"_3077":60105},[],{"_3625":75709,"_31241":75489,"_21645":129296,"_5":14907,"_28433":128716,"_3077":60108},[],{"_3625":75710,"_31241":75489,"_21645":129298,"_5":14907,"_28433":128716,"_3077":60111},[],{"_3625":75711,"_31241":75489,"_21645":129300,"_5":14907,"_28433":128716,"_3077":60114},[],{"_3625":75712,"_31241":75489,"_21645":129302,"_5":14907,"_28433":128716,"_3077":129303},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3625":75713,"_31241":75489,"_21645":129305,"_5":14907,"_28433":128716,"_3077":129306},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3625":75714,"_31241":75489,"_21645":129308,"_5":14907,"_28433":128716,"_3077":129309},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3625":75715,"_31241":75489,"_21645":129311,"_5":14907,"_28433":128720,"_3077":129312},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3625":75716,"_31241":75489,"_21645":129314,"_5":14907,"_28433":128720,"_3077":129315},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3625":75717,"_31241":75489,"_21645":129317,"_5":14907,"_28433":128720,"_3077":129318},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3625":75718,"_31241":75489,"_21645":129320,"_5":14907,"_28433":128724,"_3077":129321},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3625":75719,"_31241":75489,"_21645":129323,"_5":14907,"_28433":128724,"_3077":129324},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3625":75720,"_31241":75489,"_21645":129326,"_5":14907,"_28433":128728,"_3077":129327},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3625":75721,"_31241":75489,"_21645":129329,"_5":14907,"_28433":128732,"_3077":129330},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3625":75722,"_31241":75489,"_21645":129332,"_5":14907,"_28433":128736,"_3077":129333},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3625":75723,"_31241":75489,"_21645":129335,"_5":14907,"_28433":128740,"_3077":129336},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3625":75724,"_31241":75489,"_21645":129338,"_5":14907,"_28433":128740,"_3077":129339},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3625":75725,"_31241":75489,"_21645":129341,"_5":14907,"_28433":128740,"_3077":129342},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3625":75726,"_31241":75489,"_21645":129344,"_5":14907,"_28433":128740,"_3077":129345},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3625":75727,"_31241":75489,"_21645":129347,"_5":14907,"_28433":128744,"_3077":129348},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3625":75728,"_31241":75489,"_21645":129350,"_5":14907,"_28433":128748,"_3077":129351},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3625":75729,"_31241":75489,"_21645":129353,"_5":14907,"_28433":128748,"_3077":129354},[],"Ruta",{"_3625":75730,"_31241":75489,"_21645":129356,"_5":14907,"_28433":128748,"_3077":121667},[],{"_3625":75731,"_31241":75489,"_21645":129358,"_5":14907,"_28433":128748,"_3077":60173},[],{"_3625":75732,"_31241":75489,"_21645":129360,"_5":14907,"_28433":128748,"_3077":129361},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3625":75733,"_31241":75489,"_21645":129363,"_5":14907,"_28433":128748,"_3077":60179},[],{"_3625":75734,"_31241":75489,"_21645":129365,"_5":14907,"_28433":128748,"_3077":129366},[],"Lee los ajustes de una CA.",{"_3625":75735,"_31241":75489,"_21645":129368,"_5":14907,"_28433":128748,"_3077":60185},[],{"_3625":75736,"_31241":75489,"_21645":129370,"_5":14907,"_28433":128748,"_3077":129371},[],"Sustituye los `crl_options`.",{"_3625":75737,"_31241":75489,"_21645":129373,"_5":14907,"_28433":128748,"_3077":60191},[],{"_3625":75738,"_31241":75489,"_21645":129375,"_5":14907,"_28433":128748,"_3077":129376},[],"Elimina los ajustes archivados de una CA.",{"_3625":75739,"_31241":75489,"_21645":129378,"_5":14907,"_28433":128748,"_3077":129379},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3625":75740,"_31241":75489,"_21645":129381,"_5":14907,"_28433":128748,"_3077":129382},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3625":75741,"_31241":75489,"_21645":129384,"_5":14907,"_28433":128748,"_3077":129385},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3625":75742,"_31241":75489,"_21645":129387,"_5":14907,"_28433":128748,"_3077":129388},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3625":75743,"_31241":75489,"_21645":129390,"_5":14907,"_28433":128748,"_3077":129391},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3625":75744,"_31241":75489,"_21645":129393,"_5":14907,"_28433":128748,"_3077":129394},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3625":75745,"_31241":75489,"_21645":129396,"_5":14907,"_28433":128748,"_3077":129397},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3625":75746,"_31241":75489,"_21645":129399,"_5":14907,"_28433":128748,"_3077":129400},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3625":75747,"_31241":75489,"_21645":129402,"_5":14907,"_28433":128748,"_3077":129403},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3625":75748,"_31241":75489,"_21645":129405,"_5":14907,"_28433":128748,"_3077":129406},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3625":75749,"_31241":75489,"_21645":129408,"_5":14907,"_28433":128748,"_3077":129409},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3625":75750,"_31241":75489,"_21645":129411,"_5":14907,"_28433":128752,"_3077":129412},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3625":75751,"_31241":75489,"_21645":129414,"_5":14907,"_28433":128756,"_3077":129415},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3625":75752,"_31241":75489,"_21645":129417,"_5":14907,"_28433":128760,"_3077":129418},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3625":75753,"_31241":75489,"_21645":129420,"_5":14907,"_28433":128764,"_3077":129421},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3625":75754,"_31241":75489,"_21645":129423,"_5":14907,"_28433":128764,"_3077":129424},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3625":75755,"_31241":75489,"_21645":129426,"_5":14907,"_28433":128768,"_3077":129427},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3625":75756,"_31241":75489,"_21645":129429,"_5":14907,"_28433":128772,"_3077":129430},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3625":75757,"_31241":75489,"_21645":129432,"_5":14907,"_28433":128776,"_3077":129433},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3625":75758,"_31241":75489,"_21645":129435,"_5":14907,"_28433":128776,"_3077":129436},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3625":75759,"_31241":75489,"_21645":129438,"_5":14907,"_28433":128776,"_3077":129439},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3625":75760,"_31241":75489,"_21645":129441,"_5":14907,"_28433":128776,"_3077":129442},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3625":75761,"_31241":75489,"_21645":129444,"_5":14907,"_28433":128776,"_3077":129445},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3625":75762,"_31241":75489,"_21645":129447,"_5":14907,"_28433":128776,"_3077":129448},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3625":75763,"_31241":75489,"_21645":129450,"_5":14907,"_28433":128780,"_3077":129451},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3625":75764,"_31241":75489,"_21645":129453,"_5":14907,"_28433":128780,"_3077":129454},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3625":75765,"_31241":75489,"_21645":129456,"_5":14907,"_28433":128780,"_3077":129457},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3625":75766,"_31241":75489,"_21645":129459,"_5":14907,"_28433":128780,"_3077":129460},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3625":75767,"_31241":75489,"_21645":129462,"_5":14907,"_28433":128780,"_3077":129463},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3625":75768,"_31241":75489,"_21645":129465,"_5":14907,"_28433":128784,"_3077":129466},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3625":75769,"_31241":75489,"_21645":129468,"_5":14907,"_28433":128784,"_3077":129469},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3625":75770,"_31241":75489,"_21645":129471,"_5":14907,"_28433":128784,"_3077":129472},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3625":75771,"_31241":75489,"_21645":129474,"_5":14907,"_28433":128784,"_3077":60293},[],{"_3625":75772,"_31241":75489,"_21645":129476,"_5":14907,"_28433":128784,"_3077":129477},[],"Claves de datos obligatorias",{"_3625":75773,"_31241":75489,"_21645":129479,"_5":14907,"_28433":128784,"_3077":129480},[],"Cuándo",{"_3625":75774,"_31241":75489,"_21645":129482,"_5":14907,"_28433":128784,"_3077":129483},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3625":75775,"_31241":75489,"_21645":129485,"_5":14907,"_28433":128784,"_3077":60305},[],{"_3625":75776,"_31241":75489,"_21645":129487,"_5":14907,"_28433":128784,"_3077":129488},[],"Siempre",{"_3625":75777,"_31241":75489,"_21645":129490,"_5":14907,"_28433":128784,"_3077":129491},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3625":75778,"_31241":75489,"_21645":129493,"_5":14907,"_28433":128784,"_3077":60305},[],{"_3625":75779,"_31241":75489,"_21645":129495,"_5":14907,"_28433":128784,"_3077":129488},[],{"_3625":75780,"_31241":75489,"_21645":129497,"_5":14907,"_28433":128784,"_3077":60318},[],{"_3625":75781,"_31241":75489,"_21645":129499,"_5":14907,"_28433":128784,"_3077":60305},[],{"_3625":75782,"_31241":75489,"_21645":129501,"_5":14907,"_28433":128784,"_3077":129502},[],"Solo cuando hay autenticación SMTP",{"_3625":75783,"_31241":75489,"_21645":129504,"_5":14907,"_28433":128784,"_3077":129505},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3625":75784,"_31241":75489,"_21645":129507,"_5":14907,"_28433":128784,"_3077":129508},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3625":75785,"_31241":75489,"_21645":129510,"_5":14907,"_28433":128784,"_3077":129511},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3625":75786,"_31241":75489,"_21645":129513,"_5":14907,"_28433":128784,"_3077":129514},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3625":75787,"_31241":75489,"_21645":129516,"_5":14907,"_28433":128784,"_3077":129517},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3625":75788,"_31241":75489,"_21645":129519,"_5":14907,"_28433":128784,"_3077":129520},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3625":75789,"_31241":75489,"_21645":129522,"_5":14907,"_28433":128784,"_3077":129523},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3625":75790,"_31241":75489,"_21645":129525,"_5":14907,"_28433":128784,"_3077":129526},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3625":75791,"_31241":75489,"_21645":129528,"_5":14907,"_28433":128784,"_3077":129529},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3625":75792,"_31241":75489,"_21645":129531,"_5":14907,"_28433":128784,"_3077":129532},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3625":75793,"_31241":75489,"_21645":129534,"_5":14907,"_28433":128784,"_3077":129535},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3625":75794,"_31241":75489,"_21645":129537,"_5":14907,"_28433":128784,"_3077":129538},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3625":75795,"_31241":75489,"_21645":129540,"_5":14907,"_28433":128784,"_3077":129541},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3625":75796,"_31241":75489,"_21645":129543,"_5":14907,"_28433":128784,"_3077":129544},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3625":75797,"_31241":75489,"_21645":129546,"_5":14907,"_28433":128784,"_3077":129547},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3625":75798,"_31241":75489,"_21645":129549,"_5":14907,"_28433":128788,"_3077":129550},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3625":75799,"_31241":75489,"_21645":129552,"_5":14907,"_28433":128788,"_3077":129553},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3625":75800,"_31241":75489,"_21645":129555,"_5":14907,"_28433":128792,"_3077":129556},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3625":75801,"_31241":75489,"_21645":129558,"_5":14907,"_28433":128792,"_3077":129559},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3625":75802,"_31241":75489,"_21645":129561,"_5":14907,"_28433":128792,"_3077":129562},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3625":75803,"_31241":75489,"_21645":129564,"_5":14907,"_28433":128792,"_3077":129565},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3625":75804,"_31241":75489,"_21645":129567,"_5":14907,"_28433":128792,"_3077":129568},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3625":75805,"_31241":75489,"_21645":129570,"_5":14907,"_28433":128792,"_3077":129571},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3625":75806,"_31241":75489,"_21645":129573,"_5":14907,"_28433":128792,"_3077":129574},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3625":75807,"_31241":75489,"_21645":129576,"_5":14907,"_28433":128792,"_3077":129577},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3625":75808,"_31241":75489,"_21645":129579,"_5":14907,"_28433":128792,"_3077":129580},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3625":75809,"_31241":75489,"_21645":129582,"_5":14907,"_28433":128792,"_3077":129583},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3625":75810,"_31241":75489,"_21645":129585,"_5":14907,"_28433":128792,"_3077":129586},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3625":75811,"_31241":75489,"_21645":129588,"_5":14907,"_28433":128796,"_3077":129589},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3625":75812,"_31241":75489,"_21645":129591,"_5":14907,"_28433":128796,"_3077":129592},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3625":75813,"_31241":75489,"_21645":129594,"_5":14907,"_28433":128800,"_3077":129595},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3625":75814,"_31241":75489,"_21645":129597,"_5":14907,"_28433":128800,"_3077":129598},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3625":75815,"_31241":75489,"_21645":129600,"_5":14907,"_28433":128800,"_3077":129601},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3625":75816,"_31241":75489,"_21645":129603,"_5":14907,"_28433":128800,"_3077":129604},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3625":75817,"_31241":75489,"_21645":129606,"_5":14907,"_28433":128800,"_3077":129607},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3625":75818,"_31241":75489,"_21645":129609,"_5":14907,"_28433":128800,"_3077":129610},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3625":75819,"_31241":75489,"_21645":129612,"_5":14907,"_28433":128800,"_3077":129613},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3625":75820,"_31241":75489,"_21645":129615,"_5":14907,"_28433":128800,"_3077":129616},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3625":75821,"_31241":75489,"_21645":129618,"_5":14907,"_28433":128804,"_3077":129619},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3625":75822,"_31241":75489,"_21645":129621,"_5":14907,"_28433":128804,"_3077":129622},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3625":75823,"_31241":75489,"_21645":129624,"_5":14907,"_28433":128804,"_3077":129625},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3625":75824,"_31241":75489,"_21645":129627,"_5":14907,"_28433":128804,"_3077":129628},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3625":75825,"_31241":75489,"_21645":129630,"_5":14907,"_28433":128804,"_3077":129631},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3625":75826,"_31241":75489,"_21645":129633,"_5":14907,"_28433":128804,"_3077":129634},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3625":75827,"_31241":75489,"_21645":129636,"_5":14907,"_28433":128804,"_3077":129637},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3625":75828,"_31241":75489,"_21645":129639,"_5":14907,"_28433":128804,"_3077":129640},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3625":75829,"_31241":75489,"_21645":129642,"_5":14907,"_28433":128804,"_3077":129643},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3625":75830,"_31241":75489,"_21645":129645,"_5":14907,"_28433":128804,"_3077":129646},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3625":75831,"_31241":75489,"_21645":129648,"_5":14907,"_28433":128804,"_3077":129649},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3625":75832,"_31241":75489,"_21645":129651,"_5":14907,"_28433":128807,"_3077":129652},[],"Tras la actualización, comprueba en este orden:",{"_3625":75833,"_31241":75489,"_21645":129654,"_5":14907,"_28433":128807,"_3077":129655},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3625":75834,"_31241":75489,"_21645":129657,"_5":14907,"_28433":128807,"_3077":129658},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3625":75835,"_31241":75489,"_21645":129660,"_5":14907,"_28433":128807,"_3077":129661},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3625":75836,"_31241":75489,"_21645":129663,"_5":14907,"_28433":128807,"_3077":129664},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3625":75837,"_31241":75489,"_21645":129666,"_5":14907,"_28433":128807,"_3077":129667},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3625":75838,"_31241":75489,"_21645":129669,"_5":14907,"_28433":128807,"_3077":129670},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3625":75839,"_31241":75489,"_21645":129672,"_5":14907,"_28433":128807,"_3077":129673},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3625":75840,"_31241":75489,"_21645":129675,"_5":14907,"_28433":128807,"_3077":129676},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3625":75841,"_31241":75489,"_21645":129678,"_5":14907,"_28433":128807,"_3077":129679},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3625":75842,"_31241":75489,"_21645":129681,"_5":14907,"_28433":128807,"_3077":129682},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3625":75843,"_31241":75489,"_21645":129684,"_5":14907,"_28433":128807,"_3077":129685},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3625":75844,"_31241":75489,"_21645":129687,"_5":14907,"_28433":128807,"_3077":129688},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3625":75845,"_31241":75489,"_21645":129690,"_5":14907,"_28433":128807,"_3077":129691},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3625":75846,"_31241":75489,"_21645":129693,"_5":14907,"_28433":128807,"_3077":129694},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3625":75847,"_31241":75489,"_21645":129696,"_5":14907,"_28433":128807,"_3077":129697},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3625":75848,"_31241":75489,"_21645":129699,"_5":14907,"_28433":128811,"_3077":129700},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3625":75849,"_31241":75489,"_21645":129702,"_5":14907,"_28433":128811,"_3077":129703},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3625":75850,"_31241":75489,"_21645":129705,"_5":14907,"_28433":128811,"_3077":129706},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3625":75851,"_31241":75489,"_21645":129708,"_5":14907,"_28433":128811,"_3077":129709},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3625":75852,"_31241":75489,"_21645":129711,"_5":14907,"_28433":128811,"_3077":129712},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60536":129714,"_60538":129715,"_60540":129716,"_60542":129717,"_18782":3112,"_72789":3112},"spanish",[3077,31241,5,28433],{"_3077":25851,"_31241":25851,"_5":25851,"_28433":25851},{"_3077":129718,"_31241":132778,"_5":135838,"_28433":138898},{"_4827":129719,"_60546":129720,"_5":25851},{"_14988":7240,"_15367":7785,"_15386":4666,"_30241":7970,"_15373":4215,"_20557":3370,"_15009":5984,"_15016":20863,"_30183":12180,"_30591":7927,"_30618":7284,"_30217":4570,"_35647":5181,"_30320":21043,"_30662":10238,"_35654":5456,"_35657":4216,"_35660":5836,"_35663":5744,"_31064":10982,"_35668":4905,"_35670":3389,"_31099":5345,"_15382":16368,"_35674":7814,"_35677":7604,"_35679":5146,"_30646":12800,"_31084":4244,"_31112":3297,"_35684":5307,"_35686":3574,"_35688":6314,"_30331":7990,"_35691":3474,"_35693":6194,"_35695":13386,"_35697":3530,"_35699":3592